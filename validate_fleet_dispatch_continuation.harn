#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import {
  fleet_dispatch_continuation_read,
  fleet_dispatch_continuation_rebind,
  fleet_dispatch_lineage,
  require_fleet_dispatch_continuation_predecessor,
} from "lib/fleet_dispatch_continuation"

type Options = {
  receipt: string,
  target: string,
  chain_id: string,
  predecessor_round: int,
  predecessor_run_id: int,
  current_round: int,
  current_run_id: int,
}

const ARG_SPEC: ParserSpec = {
  name: "validate-fleet-dispatch-continuation",
  args: [
    {kind: "flag", name: "receipt", long: "--receipt", required: true},
    {kind: "flag", name: "target", long: "--target", required: true},
    {kind: "flag", name: "chain_id", long: "--chain-id", required: true},
    {
      kind: "flag",
      name: "predecessor_round",
      long: "--predecessor-round",
      parse: "int",
      required: true,
    },
    {kind: "flag", name: "current_round", long: "--current-round", parse: "int", required: true},
    {kind: "flag", name: "current_run_id", long: "--current-run-id", parse: "int", required: true},
    {
      kind: "flag",
      name: "predecessor_run_id",
      long: "--predecessor-run-id",
      parse: "int",
      required: true,
    },
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const predecessor = require_fleet_dispatch_continuation_predecessor(
    fleet_dispatch_continuation_read(harness.fs, options.receipt),
    fleet_dispatch_lineage(
      options.target,
      options.chain_id,
      options.predecessor_round,
      options.predecessor_run_id,
    ),
  )
  const receipt = fleet_dispatch_continuation_rebind(
    {fs: harness.fs, random: harness.random},
    options.receipt,
    predecessor,
    fleet_dispatch_lineage(
      options.target,
      options.chain_id,
      options.current_round,
      options.current_run_id,
    ),
  )
  harness.stdio.println(
    json_stringify_pretty(
      {
        schema_version: receipt.schema_version,
        target: receipt.target,
        chain_id: receipt.chain_id,
        update_round: receipt.update_round,
        controller_run_id: receipt.controller_run_id,
        dispatch_count: len(receipt.dispatches),
        run_ids: receipt.dispatches.map({ dispatch -> dispatch.run_id }).to_list(),
      },
    ),
  )
}
