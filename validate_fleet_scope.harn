#!/usr/bin/env harn
// Validate public workflow selectors and emit their one exact inclusion identity.
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import {
  fleet_scope_excluding,
  operation_harn_bump_repositories,
  read_fleet_manifest,
} from "lib/fleet_manifest"
import {
  fleet_operation_scope,
  fleet_scope_members,
  require_fleet_scope_digest,
  require_release_controller_scope,
} from "lib/fleet_operation_scope"

type Options = {
  only?: string,
  repositories_json?: string,
  skip_consumers?: string,
  require_canonical_repositories_json: bool,
  require_controller: bool,
  scope_digest?: string,
}

const ARG_SPEC: ParserSpec = {
  name: "validate-fleet-scope",
  args: [
    {kind: "flag", name: "only", long: "--only"},
    {kind: "flag", name: "scope_digest", long: "--scope-digest"},
    {kind: "flag", name: "repositories_json", long: "--repositories-json"},
    {kind: "flag", name: "skip_consumers", long: "--skip-consumers-json"},
    {kind: "switch", name: "require_controller", long: "--require-controller"},
    {
      kind: "switch",
      name: "require_canonical_repositories_json",
      long: "--require-canonical-repositories-json",
    },
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if options.skip_consumers != nil
    && (trim(options.only ?? "") != "" || options.repositories_json != nil) {
    throw "repository selection and skip_consumers are mutually exclusive"
  }
  const manifest = read_fleet_manifest(harness.fs)
  const scope = if options.skip_consumers != nil {
    fleet_scope_excluding(manifest, options.skip_consumers)
  } else {
    fleet_operation_scope(options.only, options.repositories_json)
  }
  operation_harn_bump_repositories(manifest, scope)
  if options.scope_digest != nil {
    require_fleet_scope_digest(scope, options.scope_digest ?? "")
  }
  if options.require_controller {
    require_release_controller_scope(scope)
  }
  const members = fleet_scope_members(scope)
  const repositories_json = if members == nil {
    ""
  } else {
    json_stringify(unwrap(members))
  }
  if options.require_canonical_repositories_json
    && options.repositories_json != nil
    && options.repositories_json != repositories_json {
    throw "repositories_json must be the canonical compact sorted repository list"
  }
  harness.stdio.println(repositories_json)
}
