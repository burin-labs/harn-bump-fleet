#!/usr/bin/env harn
//
// check_unbound_symbols.harn — repo-local static gate for orphaned module-level
// constant references. See lib/unbound_symbols.harn for the rationale and the
// upstream tracking issue (harn#4708). Run under --no-sandbox so it can shell
// out to `harn tokens` and read the repo.
import { command_run } from "std/command"
import { unbound_symbol_findings } from "lib/unbound_symbols"

const SOURCE_PATTERNS = ["*.harn", "lib/**/*.harn", "tests/**/*.harn", "scripts/**/*.harn"]

fn maintained_harn_path(path: string) -> bool {
  return ends_with(path, ".harn")
    && basename(path) != ".harn"
    && !contains(path, "/.harn/")
    && !starts_with(path, ".harn/")
}

fn harn_bin(harness: Harness) -> string {
  const configured = trim(harness.env.get_or("HARN_BIN", ""))
  if configured != "" {
    return configured
  }
  return "harn"
}

/** Tokenize one file with `harn tokens --json` and return its token list, or nil on failure. */
fn tokenize(harness: Harness, bin: string, path: string) {
  const result = command_run(
    {argv: [bin, "tokens", "--json", path], timeout_ms: 30000, capture: {max_inline_bytes: 33554432}},
  )
  if !(result.success ?? false) {
    harness.stdio.eprintln("could not tokenize ${path}: ${trim(result.stderr ?? "")}")
    return nil
  }
  // `command_run` inlines stdout only up to `max_inline_bytes`; the token JSON
  // for a large file spills to `stdout_path`, so fall back to reading it.
  const raw = if trim(result.stdout ?? "") != "" {
    result.stdout ?? ""
  } else if trim(result.stdout_path ?? "") != "" && harness.fs.exists(result.stdout_path) {
    harness.fs.read_text(result.stdout_path)
  } else {
    ""
  }
  const parsed = try {
    json_parse(raw)
  } catch (_e) {
    nil
  }
  if parsed == nil || !(parsed.ok ?? false) {
    harness.stdio.eprintln("could not parse tokens for ${path}")
    return nil
  }
  return parsed.data ?? []
}

pipeline main() {
  let paths: list<string> = []
  for pattern in SOURCE_PATTERNS {
    for path in harness.fs.glob(pattern) {
      if maintained_harn_path(path) && !paths.contains(path) {
        paths = paths.push(path)
      }
    }
  }
  const bin = harn_bin(harness)
  let total_findings = 0
  let tokenize_failures = 0
  for path in paths.sort() {
    const tokens = tokenize(harness, bin, path)
    if tokens == nil {
      tokenize_failures = tokenize_failures + 1
      continue
    }
    const findings = unbound_symbol_findings(tokens)
    for finding in findings {
      harness.stdio
        .eprintln(
        "${path}:${to_string(finding.line)}: `${finding.name}` is referenced but never defined or imported in this file",
      )
      total_findings = total_findings + 1
    }
  }
  if tokenize_failures > 0 {
    harness.stdio
      .eprintln("unbound-symbol sweep: ${to_string(tokenize_failures)} file(s) failed to tokenize")
    return 1
  }
  if total_findings > 0 {
    harness.stdio
      .eprintln(
      "unbound-symbol sweep: ${to_string(total_findings)} orphaned reference(s); define or import each, or delete the dead reference",
    )
    return 1
  }
  harness.stdio
    .println("unbound-symbol sweep: ${to_string(len(paths))} files, no orphaned references")
  return 0
}
