#!/usr/bin/env harn
import { git_run } from "std/git"
import {
  SourceLengthEntry,
  source_length_violations,
  source_line_count,
  tracked_source_paths,
} from "lib/source_length"

pipeline main(harness: Harness) {
  const inventory = git_run(harness.process, ["ls-files", "-z"])
  if !inventory.ok {
    harness.stdio.eprintln(
      "source length: unable to inventory tracked files: ${inventory.combined}",
    )
    return 1
  }
  const paths = tracked_source_paths(inventory.stdout)
  const entries: list<SourceLengthEntry> = paths.map(
    { path -> return {path: path, lines: source_line_count(harness.fs.read_text(path))} },
  )
    .to_list()
  const violations = source_length_violations(entries)
  if len(violations) > 0 {
    for violation in violations {
      harness.stdio.eprintln(
        "${violation.path}: ${violation.lines} lines exceeds the 1500-line handwritten-source limit",
      )
    }
    return 1
  }
  harness.stdio.println("source length: ${len(entries)} handwritten files, 1500-line cap")
  return 0
}
