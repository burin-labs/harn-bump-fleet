#!/usr/bin/env harn
import { SourceLengthEntry, source_length_violations, source_line_count } from "lib/source_length"

const SOURCE_PATTERNS = [
  "*.harn",
  "*.md",
  "*.toml",
  "changelog.d/*.md",
  "lib/**/*.harn",
  "prompts/**/*.prompt",
  "tests/**/*.harn",
  "scripts/**/*.harn",
  "scripts/**/*.sh",
  "scripts/**/*.template",
  ".github/workflows/*.yml",
  ".github/workflows/*.yaml",
]

fn maintained_source_path(path: string) -> bool {
  return path != "CLAUDE.md"
    && basename(path) != ".harn"
    && !contains(path, "/.harn/")
    && !starts_with(path, ".harn/")
    && (ends_with(path, ".harn")
    || ends_with(path, ".sh")
    || ends_with(path, ".md")
    || ends_with(path, ".prompt")
    || ends_with(path, ".template")
    || ends_with(path, ".toml")
    || ends_with(path, ".yml")
    || ends_with(path, ".yaml"))
}

pipeline main() {
  let paths: list<string> = []
  for pattern in SOURCE_PATTERNS {
    for path in harness.fs.glob(pattern) {
      if maintained_source_path(path) && !paths.contains(path) {
        paths = paths.push(path)
      }
    }
  }
  const entries: list<SourceLengthEntry> = paths
    .sort()
    .map({ path -> return {path: path, lines: source_line_count(harness.fs.read_text(path))} })
    .to_list()
  const violations = source_length_violations(entries)
  if len(violations) > 0 {
    for violation in violations {
      harness.stdio
        .eprintln(
        "${violation.path}: ${violation.lines} lines exceeds the 1500-line handwritten-source limit",
      )
    }
    return 1
  }
  harness.stdio.println("source length: ${len(entries)} handwritten files, 1500-line cap")
  return 0
}
