#!/usr/bin/env harn
/**
 * preflight_release_launch.harn — ask every release precondition before the
 * release takes a lease.
 *
 * Five hosted release attempts were lost in one day. Each died at a different
 * gate, and each gate was first exercised between thirty seconds and
 * sixty-five minutes into an attempt that could not be taken back. None of
 * them needed the attempt to be answered.
 *
 * This runs first in every mode, asks each of those questions through the same
 * code the cut uses, and stops before the lease if any answer is no. It takes
 * no lease, writes no ref, and opens nothing. The one thing it does create is a
 * GitHub App installation token, which is unavoidable: the question is whether
 * the mint grants what the cut needs, and only the mint can answer it. The
 * token is never printed -- `--describe` returns the grants and the expiry in
 * its place.
 *
 * Usage:
 *   harn run --no-sandbox preflight_release_launch.harn -- --mode ship-pr --bump patch
 */
import { ParserSpec } from "std/cli/argparse"
import { env_str } from "std/config"
import { cli_options } from "lib/cli_options"
import {
  PreflightPrecondition,
  ReleaseLaunchInputs,
  consumer_contract_precondition,
  credential_refresh_precondition,
  preflight_fail,
  preflight_pass,
  preflight_unavailable,
  release_input_preconditions,
  release_launch_preflight_lines,
  release_launch_preflight_receipt,
  token_description_preconditions,
  workflow_mint_precondition,
} from "lib/release_launch_preflight"
import { release_harness_root } from "lib/release_paths"
import {
  RELEASE_CREDENTIAL_LIFETIME_S,
  RELEASE_CREDENTIAL_REFRESH_INTERVAL_S,
  release_phase_budget_drift,
} from "lib/release_phase_budgets"

type Options = {
  mode: string,
  bump: string,
  preid: string,
  at_sha: string,
  repositories_json: string,
  skip_consumers: string,
  consumer_proof_runs_json: string,
  token_profile: string,
  offline: bool,
  receipt: string,
}

const ARG_SPEC: ParserSpec = {
  name: "preflight-release-launch",
  args: [
    {kind: "flag", name: "mode", long: "--mode", default: "audit"},
    {kind: "flag", name: "bump", long: "--bump", default: "patch"},
    {kind: "flag", name: "preid", long: "--preid", default: ""},
    {kind: "flag", name: "at_sha", long: "--at-sha", default: ""},
    {kind: "flag", name: "repositories_json", long: "--repositories-json", default: ""},
    {kind: "flag", name: "skip_consumers", long: "--skip-consumers-json", default: ""},
    {
      kind: "flag",
      name: "consumer_proof_runs_json",
      long: "--consumer-proof-runs-json",
      default: "",
    },
    {kind: "flag", name: "token_profile", long: "--token-profile", default: "harn-release"},
    {kind: "switch", name: "offline", long: "--offline"},
    {kind: "flag", name: "receipt", long: "--receipt", default: ""},
  ],
}

const HOSTED_RELEASE_WORKFLOW = ".github/workflows/hosted-release.yml"

const PROFILE_REGISTRY = "spec/github-app-token-profiles.json"

type TokenProfile = {repository_names: list<string>?, permissions: dict<string, string>}

type WorkflowMintBinding = {workflow: string, job: string, step: string, profile: string}

type TokenProfileRegistry = {
  schema_version: string,
  profiles: dict<string, TokenProfile>,
  workflow_mints: list<WorkflowMintBinding>,
}

fn read_profile_registry(fs: HarnessFs, root: string) -> TokenProfileRegistry {
  return schema_expect(
    json_parse(fs.read_text(path_join(root, PROFILE_REGISTRY))),
    schema_of(TokenProfileRegistry),
  )
}

fn workflow_step(document: any, job: string, step_name: string) -> any {
  const steps = document?.get("jobs")?.get(job)?.get("steps") ?? []
  return steps.find({ step -> return step?.get("name") == step_name })
}

/** `<workflow>#<job>` -> declared `timeout-minutes`, for every job that declares one. */
fn workflow_job_timeouts(
  fs: HarnessFs,
  root: string,
  workflows: list<string>,
) -> dict<string, int> {
  let timeouts: dict<string, int> = {}
  for workflow in workflows {
    const document = yaml_parse(fs.read_text(path_join(root, workflow)))
    for job in (document?.get("jobs") ?? {}).keys() {
      const declared = to_int(document?.get("jobs")?.get(job)?.get("timeout-minutes") ?? "")
      if declared != nil {
        timeouts["${workflow}#${job}"] = declared ?? 0
      }
    }
  }
  return timeouts
}

/**
 * Which modes arm the credential refresher, read from the workflow itself.
 *
 * The refresher used to be armed for `ship-pr` alone, and a `prepare` run died
 * on a 401 at sixty-five minutes because of it. Reading the arming back out of
 * the step is what makes that regression fail here instead of there.
 */
fn credential_refresher_modes(document: any) -> list<string> {
  const step = workflow_step(document, "release", "Run release harness")
  if step == nil {
    return []
  }
  const run = to_string(step?.get("run") ?? "")
  if !contains(run, "refresh_hosted_release_credentials.sh") {
    return []
  }
  const condition = to_string(step?.get("if") ?? "")
  if condition == "" {
    return ["audit", "prepare", "ship-pr"]
  }
  return ["audit", "prepare", "ship-pr"].filter({ mode -> return contains(condition, mode) })
    .to_list()
}

/** The remint interval the workflow actually sleeps between refreshes. */
fn credential_refresh_interval_s(document: any) -> int? {
  const step = workflow_step(document, "release", "Run release harness")
  const matched = regex_captures(
    "(?m)^\\s*sleep\\s+([0-9]+)\\s*$",
    to_string(step?.get("run") ?? ""),
  )
  if len(matched) == 0 {
    return nil
  }
  return to_int(matched[0].groups[0] ?? "")
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const inputs: ReleaseLaunchInputs = {
    mode: trim(options.mode),
    bump: trim(options.bump),
    prerelease_identifier: options.preid,
    at_sha: options.at_sha,
    repositories_json: options.repositories_json,
    skip_consumers: options.skip_consumers,
    consumer_proof_runs_json: options.consumer_proof_runs_json,
  }
  let checks: list<PreflightPrecondition> = release_input_preconditions(inputs)
  const root = release_harness_root(harness.fs)
  const registry = read_profile_registry(harness.fs, root)
  const profile = registry.profiles.get(options.token_profile)
  if profile == nil {
    checks = checks
      + [
        preflight_fail(
          "token.profile",
          "unknown token profile ${options.token_profile}",
          "name one of " + join(registry.profiles.keys().sort(), ", "),
        ),
      ]
  }
  const requested = (profile ?? {permissions: {}, repository_names: nil}).permissions
  // Structural: the workflow's own inline mint against the registry.
  const hosted = yaml_parse(harness.fs.read_text(path_join(root, HOSTED_RELEASE_WORKFLOW)))
  for binding in registry.workflow_mints {
    if binding.profile != options.token_profile {
      continue
    }
    const step = workflow_step(hosted, binding.job, binding.step)
    checks = checks
      + [
        workflow_mint_precondition(
          binding.workflow,
          binding.step,
          binding.profile,
          registry.profiles.get(binding.profile)?.permissions ?? {},
          if step == nil {
            nil
          } else {
            step?.get("with") ?? {}
          },
        ),
      ]
  }
  // Structural: the phase-budget registry against the ceilings that enforce it.
  const drift = release_phase_budget_drift(
    workflow_job_timeouts(
      harness.fs,
      root,
      [HOSTED_RELEASE_WORKFLOW, ".github/workflows/fleet-projection-convergence.yml"],
    ),
  )
  checks = checks
    + [
      if len(drift) == 0 {
        preflight_pass(
          "phases.budgets",
          "every declared phase budget matches the workflow ceiling that enforces it",
        )
      } else {
        preflight_fail(
          "phases.budgets",
          join(drift, "; "),
          "reconcile lib/release_phase_budgets.harn with the workflow's timeout-minutes",
        )
      },
    ]
  // Structural: the credential arming this workflow declares, against the
  // declared mint ceiling. Answerable with no credential, which is the point --
  // a pull request that narrows the arming fails here.
  const refresher_modes = credential_refresher_modes(hosted)
  const refresh_interval = credential_refresh_interval_s(hosted)
  checks = checks
    + [
      if refresh_interval == nil {
        preflight_fail(
          "credentials.refresh",
          "the hosted release workflow arms no measurable credential refresh interval",
          "restore the refresher loop in the 'Run release harness' step",
        )
      } else {
        credential_refresh_precondition(
          inputs.mode,
          RELEASE_CREDENTIAL_LIFETIME_S,
          refresh_interval ?? 0,
          refresher_modes,
        )
      },
    ]
  // Credentialed: the mint itself, through the production mint path.
  const has_credentials = (env_str(harness.env, "RELEASE_APP_CLIENT_ID") ?? "") != ""
    && (env_str(harness.env, "RELEASE_APP_PRIVATE_KEY") ?? "") != ""
  if options.offline || !has_credentials {
    const reason = if options.offline {
      "not asked: --offline"
    } else {
      "not asked: no release App credentials in this context"
    }
    checks = checks
      + [
        preflight_unavailable("token.permissions", reason),
        preflight_unavailable("token.lifetime", reason),
      ]
    checks = checks
      + [
        consumer_contract_check(
          harness.fs,
          harness.process,
          env_str(harness.env, "HARN_BIN") ?? "harn",
          root,
          inputs.mode,
          options.repositories_json,
          false,
        ),
      ]
  } else {
    const described = harness.process.run(
      {
        program: "node",
        args: [path_join(root, "scripts", "mint_github_app_installation_token.mjs"), "--describe"],
        env: {RELEASE_APP_TOKEN_PROFILE: options.token_profile},
        cwd: root,
      },
    )
    if (described.exit_code ?? 1) != 0 {
      checks = checks
        + [
          preflight_fail(
            "token.permissions",
            "could not mint an installation token for profile ${options.token_profile}: "
              + trim(described.stderr ?? ""),
            "check the release App credentials and the installation",
          ),
          preflight_unavailable("token.lifetime", "not asked: the mint failed"),
        ]
    } else {
      checks = checks
        + token_description_preconditions(
          options.token_profile,
          requested,
          json_parse(described.stdout ?? ""),
          RELEASE_CREDENTIAL_LIFETIME_S,
          refresh_interval ?? RELEASE_CREDENTIAL_REFRESH_INTERVAL_S,
        )
    }
    checks = checks
      + [
        consumer_contract_check(
          harness.fs,
          harness.process,
          env_str(harness.env, "HARN_BIN") ?? "harn",
          root,
          inputs.mode,
          options.repositories_json,
          true,
        ),
      ]
  }
  const receipt = release_launch_preflight_receipt(inputs, options.token_profile, checks)
  for line in release_launch_preflight_lines(receipt) {
    harness.stdio.println(line)
  }
  const rendered = json_stringify_pretty(receipt)
  if trim(options.receipt) != "" {
    harness.fs.write_text(trim(options.receipt), rendered + "\n")
  }
  harness.stdio.eprintln(rendered)
  return if receipt.ok {
    0
  } else {
    1
  }
}

/**
 * Run the publication-time consumer contract gate against live consumer mains.
 *
 * This is the same `check_fleet_policy.harn` the hosted release runs before
 * publication, invoked the same way, so a drift it would refuse on is a drift
 * this refuses on. Running the gate itself rather than a summary of it is the
 * point: a preflight that agreed with the gate by construction would prove
 * nothing about the gate.
 */
fn consumer_contract_check(
  fs: HarnessFs,
  process: HarnessProcess,
  harn_bin: string,
  root: string,
  mode: string,
  repositories_json: string,
  reachable: bool,
) -> PreflightPrecondition {
  if !reachable {
    return preflight_unavailable(
      "consumers.contracts",
      "not asked: this context holds no credential for reading consumer contracts",
    )
  }
  if mode != "ship-pr" {
    // The contract gates publication, and only ship-pr publishes. Saying so is
    // not the same as passing: a mode that never asks must not read like one
    // that asked and liked the answer.
    return preflight_unavailable(
      "consumers.contracts",
      "not asked: consumer contracts gate publication, which ${mode} does not reach",
    )
  }
  let args = ["run", "--no-sandbox", path_join(root, "check_fleet_policy.harn")]
  if trim(repositories_json) != "" {
    args = args + ["--", "--repositories-json", trim(repositories_json)]
  }
  const result = process.run({program: harn_bin, args: args, cwd: root})
  // Keep the gate's own document, not just this verdict. The receipt names
  // which repository drifted; the document says in what bytes, and a run that
  // refused is exactly when someone wants the second answer.
  const receipt_dir = path_join(root, ".harn-runs")
  fs.mkdir(receipt_dir, true)
  fs.write_text(
    path_join(receipt_dir, "prepublication-fleet-policy.json"),
    trim(result.stdout ?? "") + "\n",
  )
  const failures = split(trim(result.stderr ?? ""), "\n").filter(
    { line -> return trim(line) != "" && !starts_with(trim(line), "note:") },
  )
    .to_list()
  return consumer_contract_precondition((result.exit_code ?? 1) == 0, failures)
}
