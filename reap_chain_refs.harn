#!/usr/bin/env harn
import { help_requested } from "std/cli/argparse"
import {
  ChainRefReapReceipt,
  chain_ref_reap_adapter,
  run_chain_ref_reap_with_adapter,
} from "lib/chain_ref_reap"
import { cli_options } from "lib/cli_options"
import { ensure_unrestricted_sandbox } from "lib/sandbox_preflight"

pub type ChainRefReapCliOptions = {repo: string, apply: bool, yes_delete_refs: bool, json: bool}

const ARG_SPEC = {
  name: "reap-chain-refs",
  args: [
    {kind: "flag", name: "repo", long: "--repo", default: ""},
    {kind: "switch", name: "apply", long: "--apply"},
    {kind: "switch", name: "yes_delete_refs", long: "--yes-delete-refs"},
    {kind: "switch", name: "json", long: "--json"},
  ],
}

pub fn parse_chain_ref_reap_args(args: list<string>) -> ChainRefReapCliOptions {
  const parsed = cli_options<ChainRefReapCliOptions>(
    ARG_SPEC,
    args,
    schema_of(ChainRefReapCliOptions),
  )
  if parsed.apply && !parsed.yes_delete_refs {
    throw "--apply requires --yes-delete-refs"
  }
  return parsed
}

fn usage() {
  return """
Usage:
  harn run --no-sandbox reap_chain_refs.harn
  harn run --no-sandbox reap_chain_refs.harn -- --apply --yes-delete-refs

Inventories every `refs/heads/harn-update-chain/<chain id>` lease on the fleet
repository and deletes only the ones whose every owning run reached a terminal
conclusion. A chain with a live run, an unreadable run list, or no resolvable
run at all is retained with an explicit reason. The default is a dry run.

The receipt separates a read that found no refs from a read that failed: the
first is `inventory: read` with `examined_count: 0`, the second is
`inventory: unreadable` and a blocked state.

Flags:
  --repo PATH         Fleet checkout whose `origin` is inventoried (default: cwd).
  --apply             Apply the planned deletions; default is dry-run.
  --yes-delete-refs   Required with --apply.
  --json              Print the complete machine-readable receipt.
"""
}

fn report(stdio: HarnessStdio, receipt: ChainRefReapReceipt) {
  stdio.println("== chain ref reap: ${receipt.state} (${receipt.mode})")
  if receipt.inventory == "unreadable" {
    stdio.println("   inventory : UNREADABLE -- " + trim(receipt.inventory_failure ?? ""))
    stdio.println("   this is not the same as finding zero chain refs")
    return
  }
  stdio.println("   examined  : ${receipt.examined_count}")
  stdio.println("   planned   : ${receipt.planned_count}")
  stdio.println("   cleared   : ${receipt.cleared_count}")
  stdio.println("   retained  : ${receipt.retained_count}")
  stdio.println("   failed    : ${receipt.failed_count}")
  if receipt.examined_count == 0 {
    stdio.println("   the remote was read and holds no chain lease")
  }
  for row in receipt.refs {
    stdio.println("   ${row.outcome} ${row.ref} [${row.reason_code}]: ${row.message}")
  }
}

pipeline main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(usage())
    return 0
  }
  const sandbox_error = ensure_unrestricted_sandbox(
    {stdio: harness.stdio, system: harness.system},
    "reap_chain_refs.harn",
  )
  if sandbox_error != nil {
    return sandbox_error
  }
  const parsed = parse_chain_ref_reap_args(argv)
  const repo = if trim(parsed.repo) != "" {
    parsed.repo
  } else {
    harness.fs.cwd()
  }
  const receipt = run_chain_ref_reap_with_adapter(
    if parsed.apply {
      "apply"
    } else {
      "dry_run"
    },
    chain_ref_reap_adapter(harness, repo),
    to_int(date_parse(harness.clock.date_iso())) ?? 0,
  )
  if parsed.json {
    harness.stdio.println(json_stringify(receipt))
  } else {
    report(harness.stdio, receipt)
  }
  return if receipt.state == "blocked" {
    2
  } else {
    0
  }
}
