#!/usr/bin/env harn
// Daily read-only branch inventory. A missing PR is an observation, not a
// claim that work is abandoned or permission to create a cleanup task.
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { read_fleet_manifest } from "lib/fleet_manifest"
import {
  BranchInventoryRequest,
  PRIVATE_NAMES_ENV,
  branch_audit_exit_code,
  branch_audit_summary,
  collect_branch_inventory,
} from "lib/prless_branch_audit"

type BranchAuditOptions = {only?: string, fail_on_findings: bool}

const ARG_SPEC: ParserSpec = {
  name: "check-prless-branches",
  args: [
    {kind: "flag", name: "only", long: "--only"},
    {kind: "switch", name: "fail_on_findings", long: "--fail-on-findings"},
  ],
}

fn main(harness: Harness) {
  const options = cli_options<BranchAuditOptions>(ARG_SPEC, argv, schema_of(BranchAuditOptions))
  const manifest = read_fleet_manifest(harness.fs)
  const slugs = manifest.repositories.filter(
    { repo -> options.only == nil || repo.slug == options.only },
  )
    .map({ repo -> repo.slug })
    .to_list()
  const request: BranchInventoryRequest = {
    repositories: slugs,
    default_branch: manifest.fleet.default_branch,
    private_names: harness.env.get_or(PRIVATE_NAMES_ENV, ""),
  }
  const observed = try {
    collect_branch_inventory(harness, request)
  }
  if is_err(observed) {
    harness.stdio.eprintln("error: " + to_string(unwrap_err(observed)))
    return 2
  }
  const receipt = unwrap(observed)
  harness.stdio.println(json_stringify_pretty(receipt))
  const summary_path = harness.env.get_or("GITHUB_STEP_SUMMARY", "")
  if summary_path != "" {
    harness.fs.write_text(summary_path, branch_audit_summary(receipt))
  }
  for row in receipt.repositories {
    if row.state == "measurement_failed" {
      harness.stdio.eprintln("UNMEASURED ${row.slug}: ${row.detail}")
    } else {
      harness.stdio.eprintln(
        "BRANCH INVENTORY ${row.slug}: ${to_string(row.prless_branch_count ?? 0)} without a PR, "
          + "${to_string(row.merged_branch_count ?? 0)} merged, "
          + "${to_string(row.content_merged_branch_count ?? 0)} content-merged, "
          + "${to_string(row.unmerged_branch_count ?? 0)} differing, "
          + "${to_string(row.undetermined_branch_count ?? 0)} undetermined; "
          + "${to_string(row.merge_queue_ref_count ?? 0)} merge-queue ref(s) excluded",
      )
    }
  }
  return branch_audit_exit_code(receipt, options.fail_on_findings)
}
