#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { fleet_convergence_snapshot } from "lib/fleet_convergence"
import { read_fleet_manifest, scoped_harn_bump_repositories } from "lib/fleet_manifest"
import { github_latest_release_tag } from "lib/github"

type Options = {target?: string, timeout_s: int, interval_s: int, only?: string}

const ARG_SPEC: ParserSpec = {
  name: "wait-fleet-convergence",
  args: [
    {kind: "positional", name: "target", required: false},
    {kind: "flag", name: "timeout_s", long: "--timeout-s", parse: "int", default: 7200},
    {kind: "flag", name: "interval_s", long: "--interval-s", parse: "int", default: 30},
    {kind: "flag", name: "only", long: "--only"},
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if options.timeout_s < 1 || options.interval_s < 1 {
    throw "Harn update timeout and interval must be positive"
  }
  const target = options.target ?? github_latest_release_tag(harness, "burin-labs/harn")
  const repositories = scoped_harn_bump_repositories(read_fleet_manifest(harness.fs), options.only)
  const started = harness.clock.now_ms()
  const stop_at = started + options.timeout_s * 1000
  let snapshot = fleet_convergence_snapshot(harness, repositories, target)
  while !snapshot.complete && !snapshot.terminal && harness.clock.now_ms() < stop_at {
    harness.clock.sleep_ms(options.interval_s * 1000)
    snapshot = fleet_convergence_snapshot(harness, repositories, target)
  }
  const receipt = {
    schema_version: "harn_bump_fleet.harn_update.v1",
    scope: if options.only == nil {
      {kind: "fleet"}
    } else {
      {kind: "repository", repository: options.only}
    },
    observed_at: harness.clock.date_iso(),
    elapsed_ms: harness.clock.now_ms() - started,
    ...snapshot,
  }
  harness.stdio.println(json_stringify_pretty(receipt))
  return if snapshot.complete {
    0
  } else {
    1
  }
}
