#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { hydrate_remote_consumer_repositories } from "lib/consumer_projection_manifest"
import { fleet_convergence_snapshot_with_continuation } from "lib/fleet_convergence"
import { fleet_dispatch_continuation_read } from "lib/fleet_dispatch_continuation"
import { fleet_dispatch_scope } from "lib/fleet_dispatch_continuation"
import { read_fleet_manifest, scoped_harn_bump_repositories } from "lib/fleet_manifest"
import { require_fleet_scope_census } from "lib/fleet_operation_scope"
import { github_latest_release_tag } from "lib/github"

type Options = {
  target?: string,
  timeout_s: int,
  interval_s: int,
  only?: string,
  repositories_json?: string,
  continuation_receipt: string,
}

const ARG_SPEC: ParserSpec = {
  name: "wait-fleet-convergence",
  args: [
    {kind: "positional", name: "target", required: false},
    {kind: "flag", name: "timeout_s", long: "--timeout-s", parse: "int", default: 7200},
    {kind: "flag", name: "interval_s", long: "--interval-s", parse: "int", default: 30},
    {kind: "flag", name: "only", long: "--only"},
    {kind: "flag", name: "repositories_json", long: "--repositories-json"},
    {kind: "flag", name: "continuation_receipt", long: "--continuation-receipt", default: ""},
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if options.timeout_s < 1 || options.interval_s < 1 {
    throw "Harn update timeout and interval must be positive"
  }
  const target = options.target ?? github_latest_release_tag(harness, "burin-labs/harn")
  const manifest = read_fleet_manifest(harness.fs)
  const repositories = hydrate_remote_consumer_repositories(
    harness,
    manifest,
    scoped_harn_bump_repositories(manifest, options.only, options.repositories_json),
    manifest.fleet.default_branch,
  )
  const continuation = fleet_dispatch_continuation_read(harness.fs, options.continuation_receipt)
  if continuation != nil
    && continuation.scope != fleet_dispatch_scope(options.only, options.repositories_json) {
    throw "convergence continuation scope mismatch"
  }
  const started = harness.clock.now_ms()
  const stop_at = started + options.timeout_s * 1000
  let snapshot = fleet_convergence_snapshot_with_continuation(
    harness,
    manifest,
    repositories,
    target,
    continuation,
  )
  while !snapshot.complete && !snapshot.terminal && harness.clock.now_ms() < stop_at {
    harness.clock.sleep_ms(options.interval_s * 1000)
    snapshot = fleet_convergence_snapshot_with_continuation(
      harness,
      manifest,
      repositories,
      target,
      continuation,
    )
  }
  require_fleet_scope_census(
    repositories.map({ repo -> repo.slug }).to_list(),
    snapshot.repositories.map({ row -> row.repo }).to_list(),
  )
  const receipt = {
    schema_version: "harn_bump_fleet.harn_update.v1",
    scope: fleet_dispatch_scope(options.only, options.repositories_json),
    observed_at: harness.clock.date_iso(),
    elapsed_ms: harness.clock.now_ms() - started,
    ...snapshot,
  }
  harness.stdio.println(json_stringify_pretty(receipt))
  return if snapshot.complete {
    0
  } else {
    1
  }
}
