#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { env_str } from "std/config"
import { cli_options } from "lib/cli_options"
import {
  HOSTED_RELEASE_LANE_CLEANUP_PATH,
  HOSTED_RELEASE_WORKFLOW_NAME,
  HOSTED_RELEASE_WORKFLOW_PATH,
  HOSTED_RELEASE_WORKFLOW_REPO,
  HostedReleaseLaneCleanupRequest,
  cleanup_cancelled_hosted_release_lane,
  hosted_release_lane_claim_read,
  hosted_release_lane_cleanup_options,
  hosted_release_lane_cleanup_write,
  live_hosted_release_lane_cleanup_adapter,
} from "lib/hosted_release_lane_cleanup"

type Options = {
  workflow_run_id: int,
  workflow_run_attempt: int,
  workflow_head_sha: string,
  claim_receipt: string,
  artifact_outcome: string,
  receipt_out: string,
  apply: bool,
  yes_live_release: bool,
}

const ARG_SPEC: ParserSpec = {
  name: "cleanup-cancelled-hosted-release",
  args: [
    {kind: "flag", name: "workflow_run_id", long: "--workflow-run-id", parse: "int"},
    {kind: "flag", name: "workflow_run_attempt", long: "--workflow-run-attempt", parse: "int"},
    {kind: "flag", name: "workflow_head_sha", long: "--workflow-head-sha", default: ""},
    {kind: "flag", name: "claim_receipt", long: "--claim-receipt", default: ""},
    {kind: "flag", name: "artifact_outcome", long: "--artifact-outcome", default: ""},
    {
      kind: "flag",
      name: "receipt_out",
      long: "--receipt-out",
      default: HOSTED_RELEASE_LANE_CLEANUP_PATH,
    },
    {kind: "switch", name: "apply", long: "--apply"},
    {kind: "switch", name: "yes_live_release", long: "--yes-live-release"},
  ],
}

pipeline main(harness: Harness) -> int {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if !options.apply || !options.yes_live_release {
    harness.stdio.eprintln("terminal hosted lane cleanup requires --apply --yes-live-release")
    return 2
  }
  const workflow_token = env_str(harness.env, "HOSTED_WORKFLOW_TOKEN") ?? ""
  const release_token = env_str(harness.env, "HOSTED_RELEASE_TOKEN") ?? ""
  const claim = if trim(options.claim_receipt) == "" {
    nil
  } else {
    hosted_release_lane_claim_read(harness.fs, options.claim_receipt)
  }
  const request: HostedReleaseLaneCleanupRequest = {
    workflow_repo: HOSTED_RELEASE_WORKFLOW_REPO,
    workflow_name: HOSTED_RELEASE_WORKFLOW_NAME,
    workflow_path: HOSTED_RELEASE_WORKFLOW_PATH,
    workflow_run_id: options.workflow_run_id,
    workflow_run_attempt: options.workflow_run_attempt,
    workflow_head_sha: lowercase(trim(options.workflow_head_sha)),
    artifact_outcome: lowercase(trim(options.artifact_outcome)),
    updated_at: harness.clock.date_iso(),
  }
  const adapter = live_hosted_release_lane_cleanup_adapter(
    harness,
    hosted_release_lane_cleanup_options(workflow_token),
    hosted_release_lane_cleanup_options(release_token),
  )
  const result = cleanup_cancelled_hosted_release_lane(request, claim, adapter)
  hosted_release_lane_cleanup_write(
    {fs: harness.fs, random: harness.random},
    options.receipt_out,
    result,
  )
  harness.stdio.println(json_stringify_pretty(result))
  return if result.decision == "rejected" {
    1
  } else {
    0
  }
}
