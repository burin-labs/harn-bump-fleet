#!/usr/bin/env harn
//
// One scheduled fan-out for every repository that consumes Harn. Repository
// workflows remain manually dispatchable adapters; fleet.toml owns membership.
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { FleetRepository, harn_bump_repositories, read_fleet_manifest } from "lib/fleet_manifest"
import { github_latest_release_tag, github_workflow_dispatch } from "lib/github"

const HARN_REPO = "burin-labs/harn"

pub type DispatchFleetOptions = {target?: string, dry_run: bool, only?: string}

const ARG_SPEC: ParserSpec = {
  name: "dispatch-bump-fleet",
  args: [
    {kind: "positional", name: "target", required: false},
    {kind: "switch", name: "dry_run", long: "--dry-run"},
    {kind: "flag", name: "only", long: "--only"},
  ],
}

pub fn parse_dispatch_fleet_args(args: list<string>) -> DispatchFleetOptions {
  return cli_options<DispatchFleetOptions>(ARG_SPEC, args, schema_of(DispatchFleetOptions))
}

pub fn dispatch_targets(fs: HarnessFs, only: string? = nil) -> list<FleetRepository> {
  const declared = harn_bump_repositories(read_fleet_manifest(fs))
  if only == nil {
    return declared
  }
  return declared.filter({ repo -> repo.slug == only || repo.directory == only }).to_list()
}

pipeline main(harness: Harness) {
  const options = parse_dispatch_fleet_args(argv)
  const target = options.target ?? github_latest_release_tag(harness, HARN_REPO)
  if len(regex_captures("^v[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$", target)) == 0 {
    harness.stdio.eprintln("error: target must be an exact Harn tag, got '${target}'")
    return 2
  }
  const repositories = dispatch_targets(harness.fs, options.only)
  if len(repositories) == 0 {
    harness.stdio.eprintln("error: no harn_bump repository matched '${options.only ?? ""}'")
    return 1
  }
  let results = []
  let failed = false
  for repo in repositories {
    if options.dry_run {
      results = results + [{repo: repo.slug, target: target, status: "planned"}]
      continue
    }
    const dispatched = github_workflow_dispatch(
      harness,
      repo.slug,
      "bump-harn.yml",
      {version: target},
    )
    if is_err(dispatched) {
      failed = true
      results = results
        + [
          {
            repo: repo.slug,
            target: target,
            status: "failed",
            error: to_string(unwrap_err(dispatched)),
          },
        ]
    } else {
      const run = unwrap(dispatched)
      results = results
        + [
          {
            repo: repo.slug,
            target: target,
            status: "dispatched",
            run_id: run.run_id,
            run_url: run.url,
          },
        ]
    }
  }
  const receipt = {
    schema_version: "harn_bump_fleet.dispatch.v1",
    target: target,
    dry_run: options.dry_run,
    repositories: results,
  }
  harness.stdio.println(json_stringify_pretty(receipt))
  return if failed {
    1
  } else {
    0
  }
}
