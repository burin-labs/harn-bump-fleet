#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { harn_package_repositories, read_fleet_manifest } from "lib/fleet_manifest"
import {
  package_test_compatibility_passed,
  package_test_compatibility_scan,
} from "lib/package_test_compatibility"

type Options = {fleet_root: string, harn_bin: string, receipt_out: string}

const ARG_SPEC: ParserSpec = {
  name: "preflight-package-test-compatibility",
  args: [
    {kind: "flag", name: "fleet_root", long: "--fleet-root", required: true},
    {kind: "flag", name: "harn_bin", long: "--harn-bin", required: true},
    {kind: "flag", name: "receipt_out", long: "--receipt-out", required: true},
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const receipt = package_test_compatibility_scan(
    {fs: harness.fs, process: harness.process},
    harn_package_repositories(read_fleet_manifest(harness.fs)),
    options.fleet_root,
    options.harn_bin,
    dirname(options.receipt_out),
  )
  harness.fs.write_text(options.receipt_out, json_stringify_pretty(receipt) + "\n")
  harness.stdio.println(json_stringify_pretty(receipt))
  return if package_test_compatibility_passed(receipt) {
    0
  } else {
    1
  }
}
