import { FleetFileProjection } from "../lib/fleet_manifest"
import { source_head_from_commits } from "../lib/github_source_head"
import {
  ProjectionSourceObservation,
  clean_source_record_writes,
  consumers_of_source,
  converged_source_commits,
  declared_projection_sources,
  plan_projection_source_drift,
  projection_source_index,
  projection_source_ref,
  projection_source_ref_index,
  projection_source_ref_rows,
  sources_proved_clean,
} from "../lib/projection_source_drift"

const GUARD_SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const GUARD_MOVED = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const CONTRACT_SHA = "cccccccccccccccccccccccccccccccccccccccc"

fn projection(source_path: string, target_slug: string) -> FleetFileProjection {
  return {
    source_slug: "burin-labs/harn",
    source_path: source_path,
    target_slug: target_slug,
    target_path: source_path,
  }
}

/** Two sources in one source repository, read by different consumer sets. */
fn projections() -> list<FleetFileProjection> {
  return [
    projection("scripts/agent_shell_guard.harn", "burin-labs/burin-code"),
    projection("scripts/agent_shell_guard.harn", "burin-labs/harn-cloud"),
    projection("docs/shared-contract.md", "burin-labs/harn-cloud"),
  ]
}

fn observed(path: string, head: string) -> ProjectionSourceObservation {
  return {slug: "burin-labs/harn", path: path, head: head, resolved: true, detail: ""}
}

fn unreadable(path: string, detail: string) -> ProjectionSourceObservation {
  return {slug: "burin-labs/harn", path: path, head: "", resolved: false, detail: detail}
}

/** Every source recorded at the head it currently has. */
fn all_converged() -> dict {
  return converged_source_commits(
    [
      projection_source_ref(
        {slug: "burin-labs/harn", path: "scripts/agent_shell_guard.harn"},
        GUARD_SHA,
      ),
      projection_source_ref(
        {slug: "burin-labs/harn", path: "docs/shared-contract.md"},
        CONTRACT_SHA,
      ),
    ],
  )
}

pipeline test_a_moved_source_converges_exactly_its_own_consumers() {
  // The falsifier for the whole change. One source moved and one did not, in
  // the same source repository. Dispatching for the repository rather than for
  // the path would name a consumer that reads only the file that stayed put.
  const plan = plan_projection_source_drift(
    projections(),
    [
      observed("scripts/agent_shell_guard.harn", GUARD_MOVED),
      observed("docs/shared-contract.md", CONTRACT_SHA),
    ],
    all_converged(),
  )
  assert_eq(plan.dispatch, true)
  assert_eq(plan.consumers, ["burin-labs/burin-code", "burin-labs/harn-cloud"])
  assert_eq(plan.moved_count, 1)
  assert_eq(plan.unknown_count, 0)
  assert_eq(plan.converged_count, 1)
}

pipeline test_a_source_only_one_consumer_reads_converges_only_that_consumer() {
  // The same shape with the other file moving, so a plan that happened to name
  // every consumer could not pass both.
  const plan = plan_projection_source_drift(
    projections(),
    [
      observed("scripts/agent_shell_guard.harn", GUARD_SHA),
      observed("docs/shared-contract.md", GUARD_MOVED),
    ],
    all_converged(),
  )
  assert_eq(plan.consumers, ["burin-labs/harn-cloud"])
  assert_eq(plan.moved_count, 1)
}

pipeline test_an_unmoved_fleet_dispatches_nothing() {
  // The negative control. An unrelated file changing in a source repository
  // moves no declared source, which is indistinguishable here from nothing
  // happening at all: neither may dispatch.
  const plan = plan_projection_source_drift(
    projections(),
    [
      observed("scripts/agent_shell_guard.harn", GUARD_SHA),
      observed("docs/shared-contract.md", CONTRACT_SHA),
    ],
    all_converged(),
  )
  assert_eq(plan.dispatch, false)
  assert_eq(plan.consumers, [])
  assert_eq(plan.converged_count, 2)
}

pipeline test_an_unresolvable_head_converges_rather_than_reading_as_unmoved() {
  // A source whose head could not be read is the silence this whole module
  // exists to refuse. Treating it as unmoved would make an outage of the read
  // path look exactly like a quiet fleet.
  const plan = plan_projection_source_drift(
    projections(),
    [
      unreadable("scripts/agent_shell_guard.harn", "404 from the source repository"),
      observed("docs/shared-contract.md", CONTRACT_SHA),
    ],
    all_converged(),
  )
  assert_eq(plan.dispatch, true)
  assert_eq(plan.unknown_count, 1)
  assert_eq(plan.moved_count, 0)
  assert_eq(plan.consumers, ["burin-labs/burin-code", "burin-labs/harn-cloud"])
  assert_eq(plan.decisions[0]?.state ?? "", "unknown")
  assert_eq(
    contains(plan.decisions[0]?.detail ?? "", "404 from the source repository"),
    true,
    "an unknown source must say why it could not be read",
  )
}

pipeline test_a_source_never_observed_at_all_converges() {
  // Not the same silence as an unreadable head: here the observation is
  // missing entirely, which is what a reader that skipped a source produces.
  const plan = plan_projection_source_drift(
    projections(),
    [observed("docs/shared-contract.md", CONTRACT_SHA)],
    all_converged(),
  )
  assert_eq(plan.unknown_count, 1)
  assert_eq(plan.consumers, ["burin-labs/burin-code", "burin-labs/harn-cloud"])
}

pipeline test_a_source_with_no_record_converges() {
  // First run, a new projection, or a reaped ref. There is no evidence of
  // convergence, so there is no convergence.
  const plan = plan_projection_source_drift(
    projections(),
    [
      observed("scripts/agent_shell_guard.harn", GUARD_SHA),
      observed("docs/shared-contract.md", CONTRACT_SHA),
    ],
    {},
  )
  assert_eq(plan.unknown_count, 2)
  assert_eq(plan.moved_count, 0)
  assert_eq(plan.dispatch, true)
}

pipeline test_a_source_recorded_twice_is_unknown_not_whichever_ref_sorted_first() {
  // A run that claimed a new record and failed to release the old leaves two.
  // Reading either one would report a convergence nobody can vouch for.
  const commits = converged_source_commits(
    [
      projection_source_ref(
        {slug: "burin-labs/harn", path: "scripts/agent_shell_guard.harn"},
        GUARD_SHA,
      ),
      projection_source_ref(
        {slug: "burin-labs/harn", path: "scripts/agent_shell_guard.harn"},
        GUARD_MOVED,
      ),
      projection_source_ref(
        {slug: "burin-labs/harn", path: "docs/shared-contract.md"},
        CONTRACT_SHA,
      ),
    ],
  )
  const plan = plan_projection_source_drift(
    projections(),
    [
      observed("scripts/agent_shell_guard.harn", GUARD_SHA),
      observed("docs/shared-contract.md", CONTRACT_SHA),
    ],
    commits,
  )
  assert_eq(plan.unknown_count, 1)
  assert_eq(plan.converged_count, 1)
  assert_eq(plan.consumers, ["burin-labs/burin-code", "burin-labs/harn-cloud"])
}

pipeline test_a_ref_outside_the_namespace_is_not_read_as_a_record() {
  // The listing is a whole-namespace read, and a foreign ref that parsed would
  // silently mark a source converged.
  assert_eq(projection_source_ref_index("refs/heads/main"), nil)
  assert_eq(
    projection_source_ref_index(
      "refs/heads/projection-source-converged/burin-labs__harn/short.${GUARD_SHA}",
    ),
    nil,
  )
  assert_eq(
    projection_source_ref_index(
      "refs/heads/rehearsal-inputs-proved/${GUARD_SHA}/burin-labs__burin-code.abcdef012345",
    ),
    nil,
  )
  const parsed = projection_source_ref_index(
    projection_source_ref({slug: "burin-labs/harn", path: "docs/shared-contract.md"}, CONTRACT_SHA),
  )
  assert_eq((parsed ?? {index: "", commit: ""}).commit, CONTRACT_SHA)
}

pipeline test_sources_and_consumers_are_enumerated_once_each() {
  const sources = declared_projection_sources(projections())
  assert_eq(len(sources), 2)
  assert_eq(
    consumers_of_source(
      projections(),
      {slug: "burin-labs/harn", path: "scripts/agent_shell_guard.harn"},
    ),
    ["burin-labs/burin-code", "burin-labs/harn-cloud"],
  )
  assert_eq(
    consumers_of_source(projections(), {slug: "burin-labs/harn", path: "docs/shared-contract.md"}),
    ["burin-labs/harn-cloud"],
  )
}

pipeline test_an_empty_commit_listing_is_an_absent_path_not_an_unchanged_one() {
  // A path-filtered listing returns an empty array for a path that does not
  // exist on the branch. Reading that as "no new commit" would report the
  // source unchanged forever, which is the silence this comparison refuses.
  const absent = source_head_from_commits([], "burin-labs/harn", "docs/gone.md", "main")
  assert_eq(is_err(absent), true)
  assert_eq(to_string(unwrap_err(absent)?.code ?? ""), "path_absent")
  // `regex_captures` returns match objects, so a caller that misreads its
  // shape behaves exactly like a no-match. This site decides whether a head is
  // usable at all, and a wrong read here would refuse every source.
  const found = source_head_from_commits(
    [{sha: GUARD_SHA}],
    "burin-labs/harn",
    "scripts/agent_shell_guard.harn",
    "main",
  )
  assert_eq(is_err(found), false)
  assert_eq(unwrap(found), GUARD_SHA)
  const unusable = source_head_from_commits(
    [{sha: "not-a-commit"}],
    "burin-labs/harn",
    "scripts/agent_shell_guard.harn",
    "main",
  )
  assert_eq(is_err(unusable), true)
  assert_eq(to_string(unwrap_err(unusable)?.code ?? ""), "invalid_response")
}

/** One source's observed head, keyed the way a record is. */
fn head_of(source: {slug: string, path: string}, head: string) -> dict {
  let heads = {}
  heads[projection_source_index(source)] = head
  return heads
}

fn result(slug: string, status: string) -> {slug: string, status: string} {
  return {slug: slug, status: status}
}

fn all_consumers() -> list<string> {
  return ["burin-labs/burin-code", "burin-labs/harn-cloud"]
}

pipeline test_only_a_clean_consumer_proves_its_sources() {
  // The falsifier for who owns the record. A dispatch being accepted says a
  // run started. `applied` and `pending` say a repair was PROPOSED, and a
  // proposal that never merges leaves the consumer exactly as stale as it was.
  // Recording on either would report a convergence a pull request still owes.
  const clean = sources_proved_clean(
    projections(),
    all_consumers(),
    [result("burin-labs/burin-code", "clean"), result("burin-labs/harn-cloud", "clean")],
  )
  assert_eq(len(clean), 2)
  for status in ["applied", "pending", "drift", "error"] {
    assert_eq(
      sources_proved_clean(
        projections(),
        all_consumers(),
        [result("burin-labs/burin-code", status), result("burin-labs/harn-cloud", "clean")],
      ),
      [{slug: "burin-labs/harn", path: "docs/shared-contract.md"}],
      "only the source whose every consumer is clean may be recorded: ${status}",
    )
  }
}

pipeline test_a_run_that_did_not_look_at_every_consumer_records_nothing_for_that_source() {
  // A run narrowed by `--only` cannot vouch for a consumer it never read. The
  // shared source has two consumers and only one was in scope.
  const proved = sources_proved_clean(
    projections(),
    ["burin-labs/harn-cloud"],
    [result("burin-labs/harn-cloud", "clean")],
  )
  assert_eq(proved, [{slug: "burin-labs/harn", path: "docs/shared-contract.md"}])
}

pipeline test_a_failed_convergence_leaves_the_next_comparison_dispatching_again() {
  // Control's falsifier, end to end through both halves. The source moved, a
  // dispatch went out, and the run did not reach clean. Nothing is recorded,
  // so the next hour reads the OLD record against the NEW head and dispatches
  // again rather than reporting the fleet converged.
  const source = {slug: "burin-labs/harn", path: "scripts/agent_shell_guard.harn"}
  const before = converged_source_commits([projection_source_ref(source, GUARD_SHA)])
  const proved = sources_proved_clean(
    projections(),
    all_consumers(),
    [result("burin-labs/burin-code", "applied"), result("burin-labs/harn-cloud", "clean")],
  )
  const writes = clean_source_record_writes(proved, head_of(source, GUARD_MOVED), before)
  assert_eq(writes, [], "a convergence that only proposed a repair records nothing")
  const again = plan_projection_source_drift(
    projections(),
    [
      observed("scripts/agent_shell_guard.harn", GUARD_MOVED),
      observed("docs/shared-contract.md", CONTRACT_SHA),
    ],
    before,
  )
  assert_eq(again.dispatch, true)
  assert_eq(again.moved_count, 1)
  assert_eq(again.consumers, all_consumers())
}

pipeline test_a_clean_run_records_the_head_and_names_what_it_replaces() {
  const source = {slug: "burin-labs/harn", path: "scripts/agent_shell_guard.harn"}
  const writes = clean_source_record_writes(
    [source],
    head_of(source, GUARD_MOVED),
    converged_source_commits([projection_source_ref(source, GUARD_SHA)]),
  )
  assert_eq(len(writes), 1)
  assert_eq(writes[0]?.ref ?? "", projection_source_ref(source, GUARD_MOVED))
  assert_eq(
    writes[0]?.replaces ?? "",
    projection_source_ref(source, GUARD_SHA),
    "the superseded record is named so a run leaves exactly one per source",
  )
  // A head that could not be read records nothing. The empty string would
  // compare unequal to every later observation and re-converge for ever.
  assert_eq(clean_source_record_writes([source], {}, {}), [])
  // A first record replaces nothing, and an unchanged head writes nothing.
  const first = clean_source_record_writes([source], head_of(source, GUARD_SHA), {})
  assert_eq(first[0]?.replaces ?? "nope", "")
  assert_eq(
    clean_source_record_writes(
      [source],
      head_of(source, GUARD_SHA),
      converged_source_commits([projection_source_ref(source, GUARD_SHA)]),
    ),
    [],
  )
}

pipeline test_the_record_listing_drops_a_line_it_cannot_read_whole() {
  // The listing is how every record is read, so a half-read line is the
  // quietest way to lose one: a truncated ref compares unequal to its source
  // and re-converges those consumers, and a missing object id leaves the
  // superseded record unreleasable. Both are dropped rather than guessed at.
  const source = {slug: "burin-labs/harn", path: "scripts/agent_shell_guard.harn"}
  const ref = projection_source_ref(source, GUARD_MOVED)
  const oid = "1111111111111111111111111111111111111111"
  const rows = projection_source_ref_rows(
    join(
      [
        "${oid}\t${ref}",
        "${oid}\trefs/heads/main",
        "not-an-object-id\t${ref}",
        ref,
        "",
        "${oid}\trefs/heads/projection-source-converged/burin-labs__harn/nothex.${GUARD_SHA}",
      ],
      "\n",
    ),
  )
  assert_eq(len(rows), 1, "only the one whole line in our own namespace is a record")
  assert_eq(rows[0]?.ref ?? "", ref)
  assert_eq(rows[0]?.oid ?? "", oid, "the object id is read so the record can be released later")
  assert_eq(projection_source_ref_rows(""), [])
}
