import {
  equivalent_override_implementations,
  override_commit_tree,
  override_implementation_files,
} from "../lib/merge_override_implementation"
import {
  OVERRIDE_IMPLEMENTATION_PATH,
  OVERRIDE_TEMPLATE_PATH,
} from "../lib/merge_override_projection"

const COMMIT = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const TREE = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const OTHER = "cccccccccccccccccccccccccccccccccccccccc"

fn fixture_tree() -> dict {
  return {
    sha: TREE,
    truncated: false,
    tree: [
      {path: OVERRIDE_IMPLEMENTATION_PATH, type: "blob", mode: "100644", sha: COMMIT},
      {path: "scripts/merge-override", type: "tree", mode: "040000", sha: OTHER},
      {path: "scripts/merge-override/run.sh", type: "blob", mode: "100755", sha: COMMIT},
      {path: "scripts/merge-override/check.sh", type: "blob", mode: "100755", sha: TREE},
      {path: OVERRIDE_TEMPLATE_PATH, type: "blob", mode: "100644", sha: TREE},
      {path: "README.md", type: "blob", mode: "100644", sha: COMMIT},
    ],
  }
}

pipeline test_only_registered_bytes_and_execution_modes_decide_equivalence() {
  const source = fixture_tree()
  const files = override_implementation_files(TREE, source)
  assert_eq(len(files), 4)
  assert(!files.has("README.md"))
  assert_eq(files["scripts/merge-override/run.sh"], "100755:${COMMIT}")
  const unrelated = source
    + {
      sha: OTHER,
      tree: source.tree.map(
        { entry ->
          if entry.path == "README.md" {
            entry + {sha: OTHER}
          } else {
            entry
          }
        },
      )
        .to_list(),
    }
  assert_eq(override_implementation_files(OTHER, unrelated), files)
  for change in [{sha: OTHER}, {mode: "100644"}] {
    const changed = source
      + {
        tree: source.tree.map(
          { entry ->
            if entry.path == "scripts/merge-override/run.sh" {
              entry + change
            } else {
              entry
            }
          },
        )
          .to_list(),
      }
    assert(override_implementation_files(TREE, changed) != files)
  }
  const removed = source
    + {
      tree:
        source.tree.filter({ entry -> entry.path != "scripts/merge-override/run.sh" }).to_list(),
    }
  assert(override_implementation_files(TREE, removed) != files)
  const added = source
    + {
      tree: source.tree
        + [{path: "scripts/merge-override/extra.sh", type: "blob", mode: "100755", sha: OTHER}],
    }
  assert(override_implementation_files(TREE, added) != files)
}

pipeline test_empty_partial_foreign_and_nonregular_implementation_reads_refuse() {
  const source = fixture_tree()
  const run = source.tree[2]
  const no_workflow = source.tree.filter({ entry -> entry.path != OVERRIDE_IMPLEMENTATION_PATH })
    .to_list()
  const no_directory = source.tree.filter({ entry -> entry.path != "scripts/merge-override" })
    .to_list()
  const empty_directory = source.tree.filter(
    { entry -> !starts_with(entry.path, "scripts/merge-override/") },
  )
    .to_list()
  const lookalike = empty_directory + [run + {path: "scripts/merge-override-other/run.sh"}]
  for broken in [
    source + {sha: OTHER},
    source + {truncated: true},
    source + {tree: []},
    source + {tree: no_workflow},
    source + {tree: no_directory},
    source + {tree: empty_directory},
    source + {tree: lookalike},
    source + {tree: source.tree + [run]},
    source + {tree: source.tree + [run + {path: "../escape"}]},
    source + {tree: source.tree + [run + {path: "scripts/merge-override/invalid", sha: "short"}]},
    source + {tree: source.tree + [run + {path: "scripts/merge-override/link", mode: "120000"}]},
    source
      + {
        tree: source.tree
          + [run + {path: "scripts/merge-override/submodule", type: "commit", mode: "160000"}],
      },
  ] {
    const refused = try {
      override_implementation_files(TREE, broken)
      false
    } catch (_error) {
      true
    }
    assert(refused, "an incomplete or unsafe source census cannot authorize keeping a pin")
  }
}

pipeline test_git_commit_and_tree_are_bound_to_the_requested_revision() {
  assert_eq(override_commit_tree(COMMIT, {sha: COMMIT, tree: {sha: TREE}}), TREE)
  for broken in [
    {sha: OTHER, tree: {sha: TREE}},
    {sha: COMMIT, tree: {sha: "short"}},
    {sha: COMMIT},
  ] {
    const refused = try {
      override_commit_tree(COMMIT, broken)
      false
    } catch (_error) {
      true
    }
    assert(refused)
  }
}

pipeline test_comparison_distinguishes_no_difference_from_invalid_source(harness: Harness) {
  assert_eq(
    unwrap(equivalent_override_implementations(harness, COMMIT, [])),
    {canonical: COMMIT, checked: [], equivalent: []},
  )
  assert_eq(
    unwrap(equivalent_override_implementations(harness, COMMIT, [COMMIT])),
    {canonical: COMMIT, checked: [], equivalent: []},
  )
  for input in [{canonical: "short", pins: []}, {canonical: COMMIT, pins: ["short"]}] {
    const refused = equivalent_override_implementations(harness, input.canonical, input.pins)
    assert(is_err(refused))
    assert_eq(unwrap_err(refused).code, "invalid_response")
  }
}
