import {
  release_certified_pin_candidate,
  release_certified_pin_resolution,
} from "../lib/release_certified_pin"

const REQUIRED = ["CI status", "drift"]

const NEWEST = "1111111111111111111111111111111111111111"

const MIDDLE = "2222222222222222222222222222222222222222"

const OLDEST = "3333333333333333333333333333333333333333"

fn run(name: string, conclusion: string) -> dict {
  return {__typename: "CheckRun", name: name, status: "COMPLETED", conclusion: conclusion}
}

fn green_rows() -> list {
  return [run("CI status", "SUCCESS"), run("drift", "SUCCESS")]
}

fn red_rows() -> list {
  return [run("CI status", "FAILURE"), run("drift", "SUCCESS")]
}

fn pending_rows() -> list {
  return [
    {__typename: "CheckRun", name: "CI status", status: "IN_PROGRESS"},
    run("drift", "SUCCESS"),
  ]
}

fn candidate(sha: string, rows: list?) {
  return release_certified_pin_candidate(sha, REQUIRED, rows)
}

/** The ordinary case: the newest commit is green and is the one resolved. */
pipeline test_the_newest_green_commit_is_resolved() {
  const resolution = release_certified_pin_resolution(
    REQUIRED,
    [candidate(NEWEST, green_rows()), candidate(MIDDLE, green_rows())],
  )
  assert_eq(resolution.resolved, true)
  assert_eq(resolution.sha, NEWEST)
  assert_eq(resolution.scanned, 2)
  assert_eq(len(resolution.rejected), 0)
  assert_eq(resolution.refusal, nil)
}

/**
 * The acceptance criterion that matters most: a red tip must not be selected,
 * and must not refuse the cut either. A red on the branch is a statement about
 * commits the release never needed.
 */
pipeline test_a_red_tip_selects_the_newest_green_commit_below_it() {
  const resolution = release_certified_pin_resolution(
    REQUIRED,
    [
      candidate(NEWEST, red_rows()),
      candidate(MIDDLE, pending_rows()),
      candidate(OLDEST, green_rows()),
    ],
  )
  assert_eq(resolution.resolved, true)
  assert_eq(resolution.sha, OLDEST, "the newest GREEN commit, not the newest commit")
  assert_eq(resolution.scanned, 3)
  assert_eq(len(resolution.rejected), 2, "both skipped commits are recorded, not dropped")
  assert_eq(resolution.rejected[0]?.sha, NEWEST)
  assert_eq(resolution.rejected[0]?.blocking_check, "CI status")
  assert_eq(resolution.rejected[1]?.sha, MIDDLE)
  assert(
    contains(resolution.reason, "skipped 2 newer commit(s)"),
    "the reason must name what it passed over",
  )
}

/**
 * Never fall back to the head. A page with no green commit refuses by name and
 * reports the count scanned and the failing contexts.
 */
pipeline test_a_page_with_no_green_commit_refuses_and_never_falls_back() {
  const resolution = release_certified_pin_resolution(
    REQUIRED,
    [candidate(NEWEST, red_rows()), candidate(MIDDLE, red_rows())],
  )
  assert_eq(resolution.resolved, false)
  assert_eq(resolution.sha, "", "a refusal must not name a commit")
  assert_eq(resolution.refusal, "no_green_commit_in_page")
  assert_eq(resolution.scanned, 2)
  assert(contains(resolution.reason, "2 scanned commit(s)"), "the count scanned must be named")
  assert(contains(resolution.reason, "CI status"), "the failing context must be named")
}

/**
 * The measured-nothing control. An unreadable rollup is refused, and the
 * receipt can tell it apart from a rollup that was read and was red.
 */
pipeline test_an_unread_rollup_is_distinguishable_from_a_red_one() {
  const unread = candidate(NEWEST, [])
  const red = candidate(MIDDLE, red_rows())
  assert_eq(unread.green, false)
  assert_eq(unread.rollup_read, false, "no required context reported, so nothing was measured")
  assert_eq(red.green, false)
  assert_eq(red.rollup_read, true, "the rollup was read and it was red")
  const resolution = release_certified_pin_resolution(REQUIRED, [unread, red])
  assert_eq(resolution.resolved, false)
  assert_eq(resolution.refusal, "no_green_commit_in_page")
  assert(
    contains(resolution.reason, "no required context reported"),
    "the unread commit must say so rather than name a failing check",
  )
}

/**
 * A missing required context is not a passing one. A commit reporting only one
 * of the two required contexts is refused on the absent one.
 */
pipeline test_a_missing_required_context_never_reads_as_passing() {
  const partial = candidate(NEWEST, [run("drift", "SUCCESS")])
  assert_eq(partial.green, false)
  assert_eq(partial.rollup_read, true, "one context did report, so the rollup was read")
  assert_eq(partial.blocking_check, "CI status")
  assert_eq(partial.failing_contexts, ["CI status"])
}

/** Unreadable branch protection refuses; an empty required set is not consent. */
pipeline test_an_empty_required_set_refuses_rather_than_admitting_everything() {
  const resolution = release_certified_pin_resolution(
    [],
    [release_certified_pin_candidate(NEWEST, [], green_rows())],
  )
  assert_eq(resolution.resolved, false)
  assert_eq(resolution.refusal, "required_contexts_not_observed")
  assert_eq(resolution.sha, "")
}

/** An empty page is measured nothing, and is named apart from a red page. */
pipeline test_an_empty_page_refuses_as_nothing_scanned() {
  const resolution = release_certified_pin_resolution(REQUIRED, [])
  assert_eq(resolution.resolved, false)
  assert_eq(resolution.refusal, "no_commits_scanned")
  assert_eq(resolution.scanned, 0)
}

/**
 * The negative control for the whole mechanism: the branch moving after
 * resolution cannot change the answer, because the answer is a value and not a
 * branch read. Re-resolving the same page returns the same OID, and resolving a
 * page that has gained a newer red commit still returns it.
 */
pipeline test_a_branch_that_moves_after_resolution_does_not_change_the_pin() {
  const before = release_certified_pin_resolution(REQUIRED, [candidate(MIDDLE, green_rows())])
  assert_eq(before.sha, MIDDLE)
  const after_landing = release_certified_pin_resolution(
    REQUIRED,
    [candidate(NEWEST, red_rows()), candidate(MIDDLE, green_rows())],
  )
  assert_eq(after_landing.sha, MIDDLE, "the commit that landed above it is simply not the pin")
  assert_eq(after_landing.resolved, true)
}
