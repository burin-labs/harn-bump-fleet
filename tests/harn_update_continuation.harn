import { fleet_chain_branch, fleet_chain_ref } from "../lib/fleet_chain_ref"
import {
  HarnUpdateContinuationAdapter,
  HarnUpdateContinuationAuthorizationAdapter,
  continue_harn_update_with_adapter,
  preflight_harn_update_continuation_with_adapter,
} from "../lib/harn_update_continuation"
import {
  GithubConnectorError,
  GithubRefClaim,
  GithubRefRelease,
  GithubWorkflowDispatchReceipt,
} from "harn-github-connector/default"

const CHAIN_ID = "32966183960"

const REVISION = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn claim(ref: string, oid: string) -> GithubRefClaim {
  return {
    repo: "burin-labs/harn-bump-fleet",
    ref: ref,
    oid: oid,
    claimed: true,
    holder_headline: "",
  }
}

fn release(ref: string, oid: string) -> GithubRefRelease {
  return {
    repo: "burin-labs/harn-bump-fleet",
    ref: ref,
    oid: oid,
    released: true,
    reason: "released",
  }
}

fn missing_scopes() -> GithubConnectorError {
  return {
    code: "missing_scopes",
    category: "permission",
    message: "GitHub App token lacks Workflows write permission",
    http_status: 403,
  }
}

fn dispatch_receipt(ref: string) -> GithubWorkflowDispatchReceipt {
  return {
    repo: "burin-labs/harn-bump-fleet",
    accepted: true,
    run_id: 32966183961,
    workflow_id: "bump-fleet.yml",
    workflow_path: ".github/workflows/bump-fleet.yml",
    run_attempt: 1,
    ref: ref,
    head_sha: REVISION,
    head_branch: ref,
    event: "workflow_dispatch",
    url: "https://github.test/actions/runs/32966183961",
    created_at: "2026-08-26T00:00:00Z",
  }
}

pipeline test_missing_scope_returns_a_reached_typed_authorization_receipt(task: any) {
  let claims = 0
  let releases = 0
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(_ref, _oid) {
      claims = claims + 1
      return Err(missing_scopes())
    },
    release: fn(_ref, _oid) {
      releases = releases + 1
      return Err(missing_scopes())
    },
  }
  const receipt = preflight_harn_update_continuation_with_adapter(CHAIN_ID, REVISION, adapter)
  assert_eq(receipt.schema_version, "harn_bump_fleet.harn_update_continuation_authorization.v1")
  assert_eq(receipt.status, "blocked")
  assert_eq(receipt.authorized, false)
  assert_eq(receipt.failure?.code, "missing_scopes")
  assert_eq(receipt.failure?.category, "permission")
  assert_eq(receipt.failure?.http_status, 403)
  assert_eq(receipt.claim_attempts, 1)
  assert_eq(receipt.release_attempts, 0)
  assert_eq(receipt.dispatch_attempts, 0)
  assert_eq(claims, 1, "the negative control reached the lease boundary")
  assert_eq(releases, 0)
}

pipeline test_authorized_preflight_claims_and_releases_the_exact_controller(task: any) {
  let claims = 0
  let releases = 0
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) {
      claims = claims + 1
      return Ok(claim(ref, oid))
    },
    release: fn(ref, oid) {
      releases = releases + 1
      return Ok(release(ref, oid))
    },
  }
  const receipt = preflight_harn_update_continuation_with_adapter(CHAIN_ID, REVISION, adapter)
  assert_eq(receipt.status, "authorized")
  assert_eq(receipt.authorized, true)
  assert_eq(receipt.claim?.oid, REVISION)
  assert_eq(receipt.release?.reason, "released")
  assert_eq(claims, 1)
  assert_eq(releases, 1)
}

pipeline test_incomplete_round_dispatches_exactly_one_successor_under_its_lease(task: any) {
  let claims = 0
  let releases = 0
  let dispatches = 0
  let dispatched_fields = {}
  let dispatched_ref = ""
  const adapter: HarnUpdateContinuationAdapter = {
    claim: fn(ref, oid) {
      claims = claims + 1
      return Ok(claim(ref, oid))
    },
    release: fn(ref, oid) {
      releases = releases + 1
      return Ok(release(ref, oid))
    },
    dispatch: fn(fields, ref) {
      dispatches = dispatches + 1
      dispatched_fields = fields
      dispatched_ref = ref
      return Ok(dispatch_receipt(ref))
    },
  }
  const receipt = continue_harn_update_with_adapter(
    {
      target: "v0.10.117",
      proof_complete: false,
      update_round: 1,
      max_rounds: 4,
      repair_enabled: true,
      only: "burin-labs/harn-example",
      chain_id: CHAIN_ID,
      controller_revision: REVISION,
      controller_run_id: 32966183960,
    },
    adapter,
  )
  assert_eq(receipt.status, "continued")
  assert_eq(receipt.controller_ref, fleet_chain_ref(CHAIN_ID))
  assert_eq(receipt.chain_claim?.oid, REVISION)
  assert_eq(receipt.dispatch_attempts, 1)
  assert_eq(claims, 1)
  assert_eq(dispatches, 1)
  assert_eq(releases, 0)
  assert_eq(dispatched_ref, fleet_chain_branch(CHAIN_ID))
  assert_eq(dispatched_fields.version, "v0.10.117")
  assert_eq(dispatched_fields.update_round, "2")
  assert_eq(dispatched_fields.max_rounds, "4")
  assert_eq(dispatched_fields.enable_repair, true)
  assert_eq(dispatched_fields.chain_id, CHAIN_ID)
  assert_eq(dispatched_fields.predecessor_run_id, "32966183960")
  assert_eq(dispatched_fields.only, "burin-labs/harn-example")
}
