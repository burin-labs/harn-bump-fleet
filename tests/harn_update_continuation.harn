import { fleet_chain_branch, fleet_chain_ref } from "../lib/fleet_chain_ref"
import { fleet_operation_scope, fleet_scope_digest } from "../lib/fleet_operation_scope"
import {
  HarnUpdateContinuationAdapter,
  HarnUpdateContinuationAuthorizationAdapter,
  continue_harn_update_with_adapter,
  preflight_harn_update_continuation_with_adapter,
  release_harn_update_chain_with_adapter,
} from "../lib/harn_update_continuation"
import {
  GithubConnectorError,
  GithubRefClaim,
  GithubRefRelease,
  GithubWorkflowDispatchReceipt,
} from "harn-github-connector/default"

const CHAIN_ID = "32966183960"

const REVISION = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn claim(ref: string, oid: string) -> GithubRefClaim {
  return {
    repo: "burin-labs/harn-bump-fleet",
    ref: ref,
    oid: oid,
    claimed: true,
    holder_headline: "",
  }
}

fn release(ref: string, oid: string) -> GithubRefRelease {
  return {
    repo: "burin-labs/harn-bump-fleet",
    ref: ref,
    oid: oid,
    released: true,
    reason: "released",
  }
}

fn missing_scopes() -> GithubConnectorError {
  return {
    code: "missing_scopes",
    category: "permission",
    message: "GitHub App token lacks Workflows write permission",
    http_status: 403,
  }
}

fn dispatch_receipt(ref: string) -> GithubWorkflowDispatchReceipt {
  return {
    repo: "burin-labs/harn-bump-fleet",
    accepted: true,
    run_id: 32966183961,
    workflow_id: "bump-fleet.yml",
    workflow_path: ".github/workflows/bump-fleet.yml",
    run_attempt: 1,
    ref: ref,
    head_sha: REVISION,
    head_branch: ref,
    event: "workflow_dispatch",
    url: "https://github.test/actions/runs/32966183961",
    created_at: "2026-08-26T00:00:00Z",
  }
}

pipeline test_missing_scope_returns_a_reached_typed_authorization_receipt(task: any) {
  let claims = 0
  let releases = 0
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(_ref, _oid) {
      claims = claims + 1
      return Err(missing_scopes())
    },
    release: fn(_ref, _oid) {
      releases = releases + 1
      return Err(missing_scopes())
    },
  }
  const receipt = preflight_harn_update_continuation_with_adapter(CHAIN_ID, REVISION, adapter)
  assert_eq(receipt.schema_version, "harn_bump_fleet.harn_update_continuation_authorization.v1")
  assert_eq(receipt.status, "blocked")
  assert_eq(receipt.authorized, false)
  assert_eq(receipt.failure?.code, "missing_scopes")
  assert_eq(receipt.failure?.category, "permission")
  assert_eq(receipt.failure?.http_status, 403)
  assert_eq(receipt.claim_attempts, 1)
  assert_eq(receipt.release_attempts, 0)
  assert_eq(receipt.dispatch_attempts, 0)
  assert_eq(claims, 1, "the negative control reached the lease boundary")
  assert_eq(releases, 0)
}

pipeline test_authorized_preflight_claims_and_releases_the_exact_controller(task: any) {
  let claims = 0
  let releases = 0
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) {
      claims = claims + 1
      return Ok(claim(ref, oid))
    },
    release: fn(ref, oid) {
      releases = releases + 1
      return Ok(release(ref, oid))
    },
  }
  const receipt = preflight_harn_update_continuation_with_adapter(CHAIN_ID, REVISION, adapter)
  assert_eq(receipt.status, "authorized")
  assert_eq(receipt.authorized, true)
  assert_eq(receipt.claim?.oid, REVISION)
  assert_eq(receipt.release?.reason, "released")
  assert_eq(claims, 1)
  assert_eq(releases, 1)
}

pipeline test_incomplete_round_dispatches_exactly_one_successor_under_its_lease(task: any) {
  let claims = 0
  let releases = 0
  let dispatches = 0
  let dispatched_fields = {}
  let dispatched_ref = ""
  const adapter: HarnUpdateContinuationAdapter = {
    claim: fn(ref, oid) {
      claims = claims + 1
      return Ok(claim(ref, oid))
    },
    release: fn(ref, oid) {
      releases = releases + 1
      return Ok(release(ref, oid))
    },
    dispatch: fn(fields, ref) {
      dispatches = dispatches + 1
      dispatched_fields = fields
      dispatched_ref = ref
      return Ok(dispatch_receipt(ref))
    },
  }
  const receipt = continue_harn_update_with_adapter(
    {
      target: "v0.10.117",
      proof_complete: false,
      update_round: 1,
      max_rounds: 4,
      repair_enabled: true,
      only: "burin-labs/harn-example",
      chain_id: CHAIN_ID,
      controller_revision: REVISION,
      controller_run_id: 32966183960,
      controller_run_attempt: 2,
    },
    adapter,
  )
  assert_eq(receipt.status, "continued")
  assert_eq(receipt.controller_ref, fleet_chain_ref(CHAIN_ID))
  assert_eq(receipt.chain_claim?.oid, REVISION)
  assert_eq(receipt.dispatch_attempts, 1)
  assert_eq(claims, 1)
  assert_eq(dispatches, 1)
  assert_eq(releases, 0)
  assert_eq(dispatched_ref, fleet_chain_branch(CHAIN_ID))
  assert_eq(dispatched_fields.version, "v0.10.117")
  assert_eq(dispatched_fields.update_round, "2")
  assert_eq(dispatched_fields.max_rounds, "4")
  assert_eq(dispatched_fields.enable_repair, true)
  assert_eq(dispatched_fields.chain_id, CHAIN_ID)
  assert_eq(dispatched_fields.predecessor_run_id, "32966183960")
  assert_eq(dispatched_fields.predecessor_run_attempt, "2")
  assert_eq(dispatched_fields.only, "burin-labs/harn-example")
  assert_eq(
    dispatched_fields.scope_digest,
    fleet_scope_digest(fleet_operation_scope("burin-labs/harn-example")),
  )
}

/**
 * The lease leak the v0.10.127 chain exposed.
 *
 * Round 2 aborted before its scheduler could decide anything, so nothing ever
 * released `harn-update-chain/33659789177`. It sat held at an exact OID that
 * predates the fix while a fresh chain had to be started around it. A round
 * that ends without dispatching a successor must release the lease itself.
 */
pipeline test_a_round_that_dispatched_no_successor_releases_the_chain_lease(task: any) {
  let released: list<string> = []
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) { return Ok(claim(ref, oid)) },
    release: fn(ref, oid) {
      released = released + [ref]
      return Ok(release(ref, oid))
    },
  }
  const receipt = release_harn_update_chain_with_adapter(CHAIN_ID, REVISION, "none", adapter)
  assert_eq(receipt.status, "released")
  assert_eq(receipt.released, true)
  assert_eq(receipt.controller_ref, fleet_chain_ref(CHAIN_ID))
  assert_eq(released, [fleet_chain_ref(CHAIN_ID)])
}

pipeline test_a_dispatched_successor_keeps_the_lease_it_runs_from(task: any) {
  let released: list<string> = []
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) { return Ok(claim(ref, oid)) },
    release: fn(ref, oid) {
      released = released + [ref]
      return Ok(release(ref, oid))
    },
  }
  const receipt = release_harn_update_chain_with_adapter(CHAIN_ID, REVISION, "dispatched", adapter)
  assert_eq(receipt.status, "successor_dispatched")
  assert_eq(receipt.released, false)
  assert_eq(
    released,
    [],
    "releasing here would delete the controller branch the successor is checked out from",
  )
}

pipeline test_an_unprovable_successor_leaves_the_lease_alone_and_says_so(task: any) {
  let released: list<string> = []
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) { return Ok(claim(ref, oid)) },
    release: fn(ref, oid) {
      released = released + [ref]
      return Ok(release(ref, oid))
    },
  }
  const receipt = release_harn_update_chain_with_adapter(CHAIN_ID, REVISION, "unknown", adapter)
  assert_eq(receipt.status, "undecidable")
  assert_eq(receipt.released, false)
  assert_eq(released, [], "an unprovable successor must not be resolved by deleting its branch")
  assert(contains(receipt.detail, "cannot prove"))
}

pipeline test_a_lease_held_at_another_revision_is_not_this_rounds_to_release(task: any) {
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) { return Ok(claim(ref, oid)) },
    release: fn(ref, oid) { return Ok(
      release(ref, oid) + {released: false, reason: "held_by_another"},
    ) },
  }
  const receipt = release_harn_update_chain_with_adapter(CHAIN_ID, REVISION, "none", adapter)
  assert_eq(receipt.status, "not_held")
  assert_eq(receipt.released, false)
}

pipeline test_a_round_that_never_claimed_reports_absence_not_a_release(task: any) {
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) { return Ok(claim(ref, oid)) },
    release: fn(ref, oid) { return Ok(
      release(ref, oid) + {released: false, oid: "", reason: "already_absent"},
    ) },
  }
  const receipt = release_harn_update_chain_with_adapter(CHAIN_ID, REVISION, "none", adapter)
  assert_eq(
    receipt.status,
    "already_absent",
    "a no-op must not read as a release; most rounds never claim the lease at all",
  )
  assert_eq(receipt.released, false)
}

pipeline test_a_connector_failure_blocks_rather_than_reporting_a_release(task: any) {
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) { return Ok(claim(ref, oid)) },
    release: fn(_ref, _oid) { return Err(missing_scopes()) },
  }
  const receipt = release_harn_update_chain_with_adapter(CHAIN_ID, REVISION, "none", adapter)
  assert_eq(receipt.status, "blocked")
  assert_eq(receipt.released, false)
  assert_eq(receipt.failure?.code, "missing_scopes")
}

/**
 * The proof rows a refused round persists, reduced to the fields the chain's
 * decision reads. The category is the code because the connector has no
 * mapping for this code and falls through to it.
 */
fn refused_rows(code: string, category: string) -> list {
  return [
    {
      repo: "burin-labs/harn-example",
      state: "failed",
      reason: "default_branch_checks_unproven: exact-head check census read failed",
      default_branch_check_proof: {
        ok: false,
        state: "failed",
        refusal: {disposition: "refuse", code: code, category: category, action: "decide"},
      },
    },
  ]
}

fn counting_adapter(
  dispatches: fn() -> nil,
  captured: fn(dict) -> nil,
) -> HarnUpdateContinuationAdapter {
  return {
    claim: fn(ref, oid) { return Ok(claim(ref, oid)) },
    release: fn(ref, oid) { return Ok(release(ref, oid)) },
    dispatch: fn(fields, ref) {
      dispatches()
      captured(fields)
      return Ok(dispatch_receipt(ref))
    },
  }
}

/**
 * The falsifier, on the path the workflow runs.
 *
 * A round whose failures are all refusals no round can clear must not reach
 * the dispatch at all. Asserting the decision alone would leave the wiring
 * unproven, and the wiring is what spent the release app's hourly budget.
 */
pipeline test_a_round_of_final_refusals_dispatches_no_successor(task: any) {
  let dispatches = 0
  let captured: dict = {}
  const adapter = counting_adapter(
    fn() { dispatches = dispatches + 1 },
    fn(fields) { captured = fields },
  )
  const receipt = continue_harn_update_with_adapter(
    {
      target: "v0.10.141",
      proof_complete: false,
      update_round: 1,
      max_rounds: 4,
      repair_enabled: true,
      chain_id: CHAIN_ID,
      controller_revision: REVISION,
      controller_run_id: 32966183960,
      controller_run_attempt: 1,
      proof_rows: refused_rows("missing_scopes", "permission"),
    },
    adapter,
  )
  assert_eq(receipt.status, "complete")
  assert_eq(receipt.continuation.continue, false)
  assert_eq(receipt.continuation.reason, "refusals_not_code_repairable")
  assert(contains(receipt.continuation.detail ?? "", "burin-labs/harn-example"))
  assert_eq(dispatches, 0, "the stop rule must be reached before the dispatch")
  assert_eq(receipt.dispatch_attempts, 0)
}

/**
 * The control: the census race earns one more round, and the successor is
 * dispatched carrying the retry it just spent. Without that field the
 * successor would classify itself from zero and retry forever.
 */
pipeline test_a_transient_refusal_dispatches_a_successor_carrying_the_retry(task: any) {
  let dispatches = 0
  let captured: dict = {}
  const adapter = counting_adapter(
    fn() { dispatches = dispatches + 1 },
    fn(fields) { captured = fields },
  )
  const receipt = continue_harn_update_with_adapter(
    {
      target: "v0.10.141",
      proof_complete: false,
      update_round: 1,
      max_rounds: 4,
      repair_enabled: true,
      chain_id: CHAIN_ID,
      controller_revision: REVISION,
      controller_run_id: 32966183960,
      controller_run_attempt: 1,
      proof_rows: refused_rows("incomplete_page", "incomplete_page"),
    },
    adapter,
  )
  assert_eq(receipt.status, "continued")
  assert_eq(receipt.continuation.reason, "fresh_hosted_round_required")
  assert_eq(dispatches, 1)
  assert_eq(captured.transient_retries, "1")
  assert_eq(captured.update_round, "2")
  // The successor, run with that count, stops rather than spending a third.
  let successor_dispatches = 0
  const successor = continue_harn_update_with_adapter(
    {
      target: "v0.10.141",
      proof_complete: false,
      update_round: 2,
      max_rounds: 4,
      repair_enabled: true,
      chain_id: CHAIN_ID,
      controller_revision: REVISION,
      controller_run_id: 32966183961,
      controller_run_attempt: 1,
      proof_rows: refused_rows("incomplete_page", "incomplete_page"),
      transient_retries: 1,
    },
    counting_adapter(
      fn() { successor_dispatches = successor_dispatches + 1 },
      fn(_fields) {
      },
    ),
  )
  assert_eq(successor.continuation.continue, false)
  assert_eq(successor.continuation.reason, "transient_retry_budget_exhausted")
  assert_eq(successor_dispatches, 0)
}
