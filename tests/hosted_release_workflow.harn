pipeline test_consumer_projection_drift_blocks_publication_before_release_work(harness: Harness) {
  const workflow = decode_github_workflow(hosted_release_workflow(harness.fs))
  const steps = workflow.jobs.get("release")?.steps ?? []
  const token_index = steps.find_index({ step -> step.name == "Mint fleet policy read token" })
  const policy_index = steps.find_index(
    { step ->
      step.name == "Verify consumer contracts match generated adapters before publication"
    },
  )
  const release_index = steps.find_index({ step -> step.name == "Run release harness" })
  const rust_index = steps.find_index({ step -> contains(step.uses ?? "", "/rust-toolchain@") })
  const cache_index = steps.find_index({ step -> contains(step.uses ?? "", "/rust-cache@") })
  assert(token_index >= 0)
  assert(policy_index > token_index)
  assert(rust_index > policy_index)
  assert(cache_index > policy_index)
  assert(release_index > policy_index)
  const token = steps[token_index]
  assert_eq(token?.if, "inputs.mode == 'ship-pr'")
  assert_eq(token.with?.get("owner"), "burin-labs")
  assert_eq(token.with?.get("permission-contents"), "read")
  assert_eq(token.with?.get("repositories"), nil)
  assert_eq(token.with?.get("permission-actions"), nil)
  assert_eq(token.with?.get("permission-pull-requests"), nil)
  const policy = steps[policy_index]
  assert_eq(policy?.if, "inputs.mode == 'ship-pr'")
  const token_ref = "$" + "{{ steps.fleet-policy-token.outputs.token }}"
  assert_eq(policy?.env?.get("GH_TOKEN"), token_ref)
  assert_eq(policy?.env?.get("GITHUB_TOKEN"), token_ref)
  assert(contains(policy?.run ?? "", "check_fleet_policy.harn"))
  assert(contains(policy?.run ?? "", "prepublication-fleet-policy.json"))
}

/**
 * Exact-candidate source certification runs Rust, Harn, and package audit as
 * independent heavy pools. Below six CPUs the owning release scheduler must
 * serialize them, which made the source proof the release critical path even
 * though the hosted platform lanes had already completed.
 */
pipeline test_hosted_release_capacity_can_overlap_every_source_lane(harness: Harness, task: any) {
  const source = hosted_release_workflow(harness.fs)
  assert(contains(source, "vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'"))
  assert(contains(source, "'ubuntu-latest' || 'blacksmith-8vcpu-ubuntu-2404'"))
  assert(contains(source, "'github-hosted' || 'blacksmith'"))
  assert_eq(source.split("vars.HARN_CI_DISABLE_BLACKSMITH_LINUX == 'true'").count(), 3)
}

/**
 * Release bootstrap must not depend on a mutable OS package mirror for the
 * one binary the gate needs. A mirror stall previously consumed the whole
 * step budget before the release harness started.
 */
pipeline test_release_gate_ripgrep_is_pinned_and_installed_without_apt(
  harness: Harness,
  task: any,
) {
  const source = hosted_release_workflow(harness.fs)
  const workflow = decode_github_workflow(source)
  const steps = workflow.jobs.get("release")?.steps ?? []
  const matches = steps.filter({ step -> step.name == "Install pinned release-gate ripgrep" })
    .to_list()
  assert_eq(len(matches), 1)
  const install = matches[0]
  assert_eq(install.get("timeout-minutes"), 3)
  const run = install.run ?? ""
  const version_ref = "$" + "{version}"
  const target_ref = "$" + "{target}"
  assert(
    contains(
      run,
      "releases/download/"
        + version_ref
        + "/ripgrep-"
        + version_ref
        + "-"
        + target_ref
        + ".tar.gz",
    ),
  )
  assert(contains(run, "version=15.2.0"))
  assert(contains(run, "X64)"))
  assert(contains(run, "ARM64)"))
  assert(contains(run, "33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c"))
  assert(contains(run, "800b1e7206afe799dfb5a6901f23147cfaabe0e52210538100f61e86e1740915"))
  assert(contains(run, "--location"))
  assert(contains(run, "--retry-all-errors"))
  assert(contains(run, "sha256sum --check --strict"))
  assert(
    contains(run, "--strip-components=1 \"ripgrep-" + version_ref + "-" + target_ref + "/rg\""),
  )
  assert(contains(run, "GITHUB_PATH"))
  assert(contains(run, "\"$bin_dir/rg\" --version"))
  assert_eq(contains(source, "/apt-install@"), false)
  assert_eq(contains(source, "packages: ripgrep"), false)
  const install_index = steps.find_index(
    { step -> step.name == "Install pinned release-gate ripgrep" },
  )
  const release_index = steps.find_index({ step -> step.name == "Run release harness" })
  assert(install_index >= 0)
  assert(release_index > install_index)
}

pipeline test_ship_pr_can_continue_through_fleet_convergence(harness: Harness, task: any) {
  const source = hosted_release_workflow(harness.fs)
  assert(contains(source, "converge_fleet:"))
  assert(contains(source, "repositories_json:"))
  assert(contains(source, "expected_prs:"))
  assert(contains(source, "args+=(--expect-pr \"" + "$" + "{RELEASE_EXPECT_PRS}\")"))
  assert(contains(source, "--agent --no-chat --github-signed-commit"))
  assert(contains(source, "./scripts/watch_hosted_harn_release.sh"))
  const tail = source.index_of("release_chain.harn --")
  const watch = source.index_of("watch_fleet_convergence_run.harn")
  assert(tail >= 0)
  assert(watch > tail)
  assert(contains(source, "RELEASE_APP_TOKEN_PROFILE: fleet-orchestration"))
  assert(contains(source, "while sleep 2700"))
  assert(contains(source, "./scripts/refresh_hosted_release_credentials.sh"))
  assert(contains(source, "--yes-live-release --no-wait"))
  assert(contains(source, "watch_fleet_convergence_run.harn"))
  assert(contains(source, "--chain-id \"$RELEASE_CHAIN_ID\""))
  assert(contains(source, "permission-actions: read"))
  assert(contains(source, "--resume-published --reconcile-only"))
}

pipeline test_hosted_release_forwards_one_repository_scope_only_after_publication(
  harness: Harness,
  task: any,
) {
  const workflow = decode_github_workflow(hosted_release_workflow(harness.fs))
  const input = workflow.workflow_dispatch?.inputs?.get("repositories_json")
  assert_eq(input?.type, "string")
  assert_eq(input?.default, "")
  const skip = workflow.workflow_dispatch?.inputs?.get("skip_consumers")
  assert_eq(skip?.type, "string")
  assert_eq(skip?.default, "")
  const release_steps = workflow.jobs.get("release")?.steps ?? []
  const preflight = release_steps.find(
    { step -> step.name == "Validate and normalize the post-publication consumer scope" },
  )
  const policy = release_steps.find(
    { step ->
      step.name == "Verify consumer contracts match generated adapters before publication"
    },
  )
  const release = release_steps.find({ step -> step.name == "Run release harness" })
  const tail = release_steps.find(
    { step -> step.name == "Reconcile published release and hand off fleet update" },
  )
  for step in [policy, release] {
    assert_eq(
      contains(step?.run ?? "", "--repositories-json"),
      false,
      "mandatory pre-publication checks retain their all-consumer scope",
    )
    assert_eq(
      contains(step?.run ?? "", "--skip-consumers-json"),
      false,
      "consumer exclusions apply only after publication",
    )
  }
  assert_eq(
    preflight?.env?.get("RELEASE_REPOSITORIES_JSON"),
    "$" + "{{ inputs.repositories_json }}",
  )
  assert_eq(preflight?.env?.get("RELEASE_SKIP_CONSUMERS"), "$" + "{{ inputs.skip_consumers }}")
  assert(contains(preflight?.run ?? "", "validate_fleet_scope.harn"))
  assert(contains(preflight?.run ?? "", "--require-controller"))
  assert(
    contains(preflight?.run ?? "", "args+=(--skip-consumers-json \"$RELEASE_SKIP_CONSUMERS\")"),
  )
  assert_eq(
    tail?.env?.get("RELEASE_REPOSITORIES_JSON"),
    "$" + "{{ steps.release-scope.outputs.repositories_json }}",
  )
  assert(contains(tail?.run ?? "", "args+=(--repositories-json \"$RELEASE_REPOSITORIES_JSON\")"))
  const fleet_steps = workflow.jobs.get("fleet")?.steps ?? []
  const watch = fleet_steps.find({ step -> step.name == "Prove exact fleet convergence run" })
  const reconcile = fleet_steps.find(
    { step -> step.name == "Reconcile terminal published-tail journal from consumer main" },
  )
  for step in [watch, reconcile] {
    assert_eq(
      step?.env?.get("RELEASE_REPOSITORIES_JSON"),
      "$" + "{{ needs.release.outputs.repositories_json }}",
    )
    assert(contains(step?.run ?? "", "args+=(--repositories-json \"$RELEASE_REPOSITORIES_JSON\")"))
    assert_eq(contains(step?.run ?? "", "--skip-consumers-json"), false)
  }
}

pipeline test_hosted_promotion_propagates_terminal_prerequisite_failure(
  harness: Harness,
  task: any,
) {
  const workflow = decode_github_workflow(hosted_release_workflow(harness.fs))
  const steps = workflow.jobs.get("release")?.steps ?? []
  const promotions = steps.filter(
    { step -> step.name == "Reconcile published release and hand off fleet update" },
  )
    .to_list()
  assert_eq(len(promotions), 1)
  const promotion = promotions[0]
  assert_eq(promotion.get("continue-on-error"), nil)
  assert(contains(promotion.run ?? "", "set -euo pipefail"))
  assert(contains(promotion.run ?? "", "release_chain.harn"))
  assert(contains(promotion.run ?? "", "| tee .harn-runs/hosted-published-tail.json"))
}

/**
 * App-token refresh is a deep boundary: the script owns minting and installing
 * a short-lived credential, while each workflow step must project both secret
 * inputs into its process. Keep that contract structural so a new call site
 * cannot pass review while omitting one half of the credential pair.
 */
pipeline test_every_hosted_token_refresh_has_app_credential_inputs(harness: Harness, task: any) {
  const workflow = decode_github_workflow(hosted_release_workflow(harness.fs))
  let refresh_steps = 0
  for job in workflow.jobs {
    for step in job.value.steps ?? [] {
      const run = step.run ?? ""
      if !contains(run, "./scripts/refresh_hosted_release_credentials.sh")
        && !contains(run, "./scripts/watch_hosted_harn_release.sh") {
        continue
      }
      refresh_steps = refresh_steps + 1
      assert_eq(
        step.env?.get("RELEASE_APP_CLIENT_ID"),
        "$" + "{{ secrets.RELEASE_APP_CLIENT_ID }}",
        step.name ?? job.key,
      )
      assert_eq(
        step.env?.get("RELEASE_APP_PRIVATE_KEY"),
        "$" + "{{ secrets.RELEASE_APP_PRIVATE_KEY }}",
        step.name ?? job.key,
      )
    }
  }
  assert_eq(refresh_steps, 3)
}

/**
 * The connector pins its gh-auth fallback for one process. The hosted wrapper
 * must therefore resume the durable receipt in bounded fresh processes rather
 * than pretending a background credential-store rewrite changes that bearer.
 */
pipeline test_hosted_release_watch_is_segmented_below_token_lifetime(harness: Harness, task: any) {
  const root = dirname(harness.fs.cwd())
  const script = harness.fs.read_text(path_join(root, "scripts", "watch_hosted_harn_release.sh"))
  assert(contains(script, "max_segment_seconds=2700"))
  assert(contains(script, "HARN_EXT_HOSTED_RELEASE_SEGMENT_POLLS:-60"))
  assert(contains(script, "HARN_EXT_HOSTED_RELEASE_INTERVAL_SECONDS:-30"))
  assert(contains(script, "3)"), "pending status must be distinguished")
  assert(contains(script, "exit \"$status\""), "terminal failures must propagate")
  assert_eq(contains(script, "sleep 2400"), false)
  const temp = harness.fs.workspace_temp_dir()
  const refresh = path_join(temp, "refresh.sh")
  const watch = path_join(temp, "watch.sh")
  const refresh_count = path_join(temp, "refresh-count")
  const watch_count = path_join(temp, "watch-count")
  const argv_log = path_join(temp, "watch-argv")
  const gh_config_log = path_join(temp, "gh-config-log")
  harness.fs.write_text(refresh_count, "0\n")
  harness.fs.write_text(watch_count, "0\n")
  harness.fs.write_text(argv_log, "")
  harness.fs.write_text(
    refresh,
    "#!/usr/bin/env bash\nset -euo pipefail\ncount=0\n[[ -f \"$HARN_TEST_REFRESH_COUNT\" ]] && count=\"$(cat \"$HARN_TEST_REFRESH_COUNT\")\"\nprintf '%s\\n' \"$((count + 1))\" > \"$HARN_TEST_REFRESH_COUNT\"\nprintf '%s\\n' \"$"
      + "{GH_CONFIG_DIR:-}\" > \"$HARN_TEST_GH_CONFIG_LOG\"\n",
  )
  harness.fs.write_text(
    watch,
    "#!/usr/bin/env bash\nset -euo pipefail\ncount=0\n[[ -f \"$HARN_TEST_WATCH_COUNT\" ]] && count=\"$(cat \"$HARN_TEST_WATCH_COUNT\")\"\ncount=\"$((count + 1))\"\nprintf '%s\\n' \"$count\" > \"$HARN_TEST_WATCH_COUNT\"\nprintf '%s\\0' \"$@\" >> \"$HARN_TEST_ARGV_LOG\"\nprintf '\\n' >> \"$HARN_TEST_ARGV_LOG\"\nif (( count < 3 )); then exit 3; fi\n",
  )
  const chmod = harness.process.shell("chmod +x " + shell_quote(refresh) + " " + shell_quote(watch))
  assert(chmod.success, chmod.combined)
  const command = "HARN_EXT_HOSTED_RELEASE_REFRESH_SCRIPT="
    + shell_quote(refresh)
    + " HARN_EXT_HOSTED_RELEASE_WATCH_SCRIPT="
    + shell_quote(watch)
    + " HARN_EXT_HOSTED_RELEASE_SEGMENT_POLLS=2 HARN_EXT_HOSTED_RELEASE_INTERVAL_SECONDS=0"
    + " HARN_TEST_REFRESH_COUNT="
    + shell_quote(refresh_count)
    + " HARN_TEST_WATCH_COUNT="
    + shell_quote(watch_count)
    + " HARN_TEST_ARGV_LOG="
    + shell_quote(argv_log)
    + " HARN_TEST_GH_CONFIG_LOG="
    + shell_quote(gh_config_log)
    + " RUNNER_TEMP="
    + shell_quote(temp)
    + " "
    + shell_quote(path_join(root, "scripts", "watch_hosted_harn_release.sh"))
    + " --tag v0.10.115"
  const result = harness.process.shell(command)
  assert(result.success, result.combined)
  assert_eq(trim(harness.fs.read_text(refresh_count)), "3")
  assert_eq(trim(harness.fs.read_text(watch_count)), "3")
  assert_eq(trim(harness.fs.read_text(gh_config_log)), path_join(temp, "gh-config"))
  const calls = harness.fs.read_text(argv_log).split("\n").filter({ line -> return line != "" })
  assert_eq(len(calls), 3)
  for call in calls {
    const args = call.split("\0")
    assert(contains(args, "--tag"))
    assert(contains(args, "v0.10.115"))
    assert(contains(args, "--max-polls"))
    assert(contains(args, "2"))
    assert(contains(args, "--interval-seconds"))
    assert(contains(args, "0"))
  }
}

/**
 * The post-publication tail keys on the release's own proven state, not on the
 * publication prover step's conclusion.
 *
 * A prover that fails has not observed a missing release; it has failed to
 * confirm one. When the tail's conditions read that step's conclusion, one such
 * failure skipped every step after it — including the orchestration anchor's
 * only writer — while the release itself was fully published. Both halves are
 * structural here: `!cancelled()` lets the shared tail run after a red prover.
 * The tail's executable regressions prove its publication gate blocks effects.
 */
pipeline test_post_publication_tail_keys_on_the_release_not_the_prover(
  harness: Harness,
  task: any,
) {
  const source = hosted_release_workflow(harness.fs)
  assert(!contains(source, "prove_release_published.harn --"))
  assert(contains(source, "id: published-tail"))
  assert(contains(source, "id: publish-prover"))
  assert(contains(source, "steps.shipped-release.outputs.tag != ''"))
  assert_eq(
    source.split("release_chain.harn --").count(),
    3,
    "the handoff and terminal reconciliation use the same owning entrypoint",
  )
  assert_eq(
    source.split("!cancelled() && inputs.mode == 'ship-pr' && inputs.converge_fleet").count(),
    4,
    "every tail step and its terminal job survive a red prover",
  )
  assert(contains(source, "TAIL_OUTCOME: $" + "{{ steps.published-tail.outcome }}"))
  assert(contains(source, "test \"$TAIL_OUTCOME\" = success"))
  assert(!contains(source, "refresh_release_binary_size_baseline.harn --"))
  assert(!contains(source, "promote_bump_workflow.harn --"))
  assert(!contains(source, "dispatch_fleet_convergence.harn --"))
  assert(contains(source, "--yes-live-release --no-wait"))
  assert(contains(source, "--resume-published --reconcile-only --tag"))
  assert(contains(source, "hosted-cost-receipts/release/release-chain/**"))
  const tail = source.index_of("release_chain.harn --")
  const report = source.index_of("Report published release tail handoff")
  assert(tail >= 0)
  assert(report > tail)
}

/** An accepted handoff must retain its waiting owner even when release reporting failed. */
pipeline test_fleet_job_uses_accepted_identity_not_release_success(harness: Harness) {
  const workflow = decode_github_workflow(hosted_release_workflow(harness.fs))
  const release = workflow.jobs.get("release")
  const fleet = workflow.jobs.get("fleet")
  assert_eq(fleet?.name, "Prove Harn repository updates")
  assert_eq(fleet?.needs, "release")
  assert_eq(
    release?.outputs?.get("fleet_run_id"),
    "$" + "{{ steps.published-tail.outputs.run_id }}",
  )
  assert_eq(
    release?.outputs?.get("fleet_run_url"),
    "$" + "{{ steps.published-tail.outputs.run_url }}",
  )
  assert_eq(
    fleet?.get("if"),
    "$" + "{{ !cancelled() && inputs.mode == 'ship-pr' && inputs.converge_fleet"
      + " && needs.release.outputs.tag != '' && needs.release.outputs.fleet_run_id > 0"
      + " && needs.release.outputs.fleet_run_url != '' }}",
    "failed release jobs retain accepted fleet work; absent or zero dispatches do not start a waiter",
  )
}

/**
 * Every input `hosted-release.yml` declares must be reachable from the fleet's
 * own dispatcher. An input the workflow accepts but `dispatch_hosted_release`
 * never sends is settable only by hand-driving `gh workflow run`, which for
 * anyone working through the canonical path is indistinguishable from the
 * input not existing at all.
 */
pipeline test_every_hosted_release_input_is_reachable_from_the_dispatcher(
  harness: Harness,
  task: any,
) {
  const workflow = decode_github_workflow(hosted_release_workflow(harness.fs))
  const declared = (workflow.workflow_dispatch?.inputs ?? {}).keys().sort()
  // A measured zero here would otherwise mean the decoder found no inputs.
  assert(len(declared) >= 7, "the hosted release workflow declares its inputs")
  const dispatcher = harness.fs.read_text(
    path_join(dirname(harness.fs.cwd()), "dispatch_hosted_release.harn"),
  )
  const start = dispatcher.index_of("fn adapter(")
  assert(start >= 0, "the dispatcher defines its hosted workflow adapter")
  const stop = dispatcher.index_of("fn default_receipt_path(")
  assert(stop > start, "the dispatch payload ends before the run adapter")
  const payload = dispatcher.slice(start, stop)
  const unreachable = declared.filter(
    { name ->
      name != "skip_consumers"
        && !contains(payload, name + ":")
        && !contains(payload, "fields." + name + " =")
    },
  )
    .to_list()
  assert_eq(unreachable, [], "every declared hosted release input is sent by the dispatcher")
}
