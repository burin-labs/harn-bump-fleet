import { shell_quote } from "std/runtime"
import { decode_github_workflow } from "../lib/github_workflow"

fn hosted_release_workflow(fs: HarnessFs) -> string {
  return fs.read_text(path_join(dirname(fs.cwd()), ".github", "workflows", "hosted-release.yml"))
}

fn canceled_lane_cleanup_workflow(fs: HarnessFs) -> string {
  return fs.read_text(
    path_join(dirname(fs.cwd()), ".github", "workflows", "cleanup-cancelled-hosted-release.yml"),
  )
}

/**
 * Workflow-owned output must exist before Harn's fleet freshness check runs,
 * but it must not make the checkout dirty. A release can wait for environment
 * approval while main advances; a dirty checkout turns that ordinary race into
 * a failed release instead of the supported fast-forward-and-restart path.
 */
pipeline test_hosted_release_transcript_lives_in_ignored_run_root(harness: Harness, task: any) {
  const source = hosted_release_workflow(harness.fs)
  assert(contains(source, "mkdir -p .harn-runs"))
  assert(contains(source, "./scripts/with_env.sh harn run --no-sandbox --emit-summary-json"))
  assert(contains(source, "--summary-file .harn-runs/runtime-usage/release.json"))
  assert(contains(source, "| tee .harn-runs/hosted-release.md"))
  assert(contains(source, "cat .harn-runs/hosted-release.md"))
  assert_eq(contains(source, "tee hosted-release.md"), false)
  assert_eq(contains(source, "harn-bump-fleet/hosted-release.md"), false)
  const ignored = harness.fs.read_text(path_join(dirname(harness.fs.cwd()), ".gitignore"))
  assert(ignored.split("\n").contains(".harn-runs/"))
}

pipeline test_terminal_cancellation_owner_requires_exact_run_claim_and_live_acknowledgement(
  harness: Harness,
  task: any,
) {
  const release = hosted_release_workflow(harness.fs)
  const cleanup = canceled_lane_cleanup_workflow(harness.fs)
  assert(contains(release, "name: release-lane-claim-" + "$" + "{{ github.run_id }}"))
  assert(contains(release, ".harn-runs/hosted-release-lane-claim.json"))
  assert(contains(cleanup, "workflow_run:"))
  assert(contains(cleanup, "workflows: [Hosted harn release]"))
  assert(contains(cleanup, "types: [completed]"))
  assert(contains(cleanup, "github.event.workflow_run.conclusion == 'cancelled'"))
  assert(contains(cleanup, "continue-on-error: true"))
  assert(contains(cleanup, "LANE_CLAIM_OUTCOME: " + "$" + "{{ steps.lane-claim.outcome }}"))
  assert(contains(cleanup, "HOSTED_RUN_ID: " + "$" + "{{ github.event.workflow_run.id }}"))
  assert(
    contains(cleanup, "HOSTED_RUN_ATTEMPT: " + "$" + "{{ github.event.workflow_run.run_attempt }}"),
  )
  assert(contains(cleanup, "HOSTED_HEAD_SHA: " + "$" + "{{ github.event.workflow_run.head_sha }}"))
  assert(contains(cleanup, "cleanup_cancelled_hosted_release.harn"))
  assert(contains(cleanup, "--apply --yes-live-release"))
  assert(contains(cleanup, "permission-contents: write"))
  assert(contains(cleanup, "repositories: harn"))
  assert(contains(cleanup, "if-no-files-found: error"))
  const release_steps = decode_github_workflow(release).jobs.get("release")?.steps ?? []
  const claim_uploads = release_steps.filter(
    { step -> step.name == "Upload exact release lane claim" },
  )
    .to_list()
  assert_eq(len(claim_uploads), 1)
  assert_eq(claim_uploads[0].with?.get("include-hidden-files"), true)
  const cleanup_steps = decode_github_workflow(cleanup).jobs.get("cleanup")?.steps ?? []
  const receipt_uploads = cleanup_steps.filter(
    { step -> step.name == "Upload terminal lane cleanup receipt" },
  )
    .to_list()
  assert_eq(len(receipt_uploads), 1)
  assert_eq(receipt_uploads[0].with?.get("include-hidden-files"), true)
}

