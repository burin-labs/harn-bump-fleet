fn repository_source(fs: HarnessFs, path: string) -> string {
  return fs.read_text(path_join(dirname(fs.cwd()), path))
}

pipeline test_public_manifest_does_not_own_consumer_paths(harness: Harness, task: any) {
  const source = repository_source(harness.fs, "fleet.toml")
  assert_eq(contains(source, "[[file_projections]]"), false)
  assert_eq(contains(source, "target_path"), false)
}

pipeline test_repair_benchmark_uses_only_the_public_fixture(harness: Harness, task: any) {
  const source = repository_source(harness.fs, "benchmark_harn_update_repair.harn")
  const guide = repository_source(harness.fs, "docs/harn-update-benchmark.md")
  const runner = repository_source(harness.fs, "scripts/run_harn_update_repair_benchmark.sh")
  assert(contains(source, "repo: \"example/harn-update-benchmark-no-publish\""))
  assert(
    contains(source, "validation_command: \"cargo clippy --locked --all-targets -- -D warnings\""),
  )
  assert(contains(guide, "testdata/harn_update_repair"))
  assert_eq(contains(guide, "--repository-dir /"), false)
  assert(contains(guide, "scripts/run_harn_update_repair_benchmark.sh value"))
  assert(contains(runner, "--write-root \"$benchmark_dir\""))
  assert(
    contains(repository_source(harness.fs, "testdata/harn_update_repair/rust-toolchain.toml"), "1.95.0"),
  )
}
