import {
  ReleaseArchiveManifest,
  ReleaseArchiveProducer,
  ReleaseArchiveReadback,
  decode_release_archive_manifest,
  observe_release_archives,
} from "../lib/release_archive_observation"
import { release_harness_root } from "../lib/release_paths"
import { release_public_readbacks } from "../testdata/release_publication_fixtures"

const SOURCE = "6f1796501c9870074644c47c50200b05f4548e03"

const PREPARED = "213a5793a8b25d72e49160b4f6182c3b59026ca3"

const REPO = "burin-labs/harn"

fn manifest_text(fs: HarnessFs) -> string {
  return fs.read_text(
    path_join(release_harness_root(fs), "tests/fixtures/release-controller-157-manifest.json"),
  )
}

fn readbacks(fs: HarnessFs) -> list<ReleaseArchiveReadback> {
  return release_public_readbacks(fs)
}

fn producer() -> ReleaseArchiveProducer {
  return {
    repository: REPO,
    workflow: "build-release-binaries.yml",
    source: SOURCE,
    run_id: 37167101058,
    run_attempt: 1,
    status: "completed",
    conclusion: "success",
  }
}

pipeline test_published_157_combined_source_and_actual_readbacks_match(harness: Harness) {
  const result = observe_release_archives(
    REPO,
    SOURCE,
    manifest_text(harness.fs),
    producer(),
    readbacks(harness.fs),
  )
  assert_eq(result.state, "verified")
  assert_eq([result.expected_files, result.measured_files], [5, 5])
  assert_eq(result.pending_names, [])
  assert_eq(result.failing_names, [])
  // The prepared PR head genuinely differs from the actual archive source.
  const wrong = observe_release_archives(
    REPO,
    PREPARED,
    manifest_text(harness.fs),
    producer(),
    readbacks(harness.fs),
  )
  assert_eq(wrong.state, "failed")
  assert(wrong.failing_names.contains("candidate_manifest_source"))
}

pipeline test_public_assets_require_measured_sidecars(harness: Harness) {
  const archives = readbacks(harness.fs)
  const missing = observe_release_archives(
    REPO,
    SOURCE,
    manifest_text(harness.fs),
    producer(),
    archives,
    "public_assets",
  )
  assert_eq(missing.state, "pending")
  assert_eq([missing.expected_files, missing.measured_files], [7, 5])
  assert_eq(missing.pending_names, ["SHA256SUMS", "release-assets.json"])
  const sidecars = release_public_readbacks(harness.fs, true)
  const all = archives + sidecars
  const complete = observe_release_archives(
    REPO,
    SOURCE,
    manifest_text(harness.fs),
    producer(),
    all,
    "public_assets",
  )
  assert_eq(complete.state, "verified")
  assert_eq([complete.expected_files, complete.measured_files], [7, 7])
  for altered in [
    archives + sidecars.map({ row -> row + {sha256: "invalid"} }).to_list(),
    all + [sidecars[0]!],
  ] {
    const failed = observe_release_archives(
      REPO,
      SOURCE,
      manifest_text(harness.fs),
      producer(),
      altered,
      "public_assets",
    )
    assert_eq(failed.state, "failed")
    assert(failed.failing_names.contains("SHA256SUMS"))
  }
}

pipeline test_missing_manifest_producer_or_bytes_are_pending(harness: Harness) {
  const empty = observe_release_archives(REPO, "", nil, nil, [])
  assert_eq(empty.state, "pending")
  assert_eq(empty.pending_names, ["merged_source", "candidate_manifest", "archive_producer"])
  const missing_producer = observe_release_archives(
    REPO,
    SOURCE,
    manifest_text(harness.fs),
    nil,
    readbacks(harness.fs),
  )
  assert_eq(missing_producer.state, "pending")
  assert_eq(missing_producer.pending_names, ["archive_producer"])
  const missing_bytes = observe_release_archives(
    REPO,
    SOURCE,
    manifest_text(harness.fs),
    producer(),
    [],
  )
  assert_eq(missing_bytes.state, "pending")
  assert_eq(
    [missing_bytes.expected_files, missing_bytes.measured_files, len(missing_bytes.pending_names)],
    [5, 0, 5],
  )
}

pipeline test_failed_wrong_or_unreported_producer_attempt_cannot_verify(harness: Harness) {
  for changed in [
    producer() + {conclusion: "failure"},
    producer() + {conclusion: ""},
    producer() + {source: PREPARED},
    producer() + {repository: "burin-labs/other"},
    producer() + {workflow: "some-other.yml"},
    producer() + {run_id: 37167771166},
    producer() + {run_attempt: 2},
    producer() + {run_id: 0},
  ] {
    assert_eq(
      observe_release_archives(
        REPO,
        SOURCE,
        manifest_text(harness.fs),
        changed,
        readbacks(harness.fs),
      ).state,
      "failed",
    )
  }
  const active = observe_release_archives(
    REPO,
    SOURCE,
    manifest_text(harness.fs),
    producer() + {status: "in_progress", conclusion: ""},
    readbacks(harness.fs),
  )
  assert_eq(active.state, "pending")
  assert_eq(active.pending_names, ["archive_producer_verdict"])
}

pipeline test_corrupt_duplicate_missing_and_unexpected_public_files_refuse(harness: Harness) {
  const actual = readbacks(harness.fs)
  const first = actual[0]!
  const corrupt = actual.map(
    { entry ->
      if entry.file == first.file {
        entry + {sha256: "corrupt"}
      } else {
        entry
      }
    },
  )
    .to_list()
  for changed in [
    corrupt,
    actual + [first],
    actual + [{file: "unbound.tar.gz", sha256: first.sha256}],
  ] {
    const result = observe_release_archives(
      REPO,
      SOURCE,
      manifest_text(harness.fs),
      producer(),
      changed,
    )
    assert_eq(result.state, "failed")
    assert(len(result.failing_names) > 0)
  }
  const missing = observe_release_archives(
    REPO,
    SOURCE,
    manifest_text(harness.fs),
    producer(),
    actual.skip(1).to_list(),
  )
  assert_eq(missing.state, "pending")
  assert_eq(missing.pending_names, [first.file])
  assert_eq(missing.measured_files, 4)
}

pipeline test_manifest_decode_cannot_hide_missing_or_misclassified_archives(harness: Harness) {
  const original: ReleaseArchiveManifest = unwrap(
    decode_release_archive_manifest(manifest_text(harness.fs)),
  )
  for changed in [
    original + {artifacts: []},
    original + {artifacts: original.artifacts + [original.artifacts[0]!]},
    original + {sourceCommit: ""},
    original + {runId: "0"},
    original + {runAttempt: "0"},
    original + {artifacts: original.artifacts.map({ entry -> entry + {kind: "notes"} }).to_list()},
    original + {artifacts: original.artifacts.map({ entry -> entry + {sha256: ""} }).to_list()},
  ] {
    assert(is_err(decode_release_archive_manifest(json_stringify(changed))))
    assert_eq(
      observe_release_archives(REPO, SOURCE, json_stringify(changed), producer(), []).state,
      "failed",
    )
  }
  for invalid in ["", "{}", "null", "not json"] {
    assert(is_err(decode_release_archive_manifest(invalid)))
  }
}
