import {
  ReleaseLaneHolder,
  ReleaseLaneRequest,
  claim_release_lane,
  finish_release_lane,
  parse_release_lane_headline,
  release_lane_blocking_reason,
  release_lane_claim_state,
  release_lane_headline,
  release_lane_ref,
  release_lane_report,
} from "../lib/release_lane_lock"
import { ReleaseOwnerGuard } from "../lib/release_owner_guard"
import { release_lane_preflight } from "../lib/release_preflight"
import { GithubClientOptions } from "harn-github-connector/default"

const NOW = "2026-08-04T16:41:00Z"

fn holder() -> ReleaseLaneHolder {
  return {
    run_id: "019fc846",
    host: "hosted-runner",
    mode: "ship-pr",
    started_at: "2026-08-04T16:00:00Z",
  }
}

fn lost(headline: string) {
  return {
    repo: "burin-labs/harn",
    ref: release_lane_ref("0.10.53"),
    oid: "1111111111111111111111111111111111111111",
    claimed: false,
    holder_headline: headline,
  }
}

pipeline test_a_lane_is_not_a_branch(task: any) {
  // A ref under `refs/heads/` is a branch: it appears in branch pickers and
  // stale-branch reports, and it inherits whatever ruleset governs branch
  // names. A lock is none of those things.
  const ref = release_lane_ref("0.10.53")
  assert_eq(ref, "refs/release-lane/v0.10.53")
  assert_eq(starts_with(ref, "refs/heads/"), false)
}

pipeline test_the_payload_headline_round_trips(task: any) {
  // The headline is the whole channel: `holder_headline` is one line, so what
  // does not fit on it cannot reach a contended caller at all.
  const headline = release_lane_headline("0.10.53", holder())
  assert_eq(len(split(headline, "\n")), 1)
  assert_eq(parse_release_lane_headline(headline), holder())
}

pipeline test_hosted_payload_binds_lane_run_to_exact_workflow_attempt(task: any) {
  const hosted: ReleaseLaneHolder = holder()
    + {workflow_run_id: 32995361606, workflow_run_attempt: 2}
  const headline = release_lane_headline("0.10.118", hosted)
  assert(contains(headline, "workflow_run=32995361606 workflow_attempt=2"))
  assert_eq(parse_release_lane_headline(headline), hosted)
}

pipeline test_a_headline_this_module_did_not_write_parses_to_nothing(task: any) {
  for headline in [
    "",
    "Merge pull request #1234 from burin-labs/feature",
    "release-lane v0.10.53 run=019fc846 host=hosted-runner",
    "release-lane run=019fc846 host=h mode=m started=s",
  ] {
    assert_eq(parse_release_lane_headline(headline), nil)
  }
}

pipeline test_an_uncontended_claim_holds_the_lane(task: any) {
  const claim = release_lane_claim_state(
    {
      repo: "burin-labs/harn",
      ref: release_lane_ref("0.10.53"),
      oid: "2222222222222222222222222222222222222222",
      claimed: true,
      holder_headline: "",
    },
    "0.10.53",
    NOW,
    "laptop",
  )
  assert_eq(claim.state, "acquired")
  assert_eq(claim.holder, nil)
  // A release that is alone should not spend a line saying so.
  assert_eq(release_lane_report(claim), [])
  assert_eq(release_lane_blocking_reason(claim), nil)
}

pipeline test_a_contended_claim_names_the_holder_and_its_age(task: any) {
  // The v0.10.53 collision, reported at minute one instead of minute
  // sixty-three: the losing run learns which run, on which machine, in which
  // mode, and for how long.
  const claim = release_lane_claim_state(
    lost(release_lane_headline("0.10.53", holder())),
    "0.10.53",
    NOW,
    "laptop",
  )
  assert_eq(claim.state, "held")
  assert_eq(claim.holder?.run_id, "019fc846")
  assert_eq(claim.held_for_minutes, 41)
  assert(contains(claim.message, "run 019fc846 on hosted-runner"))
  assert(contains(claim.message, "41m ago"))
  assert(contains(to_string(release_lane_report(claim)), "do not dispatch a duplicate release"))
  assert(contains(release_lane_blocking_reason(claim) ?? "", "release lane unavailable"))
}

pipeline test_a_lane_held_by_this_host_is_already_abandoned(task: any) {
  // The caller holds this host's release lease, so no other release process is
  // running here. A lane still claimed by this host belongs to a run that is
  // gone — knowable now, rather than after the three-hour staleness window.
  // This is the state every retry after a failed release lands in.
  const mine: ReleaseLaneHolder = {
    run_id: holder().run_id,
    host: "laptop",
    mode: holder().mode,
    started_at: holder().started_at,
  }
  const claim = release_lane_claim_state(
    lost(release_lane_headline("0.10.53", mine)),
    "0.10.53",
    NOW,
    "laptop",
  )
  assert_eq(claim.state, "abandoned")
  assert(contains(claim.message, "this host's run 019fc846"))
  assert(contains(to_string(release_lane_report(claim)), "abandon_release_attempts.harn"))
}

pipeline test_a_lane_held_past_the_window_is_reported_stale(task: any) {
  const old: ReleaseLaneHolder = {
    run_id: holder().run_id,
    host: holder().host,
    mode: holder().mode,
    started_at: "2026-08-04T10:00:00Z",
  }
  const claim = release_lane_claim_state(
    lost(release_lane_headline("0.10.53", old)),
    "0.10.53",
    NOW,
    "laptop",
  )
  assert_eq(claim.state, "stale")
  assert_eq(claim.held_for_minutes, 401)
  assert(contains(claim.message, "past the 180m mark"))
}

pipeline test_a_holder_whose_payload_is_unreadable_still_holds_the_lane(task: any) {
  // GitHub collects an unreferenced payload, and a ref can be pointed at
  // anything. Neither makes the lane free.
  const claim = release_lane_claim_state(lost(""), "0.10.53", NOW, "laptop")
  assert_eq(claim.state, "held")
  assert_eq(claim.holder, nil)
  assert_eq(claim.held_for_minutes, 0)
  assert(contains(claim.message, "no readable payload"))
  assert_eq(len(release_lane_report(claim)), 2)
}

pipeline test_an_unparseable_timestamp_does_not_invent_an_age(task: any) {
  const broken: ReleaseLaneHolder = {
    run_id: holder().run_id,
    host: holder().host,
    mode: holder().mode,
    started_at: "yesterday",
  }
  const claim = release_lane_claim_state(
    lost(release_lane_headline("0.10.53", broken)),
    "0.10.53",
    NOW,
    "laptop",
  )
  assert_eq(claim.held_for_minutes, 0)
  assert_eq(claim.state, "held")
}

const API = "https://github.test"

const LANE_REF = "release-lane/v0.10.53"

const THEIRS = "1111111111111111111111111111111111111111"

const MINE = "7777777777777777777777777777777777777777"

fn api_options() -> GithubClientOptions {
  return {api_base_url: API, installation_token: "release-lane-test-token"}
}

fn lane_request() -> ReleaseLaneRequest {
  return {
    slug: "burin-labs/harn",
    base_branch: "main",
    version: "0.10.53",
    holder: {run_id: "019fd000", host: "laptop", mode: "ship-pr", started_at: NOW},
    now: NOW,
    options: api_options(),
  }
}

fn json(testing: HarnessTesting, method: string, url: string, status: int, body: dict) {
  testing.http_mock(method, url, {status: status, body: json_stringify(body)})
}

const BASE_TIP = "3333333333333333333333333333333333333333"

const BASE_TREE = "4444444444444444444444444444444444444444"

/**
 * Every request a claim that mints its own payload makes, in order.
 *
 * `creates` is one scripted response per ref-create attempt, which is what
 * makes a reclaim expressible at all: the same URL has to refuse the first
 * claim and accept the one that follows the delete.
 */
fn mock_mint_and_create(testing: HarnessTesting, creates: list<dict>) {
  json(
    testing,
    "GET",
    API + "/repos/burin-labs/harn/git/ref/heads/main",
    200,
    {ref: "refs/heads/main", object: {sha: BASE_TIP, type: "commit"}},
  )
  json(
    testing,
    "GET",
    API + "/repos/burin-labs/harn/git/commits/" + BASE_TIP,
    200,
    {sha: BASE_TIP, tree: {sha: BASE_TREE}},
  )
  json(
    testing,
    "POST",
    API + "/repos/burin-labs/harn/git/commits",
    201,
    {sha: MINE, tree: {sha: BASE_TREE}},
  )
  testing.http_mock("POST", API + "/repos/burin-labs/harn/git/refs", {responses: creates})
}

fn taken() -> dict {
  return {status: 422, body: json_stringify({message: "Reference already exists"})}
}

fn created() -> dict {
  return {status: 201, body: json_stringify({ref: "refs/" + LANE_REF})}
}

fn mock_lane_held_by(testing: HarnessTesting, host: string) {
  json(
    testing,
    "GET",
    API + "/repos/burin-labs/harn/git/ref/" + LANE_REF,
    200,
    {ref: "refs/" + LANE_REF, object: {sha: THEIRS, type: "commit"}},
  )
  json(
    testing,
    "GET",
    API + "/repos/burin-labs/harn/git/commits/" + THEIRS,
    200,
    {
      sha: THEIRS,
      message: release_lane_headline(
        "0.10.53",
        {run_id: "019fc846", host: host, mode: "ship-pr", started_at: "2026-08-04T16:00:00Z"},
      ),
    },
  )
}

fn deletes(testing: HarnessTesting) -> int {
  return len(testing.http_mock_calls().filter({ call -> call.method == "DELETE" }).to_list())
}

fn acquired_lane() {
  return {
    state: "acquired",
    version: "0.10.53",
    ref: "refs/" + LANE_REF,
    oid: MINE,
    holder: nil,
    held_for_minutes: 0,
    message: "holds the release lane for v0.10.53",
  }
}

fn lane_defer_probe(fs: HarnessFs, path: string, outcome: string) {
  defer {
    fs.write_text(path, "finished")
  }
  if outcome == "early_return" {
    return
  }
  if outcome == "exception" {
    throw "expected probe exception"
  }
}

pipeline test_lane_finalizer_scope_covers_success_early_return_and_exception(
  harness: Harness,
  task: any,
) {
  for outcome in ["success", "early_return", "exception"] {
    const marker = path_join(
      harness.fs.temp_dir(),
      "lane-defer-" + outcome + "-" + harness.random.uuid_v7(),
    )
    try {
      lane_defer_probe(harness.fs, marker, outcome)
    } catch (error) {
      assert_eq(outcome, "exception")
      assert(contains(to_string(error), "expected probe exception"))
    }
    assert_eq(harness.fs.read_text(marker), "finished")
  }
}

pipeline test_terminal_finish_releases_the_exact_owned_lane(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  json(
    harness.testing,
    "GET",
    API + "/repos/burin-labs/harn/git/ref/" + LANE_REF,
    200,
    {ref: "refs/" + LANE_REF, object: {sha: MINE, type: "commit"}},
  )
  json(harness.testing, "DELETE", API + "/repos/burin-labs/harn/git/refs/" + LANE_REF, 204, {})
  const finished = finish_release_lane(harness, "burin-labs/harn", acquired_lane(), api_options())
  assert_eq(finished.attempted, true)
  assert_eq(finished.released, true)
  assert_eq(finished.reason, "released")
  assert_eq(deletes(harness.testing), 1)
}

pipeline test_normal_finish_allows_immediate_same_version_reacquisition(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  json(
    harness.testing,
    "GET",
    API + "/repos/burin-labs/harn/git/ref/" + LANE_REF,
    200,
    {ref: "refs/" + LANE_REF, object: {sha: MINE, type: "commit"}},
  )
  json(harness.testing, "DELETE", API + "/repos/burin-labs/harn/git/refs/" + LANE_REF, 204, {})
  mock_mint_and_create(harness.testing, [created()])
  const finished = finish_release_lane(harness, "burin-labs/harn", acquired_lane(), api_options())
  assert_eq(finished.released, true)
  const next = claim_release_lane(harness, lane_request())
  assert_eq(next.state, "acquired")
  assert_eq(next.reclaimed ?? false, false)
}

pipeline test_terminal_finish_never_deletes_a_replacement_holder(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  json(
    harness.testing,
    "GET",
    API + "/repos/burin-labs/harn/git/ref/" + LANE_REF,
    200,
    {ref: "refs/" + LANE_REF, object: {sha: THEIRS, type: "commit"}},
  )
  const finished = finish_release_lane(harness, "burin-labs/harn", acquired_lane(), api_options())
  assert_eq(finished.attempted, true)
  assert_eq(finished.released, false)
  assert_eq(finished.reason, "held_by_another")
  assert_eq(deletes(harness.testing), 0)
}

pipeline test_terminal_finish_is_a_noop_without_ownership(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  const finished = finish_release_lane(harness, "burin-labs/harn", nil, api_options())
  assert_eq(finished.attempted, false)
  assert_eq(finished.reason, "not_owned")
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}

pipeline test_a_lane_this_host_abandoned_is_taken_back_rather_than_reported(
  harness: Harness,
  task: any,
) {
  // A process killed before its defer runs still leaves a lane. The next run on
  // this host can prove that prior process is gone because it owns the host
  // lease, then use the same exact-OID cleanup primitive before reclaiming.
  harness.testing.http_mock_clear()
  mock_lane_held_by(harness.testing, "laptop")
  // Refused, then accepted: the second claim wins the ref the delete just freed.
  mock_mint_and_create(harness.testing, [taken(), created()])
  json(harness.testing, "DELETE", API + "/repos/burin-labs/harn/git/refs/" + LANE_REF, 204, {})
  const claim = claim_release_lane(harness, lane_request())
  assert_eq(claim.state, "acquired")
  assert_eq(claim.reclaimed, true)
  assert_eq(deletes(harness.testing), 1)
  assert(contains(claim.message, "abandoned run 019fc846"))
  assert(contains(to_string(release_lane_report(claim)), "reclaimed the release lane"))
}

pipeline test_a_lane_another_machine_holds_is_never_deleted(harness: Harness, task: any) {
  // The falsifier for the reclaim. Same shape, same refusal, one field
  // different: the holder is not this host, so there is no proof its run is
  // gone and taking the lane would be taking it from a live release.
  harness.testing.http_mock_clear()
  mock_lane_held_by(harness.testing, "hosted-runner")
  mock_mint_and_create(harness.testing, [taken()])
  json(harness.testing, "DELETE", API + "/repos/burin-labs/harn/git/refs/" + LANE_REF, 204, {})
  const claim = claim_release_lane(harness, lane_request())
  assert_eq(claim.state, "held")
  assert_eq(claim.reclaimed ?? false, false)
  assert_eq(deletes(harness.testing), 0, "another machine's lane was left alone")
}

pipeline test_a_reclaim_that_cannot_free_the_ref_reports_the_abandoned_lane(
  harness: Harness,
  task: any,
) {
  // The delete is itself leased on the exact oid, so a lane that changes hands
  // between the read and the delete refuses. Reaching an operator with
  // `abandoned` means exactly this: the reclaim was tried and could not finish.
  harness.testing.http_mock_clear()
  mock_lane_held_by(harness.testing, "laptop")
  mock_mint_and_create(harness.testing, [taken()])
  json(
    harness.testing,
    "DELETE",
    API + "/repos/burin-labs/harn/git/refs/" + LANE_REF,
    500,
    {message: "Server Error"},
  )
  const claim = claim_release_lane(harness, lane_request())
  assert_eq(claim.state, "abandoned")
  assert(contains(to_string(release_lane_report(claim)), "abandon_release_attempts.harn"))
}

pipeline test_only_a_live_owned_prepare_or_ship_claims_a_lane(harness: Harness, task: any) {
  // Claiming publishes a real ref into the release repository. An audit and a
  // mock run both promise not to have side effects there, and a run that does
  // not own this host's release lease has no business speaking for it. Each of
  // these must return before any request is built.
  const analysis = {next_version: "0.10.54"}
  const owned: ReleaseOwnerGuard = {state: "disabled"}
  assert_eq(
    release_lane_preflight(harness, {mode: "ship-pr", mock: true, base: "main"}, analysis, owned),
    nil,
  )
  assert_eq(
    release_lane_preflight(harness, {mode: "audit", mock: false, base: "main"}, analysis, owned),
    nil,
  )
  assert_eq(
    release_lane_preflight(harness, {mode: "ship-pr", mock: false, base: "main"}, analysis, owned),
    nil,
  )
}
