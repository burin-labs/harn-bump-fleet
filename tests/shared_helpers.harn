import { GitRemoteRef } from "std/git"
import { release_log_range_arg, release_log_range_args, remote_url_to_slug } from "../lib/git"
import { github_pr_checks, github_pr_number } from "../lib/github"
import {
  crates_io_version_url,
  harn_release_artifacts,
  missing_release_assets,
  release_readiness_detail,
  required_harn_release_build_jobs,
} from "../lib/release_readiness"
import { sandbox_preflight_message } from "../lib/sandbox_preflight"
import {
  is_v_semver,
  latest_semver_tag_from_git_tag_list,
  latest_semver_tag_from_remote_refs,
  next_semver,
  strip_v,
  version_from_release_branch,
  version_from_tag,
} from "../lib/semver"
import {
  command_output,
  fail,
  ok,
  require_shell_arg,
  safe_shell_arg,
  shell_heredoc_command,
  shell_join,
} from "../lib/shell_util"
import { markdown_multiline, single_line_or, truncate_text } from "../lib/text_util"

pipeline test_shared_helpers(task) {
  assert_eq(strip_v("v1.2.3"), "1.2.3")
  assert_eq(strip_v("1.2.3"), "1.2.3")
  assert_eq(is_v_semver("v1.2.3"), true)
  assert_eq(is_v_semver("1.2.3"), false)
  assert_eq(latest_semver_tag_from_git_tag_list("wip\nv0.8.58-alpha\nv0.8.58\nv0.8.57\n"), "v0.8.58")
  assert_eq(latest_semver_tag_from_git_tag_list("not-a-release\nv-next\n"), "")
  const release_refs: list<GitRemoteRef> = [
    {oid: "aaaaaaaa", ref: "refs/tags/v0.9.9", name: "refs/tags/v0.9.9", peeled: false},
    {oid: "bbbbbbbb", ref: "refs/tags/not-a-release", name: "refs/tags/not-a-release", peeled: false},
    {oid: "cccccccc", ref: "refs/tags/v0.10.0", name: "refs/tags/v0.10.0", peeled: false},
    {oid: "dddddddd", ref: "refs/tags/v0.10.0^{}", name: "refs/tags/v0.10.0", peeled: true},
    {oid: "eeeeeeee", ref: "refs/tags/v0.10.0-alpha", name: "refs/tags/v0.10.0-alpha", peeled: false},
  ]
  assert_eq(latest_semver_tag_from_remote_refs(release_refs), "v0.10.0")
  assert_eq(latest_semver_tag_from_remote_refs([]), "")
  assert_eq(next_semver("1.2.3", "patch"), "1.2.4")
  assert_eq(next_semver("1.2.3", "minor"), "1.3.0")
  assert_eq(next_semver("1.2.3", "major"), "2.0.0")
  assert_eq(version_from_release_branch("release/v1.2.3"), "1.2.3")
  assert_eq(version_from_release_branch("main"), "")
  assert_eq(version_from_tag("v1.2.3"), "1.2.3")
  assert_eq(remote_url_to_slug("git@github.com:burin-labs/harn.git"), "burin-labs/harn")
  assert_eq(remote_url_to_slug("https://github.com/burin-labs/harn.git"), "burin-labs/harn")
  assert_eq(remote_url_to_slug("git@github.com:burin-labs/harn.tools.git"), "burin-labs/harn.tools")
  assert_eq(
    remote_url_to_slug("https://github.com/burin-labs/harn.tools.git"),
    "burin-labs/harn.tools",
  )
  assert_eq(remote_url_to_slug("https://github.com/burin-labs/harn/tools.git"), nil)
  assert_eq(remote_url_to_slug("git@github.com:burin-labs/harn/tools.git"), nil)
  assert_eq(remote_url_to_slug("not github"), nil)
  assert_eq(safe_shell_arg("abc"), "'abc'")
  assert_eq(safe_shell_arg("a'b"), "'a'\\''b'")
  assert_eq(safe_shell_arg("a'b'c"), "'a'\\''b'\\''c'")
  assert_eq(safe_shell_arg("a\nb"), nil)
  assert_eq(require_shell_arg("abc", "value"), "'abc'")
  assert_eq(
    shell_join(["ssh", "-o", "BatchMode=yes", "builder host", "echo 'ok'"]),
    "'ssh' '-o' 'BatchMode=yes' 'builder host' 'echo '\\''ok'\\'''",
  )
  assert_eq(
    shell_heredoc_command(["bash", "-s", "--", "a b"], "printf '%s\\n' \"$1\"", "HARN_TEST"),
    "'bash' '-s' '--' 'a b' <<'HARN_TEST'\nprintf '%s\\n' \"$1\"\nHARN_TEST",
  )
  const heredoc_run = shell(shell_heredoc_command(["bash", "-s", "--", "a b"], "printf '%s\\n' \"$1\"", "HARN_TEST"))
  assert_eq(heredoc_run.status, 0)
  assert_eq(trim(heredoc_run.stdout), "a b")
  assert_eq(github_pr_number(123), 123)
  assert_eq(github_pr_number("https://github.com/burin-labs/harn/pull/3915"), 3915)
  assert_eq(github_pr_number("not-a-pr"), nil)
  const bad_checks = github_pr_checks("burin-labs/harn", "not-a-pr")
  assert(is_err(bad_checks), "invalid PR check lookups fail before network dispatch")
  assert_eq(unwrap_err(bad_checks).code, "invalid_pull_request")
  assert_eq(sandbox_preflight_message("unrestricted", "bump_fleet.harn"), nil)
  const preflight_msg = sandbox_preflight_message("worktree", "bump_fleet.harn")
  assert_eq(starts_with(preflight_msg, "error: bump_fleet.harn needs --no-sandbox"), true)
  assert_eq(contains(preflight_msg, "harn run --no-sandbox bump_fleet.harn"), true)
  assert_eq(
    crates_io_version_url("harn-cli", "1.2.3"),
    "https://crates.io/api/v1/crates/harn-cli/1.2.3",
  )
  const all_release_assets = [
    "harn-aarch64-apple-darwin.tar.gz",
    "harn-aarch64-unknown-linux-gnu.tar.gz",
    "harn-x86_64-apple-darwin.tar.gz",
    "harn-x86_64-pc-windows-msvc.zip",
    "harn-x86_64-unknown-linux-gnu.tar.gz",
    "SHA256SUMS",
    "release-assets.json",
  ]
  assert_eq(
    harn_release_artifacts().map({ artifact -> artifact.archive }).to_list(),
    [
      "harn-aarch64-apple-darwin.tar.gz",
      "harn-aarch64-unknown-linux-gnu.tar.gz",
      "harn-x86_64-apple-darwin.tar.gz",
      "harn-x86_64-pc-windows-msvc.zip",
      "harn-x86_64-unknown-linux-gnu.tar.gz",
    ],
  )
  assert_eq(
    required_harn_release_build_jobs(),
    [
      "Build aarch64-apple-darwin",
      "Build aarch64-unknown-linux-gnu",
      "Build x86_64-apple-darwin",
      "Build x86_64-pc-windows-msvc",
      "Build x86_64-unknown-linux-gnu",
    ],
  )
  assert_eq(missing_release_assets(all_release_assets), [])
  assert_eq(
    missing_release_assets(["harn-x86_64-unknown-linux-gnu.tar.gz"]),
    [
      "harn-aarch64-apple-darwin.tar.gz",
      "harn-aarch64-unknown-linux-gnu.tar.gz",
      "harn-x86_64-apple-darwin.tar.gz",
      "harn-x86_64-pc-windows-msvc.zip",
      "SHA256SUMS",
      "release-assets.json",
    ],
  )
  assert_eq(
    missing_release_assets([], ["harn-aarch64-apple-darwin.tar.gz"]),
    ["harn-aarch64-apple-darwin.tar.gz"],
  )
  assert_eq(
    release_readiness_detail(
      {version_no_v: "1.2.3", crate_published: true, missing_assets: ["harn-aarch64-apple-darwin.tar.gz"]},
    ),
    "harn-cli 1.2.3 published; missing release assets: harn-aarch64-apple-darwin.tar.gz",
  )
  const success = ok("stdout")
  assert_eq(success.success, true)
  const failure = fail(2, "stderr")
  assert_eq(failure.status, 2)
  assert_eq(command_output({stdout: "one", stderr: "two"}), "one\ntwo")
  assert_eq(command_output({stdout: "one", stderr: ""}), "one")
  assert_eq(command_output({stdout: "", stderr: "two"}), "two")
  assert_eq(command_output({}), "")
  assert_eq(truncate_text("abcdef", 10), "abcdef")
  assert_eq(truncate_text("abcdef", 3), "abc\n... truncated 3 chars ...")
  assert_eq(single_line_or("a\n b", "fallback"), "a, b")
  assert_eq(single_line_or("", "fallback"), "fallback")
  assert_eq(markdown_multiline("a\\nb"), "a\nb")
  // `release_log_range_arg` caps the commit walk at the pinned upper
  // ref. With both bounds present the result is `tag..pin`; with no
  // upper ref it falls back to `HEAD` for legacy callers; with no
  // lower bound it just walks back from the upper ref.
  assert_eq(
    release_log_range_arg("v0.7.52", "abcdef1234567890abcdef1234567890abcdef12"),
    "v0.7.52..abcdef1234567890abcdef1234567890abcdef12 --max-count=80",
  )
  assert_eq(release_log_range_arg("v0.7.52", ""), "v0.7.52..HEAD --max-count=80")
  assert_eq(release_log_range_arg("v0.7.52", nil), "v0.7.52..HEAD --max-count=80")
  assert_eq(
    release_log_range_arg("", "abcdef1234567890abcdef1234567890abcdef12"),
    "abcdef1234567890abcdef1234567890abcdef12 --max-count=50",
  )
  assert_eq(release_log_range_arg("", ""), "HEAD --max-count=50")
  // Argv form returns the same logical range as a list, ready for git_run.
  assert_eq(
    release_log_range_args("v0.7.52", "abcdef1234567890abcdef1234567890abcdef12"),
    ["v0.7.52..abcdef1234567890abcdef1234567890abcdef12", "--max-count=80"],
  )
  assert_eq(release_log_range_args("", ""), ["HEAD", "--max-count=50"])
}
