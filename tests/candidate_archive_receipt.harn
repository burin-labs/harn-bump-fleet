import { CandidateArchiveGateStartedEvent } from "../lib/candidate_archive_receipt"
import {
  candidate_archive_receipt_matches,
  candidate_archive_receipt_overwrite_allowed,
  candidate_archive_receipt_path,
  candidate_archive_receipt_read,
  candidate_archive_receipt_write,
} from "../lib/candidate_archive_receipt"
import { release_candidate_archive_gate_config } from "../lib/release_execution"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const CANDIDATE_REF = "release-attempt/v1.2.3/" + SHA

fn started() -> CandidateArchiveGateStartedEvent {
  return {
    workflow: "build-release-binaries.yml",
    event: "workflow_dispatch",
    policy_ref: "main",
    expected_policy_sha: SHA,
    source_ref: CANDIDATE_REF,
    expected_source_sha: SHA,
    candidate_only: true,
    runner_profile: "policy",
    targets: "",
    completion_timeout_ms: 100,
    completion_interval_ms: 10,
    transient_view_retry_max_attempts: 3,
    transient_view_retry_base_ms: 1,
    transient_view_retry_cap_ms: 5,
    run_id: 42,
    run_url: "https://github.com/burin-labs/harn/actions/runs/42",
    observed_event: "workflow_dispatch",
    observed_head_branch: "main",
    observed_head_sha: SHA,
    reused: false,
  }
}

pipeline test_candidate_archive_receipt_round_trips_exact_run_identity(harness: Harness) {
  const root = path_join(harness.fs.temp_dir(), "candidate-archive-" + harness.random.uuid_v7())
  const path = candidate_archive_receipt_path(root, SHA)
  const receipt = candidate_archive_receipt_write(
    {fs: harness.fs, random: harness.random},
    path,
    "burin-labs/harn",
    started(),
    "2026-07-27T00:00:00Z",
  )
  assert_eq(candidate_archive_receipt_read(harness.fs, path), receipt)
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  assert_eq(candidate_archive_receipt_matches(receipt, "burin-labs/harn", config), true)
  assert_eq(
    candidate_archive_receipt_matches(
      receipt,
      "burin-labs/harn",
      config + {expected_policy_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
    ),
    false,
  )
  assert_eq(candidate_archive_receipt_overwrite_allowed(nil), true)
  assert_eq(candidate_archive_receipt_overwrite_allowed(receipt), false)
}
