import {
  candidate_archive_certification_ensure,
  candidate_archive_certification_message,
  candidate_archive_certification_record_from_tag,
  candidate_archive_certification_ref,
  candidate_record_read_remote,
} from "../lib/candidate_archive_certification"
import { candidate_archive_dispatch_after_selection } from "../lib/candidate_archive_gate"
import { CandidateArchiveReceipt } from "../lib/candidate_archive_receipt"
import {
  candidate_archive_manifest_artifact_name,
  candidate_archive_reuse_decision,
} from "../lib/candidate_archive_reuse"
import { release_candidate_archive_gate_config } from "../lib/release_execution"

const SOURCE = "ab5e42aa11111111111111111111111111111111"

const POLICY = "183ce6d416dac3b67e591996715a71b2104a6925"

const CERTIFIED_RUN = 33988090262

const REBUILD_RUN = 33998624166

fn receipt(run_id: int = CERTIFIED_RUN) -> CandidateArchiveReceipt {
  return {
    schema_version: "release_harn.candidate_archive.v1",
    slug: "burin-labs/harn",
    workflow: "build-release-binaries.yml",
    event: "workflow_dispatch",
    policy_ref: "main",
    expected_policy_sha: POLICY,
    source_ref: "release-attempt/v0.10.131/${SOURCE}",
    expected_source_sha: SOURCE,
    run_id: run_id,
    run_url: "https://github.com/burin-labs/harn/actions/runs/${run_id}",
    observed_event: "workflow_dispatch",
    observed_head_branch: "main",
    observed_head_sha: POLICY,
    archive_digests: {
      "harn-aarch64-apple-darwin.tar.gz": "a" * 64,
      "harn-x86_64-unknown-linux-gnu.tar.gz": "b" * 64,
    },
    created_at: "2026-09-05T00:00:00Z",
  }
}

fn sh(process: HarnessProcess, command: string) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn fixture(harness: Harness) {
  const root = path_join(
    harness.fs.temp_dir(),
    "candidate-archive-certification-" + harness.random.uuid_v7(),
  )
  const origin = path_join(root, "origin.git")
  const work = path_join(root, "work")
  const key = path_join(root, "release-signing-key")
  sh(harness.process, "git init --bare -q '" + origin + "'")
  sh(harness.process, "git init -q '" + work + "'")
  sh(harness.process, "git -C '" + work + "' config user.name 'harn-release-bot[bot]'")
  sh(
    harness.process,
    "git -C '" + work
      + "' config user.email 'harn-release-bot[bot]@users.noreply.github.com'",
  )
  sh(harness.process, "git -C '" + work + "' checkout -q -b main")
  harness.fs.write_text(path_join(work, "fixture.txt"), "certified\n")
  sh(
    harness.process,
    "git -C '" + work + "' add fixture.txt && git -C '" + work + "' commit -q -m certified",
  )
  sh(harness.process, "git -C '" + work + "' remote add origin '" + origin + "'")
  sh(harness.process, "git -C '" + work + "' push -q -u origin main")
  sh(harness.process, "ssh-keygen -q -t ed25519 -N '' -f '" + key + "'")
  harness.fs.mkdir(path_join(work, ".github"), true)
  harness.fs.write_text(
    path_join(work, ".github", "release-bot-allowed-signers"),
    "harn-release-bot[bot]@users.noreply.github.com "
      + trim(harness.fs.read_text(key + ".pub"))
      + "\n",
  )
  sh(harness.process, "git -C '" + work + "' config gpg.format ssh")
  sh(harness.process, "git -C '" + work + "' config user.signingkey '" + key + "'")
  const head = trim(sh(harness.process, "git -C '" + work + "' rev-parse HEAD").stdout)
  return {root: root, origin: origin, work: work, head: head}
}

fn at_source(base: CandidateArchiveReceipt, source: string) -> CandidateArchiveReceipt {
  return base
    + {source_ref: "release-attempt/v0.10.131/${source}", expected_source_sha: source}
}

pipeline test_signed_certification_message_round_trips_exact_receipt(task: any) {
  const expected = receipt()
  const message = candidate_archive_certification_message(expected)
  const parsed = candidate_archive_certification_record_from_tag(message)
  assert(is_ok(parsed))
  assert_eq(unwrap(parsed).receipt, expected)
  assert_eq(
    candidate_archive_certification_ref(SOURCE),
    "refs/tags/harn-candidate-archive-certification/${SOURCE}",
  )
}

pipeline test_signed_remote_binding_is_write_once_and_read_back(harness: Harness, task: any) {
  const f = fixture(harness)
  const certified = at_source(receipt(CERTIFIED_RUN), f.head)
  const created = candidate_archive_certification_ensure(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    certified,
  )
  assert_eq(created.success, true)
  assert_eq(created.action, "created")
  assert_eq(created.receipt?.run_id, CERTIFIED_RUN)
  const durable = candidate_record_read_remote(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    f.head,
  )
  assert(is_ok(durable))
  assert_eq(unwrap(durable).source_oid, f.head)
  assert_eq(unwrap(durable).attempt_ref, certified.source_ref)
  assert_eq(unwrap(durable).archive_receipt.run_id, CERTIFIED_RUN)
  assert_eq(unwrap(durable).certification_ref, candidate_archive_certification_ref(f.head))
  assert_eq(unwrap(durable).certification_object_oid, created.tag_object_oid)
  const reused = candidate_archive_certification_ensure(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    certified,
  )
  assert_eq(reused.success, true)
  assert_eq(reused.action, "reused")
  assert_eq(reused.tag_object_oid, created.tag_object_oid)
  const conflict = candidate_archive_certification_ensure(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    at_source(receipt(REBUILD_RUN), f.head),
  )
  assert_eq(conflict.success, false)
  assert(contains(conflict.reason, "disagrees"))
  const still_certified = candidate_record_read_remote(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    f.head,
  )
  assert_eq(unwrap(still_certified).archive_receipt.run_id, CERTIFIED_RUN)
  harness.fs.delete(f.root)
}

pipeline test_identical_concurrent_signed_writer_wins_without_false_conflict(
  harness: Harness,
  task: any,
) {
  const f = fixture(harness)
  const certified = at_source(receipt(CERTIFIED_RUN), f.head)
  const competing_tag = "concurrent-candidate-archive-certification"
  sh(
    harness.process,
    "GIT_COMMITTER_DATE='2026-09-05T01:00:00Z' git -C '" + f.work + "' tag -s "
      + competing_tag
      + " -m '"
      + candidate_archive_certification_message(certified)
      + "' "
      + f.head,
  )
  const competing_oid = trim(
    sh(harness.process, "git -C '" + f.work + "' rev-parse refs/tags/" + competing_tag).stdout,
  )
  const staging_ref = "refs/tags/concurrent-certification-object"
  sh(harness.process, "git -C '" + f.work + "' push -q origin " + competing_oid + ":" + staging_ref)
  sh(harness.process, "git --git-dir='" + f.origin + "' update-ref -d " + staging_ref)
  const remote_ref = candidate_archive_certification_ref(f.head)
  const hook = path_join(f.work, ".git", "hooks", "pre-push")
  harness.fs.write_text(
    hook,
    "#!/bin/sh\ngit --git-dir='" + f.origin + "' update-ref '" + remote_ref + "' '"
      + competing_oid
      + "'\n",
  )
  sh(harness.process, "chmod +x '" + hook + "'")
  const reconciled = candidate_archive_certification_ensure(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    certified,
  )
  assert_eq(reconciled.success, true)
  assert_eq(reconciled.action, "reused")
  assert_eq(reconciled.tag_object_oid, competing_oid)
  assert_eq(reconciled.receipt, certified)
  assert(contains(reconciled.reason, "concurrent signed"))
  const conflict = candidate_archive_certification_ensure(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    at_source(receipt(REBUILD_RUN), f.head),
  )
  assert_eq(conflict.success, false)
  assert(contains(conflict.reason, "disagrees"))
  harness.fs.delete(f.root)
}

/**
 * A fresh hosted run has no workspace receipt after its Actions receipt
 * artifact expires. The signed record still selects the originally certified
 * archive from an ambiguous census, before the dispatch boundary is crossed.
 */
pipeline test_fresh_run_root_reuses_signed_run_after_receipt_artifact_expiry_without_dispatch(
  harness: Harness,
  task: any,
) {
  const f = fixture(harness)
  const certified = at_source(receipt(CERTIFIED_RUN), f.head)
  const created = candidate_archive_certification_ensure(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    certified,
  )
  assert(created.success)
  const fresh_run_root = path_join(f.root, "fresh-run-root")
  harness.fs.mkdir(fresh_run_root, true)
  assert_eq(harness.fs.exists(path_join(fresh_run_root, "candidate-archive.json")), false)
  const durable = candidate_record_read_remote(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    f.head,
  )
  assert(is_ok(durable))
  const gate = release_candidate_archive_gate_config("main", POLICY, certified.source_ref, f.head)
  const certified_run = unwrap(durable).archive_receipt.run_id
  assert_eq(certified_run, CERTIFIED_RUN)
  const decision = candidate_archive_reuse_decision(
    [
      {
        id: 1,
        name: candidate_archive_manifest_artifact_name(f.head),
        expired: false,
        run_id: CERTIFIED_RUN,
        run_head_sha: POLICY,
      },
      {
        id: 2,
        name: candidate_archive_manifest_artifact_name(f.head),
        expired: false,
        run_id: REBUILD_RUN,
        run_head_sha: POLICY,
      },
    ],
    gate,
    { _head -> return true },
    certified_run,
  )
  assert_eq(decision.action, "reuse")
  assert_eq(decision.run_id, CERTIFIED_RUN)
  let dispatches = 0
  const selected = candidate_archive_dispatch_after_selection(
    {run_id: decision.run_id, url: certified.run_url, head_sha: decision.run_head_sha},
    gate,
    fn() {
      dispatches = dispatches + 1
      return Err({code: "unexpected_dispatch", message: "must not dispatch"})
    },
  )
  assert(is_ok(selected))
  assert_eq(unwrap(selected).run_id, CERTIFIED_RUN)
  assert_eq(dispatches, 0)
  harness.fs.delete(f.root)
}

pipeline test_unsigned_remote_record_is_not_authority(harness: Harness, task: any) {
  const f = fixture(harness)
  const unsigned = "unsigned-candidate-archive-certification"
  sh(
    harness.process,
    "git -C '" + f.work + "' tag -a " + unsigned + " -m '"
      + candidate_archive_certification_message(at_source(receipt(), f.head))
      + "' "
      + f.head,
  )
  const object = trim(
    sh(harness.process, "git -C '" + f.work + "' rev-parse refs/tags/" + unsigned).stdout,
  )
  sh(
    harness.process,
    "git -C '" + f.work + "' push -q origin " + object + ":"
      + candidate_archive_certification_ref(f.head),
  )
  const observed = candidate_record_read_remote(
    {env: harness.env, process: harness.process},
    {repo: f.work, mock: false},
    f.head,
  )
  assert(is_err(observed))
  assert_eq(unwrap_err(observed).code, "unsigned")
  harness.fs.delete(f.root)
}
