import { plan_fleet_dispatch } from "../lib/fleet_dispatch"
import {
  fleet_scope_excluding,
  harn_bump_repositories,
  operation_harn_bump_repositories,
  read_fleet_manifest,
  scoped_harn_bump_repositories,
} from "../lib/fleet_manifest"
import {
  fleet_operation_scope,
  require_fleet_scope_census,
  require_fleet_scope_digest,
} from "../lib/fleet_operation_scope"
import { harn_update_proof_receipt_complete_at } from "../lib/harn_update"

pipeline test_omitted_scope_accepts_only_empty_workflow_digest() {
  assert(require_fleet_scope_digest(fleet_operation_scope(), ""))
  assert(refused({ -> require_fleet_scope_digest(fleet_operation_scope(), "wrong") }))
  assert(refused({ -> require_fleet_scope_digest(fleet_operation_scope("owner/selected"), "") }))
}

pipeline test_successor_completion_reads_scope_and_exact_repository_rows(
  harness: Harness,
  task: any,
) {
  const scope = fleet_operation_scope(nil, "[\"a\",\"b\"]")
  const path = harness.fs.mkdtemp_in_workspace("scoped-proof-") + "/proof.json"
  const io = {fs: harness.fs, stdio: harness.stdio}
  harness.fs.write_text(
    path,
    json_stringify({complete: true, scope: scope, repositories: [{repo: "a"}, {repo: "b"}]}),
  )
  assert(harn_update_proof_receipt_complete_at(io, path, scope))
  for bad in [
    {complete: true, scope: scope, repositories: [{repo: "a"}, {repo: "excluded"}]},
    {complete: true, scope: {kind: "fleet"}, repositories: [{repo: "a"}, {repo: "b"}]},
  ] {
    harness.fs.write_text(path, json_stringify(bad))
    assert(refused({ -> harn_update_proof_receipt_complete_at(io, path, scope) }))
  }
}

fn refused(callback: closure) -> bool {
  return try {
    callback()
    false
  } catch (_) {
    true
  }
}

pipeline test_skip_consumers_resolves_once_to_exact_included_scope(harness: Harness, task: any) {
  const manifest = read_fleet_manifest(harness.fs, "../fleet.toml")
  const scope = fleet_scope_excluding(manifest, "[\"burin-labs/harn-cloud\"]")
  const selected = operation_harn_bump_repositories(manifest, scope)
  assert_eq(len(selected), len(harn_bump_repositories(manifest)) - 1)
  assert(!selected.any({ repo -> repo.slug == "burin-labs/harn-cloud" }))
  assert_eq(scope.kind, "repositories")
  assert(refused({ -> fleet_scope_excluding(manifest, "[]") }))
  assert(refused({ -> fleet_scope_excluding(manifest, "[\"unknown\"]") }))
  assert(refused({ -> fleet_scope_excluding(manifest, "[\"burin-labs/harn-bump-fleet\"]") }))
  assert(
    refused(
      { ->
        fleet_scope_excluding(
          manifest,
          json_stringify(harn_bump_repositories(manifest).map({ repo -> repo.slug }).to_list()),
        )
      },
    ),
  )
}

pipeline test_operation_scope_selects_exactly_and_projects_same_dispatch(
  harness: Harness,
  task: any,
) {
  const manifest = read_fleet_manifest(harness.fs, "../fleet.toml")
  const wire = "[\"burin-labs/harn-cloud\",\"burin-labs/homebrew-burin\"]"
  const selected = scoped_harn_bump_repositories(manifest, nil, wire)
  assert_eq(
    selected.map({ repo -> repo.slug }).to_list(),
    ["burin-labs/harn-cloud", "burin-labs/homebrew-burin"],
  )
  const plan = plan_fleet_dispatch(manifest, "v0.10.131", "", "123", wire)
  assert_eq(plan.workflow_inputs.repositories_json, wire)
  assert_eq(plan.scope.kind, "repositories")
  for bad in [
    "[]",
    "[\"\"]",
    "[\"burin-labs/harn-cloud\",\"burin-labs/harn-cloud\"]",
    "[\"burin-labs/unknown\"]",
  ] {
    assert(refused({ -> scoped_harn_bump_repositories(manifest, nil, bad) }))
  }
  assert(refused({ -> fleet_operation_scope("burin-labs/harn-cloud", wire) }))
}

pipeline test_operation_proof_requires_exact_members_not_equal_counts(harness: Harness, task: any) {
  assert(require_fleet_scope_census(["a", "b"], ["b", "a"]))
  assert(refused({ -> require_fleet_scope_census(["a", "b"], ["a", "c"]) }))
  assert(refused({ -> require_fleet_scope_census(["a", "b"], ["a"]) }))
  assert(refused({ -> require_fleet_scope_census(["a", "b"], ["a", "a"]) }))
  assert(refused({ -> require_fleet_scope_census([], []) }))
}
