import {
  release_fold_branch,
  release_fold_owed,
  release_fold_pr_is_ours,
  release_fold_title,
} from "../lib/release_fold_repair"
import { release_contract_fixture } from "../testdata/release_contract_fixture"

fn owed(latest_tag: string, workspace: string, changelog_top: string) {
  return release_fold_owed(release_contract_fixture(), latest_tag, workspace, changelog_top)
}

pipeline test_a_published_and_folded_release_owes_nothing(task: any) {
  const decision = owed("v1.2.3", "1.2.4-dev", "1.2.3")
  assert_eq(decision.owed, false)
  assert_eq(decision.changelog_owed, false)
  assert_eq(decision.workspace_owed, false)
}

pipeline test_the_night_this_was_written_is_reported_as_both_halves_owed(task: any) {
  // The exact live shape: v0.10.133 published, the branch still on
  // 0.10.133-dev, the changelog still topping at the release before it.
  const decision = owed("v0.10.133", "0.10.133-dev", "0.10.132")
  assert_eq(decision.owed, true)
  assert_eq(decision.changelog_owed, true)
  assert_eq(decision.workspace_owed, true)
  assert_eq(decision.development_version, "0.10.134-dev")
  assert_eq(contains(decision.reason, "v0.10.133 published but is not folded"), true)
  assert_eq(contains(decision.reason, "0.10.134-dev"), true)
}

pipeline test_a_half_landed_fold_names_only_the_half_still_owed(task: any) {
  // A run can write the changelog and die before the version bump, or the
  // reverse. A repair that treated the two as one thing would redo work that
  // landed or skip work that did not.
  const version_only = owed("v1.2.3", "1.2.3-dev", "1.2.3")
  assert_eq(version_only.changelog_owed, false)
  assert_eq(version_only.workspace_owed, true)
  const changelog_only = owed("v1.2.3", "1.2.4-dev", "1.2.2")
  assert_eq(changelog_only.changelog_owed, true)
  assert_eq(changelog_only.workspace_owed, false)
}

pipeline test_a_branch_still_on_the_released_version_owes_no_bump(task: any) {
  // The released version itself proves the fold; the contract accepts it, and
  // this must not demand a cutover the contract does not.
  const decision = owed("v1.2.3", "1.2.3", "1.2.3")
  assert_eq(decision.workspace_owed, false)
  assert_eq(decision.owed, false)
}

pipeline test_a_repository_with_no_published_release_owes_no_fold(task: any) {
  const decision = owed("", "1.0.0-dev", "")
  assert_eq(decision.owed, false)
  assert_eq(contains(decision.reason, "no release has been published"), true)
}

pipeline test_a_tag_without_its_prefix_is_read_the_same_way(task: any) {
  assert_eq(owed("1.2.3", "1.2.4-dev", "1.2.3").owed, false)
  assert_eq(owed("1.2.3", "1.2.3-dev", "1.2.2").owed, true)
}

pipeline test_a_repair_recognises_only_its_own_branch(task: any) {
  // Matched on the branch the repair itself chose, not on a title anyone
  // touching the pull request can edit. Opening a second fold for a release
  // that already has one leaves two branches claiming the same version.
  assert_eq(release_fold_branch("1.2.3"), "release-fold/v1.2.3")
  assert_eq(release_fold_pr_is_ours("release-fold/v1.2.3", "1.2.3"), true)
  assert_eq(release_fold_pr_is_ours("release-fold/v1.2.4", "1.2.3"), false)
  assert_eq(release_fold_pr_is_ours("automation/fold", "1.2.3"), false)
  assert_eq(release_fold_pr_is_ours("", "1.2.3"), false)
}

pipeline test_the_title_follows_this_repositorys_convention(task: any) {
  const title = release_fold_title("1.2.3")
  assert_eq(starts_with(title, "[Release] "), true)
  assert_eq(contains(title, "v1.2.3"), true)
}
