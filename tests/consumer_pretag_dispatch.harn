  assert_eq(dispatches, 0)
  assert_eq(receipts[0]?.status, "passed")
  assert_eq(receipts[0]?.run_url, "https://runs.test/11")
}

pipeline test_an_active_candidate_run_is_adopted_until_success_without_redispatch() {
