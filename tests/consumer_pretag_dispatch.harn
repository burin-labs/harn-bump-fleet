import {
  CONSUMER_PRETAG_GATE_POLICY,
  ConsumerPretagGateAdapter,
  ConsumerPretagGatePolicy,
  ConsumerPretagRunRow,
  consumer_pretag_gate_policy,
  parse_consumer_pretag_proof_runs_json,
  run_consumer_pretag_gates,
} from "../lib/consumer_pretag_dispatch"
import { ConsumerPretagGateTarget, consumer_pretag_gate_verdict } from "../lib/consumer_pretag_gate"

const FAST: ConsumerPretagGatePolicy = {poll_interval_ms: 1, deadline_ms: 50}

const REVISION = "1234567890abcdef1234567890abcdef12345678"

const OTHER_REVISION = "fedcba9876543210fedcba9876543210fedcba98"

pipeline test_corrected_consumer_adopts_only_its_own_proof() {
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [],
      {
        runs: fn(_target) { return Ok(
          [
            row(11, "completed", "failure") + {head_sha: OTHER_REVISION},
            row(12, "completed", "success"),
          ],
        ) },
        dispatch: fn(_target) {
          throw "existing corrected proof must be adopted"
        },
      },
    ),
    FAST,
  )
  assert_eq(receipts[0]?.status, "passed")
  assert_eq(receipts[0]?.run_url, "https://runs.test/12")
}

pipeline test_two_runs_on_same_consumer_revision_are_ambiguous() {
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [],
      {
        runs: fn(_target) { return Ok(
          [row(11, "completed", "failure"), row(12, "completed", "success")],
        ) },
        dispatch: fn(_target) {
          throw "ambiguous proof must not dispatch"
        },
      },
    ),
    FAST,
  )
  assert_eq(receipts[0]?.status, "unreadable")
}

pipeline test_missing_consumer_revision_refuses_before_dispatch() {
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [],
      {
        consumer_revision: fn(_target) { return Ok("") },
        dispatch: fn(_target) {
          throw "missing revision must not dispatch"
        },
        runs: fn(_target) {
          throw "missing revision must not list"
        },
      },
    ),
    FAST,
  )
  assert_eq(receipts[0]?.status, "unreadable")
}

pipeline test_candidate_run_without_revision_refuses_before_dispatch() {
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [],
      {
        runs: fn(_target) { return Ok([row(11, "completed", "success") + {head_sha: ""}]) },
        dispatch: fn(_target) {
          throw "unknown identity must not dispatch"
        },
      },
    ),
    FAST,
  )
  assert_eq(receipts[0]?.status, "unreadable")
}

pipeline test_dispatch_preserves_captured_revision_and_records_drifted_run() {
  let reads = 0
  let recorded = 0
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [],
      {
        consumer_revision: fn(_target) {
          reads = reads + 1
          return Ok(REVISION)
        },
        dispatch: fn(target) {
          assert_eq(target.consumer_revision, REVISION)
          return Ok({run_id: 22, head_sha: OTHER_REVISION})
        },
        run: fn(_target, _id) {
          throw "drifted dispatch must not be polled as proof"
        },
      },
    ),
    FAST,
    fn(_slug, id) { recorded = id },
  )
  assert_eq(reads, 1)
  assert_eq(recorded, 22)
  assert_eq(receipts[0]?.status, "unreadable")
  assert(contains(receipts[0]?.detail ?? "", "moved during dispatch"))
}

pipeline test_run_poll_cannot_replace_captured_consumer_revision() {
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter([row(11, "completed", "success") + {head_sha: OTHER_REVISION}]),
    FAST,
  )
  assert_eq(receipts[0]?.status, "unreadable")
}

pipeline test_run_poll_refuses_wrong_run_or_candidate_identity() {
  for changed in [
    row(12, "completed", "success"),
    row(11, "completed", "success", "Harn candidate v0.10.129 @ ${REVISION}"),
  ] {
    const receipts = run_consumer_pretag_gates([target()], adapter([changed]), FAST)
    assert_eq(receipts[0]?.status, "unreadable")
  }
}

fn target(slug: string = "owner/consumer") -> ConsumerPretagGateTarget {
  return {
    slug: slug,
    workflow: "candidate-gate.yml",
    version: "v0.10.130",
    revision: REVISION,
    inputs: {source_revision: REVISION},
  }
}

fn job_target() -> ConsumerPretagGateTarget {
  return target()
    + {proof_job: {name: "Candidate product proof", step: "Exercise the candidate"}}
}

fn row(id: int, status: string, conclusion: string, title: string = "") -> ConsumerPretagRunRow {
  return {
    id: id,
    head_sha: REVISION,
    status: status,
    conclusion: conclusion,
    html_url: "https://runs.test/${to_string(id)}",
    display_title: if title == "" {
      "Harn candidate v0.10.130 @ ${REVISION}"
    } else {
      title
    },
  }
}

fn explicit_row(id: int, status: string, conclusion: string) -> ConsumerPretagRunRow {
  return row(id, status, conclusion)
    + {workflow_path: ".github/workflows/candidate-gate.yml", event: "workflow_dispatch"}
}

fn attestation() {
  return {
    run_id: 42,
    proof_job_id: 102,
    proof_step: "Run the harn-linked TUI suite against the candidate",
    excluded_job_ids: [101, 104],
    excluded_checks: ["clean/harness-ownership"],
    baseline_run_id: 90,
    baseline_job_id: 901,
    baseline_workflow_path: ".github/workflows/ci.yml",
  }
}

fn job(id: int, run_id: int, name: string, conclusion: string, head_sha: string = REVISION) {
  return {
    id: id,
    run_id: run_id,
    name: name,
    status: "completed",
    conclusion: conclusion,
    head_sha: head_sha,
    steps: [],
  }
}

fn jobs_page(run_id: int, jobs: list<dict>, head_sha: string = REVISION) {
  return {
    repo: "owner/consumer",
    run_id: run_id,
    total_count: len(jobs),
    jobs: jobs.map({ value -> value + {run_id: run_id, head_sha: head_sha} }).to_list(),
  }
}

fn declared_proof_job(
  id: int = 102,
  status: string = "completed",
  conclusion: string = "success",
  step_status: string = "completed",
  step_conclusion: string = "success",
) {
  return job(id, 11, "Candidate product proof", conclusion)
    + {
      status: status,
      steps: [{name: "Exercise the candidate", status: step_status, conclusion: step_conclusion}],
    }
}

pipeline test_declared_job_success_is_the_gate_and_other_jobs_are_advisory() {
  const jobs = [
    job(100, 11, "Setup", "success"),
    declared_proof_job(),
    job(103, 11, "Advisory rehearsal", "failure"),
    job(104, 11, "Advisory report", "") + {status: "in_progress"},
  ]
  const receipts = run_consumer_pretag_gates(
    [job_target()],
    adapter(
      [row(11, "in_progress", "")],
      {jobs: fn(_target, id) { return Ok(jobs_page(id, jobs)) }},
    ),
    FAST,
  )
  assert_eq(receipts[0]?.status, "passed")
  assert_eq(receipts[0]?.job_proof?.job?.id, 102)
  assert_eq(receipts[0]?.job_proof?.job?.step, "Exercise the candidate")
  assert_eq(len(receipts[0]?.job_proof?.advisory_jobs ?? []), 3)
  assert_eq(receipts[0]?.job_proof?.advisory_jobs?.[1]?.conclusion, "failure")
  assert_eq(receipts[0]?.job_proof?.advisory_jobs?.[2]?.status, "in_progress")
}

pipeline test_missing_duplicate_skipped_or_failed_declared_proof_refuses() {
  const cases = [
    {jobs: [], expected: "unreadable"},
    {jobs: [job(100, 11, "Another job", "success")], expected: "unreadable"},
    {
      jobs: [declared_proof_job(102, "completed", "skipped", "completed", "skipped")],
      expected: "unreadable",
    },
    {
      jobs: [declared_proof_job(102, "completed", "failure", "completed", "failure")],
      expected: "failed",
    },
    {
      jobs: [declared_proof_job(102, "completed", "success", "completed", "skipped")],
      expected: "unreadable",
    },
    {
      jobs: [declared_proof_job(102, "completed", "success", "completed", "failure")],
      expected: "failed",
    },
    {jobs: [declared_proof_job() + {steps: []}], expected: "unreadable"},
    {
      jobs: [
        declared_proof_job()
          + {
            steps: [
              {name: "Exercise the candidate", status: "completed", conclusion: "success"},
              {name: "Exercise the candidate", status: "completed", conclusion: "success"},
            ],
          },
      ],
      expected: "unreadable",
    },
    {jobs: [declared_proof_job(102), declared_proof_job(103)], expected: "unreadable"},
  ]
  for candidate in cases {
    const receipts = run_consumer_pretag_gates(
      [job_target()],
      adapter(
        [row(11, "completed", "failure")],
        {jobs: fn(_target, id) { return Ok(jobs_page(id, candidate.jobs)) }},
      ),
      FAST,
    )
    assert_eq(receipts[0]?.status, candidate.expected)
    assert(!consumer_pretag_gate_verdict([job_target()], receipts).proven)
  }
}

pipeline test_a_nonterminal_declared_proof_step_stays_unproven_at_the_deadline() {
  const receipts = run_consumer_pretag_gates(
    [job_target()],
    adapter(
      [row(11, "completed", "success")],
      {
        jobs: fn(_target, id) { return Ok(
          jobs_page(id, [declared_proof_job(102, "completed", "success", "in_progress", "")]),
        ) },
      },
    ),
    FAST,
  )
  assert_eq(receipts[0]?.status, "pending")
  assert(contains(receipts[0]?.detail ?? "", "declared-job proof"))
  assert(!consumer_pretag_gate_verdict([job_target()], receipts).proven)
}

pipeline test_pending_declared_proof_polls_until_its_step_passes() {
  let reads = 0
  const receipts = run_consumer_pretag_gates(
    [job_target()],
    adapter(
      [row(11, "in_progress", "")],
      {
        jobs: fn(_target, id) {
          reads = reads + 1
          return Ok(
            jobs_page(
              id,
              if reads == 1 {
                [declared_proof_job(102, "in_progress", "", "in_progress", "")]
              } else {
                [declared_proof_job()]
              },
            ),
          )
        },
      },
    ),
    FAST,
  )
  assert_eq(reads, 2)
  assert_eq(receipts[0]?.status, "passed")
}

pipeline test_wrong_candidate_identity_refuses_before_reading_declared_job() {
  let job_reads = 0
  const receipts = run_consumer_pretag_gates(
    [job_target()],
    adapter(
      [row(11, "completed", "success", "Harn candidate v0.10.129 @ ${REVISION}")],
      {
        jobs: fn(_target, id) {
          job_reads = job_reads + 1
          return Ok(jobs_page(id, [declared_proof_job()]))
        },
      },
    ),
    FAST,
  )
  assert_eq(job_reads, 0)
  assert_eq(receipts[0]?.status, "unreadable")
}

pipeline test_incomplete_declared_job_census_refuses_the_proof() {
  const receipts = run_consumer_pretag_gates(
    [job_target()],
    adapter(
      [row(11, "completed", "success")],
      {
        jobs:
          fn(_target, id) { return Ok(jobs_page(id, [declared_proof_job()]) + {total_count: 2}) },
      },
    ),
    FAST,
  )
  assert_eq(receipts[0]?.status, "unreadable")
  assert(contains(receipts[0]?.detail ?? "", "completely describe"))
  assert(!consumer_pretag_gate_verdict([job_target()], receipts).proven)
}

pipeline test_explicit_run_input_is_closed_and_canonical() {
  assert_eq(
    parse_consumer_pretag_proof_runs_json("{\"z/repo\":22,\"a/repo\":11}"),
    {"a/repo": 11, "z/repo": 22},
  )
  for invalid in ["[]", "{\"owner/repo\":0}", "{\"owner/repo\":\"11\"}", "{\"bad\":11}"] {
    let failed = false
    try {
      let _ = parse_consumer_pretag_proof_runs_json(invalid)
    } catch (_error) {
      failed = true
    }
    assert(failed)
  }
  const recovered = parse_consumer_pretag_proof_runs_json(
    "{\"owner/repo\":${json_stringify(attestation())}}",
  )
  assert_eq(recovered["owner/repo"], attestation())
}

pipeline test_one_baseline_backed_failure_can_be_attested_but_no_other_red_can() {
  const run_reader = fn(_target, id) { return Ok(
    if id == 42 {
      explicit_row(42, "completed", "failure")
    } else {
      explicit_row(90, "completed", "failure")
        + {
          workflow_path: ".github/workflows/ci.yml",
          event: "push",
          head_branch: "main",
          head_sha: OTHER_REVISION,
        }
    },
  ) }
  const candidate_jobs = [
    job(100, 42, "Detect repin machinery changes", "success"),
    job(101, 42, "Rehearse the Harn repin surface", "failure"),
    job(102, 42, "Prove the candidate against the harn-linked TUI suite", "success")
      + {
        steps: [
          {
            name: "Run the harn-linked TUI suite against the candidate",
            status: "completed",
            conclusion: "success",
          },
        ],
      },
    job(104, 42, "Harn repin rehearsal", "failure"),
  ]
  const adapter_with_jobs = fn(extra: list<dict>) { return adapter(
    [],
    {
      run: run_reader,
      jobs: fn(_target, id) { return Ok(
        if id == 42 {
          jobs_page(42, candidate_jobs + extra)
        } else {
          jobs_page(90, [job(901, 90, "Harn lint", "failure", OTHER_REVISION)], OTHER_REVISION)
        },
      ) },
    },
  ) }
  const accepted = run_consumer_pretag_gates(
    [target()],
    adapter_with_jobs([]),
    FAST,
    nil,
    {"owner/consumer": attestation()},
  )
  assert_eq(accepted[0]?.status, "passed")
  assert_eq(accepted[0]?.attestation?.candidate_revision, REVISION)
  assert_eq(accepted[0]?.attestation?.consumer_revision, REVISION)
  assert_eq(accepted[0]?.attestation?.proof_job?.id, 102)
  assert_eq(accepted[0]?.attestation?.excluded_checks, ["clean/harness-ownership"])
  assert_eq(len(accepted[0]?.attestation?.excluded_jobs ?? []), 2)
  assert_eq(accepted[0]?.attestation?.baseline_run?.id, 90)
  const refused = run_consumer_pretag_gates(
    [target()],
    adapter_with_jobs([job(103, 42, "Unexpected candidate test", "failure")]),
    FAST,
    nil,
    {"owner/consumer": attestation()},
  )
  assert_eq(refused[0]?.status, "unreadable")
  assert(contains(refused[0]?.detail ?? "", "unaccounted or missing failed jobs"))
  for invalid_attestation in [
    attestation() + {proof_step: "A proof step that never ran"},
    attestation() + {baseline_job_id: 902},
  ] {
    const invalid = run_consumer_pretag_gates(
      [target()],
      adapter_with_jobs([]),
      FAST,
      nil,
      {"owner/consumer": invalid_attestation},
    )
    assert_eq(invalid[0]?.status, "unreadable")
  }
  const pending_job = run_consumer_pretag_gates(
    [target()],
    adapter_with_jobs([job(103, 42, "Still running", "") + {status: "in_progress"}]),
    FAST,
    nil,
    {"owner/consumer": attestation()},
  )
  assert_eq(pending_job[0]?.status, "unreadable")
  assert(contains(pending_job[0]?.detail ?? "", "pending jobs"))
  const pending_run = run_consumer_pretag_gates(
    [target()],
    adapter([], {run: fn(_target, _id) { return Ok(explicit_row(42, "in_progress", "")) }}),
    FAST,
    nil,
    {"owner/consumer": attestation()},
  )
  assert_eq(pending_run[0]?.status, "unreadable")
  assert(contains(pending_run[0]?.detail ?? "", "not terminal"))
}

pipeline test_unknown_explicit_run_refuses_the_whole_request_before_io() {
  let calls = 0
  const refuse_io = fn(_target) {
    calls = calls + 1
    return Ok(REVISION)
  }
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [],
      {
        consumer_revision: refuse_io,
        runs: fn(_target) {
          calls = calls + 1
          return Ok([])
        },
        dispatch: fn(_target) {
          calls = calls + 1
          return Ok({run_id: 99, head_sha: REVISION})
        },
        run: fn(_target, _run_id) {
          calls = calls + 1
          return Ok(explicit_row(42, "completed", "success"))
        },
      },
    ),
    FAST,
    nil,
    {"owner/consumer": 42, "owner/unknown": 43},
  )
  assert_eq(calls, 0)
  assert_eq(len(receipts), 1)
  assert_eq(receipts[0]?.slug, "owner/unknown")
  assert_eq(receipts[0]?.status, "unreadable")
}

pipeline test_explicit_run_binds_its_source_when_consumer_main_moved() {
  let dispatches = 0
  let list_reads = 0
  let main_reads = 0
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [],
      {
        consumer_revision: fn(_target) {
          main_reads = main_reads + 1
          return Ok(OTHER_REVISION)
        },
        runs: fn(_target) {
          list_reads = list_reads + 1
          return Ok([])
        },
        dispatch: fn(_target) {
          dispatches = dispatches + 1
          return Ok({run_id: 99, head_sha: OTHER_REVISION})
        },
        run: fn(_target, id) {
          assert_eq(id, 42)
          return Ok(explicit_row(42, "completed", "success"))
        },
      },
    ),
    FAST,
    nil,
    {"owner/consumer": 42},
  )
  assert_eq(main_reads, 0)
  assert_eq(list_reads, 0)
  assert_eq(dispatches, 0)
  assert_eq(receipts[0]?.status, "passed")
}

pipeline test_explicit_in_progress_run_waits_under_the_existing_deadline() {
  let reads = 0
  let waits = 0
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [],
      {
        run: fn(_target, id) {
          assert_eq(id, 42)
          reads = reads + 1
          return Ok(
            explicit_row(
              42,
              if reads < 3 {
                "in_progress"
              } else {
                "completed"
              },
              if reads < 3 {
                ""
              } else {
                "success"
              },
            ),
          )
        },
        wait: fn(ms) {
          waits = waits + ms
          return nil
        },
      },
    ),
    FAST,
    nil,
    {"owner/consumer": 42},
  )
  assert_eq(reads, 3)
  assert(waits > 0)
  assert_eq(receipts[0]?.status, "passed")
}

pipeline test_explicit_run_identity_mismatches_fail_without_fallback_dispatch() {
  for changed in [
    explicit_row(41, "completed", "success"),
    explicit_row(42, "completed", "success")
      + {workflow_path: ".github/workflows/other.yml"},
    explicit_row(42, "completed", "success") + {event: "push"},
