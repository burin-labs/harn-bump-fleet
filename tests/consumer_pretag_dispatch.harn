      + {display_title: "Harn candidate v0.10.129 @ ${REVISION}"},
    explicit_row(42, "completed", "success") + {head_sha: ""},
  ] {
    let dispatches = 0
    const receipts = run_consumer_pretag_gates(
      [target()],
      adapter(
        [],
        {
          run: fn(_target, _id) { return Ok(changed) },
          dispatch: fn(_target) {
