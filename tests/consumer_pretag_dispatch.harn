}

pipeline test_missing_or_nonjudging_explicit_run_fails_closed() {
  for result in [
    Err({code: "not_found"}),
    Ok(explicit_row(42, "completed", "")),
    Ok(explicit_row(42, "completed", "cancelled")),
    Ok(explicit_row(42, "completed", "skipped")),
  ] {
    const receipts = run_consumer_pretag_gates(
      [target()],
      adapter([], {run: fn(_target, _id) { return result }}),
      FAST,
      nil,
      {"owner/consumer": 42},
    )
    assert_eq(receipts[0]?.status, "unreadable")
    assert(!consumer_pretag_gate_verdict([target()], receipts).proven)
  }
}

/**
 * An adapter over a scripted run timeline. `sequence` is read once per poll of
 * the same run, so a test can hand back "running, running, completed" and prove
 * the gate actually waited instead of reading one answer and stopping.
 */
fn adapter(
  sequence: list<ConsumerPretagRunRow>,
  overrides: dict = {},
) -> ConsumerPretagGateAdapter {
  let cursor = 0
  let clock = 0
  let dispatched = false
  const base: dict = {
    consumer_revision: fn(_target) { return Ok(REVISION) },
    dispatch: fn(_target) {
      dispatched = true
      return Ok({run_id: 11, head_sha: REVISION})
    },
    runs: fn(_target) { return Ok(
      if dispatched {
        [row(11, "queued", "")]
      } else {
        []
      },
    ) },
    run: fn(_target, _run_id) {
      const answer = sequence[cursor] ?? sequence[len(sequence) - 1]
      cursor = cursor + 1
      return Ok(answer ?? row(11, "completed", "success"))
    },
    wait: fn(ms) { clock = clock + ms },
    now_ms: fn() {
      clock = clock + 1
      return clock
    },
  }
  return schema_expect(base + overrides, ConsumerPretagGateAdapter)
}

pipeline test_a_green_consumer_run_proves_the_candidate() {
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter([row(11, "completed", "success")]),
    FAST,
  )
  assert_eq(len(receipts), 1)
  assert_eq(receipts[0]?.status, "passed")
  assert_eq(receipts[0]?.run_url, "https://runs.test/11")
  assert(consumer_pretag_gate_verdict([target()], receipts).proven)
}

pipeline test_a_completed_candidate_run_is_adopted_without_redispatch() {
  let dispatches = 0
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [row(11, "completed", "success")],
      {
        dispatch: fn(_target) {
          dispatches = dispatches + 1
          return Ok({run_id: 11, head_sha: REVISION})
