import { run_release_candidate_tag } from "../lib/release_candidate_tag"
import { release_publication } from "../lib/release_publication"
import {
  release_watch_receipt,
  release_watch_receipt_bind_main_commit,
} from "../lib/release_watch_state"

const CANDIDATE = "1111111111111111111111111111111111111111"

const PIN = "2222222222222222222222222222222222222222"

const MAIN = "3333333333333333333333333333333333333333"

pipeline test_bound_candidate_with_deleted_tag_never_recreates_it(harness: Harness, task: any) {
  const original = release_watch_receipt_bind_main_commit(
    receipt(),
    CANDIDATE,
    "2026-09-05T00:00:00Z",
  )
  let writes = 0
  const result = run_release_candidate_tag(
    harness,
    {},
    original,
    harness.fs.mkdtemp_in_workspace("bound-tag-") + "/watch.json",
    {
      candidate_parent: fn() { return PIN },
      certify_target: fn() { return CANDIDATE },
      tag_target: fn() { return "" },
      verify_tag: fn(_target: string) { return [] },
      push_tag: fn(_target: string) {
        writes = writes + 1
        return [{name: "unexpected-tag", success: true}]
      },
      now: fn() { return "2026-09-05T00:01:00Z" },
    },
  )
  assert_eq(result.status, 2)
  assert_eq(writes, 0)
  assert_eq(result.receipt.release_commit_oid, CANDIDATE)
}

pipeline test_legacy_published_receipt_only_verifies_existing_tag(harness: Harness, task: any) {
  const path = harness.fs.mkdtemp_in_workspace("legacy-tag-") + "/watch.json"
  const original = release_watch_receipt_bind_main_commit(receipt(), MAIN, "2026-09-05T00:00:00Z")
  for target in [MAIN, "", CANDIDATE] {
    let pushes = 0
    let reads = 0
    const result = run_release_candidate_tag(
      harness,
      {},
      original,
      path,
      {
        candidate_parent: fn() { return "" },
        certify_target: fn() { return "" },
        tag_target: fn() { return target },
        verify_tag: fn(oid: string) {
          reads = reads + 1
          assert_eq(oid, MAIN)
          return [{name: "verified-signature", success: true}]
        },
        push_tag: fn(_oid: string) {
          pushes = pushes + 1
          return []
        },
        now: fn() { return "2026-09-05T00:01:00Z" },
      },
    )
    assert_eq(pushes, 0)
    assert_eq(
      result.status,
      if target == MAIN {
        0
      } else {
        2
      },
    )
    assert_eq(
      reads,
      if target == MAIN {
        1
      } else {
        0
      },
    )
  }
}

fn receipt() {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: PIN,
      publication: release_publication("1.2.3", CANDIDATE),
      pr_url: "https://github.com/burin-labs/harn/pull/42",
      created_at: "2026-09-05T00:00:00Z",
    },
  )
}

pipeline test_candidate_is_tagged_and_resumed_without_waiting_for_main(
  harness: Harness,
  task: any,
) {
  const path = harness.fs.mkdtemp_in_workspace("candidate-tag-") + "/watch.json"
  let targets: list<string> = []
  const adapter = {
    verify_tag: fn(target: string) {
      assert_eq(target, CANDIDATE)
      return [{name: "verified-signature", success: true}]
    },
    tag_target: fn() { return if len(targets) > 0 {
      CANDIDATE
    } else {
      ""
    } },
    candidate_parent: fn() { return PIN },
    certify_target: fn() { return if len(targets) > 0 {
      ""
    } else {
      CANDIDATE
    } },
    push_tag: fn(target: string) {
      targets = targets + [target]
      return [{name: "signed-tag-proof", success: true}]
    },
    now: fn() { return "2026-09-05T00:01:00Z" },
  }
  const first = run_release_candidate_tag(harness, {}, receipt(), path, adapter)
  assert_eq(first.status, 0)
  assert_eq(first.receipt.release_commit_oid, CANDIDATE)
  assert(first.receipt.release_commit_oid != MAIN)
  const resumed = run_release_candidate_tag(harness, {}, first.receipt, path, adapter)
  assert_eq(resumed.status, 0)
  assert_eq(targets, [CANDIDATE])
}

pipeline test_disappearing_candidate_tag_cannot_be_recreated(harness: Harness, task: any) {
  const path = harness.fs.mkdtemp_in_workspace("disappeared-tag-") + "/watch.json"
  let pushes = 0
  const result = run_release_candidate_tag(
    harness,
    {},
    receipt(),
    path,
    {
      candidate_parent: fn() { return PIN },
      certify_target: fn() { return "" },
      tag_target: fn() { return CANDIDATE },
      verify_tag: fn(_target: string) { return [] },
      push_tag: fn(_target: string) {
        pushes = pushes + 1
        return []
      },
      now: fn() { return "2026-09-05T00:01:00Z" },
    },
  )
  assert_eq(result.status, 2)
  assert_eq(pushes, 0)
}

pipeline test_missing_or_moved_certification_ref_never_pushes(harness: Harness, task: any) {
  const path = harness.fs.mkdtemp_in_workspace("candidate-ref-") + "/watch.json"
  for observed in ["", MAIN] {
    let pushed = false
    const result = run_release_candidate_tag(
      harness,
      {},
      receipt(),
      path,
      {
        tag_target: fn() { return "" },
        verify_tag: fn(_target: string) { return [] },
        candidate_parent: fn() { return PIN },
        certify_target: fn() { return observed },
        push_tag: fn(_target: string) {
          pushed = true
          return []
        },
        now: fn() { return "2026-09-05T00:01:00Z" },
      },
    )
    assert_eq(result.status, 2)
    assert(!pushed)
  }
}

pipeline test_different_candidate_parent_never_pushes(harness: Harness, task: any) {
  const path = harness.fs.mkdtemp_in_workspace("candidate-parent-") + "/watch.json"
  let pushed = false
  const result = run_release_candidate_tag(
    harness,
    {},
    receipt(),
    path,
    {
      tag_target: fn() { return "" },
      verify_tag: fn(_target: string) { return [] },
      candidate_parent: fn() { return MAIN },
      certify_target: fn() { return CANDIDATE },
      push_tag: fn(_target: string) {
        pushed = true
        return []
      },
      now: fn() { return "2026-09-05T00:01:00Z" },
    },
  )
  assert_eq(result.status, 2)
  assert(!pushed)
}
