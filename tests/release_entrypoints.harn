import { release_harness_root } from "../lib/release_runtime"
import { pinned_test_runtime } from "./pinned_runtime"

pipeline test_local_release_controllers_are_refused_before_any_mutation(
  harness: Harness,
  task: any,
) {
  const root = release_harness_root(harness.fs)
  const runtime = pinned_test_runtime(pick(harness, ["fs", "process"]), root)
  for mode in ["prepare", "ship-pr"] {
    const result = harness.process.run(
      {
        program: runtime,
        args: [
          "run",
          "--no-sandbox",
          "release_harn.harn",
          "--",
          "--mock",
          "--mode",
          mode,
          "--no-chat",
        ],
        cwd: root,
      },
    )
    assert_eq(result.success, false)
    assert(contains(result.stderr, "local release preparation is retired"), result.combined)
  }
}
