fn quote(value: string) -> string {
  return "'" + replace(value, "'", "'\\''") + "'"
}

fn run_writer(harness: Harness, root: string, records: list<string>) {
  const script = path_join(dirname(harness.fs.cwd()), "scripts", "write_harn_cost_receipt.sh")
  const output = path_join(root, "receipt.json")
  const command = quote(script)
    + " "
    + quote(output)
    + " test.cost.v1 target revision"
    + if len(records) == 0 {
    ""
  } else {
    " " + records.map({ record -> return quote(record) }).join(" ")
  }
  const result = harness.process.shell(command)
  if !result.success {
    throw result.combined
  }
  return json_parse(harness.fs.read_text(output))
}

fn summary(calls: int, input: int, output: int, cost: float) {
  return {
    schema_version: 4,
    event: "run_summary",
    llm: {
      call_count: calls,
      input_tokens: input,
      output_tokens: output,
      known_cost_usd: cost,
      unpriced_calls: 0,
      usage_unknown_calls: 0,
    },
  }
}

pipeline test_runtime_cost_writer_sums_canonical_summaries(harness: Harness, task) {
  const root = trim(harness.process.shell("mktemp -d").stdout)
  const first = path_join(root, "first.json")
  const second = path_join(root, "second.json")
  harness.fs.write_text(first, json_stringify(summary(1, 100, 20, 0.04)))
  harness.fs.write_text(second, json_stringify(summary(2, 50, 30, 0.01)))
  const receipt = run_writer(harness, root, [first, second])
  assert_eq(receipt.cost_status, "exact")
  assert_eq(receipt.cost_usd, 0.05)
  assert_eq(receipt.call_count, 3)
  assert_eq(receipt.input_tokens, 150)
  assert_eq(receipt.output_tokens, 50)
  harness.fs.delete(root)
}

pipeline test_runtime_cost_writer_rejects_malformed_summary_instead_of_reporting_zero(
  harness: Harness,
  task,
) {
  const root = trim(harness.process.shell("mktemp -d").stdout)
  const malformed = path_join(root, "malformed.json")
  harness.fs.write_text(malformed, "{\"event\":\"run_summary\"}\n")
  const receipt = run_writer(harness, root, [malformed])
  assert_eq(receipt.cost_status, "unknown")
  assert_eq(receipt.cost_usd, nil)
  assert_eq(receipt.call_count, nil)
  assert_eq(receipt.reason, "runtime_summaries_invalid")
  harness.fs.delete(root)
}

pipeline test_runtime_cost_writer_marks_missing_summaries_unknown(harness: Harness, task) {
  const root = trim(harness.process.shell("mktemp -d").stdout)
  const receipt = run_writer(harness, root, [])
  assert_eq(receipt.cost_status, "unknown")
  assert_eq(receipt.reason, "runtime_summaries_missing")
  assert_eq(receipt.source_summaries, [])
  harness.fs.delete(root)
}
