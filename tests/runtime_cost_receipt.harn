fn quote(value: string) -> string {
  return "'" + replace(value, "'", "'\\''") + "'"
}

fn run_writer(
  harness: {fs: HarnessFs, process: HarnessProcess},
  root: string,
  records: list<string>,
) {
  const script = path_join(dirname(harness.fs.cwd()), "scripts", "write_harn_cost_receipt.sh")
  const output = path_join(root, "receipt.json")
  const command = quote(script)
    + " "
    + quote(output)
    + " test.cost.v1 target revision"
    + if len(records) == 0 {
      ""
    } else {
      " " + records.map({ record -> return quote(record) }).join(" ")
    }
  const result = harness.process.shell(command)
  if !result.success {
    throw result.combined
  }
  return json_parse(harness.fs.read_text(output))
}

fn summary(calls: int, input: int, output: int, cost: float) {
  return {
    schema_version: 4,
    event: "run_summary",
    llm: {
      call_count: calls,
      input_tokens: input,
      output_tokens: output,
      known_cost_usd: cost,
      unpriced_calls: 0,
      usage_unknown_calls: 0,
    },
  }
}

fn run_combiner(
  harness: {fs: HarnessFs, process: HarnessProcess},
  root: string,
  receipts: list<string>,
) {
  const script = path_join(dirname(harness.fs.cwd()), "scripts", "combine_harn_cost_receipts.sh")
  const output = path_join(root, "combined.json")
  const command = quote(script)
    + " "
    + quote(output)
    + " test.combined.v1 target revision "
    + receipts.map({ receipt -> return quote(receipt) }).join(" ")
  const result = harness.process.shell(command)
  if !result.success {
    throw result.combined
  }
  return json_parse(harness.fs.read_text(output))
}

fn cost_receipt(status: string, calls: int, cost: float?) {
  return {
    cost_status: status,
    cost_usd: cost,
    known_cost_usd: cost ?? 0.0,
    call_count: calls,
    input_tokens: calls * 100,
    output_tokens: calls * 20,
    unpriced_calls: if status == "exact" {
      0
    } else {
      1
    },
    usage_unknown_calls: 0,
  }
}

pipeline test_runtime_cost_writer_sums_canonical_summaries(harness: Harness, task) {
  const root = trim(harness.process.shell("mktemp -d").stdout)
  const first = path_join(root, "first.json")
  const second = path_join(root, "second.json")
  harness.fs.write_text(first, json_stringify(summary(1, 100, 20, 0.04)))
  harness.fs.write_text(second, json_stringify(summary(2, 50, 30, 0.01)))
  const receipt = run_writer({fs: harness.fs, process: harness.process}, root, [first, second])
  assert_eq(receipt.cost_status, "exact")
  assert_eq(receipt.cost_usd, 0.05)
  assert_eq(receipt.call_count, 3)
  assert_eq(receipt.input_tokens, 150)
  assert_eq(receipt.output_tokens, 50)
  harness.fs.delete(root)
}

pipeline test_runtime_cost_writer_rejects_malformed_summary_instead_of_reporting_zero(
  harness: Harness,
  task,
) {
  const root = trim(harness.process.shell("mktemp -d").stdout)
  const malformed = path_join(root, "malformed.json")
  harness.fs.write_text(malformed, "{\"event\":\"run_summary\"}\n")
  const receipt = run_writer({fs: harness.fs, process: harness.process}, root, [malformed])
  assert_eq(receipt.cost_status, "unknown")
  assert_eq(receipt.cost_usd, nil)
  assert_eq(receipt.call_count, nil)
  assert_eq(receipt.reason, "runtime_summaries_invalid")
  harness.fs.delete(root)
}

pipeline test_runtime_cost_writer_marks_missing_summaries_unknown(harness: Harness, task) {
  const root = trim(harness.process.shell("mktemp -d").stdout)
  const receipt = run_writer({fs: harness.fs, process: harness.process}, root, [])
  assert_eq(receipt.cost_status, "unknown")
  assert_eq(receipt.reason, "runtime_summaries_missing")
  assert_eq(receipt.source_summaries, [])
  harness.fs.delete(root)
}

pipeline test_cost_combiner_sums_release_and_every_followed_round(harness: Harness, task) {
  const root = trim(harness.process.shell("mktemp -d").stdout)
  const release = path_join(root, "release.json")
  const round_one = path_join(root, "round-one.json")
  const round_two = path_join(root, "round-two.json")
  harness.fs.write_text(release, json_stringify(cost_receipt("exact", 2, 0.03)))
  harness.fs.write_text(round_one, json_stringify(cost_receipt("exact", 0, 0.0)))
  harness.fs.write_text(round_two, json_stringify(cost_receipt("exact", 1, 0.02)))
  const receipt = run_combiner(
    {fs: harness.fs, process: harness.process},
    root,
    [release, round_one, round_two],
  )
  assert_eq(receipt.cost_status, "exact")
  assert_eq(receipt.cost_usd, 0.05)
  assert_eq(receipt.call_count, 3)
  assert_eq(receipt.source_receipts, [release, round_one, round_two])
  harness.fs.delete(root)
}

pipeline test_cost_combiner_fails_closed_when_any_round_is_unpriced(harness: Harness, task) {
  const root = trim(harness.process.shell("mktemp -d").stdout)
  const exact = path_join(root, "exact.json")
  const unknown = path_join(root, "unknown.json")
  harness.fs.write_text(exact, json_stringify(cost_receipt("exact", 1, 0.01)))
  harness.fs.write_text(unknown, json_stringify(cost_receipt("unknown", 1, nil)))
  const receipt = run_combiner({fs: harness.fs, process: harness.process}, root, [exact, unknown])
  assert_eq(receipt.cost_status, "unknown")
  assert_eq(receipt.cost_usd, nil)
  assert_eq(receipt.reason, "source_cost_receipt_not_exact")
  harness.fs.delete(root)
}
