import { PreTagSizeGateStartedEvent } from "../lib/pretag_size_gate"
import {
  pretag_size_gate_receipt_matches,
  pretag_size_gate_receipt_path,
  pretag_size_gate_receipt_read,
  pretag_size_gate_receipt_write,
} from "../lib/pretag_size_gate_receipt"
import { pre_tag_binary_size_gate_config } from "../lib/release_execution"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const CANDIDATE_REF = "release-attempt/v1.2.3/" + SHA

fn started() -> PreTagSizeGateStartedEvent {
  return {
    workflow: "build-release-binaries.yml",
    event: "workflow_dispatch",
    policy_ref: CANDIDATE_REF,
    expected_policy_sha: SHA,
    source_ref: CANDIDATE_REF,
    expected_source_sha: SHA,
    target_job: "Build x86_64-unknown-linux-gnu",
    required_source_step: "Verify benchmark source revision",
    required_size_step: "Evaluate the binary-size growth signal",
    benchmark_only: true,
    runner_profile: "standard",
    targets: ["x86_64-unknown-linux-gnu"],
    completion_timeout_ms: 100,
    completion_interval_ms: 10,
    transient_view_retry_max_attempts: 3,
    transient_view_retry_base_ms: 1,
    transient_view_retry_cap_ms: 5,
    run_id: 42,
    run_url: "https://github.com/burin-labs/harn/actions/runs/42",
    observed_event: "workflow_dispatch",
    observed_head_branch: CANDIDATE_REF,
    observed_head_sha: SHA,
    reused: false,
  }
}

pipeline test_pretag_size_gate_receipt_round_trips_exact_run_identity(harness: Harness) {
  const root = path_join(harness.fs.temp_dir(), "pretag-receipt-" + harness.random.uuid_v7())
  const path = pretag_size_gate_receipt_path(root, SHA)
  const receipt = pretag_size_gate_receipt_write(
    {fs: harness.fs, random: harness.random},
    path,
    "burin-labs/harn",
    started(),
    "2026-07-27T00:00:00Z",
  )
  assert_eq(pretag_size_gate_receipt_read(harness.fs, path), receipt)
  const config = pre_tag_binary_size_gate_config(CANDIDATE_REF, SHA, CANDIDATE_REF, SHA)
  assert_eq(pretag_size_gate_receipt_matches(receipt, "burin-labs/harn", config), true)
  assert_eq(
    pretag_size_gate_receipt_matches(
      receipt,
      "burin-labs/harn",
      config + {expected_policy_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
    ),
    false,
  )
}
