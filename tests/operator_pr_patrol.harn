import { operator_pr_patrol_classify } from "../lib/operator_pr_patrol"

fn pr(fields: dict = {}) {
  return {
    number: 42,
    title: "Example",
    url: "https://github.com/burin-labs/example/pull/42",
    draft: false,
    github_state: "open",
    merged: false,
    mergeable_state: "clean",
    auto_merge_armed: false,
    in_merge_queue: false,
    queue_membership: {available: true, queued: false, entry: nil},
    head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
  }
    + fields
}

fn checks(state: string = "green", failing: list = [], pending: list = []) {
  return {state: state, failing_checks: failing, pending_checks: pending}
}

pipeline test_operator_pr_patrol_classifies_control_and_owner_actions(task: any) {
  const green = operator_pr_patrol_classify("burin-labs/example", pr(), checks())
  assert_eq(green.human_action, "control")
  assert_eq(green.reason, "green_unarmed")
  assert_eq(green.head_sha, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  const draft = operator_pr_patrol_classify("burin-labs/example", pr({draft: true}), checks())
  assert_eq(draft.human_action, "owner")
  assert_eq(draft.reason, "draft_pull_request")
  const dirty = operator_pr_patrol_classify(
    "burin-labs/example",
    pr({mergeable_state: "dirty"}),
    checks(),
  )
  assert_eq(dirty.human_action, "owner")
  assert_eq(dirty.reason, "merge_state_dirty")
  const red = operator_pr_patrol_classify(
    "burin-labs/example",
    pr(),
    checks("failing", [{name: "CI", status: "completed", conclusion: "failure"}]),
  )
  assert_eq(red.human_action, "owner")
  assert_eq(red.reason, "checks_failing")
  assert_eq(red.failing_checks[0].name, "CI")
}

pipeline test_operator_pr_patrol_classifies_waiting_and_done_states(task: any) {
  const pending = operator_pr_patrol_classify(
    "burin-labs/example",
    pr(),
    checks("pending", [], [{name: "CI", status: "queued", conclusion: ""}]),
  )
  assert_eq(pending.human_action, "wait")
  assert_eq(pending.reason, "checks_pending")
  const blocked_pending = operator_pr_patrol_classify(
    "burin-labs/example",
    pr({mergeable_state: "blocked", auto_merge_armed: true}),
    checks("pending", [], [{name: "Required CI", status: "in_progress", conclusion: ""}]),
  )
  assert_eq(blocked_pending.human_action, "wait")
  assert_eq(blocked_pending.reason, "checks_pending")
  const blocked_unknown = operator_pr_patrol_classify(
    "burin-labs/example",
    pr({mergeable_state: "blocked"}),
    checks("unknown"),
  )
  assert_eq(blocked_unknown.human_action, "wait")
  assert_eq(blocked_unknown.reason, "checks_unknown")
  const clean_unknown = operator_pr_patrol_classify("burin-labs/example", pr(), checks("unknown"))
  assert_eq(clean_unknown.human_action, "wait")
  assert_eq(clean_unknown.reason, "checks_unknown")
  const dirty_unknown = operator_pr_patrol_classify(
    "burin-labs/example",
    pr({mergeable_state: "dirty"}),
    checks("unknown"),
  )
  assert_eq(dirty_unknown.human_action, "owner")
  assert_eq(dirty_unknown.reason, "merge_state_dirty")
  const hidden_pending = operator_pr_patrol_classify(
    "burin-labs/example",
    pr({mergeable_state: "blocked", auto_merge_armed: true}),
    checks("green"),
  )
  assert_eq(hidden_pending.human_action, "wait")
  assert_eq(hidden_pending.reason, "checks_pending")
  assert_eq(hidden_pending.check_state, "pending")
  assert_eq(hidden_pending.pending_checks[0].source, "blocked_auto_merge")
  const armed = operator_pr_patrol_classify(
    "burin-labs/example",
    pr({auto_merge_armed: true}),
    checks(),
  )
  assert_eq(armed.human_action, "none")
  assert_eq(armed.reason, "ready_or_waiting")
  const queued = operator_pr_patrol_classify(
    "burin-labs/example",
    pr(
      {
        in_merge_queue: true,
        queue_membership: {available: true, queued: true, entry: {state: "awaiting_checks"}},
      },
    ),
    checks(),
  )
  assert_eq(queued.human_action, "none")
  assert_eq(queued.queue_state, "awaiting_checks")
  const merged = operator_pr_patrol_classify(
    "burin-labs/example",
    pr({merged: true, github_state: "closed", merge_commit_oid: "bbbb"}),
    checks(),
  )
  assert_eq(merged.human_action, "none")
  assert_eq(merged.reason, "merged")
}
