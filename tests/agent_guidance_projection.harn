import { shared_agent_guidance_block } from "../lib/agent_guidance"
import { resolve_agent_guidance_targets } from "../lib/fleet_projection_targets"

pipeline test_remote_guidance_preserves_local_rules_and_source_identity() {
  const old = "Before\n<!-- BEGIN HARN SHARED AGENT CONTRACT: managed by harn-bump-fleet -->\n"
    + "Old expensive policy\n<!-- END HARN SHARED AGENT CONTRACT -->\nAfter\n"
  const result = resolve_agent_guidance_targets(
    [{slug: "owner/repo", directory: "repo"}],
    {"owner/repo:AGENTS.md": old},
  )
  assert_eq(result.errors, [])
  assert_eq(len(result.targets), 1)
  assert_eq(result.targets[0]?.expected, "Before\n" + shared_agent_guidance_block() + "\nAfter\n")
  assert_eq(result.targets[0]?.derived_from_sha256, sha256(old))
  const again = resolve_agent_guidance_targets(
    [{slug: "owner/repo", directory: "repo"}],
    {"owner/repo:AGENTS.md": result.targets[0]?.expected},
  )
  assert_eq(again.targets[0]?.expected, result.targets[0]?.expected)
}

pipeline test_remote_guidance_names_missing_and_malformed_targets() {
  const result = resolve_agent_guidance_targets(
    [
      {slug: "owner/missing", directory: "missing"},
      {slug: "owner/malformed", directory: "malformed"},
    ],
    {"owner/malformed:AGENTS.md": "<!-- END HARN SHARED AGENT CONTRACT -->"},
  )
  assert_eq(result.targets, [])
  assert_eq(len(result.errors), 2)
  assert_eq(result.failed_by, ["owner/missing", "owner/malformed"])
  assert(contains(result.errors[0] ?? "", "current default-branch guidance is missing"))
  assert(contains(result.errors[1] ?? "", "managed guidance markers"))
}
