import {
  ReleaseUnfoldState,
  release_unfold_body,
  release_unfold_branch,
  release_unfold_decision,
  release_unfold_title,
} from "../lib/release_unfold"

const MERGE = "7c953ee2b749c153531c5d6df6a341ca3fada4e7"

fn state(overrides: dict = {}) -> ReleaseUnfoldState {
  const merged = {
    tag: "v0.10.128",
    version: "0.10.128",
    merge_commit: MERGE,
    development_version: "0.10.128-dev",
    tag_published: false,
    open_pull_number: 0,
  }
    + overrides
  return {
    tag: to_string(merged.tag),
    version: to_string(merged.version),
    merge_commit: to_string(merged.merge_commit),
    development_version: to_string(merged.development_version),
    tag_published: merged.tag_published == true,
    open_pull_number: to_int(merged.open_pull_number),
  }
}

/**
 * The recovery that had to be written by hand. Main carried version 0.10.128
 * with no tag, the release preflight refuses to cut while main is not a
 * development version, and resuming the receipt re-entered the same refusal.
 * Reverting the merge is the way out, and the harness offers it.
 */
pipeline test_unfold_opens_the_revert_for_a_stranded_bump(task: any) {
  const decision = release_unfold_decision(state())
  assert_eq(decision.action, "open")
  assert_eq(decision.branch, "release-unfold/v0.10.128")
  assert(contains(decision.reason, "0.10.128-dev"))
  assert(contains(decision.reason, "changelog fragments come back"))
}

/**
 * A published tag is the one hard refusal. Reverting the commit a tag names
 * does not unpublish the tag, it only makes main disagree with something
 * immutable, and that is a different problem than this one.
 */
pipeline test_unfold_refuses_once_the_tag_is_published(task: any) {
  const decision = release_unfold_decision(state({tag_published: true}))
  assert_eq(
    [decision.action, decision.terminal_reason],
    ["refuse", "unfold_tag_already_published"],
  )
  assert(contains(decision.reason, "immutable tag"))
}

/** A second attempt finds the unfold it already opened rather than opening two. */
pipeline test_unfold_is_idempotent(task: any) {
  const decision = release_unfold_decision(state({open_pull_number: 4242}))
  assert_eq(decision.action, "already_open")
  assert(contains(decision.reason, "#4242"))
}

/** No exact merge commit, no revert. An unobserved commit is not a clean one. */
pipeline test_unfold_refuses_without_an_exact_merge_commit(task: any) {
  assert_eq(
    release_unfold_decision(state({merge_commit: ""})).terminal_reason,
    "unfold_merge_commit_not_observed",
  )
  assert_eq(
    release_unfold_decision(state({merge_commit: "7c953ee"})).terminal_reason,
    "unfold_merge_commit_not_observed",
  )
}

/** Without the development version to restore, the revert has no target state. */
pipeline test_unfold_refuses_without_the_development_version(task: any) {
  assert_eq(
    release_unfold_decision(state({development_version: ""})).terminal_reason,
    "unfold_versions_not_observed",
  )
}

/**
 * Written for whoever finds this open on a morning they were not expecting it.
 * A revert with no explanation reads like something went wrong with the revert.
 */
pipeline test_unfold_body_explains_itself(task: any) {
  const body = release_unfold_body(
    {
      tag: "v0.10.128",
      version: "0.10.128",
      development_version: "0.10.128-dev",
      merge_commit: MERGE,
      failing_check: "Workspace nextest (windows-latest)",
      drifted_commits: "abc1234, def5678",
    },
  )
  assert(contains(body, "Workspace nextest (windows-latest)"))
  assert(contains(body, "abc1234, def5678"))
  assert(contains(body, "0.10.128-dev"))
  assert(contains(body, "No tag was minted"))
  assert(contains(body, MERGE))
}

/** The branch and title are stable, so a retry finds its own work. */
pipeline test_unfold_names_are_stable(task: any) {
  assert_eq(release_unfold_branch("0.10.128"), "release-unfold/v0.10.128")
  assert(contains(release_unfold_title("0.10.128"), "[Release] Unfold the v0.10.128 bump"))
}
