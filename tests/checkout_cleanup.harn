import {
  checkout_cleanup,
  checkout_cleanup_commands,
  sync_base_branch,
} from "../lib/checkout_cleanup"
import { fail, ok } from "../lib/shell_util"

fn scripted_runner(entries) {
  return { command ->
    for entry in entries {
      if entry.command == command {
        return entry.result
      }
    }
    throw "unexpected cleanup command: " + command
  }
}

fn runner_entries(commands, results) {
  var entries = []
  var i = 0
  while i < len(commands) {
    entries = entries + [{command: commands[i], result: results[i]}]
    i = i + 1
  }
  return entries
}

pipeline test_checkout_cleanup(task) {
  assert_eq(
    checkout_cleanup_commands("main").map({ c -> c.name }),
    ["cleanup-fetch-origin", "cleanup-switch-base", "cleanup-sync-base"],
  )
  let clean = checkout_cleanup(
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git fetch origin --prune --quiet",
          "git switch main",
          "git pull --ff-only origin main --quiet",
          "git branch --show-current",
        ],
        [ok(""), ok(""), ok(""), ok(""), ok("main\n")],
      ),
    ),
    "main",
  )
  assert_eq(clean.success, true)
  assert_eq(clean.skipped, false)
  assert_eq(clean.branch, "main")
  assert_eq(clean.detail, "checkout restored to main")
  assert_eq(
    clean.steps.map({ step -> step.name }),
    [
      "cleanup-status",
      "cleanup-fetch-origin",
      "cleanup-switch-base",
      "cleanup-sync-base",
      "cleanup-current-branch",
      "cleanup-verify-base",
    ],
  )
  let dirty = checkout_cleanup(
    scripted_runner(
      runner_entries(["git status --porcelain --untracked-files=normal"], [ok(" M release_harn.harn\n")]),
    ),
    "main",
  )
  assert_eq(dirty.success, true)
  assert_eq(dirty.skipped, true)
  assert_eq(dirty.detail, "working tree dirty; left checkout unchanged")
  let mismatch = checkout_cleanup(
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git fetch origin --prune --quiet",
          "git switch main",
          "git pull --ff-only origin main --quiet",
          "git branch --show-current",
        ],
        [ok(""), ok(""), ok(""), ok(""), ok("release/v1.2.3\n")],
      ),
    ),
    "main",
  )
  assert_eq(mismatch.success, false)
  assert_eq(mismatch.branch, "release/v1.2.3")
  assert(contains(mismatch.detail, "expected main"))
  let failed = checkout_cleanup(
    scripted_runner(
      runner_entries(
        ["git status --porcelain --untracked-files=normal", "git fetch origin --prune --quiet"],
        [ok(""), fail(128, "network unavailable")],
      ),
    ),
    "main",
  )
  assert_eq(failed.success, false)
  assert_eq(failed.detail, "failed during cleanup-fetch-origin")
}

pipeline test_sync_base_branch_clean_on_base(task) {
  let result = sync_base_branch(
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git branch --show-current",
          "git fetch origin --prune --quiet",
          "git pull --ff-only origin main --quiet",
        ],
        [ok(""), ok("main\n"), ok(""), ok("Already up to date.\n")],
      ),
    ),
    "main",
    "release_harn-auto-stash-abc",
  )
  assert_eq(result.success, true)
  assert_eq(result.dirty, false)
  assert_eq(result.stashed, false)
  assert_eq(result.stash_message, "")
  assert_eq(result.branch, "main")
  assert_eq(result.detail, "main fast-forwarded from origin")
  assert_eq(
    result.steps.map({ step -> step.name }),
    ["sync-status", "sync-current-branch", "sync-fetch-origin", "sync-pull-ff"],
  )
}

pipeline test_sync_base_branch_dirty_switches_and_stashes(task) {
  let result = sync_base_branch(
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git stash push --include-untracked -m release_harn-auto-stash-xyz",
          "git branch --show-current",
          "git switch main",
          "git fetch origin --prune --quiet",
          "git pull --ff-only origin main --quiet",
        ],
        [
          ok(" M release_harn.harn\n?? new_file.txt\n"),
          ok("Saved working directory and index state On feature: WIP\n"),
          ok("feature\n"),
          ok(""),
          ok(""),
          ok(""),
        ],
      ),
    ),
    "main",
    "release_harn-auto-stash-xyz",
  )
  assert_eq(result.success, true)
  assert_eq(result.dirty, true)
  assert_eq(result.stashed, true)
  assert_eq(result.stash_message, "release_harn-auto-stash-xyz")
  assert_eq(result.branch, "main")
  assert_eq(result.detail, "stashed dirty tree (release_harn-auto-stash-xyz) and fast-forwarded main")
  assert_eq(
    result.steps.map({ step -> step.name }),
    [
      "sync-status",
      "sync-stash",
      "sync-current-branch",
      "sync-switch-base",
      "sync-fetch-origin",
      "sync-pull-ff",
    ],
  )
}

pipeline test_sync_base_branch_ff_failure_surfaces_stash(task) {
  let result = sync_base_branch(
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git stash push --include-untracked -m release_harn-auto-stash-fail",
          "git branch --show-current",
          "git fetch origin --prune --quiet",
          "git pull --ff-only origin main --quiet",
        ],
        [
          ok(" M release_harn.harn\n"),
          ok("Saved working directory and index state\n"),
          ok("main\n"),
          ok(""),
          fail(1, "fatal: Not possible to fast-forward, aborting.\n"),
        ],
      ),
    ),
    "main",
    "release_harn-auto-stash-fail",
  )
  assert_eq(result.success, false)
  assert_eq(result.dirty, true)
  assert_eq(result.stashed, true)
  assert_eq(result.stash_message, "release_harn-auto-stash-fail")
  assert_eq(result.detail, "failed to fast-forward main from origin")
}

pipeline test_sync_base_branch_rejects_whitespace_stash_message(task) {
  var caught = ""
  try {
    sync_base_branch(scripted_runner([]), "main", "has whitespace")
  } catch (e) {
    caught = to_string(e)
  }
  assert(contains(caught, "stash_message must not contain whitespace"))
}
