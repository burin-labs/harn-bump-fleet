import { command_result_fail, command_result_ok } from "std/command"
import {
  base_ref_fetch_command,
  checkout_cleanup,
  checkout_cleanup_commands,
  sync_base_branch,
} from "../lib/checkout_cleanup"

fn scripted_runner(entries: any) {
  return { command ->
    for entry in entries {
      if entry.command == command {
        return entry.result
      }
    }
    throw "unexpected cleanup command: " + command
  }
}

fn runner_entries(commands: any, results: any) {
  let entries = []
  let i = 0
  while i < len(commands) {
    entries = entries + [{command: commands[i], result: results[i]}]
    i = i + 1
  }
  return entries
}

pipeline test_checkout_cleanup(harness: Harness, task: any) {
  assert_eq(
    checkout_cleanup_commands("main").map({ c -> c.name }),
    ["cleanup-fetch-origin", "cleanup-switch-base", "cleanup-sync-base"],
  )
  const clean = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          base_ref_fetch_command("main"),
          "git switch main",
          "git pull --ff-only origin main --quiet",
          "git branch --show-current",
        ],
        [
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok("main\n"),
        ],
      ),
    ),
    "main",
  )
  assert_eq(clean.success, true)
  assert_eq(clean.skipped, false)
  assert_eq(clean.branch, "main")
  assert_eq(clean.detail, "checkout restored to main")
  assert_eq(clean.warning, "")
  assert_eq(clean.fatal, false)
  assert_eq(
    clean.steps.map({ step -> step.name }),
    [
      "cleanup-status",
      "cleanup-fetch-origin",
      "cleanup-switch-base",
      "cleanup-sync-base",
      "cleanup-current-branch",
      "cleanup-verify-base",
    ],
  )
  const dirty = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        ["git status --porcelain --untracked-files=normal"],
        [command_result_ok(" M release_harn.harn\n")],
      ),
    ),
    "main",
  )
  assert_eq(dirty.success, true)
  assert_eq(dirty.skipped, true)
  assert_eq(dirty.detail, "working tree dirty; left checkout unchanged")
  assert_eq(dirty.warning, "")
  assert_eq(dirty.fatal, false)
  const mismatch = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          base_ref_fetch_command("main"),
          "git switch main",
          "git pull --ff-only origin main --quiet",
          "git branch --show-current",
        ],
        [
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok("release/v1.2.3\n"),
        ],
      ),
    ),
    "main",
  )
  assert_eq(mismatch.success, false)
  assert_eq(mismatch.branch, "release/v1.2.3")
  assert(contains(mismatch.detail, "expected main"))
  assert_eq(contains(mismatch.warning, "non-fatal checkout cleanup warning"), true)
  assert_eq(mismatch.fatal, false)
  const failed = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        ["git status --porcelain --untracked-files=normal", base_ref_fetch_command("main")],
        [command_result_ok(""), command_result_fail(128, "network unavailable")],
      ),
    ),
    "main",
  )
  assert_eq(failed.success, false)
  assert_eq(failed.detail, "failed during cleanup-fetch-origin")
  assert_eq(contains(failed.warning, "non-fatal checkout cleanup warning"), true)
  assert_eq(failed.fatal, false)
  const switch_failed = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          base_ref_fetch_command("main"),
          "git switch main",
        ],
        [
          command_result_ok(""),
          command_result_ok(""),
          command_result_fail(1, "fatal: cannot switch branch\n"),
        ],
      ),
    ),
    "main",
  )
  assert_eq(switch_failed.success, false)
  assert_eq(switch_failed.detail, "failed during cleanup-switch-base")
  assert_eq(
    switch_failed.warning,
    "non-fatal checkout cleanup warning: failed during cleanup-switch-base",
  )
  assert_eq(switch_failed.fatal, false)
}

pipeline test_sync_base_branch_clean_on_base(harness: Harness, task: any) {
  const result = sync_base_branch(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git branch --show-current",
          base_ref_fetch_command("main"),
          "git pull --ff-only origin main --quiet",
        ],
        [
          command_result_ok(""),
          command_result_ok("main\n"),
          command_result_ok(""),
          command_result_ok("Already up to date.\n"),
        ],
      ),
    ),
    "main",
    "release_harn-auto-stash-abc",
  )
  assert_eq(result.success, true)
  assert_eq(result.dirty, false)
  assert_eq(result.stashed, false)
  assert_eq(result.stash_message, "")
  assert_eq(result.branch, "main")
  assert_eq(result.detail, "main fast-forwarded from origin")
  assert_eq(
    result.steps.map({ step -> step.name }),
    ["sync-status", "sync-current-branch", "sync-fetch-origin", "sync-pull-ff"],
  )
}

pipeline test_sync_base_branch_dirty_switches_and_stashes(harness: Harness, task: any) {
  const result = sync_base_branch(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git stash push --include-untracked -m release_harn-auto-stash-xyz",
          "git branch --show-current",
          base_ref_fetch_command("main"),
          "git show-ref --verify --quiet refs/heads/main",
          "git switch main",
          "git pull --ff-only origin main --quiet",
        ],
        [
          command_result_ok(" M release_harn.harn\n?? new_file.txt\n"),
          command_result_ok("Saved working directory and index state On feature: WIP\n"),
          command_result_ok("feature\n"),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
        ],
      ),
    ),
    "main",
    "release_harn-auto-stash-xyz",
  )
  assert_eq(result.success, true)
  assert_eq(result.dirty, true)
  assert_eq(result.stashed, true)
  assert_eq(result.stash_message, "release_harn-auto-stash-xyz")
  assert_eq(result.branch, "main")
  assert_eq(
    result.detail,
    "stashed dirty tree (release_harn-auto-stash-xyz) and fast-forwarded main",
  )
  assert_eq(
    result.steps.map({ step -> step.name }),
    [
      "sync-status",
      "sync-stash",
      "sync-current-branch",
      "sync-fetch-origin",
      "sync-local-base-exists",
      "sync-switch-base",
      "sync-pull-ff",
    ],
  )
}

pipeline test_sync_base_branch_creates_missing_base(harness: Harness, task: any) {
  const result = sync_base_branch(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git branch --show-current",
          base_ref_fetch_command("main"),
          "git show-ref --verify --quiet refs/heads/main",
          "git switch -c main origin/main",
          "git pull --ff-only origin main --quiet",
        ],
        [
          command_result_ok(""),
          command_result_ok("release/v0.10.21\n"),
          command_result_ok(""),
          command_result_fail(1, ""),
          command_result_ok(""),
          command_result_ok("Already up to date.\n"),
        ],
      ),
    ),
    "main",
    "release_harn-auto-stash-create-base",
  )
  assert_eq(result.success, true)
  assert_eq(result.branch, "main")
  assert_eq(
    result.steps.map({ step -> step.name }),
    [
      "sync-status",
      "sync-current-branch",
      "sync-fetch-origin",
      "sync-local-base-exists",
      "sync-create-base",
      "sync-pull-ff",
    ],
  )
}

pipeline test_sync_base_branch_ff_failure_surfaces_stash(harness: Harness, task: any) {
  const result = sync_base_branch(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git stash push --include-untracked -m release_harn-auto-stash-fail",
          "git branch --show-current",
          base_ref_fetch_command("main"),
          "git pull --ff-only origin main --quiet",
        ],
        [
          command_result_ok(" M release_harn.harn\n"),
          command_result_ok("Saved working directory and index state\n"),
          command_result_ok("main\n"),
          command_result_ok(""),
          command_result_fail(1, "fatal: Not possible to fast-forward, aborting.\n"),
        ],
      ),
    ),
    "main",
    "release_harn-auto-stash-fail",
  )
  assert_eq(result.success, false)
  assert_eq(result.dirty, true)
  assert_eq(result.stashed, true)
  assert_eq(result.stash_message, "release_harn-auto-stash-fail")
  assert_eq(result.detail, "failed to fast-forward main from origin")
}

pipeline test_sync_base_branch_rejects_whitespace_stash_message(harness: Harness, task: any) {
  let caught = ""
  try {
    sync_base_branch(harness.process, scripted_runner([]), "main", "has whitespace")
  } catch (e) {
    caught = to_string(e)
  }
  assert(contains(caught, "stash_message must not contain whitespace"))
}
