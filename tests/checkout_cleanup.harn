import { command_result_fail, command_result_ok } from "std/command"
import {
  base_ref_fetch_command,
  checkout_cleanup,
  checkout_cleanup_commands,
} from "../lib/checkout_cleanup"

fn scripted_runner(entries: any) {
  return { command ->
    for entry in entries {
      if entry.command == command {
        return entry.result
      }
    }
    throw "unexpected cleanup command: " + command
  }
}

fn runner_entries(commands: any, results: any) {
  let entries = []
  let i = 0
  while i < len(commands) {
    entries = entries + [{command: commands[i], result: results[i]}]
    i = i + 1
  }
  return entries
}

pipeline test_checkout_cleanup(harness: Harness, task: any) {
  assert_eq(
    checkout_cleanup_commands("main").map({ c -> c.name }),
    ["cleanup-fetch-origin", "cleanup-switch-base", "cleanup-sync-base"],
  )
  const clean = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          base_ref_fetch_command("main"),
          "git switch main",
          "git pull --ff-only origin main --quiet",
          "git branch --show-current",
        ],
        [
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok("main\n"),
        ],
      ),
    ),
    "main",
  )
  assert_eq(clean.success, true)
  assert_eq(clean.skipped, false)
  assert_eq(clean.branch, "main")
  assert_eq(clean.detail, "checkout restored to main")
  assert_eq(clean.warning, "")
  assert_eq(clean.fatal, false)
  assert_eq(
    clean.steps.map({ step -> step.name }),
    [
      "cleanup-status",
      "cleanup-fetch-origin",
      "cleanup-switch-base",
      "cleanup-sync-base",
      "cleanup-current-branch",
      "cleanup-verify-base",
    ],
  )
  const dirty = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        ["git status --porcelain --untracked-files=normal"],
        [command_result_ok(" M release_harn.harn\n")],
      ),
    ),
    "main",
  )
  assert_eq(dirty.success, true)
  assert_eq(dirty.skipped, true)
  assert_eq(dirty.detail, "working tree dirty; left checkout unchanged")
  assert_eq(dirty.warning, "")
  assert_eq(dirty.fatal, false)
  const mismatch = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          base_ref_fetch_command("main"),
          "git switch main",
          "git pull --ff-only origin main --quiet",
          "git branch --show-current",
        ],
        [
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok(""),
          command_result_ok("release/v1.2.3\n"),
        ],
      ),
    ),
    "main",
  )
  assert_eq(mismatch.success, false)
  assert_eq(mismatch.branch, "release/v1.2.3")
  assert(contains(mismatch.detail, "expected main"))
  assert_eq(contains(mismatch.warning, "non-fatal checkout cleanup warning"), true)
  assert_eq(mismatch.fatal, false)
  const failed = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        ["git status --porcelain --untracked-files=normal", base_ref_fetch_command("main")],
        [command_result_ok(""), command_result_fail(128, "network unavailable")],
      ),
    ),
    "main",
  )
  assert_eq(failed.success, false)
  assert_eq(failed.detail, "failed during cleanup-fetch-origin")
  assert_eq(contains(failed.warning, "non-fatal checkout cleanup warning"), true)
  assert_eq(failed.fatal, false)
  const switch_failed = checkout_cleanup(
    harness.process,
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          base_ref_fetch_command("main"),
          "git switch main",
        ],
        [
          command_result_ok(""),
          command_result_ok(""),
          command_result_fail(1, "fatal: cannot switch branch\n"),
        ],
      ),
    ),
    "main",
  )
  assert_eq(switch_failed.success, false)
  assert_eq(switch_failed.detail, "failed during cleanup-switch-base")
  assert_eq(
    switch_failed.warning,
    "non-fatal checkout cleanup warning: failed during cleanup-switch-base",
  )
  assert_eq(switch_failed.fatal, false)
}
