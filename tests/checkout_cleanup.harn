import { checkout_cleanup, checkout_cleanup_commands } from "../lib/checkout_cleanup"
import { fail, ok } from "../lib/shell_util"

fn scripted_runner(entries) {
  return { command ->
    for entry in entries {
      if entry.command == command {
        return entry.result
      }
    }
    throw "unexpected cleanup command: " + command
  }
}

fn runner_entries(commands, results) {
  var entries = []
  var i = 0
  while i < len(commands) {
    entries = entries + [{command: commands[i], result: results[i]}]
    i = i + 1
  }
  return entries
}

pipeline test_checkout_cleanup(task) {
  assert_eq(
    checkout_cleanup_commands("main").map({ c -> c.name }),
    ["cleanup-fetch-origin", "cleanup-switch-base", "cleanup-sync-base"],
  )
  let clean = checkout_cleanup(
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git fetch origin --prune --quiet",
          "git switch 'main'",
          "git pull --ff-only origin 'main' --quiet",
          "git branch --show-current",
        ],
        [ok(""), ok(""), ok(""), ok(""), ok("main\n")],
      ),
    ),
    "main",
  )
  assert_eq(clean.success, true)
  assert_eq(clean.skipped, false)
  assert_eq(clean.branch, "main")
  assert_eq(clean.detail, "checkout restored to main")
  assert_eq(
    clean.steps.map({ step -> step.name }),
    [
      "cleanup-status",
      "cleanup-fetch-origin",
      "cleanup-switch-base",
      "cleanup-sync-base",
      "cleanup-current-branch",
      "cleanup-verify-base",
    ],
  )
  let dirty = checkout_cleanup(
    scripted_runner(
      runner_entries(["git status --porcelain --untracked-files=normal"], [ok(" M release_harn.harn\n")]),
    ),
    "main",
  )
  assert_eq(dirty.success, true)
  assert_eq(dirty.skipped, true)
  assert_eq(dirty.detail, "working tree dirty; left checkout unchanged")
  let mismatch = checkout_cleanup(
    scripted_runner(
      runner_entries(
        [
          "git status --porcelain --untracked-files=normal",
          "git fetch origin --prune --quiet",
          "git switch 'main'",
          "git pull --ff-only origin 'main' --quiet",
          "git branch --show-current",
        ],
        [ok(""), ok(""), ok(""), ok(""), ok("release/v1.2.3\n")],
      ),
    ),
    "main",
  )
  assert_eq(mismatch.success, false)
  assert_eq(mismatch.branch, "release/v1.2.3")
  assert(contains(mismatch.detail, "expected main"))
  let failed = checkout_cleanup(
    scripted_runner(
      runner_entries(
        ["git status --porcelain --untracked-files=normal", "git fetch origin --prune --quiet"],
        [ok(""), fail(128, "network unavailable")],
      ),
    ),
    "main",
  )
  assert_eq(failed.success, false)
  assert_eq(failed.detail, "failed during cleanup-fetch-origin")
}
