import { release_merge_lease_headline } from "../lib/release_merge_lease"
import { mock_release_watch_adapter, run_release_watch } from "../lib/release_watch_runtime"
import { release_watch_receipt, release_watch_transition } from "../lib/release_watch_state"
import { finish_terminal_release_merge_lease } from "../watch_harn_release.harn"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const BASE_OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const LEASE_OID = "cccccccccccccccccccccccccccccccccccccccc"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "terminal-lease-test-token"}
}

fn receipt() {
  return {
    slug: "burin-labs/harn",
    pin_sha: BASE_OID,
    pr_url: "https://github.com/burin-labs/harn/pull/7191",
    merge_lease_candidate_pr: 7191,
    merge_lease_generation: "hosted-123-attempt-2",
    merge_lease_method: "squash",
    publication: {head_oid: HEAD},
    tag: "v0.10.115",
  }
}

fn result(reason: string) {
  return {status: 2, receipt: receipt(), watchdog: {action: "blocked", reason: reason}}
}

fn lease(candidate_pr: int = 7191, generation: string = "hosted-123-attempt-2") {
  return {
    repo: "burin-labs/harn",
    base_branch: "main",
    base_oid: BASE_OID,
    candidate_pr: candidate_pr,
    candidate_head: HEAD,
    generation: generation,
    tag: "v0.10.115",
    merge_method: "squash",
  }
}

fn ref_url() -> string {
  return BASE + "/repos/burin-labs/harn/git/ref/release-merge-lease/main"
}

fn commit_url() -> string {
  return BASE + "/repos/burin-labs/harn/git/commits/" + LEASE_OID
}

fn delete_url() -> string {
  return BASE + "/repos/burin-labs/harn/git/refs/release-merge-lease/main"
}

fn mock_lease(
  testing: HarnessTesting,
  candidate_pr: int = 7191,
  generation: string = "hosted-123-attempt-2",
) {
  testing.http_mock(
    "GET",
    ref_url(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/release-merge-lease/main", object: {sha: LEASE_OID, type: "commit"}},
      ),
    },
  )
  testing.http_mock(
    "GET",
    commit_url(),
    {
      status: 200,
      body: json_stringify(
        {sha: LEASE_OID, message: release_merge_lease_headline(lease(candidate_pr, generation))},
      ),
    },
  )
  testing.http_mock("DELETE", delete_url(), {status: 204, body: ""})
}

fn delete_count(testing: HarnessTesting) -> int {
  return len(testing.http_mock_calls().filter({ call -> call.method == "DELETE" }).to_list())
}

fn healthy_runtime_receipt() {
  const initial = release_watch_receipt(
    {
      tag: "v0.10.115",
      slug: "burin-labs/harn",
      pin_sha: BASE_OID,
      publication: {
        version: "0.10.115",
        local_branch: "release/v0.10.115",
        remote_ref: "release-attempt/v0.10.115/" + HEAD,
        head_oid: HEAD,
      },
      pr_url: "https://github.com/burin-labs/harn/pull/7191",
      created_at: "2026-08-24T21:10:38Z",
    },
  )
  return release_watch_transition(
    initial,
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-08-24T21:11:00Z"},
  ).receipt
}

pipeline test_revoked_authority_finishes_the_exact_owned_lease_after_queue_restore(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  mock_lease(harness.testing)
  const finished = finish_terminal_release_merge_lease(
    harness,
    {
      result: result("release_pr_merge_authority_revoked"),
      queue_restore: {name: "release-queue-restore", success: true, classification: "ok"},
      observe_only: false,
      mock: false,
      options: options(),
    },
  )
  assert_eq(finished?.released, true)
  assert_eq(finished?.reason, "released")
  assert_eq(delete_count(harness.testing), 1)
}

pipeline test_recoverable_status_two_retains_the_release_lease(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  const finished = finish_terminal_release_merge_lease(
    harness,
    {
      result: result("release_pr_conflicted"),
      queue_restore: {name: "release-queue-restore", success: true, classification: "ok"},
      observe_only: false,
      mock: false,
      options: options(),
    },
  )
  assert_eq(finished, nil)
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}

pipeline test_terminal_receipt_without_claimed_generation_fails_closed(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  const unowned = result("release_pr_merge_authority_revoked")
  const finished = finish_terminal_release_merge_lease(
    harness,
    {
      result: unowned
        + {receipt: unowned.receipt + {merge_lease_candidate_pr: 0, merge_lease_generation: ""}},
      queue_restore: {name: "release-queue-restore", success: true, classification: "ok"},
      observe_only: false,
      mock: false,
      options: options(),
    },
  )
  assert_eq(finished?.released, false)
  assert_eq(finished?.reason, "not_owned")
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}

pipeline test_revoked_candidate_cannot_release_another_generations_lease(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  mock_lease(harness.testing, 7192)
  const finished = finish_terminal_release_merge_lease(
    harness,
    {
      result: result("release_pr_merge_authority_revoked"),
      queue_restore: {name: "release-queue-restore", success: true, classification: "ok"},
      observe_only: false,
      mock: false,
      options: options(),
    },
  )
  assert_eq(finished?.released, false)
  assert_eq(finished?.reason, "not_owned")
  assert_eq(delete_count(harness.testing), 0)
}

pipeline test_stale_watcher_cannot_release_new_generation_for_same_candidate(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  mock_lease(harness.testing, 7191, "hosted-123-attempt-3")
  const finished = finish_terminal_release_merge_lease(
    harness,
    {
      result: result("release_pr_merge_authority_revoked"),
      queue_restore: {name: "release-queue-restore", success: true, classification: "ok"},
      observe_only: false,
      mock: false,
      options: options(),
    },
  )
  assert_eq(finished?.released, false)
  assert_eq(finished?.reason, "not_owned")
  assert_eq(delete_count(harness.testing), 0)
}

pipeline test_revoked_merge_authority_stays_terminal_across_resume(harness: Harness, task: any) {
  const original = healthy_runtime_receipt()
  let arms = 0
  const adapter = mock_release_watch_adapter(original)
    + {
      pr_probe: fn(_slug, _url) { return {
        number: 7191,
        merged: false,
        merged_at: nil,
        merge_commit_oid: nil,
        github_state: "open",
        mergeable_state: "clean",
        in_merge_queue: false,
        auto_merge_armed: false,
      } },
      enable_auto_merge: fn(_slug, _pr) {
        arms = arms + 1
        return {state: "enabled"}
      },
    }
  const path = path_join(harness.fs.temp_dir(), "revoked-watch.json")
  const first = run_release_watch(
    harness,
    original,
    path,
    {max_polls: 5, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  const resumed = run_release_watch(
    harness,
    first.receipt,
    path,
    {max_polls: 5, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq([first.status, resumed.status], [2, 2])
  assert_eq([first.polls, resumed.polls], [1, 1])
  assert_eq(first.watchdog.reason, "release_pr_merge_authority_revoked")
  assert_eq(resumed.watchdog.reason, "release_pr_merge_authority_revoked")
  assert_eq(arms, 0)
}
