import {
  BranchInventoryRequest,
  branch_audit_exit_code,
  branch_audit_summary,
  collect_branch_inventory,
} from "../lib/prless_branch_audit"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

const OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const RELEASE = "release-attempt/v0.10.166/${OID}"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "branch-inventory-test-token"}
}

fn request() -> BranchInventoryRequest {
  return {repositories: [SLUG], default_branch: "main", private_names: "privatehost"}
}

pipeline test_retained_refs_stay_visible_without_reading_or_mutating_issues(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/${SLUG}/branches?page=1&per_page=100",
    {
      status: 200,
      body: json_stringify(
        [
          {name: "main", commit: {sha: OID}, protected: true},
          {name: RELEASE, commit: {sha: OID}, protected: false},
          {name: "work/privatehost/feature", commit: {sha: OID}, protected: false},
        ],
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/${SLUG}/pulls?state=open&per_page=30&page=1",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/${SLUG}/compare/main...${OID}",
    {status: 200, body: json_stringify({status: "identical"})},
  )
  const receipt = collect_branch_inventory(harness, request(), options())
  assert_eq(receipt.scanned_repository_count, 1)
  assert_eq(receipt.failed_repository_count, 0)
  assert_eq(receipt.branch_count, 3)
  assert_eq(receipt.prless_branch_count, 2)
  assert_eq(branch_audit_exit_code(receipt, false), 0)
  assert_eq(branch_audit_exit_code(receipt, true), 1)
  const summary = branch_audit_summary(receipt)
  assert(contains(summary, RELEASE))
  assert(contains(summary, "work/[host]/feature"))
  assert_eq(contains(summary, "privatehost"), false)
  assert(contains(summary, "does not establish ownership or abandonment"))
  const calls = harness.testing.http_mock_calls()
  assert(len(calls) >= 6, "the complete census and both branch comparisons must run")
  assert_eq(calls.every({ call -> call.method == "GET" }), true)
  assert_eq(calls.any({ call -> contains(call.url, "/issues") }), false)
}

pipeline test_an_unreadable_inventory_is_reported_as_a_failure(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/${SLUG}/branches?page=1&per_page=100",
    {status: 200, body: "[]"},
  )
  const receipt = collect_branch_inventory(harness, request(), options())
  assert_eq(receipt.scanned_repository_count, 0)
  assert_eq(receipt.failed_repository_count, 1)
  assert_eq(branch_audit_exit_code(receipt, false), 1)
  const summary = branch_audit_summary(receipt)
  assert(contains(summary, "1 unmeasured"))
  assert(contains(summary, "empty_branch_read"))
  assert(contains(summary, SLUG))
}

pipeline test_empty_scope_or_missing_redaction_refuses_before_reading(harness: Harness) {
  harness.testing.http_mock_clear()
  assert(
    is_err(
      try {
        collect_branch_inventory(harness, request() + {repositories: []}, options())
      },
    ),
  )
  assert(
    is_err(
      try {
        collect_branch_inventory(harness, request() + {private_names: ""}, options())
      },
    ),
  )
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}
