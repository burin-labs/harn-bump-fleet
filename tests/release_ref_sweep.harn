import { read_json_result, write_json } from "std/fs"
import { GitRemoteRef } from "std/git"
import {
  ReleaseRefRecoveryProof,
  ReleaseRefSweepAdapter,
  release_local_branch_sweep_entry,
  release_remote_ref_sweep_entry,
  run_release_ref_sweep,
} from "../lib/release_ref_sweep"

const FIRST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const SECOND = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn remote(name: string, oid: string) -> GitRemoteRef {
  return {ref: name, name: name, oid: oid, peeled: false}
}

fn proof(
  version: string,
  ref_oid: string,
  tag_target_oid: string,
  signed_tag: bool = true,
  hosted_terminal: bool = true,
  withdrawn: bool = false,
) -> ReleaseRefRecoveryProof {
  return {
    version: version,
    tag: "v${version}",
    ref_oid: ref_oid,
    tag_target_oid: tag_target_oid,
    signed_tag: signed_tag,
    hosted_terminal: hosted_terminal,
    withdrawn: withdrawn,
    message: if signed_tag && hosted_terminal && ref_oid == tag_target_oid {
      "signed published tag and terminal hosted release recover exact OID"
    } else if signed_tag && withdrawn && ref_oid == tag_target_oid {
      "signed published tag and a registered withdrawal recover exact OID"
    } else {
      "release proof is incomplete or targets another OID"
    },
  }
}

fn receipt_path(harness: {fs: HarnessFs, random: HarnessRandom}) -> string {
  return path_join(
    harness.fs.temp_dir(),
    "release-ref-sweep-" + harness.random.uuid_v7(),
    "receipt.json",
  )
}

fn adapter(
  remote_refs: list<GitRemoteRef> = [],
  local_refs: list<GitRemoteRef> = [],
  worktree_owner: string = "",
  commits_recoverable: bool = true,
  terminal: bool = true,
  tag_target_oid: string = FIRST,
  remote_commit_recoverable: bool = false,
) -> ReleaseRefSweepAdapter {
  return {
    now: fn() { return "2026-07-31T00:00:00Z" },
    remote_refs: fn(_repo) { return remote_refs },
    local_refs: fn(_repo) { return local_refs },
    version_at_ref: fn(_slug, _ref) { return "1.2.3" },
    remote_commit_recoverable: fn(_repo, _oid) { return remote_commit_recoverable },
    recovery_proof: fn(version, ref_oid, _slug) { return proof(
      version,
      ref_oid,
      tag_target_oid,
      true,
      terminal,
    ) },
    worktree_branch: fn(_repo, _branch) { return worktree_owner },
    local_commits_recoverable: fn(_repo, _branch, _tag) { return commits_recoverable },
    delete_remote_ref: fn(_repo, _ref, _expected_oid) { return {
      success: true,
      message: "deleted exact remote ref",
    } },
    delete_local_branch: fn(_repo, _branch, _expected_oid) { return {
      success: true,
      absent: false,
      message: "deleted exact local branch",
    } },
  }
}

pipeline test_remote_sweep_accepts_tag_backed_attempt_certification_and_failed_ref(task) {
  for name in [
    "refs/heads/release-attempt/v1.2.3/${FIRST}",
    "refs/heads/release-certify/${FIRST}",
    "refs/heads/release-failed/v1.2.3/${FIRST}-pre-tag-size",
  ] {
    const entry = release_remote_ref_sweep_entry(
      "burin-labs/harn",
      remote(name, FIRST),
      fn(_slug, _ref) { return "1.2.3" },
      fn(_oid) { return false },
      fn(version, ref_oid, _slug) { return proof(version, ref_oid, FIRST) },
    )
    assert_eq(entry.action, "delete")
    assert_eq(entry.outcome, "planned")
    assert_eq(entry.reason_code, "tag_backed_terminal_release")
  }
}

pipeline test_sweep_recognizes_prerelease_attempt_and_local_branch(task) {
  const remote_entry = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-attempt/v1.2.4-rc.10/${FIRST}", FIRST),
    fn(_slug, _ref) { return "1.2.4-rc.10" },
    fn(_oid) { return false },
    fn(version, ref_oid, _slug) { return proof(version, ref_oid, FIRST) },
  )
  assert_eq([remote_entry.version, remote_entry.action], ["1.2.4-rc.10", "delete"])
  const local_entry = release_local_branch_sweep_entry(
    "/tmp/harn",
    "burin-labs/harn",
    remote("refs/heads/release/v1.2.4-rc.10", FIRST),
    adapter([], [], "", true, true, FIRST),
  )
  assert_eq([local_entry.version, local_entry.action], ["1.2.4-rc.10", "delete"])
}

pipeline test_active_unpublished_release_is_retained(task) {
  const attempt = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-attempt/v1.2.4/${SECOND}", SECOND),
    fn(_slug, _ref) { return "1.2.4" },
    fn(_oid) { return false },
    fn(version, ref_oid, _slug) { return proof(version, ref_oid, "", false, false) },
  )
  const certification = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-certify/${SECOND}", SECOND),
    fn(_slug, _ref) { return nil },
    fn(_oid) { return false },
    fn(version, ref_oid, _slug) { return proof(version, ref_oid, "", false, false) },
  )
  assert_eq(attempt.action, "retain")
  assert_eq(attempt.reason_code, "signed_tag_unproven")
  assert_eq(certification.action, "retain")
  assert_eq(certification.reason_code, "version_unproven")
}

/**
 * harn's v0.10.51 shape: a verified signed tag on the exact OID, a hosted
 * release that will never be terminal because it was withdrawn on purpose, and
 * a registry entry recording that decision. Before #701 the sweep pinned these
 * refs forever and every later withdrawal added three more.
 */
pipeline test_withdrawn_release_refs_are_swept(task) {
  const withdrawn = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-attempt/v1.2.3/${FIRST}", FIRST),
    fn(_slug, _ref) { return "1.2.3" },
    fn(_oid) { return false },
    fn(version, ref_oid, _slug) { return proof(version, ref_oid, FIRST, true, false, true) },
  )
  assert_eq(withdrawn.action, "delete")
  // Asserting the code, not just the action: the entry must not inherit
  // deletion()'s "tag_backed_terminal_release" default and record a withdrawn
  // release as a completed one.
  assert_eq(withdrawn.reason_code, "withdrawn_release_terminal")
  // The paired negative is the whole guard: identical evidence with no
  // registered withdrawal must still be retained, so an in-flight release is
  // never swept by this path.
  const in_flight = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-attempt/v1.2.3/${FIRST}", FIRST),
    fn(_slug, _ref) { return "1.2.3" },
    fn(_oid) { return false },
    fn(version, ref_oid, _slug) { return proof(version, ref_oid, FIRST, true, false, false) },
  )
  assert_eq(in_flight.action, "retain")
  assert_eq(in_flight.reason_code, "hosted_release_nonterminal")
}

pipeline test_versionless_certification_requires_exact_main_recovery(task) {
  let proof_calls = 0
  const recovery = fn(version, ref_oid, _slug) {
    proof_calls = proof_calls + 1
    return proof(version, ref_oid, FIRST)
  }
  const recoverable = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-certify/${FIRST}", FIRST),
    fn(_slug, _ref) { return nil },
    fn(oid) { return oid == FIRST },
    recovery,
  )
  assert_eq(recoverable.action, "delete")
  assert_eq(recoverable.outcome, "planned")
  assert_eq(recoverable.reason_code, "main_recoverable_certification")
  assert(contains(recoverable.message, "origin/main"))
  assert_eq(proof_calls, 0)
  const divergent = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-certify/${SECOND}", SECOND),
    fn(_slug, _ref) { return nil },
    fn(_oid) { return false },
    recovery,
  )
  assert_eq(divergent.action, "retain")
  assert_eq(divergent.reason_code, "version_unproven")
  assert_eq(proof_calls, 0)
}

pipeline test_moved_and_malformed_remote_refs_are_retained_without_proof(task) {
  let proof_calls = 0
  const proof_fn = fn(version, ref_oid, _slug) {
    proof_calls = proof_calls + 1
    return proof(version, ref_oid, FIRST)
  }
  const moved = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-certify/${FIRST}", SECOND),
    fn(_slug, _ref) { return "1.2.3" },
    fn(_oid) { return false },
    proof_fn,
  )
  const malformed = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote("refs/heads/release-attempt/v1.2/${FIRST}", FIRST),
    fn(_slug, _ref) { return "1.2.3" },
    fn(_oid) { return false },
    proof_fn,
  )
  assert_eq(moved.reason_code, "moved_ref")
  assert_eq(malformed.reason_code, "malformed_or_unowned_ref")
  assert_eq(proof_calls, 0)
}

pipeline test_worktree_held_local_release_branch_is_retained(task) {
  const entry = release_local_branch_sweep_entry(
    "/tmp/harn",
    "burin-labs/harn",
    remote("refs/heads/release/v1.2.3", FIRST),
    adapter([], [], "/tmp/release-worktree"),
  )
  assert_eq(entry.action, "retain")
  assert_eq(entry.reason_code, "worktree_owned")
  assert(contains(entry.message, "/tmp/release-worktree"))
}

pipeline test_local_branch_with_unique_commits_is_retained(task) {
  const entry = release_local_branch_sweep_entry(
    "/tmp/harn",
    "burin-labs/harn",
    remote("refs/heads/release/v1.2.3", FIRST),
    adapter([], [], "", false),
  )
  assert_eq(entry.action, "retain")
  assert_eq(entry.reason_code, "unique_local_commits")
}

pipeline test_dry_run_inventories_every_ref_without_deleting(harness: Harness, task) {
  let deletes = 0
  const base = adapter(
    [
      remote("refs/heads/release-attempt/v1.2.3/${FIRST}", FIRST),
      remote("refs/heads/release-weird", SECOND),
    ],
    [remote("refs/heads/release/v1.2.3", FIRST)],
  )
  const injected: ReleaseRefSweepAdapter = {
    now: base.now,
    remote_refs: base.remote_refs,
    local_refs: base.local_refs,
    version_at_ref: base.version_at_ref,
    remote_commit_recoverable: base.remote_commit_recoverable,
    recovery_proof: base.recovery_proof,
    worktree_branch: base.worktree_branch,
    local_commits_recoverable: base.local_commits_recoverable,
    delete_remote_ref: fn(_repo, _ref, _expected_oid) {
      deletes = deletes + 1
      return {success: true, message: "unexpected"}
    },
    delete_local_branch: fn(_repo, _branch, _expected_oid) {
      deletes = deletes + 1
      return {success: true, message: "unexpected"}
    },
  }
  const path = receipt_path({fs: harness.fs, random: harness.random})
  const result = run_release_ref_sweep(
    harness,
    {repo: "/tmp/harn", mode: "dry_run", receipt_path: path},
    injected,
  )
  assert_eq(result.state, "planned")
  assert_eq(len(result.refs), 3)
  assert_eq(deletes, 0)
  assert_eq(result.refs.filter({ entry -> entry.action == "delete" }).count(), 2)
  assert_eq(result.refs.filter({ entry -> entry.action == "retain" }).count(), 1)
  const persisted = read_json_result(harness.fs, path)
  assert(is_ok(persisted))
  assert_eq(len(unwrap(persisted).refs), 3)
}

pipeline test_apply_retries_partial_cleanup_and_records_absence(harness: Harness, task) {
  let remote_refs = [
    remote("refs/heads/release-attempt/v1.2.3/${FIRST}", FIRST),
    remote("refs/heads/release-certify/${FIRST}", FIRST),
  ]
  let fail_certify = true
  const base = adapter()
  const injected: ReleaseRefSweepAdapter = {
    now: base.now,
    remote_refs: fn(_repo) { return remote_refs },
    local_refs: base.local_refs,
    version_at_ref: base.version_at_ref,
    remote_commit_recoverable: base.remote_commit_recoverable,
    recovery_proof: base.recovery_proof,
    worktree_branch: base.worktree_branch,
    local_commits_recoverable: base.local_commits_recoverable,
    delete_remote_ref: fn(_repo, ref, _expected_oid) {
      if contains(ref, "release-certify") && fail_certify {
        fail_certify = false
        return {success: false, message: "transient provider failure"}
      }
      remote_refs = remote_refs.filter({ current -> current.ref != ref }).to_list()
      return {success: true, message: "deleted"}
    },
    delete_local_branch: base.delete_local_branch,
  }
  const path = receipt_path({fs: harness.fs, random: harness.random})
  const first = run_release_ref_sweep(
    harness,
    {repo: "/tmp/harn", mode: "apply", receipt_path: path},
    injected,
  )
  assert_eq(first.state, "blocked")
  assert_eq(len(remote_refs), 1)
  const retried = run_release_ref_sweep(
    harness,
    {repo: "/tmp/harn", mode: "apply", receipt_path: path},
    injected,
  )
  assert_eq(retried.state, "completed")
  assert_eq(len(remote_refs), 0)
  assert(retried.refs.any({ entry -> entry.outcome == "absent" }))
  assert(retried.refs.any({ entry -> entry.outcome == "deleted" }))
}

pipeline test_sweep_observation_failure_preserves_terminal_release_authority(
  harness: Harness,
  task,
) {
  const base = adapter()
  const path = receipt_path({fs: harness.fs, random: harness.random})
  write_json(
    harness.fs,
    path,
    {
      schema_version: "release_harn.ref_sweep.v1",
      mode: "apply",
      slug: "burin-labs/harn",
      repo: "/tmp/harn",
      state: "blocked",
      message: "prior partial sweep",
      refs: [
        {
          resource: "remote_ref",
          name: "refs/heads/release/v1.2.3",
          version: "1.2.3",
          expected_oid: FIRST,
          observed_oid: FIRST,
          action: "delete",
          outcome: "failed",
          reason_code: "delete_failed",
          message: "prior delete failed",
        },
      ],
      updated_at: "2026-07-13T00:03:00Z",
    },
  )
  const result = run_release_ref_sweep(
    harness,
    {repo: "/tmp/harn", mode: "apply", receipt_path: path},
    {
      now: base.now,
      remote_refs: fn(_repo) {
        throw {
          category: "transient_network_exhausted",
          message: "could not resolve host after four attempts",
        }
      },
      local_refs: base.local_refs,
      version_at_ref: base.version_at_ref,
      remote_commit_recoverable: base.remote_commit_recoverable,
      recovery_proof: base.recovery_proof,
      worktree_branch: base.worktree_branch,
      local_commits_recoverable: base.local_commits_recoverable,
      delete_remote_ref: base.delete_remote_ref,
      delete_local_branch: base.delete_local_branch,
    },
  )
  assert_eq(result.state, "blocked")
  assert_eq(result.error_category, "transient_network_exhausted")
  assert(contains(result.message, "terminal release proof remains authoritative"))
  assert_eq(len(result.refs), 1)
  assert_eq(result.refs[0]?.name, "refs/heads/release/v1.2.3")
  const persisted = read_json_result(harness.fs, path)
  assert(is_ok(persisted))
  assert_eq(unwrap(persisted).error_category, "transient_network_exhausted")
}
