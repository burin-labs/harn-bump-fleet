import { GithubWorkflowProjection, decode_github_workflow } from "../lib/github_workflow"

fn workflow_source(fs: HarnessFs) -> string {
  const root = dirname(fs.cwd())
  return fs.read_text(path_join(root, ".github/workflows/ci.yml"))
}

fn has_bounded_unit_suite(projected: GithubWorkflowProjection) -> bool {
  const job = projected.jobs.get("unit-tests")
  let run_steps = []
  for step in job?.steps ?? [] {
    if step.run != nil {
      run_steps = run_steps + [step.run]
    }
  }
  return job?.name == "Harn unit suite"
    && job?.["timeout-minutes"] == 20
    && run_steps
      == [
        "harn install --locked",
        "harn run --no-sandbox check_public_metadata_privacy.harn",
        "harn test tests/ --parallel --timeout 120000",
      ]
    && projected.jobs.get("status")?.needs
      == ["package", "unit-tests", "release-harness", "release-preflight"]
}

pipeline test_ci_requires_the_bounded_unit_suite(harness: Harness, task: any) {
  const source = workflow_source(harness.fs)
  assert(has_bounded_unit_suite(decode_github_workflow(source)))
  // Negative control: an unbounded suite must not satisfy the required CI contract.
  const unbounded = source.replace(" --timeout 120000", "")
  assert_eq(has_bounded_unit_suite(decode_github_workflow(unbounded)), false)
}

pipeline test_ci_asks_every_release_precondition_and_never_greens_a_skipped_one(harness: Harness) {
  // A renderer, manifest, or token-profile change edited here is what put the
  // release's own preconditions out of date, so it has to fail its own pull
  // request. This asserts the job that does that, and that a context without
  // credentials drops to --offline rather than passing silently.
  const root = dirname(harness.fs.cwd())
  const ci = decode_github_workflow(workflow_source(harness.fs))
  const call = ci.jobs.get("release-preflight")
  assert(call != nil, "CI does not run the release launch preflight")
  assert_eq(call?.uses, "./.github/workflows/release-preflight.yml")
  // A pull request cannot answer for consumers that can only be re-rendered
  // after it merges, so it is asked as `prepare`; only a push asks as ship-pr.
  const mode = to_string(call?.with?.get("mode") ?? "")
  assert(contains(mode, "'ship-pr'"), mode)
  assert(contains(mode, "'prepare'"), mode)
  assert_eq(
    ci.jobs.get("status")?.needs,
    ["package", "unit-tests", "release-harness", "release-preflight"],
  )
  const preflight = decode_github_workflow(
    harness.fs.read_text(path_join(root, ".github/workflows/release-preflight.yml")),
  )
  const ask = (preflight.jobs.get("release-preflight")?.steps ?? []).find(
    { step -> step.name == "Ask every release precondition" },
  )
  assert(ask != nil, "the preflight workflow never asks the preconditions")
  assert(contains(ask?.run ?? "", "./scripts/preflight_release_launch.sh"), ask?.run ?? "")
  assert(contains(ask?.run ?? "", "args+=(--offline)"), ask?.run ?? "")
  // Live state rots with no commit here, so the preflight also runs hourly.
  assert(contains(preflight.triggers, "schedule"))
  assert(contains(preflight.triggers, "workflow_call"))
}

/**
 * The standalone hourly probe and CI's called copy can overlap on `main`.
 * Their concurrency keys must differ, while repeats within either identity
 * remain collapsible.
 */
pipeline test_scheduled_preflight_cannot_cancel_ci_preflight(harness: Harness) {
  const root = dirname(harness.fs.cwd())
  const source = harness.fs.read_text(path_join(root, ".github/workflows/release-preflight.yml"))
  const group = to_string(yaml_parse(source)?.get("concurrency")?.get("group") ?? "")
  assert(contains(group, "github.workflow"), group)
  assert(contains(group, "github.ref"), group)
  // Negative control: the old ref-only key collapses the scheduled workflow
  // and CI back onto the same main-branch concurrency group.
  const collapsed = source.replace("$" + "{{ github.workflow }}-", "")
  const collapsed_group = to_string(yaml_parse(collapsed)?.get("concurrency")?.get("group") ?? "")
  assert_eq(contains(collapsed_group, "github.workflow"), false)
}
