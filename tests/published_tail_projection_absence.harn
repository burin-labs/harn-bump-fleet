import { FleetProjectionTarget } from "../lib/fleet_projection_targets"
import {
  observe_remote_projection_effect,
  remote_projection_branch,
} from "../lib/remote_projection"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

const PATH = "PROJECTION.yml"

const EXPECTED = "name: expected\n"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "projection-absence-token"}
}

fn targets() -> list<FleetProjectionTarget> {
  return [{slug: SLUG, path: PATH, expected: EXPECTED, origin: "fleet.toml test projection"}]
}

fn file_url(ref: string) -> string {
  return BASE + "/repos/octo-org/octo-repo/contents/" + PATH + "?ref=" + replace(ref, "/", "%2F")
}

fn file_body(text: string) -> string {
  return json_stringify(
    {
      name: PATH,
      path: PATH,
      sha: "dddddddddddddddddddddddddddddddddddddddd",
      size: len(text),
      type: "file",
      encoding: "base64",
      content: base64_encode(text),
    },
  )
}

fn mock_drift_and_missing_ref(testing: HarnessTesting, branch: string) {
  testing.http_mock("GET", file_url("main"), {status: 200, body: file_body("name: stale\n")})
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch,
    {status: 404, body: json_stringify({message: "Not Found"})},
  )
}

fn pulls_url(branch: string) -> string {
  return BASE
    + "/repos/octo-org/octo-repo/pulls?state=all&head="
    + url_encode("octo-org:" + branch)
    + "&base=main&per_page=100"
}

pipeline test_exact_projection_absence_requires_both_missing_ref_and_empty_pr_census(
  harness: Harness,
) {
  harness.testing.http_mock_clear()
  const branch = remote_projection_branch(targets())
  mock_drift_and_missing_ref(harness.testing, branch)
  harness.testing.http_mock("GET", pulls_url(branch), {status: 200, body: "[]"})
  const observed = observe_remote_projection_effect(harness, SLUG, "main", targets(), options())
  assert_eq(observed.status, "drift")
  assert_eq(observed.branch, branch)
  assert_eq(observed.effect_absent, true)
  assert_eq(harness.testing.http_mock_calls().filter({ call -> call.method != "GET" }).count(), 0)
}

pipeline test_a_historical_exact_projection_pr_prevents_absence_proof(harness: Harness) {
  harness.testing.http_mock_clear()
  const branch = remote_projection_branch(targets())
  mock_drift_and_missing_ref(harness.testing, branch)
  harness.testing.http_mock(
    "GET",
    pulls_url(branch),
    {
      status: 200,
      body: json_stringify(
        [
          {
            number: 42,
            title: "chore: restore fleet-owned projections",
            state: "closed",
            html_url: "https://github.com/octo-org/octo-repo/pull/42",
            merged_at: nil,
            base: {
              ref: "main",
              sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              repo: {full_name: SLUG, owner: {login: "octo-org"}},
            },
            head: {
              ref: branch,
              sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              repo: {full_name: SLUG, owner: {login: "octo-org"}},
            },
          },
        ],
      ),
    },
  )
  const observed = observe_remote_projection_effect(harness, SLUG, "main", targets(), options())
  assert_eq(observed.status, "error")
  assert_eq(observed.effect_absent, false)
  assert(contains(observed.error ?? "", "was closed"))
}
