import {
  parse_pin_staleness_args,
  resolve_max_releases_behind,
} from "../check_fleet_pin_staleness.harn"
import { formula_harn_pin_probe } from "../lib/bump_pins"
import {
  harn_bump_repositories,
  harn_pin_watch_repositories,
  read_fleet_manifest,
  unwatched_repositories,
} from "../lib/fleet_manifest"
import {
  pin_staleness_verdict,
  releases_behind,
  stale_rows,
  staleness_issue_body,
  staleness_issue_marker,
  undeclared_pin_rows,
} from "../lib/fleet_staleness"
import { github_open_issues_query } from "../lib/github"

// A synthetic series with a deliberate hole at v0.10.112. The real Harn series
// is dense today, but a failed or yanked publication leaves exactly this shape,
// and it is the case where counting differs from arithmetic.
const GAPPED = ["v0.10.115", "v0.10.114", "v0.10.113", "v0.10.111", "v0.10.110"]

// The real series at the time of the incident below, which is dense.
const REAL_SERIES = ["v0.10.115", "v0.10.114", "v0.10.113", "v0.10.112", "v0.10.111"]

pipeline test_releases_behind_counts_published_releases_not_version_arithmetic() {
  // Three published releases are newer than 0.10.111 in the gapped series.
  // Subtracting patch numbers would say four and name a release nobody could
  // ever have adopted.
  assert_eq(releases_behind("0.10.111", GAPPED), 3)
  assert_eq(releases_behind("0.10.115", GAPPED), 0)
  assert_eq(releases_behind("v0.10.114", GAPPED), 1)
}

/**
 * A pin the check could not read must not round down to "healthy". A repo that
 * has fallen out of the fleet's reach is the failure being hunted, not a pass.
 */
pipeline test_an_unreadable_pin_counts_as_maximally_behind() {
  assert_eq(releases_behind(nil, GAPPED), len(GAPPED))
  assert_eq(releases_behind("", GAPPED), len(GAPPED))
  const verdict = pin_staleness_verdict(nil, "v0.10.115", 5, 1)
  assert_eq(verdict.state, "unknown")
  assert(verdict.stale, "an unreadable pin must alarm")
}

pipeline test_a_current_or_ahead_pin_does_not_alarm() {
  const current = pin_staleness_verdict("0.10.115", "v0.10.115", 0, 1)
  assert_eq(current.state, "current")
  assert(!current.stale)
  const ahead = pin_staleness_verdict("0.10.116", "v0.10.115", 0, 1)
  assert_eq(ahead.state, "ahead")
  assert(!ahead.stale, "a consumer ahead of the release is not stale")
}

/**
 * The threshold is the whole design: one release behind is the normal window
 * between a release publishing and the daily bump landing, so alarming there
 * would train people to ignore this. Two is a pipeline that already failed.
 */
pipeline test_one_release_behind_is_tolerated_and_two_is_not() {
  const tolerated = pin_staleness_verdict("0.10.114", "v0.10.115", 1, 1)
  assert_eq(tolerated.state, "behind")
  assert(!tolerated.stale, "one release behind is the adoption window")
  const alarming = pin_staleness_verdict("0.10.113", "v0.10.115", 2, 1)
  assert_eq(alarming.state, "behind")
  assert(alarming.stale, "two releases behind means a bump already failed")
}

/**
 * The incident this check exists for: a consumer pinned 0.10.111 while
 * v0.10.115 was published, after three bump runs failed without paging anyone.
 * A live dry run against the fleet reproduced exactly this row.
 */
pipeline test_the_four_release_regression_alarms() {
  const behind = releases_behind("0.10.111", REAL_SERIES)
  const verdict = pin_staleness_verdict("0.10.111", "v0.10.115", behind, 1)
  assert(verdict.stale, "a consumer stuck on 0.10.111 must alarm")
  assert_eq(verdict.releases_behind, 4)
  assert(contains(verdict.detail, "0.10.111"), verdict.detail)
  const rows = stale_rows(
    [
      verdict + {slug: "burin-labs/stuck", pin: "0.10.111"},
      pin_staleness_verdict("0.10.115", "v0.10.115", 0, 1)
        + {slug: "burin-labs/fine", pin: "0.10.115"},
    ],
  )
  assert_eq(len(rows), 1)
  assert_eq(rows[0].slug, "burin-labs/stuck")
}

/**
 * The marker is the upsert key. If the body ever stops carrying it, the check
 * silently opens a fresh issue every morning instead of refreshing one, and
 * the alarm becomes the noise it was built to avoid.
 */
pipeline test_the_issue_body_carries_its_upsert_marker() {
  const row = pin_staleness_verdict("0.10.111", "v0.10.115", 4, 1)
    + {slug: "burin-labs/stuck", pin: "0.10.111"}
  const body = staleness_issue_body(row, "v0.10.115", "https://example.test/run/1")
  assert(contains(body, staleness_issue_marker("burin-labs/stuck")), body)
  assert(contains(body, "0.10.111"), body)
  assert(contains(body, "v0.10.115"), body)
  assert(contains(body, "https://example.test/run/1"), body)
  assert(!contains(staleness_issue_body(row, "v0.10.115", nil), "Detected by"))
}

pipeline test_open_issue_query_is_scoped_to_open_labelled_issues() {
  assert_eq(
    github_open_issues_query("harn-pin-staleness"),
    {labels: "harn-pin-staleness", state: "open", per_page: 100},
  )
}

fn thrown(callback: closure) -> string {
  const result = try {
    callback()
  }
  return to_string(unwrap_err(result))
}

pipeline test_pin_staleness_cli_boundary() {
  const parsed = parse_pin_staleness_args(["--dry-run", "--max-releases-behind", "2", "v1.2.3"])
  assert_eq(parsed.dry_run, true)
  assert_eq(resolve_max_releases_behind(parsed.max_releases_behind), 2)
  assert_eq(parsed.target, "v1.2.3")
  assert_eq(parsed.only, nil)
  const defaults = parse_pin_staleness_args([])
  assert_eq(resolve_max_releases_behind(defaults.max_releases_behind), 1)
  assert_eq(defaults.dry_run, false)
}

/**
 * A threshold that silently parsed to nothing would read as "no consumer is
 * ever stale" — the alarm disarmed by a typo, which is the failure mode this
 * whole check exists to prevent. It must refuse instead.
 */
pipeline test_a_non_numeric_threshold_is_refused_rather_than_ignored() {
  assert(contains(thrown({ -> resolve_max_releases_behind("two") }), "non-negative integer"))
  assert(contains(thrown({ -> resolve_max_releases_behind("-1") }), "non-negative integer"))
  assert_eq(resolve_max_releases_behind("0"), 0)
}

/**
 * The tap pins its Harn version in a Ruby `version` field. A formula also
 * carries version-shaped text inside its URLs and sha256 digests, so the probe
 * is anchored to the DSL line rather than to anything that merely looks like a
 * version.
 */
pipeline test_formula_pin_is_read_from_the_version_line_only() {
  const formula = "class Harn < Formula\n"
    + "  homepage \"https://harnlang.com/\"\n"
    + "  version \"0.10.115\"\n"
    + "  url \"https://github.com/burin-labs/harn/releases/download/v0.9.17/harn.tar.gz\"\n"
    + "  sha256 \"8785839ee3d49e3ad0abf34e87b8c4c8346c0888c0859926c64f6a189cd4777f\"\n"
    + "end\n"
  assert_eq(formula_harn_pin_probe(formula).pin, "0.10.115")
  assert_eq(formula_harn_pin_probe(nil).pin, nil)
  assert_eq(formula_harn_pin_probe("").pin, nil)
  const no_version = formula_harn_pin_probe("class Harn < Formula\nend\n")
  assert_eq(no_version.pin, nil)
  assert(contains(no_version.evidence, "no version"), no_version.evidence)
}

/**
 * The tap is both watched and dispatched through its repository-owned formula
 * workflow. Its zero-release budget makes publication lag visible immediately.
 */
pipeline test_the_watch_set_includes_pin_only_repositories(harness: Harness) {
  const manifest = read_fleet_manifest(
    harness.fs,
    path_join(dirname(harness.fs.cwd()), "fleet.toml"),
  )
  const watched = harn_pin_watch_repositories(manifest).map({ repo -> repo.slug }).to_list()
  const bumped = harn_bump_repositories(manifest).map({ repo -> repo.slug }).to_list()
  assert(contains(watched, "burin-labs/homebrew-burin"), "the tap must be watched")
  assert(contains(bumped, "burin-labs/homebrew-burin"), "the tap must receive release dispatches")
  const tap = manifest.repositories.find({ repo -> repo.slug == "burin-labs/homebrew-burin" })
  assert_eq(tap?.bump_max_releases_behind, 0)
  for slug in bumped {
    assert(contains(watched, slug), "every bumped repository is also watched: ${slug}")
  }
}

/**
 * The finding must come from a pin that was read. A repository outside the
 * watch is the normal case, not a defect, so only an actual pin file makes a
 * row; an unreadable probe and an absent file both stay silent rather than
 * inventing one.
 */
pipeline test_an_undeclared_pin_is_reported_only_when_a_pin_was_actually_read(task: unknown) {
  assert_eq(len(undeclared_pin_rows([])), 0)
  assert_eq(len(undeclared_pin_rows([{slug: "owner/no-pin", pin_text: nil}])), 0)
  assert_eq(len(undeclared_pin_rows([{slug: "owner/blank", pin_text: "  \n"}])), 0)
  const rows = undeclared_pin_rows(
    [{slug: "owner/no-pin", pin_text: nil}, {slug: "owner/pinned", pin_text: "0.10.53\n"}],
  )
  assert_eq(len(rows), 1)
  assert_eq(rows[0]?.slug, "owner/pinned")
  assert_eq(rows[0]?.pin, "0.10.53")
  assert(contains(rows[0]?.detail ?? "", "harn_bump"))
}

/**
 * Every repository the manifest leaves out of the watch must be one that does
 * not track the runtime. This asserts the partition itself, so a future entry
 * cannot rejoin the unwatched set while carrying a pin without reddening here
 * as well as in the live census.
 */
pipeline test_no_manifest_repository_pins_the_runtime_outside_the_watch(harness: Harness) {
  const manifest = read_fleet_manifest(
    harness.fs,
    path_join(dirname(harness.fs.cwd()), "fleet.toml"),
  )
  const unwatched = unwatched_repositories(manifest).map({ repo -> repo.slug }).to_list()
  const watched = harn_pin_watch_repositories(manifest).map({ repo -> repo.slug }).to_list()
  assert_eq(len(unwatched) + len(watched), len(manifest.repositories))
  for slug in unwatched {
    assert_eq(contains(watched, slug), false, "a repository cannot be in both sets: ${slug}")
  }
  assert(contains(unwatched, "burin-labs/harn-sdk-python"))
  assert_eq(contains(unwatched, "burin-labs/harn-documents"), false)
  assert_eq(contains(unwatched, "burin-labs/harn-packages"), false)
}
