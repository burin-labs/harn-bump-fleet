import { read_json_result, write_json } from "std/fs"
import { GitRemoteRef } from "std/git"
import {
  release_current_ref_cleanup_decision,
  release_ref_cleanup_candidates,
  release_ref_cleanup_receipt_path,
  release_ref_deletion_decision,
  run_release_ref_cleanup,
} from "../lib/release_ref_cleanup"
import {
  ReleaseWatchReceipt,
  release_watch_apply_warm_cache_transition,
  release_watch_receipt,
  release_watch_receipt_bind_main_commit,
  release_watch_record_warm_cache_dispatch,
  release_watch_transition,
  release_watch_warm_cache_transition,
} from "../lib/release_watch_state"

const FIRST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const SECOND = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const OTHER = "cccccccccccccccccccccccccccccccccccccccc"

fn terminal_receipt() -> ReleaseWatchReceipt {
  let receipt = release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: OTHER,
      publication: {
        version: "1.2.3",
        local_branch: "release/v1.2.3",
        remote_ref: "release-attempt/v1.2.3/${SECOND}",
        head_oid: SECOND,
      },
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
  receipt = release_watch_receipt_bind_main_commit(
    receipt,
    "dddddddddddddddddddddddddddddddddddddddd",
    "2026-07-13T00:00:30Z",
  )
  receipt = release_watch_transition(
    receipt,
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:01:00Z"},
  ).receipt
  receipt = release_watch_record_warm_cache_dispatch(
    receipt,
    {
      accepted: true,
      observed_at: "2026-07-13T00:02:00Z",
      workflow_run_id: 99,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/99",
      source_sha: OTHER,
      message: "accepted",
    },
  )
  return release_watch_apply_warm_cache_transition(
    receipt,
    release_watch_warm_cache_transition(
      receipt.warm_cache,
      true,
      {
        observed_at: "2026-07-13T00:03:00Z",
        release_pr_merged: true,
        overlap_active: false,
        run: {
          workflow_run_id: 99,
          workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/99",
          source_sha: OTHER,
          event: "workflow_dispatch",
          head_branch: "main",
          status: "completed",
          conclusion: "success",
          started_at: "2026-07-13T00:02:01Z",
          completed_at: "2026-07-13T00:03:00Z",
        },
        jobs: [
          {name: "Build aarch64-apple-darwin", status: "completed", conclusion: "success"},
          {name: "Build aarch64-unknown-linux-gnu", status: "completed", conclusion: "success"},
          {name: "Build x86_64-apple-darwin", status: "completed", conclusion: "success"},
          {name: "Build x86_64-pc-windows-msvc", status: "completed", conclusion: "success"},
          {name: "Build x86_64-unknown-linux-gnu", status: "completed", conclusion: "success"},
        ],
        jobs_observed: true,
      },
    ),
  )
}

fn unwarmed_terminal_receipt() -> ReleaseWatchReceipt {
  let receipt = release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: OTHER,
      publication: {
        version: "1.2.3",
        local_branch: "release/v1.2.3",
        remote_ref: "release-attempt/v1.2.3/${SECOND}",
        head_oid: SECOND,
      },
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
  receipt = release_watch_receipt_bind_main_commit(
    receipt,
    "dddddddddddddddddddddddddddddddddddddddd",
    "2026-07-13T00:00:30Z",
  )
  return release_watch_transition(
    receipt,
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:01:00Z"},
  ).receipt
}

fn remote(ref: string, oid: string) -> GitRemoteRef {
  return {oid: oid, ref: ref, name: ref, peeled: false}
}

fn watch_path(harness: {fs: HarnessFs, random: HarnessRandom}) -> string {
  return path_join(
    harness.fs.temp_dir(),
    "release-cleanup-" + harness.random.uuid_v7(),
    "watch.json",
  )
}

pipeline test_exact_deletion_policy_requires_signed_tag_and_terminal_hosted_proof(task: any) {
  const unsigned = release_ref_deletion_decision(
    {
      expected_oid: FIRST,
      observed_oid: FIRST,
      tag_target_oid: FIRST,
      signed_tag: false,
      hosted_terminal: true,
      withdrawn: false,
    },
  )
  const nonterminal = release_ref_deletion_decision(
    {
      expected_oid: FIRST,
      observed_oid: FIRST,
      tag_target_oid: FIRST,
      signed_tag: true,
      hosted_terminal: false,
      withdrawn: false,
    },
  )
  const exact = release_ref_deletion_decision(
    {
      expected_oid: FIRST,
      observed_oid: FIRST,
      tag_target_oid: FIRST,
      signed_tag: true,
      hosted_terminal: true,
      withdrawn: false,
    },
  )
  assert_eq(unsigned.reason_code, "signed_tag_unproven")
  assert_eq(nonterminal.reason_code, "hosted_release_nonterminal")
  assert_eq(exact.delete, true)
}

/**
 * A lockless release tags merged R, not pre-merge candidate C. Terminal watch
 * authority therefore deletes exact C refs without pretending the tag recovers
 * C; the unrelated OIDs are the shape this contract exists to support.
 */
pipeline test_current_cleanup_uses_the_terminal_merged_commit_not_candidate_tag_recovery(
  task: any,
) {
  const candidate = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const merged = "dddddddddddddddddddddddddddddddddddddddd"
  const decision = release_current_ref_cleanup_decision(
    {
      expected_oid: candidate,
      observed_oid: candidate,
      release_commit_oid: merged,
      hosted_terminal: true,
    },
  )
  assert_eq(decision.delete, true)
  assert_eq(decision.reason_code, "terminal_release_receipt")
  assert(contains(decision.message, merged))
  assert_eq(contains(decision.message, "recoverable from a signed tag"), false)
}

/** Missing terminal authority and moved ref identity both fail closed. */
pipeline test_current_cleanup_refuses_unbound_nonterminal_and_moved_evidence(task: any) {
  const exact = {
    expected_oid: FIRST,
    observed_oid: FIRST,
    release_commit_oid: OTHER,
    hosted_terminal: true,
  }
  const unbound = release_current_ref_cleanup_decision({...exact, release_commit_oid: ""})
  const nonterminal = release_current_ref_cleanup_decision({...exact, hosted_terminal: false})
  const moved = release_current_ref_cleanup_decision({...exact, observed_oid: SECOND})
  assert_eq(
    [unbound.reason_code, nonterminal.reason_code, moved.reason_code],
    ["release_commit_unbound", "hosted_release_nonterminal", "moved_ref"],
  )
  assert_eq([unbound.delete, nonterminal.delete, moved.delete], [false, false, false])
}

/**
 * A withdrawn release never becomes hosted-terminal, so without its own
 * terminal state its transient refs are pinned forever (#701). It must still
 * be reported distinctly from a completed release, and must not weaken the
 * OID-exactness the other gates provide.
 */
pipeline test_registered_withdrawal_is_terminal_without_a_hosted_release(task: any) {
  const withdrawn = release_ref_deletion_decision(
    {
      expected_oid: FIRST,
      observed_oid: FIRST,
      tag_target_oid: FIRST,
      signed_tag: true,
      hosted_terminal: false,
      withdrawn: true,
    },
  )
  assert_eq(withdrawn.delete, true)
  // Never "tag_backed_terminal_release": a receipt must not claim a withdrawn
  // release completed.
  assert_eq(withdrawn.reason_code, "withdrawn_release_terminal")
  // A withdrawal does not excuse an unsigned tag.
  const unsigned = release_ref_deletion_decision(
    {
      expected_oid: FIRST,
      observed_oid: FIRST,
      tag_target_oid: FIRST,
      signed_tag: false,
      hosted_terminal: false,
      withdrawn: true,
    },
  )
  assert_eq(unsigned.delete, false)
  assert_eq(unsigned.reason_code, "signed_tag_unproven")
  // Nor a tag that targets some other commit.
  const mismatched = release_ref_deletion_decision(
    {
      expected_oid: FIRST,
      observed_oid: FIRST,
      tag_target_oid: SECOND,
      signed_tag: true,
      hosted_terminal: false,
      withdrawn: true,
    },
  )
  assert_eq(mismatched.delete, false)
  assert_eq(mismatched.reason_code, "tag_target_mismatch")
  // Nor a ref that moved out from under the classification.
  const moved = release_ref_deletion_decision(
    {
      expected_oid: FIRST,
      observed_oid: SECOND,
      tag_target_oid: FIRST,
      signed_tag: true,
      hosted_terminal: false,
      withdrawn: true,
    },
  )
  assert_eq(moved.delete, false)
  assert_eq(moved.reason_code, "moved_ref")
  // A completed release still reports as completed, not as withdrawn.
  const completed = release_ref_deletion_decision(
    {
      expected_oid: FIRST,
      observed_oid: FIRST,
      tag_target_oid: FIRST,
      signed_tag: true,
      hosted_terminal: true,
      withdrawn: true,
    },
  )
  assert_eq(completed.reason_code, "tag_backed_terminal_release")
}

pipeline test_cleanup_candidates_include_attempts_and_same_version_certifications(task: any) {
  const receipt = terminal_receipt()
  const candidates = release_ref_cleanup_candidates(
    receipt,
    [
      remote("refs/heads/release-attempt/v1.2.3/${FIRST}", FIRST),
      remote("refs/heads/release-attempt/v1.2.3/${SECOND}", SECOND),
      remote("refs/heads/release-certify/${FIRST}", FIRST),
      remote("refs/heads/release-certify/${OTHER}", OTHER),
      remote("refs/heads/main", OTHER),
    ],
    fn(_slug, ref) { return if ref == "release-certify/${FIRST}" {
      "1.2.3"
    } else {
      "1.2.2"
    } },
  )
  assert_eq(
    candidates.map({ candidate -> candidate.ref }).to_list(),
    [
      "refs/heads/release-attempt/v1.2.3/${FIRST}",
      "refs/heads/release-attempt/v1.2.3/${SECOND}",
      "refs/heads/release-certify/${FIRST}",
    ],
  )
}

pipeline test_terminal_cleanup_deletes_exact_refs_and_persists_receipt(
  harness: Harness,
  task: any,
) {
  const receipt = terminal_receipt()
  assert_eq(receipt.release_commit_oid, "dddddddddddddddddddddddddddddddddddddddd")
  assert(receipt.release_commit_oid != FIRST)
  let refs = [
    remote("refs/heads/release-attempt/v1.2.3/${FIRST}", FIRST),
    remote("refs/heads/release-certify/${FIRST}", FIRST),
  ]
  let deleted: list<string> = []
  const path = watch_path({fs: harness.fs, random: harness.random})
  const result = run_release_ref_cleanup(
    harness,
    receipt,
    path,
    "/tmp/harn",
    {
      now: fn() { return "2026-07-13T00:04:00Z" },
      remote_refs: fn(_repo, _patterns) { return refs },
      version_at_ref: fn(_slug, _ref) { return "1.2.3" },
      delete_ref: fn(_repo, ref, expected_oid) {
        assert(ends_with(ref, expected_oid))
        deleted = deleted + [ref]
        refs = refs.filter({ candidate -> candidate.ref != ref }).to_list()
        return {success: true, message: "deleted"}
      },
    },
  )
  assert_eq(result.state, "completed")
  assert_eq(len(deleted), 2)
  assert(result.refs.all({ ref -> ref.state == "deleted" }))
  const persisted = read_json_result(harness.fs, release_ref_cleanup_receipt_path(path))
  assert(is_ok(persisted))
  assert_eq(unwrap(persisted).state, "completed")
}

pipeline test_unwarmed_terminal_cleanup_uses_hosted_release_proof(harness: Harness, task: any) {
  let deleted: list<string> = []
  const result = run_release_ref_cleanup(
    harness,
    unwarmed_terminal_receipt(),
    watch_path({fs: harness.fs, random: harness.random}),
    "/tmp/harn",
    {
      now: fn() { return "2026-07-13T00:04:00Z" },
      remote_refs: fn(_repo, _patterns) { return [
        remote("refs/heads/release-attempt/v1.2.3/${FIRST}", FIRST),
      ] },
      version_at_ref: fn(_slug, _ref) { return "1.2.3" },
      delete_ref: fn(_repo, ref, _expected_oid) {
        deleted = deleted + [ref]
        return {success: true, message: "deleted"}
      },
    },
  )
  assert_eq(result.state, "completed")
  assert_eq(result.terminal_proof_at, "2026-07-13T00:01:00Z")
  assert_eq(len(deleted), 1)
}

pipeline test_cleanup_target_mismatch_fails_closed_without_delete(harness: Harness, task: any) {
  let delete_count = 0
  const result = run_release_ref_cleanup(
    harness,
    terminal_receipt(),
    watch_path({fs: harness.fs, random: harness.random}),
    "/tmp/harn",
    {
      now: fn() { return "2026-07-13T00:04:00Z" },
      remote_refs: fn(_repo, _patterns) { return [
        remote("refs/heads/release-attempt/v1.2.3/${FIRST}", SECOND),
      ] },
      version_at_ref: fn(_slug, _ref) { return "1.2.3" },
      delete_ref: fn(_repo, _ref, _expected_oid) {
        delete_count = delete_count + 1
        return {success: true, message: "unexpected"}
      },
    },
  )
  assert_eq(result.state, "blocked")
  const first = result.refs[0]
  if first == nil {
    throw "expected mismatched ref receipt"
  }
  assert_eq(first.state, "mismatch")
  assert_eq(delete_count, 0)
}

pipeline test_cleanup_retry_recovers_from_partial_delete(harness: Harness, task: any) {
  let refs = [
    remote("refs/heads/release-attempt/v1.2.3/${FIRST}", FIRST),
    remote("refs/heads/release-certify/${FIRST}", FIRST),
  ]
  let fail_certify = true
  const path = watch_path({fs: harness.fs, random: harness.random})
  const adapter = {
    now: fn() { return "2026-07-13T00:04:00Z" },
    remote_refs: fn(_repo, _patterns) { return refs },
    version_at_ref: fn(_slug, _ref) { return "1.2.3" },
    delete_ref: fn(_repo, ref, _expected_oid) {
      if contains(ref, "release-certify") && fail_certify {
        fail_certify = false
        return {success: false, message: "transient provider failure"}
      }
      refs = refs.filter({ candidate -> candidate.ref != ref }).to_list()
      return {success: true, message: "deleted"}
    },
  }
  const first = run_release_ref_cleanup(harness, terminal_receipt(), path, "/tmp/harn", adapter)
  assert_eq(first.state, "blocked")
  assert_eq(len(refs), 1)
  const retried = run_release_ref_cleanup(harness, terminal_receipt(), path, "/tmp/harn", adapter)
  assert_eq(retried.state, "completed")
  assert_eq(len(refs), 0)
  assert(retried.refs.any({ ref -> ref.state == "absent" }))
  assert(retried.refs.any({ ref -> ref.state == "deleted" }))
}

pipeline test_cleanup_records_thrown_adapter_error_without_replacing_terminal_result(
  harness: Harness,
  task: any,
) {
  const path = watch_path({fs: harness.fs, random: harness.random})
  const result = run_release_ref_cleanup(
    harness,
    terminal_receipt(),
    path,
    "/tmp/harn",
    {
      now: fn() { return "2026-07-13T00:04:00Z" },
      remote_refs: fn(_repo, _patterns) { return [
        remote("refs/heads/release-certify/${FIRST}", FIRST),
      ] },
      version_at_ref: fn(_slug, _ref) { return "1.2.3" },
      delete_ref: fn(_repo, _ref, _expected_oid) {
        throw {category: "tool_rejected", message: "git.push approval unavailable"}
      },
    },
  )
  assert_eq(result.state, "blocked")
  assert_eq(result.refs[0]?.state, "failed")
  assert_eq(result.refs[0]?.error_category, "tool_rejected")
  assert(contains(result.refs[0]?.message ?? "", "git.push approval unavailable"))
  const persisted = read_json_result(harness.fs, release_ref_cleanup_receipt_path(path))
  assert(is_ok(persisted))
  assert_eq(unwrap(persisted).refs[0]?.error_category, "tool_rejected")
}

pipeline test_cleanup_observation_failure_is_blocked_housekeeping_not_a_release_failure(
  harness: Harness,
  task: any,
) {
  const path = watch_path({fs: harness.fs, random: harness.random})
  write_json(
    harness.fs,
    release_ref_cleanup_receipt_path(path),
    {
      schema_version: "release_harn.ref_cleanup.v1",
      tag: "v1.2.3",
      watch_receipt_path: path,
      terminal_proof_at: "2026-07-13T00:03:00Z",
      state: "blocked",
      message: "prior partial cleanup",
      refs: [
        {
          ref: "refs/heads/release/v1.2.3",
          expected_oid: "abc123",
          observed_oid: "abc123",
          state: "failed",
          message: "prior delete failed",
          error_category: "network",
        },
      ],
      updated_at: "2026-07-13T00:03:00Z",
    },
  )
  const result = run_release_ref_cleanup(
    harness,
    terminal_receipt(),
    path,
    "/tmp/harn",
    {
      now: fn() { return "2026-07-13T00:04:00Z" },
      remote_refs: fn(_repo, _patterns) {
        throw {
          category: "transient_network_exhausted",
          message: "could not resolve host after four attempts",
        }
      },
      version_at_ref: fn(_slug, _ref) { return "1.2.3" },
      delete_ref: fn(_repo, _ref, _expected_oid) { return {success: true, message: "unexpected"} },
    },
  )
  assert_eq(result.state, "blocked")
  assert_eq(result.error_category, "transient_network_exhausted")
  assert(contains(result.message, "terminal release proof remains authoritative"))
  assert(contains(result.message, "could not resolve host after four attempts"))
  assert_eq(len(result.refs), 1)
  assert_eq(result.refs[0]?.ref, "refs/heads/release/v1.2.3")
  const persisted = read_json_result(harness.fs, release_ref_cleanup_receipt_path(path))
  assert(is_ok(persisted))
  assert_eq(unwrap(persisted).error_category, "transient_network_exhausted")
}

pipeline test_nonterminal_release_keeps_recovery_refs(harness: Harness, task: any) {
  let probed = false
  const pending = release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: OTHER,
      publication: {
        version: "1.2.3",
        local_branch: "release/v1.2.3",
        remote_ref: "release-attempt/v1.2.3/${SECOND}",
        head_oid: SECOND,
      },
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
  const path = watch_path({fs: harness.fs, random: harness.random})
  const result = run_release_ref_cleanup(
    harness,
    pending,
    path,
    "/tmp/harn",
    {
      now: fn() { return "2026-07-13T00:04:00Z" },
      remote_refs: fn(_repo, _patterns) {
        probed = true
        return []
      },
      version_at_ref: fn(_slug, _ref) { return nil },
      delete_ref: fn(_repo, _ref, _expected_oid) { return {success: true, message: ""} },
    },
  )
  assert_eq(result.state, "blocked")
  assert(contains(result.message, "remain protected"))
  assert_eq(probed, false)
  const persisted = read_json_result(harness.fs, release_ref_cleanup_receipt_path(path))
  assert(is_ok(persisted))
  assert_eq(unwrap(persisted).state, "blocked")
}

pipeline test_healthy_unbound_release_keeps_recovery_refs(harness: Harness, task: any) {
  let healthy_unbound = release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: OTHER,
      publication: {
        version: "1.2.3",
        local_branch: "release/v1.2.3",
        remote_ref: "release-attempt/v1.2.3/${SECOND}",
        head_oid: SECOND,
      },
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
  healthy_unbound = release_watch_transition(
    healthy_unbound,
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:01:00Z"},
  ).receipt
  let probed = false
  const result = run_release_ref_cleanup(
    harness,
    healthy_unbound,
    watch_path({fs: harness.fs, random: harness.random}),
    "/tmp/harn",
    {
      now: fn() { return "2026-07-13T00:04:00Z" },
      remote_refs: fn(_repo, _patterns) {
        probed = true
        return []
      },
      version_at_ref: fn(_slug, _ref) { return nil },
      delete_ref: fn(_repo, _ref, _expected_oid) { return {success: true, message: ""} },
    },
  )
  assert_eq(result.state, "blocked")
  assert(contains(result.message, "bound to an exact published release commit"))
  assert_eq(probed, false)
}
