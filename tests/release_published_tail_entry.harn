import { run_published_tail_cleanup } from "../lib/release_published_tail_entry"

fn called_tail_failure() -> string {
  throw "simulated published-tail hydration failure"
}

fn called_cleanup_failure() -> nil {
  throw "simulated lease cleanup failure"
}

pipeline test_called_failure_cleans_up_then_preserves_the_original_error(harness: Harness) {
  const remote_cleanups = harness.runtime.atomic(0)
  const local_cleanups = harness.runtime.atomic(0)
  const error = try {
    run_published_tail_cleanup(
      fn() { return run_published_tail_cleanup(
        fn() { return called_tail_failure() },
        fn() {
          harness.runtime.atomic_add(remote_cleanups, 1)
          return nil
        },
      ) },
      fn() {
        harness.runtime.atomic_add(local_cleanups, 1)
        return nil
      },
    )
    ""
  } catch (actual) {
    to_string(actual)
  }
  assert_eq(harness.runtime.atomic_get(remote_cleanups), 1)
  assert_eq(harness.runtime.atomic_get(local_cleanups), 1)
  assert_eq(error, "simulated published-tail hydration failure")
}

pipeline test_success_cleans_up_once_and_returns_the_body_value(harness: Harness) {
  const remote_cleanups = harness.runtime.atomic(0)
  const local_cleanups = harness.runtime.atomic(0)
  const result = run_published_tail_cleanup(
    fn() { return run_published_tail_cleanup(
      fn() { return "published" },
      fn() {
        harness.runtime.atomic_add(remote_cleanups, 1)
        return nil
      },
    ) },
    fn() {
      harness.runtime.atomic_add(local_cleanups, 1)
      return nil
    },
  )
  assert_eq(result, "published")
  assert_eq(harness.runtime.atomic_get(remote_cleanups), 1)
  assert_eq(harness.runtime.atomic_get(local_cleanups), 1)
}

pipeline test_success_surfaces_a_called_cleanup_failure() {
  const error = try {
    run_published_tail_cleanup(
      fn() { return "published" },
      fn() { return called_cleanup_failure() },
    )
    ""
  } catch (actual) {
    to_string(actual)
  }
  assert_eq(error, "simulated lease cleanup failure")
}

pipeline test_body_failure_wins_over_cleanup_failure_and_outer_cleanup_still_runs(
  harness: Harness,
) {
  const remote_cleanups = harness.runtime.atomic(0)
  const local_cleanups = harness.runtime.atomic(0)
  const error = try {
    run_published_tail_cleanup(
      fn() { return run_published_tail_cleanup(
        fn() { return called_tail_failure() },
        fn() {
          harness.runtime.atomic_add(remote_cleanups, 1)
          return called_cleanup_failure()
        },
      ) },
      fn() {
        harness.runtime.atomic_add(local_cleanups, 1)
        return nil
      },
    )
    ""
  } catch (actual) {
    to_string(actual)
  }
  assert_eq(error, "simulated published-tail hydration failure")
  assert_eq(harness.runtime.atomic_get(remote_cleanups), 1)
  assert_eq(harness.runtime.atomic_get(local_cleanups), 1)
}
