import { ReleaseBodyResult, ReleasePublishedBodySource } from "../lib/release_body_contracts"
import {
  ReleasePostMergeDriftEvidence,
  execute_release_body_integrity_plan,
  post_merge_drift_decision,
  release_body_corrected,
  release_body_integrity_plan,
  release_body_without_correction,
} from "../lib/release_notes"

const REF_OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const TARGET_OID = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const PIN_OID = "cccccccccccccccccccccccccccccccccccccccc"

fn source(body: string = "Exact pin-time notes.\n") -> ReleasePublishedBodySource {
  return {
    tag: "v1.2.3",
    version: "1.2.3",
    original_pin: PIN_OID,
    body: body,
    tag_ref_oid: REF_OID,
    tag_target_oid: TARGET_OID,
  }
}

fn lookup(body: string, lease_overrides: dict? = nil) -> ReleaseBodyResult {
  return {
    found: true,
    release: {id: 701, tag_name: "v1.2.3", body: body, assets: []},
    lease: {release_id: 701, tag_ref_oid: REF_OID, tag_target_oid: TARGET_OID}
      + (lease_overrides ?? {}),
  }
}

pipeline test_release_body_clean_preserves_exact_pin_bytes(_task) {
  const exact = "  Exact leading spaces and final newline.\n"
  const plan = release_body_integrity_plan(source(exact), lookup(exact))
  assert_eq(plan.status, "clean")
  assert_eq(plan.expected_body, exact)
  assert_eq(plan.observed_body, exact)
  assert_eq(plan.before_sha256, sha256(exact))
  assert_eq(plan.after_sha256, plan.before_sha256)
}

pipeline test_release_body_only_drift_audits_then_repairs_in_process(_task) {
  const expected = source()
  const plan = release_body_integrity_plan(expected, lookup("Notes from a later commit.\n"))
  assert_eq(plan.status, "drifted")
  let calls = 0
  const audit = execute_release_body_integrity_plan(
    plan,
    false,
    { _tag, _body, _lease ->
      calls = calls + 1
      return Err({code: "unexpected", message: "audit must not edit"})
    },
  )
  assert_eq(audit.status, "drifted")
  assert_eq(calls, 0)
  const repaired = execute_release_body_integrity_plan(
    plan,
    true,
    { tag, body, lease ->
      calls = calls + 1
      assert_eq(tag, expected.tag)
      assert_eq(lease.release_id, 701)
      assert_eq(body, release_body_corrected(expected))
      return {body: body}
    },
  )
  assert_eq(repaired.status, "repaired")
  assert_eq(calls, 1)
  assert_eq(repaired.after_sha256, sha256(repaired.observed_body))
}

pipeline test_release_body_already_corrected_is_idempotent(_task) {
  const expected = source()
  const corrected = release_body_corrected(expected)
  const plan = release_body_integrity_plan(expected, lookup(corrected))
  assert_eq(plan.status, "already_corrected")
  assert_eq(release_body_without_correction(corrected), expected.body)
  let calls = 0
  const receipt = execute_release_body_integrity_plan(
    plan,
    true,
    { _tag, _body, _lease ->
      calls = calls + 1
      return {body: "should not run"}
    },
  )
  assert_eq(receipt.status, "already_corrected")
  assert_eq(calls, 0)
}

pipeline test_release_body_double_correction_is_recomputed_once(_task) {
  const expected = source()
  const footer = release_body_corrected(expected)
  const doubled = footer + "\n\n" + footer
  const plan = release_body_integrity_plan(expected, lookup(doubled))
  assert_eq(plan.status, "drifted")
  assert_eq(len(split(plan.desired_body, "harn-release-body-correction:v1")), 2)
  const repaired = execute_release_body_integrity_plan(
    plan,
    true,
    { _tag, body, _lease -> return {body: body} },
  )
  assert_eq(repaired.status, "repaired")
  const second = release_body_integrity_plan(expected, lookup(repaired.observed_body))
  assert_eq(second.status, "already_corrected")
}

pipeline test_release_body_stale_lease_and_connector_failure_fail_closed(_task) {
  const expected = source()
  const stale = release_body_integrity_plan(
    expected,
    lookup(expected.body, {tag_target_oid: "dddddddddddddddddddddddddddddddddddddddd"}),
  )
  assert_eq(stale.status, "stale_lease")
  const unavailable = release_body_integrity_plan(
    expected,
    Err({code: "network", message: "provider unavailable"}),
  )
  assert_eq(unavailable.status, "connector_failure")
  const mutation_race = execute_release_body_integrity_plan(
    release_body_integrity_plan(expected, lookup("drift")),
    true,
    { _tag, _body, _lease ->
      return Err({code: "stale_tag", message: "tag changed before mutation"})
    },
  )
  assert_eq(mutation_race.status, "stale_lease")
}

pipeline test_release_body_drift_without_lease_fails_before_edit(_task) {
  const plan = release_body_integrity_plan(source(), lookup("drift")) + {lease: nil}
  let calls = 0
  const result = execute_release_body_integrity_plan(
    plan,
    true,
    { _tag, _body, _lease ->
      calls = calls + 1
      return {body: "must not run"}
    },
  )
  assert_eq(result.status, "connector_failure")
  assert_eq(result.error?.code, "invalid_response")
  assert_eq(calls, 0)
}

pipeline test_source_and_release_body_drift_remain_independent_actions(_task) {
  const expected = source()
  const body_plan = release_body_integrity_plan(expected, lookup("metadata drift"))
  const source_evidence: ReleasePostMergeDriftEvidence = {
    tag: expected.tag,
    version: expected.version,
    original_pin: expected.original_pin,
    pin_unreleased: expected.body,
    current_section: "Source changelog drift.",
    published_tag_section: expected.body,
    paperwork_branch: "paperwork/v1.2.3-changelog-fix",
  }
  assert_eq(body_plan.status, "drifted")
  assert_eq(post_merge_drift_decision(source_evidence).action, "drift")
  const repaired = execute_release_body_integrity_plan(
    body_plan,
    true,
    { _tag, body, _lease -> return {body: body} },
  )
  assert_eq(repaired.status, "repaired")
  assert_eq(post_merge_drift_decision(source_evidence).action, "drift")
}
