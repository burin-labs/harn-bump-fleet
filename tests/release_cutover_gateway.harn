import { release_chain_repair_once } from "../lib/release_chain_effect_door"
import { ReleaseCutoverState, release_cutover_gateway } from "../lib/release_cutover_gateway"

const REPO = "burin-labs/harn"

const VERSION = "0.10.134-dev"

const BRANCH = "automation/development-0.10.134-dev"

fn state(open_pr: string, opened_by: string, read_failed: string) -> ReleaseCutoverState {
  return {open_pr: open_pr, opened_by: opened_by, read_failed: read_failed}
}

/**
 * Drive one cutover repair through the real door with a given reader.
 *
 * Routed through `release_chain_repair_once` rather than calling the gateway
 * directly, because the door is what turns a read-back into an outcome, and the
 * outcome is the claim being made.
 */
fn repair_with(mode: string, reader: fn(string, string) -> ReleaseCutoverState) {
  return release_chain_repair_once(
    "chain-0198",
    4,
    "publish",
    {
      subject: VERSION,
      cause: "development_version_missing",
      retryable: true,
      detail: "seeded by the test",
    },
    1,
    REPO,
    [],
    release_cutover_gateway(mode, REPO, reader, { -> return "2026-09-08T03:00:00Z" }),
  )
}

pipeline test_a_dry_run_names_the_cutover_and_records_that_none_was_opened(task: any) {
  /**
   * The door's read-back is what separates an effect that happened from one
   * that did not. A dry run handing it an observed read would record a repair
   * nobody performed; a missing one would record an attempt nobody made. So the
   * dry run refuses, and the refusal carries what it would have opened.
   */
  let looked: list<string> = []
  const receipt = repair_with(
    "dry_run",
    fn(repository: string, branch: string) {
      looked = looked + ["${repository} ${branch}"]
      return state("", "", "")
    },
  )
  assert_eq(receipt.outcome, "escalated")
  assert(contains(receipt.reason, "dry run"))
  assert(contains(receipt.reason, BRANCH))
  assert(contains(receipt.reason, "[Release] Start 0.10.134-dev development"))
  assert(contains(receipt.reason, "nothing was opened"))
  assert_eq(receipt.effect, nil)
  // It reached the repository to decide, and reached it for the right branch.
  assert_eq(looked, ["${REPO} ${BRANCH}"])
}

pipeline test_a_cutover_already_open_is_the_effect_being_satisfied(task: any) {
  // The goal is that a cutover exists, not that this run opened it. A dry run
  // can prove that honestly, because it is a read.
  const receipt = repair_with(
    "dry_run",
    fn(_repository: string, _branch: string) { return state(
      "burin-labs/harn#8400",
      "harn-release-bot[bot]",
      "",
    ) },
  )
  assert_eq(receipt.outcome, "repaired")
  assert_eq(unwrap(receipt.effect).kind, "open_development_cutover_pr")
  assert_eq(unwrap(receipt.effect).accepted_identity, "harn-release-bot[bot]")
  assert(contains(unwrap(receipt.effect).read_back[0]?.subject ?? "", "#8400"))
}

pipeline test_an_unreadable_repository_stops_rather_than_reading_as_none_open(task: any) {
  /**
   * "I looked and found no cutover" and "I could not look" select opposite
   * actions. Collapsing them is how a repair opens a second pull request
   * beside one it could not see.
   */
  const receipt = repair_with(
    "dry_run",
    fn(_repository: string, _branch: string) { return state(
      "",
      "",
      "the pull request list could not be read",
    ) },
  )
  assert_eq(receipt.outcome, "escalated")
  assert(contains(receipt.reason, "could not be read"))
  assert_eq(contains(receipt.reason, "dry run"), false)
  assert_eq(receipt.effect, nil)
}

pipeline test_a_read_that_throws_escalates_rather_than_crashing_the_loop(task: any) {
  const receipt = repair_with(
    "dry_run",
    fn(_repository: string, _branch: string) {
      throw "the network is gone"
    },
  )
  assert_eq(receipt.outcome, "escalated")
  assert(contains(receipt.reason, "could not be performed"))
}

pipeline test_the_gateway_refuses_an_effect_it_does_not_own(task: any) {
  /**
   * A different kind arriving here is a routing defect. Performing the cutover
   * anyway would repair something nobody asked to repair, and the read would
   * never fire to notice.
   */
  let reached = false
  const gateway = release_cutover_gateway(
    "dry_run",
    REPO,
    fn(_repository: string, _branch: string) {
      reached = true
      return state("", "", "")
    },
    { -> return "2026-09-08T03:00:00Z" },
  )
  const receipt = release_chain_repair_once(
    "chain-0198",
    4,
    "publish",
    {
      subject: "burin-labs/harn-documents",
      cause: "consumer_pin_stale",
      retryable: true,
      detail: "seeded by the test",
    },
    1,
    "burin-labs/harn-documents",
    [],
    gateway,
  )
  assert_eq(receipt.outcome, "escalated")
  assert(contains(receipt.reason, "does not perform"))
  // And it stopped before touching the repository at all.
  assert_eq(reached, false)
}

pipeline test_a_planned_cutover_with_no_version_stops_before_building_a_branch(task: any) {
  // An empty version would build `automation/development-`, a branch that could
  // collide across every release. It refuses instead.
  let reached = false
  const receipt = release_chain_repair_once(
    "chain-0198",
    4,
    "publish",
    {subject: "   ", cause: "development_version_missing", retryable: true, detail: "seeded"},
    1,
    REPO,
    [],
    release_cutover_gateway(
      "dry_run",
      REPO,
      fn(_repository: string, _branch: string) {
        reached = true
        return state("", "", "")
      },
      { -> return "2026-09-08T03:00:00Z" },
    ),
  )
  assert_eq(receipt.outcome, "escalated")
  assert_eq(reached, false)
}
