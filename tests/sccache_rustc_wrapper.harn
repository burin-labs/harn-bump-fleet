import { shell_quote } from "std/runtime"
import { with_temp_dir } from "std/testing"

fn script_path(fs: HarnessFs, name: string) -> string {
  return path_normalize(path_join(fs.source_dir(), "..", "scripts", name))
}

fn make_executable(
  harness: {fs: HarnessFs, process: HarnessProcess},
  path: string,
  source: string,
) {
  harness.fs.write_text(path, source)
  const chmod = harness.process.shell("chmod +x " + shell_quote(path))
  if !chmod.success {
    throw "could not make fixture executable: " + to_string(chmod.stderr)
  }
}

pipeline test_wrapper_removes_only_checkout_specific_cargo_target_dir(
  harness: Harness,
  _task: any,
) {
  with_temp_dir(
    harness.fs,
    { root ->
      const log_path = path_join(root, "wrapper-log")
      const fake_sccache = path_join(root, "sccache")
      make_executable(
        {fs: harness.fs, process: harness.process},
        fake_sccache,
        "#!/bin/sh\n"
          + "if [ -n \"$CARGO_TARGET_DIR\" ]; then exit 41; fi\n"
          + "printf 'CARGO_BUILD_JOBS=%s\\n' \"$CARGO_BUILD_JOBS\" > \"$WRAPPER_LOG\"\n"
          + "printf '%s\\n' \"$@\" >> \"$WRAPPER_LOG\"\n",
      )
      const result = harness.process.shell(
        "CARGO_TARGET_DIR="
          + shell_quote(path_join(root, "target-a"))
          + " CARGO_BUILD_JOBS=6 WRAPPER_LOG="
          + shell_quote(log_path)
          + " SCCACHE_BIN="
          + shell_quote(fake_sccache)
          + " "
          + shell_quote(script_path(harness.fs, "sccache-rustc-wrapper.sh"))
          + " rustc --crate-name fixture",
      )
      assert_eq(result.success, true)
      assert_eq(
        to_string(harness.fs.read_text(log_path)),
        "CARGO_BUILD_JOBS=6\nrustc\n--crate-name\nfixture\n",
      )
    },
  )
}

pipeline test_installer_creates_stable_cargo_projection(harness: Harness, _task: any) {
  with_temp_dir(
    harness.fs,
    { root ->
      const cargo_home = path_join(root, "cargo")
      const installer = script_path(harness.fs, "install_sccache_rustc_wrapper.sh")
      const command = "CARGO_HOME=" + shell_quote(cargo_home) + " " + shell_quote(installer)
      const first = harness.process.shell(command)
      assert_eq(first.success, true)
      const expected_wrapper = path_join(cargo_home, "bin", "sccache-rustc-wrapper.sh")
      assert_eq(harness.fs.exists(expected_wrapper), true)
      assert_eq(
        to_string(harness.fs.read_text(path_join(cargo_home, "config.toml"))),
        "[build]\nrustc-wrapper = \"" + expected_wrapper + "\"\n",
      )
      const second = harness.process.shell(command)
      assert_eq(second.success, true)
      assert_eq(
        to_string(harness.fs.read_text(path_join(cargo_home, "config.toml"))),
        "[build]\nrustc-wrapper = \"" + expected_wrapper + "\"\n",
      )
    },
  )
}

pipeline test_installer_preserves_build_config_and_refuses_custom_wrapper(
  harness: Harness,
  _task: any,
) {
  with_temp_dir(
    harness.fs,
    { root ->
      const cargo_home = path_join(root, "cargo")
      const config_path = path_join(cargo_home, "config.toml")
      harness.fs.mkdir(cargo_home, true)
      harness.fs.write_text(
        config_path,
        "[net]\noffline = true\n\n[build]\nincremental = false\nrustc-wrapper = \"custom-rustc-proxy\"\n",
      )
      const before = to_string(harness.fs.read_text(config_path))
      const result = harness.process.shell(
        "CARGO_HOME="
          + shell_quote(cargo_home)
          + " "
          + shell_quote(script_path(harness.fs, "install_sccache_rustc_wrapper.sh")),
      )
      assert_eq(result.success, false)
      assert_eq(to_string(harness.fs.read_text(config_path)), before)
    },
  )
}
