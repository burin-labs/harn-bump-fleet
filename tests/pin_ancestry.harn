import { distinct_pin_keys, org_commit_pins, pin_ancestry_violations } from "../lib/pin_ancestry"

const SHA_A: string = "1e1cf1d5d97bba32ca9c25e743b81b3b9be9e5b0"

const SHA_B: string = "c51529872cf153becb8588920a348e64b8334611"

const WORKFLOW: string = """
jobs:
  override:
    uses: burin-labs/.github/.github/workflows/merge-override.yml@1e1cf1d5d97bba32ca9c25e743b81b3b9be9e5b0
  build:
    steps:
      - uses: burin-labs/harn/.github/actions/setup-harn@C51529872CF153BECB8588920A348E64B8334611 # v0.10.144
      - uses: "burin-labs/harn@c51529872cf153becb8588920a348e64b8334611"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      - uses: burin-labs/harn/.github/actions/setup-harn@main
      - uses: burin-labs/harn/.github/actions/setup-harn@v0.10.144
"""

pipeline test_only_organization_commit_pins_are_collected() {
  // A third-party action and a tag or branch ref are other policies' business;
  // only an exact organization commit can be a squash-merged branch head.
  const pins = org_commit_pins("ci.yml", WORKFLOW, "burin-labs")
  assert_eq(len(pins), 3)
  assert_eq(pins[0]?.slug, "burin-labs/.github")
  assert_eq(pins[0]?.sha, SHA_A)
  assert_eq(pins[0]?.line, 3)
  assert_eq(pins[1]?.slug, "burin-labs/harn")
  assert_eq(pins[1]?.sha, SHA_B)
  assert_eq(pins[2]?.slug, "burin-labs/harn")
  assert_eq(distinct_pin_keys(pins), ["burin-labs/.github@${SHA_A}", "burin-labs/harn@${SHA_B}"])
}

pipeline test_a_pin_off_the_default_branch_is_named() {
  const pins = org_commit_pins("ci.yml", WORKFLOW, "burin-labs")
  const violations = pin_ancestry_violations(
    pins,
    {
      ["burin-labs/.github@${SHA_A}"]: {reachable: false, status: "diverged"},
      ["burin-labs/harn@${SHA_B}"]: {reachable: true, status: "tagged"},
    },
  )
  assert_eq(len(violations), 1)
  assert_eq(violations[0]?.file, "ci.yml")
  assert_eq(violations[0]?.reason, "off_default_branch")
}

pipeline test_an_unread_or_failed_lookup_is_a_violation_not_a_pass() {
  // Absence must not read as a commit on main.
  const pins = org_commit_pins("ci.yml", WORKFLOW, "burin-labs")
  const violations = pin_ancestry_violations(
    pins,
    {["burin-labs/harn@${SHA_B}"]: {error: "rate limited"}},
  )
  assert_eq(len(violations), 3)
  assert_eq(violations.map({ v -> v.reason }).to_list().to_set().to_list(), ["unverifiable"])
}
