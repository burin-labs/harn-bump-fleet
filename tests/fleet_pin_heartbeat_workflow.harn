import { decode_github_workflow, github_projection_has_trigger } from "../lib/github_workflow"

fn alarm_workflow(fs: HarnessFs) -> string {
  return fs.read_text(
    path_join(dirname(fs.cwd()), ".github", "workflows", "fleet-pin-staleness.yml"),
  )
}

fn heartbeat_workflow(fs: HarnessFs) -> string {
  return fs.read_text(
    path_join(dirname(fs.cwd()), ".github", "workflows", "fleet-pin-staleness-heartbeat.yml"),
  )
}

/**
 * The whole point of #980: the assertion that the alarm still ran cannot live
 * inside the workflow it is checking. Folding this job back into
 * fleet-pin-staleness.yml makes this fail.
 */
pipeline test_the_heartbeat_is_a_separate_scheduled_workflow(harness: Harness, task: any) {
  const heartbeat = decode_github_workflow(heartbeat_workflow(harness.fs))
  const alarm = alarm_workflow(harness.fs)
  assert_eq(github_projection_has_trigger(heartbeat, "schedule"), true)
  assert_eq(github_projection_has_trigger(heartbeat, "workflow_dispatch"), true)
  assert(contains(heartbeat_workflow(harness.fs), "check_fleet_pin_staleness_heartbeat.harn"))
  assert_eq(contains(heartbeat_workflow(harness.fs), "check_fleet_pin_staleness.harn --"), false)
  assert_eq(contains(alarm, "check_fleet_pin_staleness_heartbeat.harn"), false)
  assert_eq(contains(alarm, "fleet-pin-staleness-heartbeat.yml"), false)
}

pipeline test_the_heartbeat_does_not_depend_on_the_fleet_app_token(harness: Harness, task: any) {
  const source = heartbeat_workflow(harness.fs)
  assert_eq(contains(source, "create-github-app-token"), false)
  assert_eq(contains(source, "RELEASE_APP_"), false)
  assert(contains(source, "github.token"))
  assert(contains(source, "actions: read"))
  assert(contains(source, "issues: write"))
}

pipeline test_the_heartbeat_concurrency_group_is_not_the_alarm(harness: Harness, task: any) {
  const heartbeat = heartbeat_workflow(harness.fs)
  const alarm = alarm_workflow(harness.fs)
  assert(contains(heartbeat, "group: check-fleet-pin-staleness-heartbeat"))
  assert(contains(alarm, "group: check-fleet-pin-staleness"))
  assert_eq(contains(alarm, "check-fleet-pin-staleness-heartbeat"), false)
}

pipeline test_the_alarm_can_observe_a_stale_development_pull_request(harness: Harness, task: any) {
  const source = alarm_workflow(harness.fs)
  assert(contains(source, "permission-pull-requests: read"))
  assert(contains(source, "check_fleet_pin_staleness.harn"))
  const check = harness.fs.read_text(
    path_join(dirname(harness.fs.cwd()), "check_fleet_pin_staleness.harn"),
  )
  assert(contains(check, "development_cutover_verdict"))
  assert(contains(check, "STALE development cutover:"))
}
