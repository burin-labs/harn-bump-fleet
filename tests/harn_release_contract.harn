import {
  HarnReleaseContract,
  contract_last_published_release_version,
  contract_next_development_version,
  contract_next_release_version,
  contract_workspace_proves_release_fold,
  harn_release_contract_from_text,
  harn_release_contract_parse,
} from "../lib/harn_release_contract"
import { release_contract_fixture } from "./release_contract_fixture"

pipeline test_release_contract_parser_fails_closed(task: unknown) {
  assert_eq(harn_release_contract_from_text("not json"), nil)
  assert_eq(harn_release_contract_parse({schema_version: "harn.release_contract.v1"}), nil)
  const value = json_parse(json_stringify(release_contract_fixture()))
  assert_eq(harn_release_contract_parse(value + {retired_owner: true}), nil)
  const unknown_anchor = json_parse(
    json_stringify(release_contract_fixture()).replace(
      "merged_main_commit",
      "uncertified_worktree_commit",
    ),
  )
  assert_eq(harn_release_contract_parse(unknown_anchor), nil)
}

pipeline test_release_contract_accepts_the_certified_candidate_tag_anchor(task: unknown) {
  const current = release_contract_fixture()
  const parsed = harn_release_contract_parse(
    json_parse(json_stringify(current))
      + {tag: current.tag + {anchor: "certified_candidate_commit"}},
  )
  assert(parsed != nil)
  assert_eq(unwrap(parsed).tag.anchor, "certified_candidate_commit")
}

pipeline test_release_semantics_follow_the_descriptor_not_dev(task: unknown) {
  const contract = release_contract_fixture()
  const preview: HarnReleaseContract = contract
    + {
      versions: contract.versions
        + {development_prerelease: "preview"},
    }
  assert_eq(contract_next_development_version(preview, "1.2.3"), "1.2.4-preview")
  assert(contract_workspace_proves_release_fold(preview, "1.2.4-preview", "1.2.3"))
  assert(!contract_workspace_proves_release_fold(preview, "1.2.4-dev", "1.2.3"))
  assert_eq(contract_next_release_version(preview, "1.2.4-preview", "v1.2.3"), "1.2.4")
  assert_eq(contract_last_published_release_version(preview, "1.2.4-preview", "v1.2.3"), "1.2.3")
}

pipeline test_release_contract_carries_cross_repo_workflow_names(task: unknown) {
  const contract = release_contract_fixture()
  assert_eq(contract.workflows.binaries.path, ".github/workflows/build-release-binaries.yml")
  assert(contract.workflows.binaries.dispatch_inputs.contains("candidate_source_sha"))
  assert(contract.workflows.binaries.jobs.contains("build"))
  assert(contract.workflows.binaries.observed_steps.contains("Check the distribution fuse"))
}
