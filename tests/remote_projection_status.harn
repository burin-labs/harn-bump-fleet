import { projection_status_line } from "../lib/remote_projection"

const SLUG = "octo-org/octo-repo"

const PATH = "PROJECTION.yml"

pipeline test_a_clean_status_line_is_one_human_sentence(task: any) {
  assert_eq(
    projection_status_line({slug: SLUG, status: "clean", drifted: []}),
    "clean octo-org/octo-repo: ",
  )
}

pipeline test_an_error_status_line_names_the_failure(task: any) {
  assert_eq(
    projection_status_line({slug: SLUG, status: "error", drifted: [], error: "contents 404"}),
    "error octo-org/octo-repo: contents 404",
  )
}

pipeline test_a_refused_arming_is_named_on_the_status_line(task: any) {
  assert_eq(
    projection_status_line(
      {
        slug: SLUG,
        status: "pending",
        drifted: [PATH],
        auto_merge: {state: "refused", error: "auto-merge disabled"},
      },
    ),
    "pending octo-org/octo-repo: PROJECTION.yml [Smart Ship refused: auto-merge disabled]",
  )
}

pipeline test_an_overdue_proposal_is_named_on_the_status_line(task: any) {
  assert_eq(
    projection_status_line(
      {slug: SLUG, status: "pending", drifted: [PATH], age_days: 8, overdue: true},
    ),
    "pending octo-org/octo-repo: PROJECTION.yml [overdue: 8d]",
  )
}

pipeline test_a_sweep_is_named_on_the_status_line(task: any) {
  assert_eq(
    projection_status_line(
      {
        slug: SLUG,
        status: "applied",
        drifted: [PATH],
        sweep: {
          superseded: [
            {
              pull_request: 59,
              branch: "automation/fleet-projections-old",
              url: "https://github.test/octo-org/octo-repo/pull/59",
              state: "closed",
            },
          ],
        },
      },
    ),
    "applied octo-org/octo-repo: PROJECTION.yml [superseded: #59 closed]",
  )
}
