import { next, parse_release, version_from_tag } from "std/semver"
import { HarnReleaseContract } from "../lib/harn_release_contract"
import {
  development_cutover_verdict,
  development_release_target,
  development_version_for,
  last_published_release_version,
  next_development_version,
  next_release_version,
  release_body_gate_version,
  workspace_proves_release_fold,
} from "../lib/release_analysis"
import {
  prior_release_fold_decision,
  prior_release_fold_recovery_allowed,
} from "../lib/release_preflight"
import { release_contract_fixture } from "../testdata/release_contract_fixture"

/**
 * The development-version contract, asserted at every gate entry point.
 *
 * A single upstream change to the target repo's version scheme broke three
 * fleet gates in one day, each discovered by burning a live release cut,
 * because each gate re-derived the convention instead of asking one owner.
 * This file feeds the post-cutover pair — workspace `0.10.115-dev` against
 * published tag `v0.10.114` — through every gate that reads a workspace
 * version, so a fourth gate cannot regress silently.
 *
 * Falsifier: restore any gate's own copy of the `-dev` rule (for example, make
 * `prior_release_fold_decision` accept only `workspace_version == latest`) and
 * the matching pipeline below must fail.
 */
const WORKSPACE = "0.10.115-dev"

const LATEST_TAG = "v0.10.114"

const PUBLISHED = "0.10.114"

const TARGET = "0.10.115"

fn fold_evidence(
  workspace_version: string,
  latest_tag: string,
) -> {
  contract: HarnReleaseContract,
  base_ref: string,
  latest_tag: string,
  workspace_version: string,
  changelog_version: string,
  recovery_ref: string,
  recovery_pr_number: int?,
  recovery_pr_url: string,
} {
  return {
    contract: release_contract_fixture(),
    base_ref: "origin/main",
    latest_tag: latest_tag,
    workspace_version: workspace_version,
    changelog_version: version_from_tag(latest_tag),
    recovery_ref: "",
    recovery_pr_number: nil,
    recovery_pr_url: "",
  }
}

pipeline test_the_development_form_has_one_producer() {
  assert_eq(development_version_for(TARGET), WORKSPACE)
  assert_eq(next_development_version(PUBLISHED), WORKSPACE)
  assert_eq(development_release_target(WORKSPACE), TARGET)
  assert_eq(development_release_target(PUBLISHED), nil)
}

pipeline test_stable_main_surfaces_the_matching_development_pull_request() {
  const blocked = development_cutover_verdict(
    PUBLISHED,
    ["feature/unrelated", "automation/development-${WORKSPACE}"],
  )
  assert_eq(blocked.state, "blocking_pull_request")
  assert_eq(blocked.blocked, true)
  assert_eq(blocked.expected_version, WORKSPACE)
  assert_eq(blocked.pull_request_branches, ["automation/development-${WORKSPACE}"])
  assert(contains(blocked.detail, PUBLISHED))
  const missing = development_cutover_verdict(PUBLISHED, [])
  assert_eq(missing.state, "missing_cutover")
  assert_eq(missing.blocked, true)
  const ready = development_cutover_verdict(WORKSPACE, ["automation/development-${WORKSPACE}"])
  assert_eq(ready.state, "ready")
  assert_eq(ready.blocked, false)
}

pipeline test_the_release_target_resolver_strips_dev() {
  assert_eq(next_release_version(WORKSPACE, LATEST_TAG, "patch", ""), TARGET)
  // A released workspace (pre-cutover shape) still resolves the same target.
  assert_eq(next_release_version(PUBLISHED, LATEST_TAG, "patch", ""), TARGET)
}

pipeline test_the_published_resolver_looks_through_dev() {
  assert_eq(last_published_release_version(WORKSPACE, LATEST_TAG), PUBLISHED)
  assert_eq(last_published_release_version(PUBLISHED, LATEST_TAG), PUBLISHED)
  // With no tag to resolve against there is nothing to look through.
  assert_eq(last_published_release_version(WORKSPACE, ""), WORKSPACE)
}

pipeline test_the_body_integrity_gate_verifies_the_published_release() {
  // This is the gate that burned hosted release run 32742355169: it looked up
  // a GitHub release named `v0.10.115-dev`, which never exists.
  assert_eq(release_body_gate_version(WORKSPACE, TARGET, LATEST_TAG, false), PUBLISHED)
  assert_eq(release_body_gate_version(PUBLISHED, TARGET, LATEST_TAG, false), PUBLISHED)
  // A fixup pass over an already-published release verifies that release.
  assert_eq(release_body_gate_version(WORKSPACE, TARGET, LATEST_TAG, true), TARGET)
}

pipeline test_the_fold_predicate_accepts_both_proving_shapes() {
  assert_eq(workspace_proves_release_fold(WORKSPACE, PUBLISHED), true)
  assert_eq(workspace_proves_release_fold(PUBLISHED, PUBLISHED), true)
  // The previous cycle's development form does NOT prove this fold.
  assert_eq(workspace_proves_release_fold(development_version_for(PUBLISHED), PUBLISHED), false)
}

pipeline test_the_fold_gate_proceeds_on_a_development_workspace() {
  // This is the gate that burned hosted release run 32739738413.
  const decision = prior_release_fold_decision(fold_evidence(WORKSPACE, LATEST_TAG))
  assert_eq(decision.proceed, true)
}

pipeline test_the_fold_gate_still_refuses_an_unfolded_base() {
  // The previous cycle's development form means the fold never landed.
  const stale = prior_release_fold_decision(
    fold_evidence(development_version_for(PUBLISHED), LATEST_TAG),
  )
  assert_eq(stale.proceed, false)
  assert_eq(contains(stale.detail, "expected ${PUBLISHED} or ${WORKSPACE}"), true)
}

pipeline test_fold_recovery_depends_on_prerelease_stripping() {
  // `prior_release_fold_recovery_allowed` reads the raw workspace version on
  // purpose and stays correct only because `next` strips a prerelease instead
  // of bumping past it. Pin both halves: the semver behavior it relies on, and
  // the recovery verdict that behavior produces.
  assert_eq(next("0.10.114-dev", "patch", ""), "0.10.114")
  assert_eq(next("0.10.115-dev", "patch", ""), "0.10.115")
  assert_eq(parse_release(WORKSPACE) == nil, false)
  const unfolded = fold_evidence(development_version_for(PUBLISHED), LATEST_TAG)
    + {recovery_ref: "release-fold/${LATEST_TAG}"}
  assert_eq(prior_release_fold_recovery_allowed(unfolded, "patch", "ship-pr", ""), true)
}
