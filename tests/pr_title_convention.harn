// Tests for the one owner of the titles this repository puts on pull requests.
// harn#7932 was opened as "Start 0.10.129-dev development", failed harn's
// required title gate, and had to be retitled by hand; these cases hold the
// shape that failure taught us.
import {
  HARN_PR_AREAS,
  PR_TITLE_SITES,
  pr_title_area,
  pr_title_changelog_paperwork,
  pr_title_file_opens_pull_request,
  pr_title_for_consumer,
  pr_title_is_conventional,
  pr_title_size_baseline,
  pr_title_unregistered_paths,
  pr_title_violations,
} from "../lib/pr_title_convention"

pipeline test_the_title_that_failed_the_gate_is_still_refused(task: any) {
  assert_eq(pr_title_is_conventional("Start 0.10.129-dev development", HARN_PR_AREAS), false)
  assert_eq(
    pr_title_is_conventional("[Release] Start 0.10.129-dev development", HARN_PR_AREAS),
    true,
  )
}

pipeline test_an_area_outside_harns_list_is_refused(task: any) {
  assert_eq(pr_title_is_conventional("[Build] Bump the runtime", HARN_PR_AREAS), false)
  assert_eq(pr_title_is_conventional("[Release] Bump the runtime", HARN_PR_AREAS), true)
}

pipeline test_a_bracket_with_no_sentence_after_it_is_refused(task: any) {
  assert_eq(pr_title_is_conventional("[Release]", HARN_PR_AREAS), false)
  assert_eq(pr_title_is_conventional("[Release]   ", HARN_PR_AREAS), false)
  assert_eq(pr_title_is_conventional("[] Something", HARN_PR_AREAS), false)
}

pipeline test_the_release_pull_request_keeps_its_verbatim_subject(task: any) {
  // publish-release.yml matches this subject before it tags. Bracketing it
  // would pass the title gate and break publication.
  assert_eq(pr_title_is_conventional("Release v0.10.129", HARN_PR_AREAS), true)
  assert_eq(pr_title_area("Release v0.10.129"), "")
}

pipeline test_the_rendered_titles_satisfy_the_gate(task: any) {
  assert_eq(pr_title_is_conventional(pr_title_size_baseline("0.10.129"), HARN_PR_AREAS), true)
  assert_eq(pr_title_is_conventional(pr_title_size_baseline(""), HARN_PR_AREAS), true)
  assert_eq(
    pr_title_is_conventional(pr_title_changelog_paperwork("v0.10.128"), HARN_PR_AREAS),
    true,
  )
  assert_eq(pr_title_is_conventional(pr_title_changelog_paperwork(""), HARN_PR_AREAS), true)
}

pipeline test_every_registered_title_passes_its_targets_gate(task: any) {
  assert_eq(pr_title_violations(PR_TITLE_SITES), [])
}

pipeline test_a_bare_harn_bound_title_is_reported(task: any) {
  const found = pr_title_violations(
    [
      {
        path: "somewhere.harn",
        symbol: "opener",
        target: "harn",
        sample: "Start 0.10.129-dev development",
        exempt_reason: "",
      },
    ],
  )
  assert_eq(len(found), 1)
  assert_eq(found[0]?.path ?? "", "somewhere.harn")
}

pipeline test_an_exemption_does_not_excuse_a_harn_bound_title(task: any) {
  // Only the target's own gate decides, so a reason recorded here must not
  // silence a title harn would refuse.
  const found = pr_title_violations(
    [
      {
        path: "somewhere.harn",
        symbol: "opener",
        target: "harn",
        sample: "changelog: paperwork",
        exempt_reason: "we would rather not",
      },
    ],
  )
  assert_eq(len(found), 1)
}

pipeline test_a_consumer_bound_title_is_reported_only_without_a_reason(task: any) {
  const bare = pr_title_violations(
    [
      {
        path: "somewhere.harn",
        symbol: "opener",
        target: "consumer",
        sample: "Bump Harn runtime",
        exempt_reason: "",
      },
    ],
  )
  assert_eq(len(bare), 1)
  const recorded = pr_title_violations(
    [
      {
        path: "somewhere.harn",
        symbol: "opener",
        target: "consumer",
        sample: "Bump Harn runtime",
        exempt_reason: "the consumer declares its own area list",
      },
    ],
  )
  assert_eq(recorded, [])
}

pipeline test_a_call_site_no_one_named_is_reported(task: any) {
  const missing = pr_title_unregistered_paths(
    ["lib/release_notes.harn", "lib/brand_new_opener.harn"],
    PR_TITLE_SITES,
  )
  assert_eq(missing, ["lib/brand_new_opener.harn"])
}

pipeline test_the_shared_client_and_the_gate_itself_are_not_call_sites(task: any) {
  assert_eq(
    pr_title_unregistered_paths(
      ["lib/github.harn", "check_pr_title_convention.harn", "lib/pr_title_convention.harn"],
      PR_TITLE_SITES,
    ),
    [],
  )
}

pipeline test_an_opener_is_detected_and_a_mention_of_one_is_not(task: any) {
  assert_eq(pr_title_file_opens_pull_request("const x = github_pr_upsert(harness, {})"), true)
  assert_eq(pr_title_file_opens_pull_request("  const y = release_github_pr_create(a, b)"), true)
  assert_eq(pr_title_file_opens_pull_request("// github_pr_create( is mentioned in prose"), false)
  assert_eq(pr_title_file_opens_pull_request("const z = 1\nconst w = 2"), false)
}

pipeline test_a_consumer_title_carries_the_area_that_consumer_declares(task: any) {
  assert_eq(pr_title_for_consumer("Harn", "Bump Harn runtime"), "[Harn] Bump Harn runtime")
  assert_eq(pr_title_for_consumer("  Harn  ", " Bump Harn runtime "), "[Harn] Bump Harn runtime")
  assert_eq(pr_title_for_consumer("", "Bump Harn runtime"), "Bump Harn runtime")
  assert(pr_title_is_conventional(pr_title_for_consumer("Harn", "Bump Harn runtime"), ["Harn"]))
  assert(!pr_title_is_conventional(pr_title_for_consumer("", "Bump Harn runtime"), ["Harn"]))
}
