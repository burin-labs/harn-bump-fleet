import {
  harn_repo_version,
  run_session_view_cargo_target_dir_from_config,
  run_session_view_command_env,
  run_session_view_contract_paths_from_text,
  run_session_view_downstream_markdown,
  run_session_view_fleet_command_env,
  run_session_view_fleet_gate,
  run_session_view_gate,
  run_session_view_release_command_env,
  run_session_view_release_note_status,
  run_session_view_schema_summary,
  run_session_view_target_change_probe,
} from "../lib/run_session_view_gate"
import { fail, ok } from "../lib/shell_util"

fn fixture_repo() {
  let root = path_join(harness.fs.temp_dir(), "run-view-gate-" + uuid_v7())
  harness.fs.mkdir(path_join(root, "spec/run-view-fixtures/cases/basic/expected/runs"), true)
  harness.fs
    .write_text(path_join(root, "Cargo.toml"), "[package]\nname = \"harn\"\nversion = \"1.2.3\"\n")
  harness.fs
    .write_text(
    path_join(root, "spec/run-view-fixtures/cases/basic/expected/runs/run.run_view.json"),
    json_stringify({schema: "harn.run_view.v1", schema_version: 1}) + "\n",
  )
  harness.fs
    .write_text(
    path_join(root, "spec/run-view-fixtures/cases/basic/expected/session_view.json"),
    json_stringify({schema: "harn.session_view.v1", schema_version: 1}) + "\n",
  )
  return root
}

fn command_runner(result) {
  return { _ctx -> result }
}

fn git_runner(responses) {
  return { spec ->
    let key = join(spec.argv, " ")
    return responses[key] ?? fail(127, "missing command fixture: " + key)
  }
}

pipeline test_run_session_view_schema_summary(task) {
  let root = fixture_repo()
  let summary = run_session_view_schema_summary(harness, root)
  assert_eq(summary.expected_json_count, 2)
  assert_eq(len(summary.parse_errors), 0)
  assert_eq(summary.schemas[0].schema, "harn.run_view.v1")
  assert_eq(summary.schemas[0].schema_version, 1)
  assert_eq(summary.schemas[1].schema, "harn.session_view.v1")
  assert_eq(harn_repo_version(harness, root), "1.2.3")
}

pipeline test_run_session_view_cargo_target_dir_from_config(task) {
  let root = fixture_repo()
  harness.fs.mkdir(path_join(root, ".cargo"), true)
  harness.fs
    .write_text(path_join(root, ".cargo/config.toml"), "[build]\ntarget-dir = \"target-shared\"\n")
  assert_eq(
    run_session_view_cargo_target_dir_from_config(harness, root),
    path_join(root, "target-shared"),
  )
  let command_env = run_session_view_command_env(harness, root)
  assert_eq(command_env.CARGO_TARGET_DIR, path_join(root, "target-shared"))
  assert_eq(command_env.CARGO_BUILD_BUILD_DIR, path_join(root, "target-shared/build"))
  assert_eq(command_env.CARGO_BUILD_RUSTC_WRAPPER, "")
  assert_eq(command_env.CARGO_INCREMENTAL, "0")
  assert_eq(command_env.PATH.contains(".cargo"), true)
  assert_eq(command_env.RUSTC_WRAPPER, "")
  assert_eq(command_env.SCCACHE_DISABLE, "1")
}

pipeline test_run_session_view_gate_passes_cargo_target_env(task) {
  let root = fixture_repo()
  let key = "run_session_view_gate.test_cargo_target_env." + uuid_v7()
  let runner = { ctx ->
    store_set(key, ctx?.env?.CARGO_TARGET_DIR ?? "")
    return ok("")
  }
  let gate = run_session_view_gate(harness, root, runner, {CARGO_TARGET_DIR: "/tmp/harn-run-view-target"})
  assert_eq(gate.ok, true)
  assert_eq(gate.cargo_target_dir, "/tmp/harn-run-view-target")
  assert_eq(store_get(key), "/tmp/harn-run-view-target")
  store_set(key, nil)
}

pipeline test_run_session_view_fleet_command_env_uses_checkout_local_target(task) {
  let root = fixture_repo()
  let command_env = run_session_view_fleet_command_env(harness, root)
  assert_eq(command_env.CARGO_TARGET_DIR, path_join(root, ".target/run-session-view-gate"))
  assert_eq(command_env.CARGO_BUILD_BUILD_DIR, path_join(root, ".target/run-session-view-gate/build"))
  assert_eq(command_env.CARGO_BUILD_RUSTC_WRAPPER, "")
  assert_eq(command_env.CARGO_INCREMENTAL, "0")
  assert_eq(command_env.PATH.contains(".cargo"), true)
  assert_eq(command_env.RUSTC_WRAPPER, "")
  assert_eq(command_env.SCCACHE_DISABLE, "1")
}

pipeline test_run_session_view_release_command_env_prefers_release_target(task) {
  let root = fixture_repo()
  let command_env = run_session_view_release_command_env(harness, root, "/tmp/harn-release-target")
  assert_eq(command_env.CARGO_TARGET_DIR, "/tmp/harn-release-target")
  assert_eq(command_env.CARGO_BUILD_BUILD_DIR, "/tmp/harn-release-target/build")
  assert_eq(command_env.CARGO_BUILD_RUSTC_WRAPPER, "")
  assert_eq(command_env.CARGO_INCREMENTAL, "0")
  assert_eq(command_env.RUSTC_WRAPPER, "")
  assert_eq(command_env.SCCACHE_DISABLE, "1")
}

pipeline test_run_session_view_gate_fails_on_check_failure(task) {
  let root = fixture_repo()
  let gate = run_session_view_gate(harness, root, command_runner(fail(1, "snapshot drift")))
  assert_eq(gate.ok, false)
  assert_eq(gate.metadata_ok, true)
  assert_eq(gate.check.status, 1)
  assert_eq(contains(gate.check.stderr, "snapshot drift"), true)
}

pipeline test_run_session_view_release_note_status_accepts_changelog_fragment(task) {
  let root = fixture_repo()
  let analysis = {
    diff_names: "crates/harn-vm/src/orchestration/records/view.rs\n",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
    changelog_section: "",
    changelog_unreleased_section: "",
  }
  let missing = run_session_view_release_note_status(harness, root, analysis)
  assert_eq(missing.required, true)
  assert_eq(missing.present, false)
  harness.fs.mkdir(path_join(root, "changelog.d"), true)
  harness.fs
    .write_text(
    path_join(root, "changelog.d/150.changed.md"),
    "Document the run/session view schema compatibility plan.",
  )
  let present = run_session_view_release_note_status(harness, root, analysis)
  assert_eq(present.required, true)
  assert_eq(present.present, true)
  assert_eq(present.ok, true)
}

pipeline test_run_session_view_target_change_probe_and_markdown(task) {
  let probe = run_session_view_target_change_probe(
    "/tmp/harn",
    "v1.2.3",
    git_runner(
      {
        "git describe --tags --abbrev=0 v1.2.3^": ok("v1.2.2\n"),
        "git diff --name-only v1.2.2..v1.2.3": ok("README.md\nspec/run-view-fixtures/cases/basic/expected/session_view.json\n"),
      },
    ),
  )
  assert_eq(probe.known, true)
  assert_eq(probe.changed, true)
  assert_eq(probe.paths, ["spec/run-view-fixtures/"])
  let body = run_session_view_downstream_markdown(
    "v1.2.3",
    {
      check: {success: true},
      summary_line: "harn.run_view.v1@1, harn.session_view.v1@1",
      target_change: probe,
    },
  )
  assert_eq(contains(body, "Harn run/session view compatibility"), true)
  assert_eq(contains(body, "View-schema or fixture change in this bump: yes"), true)
  let unknown_body = run_session_view_downstream_markdown(
    "1.2.3",
    {check: {success: true}, target_change: {known: false}},
  )
  assert_eq(contains(unknown_body, "Target Harn version: `1.2.3`"), true)
  assert_eq(contains(unknown_body, "Tested schemas: unknown."), true)
  assert_eq(contains(unknown_body, "View-schema or fixture change in this bump: unknown"), true)
}

pipeline test_run_session_view_fleet_gate_rejects_version_mismatch(task) {
  let root = fixture_repo()
  let gate = run_session_view_fleet_gate(harness, root, "v1.2.4", command_runner(ok("")))
  assert_eq(gate.ok, false)
  assert_eq(gate.repo_version, "1.2.3")
  assert_eq(contains(gate.check.stderr, "fleet target is 1.2.4"), true)
}

pipeline test_run_session_view_contract_path_detection(task) {
  assert_eq(
    run_session_view_contract_paths_from_text(
      "M\tcrates/harn-vm/tests/run_view_fixtures.rs\nM\tcrates/harn-vm/src/orchestration/records/view.rs\n",
    ),
    ["crates/harn-vm/src/orchestration/records/view.rs", "crates/harn-vm/tests/run_view_fixtures.rs"],
  )
}
