  assert_eq(command_env.CARGO_TARGET_DIR, "/tmp/harn-release-target")
  assert_eq(command_env.CARGO_BUILD_BUILD_DIR, "/tmp/harn-release-target/build")
  assert_eq(command_env.CARGO_BUILD_RUSTC_WRAPPER, "")
  assert_eq(command_env.CARGO_INCREMENTAL, "0")
  assert_eq(command_env.HARN_BIN, "")
  assert_eq(command_env.HARN_BIN_NO_BUILD, "")
  assert_eq(command_env.RUSTC_WRAPPER, "")
  assert_eq(command_env.SCCACHE_DISABLE, "1")
}

pipeline test_run_session_view_gate_fails_on_check_failure(harness: Harness, task: any) {
  const root = fixture_repo({fs: harness.fs, random: harness.random})
  const gate = run_session_view_gate(
    harness,
    root,
    command_runner(command_result_fail(1, "snapshot drift")),
  )
  assert_eq(gate.ok, false)
  assert_eq(gate.metadata_ok, true)
  assert_eq(gate.check.status, "failed")
  assert_eq(gate.check.exit_code, 1)
  assert_eq(contains(gate.check.stderr, "snapshot drift"), true)
}

pipeline test_run_session_view_release_note_status_accepts_changelog_fragment(
  harness: Harness,
  task: any,
) {
  const root = fixture_repo({fs: harness.fs, random: harness.random})
  const analysis = {
    diff_names: "crates/harn-vm/src/orchestration/records/view.rs\n",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
    changelog_section: "",
    changelog_unreleased_section: "",
  }
  const missing = run_session_view_release_note_status(harness.fs, root, analysis)
  assert_eq(missing.required, true)
  assert_eq(missing.present, false)
  harness.fs.mkdir(path_join(root, "changelog.d"), true)
  harness.fs.write_text(
    path_join(root, "changelog.d/150.changed.md"),
    "Document the run/session view schema compatibility plan.",
  )
  const present = run_session_view_release_note_status(harness.fs, root, analysis)
  assert_eq(present.required, true)
  assert_eq(present.present, true)
  assert_eq(present.ok, true)
}

pipeline test_run_session_view_target_change_probe_and_markdown(harness: Harness, task: any) {
  const probe = run_session_view_target_change_probe(
    harness.tools,
    "/tmp/harn",
    "v1.2.3",
    git_runner(
      {
        "git describe --tags --abbrev=0 v1.2.3^": command_result_ok("v1.2.2\n"),
        "git diff --name-only v1.2.2..v1.2.3": command_result_ok(
          "README.md\nspec/run-view-fixtures/cases/basic/expected/session_view.json\n",
        ),
      },
    ),
  )
  assert_eq(probe.known, true)
  assert_eq(probe.changed, true)
  assert_eq(probe.paths, ["spec/run-view-fixtures/"])
  const body = run_session_view_downstream_markdown(
    "v1.2.3",
    {
      check: {success: true},
      summary_line: "harn.run_view.v1@1, harn.session_view.v1@1",
      target_change: probe,
    },
  )
  assert_eq(contains(body, "Harn run/session view compatibility"), true)
  assert_eq(contains(body, "View-schema or fixture change in this bump: yes"), true)
  const unknown_body = run_session_view_downstream_markdown(
    "1.2.3",
    {check: {success: true}, target_change: {known: false}},
  )
  assert_eq(contains(unknown_body, "Target Harn version: `1.2.3`"), true)
  assert_eq(contains(unknown_body, "Tested schemas: unknown."), true)
  assert_eq(contains(unknown_body, "View-schema or fixture change in this bump: unknown"), true)
}

pipeline test_run_session_view_fleet_gate_rejects_version_mismatch(harness: Harness, task: any) {
  const root = fixture_repo({fs: harness.fs, random: harness.random})
  const gate = run_session_view_fleet_gate(
    harness,
    root,
    "v1.2.4",
    command_runner(command_result_ok("")),
  )
  assert_eq(gate.ok, false)
  assert_eq(gate.repo_version, "1.2.3")
  assert_eq(contains(gate.check.stderr, "fleet target is 1.2.4"), true)
}

pipeline test_run_session_view_contract_path_detection(task: any) {
  assert_eq(
    run_session_view_contract_paths_from_text(
      "M\tcrates/harn-vm/tests/run_view_fixtures.rs\nM\tcrates/harn-vm/src/orchestration/records/view.rs\n",
    ),
    [
      "crates/harn-vm/src/orchestration/records/view.rs",
      "crates/harn-vm/tests/run_view_fixtures.rs",
    ],
  )
}
