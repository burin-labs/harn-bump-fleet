import { command_result_fail, command_result_ok } from "std/command"
import {
  harn_repo_version,
  run_session_view_cargo_target_dir_from_config,
  run_session_view_command_env,
  run_session_view_contract_paths_from_text,
  run_session_view_downstream_markdown,
  run_session_view_fleet_command_env,
  run_session_view_fleet_gate,
  run_session_view_gate,
  run_session_view_release_command_env,
  run_session_view_release_note_status,
  run_session_view_schema_summary,
  run_session_view_schema_summary_from_snapshots,
  run_session_view_target_change_probe,
} from "../lib/run_session_view_gate"

fn fixture_repo(harness: {fs: HarnessFs, random: HarnessRandom}) {
  const root = path_join(harness.fs.temp_dir(), "run-view-gate-" + harness.random.uuid_v7())
  harness.fs.mkdir(path_join(root, "spec/run-view-fixtures/cases/basic/expected/runs"), true)
  harness.fs.write_text(
    path_join(root, "Cargo.toml"),
    "[package]\nname = \"harn\"\nversion = \"1.2.3\"\n",
  )
  harness.fs.write_text(
    path_join(root, "spec/run-view-fixtures/cases/basic/expected/runs/run.run_view.json"),
    json_stringify({schema: "harn.run_view.v1", schema_version: 1}) + "\n",
  )
  harness.fs.write_text(
    path_join(root, "spec/run-view-fixtures/cases/basic/expected/session_view.json"),
    json_stringify({schema: "harn.session_view.v1", schema_version: 1}) + "\n",
  )
  return root
}

fn command_runner(result: any) {
  return { _ctx -> result }
}

fn git_runner(responses: dict) {
  return { spec ->
    const key = join(spec.argv, " ")
    return responses[key] ?? command_result_fail(127, "missing command fixture: " + key)
  }
}

pipeline test_run_session_view_schema_summary(harness: Harness, task: any) {
  const root = fixture_repo({fs: harness.fs, random: harness.random})
  const summary = run_session_view_schema_summary(harness, root)
  assert_eq(summary.expected_json_count, 2)
  assert_eq(len(summary.parse_errors), 0)
  assert_eq(summary.schemas[0]?.schema, "harn.run_view.v1")
  assert_eq(summary.schemas[0]?.schema_version, 1)
  assert_eq(summary.schemas[1]?.schema, "harn.session_view.v1")
  assert_eq(harn_repo_version(harness.fs, root), "1.2.3")
}

pipeline test_run_session_view_schema_summary_reports_invalid_json(task: any) {
  const summary = run_session_view_schema_summary_from_snapshots(
    [{path: "bad.json", text: "{not json"}],
  )
  assert_eq(summary.expected_json_count, 1)
  assert_eq(summary.parse_errors, [{path: "bad.json", error: "invalid JSON"}])
  assert_eq(summary.schemas, [])
}

pipeline test_run_session_view_schema_summary_rejects_malformed_metadata(task: any) {
  const summary = run_session_view_schema_summary_from_snapshots(
    [
      {
        path: "wrong-version.json",
        text: json_stringify({schema: "harn.run_view.v1", schema_version: "1"}),
      },
    ],
  )
  assert_eq(summary.parse_errors, [{path: "wrong-version.json", error: "invalid schema metadata"}])
  assert_eq(summary.schemas, [])
}

pipeline test_run_session_view_cargo_target_dir_from_config(harness: Harness, task: any) {
  const root = fixture_repo({fs: harness.fs, random: harness.random})
  harness.fs.mkdir(path_join(root, ".cargo"), true)
  harness.fs.write_text(
    path_join(root, ".cargo/config.toml"),
    "[build]\ntarget-dir = \"target-shared\"\n",
  )
  assert_eq(
    run_session_view_cargo_target_dir_from_config(harness.fs, root),
    path_join(root, "target-shared"),
  )
  const command_env = run_session_view_command_env(harness, root)
  assert_eq(command_env.CARGO_TARGET_DIR, path_join(root, "target-shared"))
  assert_eq(command_env.CARGO_BUILD_BUILD_DIR, path_join(root, "target-shared/build"))
  assert_eq(command_env.CARGO_BUILD_RUSTC_WRAPPER, "")
  assert_eq(command_env.CARGO_INCREMENTAL, "0")
  assert_eq(command_env.HARN_BIN, "")
  assert_eq(command_env.HARN_BIN_NO_BUILD, "")
  assert_eq(command_env.PATH.contains(".cargo"), true)
  assert_eq(command_env.RUSTC_WRAPPER, "")
  assert_eq(command_env.SCCACHE_DISABLE, "1")
}

pipeline test_run_session_view_gate_passes_cargo_target_env(harness: Harness, task: any) {
  const root = fixture_repo({fs: harness.fs, random: harness.random})
  const key = "run_session_view_gate.test_cargo_target_env." + harness.random.uuid_v7()
  const runner = { ctx ->
    harness.runtime.store_set(key, ctx?.env?.CARGO_TARGET_DIR ?? "")
    return command_result_ok("")
  }
  const gate = run_session_view_gate(
    harness,
    root,
    runner,
    {CARGO_TARGET_DIR: "/tmp/harn-run-view-target"},
  )
  assert_eq(gate.ok, true)
  assert_eq(gate.cargo_target_dir, "/tmp/harn-run-view-target")
  assert_eq(harness.runtime.store_get(key), "/tmp/harn-run-view-target")
  harness.runtime.store_set(key, nil)
}

pipeline test_run_session_view_fleet_command_env_uses_checkout_local_target(
  harness: Harness,
  task: any,
) {
  const root = fixture_repo({fs: harness.fs, random: harness.random})
  const command_env = run_session_view_fleet_command_env(
    {env: harness.env, system: harness.system},
    root,
  )
  assert_eq(command_env.CARGO_TARGET_DIR, path_join(root, ".target/run-session-view-gate"))
  assert_eq(
    command_env.CARGO_BUILD_BUILD_DIR,
    path_join(root, ".target/run-session-view-gate/build"),
  )
  assert_eq(command_env.CARGO_BUILD_RUSTC_WRAPPER, "")
  assert_eq(command_env.CARGO_INCREMENTAL, "0")
  assert_eq(command_env.PATH.contains(".cargo"), true)
  assert_eq(command_env.RUSTC_WRAPPER, "")
  assert_eq(command_env.SCCACHE_DISABLE, "1")
}

pipeline test_run_session_view_release_command_env_prefers_release_target(
  harness: Harness,
