import { workflow_run_repair } from "std/workflow/repair"
import {
  fleet_repair_agent_attempt,
  fleet_repair_attempt_summary,
} from "../lib/fleet_repair_attempt"

fn agent(status: string, calls: int?) -> dict {
  return {
    result: {status: status, provider_call_count: calls, cost_usd: 0.0, known_cost_usd: 0.0},
    route: {tier: "strong", reason: "same_failure_after_value_attempt"},
    planner: {provider: "openrouter", model: "fixture"},
  }
}

pipeline test_provider_outage_stops_the_real_repair_workflow_without_validation(harness: Harness) {
  let executions = 0
  let validations = 0
  const out = workflow_run_repair(
    harness,
    {
      task: "repair fixture",
      max_attempts: 3,
      executor: { _ctx ->
        executions = executions + 1
        return fleet_repair_agent_attempt(
          agent("provider_error", 0),
          { ->
            validations = validations + 1
            return {ok: false, output: "should not validate an unexecuted repair"}
          },
        )
      },
    },
  )
  assert_eq(executions, 1)
  assert_eq(validations, 0)
  assert_eq(out.verification.agent_status, "provider_error")
  assert(!out.verification.ok)
  const summary = fleet_repair_attempt_summary(out.attempts)
  assert_eq(len(summary.attempts), 0)
  assert_eq(len(summary.provider_failures), 1)
  assert_eq(summary.cost_status, "exact")
  assert_eq(summary.known_cost_usd, 0.0)
}

pipeline test_source_failures_still_consume_attempts_and_thread_validation_feedback(
  harness: Harness,
) {
  let executions = 0
  const out = workflow_run_repair(
    harness,
    {
      task: "repair fixture",
      max_attempts: 3,
      executor: { ctx ->
        executions = executions + 1
        if executions > 1 {
          assert_eq(ctx.prior_findings, ["source defect"])
        }
        return fleet_repair_agent_attempt(
          agent("done", 1),
          { -> return {ok: executions == 2, output: "source defect"} },
        )
      },
    },
  )
  assert_eq(executions, 2)
  assert(out.verification.ok)
  const summary = fleet_repair_attempt_summary(out.attempts)
  assert_eq(len(summary.attempts), 2)
  assert_eq(len(summary.provider_failures), 0)
  const unknown = fleet_repair_agent_attempt(
    agent("provider_error", nil),
    { -> return {ok: false, output: "source defect"} },
  )
  const unmeasured = fleet_repair_attempt_summary([{verification: unknown.verification}])
  assert_eq(len(unmeasured.attempts), 1)
  assert_eq(len(unmeasured.provider_failures), 0)
  assert_eq(unmeasured.cost_status, "unknown")
  let validations = 0
  const recovered = fleet_repair_agent_attempt(
    agent("provider_error", 1),
    { ->
      validations = validations + 1
      return {ok: true, output: "delivered repair passed"}
    },
  )
  assert_eq(validations, 1)
  assert(recovered.verification.ok)
  assert_eq(recovered.branch, "completed")
}

pipeline test_outage_after_a_priced_repair_preserves_its_budget_and_cost(harness: Harness) {
  let executions = 0
  let validations = 0
  const out = workflow_run_repair(
    harness,
    {
      task: "repair fixture",
      max_attempts: 3,
      executor: { _ctx ->
        executions = executions + 1
        const result = if executions == 1 {
          agent("done", 1)
            + {
              result: {
                status: "done",
                provider_call_count: 1,
                cost_usd: 0.0232,
                known_cost_usd: 0.0232,
              },
            }
        } else {
          agent("provider_error", 0)
        }
        return fleet_repair_agent_attempt(
          result,
          { ->
            validations = validations + 1
            return {ok: false, output: "source defect"}
          },
        )
      },
    },
  )
  const summary = fleet_repair_attempt_summary(out.attempts)
  assert_eq(executions, 2)
  assert_eq(validations, 1)
  assert_eq(len(summary.attempts), 1)
  assert_eq(len(summary.provider_failures), 1)
  assert_eq(summary.known_cost_usd, 0.0232)
  assert_eq(summary.cost_status, "exact")
}
