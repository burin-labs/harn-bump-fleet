import { compose_dependabot_projection } from "../lib/dependabot_projection"

const HEADER =
  "version: 2\nupdates:\n  - package-ecosystem: \"github-actions\"\n    directory: \"/\"\n"

const GROUPS = "    groups:\n      actions:\n        patterns: [\"*\"]\n"

const IGNORE =
  "    ignore:\n      - dependency-name: \"burin-labs/harn/.github/workflows/bump-harn.yml\"\n"

const OLDEST = HEADER + GROUPS

const INTERMEDIATE = HEADER + IGNORE + GROUPS

const CURRENT = HEADER + GROUPS + IGNORE

const LOCAL =
  "    open-pull-requests-limit: 5\n    # Sticky disk is updated with its runner policy.\n    # A quoted value or comment saying ignore: is not another field.\n    ignore:\n      - dependency-name: \"useblacksmith/stickydisk\"\n"

const OTHER =
  "\n# Consumer ecosystem and its comments survive exactly.\n  - package-ecosystem: \"npm\"\n    directory: \"/site\"\n    groups:\n      npm:\n        patterns: [\"*\"]\n"

type Config = {version: int, updates: list<dict>}

pipeline test_actual_duplicate_ignore_shape_fails_old_prefix_concat_and_composes_once() {
  const body = OLDEST + LOCAL + OTHER
  const old_writer = try {
    yaml_parse(INTERMEDIATE + body.substring(len(OLDEST)))
    false
  } catch (_error) {
    true
  }
  assert(old_writer, "the original literal prefix replacement creates a duplicate ignore mapping")
  const rendered = compose_dependabot_projection(body, [INTERMEDIATE, OLDEST], CURRENT)
  assert(rendered.starts_with(CURRENT), "the byte-prefix validator remains satisfied")
  assert(rendered.ends_with(OTHER), "other ecosystem bytes and comments remain exact")
  assert(rendered.contains("# Sticky disk is updated with its runner policy."))
  const parsed: Config = schema_expect(yaml_parse(rendered), schema_of(Config))
  assert_eq(
    parsed.updates[0]?.ignore,
    [
      {"dependency-name": "burin-labs/harn/.github/workflows/bump-harn.yml"},
      {"dependency-name": "useblacksmith/stickydisk"},
    ],
  )
  assert_eq(parsed.updates[0]?.get("open-pull-requests-limit"), 5)
  assert_eq(parsed.updates[0]?.groups?.actions?.patterns, ["*"])
}

pipeline test_mixed_verified_prefixes_and_already_composed_local_entries() {
  for previous in [OLDEST, INTERMEDIATE] {
    assert_eq(
      compose_dependabot_projection(previous + OTHER, [OLDEST, INTERMEDIATE], CURRENT),
      CURRENT + OTHER,
    )
  }
  const local_tail = "      - dependency-name: \"useblacksmith/stickydisk\"\n" + OTHER
  assert_eq(
    compose_dependabot_projection(CURRENT + local_tail, [OLDEST, INTERMEDIATE], CURRENT),
    CURRENT + local_tail,
  )
  const next = CURRENT + "      - dependency-name: \"another/owned-action\"\n"
  const evolved = compose_dependabot_projection(CURRENT + local_tail, [CURRENT], next)
  const parsed: Config = schema_expect(yaml_parse(evolved), schema_of(Config))
  assert_eq(len(parsed.updates[0]?.ignore ?? []), 3)
  assert(evolved.ends_with(OTHER))
}

pipeline test_unknown_invalid_and_unsupported_source_shapes_never_produce_targets() {
  const cases = [
    {
      body: HEADER + "    schedule: {interval: daily}\n" + OTHER,
      history: [OLDEST],
      current: CURRENT,
    },
    {body: OLDEST + LOCAL + OTHER, history: [OLDEST], current: INTERMEDIATE},
    {
      body: OLDEST + "    ignore: [{dependency-name: sticky}]\n" + OTHER,
      history: [OLDEST],
      current: CURRENT,
    },
    {
      body: CURRENT + "    ignore:\n      - dependency-name: sticky\n",
      history: [OLDEST],
      current: CURRENT,
    },
  ]
  for case in cases {
    const refused = try {
      compose_dependabot_projection(case.body, case.history, case.current)
      false
    } catch (_error) {
      true
    }
    assert(
      refused,
      "unknown prefixes, duplicate mappings, and unsupported composition refuse writes",
    )
  }
}
