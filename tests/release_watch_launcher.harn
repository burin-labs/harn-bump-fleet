import { release_harness_root } from "../lib/release_runtime"

pipeline test_watch_launcher_delegates_once_without_mutation_authority(harness: Harness) {
  const root = release_harness_root(harness.fs)
  const fixture = harness.fs.mkdtemp_in_workspace("release-watch-launcher-")
  const scripts = path_join(fixture, "scripts")
  harness.fs.mkdir(scripts, true)
  const launcher = path_join(scripts, "watch_harn_release.sh")
  const confined = path_join(scripts, "harn_confined.sh")
  const log = path_join(fixture, "calls")
  harness.fs.write_text(
    launcher,
    harness.fs.read_text(path_join(root, "scripts/watch_harn_release.sh")),
  )
  harness.fs.write_text(
    confined,
    "#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$HARN_TEST_WATCH_CALLS\"\n",
  )
  assert(harness.process.run({program: "chmod", args: ["+x", launcher, confined]}).success)
  const result = harness.process.run(
    {
      program: launcher,
      args: ["--receipt", "handoff.json", "--release-pr", "7", "--producer-run", "42", "--json"],
      env: {HARN_TEST_WATCH_CALLS: log, HARN_EXT_RELEASE_REPO: "/absent-checkout"},
    },
  )
  assert(result.success, result.combined)
  const calls = harness.fs.read_lines(log)
  assert_eq(len(calls), 1)
  assert(contains(calls[0], "--workflow-watch-egress"))
  assert(ends_with(calls[0], "--receipt handoff.json --release-pr 7 --producer-run 42 --json"))
  assert_eq(contains(calls[0], "--approve-risky"), false)
}
