import { projection_source_key } from "../lib/fleet_projection_targets"
import {
  OVERRIDE_DISPATCHER_PATH,
  merge_override_caller_revision,
  render_merge_override_pin,
  resolve_merge_override_targets,
} from "../lib/merge_override_projection"

const OLD = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const NEW = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const COMPARISON = {canonical: NEW, checked: [], equivalent: []}

const TEMPLATE =
  "name: Merge override\non:\n  pull_request:\n    types: [labeled]\npermissions:\n  contents: read\n  issues: write\njobs:\n  override:\n    if: github.event_name == 'pull_request'\n    uses: burin-labs/.github/.github/workflows/merge-override.yml@<full-commit-sha>\n    with:\n      actor: trusted\n"

pipeline test_only_the_verified_reference_changes_and_comments_survive() {
  const current = "# Consumer comment remains byte exact.\n"
    + replace(TEMPLATE, "<full-commit-sha>", OLD)
  const expected = "# Consumer comment remains byte exact.\n"
    + replace(TEMPLATE, "<full-commit-sha>", NEW)
  assert_eq(merge_override_caller_revision(current), OLD)
  assert_eq(render_merge_override_pin(current, TEMPLATE, NEW), expected)
  assert_eq(render_merge_override_pin(expected, TEMPLATE, NEW), expected)
  const renamed = replace(current, "name: Merge override", "name: Consumer display name")
  assert_eq(render_merge_override_pin(renamed, TEMPLATE, NEW), replace(renamed, OLD, NEW))
}

pipeline test_damaged_or_different_caller_contracts_refuse_the_same_writer() {
  const current = replace(TEMPLATE, "<full-commit-sha>", OLD)
  for damaged in [
    replace(current, "types: [labeled]", "types: [opened]"),
    replace(current, "issues: write", "administration: write"),
    replace(current, "actor: trusted", "actor: attacker"),
    replace(current, OLD, "main"),
    "# burin-labs/.github/.github/workflows/merge-override.yml@" + OLD + "\n" + current,
    current + "  extra:\n    uses: burin-labs/.github/.github/workflows/merge-override.yml@" + OLD
      + "\n",
  ] {
    const refused = try {
      render_merge_override_pin(damaged, TEMPLATE, NEW)
      false
    } catch (_error) {
      true
    }
    assert(refused)
  }
  for damaged in [
    replace(current, OLD, "main"),
    current + "\n# burin-labs/.github/.github/workflows/merge-override.yml@" + OLD,
  ] {
    const refused = try {
      merge_override_caller_revision(damaged)
      false
    } catch (_error) {
      true
    }
    assert(refused)
  }
  for revision in ["", "main", "short"] {
    const refused = try {
      render_merge_override_pin(current, TEMPLATE, revision)
      false
    } catch (_error) {
      true
    }
    assert(refused)
  }
}

pipeline test_absence_is_measured_and_missing_reads_are_errors() {
  const repo = {slug: "owner/repository", directory: "repository"}
  const key = projection_source_key(repo.slug, OVERRIDE_DISPATCHER_PATH)
  const absent = resolve_merge_override_targets([repo], {[key]: nil}, {}, TEMPLATE, NEW, COMPARISON)
  assert_eq(absent.targets, [])
  assert_eq(absent.errors, [])
  assert_eq(absent.absent_by, [repo.slug])
  const missing = resolve_merge_override_targets([repo], {}, {}, TEMPLATE, NEW, COMPARISON)
  assert_eq(missing.targets, [])
  assert_eq(missing.failed_by, [repo.slug])
  assert_eq(len(missing.errors), 1)
  const current = replace(TEMPLATE, "<full-commit-sha>", OLD)
  const proposed = resolve_merge_override_targets(
    [repo],
    {[key]: current},
    {"owner/repository": TEMPLATE},
    TEMPLATE,
    NEW,
    COMPARISON,
  )
  assert_eq(len(proposed.targets), 1)
  assert_eq(proposed.targets[0]?.derived_from_sha256, sha256(current))
  assert_eq(proposed.targets[0]?.expected, replace(TEMPLATE, "<full-commit-sha>", NEW))
}

pipeline test_a_verified_historical_contract_can_advance_to_the_new_contract() {
  const repo = {slug: "owner/repository", directory: "repository"}
  const key = projection_source_key(repo.slug, OVERRIDE_DISPATCHER_PATH)
  const current = replace(TEMPLATE, "<full-commit-sha>", OLD)
  const updated = replace(TEMPLATE, "pull_request", "pull_request_target")
  const history = {"owner/repository": TEMPLATE}
  const result = resolve_merge_override_targets(
    [repo],
    {[key]: current},
    history,
    updated,
    NEW,
    COMPARISON,
  )
  assert_eq(result.errors, [])
  assert_eq(result.targets[0]?.expected, replace(updated, "<full-commit-sha>", NEW))
  const unknown = resolve_merge_override_targets(
    [repo],
    {[key]: current},
    {},
    updated,
    NEW,
    COMPARISON,
  )
  assert_eq(unknown.targets, [])
  assert_eq(unknown.failed_by, [repo.slug])
  const altered = replace(current, "actor: trusted", "actor: attacker")
  const refused = resolve_merge_override_targets(
    [repo],
    {[key]: altered},
    history,
    updated,
    NEW,
    COMPARISON,
  )
  assert_eq(refused.targets, [])
  assert_eq(refused.failed_by, [repo.slug])
}

pipeline test_a_verified_equivalent_caller_is_not_rolled_back_to_the_last_path_touch() {
  const repo = {slug: "owner/repository", directory: "repository"}
  const key = projection_source_key(repo.slug, OVERRIDE_DISPATCHER_PATH)
  const current = replace(TEMPLATE, "<full-commit-sha>", NEW)
  const result = resolve_merge_override_targets(
    [repo],
    {[key]: current},
    {[repo.slug]: TEMPLATE},
    TEMPLATE,
    OLD,
    {canonical: OLD, checked: [NEW], equivalent: [NEW]},
  )
  assert_eq(result.errors, [])
  assert_eq(result.targets[0]?.expected, current)
  const changed = resolve_merge_override_targets(
    [repo],
    {[key]: current},
    {[repo.slug]: TEMPLATE},
    TEMPLATE,
    OLD,
    {canonical: OLD, checked: [NEW], equivalent: []},
  )
  assert_eq(changed.targets[0]?.expected, replace(current, NEW, OLD))
  for comparison in [
    {canonical: NEW, checked: [NEW], equivalent: [NEW]},
    {canonical: OLD, checked: [], equivalent: [NEW]},
  ] {
    const unmeasured = resolve_merge_override_targets(
      [repo],
      {[key]: current},
      {[repo.slug]: TEMPLATE},
      TEMPLATE,
      OLD,
      comparison,
    )
    assert_eq(unmeasured.targets, [])
    assert_eq(unmeasured.failed_by, [repo.slug])
  }
  const unreachable = resolve_merge_override_targets(
    [repo],
    {[key]: current},
    {},
    TEMPLATE,
    OLD,
    {canonical: OLD, checked: [NEW], equivalent: [NEW]},
  )
  assert_eq(unreachable.targets, [])
  assert_eq(unreachable.failed_by, [repo.slug])
}
