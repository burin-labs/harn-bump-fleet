// The audit's exit code answers one question: could the audit do its job?
// It must NOT answer "did the audit find anything", because findings are the
// product and the fleet's steady state is hundreds of them. A run that is red
// every day hides the day it goes red for a reason.
//
// Run: harn test tests/prless_branch_audit_exit_code.harn
import {
  RepositoryBranchAudit,
  branch_audit_exit_code,
  fleet_branch_audit_receipt,
} from "../lib/prless_branch_audit"

const OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn clean_row(slug: string) -> RepositoryBranchAudit {
  return {
    slug: slug,
    state: "clean",
    default_branch: "main",
    branch_count: 4,
    open_pr_head_count: 4,
    prless_branch_count: 0,
    prless_branches: [],
    detail: "every branch has an open pull request",
  }
}

fn findings_row(slug: string, count: int) -> RepositoryBranchAudit {
  return {
    slug: slug,
    state: "findings",
    default_branch: "main",
    branch_count: count + 1,
    open_pr_head_count: 1,
    prless_branch_count: count,
    prless_branches: [{name: "lane/one", head_oid: OID, protected: false}],
    detail: "${to_string(count)} branch(es) without an open pull request",
  }
}

fn failed_row(slug: string) -> RepositoryBranchAudit {
  return {
    slug: slug,
    state: "measurement_failed",
    default_branch: "main",
    branch_count: nil,
    open_pr_head_count: nil,
    prless_branch_count: nil,
    prless_branches: [],
    error_code: "empty_branch_read",
    detail: "GitHub returned zero branches",
  }
}

/**
 * The case this test exists for. A fully measured sweep that found branches
 * is a SUCCESSFUL audit, so it exits 0 while still reporting the count.
 */
pipeline test_a_measured_sweep_with_findings_succeeds(harness: Harness) {
  const receipt = fleet_branch_audit_receipt([findings_row("octo-org/a", 62)])
  assert_eq(receipt.failed_repository_count, 0)
  // The count is not thrown away by exiting 0; it is still on the receipt.
  assert_eq(receipt.prless_branch_count, 62)
  assert_eq(branch_audit_exit_code(receipt, false, false), 0)
}

/**
 * Negative control against the exact regression this replaces. If someone
 * reinstates `prless_branch_count > 0` in the exit decision, the assertion
 * above flips, so this test states the boundary from the other side: the
 * ONLY thing that makes a fully measured sweep fail is opting in.
 */
pipeline test_findings_fail_only_when_a_caller_opts_in(harness: Harness) {
  const receipt = fleet_branch_audit_receipt([findings_row("octo-org/a", 1)])
  assert_eq(branch_audit_exit_code(receipt, false, false), 0)
  assert_eq(branch_audit_exit_code(receipt, false, true), 1)
}

/**
 * A broken instrument must stay loud, including when every other repository
 * was clean. This is the signal the old behavior was drowning.
 */
pipeline test_a_failed_measurement_fails_even_beside_clean_repositories(harness: Harness) {
  const receipt = fleet_branch_audit_receipt([clean_row("octo-org/a"), failed_row("octo-org/b")])
  assert_eq(receipt.failed_repository_count, 1)
  assert_eq(receipt.prless_branch_count, 0)
  assert_eq(branch_audit_exit_code(receipt, false, false), 1)
  // Opting out of finding-failures must not silence a measurement failure.
  assert_eq(branch_audit_exit_code(receipt, false, true), 1)
}

/**
 * An issue the audit was asked to write and could not is also the audit
 * failing at its job, independent of what it measured.
 */
pipeline test_a_failed_reconciliation_fails_a_clean_sweep(harness: Harness) {
  const receipt = fleet_branch_audit_receipt([clean_row("octo-org/a")])
  assert_eq(branch_audit_exit_code(receipt, false, false), 0)
  assert_eq(branch_audit_exit_code(receipt, true, false), 1)
}

/** The all-clear. Nothing found, nothing failed, nothing to report. */
pipeline test_a_clean_measured_sweep_succeeds(harness: Harness) {
  const receipt = fleet_branch_audit_receipt([clean_row("octo-org/a")])
  assert_eq(branch_audit_exit_code(receipt, false, false), 0)
}
