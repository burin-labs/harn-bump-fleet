import { bump_no_op_diagnosis } from "../lib/bump_no_op_diagnosis"
import {
  GithubWorkflowJob,
  GithubWorkflowJobs,
  GithubWorkflowStep,
} from "harn-github-connector/default"

fn step(name: string, conclusion: string?) -> GithubWorkflowStep {
  return {
    number: 1,
    name: name,
    status: "completed",
    conclusion: conclusion,
    started_at: nil,
    completed_at: nil,
  }
}

fn job(name: string, steps: list<GithubWorkflowStep>) -> GithubWorkflowJob {
  return {
    id: 1,
    run_id: 99,
    name: name,
    status: "completed",
    conclusion: "success",
    head_sha: "a" * 40,
    url: "https://github.test/job/1",
    runner_name: "runner",
    started_at: nil,
    completed_at: nil,
    steps: steps,
  }
}

fn jobs(rows: list<GithubWorkflowJob>) -> GithubWorkflowJobs {
  return {
    repo: "octo-org/consumer",
    run_id: 99,
    total_count: len(rows),
    jobs: rows,
    page: 1,
    per_page: 100,
  }
}

/**
 * The whole point of this module is that "we could not look" and "there was
 * nothing to see" are opposite findings. A failed read must never be reported
 * as a workflow that gated itself out.
 */
pipeline test_an_unreadable_job_list_is_not_a_workflow_that_did_nothing(task: unknown) {
  const unreadable = bump_no_op_diagnosis(nil, "http_503")
  assert_eq(unreadable.cause, "jobs_unreadable")
  assert_eq(unreadable.job_count, 0)
  assert(contains(unreadable.detail, "makes no claim"))
  assert(contains(unreadable.detail, "http_503"))
  const empty = bump_no_op_diagnosis(jobs([]))
  assert_eq(empty.cause, "no_jobs_reported")
  assert(contains(empty.detail, "zero jobs"))
}

/**
 * A run whose every step was skipped succeeded without running. That is a
 * defect in whatever gated the steps, and it is a different repair from a
 * mutation that executed and wrote to the wrong place.
 */
pipeline test_a_fully_skipped_run_is_named_apart_from_one_that_executed(task: unknown) {
  const skipped = bump_no_op_diagnosis(
    jobs([job("bump", [step("Checkout", "skipped"), step("Rewrite pin", "skipped")])]),
  )
  assert_eq(skipped.cause, "all_steps_skipped")
  assert_eq(skipped.step_count, 2)
  assert_eq(skipped.skipped_step_count, 2)
  assert_eq(len(skipped.executed_steps), 0)
  assert_eq(skipped.skipped_steps[0]?.step, "Checkout")
  assert(contains(skipped.detail, "what gated them"))
  const executed = bump_no_op_diagnosis(
    jobs([job("bump", [step("Checkout", "success"), step("Rewrite pin", "skipped")])]),
  )
  assert_eq(executed.cause, "steps_ran_and_wrote_nothing")
  assert_eq(executed.step_count, 2)
  assert_eq(executed.skipped_step_count, 1)
  assert_eq(len(executed.executed_steps), 1)
  assert_eq(executed.executed_steps[0]?.job, "bump")
  assert_eq(executed.executed_steps[0]?.step, "Checkout")
  assert(contains(executed.detail, "wrong target"))
}

/** A job that reported no steps at all is not the same as one whose steps were skipped. */
pipeline test_a_job_with_no_steps_is_not_counted_as_skipped_work(task: unknown) {
  const result = bump_no_op_diagnosis(jobs([job("bump", [])]))
  assert_eq(result.cause, "no_jobs_reported")
  assert_eq(result.job_count, 1)
  assert_eq(result.step_count, 0)
  assert_eq(result.skipped_step_count, 0)
  assert(contains(result.detail, "no steps at all"))
}

/** Steps are attributed to their own job, so a multi-job run stays readable. */
pipeline test_every_step_carries_the_job_that_ran_it(task: unknown) {
  const result = bump_no_op_diagnosis(
    jobs(
      [
        job("preflight", [step("Resolve target", "success")]),
        job("bump", [step("Rewrite pin", "skipped")]),
      ],
    ),
  )
  assert_eq(result.job_count, 2)
  assert_eq(result.cause, "steps_ran_and_wrote_nothing")
  assert_eq(result.executed_steps[0]?.job, "preflight")
  assert_eq(result.skipped_steps[0]?.job, "bump")
}
