import { acquire_build_lock, build_lock_decision, release_build_lock } from "../lib/build_mutex"

pipeline test_build_lock_decision(task) {
  assert_eq(build_lock_decision({acquired: true}).action, "acquired")
  // Held by a dead process -> stale, safe to steal.
  assert_eq(build_lock_decision({acquired: false, owner_alive: false}).action, "steal")
  // Held by a live process, --wait -> queue behind it.
  assert_eq(build_lock_decision({acquired: false, owner_alive: true, wait: true}).action, "wait")
  // Held by a live process, no --wait -> fail fast.
  let fail = build_lock_decision({acquired: false, owner_alive: true, wait: false})
  assert_eq(fail.action, "fail")
  assert_eq(contains(fail.reason, "holds the build lock"), true)
}

fn sh(cmd) {
  let r = shell(cmd)
  if !(r.success ?? false) {
    throw "fixture command failed: ${cmd}\n${r.stderr ?? ""}"
  }
  return r
}

pipeline test_build_lock_dogfood(task) {
  let base = trim(sh("mktemp -d").stdout)
  let lock = base + "/harn-release-build.lock"
  let run = { cmd -> shell(cmd) }
  // First acquire wins and creates the lock dir with our (live) pid.
  let first = acquire_build_lock(run, {lock_path: lock, pid: pid(), note: "unit test"})
  assert_eq(first.acquired, true)
  assert_eq(first.action, "acquired")
  assert_eq(trim(sh("test -d '" + lock + "' && echo yes").stdout), "yes")
  // A second acquirer sees the live owner and fails fast (no --wait).
  let second = acquire_build_lock(run, {lock_path: lock, pid: pid(), wait: false})
  assert_eq(second.acquired, false)
  assert_eq(second.action, "fail")
  // Releasing clears the lock; the next acquire wins again.
  release_build_lock(run, lock)
  assert_eq(shell("test -d '" + lock + "'").success, false)
  let third = acquire_build_lock(run, {lock_path: lock, pid: pid()})
  assert_eq(third.acquired, true)
  release_build_lock(run, lock)
  sh("rm -rf '" + base + "'")
}

pipeline test_build_lock_steals_stale(task) {
  let base = trim(sh("mktemp -d").stdout)
  let lock = base + "/harn-release-build.lock"
  let run = { cmd -> shell(cmd) }
  // Plant a lock owned by a dead pid (pid 2 is unkillable; use a huge unused pid).
  sh("mkdir '" + lock + "'")
  sh("printf 'pid=999999999\\n' > '" + lock + "/owner'")
  // A live acquirer should detect the dead owner and steal the stale lock.
  let result = acquire_build_lock(run, {lock_path: lock, pid: pid()})
  assert_eq(result.acquired, true)
  assert_eq(result.waited_polls, 0)
  release_build_lock(run, lock)
  sh("rm -rf '" + base + "'")
}
