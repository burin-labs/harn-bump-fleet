import { write_json } from "std/fs"
import { CandidateArchiveReceipt } from "../lib/candidate_archive_receipt"
import {
  HostedCandidateArchiveReceiptAdapter,
  import_hosted_candidate_archive_receipt,
} from "../lib/hosted_candidate_archive_receipt"

const SOURCE_SHA = "6bbef209b7674bb76084dbf1c8c08a7995917b77"

const ARCHIVE_RUN_ID = 34059280707

const HOSTED_RUN_ID = 34058798906

fn receipt(run_id: int = ARCHIVE_RUN_ID) -> CandidateArchiveReceipt {
  return {
    schema_version: "release_harn.candidate_archive.v1",
    slug: "burin-labs/harn",
    workflow: "build-release-binaries.yml",
    event: "workflow_dispatch",
    policy_ref: "main",
    expected_policy_sha: "496a4900f6e20ddb4e41b6537aa57fae3b60e2ac",
    source_ref: "release-attempt/v0.10.132/${SOURCE_SHA}",
    expected_source_sha: SOURCE_SHA,
    run_id: run_id,
    run_url: "https://github.com/burin-labs/harn/actions/runs/${run_id}",
    observed_event: "workflow_dispatch",
    observed_head_branch: "main",
    observed_head_sha: "496a4900f6e20ddb4e41b6537aa57fae3b60e2ac",
    created_at: "2026-09-06T20:51:36.726Z",
  }
}

fn write_uploaded_receipt(fs: HarnessFs, destination: string, value: CandidateArchiveReceipt) {
  const dir = path_join(destination, "release-harn", "candidate-archive")
  fs.mkdir(dir, true)
  write_json(fs, path_join(dir, SOURCE_SHA + ".json"), value, {pretty: true})
}

fn failure_message(callback: closure) -> string {
  try {
    callback()
    return ""
  } catch (error) {
    return to_string(error)
  }
}

pipeline test_exact_prior_hosted_run_restores_selected_archive_receipt(
  harness: Harness,
  task: any,
) {
  let observed_run_id = 0
  let observed_artifact = ""
  const adapter: HostedCandidateArchiveReceiptAdapter = {
    download: fn(run_id, destination) {
      observed_run_id = run_id
      observed_artifact = "release-run-${run_id}"
      write_uploaded_receipt(harness.fs, destination, receipt())
      return {success: true, message: ""}
    },
  }
  const output = path_join(
    harness.fs.mkdtemp_in_workspace("candidate-receipt-output-"),
    "receipt.json",
  )
  const restored = import_hosted_candidate_archive_receipt(
    harness,
    {
      repo_root: harness.fs.cwd(),
      hosted_run_id: HOSTED_RUN_ID,
      candidate_archive_run_id: ARCHIVE_RUN_ID,
      destination: output,
    },
    adapter,
  )
  assert_eq(restored, receipt())
  assert_eq(observed_run_id, HOSTED_RUN_ID)
  assert_eq(observed_artifact, "release-run-${HOSTED_RUN_ID}")
  assert_eq(harness.fs.exists(output), true)
}

pipeline test_archive_receipt_run_mismatch_refuses_without_persisting(harness: Harness, task: any) {
  const adapter: HostedCandidateArchiveReceiptAdapter = {
    download: fn(_run_id, destination) {
      write_uploaded_receipt(harness.fs, destination, receipt(34057196326))
      return {success: true, message: ""}
    },
  }
  const output = path_join(
    harness.fs.mkdtemp_in_workspace("candidate-receipt-mismatch-"),
    "receipt.json",
  )
  const message = failure_message(
    fn() { import_hosted_candidate_archive_receipt(
      harness,
      {
        repo_root: harness.fs.cwd(),
        hosted_run_id: HOSTED_RUN_ID,
        candidate_archive_run_id: ARCHIVE_RUN_ID,
        destination: output,
      },
      adapter,
    ) },
  )
  assert(contains(message, "names archive run 34057196326, not selected run 34059280707"))
  assert_eq(harness.fs.exists(output), false)
}

pipeline test_successful_empty_artifact_download_is_not_a_receipt(harness: Harness, task: any) {
  const adapter: HostedCandidateArchiveReceiptAdapter = {
    download: fn(_run_id, _destination) { return {success: true, message: ""} },
  }
  const output = path_join(
    harness.fs.mkdtemp_in_workspace("candidate-receipt-empty-"),
    "receipt.json",
  )
  const message = failure_message(
    fn() { import_hosted_candidate_archive_receipt(
      harness,
      {
        repo_root: harness.fs.cwd(),
        hosted_run_id: HOSTED_RUN_ID,
        candidate_archive_run_id: ARCHIVE_RUN_ID,
        destination: output,
      },
      adapter,
    ) },
  )
  assert(contains(message, "contained no candidate archive receipt"))
  assert_eq(harness.fs.exists(output), false)
}
