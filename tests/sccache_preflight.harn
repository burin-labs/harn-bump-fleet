import { command_result_fail, command_result_ok } from "std/command"
import { ensure_healthy_sccache, sccache_cache_error_count } from "../lib/sccache_preflight"

// A healthy `sccache --show-stats` excerpt: every error counter is zero.
const HEALTHY_STATS = "Compile requests                    100\n"
  + "Cache hits                           40\n"
  + "Cache misses                         60\n"
  + "Cache hits rate                   40.00 %\n"
  + "Cache read errors                     0\n"
  + "Cache write errors                    0\n"
  + "Cache errors                          0\n"
  + "Cache errors (Rust)                   0\n"
  + "Average cache read hit            0.001 s\n"

// A poisoned daemon (confined by an inherited sandbox): cache writes and
// reads fail in bulk. Mirrors the real run that broke the v0.8.82 release.
const POISONED_STATS = "Compile requests                   1317\n"
  + "Cache hits                            0\n"
  + "Cache misses                        956\n"
  + "Cache read errors                     0\n"
  + "Cache write errors                  956\n"
  + "Cache errors                          3\n"
  + "Cache errors (Rust)                   3\n"

fn scripted_runner(entries) {
  return { command ->
    for entry in entries {
      if entry.command == command {
        return entry.result
      }
    }
    throw "unexpected sccache command: " + command
  }
}

pipeline test_error_count_zero_when_healthy(task) {
  assert_eq(sccache_cache_error_count(HEALTHY_STATS), 0)
  assert_eq(sccache_cache_error_count(""), 0)
  assert_eq(sccache_cache_error_count(nil), 0)
}

pipeline test_error_count_sums_poisoned_counters(task) {
  // 956 (write) + 0 (read) + 3 (errors) + 3 (errors Rust) = 962
  assert_eq(sccache_cache_error_count(POISONED_STATS), 962)
}

pipeline test_healthy_daemon_is_not_restarted(task) {
  const result = ensure_healthy_sccache(
    scripted_runner(
      [
        {
          command: "command -v sccache 2>/dev/null",
          result: command_result_ok("/opt/homebrew/bin/sccache\n"),
        },
        {command: "sccache --show-stats 2>/dev/null", result: command_result_ok(HEALTHY_STATS)},
      ],
    ),
  )
  assert_eq(result.checked, true)
  assert_eq(result.restarted, false)
  assert_eq(result.errors, 0)
  assert_eq(result.detail, "sccache daemon healthy")
}

pipeline test_poisoned_daemon_is_restarted(task) {
  const result = ensure_healthy_sccache(
    scripted_runner(
      [
        {
          command: "command -v sccache 2>/dev/null",
          result: command_result_ok("/opt/homebrew/bin/sccache\n"),
        },
        {command: "sccache --show-stats 2>/dev/null", result: command_result_ok(POISONED_STATS)},
        {command: "sccache --stop-server >/dev/null 2>&1 || true", result: command_result_ok("")},
      ],
    ),
  )
  assert_eq(result.checked, true)
  assert_eq(result.restarted, true)
  assert_eq(result.errors, 962)
  assert(contains(result.detail, "restarted poisoned sccache daemon"))
}

pipeline test_missing_sccache_is_a_noop(task) {
  const result = ensure_healthy_sccache(
    scripted_runner([{command: "command -v sccache 2>/dev/null", result: command_result_ok("")}]),
  )
  assert_eq(result.checked, false)
  assert_eq(result.restarted, false)
  assert(contains(result.detail, "not installed"))
}

pipeline test_stats_failure_leaves_daemon_untouched(task) {
  const result = ensure_healthy_sccache(
    scripted_runner(
      [
        {
          command: "command -v sccache 2>/dev/null",
          result: command_result_ok("/opt/homebrew/bin/sccache\n"),
        },
        {command: "sccache --show-stats 2>/dev/null", result: command_result_fail(1, "server unreachable")},
      ],
    ),
  )
  assert_eq(result.checked, false)
  assert_eq(result.restarted, false)
  assert(contains(result.detail, "left daemon as-is"))
}
