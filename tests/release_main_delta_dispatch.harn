import { ExactWorkflowRunProvider } from "../lib/exact_workflow_run"
import {
  ReleaseMainDeltaWorkflowAcquisition,
  acquire_release_main_delta_workflows,
} from "../lib/release_main_delta_dispatch"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const PATH = ".github/workflows/windows-nightly.yml"

const REF = "release-certify/${SHA}"

fn spec() -> ReleaseMainDeltaWorkflowAcquisition {
  return {repo: "burin-labs/harn", ref: REF, head_sha: SHA, workflow_paths: [PATH]}
}

fn run(id: int, status: string, conclusion: string?) -> dict {
  return {
    id: id,
    workflow_path: PATH,
    event: "workflow_dispatch",
    status: status,
    conclusion: conclusion,
    head_branch: REF,
    head_sha: SHA,
    run_attempt: 1,
    url: "https://github.com/burin-labs/harn/actions/runs/${id}",
  }
}

fn receipt(id: int) -> dict {
  return {
    run_id: id,
    workflow_path: PATH,
    ref: REF,
    head_sha: SHA,
    event: "workflow_dispatch",
    run_attempt: 1,
    url: "https://github.com/burin-labs/harn/actions/runs/${id}",
  }
}

fn cancel_ok(id: int) -> Result<dict, dict> {
  return Ok({run_id: id, accepted: true, state: "cancel_requested"})
}

/** The release acquisition boundary never retries an exact red verdict. */
pipeline test_release_delta_acquisition_preserves_failure_and_timeout(task: any) {
  for conclusion in ["failure", "timed_out"] {
    let dispatches = 0
    let reruns = 0
    const provider: ExactWorkflowRunProvider = {
      list: fn(_request) { return Ok({runs: [run(8101, "completed", conclusion)]}) },
      dispatch: fn(_request) {
        dispatches = dispatches + 1
        return Ok(receipt(8102))
      },
      rerun: fn(id) {
        reruns = reruns + 1
        return Ok({run_id: id, accepted: true})
      },
      cancel: cancel_ok,
      wait: fn(_ms) {
      },
    }
    assert_eq(acquire_release_main_delta_workflows(spec(), provider), false)
    assert_eq([reruns, dispatches], [0, 0])
  }
}

/** A missing exact run dispatches once and reconciles the same identity. */
pipeline test_release_delta_acquisition_dispatches_an_absent_run(task: any) {
  let runs: list<dict> = []
  let dispatches = 0
  const provider: ExactWorkflowRunProvider = {
    list: fn(_request) { return Ok({runs: runs}) },
    dispatch: fn(_request) {
      dispatches = dispatches + 1
      runs = [run(8201, "queued", nil)]
      return Ok(receipt(8201))
    },
    rerun: fn(_id) { return Err({code: "unexpected_rerun"}) },
    cancel: cancel_ok,
    wait: fn(_ms) {
    },
  }
  assert_eq(acquire_release_main_delta_workflows(spec(), provider), true)
  assert_eq(dispatches, 1)
}

/** An active exact run is adopted without another dispatch. */
pipeline test_release_delta_acquisition_adopts_an_active_run(task: any) {
  let dispatches = 0
  const provider: ExactWorkflowRunProvider = {
    list: fn(_request) { return Ok({runs: [run(8301, "in_progress", nil)]}) },
    dispatch: fn(_request) {
      dispatches = dispatches + 1
      return Ok(receipt(8302))
    },
    rerun: fn(_id) { return Err({code: "unexpected_rerun"}) },
    cancel: cancel_ok,
    wait: fn(_ms) {
    },
  }
  assert_eq(acquire_release_main_delta_workflows(spec(), provider), true)
  assert_eq(dispatches, 0)
}
