import { release_scope_findings } from "../lib/release_analysis"
import {
  post_merge_drift_deterministic_findings,
  post_merge_paperwork_push_args,
} from "../lib/release_notes"
import { planner_credential_remediation } from "../lib/release_preflight"
import { parse_release_args, parse_release_scope_pr_numbers, usage } from "../lib/release_runtime"

pipeline test_planner_credential_remediation_points_at_with_env(task) {
  const text = planner_credential_remediation()
  // Names the documented seam and a runnable example, not just "set your keys".
  assert(contains(text, "scripts/with_env.sh"))
  assert(contains(text, "release_harn.harn"))
  // Spells out the discovery order so the operator knows which file to edit.
  assert(contains(text, "HARN_BUMP_FLEET_ENV_FILE"))
  assert(contains(text, ".env.local"))
}

pipeline test_usage_documents_credential_seam(task) {
  const text = usage()
  assert(contains(text, "Credentials"))
  assert(contains(text, "scripts/with_env.sh"))
}

pipeline test_release_scope_pr_numbers_accept_repeated_and_hash_forms(task) {
  assert_eq(parse_release_scope_pr_numbers(["4844", "#4843,4841", "4844"]), [4844, 4843, 4841])
  const cfg = parse_release_args(
    harness,
    ["--expect-pr", "4844", "--expect-pr", "#4843,4841", "--reject-pr", "4845"],
  )
  assert_eq(cfg.expected_prs, [4844, 4843, 4841])
  assert_eq(cfg.rejected_prs, [4845])
}

pipeline test_release_scope_pr_numbers_reject_invalid_values(task) {
  const err = try {
    parse_release_scope_pr_numbers(["4844,not-a-pr"])
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(err, "invalid release scope PR number"))
}

pipeline test_release_scope_findings_cover_missing_expected_and_rejected_present(task) {
  const findings = release_scope_findings({expected_prs: [4843, 4844], rejected_prs: [4845]}, [4843, 4845])
  const text = join(findings, "\n")
  assert(contains(text, "expected PR #4844"))
  assert(contains(text, "rejected PR #4845"))
  assert_eq(release_scope_findings({expected_prs: [4843], rejected_prs: [4845]}, [4843]), [])
}

pipeline test_post_merge_drift_findings_hide_next_release_scope_noise(task) {
  const findings = post_merge_drift_deterministic_findings(
    [
      "working tree has no candidate release content",
      "release scope expected PR #4844 is absent from the selected range",
      "CHANGELOG.md top entry is v0.10.19; expected v0.10.20 for --bump patch",
    ],
  )
  assert_eq(
    findings,
    [
      "working tree has no candidate release content",
      "CHANGELOG.md top entry is v0.10.19; expected v0.10.20 for --bump patch",
    ],
  )
}

pipeline test_post_merge_paperwork_push_uses_force_only_for_existing_remote_branch(task) {
  assert_eq(
    post_merge_paperwork_push_args("paperwork/v0.10.19-changelog-fix", false),
    ["push", "-u", "origin", "paperwork/v0.10.19-changelog-fix"],
  )
  assert_eq(
    post_merge_paperwork_push_args("paperwork/v0.10.19-changelog-fix", true),
    ["push", "-u", "origin", "paperwork/v0.10.19-changelog-fix", "--force-with-lease"],
  )
}
