pipeline test_prior_release_fold_accepts_matching_base(task: any) {
  const base = prior_release_fold_base_evidence(
    "origin/main",
    "v1.2.3",
    "[workspace.package]\nversion = \"1.2.3\"\n",
    "# Changelog\n\n## Unreleased\n\n## v1.2.3\n\n- Shipped.\n",
    release_contract_fixture(),
  )
  const decision = prior_release_fold_decision(base)
  assert_eq(base.workspace_version, "1.2.3")
  assert_eq(base.changelog_version, "1.2.3")
  assert_eq(decision.proceed, true)
}

pipeline test_prior_release_fold_accepts_development_version_base(task: any) {
  // Post-release automation cuts main straight to the next patch `-dev`
  // version; that shape proves the release fold exactly as the released
  // version itself does.
  const base = prior_release_fold_base_evidence(
    "origin/main",
    "v1.2.3",
    "[workspace.package]\nversion = \"1.2.4-dev\"\n",
    "# Changelog\n\n## Unreleased\n\n## v1.2.3\n\n- Shipped.\n",
    release_contract_fixture(),
  )
  const decision = prior_release_fold_decision(base)
  assert_eq(base.workspace_version, "1.2.4-dev")
  assert_eq(decision.proceed, true)
}

pipeline test_prior_release_fold_rejects_wrong_development_target(task: any) {
  // Only the NEXT patch's -dev form counts; a skipped or stale dev target
  // still fails the fold gate and the message names both accepted forms.
  const decision = prior_release_fold_decision(
    {
      contract: release_contract_fixture(),
      base_ref: "origin/main",
      latest_tag: "v1.2.3",
      workspace_version: "1.2.5-dev",
      changelog_version: "1.2.3",
      recovery_ref: "",
      recovery_pr_number: nil,
      recovery_pr_url: "",
    },
  )
  assert_eq(decision.proceed, false)
  assert(contains(decision.detail, "workspace version is 1.2.5-dev"))
  assert(contains(decision.detail, "expected 1.2.3 or 1.2.4-dev"))
}

pipeline test_prior_release_fold_reports_each_mismatch(task: any) {
  const workspace = prior_release_fold_decision(
    {
      contract: release_contract_fixture(),
      base_ref: "origin/main",
      latest_tag: "v1.2.3",
      workspace_version: "1.2.2",
      changelog_version: "1.2.3",
      recovery_ref: "",
      recovery_pr_number: nil,
      recovery_pr_url: "",
    },
  )
  assert_eq(workspace.proceed, false)
  assert(contains(workspace.detail, "workspace version is 1.2.2"))
  assert(!contains(workspace.detail, "CHANGELOG top is"))
  const changelog = prior_release_fold_decision(
    {
      contract: release_contract_fixture(),
      base_ref: "origin/main",
      latest_tag: "v1.2.3",
      workspace_version: "1.2.3",
      changelog_version: "1.2.2",
      recovery_ref: "",
      recovery_pr_number: nil,
      recovery_pr_url: "",
    },
  )
  assert_eq(changelog.proceed, false)
  assert(contains(changelog.detail, "CHANGELOG top is v1.2.2"))
}

pipeline test_prior_release_fold_names_orphaned_pr_and_branch(task: any) {
  const decision = prior_release_fold_decision(
    {
      contract: release_contract_fixture(),
      base_ref: "origin/main",
      latest_tag: "v1.2.3",
      workspace_version: "1.2.2",
      changelog_version: "1.2.2",
      recovery_ref: "release-attempt/v1.2.3/deadbeef",
      recovery_pr_number: 42,
      recovery_pr_url: "https://github.test/pull/42",
    },
  )
  assert_eq(decision.proceed, false)
  assert(contains(decision.detail, "PR #42 https://github.test/pull/42"))
  assert(contains(decision.detail, "release-attempt/v1.2.3/deadbeef"))
  assert(contains(decision.detail, "Recreate the fold from v1.2.3"))
}

pipeline test_prior_release_fold_uses_remote_tag_as_authority(task: any) {
  const decision = prior_release_fold_decision(
    {
      contract: release_contract_fixture(),
      base_ref: "origin/main",
      latest_tag: "v1.2.4",
      workspace_version: "1.2.3",
      changelog_version: "1.2.3",
      recovery_ref: "",
      recovery_pr_number: nil,
      recovery_pr_url: "",
    },
  )
  assert_eq(decision.proceed, false)
  assert(contains(decision.detail, "expected 1.2.4"))
}

pipeline test_prior_release_fold_allows_only_exact_next_tag_recovery(task: any) {
  const evidence = {
    contract: release_contract_fixture(),
    base_ref: "origin/main",
    latest_tag: "v1.2.3",
    workspace_version: "1.2.2",
    changelog_version: "1.2.2",
    recovery_ref: "release-attempt/v1.2.3/abc",
    recovery_pr_number: 42,
    recovery_pr_url: "https://github.test/pull/42",
  }
  assert_eq(prior_release_fold_recovery_allowed(evidence, "patch"), true)
  assert_eq(prior_release_fold_recovery_allowed(evidence, "minor"), false)
  assert_eq(prior_release_fold_recovery_allowed(evidence, "patch", "prepare"), false)
  assert_eq(prior_release_fold_recovery_allowed(evidence + {recovery_ref: ""}, "patch"), false)
  assert_eq(
    prior_release_fold_recovery_allowed(evidence + {workspace_version: "unknown"}, "patch"),
    false,
  )
}

pipeline test_prior_release_fold_probes_exact_heads_with_bounded_queries(task: any) {
  const filters = release_fold_pr_probe_filters(
    "main",
    ["release-attempt/v1.2.3/abc", "release-fold/v1.2.3-recovery"],
  )
  assert_eq(
    filters,
    [
      {base: "main", head: "release-attempt/v1.2.3/abc", state: "open", limit: 1},
      {base: "main", head: "release-fold/v1.2.3-recovery", state: "open", limit: 1},
      {base: "main", head: "release-attempt/v1.2.3/abc", state: "all", limit: 1},
      {base: "main", head: "release-fold/v1.2.3-recovery", state: "all", limit: 1},
    ],
  )
}

pipeline test_prior_release_fold_live_probe_does_not_touch_checkout(harness: Harness, task: any) {
  const root = path_join(harness.fs.temp_dir(), "prior-fold-" + harness.random.uuid_v7())
  const remote = path_join(root, "remote.git")
  const work = path_join(root, "work")
  fixture_shell(harness.process, "git init --bare -q '" + remote + "'")
  fixture_shell(harness.process, "git init -q '" + work + "'")
  fixture_shell(harness.process, "git -C '" + work + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + work + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + work + "' checkout -q -b main")
  harness.fs.write_text(path_join(work, "Cargo.toml"), "[workspace.package]\nversion = \"1.2.3\"\n")
  harness.fs.write_text(
    path_join(work, "CHANGELOG.md"),
    "# Changelog\n\n## Unreleased\n\n## v1.2.3\n\n- Shipped.\n",
  )
  harness.fs.mkdir(path_join(work, "scripts"))
  harness.fs.write_text(
    path_join(work, "scripts/release_contract.json"),
    json_stringify(release_contract_fixture()) + "\n",
  )
  fixture_shell(
    harness.process,
    "git -C '" + work + "' add Cargo.toml CHANGELOG.md scripts/release_contract.json",
  )
  fixture_shell(harness.process, "git -C '" + work + "' commit -q -m folded")
  fixture_shell(harness.process, "git -C '" + work + "' tag v1.2.3")
  fixture_shell(harness.process, "git -C '" + work + "' remote add origin '" + remote + "'")
  fixture_shell(harness.process, "git -C '" + work + "' push -q -u origin main --tags")
  harness.fs.write_text(path_join(work, "operator-notes.txt"), "keep me\n")
  const before = fixture_shell(
    harness.process,
    "git -C '" + work + "' status --porcelain --untracked-files=normal",
  ).stdout
  release_prior_fold_preflight(
    harness,
    {repo: work, base: "main", mode: "ship-pr", mock: false, yes_live_release: true},
    "test-prior-fold",
  )
  const after = fixture_shell(
    harness.process,
    "git -C '" + work + "' status --porcelain --untracked-files=normal",
  ).stdout
  assert_eq(after, before)
}

pipeline test_planner_credential_remediation_points_at_release_launcher(task: any) {
  const text = planner_credential_remediation()
  // Names the documented seam and a runnable example, not just "set your keys".
  assert(contains(text, "scripts/run_harn_release.sh"))
  assert_eq(contains(text, "harn run"), false)
  // Spells out the discovery order so the operator knows which file to edit.
  assert(contains(text, "HARN_EXT_BUMP_FLEET_ENV_FILE"))
  assert(contains(text, ".env.local"))
}

pipeline test_usage_documents_credential_seam(task: any) {
  const text = usage()
  assert(contains(text, "Credentials"))
  assert(contains(text, "scripts/run_harn_release.sh"))
}

pipeline test_release_build_lease_options_are_stable_and_bounded(task: any) {
  const immediate = release_build_lease_options({mode: "ship-pr"}, "run-1")
  assert_eq(immediate.owner, "release-harn.run-1")
  assert_eq(immediate.resource_class, "rust-heavy")
  assert_eq(immediate.domain, "release-build")
  assert_eq(immediate.wait_timeout_ms, 0)
  assert_eq(immediate.metadata, {mode: "ship-pr"})
  const waiting = release_build_lease_options({mode: "prepare", wait_build_lock: true}, "run-2")
  assert_eq(waiting.wait_timeout_ms, 20 * 60 * 1000)
}

@serial(group: "host-lease-store")
pipeline test_release_build_lease_contends_and_releases_in_process(harness: Harness, task: any) {
  const domain = "release-build-" + harness.random.uuid_v7()
  const cfg = {mode: "ship-pr", yes_live_release: true, build_lease_domain: domain}
  let blocked = ""
  const first = release_with_build_lease(
    harness,
    cfg,
    "run-" + harness.random.uuid_v7(),
    { ->
      blocked = try {
        release_with_build_lease(
          harness,
          cfg,
          "run-" + harness.random.uuid_v7(),
          { -> "unexpected" },
        )
        ""
      } catch (e) {
        to_string(e)
      }
      return "held"
    },
  )
  assert_eq(first, "held")
  assert(contains(blocked, "release build lease is held"))
  assert_eq(
    release_with_build_lease(harness, cfg, "run-" + harness.random.uuid_v7(), { -> "reacquired" }),
    "reacquired",
  )
}

@serial(group: "host-lease-store")
pipeline test_release_build_lease_releases_after_exception(harness: Harness, task: any) {
  const cfg = {
    mode: "prepare",
    yes_live_release: true,
    build_lease_domain: "release-build-" + harness.random.uuid_v7(),
  }
  const failure = try {
    release_with_build_lease(
      harness,
      cfg,
      "run-" + harness.random.uuid_v7(),
      { ->
        throw "build failed"
      },
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(failure, "build failed"))
  assert_eq(
    release_with_build_lease(harness, cfg, "run-" + harness.random.uuid_v7(), { -> "reacquired" }),
    "reacquired",
  )
}

@serial(group: "host-lease-store")
pipeline test_release_build_lease_preserves_nil_callback_result(harness: Harness, task: any) {
  const cfg = {
    mode: "prepare",
    yes_live_release: true,
    build_lease_domain: "release-build-" + harness.random.uuid_v7(),
  }
  assert_eq(
    release_with_build_lease(harness, cfg, "run-" + harness.random.uuid_v7(), { -> return nil }),
    nil,
  )
}

pipeline test_release_scope_pr_numbers_accept_repeated_and_hash_forms(harness: Harness, task: any) {
  assert_eq(
    parse_pull_request_numbers("expected_prs", ["4844", "#4843,4841", "4844"]),
    [4844, 4843, 4841],
  )
  const cfg = parse_release_args(
    harness.env,
    [
      "--expect-pr",
      "4844",
      "--expect-pr",
      "#4843,4841",
      "--reject-pr",
      "4845",
      "--queue-critical-pr",
      "#4844,4843",
      "--queue-live-pr",
      "4850",
      "--queue-noncritical-live-pr",
      "4851,4852",
      "--at-sha",
      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    ],
  )
  assert_eq(cfg.expected_prs, [4844, 4843, 4841])
  assert_eq(cfg.rejected_prs, [4845])
  assert_eq(cfg.queue_critical_prs, [4844, 4843])
  assert_eq(cfg.queue_live_prs, [4850])
  assert_eq(cfg.queue_noncritical_live_prs, [4851, 4852])
}

pipeline test_release_scope_pr_numbers_reject_invalid_values(task: any) {
  const err = try {
    parse_pull_request_numbers("expected_prs", ["4844,[7922"])
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(err, "invalid expected_prs value: [7922"))
  assert(
    contains(
      err,
      "expected blank or comma-separated positive pull request numbers, each optionally prefixed with #",
    ),
  )
  assert(contains(err, "for example 7922,#8146"))
  const rejected = try {
    parse_pull_request_numbers("rejected_prs", ["not-a-pr"])
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(rejected, "invalid rejected_prs value: not-a-pr"))
}

pipeline test_release_scope_findings_cover_missing_expected_and_rejected_present(task: any) {
  const findings = release_scope_findings(
    {expected_prs: [4843, 4844], rejected_prs: [4845]},
    [4843, 4845],
  )
  const text = join(findings, "\n")
  assert(contains(text, "expected PR #4844"))
  assert(contains(text, "rejected PR #4845"))
  assert_eq(release_scope_findings({expected_prs: [4843], rejected_prs: [4845]}, [4843]), [])
}

pipeline test_release_scope_findings_compare_typed_pr_numbers(task: any) {
  const commits = join(
    [
      "630d862 chore: repair v0.10.19 changelog paperwork (#4851)",
      "0ceebcc fix: drain wait_command completion result (#4844)",
      "2956aae audit: align dispatch docs alias (#4843)",
      "f45b17a ci: keep cold-start budget off routine PRs (#4845)",
      "5c59c10 runtime: recover typed missing tool calls (#4841)",
      "bc26901 test: prior release support (#4840)",
      "0f3684d docs: release prep cleanup (#4838)",
      "0f3684d docs: release prep cleanup duplicate subject (#4838)",
    ],
    "\n",
  )
  const observed = pr_numbers_from_commits(commits)
  assert_eq(observed, [4851, 4844, 4843, 4845, 4841, 4840, 4838])
  assert_eq(
    release_scope_findings(
      {expected_prs: [4841, 4845, 4843, 4844], rejected_prs: [4847]},
      observed,
    ),
    [],
  )
  const contaminated = pr_numbers_from_commits(
    commits + "\nc419448 split package audit out of format CI (#4847)",
  )
  assert_eq(
    release_scope_findings(
      {expected_prs: [4841, 4845, 4843, 4844], rejected_prs: [4847]},
      contaminated,
    ),
    ["release scope rejected PR #4847 is present in the selected range"],
  )
}

pipeline test_post_merge_drift_findings_hide_next_release_scope_noise(task: any) {
  const findings = post_merge_drift_deterministic_findings(
    [
      "working tree has no candidate release content",
      "release scope expected PR #4844 is absent from the selected range",
      "CHANGELOG.md top entry is v0.10.19; expected v0.10.20 for --bump patch",
    ],
  )
  assert_eq(
    findings,
    [
      "working tree has no candidate release content",
      "CHANGELOG.md top entry is v0.10.19; expected v0.10.20 for --bump patch",
    ],
  )
}

pipeline test_post_merge_paperwork_push_uses_force_only_for_existing_remote_branch(task: any) {
  assert_eq(
    post_merge_paperwork_push_args("paperwork/v0.10.19-changelog-fix", false),
    ["push", "-u", "origin", "paperwork/v0.10.19-changelog-fix"],
  )
  assert_eq(
    post_merge_paperwork_push_args("paperwork/v0.10.19-changelog-fix", true),
    ["push", "-u", "origin", "paperwork/v0.10.19-changelog-fix", "--force-with-lease"],
  )
}

fn fixture_shell(process: HarnessProcess, command: any) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

pipeline test_release_base_ref_preflight_ignores_deleted_narrow_refspec(
  harness: Harness,
  task: any,
) {
  const root = path_join(harness.fs.temp_dir(), "release-base-ref-" + harness.random.uuid_v7())
  const remote = path_join(root, "remote.git")
  const source = path_join(root, "source")
  const pin_checkout = path_join(root, "pin")
  const explicit_pin_checkout = path_join(root, "explicit-pin")
  fixture_shell(harness.process, "git init --bare -q '" + remote + "'")
  fixture_shell(harness.process, "git init -q '" + source + "'")
  fixture_shell(harness.process, "git -C '" + source + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + source + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + source + "' checkout -q -b main")
  harness.fs.write_text(path_join(source, "fixture.txt"), "base\n")
  fixture_shell(harness.process, "git -C '" + source + "' add fixture.txt")
  fixture_shell(harness.process, "git -C '" + source + "' commit -q -m base")
  const base_sha = trim(
    fixture_shell(harness.process, "git -C '" + source + "' rev-parse HEAD").stdout,
  )
  fixture_shell(harness.process, "git -C '" + source + "' remote add origin '" + remote + "'")
  fixture_shell(harness.process, "git -C '" + source + "' push -q -u origin main")
  fixture_shell(harness.process, "git -C '" + source + "' checkout -q -b release/v0.10.21")
  harness.fs.write_text(path_join(source, "release-only.txt"), "divergent release branch\n")
  fixture_shell(harness.process, "git -C '" + source + "' add release-only.txt")
  fixture_shell(harness.process, "git -C '" + source + "' commit -q -m release-only")
  const divergent_sha = trim(
    fixture_shell(harness.process, "git -C '" + source + "' rev-parse HEAD").stdout,
  )
  fixture_shell(harness.process, "git -C '" + source + "' push -q -u origin release/v0.10.21")
  fixture_shell(
    harness.process,
    "git clone -q --single-branch --branch release/v0.10.21 '" + remote + "' '" + pin_checkout
      + "'",
  )
  fixture_shell(
    harness.process,
    "git clone -q --single-branch --branch release/v0.10.21 '" + remote + "' '"
      + explicit_pin_checkout
      + "'",
  )
  fixture_shell(harness.process, "git -C '" + source + "' push -q origin --delete release/v0.10.21")
  const pin = resolve_pin_sha(
    harness.process,
    {
      mock: false,
      repo: pin_checkout,
      base: "main",
      mode: "ship-pr",
      yes_live_release: true,
      pin_sha_input: "",
      allow_base_drift: false,
    },
  )
  assert_eq(pin, base_sha)
  assert_eq(
    trim(
      fixture_shell(harness.process, "git -C '" + pin_checkout + "' rev-parse origin/main").stdout,
    ),
    base_sha,
  )
  const explicit_pin = resolve_pin_sha(
    harness.process,
    {
      mock: false,
      repo: explicit_pin_checkout,
      base: "main",
      mode: "ship-pr",
      yes_live_release: true,
      pin_sha_input: base_sha,
      allow_base_drift: false,
    },
  )
  assert_eq(explicit_pin, base_sha)
  assert_eq(
    trim(
      fixture_shell(
        harness.process,
        "git -C '" + explicit_pin_checkout + "' rev-parse origin/main",
      ).stdout,
    ),
    base_sha,
  )
  const divergent_error = try {
    resolve_pin_sha(
      harness.process,
      {
        mock: false,
        repo: explicit_pin_checkout,
        base: "main",
        mode: "ship-pr",
        yes_live_release: true,
        pin_sha_input: divergent_sha,
        allow_base_drift: false,
      },
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(divergent_error, "is not an ancestor of refreshed origin/main"))
  const allowed_divergent_pin = resolve_pin_sha(
    harness.process,
    {
      mock: false,
      repo: explicit_pin_checkout,
      base: "main",
      mode: "ship-pr",
      yes_live_release: true,
      pin_sha_input: divergent_sha,
      allow_base_drift: true,
    },
  )
  assert_eq(allowed_divergent_pin, divergent_sha)
}

/**
 * Pre-tag resume owns the prepared release checkout. The generic preflight
 * must return before probing or rewriting it, otherwise the resume path can
 * reject the release commit as "un-pushed" and never reach certification.
 */
pipeline test_pre_tag_resume_skips_generic_preflight_autoremediation(harness: Harness, task: any) {
  const run_id = "test-pre-tag-resume-preflight-" + harness.random.uuid_v7()
  release_preflight_autoremediate(
    harness,
    {
      mode: "ship-pr",
      yes_live_release: true,
      pre_tag_resume: true,
      mock: false,
      repo: "/definitely/not/a/repository",
      base: "main",
    },
    {next_version: ""},
    run_id,
  )
  assert_eq(
    harness.fs.exists(path_join(release_run_dir(harness.fs, run_id), "run-events.jsonl")),
    false,
  )
}

/**
 * The stale-branch remediation is a handful of git commands; the run/session
 * view gate compiles the exact release tree. A retry blocked only by a stale
 * local branch owner must reach preparation without paying for that compile
 * first, so the entrypoint has to call remediation before the gate.
 */
pipeline test_cheap_preflight_remediation_precedes_the_exact_tree_gate(
  harness: Harness,
  task: any,
) {
  const source = harness.fs.read_text(
    path_join(release_harness_root(harness.fs), "release_harn.harn"),
  )
  let preflight_line = -1
  let view_gate_line = -1
  let index = 0
  for line in split(source, "\n") {
    if preflight_line < 0 && contains(line, "release_preflight_autoremediate(") {
      preflight_line = index
    }
    if view_gate_line < 0 && contains(line, "release_run_session_view_gate(") {
      view_gate_line = index
    }
    index = index + 1
  }
  assert(preflight_line >= 0)
  assert(view_gate_line >= 0)
  assert(preflight_line < view_gate_line)
}
