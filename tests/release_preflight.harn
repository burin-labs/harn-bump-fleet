import { pr_numbers_from_commits, release_scope_findings } from "../lib/release_analysis"
import {
  normalize_release_analysis_checkout,
  release_analysis_checkout_plan,
  release_branch_resume_decision,
} from "../lib/release_checkout"
import {
  post_merge_drift_deterministic_findings,
  post_merge_paperwork_push_args,
} from "../lib/release_notes"
import { planner_credential_remediation } from "../lib/release_preflight"
import { parse_release_args, parse_release_scope_pr_numbers, usage } from "../lib/release_runtime"

pipeline test_planner_credential_remediation_points_at_with_env(task) {
  const text = planner_credential_remediation()
  // Names the documented seam and a runnable example, not just "set your keys".
  assert(contains(text, "scripts/with_env.sh"))
  assert(contains(text, "release_harn.harn"))
  // Spells out the discovery order so the operator knows which file to edit.
  assert(contains(text, "HARN_BUMP_FLEET_ENV_FILE"))
  assert(contains(text, ".env.local"))
}

pipeline test_usage_documents_credential_seam(task) {
  const text = usage()
  assert(contains(text, "Credentials"))
  assert(contains(text, "scripts/with_env.sh"))
}

pipeline test_release_scope_pr_numbers_accept_repeated_and_hash_forms(task) {
  assert_eq(parse_release_scope_pr_numbers(["4844", "#4843,4841", "4844"]), [4844, 4843, 4841])
  const cfg = parse_release_args(
    harness,
    [
      "--expect-pr",
      "4844",
      "--expect-pr",
      "#4843,4841",
      "--reject-pr",
      "4845",
      "--at-sha",
      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "--resume-head-sha",
      "5c98275c411a2cca50b4364e2b30f85942004329",
    ],
  )
  assert_eq(cfg.expected_prs, [4844, 4843, 4841])
  assert_eq(cfg.rejected_prs, [4845])
  assert_eq(cfg.resume_head_sha, "5c98275c411a2cca50b4364e2b30f85942004329")
}

pipeline test_resume_head_sha_requires_full_sha_and_at_sha(task) {
  const missing_pin = try {
    parse_release_args(harness, ["--resume-head-sha", "5c98275c411a2cca50b4364e2b30f85942004329"])
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(missing_pin, "requires --at-sha"))
  const short_sha = try {
    parse_release_args(harness, ["--at-sha", "HEAD", "--resume-head-sha", "5c98275c"])
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(short_sha, "full 40-hex"))
}

pipeline test_release_scope_pr_numbers_reject_invalid_values(task) {
  const err = try {
    parse_release_scope_pr_numbers(["4844,not-a-pr"])
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(err, "invalid release scope PR number"))
}

pipeline test_release_scope_findings_cover_missing_expected_and_rejected_present(task) {
  const findings = release_scope_findings({expected_prs: [4843, 4844], rejected_prs: [4845]}, [4843, 4845])
  const text = join(findings, "\n")
  assert(contains(text, "expected PR #4844"))
  assert(contains(text, "rejected PR #4845"))
  assert_eq(release_scope_findings({expected_prs: [4843], rejected_prs: [4845]}, [4843]), [])
}

pipeline test_release_scope_findings_compare_typed_pr_numbers(task) {
  const commits = join(
    [
      "630d862 chore: repair v0.10.19 changelog paperwork (#4851)",
      "0ceebcc fix: drain wait_command completion result (#4844)",
      "2956aae audit: align dispatch docs alias (#4843)",
      "f45b17a ci: keep cold-start budget off routine PRs (#4845)",
      "5c59c10 runtime: recover typed missing tool calls (#4841)",
      "bc26901 test: prior release support (#4840)",
      "0f3684d docs: release prep cleanup (#4838)",
      "0f3684d docs: release prep cleanup duplicate subject (#4838)",
    ],
    "\n",
  )
  const observed = pr_numbers_from_commits(commits)
  assert_eq(observed, [4851, 4844, 4843, 4845, 4841, 4840, 4838])
  assert_eq(
    release_scope_findings({expected_prs: [4841, 4845, 4843, 4844], rejected_prs: [4847]}, observed),
    [],
  )
  const contaminated = pr_numbers_from_commits(commits + "\nc419448 split package audit out of format CI (#4847)")
  assert_eq(
    release_scope_findings({expected_prs: [4841, 4845, 4843, 4844], rejected_prs: [4847]}, contaminated),
    ["release scope rejected PR #4847 is present in the selected range"],
  )
}

pipeline test_post_merge_drift_findings_hide_next_release_scope_noise(task) {
  const findings = post_merge_drift_deterministic_findings(
    [
      "working tree has no candidate release content",
      "release scope expected PR #4844 is absent from the selected range",
      "CHANGELOG.md top entry is v0.10.19; expected v0.10.20 for --bump patch",
    ],
  )
  assert_eq(
    findings,
    [
      "working tree has no candidate release content",
      "CHANGELOG.md top entry is v0.10.19; expected v0.10.20 for --bump patch",
    ],
  )
}

pipeline test_post_merge_paperwork_push_uses_force_only_for_existing_remote_branch(task) {
  assert_eq(
    post_merge_paperwork_push_args("paperwork/v0.10.19-changelog-fix", false),
    ["push", "-u", "origin", "paperwork/v0.10.19-changelog-fix"],
  )
  assert_eq(
    post_merge_paperwork_push_args("paperwork/v0.10.19-changelog-fix", true),
    ["push", "-u", "origin", "paperwork/v0.10.19-changelog-fix", "--force-with-lease"],
  )
}

pipeline test_pinned_release_analysis_detaches_clean_non_release_checkout(task) {
  const plan = release_analysis_checkout_plan(
    {
      current_branch: "paperwork/v0.10.19-changelog-fix",
      pin_sha_input: "630d862cdf6ee3fa8a3db6b71c3e4f5b0029c8b6",
      status: "",
    },
  )
  assert_eq(plan.action, "detach_pin")
}

pipeline test_pinned_release_analysis_refuses_dirty_non_release_checkout(task) {
  const plan = release_analysis_checkout_plan(
    {
      current_branch: "main",
      pin_sha_input: "630d862cdf6ee3fa8a3db6b71c3e4f5b0029c8b6",
      status: " M CHANGELOG.md\n",
    },
  )
  assert_eq(plan.action, "abort_dirty_pinned_checkout")
}

pipeline test_pinned_release_analysis_detaches_clean_release_checkout(task) {
  const plan = release_analysis_checkout_plan(
    {
      current_branch: "release/v0.10.20",
      current_version: "0.10.20",
      changelog_top: "0.10.20",
      latest_tag: "v0.10.19",
      pin_sha_input: "630d862cdf6ee3fa8a3db6b71c3e4f5b0029c8b6",
      status: "",
    },
  )
  assert_eq(plan.action, "detach_pin")
}

pipeline test_unpinned_release_analysis_keeps_prepared_release_branch(task) {
  const plan = release_analysis_checkout_plan(
    {
      current_branch: "release/v0.10.20",
      current_version: "0.10.20",
      changelog_top: "0.10.20",
      latest_tag: "v0.10.19",
      status: "",
    },
  )
  assert_eq(plan.action, "skip_prepared_release_branch")
}

pipeline test_release_branch_resume_decision_requires_prepared_branch_at_pin(task) {
  const resume = release_branch_resume_decision(
    {
      remote_exists: true,
      contains_pin: true,
      commit_count: 2,
      current_version: "0.10.21",
      changelog_top: "0.10.21",
      next_version: "0.10.21",
      expected_head: "5c98275c411a2cca50b4364e2b30f85942004329",
      remote_head: "5c98275c411a2cca50b4364e2b30f85942004329",
    },
  )
  assert_eq(resume.action, "resume")
  assert_eq(
    release_branch_resume_decision(
      {
        remote_exists: true,
        contains_pin: false,
        commit_count: 2,
        current_version: "0.10.21",
        changelog_top: "0.10.21",
        next_version: "0.10.21",
        expected_head: "5c98275c411a2cca50b4364e2b30f85942004329",
        remote_head: "5c98275c411a2cca50b4364e2b30f85942004329",
      },
    ).action,
    "fail",
  )
  assert_eq(
    release_branch_resume_decision(
      {
        remote_exists: true,
        contains_pin: true,
        commit_count: 0,
        current_version: "0.10.21",
        changelog_top: "0.10.21",
        next_version: "0.10.21",
        expected_head: "5c98275c411a2cca50b4364e2b30f85942004329",
        remote_head: "5c98275c411a2cca50b4364e2b30f85942004329",
      },
    ).action,
    "fail",
  )
  assert_eq(
    release_branch_resume_decision(
      {
        remote_exists: true,
        contains_pin: true,
        commit_count: 2,
        current_version: "0.10.21",
        changelog_top: "0.10.20",
        next_version: "0.10.21",
        expected_head: "5c98275c411a2cca50b4364e2b30f85942004329",
        remote_head: "5c98275c411a2cca50b4364e2b30f85942004329",
      },
    ).action,
    "fail",
  )
  assert_eq(
    release_branch_resume_decision(
      {remote_exists: false, expected_head: "5c98275c411a2cca50b4364e2b30f85942004329"},
    ).action,
    "fail",
  )
  assert_eq(
    release_branch_resume_decision(
      {remote_exists: true, contains_pin: false, commit_count: 0, next_version: "0.10.21"},
    ).action,
    "normal",
  )
  assert_eq(
    release_branch_resume_decision(
      {
        remote_exists: true,
        contains_pin: true,
        commit_count: 2,
        current_version: "0.10.21",
        changelog_top: "0.10.21",
        next_version: "0.10.21",
        remote_head: "5c98275c411a2cca50b4364e2b30f85942004329",
      },
    ).action,
    "fail",
  )
  assert_eq(
    release_branch_resume_decision(
      {
        remote_exists: true,
        contains_pin: true,
        commit_count: 2,
        current_version: "0.10.21",
        changelog_top: "0.10.21",
        next_version: "0.10.21",
        expected_head: "5c98275c411a2cca50b4364e2b30f85942004329",
        remote_head: "91f85927b932cc88b15019210c22677377997184",
      },
    ).action,
    "fail",
  )
}

fn fixture_shell(command) {
  const result = shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

pipeline test_pinned_release_analysis_normalizes_live_checkout_to_pin(task) {
  const root = path_join(harness.fs.temp_dir(), "release-pin-checkout-" + uuid_v7())
  const work = path_join(root, "work")
  fixture_shell("git init -q '" + work + "'")
  fixture_shell("git -C '" + work + "' config user.email test@example.com")
  fixture_shell("git -C '" + work + "' config user.name test")
  fixture_shell("git -C '" + work + "' checkout -q -b main")
  harness.fs.write_text(path_join(work, "file.txt"), "pinned\n")
  fixture_shell("git -C '" + work + "' add file.txt")
  fixture_shell("git -C '" + work + "' commit -q -m pinned")
  const pin = trim(fixture_shell("git -C '" + work + "' rev-parse HEAD").stdout)
  fixture_shell("git -C '" + work + "' checkout -q -b paperwork/v0.10.19-changelog-fix")
  harness.fs.write_text(path_join(work, "file.txt"), "paperwork\n")
  fixture_shell("git -C '" + work + "' commit -q -am paperwork")
  normalize_release_analysis_checkout(
    harness,
    {
      base: "main",
      mock: false,
      mode: "ship-pr",
      pin_sha: pin,
      pin_sha_input: pin,
      repo: work,
      yes_live_release: true,
    },
    "test-run",
  )
  assert_eq(trim(fixture_shell("git -C '" + work + "' rev-parse HEAD").stdout), pin)
  assert_eq(trim(fixture_shell("git -C '" + work + "' branch --show-current").stdout), "")
}
