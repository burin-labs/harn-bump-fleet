import {
  candidate_archive_receipt_reuse_decision,
  mock_candidate_archive_gate_adapter,
  run_candidate_archive_gate,
} from "../lib/candidate_archive_gate"
import {
  candidate_archive_receipt_overwrite_allowed,
  candidate_archive_receipt_write,
} from "../lib/candidate_archive_receipt"
import { release_candidate_archive_gate_config } from "../lib/release_execution"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const CANDIDATE_REF = "release-certify/" + SHA

pipeline test_candidate_archive_gate_green_from_mock_adapter(task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  assert_eq(config.completion_timeout_ms, 7200000)
  assert_eq(config.completion_interval_ms, 120000)
  const result = run_candidate_archive_gate(config, mock_candidate_archive_gate_adapter(config))
  assert_eq(result.success, true)
  assert_eq(result.run_id, 702)
  assert(contains(result.message, SHA))
}

pipeline test_candidate_archive_receipt_reuses_exact_success(harness: Harness, task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  const root = path_join(harness.fs.temp_dir(), "candidate-reuse-" + harness.random.uuid_v7())
  const path = path_join(root, "candidate-archive", SHA + ".json")
  const prior = candidate_archive_receipt_write(
    {fs: harness.fs, random: harness.random},
    path,
    "burin-labs/harn",
    {
      workflow: config.workflow,
      event: config.event,
      policy_ref: config.policy_ref,
      expected_policy_sha: config.expected_policy_sha,
      source_ref: config.source_ref,
      expected_source_sha: config.expected_source_sha,
      candidate_only: true,
      runner_profile: "policy",
      targets: "",
      completion_timeout_ms: config.completion_timeout_ms,
      completion_interval_ms: config.completion_interval_ms,
      transient_view_retry_max_attempts: 3,
      transient_view_retry_base_ms: 1,
      transient_view_retry_cap_ms: 5,
      run_id: 9001,
      run_url: "https://github.test/run/9001",
      observed_event: config.event,
      observed_head_branch: config.policy_ref,
      observed_head_sha: config.expected_policy_sha,
      reused: false,
    },
    "2026-07-27T00:00:00Z",
  )
  assert_eq(candidate_archive_receipt_reuse_decision(prior, "burin-labs/harn", config, []), "reuse")
  assert_eq(candidate_archive_receipt_overwrite_allowed(prior), false)
}

pipeline test_candidate_archive_receipt_rejects_ambiguous_active_runs(task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  assert_eq(
    candidate_archive_receipt_reuse_decision(nil, "burin-labs/harn", config, [11, 12]),
    "reject_ambiguous",
  )
  assert_eq(
    candidate_archive_receipt_reuse_decision(nil, "burin-labs/harn", config, [11]),
    "reject_ambiguous",
  )
  assert_eq(
    candidate_archive_receipt_reuse_decision(nil, "burin-labs/harn", config, []),
    "dispatch_new",
  )
}
