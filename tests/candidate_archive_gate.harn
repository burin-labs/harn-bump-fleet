import {
  CandidateArchiveGateAdapter,
  candidate_archive_receipt_reuse_decision,
  mock_candidate_archive_gate_adapter,
  run_candidate_archive_gate,
} from "../lib/candidate_archive_gate"
import {
  candidate_archive_receipt_overwrite_allowed,
  candidate_archive_receipt_write,
} from "../lib/candidate_archive_receipt"
import {
  candidate_archive_manifest_artifact_name,
  candidate_archive_policy_matches,
  candidate_archive_reuse_decision,
} from "../lib/candidate_archive_reuse"
import { release_candidate_archive_gate_config } from "../lib/release_execution"
import { PreTagBinaryGateJob } from "../lib/workflow_runs"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const CANDIDATE_REF = "release-certify/" + SHA

fn exact_adapter(
  config: any,
  jobs: list<PreTagBinaryGateJob>,
  conclusion: string = "success",
) -> CandidateArchiveGateAdapter {
  return {
    dispatch: fn(_config) { return {
      accepted: true,
      run_id: 44,
      url: "https://github.test/run/44",
      event: config.event,
      head_branch: config.policy_ref,
      head_sha: config.expected_policy_sha,
    } },
    view_run: fn(_run_id) { return Ok(
      {
        run: {
          id: 44,
          event: config.event,
          head_branch: config.policy_ref,
          head_sha: config.expected_policy_sha,
          status: "completed",
          conclusion: conclusion,
          url: "https://github.test/run/44",
        },
        jobs: jobs,
      },
    ) },
    wait: fn(_interval_ms) {
    },
  }
}

fn linux_job(config: any, fuse: string = "success", growth: string = "success") {
  return {
    name: config.target_job,
    status: "completed",
    conclusion: "success",
    steps: [
      {name: config.required_source_step, status: "completed", conclusion: "success"},
      {name: config.required_fuse_step, status: "completed", conclusion: fuse},
      {name: config.required_size_step, status: "completed", conclusion: growth},
    ],
  }
}

pipeline test_candidate_archive_gate_green_from_mock_adapter(task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  assert_eq(config.completion_timeout_ms, 7200000)
  assert_eq(config.completion_interval_ms, 120000)
  const result = run_candidate_archive_gate(config, mock_candidate_archive_gate_adapter(config))
  assert_eq(result.success, true)
  assert_eq(result.run_id, 702)
  assert(contains(result.message, SHA))
}

pipeline test_candidate_archive_gate_fails_when_linux_size_proof_is_missing(task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  const result = run_candidate_archive_gate(config, exact_adapter(config, []))
  assert_eq(result.success, false)
  assert(contains(result.message, config.target_job))
}

pipeline test_candidate_archive_gate_fails_when_distribution_fuse_fails(task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  const result = run_candidate_archive_gate(
    config,
    exact_adapter(config, [linux_job(config, "failure")]),
  )
  assert_eq(result.success, false)
  assert(contains(result.message, config.required_fuse_step))
}

pipeline test_candidate_archive_gate_fails_when_growth_step_is_skipped(task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  const result = run_candidate_archive_gate(
    config,
    exact_adapter(config, [linux_job(config, "success", "skipped")]),
  )
  assert_eq(result.success, false)
  assert(contains(result.message, config.required_size_step))
}

pipeline test_candidate_archive_gate_fails_on_cancelled_run_before_reading_jobs(task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  const result = run_candidate_archive_gate(
    config,
    exact_adapter(config, [linux_job(config)], "cancelled"),
  )
  assert_eq(result.success, false)
  assert(contains(result.message, "cancelled"))
}

pipeline test_candidate_archive_receipt_reuses_exact_success(harness: Harness, task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  const root = path_join(harness.fs.temp_dir(), "candidate-reuse-" + harness.random.uuid_v7())
  const path = path_join(root, "candidate-archive", SHA + ".json")
  const prior = candidate_archive_receipt_write(
    {fs: harness.fs, random: harness.random},
    path,
    "burin-labs/harn",
    {
      workflow: config.workflow,
      event: config.event,
      policy_ref: config.policy_ref,
      expected_policy_sha: config.expected_policy_sha,
      source_ref: config.source_ref,
      expected_source_sha: config.expected_source_sha,
      target_job: config.target_job,
      required_source_step: config.required_source_step,
      required_fuse_step: config.required_fuse_step,
      required_size_step: config.required_size_step,
      candidate_only: true,
      runner_profile: "policy",
      targets: "",
      completion_timeout_ms: config.completion_timeout_ms,
      completion_interval_ms: config.completion_interval_ms,
      transient_view_retry_max_attempts: 3,
      transient_view_retry_base_ms: 1,
      transient_view_retry_cap_ms: 5,
      run_id: 9001,
      run_url: "https://github.test/run/9001",
      observed_event: config.event,
      observed_head_branch: config.policy_ref,
      observed_head_sha: config.expected_policy_sha,
      reused: false,
    },
    "2026-07-27T00:00:00Z",
  )
  assert_eq(candidate_archive_receipt_reuse_decision(prior, "burin-labs/harn", config, []), "reuse")
  assert_eq(candidate_archive_receipt_overwrite_allowed(prior), false)
}

pipeline test_candidate_archive_receipt_rejects_ambiguous_active_runs(task: any) {
  const config = release_candidate_archive_gate_config("main", SHA, CANDIDATE_REF, SHA)
  assert_eq(
    candidate_archive_receipt_reuse_decision(nil, "burin-labs/harn", config, [11, 12]),
    "reject_ambiguous",
  )
  assert_eq(
    candidate_archive_receipt_reuse_decision(nil, "burin-labs/harn", config, [11]),
    "reject_ambiguous",
  )
  assert_eq(
    candidate_archive_receipt_reuse_decision(nil, "burin-labs/harn", config, []),
    "dispatch_new",
  )
}

fn manifest_row(run_id: int, head: string, expired: bool = false, name: any = nil) {
  return {
    id: run_id + 900000,
    name: name ?? candidate_archive_manifest_artifact_name(SHA),
    expired: expired,
    run_id: run_id,
    run_head_sha: head,
  }
}

const CERTIFIED_POLICY = "6308bebbb5e16b2e4fb05c2e5b0deddf89b823a2"

const CURRENT_POLICY = "48ed6e2e3395579bd710f0b507da3c6375e234b6"

/**
 * The v0.10.131 rebuild. A resume of a certified candidate found an unexpired
 * `candidate-archive-manifest-<sha>` from a run under an earlier policy commit
 * whose archive workflow, runner policy, and matrix script were byte-identical,
 * and dispatched five fresh platform builds anyway.
 *
 * Reuse keys on the source-qualified artifact name and on archive-policy
 * content. Restore the commit-equality key and this fails.
 */
pipeline test_certified_candidate_archive_is_reused_not_rebuilt(task: any) {
  const config = release_candidate_archive_gate_config("main", CURRENT_POLICY, CANDIDATE_REF, SHA)
  const decision = candidate_archive_reuse_decision(
    [manifest_row(33988090262, CERTIFIED_POLICY)],
    config,
    { _head -> return true },
  )
  assert_eq(decision.action, "reuse")
  assert_eq(decision.run_id, 33988090262)
  assert_eq(decision.run_head_sha, CERTIFIED_POLICY)
  assert_eq(decision.usable, 1)
  // Content identity, not commit identity: the three archive-policy blobs were
  // the same across both commits, which is why the rebuild was pure waste.
  const same = {
    ".github/release-runner-policy.json": "f5b280487606eccb2c4d8fc28fe874fa18c4f0d3",
    ".github/workflows/build-release-binaries.yml": "1e8af6b55ed1a631d3c6f648ae57146ff114f2c2",
    "scripts/release_runner_matrix.sh": "abd4680596d69dc9f61126ec31bed73238ecee7c",
  }
  assert_eq(candidate_archive_policy_matches(same, same), true)
}

/**
 * The negative control. A resume with no certified archive for this candidate
 * must still build, and so must one whose only archive has expired — the
 * binaries an expired artifact named are gone.
 */
pipeline test_resume_without_a_certified_archive_still_builds(task: any) {
  const config = release_candidate_archive_gate_config("main", CURRENT_POLICY, CANDIDATE_REF, SHA)
  const nothing = candidate_archive_reuse_decision([], config, { _head -> return true })
  assert_eq(nothing.action, "dispatch_new")
  assert_eq(nothing.run_id, 0)
  assert_eq(nothing.usable, 0)
  const expired = candidate_archive_reuse_decision(
    [manifest_row(33988090262, CERTIFIED_POLICY, true)],
    config,
    { _head -> return true },
  )
  assert_eq(expired.action, "dispatch_new")
  // Another commit's archive is not this candidate's archive.
  const other = candidate_archive_reuse_decision(
    [manifest_row(33988090262, CERTIFIED_POLICY, false, "candidate-archive-manifest-" + "b" * 40)],
    config,
    { _head -> return true },
  )
  assert_eq(other.action, "dispatch_new")
  // A real archive-policy change must rebuild.
  const policy_changed = candidate_archive_reuse_decision(
    [manifest_row(33988090262, CERTIFIED_POLICY)],
    config,
    { _head -> return false },
  )
  assert_eq(policy_changed.action, "dispatch_new")
}

/** Two distinct archives for one candidate are refused, never resolved by age. */
pipeline test_ambiguous_certified_archives_are_refused(task: any) {
  const config = release_candidate_archive_gate_config("main", CURRENT_POLICY, CANDIDATE_REF, SHA)
  const decision = candidate_archive_reuse_decision(
    [manifest_row(1, CERTIFIED_POLICY), manifest_row(2, CURRENT_POLICY)],
    config,
    { _head -> return true },
  )
  assert_eq(decision.action, "reject_ambiguous")
  assert_eq(decision.usable, 2)
  assert(contains(decision.reason, "refusing to choose one"))
}

/**
 * An unread archive policy must never read as a matching one. Reuse on an
 * empty census is the one failure here that ships binaries nobody built.
 */
pipeline test_unread_archive_policy_never_matches(task: any) {
  assert_eq(candidate_archive_policy_matches({}, {}), false)
  const full = {
    ".github/release-runner-policy.json": "a" * 40,
    ".github/workflows/build-release-binaries.yml": "b" * 40,
    "scripts/release_runner_matrix.sh": "c" * 40,
  }
  assert_eq(candidate_archive_policy_matches(full, full), true)
  assert_eq(candidate_archive_policy_matches(full, {}), false)
  const partial = {".github/release-runner-policy.json": "a" * 40}
  assert_eq(candidate_archive_policy_matches(full, partial), false)
}

/** A reused run is not refused for having run under an earlier policy commit. */
pipeline test_reused_run_passes_the_policy_identity_assertion(task: any) {
  const config = release_candidate_archive_gate_config("main", CURRENT_POLICY, CANDIDATE_REF, SHA)
  const adapter: CandidateArchiveGateAdapter = {
    dispatch: fn(_config) { return {
      accepted: true,
      run_id: 33988090262,
      url: "https://github.test/run/33988090262",
      event: config.event,
      head_branch: config.policy_ref,
      // The certified run's own head: an earlier policy commit.
      head_sha: CERTIFIED_POLICY,
      reused: true,
    } },
    view_run: fn(_run_id) { return Ok(
      {
        run: {
          id: 33988090262,
          event: config.event,
          head_branch: config.policy_ref,
          head_sha: CERTIFIED_POLICY,
          status: "completed",
          conclusion: "success",
          url: "https://github.test/run/33988090262",
        },
        jobs: [linux_job(config)],
      },
    ) },
    wait: fn(_interval_ms) {
    },
  }
  const result = run_candidate_archive_gate(config, adapter)
  assert_eq(result.success, true)
  assert_eq(result.run_id, 33988090262)
  assert_eq(result.phase, "complete")
}

/**
 * Two archives of one candidate are not interchangeable. Runs 33988090262 and
 * 33998624166 both built ab5e42aa under byte-identical archive policy, both
 * manifests unexpired, and all five binaries differ by sha256 in every target:
 * the builds are not reproducible. Picking the newest would be a guess about
 * which bytes ship, so an operator names the certified run and the harness
 * only proves the choice is well formed.
 */
pipeline test_operator_pins_which_certified_archive_ships(task: any) {
  const config = release_candidate_archive_gate_config("main", CURRENT_POLICY, CANDIDATE_REF, SHA)
  const both = [
    manifest_row(33988090262, CERTIFIED_POLICY),
    manifest_row(33998624166, CURRENT_POLICY),
  ]
  // Unpinned, this is refused, and the refusal says why they are not
  // interchangeable and how to settle it.
  const unpinned = candidate_archive_reuse_decision(both, config, { _head -> return true })
  assert_eq(unpinned.action, "reject_ambiguous")
  assert(contains(unpinned.reason, "--candidate-archive-run-id"))
  assert(contains(unpinned.reason, "not interchangeable"))
  // Pinned, the named run is adopted and the alternatives are still counted.
  const pinned = candidate_archive_reuse_decision(
    both,
    config,
    { _head -> return true },
    33988090262,
  )
  assert_eq(pinned.action, "reuse")
  assert_eq(pinned.run_id, 33988090262)
  assert_eq(pinned.run_head_sha, CERTIFIED_POLICY)
  assert_eq(pinned.usable, 2)
}

/**
 * The pin selects, it never widens. A run the census does not vouch for is
 * refused however explicitly it is named.
 */
pipeline test_a_pin_cannot_admit_an_archive_the_census_refuses(task: any) {
  const config = release_candidate_archive_gate_config("main", CURRENT_POLICY, CANDIDATE_REF, SHA)
  // Named run is not in the census at all.
  const absent = candidate_archive_reuse_decision(
    [manifest_row(33988090262, CERTIFIED_POLICY)],
    config,
    { _head -> return true },
    999,
  )
  assert_eq(absent.action, "reject_ambiguous")
  assert(contains(absent.reason, "pinned archive run 999"))
  assert(contains(absent.reason, "33988090262"))
  // Named run exists but its archive has expired.
  const expired = candidate_archive_reuse_decision(
    [manifest_row(33988090262, CERTIFIED_POLICY, true)],
    config,
    { _head -> return true },
    33988090262,
  )
  assert_eq(expired.action, "reject_ambiguous")
  assert(contains(expired.reason, "none were found"))
  // Named run exists but its archive policy does not match.
  const wrong_policy = candidate_archive_reuse_decision(
    [manifest_row(33988090262, CERTIFIED_POLICY)],
    config,
    { _head -> return false },
    33988090262,
  )
  assert_eq(wrong_policy.action, "reject_ambiguous")
  // Named run belongs to another candidate.
  const other = candidate_archive_reuse_decision(
    [manifest_row(33988090262, CERTIFIED_POLICY, false, "candidate-archive-manifest-" + "b" * 40)],
    config,
    { _head -> return true },
    33988090262,
  )
  assert_eq(other.action, "reject_ambiguous")
}
