import { with_temp_dir } from "std/testing"
import {
  ReleasePostMergeDriftEvidence,
  detect_post_merge_drift_from_git,
  post_merge_drift_decision,
  post_merge_drift_evidence_from_git,
} from "../lib/release_notes"

fn sh(harness: HarnessProcess, command) {
  const result = harness.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn with_recreated_fold_fixture(
  harness: {fs: HarnessFs, process: HarnessProcess},
  tag_kind: string,
  stale_local_tag: bool,
  body,
) {
  return with_temp_dir(
    harness.fs,
    { root ->
      const origin = path_join(root, "origin.git")
      const work = path_join(root, "work")
      const pin_changelog =
        "# Changelog\n\n## Unreleased\n\n- Pin-time release planning note.\n\n## v1.2.2\n\n- Prior release.\n"
      const released_changelog =
        "# Changelog\n\n## Unreleased\n\n- Next release work.\n\n## v1.2.3\n\n- Shipped parser repair.\n\n## v1.2.2\n\n- Prior release.\n"
      sh(harness.process, "git init --bare -q '" + origin + "'")
      sh(harness.process, "git init -q '" + work + "'")
      sh(harness.process, "git -C '" + work + "' config user.email test@example.com")
      sh(harness.process, "git -C '" + work + "' config user.name test")
      sh(harness.process, "git -C '" + work + "' checkout -q -b main")
      harness.fs.write_text(path_join(work, "CHANGELOG.md"), pin_changelog)
      sh(harness.process, "git -C '" + work + "' add CHANGELOG.md")
      sh(harness.process, "git -C '" + work + "' commit -q -m pin")
      sh(harness.process, "git -C '" + work + "' remote add origin '" + origin + "'")
      sh(harness.process, "git -C '" + work + "' push -q -u origin main")
      sh(harness.process, "git --git-dir='" + origin + "' symbolic-ref HEAD refs/heads/main")
      sh(harness.process, "git -C '" + work + "' checkout -q -b release/v1.2.3")
      harness.fs.write_text(path_join(work, "CHANGELOG.md"), released_changelog)
      sh(harness.process, "git -C '" + work + "' commit -q -am release")
      if tag_kind == "annotated" {
        sh(harness.process, "git -C '" + work + "' tag -a v1.2.3 -m release")
      } else {
        sh(harness.process, "git -C '" + work + "' tag v1.2.3")
      }
      sh(harness.process, "git -C '" + work + "' push -q origin refs/tags/v1.2.3")
      if stale_local_tag {
        sh(harness.process, "git -C '" + work + "' tag -d v1.2.3")
        sh(harness.process, "git -C '" + work + "' tag v1.2.3 main")
      }
      sh(harness.process, "git -C '" + work + "' checkout -q main")
      harness.fs.write_text(path_join(work, "CHANGELOG.md"), released_changelog)
      sh(harness.process, "git -C '" + work + "' commit -q -am recreated-fold")
      sh(harness.process, "git -C '" + work + "' push -q origin main")
      sh(harness.process, "git -C '" + work + "' fetch -q origin main")
      return body({origin: origin, work: work})
    },
  )
}

fn recreated_fold_facts(harness: {env: HarnessEnv, process: HarnessProcess}, fixture) {
  const cfg = {mock: false, repo: fixture.work, base: "main"}
  const evidence = post_merge_drift_evidence_from_git(harness, cfg, "1.2.3")
  if evidence == nil {
    throw "expected remote tag evidence"
  }
  const without_published_tag: ReleasePostMergeDriftEvidence = {
    tag: evidence.tag,
    version: evidence.version,
    original_pin: evidence.original_pin,
    pin_unreleased: evidence.pin_unreleased,
    current_section: evidence.current_section,
    published_tag_section: "",
    paperwork_branch: evidence.paperwork_branch,
  }
  return {
    pin_unreleased: trim(evidence.pin_unreleased),
    current_section: trim(evidence.current_section),
    published_tag_section: trim(evidence.published_tag_section),
    without_published_action: post_merge_drift_decision(without_published_tag).action,
    action: post_merge_drift_decision(evidence).action,
    detected: detect_post_merge_drift_from_git(harness, cfg, "1.2.3"),
  }
}

pipeline test_lightweight_remote_tag_ignores_stale_local_tag(harness: Harness, _task) {
  with_recreated_fold_fixture(
    {fs: harness.fs, process: harness.process},
    "lightweight",
    true,
    { fixture ->
      const facts = recreated_fold_facts({env: harness.env, process: harness.process}, fixture)
      assert_ne(facts.pin_unreleased, facts.current_section)
      assert_eq(facts.current_section, facts.published_tag_section)
      assert_eq(facts.without_published_action, "drift")
      assert_eq(facts.action, "no_drift")
      assert_eq(facts.detected, nil)
    },
  )
}

pipeline test_annotated_remote_tag_ignores_stale_local_tag(harness: Harness, _task) {
  with_recreated_fold_fixture(
    {fs: harness.fs, process: harness.process},
    "annotated",
    true,
    { fixture ->
      const facts = recreated_fold_facts({env: harness.env, process: harness.process}, fixture)
      assert_ne(facts.pin_unreleased, facts.current_section)
      assert_eq(facts.current_section, facts.published_tag_section)
      assert_eq(facts.without_published_action, "drift")
      assert_eq(facts.action, "no_drift")
      assert_eq(facts.detected, nil)
    },
  )
}

pipeline test_missing_remote_tag_object_fails_closed(harness: Harness, _task) {
  with_recreated_fold_fixture(
    {fs: harness.fs, process: harness.process},
    "lightweight",
    false,
    { fixture ->
      harness.fs.write_text(
        path_join(fixture.origin, "refs", "tags", "v1.2.3"),
        "1111111111111111111111111111111111111111\n",
      )
      const cfg = {mock: false, repo: fixture.work, base: "main"}
      assert_eq(
        post_merge_drift_evidence_from_git(
          {env: harness.env, process: harness.process},
          cfg,
          "1.2.3",
        ),
        nil,
      )
    },
  )
}
