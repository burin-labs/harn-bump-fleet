import {
  ReleasePostMergeDriftEvidence,
  detect_post_merge_drift_from_git,
  post_merge_drift_decision,
  post_merge_drift_evidence_from_git,
} from "../lib/release_notes"

fn sh(command) {
  const result = shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn recreated_fold_fixture() {
  const root = path_join(harness.fs.temp_dir(), "post-merge-drift-" + uuid_v7())
  const origin = path_join(root, "origin.git")
  const work = path_join(root, "work")
  const pin_changelog = "# Changelog\n\n## Unreleased\n\n- Pin-time release planning note.\n\n## v1.2.2\n\n- Prior release.\n"
  const released_changelog = "# Changelog\n\n## Unreleased\n\n- Next release work.\n\n## v1.2.3\n\n- Shipped parser repair.\n\n## v1.2.2\n\n- Prior release.\n"
  sh("git init --bare -q '" + origin + "'")
  sh("git init -q '" + work + "'")
  sh("git -C '" + work + "' config user.email test@example.com")
  sh("git -C '" + work + "' config user.name test")
  sh("git -C '" + work + "' checkout -q -b main")
  harness.fs.write_text(path_join(work, "CHANGELOG.md"), pin_changelog)
  sh("git -C '" + work + "' add CHANGELOG.md")
  sh("git -C '" + work + "' commit -q -m pin")
  sh("git -C '" + work + "' remote add origin '" + origin + "'")
  sh("git -C '" + work + "' push -q -u origin main")
  sh("git --git-dir='" + origin + "' symbolic-ref HEAD refs/heads/main")
  sh("git -C '" + work + "' checkout -q -b release/v1.2.3")
  harness.fs.write_text(path_join(work, "CHANGELOG.md"), released_changelog)
  sh("git -C '" + work + "' commit -q -am release")
  sh("git -C '" + work + "' tag v1.2.3")
  sh("git -C '" + work + "' push -q origin refs/tags/v1.2.3")
  sh("git -C '" + work + "' checkout -q main")
  harness.fs.write_text(path_join(work, "CHANGELOG.md"), released_changelog)
  sh("git -C '" + work + "' commit -q -am recreated-fold")
  sh("git -C '" + work + "' push -q origin main")
  sh("git -C '" + work + "' fetch -q origin main")
  return {root: root, work: work}
}

pipeline test_recreated_fold_matching_published_tag_is_not_post_merge_drift(task) {
  const fixture = recreated_fold_fixture()
  const cfg = {mock: false, repo: fixture.work, base: "main"}
  const evidence = post_merge_drift_evidence_from_git(cfg, "1.2.3")
  assert(evidence != nil)
  assert_ne(trim(evidence.pin_unreleased), trim(evidence.current_section))
  assert_eq(trim(evidence.current_section), trim(evidence.published_tag_section))
  const without_published_tag: ReleasePostMergeDriftEvidence = {
    tag: evidence.tag,
    version: evidence.version,
    original_pin: evidence.original_pin,
    pin_unreleased: evidence.pin_unreleased,
    current_section: evidence.current_section,
    published_tag_section: "",
    paperwork_branch: evidence.paperwork_branch,
  }
  assert_eq(post_merge_drift_decision(without_published_tag).action, "drift")
  assert_eq(post_merge_drift_decision(evidence).action, "no_drift")
  assert_eq(detect_post_merge_drift_from_git(cfg, "1.2.3"), nil)
  sh("rm -rf '" + fixture.root + "'")
}
