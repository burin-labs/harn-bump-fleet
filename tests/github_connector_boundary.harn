import { command_run } from "std/command"
import {
  github_branch_commit,
  github_branch_head,
  github_claim_ref,
  github_disable_auto_merge,
  github_enable_auto_merge,
  github_file_text_at_ref,
  github_latest_release_tag,
  github_pr_close,
  github_pr_mergeability,
  github_pr_upsert,
  github_release_at_tag,
  github_release_body_edit,
  github_release_ref,
} from "../lib/github"
import {
  SignedBotPullRequest,
  load_pr_signature_metadata,
  load_queued_pr_numbers,
  rewrite_plan,
} from "../lib/signed_bot_prs"
import { GithubClientOptions } from "harn-github-connector/default"
import { github_commit_worktree } from "harn-github-connector/worktree"

/**
 * Every fleet call into the GitHub connector, exercised through the real
 * dispatch path.
 *
 * `harn check` does not verify call arity or field names across a package
 * boundary (burin-labs/harn#6172), so a connector major bump can leave every
 * call site on the old shape and still report clean. The fleet's other tests
 * cannot catch it either: they stub the fleet's own wrappers rather than the
 * connector underneath them.
 *
 * The discriminator is *where* each call fails. A connector operation validates
 * its request record before it builds a URL or reads a credential, so a
 * wrapper that still passes v0.6.x positional arguments fails as `schema_drift`
 * — the record it hands over is empty. A correctly shaped one gets past that
 * and fails at the next gate instead. Asking which gate rejected it needs no
 * credentials and no network, so it is the same answer on a laptop and on a
 * runner that has neither.
 *
 * The endpoints are still mocked. Nothing here should reach GitHub, and on a
 * machine that happens to be authenticated it otherwise would.
 */
const BASE = "https://github.test"

/** An endpoint identity the test owns, so no run needs ambient credentials. */
fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "boundary-test-token"}
}

const SLUG = "octo-org/octo-repo"

fn absent(testing: HarnessTesting, method: string, url: string) {
  testing.http_mock(method, url, {status: 404, body: json_stringify({message: "Not Found"})})
}

/** The request resolved to the exact URL the mock answers, and nothing else. */
fn reached(result) -> bool {
  return is_err(result) && (unwrap_err(result)?.http_status ?? 0) == 404
}

pipeline test_repository_reads_reach_their_exact_endpoints(harness: Harness, task) {
  harness.testing.http_mock_clear()
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/branches/release%2Fv1.2.3")
  assert(reached(github_branch_head(harness, SLUG, "release/v1.2.3", options())))
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo")
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/releases/tags/v1.2.3")
  assert(reached(github_release_at_tag(harness, SLUG, "v1.2.3", options())))
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/releases/latest")
  const latest = try {
    github_latest_release_tag(harness, SLUG, options())
  }
  assert(is_err(latest))
  assert(contains(to_string(unwrap_err(latest)), "404"))
}

pipeline test_a_file_read_carries_its_path_and_ref(harness: Harness, task) {
  // The path and ref ride in different halves of the request — one in the URL,
  // one in the query — so a record that loses either still produces a URL.
  harness.testing.http_mock_clear()
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo")
  absent(
    harness.testing,
    "GET",
    BASE + "/repos/octo-org/octo-repo/contents/CHANGELOG.md?ref=refs%2Fheads%2Fmain",
  )
  const read = try {
    github_file_text_at_ref(harness, SLUG, "CHANGELOG.md", "refs/heads/main", options())
  }
  assert(is_err(read))
  assert(contains(to_string(unwrap_err(read)), "404"))
}

pipeline test_pull_request_operations_carry_their_number(harness: Harness, task) {
  harness.testing.http_mock_clear()
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/pulls/42")
  assert(reached(github_pr_mergeability(harness, SLUG, 42, options())))
  absent(harness.testing, "POST", BASE + "/repos/octo-org/octo-repo/issues/42/comments")
  absent(harness.testing, "PATCH", BASE + "/repos/octo-org/octo-repo/pulls/42")
  assert_eq(
    contains(
      to_string(github_pr_close(harness, SLUG, 42, "superseded", options())),
      "schema_drift",
    ),
    false,
  )
}

pipeline test_leased_mutations_carry_their_lease(harness: Harness, task) {
  // These are the head-sensitive calls. A lease that does not survive into the
  // request record is worse than a wrong URL: the mutation would still be
  // attempted, just without the guard that makes it safe.
  harness.testing.http_mock_clear()
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo")
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/releases/tags/v1.2.3")
  const edited = github_release_body_edit(
    harness,
    SLUG,
    "v1.2.3",
    "body",
    {
      release_id: 7,
      tag_ref_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      tag_target_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      tag_target_type: "commit",
    },
    options(),
  )
  assert(reached(edited))
  absent(harness.testing, "POST", BASE + "/graphql")
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/branches/main")
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/pulls/42")
  assert(reached(github_enable_auto_merge(harness, SLUG, 42, "abc123", "squash", options())))
  assert(
    reached(
      github_disable_auto_merge(
        harness,
        {
          slug: SLUG,
          pull_number: 42,
          expected_head_oid: "abc123",
          base_branch: "main",
          expected_base_oid: "def456",
          restore_merge_method: "squash",
        },
        options(),
      ),
    ),
  )
}

pipeline test_lane_refs_resolve_to_the_ref_endpoints(harness: Harness, task) {
  // The lane lock reaches the connector through `import * as`, which `harn
  // check` does not type-check at all (burin-labs/harn#6172). Nothing but a
  // request that lands on an exact URL says these two call sites are shaped
  // right.
  harness.testing.http_mock_clear()
  // A claim carrying a payload reads the base ref before it can mint anything,
  // so that is the first URL it must resolve.
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/git/ref/heads/main")
  assert(
    reached(
      github_claim_ref(
        harness,
        SLUG,
        "refs/release-lane/v1.2.3",
        {payload: {message: "release-lane v1.2.3 run=019fc846", base_ref: "refs/heads/main"}},
        options(),
      ),
    ),
  )
  // A release reads the ref it is about to delete. An absent ref is the
  // intended end state, so this one comes back Ok, and reaching that answer at
  // all means the URL resolved.
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/git/ref/release-lane/v1.2.3")
  const released = github_release_ref(
    harness,
    SLUG,
    "refs/release-lane/v1.2.3",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    options(),
  )
  assert_eq(unwrap(released).reason, "already_absent")
}

pipeline test_projection_writes_reach_their_exact_endpoints(harness: Harness, task) {
  // The convergence loop's three mutations. Each writes to a repository the
  // fleet does not own, so a request record that loses a field must fail before
  // the URL exists rather than after.
  //
  // A claim naming an oid mints nothing, so unlike the lane lock above it goes
  // straight to the ref create.
  harness.testing.http_mock_clear()
  absent(harness.testing, "POST", BASE + "/repos/octo-org/octo-repo/git/refs")
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/git/ref/heads/automation/x")
  assert(
    reached(
      github_claim_ref(
        harness,
        SLUG,
        "refs/heads/automation/x",
        {oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
        options(),
      ),
    ),
  )
  absent(harness.testing, "POST", BASE + "/graphql")
  assert(
    reached(
      github_branch_commit(
        harness,
        {
          slug: SLUG,
          branch: "automation/x",
          expected_head_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          headline: "chore: restore fleet-owned projections",
          body: "body",
          files: [{path: "PROJECTION.yml", contents: "name: projection\n"}],
        },
        options(),
      ),
    ),
  )
  absent(
    harness.testing,
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head=octo-org%3Aautomation%2Fx&base=main&per_page=2",
  )
  assert(
    reached(
      github_pr_upsert(
        harness,
        {
          slug: SLUG,
          head: "automation/x",
          base: "main",
          title: "chore: restore fleet-owned projections",
          body: "body",
          expected_head_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        },
        options(),
      ),
    ),
  )
}

fn git_ok(tools: HarnessTools, root: string, args: list<string>) {
  const result = command_run(tools, ["git", "-C", root] + args)
  if !result.success {
    throw "fixture git " + join(args, " ") + " failed: " + trim(to_string(result.stderr ?? ""))
  }
}

/**
 * One commit and one staged change, which is the state `sign_bot_prs` prepares.
 *
 * `soft-reset-to-base` leaves the PR's tree in the index with `HEAD` at the
 * base, so the delta the publish derives is index-against-`HEAD`. Reproducing
 * that exactly is what makes the request reach the network at all: an empty
 * delta is a clean local outcome that sends nothing.
 */
fn staged_repo(harness: Harness) -> string {
  const root = path_join(harness.fs.temp_dir(), "signed-bot-boundary-" + harness.random.uuid_v7())
  if !command_run(harness.tools, ["git", "init", "-q", root]).success {
    throw "fixture git init failed at " + root
  }
  // `gc.autoDetach` defaults on, so a commit can fork a repack that outlives it
  // and keeps writing while teardown removes the directory.
  git_ok(harness.tools, root, ["config", "gc.auto", "0"])
  git_ok(harness.tools, root, ["config", "user.email", "boundary@example.test"])
  git_ok(harness.tools, root, ["config", "user.name", "Boundary Test"])
  git_ok(harness.tools, root, ["config", "commit.gpgsign", "false"])
  harness.fs.write_text(path_join(root, "CHANGELOG.md"), "# base\n")
  git_ok(harness.tools, root, ["add", "CHANGELOG.md"])
  git_ok(harness.tools, root, ["commit", "-q", "-m", "base"])
  harness.fs.write_text(path_join(root, "CHANGELOG.md"), "# base\n\n## 1.0.1\n")
  git_ok(harness.tools, root, ["add", "CHANGELOG.md"])
  return root
}

fn boundary_pr(branch: string, head_oid: string) -> SignedBotPullRequest {
  return {
    slug: SLUG,
    number: 42,
    title: "build(deps): bump example from 1.0.0 to 1.0.1",
    url: "https://github.test/octo-org/octo-repo/pull/42",
    state: "open",
    base_ref_name: "main",
    head_ref_name: branch,
    head_oid: head_oid,
    head_repo: SLUG,
    head_owner: "octo-org",
    author_login: "dependabot[bot]",
    author_type: "Bot",
    merge_state_status: "blocked",
    auto_merge_enabled: false,
    cross_repository: false,
    commits: [],
  }
}

pipeline test_the_merge_queue_read_is_unwrapped_before_it_is_used(harness: Harness, task) {
  // Unlike the request-shape checks above, this one needs a *successful*
  // response: the defect it guards is reading a field off a `Result` that was
  // never unwrapped, which yields `nil` rather than failing, and no error path
  // can show that.
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            repository: {
              mergeQueue: {
                url: "https://github.test/queue",
                entries: {
                  nodes: [
                    {
                      id: "MQE_1",
                      position: 1,
                      state: "AWAITING_CHECKS",
                      enqueuedAt: "2026-08-05T03:07:17Z",
                      headOid: "56de5b80f593c62ac36f605fb258ea9c4206c3ea",
                      pullRequest: {
                        number: 999901,
                        url: "https://github.test/pull/999901",
                        baseRefName: "main",
                      },
                    },
                  ],
                },
              },
            },
          },
        },
      ),
    },
  )
  assert_eq(load_queued_pr_numbers(harness, SLUG, "main", options()), [999901])
}

pipeline test_the_signature_metadata_read_reaches_its_pull_request(harness: Harness, task) {
  // `github_pr_view` is the read every rewrite decision is made from, and it is
  // reached here through `load_pr_signature_metadata` rather than directly, so
  // the arity of that hop is exercised too.
  harness.testing.http_mock_clear()
  absent(harness.testing, "GET", BASE + "/repos/octo-org/octo-repo/pulls/42")
  const read = try {
    load_pr_signature_metadata(harness, SLUG, 42, options())
  }
  assert(is_err(read))
  const failure = to_string(unwrap_err(read))
  assert(contains(failure, "404"), "the request resolved to the mocked pull request")
  assert(!contains(failure, "schema_drift"), "the record reached the endpoint intact")
  assert_eq(len(harness.testing.http_mock_calls()), 1)
}

pipeline test_a_signed_rewrite_carries_its_branch_lease(harness: Harness, task) {
  // The rewrite reaches the connector through a second export (`worktree`), and
  // hands it the largest request record the fleet builds for any connector call.
  // `harn check` verifies neither across the package boundary, so only a request
  // that lands on an exact URL — still carrying the lease — says this call site
  // is shaped right.
  harness.testing.http_mock_clear()
  const head_oid = "abcdef1234567890abcdef1234567890abcdef12"
  const repo_dir = staged_repo(harness)
  const plan = rewrite_plan(
    harness.random,
    SLUG,
    boundary_pr("dependabot/cargo/example-1.0.1", head_oid),
    {home: "/nonexistent", temp_path: repo_dir},
  )
  absent(
    harness.testing,
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/dependabot/cargo/example-1.0.1",
  )
  const published = github_commit_worktree(harness, plan.publish + {options: options()})
  command_run(harness.tools, ["rm", "-rf", repo_dir])
  // Not `schema_drift`: the record kept owner, repo, branch, headline, and
  // repo_dir, so the adapter got as far as deriving a delta and asking GitHub
  // where the branch is. And not a bare 404 either — an absent branch is a
  // lease violation only because `expected_branch_oid` survived the trip.
  const failure = unwrap_err(published)
  assert_eq(failure?.code, "stale_head")
  assert(contains(to_string(failure?.message ?? ""), head_oid))
  assert_eq(len(harness.testing.http_mock_calls()), 1, "nothing was written")
}

pipeline test_a_ref_claim_must_name_exactly_one_object(harness: Harness, task) {
  // The two claim forms are mutually exclusive by construction: naming both
  // would leave the connector to choose, and naming neither leaves the ref with
  // nothing to point at. Both are rejected before any URL is built.
  harness.testing.http_mock_clear()
  const neither = github_claim_ref(harness, SLUG, "refs/heads/automation/x", {}, options())
  assert_eq(unwrap_err(neither)?.code, "invalid_ref_claim")
  const both = github_claim_ref(
    harness,
    SLUG,
    "refs/heads/automation/x",
    {
      oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      payload: {message: "lock", base_ref: "refs/heads/main"},
    },
    options(),
  )
  assert_eq(unwrap_err(both)?.code, "invalid_ref_claim")
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}
