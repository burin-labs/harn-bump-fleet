import { run_release_watch } from "../lib/release_watch_runtime"
import {
  ReleaseWatchReceipt,
  release_watch_receipt,
  release_watch_receipt_read,
} from "../lib/release_watch_state"

fn receipt() -> ReleaseWatchReceipt {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      publication: {
        version: "1.2.3",
        local_branch: "release/v1.2.3",
        remote_ref: "release-attempt/v1.2.3/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        head_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      },
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
}

fn receipt_path(harness: {fs: HarnessFs, random: HarnessRandom}) {
  return path_join(
    harness.fs.temp_dir(),
    "watch-runtime-recovery-" + harness.random.uuid_v7(),
    "receipt.json",
  )
}

fn merged_pr_probe() {
  return {
    number: 1,
    merged: true,
    github_state: "merged",
    merged_at: "2026-07-12T23:59:00Z",
    merge_commit_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    in_merge_queue: false,
    auto_merge_armed: false,
    mergeable_state: "unknown",
    head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
  }
}

fn observed_at(poll: int) -> string {
  if poll == 0 {
    return "2026-07-13T00:01:00Z"
  }
  return "2026-07-13T00:02:00Z"
}

fn accepted_recovery_dispatch(run_id: int) {
  return {
    accepted: true,
    run_id: run_id,
    workflow_path: ".github/workflows/build-release-binaries.yml",
    ref: "main",
    url: "https://github.com/burin-labs/harn/actions/runs/${run_id}",
    event: "workflow_dispatch",
    head_branch: "main",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  }
}

pipeline test_release_watch_runtime_persists_recovery_before_resuming(harness: Harness, task: any) {
  let dispatch_count = 0
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, poll) {
      const tag_run = {
        id: if workflow == "publish-release.yml" {
          21
        } else {
          22
        },
        created_at: "2026-07-13T00:00:00Z",
        event: "push",
        status: "completed",
        conclusion: if workflow == "publish-release.yml" {
          "success"
        } else {
          "failure"
        },
        head_branch: "v1.2.3",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      }
      if workflow != "build-release-binaries.yml" || poll == 0 {
        return [tag_run]
      }
      return [
        tag_run,
        {
          id: 777,
          created_at: "2026-07-13T00:02:00Z",
          event: "workflow_dispatch",
          status: "completed",
          conclusion: "success",
          head_branch: "main",
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        },
        {
          id: 778,
          created_at: "2026-07-13T00:03:00Z",
          event: "workflow_dispatch",
          status: "completed",
          conclusion: "failure",
          head_branch: "main",
          head_sha: "dddddddddddddddddddddddddddddddddddddddd",
        },
      ]
    },
    readiness: fn(_tag, poll) { return if poll == 0 {
      {ready: false, missing_assets: ["harn-x86_64-apple-darwin.tar.gz"]}
    } else {
      {ready: true, missing_assets: []}
    } },
    dispatch: fn(_slug, workflow, fields) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {tag: "v1.2.3"})
      dispatch_count = dispatch_count + 1
      return accepted_recovery_dispatch(777)
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warming is disabled"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const path = receipt_path({fs: harness.fs, random: harness.random})
  const first = run_release_watch(
    harness,
    receipt(),
    path,
    {max_polls: 2, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(first.status, 0)
  assert_eq(dispatch_count, 1)
  const persisted = release_watch_receipt_read(harness.fs, path)
  if persisted == nil {
    throw "expected recovery receipt"
  }
  assert_eq(persisted.state, "healthy")
  assert_eq(persisted.recovery.dispatch_status, "succeeded")
  assert(persisted.observed_run_ids.any({ id -> id == 777 }))
  assert(!persisted.observed_run_ids.any({ id -> id == 778 }))
  const resumed = run_release_watch(
    harness,
    persisted,
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(resumed.status, 0)
  assert_eq(resumed.state, "healthy")
  assert_eq(dispatch_count, 1)
}
