import { ReleaseSizeReport } from "../lib/release_size_report"
import {
  download_release_baseline_report,
  release_baseline_build_evidence,
} from "../refresh_release_binary_size_baseline"
import {
  GithubWorkflowJob,
  GithubWorkflowJobs,
  GithubWorkflowRun,
  GithubWorkflowRuns,
} from "harn-github-connector/default"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const SLUG = "owner/release"

const TAG = "v0.10.130"

pipeline test_selected_build_still_requires_present_exact_size_report(harness: Harness) {
  const report: ReleaseSizeReport = json_parse(
    harness.fs.read_text(
      path_join(harness.fs.source_dir(), "../testdata/release_size/report-0.10.126.json"),
    ),
  )
  let downloads = 0
  const missing = download_release_baseline_report(
    harness.fs,
    run(),
    SHA,
    {
      download: fn(id, artifact, _destination) {
        downloads += 1
        assert_eq(id, 130)
        assert_eq(artifact, "harn-binary-size-x86_64-unknown-linux-gnu-" + SHA)
        return {success: false, message: "artifact absent"}
      },
    },
  )
  assert(is_err(missing))
  assert_eq(downloads, 1)
  const empty = download_release_baseline_report(
    harness.fs,
    run(),
    SHA,
    {download: fn(_id, _artifact, _destination) { return {success: true, message: ""} }},
  )
  assert(is_err(empty))
  for source in [report.source_sha, SHA] {
    const loaded = download_release_baseline_report(
      harness.fs,
      run(),
      SHA,
      {
        download: fn(_id, _artifact, destination) {
          harness.fs.write_text(
            path_join(destination, "binary-size.json"),
            json_stringify(report + {source_sha: source}),
          )
          return {success: true, message: ""}
        },
      },
    )
    assert_eq(is_ok(loaded), source == SHA)
    if is_ok(loaded) {
      assert_eq(unwrap(loaded).bytes, report.bytes)
    }
  }
}

fn run() -> GithubWorkflowRun {
  return {
    repo: SLUG,
    id: 130,
    workflow_id: 1,
    workflow_path: ".github/workflows/build-release-binaries.yml",
    run_number: 1,
    run_attempt: 1,
    name: "Build release binaries",
    display_title: TAG,
    event: "push",
    status: "completed",
    conclusion: "failure",
    head_branch: TAG,
    head_sha: SHA,
    url: "https://github.com/owner/release/actions/runs/130",
    created_at: nil,
    run_started_at: nil,
    updated_at: nil,
  }
}

fn runs(value: GithubWorkflowRun = run()) -> GithubWorkflowRuns {
  return {
    repo: SLUG,
    workflow_id: "build-release-binaries.yml",
    total_count: 1,
    runs: [value],
    page: 1,
    per_page: 50,
  }
}

fn build() -> GithubWorkflowJob {
  return {
    id: 1,
    run_id: 130,
    name: "Build x86_64-unknown-linux-gnu",
    status: "completed",
    conclusion: "success",
    head_sha: SHA,
    url: "https://github.com/owner/release/actions/runs/130/job/1",
    runner_name: "fixture",
    started_at: nil,
    completed_at: nil,
    steps: [],
  }
}

fn jobs(values: list<GithubWorkflowJob> = [build()]) -> GithubWorkflowJobs {
  return {repo: SLUG, run_id: 130, total_count: len(values), jobs: values, page: 1, per_page: 100}
}

pipeline test_recovered_publication_uses_successful_exact_build_not_failed_finalizer() {
  let reads = 0
  const result = release_baseline_build_evidence(
    SLUG,
    TAG,
    SHA,
    runs(),
    fn(id) {
      reads += 1
      assert_eq(id, 130)
      return Ok(
        jobs([build(), build() + {id: 2, name: "Create GitHub release", conclusion: "failure"}]),
      )
    },
  )
  assert(is_ok(result), to_string(result))
  assert_eq(unwrap(result).id, 130)
  assert_eq(unwrap(result).conclusion, "failure")
  assert_eq(reads, 1)
}

pipeline test_baseline_build_refuses_unproven_or_ambiguous_job_evidence() {
  for invalid in [
    jobs([]),
    jobs([build(), build()]),
    jobs([build() + {conclusion: "failure"}]),
    jobs([build() + {conclusion: "skipped"}]),
    jobs([build() + {conclusion: nil, status: "in_progress"}]),
    jobs([build() + {head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]),
    jobs([build() + {run_id: 131}]),
    jobs() + {total_count: 2},
    jobs() + {run_id: 131},
    jobs() + {repo: "owner/other"},
  ] {
    const result = release_baseline_build_evidence(
      SLUG,
      TAG,
      SHA,
      runs(),
      fn(_id) { return Ok(invalid) },
    )
    assert(is_err(result), to_string(invalid))
  }
}

pipeline test_baseline_build_refuses_wrong_source_or_incomplete_runs_before_job_read() {
  let reads = 0
  for invalid in [
    runs(run() + {head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}),
    runs(run() + {head_branch: "main"}),
    runs(run() + {event: "workflow_dispatch"}),
    runs(run() + {workflow_path: ".github/workflows/other.yml"}),
    runs(run() + {status: "in_progress"}),
    runs() + {total_count: 2},
    runs() + {repo: "owner/other"},
    runs() + {runs: [], total_count: 0},
  ] {
    const result = release_baseline_build_evidence(
      SLUG,
      TAG,
      SHA,
      invalid,
      fn(_id) {
        reads += 1
        return Ok(jobs())
      },
    )
    assert(is_err(result), to_string(invalid))
  }
  assert_eq(reads, 0)
}

pipeline test_newer_red_exact_build_cannot_fall_back_to_older_success() {
  const inventory = runs() + {total_count: 2, runs: [run(), run() + {id: 131}]}
  const result = release_baseline_build_evidence(
    SLUG,
    TAG,
    SHA,
    inventory,
    fn(id) {
      assert_eq(id, 131)
      return Ok(jobs([build() + {run_id: 131, conclusion: "failure"}]) + {run_id: 131})
    },
  )
  assert(is_err(result))
}
