import {
  AUTHENTICATED_SESSION_URL_POLICY,
  public_metadata_commits,
  public_metadata_violation_line,
  public_metadata_violations,
} from "../lib/public_metadata_privacy"

fn run_git(process: HarnessProcess, repo: string, args: list<string>) {
  const result = process.run({program: "git", args: ["-C", repo] + args})
  assert_eq(result.exit_code, 0, result.combined ?? "git command failed")
  return trim(result.stdout ?? "")
}

fn commit_fixture(
  io: {fs: HarnessFs, process: HarnessProcess},
  repo: string,
  subject: string,
  body: string,
) -> string {
  io.fs.write_text(path_join(repo, "fixture.txt"), subject + "\n")
  run_git(io.process, repo, ["add", "fixture.txt"])
  run_git(io.process, repo, ["commit", "-q", "-m", subject, "-m", body])
  return run_git(io.process, repo, ["rev-parse", "HEAD"])
}

pipeline test_authenticated_session_url_is_rejected_without_echoing_identifiers() {
  const secret_query = "private-query-value"
  const session_id = "session_fixturePrivate123"
  const violations = public_metadata_violations(
    "commit/0123456789012345678901234567890123456789/message",
    "Assistant record: https://claude.ai/code/${session_id}?access=${secret_query}",
  )
  assert_eq(len(violations), 1)
  const violation = unwrap(violations[0])
  assert_eq(violation.policy, AUTHENTICATED_SESSION_URL_POLICY)
  const diagnostic = public_metadata_violation_line(violation)
  assert(contains(diagnostic, "commit/0123456789012345678901234567890123456789/message"))
  assert(contains(diagnostic, "policy=authenticated-session-url"))
  assert(contains(diagnostic, "?[redacted-query]"))
  assert_eq(contains(diagnostic, secret_query), false)
  assert_eq(contains(diagnostic, session_id), false)
}

pipeline test_ordinary_public_documentation_urls_are_accepted() {
  assert_eq(
    public_metadata_violations(
      "commit/clean/message",
      "See https://docs.anthropic.com/en/docs/claude-code/overview?utm_source=release and "
        + "https://docs.github.com/en/pull-requests/collaborating-with-pull-requests.",
    ),
    [],
  )
}

pipeline test_commit_range_reads_subject_and_body_and_negative_control_fires(harness: Harness) {
  const repo = harness.fs.mkdtemp_in_workspace("public-metadata-range-")
  run_git(harness.process, repo, ["init", "-q", "-b", "main"])
  run_git(harness.process, repo, ["config", "user.name", "Metadata Fixture"])
  run_git(harness.process, repo, ["config", "user.email", "metadata@invalid.example"])
  run_git(harness.process, repo, ["config", "commit.gpgSign", "false"])
  const io = {fs: harness.fs, process: harness.process}
  const base = commit_fixture(io, repo, "Base fixture", "Public base body.")
  run_git(harness.process, repo, ["switch", "-q", "-c", "feature"])
  const clean = commit_fixture(
    io,
    repo,
    "Document the release gate",
    "See https://docs.github.com/en/actions.",
  )
  const clean_commits = unwrap(public_metadata_commits(harness.process, repo, base, clean))
  assert_eq(len(clean_commits), 1)
  assert_eq(public_metadata_violations("commit/${clean}/message", clean_commits[0].message), [])
  const denied = commit_fixture(
    io,
    repo,
    "Preserve the release evidence",
    "Private assistant record: https://claude.ai/code/session_fixtureNegativeControl?key=hidden",
  )
  const denied_commits = unwrap(public_metadata_commits(harness.process, repo, clean, denied))
  assert_eq(len(denied_commits), 1)
  const violations = public_metadata_violations(
    "commit/${denied}/message",
    denied_commits[0].message,
  )
  assert_eq(len(violations), 1, "the real Git commit body must reach the privacy policy")
  assert_eq(unwrap(violations[0]).source, "commit/${denied}/message")
}

pipeline test_canonical_pr_job_runs_commit_range_scanner_with_full_history(harness: Harness) {
  const root = dirname(harness.fs.cwd())
  const workflow = harness.fs.read_text(path_join(root, ".github/workflows/ci.yml"))
  assert(contains(workflow, "run: harn run --no-sandbox check_public_metadata_privacy.harn"))
  assert(
    contains(
      workflow,
      "# Full history is required to measure every PR-range commit message.\n"
        + "          fetch-depth: 0",
    ),
  )
}
