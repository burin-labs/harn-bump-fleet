import { release_agent_evidence_decision } from "../lib/release_agent_evidence"

fn analysis() {
  return {latest_tag: "v1.2.2", pin_sha: "0123456789012345678901234567890123456789", mock: false}
}

fn dispatch(name, id, arguments, ok = true) {
  return {tool_name: name, tool_call_id: id, arguments: arguments, ok: ok}
}

pipeline test_log_alone_cannot_satisfy_both_evidence_classes(task) {
  const a = analysis()
  const payload = {
    dispatch: [
      dispatch(
        "release_git",
        "log-1",
        {operation: "log", rev_range: "v1.2.2..0123456789012345678901234567890123456789"},
      ),
    ],
  }
  const decision = release_agent_evidence_decision([], payload, a)
  assert_eq(decision.complete, false)
  assert(contains(decision.reason, "distinct"))
  assert_eq(decision.observations[0]?.evidence_class, "delta")
  assert_eq(decision.observations[0]?.source_tree, a.pin_sha)
}

pipeline test_invalid_arguments_do_not_count_and_distinct_content_closes_receipt(task) {
  const a = analysis()
  const first = {
    dispatch: [
      dispatch("release_run", "bad-1", {argv: "git log"}, false),
      dispatch(
        "release_run",
        "delta-1",
        {argv: ["git", "diff", "v1.2.2..0123456789012345678901234567890123456789"]},
      ),
    ],
  }
  const pending = release_agent_evidence_decision([], first, a)
  assert_eq(pending.complete, false)
  assert_eq(len(pending.observations), 1)
  const closed = release_agent_evidence_decision(
    pending.observations,
    {dispatch: [dispatch("release_read", "read-1", {path: "CHANGELOG.md"})]},
    a,
  )
  assert_eq(closed.complete, true)
  assert_eq(closed.delta_observation_id, "delta-1")
  assert_eq(closed.content_observation_id, "read-1")
}

pipeline test_provider_call_id_reuse_does_not_erase_a_distinct_later_observation(task) {
  const a = analysis()
  const pending = release_agent_evidence_decision(
    [],
    {
      dispatch: [
        dispatch(
          "release_run",
          "recycled-call-1",
          {argv: ["git", "log", "v1.2.2..0123456789012345678901234567890123456789"]},
        ),
      ],
    },
    a,
  )
  const closed = release_agent_evidence_decision(
    pending.observations,
    {dispatch: [dispatch("release_read", "recycled-call-1", {path: "CHANGELOG.md"})]},
    a,
  )
  assert_eq(closed.complete, true)
  assert_eq(len(closed.observations), 2)
}
