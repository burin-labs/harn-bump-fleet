import { read_json_result } from "std/fs"
import {
  release_queue_reservation_plan,
  release_queue_reserve,
  release_queue_restore,
} from "../lib/release_queue_reservation"
import {
  release_queue_active_pointer_path,
  release_queue_active_reservation_id,
  release_queue_checkpoint,
  release_queue_receipt_path,
  release_queue_receipt_read,
} from "../lib/release_queue_state"

fn plan() {
  return release_queue_reservation_plan(
    "burin-labs/harn",
    "main",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    [{pull_number: 20, expected_head_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}],
    [
      {
        entry_id: "entry-30",
        pull_number: 30,
        head_oid: "cccccccccccccccccccccccccccccccccccccccc",
        position: 2,
        state: "QUEUED",
      },
    ],
    [
      {
        pull_number: 30,
        head_oid: "cccccccccccccccccccccccccccccccccccccccc",
        auto_merge_armed: true,
        merge_method: "SQUASH",
        source_check_state: "green",
        source_checks: [],
      },
    ],
    {live_pull_numbers: [], noncritical_live_overrides: []},
  )
}

pipeline test_queue_receipts_are_atomic_typed_and_terminally_released(harness: Harness, task) {
  const root = path_join(harness.fs.temp_dir(), "release-queue-state-" + harness.random.uuid_v7())
  const reservation = plan()
  const adapter = {
    hold: fn(_hold) { return {ok: true, detail: "held", after_position: nil} },
    restore: fn(hold) { return {ok: true, detail: "restored", after_position: hold.position} },
  }
  const checkpoint = release_queue_checkpoint({fs: harness.fs, random: harness.random}, root)
  const reserved = release_queue_reserve(reservation, nil, adapter, checkpoint)
  const reserve_path = release_queue_receipt_path(root, reservation.reservation_id, "reserve")
  assert_eq(release_queue_receipt_read(harness.fs, reserve_path), reserved)
  assert_eq(release_queue_active_reservation_id(harness.fs, root), reservation.reservation_id)
  const restored = release_queue_restore(reserved, nil, adapter, checkpoint)
  const restore_path = release_queue_receipt_path(root, reservation.reservation_id, "restore")
  assert_eq(release_queue_receipt_read(harness.fs, restore_path), restored)
  assert_eq(release_queue_active_reservation_id(harness.fs, root), nil)
  const pointer = unwrap(read_json_result(harness.fs, release_queue_active_pointer_path(root)))
  assert_eq(pointer.state, "terminal")
}

pipeline test_queue_receipt_reader_rejects_untyped_state(harness: Harness, task) {
  const root = path_join(harness.fs.temp_dir(), "release-queue-invalid-" + harness.random.uuid_v7())
  const reservation = plan()
  const path = release_queue_receipt_path(root, reservation.reservation_id, "reserve")
  harness.fs.mkdir(dirname(path), true)
  harness.fs.write_text(path, json_stringify({schema_version: "invented"}))
  const invalid = try {
    release_queue_receipt_read(harness.fs, path)
  }
  assert(is_err(invalid), "corrupt receipt fails closed")
  assert_eq(
    release_queue_receipt_read(harness.fs, path_join(dirname(path), "missing.json")),
    nil,
    "proven absence remains optional",
  )
}
