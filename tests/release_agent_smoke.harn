import { agent_preset } from "std/agent/presets"

/**
 * Regression tests for the agent_preset capability-derivation flow used by
 * release_harn.harn's `--agent` mode. Before harn v0.8.19, agent_preset
 * hardcoded `tool_format: "native"`, so any release run against a text-only
 * tool route (ollama/qwen3.6 et al.) failed at agent_loop with
 * "option `tools` is not supported by <model>". v0.8.19 derives the right
 * `tool_format` from `provider_capabilities`; these tests pin that behavior
 * and catch a re-introduction of the bug class.
 */
fn smoke_tools() {
  var tools = tool_registry()
  tools = tool_define(
    tools,
    "smoke_read",
    "Echo a string (test-only).",
    {
      parameters: {x: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> args.x },
    },
  )
  return tools
}

pipeline test_agent_preset_derives_text_format_for_ollama_qwen(task) {
  let options = agent_preset(
    "audit",
    {provider: "ollama", model: "qwen3.6:35b-a3b-coding-nvfp4", tools: smoke_tools()},
  )
  assert_eq(options.tool_format, "text")
}

pipeline test_agent_preset_keeps_native_for_anthropic(task) {
  let options = agent_preset("audit", {provider: "anthropic", model: "claude-sonnet-4-6", tools: smoke_tools()})
  assert_eq(options.tool_format, "native")
}
