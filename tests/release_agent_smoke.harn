import { agent_preset } from "std/agent/presets"
import { release_generated_content_checks } from "../lib/release_agent"

/**
 * Regression tests for the agent_preset capability-derivation flow used by
 * release_harn.harn's `--agent` mode. Before harn v0.8.19, agent_preset
 * hardcoded `tool_format: "native"`, so any release run against a text-only
 * tool route (ollama/qwen3.6 et al.) failed at agent_loop with
 * "option `tools` is not supported by <model>". v0.8.19 derives the right
 * `tool_format` from `provider_capabilities`; these tests catch a
 * re-introduction of that bug class. They assert the derived format is
 * NON-native rather than a specific literal, because the concrete non-native
 * default is a runtime-version detail (harn v0.8.92 moved it from "text" to
 * fenced-JSON "json") — pinning the literal would make the test fail under
 * whichever runtime (pinned CI vs. a newer local `harn`) disagrees with the
 * pin. Asserting "not native, and a known text route" is invariant across
 * both and still catches the original regression.
 */
fn smoke_tools() {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "smoke_read",
    "Echo a string (test-only).",
    {
      parameters: {x: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> args.x },
    },
  )
  return tools
}

pipeline test_agent_preset_derives_non_native_format_for_ollama_qwen(task) {
  const options = agent_preset(
    "audit",
    {provider: "ollama", model: "qwen3.6:35b-a3b-coding-nvfp4", tools: smoke_tools()},
  )
  // The exact non-native default is runtime-version dependent ("text" pre-0.8.92,
  // "json" after). What matters for the bug class is that it is NOT "native".
  assert(options.tool_format != "native")
  assert(options.tool_format == "text" || options.tool_format == "json")
}

pipeline test_agent_preset_keeps_native_for_anthropic(task) {
  const options = agent_preset(
    "audit",
    {provider: "anthropic", model: "claude-sonnet-4-6", tools: smoke_tools()},
  )
  assert_eq(options.tool_format, "native")
}

pipeline test_generated_content_checks_cover_fixup_reconciliation(task) {
  // The ship prepare phase invokes this shared list after normal prepare and the
  // fixup early-return path, before it can commit or push the release branch.
  const checks = release_generated_content_checks(
    {
      fixup_mode: true,
      repo: "/tmp/harn release fixture",
      bootstrap_new_crates: false,
      release_cargo_target_dir: "/tmp/canonical release target",
    },
  )
  assert_eq(checks.map({ check -> check.name }), ["release-markdown-lint", "release-cli-aot"])
  assert_eq(checks.map({ check -> check.context }), ["plain", "release_build"])
  assert_eq(checks[0]?.command, "make -s lint-md")
  assert_eq(
    contains(checks[1]?.command ?? "", "CARGO_TARGET_DIR='/tmp/canonical release target'"),
    true,
  )
  assert_eq(
    contains(
      checks[1]?.command ?? "",
      "CARGO_BUILD_BUILD_DIR='/tmp/canonical release target/build'",
    ),
    true,
  )
  assert_eq(ends_with(checks[1]?.command ?? "", " make check-cli-aot"), true)
  assert_eq(contains(checks[1]?.command ?? "", "/tmp/harn release fixture/target"), false)
}
