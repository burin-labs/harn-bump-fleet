import { command_result_fail, command_result_ok } from "std/command"
import { EMPTY_AUDIT_FINDING, NO_VISIBLE_AUDIT_FINDING } from "../lib/release_audit"
import {
  decisive_failed_step,
  execution_failed,
  mock_release_tag_command,
  push_hook_budget_exceeded,
  recorded_step,
  release_failure_explanation,
  release_tag_verify_git_args,
} from "../lib/release_execution"

pipeline test_release_failure_explanation(task: any) {
  // The cryptic `agent-review-validation` step gets a plain-language headline
  // that answers "what is this" without leaking the internal step id.
  const agent = release_failure_explanation(
    recorded_step(
      "agent-review-validation",
      "validate local-model release audit",
      command_result_fail(2, "agent review failed validation:\n" + NO_VISIBLE_AUDIT_FINDING),
    ),
  )
  assert_eq(contains(agent.headline, "release-readiness review"), true)
  assert_eq(contains(agent.headline, "agent-review"), false)
  assert_eq(
    contains(agent.next, "scripts/with_env.sh harn run --no-sandbox release_harn.harn"),
    true,
  )
  assert(contains(agent.next, "required key"))
  // prepare failures point at the live log.
  const prep = release_failure_explanation(
    recorded_step("prepare", "./scripts/release_ship.sh --prepare", command_result_fail(1, "boom")),
  )
  assert_eq(contains(prep.headline, "prepare step"), true)
  assert_eq(contains(prep.next, "live log"), true)
  // A raw shell command never leaks into the headline; fall back to the name.
  const raw = release_failure_explanation(
    recorded_step("create-release-tag", "git rev-parse HEAD", command_result_fail(1, "x")),
  )
  assert_eq(contains(raw.headline, "git "), false)
  assert_eq(contains(raw.headline, "signed release tag"), true)
  assert_eq(contains(raw.next, "not pushed"), true)
  const untrusted = release_failure_explanation(
    recorded_step(
      "verify-release-tag-github-trust",
      "verify GitHub signer",
      command_result_fail(2, "unknown key"),
    ),
  )
  assert(contains(untrusted.headline, "cannot attribute"))
  assert(contains(untrusted.next, "--show-origin --show-scope"))
  assert(contains(untrusted.next, "tag was not pushed"))
}

pipeline test_decisive_failed_step_skips_candidate_join_bookkeeping(task: any) {
  const lane = recorded_step(
    "hosted-platform-certification",
    "certify the candidate on supported platforms",
    command_result_fail(2, "harn conformance failed"),
  )
  const cancelled = recorded_step(
    "candidate-certification-lane-cancelled",
    "cancel a sibling after a lane failure",
    command_result_fail(130, "platform certification failed"),
  )
  const join = recorded_step(
    "candidate-certification-join",
    "join exact-candidate certification lanes",
    command_result_fail(2, "one or more lanes failed"),
  )
  assert_eq(decisive_failed_step([lane, cancelled, join])?.name, lane.name)
  assert_eq(decisive_failed_step([join])?.name, join.name)
  assert_eq(decisive_failed_step([]), nil)
}

pipeline test_release_execution(task: any) {
  const numeric_success = recorded_step(
    "numeric-success",
    "external command",
    command_result_ok(""),
  )
  const numeric_failure = recorded_step(
    "numeric-failure",
    "external command",
    command_result_fail(7, "failed"),
  )
  assert_eq(numeric_success.status, "completed")
  assert_eq(numeric_failure.status, "failed")
  assert_eq(numeric_success.cwd, "")
  assert_eq(
    release_tag_verify_git_args("v1.2.3"),
    [
      "-c",
      "gpg.ssh.allowedSignersFile=.github/release-bot-allowed-signers",
      "verify-tag",
      "--raw",
      "v1.2.3",
    ],
  )
  assert_eq(mock_release_tag_command("git tag -s v1.2.3", false).success, true)
  const verify_command = (["git"] + release_tag_verify_git_args("v1.2.3")).join(" ")
  assert_eq(mock_release_tag_command(verify_command, false).success, true)
  const rejected = mock_release_tag_command(verify_command, true)
  assert_eq(rejected.success, false)
  assert_eq(rejected.status, "failed")
  assert_eq(rejected.exit_code, 1)
  assert_eq(
    mock_release_tag_command(
      "git push origin aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:refs/tags/v1.2.3",
      false,
    ),
    nil,
  )
  const green_timeout = command_result_fail(
    1,
    "pre-push hook: make test passed (3187/3187) but exceeded budget",
  )
  assert_eq(push_hook_budget_exceeded("git push -u origin release/v1.2.3", green_timeout), true)
  const push_step = recorded_step("push", "git push -u origin release/v1.2.3", green_timeout)
  assert_eq(push_step.classification, "push_hook_budget_exceeded_after_green_tests")
  assert_eq(execution_failed([push_step]), true)
  assert_eq(
    execution_failed(
      [
        push_step,
        recorded_step(
          "push-no-verify-after-green-hook-budget",
          "git push --no-verify",
          command_result_ok(""),
        ),
      ],
    ),
    false,
  )
  const lint_step = recorded_step(
    "release-markdown-lint",
    "make -s lint-md",
    command_result_fail(1, "MD013"),
  )
  assert_eq(lint_step.classification, "generated_markdown_lint_failed")
  assert_eq(
    execution_failed(
      [
        lint_step,
        recorded_step(
          "release-markdown-lint-after-agent-repair",
          "make -s lint-md",
          command_result_ok(""),
        ),
      ],
    ),
    false,
  )
  const stale_aot = recorded_step(
    "release-cli-aot",
    "make check-cli-aot",
    command_result_fail(
      1,
      "CLI AOT artifacts target Harn 0.10.20; expected 0.10.21; run `make gen-cli-aot`",
    ),
  )
  assert_eq(stale_aot.classification, "generated_cli_aot_failed")
  assert(contains(stale_aot.recovery_hint, "make gen-cli-aot"))
  const aot_failure = release_failure_explanation(stale_aot)
  assert(contains(aot_failure.headline, "generated CLI bytecode"))
  assert(contains(aot_failure.next, "make gen-cli-aot"))
  assert_eq(
    execution_failed(
      [
        stale_aot,
        recorded_step(
          "release-cli-aot-after-agent-repair",
          "make check-cli-aot",
          command_result_ok(""),
        ),
      ],
    ),
    false,
  )
}

/**
 * The `agent-review-validation` step fails for two opposite reasons, and the
 * remediation must not send an operator to the credential store when the model
 * answered fine and the audit merely failed a content check.
 */
pipeline test_agent_review_remediation_distinguishes_no_text_from_rejected_audit(task: any) {
  const rejected = release_failure_explanation(
    recorded_step(
      "agent-review-validation",
      "validate local-model release audit",
      command_result_fail(
        2,
        "agent review failed validation:\nagent draft changelog contains an `## Unreleased` heading",
      ),
    ),
  )
  assert(contains(rejected.headline, "failed validation"))
  assert(contains(rejected.next, "validation findings printed above"))
  // The falsifier: the old message blamed provider credentials for every
  // failure at this step, including this one.
  assert_eq(contains(rejected.next, "required key"), false)
  assert_eq(contains(rejected.next, "auth/rate-limit"), false)
  const empty = release_failure_explanation(
    recorded_step(
      "agent-review-validation",
      "validate local-model release audit",
      command_result_fail(2, "agent review failed validation:\n" + EMPTY_AUDIT_FINDING),
    ),
  )
  assert(contains(empty.headline, "never produced a usable audit"))
  assert(contains(empty.next, "auth/rate-limit"))
}
