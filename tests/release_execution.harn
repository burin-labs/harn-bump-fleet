import {
  execution_failed,
  push_hook_budget_exceeded,
  recorded_step,
  recovery_step_ref,
} from "../lib/release_execution"
import { fail, ok } from "../lib/shell_util"

pipeline test_release_execution(task) {
  let green_timeout = fail(1, "pre-push hook: make test passed (3187/3187) but exceeded budget")
  assert_eq(push_hook_budget_exceeded("git push -u origin release/v1.2.3", green_timeout), true)
  let push_step = recorded_step("push", "git push -u origin release/v1.2.3", green_timeout)
  assert_eq(push_step.classification, "push_hook_budget_exceeded_after_green_tests")
  assert_eq(execution_failed([push_step]), true)
  assert_eq(
    execution_failed(
      [push_step, recorded_step("push-no-verify-after-green-hook-budget", "git push --no-verify", ok(""))],
    ),
    false,
  )
  let lint_step = recorded_step("release-markdown-lint", "make -s lint-md", fail(1, "MD013"))
  assert_eq(lint_step.classification, "generated_markdown_lint_failed")
  assert_eq(
    execution_failed(
      [lint_step, recorded_step("release-markdown-lint-after-agent-repair", "make -s lint-md", ok(""))],
    ),
    false,
  )
  let ref = recovery_step_ref({...lint_step, live_log: "/tmp/log"})
  assert_eq(ref.stdout, "(full output is in live_log)")
}
