import {
  release_pr_watchdog_decision,
  release_pr_watchdog_query_args,
} from "../lib/release_pr_watchdog"

pipeline test_release_pr_watchdog_query_args(task) {
  let args = release_pr_watchdog_query_args("burin-labs/harn", "https://github.com/burin-labs/harn/pull/4044")
  assert(args != nil, "valid slug + PR URL should produce a GraphQL argv")
  assert_eq(args[0], "api")
  assert_eq(args[1], "graphql")
  assert(args.contains("owner=burin-labs"), "query args should bind owner")
  assert(args.contains("repo=harn"), "query args should bind repo")
  assert(args.contains("number=4044"), "query args should bind PR number")
  assert(release_pr_watchdog_query_args("not-a-slug", "4044") == nil)
}

pipeline test_release_pr_watchdog_decision(task) {
  let queued = release_pr_watchdog_decision(
    {
      data: {
        repository: {
          pullRequest: {
            number: 4044,
            state: "OPEN",
            mergeStateStatus: "UNSTABLE",
            isInMergeQueue: true,
            mergeQueueEntry: {position: 2, state: "AWAITING_CHECKS"},
            autoMergeRequest: nil,
          },
        },
      },
    },
  )
  assert_eq(queued.action, "ok")
  assert_eq(queued.reason, "release_pr_in_merge_queue")
  assert_eq(queued.queue_position, 2)
  let armed = release_pr_watchdog_decision(
    {number: 4044, state: "OPEN", isInMergeQueue: false, autoMergeRequest: {enabledAt: "now"}},
  )
  assert_eq(armed.action, "ok")
  assert_eq(armed.reason, "release_pr_auto_merge_armed")
  let idle = release_pr_watchdog_decision(
    {
      data: {
        repository: {
          pullRequest: {
            number: 4044,
            state: "OPEN",
            mergeStateStatus: "UNSTABLE",
            isInMergeQueue: false,
            mergeQueueEntry: nil,
            autoMergeRequest: nil,
          },
        },
      },
    },
  )
  assert_eq(idle.action, "rearm")
  assert_eq(idle.reason, "release_pr_open_without_queue_or_auto_merge")
  let merged = release_pr_watchdog_decision({number: 4044, state: "MERGED"})
  assert_eq(merged.action, "done")
  let missing = release_pr_watchdog_decision({})
  assert_eq(missing.action, "skip")
}
