import { release_pr_watchdog_decision } from "../lib/release_pr_watchdog"

fn open_pr(fields = {}) {
  return {
    number: 4044,
    merged: false,
    merged_at: nil,
    merge_commit_oid: nil,
    github_state: "open",
    mergeable_state: "unstable",
    in_merge_queue: false,
    auto_merge_armed: false,
    queue_membership: {entry: nil},
  }
    + fields
}

pipeline test_release_pr_watchdog_decision(task) {
  const queued = release_pr_watchdog_decision(
    open_pr({in_merge_queue: true, queue_membership: {entry: {position: 2, state: "awaiting_checks"}}}),
  )
  assert_eq(queued.action, "ok")
  assert_eq(queued.reason, "release_pr_in_merge_queue")
  assert_eq(queued.queue_position, 2)
  const armed = release_pr_watchdog_decision(open_pr({auto_merge_armed: true}))
  assert_eq(armed.action, "ok")
  assert_eq(armed.reason, "release_pr_auto_merge_armed")
  const idle = release_pr_watchdog_decision(open_pr())
  assert_eq(idle.action, "rearm")
  assert_eq(idle.reason, "release_pr_open_without_queue_or_auto_merge")
  const merged = release_pr_watchdog_decision(
    open_pr(
      {
        merged: true,
        github_state: "merged",
        merged_at: "2026-07-13T00:00:00Z",
        merge_commit_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      },
    ),
  )
  assert_eq(merged.action, "done")
  assert_eq(merged.merge_sha, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  assert_eq(merged.merged_at, "2026-07-13T00:00:00Z")
  const missing = release_pr_watchdog_decision(nil)
  assert_eq(missing.action, "skip")
}
