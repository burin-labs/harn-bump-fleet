import { analyze_release } from "../lib/release_analysis"
import { parse_release_args, release_repo_slug } from "../lib/release_runtime"

pipeline test_audit_analysis_keeps_the_mocked_merged_release_range(harness: Harness) {
  const analysis = analyze_release(
    harness,
    parse_release_args(harness.env, ["--mock", "--no-chat"]),
  )
  assert_eq(analysis.current_version, "0.7.52")
  assert_eq(analysis.next_version, "0.7.53")
  assert_eq(json_parse(analysis.recent_merged_prs)[0]?.number, 998)
}

pipeline test_release_repository_identity_reads_both_github_remote_forms(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("release-repo-slug-")
  assert(harness.process.run({program: "git", args: ["init", "-q", root]}).success)
  assert(
    harness.process.run(
      {
        program: "git",
        args: ["-C", root, "remote", "add", "origin", "git@github.com:owner/repo.git"],
      },
    ).success,
  )
  const caps = pick(harness, ["env", "process"])
  const cfg = {mock: false, repo: root}
  assert_eq(release_repo_slug(caps, cfg), "owner/repo")
  for remote in ["https://github.com/owner/repo.git", "https://elsewhere.test/owner/repo.git"] {
    assert(
      harness.process.run(
        {program: "git", args: ["-C", root, "remote", "set-url", "origin", remote]},
      ).success,
    )
    assert_eq(
      release_repo_slug(caps, cfg),
      if contains(remote, "github.com") {
        "owner/repo"
      } else {
        ""
      },
    )
  }
}
