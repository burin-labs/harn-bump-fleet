import {
  parse_pin_staleness_heartbeat_args,
  resolve_max_age_days,
} from "../check_fleet_pin_staleness_heartbeat.harn"
import {
  HEARTBEAT_ISSUE_MARKER,
  HEARTBEAT_LABEL,
  HeartbeatRun,
  PIN_STALENESS_WORKFLOW,
  heartbeat_age_seconds,
  heartbeat_issue_body,
  is_successful_pin_staleness_run,
  pin_staleness_heartbeat_verdict,
} from "../lib/fleet_pin_heartbeat"
import { github_open_issues_query } from "../lib/github"

const NOW = "2026-08-28T13:37:00Z"

fn run(id: int, status: string, conclusion: string?, created_at: string?) -> HeartbeatRun {
  return {
    id: id,
    status: status,
    conclusion: conclusion,
    created_at: created_at,
    updated_at: created_at,
    url: "https://github.test/burin-labs/harn-bump-fleet/actions/runs/${to_string(id)}",
  }
}

fn thrown(callback: closure) -> string {
  const result = try {
    callback()
  }
  return to_string(unwrap_err(result))
}

pipeline test_a_recent_success_is_a_fresh_heartbeat() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(11, "completed", "success", "2026-08-28T11:37:00Z")],
    NOW,
    2,
  )
  assert_eq(verdict.state, "fresh")
  assert(!verdict.silent)
  assert_eq(verdict.newest_success_id, 11)
}

/**
 * The falsifier for "any completed run is a pulse". A failed alarm — lost
 * `issues: write`, broken `harn install`, or a crash before the receipt — must
 * not keep the heartbeat green. Deleting the success check makes this fail.
 */
pipeline test_a_recent_failed_run_is_silence_not_a_pulse() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(12, "completed", "failure", "2026-08-28T11:37:00Z")],
    NOW,
    2,
  )
  assert(verdict.silent, "a failed pin-staleness run is not a heartbeat")
  assert_eq(verdict.newest_success_id, nil)
  assert(!is_successful_pin_staleness_run(run(12, "completed", "failure", NOW)))
}

pipeline test_no_runs_is_silence() {
  const verdict = pin_staleness_heartbeat_verdict([], NOW, 2)
  assert(verdict.silent)
  assert(contains(verdict.detail, "no successful"), verdict.detail)
}

/**
 * A success that aged past the ceiling is the disabled-cron shape: the alarm
 * used to run, then stopped, and the last green row is still sitting there.
 */
pipeline test_an_old_success_is_silence() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(9, "completed", "success", "2026-08-25T11:37:00Z")],
    NOW,
    2,
  )
  assert(verdict.silent, "a success older than the ceiling must not count as a pulse")
  assert_eq(verdict.newest_success_id, 9)
  assert(contains(verdict.detail, "older than 2 day(s)"), verdict.detail)
}

pipeline test_a_success_exactly_on_the_ceiling_is_still_fresh() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(10, "completed", "success", "2026-08-26T13:37:00Z")],
    NOW,
    2,
  )
  assert_eq(verdict.state, "fresh")
  assert_eq(heartbeat_age_seconds("2026-08-26T13:37:00Z", NOW), 2 * 86400)
}

pipeline test_an_older_failure_does_not_hide_a_newer_success() {
  const verdict = pin_staleness_heartbeat_verdict(
    [
      run(8, "completed", "failure", "2026-08-28T12:00:00Z"),
      run(7, "completed", "success", "2026-08-28T11:37:00Z"),
    ],
    NOW,
    2,
  )
  assert_eq(verdict.state, "fresh")
  assert_eq(verdict.newest_success_id, 7)
}

pipeline test_an_unreadable_timestamp_is_not_treated_as_recent() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(3, "completed", "success", "not-a-timestamp")],
    NOW,
    2,
  )
  assert(verdict.silent, "a corrupt clock must not mint a pulse")
  assert_eq(verdict.newest_success_id, nil)
}

pipeline test_heartbeat_issue_body_carries_the_upsert_marker() {
  const silent = pin_staleness_heartbeat_verdict([], NOW, 2)
  const body = heartbeat_issue_body(silent, 2, "https://example.test/run/1")
  assert(contains(body, HEARTBEAT_ISSUE_MARKER), body)
  assert(contains(body, PIN_STALENESS_WORKFLOW), body)
  assert(contains(body, "https://example.test/run/1"), body)
  assert(!contains(heartbeat_issue_body(silent, 2, nil), "Detected by"))
}

pipeline test_open_issue_query_is_scoped_to_the_heartbeat_label() {
  assert_eq(
    github_open_issues_query(HEARTBEAT_LABEL),
    {labels: HEARTBEAT_LABEL, state: "open", per_page: 100},
  )
}

pipeline test_heartbeat_cli_boundary() {
  const parsed = parse_pin_staleness_heartbeat_args(
    ["--dry-run", "--max-age-days", "3", "--repo", "burin-labs/other"],
  )
  assert_eq(parsed.dry_run, true)
  assert_eq(resolve_max_age_days(parsed.max_age_days), 3)
  assert_eq(parsed.repo, "burin-labs/other")
  assert_eq(parsed.workflow, PIN_STALENESS_WORKFLOW)
  const defaults = parse_pin_staleness_heartbeat_args([])
  assert_eq(resolve_max_age_days(defaults.max_age_days), 2)
  assert_eq(defaults.dry_run, false)
  assert_eq(defaults.repo, "burin-labs/harn-bump-fleet")
}

pipeline test_a_non_positive_age_ceiling_is_refused_rather_than_ignored() {
  assert(contains(thrown({ -> resolve_max_age_days("two") }), "positive integer"))
  assert(contains(thrown({ -> resolve_max_age_days("0") }), "positive integer"))
  assert(contains(thrown({ -> resolve_max_age_days("-1") }), "positive integer"))
  assert_eq(resolve_max_age_days("1"), 1)
}
