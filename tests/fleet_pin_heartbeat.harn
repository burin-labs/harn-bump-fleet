import {
  parse_pin_staleness_heartbeat_args,
  resolve_max_age_days,
} from "../check_fleet_pin_staleness_heartbeat.harn"
import {
  HEARTBEAT_ISSUE_MARKER,
  HEARTBEAT_LABEL,
  HeartbeatRun,
  PIN_STALENESS_WORKFLOW,
  heartbeat_age_seconds,
  heartbeat_issue_body,
  is_successful_pin_staleness_run,
  pin_staleness_heartbeat_verdict,
} from "../lib/fleet_pin_heartbeat"
import { github_open_issues_query } from "../lib/github"

const NOW = "2026-08-28T13:37:00Z"

fn run(id: int, status: string, conclusion: string?, created_at: string?) -> HeartbeatRun {
  return {
    id: id,
    status: status,
    conclusion: conclusion,
    created_at: created_at,
    updated_at: created_at,
    url: "https://github.test/burin-labs/harn-bump-fleet/actions/runs/${to_string(id)}",
  }
}

fn thrown(callback: closure) -> string {
  const result = try {
    callback()
  }
  return to_string(unwrap_err(result))
}

pipeline test_a_recent_success_is_a_fresh_heartbeat() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(11, "completed", "success", "2026-08-28T11:37:00Z")],
    NOW,
    2,
  )
  assert_eq(verdict.state, "fresh")
  assert(!verdict.silent)
  assert_eq(verdict.newest_success_id, 11)
}

/**
 * The falsifier for "any completed run is a pulse". A failed alarm — lost
 * `issues: write`, broken `harn install`, or a crash before the receipt — must
 * not keep the heartbeat green. Deleting the success check makes this fail.
 */
pipeline test_a_recent_failed_run_is_silence_not_a_pulse() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(12, "completed", "failure", "2026-08-28T11:37:00Z")],
    NOW,
    2,
  )
  assert(verdict.silent, "a failed pin-staleness run is not a heartbeat")
  assert_eq(verdict.newest_success_id, nil)
  assert(!is_successful_pin_staleness_run(run(12, "completed", "failure", NOW)))
}

pipeline test_no_runs_is_silence() {
  const verdict = pin_staleness_heartbeat_verdict([], NOW, 2)
  assert(verdict.silent)
  assert(contains(verdict.detail, "no successful"), verdict.detail)
}

/**
 * A success that aged past the ceiling is the disabled-cron shape: the alarm
 * used to run, then stopped, and the last green row is still sitting there.
 */
pipeline test_an_old_success_is_silence() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(9, "completed", "success", "2026-08-25T11:37:00Z")],
    NOW,
    2,
  )
  assert(verdict.silent, "a success older than the ceiling must not count as a pulse")
  assert_eq(verdict.newest_success_id, 9)
  assert(contains(verdict.detail, "older than 2 day(s)"), verdict.detail)
}

pipeline test_a_success_exactly_on_the_ceiling_is_still_fresh() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(10, "completed", "success", "2026-08-26T13:37:00Z")],
    NOW,
    2,
  )
  assert_eq(verdict.state, "fresh")
  assert_eq(heartbeat_age_seconds("2026-08-26T13:37:00Z", NOW), 2 * 86400)
}

/**
 * Liveness and the subject's verdict are answered separately.
 *
 * This case used to assert `fresh` here, which encoded the defect as intended
 * behaviour: run 8 is the NEWER of the two and it failed, so the alarm was
 * running and had just gone red. Liveness is still satisfied by run 7, and
 * that is still asserted; what changed is that the newer failure now decides
 * the state instead of being hidden by the older success.
 */
pipeline test_a_newer_failure_still_leaves_liveness_answered() {
  const verdict = pin_staleness_heartbeat_verdict(
    [
      run(8, "completed", "failure", "2026-08-28T12:00:00Z"),
      run(7, "completed", "success", "2026-08-28T11:37:00Z"),
    ],
    NOW,
    2,
  )
  assert_eq(verdict.state, "subject_failed", "the newer failure decides the state")
  assert(!verdict.silent, "a fresh success means the alarm is still running")
  assert_eq(verdict.newest_success_id, 7, "liveness is still answered by the older success")
}

pipeline test_an_unreadable_timestamp_is_not_treated_as_recent() {
  const verdict = pin_staleness_heartbeat_verdict(
    [run(3, "completed", "success", "not-a-timestamp")],
    NOW,
    2,
  )
  assert(verdict.silent, "a corrupt clock must not mint a pulse")
  assert_eq(verdict.newest_success_id, nil)
}

pipeline test_heartbeat_issue_body_carries_the_upsert_marker() {
  const silent = pin_staleness_heartbeat_verdict([], NOW, 2)
  const body = heartbeat_issue_body(silent, 2, "https://example.test/run/1")
  assert(contains(body, HEARTBEAT_ISSUE_MARKER), body)
  assert(contains(body, PIN_STALENESS_WORKFLOW), body)
  assert(contains(body, "https://example.test/run/1"), body)
  assert(!contains(heartbeat_issue_body(silent, 2, nil), "Detected by"))
}

pipeline test_open_issue_query_is_scoped_to_the_heartbeat_label() {
  assert_eq(
    github_open_issues_query(HEARTBEAT_LABEL),
    {labels: HEARTBEAT_LABEL, state: "open", per_page: 100},
  )
}

pipeline test_heartbeat_cli_boundary() {
  const parsed = parse_pin_staleness_heartbeat_args(
    ["--dry-run", "--max-age-days", "3", "--repo", "burin-labs/other"],
  )
  assert_eq(parsed.dry_run, true)
  assert_eq(resolve_max_age_days(parsed.max_age_days), 3)
  assert_eq(parsed.repo, "burin-labs/other")
  assert_eq(parsed.workflow, PIN_STALENESS_WORKFLOW)
  const defaults = parse_pin_staleness_heartbeat_args([])
  assert_eq(resolve_max_age_days(defaults.max_age_days), 2)
  assert_eq(defaults.dry_run, false)
  assert_eq(defaults.repo, "burin-labs/harn-bump-fleet")
}

pipeline test_a_non_positive_age_ceiling_is_refused_rather_than_ignored() {
  assert(contains(thrown({ -> resolve_max_age_days("two") }), "positive integer"))
  assert(contains(thrown({ -> resolve_max_age_days("0") }), "positive integer"))
  assert(contains(thrown({ -> resolve_max_age_days("-1") }), "positive integer"))
  assert_eq(resolve_max_age_days("1"), 1)
}

/**
 * The defect this heartbeat shipped with: an older success spoke for a newer
 * failure.
 *
 * On 2026-09-07 the pin-staleness alarm failed at 11:41 and this heartbeat
 * reported success at 13:42. Both halves are asserted, because a verdict that
 * simply refused everything would satisfy a one-sided check: a red newest run
 * fails even though a fresh success exists, and a green newest run still
 * passes with that same fresh success.
 */
@test
pipeline test_a_failed_newest_run_is_not_excused_by_an_older_success() {
  const verdict = pin_staleness_heartbeat_verdict(
    [
      run(2, "completed", "failure", "2026-08-28T11:41:00Z"),
      run(1, "completed", "success", "2026-08-28T09:00:00Z"),
    ],
    NOW,
    2,
  )
  assert_eq(verdict.state, "subject_failed", "the subject's own verdict decides the state")
  assert(verdict.subject_failed, "a red newest run is reported as a red subject")
  assert_eq(
    verdict.newest_completed_id,
    2,
    "the newest FINISHED run is the subject, not the newest success",
  )
  assert_eq(
    verdict.newest_completed_conclusion,
    "failure",
    "its conclusion travels with the verdict",
  )
  assert_eq(verdict.newest_success_id, 1, "liveness is still answered separately")
  assert(!verdict.silent, "the alarm is running, so it is not silent")
}

@test
pipeline test_a_successful_newest_run_still_passes() {
  const verdict = pin_staleness_heartbeat_verdict(
    [
      run(2, "completed", "success", "2026-08-28T11:41:00Z"),
      run(1, "completed", "failure", "2026-08-28T09:00:00Z"),
    ],
    NOW,
    2,
  )
  assert_eq(verdict.state, "fresh", "an older failure does not condemn a newer success")
  assert(!verdict.subject_failed, "the subject is clean")
  assert_eq(verdict.newest_completed_id, 2, "the newest finished run is the subject")
}

/**
 * A conclusion that is not `success` is not a pass, whatever it is called.
 *
 * `cancelled` and `timed_out` are how a scheduled alarm dies quietly, and
 * treating anything other than an explicit failure as fine would put the
 * original defect back under a different name.
 */
@test
pipeline test_a_cancelled_newest_run_is_a_red_subject() {
  const verdict = pin_staleness_heartbeat_verdict(
    [
      run(2, "completed", "cancelled", "2026-08-28T11:41:00Z"),
      run(1, "completed", "success", "2026-08-28T09:00:00Z"),
    ],
    NOW,
    2,
  )
  assert(verdict.subject_failed, "cancelled is not success")
  assert_eq(
    verdict.newest_completed_conclusion,
    "cancelled",
    "the conclusion is named, not flattened",
  )
}

/**
 * A run still going is not yet a verdict.
 *
 * Reading an in-progress run as failure would make the heartbeat red for the
 * duration of every alarm run, which trains an operator to ignore it.
 */
@test
pipeline test_an_in_progress_newest_run_is_not_a_verdict() {
  const verdict = pin_staleness_heartbeat_verdict(
    [
      run(2, "in_progress", nil, "2026-08-28T11:41:00Z"),
      run(1, "completed", "success", "2026-08-28T09:00:00Z"),
    ],
    NOW,
    2,
  )
  assert(!verdict.subject_failed, "an unfinished run has decided nothing")
  assert_eq(verdict.state, "fresh", "the last finished run still speaks")
  assert_eq(verdict.newest_completed_id, 1, "the unfinished run is not the subject")
}

/**
 * The negative control the issue asks for: a clean fleet must report a count,
 * not report nothing.
 *
 * A monitor that returns a bare boolean cannot be told apart from one that
 * examined an empty list, which is the shape this whole class of defect takes.
 */
@test
pipeline test_every_verdict_carries_how_much_it_examined() {
  const clean = pin_staleness_heartbeat_verdict(
    [run(1, "completed", "success", "2026-08-28T09:00:00Z")],
    NOW,
    2,
  )
  assert_eq(clean.examined_count, 1, "a clean verdict still reports what it looked at")
  assert_eq(clean.completed_count, 1, "and how much of it had finished")
  const nothing = pin_staleness_heartbeat_verdict([], NOW, 2)
  assert_eq(nothing.examined_count, 0, "examining nothing is reported as zero, not as clean")
  assert(nothing.silent, "a verdict over no runs is silence")
  assert(!nothing.subject_failed, "no runs is not the same as a failed run")
}

/** A red subject must reach the operator through the issue body, not just the exit code. */
@test
pipeline test_the_alarm_issue_names_a_red_subject() {
  const verdict = pin_staleness_heartbeat_verdict(
    [
      run(2, "completed", "failure", "2026-08-28T11:41:00Z"),
      run(1, "completed", "success", "2026-08-28T09:00:00Z"),
    ],
    NOW,
    2,
  )
  const body = heartbeat_issue_body(verdict, 2, nil)
  assert(contains(body, "failure"), "the body names the conclusion")
  assert(contains(body, "harn-pin-staleness"), "and points at where the repository names live")
  assert(contains(body, "Examined 2 run(s)"), "the census travels with the alarm")
}
