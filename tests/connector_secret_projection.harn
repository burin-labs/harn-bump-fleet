import {
  project_connector_required_secrets,
  render_required_secrets,
  sync_connector_secret_repo,
} from "../lib/connector_secret_projection"
import {
  ConnectorRequiredSecret,
  FleetRepository,
  connector_secret_schema,
  read_fleet_manifest,
} from "../lib/fleet_manifest"

const SECRETS: list<ConnectorRequiredSecret> = [
  {id: "example/api-token", direction: "outbound"},
  {id: "example/webhook-secret", direction: "inbound"},
]

fn repo() -> FleetRepository {
  return {
    slug: "burin-labs/harn-example-connector",
    directory: "harn-example-connector",
    harn_package: true,
    package_ci_ownership: "fleet",
    harn_bump: true,
    bump_workflow_ownership: "fleet",
    connector_required_secrets: SECRETS,
  }
}

pipeline test_connector_registry_covers_all_first_party_connector_repositories(harness: Harness) {
  const manifest = read_fleet_manifest(harness.fs, "../fleet.toml")
  const connectors = manifest.repositories.filter(
    { entry -> starts_with(entry.slug, "burin-labs/harn-") && ends_with(entry.slug, "-connector") },
  )
    .to_list()
  assert_eq(len(connectors), 19)
  assert(connectors.all({ entry -> entry.connector_required_secrets != nil }))
  assert(
    connectors.any({ entry -> entry.slug == "burin-labs/harn-duffel-connector" }),
    "Duffel must not remain outside the fleet projection",
  )
  assert_eq(connector_secret_schema(manifest), "legacy")
}

pipeline test_required_secret_renderer_has_one_exact_projection_per_schema() {
  assert_eq(
    render_required_secrets(SECRETS, "legacy"),
    ["required_secrets = [\"example/api-token\", \"example/webhook-secret\"]"],
  )
  assert_eq(
    render_required_secrets(SECRETS, "direction-v1"),
    [
      "required_secrets = [",
      "  { id = \"example/api-token\", direction = \"outbound\" },",
      "  { id = \"example/webhook-secret\", direction = \"inbound\" },",
      "]",
    ],
  )
}

pipeline test_projection_changes_only_the_owned_manifest_field() {
  const before = """[package]
name = "example"

[providers.setup]
auth_type = "api-key"
required_secrets = ["example/api-token", "example/webhook-secret"]
setup_command = ["harn", "connect", "example"]

[[providers.setup.health_checks]]
kind = "auth"
"""
    + "\n"
  const after = """[package]
name = "example"

[providers.setup]
auth_type = "api-key"
required_secrets = [
  { id = "example/api-token", direction = "outbound" },
  { id = "example/webhook-secret", direction = "inbound" },
]
setup_command = ["harn", "connect", "example"]

[[providers.setup.health_checks]]
kind = "auth"
"""
    + "\n"
  assert_eq(project_connector_required_secrets(before, repo(), "direction-v1"), after)
  assert_eq(project_connector_required_secrets(after, repo(), "direction-v1"), after)
}

pipeline test_projection_is_dry_run_first_and_idempotent(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("connector-secrets-")
  const checkout = path_join(root, repo().directory)
  harness.fs.mkdir(checkout, true)
  harness.fs.write_text(path_join(checkout, ".git"), "gitdir: fixture\n")
  harness.fs.write_text(
    path_join(checkout, "harn.toml"),
    "[providers.setup]\nrequired_secrets = [\"old/value\"]\n",
  )
  assert_eq(
    sync_connector_secret_repo(harness.fs, repo(), root, "direction-v1", false).status,
    "drift",
  )
  assert_eq(
    sync_connector_secret_repo(harness.fs, repo(), root, "direction-v1", true).status,
    "applied",
  )
  assert_eq(
    sync_connector_secret_repo(harness.fs, repo(), root, "direction-v1", false).status,
    "clean",
  )
}

pipeline test_projection_refuses_missing_or_unclosed_required_secrets() {
  const missing = "[providers.setup]\nauth_type = \"api-key\"\n"
  const unclosed = "[providers.setup]\nrequired_secrets = [\n  \"example/api-token\",\n"
  assert(
    is_err(
      try {
        project_connector_required_secrets(missing, repo(), "legacy")
      },
    ),
  )
  assert(
    is_err(
      try {
        project_connector_required_secrets(unclosed, repo(), "legacy")
      },
    ),
  )
}
