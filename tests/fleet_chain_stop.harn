import {
  CHAIN_TRANSIENT_RETRY_BUDGET,
  fleet_chain_refusal,
  fleet_chain_stop_decision,
} from "../lib/fleet_chain_stop"
import {
  fleet_default_branch_observation,
  fleet_default_branch_refusal,
} from "../lib/fleet_default_branch_proof"
import { harn_update_continuation } from "../lib/harn_update"

const SHA: string = "2222222222222222222222222222222222222222"

// The record the connector returned on every one of the eight rounds. Its
// category is the code, because the connector has no mapping for this code and
// falls through to it; that fall-through is exactly what the stop rule reads.
const CENSUS_RACE: dict = {
  category: "incomplete_page",
  code: "incomplete_page",
  message: "could not attribute an Actions check to an exact-head workflow generation",
}

const PERMISSION_REFUSAL: dict = {
  category: "permission",
  code: "missing_scopes",
  http_status: 403,
  message: "github API request failed with status 403",
}

fn refused_row(repo: string, error: dict) -> dict {
  const proof = fleet_default_branch_refusal(fleet_default_branch_observation(nil, error, nil), SHA)
  return {
    repo: repo,
    state: "failed",
    reason: "default_branch_checks_unproven: " + proof.unproven.join(", "),
    default_branch_check_proof: proof,
  }
}

fn checks_failing_row(repo: string) -> dict {
  return {repo: repo, state: "failed", reason: "checks_failing", pr_number: 7, head_sha: SHA}
}

/**
 * The classification has to survive the round boundary.
 *
 * The chain's decision reads the round's persisted proof receipt and nothing
 * else. If the class did not ride on the proof, the only thing left on the far
 * side would be the reason sentence, and reconstructing a category from prose
 * is the guess the observation module exists to avoid.
 */
pipeline test_the_refusal_class_rides_on_the_persisted_proof(task: any) {
  const row = refused_row("owner/consumer", CENSUS_RACE)
  assert_eq(row.default_branch_check_proof.refusal.disposition, "refuse")
  assert_eq(row.default_branch_check_proof.refusal.code, "incomplete_page")
  assert_eq(row.default_branch_check_proof.refusal.category, "incomplete_page")
  const classified = fleet_chain_refusal(row)
  assert(classified != nil)
  assert_eq(unwrap(classified).kind, "transient")
  assert_eq(unwrap(classified).code, "incomplete_page")
  assert_eq(unwrap(classified).repo, "owner/consumer")
}

/** A row still running is not a refusal, and must not be counted as one. */
pipeline test_a_waiting_row_is_not_a_refusal(task: any) {
  assert_eq(fleet_chain_refusal({repo: "owner/consumer", state: "waiting", reason: "pending"}), nil)
  assert_eq(fleet_chain_refusal({repo: "owner/consumer", state: "proven", reason: "ok"}), nil)
}

/**
 * The falsifier from the issue: a round whose refusals are all final schedules
 * no successor, and the run says which repositories ended it.
 */
pipeline test_a_round_of_only_final_refusals_stops_the_chain(task: any) {
  const decision = fleet_chain_stop_decision(
    [refused_row("owner/a", PERMISSION_REFUSAL), refused_row("owner/b", PERMISSION_REFUSAL)],
  )
  assert(decision.stop)
  assert_eq(decision.reason, "refusals_not_code_repairable")
  assert_eq(decision.final, ["owner/a", "owner/b"])
  assert_eq(decision.transient, [])
  assert(contains(decision.summary, "owner/a"))
  assert(contains(decision.summary, "owner/b"))
  const continuation = harn_update_continuation(1, 4, false, true, decision)
  assert_eq(continuation.continue, false)
  assert_eq(continuation.reason, "refusals_not_code_repairable")
  assert_eq(continuation.next_round, nil)
  assert_eq(continuation.detail, decision.summary)
}

/**
 * The control from the issue. Round 1 of a chain with real work left still
 * schedules round 2, and one repairable repository is enough even when the
 * rest refused.
 */
pipeline test_a_repairable_failure_still_continues(task: any) {
  const decision = fleet_chain_stop_decision(
    [refused_row("owner/a", PERMISSION_REFUSAL), checks_failing_row("owner/b")],
  )
  assert_eq(decision.stop, false)
  assert_eq(decision.reason, "repairable_failures_remain")
  assert_eq(decision.repairable, ["owner/b"])
  assert(contains(decision.summary, "owner/b"))
  const continuation = harn_update_continuation(1, 4, false, true, decision)
  assert(continuation.continue)
  assert_eq(continuation.next_round, 2)
}

/**
 * The control from the refinement, both halves.
 *
 * Stopping the chain on the census race would have been stopping on a race, so
 * the first round of it earns one more round. The second identical round does
 * not: a refusal that survived the retry is not the settling index it was
 * classified as, and the chain has no further reason to spend a round.
 */
pipeline test_a_transient_refusal_retries_once_then_stops(task: any) {
  const rows = [refused_row("owner/a", CENSUS_RACE), refused_row("owner/b", CENSUS_RACE)]
  const first = fleet_chain_stop_decision(rows, 0)
  assert_eq(first.stop, false)
  assert_eq(first.reason, "transient_refusal_retry")
  assert_eq(first.transient, ["owner/a", "owner/b"])
  assert_eq(first.final, [])
  // Counted by name: the summary carries both the repository and the code, so
  // a reader does not have to open an artifact to learn what was retried.
  assert(contains(first.summary, "owner/a (incomplete_page)"))
  assert(contains(first.summary, "owner/b (incomplete_page)"))
  assert_eq(first.next_transient_retries, 1)
  const continued = harn_update_continuation(1, 4, false, true, first)
  assert(continued.continue)
  assert_eq(continued.next_transient_retries, 1)
  const second = fleet_chain_stop_decision(rows, first.next_transient_retries)
  assert(second.stop)
  assert_eq(second.reason, "transient_retry_budget_exhausted")
  assert_eq(second.transient_retries_used, 1)
  assert(contains(second.summary, "owner/a (incomplete_page)"))
  const stopped = harn_update_continuation(2, 4, false, true, second)
  assert_eq(stopped.continue, false)
  assert_eq(stopped.reason, "transient_retry_budget_exhausted")
  assert_eq(stopped.next_round, nil)
}

/** The budget is one round, stated once, and the retry accounting reports it. */
pipeline test_the_transient_retry_budget_is_one_round(task: any) {
  assert_eq(CHAIN_TRANSIENT_RETRY_BUDGET, 1)
  const decision = fleet_chain_stop_decision([refused_row("owner/a", CENSUS_RACE)])
  assert_eq(decision.transient_retry_budget, 1)
  assert_eq(decision.transient_retries_used, 0)
}

/**
 * Absence must not read as a stop.
 *
 * A round whose proof receipt never arrived classified nothing. Treating that
 * as "no refusals left" would end a chain on silence, which is the failure
 * shape this rule is meant to remove, not create.
 */
pipeline test_no_rows_defers_to_the_round_limit(task: any) {
  const decision = fleet_chain_stop_decision([])
  assert_eq(decision.stop, false)
  assert_eq(decision.reason, "no_refusals_to_classify")
  const continued = harn_update_continuation(1, 4, false, true, decision)
  assert(continued.continue)
  assert_eq(continued.next_round, 2)
  // And the round limit still ends the chain with a decision present.
  const capped = harn_update_continuation(4, 4, false, true, decision)
  assert_eq(capped.continue, false)
  assert_eq(capped.reason, "repair_round_limit_reached")
}

/** A proven round and a repair-disabled round outrank any classification. */
pipeline test_proof_and_repair_switch_outrank_the_stop_rule(task: any) {
  const decision = fleet_chain_stop_decision([checks_failing_row("owner/b")])
  assert_eq(harn_update_continuation(1, 4, true, true, decision).reason, "update_proven")
  assert_eq(harn_update_continuation(1, 4, false, false, decision).reason, "repair_disabled")
}

/**
 * An unclassified failure is final by default.
 *
 * A round that meets a failure shape nobody has classified has not been shown
 * to clear it, and the expensive mistake runs the other way.
 */
pipeline test_an_unclassified_failure_is_final(task: any) {
  const decision = fleet_chain_stop_decision(
    [{repo: "owner/a", state: "failed", reason: "update_proof_failed"}],
  )
  assert(decision.stop)
  assert_eq(decision.reason, "refusals_not_code_repairable")
  assert_eq(decision.final, ["owner/a"])
}

/** A branch that lost its pull request is recovered by a round, not by a person. */
pipeline test_a_missing_target_branch_pull_request_is_repairable(task: any) {
  const decision = fleet_chain_stop_decision(
    [{repo: "owner/a", state: "failed", reason: "target_branch_missing_pull_request"}],
  )
  assert_eq(decision.stop, false)
  assert_eq(decision.repairable, ["owner/a"])
}
