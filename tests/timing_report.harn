import { timed } from "std/timing"
import {
  slowest_timing_rows,
  timing_artifacts,
  timing_duration_label,
  timing_summary_lines,
  user_timing_spans,
} from "../lib/timing_report"

pipeline test_timing_artifacts_include_user_span_summary(task) {
  mock_time(1700000000000)
  const outcome = timed(
    "test.phase",
    {phase: "steel-thread"},
    { ->
      advance_time(250)
      return "done"
    },
  )
  unmock_time()
  assert_eq(outcome.result, "done")
  const artifacts = timing_artifacts()
  const spans = user_timing_spans(artifacts.trace_spans).filter(
    { span -> span.name == "test.phase" },
  )
  assert_eq(len(spans), 1)
  assert_eq(spans[0].attributes.phase, "steel-thread")
  assert(spans[0].duration_ms >= 250)
  const summary = artifacts.timing_summary
  assert(summary.span_count >= 1)
  const phase = summary.by_name["test.phase"]
  assert_eq(phase.count, 1)
  assert(phase.duration_ms >= 250)
  assert_eq(phase.error_count, 0)
}

pipeline test_timing_summary_lines_show_slowest_phases(task) {
  const summary = {
    by_name: {
      "release.fast": {count: 1, duration_ms: 500, max_duration_ms: 500, error_count: 0},
      "release.prepare": {count: 2, duration_ms: 125000, max_duration_ms: 90000, error_count: 0},
      "release.publish": {count: 1, duration_ms: 65000, max_duration_ms: 65000, error_count: 1},
    },
  }
  const rows = slowest_timing_rows(summary, {limit: 2, min_duration_ms: 1000})
  assert_eq(len(rows), 2)
  assert_eq(rows[0].name, "release.prepare")
  assert_eq(rows[1].name, "release.publish")
  const lines = timing_summary_lines(summary, {limit: 2, min_duration_ms: 1000})
  assert_eq(lines[0], "release.prepare: 2:05 total across 2 spans, max 1:30")
  assert_eq(lines[1], "release.publish: 1:05, errors 1")
  assert_eq(timing_duration_label(999), "999ms")
  assert_eq(timing_duration_label(10000), "10s")
}
