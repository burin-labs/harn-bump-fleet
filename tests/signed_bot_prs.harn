import {
  default_temp_path,
  is_bot_pr_author,
  normalize_pr_signature_payload,
  parse_pr_numbers,
  queued_pr_numbers,
  rewrite_command_plan,
  signed_bot_pr_decision,
  unsigned_commits,
} from "../lib/signed_bot_prs"

fn sample_payload(
  signature_state = nil,
  author_type = "Bot",
  cross_repository = false,
  author_login = "dependabot[bot]",
) {
  return {
    data: {
      repository: {
        pullRequest: {
          number: 42,
          title: "build(deps): bump example from 1.0.0 to 1.0.1",
          url: "https://github.com/burin-labs/example/pull/42",
          state: "OPEN",
          isCrossRepository: cross_repository,
          mergeStateStatus: "BLOCKED",
          baseRefName: "main",
          headRefName: "dependabot/cargo/example-1.0.1",
          headRefOid: "abcdef1234567890abcdef1234567890abcdef12",
          author: {login: author_login, __typename: author_type},
          headRepositoryOwner: {login: "burin-labs"},
          headRepository: {
            nameWithOwner: if cross_repository {
              "dependabot/example"
            } else {
              "burin-labs/example"
            },
          },
          autoMergeRequest: {enabledAt: "2026-06-29T00:00:00Z"},
          commits: {
            nodes: [
              {
                commit: {
                  oid: "abc1",
                  messageHeadline: "build(deps): bump example",
                  signature: if signature_state == nil {
                    nil
                  } else {
                    {state: signature_state, signer: {login: "dependabot"}}
                  },
                },
              },
            ],
          },
        },
      },
    },
  }
}

pipeline test_parse_pr_numbers(task) {
  assert_eq(parse_pr_numbers("1, 2,3"), [1, 2, 3])
  assert_eq(parse_pr_numbers(""), [])
  var caught = ""
  try {
    parse_pr_numbers("12,nope")
  } catch (e) {
    caught = to_string(e)
  }
  assert(contains(caught, "invalid pull request number"))
}

pipeline test_normalize_signature_payload(task) {
  let pr = normalize_pr_signature_payload("burin-labs/example", sample_payload())
  assert_eq(pr.number, 42)
  assert_eq(pr.head_ref_name, "dependabot/cargo/example-1.0.1")
  assert_eq(pr.head_oid, "abcdef1234567890abcdef1234567890abcdef12")
  assert_eq(pr.cross_repository, false)
  assert_eq(len(unsigned_commits(pr)), 1)
  assert_eq(is_bot_pr_author(pr), true)
  let signed = normalize_pr_signature_payload("burin-labs/example", sample_payload("VALID"))
  assert_eq(len(unsigned_commits(signed)), 0)
}

pipeline test_queue_payload_normalization(task) {
  let payload = {
    data: {
      repository: {
        mergeQueue: {entries: {nodes: [{pullRequest: {number: 10}}, {pullRequest: {number: 42}}, {pullRequest: nil}]}},
      },
    },
  }
  assert_eq(queued_pr_numbers(payload), [10, 42])
}

pipeline test_signed_bot_decision_refuses_risky_cases(task) {
  let pr = normalize_pr_signature_payload("burin-labs/example", sample_payload())
  let queued = signed_bot_pr_decision(pr, [42], {})
  assert_eq(queued.eligible, false)
  assert_eq(queued.action, "refuse")
  assert(contains(queued.detail, "merge queue"))
  let human = normalize_pr_signature_payload("burin-labs/example", sample_payload(nil, "User", false, "ksinder"))
  let human_decision = signed_bot_pr_decision(human, [], {})
  assert_eq(human_decision.eligible, false)
  assert(contains(human_decision.detail, "not recognized as a bot"))
  let fork = normalize_pr_signature_payload("burin-labs/example", sample_payload(nil, "Bot", true))
  let fork_decision = signed_bot_pr_decision(fork, [], {})
  assert_eq(fork_decision.eligible, false)
  assert(contains(fork_decision.detail, "cross-repository"))
}

pipeline test_signed_bot_decision_rewrites_only_unsigned_bots(task) {
  let pr = normalize_pr_signature_payload("burin-labs/example", sample_payload())
  let decision = signed_bot_pr_decision(pr, [], {})
  assert_eq(decision.eligible, true)
  assert_eq(decision.action, "rewrite")
  assert_eq(decision.unsigned_count, 1)
  let signed = normalize_pr_signature_payload("burin-labs/example", sample_payload("VALID"))
  let no_op = signed_bot_pr_decision(signed, [], {})
  assert_eq(no_op.eligible, false)
  assert_eq(no_op.action, "already_signed")
}

pipeline test_rewrite_command_plan_uses_exact_lease_and_fsmonitor_off(task) {
  let pr = normalize_pr_signature_payload("burin-labs/example", sample_payload())
  let temp = default_temp_path("burin-labs/example", 42, pr.head_oid)
  assert_eq(temp, "/tmp/harn-signed-bot-prs/burin-labs-example-pr-42-abcdef123456")
  let plan = rewrite_command_plan(
    "burin-labs/example",
    pr,
    {home: "/Users/example", trailer: "Co-Authored-By: Codex <codex@openai.com>"},
  )
  assert_eq(plan.checkout, "/Users/example/projects/example")
  assert_eq(plan.branch, "dependabot/cargo/example-1.0.1")
  let names = plan.commands.map({ c -> c.name })
  assert_eq(
    names,
    [
      "fetch-pr-head",
      "mkdir-temp-root",
      "add-temp-worktree",
      "disable-temp-fsmonitor",
      "soft-reset-to-base",
      "create-signed-commit",
      "push-signed-head",
      "remove-temp-worktree",
    ],
  )
  assert(contains(plan.commands[0].argv, "core.fsmonitor=false"))
  assert(contains(plan.commands[4].argv, "reset"))
  assert(contains(plan.commands[4].argv, "origin/main"))
  assert(
    contains(
      plan.commands[6].argv,
      "--force-with-lease=refs/heads/dependabot/cargo/example-1.0.1:abcdef1234567890abcdef1234567890abcdef12",
    ),
  )
}
