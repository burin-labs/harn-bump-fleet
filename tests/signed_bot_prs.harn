import { command_result_fail, command_result_ok } from "std/command"
import {
  checkout_origin_check,
  default_temp_path,
  is_bot_pr_author,
  maybe_enable_auto_merge,
  parse_pr_numbers,
  rewrite_command_plan,
  signed_bot_pr_decision,
  unsigned_commits,
} from "../lib/signed_bot_prs"

fn sample_pr(
  signature_verified = false,
  author_type = "Bot",
  cross_repository = false,
  author_login = "dependabot[bot]",
) {
  const head_repo = if cross_repository {
    "dependabot/example"
  } else {
    "burin-labs/example"
  }
  return {
    slug: "burin-labs/example",
    number: 42,
    title: "build(deps): bump example from 1.0.0 to 1.0.1",
    url: "https://github.com/burin-labs/example/pull/42",
    state: "open",
    base_ref_name: "main",
    head_ref_name: "dependabot/cargo/example-1.0.1",
    head_oid: "abcdef1234567890abcdef1234567890abcdef12",
    head_repo: head_repo,
    head_owner: if cross_repository {
      "dependabot"
    } else {
      "burin-labs"
    },
    author_login: author_login,
    author_type: author_type,
    merge_state_status: "blocked",
    auto_merge_enabled: true,
    cross_repository: cross_repository,
    commits: [
      {
        oid: "abc1",
        message: "build(deps): bump example",
        signature_verified: signature_verified,
        signature_reason: if signature_verified {
          "valid"
        } else {
          "unsigned"
        },
      },
    ],
  }
}

pipeline test_parse_pr_numbers(task) {
  assert_eq(parse_pr_numbers("1, 2,3"), [1, 2, 3])
  assert_eq(parse_pr_numbers(""), [])
  let caught = ""
  try {
    parse_pr_numbers("12,nope")
  } catch (e) {
    caught = to_string(e)
  }
  assert(contains(caught, "invalid pull request number"))
}

pipeline test_signature_evidence_projection(task) {
  const pr = sample_pr()
  assert_eq(pr.number, 42)
  assert_eq(pr.head_ref_name, "dependabot/cargo/example-1.0.1")
  assert_eq(pr.head_oid, "abcdef1234567890abcdef1234567890abcdef12")
  assert_eq(pr.cross_repository, false)
  assert_eq(len(unsigned_commits(pr)), 1)
  assert_eq(is_bot_pr_author(pr), true)
  const signed = sample_pr(true)
  assert_eq(len(unsigned_commits(signed)), 0)
}

pipeline test_signed_bot_decision_refuses_risky_cases(task) {
  const pr = sample_pr()
  const queued = signed_bot_pr_decision(pr, [42], {})
  assert_eq(queued.eligible, false)
  assert_eq(queued.action, "refuse")
  assert(contains(queued.detail, "merge queue"))
  const human = sample_pr(false, "User", false, "ksinder")
  const human_decision = signed_bot_pr_decision(human, [], {})
  assert_eq(human_decision.eligible, false)
  assert(contains(human_decision.detail, "not recognized as a bot"))
  const fork = sample_pr(false, "Bot", true)
  const fork_decision = signed_bot_pr_decision(fork, [], {})
  assert_eq(fork_decision.eligible, false)
  assert(contains(fork_decision.detail, "cross-repository"))
}

pipeline test_signed_bot_decision_rewrites_only_unsigned_bots(task) {
  const pr = sample_pr()
  const decision = signed_bot_pr_decision(pr, [], {})
  assert_eq(decision.eligible, true)
  assert_eq(decision.action, "rewrite")
  assert_eq(decision.unsigned_count, 1)
  const signed = sample_pr(true)
  const no_op = signed_bot_pr_decision(signed, [], {})
  assert_eq(no_op.eligible, false)
  assert_eq(no_op.action, "already_signed")
}

pipeline test_rewrite_command_plan_uses_exact_lease_and_fsmonitor_off(harness: Harness, task) {
  const pr = sample_pr()
  const temp = default_temp_path(harness.random, "burin-labs/example", 42, pr.head_oid)
  const second_temp = default_temp_path(harness.random, "burin-labs/example", 42, pr.head_oid)
  assert(starts_with(temp, "/tmp/harn-signed-bot-prs/burin-labs-example-pr-42-abcdef123456-"))
  assert(temp != second_temp, "parallel rewrites use distinct worktrees")
  const plan = rewrite_command_plan(
    harness.random,
    "burin-labs/example",
    pr,
    {
      home: "/Users/example",
      temp_path: "/tmp/harn-signed-bot-prs/test-pr-42",
      trailer: "Co-Authored-By: Codex <codex@openai.com>",
    },
  )
  assert_eq(plan.checkout, "/Users/example/projects/example")
  assert_eq(plan.temp_path, "/tmp/harn-signed-bot-prs/test-pr-42")
  assert_eq(plan.branch, "dependabot/cargo/example-1.0.1")
  const names = plan.commands.map({ c -> c.name })
  assert_eq(
    names,
    [
      "fetch-pr-head",
      "mkdir-temp-root",
      "add-temp-worktree",
      "disable-temp-fsmonitor",
      "soft-reset-to-base",
      "create-signed-commit",
      "push-signed-head",
      "remove-temp-worktree",
    ],
  )
  assert(contains(plan.commands[0]?.argv ?? [], "core.fsmonitor=false"))
  assert(contains(plan.commands[4]?.argv ?? [], "reset"))
  assert(contains(plan.commands[4]?.argv ?? [], "origin/main"))
  assert(
    contains(
      plan.commands[6]?.argv ?? [],
      "--force-with-lease=refs/heads/dependabot/cargo/example-1.0.1:abcdef1234567890abcdef1234567890abcdef12",
    ),
  )
}

pipeline test_disabled_auto_merge_is_a_typed_success(harness: Harness, task) {
  const result = maybe_enable_auto_merge(harness, "burin-labs/example", 42, "abcdef", false)
  assert(!is_err(result))
  assert_eq(unwrap(result).state, "skipped")
}

pipeline test_checkout_origin_check(task) {
  const ok_check = checkout_origin_check(
    "/repo/example",
    "burin-labs/example",
    { _argv -> return command_result_ok("git@github.com:burin-labs/example.git\n") },
  )
  assert_eq(ok_check.ok, true)
  const mismatch = checkout_origin_check(
    "/repo/example",
    "burin-labs/example",
    { _argv -> return command_result_ok("https://github.com/other/example.git\n") },
  )
  assert_eq(mismatch.ok, false)
  assert(contains(mismatch.detail, "expected burin-labs/example"))
  const missing = checkout_origin_check(
    "/repo/example",
    "burin-labs/example",
    { _argv -> return command_result_fail(1, "not a git repository") },
  )
  assert_eq(missing.ok, false)
  assert(contains(missing.detail, "could not read checkout origin"))
}
