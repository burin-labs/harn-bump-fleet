import { publish_failure_yank_lines, publish_watch_decision } from "../lib/release_health"

let REQUIRED = ["publish-release.yml", "build-release-binaries.yml"]

pipeline test_publish_watch_decision(task) {
  // No runs observed yet: pending.
  let none = publish_watch_decision({runs: [], required_workflows: REQUIRED, tag: "v0.8.154"})
  assert_eq(none.state, "pending")
  // One required workflow still in progress: pending.
  let partial = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(partial.state, "pending")
  assert_eq(contains(partial.message, "build-release-binaries.yml"), true)
  // Both required workflows green: healthy.
  let healthy = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(healthy.state, "healthy")
  // A failed conclusion wins over an otherwise-green sibling.
  let failed = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(failed.state, "failed")
  assert_eq(contains(failed.message, "build-release-binaries.yml"), true)
  // Cancelled counts as failed too.
  let cancelled = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "cancelled",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(cancelled.state, "failed")
  // Stale red runs from main or older release tags do not poison the new tag.
  let stale_red = publish_watch_decision(
    {
      runs: [
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          headBranch: "main",
        },
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(stale_red.state, "pending")
}

pipeline test_publish_failure_yank_lines(task) {
  let lines = publish_failure_yank_lines("v0.8.154", "burin-labs/harn")
  let joined = lines.join("\n")
  assert_eq(contains(joined, "v0.8.154"), true)
  assert_eq(contains(joined, "git push origin --delete v0.8.154"), true)
  assert_eq(contains(joined, "cargo yank"), true)
  assert_eq(contains(joined, "burin-labs/harn"), true)
  // Falls back to a placeholder slug when none is known.
  assert_eq(contains(publish_failure_yank_lines("v0.8.154", "").join("\n"), "<owner/repo>"), true)
}
