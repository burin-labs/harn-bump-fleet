import {
  post_publish_warm_cache_dispatch_decision,
  publish_binary_recovery_decision,
  publish_failure_recovery_lines,
  publish_watch_decision,
} from "../lib/release_health"

const REQUIRED = ["publish-release.yml", "build-release-binaries.yml"]

pipeline test_publish_watch_decision(task) {
  // No runs observed yet: pending.
  const none = publish_watch_decision({runs: [], required_workflows: REQUIRED, tag: "v0.8.154"})
  assert_eq(none.state, "pending")
  // One required workflow still in progress: pending.
  const partial = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          head_branch: "v0.8.154",
          url: "https://github.com/burin-labs/harn/actions/runs/22",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(partial.state, "pending")
  assert_eq(contains(partial.message, "build-release-binaries.yml"), true)
  assert_eq(contains(partial.message, "in_progress"), true)
  assert_eq(contains(partial.message, "actions/runs/22"), true)
  // Both required workflows green: healthy.
  const healthy = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(healthy.state, "healthy")
  // A failed conclusion wins over an otherwise-green sibling.
  const failed = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:10:00Z",
          url: "https://github.com/burin-labs/harn/actions/runs/29",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(failed.state, "failed")
  assert_eq(failed.failed_workflows, ["build-release-binaries.yml"])
  assert_eq(failed.failed_runs[0].workflow, "build-release-binaries.yml")
  assert_eq(failed.failed_runs[0].conclusion, "failure")
  assert_eq(failed.failed_runs[0].url, "https://github.com/burin-labs/harn/actions/runs/29")
  assert_eq(contains(failed.message, "build-release-binaries.yml"), true)
  assert_eq(contains(failed.message, "completed/failure"), true)
  assert_eq(contains(failed.message, "actions/runs/29"), true)
  // GitHub keeps historical failed runs for a tag. The newest observed run
  // per workflow wins, so a successful manual rerun unblocks release reruns.
  const newer_success = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:05:00Z",
          url: "https://github.com/burin-labs/harn/actions/runs/30",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:00:00Z",
          url: "https://github.com/burin-labs/harn/actions/runs/28",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:10:00Z",
          url: "https://github.com/burin-labs/harn/actions/runs/29",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(newer_success.state, "healthy")
  // Conversely, a newer failed rerun stays red even if an older run was green.
  const newer_failure = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:05:00Z",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:00:00Z",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:10:00Z",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(newer_failure.state, "failed")
  assert_eq(newer_failure.failed_workflows, ["build-release-binaries.yml"])
  // Cancelled counts as failed too.
  const cancelled = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "cancelled",
          head_branch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(cancelled.state, "failed")
  // Stale red runs from main or older release tags do not poison the new tag.
  const stale_red = publish_watch_decision(
    {
      runs: [
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "main",
        },
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          head_branch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(stale_red.state, "pending")
}

pipeline test_post_publish_warm_cache_dispatch_decision(task) {
  const dispatch = post_publish_warm_cache_dispatch_decision(
    {enabled: true, publish_state: "healthy", slug: "burin-labs/harn"},
  )
  assert_eq(dispatch.should_dispatch, true)
  assert_eq(dispatch.workflow, "build-release-binaries.yml")
  assert_eq(dispatch.fields, {warm_cache_only: true})
  assert_eq(contains(dispatch.message, "burin-labs/harn"), true)
  assert_eq(
    post_publish_warm_cache_dispatch_decision(
      {enabled: true, publish_state: "pending", slug: "burin-labs/harn"},
    ).should_dispatch,
    false,
  )
  assert_eq(
    post_publish_warm_cache_dispatch_decision({enabled: true, publish_state: "healthy", slug: ""}).reason,
    "could not resolve repository slug",
  )
  assert_eq(
    post_publish_warm_cache_dispatch_decision(
      {enabled: false, publish_state: "healthy", slug: "burin-labs/harn"},
    ).reason,
    "post-publish warm-cache dispatch disabled",
  )
}

pipeline test_publish_failure_recovery_lines_for_binary_build(task) {
  const lines = publish_failure_recovery_lines("v0.8.154", "burin-labs/harn", ["build-release-binaries.yml"])
  const joined = lines.join("\n")
  assert_eq(contains(joined, "v0.8.154"), true)
  assert_eq(contains(joined, "build-release-binaries.yml"), true)
  assert_eq(
    contains(
      joined,
      "gh workflow run build-release-binaries.yml --repo burin-labs/harn -f tag=v0.8.154",
    ),
    true,
  )
  assert_eq(
    contains(joined, "harn run --no-sandbox wait_harn_release_ready.harn -- --tag v0.8.154"),
    true,
  )
  assert_eq(contains(joined, "git push origin --delete v0.8.154"), false)
  assert_eq(contains(joined, "cargo yank"), false)
}

pipeline test_publish_failure_recovery_lines_for_publish(task) {
  const lines = publish_failure_recovery_lines("v0.8.154", "burin-labs/harn", ["publish-release.yml"])
  const joined = lines.join("\n")
  assert_eq(contains(joined, "publish-release.yml"), true)
  assert_eq(contains(joined, "git push origin --delete v0.8.154"), true)
  assert_eq(contains(joined, "cargo yank"), true)
  assert_eq(contains(joined, "burin-labs/harn"), true)
  assert_eq(contains(joined, "gh workflow run build-release-binaries.yml"), false)
  // Falls back to a placeholder slug when none is known.
  assert_eq(
    contains(
      publish_failure_recovery_lines("v0.8.154", "", ["publish-release.yml"]).join("\n"),
      "<owner/repo>",
    ),
    true,
  )
}

pipeline test_publish_failure_recovery_lines_for_both_workflows(task) {
  const lines = publish_failure_recovery_lines(
    "v0.8.154",
    "burin-labs/harn",
    ["publish-release.yml", "build-release-binaries.yml"],
  )
  const joined = lines.join("\n")
  assert_eq(contains(joined, "git push origin --delete v0.8.154"), true)
  assert_eq(contains(joined, "gh workflow run build-release-binaries.yml"), true)
}

pipeline test_publish_binary_recovery_decision_dispatches_binary_only_failure(task) {
  const decision = publish_binary_recovery_decision(
    {
      tag: "v0.8.154",
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:00:00Z",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:10:00Z",
          url: "https://github.com/burin-labs/harn/actions/runs/29",
        },
      ],
    },
  )
  assert_eq(decision.should_dispatch, true)
  assert_eq(decision.workflow, "build-release-binaries.yml")
  assert_eq(decision.fields, {tag: "v0.8.154"})
  assert_eq(decision.failed_run.url, "https://github.com/burin-labs/harn/actions/runs/29")
}

pipeline test_publish_binary_recovery_decision_suppresses_active_build(task) {
  const decision = publish_binary_recovery_decision(
    {
      tag: "v0.8.154",
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:00:00Z",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          head_branch: "v0.8.154",
          created_at: "2026-07-02T10:10:00Z",
        },
      ],
    },
  )
  assert_eq(decision.should_dispatch, false)
  assert_eq(contains(decision.reason, "active"), true)
}

pipeline test_publish_binary_recovery_decision_keeps_publish_failures_manual(task) {
  const decision = publish_binary_recovery_decision(
    {
      tag: "v0.8.154",
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "v0.8.154",
        },
      ],
    },
  )
  assert_eq(decision.should_dispatch, false)
  assert_eq(contains(decision.reason, "publish-release.yml"), true)
}

pipeline test_publish_binary_recovery_decision_dispatches_once(task) {
  const decision = publish_binary_recovery_decision(
    {
      tag: "v0.8.154",
      already_dispatched: true,
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          head_branch: "v0.8.154",
        },
      ],
    },
  )
  assert_eq(decision.should_dispatch, false)
  assert_eq(contains(decision.reason, "already"), true)
}
