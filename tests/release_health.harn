import {
  publish_failure_yank_lines,
  publish_watch_decision,
  release_publish_watch_enabled,
  release_publish_watch_polling_defaults,
} from "../lib/release_health"

let REQUIRED = ["publish-release.yml", "build-release-binaries.yml"]

pipeline test_publish_watch_decision(task) {
  // No runs observed yet: pending.
  let none = publish_watch_decision({runs: [], required_workflows: REQUIRED, tag: "v0.8.154"})
  assert_eq(none.state, "pending")
  // One required workflow still in progress: pending.
  let partial = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          headBranch: "v0.8.154",
          url: "https://github.com/burin-labs/harn/actions/runs/22",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(partial.state, "pending")
  assert_eq(contains(partial.message, "build-release-binaries.yml"), true)
  assert_eq(contains(partial.message, "in_progress"), true)
  assert_eq(contains(partial.message, "actions/runs/22"), true)
  // Both required workflows green: healthy.
  let healthy = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(healthy.state, "healthy")
  // A failed conclusion wins over an otherwise-green sibling.
  let failed = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(failed.state, "failed")
  assert_eq(contains(failed.message, "build-release-binaries.yml"), true)
  // GitHub keeps historical failed runs for a tag. The newest observed run
  // per workflow wins, so a successful manual rerun unblocks release reruns.
  let newer_success = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
          createdAt: "2026-07-02T10:05:00Z",
          url: "https://github.com/burin-labs/harn/actions/runs/30",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          headBranch: "v0.8.154",
          createdAt: "2026-07-02T10:00:00Z",
          url: "https://github.com/burin-labs/harn/actions/runs/28",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
          createdAt: "2026-07-02T10:10:00Z",
          url: "https://github.com/burin-labs/harn/actions/runs/29",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(newer_success.state, "healthy")
  // Conversely, a newer failed rerun stays red even if an older run was green.
  let newer_failure = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
          createdAt: "2026-07-02T10:05:00Z",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
          createdAt: "2026-07-02T10:00:00Z",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          headBranch: "v0.8.154",
          createdAt: "2026-07-02T10:10:00Z",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(newer_failure.state, "failed")
  // Cancelled counts as failed too.
  let cancelled = publish_watch_decision(
    {
      runs: [
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "cancelled",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(cancelled.state, "failed")
  // Stale red runs from main or older release tags do not poison the new tag.
  let stale_red = publish_watch_decision(
    {
      runs: [
        {
          workflow: "build-release-binaries.yml",
          status: "completed",
          conclusion: "failure",
          headBranch: "main",
        },
        {
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v0.8.154",
        },
        {
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          headBranch: "v0.8.154",
        },
      ],
      required_workflows: REQUIRED,
      tag: "v0.8.154",
    },
  )
  assert_eq(stale_red.state, "pending")
}

pipeline test_release_publish_watch_enabled(task) {
  assert_eq(release_publish_watch_enabled({mode: "ship-pr", yes_live_release: true}), true)
  assert_eq(release_publish_watch_enabled({mode: "ship-pr", yes_live_release: false}), false)
  assert_eq(release_publish_watch_enabled({mode: "prepare", yes_live_release: true}), false)
  assert_eq(
    release_publish_watch_enabled({mode: "audit", yes_live_release: false, explicit_watch: true}),
    true,
  )
  assert_eq(
    release_publish_watch_enabled({mode: "ship-pr", yes_live_release: true, mock: true}),
    false,
  )
}

pipeline test_release_publish_watch_polling_defaults(task) {
  assert_eq(
    release_publish_watch_polling_defaults({mode: "ship-pr", yes_live_release: true}),
    {attempts: 240, interval_seconds: 30},
  )
  assert_eq(
    release_publish_watch_polling_defaults({mode: "ship-pr", yes_live_release: false}),
    {attempts: 20, interval_seconds: 15},
  )
  assert_eq(
    release_publish_watch_polling_defaults({mode: "audit", explicit_watch: true}),
    {attempts: 20, interval_seconds: 15},
  )
  assert_eq(
    release_publish_watch_polling_defaults({mode: "ship-pr", yes_live_release: true, mock: true}),
    {attempts: 20, interval_seconds: 15},
  )
}

pipeline test_publish_failure_yank_lines(task) {
  let lines = publish_failure_yank_lines("v0.8.154", "burin-labs/harn")
  let joined = lines.join("\n")
  assert_eq(contains(joined, "v0.8.154"), true)
  assert_eq(contains(joined, "git push origin --delete v0.8.154"), true)
  assert_eq(contains(joined, "cargo yank"), true)
  assert_eq(contains(joined, "burin-labs/harn"), true)
  // Falls back to a placeholder slug when none is known.
  assert_eq(contains(publish_failure_yank_lines("v0.8.154", "").join("\n"), "<owner/repo>"), true)
}
