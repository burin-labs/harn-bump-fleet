import { parse_admit_green_specs } from "../admit_green"
import {
  AdmissionMergeOutcome,
  admission_checks_summary,
  admission_receipt_line,
  admit_green_apply,
  admit_green_decide,
  is_exact_head,
  latest_check_per_name,
  required_check_state,
} from "../lib/pr_admission"

const HEAD = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const OTHER_HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn pr(fields: dict = {}) {
  return {
    number: 42,
    title: "Example",
    url: "https://github.com/burin-labs/example/pull/42",
    draft: false,
    github_state: "open",
    merged: false,
    mergeable_state: "MERGEABLE",
    auto_merge_armed: false,
    in_merge_queue: false,
    queue_membership: {available: true, queued: false, entry: nil},
    head: {sha: HEAD},
  }
    + fields
}

fn run(name: string, status: string, conclusion: string) {
  return {__typename: "CheckRun", name: name, status: status, conclusion: conclusion}
}

fn ctx(name: string, state: string) {
  return {__typename: "StatusContext", name: name, state: state}
}

/** A rollup that should admit: the aggregate gate plus one intentional skip. */
fn green_rollup() {
  return [
    run("CI status", "COMPLETED", "SUCCESS"),
    run("Rust tests", "COMPLETED", "SUCCESS"),
    run("Windows cross-compile", "COMPLETED", "SKIPPED"),
  ]
}

fn decide(pr_value: any, rollup: list, head: string = "") {
  return admit_green_decide("burin-labs/example", pr_value, rollup, "CI status", head)
}

fn refuse_merge(number: int, head: string) -> AdmissionMergeOutcome {
  throw "merge must not be issued (called for #${number} at ${head})"
}

fn merge_ok(number: int, head: string) -> AdmissionMergeOutcome {
  return {merged: true, detail: "merged ${number} at ${head}", policy_prohibited: false}
}

fn merge_policy_prohibited(number: int, head: string) -> AdmissionMergeOutcome {
  return {
    merged: false,
    detail: "Pull request is not mergeable: the base branch policy prohibits the merge.",
    policy_prohibited: true,
  }
}

fn merge_other_failure(number: int, head: string) -> AdmissionMergeOutcome {
  return {
    merged: false,
    detail: "Head branch was modified. Review and try the merge again.",
    policy_prohibited: false,
  }
}

fn rest_ok(number: int, head: string) -> AdmissionMergeOutcome {
  return {merged: true, detail: "{\"merged\":true,\"sha\":\"${head}\"}", policy_prohibited: false}
}

pipeline test_admits_a_green_pull_request_at_its_exact_head(task: any) {
  const verdict = decide(pr(), green_rollup(), HEAD)
  assert_eq(verdict.decision, "admit")
  assert_eq(verdict.method, "squash_head_match")
  assert_eq(verdict.head_sha, HEAD)
  assert_eq(verdict.total_checks, 3)
  assert_eq(verdict.pending_checks, 0)
  assert_eq(len(verdict.bad_checks), 0)
  assert_eq(verdict.required_check_state, "SUCCESS")
}

/**
 * The latest-per-name guard.
 *
 * A respawned run leaves its predecessor's FAILURE row in the rollup beside the
 * fresh SUCCESS. Reading every row would hold this pull request forever.
 */
pipeline test_a_respawned_check_run_does_not_read_as_a_permanent_failure(task: any) {
  const rollup = [
    run("CI status", "COMPLETED", "FAILURE"),
    run("Rust tests", "COMPLETED", "SUCCESS"),
    run("CI status", "COMPLETED", "SUCCESS"),
  ]
  const reduced = latest_check_per_name(rollup)
  assert_eq(len(reduced), 2)
  const summary = admission_checks_summary(rollup)
  assert_eq(summary.total, 2)
  assert_eq(len(summary.bad_names), 0)
  assert_eq(required_check_state(rollup, "CI status"), "SUCCESS")
  assert_eq(decide(pr(), rollup, HEAD).decision, "admit")
  // Falsifier for the same guard, in the other direction: the newest row is the
  // one that counts, so a fresh failure after a stale success must hold.
  const regressed = [
    run("CI status", "COMPLETED", "SUCCESS"),
    run("Rust tests", "COMPLETED", "SUCCESS"),
    run("Rust tests", "COMPLETED", "FAILURE"),
  ]
  const held = decide(pr(), regressed, HEAD)
  assert_eq(held.decision, "hold")
  assert_eq(held.reason, "checks_failing")
  assert_eq(held.bad_checks, ["Rust tests"])
  // The required check obeys the same latest-per-name reduction: a stale
  // success cannot carry an aggregate gate that has since gone red.
  const required_regressed = [
    run("CI status", "COMPLETED", "SUCCESS"),
    run("CI status", "COMPLETED", "FAILURE"),
  ]
  assert_eq(required_check_state(required_regressed, "CI status"), "FAILURE")
  const required_held = decide(pr(), required_regressed, HEAD)
  assert_eq(required_held.decision, "hold")
  assert_eq(required_held.reason, "required_check_not_success")
}

/**
 * The measured-nothing guard.
 *
 * An empty rollup reports zero pending and zero bad, which is exactly what a
 * green pull request reports. Absence must not reach the merge branch.
 */
pipeline test_an_unread_pull_request_is_not_a_green_one(task: any) {
  const empty = decide(pr(), [], HEAD)
  assert_eq(empty.decision, "measured_nothing")
  assert_eq(empty.total_checks, 0)
  assert_eq(empty.pending_checks, 0)
  assert_eq(len(empty.bad_checks), 0)
  const headless = decide(pr({head: {sha: ""}}), green_rollup(), "")
  assert_eq(headless.decision, "measured_nothing")
  const truncated = decide(pr({head: {sha: "aaaaaaa"}}), green_rollup(), "")
  assert_eq(truncated.decision, "measured_nothing")
  assert_eq(is_exact_head("aaaaaaa"), false)
  assert_eq(is_exact_head(HEAD), true)
}

/**
 * The required-check guard.
 *
 * A required check that never reported is absent from the rollup rather than
 * failing, so its absence must be named MISSING and must hold.
 */
pipeline test_a_required_check_that_never_reported_holds(task: any) {
  const rollup = [run("Rust tests", "COMPLETED", "SUCCESS")]
  assert_eq(required_check_state(rollup, "CI status"), "MISSING")
  const verdict = decide(pr(), rollup, HEAD)
  assert_eq(verdict.decision, "hold")
  assert_eq(verdict.reason, "required_check_not_success")
  assert_eq(verdict.required_check_state, "MISSING")
  const neutral = decide(pr(), [run("CI status", "COMPLETED", "NEUTRAL")], HEAD)
  assert_eq(neutral.decision, "hold")
  assert_eq(neutral.required_check_state, "NEUTRAL")
}

/** The exact-head guard: evidence read about one commit cannot admit another. */
pipeline test_a_head_that_moved_since_the_read_is_refused(task: any) {
  const verdict = decide(pr(), green_rollup(), OTHER_HEAD)
  assert_eq(verdict.decision, "head_mismatch")
  assert_eq(verdict.reason, "head_moved")
  assert_eq(verdict.head_sha, HEAD)
  assert_eq(verdict.requested_head, OTHER_HEAD)
  assert_eq(decide(pr(), green_rollup(), uppercase(HEAD)).decision, "admit")
}

pipeline test_draft_pending_and_dirty_pull_requests_hold(task: any) {
  const draft = decide(pr({draft: true}), green_rollup(), HEAD)
  assert_eq(draft.decision, "hold")
  assert_eq(draft.reason, "draft_pull_request")
  const pending = decide(pr(), green_rollup() + [run("Harn lint", "IN_PROGRESS", "")], HEAD)
  assert_eq(pending.decision, "hold")
  assert_eq(pending.reason, "checks_pending")
  assert_eq(pending.pending_checks, 1)
  const queued_context = decide(pr(), green_rollup() + [ctx("Legacy status", "PENDING")], HEAD)
  assert_eq(queued_context.decision, "hold")
  assert_eq(queued_context.reason, "checks_pending")
  const dirty = decide(pr({mergeable_state: "DIRTY"}), green_rollup(), HEAD)
  assert_eq(dirty.decision, "hold")
  assert_eq(dirty.reason, "mergeable_state")
  const errored = decide(pr(), green_rollup() + [ctx("Legacy status", "ERROR")], HEAD)
  assert_eq(errored.decision, "hold")
  assert_eq(errored.reason, "checks_failing")
}

/** Intentional skips are the majority of a fleet rollup and are not failures. */
pipeline test_intentional_skips_do_not_hold_an_admission(task: any) {
  let rollup = [run("CI status", "COMPLETED", "SUCCESS")]
  for name in ["a", "b", "c", "d"] {
    rollup = rollup + [run("skipped-" + name, "COMPLETED", "SKIPPED")]
  }
  const verdict = decide(pr(), rollup, HEAD)
  assert_eq(verdict.decision, "admit")
  assert_eq(verdict.total_checks, 5)
  assert_eq(len(verdict.bad_checks), 0)
}

/** Cached UNKNOWN mergeability is not evidence of a conflict; REST re-decides. */
pipeline test_unknown_mergeability_routes_to_the_rest_merge(task: any) {
  const verdict = decide(pr({mergeable_state: "UNKNOWN"}), green_rollup(), HEAD)
  assert_eq(verdict.decision, "admit")
  assert_eq(verdict.method, "rest_exact_head")
  const receipt = admit_green_apply(verdict, false, refuse_merge, rest_ok)
  assert_eq(receipt.merged, true)
  assert_eq(receipt.attempted_method, "rest_exact_head")
}

/**
 * Dry run is the default and must issue nothing.
 *
 * Both merge functions throw when called, so this test fails loudly if a dry
 * run ever reaches GitHub.
 */
pipeline test_a_dry_run_issues_no_merge(task: any) {
  const verdict = decide(pr(), green_rollup(), HEAD)
  assert_eq(verdict.decision, "admit")
  const receipt = admit_green_apply(verdict, true, refuse_merge, refuse_merge)
  assert_eq(receipt.merged, false)
  assert_eq(receipt.dry_run, true)
  assert_eq(receipt.attempted_method, "none")
  assert_eq(contains(receipt.detail, "dry run"), true)
}

/** A hold issues nothing either, dry run or not. */
pipeline test_a_held_verdict_issues_no_merge(task: any) {
  const verdict = decide(pr({draft: true}), green_rollup(), HEAD)
  const receipt = admit_green_apply(verdict, false, refuse_merge, refuse_merge)
  assert_eq(receipt.merged, false)
  assert_eq(receipt.attempted_method, "none")
}

pipeline test_apply_merges_at_the_exact_head(task: any) {
  const verdict = decide(pr(), green_rollup(), HEAD)
  const receipt = admit_green_apply(verdict, false, merge_ok, refuse_merge)
  assert_eq(receipt.merged, true)
  assert_eq(receipt.attempted_method, "squash_head_match")
  assert_eq(contains(receipt.detail, HEAD), true)
}

/**
 * The REST fallback is scoped to one exact refusal.
 *
 * `gh pr merge` refuses on repositories whose branch protection it cannot
 * express. Any other refusal is a real one and must not be retried.
 */
pipeline test_only_a_base_branch_policy_refusal_falls_back_to_rest(task: any) {
  const verdict = decide(pr(), green_rollup(), HEAD)
  const fell_back = admit_green_apply(verdict, false, merge_policy_prohibited, rest_ok)
  assert_eq(fell_back.merged, true)
  assert_eq(fell_back.attempted_method, "rest_exact_head")
  assert_eq(contains(fell_back.detail, "base branch policy prohibits"), true)
  const stood = admit_green_apply(verdict, false, merge_other_failure, refuse_merge)
  assert_eq(stood.merged, false)
  assert_eq(stood.attempted_method, "squash_head_match")
}

pipeline test_apply_refuses_without_a_pull_request_number_or_exact_head(task: any) {
  const verdict = decide(pr(), green_rollup(), HEAD)
  const receipt = admit_green_apply(
    verdict + {head_sha: "aaaaaaa"},
    false,
    refuse_merge,
    refuse_merge,
  )
  assert_eq(receipt.merged, false)
  assert_eq(receipt.attempted_method, "none")
  const numberless = admit_green_apply(
    verdict + {pr_number: nil},
    false,
    refuse_merge,
    refuse_merge,
  )
  assert_eq(numberless.merged, false)
  assert_eq(numberless.attempted_method, "none")
}

/** The board line must carry counts, never a bare verdict word. */
pipeline test_receipt_line_reports_the_shape_not_a_boolean(task: any) {
  const verdict = decide(pr(), green_rollup() + [run("Harn lint", "QUEUED", "")], HEAD)
  const line = admission_receipt_line(admit_green_apply(verdict, true, refuse_merge, refuse_merge))
  assert_eq(contains(line, "checks=4"), true)
  assert_eq(contains(line, "pending=1"), true)
  assert_eq(contains(line, "bad=[]"), true)
  assert_eq(contains(line, "required[CI status]=SUCCESS"), true)
  assert_eq(contains(line, HEAD), true)
}

pipeline test_specs_parse_into_typed_targets(task: any) {
  const one = parse_admit_green_specs("burin-labs/harn:7844")
  assert_eq(len(one), 1)
  assert_eq(one[0]?.repo, "burin-labs/harn")
  assert_eq(one[0]?.pr, 7844)
  const many = parse_admit_green_specs("burin-labs/harn:1, burin-labs/burin-code:2")
  assert_eq(len(many), 2)
  assert_eq(many[1]?.repo, "burin-labs/burin-code")
  assert_eq(many[1]?.pr, 2)
  for malformed in ["burin-labs/harn", "harn:12", "burin-labs/harn:0", ""] {
    const rejected = try {
      parse_admit_green_specs(malformed)
    }
    assert_eq(is_err(rejected), true)
  }
}
