import { GitRemoteRef, git_ls_remote } from "std/git"
import {
  local_release_tag_decision,
  release_cutoff_decision,
  release_cutoff_probe,
  release_publish_tree_invariant,
  release_tag_push_reconciliation,
  remote_release_tag_decision,
  remote_tag_sha,
  remote_tag_target_sha,
} from "../lib/release_repin"

pipeline test_release_repin(task) {
  const direct_refs: list<GitRemoteRef> = [
    {
      oid: "0123456789abcdef0123456789abcdef01234567",
      ref: "refs/tags/v0.8.6",
      name: "refs/tags/v0.8.6",
      peeled: false,
    },
  ]
  assert_eq(remote_tag_sha([]), "")
  assert_eq(remote_tag_sha(direct_refs), "0123456789abcdef0123456789abcdef01234567")
  const annotated_refs: list<GitRemoteRef> = [
    {
      oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      ref: "refs/tags/v0.8.6",
      name: "refs/tags/v0.8.6",
      peeled: false,
    },
    {
      oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      ref: "refs/tags/v0.8.6^{}",
      name: "refs/tags/v0.8.6",
      peeled: true,
    },
  ]
  assert_eq(remote_tag_target_sha(annotated_refs), "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
  assert_eq(remote_tag_target_sha(direct_refs), "0123456789abcdef0123456789abcdef01234567")
  assert_eq(remote_tag_target_sha([]), "")
  assert_eq(
    remote_release_tag_decision({tag: "v0.8.6", head_sha: "aaaa", remote_target_sha: ""}).action,
    "proceed",
  )
  const remote_reuse = remote_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      remote_target_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    },
  )
  assert_eq(remote_reuse.action, "reuse")
  assert_eq(contains(remote_reuse.reason, "release HEAD"), true)
  const remote_abort = remote_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      remote_target_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
  )
  assert_eq(remote_abort.action, "abort")
  assert_eq(contains(remote_abort.reason, "refusing to move"), true)
  const recovered_push = release_tag_push_reconciliation(
    {
      tag: "v0.8.6",
      tag_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      remote_probe_success: true,
      remote_refs: annotated_refs,
    },
  )
  assert_eq(recovered_push.action, "recovered")
  assert_eq(recovered_push.success, true)
  assert_eq(recovered_push.remote_target_sha, "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
  const absent_push = release_tag_push_reconciliation(
    {
      tag: "v0.8.6",
      tag_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      remote_probe_success: true,
    },
  )
  assert_eq(absent_push.action, "absent")
  assert_eq(absent_push.success, false)
  const conflicting_push = release_tag_push_reconciliation(
    {
      tag: "v0.8.6",
      tag_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      head_sha: "cccccccccccccccccccccccccccccccccccccccc",
      remote_probe_success: true,
      remote_refs: annotated_refs,
    },
  )
  assert_eq(conflicting_push.action, "conflicting_target")
  assert_eq(conflicting_push.success, false)
  const unknown_push = release_tag_push_reconciliation(
    {
      tag: "v0.8.6",
      tag_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      remote_probe_success: false,
      remote_probe_error: "transport unavailable",
    },
  )
  assert_eq(unknown_push.action, "probe_failed")
  assert(contains(unknown_push.reason, "transport unavailable"))
  const local_create = local_release_tag_decision(
    {tag: "v0.8.6", head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", local_exists: false},
  )
  assert_eq(local_create.action, "create")
  const local_reuse = local_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      local_exists: true,
      local_target_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      remote_target_sha: "",
    },
  )
  assert_eq(local_reuse.action, "reuse")
  const local_refresh = local_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      local_exists: true,
      local_target_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      remote_target_sha: "",
    },
  )
  assert_eq(local_refresh.action, "refresh")
  assert_eq(contains(local_refresh.reason, "origin has no v0.8.6"), true)
  const local_remote_guard = local_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      local_exists: true,
      local_target_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      remote_target_sha: "cccccccccccccccccccccccccccccccccccccccc",
    },
  )
  assert_eq(local_remote_guard.action, "abort")
  assert_eq(contains(local_remote_guard.reason, "origin has release state"), true)
  const local_unknown_target = local_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      local_exists: true,
      local_target_sha: "",
      remote_target_sha: "",
    },
  )
  assert_eq(local_unknown_target.action, "abort")
  assert_eq(contains(local_unknown_target.reason, "could not be resolved"), true)
  // Published content must be the tag tree, not a later main tree.
  const safe_publish = release_publish_tree_invariant(
    {
      tag: "v0.8.55",
      tag_tree: "tree-sandbox-fix",
      publish_tree: "tree-sandbox-fix",
      main_tree: "tree-sandbox-plus-queued-features",
    },
  )
  assert_eq(safe_publish.success, true)
  assert_eq(contains(safe_publish.message, "tree-sandbox-fix"), true)
  const racy_publish = release_publish_tree_invariant(
    {
      tag: "v0.8.55",
      tag_tree: "tree-sandbox-fix",
      publish_tree: "tree-sandbox-plus-queued-features",
      main_tree: "tree-sandbox-plus-queued-features",
    },
  )
  assert_eq(racy_publish.success, false)
  assert_eq(contains(racy_publish.message, "must publish tag tree"), true)
  assert_eq(contains(racy_publish.message, "main has moved past"), true)
}

fn fixture_shell(process: HarnessProcess, command) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

pipeline test_release_tag_push_reconciliation_live_remote(harness: Harness, task) {
  const root = path_join(harness.fs.temp_dir(), "release-tag-reconcile-" + harness.random.uuid_v7())
  const origin = path_join(root, "origin.git")
  const work = path_join(root, "work")
  fixture_shell(harness.process, "git init --bare -q '" + origin + "'")
  fixture_shell(harness.process, "git init -q '" + work + "'")
  fixture_shell(harness.process, "git -C '" + work + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + work + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + work + "' checkout -q -b main")
  harness.fs.write_text(path_join(work, "file.txt"), "first\n")
  fixture_shell(harness.process, "git -C '" + work + "' add file.txt")
  fixture_shell(harness.process, "git -C '" + work + "' commit -q -m first")
  const head = trim(fixture_shell(harness.process, "git -C '" + work + "' rev-parse HEAD").stdout)
  fixture_shell(harness.process, "git -C '" + work + "' remote add origin '" + origin + "'")
  fixture_shell(harness.process, "git -C '" + work + "' tag v1.2.3")
  fixture_shell(harness.process, "git -C '" + work + "' push -q origin refs/tags/v1.2.3")
  const published = git_ls_remote(
    harness.process,
    "origin",
    {repo: work, refs: ["refs/tags/v1.2.3", "refs/tags/v1.2.3^{}"]},
  )
  const published_tag_oid = remote_tag_sha(published.data.refs)
  const recovered = release_tag_push_reconciliation(
    {
      tag: "v1.2.3",
      tag_oid: published_tag_oid,
      head_sha: head,
      remote_probe_success: published.success,
      remote_refs: published.data.refs,
    },
  )
  assert_eq(recovered.action, "recovered")
  assert_eq(recovered.remote_target_sha, head)
  fixture_shell(harness.process, "git --git-dir='" + origin + "' update-ref -d refs/tags/v1.2.3")
  const absent = git_ls_remote(harness.process, "origin", {repo: work, refs: ["refs/tags/v1.2.3"]})
  assert_eq(
    release_tag_push_reconciliation(
      {
        tag: "v1.2.3",
        tag_oid: published_tag_oid,
        head_sha: head,
        remote_probe_success: absent.success,
        remote_refs: absent.data.refs,
      },
    ).action,
    "absent",
  )
  harness.fs.write_text(path_join(work, "file.txt"), "second\n")
  fixture_shell(harness.process, "git -C '" + work + "' commit -q -am second")
  const conflicting_head = trim(
    fixture_shell(harness.process, "git -C '" + work + "' rev-parse HEAD").stdout,
  )
  fixture_shell(harness.process, "git -C '" + work + "' tag -f v1.2.3 " + conflicting_head)
  fixture_shell(harness.process, "git -C '" + work + "' push -q origin refs/tags/v1.2.3")
  const conflicting = git_ls_remote(
    harness.process,
    "origin",
    {repo: work, refs: ["refs/tags/v1.2.3"]},
  )
  assert_eq(
    release_tag_push_reconciliation(
      {
        tag: "v1.2.3",
        tag_oid: published_tag_oid,
        head_sha: head,
        remote_probe_success: conflicting.success,
        remote_refs: conflicting.data.refs,
      },
    ).action,
    "conflicting_target",
  )
  harness.fs.delete(root)
}

pipeline test_release_cutoff_decision(task) {
  const pin = "1111111111111111111111111111111111111111"
  const moved = "2222222222222222222222222222222222222222"
  // Pin still at base HEAD: safe to tag.
  const current = release_cutoff_decision(
    {pin_sha: pin, base_head_sha: pin, pin_is_base_ancestor: true, base: "main", tag: "v0.8.154"},
  )
  assert_eq(current.action, "proceed")
  assert_eq(current.reason, "")
  // Normal base advancement preserves the frozen cutoff.
  const advanced = release_cutoff_decision(
    {pin_sha: pin, base_head_sha: moved, pin_is_base_ancestor: true, base: "main", tag: "v0.8.154"},
  )
  assert_eq(advanced.action, "proceed")
  // A divergent or force-pushed base fails closed.
  const divergent = release_cutoff_decision(
    {
      pin_sha: pin,
      base_head_sha: moved,
      pin_is_base_ancestor: false,
      base: "main",
      tag: "v0.8.154",
    },
  )
  assert_eq(divergent.action, "abort")
  assert_eq(contains(divergent.reason, "not an ancestor"), true)
  assert_eq(contains(divergent.reason, "--allow-base-drift"), true)
  // Explicit operator overrides proceed despite drift.
  assert_eq(
    release_cutoff_decision({pin_sha: pin, base_head_sha: moved, explicit_pin: true}).action,
    "proceed",
  )
  assert_eq(
    release_cutoff_decision({pin_sha: pin, base_head_sha: moved, allow_drift: true}).action,
    "proceed",
  )
  // Fail-closed: a missing probe SHA aborts rather than assuming ancestry.
  const no_probe = release_cutoff_decision(
    {pin_sha: pin, base_head_sha: "", base: "main", tag: "v0.8.154"},
  )
  assert_eq(no_probe.action, "abort")
  assert_eq(contains(no_probe.reason, "could not resolve"), true)
  const no_pin = release_cutoff_decision({pin_sha: "", base_head_sha: pin})
  assert_eq(no_pin.action, "abort")
}

pipeline test_release_cutoff_probe_uses_ancestry_not_head_equality(harness: Harness, task) {
  const pin = "1111111111111111111111111111111111111111"
  const moved = "2222222222222222222222222222222222222222"
  const descendant = release_cutoff_probe(
    harness.tools,
    { args ->
      const command = join(args, " ")
      if command == "rev-parse --verify origin/main^{commit}" {
        return {success: true, stdout: moved + "\n", stderr: ""}
      }
      if command == "merge-base --is-ancestor ${pin} ${moved}" {
        return {success: true, stdout: "", stderr: ""}
      }
      throw "unexpected git command: " + command
    },
    {pin_sha: pin, base: "main"},
  )
  assert_eq(descendant.base_head_sha, moved)
  assert_eq(descendant.pin_is_base_ancestor, true)
  const divergent = release_cutoff_probe(
    harness.tools,
    { args ->
      const command = join(args, " ")
      if command == "rev-parse --verify origin/main^{commit}" {
        return {success: true, stdout: moved + "\n", stderr: ""}
      }
      if command == "merge-base --is-ancestor ${pin} ${moved}" {
        return {success: false, stdout: "", stderr: ""}
      }
      throw "unexpected git command: " + command
    },
    {pin_sha: pin, base: "main"},
  )
  assert_eq(divergent.base_head_sha, moved)
  assert_eq(divergent.pin_is_base_ancestor, false)
}
