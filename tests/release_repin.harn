import {
  local_release_tag_decision,
  release_cutoff_decision,
  release_cutoff_probe,
  release_publish_tree_invariant,
  remote_release_tag_decision,
  remote_tag_sha_from_ls_remote,
  remote_tag_target_sha_from_ls_remote,
  repin_tocttou_decision,
} from "../lib/release_repin"

pipeline test_release_repin(task) {
  // ls-remote parsing.
  assert_eq(remote_tag_sha_from_ls_remote(""), "")
  assert_eq(
    remote_tag_sha_from_ls_remote("0123456789abcdef0123456789abcdef01234567\trefs/tags/v0.8.6\n"),
    "0123456789abcdef0123456789abcdef01234567",
  )
  assert_eq(remote_tag_sha_from_ls_remote("   "), "")
  assert_eq(
    remote_tag_target_sha_from_ls_remote(
      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/tags/v0.8.6\n"
        + "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\trefs/tags/v0.8.6^{}\n",
    ),
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  )
  assert_eq(
    remote_tag_target_sha_from_ls_remote("cccccccccccccccccccccccccccccccccccccccc\trefs/tags/v0.8.6\n"),
    "cccccccccccccccccccccccccccccccccccccccc",
  )
  assert_eq(remote_tag_target_sha_from_ls_remote(""), "")
  assert_eq(
    remote_release_tag_decision({tag: "v0.8.6", head_sha: "aaaa", remote_target_sha: ""}).action,
    "proceed",
  )
  let remote_reuse = remote_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      remote_target_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    },
  )
  assert_eq(remote_reuse.action, "reuse")
  assert_eq(contains(remote_reuse.reason, "release HEAD"), true)
  let remote_abort = remote_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      remote_target_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
  )
  assert_eq(remote_abort.action, "abort")
  assert_eq(contains(remote_abort.reason, "refusing to move"), true)
  let local_create = local_release_tag_decision(
    {tag: "v0.8.6", head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", local_exists: false},
  )
  assert_eq(local_create.action, "create")
  let local_reuse = local_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      local_exists: true,
      local_target_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      remote_target_sha: "",
    },
  )
  assert_eq(local_reuse.action, "reuse")
  let local_refresh = local_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      local_exists: true,
      local_target_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      remote_target_sha: "",
    },
  )
  assert_eq(local_refresh.action, "refresh")
  assert_eq(contains(local_refresh.reason, "origin has no v0.8.6"), true)
  let local_remote_guard = local_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      local_exists: true,
      local_target_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      remote_target_sha: "cccccccccccccccccccccccccccccccccccccccc",
    },
  )
  assert_eq(local_remote_guard.action, "abort")
  assert_eq(contains(local_remote_guard.reason, "origin has release state"), true)
  let local_unknown_target = local_release_tag_decision(
    {
      tag: "v0.8.6",
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      local_exists: true,
      local_target_sha: "",
      remote_target_sha: "",
    },
  )
  assert_eq(local_unknown_target.action, "abort")
  assert_eq(contains(local_unknown_target.reason, "could not be resolved"), true)
  // Happy path: no release, tag SHA stable, pin re-resolved.
  let proceed = repin_tocttou_decision(
    {
      release_exists: false,
      initial_remote_tag_sha: "",
      current_remote_tag_sha: "",
      new_pin_sha: "abcdef1234567890abcdef1234567890abcdef12",
      tag: "v0.8.6",
    },
  )
  assert_eq(proceed.action, "proceed")
  assert_eq(proceed.new_pin_sha, "abcdef1234567890abcdef1234567890abcdef12")
  // Release materialized between check and mutation.
  let released = repin_tocttou_decision(
    {
      release_exists: true,
      initial_remote_tag_sha: "",
      current_remote_tag_sha: "",
      new_pin_sha: "abcdef1234567890abcdef1234567890abcdef12",
      tag: "v0.8.6",
    },
  )
  assert_eq(released.action, "abort")
  assert_eq(contains(released.reason, "crates.io is immutable"), true)
  assert_eq(contains(released.reason, "v0.8.6"), true)
  // Remote tag advanced from absent to present.
  let tag_appeared = repin_tocttou_decision(
    {
      release_exists: false,
      initial_remote_tag_sha: "",
      current_remote_tag_sha: "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef",
      new_pin_sha: "abcdef1234567890abcdef1234567890abcdef12",
      tag: "v0.8.6",
    },
  )
  assert_eq(tag_appeared.action, "abort")
  assert_eq(contains(tag_appeared.reason, "from absent to deadbeef"), true)
  // Remote tag moved from one SHA to another.
  let tag_moved = repin_tocttou_decision(
    {
      release_exists: false,
      initial_remote_tag_sha: "1111111111111111111111111111111111111111",
      current_remote_tag_sha: "2222222222222222222222222222222222222222",
      new_pin_sha: "abcdef1234567890abcdef1234567890abcdef12",
      tag: "v0.8.6",
    },
  )
  assert_eq(tag_moved.action, "abort")
  assert_eq(contains(tag_moved.reason, "1111111"), true)
  assert_eq(contains(tag_moved.reason, "2222222"), true)
  // Pin re-resolution failed.
  let no_pin = repin_tocttou_decision(
    {
      release_exists: false,
      initial_remote_tag_sha: "",
      current_remote_tag_sha: "",
      new_pin_sha: "",
      tag: "v0.8.6",
    },
  )
  assert_eq(no_pin.action, "abort")
  assert_eq(contains(no_pin.reason, "could not re-resolve"), true)
  // Published content must be the tag tree, not a later main tree.
  let safe_publish = release_publish_tree_invariant(
    {
      tag: "v0.8.55",
      tag_tree: "tree-sandbox-fix",
      publish_tree: "tree-sandbox-fix",
      main_tree: "tree-sandbox-plus-queued-features",
    },
  )
  assert_eq(safe_publish.success, true)
  assert_eq(contains(safe_publish.message, "tree-sandbox-fix"), true)
  let racy_publish = release_publish_tree_invariant(
    {
      tag: "v0.8.55",
      tag_tree: "tree-sandbox-fix",
      publish_tree: "tree-sandbox-plus-queued-features",
      main_tree: "tree-sandbox-plus-queued-features",
    },
  )
  assert_eq(racy_publish.success, false)
  assert_eq(contains(racy_publish.message, "must publish tag tree"), true)
  assert_eq(contains(racy_publish.message, "main has moved past"), true)
}

pipeline test_release_cutoff_decision(task) {
  let pin = "1111111111111111111111111111111111111111"
  let moved = "2222222222222222222222222222222222222222"
  // Pin still at base HEAD: safe to tag.
  let current = release_cutoff_decision(
    {pin_sha: pin, base_head_sha: pin, pin_is_base_ancestor: true, base: "main", tag: "v0.8.154"},
  )
  assert_eq(current.action, "proceed")
  assert_eq(current.reason, "")
  // Normal base advancement preserves the frozen cutoff.
  let advanced = release_cutoff_decision(
    {pin_sha: pin, base_head_sha: moved, pin_is_base_ancestor: true, base: "main", tag: "v0.8.154"},
  )
  assert_eq(advanced.action, "proceed")
  // A divergent or force-pushed base fails closed.
  let divergent = release_cutoff_decision(
    {pin_sha: pin, base_head_sha: moved, pin_is_base_ancestor: false, base: "main", tag: "v0.8.154"},
  )
  assert_eq(divergent.action, "abort")
  assert_eq(contains(divergent.reason, "not an ancestor"), true)
  assert_eq(contains(divergent.reason, "--repin-latest"), true)
  assert_eq(contains(divergent.reason, "--allow-base-drift"), true)
  // Each opt-out proceeds despite drift.
  assert_eq(
    release_cutoff_decision({pin_sha: pin, base_head_sha: moved, repin_latest: true}).action,
    "proceed",
  )
  assert_eq(
    release_cutoff_decision({pin_sha: pin, base_head_sha: moved, explicit_pin: true}).action,
    "proceed",
  )
  assert_eq(
    release_cutoff_decision({pin_sha: pin, base_head_sha: moved, allow_drift: true}).action,
    "proceed",
  )
  // Fail-closed: a missing probe SHA aborts rather than assuming ancestry.
  let no_probe = release_cutoff_decision({pin_sha: pin, base_head_sha: "", base: "main", tag: "v0.8.154"})
  assert_eq(no_probe.action, "abort")
  assert_eq(contains(no_probe.reason, "could not resolve"), true)
  let no_pin = release_cutoff_decision({pin_sha: "", base_head_sha: pin})
  assert_eq(no_pin.action, "abort")
}

pipeline test_release_cutoff_probe_uses_ancestry_not_head_equality(task) {
  const pin = "1111111111111111111111111111111111111111"
  const moved = "2222222222222222222222222222222222222222"
  const descendant = release_cutoff_probe(
    { args ->
      const command = join(args, " ")
      if command == "rev-parse --verify origin/main^{commit}" {
        return {success: true, stdout: moved + "\n", stderr: ""}
      }
      if command == "merge-base --is-ancestor ${pin} ${moved}" {
        return {success: true, stdout: "", stderr: ""}
      }
      throw "unexpected git command: " + command
    },
    {pin_sha: pin, base: "main"},
  )
  assert_eq(descendant.base_head_sha, moved)
  assert_eq(descendant.pin_is_base_ancestor, true)
  const divergent = release_cutoff_probe(
    { args ->
      const command = join(args, " ")
      if command == "rev-parse --verify origin/main^{commit}" {
        return {success: true, stdout: moved + "\n", stderr: ""}
      }
      if command == "merge-base --is-ancestor ${pin} ${moved}" {
        return {success: false, stdout: "", stderr: ""}
      }
      throw "unexpected git command: " + command
    },
    {pin_sha: pin, base: "main"},
  )
  assert_eq(divergent.base_head_sha, moved)
  assert_eq(divergent.pin_is_base_ancestor, false)
}
