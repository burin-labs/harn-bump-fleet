import {
  pre_tag_drift_decision,
  release_publish_tree_invariant,
  remote_tag_sha_from_ls_remote,
  repin_tocttou_decision,
} from "../lib/release_repin"

pipeline test_release_repin(task) {
  // ls-remote parsing.
  assert_eq(remote_tag_sha_from_ls_remote(""), "")
  assert_eq(
    remote_tag_sha_from_ls_remote("0123456789abcdef0123456789abcdef01234567\trefs/tags/v0.8.6\n"),
    "0123456789abcdef0123456789abcdef01234567",
  )
  assert_eq(remote_tag_sha_from_ls_remote("   "), "")
  // Happy path: no release, tag SHA stable, pin re-resolved.
  let proceed = repin_tocttou_decision(
    {
      release_exists: false,
      initial_remote_tag_sha: "",
      current_remote_tag_sha: "",
      new_pin_sha: "abcdef1234567890abcdef1234567890abcdef12",
      tag: "v0.8.6",
    },
  )
  assert_eq(proceed.action, "proceed")
  assert_eq(proceed.new_pin_sha, "abcdef1234567890abcdef1234567890abcdef12")
  // Release materialized between check and mutation.
  let released = repin_tocttou_decision(
    {
      release_exists: true,
      initial_remote_tag_sha: "",
      current_remote_tag_sha: "",
      new_pin_sha: "abcdef1234567890abcdef1234567890abcdef12",
      tag: "v0.8.6",
    },
  )
  assert_eq(released.action, "abort")
  assert_eq(contains(released.reason, "crates.io is immutable"), true)
  assert_eq(contains(released.reason, "v0.8.6"), true)
  // Remote tag advanced from absent to present.
  let tag_appeared = repin_tocttou_decision(
    {
      release_exists: false,
      initial_remote_tag_sha: "",
      current_remote_tag_sha: "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef",
      new_pin_sha: "abcdef1234567890abcdef1234567890abcdef12",
      tag: "v0.8.6",
    },
  )
  assert_eq(tag_appeared.action, "abort")
  assert_eq(contains(tag_appeared.reason, "from absent to deadbeef"), true)
  // Remote tag moved from one SHA to another.
  let tag_moved = repin_tocttou_decision(
    {
      release_exists: false,
      initial_remote_tag_sha: "1111111111111111111111111111111111111111",
      current_remote_tag_sha: "2222222222222222222222222222222222222222",
      new_pin_sha: "abcdef1234567890abcdef1234567890abcdef12",
      tag: "v0.8.6",
    },
  )
  assert_eq(tag_moved.action, "abort")
  assert_eq(contains(tag_moved.reason, "1111111"), true)
  assert_eq(contains(tag_moved.reason, "2222222"), true)
  // Pin re-resolution failed.
  let no_pin = repin_tocttou_decision(
    {
      release_exists: false,
      initial_remote_tag_sha: "",
      current_remote_tag_sha: "",
      new_pin_sha: "",
      tag: "v0.8.6",
    },
  )
  assert_eq(no_pin.action, "abort")
  assert_eq(contains(no_pin.reason, "could not re-resolve"), true)
  // Published content must be the tag tree, not a later main tree.
  let safe_publish = release_publish_tree_invariant(
    {
      tag: "v0.8.55",
      tag_tree: "tree-sandbox-fix",
      publish_tree: "tree-sandbox-fix",
      main_tree: "tree-sandbox-plus-queued-features",
    },
  )
  assert_eq(safe_publish.success, true)
  assert_eq(contains(safe_publish.message, "tree-sandbox-fix"), true)
  let racy_publish = release_publish_tree_invariant(
    {
      tag: "v0.8.55",
      tag_tree: "tree-sandbox-fix",
      publish_tree: "tree-sandbox-plus-queued-features",
      main_tree: "tree-sandbox-plus-queued-features",
    },
  )
  assert_eq(racy_publish.success, false)
  assert_eq(contains(racy_publish.message, "must publish tag tree"), true)
  assert_eq(contains(racy_publish.message, "main has moved past"), true)
}

pipeline test_pre_tag_drift_decision(task) {
  let pin = "1111111111111111111111111111111111111111"
  let moved = "2222222222222222222222222222222222222222"
  // Pin still at base HEAD: safe to tag.
  let current = pre_tag_drift_decision({pin_sha: pin, base_head_sha: pin, base: "main", tag: "v0.8.154"})
  assert_eq(current.action, "proceed")
  assert_eq(current.reason, "")
  // Base advanced past the frozen pin: abort by default (the v0.8.153 bug).
  let drifted = pre_tag_drift_decision({pin_sha: pin, base_head_sha: moved, base: "main", tag: "v0.8.154"})
  assert_eq(drifted.action, "abort")
  assert_eq(contains(drifted.reason, "behind main"), true)
  assert_eq(contains(drifted.reason, "--repin-latest"), true)
  assert_eq(contains(drifted.reason, "--allow-base-drift"), true)
  // Each opt-out proceeds despite drift.
  assert_eq(
    pre_tag_drift_decision({pin_sha: pin, base_head_sha: moved, repin_latest: true}).action,
    "proceed",
  )
  assert_eq(
    pre_tag_drift_decision({pin_sha: pin, base_head_sha: moved, explicit_pin: true}).action,
    "proceed",
  )
  assert_eq(
    pre_tag_drift_decision({pin_sha: pin, base_head_sha: moved, allow_drift: true}).action,
    "proceed",
  )
  // Fail-closed: a missing probe SHA aborts rather than assuming the pin is current.
  let no_probe = pre_tag_drift_decision({pin_sha: pin, base_head_sha: "", base: "main", tag: "v0.8.154"})
  assert_eq(no_probe.action, "abort")
  assert_eq(contains(no_probe.reason, "could not resolve"), true)
  let no_pin = pre_tag_drift_decision({pin_sha: "", base_head_sha: pin})
  assert_eq(no_pin.action, "abort")
}
