import {
  HostedReleaseRecordedInputs,
  HostedReleaseRunStep,
  hosted_release_failure_receipt,
  hosted_release_failure_row,
  hosted_release_failure_summary,
  hosted_release_job_key,
  hosted_release_registry_findings,
  hosted_release_registry_refusals,
  hosted_release_run_steps,
  job_name_literals,
} from "../lib/hosted_release_failure"

const RUN = {
  repo: "burin-labs/harn-bump-fleet",
  workflow: "hosted-release.yml",
  ref: "main",
  run_id: 32739738413,
  run_url: "https://github.test/run/32739738413",
  run_attempt: 1,
}

const INPUTS: HostedReleaseRecordedInputs = {
  mode: "ship-pr",
  bump: "patch",
  prerelease_identifier: "",
  at_sha: "",
  expected_prs: "",
  resume_tagged_release: false,
  converge_fleet: true,
  repositories_json: "",
  skip_consumers: "",
  consumer_proof_runs_json: "",
}

fn step(job: string, name: string, conclusion: string, number: int = 1) -> HostedReleaseRunStep {
  return {job: job, name: name, conclusion: conclusion, number: number}
}

pipeline test_a_mechanical_failure_names_its_exact_redispatch(task: any) {
  const receipt = hosted_release_failure_receipt(
    RUN,
    [
      step("release", "Check out release harness", "success", 1),
      step("release", "Mint scoped release token", "failure", 2),
      step("release", "Upload release run artifacts", "success", 3),
    ],
    INPUTS,
  )
  assert_eq(receipt.state, "classified")
  assert_eq(receipt.cause, "credential")
  assert_eq(receipt.failed_precondition, "the scoped release token mint")
  assert_eq(len(receipt.failed_steps), 1)
  assert_eq(receipt.unmapped_steps, [])
  const plan = unwrap(receipt.redispatch)
  assert_eq(plan.repo, "burin-labs/harn-bump-fleet")
  assert_eq(plan.workflow, "hosted-release.yml")
  assert_eq(plan.ref, "main")
  assert_eq(plan.inputs.mode, "ship-pr")
  assert_eq(plan.inputs.bump, "patch")
  assert_eq(plan.inputs.converge_fleet, true)
  assert_eq(plan.inputs.resume_tagged_release, false)
}

/**
 * A step that runs only after the tag exists cannot be retried as a fresh cut,
 * because the run's own follow-up bump is a prerequisite of its own rerun. The
 * re-dispatch has to carry the resume flag even though the original dispatch
 * did not.
 */
pipeline test_a_failure_after_the_tag_redispatches_as_a_resume(task: any) {
  const receipt = hosted_release_failure_receipt(
    RUN,
    [step("release", "Prove hosted release publication", "failure", 9)],
    INPUTS,
  )
  assert_eq(receipt.state, "classified")
  assert_eq(receipt.cause, "publication")
  assert_eq(unwrap(receipt.redispatch).inputs.resume_tagged_release, true)
  assert_eq(INPUTS.resume_tagged_release, false)
  const before_tag = hosted_release_failure_receipt(
    RUN,
    [step("release", "Install cargo-nextest", "failure", 5)],
    INPUTS,
  )
  assert_eq(unwrap(before_tag.redispatch).inputs.resume_tagged_release, false)
}

/**
 * The negative control the repair loop turns on: an unrecognised cause has to
 * escalate. Defaulting to a retry is how a repair loop turns one failure into
 * a queue of identical failures.
 */
pipeline test_an_unregistered_step_escalates_rather_than_retrying(task: any) {
  const receipt = hosted_release_failure_receipt(
    RUN,
    [step("release", "Do something nobody registered", "failure", 4)],
    INPUTS,
  )
  assert_eq(receipt.state, "escalated")
  assert_eq(receipt.cause, "unclassified")
  assert_eq(receipt.redispatch, nil)
  assert_eq(receipt.unmapped_steps, ["release: Do something nobody registered"])
  assert(contains(unwrap(receipt.escalation_reason), "escalates rather than defaulting"))
}

/** A failure the same inputs would reproduce is escalated, not re-dispatched. */
pipeline test_a_failure_the_same_inputs_would_repeat_is_escalated(task: any) {
  for name in [
    "Validate release inputs",
    "Validate and normalize the post-publication consumer scope",
    "Verify consumer contracts match generated adapters before publication",
    "Run release harness",
  ] {
    const receipt = hosted_release_failure_receipt(RUN, [step("release", name, "failure")], INPUTS)
    assert_eq(receipt.state, "escalated")
    assert_eq(receipt.redispatch, nil)
    assert(contains(unwrap(receipt.escalation_reason), "would repeat this failure"))
    assert(receipt.cause != "unclassified")
  }
}

/**
 * A failure that has a mechanical repair which is not a re-dispatch says what
 * that repair is. Consumer contract drift is repaired by the convergence
 * workflow, and a reader told only "this needs a change" would have to go
 * looking for that themselves.
 */
pipeline test_an_escalation_names_a_repair_when_one_exists(task: any) {
  const drift = hosted_release_failure_receipt(
    RUN,
    [
      step(
        "release",
        "Verify consumer contracts match generated adapters before publication",
        "failure",
      ),
    ],
    INPUTS,
  )
  assert_eq(drift.state, "escalated")
  assert(contains(unwrap(drift.escalation_reason), "fleet-projection-convergence.yml"))
  assert(contains(unwrap(drift.escalation_reason), "re-dispatch this release unchanged"))
  const no_named_repair = hosted_release_failure_receipt(
    RUN,
    [step("release", "Run release harness", "failure")],
    INPUTS,
  )
  assert(contains(unwrap(no_named_repair.escalation_reason), "needs a change, not a retry"))
}

/**
 * A failed run with no failed step in hand is a failed reading. Reporting it as
 * clean would turn every unreadable run into a silent success, which is the one
 * outcome a failure finalizer must never produce.
 */
pipeline test_a_run_with_no_readable_failure_is_unreadable_not_clean(task: any) {
  const no_steps = hosted_release_failure_receipt(RUN, [], INPUTS)
  assert_eq(no_steps.state, "unreadable")
  assert_eq(no_steps.redispatch, nil)
  assert(contains(no_steps.failed_precondition, "no steps at all"))
  const nothing_failed = hosted_release_failure_receipt(
    RUN,
    [step("release", "Check out release harness", "success")],
    INPUTS,
  )
  assert_eq(nothing_failed.state, "unreadable")
  assert_eq(nothing_failed.redispatch, nil)
  assert(contains(unwrap(nothing_failed.escalation_reason), "failed reading"))
}

/** Without the recorded inputs there is no exact re-dispatch to name. */
pipeline test_a_run_that_recorded_no_inputs_escalates(task: any) {
  const receipt = hosted_release_failure_receipt(
    RUN,
    [step("release", "Mint scoped release token", "failure")],
    nil,
  )
  assert_eq(receipt.state, "escalated")
  assert_eq(receipt.cause, "credential")
  assert_eq(receipt.redispatch, nil)
  assert(contains(unwrap(receipt.escalation_reason), "did not record the inputs"))
}

pipeline test_the_registry_separates_the_two_jobs(task: any) {
  const release_row = unwrap(hosted_release_failure_row("release", "Check out release harness"))
  const fleet_row = unwrap(hosted_release_failure_row("fleet", "Check out release harness"))
  assert_eq(release_row.after_tag, false)
  assert_eq(fleet_row.after_tag, true)
  assert_eq(hosted_release_failure_row("nobody", "Check out release harness"), nil)
}

pipeline test_a_rendered_job_name_resolves_to_its_declared_key(task: any) {
  const templates = [
    {key: "release", name: "\${{ inputs.mode }} v-next (\${{ inputs.bump }})"},
    {key: "fleet", name: "Prove Harn repository updates"},
  ]
  assert_eq(job_name_literals("Prove Harn repository updates"), ["Prove Harn repository updates"])
  assert_eq(
    job_name_literals("\${{ inputs.mode }} v-next (\${{ inputs.bump }})"),
    ["", " v-next (", ")"],
  )
  assert_eq(hosted_release_job_key(templates, "ship-pr v-next (patch)"), "release")
  assert_eq(hosted_release_job_key(templates, "Prove Harn repository updates"), "fleet")
  assert_eq(hosted_release_job_key(templates, "something else entirely"), nil)
  assert_eq(hosted_release_job_key([], "ship-pr v-next (patch)"), nil)
}

pipeline test_run_steps_keep_an_unresolved_job_under_its_own_name(task: any) {
  const templates = [{key: "fleet", name: "Prove Harn repository updates"}]
  const steps = hosted_release_run_steps(
    templates,
    [
      {
        name: "Prove Harn repository updates",
        steps: [{number: 1, name: "Prove exact fleet convergence run", conclusion: "failure"}],
      },
      {
        name: "ship-pr v-next (patch)",
        steps: [{number: 1, name: "Mint scoped release token", conclusion: "failure"}],
      },
    ],
  )
  assert_eq(len(steps), 2)
  assert_eq(steps[0]?.job, "fleet")
  assert_eq(steps[1]?.job, "ship-pr v-next (patch)")
  const receipt = hosted_release_failure_receipt(RUN, steps, INPUTS)
  assert_eq(receipt.cause, "fleet_convergence")
  assert_eq(receipt.unmapped_steps, ["ship-pr v-next (patch): Mint scoped release token"])
}

pipeline test_the_registry_census_names_both_directions(task: any) {
  const matching = [
    {job: "release", steps: ["Check out release harness", "Mint scoped release token"]},
  ]
  const findings = hosted_release_registry_findings(matching)
  // Every registry row the fixture does not mention is a stale row, which is
  // the census working, so assert on the shape of one instead of the count.
  assert(len(findings) > 0)
  assert_eq(findings.filter({ f -> return f.kind == "unregistered_step" }).to_list(), [])
  const renamed = [{job: "release", steps: ["Mint a scoped release token"]}]
  const unregistered = hosted_release_registry_findings(renamed).filter(
    { f -> return f.kind == "unregistered_step" },
  )
    .to_list()
  assert_eq(len(unregistered), 1)
  assert_eq(unwrap(unregistered[0]).step, "Mint a scoped release token")
  const unnamed = hosted_release_registry_findings([{job: "release", steps: [nil]}]).filter(
    { f -> return f.kind == "unnamed_step" },
  )
    .to_list()
  assert_eq(len(unnamed), 1)
  assert(contains(unwrap(unnamed[0]).detail, "give the step a name"))
}

pipeline test_the_registry_census_refuses_a_reading_of_nothing(task: any) {
  assert_eq(len(hosted_release_registry_refusals([])), 1)
  assert(contains(unwrap(hosted_release_registry_refusals([])[0]), "no jobs at all"))
  const empty_job = hosted_release_registry_refusals([{job: "release", steps: []}])
  assert_eq(len(empty_job), 1)
  assert(contains(unwrap(empty_job[0]), "no steps"))
  assert_eq(
    hosted_release_registry_refusals([{job: "release", steps: ["Check out release harness"]}]),
    [],
  )
}

pipeline test_the_summary_leads_with_the_decision(task: any) {
  const classified = hosted_release_failure_summary(
    hosted_release_failure_receipt(
      RUN,
      [step("release", "Mint scoped release token", "failure")],
      INPUTS,
    ),
  )
  assert(contains(classified, "State: `classified`"))
  assert(contains(classified, "the scoped release token mint"))
  assert(contains(classified, "### Exact re-dispatch"))
  assert(contains(classified, "ship-pr"))
  const escalated = hosted_release_failure_summary(
    hosted_release_failure_receipt(
      RUN,
      [step("release", "Run release harness", "failure")],
      INPUTS,
    ),
  )
  assert(contains(escalated, "State: `escalated`"))
  assert(!contains(escalated, "### Exact re-dispatch"))
}
