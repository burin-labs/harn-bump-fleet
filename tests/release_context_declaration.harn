import {
  release_context_readiness,
  release_context_readiness_from_rows,
  release_context_set,
} from "../lib/release_context_declaration"

// The two contexts burin-labs/harn's active rulesets actually require, read
// live on 2026-09-06 from `main protection` and `release drift required`.
const RULESET = ["CI status", "drift"]

// A check the runtime repository really produces and no ruleset requires. Its
// workflow triggers on every push to the default branch, so the release-only
// classifier calls it branch-covered and does not wait for it either.
const E2E = "Slow E2E suite"

// Every check name some workflow at the candidate revision can emit.
const PRODUCIBLE = ["CI status", "drift", "Slow E2E suite", "Format check"]

fn run(name: string, conclusion: string) {
  return {name: name, status: "COMPLETED", conclusion: conclusion, __typename: "CheckRun"}
}

/**
 * The positive control: a repository that declares nothing decides on exactly
 * the ruleset set, in exactly the order it decided on before.
 *
 * This is the bullet the whole change has to keep true. If declaring nothing
 * moved the decision at all, every repository in the fleet would be quietly
 * held to a bar nobody wrote down.
 */
pipeline test_no_declaration_leaves_the_ruleset_set_untouched(task: any) {
  const set = release_context_set(RULESET, [], PRODUCIBLE, "manifest")
  assert_eq(set.contexts, RULESET)
  assert_eq([set.declared, set.declared_only, set.refused], [[], [], []])
  const ready = release_context_readiness(set, {"CI status": "SUCCESS", drift: "SUCCESS"})
  assert_eq([ready.ok, ready.state], [true, "ready"])
}

/** The union is the union, and each entry says which side it came from. */
pipeline test_the_declared_set_unions_with_the_ruleset_set(task: any) {
  const set = release_context_set(RULESET, [E2E, "CI status"], PRODUCIBLE, "manifest")
  assert_eq(set.contexts, ["CI status", E2E, "drift"])
  assert_eq(set.declared_only, [E2E])
  assert_eq(
    set.entries.map({ entry -> entry.name + "@" + entry.origin }),
    ["CI status@both", "${E2E}@declared", "drift@ruleset"],
  )
  assert_eq(set.declaration_source, "manifest")
}

/**
 * The failure the declaration exists to close.
 *
 * A lane that is branch-covered and not ruleset-required is in neither set the
 * release already computes, so it can be red on the exact commit being tagged
 * and no gate reads it. Declared, it is read, and a red holds the cut. The
 * shape is reported beside the verdict: the failing name, and the pending
 * count, rather than a boolean.
 */
pipeline test_a_red_declared_context_holds_the_decision(task: any) {
  const set = release_context_set(RULESET, [E2E], PRODUCIBLE, "manifest")
  const ready = release_context_readiness_from_rows(
    set,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS"), run(E2E, "FAILURE")],
  )
  assert_eq([ready.ok, ready.state], [false, "failed"])
  assert_eq([ready.failing_names, ready.pending_names], [[E2E], []])
  assert_eq(ready.pending_count, 0)
  assert(contains(ready.reason, "0 pending, 1 failing of 3 required"))
  assert(contains(ready.reason, "failing: ${E2E}"))
}

/**
 * The same three contexts without the declaration, so the negative control is
 * a controlled comparison rather than an assertion about one arm.
 *
 * The identical rows that hold above admit here, because the red context is in
 * neither set. That is the behavior on main today, stated as a test so the fix
 * cannot be mistaken for something the old code already did.
 */
pipeline test_the_same_red_lane_admits_when_nothing_declares_it(task: any) {
  const set = release_context_set(RULESET, [], PRODUCIBLE, "manifest")
  const ready = release_context_readiness_from_rows(
    set,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS"), run(E2E, "FAILURE")],
  )
  assert_eq([ready.ok, ready.state], [true, "ready"])
  assert_eq(ready.failing_names, [])
}

/**
 * A declared context that never reported is pending by name and by count.
 *
 * This is the absence-reads-as-success case. The row is not in the rollup at
 * all, and every reader that filters a rollup rather than looking the name up
 * would see three green rows and call it green.
 */
pipeline test_a_declared_context_that_never_reported_is_pending_by_name(task: any) {
  const set = release_context_set(RULESET, [E2E], PRODUCIBLE, "manifest")
  const ready = release_context_readiness_from_rows(
    set,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
  )
  assert_eq([ready.ok, ready.state], [false, "pending"])
  assert_eq([ready.pending_names, ready.pending_count], [[E2E], 1])
  assert_eq(ready.failing_names, [])
  assert(contains(ready.reason, "1 pending, 0 failing of 3 required"))
  assert(contains(ready.reason, "pending: ${E2E}"))
  // Named in the rows too, with the state that made it pending, so a reader
  // never has to infer why a context is being waited on.
  assert_eq(ready.rows.filter({ row -> row.name == E2E }).to_list()[0].state, "MISSING")
}

/**
 * A declared context nothing at the revision can produce is a named refusal.
 *
 * Dropping it instead is how a list rots into a gate that asserts nothing: the
 * workflow is renamed, the entry stops matching, and the release keeps
 * reporting a satisfied set that is one context smaller than it was.
 */
pipeline test_a_declared_context_no_workflow_produces_is_refused_by_name(task: any) {
  const set = release_context_set(RULESET, ["E2E suite (renamed away)"], PRODUCIBLE, "manifest")
  assert_eq(set.refused, ["E2E suite (renamed away)"])
  const ready = release_context_readiness_from_rows(
    set,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
  )
  assert_eq([ready.ok, ready.state], [false, "refused"])
  assert_eq(ready.refused_names, ["E2E suite (renamed away)"])
  assert(contains(ready.reason, "E2E suite (renamed away)"))
}

/**
 * An unread inventory refuses nothing and drops nothing.
 *
 * Not observing which checks exist is not the same as observing that this one
 * does not. The declared context stays in the union and still has to report, so
 * a failed inventory read cannot turn a required context into a satisfied one.
 */
pipeline test_an_unobserved_inventory_neither_refuses_nor_drops(task: any) {
  const set = release_context_set(RULESET, [E2E], nil, "manifest")
  assert_eq([set.refused, set.producible_observed], [[], false])
  assert(set.contexts.contains(E2E))
  const ready = release_context_readiness_from_rows(set, [run("CI status", "SUCCESS")])
  assert_eq([ready.state, ready.pending_names], ["pending", [E2E, "drift"]])
}

/**
 * A ruleset-required context is never refused for missing the inventory.
 *
 * `CI status` is an aggregate the branch requires and no single workflow job
 * emits under that name. Refusing on its absence from the job inventory would
 * make every cut impossible, and the branch's own requirement is the branch's
 * claim to make.
 */
pipeline test_a_ruleset_context_is_not_refused_for_missing_the_inventory(task: any) {
  const set = release_context_set(RULESET, [], ["Format check"], "manifest")
  assert_eq(set.refused, [])
  assert_eq(set.contexts, RULESET)
}

/**
 * A stale failure beside a fresh success is not a red.
 *
 * A rerun does not replace its predecessor's row, so a rollup carries both.
 * Resolution reduces to the latest row per name through admission's own owner;
 * a second opinion here is how a release and an admission would come to
 * disagree about the same commit.
 */
pipeline test_a_stale_failure_does_not_outrank_a_fresh_success(task: any) {
  const set = release_context_set(RULESET, [E2E], PRODUCIBLE, "manifest")
  const ready = release_context_readiness_from_rows(
    set,
    [
      run("CI status", "SUCCESS"),
      run("drift", "SUCCESS"),
      run(E2E, "FAILURE"),
      run(E2E, "SUCCESS"),
    ],
  )
  assert_eq([ready.ok, ready.state], [true, "ready"])
  assert_eq(ready.failing_names, [])
}

/**
 * A declared context still running holds, and says so as pending rather than
 * as a failure. The two are different answers to "what should happen next".
 */
pipeline test_an_in_progress_declared_context_is_pending_not_failed(task: any) {
  const set = release_context_set(RULESET, [E2E], PRODUCIBLE, "manifest")
  const ready = release_context_readiness_from_rows(
    set,
    [
      run("CI status", "SUCCESS"),
      run("drift", "SUCCESS"),
      {name: E2E, status: "IN_PROGRESS", conclusion: nil, __typename: "CheckRun"},
    ],
  )
  assert_eq([ready.state, ready.pending_names, ready.pending_count], ["pending", [E2E], 1])
}

/** An empty union proves nothing, and must not be mistaken for everything. */
pipeline test_an_empty_required_set_is_not_a_pass(task: any) {
  const ready = release_context_readiness_from_rows(release_context_set([], [], nil), [])
  assert_eq([ready.ok, ready.state], [false, "unrequired"])
}

/** Blanks and duplicates fold, so the pending count a reader trusts is exact. */
pipeline test_the_set_normalizes_blanks_and_duplicates(task: any) {
  const set = release_context_set(["drift", "drift", " "], [" ${E2E} ", E2E], PRODUCIBLE)
  assert_eq(set.contexts, [E2E, "drift"])
  assert_eq(set.declaration_source, "none")
}

/**
 * A skipped or neutral conclusion satisfies a context, because GitHub's own
 * protection merges a pull request carrying either. A reader that demanded
 * SUCCESS would be stricter than the branch it claims to be reading.
 */
pipeline test_skipped_and_neutral_satisfy_a_declared_context(task: any) {
  const set = release_context_set(RULESET, [E2E], PRODUCIBLE, "manifest")
  const ready = release_context_readiness_from_rows(
    set,
    [run("CI status", "NEUTRAL"), run("drift", "SKIPPED"), run(E2E, "SUCCESS")],
  )
  assert_eq([ready.ok, ready.state], [true, "ready"])
}
