import { command_result_fail, command_result_ok } from "std/command"
import {
  release_rehearsal_failures,
  release_rehearsal_matrix,
  render_release_rehearsal_markdown,
  run_release_rehearsal,
} from "../lib/release_rehearsal"

fn test_matrix() {
  return [
    {id: "baseline", description: "first", env: {}, command: ["true"]},
    {
      id: "stale-cli-aot",
      description: "historical stale CLI AOT failure",
      env: {},
      command: ["false"],
    },
    {
      id: "tmpdir-pressure",
      description: "historical tmpdir pressure failure",
      env: {},
      command: ["false"],
    },
  ]
}

pipeline test_release_rehearsal_matrix_enumerates_adversarial_legs(harness: Harness, task) {
  const matrix = release_rehearsal_matrix(
    {fs: harness.fs, system: harness.system, tools: harness.tools},
    {harness_root: "/repo", command: ["harn", "run", "release_harn.harn"]},
  )
  assert_eq(
    matrix.map({ leg -> leg.id }).to_list(),
    ["baseline", "poisoned-ambient-env", "tmpdir-pressure", "stale-manifest"],
  )
  assert(matrix[1]?.env?.HARN_BIN != "")
  assert(matrix[2]?.env?.TMPDIR != "")
  const root = path_join(harness.fs.temp_dir(), "release-rehearsal-cli-" + harness.random.uuid_v7())
  const pinned_harn = path_join(root, ".harn", "bin", "harn")
  harness.fs.mkdir(path_join(root, ".harn", "bin"), true)
  harness.fs.write_text(pinned_harn, "fixture")
  const defaults = release_rehearsal_matrix(
    {fs: harness.fs, system: harness.system, tools: harness.tools},
    {harness_root: root},
  )
  assert_eq(defaults[0]?.command?.[0], pinned_harn)
}

pipeline test_release_rehearsal_fail_collects_every_leg(harness: Harness, task) {
  let seen = []
  const adapter = {
    now: fn() { return "2026-07-16T00:00:00Z" },
    run: fn(leg, _index, _run_dir) {
      seen = seen + [leg.id]
      if leg.id == "baseline" {
        return command_result_ok("ok", {classification: "ok"})
      }
      if leg.id == "stale-cli-aot" {
        return command_result_fail(7, "boom", {classification: "fixture_failure"})
      }
      return command_result_fail(8, "tmp full", {classification: "fixture_failure"})
    },
  }
  const root = path_join(harness.fs.temp_dir(), "release-rehearsal-" + harness.random.uuid_v7())
  const report = run_release_rehearsal(
    harness,
    {run_id: "fixture", run_root: root, matrix: test_matrix()},
    adapter,
  )
  assert_eq(report.status, 2)
  assert_eq(seen, ["baseline", "stale-cli-aot", "tmpdir-pressure"])
  assert_eq(
    release_rehearsal_failures(report).map({ leg -> leg.id }).to_list(),
    ["stale-cli-aot", "tmpdir-pressure"],
  )
  assert(harness.fs.exists(report.report_json))
  assert(harness.fs.exists(report.report_markdown))
}

pipeline test_release_rehearsal_markdown_reports_failure_set(task) {
  const report = {
    run_id: "fixture",
    generated_at: "2026-07-16T00:00:00Z",
    legs: [
      {id: "baseline", success: true, exit_code: 0, env_keys: [], description: "ok"},
      {
        id: "tmpdir-pressure",
        success: false,
        exit_code: 2,
        env_keys: ["TMPDIR"],
        description: "bad",
        output: "full failure",
      },
    ],
  }
  const rendered = render_release_rehearsal_markdown(report)
  assert(contains(rendered, "Failures: 1"))
  assert(contains(rendered, "tmpdir-pressure"))
  assert(contains(rendered, "full failure"))
}
