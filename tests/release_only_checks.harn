import { decode_github_workflow } from "../lib/github_workflow"
import {
  release_only_check_set,
  release_only_workflow_is_branch_covered,
} from "../lib/release_only_checks"

/**
 * The two hosted certification lanes, reduced to what this computation reads.
 * Both trigger only on a schedule and on dispatch, which is why an ordinary
 * pull request never runs them: measured on burin-labs/harn, `Workspace nextest
 * (windows-latest)` appears on 2 of 20 recent pull-request heads and
 * `(macos-latest)` on 1 of 20.
 */
const WINDOWS_NIGHTLY = """
name: Windows nightly
on:
  schedule:
    - cron: "0 7 * * *"
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (windows-latest)
    steps:
      - run: cargo nextest run
"""

const MACOS_NIGHTLY = """
name: macOS nightly
on:
  schedule:
    - cron: "0 7 * * *"
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (macos-latest)
    steps:
      - run: cargo nextest run
"""

/**
 * The default branch's own gate. It runs on push and pull request, so anything
 * it covers is already proved for a commit that reached main.
 */
const CI = """
name: CI
on:
  push:
    branches: [main]
  pull_request:
  merge_group:
jobs:
  rust-checks:
    name: Check Rust code
    steps:
      - run: cargo check
  windows:
    name: Rust on Windows (build + smoke test)
    steps:
      - run: cargo build
"""

fn entry(path: string, source: string) {
  return {path: path, workflow: decode_github_workflow(source)}
}

/**
 * The computation, on the real lane shapes. The release-only set is exactly the
 * two workspace test runs, and `ci.yml` contributes nothing even though it also
 * builds on Windows, because the branch runs it on every commit already.
 */
pipeline test_release_only_set_is_the_lanes_the_branch_never_runs(task: any) {
  const computed = release_only_check_set(
    [
      entry(".github/workflows/windows-nightly.yml", WINDOWS_NIGHTLY),
      entry(".github/workflows/macos-nightly.yml", MACOS_NIGHTLY),
      entry(".github/workflows/ci.yml", CI),
    ],
  )
  assert_eq(
    computed.checks,
    ["Workspace nextest (macos-latest)", "Workspace nextest (windows-latest)"],
  )
  assert_eq(
    computed.source_workflows,
    [".github/workflows/macos-nightly.yml", ".github/workflows/windows-nightly.yml"],
  )
}

/**
 * The negative control. Give the same lane a pull-request trigger and it stops
 * being release-only, because every commit on main would then have run it. This
 * is the lever that would make the release-only delta disappear entirely.
 */
pipeline test_a_lane_the_branch_runs_is_not_release_only(task: any) {
  const covered = decode_github_workflow(
    replace(WINDOWS_NIGHTLY, "  workflow_dispatch:", "  workflow_dispatch:\n  pull_request:"),
  )
  assert_eq(release_only_workflow_is_branch_covered(covered), true)
  assert_eq(
    release_only_check_set([{path: ".github/workflows/windows-nightly.yml", workflow: covered}])
      .checks,
    [],
  )
}

/** Push-triggered and merge-group-triggered lanes are branch-covered too. */
pipeline test_push_and_merge_group_both_count_as_branch_coverage(task: any) {
  assert_eq(release_only_workflow_is_branch_covered(decode_github_workflow(CI)), true)
  const merge_group_only = decode_github_workflow(
    "name: Gate\non:\n  merge_group:\njobs:\n  gate:\n    name: Gate\n    steps:\n      - run: cargo test\n",
  )
  assert_eq(release_only_workflow_is_branch_covered(merge_group_only), true)
}

/**
 * A release-only lane bears on every path, and says so. The projection carries
 * triggers and jobs, not `paths` filters, so narrowing has to come from a
 * filter on the lane rather than from a guess made here.
 */
pipeline test_release_only_lanes_bear_on_every_path_until_a_filter_says_otherwise(task: any) {
  const computed = release_only_check_set(
    [entry(".github/workflows/windows-nightly.yml", WINDOWS_NIGHTLY)],
  )
  assert_eq([computed.bears_on_all_paths, computed.bearing_paths], [true, []])
}

/** No release-only lanes means nothing extra bears on anything. */
pipeline test_an_empty_release_only_set_bears_on_nothing(task: any) {
  const computed = release_only_check_set([entry(".github/workflows/ci.yml", CI)])
  assert_eq([computed.checks, computed.bears_on_all_paths], [[], false])
}
