import { decode_github_workflow } from "../lib/github_workflow"
import {
  release_only_check_set,
  release_only_source_workflows_for_checks,
  release_only_workflow_is_branch_covered,
  release_pull_request_lane_set,
  release_workflow_runs_on_main_commits,
} from "../lib/release_only_checks"

/**
 * The two hosted certification lanes, reduced to what this computation reads.
 * Both trigger only on a schedule and on dispatch, which is why an ordinary
 * pull request never runs them: measured on burin-labs/harn, `Workspace nextest
 * (windows-latest)` appears on 2 of 20 recent pull-request heads and
 * `(macos-latest)` on 1 of 20.
 */
const WINDOWS_NIGHTLY = """
name: Windows nightly
on:
  schedule:
    - cron: "0 7 * * *"
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (windows-latest)
    steps:
      - run: cargo nextest run
"""

const MACOS_NIGHTLY = """
name: macOS nightly
on:
  schedule:
    - cron: "0 7 * * *"
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (macos-latest)
    steps:
      - run: cargo nextest run
"""

/**
 * The default branch's own gate. It runs on push and pull request, so anything
 * it covers is already proved for a commit that reached main.
 */
const CI = """
name: CI
on:
  push:
    branches: [main]
  pull_request:
  merge_group:
jobs:
  rust-checks:
    name: Check Rust code
    steps:
      - run: cargo check
  windows:
    name: Rust on Windows (build + smoke test)
    steps:
      - run: cargo build
"""

fn entry(path: string, source: string) {
  return {path: path, workflow: decode_github_workflow(source)}
}

/**
 * The computation, on the real lane shapes. The release-only set is exactly the
 * two workspace test runs, and `ci.yml` contributes nothing even though it also
 * builds on Windows, because the branch runs it on every commit already.
 */
pipeline test_release_only_set_is_the_lanes_the_branch_never_runs(task: any) {
  const computed = release_only_check_set(
    [
      entry(".github/workflows/windows-nightly.yml", WINDOWS_NIGHTLY),
      entry(".github/workflows/macos-nightly.yml", MACOS_NIGHTLY),
      entry(".github/workflows/ci.yml", CI),
    ],
  )
  assert_eq(
    computed.checks,
    ["Workspace nextest (macos-latest)", "Workspace nextest (windows-latest)"],
  )
  assert_eq(
    computed.source_workflows,
    [".github/workflows/macos-nightly.yml", ".github/workflows/windows-nightly.yml"],
  )
}

/** An interrupted dispatch resumes only the workflow whose check is absent. */
pipeline test_release_only_sources_select_only_missing_check_owners(task: any) {
  const workflows = [
    entry(".github/workflows/windows-nightly.yml", WINDOWS_NIGHTLY),
    entry(".github/workflows/macos-nightly.yml", MACOS_NIGHTLY),
    entry(".github/workflows/ci.yml", CI),
  ]
  assert_eq(
    release_only_source_workflows_for_checks(workflows, ["Workspace nextest (macos-latest)"]),
    [".github/workflows/macos-nightly.yml"],
  )
}

/**
 * The negative control. Give the same lane a pull-request trigger and it stops
 * being release-only, because every commit on main would then have run it. This
 * is the lever that would make the release-only delta disappear entirely.
 */
pipeline test_a_lane_the_branch_runs_is_not_release_only(task: any) {
  const covered = decode_github_workflow(
    replace(WINDOWS_NIGHTLY, "  workflow_dispatch:", "  workflow_dispatch:\n  pull_request:"),
  )
  assert_eq(release_only_workflow_is_branch_covered(covered), true)
  assert_eq(
    release_only_check_set([{path: ".github/workflows/windows-nightly.yml", workflow: covered}])
      .checks,
    [],
  )
}

/** Push-triggered and merge-group-triggered lanes are branch-covered too. */
pipeline test_push_and_merge_group_both_count_as_branch_coverage(task: any) {
  assert_eq(release_only_workflow_is_branch_covered(decode_github_workflow(CI)), true)
  const merge_group_only = decode_github_workflow(
    "name: Gate\non:\n  merge_group:\njobs:\n  gate:\n    name: Gate\n    steps:\n      - run: cargo test\n",
  )
  assert_eq(release_only_workflow_is_branch_covered(merge_group_only), true)
}

/**
 * A release-only lane bears on every path, and says so. The projection carries
 * triggers and jobs, not `paths` filters, so narrowing has to come from a
 * filter on the lane rather than from a guess made here.
 */
pipeline test_release_only_lanes_bear_on_every_path_until_a_filter_says_otherwise(task: any) {
  const computed = release_only_check_set(
    [entry(".github/workflows/windows-nightly.yml", WINDOWS_NIGHTLY)],
  )
  assert_eq([computed.bears_on_all_paths, computed.bearing_paths], [true, []])
}

/** No release-only lanes means nothing extra bears on anything. */
pipeline test_an_empty_release_only_set_bears_on_nothing(task: any) {
  const computed = release_only_check_set([entry(".github/workflows/ci.yml", CI)])
  assert_eq([computed.checks, computed.bears_on_all_paths], [[], false])
}

/**
 * The mirror of the release-only set, and the one the evidence reader uses. A
 * lane that runs on pull requests can report on a drifted commit's own head, so
 * the release can hold the commit to it. A lane that does not run there can
 * never report, and requiring it would make the release wait for a result
 * nobody is going to produce.
 *
 * Empty until the lanes gain the trigger, which is what makes the reader safe
 * to land before or after the workflow change: with no lane runnable on a pull
 * request, no drifted commit owes one and nothing waits.
 */
pipeline test_pull_request_lane_set_is_empty_until_the_lanes_gain_the_trigger(task: any) {
  const before = release_pull_request_lane_set(
    [
      entry(".github/workflows/windows-nightly.yml", WINDOWS_NIGHTLY),
      entry(".github/workflows/macos-nightly.yml", MACOS_NIGHTLY),
    ],
  )
  assert_eq(before.checks, [])
  const triggered = decode_github_workflow(
    replace(WINDOWS_NIGHTLY, "  workflow_dispatch:", "  workflow_dispatch:\n  pull_request:"),
  )
  const after = release_pull_request_lane_set(
    [
      {path: ".github/workflows/windows-nightly.yml", workflow: triggered},
      entry(".github/workflows/macos-nightly.yml", MACOS_NIGHTLY),
    ],
  )
  assert_eq(after.checks, ["Workspace nextest (windows-latest)"])
}

/**
 * The two sets answer different questions and both are needed. Once a lane runs
 * on pull requests the release no longer has to run it itself, but the commit
 * still has to have passed it, because these lanes are not required checks and
 * a commit can merge with one red.
 */
pipeline test_the_two_lane_sets_are_complements(task: any) {
  const triggered = decode_github_workflow(
    replace(WINDOWS_NIGHTLY, "  workflow_dispatch:", "  workflow_dispatch:\n  pull_request:"),
  )
  const entries = [{path: ".github/workflows/windows-nightly.yml", workflow: triggered}]
  assert_eq(release_only_check_set(entries).checks, [])
  assert_eq(release_pull_request_lane_set(entries).checks, ["Workspace nextest (windows-latest)"])
}

/**
 * The v0.10.129 refusal, at its source.
 *
 * `ci.yml` carries a pull-request trigger and, on burin-labs/harn, twenty-nine
 * job names. Harvesting them made every one an obligation for a drifted
 * commit, including the path-gated `Deploy docs` that concluded SKIPPED and
 * refused run 33717920114. The branch requires exactly `CI status` and `drift`,
 * and `CI status` already aggregates those jobs, so naming them adds no proof.
 */
pipeline test_a_workflow_main_commits_already_run_contributes_no_lanes(task: any) {
  const computed = release_pull_request_lane_set([entry(".github/workflows/ci.yml", CI)])
  assert_eq(computed.checks, [])
  assert_eq(computed.source_workflows, [])
  assert_eq(computed.bears_on_all_paths, false)
  assert_eq(release_workflow_runs_on_main_commits(decode_github_workflow(CI)), true)
}

/**
 * The control that keeps the rule from being a blanket exclusion. A nightly
 * lane that gains a pull-request trigger and nothing else is still a lane a
 * drifted commit can be held to: no ordinary main commit runs it, so its result
 * is not folded into any required aggregate.
 */
pipeline test_a_nightly_lane_with_a_pull_request_trigger_is_still_a_lane(task: any) {
  const source = replace(
    WINDOWS_NIGHTLY,
    "  workflow_dispatch:",
    "  workflow_dispatch:\n  pull_request:",
  )
  const workflow = decode_github_workflow(source)
  assert_eq(release_workflow_runs_on_main_commits(workflow), false)
  const computed = release_pull_request_lane_set(
    [{path: ".github/workflows/windows-nightly.yml", workflow: workflow}],
  )
  assert_eq(computed.checks, ["Workspace nextest (windows-latest)"])
  assert_eq(computed.source_workflows, [".github/workflows/windows-nightly.yml"])
}

/**
 * The whole certification set at once, in the shape it has today: two nightly
 * lanes carrying a pull-request trigger since harn#7926, beside `ci.yml`. Only
 * the nightly lanes are owed.
 */
pipeline test_only_the_nightly_lanes_are_owed_by_a_drifted_commit(task: any) {
  const with_trigger = { source ->
    replace(source, "  workflow_dispatch:", "  workflow_dispatch:\n  pull_request:")
  }
  const computed = release_pull_request_lane_set(
    [
      entry(".github/workflows/windows-nightly.yml", with_trigger(WINDOWS_NIGHTLY)),
      entry(".github/workflows/macos-nightly.yml", with_trigger(MACOS_NIGHTLY)),
      entry(".github/workflows/ci.yml", CI),
    ],
  )
  assert_eq(
    computed.checks,
    ["Workspace nextest (macos-latest)", "Workspace nextest (windows-latest)"],
  )
  assert(!computed.checks.contains("Check Rust code"))
  assert(!computed.checks.contains("Rust on Windows (build + smoke test)"))
}
