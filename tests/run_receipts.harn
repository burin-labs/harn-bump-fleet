import { fleet_audit_receipt_read, release_audit_receipt_read } from "../lib/run_receipts"

fn receipt_path(name: string) -> string {
  const dir = path_join(harness.fs.temp_dir(), "harn-receipts-" + uuid_v7())
  harness.fs.mkdir(dir, true)
  return path_join(dir, name)
}

fn release_receipt(version = "release_harn.audit.v1") {
  return {
    schema_version: version,
    run_id: "release-run",
    started_iso: "2026-07-19T10:00:00Z",
    finished_iso: "2026-07-19T10:00:01Z",
    duration_ms: 1000,
    operator: "operator",
    host: "host",
    config: {mode: "audit", extra_config: true},
    analysis: {
      current_version: "1.2.2",
      next_version: "1.2.3",
      branch: "main",
      changelog_top: "1.2.3",
      deterministic_findings: [],
      extra_analysis: true,
    },
    agent_review: "ok",
    agent_review_detail: {validation_findings: [], extra_review: true},
    execution: [{name: "check", success: true, status: "completed", extra_step: true}],
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
}

fn fleet_receipt(version = "harn_bump_fleet.audit.v1") {
  return {
    schema_version: version,
    run_id: "fleet-run",
    started_iso: "2026-07-19T10:00:00Z",
    finished_iso: "2026-07-19T10:00:01Z",
    duration_ms: 1000,
    operator: "operator",
    host: "host",
    target_version: "v1.2.3",
    mode: "live",
    repos_total: 1,
    repos_dispatched: 1,
    summary_model: "deterministic",
    summary_text: "ok",
    summary: {},
    outcomes: [{slug: "example/repo", status: "success", detail: "done", extra: true}],
    run_session_view: {},
    public_surface_impact: {},
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
}

pipeline test_release_receipt_validates_once_and_preserves_open_payloads(task) {
  const path = receipt_path("release.json")
  harness.fs.write_text(path, json_stringify(release_receipt()) + "\n")
  const result = release_audit_receipt_read(path)
  assert(is_ok(result))
  if is_ok(result) {
    assert_eq(unwrap(result).analysis.next_version, "1.2.3")
    assert_eq(unwrap(result).execution[0].success, true)
  }
}

pipeline test_fleet_receipt_validates_once_and_preserves_open_outcomes(task) {
  const path = receipt_path("fleet.json")
  harness.fs.write_text(path, json_stringify(fleet_receipt()) + "\n")
  const result = fleet_audit_receipt_read(path)
  assert(is_ok(result))
  if is_ok(result) {
    assert_eq(unwrap(result).target_version, "v1.2.3")
    assert_eq(unwrap(result).outcomes[0].slug, "example/repo")
  }
}

pipeline test_receipts_reject_wrong_versions_and_shapes(task) {
  const release_path = receipt_path("wrong-release.json")
  harness.fs.write_text(
    release_path,
    json_stringify(release_receipt("release_harn.audit.v0")) + "\n",
  )
  const release_result = release_audit_receipt_read(release_path)
  assert(is_err(release_result))
  assert_eq(unwrap_err(release_result).kind, "schema_invalid")
  const fleet_path = receipt_path("wrong-fleet.json")
  const invalid_fleet = {...fleet_receipt(), repos_total: "one"}
  harness.fs.write_text(fleet_path, json_stringify(invalid_fleet) + "\n")
  const fleet_result = fleet_audit_receipt_read(fleet_path)
  assert(is_err(fleet_result))
  assert_eq(unwrap_err(fleet_result).kind, "schema_invalid")
}

pipeline test_receipt_read_failures_are_explicit(task) {
  const path = receipt_path("malformed.json")
  harness.fs.write_text(path, "{not json}\n")
  const result = release_audit_receipt_read(path)
  assert(is_err(result))
  assert_eq(unwrap_err(result).kind, "malformed")
  assert_eq(unwrap_err(result).path, path)
}
