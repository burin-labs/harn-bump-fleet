import {
  run_artifact_read_json_typed_result,
  run_artifact_write_json,
  run_artifacts_from_dir,
} from "std/run_artifacts"
import { FleetAuditReceipt, ReleaseAuditReceipt } from "../lib/run_receipts"

fn receipt_run() {
  const dir = path_join(harness.fs.temp_dir(), "harn-receipts-" + uuid_v7())
  return run_artifacts_from_dir("receipt-test", dir)
}

fn release_receipt(version = "release_harn.audit.v1") {
  return {
    schema_version: version,
    run_id: "release-run",
    started_iso: "2026-07-19T10:00:00Z",
    finished_iso: "2026-07-19T10:00:01Z",
    duration_ms: 1000,
    operator: "operator",
    host: "host",
    config: {mode: "audit", extra_config: true},
    analysis: {
      current_version: "1.2.2",
      next_version: "1.2.3",
      branch: "main",
      changelog_top: "1.2.3",
      deterministic_findings: [],
      extra_analysis: true,
    },
    agent_review: "ok",
    agent_review_detail: {validation_findings: [], extra_review: true},
    execution: [{name: "check", success: true, status: "completed", extra_step: true}],
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
}

fn fleet_receipt(version = "harn_bump_fleet.audit.v1") {
  return {
    schema_version: version,
    run_id: "fleet-run",
    started_iso: "2026-07-19T10:00:00Z",
    finished_iso: "2026-07-19T10:00:01Z",
    duration_ms: 1000,
    operator: "operator",
    host: "host",
    target_version: "v1.2.3",
    mode: "live",
    repos_total: 1,
    repos_dispatched: 1,
    summary_model: "deterministic",
    summary_text: "ok",
    summary: {},
    outcomes: [{slug: "example/repo", status: "success", detail: "done", extra: true}],
    run_session_view: {},
    public_surface_impact: {},
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
}

pipeline test_release_receipt_validates_once_and_preserves_open_payloads(task) {
  const run = receipt_run()
  run_artifact_write_json(run, "release.json", release_receipt())
  const result = run_artifact_read_json_typed_result(
    run,
    "release.json",
    schema_of(ReleaseAuditReceipt),
  )
  assert(is_ok(result))
  if is_ok(result) {
    assert_eq(unwrap(result).analysis.next_version, "1.2.3")
    assert_eq(unwrap(result).execution[0].success, true)
  }
}

pipeline test_fleet_receipt_validates_once_and_preserves_open_outcomes(task) {
  const run = receipt_run()
  run_artifact_write_json(run, "fleet.json", fleet_receipt())
  const result = run_artifact_read_json_typed_result(
    run,
    "fleet.json",
    schema_of(FleetAuditReceipt),
  )
  assert(is_ok(result))
  if is_ok(result) {
    assert_eq(unwrap(result).target_version, "v1.2.3")
    assert_eq(unwrap(result).outcomes[0].slug, "example/repo")
  }
}

pipeline test_receipts_reject_wrong_versions_and_shapes(task) {
  const run = receipt_run()
  run_artifact_write_json(run, "wrong-release.json", release_receipt("release_harn.audit.v0"))
  const release_result = run_artifact_read_json_typed_result(
    run,
    "wrong-release.json",
    schema_of(ReleaseAuditReceipt),
  )
  assert(is_err(release_result))
  assert_eq(unwrap_err(release_result).kind, "schema_invalid")
  const invalid_fleet = {...fleet_receipt(), repos_total: "one"}
  run_artifact_write_json(run, "wrong-fleet.json", invalid_fleet)
  const fleet_result = run_artifact_read_json_typed_result(
    run,
    "wrong-fleet.json",
    schema_of(FleetAuditReceipt),
  )
  assert(is_err(fleet_result))
  assert_eq(unwrap_err(fleet_result).kind, "schema_invalid")
}
