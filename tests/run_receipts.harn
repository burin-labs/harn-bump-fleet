import { CommandStepReceipt } from "std/command"
import {
  artifact_descriptor,
  run_artifact_read_json_result,
  run_artifact_write_json_raw,
  run_artifacts_from_dir,
} from "std/run_artifacts"
import {
  FLEET_AUDIT_CONTRACT,
  FLEET_AUDIT_DESCRIPTOR,
  RELEASE_AUDIT_CONTRACT,
  RELEASE_AUDIT_DESCRIPTOR,
  fleet_audit_receipt_write,
  fleet_audit_report_write,
  release_audit_receipt_write,
} from "../lib/run_receipts"

fn receipt_run(harness: {fs: HarnessFs, random: HarnessRandom}) {
  const dir = path_join(harness.fs.temp_dir(), "harn-receipts-" + harness.random.uuid_v7())
  return run_artifacts_from_dir("receipt-test", dir)
}

fn release_receipt(version: string = "release_harn.audit.v1") {
  const step: CommandStepReceipt = {name: "check", success: true, status: "completed", cwd: ""}
  return {
    schema_version: version,
    run_id: "release-run",
    started_iso: "2026-07-19T10:00:00Z",
    finished_iso: "2026-07-19T10:00:01Z",
    duration_ms: 1000,
    operator: "operator",
    host: "host",
    config: {mode: "audit", extra_config: true},
    analysis: {
      current_version: "1.2.2",
      next_version: "1.2.3",
      branch: "main",
      changelog_top: "1.2.3",
      deterministic_findings: [],
      extra_analysis: true,
    },
    agent_review: "ok",
    agent_review_detail: {validation_findings: [], extra_review: true},
    execution: [step],
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
}

fn fleet_receipt(version: string = "harn_bump_fleet.audit.v1") {
  return {
    schema_version: version,
    run_id: "fleet-run",
    started_iso: "2026-07-19T10:00:00Z",
    finished_iso: "2026-07-19T10:00:01Z",
    duration_ms: 1000,
    operator: "operator",
    host: "host",
    target_version: "v1.2.3",
    mode: "live",
    repos_total: 1,
    repos_dispatched: 1,
    summary_model: "deterministic",
    summary_text: "ok",
    summary: {},
    outcomes: [{slug: "example/repo", status: "success", detail: "done", extra: true}],
    run_session_view: {},
    public_surface_impact: {},
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
}

pipeline test_release_receipt_validates_once_and_preserves_open_payloads(
  harness: Harness,
  task: any,
) {
  const run = receipt_run({fs: harness.fs, random: harness.random})
  const written = release_audit_receipt_write(harness.fs, run.dir, release_receipt())
  const result = run_artifact_read_json_result(harness.fs, run, RELEASE_AUDIT_DESCRIPTOR)
  assert(is_ok(result))
  assert_eq(written.json_path, path_join(run.dir, "release-audit.json"))
  if is_ok(result) {
    assert_eq(unwrap(result).analysis.next_version, "1.2.3")
    assert_eq(unwrap(result).execution[0].success, true)
  }
}

pipeline test_fleet_receipt_validates_once_and_preserves_open_outcomes(
  harness: Harness,
  task: any,
) {
  const run = receipt_run({fs: harness.fs, random: harness.random})
  const written = fleet_audit_receipt_write(harness.fs, run.dir, fleet_receipt())
  const result = run_artifact_read_json_result(harness.fs, run, FLEET_AUDIT_DESCRIPTOR)
  assert(is_ok(result))
  assert_eq(written.json_path, run.paths.audit)
  if is_ok(result) {
    assert_eq(unwrap(result).target_version, "v1.2.3")
    assert_eq(unwrap(result).outcomes[0].slug, "example/repo")
  }
}

pipeline test_fleet_audit_report_writes_both_artifacts_through_harness_fs(
  harness: Harness,
  task: any,
) {
  const run = receipt_run({fs: harness.fs, random: harness.random})
  const written = fleet_audit_report_write(
    harness.fs,
    run.dir,
    fleet_receipt(),
    fn(receipt, audit_sha) { return "# ${receipt.target_version}\n\nAudit: ${audit_sha}\n" },
  )
  assert_eq(written.json_path, run.paths.audit)
  assert_eq(written.md_path, path_join(run.dir, "audit.md"))
  assert(starts_with(harness.fs.read_text(written.md_path), "# v1.2.3\n\nAudit: "))
}

pipeline test_receipts_reject_wrong_versions_and_shapes(harness: Harness, task: any) {
  const run = receipt_run({fs: harness.fs, random: harness.random})
  run_artifact_write_json_raw(
    harness.fs,
    run,
    "wrong-release.json",
    release_receipt("release_harn.audit.v0"),
  )
  const release_result = run_artifact_read_json_result(
    harness.fs,
    run,
    artifact_descriptor("wrong-release.json", RELEASE_AUDIT_CONTRACT),
  )
  assert(is_err(release_result))
  assert_eq(unwrap_err(release_result).kind, "schema_invalid")
  const invalid_fleet = {...fleet_receipt(), repos_total: "one"}
  run_artifact_write_json_raw(harness.fs, run, "wrong-fleet.json", invalid_fleet)
  const fleet_result = run_artifact_read_json_result(
    harness.fs,
    run,
    artifact_descriptor("wrong-fleet.json", FLEET_AUDIT_CONTRACT),
  )
  assert(is_err(fleet_result))
  assert_eq(unwrap_err(fleet_result).kind, "schema_invalid")
}
