import { parse_fleet_args } from "../bump_fleet.harn"
import { parse_self_review_args } from "../harness_self_review.harn"
import { parse_release_args } from "../lib/release_runtime"
import { parse_operator_pr_patrol_args } from "../operator_pr_patrol.harn"
import { parse_sign_args } from "../sign_bot_prs.harn"
import { parse_prerequisite_args } from "../verify_prerequisite_pr.harn"
import { parse_release_watch_args, release_watch_exit_status } from "../watch_harn_release.harn"

fn thrown(callback: closure) -> string {
  return try {
    callback()
    ""
  } catch (e) {
    to_string(e)
  }
}

pipeline test_typed_cli_boundaries(harness: Harness, task: any) {
  const options = parse_fleet_args(
    [
      "--dry-run",
      "--chat-timeout-s",
      "9",
      "--retry-failed",
      "3",
      "--only",
      "owner/repo",
      "--fleet-root",
      "/srv/fleet",
      "v1.2.3",
    ],
  )
  assert_eq(options.target, "v1.2.3")
  assert_eq(options.dry_run, true)
  assert_eq(options.chat_timeout_s, 9)
  assert_eq(options.retry_failed, 3)
  assert_eq(options.only, "owner/repo")
  assert_eq(options.fleet_root, "/srv/fleet")
  assert(contains(thrown({ -> parse_fleet_args(["--retry-failed", "many"]) }), "expected int"))
  const review = parse_self_review_args(
    ["--facts-only", "--recent", "2", "--tool-format", "native"],
  )
  assert_eq(review.facts_only, true)
  assert_eq(review.recent, 2)
  assert_eq(review.tool_format, "native")
  assert(contains(thrown({ -> parse_self_review_args(["--recent", "0"]) }), "must be positive"))
  const sign = parse_sign_args(
    ["--repo", "owner/repo", "--pr", "2", "--prs", "3,4", "--no-auto-merge"],
  )
  assert_eq(sign.prs, [2, 3, 4])
  assert_eq(sign.auto_merge, false)
  assert(contains(thrown({ -> parse_sign_args(["--repo", "owner/repo"]) }), "--pr N or --prs"))
  const release = parse_release_args(
    harness.env,
    ["--mock", "--mode", "ship-pr", "--chat-timeout-s", "12"],
  )
  assert_eq(release.mode, "ship-pr")
  assert_eq(release.chat_timeout_s, 12)
  const prerelease = parse_release_args(
    harness.env,
    ["--mock", "--bump", "prepatch", "--preid", "rc"],
  )
  assert_eq([prerelease.bump, prerelease.preid], ["prepatch", "rc"])
  assert(
    contains(
      thrown({ -> parse_release_args(harness.env, ["--bump", "prepatch"]) }),
      "--preid is required",
    ),
  )
  assert(
    contains(
      thrown({ -> parse_release_args(harness.env, ["--bump", "patch", "--preid", "rc"]) }),
      "only valid",
    ),
  )
  assert(
    contains(
      thrown({ -> parse_release_args(harness.env, ["--bump", "prepatch", "--preid", "01"]) }),
      "invalid prerelease identifier",
    ),
  )
  assert(thrown({ -> parse_release_args(harness.env, ["--mode", "unknown"]) }) != "")
  assert_eq(parse_operator_pr_patrol_args(["--repo", "owner/repo", "--pr", "7"]).pr, 7)
  assert_eq(parse_prerequisite_args(["--repo", "owner/repo", "--pr", "8"]).pr, 8)
  assert(
    contains(
      thrown({ -> parse_operator_pr_patrol_args(["--repo", "owner/repo", "--pr", "zero"]) }),
      "expected int",
    ),
  )
  assert(
    contains(
      thrown({ -> parse_prerequisite_args(["--repo", "owner/repo", "--pr", "0"]) }),
      "positive integer",
    ),
  )
  const watch = parse_release_watch_args(
    ["--tag", "v1.2.3", "--max-polls", "4", "--interval-seconds", "0"],
  )
  assert_eq(watch.max_polls, 4)
  assert_eq(watch.interval_seconds, 0)
  assert_eq(watch.hosted_run, nil)
  assert_eq(watch.warm_cache, false)
  assert_eq(parse_release_watch_args(["--hosted-run", "42"]).hosted_run, 42)
  assert_eq(parse_release_watch_args(["--warm-cache"]).warm_cache, true)
  assert_eq(release_watch_exit_status(0, false), 0)
  assert_eq(release_watch_exit_status(2, false), 2)
  assert_eq(release_watch_exit_status(0, true), 2)
  assert(
    contains(thrown({ -> parse_release_watch_args(["--max-polls", "0"]) }), "positive integer"),
  )
  assert(
    contains(thrown({ -> parse_release_watch_args(["--interval-seconds", "-1"]) }), "non-negative"),
  )
  assert(contains(thrown({ -> parse_release_watch_args(["--hosted-run", "0"]) }), "positive"))
  assert(contains(thrown({ -> parse_fleet_args(["--bogus"]) }), "no flag named --bogus"))
}
