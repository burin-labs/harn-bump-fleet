import {
  ConsumerPretagDispatchReceipt,
  ConsumerPretagGateAdapter,
  ConsumerPretagRunRow,
  consumer_pretag_dispatch_with_retry,
} from "../lib/consumer_pretag_dispatch"
import { ConsumerPretagGateTarget } from "../lib/consumer_pretag_gate"

const REVISION = "1234567890abcdef1234567890abcdef12345678"

fn target() -> ConsumerPretagGateTarget {
  return {
    slug: "owner/consumer",
    workflow: "candidate-gate.yml",
    version: "v0.10.130",
    revision: REVISION,
    inputs: {source_revision: REVISION},
    // The gate resolves this before dispatching and the run matcher keys on
    // it, so a direct call to the retry has to carry it too.
    consumer_revision: REVISION,
  }
}

fn row(id: int, status: string, conclusion: string) -> ConsumerPretagRunRow {
  return {
    id: id,
    head_sha: REVISION,
    status: status,
    conclusion: conclusion,
    html_url: "https://runs.test/${to_string(id)}",
    display_title: "Harn candidate v0.10.130 @ ${REVISION}",
  }
}

/**
 * The two adapter functions these tests actually drive, taken as parameters.
 *
 * Not a dict merged over a base: a merge types as `dict`, so a field renamed on
 * `ConsumerPretagGateAdapter` would leave these tests passing against a shape
 * the production code no longer accepts.
 */
fn adapter(
  dispatch: fn(ConsumerPretagGateTarget) -> Result<ConsumerPretagDispatchReceipt, dict>,
  runs: fn(ConsumerPretagGateTarget) -> Result<list<ConsumerPretagRunRow>, dict>,
) -> ConsumerPretagGateAdapter {
  return {
    consumer_revision: fn(_t) { return Ok(REVISION) },
    dispatch: dispatch,
    runs: runs,
    run: fn(_t, id) { return Ok(row(id, "completed", "success")) },
    wait: fn(_ms) { return nil },
    now_ms: fn() { return 0 },
  }
}

/**
 * A dropped response followed by a retry yields exactly one consumer run.
 *
 * This is the negative control for #1256. A transport failure that happens
 * after the remote already accepted the dispatch is indistinguishable from one
 * where the request never arrived, and the retry classified both as retryable
 * and re-sent. The second run then makes the pre-tag resume scan refuse, with
 * "two runs name this candidate; refusing to guess which one judged it", so a
 * release that could have been resumed no longer can and nothing on the
 * retrying run says why.
 *
 * The fixture is that exact sequence: the first send reaches the remote and
 * starts run 11, then the response is dropped with a network-class error. The
 * assertion is on the send count, not on the returned receipt, because a
 * retry that adopted the right run while still sending a second dispatch would
 * satisfy every other observable and leave the defect in place.
 */
pipeline test_a_dropped_response_then_a_retry_starts_exactly_one_run() {
  let sends = 0
  const outcome = consumer_pretag_dispatch_with_retry(
    target(),
    adapter(
      fn(_target) {
        sends = sends + 1
        // The remote acted; only the answer was lost.
        return Err({category: "network", message: "http: request failed"})
      },
      fn(_target) { return Ok(
        if sends > 0 {
          [row(11, "queued", "")]
        } else {
          []
        },
      ) },
    ),
  )
  assert_eq(sends, 1, "the retry must adopt the run the first send started, not send again")
  assert_eq(outcome.receipt?.run_id, 11)
  assert_eq(outcome.retryable, false)
}

/**
 * A send that genuinely never arrived is still retried.
 *
 * The counterpart to the control above, and the reason this cannot be fixed by
 * simply not retrying. With no run to adopt, the second send must happen or the
 * bounded retry from #1249 stops doing the job it was added for.
 */
pipeline test_a_request_that_never_arrived_is_still_resent() {
  let sends = 0
  const outcome = consumer_pretag_dispatch_with_retry(
    target(),
    adapter(
      fn(_target) {
        sends = sends + 1
        return if sends >= 2 {
          Ok({run_id: 21, head_sha: REVISION})
        } else {
          Err({category: "network", message: "http: request failed"})
        }
      },
      // Nothing was started, so there is nothing to adopt.
      fn(_target) { return Ok([]) },
    ),
  )
  assert_eq(sends, 2)
  assert_eq(outcome.receipt?.run_id, 21)
}

/**
 * An unreadable run listing resends rather than failing the gate.
 *
 * An unreadable listing is not evidence that nothing was dispatched, so this
 * arm can produce a duplicate. It is the deliberate trade: a duplicate is a
 * recoverable state that the resume scan still reports, while a release that
 * refused to send at all is not recoverable by any later attempt.
 */
pipeline test_an_unreadable_run_listing_still_resends() {
  let sends = 0
  const outcome = consumer_pretag_dispatch_with_retry(
    target(),
    adapter(
      fn(_target) {
        sends = sends + 1
        return if sends >= 2 {
          Ok({run_id: 31, head_sha: REVISION})
        } else {
          Err({category: "network", message: "http: request failed"})
        }
      },
      fn(_target) { return Err({category: "network", message: "listing unreadable"}) },
    ),
  )
  assert_eq(sends, 2)
  assert_eq(outcome.receipt?.run_id, 31)
}

/**
 * Two matching runs are not adopted, because that is the guess the gate refuses.
 *
 * By the time two exist the damage is done, and picking one here would hide it
 * from the resume scan that is designed to report it.
 */
pipeline test_an_already_ambiguous_pair_is_not_silently_adopted() {
  let sends = 0
  const outcome = consumer_pretag_dispatch_with_retry(
    target(),
    adapter(
      fn(_target) {
        sends = sends + 1
        return Err({category: "network", message: "http: request failed"})
      },
      fn(_target) { return Ok([row(41, "queued", ""), row(42, "queued", "")]) },
    ),
    2,
  )
  assert_eq(sends, 2)
  assert_eq(outcome.receipt, nil)
  assert_eq(outcome.retryable, true)
}
