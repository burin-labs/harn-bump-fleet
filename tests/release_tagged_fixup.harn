import { command_result_fail, command_result_ok } from "std/command"
import { verify_tagged_fixup_handoff } from "../lib/release_fixup_handoff"
import { release_publication, superseded_release_attempts } from "../lib/release_publication"
import { release_fixup_watch_handoff } from "../lib/release_ship_pr"
import { mock_release_watch_adapter, run_release_watch } from "../lib/release_watch_runtime"
import {
  release_watch_receipt,
  release_watch_receipt_bind_main_commit,
} from "../lib/release_watch_state"

const C = "1111111111111111111111111111111111111111"

const M = "2222222222222222222222222222222222222222"

const P = "3333333333333333333333333333333333333333"

const NOW = "2026-09-05T00:00:00Z"

pipeline test_only_selected_same_version_paperwork_is_superseded(task: any) {
  const prior = paperwork()
  const other = prior + {number: 3, url: "https://github.com/burin-labs/harn/pull/3"}
  const next = {
    number: 4,
    url: "https://github.com/burin-labs/harn/pull/4",
    head: {ref: "release-attempt/v1.2.3/${M}", sha: M},
  }
  const chosen = superseded_release_attempts(
    release_publication("1.2.3", M),
    [prior, other, next],
    prior.url,
  )
  assert_eq(chosen.map({ pr -> pr.number }).to_list(), [2])
  assert_eq(superseded_release_attempts(release_publication("1.2.4", M), [prior], prior.url), [])
}

pipeline test_replacement_head_is_reverified_before_arming(harness: Harness, task: any) {
  const receipt = original() + {state: "healthy"}
  let arms = 0
  const valid = paperwork()
    + {
      title: "Release v1.2.3",
      base: {ref: "main"},
      merged: false,
      merged_at: nil,
      merge_commit_oid: nil,
      github_state: "open",
      mergeable_state: "clean",
      auto_merge_armed: false,
      in_merge_queue: false,
    }
  const adapter = mock_release_watch_adapter(receipt)
    + {
      pr_probe: fn(_slug, url) { return if url == receipt.pr_url {
        valid + {github_state: "closed"}
      } else {
        valid + {head: {ref: "release/v1.2.3", sha: M}}
      } },
      replacement_prs: fn(_slug, _tag, _poll) { return {pull_requests: [valid]} },
      verify_replacement: fn(_receipt, pr) { return pr.head.sha == P },
      enable_auto_merge: fn(_slug, _pr) {
        arms = arms + 1
        return {state: "enabled"}
      },
    }
  const result = run_release_watch(
    harness,
    receipt,
    harness.fs.mkdtemp_in_workspace("fixup-race-") + "/watch.json",
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 2)
  assert_eq(result.watchdog.reason, "replacement_release_pr_unverified")
  assert(contains(result.reason, "verification failed"))
  assert(!contains(result.reason, "conflicts"))
  assert_eq(arms, 0)
  assert_eq(result.receipt.release_commit_oid, C)
}

fn original() {
  return release_watch_receipt_bind_main_commit(
    release_watch_receipt(
      {
        tag: "v1.2.3",
        slug: "burin-labs/harn",
        pin_sha: M,
        publication: release_publication("1.2.3", C),
        pr_url: "https://github.com/burin-labs/harn/pull/1",
        created_at: NOW,
      },
    ),
    C,
    NOW,
  )
}

fn paperwork() {
  return {
    number: 2,
    url: "https://github.com/burin-labs/harn/pull/2",
    head: {ref: "release/v1.2.3", sha: P},
  }
}

pipeline test_paperwork_retargets_without_replacing_certified_identity(task: any) {
  const receipt = original()
  const result = release_fixup_watch_handoff(receipt, receipt.publication, C, paperwork().url, NOW)
  assert_eq(result.publication.head_oid, C)
  assert_eq(result.release_commit_oid, C)
  assert_eq(result.pin_sha, M)
  assert_eq(result.pr_url, paperwork().url)
  const missing_tag = release_fixup_watch_handoff(
    receipt,
    receipt.publication,
    "",
    paperwork().url,
    NOW,
  )
  assert_eq(missing_tag.release_commit_oid, C)
  const wrong = try {
    release_fixup_watch_handoff(receipt, release_publication("1.2.3", P), C, paperwork().url, NOW)
  }
  assert(is_err(wrong))
}

pipeline test_fixup_verifier_rejects_moved_unsigned_or_changed_notes(harness: Harness, task: any) {
  for failure in ["", "moved", "unsigned", "notes"] {
    const verified = try {
      verify_tagged_fixup_handoff(
        {env: harness.env, process: harness.process},
        {repo: "/mock", mock: true},
        original().publication,
        paperwork(),
        {
          remote_oid: fn(ref) {
            assert_eq(ref, "refs/pull/2/head")
            return if failure == "moved" {
              M
            } else {
              P
            }
          },
          git: fn(args) {
            if args[0] == "fetch" {
              return command_result_ok("")
            }
            if args[0] == "rev-parse" {
              return command_result_ok(P)
            }
            if args[0] == "verify-commit" {
              return if failure == "unsigned" {
                command_result_fail(1, "unsigned")
              } else {
                command_result_ok("signed")
              }
            }
            if args[1] == "${P}:Cargo.toml" {
              return command_result_ok("[workspace.package]\nversion = \"1.2.3\"\n")
            }
            const body = if failure == "notes" && args[1] == "${P}:CHANGELOG.md" {
              "changed"
            } else {
              "shipped"
            }
            return command_result_ok("# Changelog\n\n## v1.2.3\n\n${body}\n")
          },
        },
      )
    }
    assert_eq(is_ok(verified), failure == "")
  }
}

pipeline test_watch_adopts_verified_paperwork_and_keeps_tag_identity(harness: Harness, task: any) {
  for allowed in [false, true] {
    const receipt = original() + {state: "healthy"}
    const replacement = paperwork()
      + {
        title: "Release v1.2.3",
        base: {ref: "main"},
        merged: true,
        github_state: "merged",
        mergeable_state: "clean",
        merge_commit_oid: P,
        merged_at: NOW,
        auto_merge_armed: false,
        in_merge_queue: false,
      }
    const adapter = mock_release_watch_adapter(receipt)
      + {
        workflow_runs: fn(_slug, _workflow, _poll) { return [] },
        pr_probe: fn(_slug, url) { return if url == receipt.pr_url {
          replacement + {number: 1, merged: false, github_state: "closed"}
        } else {
          replacement
        } },
        replacement_prs: fn(_slug, _tag, _poll) { return {pull_requests: [replacement]} },
        verify_replacement: fn(observed, pr) {
          assert_eq(observed.release_commit_oid, C)
          assert_eq(pr.head.sha, P)
          return allowed
        },
      }
    const path = harness.fs.mkdtemp_in_workspace("fixup-watch-") + "/watch.json"
    const result = run_release_watch(
      harness,
      receipt,
      path,
      {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
      adapter,
    )
    assert_eq(result.receipt.release_commit_oid, C)
    assert_eq(result.receipt.publication.head_oid, C)
    assert_eq(
      result.receipt.pr_url,
      if allowed {
        replacement.url
      } else {
        receipt.pr_url
      },
    )
    if !allowed {
      assert_eq(result.status, 2)
    } else {
      assert_eq(result.status, 0)
      assert_eq(result.watchdog.action, "done")
    }
  }
}
