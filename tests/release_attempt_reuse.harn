// Tests for the decision that lets a deferred release reuse the certification
// it already paid for. Shapes are the real ones: the v0.10.129 cut certified
// candidate 3b9156f3 and deferred without merging anything, leaving that
// attempt's hosted lanes recorded and green.
import { release_attempt_reuse_verdict } from "../lib/release_attempt_reuse"

const ATTEMPT = "3b9156f368442c717e7b8d4abb5fc3ed44770fa8"

// The two hosted certification lanes as they were recorded against that
// candidate: both `completed/success`, read from the commit's check runs.
const LANES = ["Workspace nextest (macos-latest)", "Workspace nextest (windows-latest)"]

fn run(name: string, status: string, conclusion: string) {
  return {name: name, status: status, conclusion: conclusion, __typename: "CheckRun"}
}

fn green() {
  return [
    run("Workspace nextest (macos-latest)", "COMPLETED", "SUCCESS"),
    run("Workspace nextest (windows-latest)", "COMPLETED", "SUCCESS"),
  ]
}

/**
 * The case worth having the module for. The v0.10.129 attempt was certified
 * green and then thrown away, costing a second two-hour certification.
 */
pipeline test_a_green_attempt_is_reused(task: any) {
  const verdict = release_attempt_reuse_verdict(ATTEMPT, LANES, green())
  assert_eq(verdict.decision, "reuse")
  assert_eq(verdict.proved, LANES)
  assert_eq(verdict.unproved, [])
  assert_eq(verdict.failed, [])
  assert(contains(verdict.reason, ATTEMPT))
}

/**
 * The load-bearing control. An attempt with nothing recorded against it must
 * certify, not reuse. Asking only "is anything red" would call this green,
 * which is the shape that turns a missing measurement into a proof.
 */
pipeline test_an_attempt_with_no_recorded_lanes_certifies(task: any) {
  const verdict = release_attempt_reuse_verdict(ATTEMPT, LANES, [])
  assert_eq(verdict.decision, "certify")
  assert_eq(verdict.proved, [])
  assert_eq(verdict.unproved, LANES)
  assert_eq(verdict.failed, [])
  assert(contains(verdict.reason, "absent evidence is not green evidence"))
}

/** A lane still running is also not proof, and also certifies rather than waits. */
pipeline test_an_unfinished_lane_certifies(task: any) {
  const rows = [
    run("Workspace nextest (macos-latest)", "COMPLETED", "SUCCESS"),
    run("Workspace nextest (windows-latest)", "IN_PROGRESS", ""),
  ]
  const verdict = release_attempt_reuse_verdict(ATTEMPT, LANES, rows)
  assert_eq(verdict.decision, "certify")
  assert_eq(verdict.proved, ["Workspace nextest (macos-latest)"])
  assert_eq(verdict.unproved, ["Workspace nextest (windows-latest)"])
}

/**
 * A red attempt refuses rather than certifying. Re-running certification on a
 * commit whose proof already failed would turn a stop into a retry.
 */
pipeline test_a_failed_lane_refuses_rather_than_recertifying(task: any) {
  const rows = [
    run("Workspace nextest (macos-latest)", "COMPLETED", "SUCCESS"),
    run("Workspace nextest (windows-latest)", "COMPLETED", "FAILURE"),
  ]
  const verdict = release_attempt_reuse_verdict(ATTEMPT, LANES, rows)
  assert_eq(verdict.decision, "refuse")
  assert_eq(verdict.failed, ["Workspace nextest (windows-latest)"])
  assert(contains(verdict.reason, "must not be reused or silently repeated"))
}

/**
 * A rerun does not replace its predecessor's row, so a stale failure can sit
 * beside a fresh success on the same name. Latest-per-name decides.
 */
pipeline test_a_stale_failure_beside_a_fresh_success_does_not_refuse(task: any) {
  const rows = [
    run("Workspace nextest (macos-latest)", "COMPLETED", "FAILURE"),
    run("Workspace nextest (windows-latest)", "COMPLETED", "SUCCESS"),
    run("Workspace nextest (macos-latest)", "COMPLETED", "SUCCESS"),
  ]
  const verdict = release_attempt_reuse_verdict(ATTEMPT, LANES, rows)
  assert_eq(verdict.decision, "reuse")
  assert_eq(verdict.failed, [])
}

/**
 * An unreadable lane list refuses. Inheriting nothing and calling it proof is
 * the same defect as reading an empty check list as a pass.
 */
pipeline test_an_unreadable_lane_list_refuses(task: any) {
  const verdict = release_attempt_reuse_verdict(ATTEMPT, [], green())
  assert_eq(verdict.decision, "refuse")
  assert(contains(verdict.reason, "could not be read"))
}

/** A malformed attempt OID refuses; nothing is looked up on a guess. */
pipeline test_a_malformed_attempt_oid_refuses(task: any) {
  const verdict = release_attempt_reuse_verdict("3b9156f3", LANES, green())
  assert_eq(verdict.decision, "refuse")
  assert(contains(verdict.reason, "40-hex"))
}

/**
 * A skipped lane counts as passing, the same rule the branch itself uses. This
 * keeps the reuse decision from re-introducing the `!= SUCCESS` defect that
 * stopped the v0.10.129 cut in the first place.
 */
pipeline test_a_skipped_lane_counts_as_proved(task: any) {
  const rows = [
    run("Workspace nextest (macos-latest)", "COMPLETED", "SKIPPED"),
    run("Workspace nextest (windows-latest)", "COMPLETED", "SUCCESS"),
  ]
  const verdict = release_attempt_reuse_verdict(ATTEMPT, LANES, rows)
  assert_eq(verdict.decision, "reuse")
  assert_eq(verdict.proved, LANES)
}
