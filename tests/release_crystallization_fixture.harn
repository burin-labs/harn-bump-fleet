import { agent_fixture_events } from "../release_harn.harn"

pipeline test_agent_fixture_events_preserves_sparse_attempt_slots(task) {
  let events = agent_fixture_events(
    harness,
    {
      finished_iso: "2026-07-06T17:22:00Z",
      agent_review: "complete",
      agent_review_detail: {
        attempts: [
          nil,
          {
            name: "initial-review",
            status: "completed",
            text: "Audit:\n- ready",
            validation_findings: [],
            llm: {provider: "mock"},
            tools: {successful: ["release_read"]},
          },
          "missing-record",
        ],
        artifacts: {},
      },
      execution: [],
    },
  )
  assert_eq(len(events), 4)
  assert_eq(events[0].event_type, "agent_review_attempt_invalid")
  assert_eq(events[0].data.index, 0)
  assert_eq(events[0].data.observed_type, "nil")
  assert_eq(events[1].event_type, "agent_review_attempt")
  assert_eq(events[1].data.name, "initial-review")
  assert_eq(events[1].data.status, "completed")
  assert_eq(events[2].event_type, "agent_review_attempt_invalid")
  assert_eq(events[2].data.index, 2)
  assert_eq(events[2].data.observed_type, "string")
  assert_eq(events[3].event_type, "agent_review_artifacts")
}

pipeline test_agent_fixture_events_defaults_partial_attempt_records(task) {
  let events = agent_fixture_events(
    harness,
    {
      finished_iso: "2026-07-06T17:22:00Z",
      agent_review: "complete",
      agent_review_detail: {attempts: [{}], artifacts: {}},
      execution: [],
    },
  )
  assert_eq(len(events), 2)
  assert_eq(events[0].event_type, "agent_review_attempt")
  assert_eq(events[0].data.name, "attempt-1")
  assert_eq(events[0].data.status, "")
  assert_eq(events[0].data.text, "")
  assert_eq(events[0].data.validation_findings, [])
  assert_eq(events[1].event_type, "agent_review_artifacts")
}
