import {
  agent_fixture_events,
  deterministic_fixture_events,
  tool_observation_events,
} from "../lib/release_crystallization"

fn fixture_payload() {
  return {
    started_iso: "2026-07-06T17:20:00Z",
    finished_iso: "2026-07-06T17:22:00Z",
    agent_review: "complete",
    agent_review_detail: {attempts: [], artifacts: {}},
    analysis: {
      repo: "/fixture/harn",
      mode: "ship-pr",
      mock: true,
      bump: "patch",
      branch: "main",
      expected_branch: "release/v1.2.3",
      base_branch: "main",
      current_version: "1.2.2",
      next_version: "1.2.3",
      latest_tag: "v1.2.2",
      pin_sha: "abcdef12",
      dirty_files: 0,
      status: "clean",
      changelog_top: "Unreleased",
      changelog_section: "- Added fixture ownership.",
      changelog_unreleased_section: "",
      commits_since_latest_tag: "abcdef1 fixture ownership",
      commit_stats_since_latest_tag: "1 file changed",
      commit_file_changes_since_latest_tag: "M\tlib/release_crystallization.harn",
      post_tag_pr_numbers: [7],
      post_tag_pr_details: "#7 fixture ownership",
      deterministic_findings: ["first finding", "second finding"],
    },
    execution: [
      {
        name: "prepare",
        command: "harn release prepare",
        success: true,
        status: 0,
        exit_code: 0,
        classification: "ok",
        recovery_hint: "",
        stdout: "prepared\n",
        stderr: "",
      },
      {
        name: "agent-recovery-advice-lint",
        command: "agent recovery",
        success: true,
        status: 0,
        exit_code: 0,
        classification: "recovered",
        recovery_hint: "",
        stdout: "repair advice",
        stderr: "",
        agent_status: "completed",
        llm: {provider: "mock"},
        tools: {successful: ["release_read"]},
        artifacts: {},
      },
    ],
  }
}

pipeline test_deterministic_fixture_events_preserve_schema_order_and_timestamps(task: any) {
  const events = deterministic_fixture_events(fixture_payload())
  assert_eq(
    events.map({ event -> event.event_type }),
    [
      "release_analysis",
      "changelog_audit_inputs",
      "deterministic_finding",
      "deterministic_finding",
      "release_step_recorded",
      "release_step_recorded",
    ],
  )
  assert_eq(
    events.map({ event -> event.schema_version }).unique(),
    ["release_harn.crystallization_input.v3"],
  )
  assert_eq(events[0]?.timestamp, "2026-07-06T17:20:00Z")
  assert_eq(events[2]?.timestamp, "2026-07-06T17:22:00Z")
  assert_eq(events[0]?.data.git_log_range, "v1.2.2..abcdef12 --max-count=80")
  assert_eq(events[5]?.data.name, "agent-recovery-advice-lint")
  assert_eq(events[4]?.data.side_effects_known, false)
  assert_eq(events[4]?.data.side_effects, [])
}

pipeline test_release_mutations_emit_complete_typed_side_effect_evidence(task: any) {
  let payload = fixture_payload()
  payload.execution = [
    {
      ...payload.execution[0],
      name: "publish-immutable-release-attempt",
      command: "git push origin HEAD:refs/heads/release/v1.2.3",
    },
    {...payload.execution[0], name: "create-pr", command: "create release pull request"},
    {...payload.execution[0], name: "auto-merge", command: "enable squash auto-merge"},
  ]
  const events = deterministic_fixture_events(payload).filter(
    { event -> event.event_type == "release_step_recorded" },
  )
  assert(events.all({ event -> event.data.side_effects_known == true }))
  assert_eq(
    events.map({ event -> event.data.side_effects[0]?.kind }),
    ["remote_git_write", "github_write", "github_write"],
  )
  assert_eq(events[0]?.data.side_effects[0]?.capability, "git.push")
  assert_eq(events[1]?.data.side_effects[0]?.mutation, "create-pr")
  assert_eq(events[2]?.data.side_effects[0]?.mutation, "auto-merge")
}

pipeline test_tool_observation_events_preserve_order_and_agent_source(task: any) {
  const events = tool_observation_events(fixture_payload())
  assert_eq(
    events.map({ event -> event.data.tool }),
    ["shell", "shell", "shell", "shell", "read_file", "read_file", "shell", "agent_loop"],
  )
  assert_eq(
    events.map({ event -> event.source }),
    [
      "deterministic",
      "deterministic",
      "deterministic",
      "deterministic",
      "deterministic",
      "deterministic",
      "deterministic",
      "agent",
    ],
  )
  assert_eq(events[0]?.data.command, "git status --porcelain --untracked-files=normal")
  assert_eq(events[7]?.data.stdout, "repair advice")
  assert_eq(events[6]?.data.side_effects_known, false)
}

pipeline test_agent_fixture_events_include_recovery_after_skipped_review(
  harness: Harness,
  task: any,
) {
  const events = agent_fixture_events(harness.fs, fixture_payload())
  assert_eq(
    events.map({ event -> event.event_type }),
    ["agent_review_skipped", "agent_recovery_advice"],
  )
  assert_eq(events[1]?.data.step_name, "agent-recovery-advice-lint")
  assert_eq(events[1]?.data.artifacts.advice_md, "")
}

pipeline test_agent_fixture_events_preserves_sparse_attempt_slots(harness: Harness, task: any) {
  const events = agent_fixture_events(
    harness.fs,
    {
      finished_iso: "2026-07-06T17:22:00Z",
      agent_review: "complete",
      agent_review_detail: {
        attempts: [
          nil,
          {
            name: "initial-review",
            status: "completed",
            text: "Audit:\n- ready",
            validation_findings: [],
            llm: {provider: "mock"},
            tools: {successful: ["release_read"]},
          },
          "missing-record",
        ],
        artifacts: {},
      },
      execution: [],
    },
  )
  assert_eq(len(events), 4)
  assert_eq(events[0]?.event_type, "agent_review_attempt_invalid")
  assert_eq(events[0]?.data.index, 0)
  assert_eq(events[0]?.data.observed_type, "nil")
  assert_eq(events[1]?.event_type, "agent_review_attempt")
  assert_eq(events[1]?.data.name, "initial-review")
  assert_eq(events[1]?.data.status, "completed")
  assert_eq(events[2]?.event_type, "agent_review_attempt_invalid")
  assert_eq(events[2]?.data.index, 2)
  assert_eq(events[2]?.data.observed_type, "string")
  assert_eq(events[3]?.event_type, "agent_review_artifacts")
}

pipeline test_agent_fixture_events_defaults_partial_attempt_records(harness: Harness, task: any) {
  const events = agent_fixture_events(
    harness.fs,
    {
      finished_iso: "2026-07-06T17:22:00Z",
      agent_review: "complete",
      agent_review_detail: {attempts: [{}], artifacts: {}},
      execution: [],
    },
  )
  assert_eq(len(events), 2)
  assert_eq(events[0]?.event_type, "agent_review_attempt")
  assert_eq(events[0]?.data.name, "attempt-1")
  assert_eq(events[0]?.data.status, "")
  assert_eq(events[0]?.data.text, "")
  assert_eq(events[0]?.data.validation_findings, [])
  assert_eq(events[1]?.event_type, "agent_review_artifacts")
}
