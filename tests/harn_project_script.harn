fn sh(process: HarnessProcess, command) {
  const result = process.shell(command)
  if !result.success {
    throw result.combined
  }
  return result
}

fn quote(value: string) -> string {
  return "'" + replace(value, "'", "'\\''") + "'"
}

fn invocation_args(log: string) -> list<list<string>> {
  return split(log, "\n--invocation--\n").filter({ record -> return record != "" }).map(
    { record -> return split(record, "\0").filter({ arg -> return arg != "" }).to_list() },
  )
    .to_list()
}

pipeline test_harn_project_script_includes_new_sources_and_preserves_filenames(
  harness: Harness,
  task,
) {
  const root = trim(sh(harness.process, "mktemp -d").stdout)
  const repo = root + "/repo"
  const bin = root + "/bin"
  const log = root + "/harn.log"
  const version = root + "/harn.version"
  const installs = root + "/installs.log"
  harness.fs.mkdir(repo, true)
  harness.fs.mkdir(bin, true)
  harness.fs.mkdir(repo + "/scripts", true)
  harness.fs.mkdir(repo + "/.harn/bin", true)
  sh(harness.process, "git init -q " + quote(repo))
  sh(harness.process, "git -C " + quote(repo) + " config user.email test@example.com")
  sh(harness.process, "git -C " + quote(repo) + " config user.name test")
  harness.fs.write_text(repo + "/tracked.harn", "const tracked = true\n")
  harness.fs.write_text(repo + "/space name.harn", "const spaced = true\n")
  harness.fs.write_text(repo + "/line\nbreak.harn", "const newline = true\n")
  harness.fs.write_text(repo + "/-flag.harn", "const leading_dash = true\n")
  harness.fs.write_text(repo + "/.gitignore", "ignored.harn\n")
  harness.fs.write_text(repo + "/.harn-version", "0.10.61\n")
  sh(harness.process, "git -C " + quote(repo) + " add .")
  sh(harness.process, "git -C " + quote(repo) + " commit -q -m base")
  harness.fs.write_text(repo + "/new source.harn", "const fresh = true\n")
  harness.fs.write_text(repo + "/ignored.harn", "const ignored = true\n")
  const fake_harn = repo + "/.harn/bin/harn"
  harness.fs.write_text(
    fake_harn,
    "#!/usr/bin/env bash\nset -euo pipefail\nif [[ \"$#\" -gt 0 && \"$1\" == \"--version\" ]]; then printf 'harn %s\\n' \"$(cat \"$HARN_EXT_SOURCE_TEST_VERSION\")\"; exit 0; fi\nprintf '\\n--invocation--\\n' >> \"$HARN_EXT_SOURCE_TEST_LOG\"\nprintf '%s\\0' \"$@\" >> \"$HARN_EXT_SOURCE_TEST_LOG\"\n",
  )
  sh(harness.process, "chmod +x " + quote(fake_harn))
  harness.fs.write_text(version, "0.10.60\n")
  harness.fs.write_text(
    repo + "/scripts/install_harn.sh",
    "#!/usr/bin/env bash\nset -euo pipefail\nprintf '%s\\n' \"$1\" > \"$HARN_EXT_SOURCE_TEST_VERSION\"\nprintf 'install %s\\n' \"$1\" >> \"$HARN_EXT_SOURCE_TEST_INSTALLS\"\n",
  )
  sh(harness.process, "chmod +x " + quote(repo + "/scripts/install_harn.sh"))
  harness.fs.write_text(
    bin + "/harn",
    "#!/usr/bin/env bash\necho 'PATH harn must not run' >&2\nexit 91\n",
  )
  sh(harness.process, "chmod +x " + quote(bin + "/harn"))
  const source_script = path_join(dirname(harness.fs.cwd()), "scripts", "harn-project.sh")
  const script = repo + "/scripts/harn-project.sh"
  harness.fs.write_text(script, harness.fs.read_text(source_script))
  sh(harness.process, "chmod +x " + quote(script))
  const test_path = bin + ":" + harness.env.get_or("PATH", "")
  const command_env = "PATH="
    + quote(test_path)
    + " HARN_EXT_SOURCE_TEST_LOG="
    + quote(log)
    + " HARN_EXT_SOURCE_TEST_VERSION="
    + quote(version)
    + " HARN_EXT_SOURCE_TEST_INSTALLS="
    + quote(installs)
  sh(harness.process, "cd " + quote(repo) + " && " + command_env + " " + quote(script) + " verify")
  assert_eq(trim(harness.fs.read_text(version)), "0.10.61")
  assert_eq(trim(harness.fs.read_text(installs)), "install 0.10.61")
  const local_calls = invocation_args(harness.fs.read_text(log))
  assert_eq(len(local_calls), 3)
  for call in local_calls {
    assert(contains(call, "./tracked.harn"))
    assert(contains(call, "./space name.harn"))
    assert(contains(call, "./line\nbreak.harn"))
    assert(contains(call, "./-flag.harn"))
    assert(contains(call, "./new source.harn"))
    assert_eq(contains(call, "./ignored.harn"), false)
  }
  harness.fs.write_text(log, "")
  sh(
    harness.process,
    "cd " + quote(repo) + " && " + command_env + " " + quote(script) + " --tracked-only verify",
  )
  const tracked_calls = invocation_args(harness.fs.read_text(log))
  assert_eq(len(tracked_calls), 3)
  for call in tracked_calls {
    assert(contains(call, "./tracked.harn"))
    assert(contains(call, "./line\nbreak.harn"))
    assert(contains(call, "./-flag.harn"))
    assert_eq(contains(call, "./new source.harn"), false)
  }
  harness.fs.write_text(log, "")
  sh(harness.process, "cd " + quote(repo) + " && " + command_env + " " + quote(script) + " format")
  const format_calls = invocation_args(harness.fs.read_text(log))
  assert_eq(len(format_calls), 1)
  const format_call = format_calls[0] ?? []
  assert_eq(format_call[0], "fmt")
  assert(contains(format_call, "./new source.harn"))
  harness.fs.write_text(log, "")
  sh(harness.process, "cd " + quote(root) + " && " + command_env + " " + quote(script) + " test")
  assert_eq(
    invocation_args(harness.fs.read_text(log)),
    [["test", "tests/", "--parallel", "--verbose"]],
  )
  assert_eq(trim(harness.fs.read_text(installs)), "install 0.10.61")
  // Delete the deliberately newline-bearing fixture explicitly before the
  // recursive teardown so cleanup never has to rediscover that path.
  harness.fs.delete(repo + "/line\nbreak.harn")
  harness.fs.delete(root)
}
