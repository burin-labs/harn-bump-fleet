import {
  harn_bump_repositories,
  harn_package_repositories,
  read_fleet_manifest,
  resolve_fleet_root,
  validate_fleet_manifest,
} from "../lib/fleet_manifest"

fn thrown(callback) -> string {
  return try {
    callback()
    ""
  } catch (e) {
    to_string(e)
  }
}

pipeline test_fleet_manifest_is_typed_unique_and_complete() {
  const manifest = read_fleet_manifest("../fleet.toml")
  assert_eq(manifest.schema_version, 1)
  assert(len(manifest.repositories) >= 30)
  let slugs = {}
  let directories = {}
  for repo in manifest.repositories {
    assert_eq(slugs[repo.slug] ?? false, false, "duplicate fleet slug ${repo.slug}")
    assert_eq(
      directories[repo.directory] ?? false,
      false,
      "duplicate fleet directory ${repo.directory}",
    )
    slugs[repo.slug] = true
    directories[repo.directory] = true
  }
  assert(slugs["burin-labs/20eq"] ?? false)
  assert(len(harn_package_repositories(manifest)) >= 25)
  assert(len(harn_bump_repositories(manifest)) >= 20)
}

pipeline test_fleet_root_expansion() {
  assert_eq(resolve_fleet_root("~/projects", "/Users/test"), "/Users/test/projects")
  assert_eq(resolve_fleet_root("~", "/Users/test"), "/Users/test")
  assert_eq(resolve_fleet_root("/srv/repos", "/Users/test"), "/srv/repos")
}

pipeline test_fleet_manifest_rejects_ambiguous_or_unsafe_projections() {
  const base = {schema_version: 1, fleet: {default_root: "~/projects"}, repositories: []}
  const duplicate = base
    + {
    repositories: [
      {slug: "burin-labs/pkg", directory: "one"},
      {slug: "burin-labs/pkg", directory: "two"},
    ],
  }
  assert(contains(thrown({ -> validate_fleet_manifest(duplicate) }), "duplicate"))
  const escaped = base
    + {
    repositories: [{slug: "burin-labs/pkg", directory: "../pkg", harn_package: true}],
  }
  assert(contains(thrown({ -> validate_fleet_manifest(escaped) }), "invalid"))
  const poll_without_package = base
    + {
    repositories: [{slug: "burin-labs/pkg", directory: "pkg", run_poll_tick: true}],
  }
  assert(
    contains(thrown({ -> validate_fleet_manifest(poll_without_package) }), "without harn_package"),
  )
}
