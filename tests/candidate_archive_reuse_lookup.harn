// Write-path coverage for the artifact lookup the candidate archive gate runs.
//
// The gate's only key is an exact, source-qualified artifact name, so the
// lookup must actually reach GitHub for a well-formed slug. Every existing test
// exercised the surrounding decision functions, which are pure, and none called
// this function with a real slug. A refusal that fired on every slug therefore
// passed the suite and failed the first live release.
import { candidate_archive_artifacts_named } from "../lib/candidate_archive_reuse"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const ARTIFACTS = BASE + "/repos/burin-labs/harn/actions/artifacts"

const NAME = "candidate-archive-manifest-9b2feeb27c"

const SHA = "9b2feeb27c1d4f5a6b7c8d9e0f1a2b3c4d5e6f70"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "candidate-archive-lookup-test-token"}
}

fn artifact_row() -> dict {
  return {id: 4242, name: NAME, expired: false, workflow_run: {id: 99, head_sha: SHA}}
}

/**
 * The falsifier for the shape defect.
 *
 * Reading `regex_captures` as a flat list makes this refuse `burin-labs/harn`
 * with `invalid_artifact_query` and issue no request at all. The assertion on
 * the request path is what proves the lookup was reached, rather than that the
 * function merely returned something.
 */
pipeline test_a_well_formed_slug_reaches_the_artifact_endpoint(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    ARTIFACTS + "?per_page=100&name=${NAME}",
    {status: 200, body: json_stringify({artifacts: [artifact_row()]})},
  )
  const result = candidate_archive_artifacts_named(harness, "burin-labs/harn", NAME, options())
  assert_eq(is_err(result), false, "a well-formed slug must not be refused")
  const rows = unwrap(result)
  assert_eq(len(rows), 1)
  assert_eq(rows[0].name, NAME)
  assert_eq(rows[0].run_head_sha, SHA)
  const calls = harness.testing.http_mock_calls().filter({ call -> call.method == "GET" }).to_list()
  assert_eq(len(calls), 1, "the lookup must issue exactly one read")
  assert(
    contains(calls[0].url, "/repos/burin-labs/harn/actions/artifacts"),
    "the request must name the owner and repository from the slug",
  )
}

/** A slug carrying no separator is unusable, and refusing it issues no read. */
pipeline test_a_slug_without_a_separator_is_refused_before_any_request(harness: Harness) {
  harness.testing.http_mock_clear()
  const result = candidate_archive_artifacts_named(harness, "burin-labs", NAME, options())
  assert_eq(is_err(result), true)
  assert_eq(unwrap_err(result).code, "invalid_artifact_query")
  assert_eq(len(harness.testing.http_mock_calls()), 0, "a refused query must not reach GitHub")
}

/** An empty artifact name is equally unusable, and is refused the same way. */
pipeline test_an_empty_artifact_name_is_refused_before_any_request(harness: Harness) {
  harness.testing.http_mock_clear()
  const result = candidate_archive_artifacts_named(harness, "burin-labs/harn", "  ", options())
  assert_eq(is_err(result), true)
  assert_eq(unwrap_err(result).code, "invalid_artifact_query")
  assert_eq(len(harness.testing.http_mock_calls()), 0, "a refused query must not reach GitHub")
}

/** An empty list is a read that found nothing, never a read that failed. */
pipeline test_a_name_with_no_artifacts_reads_empty_rather_than_failing(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    ARTIFACTS + "?per_page=100&name=${NAME}",
    {status: 200, body: json_stringify({artifacts: []})},
  )
  const result = candidate_archive_artifacts_named(harness, "burin-labs/harn", NAME, options())
  assert_eq(is_err(result), false)
  assert_eq(len(unwrap(result)), 0)
}
