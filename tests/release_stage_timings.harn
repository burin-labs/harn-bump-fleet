import {
  RELEASE_TIMELINE_STAGES,
  release_stage_timing_lines,
  release_stage_timing_markdown,
  release_stage_timing_report,
} from "../lib/release_stage_timings"
import { TimingSpanRecord } from "../lib/timing_report"

fn span(name: string, duration_ms: int, status: string = "ok") -> TimingSpanRecord {
  const attributes: dict = {stage: name}
  return {
    name: name,
    kind: "user_timing",
    duration_ms: duration_ms,
    status: status,
    attributes: attributes,
    event_count: 0,
  }
}

fn every_stage() -> list<TimingSpanRecord> {
  let spans: list<TimingSpanRecord> = []
  for stage in RELEASE_TIMELINE_STAGES {
    spans = spans + [span(stage.key, 1000)]
  }
  return spans
}

pub pipeline test_a_complete_timeline_reports_every_stage(harness: Harness, task: any) {
  const report = release_stage_timing_report(every_stage())
  assert_eq(report.complete, true)
  assert_eq(report.unmeasured, [])
  assert_eq(report.measured_count, len(RELEASE_TIMELINE_STAGES))
  assert_eq(len(report.rows), len(RELEASE_TIMELINE_STAGES))
  assert_eq(report.total_duration_ms, 1000 * len(RELEASE_TIMELINE_STAGES))
}

/**
 * The whole point of the registry: a stage that emitted nothing is a row, not
 * an absence.
 *
 * The aggregate timing summary this replaces is a slowest-N view keyed by span
 * name with a minimum-duration floor, so a stage that never ran and a stage
 * that ran quickly are both simply missing from it. A reader cannot tell a
 * measured zero from measuring nothing.
 */
pub pipeline test_a_stage_that_emitted_nothing_is_named(harness: Harness, task: any) {
  const missing = RELEASE_TIMELINE_STAGES[1]?.stage ?? ""
  let spans: list<TimingSpanRecord> = []
  for stage in RELEASE_TIMELINE_STAGES {
    if stage.stage == missing {
      continue
    }
    spans = spans + [span(stage.key, 500)]
  }
  const report = release_stage_timing_report(spans)
  assert_eq(report.complete, false)
  assert_eq(report.unmeasured, [missing])
  assert_eq(len(report.rows), len(RELEASE_TIMELINE_STAGES))
  assert(contains(join(release_stage_timing_lines(report), "\n"), "unmeasured"))
  assert(contains(join(release_stage_timing_markdown(report), "\n"), missing))
}

pub pipeline test_an_empty_run_reports_every_stage_as_unmeasured(harness: Harness, task: any) {
  const report = release_stage_timing_report([])
  assert_eq(report.complete, false)
  assert_eq(report.measured_count, 0)
  assert_eq(len(report.unmeasured), len(RELEASE_TIMELINE_STAGES))
  assert_eq(len(report.rows), len(RELEASE_TIMELINE_STAGES))
}

/** A stage that ran in zero milliseconds is measured, not missing. */
pub pipeline test_a_zero_duration_stage_is_measured(harness: Harness, task: any) {
  const first = RELEASE_TIMELINE_STAGES[0] ?? {stage: "", label: "", key: ""}
  const report = release_stage_timing_report([span(first.key, 0)])
  assert_eq(report.rows[0]?.measured, true)
  assert_eq(report.rows[0]?.duration_ms, 0)
  assert(!report.unmeasured.contains(first.stage))
}

/** Repeats aggregate, and a failing span is counted as an error, not dropped. */
pub pipeline test_repeated_and_failing_spans_are_both_kept(harness: Harness, task: any) {
  const first = RELEASE_TIMELINE_STAGES[0] ?? {stage: "", label: "", key: ""}
  const report = release_stage_timing_report([span(first.key, 100), span(first.key, 250, "error")])
  assert_eq(report.rows[0]?.count, 2)
  assert_eq(report.rows[0]?.duration_ms, 350)
  assert_eq(report.rows[0]?.error_count, 1)
}

/** An unrelated span must not satisfy any stage. */
pub pipeline test_an_unrelated_span_measures_no_stage(harness: Harness, task: any) {
  const report = release_stage_timing_report([span("release.command", 90000)])
  assert_eq(report.measured_count, 0)
  assert_eq(report.total_duration_ms, 0)
}

/** Every declared stage names a distinct span, or two rows would share a number. */
pub pipeline test_every_declared_stage_has_a_distinct_key(harness: Harness, task: any) {
  let keys: list<string> = []
  for stage in RELEASE_TIMELINE_STAGES {
    assert(starts_with(stage.key, "release."), "stage key must be a release span name")
    assert(!keys.contains(stage.key), "duplicate stage key ${stage.key}")
    keys = keys + [stage.key]
  }
  assert(len(keys) >= 6, "the timeline must declare every stage the harness reaches")
}
