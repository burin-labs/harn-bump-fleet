import {
  CERTIFICATION_LANE_LIMIT_MS,
  certification_wait_begin,
  certification_wait_end,
  certification_wait_poll,
} from "../lib/certification_progress"

fn spec() {
  return {
    platform: "windows",
    workflow_path: ".github/workflows/windows-nightly.yml",
    required_job: "Workspace nextest (windows-latest)",
  }
}

fn adapter(harness: Harness, started_ms: int) {
  let now = started_ms
  let lines = []
  return {
    now_ms: fn() { return now },
    advance: fn(ms) { now = now + ms },
    lines: fn() { return lines },
    host: harness,
    log: fn(line) { lines = lines + [line] },
  }
}

pipeline test_certification_wait_uses_stdlib_start_tick_and_finish(harness: Harness, task: any) {
  harness.testing.clock_set(0)
  const sink = adapter(harness, 0)
  const wait = certification_wait_begin(sink, spec(), "burin-labs/harn", 6001)
  assert_eq(wait.reporter != nil, true)
  assert_eq(CERTIFICATION_LANE_LIMIT_MS, 7200000)
  assert(sink.lines().any({ line -> contains(line, "windows certification") }))
  assert(sink.lines().any({ line -> contains(line, "Workspace nextest (windows-latest)") }))
  harness.testing.clock_advance(10000)
  sink.advance(10000)
  const after_first = certification_wait_poll(sink, wait, spec(), "queued", 0, 1)
  harness.testing.clock_advance(60000)
  sink.advance(60000)
  const after_heartbeat = certification_wait_poll(sink, after_first, spec(), "in_progress", 0, 7)
  assert_eq(after_heartbeat.last_status, "in_progress")
  harness.testing.clock_advance(1000)
  sink.advance(1000)
  const done = certification_wait_end(sink, after_heartbeat, spec(), "success", 0)
  assert_eq(done.reporter?.finished, true)
  assert(sink.lines().any({ line -> contains(line, "certification success") }))
}

pipeline test_certification_wait_without_host_stays_on_adapter_log(task: any) {
  let now = 0
  let lines = []
  const sink = {now_ms: fn() { return now }, log: fn(line) { lines = lines + [line] }}
  const wait = certification_wait_begin(sink, spec(), "burin-labs/harn", 9)
  assert_eq(wait.reporter == nil, true)
  now = 60000
  const polled = certification_wait_poll(sink, wait, spec(), "in_progress", 0, 6)
  assert(lines.any({ line -> contains(line, "still in_progress") }))
  certification_wait_end(sink, polled, spec(), "success", 0)
  assert(lines.any({ line -> contains(line, "certification success") }))
}
