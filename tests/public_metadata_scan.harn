import { private_metadata_tokens, public_metadata_hits } from "../lib/public_metadata_scan"

pipeline test_private_denylist_ignores_comments_and_blank_lines() {
  assert_eq(private_metadata_tokens("\n# owned privately\nalpha\n  beta  \n"), ["alpha", "beta"])
}

pipeline test_scan_reports_only_file_coordinates_and_catches_every_matching_line() {
  const private_tokens = private_metadata_tokens("private-source-root\nprivate-crate-name\n")
  const hits = public_metadata_hits(
    [
      {path: "fleet.toml", text: "public\nprivate-source-root/src/lib.rs\nprivate-crate-name\n"},
      {path: "docs/guide.md", text: "public only\n"},
    ],
    private_tokens,
  )
  assert_eq(hits, [{path: "fleet.toml", line: 2}, {path: "fleet.toml", line: 3}])
  assert_eq(contains(json_stringify(hits), "private-source-root"), false)
  assert_eq(contains(json_stringify(hits), "private-crate-name"), false)
}

pipeline test_scan_rejects_an_empty_denylist_instead_of_vacuously_passing() {
  let message = ""
  try {
    public_metadata_hits([{path: "fleet.toml", text: "anything"}], [])
  } catch (error) {
    message = to_string(error)
  }
  assert(contains(message, "at least one token"))
}
