import { git_ls_remote } from "std/git"
import {
  publish_release_publication,
  release_publication,
  release_publication_decision,
  superseded_release_attempts,
} from "../lib/release_publication"

fn sh(command) {
  const result = shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn fixture() {
  const root = path_join(harness.fs.temp_dir(), "immutable-release-publication-" + uuid_v7())
  const origin = path_join(root, "origin.git")
  const work = path_join(root, "work")
  sh("git init --bare -q '" + origin + "'")
  sh("git init -q '" + work + "'")
  sh("git -C '" + work + "' config user.email test@example.com")
  sh("git -C '" + work + "' config user.name test")
  sh("git -C '" + work + "' checkout -q -b main")
  harness.fs.write_text(path_join(work, "fixture.txt"), "first\n")
  sh("git -C '" + work + "' add fixture.txt && git -C '" + work + "' commit -q -m first")
  sh("git -C '" + work + "' remote add origin '" + origin + "'")
  return {root: root, origin: origin, work: work}
}

fn head(work: string) -> string {
  return trim(sh("git -C '" + work + "' rev-parse HEAD").stdout)
}

pipeline test_release_publication_contract_is_immutable(task) {
  const oid = "0123456789abcdef0123456789abcdef01234567"
  const publication = release_publication("1.2.3", oid)
  assert_eq(publication.local_branch, "release/v1.2.3")
  assert_eq(publication.remote_ref, "release-attempt/v1.2.3/${oid}")
  assert_eq(release_publication_decision(publication, "").action, "publish")
  assert_eq(release_publication_decision(publication, oid).action, "resume")
  assert_eq(
    release_publication_decision(publication, "fedcba9876543210fedcba9876543210fedcba98").action,
    "fail",
  )
}

pipeline test_release_publication_selects_only_prior_attempt_prs(task) {
  const publication = release_publication("1.2.3", "0123456789abcdef0123456789abcdef01234567")
  const prior = superseded_release_attempts(
    publication,
    [
      {number: 1, head: {ref: publication.remote_ref}},
      {number: 2, head: {ref: "release-attempt/v1.2.3/fedcba9876543210fedcba9876543210fedcba98"}},
      {number: 3, head: {ref: "release-attempt/v1.2.4/fedcba9876543210fedcba9876543210fedcba98"}},
      {number: 4, head: {ref: "release/v1.2.3"}},
    ],
  )
  assert_eq(len(prior), 1)
  assert_eq(prior[0].number, 2)
}

pipeline test_release_publication_pushes_once_and_resumes_exact_ref(task) {
  const f = fixture()
  const publication = release_publication("1.2.3", head(f.work))
  const first = publish_release_publication({repo: f.work, mock: false}, publication)
  assert_eq(first.success, true)
  assert_eq(first.action, "published")
  const remote = git_ls_remote("origin", {repo: f.work, refs: ["refs/heads/${publication.remote_ref}"], heads: true})
  assert_eq(remote.success, true)
  assert_eq(remote.data.refs[0].oid, publication.head_oid)
  const resumed = publish_release_publication({repo: f.work, mock: false}, publication)
  assert_eq(resumed.success, true)
  assert_eq(resumed.action, "resume")
  sh("rm -rf '" + f.root + "'")
}

pipeline test_release_publication_new_head_never_rewrites_prior_attempt(task) {
  const f = fixture()
  const first_publication = release_publication("1.2.3", head(f.work))
  assert_eq(publish_release_publication({repo: f.work, mock: false}, first_publication).success, true)
  harness.fs.write_text(path_join(f.work, "fixture.txt"), "second\n")
  sh("git -C '" + f.work + "' commit -q -am second")
  const second_publication = release_publication("1.2.3", head(f.work))
  assert_ne(second_publication.remote_ref, first_publication.remote_ref)
  assert_eq(
    publish_release_publication({repo: f.work, mock: false}, second_publication).success,
    true,
  )
  const prior = git_ls_remote(
    "origin",
    {repo: f.work, refs: ["refs/heads/${first_publication.remote_ref}"], heads: true},
  )
  assert_eq(prior.data.refs[0].oid, first_publication.head_oid)
  sh("rm -rf '" + f.root + "'")
}

pipeline test_release_publication_ref_mismatch_fails_before_any_mutation(task) {
  const f = fixture()
  const publication = release_publication("1.2.3", head(f.work))
  harness.fs.write_text(path_join(f.work, "fixture.txt"), "conflicting\n")
  sh("git -C '" + f.work + "' commit -q -am conflicting")
  const conflicting_oid = head(f.work)
  sh("git -C '" + f.work + "' push -q origin HEAD:refs/heads/scratch")
  sh(
    "git --git-dir='" + f.origin + "' update-ref refs/heads/" + publication.remote_ref + " "
      + conflicting_oid,
  )
  const result = publish_release_publication({repo: f.work, mock: false}, publication)
  assert_eq(result.success, false)
  assert_eq(result.action, "fail")
  const remote = git_ls_remote("origin", {repo: f.work, refs: ["refs/heads/${publication.remote_ref}"], heads: true})
  assert_eq(remote.data.refs[0].oid, conflicting_oid)
  sh("rm -rf '" + f.root + "'")
}
