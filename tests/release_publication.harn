}

pipeline test_explicit_pin_selects_one_of_multiple_bare_release_attempts(task) {
  const stale = release_publication("1.2.3", "0123456789abcdef0123456789abcdef01234567")
  const requested = release_publication("1.2.3", "fedcba9876543210fedcba9876543210fedcba98")
  const refs = [remote_attempt_ref(stale), remote_attempt_ref(requested)]
  const selected = release_recovery_source("1.2.3", [], refs, "", requested.head_oid)
  assert_eq(selected?.publication, requested)
  const unpinned = try {
    release_recovery_source("1.2.3", [], refs, "")
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(unpinned, "multiple unclaimed immutable release attempts"), true)
  const missing = try {
    release_recovery_source("1.2.3", [], refs, "", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(missing, "has no matching immutable origin ref"), true)
}

pipeline test_recovery_default_selects_the_unique_newest_base_ancestor(task) {
  const old_pin = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const new_pin = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const new_attempt = "2222222222222222222222222222222222222222"
  const candidates = [
    {
      publication: release_publication("1.2.3", "1111111111111111111111111111111111111111"),
      pin_oid: old_pin,
    },
    {publication: release_publication("1.2.3", new_attempt), pin_oid: new_pin},
  ]
  const selected = release_recovery_candidate_preference(
    "1.2.3",
    candidates,
    "",
    fn(older, newer) { return older == old_pin && newer == new_pin },
  )
  assert_eq(selected.attempt_oid, new_attempt)
  assert_eq(selected.pin_oid, new_pin)
  assert_eq(selected.mode, "newest_base_ancestor")
}

pipeline test_recovery_default_fails_with_exact_pin_commands_when_ancestry_is_ambiguous(task) {
  const first_pin = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const second_pin = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const first_ref = "release-attempt/v1.2.3/1111111111111111111111111111111111111111"
  const second_ref = "release-attempt/v1.2.3/2222222222222222222222222222222222222222"
  const candidates = [
    {
      publication: release_publication("1.2.3", "1111111111111111111111111111111111111111"),
      pin_oid: first_pin,
    },
    {
      publication: release_publication("1.2.3", "2222222222222222222222222222222222222222"),
      pin_oid: second_pin,
    },
  ]
  const message = try {
    release_recovery_candidate_preference(
      "1.2.3",
      candidates,
      "",
      fn(_older, _newer) { return false },
    )
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(message, "no unique newest source pin can be proven"))
  assert(contains(message, "--at-sha ${first_pin}"))
  assert(contains(message, "--at-sha ${second_pin}"))
  assert(contains(message, first_ref))
  assert(contains(message, second_ref))
}

pipeline test_recovery_explicit_pin_selects_one_exact_candidate(task) {
  const first_pin = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const second_pin = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const second_attempt = "2222222222222222222222222222222222222222"
  const candidates = [
    {
      publication: release_publication("1.2.3", "1111111111111111111111111111111111111111"),
      pin_oid: first_pin,
    },
    {publication: release_publication("1.2.3", second_attempt), pin_oid: second_pin},
  ]
  const selected = release_recovery_candidate_preference(
    "1.2.3",
    candidates,
    second_pin,
    fn(_older, _newer) { return false },
