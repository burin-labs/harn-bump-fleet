pipeline test_release_publication_pushes_once_and_resumes_exact_ref(harness: Harness, task) {
  const f = fixture(harness)
  const publication = release_publication("1.2.3", head(harness.process, f.work))
  const first = publish_release_publication(
    harness.process,
    {repo: f.work, mock: false},
    publication,
  )
  assert_eq(first.success, true)
  assert_eq(first.action, "published")
  assert_eq(first.push_git_receipt.success, true)
  assert_eq(first.remote_git_receipt.success, true)
  const remote = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/heads/${publication.remote_ref}"], heads: true},
  )
  assert_eq(remote.success, true)
  assert_eq(remote.data.refs[0].oid, publication.head_oid)
  const discovered = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/heads/release-attempt/v1.2.3/*"], heads: true},
  )
  assert_eq(discovered.success, true)
  assert_eq(len(discovered.data.refs), 1)
  assert_eq(
    release_recovery_source("1.2.3", [], discovered.data.refs, "")?.publication,
    publication,
  )
  const resumed = publish_release_publication(
    harness.process,
    {repo: f.work, mock: false},
    publication,
  )
  assert_eq(resumed.success, true)
  assert_eq(resumed.action, "resume")
  assert_eq(resumed.push_git_receipt, nil)
  assert_eq(resumed.remote_git_receipt.success, true)
  harness.fs.delete(f.root)
}

pipeline test_release_publication_pushes_captured_oid_when_local_head_advances(
  harness: Harness,
  task,
) {
  const f = fixture(harness)
  const captured_oid = head(harness.process, f.work)
  const publication = release_publication("1.2.3", captured_oid)
  harness.fs.write_text(path_join(f.work, "fixture.txt"), "advanced\n")
  sh(harness.process, "git -C '" + f.work + "' commit -q -am advanced")
  assert_ne(head(harness.process, f.work), captured_oid)
  const result = publish_release_publication(
    harness.process,
    {repo: f.work, mock: false},
    publication,
  )
  assert_eq(result.success, true)
  const remote = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/heads/${publication.remote_ref}"], heads: true},
  )
  assert_eq(remote.data.refs[0].oid, captured_oid)
  harness.fs.delete(f.root)
}

pipeline test_unsigned_remote_tag_is_not_a_verified_recovery_source(harness: Harness, task) {
  const f = fixture(harness)
  const repo_cfg: ReleaseRepoConfig = {repo: f.work, mock: false}
  const captured_oid = head(harness.process, f.work)
  const publication = release_publication("1.2.3", captured_oid)
  assert_eq(
    publish_release_publication(harness.process, {repo: f.work, mock: false}, publication).success,
    true,
  )
  sh(harness.process, "git -C '" + f.work + "' tag -a v1.2.3 -m release " + captured_oid)
  sh(harness.process, "git -C '" + f.work + "' push -q origin refs/tags/v1.2.3")
  sh(harness.process, "git -C '" + f.work + "' tag -d v1.2.3 >/dev/null")
  const refs = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/tags/v1.2.3", "refs/tags/v1.2.3^{}"]},
  )
  assert_eq(refs.success, true)
  assert_eq(remote_tag_target_sha(refs.data.refs), captured_oid)
  const attempts = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/heads/${publication.remote_ref}"], heads: true},
  )
  const recovery = release_recovery_source(
    "1.2.3",
    [],
    attempts.data.refs,
    remote_tag_target_sha(refs.data.refs),
  )
  assert_eq(recovery?.publication?.head_oid, captured_oid)
  const verification_error = try {
    verify_release_recovery_source(
      {env: harness.env, process: harness.process},
      repo_cfg,
      "v1.2.3",
      publication,
      refs.data.refs,
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(verification_error, "failed signature verification"), true)
  harness.fs.delete(f.root)
}

pipeline test_recovery_uses_repository_owned_release_tag_trust(harness: Harness, task) {
  const f = fixture(harness)
  const repo_cfg: ReleaseRepoConfig = {repo: f.work, mock: false}
  const captured_oid = head(harness.process, f.work)
  const publication = release_publication("1.2.3", captured_oid)
  assert_eq(
    publish_release_publication(harness.process, {repo: f.work, mock: false}, publication).success,
    true,
  )
  const key = path_join(f.root, "release-signing-key")
  const wrong_trust = path_join(f.root, "wrong-allowed-signers")
  sh(harness.process, "ssh-keygen -q -t ed25519 -N '' -f '" + key + "'")
  harness.fs.mkdir(path_join(f.work, ".github"), true)
  harness.fs.write_text(
    path_join(f.work, ".github", "release-bot-allowed-signers"),
    "harn-release-bot[bot]@users.noreply.github.com " + trim(harness.fs.read_text(key + ".pub"))
      + "\n",
  )
  harness.fs.write_text(wrong_trust, "")
  sh(harness.process, "git -C '" + f.work + "' config user.name 'harn-release-bot[bot]'")
  sh(
    harness.process,
    "git -C '" + f.work
      + "' config user.email 'harn-release-bot[bot]@users.noreply.github.com'",
  )
  sh(harness.process, "git -C '" + f.work + "' config gpg.format ssh")
  sh(harness.process, "git -C '" + f.work + "' config user.signingkey '" + key + "'")
  sh(
    harness.process,
    "git -C '" + f.work + "' config gpg.ssh.allowedSignersFile '" + wrong_trust + "'",
  )
  sh(harness.process, "git -C '" + f.work + "' tag -s v1.2.3 -m release " + captured_oid)
  const ambient = harness.process.shell("git -C '" + f.work + "' verify-tag --raw v1.2.3")
  assert_eq(ambient.success, false)
  sh(harness.process, "git -C '" + f.work + "' push -q origin refs/tags/v1.2.3")
  sh(
    harness.process,
    "git -C '" + f.work + "' push -q origin :refs/heads/" + publication.remote_ref,
  )
  sh(harness.process, "git -C '" + f.work + "' tag -d v1.2.3 >/dev/null")
  const refs = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/tags/v1.2.3", "refs/tags/v1.2.3^{}"]},
  )
  const recovery = release_recovery_source("1.2.3", [], [], remote_tag_target_sha(refs.data.refs))
  assert_eq(recovery?.publication, publication)
  const verified = verify_release_recovery_source(
    {env: harness.env, process: harness.process},
    repo_cfg,
    "v1.2.3",
    publication,
    refs.data.refs,
  )
  assert_eq(verified.immutable_ref, "refs/tags/v1.2.3")
  assert_ne(verified.tag_object_oid, "")
  harness.fs.delete(f.root)
}

pipeline test_release_publication_new_head_never_rewrites_prior_attempt(harness: Harness, task) {
  const f = fixture(harness)
  const first_publication = release_publication("1.2.3", head(harness.process, f.work))
  assert_eq(
    publish_release_publication(harness.process, {repo: f.work, mock: false}, first_publication)
      .success,
    true,
  )
  harness.fs.write_text(path_join(f.work, "fixture.txt"), "second\n")
  sh(harness.process, "git -C '" + f.work + "' commit -q -am second")
  const second_publication = release_publication("1.2.3", head(harness.process, f.work))
  assert_ne(second_publication.remote_ref, first_publication.remote_ref)
  assert_eq(
    publish_release_publication(harness.process, {repo: f.work, mock: false}, second_publication)
      .success,
    true,
  )
  const prior = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/heads/${first_publication.remote_ref}"], heads: true},
  )
  assert_eq(prior.data.refs[0].oid, first_publication.head_oid)
  harness.fs.delete(f.root)
}

pipeline test_release_publication_ref_mismatch_fails_before_any_mutation(harness: Harness, task) {
  const f = fixture(harness)
  const publication = release_publication("1.2.3", head(harness.process, f.work))
  harness.fs.write_text(path_join(f.work, "fixture.txt"), "conflicting\n")
  sh(harness.process, "git -C '" + f.work + "' commit -q -am conflicting")
  const conflicting_oid = head(harness.process, f.work)
  sh(harness.process, "git -C '" + f.work + "' push -q origin HEAD:refs/heads/scratch")
  sh(
    harness.process,
    "git --git-dir='" + f.origin + "' update-ref refs/heads/" + publication.remote_ref + " "
      + conflicting_oid,
  )
  const result = publish_release_publication(
    harness.process,
    {repo: f.work, mock: false},
    publication,
  )
  assert_eq(result.success, false)
  assert_eq(result.action, "fail")
  const remote = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/heads/${publication.remote_ref}"], heads: true},
  )
  assert_eq(remote.data.refs[0].oid, conflicting_oid)
  harness.fs.delete(f.root)
}

/**
 * A checkpoint validates with the release-gate tooling frozen in its own tree,
 * so a fix landing on `base` under one of those paths cannot reach it. This is
 * the v0.10.53 case: harn#6105 fixed scripts/release_audit_contract.harn, the
 * candidate's pin predated it, and two resumes failed identically.
 */
pipeline test_checkpoint_tooling_drift_surfaces_the_supersede_escape(harness: Harness, task) {
  const base_head = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const stale = release_checkpoint_tooling_drift(
    ["docs/readme.md", "scripts/release_audit_contract.harn"],
    base_head,
  )
  assert_eq(stale.stale, true)
  assert_eq(stale.paths, ["scripts/release_audit_contract.harn"])
  assert_eq(stale.supersede_pin, base_head)
  const advisory = release_checkpoint_supersede_advisory(stale)
  assert(advisory != nil)
  // The escape must name both the flag and the commit; discovering it
  // previously required reading three library files.
  assert(contains(advisory ?? "", "--at-sha ${base_head}"))
  assert(contains(advisory ?? "", "scripts/release_audit_contract.harn"))
  // The immutable audit ref is preserved by this route; say so, because the
  // obvious cleanup path (sweep_release_refs) correctly refuses to help.
  assert(contains(advisory ?? "", "preserved"))
  // Following this advice is what invalidates it: superseding mints a second
  // attempt, and if that run fails the version holds two, at which point the
  // same command form fails with `selected 0 immutable attempts`. That failure
  // lands at the *next* recovery, so the cost has to be stated here.
  assert(contains(advisory ?? "", "second immutable attempt"))
  assert(contains(advisory ?? "", "abandon_release_attempts.harn"))
}

/**
 * Surfacing the escape is not enough on its own. Run 30824705839 printed the
 * advisory, resumed anyway, and spent 40 minutes on a hosted runner reaching
 * the exact failure the advisory had predicted.
 */
pipeline test_stale_gate_tooling_refuses_the_resume_outright(harness: Harness, task) {
  const base_head = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const stale = release_checkpoint_tooling_drift(["scripts/release_gate.sh"], base_head)
  const block = release_checkpoint_resume_block(stale)
  assert(block != nil)
  assert(contains(block ?? "", "refusing to resume"))
  // The refusal has to carry the whole escape, because it is now the only
  // thing an operator sees before the run stops.
  assert(contains(block ?? "", "--at-sha ${base_head}"))
  assert(contains(block ?? "", "scripts/release_gate.sh"))
  assert(contains(block ?? "", "preserved"))
  // The refusal is the whole advisory, so it must carry the cost too — this is
  // the only screen an operator sees before the run stops.
  assert(contains(block ?? "", "second immutable attempt"))
}

/** A healthy checkpoint must still resume; this gate blocks releases when wrong. */
pipeline test_healthy_checkpoint_is_never_blocked(harness: Harness, task) {
  const base_head = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const clean = release_checkpoint_tooling_drift(["crates/harn-vm/src/lib.rs"], base_head)
  assert_eq(release_checkpoint_resume_block(clean), nil)
  // No recovered base head means no honest supersede target, so resuming is
  // still the only route available and must not be refused.
  const unknown_base = release_checkpoint_tooling_drift(["scripts/release_gate.sh"], "")
  assert_eq(release_checkpoint_resume_block(unknown_base), nil)
}

pipeline test_checkpoint_tooling_drift_stays_quiet_for_unrelated_change(harness: Harness, task) {
  const clean = release_checkpoint_tooling_drift(
    ["crates/harn-vm/src/lib.rs", "CHANGELOG.md"],
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  )
  assert_eq(clean.stale, false)
  assert_eq(clean.paths, [])
  assert_eq(release_checkpoint_supersede_advisory(clean), nil)
  // No base head recovered means no command we could honestly print.
  const unknown_base = release_checkpoint_tooling_drift(["scripts/release_gate.sh"], "")
  assert_eq(unknown_base.stale, true)
  assert_eq(release_checkpoint_supersede_advisory(unknown_base), nil)
}

pipeline test_checkpoint_tooling_drift_covers_every_gate_path(harness: Harness, task) {
  // Every declared gate path must be detected; a path added to the constant
  // without detection would silently reintroduce the forever-resume loop.
  for path in RELEASE_GATE_TOOLING_PATHS {
    const drift = release_checkpoint_tooling_drift(
      [path],
      "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    )
    assert_eq(drift.stale, true)
    assert_eq(drift.paths, [path])
  }
  // Substring lookalikes must not trip the gate.
  const lookalike = release_checkpoint_tooling_drift(
    ["scripts/release_gate.sh.bak", "tests/scripts/release_gate.sh"],
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  )
  assert_eq(lookalike.stale, false)
}

/**
 * The seam that source review cannot settle: whether the paths git actually
 * emits for a pin..base comparison are the repo-relative form the drift
 * matcher compares against. Run it against a real repository.
 */
pipeline test_gate_tooling_drift_matches_real_git_diff_paths(harness: Harness, task) {
  const f = fixture(harness)
  const pin = head(harness.process, f.work)
  sh(harness.process, "mkdir -p '" + path_join(f.work, "scripts") + "'")
  harness.fs.write_text(path_join(f.work, "scripts/release_gate.sh"), "#!/bin/sh\nexit 0\n")
  harness.fs.write_text(path_join(f.work, "unrelated.txt"), "noise\n")
  sh(
    harness.process,
    "git -C '" + f.work + "' add -A && git -C '" + f.work + "' commit -q -m gatefix",
  )
  const base_head = head(harness.process, f.work)
  // Exactly the command detect_fixup_state issues during recovery.
  const changed = sh(
    harness.process,
    "git -C '" + f.work + "' diff --name-only " + pin + " " + base_head,
  )
  const drift = release_checkpoint_tooling_drift(split(trim(changed.stdout), "\n"), base_head)
  assert_eq(drift.stale, true)
  assert_eq(drift.paths, ["scripts/release_gate.sh"])
  assert_eq(drift.supersede_pin, base_head)
  assert(contains(release_checkpoint_supersede_advisory(drift) ?? "", "--at-sha ${base_head}"))
  // A pin that already contains the fix must stay quiet.
  const settled = sh(
    harness.process,
    "git -C '" + f.work + "' diff --name-only " + base_head + " " + base_head,
  )
  const no_drift = release_checkpoint_tooling_drift(split(trim(settled.stdout), "\n"), base_head)
  assert_eq(no_drift.stale, false)
  assert_eq(release_checkpoint_supersede_advisory(no_drift), nil)
  harness.fs.delete(f.root)
}
