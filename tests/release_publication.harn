pipeline test_tagged_fixup_pr_is_partitioned_from_immutable_recovery(task) {
  const tag_oid = "0123456789abcdef0123456789abcdef01234567"
  const attempt_oid = "fedcba9876543210fedcba9876543210fedcba98"
  const fixup = {
    number: 4,
    url: "https://example.test/pull/4",
    head: {ref: "release/v1.2.3", sha: tag_oid},
  }
  const attempt = {
    number: 5,
    url: "https://example.test/pull/5",
    head: {ref: "release-attempt/v1.2.3/${attempt_oid}", sha: attempt_oid},
  }
  const partition = release_recovery_pull_requests("1.2.3", [fixup, attempt], tag_oid)
  assert_eq(partition.tagged_fixup, fixup)
  assert_eq(partition.immutable_attempts, [attempt])
  const duplicate_probe = release_recovery_pull_requests("1.2.3", [fixup, fixup], tag_oid)
  assert_eq(duplicate_probe.tagged_fixup, fixup)
  const pre_tag_error = try {
    release_recovery_pull_requests("1.2.3", [fixup], "")
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(pre_tag_error, "before a signed tag selects an immutable attempt"), true)
  const malformed_tag_error = try {
    release_recovery_pull_requests("1.2.3", [fixup], "not-an-oid")
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(malformed_tag_error, "full 40-hex OID"), true)
}

pipeline test_release_attempt_discovery_requires_one_exact_ref_and_head(task) {
  const oid = "0123456789abcdef0123456789abcdef01234567"
  const publication = release_publication("1.2.3", oid)
  const pull_request = {
    number: 7,
    url: "https://example.test/pull/7",
    head: {ref: publication.remote_ref, sha: oid},
  }
  const attempt = release_attempt_for_version("1.2.3", [pull_request])
  assert_eq(attempt.publication, publication)
  assert_eq(attempt.pull_request, pull_request)
  assert_eq(release_attempt_for_version("1.2.4", [pull_request]), nil)
  assert_eq(release_publication_pr_decision(publication, pull_request).action, "accept")
  assert_eq(
    release_publication_pr_decision(
      publication,
      pull_request + {head: pull_request.head + {sha: "fedcba9876543210fedcba9876543210fedcba98"}},
    ).action,
    "fail",
  )
}

pipeline test_release_attempt_discovery_fails_loud_on_drift_or_ambiguity(task) {
  const first_oid = "0123456789abcdef0123456789abcdef01234567"
  const second_oid = "fedcba9876543210fedcba9876543210fedcba98"
  const first = {
    number: 7,
    url: "https://example.test/pull/7",
    head: {ref: "release-attempt/v1.2.3/${first_oid}", sha: first_oid},
  }
  const second = {
    number: 8,
    url: "https://example.test/pull/8",
    head: {ref: "release-attempt/v1.2.3/${second_oid}", sha: second_oid},
  }
  const drift_error = try {
    release_attempt_for_version("1.2.3", [first + {head: first.head + {sha: second_oid}}])
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(drift_error, "does not match immutable ref"), true)
  const malformed_error = try {
    release_attempt_for_version(
      "1.2.3",
      [
        {
          number: 9,
          url: "https://example.test/pull/9",
          head: {ref: "release-attempt/v1.2.3/not-an-oid", sha: first_oid},
        },
      ],
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(malformed_error, "full 40-hex OID"), true)
  const ambiguous_error = try {
    release_attempt_for_version("1.2.3", [first, second])
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(ambiguous_error, "multiple open immutable release attempts"), true)
}

pipeline test_release_recovery_source_handles_tag_only_crash_and_reconciles_pr(task) {
  const oid = "0123456789abcdef0123456789abcdef01234567"
  const publication = release_publication("1.2.3", oid)
  const pull_request = {
    number: 7,
    url: "https://example.test/pull/7",
    head: {ref: publication.remote_ref, sha: oid},
  }
  const remote_refs = [remote_attempt_ref(publication)]
  const pre_tag_crash = release_recovery_source("1.2.3", [], remote_refs, "")
  assert_eq(pre_tag_crash?.publication, publication)
  assert_eq(pre_tag_crash?.pull_request, nil)
  const tag_only = release_recovery_source("1.2.3", [], remote_refs, oid)
  assert_eq(tag_only?.publication, publication)
  assert_eq(tag_only?.pull_request, nil)
  const reconciled = release_recovery_source("1.2.3", [pull_request], remote_refs, oid)
  assert_eq(reconciled?.publication, publication)
  assert_eq(reconciled?.pull_request, pull_request)
  const mismatch = try {
    release_recovery_source(
      "1.2.3",
      [pull_request],
      remote_refs,
      "fedcba9876543210fedcba9876543210fedcba98",
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert_eq(contains(mismatch, "but open immutable attempt"), true)
}

pipeline test_release_recovery_source_uses_exact_tag_after_attempt_cleanup(task) {
