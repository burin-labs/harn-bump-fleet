pipeline test_pre_tag_resume_preserves_explicit_release_pin(harness: Harness, task) {
  const requested = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const stale = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let cfg = parse_release_args(harness.env, ["--at-sha", requested])
  cfg["pin_sha"] = requested
  const resumed = with_fixup_state(
    cfg,
    {
      publication: release_publication("1.2.3", "cccccccccccccccccccccccccccccccccccccccc"),
      tag: "v1.2.3",
      pr_url: "",
      original_pin: stale,
      pin_unreleased: "## Unreleased\n",
      release_body_source: "attempt-release-section",
      tag_exists: false,
      release_exists: false,
      missing_assets: [],
      conflicting: false,
      pre_tag_resume: true,
    },
  )
  assert_eq(resumed.pin_sha, requested)
  assert_eq(resumed.release_notes_scope, "immutable_checkpoint")
  const rejected = release_recovery_pin_decision(requested, requested, stale)
  assert_eq(rejected.compatible, false)
  assert_eq(rejected.effective_pin, requested)
  const automatic = release_recovery_pin_decision("", requested, stale)
  assert_eq(automatic.compatible, true)
  assert_eq(automatic.effective_pin, stale)
  assert_eq(release_recovery_checkpoint_route(true, rejected), "supersede_pre_tag")
  assert_eq(release_recovery_checkpoint_route(true, automatic), "resume_pre_tag")
  assert_eq(release_recovery_checkpoint_route(false, rejected), "repair")
  const superseded = with_fixup_state(
    cfg,
    {
      publication: release_publication("1.2.3", "cccccccccccccccccccccccccccccccccccccccc"),
      tag: "v1.2.3",
      pr_url: "",
      original_pin: stale,
      pin_unreleased: "## Unreleased\n",
      release_body_source: "attempt-release-section",
      tag_exists: false,
      release_exists: false,
      missing_assets: [],
      conflicting: false,
      pre_tag_resume: false,
      pre_tag_supersede: true,
    },
  )
  assert_eq(superseded.pin_sha, requested)
  assert_eq(superseded.fixup_mode, true)
  assert_eq(superseded.pre_tag_resume, false)
  assert_eq(superseded.pre_tag_supersede, true)
  assert_eq(superseded.release_notes_scope, "candidate_tree")
}

