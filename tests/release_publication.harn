import {
  release_publication,
  release_publications_from_remote_refs,
} from "../lib/release_publication"

pipeline test_release_publication_preserves_prerelease_identity(task: any) {
  const oid = "0123456789abcdef0123456789abcdef01234567"
  const publication = release_publication("1.2.4-rc.10", oid)
  assert_eq(publication.local_branch, "release/v1.2.4-rc.10")
  assert_eq(publication.remote_ref, "release-attempt/v1.2.4-rc.10/${oid}")
}

pipeline test_remote_attempt_identity_requires_the_ref_to_match_its_object(task: any) {
  const oid = "0123456789abcdef0123456789abcdef01234567"
  const publication = release_publication("1.2.3", oid)
  const ref = {
    oid: oid,
    ref: "refs/heads/${publication.remote_ref}",
    name: "refs/heads/${publication.remote_ref}",
    peeled: false,
  }
  assert_eq(release_publications_from_remote_refs("1.2.3", [ref]), [publication])
  assert_eq(release_publications_from_remote_refs("1.2.4", [ref]), [])
  for invalid in [
    ref + {oid: "fedcba9876543210fedcba9876543210fedcba98"},
    ref + {peeled: true},
    ref + {ref: "refs/heads/release-attempt/v1.2.3/not-an-oid"},
  ] {
    assert(
      is_err(
        try {
          release_publications_from_remote_refs("1.2.3", [invalid])
        },
      ),
    )
  }
}
