}

pipeline test_only_bare_immutable_attempt_resumes_pre_tag_checkpoint(task) {
  assert_eq(release_recovery_is_pre_tag_resume(false, ""), true)
  assert_eq(release_recovery_is_pre_tag_resume(true, ""), false)
  assert_eq(release_recovery_is_pre_tag_resume(false, "https://example.test/pull/7"), false)
