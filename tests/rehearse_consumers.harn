import { consumer_pretag_gate_verdict } from "../lib/consumer_pretag_gate"
import {
  certified_consumer_slugs,
  parse_rehearsal_args,
  rehearsal_version_from_workspace,
} from "../rehearse_consumers.harn"

/**
 * The rehearsal must be run under the identity the next release will carry.
 *
 * `0.10.134-dev` on the default branch means the next cut is `v0.10.134`, and
 * that is the version the consumer gates will be handed for real. A rehearsal
 * dispatched under any other label exercises an input no release sends, so its
 * green would say nothing about the release it stands in for.
 */
pipeline test_the_development_workspace_names_the_version_the_next_release_will_carry() {
  assert_eq(
    rehearsal_version_from_workspace("[workspace.package]\nversion = \"0.10.134-dev\"\n"),
    "v0.10.134",
  )
}

/**
 * A default branch mid-release has nothing to rehearse.
 *
 * Between the tag and the fold the workspace names a version that is already
 * published. Returning it would rehearse consumers against a release that has
 * shipped, so this refuses instead and the run reports why.
 */
pipeline test_a_workspace_without_dev_has_no_next_version_to_rehearse() {
  assert_eq(rehearsal_version_from_workspace("version = \"0.10.133\"\n"), nil)
}

/**
 * The negative controls for the parse.
 *
 * A manifest this cannot read must not yield a version, because the caller
 * turns a version into a dispatch. An empty answer here becomes a refusal
 * upstream; a wrong one becomes 32 consumer builds under a bad identity.
 */
pipeline test_an_unreadable_manifest_yields_no_version_rather_than_a_guess() {
  assert_eq(rehearsal_version_from_workspace(""), nil)
  assert_eq(rehearsal_version_from_workspace("name = \"harn\"\n"), nil)
  assert_eq(rehearsal_version_from_workspace("version = \"-dev\"\n"), nil)
  assert_eq(rehearsal_version_from_workspace("version = \"0.10-dev\"\n"), nil)
  assert_eq(rehearsal_version_from_workspace("version = \"not.a.version-dev\"\n"), nil)
}

/** `--only` has to arrive as a value, because it decides how many consumers are asked. */
pipeline test_the_only_flag_parses_to_the_slug_it_was_given() {
  assert_eq(parse_rehearsal_args(["--only", "burin-labs/harn-cloud"]).only, "burin-labs/harn-cloud")
  assert_eq(parse_rehearsal_args([]).only, nil)
  assert_eq(parse_rehearsal_args([]).mock, false)
  assert_eq(parse_rehearsal_args(["--mock"]).mock, true)
}

/**
 * Proofs follow the gate verdict, in the shape the verdict actually writes.
 *
 * `consumer_pretag_gate_verdict` names each consumer `slug:workflow`, and a
 * reader that compared those whole against a slug would match nothing and
 * record nothing, forever, while the tick still reported success and re-gated
 * the entire fleet every hour. So this fixture is the verdict's own shape
 * rather than an invented one.
 */
pipeline test_proofs_are_recorded_per_consumer_from_the_verdicts_own_shape() {
  const verdict = consumer_pretag_gate_verdict(
    [],
    [
      {
        slug: "burin-labs/harn-cloud",
        workflow: "harn-pin-gate.yml",
        status: "passed",
        run_url: "",
        detail: "",
      },
      {
        slug: "burin-labs/burin-code",
        workflow: "harn-pin.yml",
        status: "passed",
        run_url: "",
        detail: "",
      },
      {
        slug: "burin-labs/harn-documents",
        workflow: "harn-pin.yml",
        status: "failed",
        run_url: "",
        detail: "drifted",
      },
    ],
  )
  assert_eq(
    certified_consumer_slugs([{name: "consumer-pretag-gate", consumer_pretag_verdict: verdict}]),
    ["burin-labs/harn-cloud", "burin-labs/burin-code"],
  )
}

/** A mock run dispatches nothing, so it must record nothing. */
pipeline test_a_step_without_a_gate_verdict_records_no_proof() {
  assert_eq(certified_consumer_slugs([{name: "consumer-pretag-gate"}]), [])
  assert_eq(certified_consumer_slugs([]), [])
}
