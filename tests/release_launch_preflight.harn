  RELEASE_CREDENTIAL_REFRESH_INTERVAL_S,
  release_phase_budget_drift,
  release_phases_outliving_credential,
} from "../lib/release_phase_budgets"

fn launch_inputs(
  overrides: {mode?: string, bump?: string, at_sha?: string, preid?: string} = {},
) -> ReleaseLaunchInputs {
  return {
    mode: overrides.mode ?? "ship-pr",
    bump: overrides.bump ?? "patch",
    prerelease_identifier: overrides.preid ?? "",
    at_sha: overrides.at_sha ?? "",
    repositories_json: "",
    skip_consumers: "",
    consumer_proof_runs_json: "",
  }
}

fn status_of(checks: list<any>, name: string) -> string {
  const check = checks.find({ entry -> return entry.name == name })
  return if check == nil {
    "absent"
  } else {
    to_string(check?.status ?? "absent")
  }
}

fn detail_of(checks: list<any>, name: string) -> string {
  return to_string(checks.find({ entry -> return entry.name == name })?.detail ?? "")
}

pipeline test_a_full_release_input_tuple_passes_every_shape_check(task: any) {
  const checks = release_input_preconditions(
    launch_inputs({at_sha: "0123456789abcdef0123456789abcdef01234567"}),
  )
  assert_eq(status_of(checks, "inputs.mode"), "pass")
  assert_eq(status_of(checks, "inputs.bump"), "pass")
  assert_eq(status_of(checks, "inputs.shape"), "pass")
}

pipeline test_an_unresolved_pin_is_withheld_from_the_delegated_validator(task: any) {
  // A short pin is answered by its own two preconditions and widened before
  // anything downstream sees it, so the delegated validator -- whose rule is
  // that the release receives forty characters -- is handed nothing rather
  // than the same shortfall under a second name.
  const short = release_input_preconditions(launch_inputs({at_sha: "548d304"}))
  assert_eq(status_of(short, "inputs.shape"), "pass")
  // The resolved commit is what it does validate, and it validates cleanly.
  const resolved = release_input_preconditions(
    launch_inputs({at_sha: "548d304c21c5ce0ebab4186fc826914258815339"}),
  )
  assert_eq(status_of(resolved, "inputs.shape"), "pass")
}

pipeline test_an_unknown_mode_leaves_the_delegated_shape_check_unasked_not_passed(task: any) {
  const checks = release_input_preconditions(launch_inputs({mode: "shipit"}))
  assert_eq(status_of(checks, "inputs.mode"), "fail")
  // The delegated validator cannot represent this mode, so it was not asked.
  // Reporting that as a pass is the failure this whole preflight exists to
  // remove.
  assert_eq(status_of(checks, "inputs.shape"), "unavailable")
}

pipeline test_a_prerelease_bump_without_an_identifier_fails_the_shape_check(task: any) {
  const checks = release_input_preconditions(launch_inputs({bump: "prerelease"}))
  assert_eq(status_of(checks, "inputs.shape"), "fail")
  assert(contains(detail_of(checks, "inputs.shape"), "prerelease identifier"))
}

pipeline test_a_mint_missing_a_permission_fails_and_names_it(task: any) {
  // burin-labs/harn-bump-fleet#1234: the installation held `workflows: write`
  // and the mint did not, so the certify push was refused 30 seconds in.
  const check = token_permission_precondition(
    "harn-release",
    {actions: "write", contents: "write", pull_requests: "write", workflows: "write"},
    {actions: "write", contents: "write", pull_requests: "write"},
  )
  assert_eq(check.status, "fail")
  assert(contains(check.detail, "workflows (want write, not granted)"), check.detail)
  assert(contains(check.remedy, "spec/github-app-token-profiles.json"))
}

pipeline test_a_mint_granting_a_weaker_level_than_requested_fails(task: any) {
  const check = token_permission_precondition(
    "harn-release",
    {contents: "write"},
    {contents: "read"},
  )
  assert_eq(check.status, "fail")
  assert(contains(check.detail, "granted read"), check.detail)
}

pipeline test_a_complete_mint_passes(task: any) {
  const grants = {actions: "write", contents: "write", workflows: "write"}
  assert_eq(token_permission_precondition("harn-release", grants, grants).status, "pass")
}

pipeline test_a_refresher_armed_for_ship_pr_only_fails_a_prepare_launch(task: any) {
  // burin-labs/harn-bump-fleet#1235: `prepare` spent 51 minutes in the linked
  // suite and died on a 401 at 65 minutes, because the refresher was armed for
  // ship-pr on the theory that prepare was short.
  const check = credential_refresh_precondition(
    "prepare",
    RELEASE_CREDENTIAL_LIFETIME_S,
    RELEASE_CREDENTIAL_REFRESH_INTERVAL_S,
    ["ship-pr"],
  )
  assert_eq(check.status, "fail")
  assert(contains(check.detail, "release_job"), check.detail)
  assert(contains(check.detail, "not armed for this mode"), check.detail)
}

pipeline test_a_refresher_armed_in_every_mode_passes_a_prepare_launch(task: any) {
  const check = credential_refresh_precondition(
    "prepare",
    RELEASE_CREDENTIAL_LIFETIME_S,
    RELEASE_CREDENTIAL_REFRESH_INTERVAL_S,
    ["audit", "prepare", "ship-pr"],
  )
  assert_eq(check.status, "pass")
}

pipeline test_a_refresh_interval_without_headroom_fails_however_it_is_armed(task: any) {
  const check = credential_refresh_precondition(
    "ship-pr",
    RELEASE_CREDENTIAL_LIFETIME_S,
    3500,
    ["audit", "prepare", "ship-pr"],
  )
  assert_eq(check.status, "fail")
  assert(contains(check.detail, "headroom"), check.detail)
}

pipeline test_a_mint_shorter_than_the_refresh_interval_fails_however_it_is_armed(task: any) {
  // The structural half reasons from a declared one-hour ceiling. This is what
  // keeps that constant honest against what GitHub actually hands back.
  const short = token_lifetime_precondition(900, RELEASE_CREDENTIAL_LIFETIME_S, 2400)
  assert_eq(short.status, "fail")
  assert(contains(short.detail, "under the 3000s"), short.detail)
  const ample = token_lifetime_precondition(
    RELEASE_CREDENTIAL_LIFETIME_S,
    RELEASE_CREDENTIAL_LIFETIME_S,
    2400,
  )
  assert_eq(ample.status, "pass")
}

pipeline test_every_release_mode_reaches_a_phase_that_outlives_one_mint(task: any) {
  // The registry's whole point: no mode is short enough to skip the refresher.
  for mode in ["audit", "prepare", "ship-pr"] {
    assert(
      len(release_phases_outliving_credential(mode, RELEASE_CREDENTIAL_LIFETIME_S)) > 0,
      "${mode} was treated as short enough to outrun a mint",
    )
  }
}

pipeline test_a_phase_budget_that_no_longer_matches_its_workflow_ceiling_is_reported(task: any) {
  const drift = release_phase_budget_drift(
    {
      ".github/workflows/hosted-release.yml#release": 200,
      ".github/workflows/hosted-release.yml#fleet": 210,
      ".github/workflows/fleet-projection-convergence.yml#converge": 30,
    },
  )
  assert_eq(len(drift), 1)
  assert(contains(drift[0] ?? "", "release_job"), drift[0] ?? "")
}

pipeline test_a_phase_whose_job_declares_no_ceiling_is_reported_not_skipped(task: any) {
  // An unmeasured row and a matching row must not read the same.
  const drift = release_phase_budget_drift({})
  assert_eq(len(drift), 3)
  assert(contains(drift[0] ?? "", "declares no timeout-minutes"), drift[0] ?? "")
}

pipeline test_a_workflow_mint_missing_a_permission_input_fails(task: any) {
  const check = workflow_mint_precondition(
    ".github/workflows/hosted-release.yml",
    "Mint scoped release token",
    "harn-release",
    {contents: "write", pull_requests: "write", workflows: "write"},
