pipeline test_a_missing_workflow_mint_step_fails_rather_than_passing_vacuously(task: any) {
  const check = workflow_mint_precondition(
    ".github/workflows/hosted-release.yml",
    "Mint scoped release token",
    "harn-release",
    {contents: "write"},
    nil,
  )
  assert_eq(check.status, "fail")
  assert(contains(check.detail, "no step named"), check.detail)
}

pipeline test_a_drifted_consumer_digest_names_the_convergence_workflow_to_dispatch(task: any) {
  // A renderer change lands here, and until the convergence run re-renders the
  // consumers their contract digests do not match. That drift refused a live
  // ship-pr at the publication gate. The answer an operator needs is not the
  // digest; it is which workflow repairs it.
  const check = consumer_contract_precondition(
    false,
    [
      "consumer contract projection drift: .github/workflows/harn-update.yml digest "
        + "aaaa does not match generated adapter digest bbbb",
    ],
  )
  assert_eq(check.status, "fail")
  assert(contains(check.detail, "does not match generated adapter digest"), check.detail)
  assert(contains(check.remedy, "fleet-projection-convergence.yml"), check.remedy)
  assert(contains(check.remedy, "apply=true"), check.remedy)
}

pipeline test_matching_consumer_contracts_pass(task: any) {
  assert_eq(consumer_contract_precondition(true, []).status, "pass")
}

pipeline test_a_receipt_separates_a_clean_read_from_a_partial_one(task: any) {
  const inputs = launch_inputs()
  const complete = release_launch_preflight_receipt(
    inputs,
    "harn-release",
    [consumer_contract_precondition(true, [])],
  )
  assert_eq(complete.ok, true)
  assert_eq(complete.complete, true)
  const partial = release_launch_preflight_receipt(
    inputs,
    "harn-release",
    release_input_preconditions(launch_inputs({mode: "shipit"})),
  )
  // A context that could not ask every question is never reported as a clean
  // read, even when nothing it did ask came back bad.
  assert_eq(partial.ok, false)
  assert_eq(partial.complete, false)
  assert(contains(partial.unavailable, "inputs.shape"))
  assert(contains(join(release_launch_preflight_lines(partial), "\n"), "NOT ASKED"))
}

pipeline test_the_checked_in_workflow_mint_matches_the_checked_in_profile(harness: Harness) {
  // The live pairing, not a fixture. A workflow step or a profile edited alone
  // fails here, which is the drift that cost the certify push.
  const root = release_harness_root(harness.fs)
  const registry = json_parse(
    harness.fs.read_text(path_join(root, "spec", "github-app-token-profiles.json")),
  )
  const workflows = yaml_parse(
    harness.fs.read_text(path_join(root, ".github", "workflows", "hosted-release.yml")),
  )
  const bindings = registry?.get("workflow_mints") ?? []
  assert(len(bindings) > 0, "the registry binds no workflow mint step")
  for binding in bindings {
    const steps = workflows?.get("jobs")?.get(binding.job)?.get("steps") ?? []
    const step = steps.find({ entry -> return entry?.get("name") == binding.step })
    const permissions = registry?.get("profiles")?.get(binding.profile)?.get("permissions") ?? {}
    const check = workflow_mint_precondition(
      binding.workflow,
      binding.step,
      binding.profile,
      permissions,
      if step == nil {
        nil
      } else {
        step?.get("with") ?? {}
      },
    )
    assert_eq(check.status, "pass", check.detail)
  }
}

pipeline test_the_registry_and_the_node_minter_agree_on_every_profile(harness: Harness) {
  const root = release_harness_root(harness.fs)
  const result = harness.process.run(
    {
      program: "node",
      args: [
        "-e",
        "import(\"./scripts/github_app_token_profiles.mjs\").then((m) => console.log("
          + "JSON.stringify(m.tokenProfileNames().map((n) => [n, m.tokenProfilePermissions(n)]))))",
      ],
      cwd: root,
    },
  )
  assert((result.exit_code ?? 1) == 0, to_string(result.stderr ?? ""))
  const registry = json_parse(
    harness.fs.read_text(path_join(root, "spec", "github-app-token-profiles.json")),
  )
  const profiles = registry?.get("profiles") ?? {}
  for entry in json_parse(trim(result.stdout ?? "")) {
    assert_eq(entry[1], profiles.get(entry[0])?.get("permissions"))
  }
}

/**
 * One recorded `--describe` response, of the shape GitHub's installation token
 * endpoint returns and `scripts/mint_github_app_installation_token.mjs` prints.
 */
fn recorded_mint(permissions: string, lifetime_s: string) -> any {
  return json_parse(
    "{\"schema_version\": \"harn_bump_fleet.installation_token_description.v1\","
      + " \"profile\": \"harn-release\", \"granted_permissions\": ${permissions},"
      + " \"repository_selection\": \"selected\", \"repositories\": [\"harn\"],"
      + " \"expires_at\": \"2026-09-07T21:00:00Z\", \"lifetime_s\": ${lifetime_s}}",
  )
}

pipeline test_a_recorded_mint_response_reads_into_its_two_preconditions(task: any) {
  // The decode seam runs against a recorded response here rather than being
  // exercised for the first time on a live cut.
  const requested = {contents: "write", workflows: "write"}
  const good = token_description_preconditions(
    "harn-release",
    requested,
    recorded_mint("{\"contents\": \"write\", \"workflows\": \"write\"}", "3600"),
    3600,
    2400,
  )
  assert_eq(len(good), 2)
  assert_eq(status_of(good, "token.permissions"), "pass")
  assert_eq(status_of(good, "token.lifetime"), "pass")
  // The narrowed mint that refused the certification push.
  const narrowed = token_description_preconditions(
    "harn-release",
    requested,
    recorded_mint("{\"contents\": \"write\"}", "3600"),
    3600,
    2400,
  )
  assert_eq(status_of(narrowed, "token.permissions"), "fail")
  assert(contains(detail_of(narrowed, "token.permissions"), "workflows"))
}

pipeline test_a_mint_response_without_an_expiry_fails_rather_than_defaulting(task: any) {
  const checks = token_description_preconditions(
    "harn-release",
    {contents: "write"},
    json_parse("{\"granted_permissions\": {\"contents\": \"write\"}}"),
    3600,
    2400,
  )
  assert_eq(status_of(checks, "token.lifetime"), "fail")
  assert(contains(detail_of(checks, "token.lifetime"), "no expiry"))
}

pipeline test_a_short_at_sha_passes_syntax_and_is_widened_before_anything_downstream(task: any) {
  // The live refusal was a ten-character pin. It is a legitimate thing to
  // type; what was missing was the widening, not the validation.
  const checks = at_sha_preconditions(
    {
      requested: "548d304c21",
      resolved: "548d304c21c5ce0ebab4186fc826914258815339",
      asked: true,
      reason: "",
    },
  )
  assert_eq(status_of(checks, "inputs.at_sha"), "pass")
  assert_eq(status_of(checks, "inputs.at_sha_resolved"), "pass")
  assert(
    contains(
      detail_of(checks, "inputs.at_sha_resolved"),
      "548d304c21c5ce0ebab4186fc826914258815339",
    ),
  )
}

pipeline test_a_commit_that_does_not_exist_stops_in_the_preflight(task: any) {
  const checks = at_sha_preconditions(
    {
      requested: "deadbeefcafe",
      resolved: "",
      asked: true,
      reason: "burin-labs/harn has no commit deadbeefcafe",
    },
  )
  assert_eq(status_of(checks, "inputs.at_sha"), "pass")
  assert_eq(status_of(checks, "inputs.at_sha_resolved"), "fail")
  assert(contains(detail_of(checks, "inputs.at_sha_resolved"), "no commit"))
}

pipeline test_a_branch_name_is_not_a_commit_prefix(task: any) {
  // `--at-sha main` would otherwise become whatever main was at that instant,
  // which is the unpinned cut the input exists to remove.
  assert_eq(github_commit_prefix_is_well_formed("main"), false)
  assert_eq(github_commit_prefix_is_well_formed("548d30"), false)
  assert_eq(github_commit_prefix_is_well_formed("548d304"), true)
  // Case is normalized rather than refused; what is handed on is lowercase.
  assert_eq(github_commit_prefix_is_well_formed("548D304C21"), true)
  const checks = at_sha_preconditions(
    {requested: "main", resolved: "", asked: false, reason: "nothing to resolve"},
  )
  assert_eq(status_of(checks, "inputs.at_sha"), "fail")
  // Not asked, not passed: the resolver was never given this string.
  assert_eq(status_of(checks, "inputs.at_sha_resolved"), "unavailable")
}

pipeline test_an_unresolvable_context_reports_a_short_pin_unasked_not_resolved(task: any) {
  const checks = at_sha_preconditions(
    {requested: "548d304c21", resolved: "", asked: false, reason: "--offline"},
  )
  assert_eq(status_of(checks, "inputs.at_sha"), "pass")
  assert_eq(status_of(checks, "inputs.at_sha_resolved"), "unavailable")
  assert(contains(detail_of(checks, "inputs.at_sha_resolved"), "forty characters"))
}

pipeline test_a_full_at_sha_needs_no_resolution_and_a_blank_one_has_nothing_to_resolve(task: any) {
  const full = at_sha_preconditions(
    {
      requested: "548d304c21c5ce0ebab4186fc826914258815339",
      resolved: "",
      asked: false,
      reason: "nothing to resolve",
    },
  )
  assert_eq(status_of(full, "inputs.at_sha_resolved"), "pass")
  assert(contains(detail_of(full, "inputs.at_sha_resolved"), "already the full commit"))
  const blank = at_sha_preconditions(
    {requested: "", resolved: "", asked: false, reason: "nothing to resolve"},
  )
  assert_eq(status_of(blank, "inputs.at_sha"), "pass")
  assert_eq(status_of(blank, "inputs.at_sha_resolved"), "pass")
}

pipeline test_an_ambiguous_prefix_is_refused_rather_than_widened_to_the_wrong_commit(task: any) {
  // GitHub answering a prefix with a commit that does not extend it is the
  // shape of an ambiguous abbreviation; adopting it would pin the wrong tree.
  const checks = at_sha_preconditions(
    {
      requested: "548d304c21",
      resolved: "",
      asked: true,
      reason: "burin-labs/harn resolved 548d304c21 to ffffffff..., which does not extend it",
    },
  )
  assert_eq(status_of(checks, "inputs.at_sha_resolved"), "fail")
  assert(contains(detail_of(checks, "inputs.at_sha_resolved"), "does not extend it"))
}

pipeline test_only_a_full_commit_id_is_exact(task: any) {
  // What a provider answers with has to be one whole commit before this fleet
  // adopts it as a pin. A prefix is what an operator may type; it is not what
  // any step after the dispatch accepts.
  assert_eq(github_commit_id_is_exact("548d304c21e4dbf5a4d0b2f4c9e0a17c3b8d6e91"), true)
  assert_eq(github_commit_id_is_exact("  548D304C21E4DBF5A4D0B2F4C9E0A17C3B8D6E91  "), true)
  assert_eq(github_commit_id_is_exact("548d304c21"), false)
  assert_eq(github_commit_id_is_exact("548d304c21e4dbf5a4d0b2f4c9e0a17c3b8d6e912"), false)
  assert_eq(github_commit_id_is_exact("main"), false)
  assert_eq(github_commit_id_is_exact(""), false)
}

pipeline test_the_refresh_interval_is_read_from_the_step_the_workflow_runs(task: any) {
  // The declared interval and the one the workflow sleeps are two facts, and
  // comparing them is the whole point of the lifetime precondition. A step
  // naming no interval must not report a plausible default.
  assert_eq(
    hosted_release_refresh_interval_s(
      "set -euo pipefail\n(\n  while true; do\n    sleep 2400\n    ./refresh.sh\n  done\n) &\n",
    ),
    2400,
  )
  assert_eq(hosted_release_refresh_interval_s("./refresh.sh\n"), nil)
  assert_eq(hosted_release_refresh_interval_s("echo \"sleep 2400 is what we do\"\n"), nil)
}

pipeline test_a_changelog_fragment_is_decided_by_its_name(task: any) {
  // The `changelog.d/` directory legitimately holds infrastructure files. The
  // naming convention is the one owner of which entries are release notes
  // waiting to be folded, so a count that classified by anything else would
  // refuse a tag over a lint config.
  assert_eq(is_release_changelog_fragment_name("8060.fixed.md"), true)
  assert_eq(is_release_changelog_fragment_name("7766-runner.fixed.md"), true)
  assert_eq(is_release_changelog_fragment_name(".gitkeep"), false)
  assert_eq(is_release_changelog_fragment_name(".markdownlint-cli2.jsonc"), false)
  assert_eq(is_release_changelog_fragment_name("README.md"), false)
  assert_eq(is_release_changelog_fragment_name("8060.invented.md"), false)
  assert_eq(is_release_changelog_fragment_name("8060.fixed.txt"), false)
}

pipeline test_a_raw_file_read_refuses_an_incomplete_request(harness: Harness) {
  // The raw route exists for files the typed connector cannot return. It still
  // has to refuse a request that names no ref rather than shell out and let
  // the adapter pick a default branch nobody asked for.
  const missing_ref = github_large_file_text_at_ref(harness.process, "burin-labs/harn", "F.md", "")
  assert_eq(is_err(missing_ref), true)
  assert_eq(unwrap_err(missing_ref).code, "invalid_file_lookup")
}
