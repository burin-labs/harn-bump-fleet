import { shell_quote } from "std/runtime"

fn test_path(bin) {
  return shell_quote(bin + ":/usr/bin:/bin:/usr/sbin:/sbin")
}

fn wait_harn_release_ready_script() {
  return path_join(dirname(cwd()), "scripts", "wait_harn_release_ready.sh")
}

pipeline test_wait_harn_release_ready_requires_checksum_sidecar(task) {
  const root = path_join(harness.fs.temp_dir(), "wait-harn-release-ready-" + uuid_v7())
  const bin = path_join(root, "bin")
  harness.fs.mkdir(bin, true)
  harness.fs.write_text(
    path_join(bin, "curl"),
    "#!/bin/sh\ncase \"$*\" in *crates.io/api/v1/crates/harn-cli/1.2.3*) exit 0;; *) exit 22;; esac\n",
  )
  harness.fs.write_text(
    path_join(bin, "gh"),
    "#!/bin/sh\ncase \"$*\" in\n  *isPrerelease*) printf '%s\\n' false;;\n  *) printf '%s\\n' 'harn-x86_64-unknown-linux-gnu.tar.gz';;\nesac\n",
  )
  harness.fs.write_text(path_join(bin, "sleep"), "#!/bin/sh\nexit 0\n")
  const chmod = shell(
    "chmod +x ${shell_quote(path_join(bin, "curl"))} ${shell_quote(path_join(bin, "gh"))} ${shell_quote(path_join(bin, "sleep"))}",
  )
  assert_eq(chmod.status, 0)
  const outputs = path_join(root, "outputs")
  const script = wait_harn_release_ready_script()
  const command = "PATH=${test_path(bin)} "
    + "GITHUB_OUTPUT=${shell_quote(outputs)} "
    + "HARN_RELEASE_READY_MAX_ATTEMPTS=1 "
    + "HARN_RELEASE_READY_POLL_SECONDS=0 "
    + "${shell_quote(script)} v1.2.3"
  const result = shell(command)
  assert_eq(result.status, 0)
  assert(contains(result.stdout, "harn-cli 1.2.3 published"))
  assert(contains(result.stdout, "missing release assets"))
  assert(contains(result.stdout, "SHA256SUMS"))
  assert(contains(harness.fs.read_text(outputs), "ready=false"))
}

pipeline test_wait_harn_release_ready_accepts_complete_release(task) {
  const root = path_join(harness.fs.temp_dir(), "wait-harn-release-ready-" + uuid_v7())
  const bin = path_join(root, "bin")
  harness.fs.mkdir(bin, true)
  harness.fs.write_text(
    path_join(bin, "curl"),
    "#!/bin/sh\ncase \"$*\" in *crates.io/api/v1/crates/harn-cli/1.2.3*) exit 0;; *) exit 22;; esac\n",
  )
  harness.fs.write_text(
    path_join(bin, "gh"),
    "#!/bin/sh\ncase \"$*\" in\n  *isPrerelease*) printf '%s\\n' false;;\n  *) cat <<'EOF'\nharn-aarch64-apple-darwin.tar.gz\nharn-aarch64-unknown-linux-gnu.tar.gz\nharn-x86_64-apple-darwin.tar.gz\nharn-x86_64-pc-windows-msvc.zip\nharn-x86_64-unknown-linux-gnu.tar.gz\nSHA256SUMS\nrelease-assets.json\nEOF\n  ;;\nesac\n",
  )
  harness.fs.write_text(path_join(bin, "sleep"), "#!/bin/sh\nexit 0\n")
  const chmod = shell(
    "chmod +x ${shell_quote(path_join(bin, "curl"))} ${shell_quote(path_join(bin, "gh"))} ${shell_quote(path_join(bin, "sleep"))}",
  )
  assert_eq(chmod.status, 0)
  const outputs = path_join(root, "outputs")
  const script = wait_harn_release_ready_script()
  const command = "PATH=${test_path(bin)} "
    + "GITHUB_OUTPUT=${shell_quote(outputs)} "
    + "HARN_RELEASE_READY_MAX_ATTEMPTS=1 "
    + "HARN_RELEASE_READY_POLL_SECONDS=0 "
    + "${shell_quote(script)} v1.2.3"
  const result = shell(command)
  assert_eq(result.status, 0)
  assert(contains(result.stdout, "required release assets are present"))
  assert(contains(harness.fs.read_text(outputs), "ready=true"))
}

pipeline test_wait_harn_release_ready_requires_finalized_release(task) {
  const root = path_join(harness.fs.temp_dir(), "wait-harn-release-ready-" + uuid_v7())
  const bin = path_join(root, "bin")
  harness.fs.mkdir(bin, true)
  harness.fs.write_text(
    path_join(bin, "curl"),
    "#!/bin/sh\ncase \"$*\" in *crates.io/api/v1/crates/harn-cli/1.2.3*) exit 0;; *) exit 22;; esac\n",
  )
  harness.fs.write_text(
    path_join(bin, "gh"),
    "#!/bin/sh\ncase \"$*\" in\n  *isPrerelease*) printf '%s\\n' true;;\n  *) cat <<'EOF'\nharn-aarch64-apple-darwin.tar.gz\nharn-aarch64-unknown-linux-gnu.tar.gz\nharn-x86_64-apple-darwin.tar.gz\nharn-x86_64-pc-windows-msvc.zip\nharn-x86_64-unknown-linux-gnu.tar.gz\nSHA256SUMS\nrelease-assets.json\nEOF\n  ;;\nesac\n",
  )
  harness.fs.write_text(path_join(bin, "sleep"), "#!/bin/sh\nexit 0\n")
  const chmod = shell(
    "chmod +x ${shell_quote(path_join(bin, "curl"))} ${shell_quote(path_join(bin, "gh"))} ${shell_quote(path_join(bin, "sleep"))}",
  )
  assert_eq(chmod.status, 0)
  const outputs = path_join(root, "outputs")
  const script = wait_harn_release_ready_script()
  const command = "PATH=${test_path(bin)} "
    + "GITHUB_OUTPUT=${shell_quote(outputs)} "
    + "HARN_RELEASE_READY_MAX_ATTEMPTS=1 "
    + "HARN_RELEASE_READY_POLL_SECONDS=0 "
    + "${shell_quote(script)} v1.2.3"
  const result = shell(command)
  assert_eq(result.status, 0)
  assert(contains(result.stdout, "required release assets present"))
  assert(contains(result.stdout, "GitHub release still marked prerelease"))
  assert(contains(harness.fs.read_text(outputs), "ready=false"))
}

pipeline test_wait_harn_release_ready_does_not_require_cargo(task) {
  const root = path_join(harness.fs.temp_dir(), "wait-harn-release-ready-" + uuid_v7())
  const bin = path_join(root, "bin")
  harness.fs.mkdir(bin, true)
  harness.fs.write_text(path_join(bin, "curl"), "#!/bin/sh\nexit 22\n")
  harness.fs.write_text(
    path_join(bin, "gh"),
    "#!/bin/sh\ncase \"$*\" in\n  *isPrerelease*) printf '%s\\n' false;;\n  *) cat <<'EOF'\nharn-aarch64-apple-darwin.tar.gz\nharn-aarch64-unknown-linux-gnu.tar.gz\nharn-x86_64-apple-darwin.tar.gz\nharn-x86_64-pc-windows-msvc.zip\nharn-x86_64-unknown-linux-gnu.tar.gz\nSHA256SUMS\nrelease-assets.json\nEOF\n  ;;\nesac\n",
  )
  harness.fs.write_text(path_join(bin, "sleep"), "#!/bin/sh\nexit 0\n")
  const chmod = shell(
    "chmod +x ${shell_quote(path_join(bin, "curl"))} ${shell_quote(path_join(bin, "gh"))} ${shell_quote(path_join(bin, "sleep"))}",
  )
  assert_eq(chmod.status, 0)
  const outputs = path_join(root, "outputs")
  const script = wait_harn_release_ready_script()
  const command = "PATH=${test_path(bin)} "
    + "GITHUB_OUTPUT=${shell_quote(outputs)} "
    + "HARN_RELEASE_READY_MAX_ATTEMPTS=1 "
    + "HARN_RELEASE_READY_POLL_SECONDS=0 "
    + "${shell_quote(script)} v1.2.3"
  const result = shell(command)
  assert_eq(result.status, 0)
  assert(contains(result.stdout, "harn-cli 1.2.3 not visible on crates.io"))
  assert(contains(harness.fs.read_text(outputs), "ready=false"))
}
