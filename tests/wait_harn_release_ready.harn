import {
  crate_visibility_from_response,
  github_release_state,
  harn_release_readiness_from,
  release_readiness_detail,
  required_harn_release_assets,
  wait_for_harn_release,
} from "../lib/release_readiness"
import { parse_release_readiness_args } from "../wait_harn_release_ready"

fn thrown(f) -> string {
  return try {
    f()
    ""
  } catch (e) {
    to_string(e)
  }
}

fn release(overrides = {}) {
  return {
    found: true,
    draft: false,
    prerelease: false,
    finalized: true,
    asset_names: required_harn_release_assets(),
  }
    + overrides
}

fn visibility(published) {
  return {published: published, state: "fixture"}
}

pipeline test_readiness_decisions_are_typed_and_fail_closed(task) {
  const ready = harn_release_readiness_from("v1.2.3", visibility(true), release())
  const assets = required_harn_release_assets().filter({ name -> name != "SHA256SUMS" })
  const missing = harn_release_readiness_from(
    "v1.2.3",
    visibility(true),
    release({asset_names: assets}),
  )
  const prerelease = harn_release_readiness_from(
    "v1.2.3",
    visibility(true),
    release({prerelease: true, finalized: false}),
  )
  assert_eq(ready.ready, true)
  assert_eq(missing.missing_assets, ["SHA256SUMS"])
  assert(contains(release_readiness_detail(missing), "missing release assets: SHA256SUMS"))
  assert_eq(prerelease.ready, false)
  assert_eq(harn_release_readiness_from("v1.2.3", visibility(false), release()).ready, false)
}

pipeline test_provider_evidence_normalizes_in_process(task) {
  assert_eq(crate_visibility_from_response({ok: true, status: 200}).state, "published")
  assert_eq(crate_visibility_from_response({ok: false, status: 404}).state, "not_found")
  assert_eq(crate_visibility_from_response({ok: false, status: 503}).state, "unknown")
  assert_eq(github_release_state({found: false}).found, false)
  assert_eq(github_release_state(Err({message: "unavailable"})).finalized, false)
  const final = github_release_state(
    {found: true, release: {draft: false, prerelease: false, assets: [{name: "SHA256SUMS"}]}},
  )
  assert_eq([final.found, final.finalized, final.asset_names], [true, true, ["SHA256SUMS"]])
}

pipeline test_readiness_poll_is_bounded_without_sleep(task) {
  const adapter = {
    crate_visibility: fn(_version) { return visibility(true) },
    github_release: fn(_tag) { return release() },
  }
  const ready = wait_for_harn_release(
    "v1.2.3",
    adapter,
    {max_attempts: 3, interval_ms: 1, timeout_ms: 10},
  )
  const waiting = wait_for_harn_release(
    "v1.2.3",
    adapter + {crate_visibility: fn(_version) { return visibility(false) }},
    {max_attempts: 1, interval_ms: 1, timeout_ms: 1},
  )
  assert_eq([ready.ready, ready.attempts, waiting.ready, waiting.attempts], [true, 1, false, 1])
}

pipeline test_readiness_cli_parses_bounds_and_rejects_invalid_input(task) {
  const defaults = parse_release_readiness_args(["--tag", "v1.2.3"])
  assert_eq(
    [defaults.max_attempts, defaults.interval_seconds, defaults.timeout_seconds],
    [180, 20, 7200],
  )
  assert(
    contains(thrown({ -> parse_release_readiness_args(["--tag", "1.2.3"]) }), "expected Harn tag"),
  )
  assert(
    contains(
      thrown({ -> parse_release_readiness_args(["--tag", "v1.2.3", "--max-attempts", "0"]) }),
      "bounds must be positive",
    ),
  )
}
