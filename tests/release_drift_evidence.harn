import { release_context_set } from "../lib/release_context_declaration"
import {
  ReleaseDriftCommit,
  release_drift_commit_evidence,
  release_drift_evidence,
  release_drift_lane_contexts,
  release_required_contexts_from_rulesets,
} from "../lib/release_drift_evidence"

const BASE = "1111111111111111111111111111111111111111"

const MOVED = "2222222222222222222222222222222222222222"

// The two contexts burin-labs/harn actually requires on main, read from its
// rulesets on 2026-09-03.
const REQUIRED = ["CI status", "drift"]

// A check burin-labs/harn really produces that no ruleset requires. Its
// workflow triggers on every push to the default branch, so the release-only
// classifier calls it branch-covered and does not wait for it either: without
// a declaration it is in neither set the release reads.
const E2E_LANE = "Slow E2E suite"

// Every check name some workflow at the candidate revision can emit.
const PRODUCIBLE = ["CI status", "drift", "Slow E2E suite"]

fn run(name: string, conclusion: string) {
  return {name: name, status: "COMPLETED", conclusion: conclusion, __typename: "CheckRun"}
}

fn green_commit(sha: string) -> ReleaseDriftCommit {
  return release_drift_commit_evidence(
    sha,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS")],
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
  )
}

/**
 * The measured shape. `drift` appears on 2 of the 20 most recent main commits
 * and on 20 of 20 pull-request heads, so a reader that only looked at the main
 * commit would call a green branch unproved and defer every release.
 */
pipeline test_drift_evidence_falls_back_to_the_pull_request_head(task: any) {
  const commit = green_commit(MOVED)
  assert_eq(commit.green, true)
  assert_eq(
    commit.checks.map({ check -> check.name + "@" + check.source }),
    ["CI status@main_commit", "drift@pull_request_head"],
  )
}

/** A required context found in neither place is missing, and missing is not green. */
pipeline test_drift_evidence_refuses_a_context_nobody_ran(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS")],
    [run("CI status", "SUCCESS")],
  )
  assert_eq([commit.green, commit.blocking_check], [false, "drift"])
  assert_eq(commit.checks.map({ check -> check.state }), ["SUCCESS", "MISSING"])
}

/**
 * A rerun leaves a stale failure beside a fresh success, observed on 2 of those
 * 20 main commits. The latest row per name is what the rollup means, so this
 * commit is green.
 */
pipeline test_drift_evidence_reduces_a_rerun_to_its_latest_row(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "FAILURE"), run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
  )
  assert_eq(
    [commit.green, commit.checks.map({ check -> check.state })],
    [true, ["SUCCESS", "SUCCESS"]],
  )
}

/**
 * The real wreck as a negative control. Merge commit 7c953ee2, the v0.10.128
 * cut, carries `CI status=failure`. As the commit being tagged, that shape must
 * stop the release rather than ride along inside the version.
 */
pipeline test_drift_evidence_refuses_the_v128_merge_commit_shape(task: any) {
  const commit = release_drift_commit_evidence(
    "7c953ee2b749c153531c5d6df6a341ca3fada4e7",
    7897,
    REQUIRED,
    [run("CI status", "FAILURE"), run("drift", "SUCCESS")],
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
  )
  const evidence = release_drift_evidence(
    BASE,
    "7c953ee2b749c153531c5d6df6a341ca3fada4e7",
    REQUIRED,
    [commit],
    "2026-09-03T03:00:00Z",
  )
  assert_eq([evidence.green, evidence.blocking_check], [false, "CI status"])
  assert_eq(evidence.blocking_sha, "7c953ee2b749c153531c5d6df6a341ca3fada4e7")
  assert(contains(evidence.reason, "the commit being tagged"))
  assert(contains(evidence.reason, "did not pass CI status"))
}

/**
 * The fix-forward case, which is why the verdict moved to the candidate.
 *
 * An earlier commit in the range failed a required check and a later one
 * repaired it. The tip is what the tag names and what consumers pin, and its
 * required checks are green, so the release admits. Judging the whole range
 * instead refused this shape, and under fix-forward such a commit is always on
 * the branch, so that rule refused every cut forever.
 */
pipeline test_a_red_earlier_commit_does_not_refuse_a_green_candidate(task: any) {
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [
      green_commit(MOVED),
      release_drift_commit_evidence(BASE, 1, REQUIRED, [run("CI status", "FAILURE")], []),
    ],
    "2026-09-03T03:00:00Z",
  )
  assert_eq([evidence.green, evidence.blocking_check], [true, ""])
  assert_eq([evidence.candidate_sha, evidence.blocking_sha], [MOVED, ""])
  assert(contains(evidence.reason, "the commit being tagged, ${MOVED}, passed CI status, drift"))
  // The red is carried in the receipt as history. A verdict that dropped it
  // would read identically to a range that was clean all along.
  assert(contains(evidence.reason, "carrying 1 earlier commit(s)"))
  assert(contains(evidence.reason, "${BASE} (CI status)"))
}

/**
 * The paired control, so the move to the candidate is a narrowing and not a
 * hole: a red tip still refuses, however clean the commits behind it are.
 */
pipeline test_a_red_candidate_still_refuses_behind_green_history(task: any) {
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [
      release_drift_commit_evidence(
        MOVED,
        2,
        REQUIRED,
        [run("CI status", "FAILURE"), run("drift", "SUCCESS")],
        [],
      ),
      green_commit(BASE),
    ],
    "2026-09-03T03:00:00Z",
  )
  assert_eq([evidence.green, evidence.blocking_check], [false, "CI status"])
  assert_eq([evidence.candidate_sha, evidence.blocking_sha], [MOVED, MOVED])
  assert(contains(evidence.reason, "the commit being tagged, ${MOVED}, did not pass CI status"))
}

/** An all-green range still admits, and still says what it carried. */
pipeline test_drift_evidence_admits_a_clean_range(task: any) {
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [green_commit(MOVED), green_commit(BASE)],
    "2026-09-03T03:00:00Z",
  )
  assert_eq([evidence.green, evidence.candidate_sha], [true, MOVED])
  assert(contains(evidence.reason, "passed CI status, drift"))
  assert(contains(evidence.reason, "carrying 1 earlier commit(s)"))
  // Nothing in the range failed, so the receipt says so by naming nobody.
  assert_eq(contains(evidence.reason, "did not themselves pass"), false)
}

/**
 * The candidate must actually be among the commits whose checks were read. An
 * absent candidate is an unread verdict, and an unread verdict must not be
 * indistinguishable from a passing one.
 */
pipeline test_drift_evidence_refuses_a_candidate_it_never_read(task: any) {
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [green_commit(BASE)],
    "2026-09-03T03:00:00Z",
  )
  assert_eq([evidence.green, evidence.candidate_sha], [false, ""])
  assert(contains(evidence.reason, "was not among the 1 commits reported"))
}

/**
 * An unreadable required set is refused, not satisfied. A branch whose rules
 * could not be read looks exactly like a branch with nothing to satisfy, and
 * the second reading would admit every drifted commit on a failed API call.
 */
pipeline test_drift_evidence_refuses_an_unreadable_required_set(task: any) {
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    [],
    [green_commit(MOVED)],
    "2026-09-03T03:00:00Z",
  )
  assert_eq(evidence.green, false)
  assert(contains(evidence.reason, "required checks could not be read"))
}

/** Main moved but nothing was reported: an unproved comparison, not a clean one. */
pipeline test_drift_evidence_refuses_a_drift_with_no_commits(task: any) {
  const evidence = release_drift_evidence(BASE, MOVED, REQUIRED, [], "2026-09-03T03:00:00Z")
  assert_eq(evidence.green, false)
  assert(contains(evidence.reason, "no drifted commit was reported"))
}

/**
 * The required set comes from the rulesets endpoint, because classic branch
 * protection answers 404 on this branch. Only active rulesets count: harn's
 * merge-queue ruleset is disabled, which is why nothing serialised the release
 * merge in the first place.
 */
pipeline test_required_contexts_come_from_active_rulesets_only(task: any) {
  const contexts = release_required_contexts_from_rulesets(
    [
      {
        name: "main protection",
        enforcement: "active",
        rules: [
          {
            type: "required_status_checks",
            parameters: {required_status_checks: [{context: "CI status"}]},
          },
          {type: "deletion"},
        ],
      },
      {
        name: "release drift required",
        enforcement: "active",
        rules: [
          {
            type: "required_status_checks",
            parameters: {required_status_checks: [{context: "drift"}]},
          },
        ],
      },
      {
        name: "merge queue",
        enforcement: "disabled",
        rules: [
          {
            type: "required_status_checks",
            parameters: {required_status_checks: [{context: "never enforced"}]},
          },
        ],
      },
    ],
  )
  assert_eq(contexts, ["CI status", "drift"])
}

/** No rulesets at all reads as no required contexts, which the verdict refuses. */
pipeline test_required_contexts_are_empty_when_nothing_is_enforced(task: any) {
  assert_eq(release_required_contexts_from_rulesets([]), [])
  assert_eq(release_required_contexts_from_rulesets(nil), [])
}

const LANES = ["Workspace nextest (macos-latest)", "Workspace nextest (windows-latest)"]

/**
 * A release-only lane is required of a drifted commit only when that commit
 * touched a path the lane bears on. Without the condition, a documentation
 * commit would owe a workspace test run its own pull request never triggered,
 * and the release would wait forever for a result nobody is going to produce.
 */
pipeline test_lane_contexts_follow_what_the_commit_changed(task: any) {
  assert_eq(
    release_drift_lane_contexts(
      LANES,
      ["crates/harn-core/src/lib.rs"],
      ["crates/harn-core/src/lib.rs"],
    ),
    LANES,
  )
  assert_eq(release_drift_lane_contexts(LANES, ["changelog.d/1.fixed.md"], []), [])
  assert_eq(release_drift_lane_contexts([], ["crates/a.rs"], ["crates/a.rs"]), [])
}

/**
 * The change the pull-request trigger buys. A lane that ran green on the
 * drifted commit's own pull request head satisfies the release, so the cut
 * merges without running a thirty-four minute job of its own.
 */
pipeline test_a_lane_green_on_the_pull_request_head_satisfies_the_release(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS")],
    [
      run("CI status", "SUCCESS"),
      run("drift", "SUCCESS"),
      run("Workspace nextest (windows-latest)", "SUCCESS"),
      run("Workspace nextest (macos-latest)", "SUCCESS"),
    ],
    LANES,
  )
  assert_eq([commit.green, commit.blocking_check], [true, ""])
  assert(commit.checks.any({ check -> check.release_only && check.state == "SUCCESS" }))
}

/**
 * An unfinished lane admits the commit immediately and is named as unfinished.
 *
 * This removes the wait #1097 introduced. Waiting only makes sense when
 * finishing could change the verdict, and outside the required set nothing a
 * lane reports can: it does not refuse, so there is nothing to wait to learn.
 * The .129 cut held for ten polls on exactly this arm before deferring anyway.
 */
pipeline test_an_unfinished_lane_admits_and_is_named(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
    LANES,
  )
  assert_eq([commit.green, commit.blocking_check], [true, ""])
  assert_eq(commit.unfinished_lanes, LANES)
  assert_eq(commit.failed_lanes, [])
  const evidence = release_drift_evidence(BASE, MOVED, REQUIRED, [commit], "2026-09-03T03:00:00Z")
  assert_eq(evidence.green, true)
  assert(contains(evidence.reason, "without waiting for unfinished lanes"))
  assert(contains(evidence.reason, "Workspace nextest (macos-latest)"))
}

/**
 * The control that keeps the removal a narrowing: a required context that has
 * not finished still refuses, because a commit is on main without it.
 */
pipeline test_an_unfinished_required_context_still_refuses(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "IN_PROGRESS")],
    [],
    LANES,
  )
  assert_eq([commit.green, commit.blocking_check], [false, "drift"])
}

/**
 * A failed lane and an unfinished lane are recorded apart, and neither decides.
 *
 * This supersedes the lane-refusal #1097 introduced. A commit is admitted on
 * what the branch requires of it, and the branch requires none of these lanes,
 * so a red one is a fact about the commit rather than a verdict on the release.
 */
pipeline test_a_failed_lane_and_an_unfinished_lane_are_both_only_recorded(task: any) {
  const failed = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [
      run("Workspace nextest (windows-latest)", "FAILURE"),
      run("Workspace nextest (macos-latest)", "SUCCESS"),
    ],
    LANES,
  )
  const unfinished = release_drift_commit_evidence(
    BASE,
    7891,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
    LANES,
  )
  assert_eq(failed.blocking_check, "")
  assert_eq(failed.failed_lanes, ["Workspace nextest (windows-latest)"])
  assert_eq(failed.unfinished_lanes, [])
  assert_eq(unfinished.unfinished_lanes, LANES)
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [unfinished, failed],
    "2026-09-03T03:00:00Z",
  )
  assert_eq([evidence.green, evidence.blocking_check], [true, ""])
  assert(contains(evidence.reason, "over failing lanes"))
  assert(contains(evidence.reason, "without waiting for unfinished lanes"))
}

/** A commit that owes no lane is green on the branch's own checks alone. */
pipeline test_a_paperwork_commit_owes_no_lane(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
    [],
  )
  assert_eq([commit.green, commit.unfinished_lanes], [true, []])
}

/**
 * A required context that skipped, held for completeness.
 *
 * `Deploy docs` is used here as a name only. It is NOT one of the contexts
 * burin-labs/harn requires: rulesets 15807155 and 16571690 require exactly
 * `CI status` and `drift`. The case that reproduces the v0.10.129 refusal is
 * the lane one below; this one holds the same rule on the other arm.
 */
pipeline test_a_path_gated_required_check_that_skipped_does_not_block(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7918,
    ["CI status", "Deploy docs"],
    [run("CI status", "SUCCESS"), run("Deploy docs", "SKIPPED")],
    [],
  )
  assert_eq(commit.blocking_check, "")
  assert_eq(commit.unfinished_lanes, [])
  assert_eq(commit.green, true)
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    ["CI status", "Deploy docs"],
    [commit],
    "2026-09-03T07:18:13Z",
  )
  assert_eq(evidence.green, true)
  assert_eq(evidence.blocking_check, "")
}

/**
 * The negative controls for the same rule. A skip is admissible; a settled
 * failure and a context that never reported are not, and both still name
 * themselves.
 */
pipeline test_a_failure_and_a_missing_context_still_block(task: any) {
  const failed = release_drift_commit_evidence(
    MOVED,
    7918,
    ["CI status", "Deploy docs"],
    [run("CI status", "SUCCESS"), run("Deploy docs", "FAILURE")],
    [],
  )
  assert_eq(failed.blocking_check, "Deploy docs")
  assert_eq(failed.green, false)
  const missing = release_drift_commit_evidence(
    MOVED,
    7918,
    ["CI status", "Deploy docs"],
    [run("CI status", "SUCCESS")],
    [],
  )
  assert_eq(missing.blocking_check, "Deploy docs")
  assert_eq(missing.green, false)
  const neutral = release_drift_commit_evidence(
    MOVED,
    7918,
    ["CI status", "Deploy docs"],
    [run("CI status", "SUCCESS"), run("Deploy docs", "NEUTRAL")],
    [],
  )
  assert_eq(neutral.blocking_check, "")
  assert_eq(neutral.green, true)
}

/**
 * The v0.10.129 cut, reproduced on the arm that actually refused.
 *
 * Run 33717920114 refused with "commit 2937eb1d929a5dd9736fb94371f6e97aa37b9119
 * landed on main without passing Deploy docs". `Deploy docs` reached the
 * evidence as a LANE, not as a required context: `release_pull_request_lane_set`
 * harvests every job name from every certification workflow carrying a
 * `pull_request` trigger, and `ci.yml` is one of them with twenty-nine such
 * jobs. `Deploy docs` is one of those twenty-nine, it is path-gated, and the
 * commit touched no documentation, so it concluded `SKIPPED`.
 *
 * A census of the twelve main commits before the refusal found it skipped on
 * nine and successful on three, so the old rule deferred a cut on almost any
 * drift rather than on a rare one.
 */
pipeline test_a_skipped_lane_does_not_block_or_wait(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7918,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS"), run("Deploy docs", "SKIPPED")],
    [],
    ["Deploy docs"],
  )
  assert_eq(commit.blocking_check, "")
  assert_eq(commit.unfinished_lanes, [])
  assert_eq(commit.green, true)
}

/**
 * The v0.10.129 main_tag refusal, reproduced.
 *
 * Run 33735313684 refused at main_tag with "commit 9fabd067 landed on main
 * without passing Workspace nextest (windows-latest)". That job comes from
 * `windows-nightly.yml`, which carries a `pull_request` trigger and no
 * main-commit trigger, so the obligation narrowing keeps it in the lane set and
 * correctly so. The workflow's own header says failure there is informational
 * and does not gate the aggregate the branch requires, and the branch's
 * rulesets agree: nothing about that job is a required context.
 *
 * A commit is admitted on what the branch requires of it. A failed lane the
 * branch does not require is recorded and named, and the release goes on.
 */
pipeline test_a_failed_lane_is_recorded_and_does_not_refuse(task: any) {
  const commit = release_drift_commit_evidence(
    "9fabd0670000000000000000000000000000abcd",
    7948,
    REQUIRED,
    [
      run("CI status", "SUCCESS"),
      run("drift", "SUCCESS"),
      run("Workspace nextest (windows-latest)", "FAILURE"),
    ],
    [],
    ["Workspace nextest (windows-latest)"],
  )
  assert_eq(commit.blocking_check, "")
  assert_eq(commit.unfinished_lanes, [])
  assert_eq(commit.green, true)
  assert_eq(commit.failed_lanes, ["Workspace nextest (windows-latest)"])
  const evidence = release_drift_evidence(
    BASE,
    "9fabd0670000000000000000000000000000abcd",
    REQUIRED,
    [commit],
    "2026-09-03T10:30:00Z",
  )
  assert_eq(evidence.green, true)
  assert(contains(evidence.reason, "Workspace nextest (windows-latest)"))
}

/**
 * The paired control, so the change is a narrowing and not a hole.
 *
 * Same commit, same lane, but the red is on a context the branch requires. That
 * still refuses, and the terminal reason still names it.
 */
pipeline test_a_failing_required_context_still_refuses_on_the_same_commit(task: any) {
  const commit = release_drift_commit_evidence(
    "9fabd0670000000000000000000000000000abcd",
    7948,
    REQUIRED,
    [
      run("CI status", "FAILURE"),
      run("drift", "SUCCESS"),
      run("Workspace nextest (windows-latest)", "FAILURE"),
    ],
    [],
    ["Workspace nextest (windows-latest)"],
  )
  assert_eq(commit.blocking_check, "CI status")
  assert_eq(commit.green, false)
  const evidence = release_drift_evidence(
    BASE,
    "9fabd0670000000000000000000000000000abcd",
    REQUIRED,
    [commit],
    "2026-09-03T10:30:00Z",
  )
  assert_eq(evidence.green, false)
  assert_eq(evidence.blocking_check, "CI status")
}

/** An unreported lane is recorded as unfinished and admits the commit. */
pipeline test_an_absent_lane_is_recorded_not_waited_on(task: any) {
  const absent = release_drift_commit_evidence(
    MOVED,
    7918,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
    ["Deploy docs"],
  )
  assert_eq(absent.blocking_check, "")
  assert_eq(absent.unfinished_lanes, ["Deploy docs"])
  assert_eq(absent.green, true)
}

/**
 * The v0.10.129 commit, judged against the obligation set the branch actually
 * requires rather than against every job name in a certification workflow.
 *
 * This is the end of the story #1102 and #1103 tell. Those made a skipped
 * obligation tolerable; this removes `Deploy docs` from the obligation set
 * entirely, because `ci.yml` runs on ordinary main commits and its jobs reach
 * the branch through `CI status`. The commit is green here without any
 * tolerance being exercised: the check is not asked for, so its conclusion,
 * whatever it was, cannot decide a release.
 */
pipeline test_the_real_commit_passes_with_the_docs_job_out_of_the_set(task: any) {
  const commit = release_drift_commit_evidence(
    "2937eb1d929a5dd9736fb94371f6e97aa37b9119",
    7918,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS"), run("Deploy docs", "SKIPPED")],
    [],
  )
  assert_eq(commit.blocking_check, "")
  assert_eq(commit.unfinished_lanes, [])
  assert_eq(commit.green, true)
  assert_eq(commit.checks.map({ check -> check.name }), REQUIRED)
  assert(!commit.checks.map({ check -> check.name }).contains("Deploy docs"))
}

/** The control: the aggregate the branch does require still decides. */
pipeline test_a_failing_required_aggregate_still_refuses(task: any) {
  const commit = release_drift_commit_evidence(
    "2937eb1d929a5dd9736fb94371f6e97aa37b9119",
    7918,
    REQUIRED,
    [run("CI status", "FAILURE"), run("drift", "SUCCESS"), run("Deploy docs", "SUCCESS")],
    [],
  )
  assert_eq(commit.blocking_check, "CI status")
  assert_eq(commit.green, false)
}

/**
 * The release decides on the union, so a declared context that never reported
 * holds the cut and is named with the count.
 *
 * The candidate's ruleset checks are green here, which is exactly the shape
 * that admits today. The lane that is branch-covered and ruleset-optional is
 * the one nothing was reading, and declaring it is what makes its absence a
 * pending row instead of a silence.
 */
pipeline test_a_declared_context_that_never_reported_holds_the_cut(task: any) {
  const set = release_context_set(REQUIRED, [E2E_LANE], PRODUCIBLE, "manifest")
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    set.contexts,
    [
      release_drift_commit_evidence(
        MOVED,
        3,
        set.contexts,
        [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
        [],
      ),
    ],
    "2026-09-06T03:00:00Z",
    set,
  )
  assert_eq([evidence.green, evidence.candidate_sha], [false, MOVED])
  assert_eq(evidence.blocking_check, E2E_LANE)
  assert_eq([evidence.readiness.pending_names, evidence.readiness.pending_count], [[E2E_LANE], 1])
  assert(contains(evidence.reason, "1 pending, 0 failing of 3 required"))
}

/**
 * The paired control on the same rows: without the declaration the identical
 * candidate admits, which is the behavior on main today.
 */
pipeline test_the_same_candidate_admits_with_no_declaration(task: any) {
  const set = release_context_set(REQUIRED, [], PRODUCIBLE, "manifest")
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    set.contexts,
    [
      release_drift_commit_evidence(
        MOVED,
        3,
        set.contexts,
        [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
        [],
      ),
    ],
    "2026-09-06T03:00:00Z",
    set,
  )
  assert_eq([evidence.green, evidence.blocking_check], [true, ""])
  assert(contains(evidence.reason, "passed CI status, drift"))
}

/** A declared context nothing at the candidate revision produces refuses by name. */
pipeline test_a_declared_context_that_no_longer_exists_refuses_by_name(task: any) {
  const set = release_context_set(REQUIRED, ["Slow E2E suit"], PRODUCIBLE, "manifest")
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    set.contexts,
    [green_commit(MOVED)],
    "2026-09-06T03:00:00Z",
    set,
  )
  assert_eq([evidence.green, evidence.candidate_sha], [false, ""])
  assert(contains(evidence.reason, "no workflow at ${MOVED} produces: Slow E2E suit"))
}

/**
 * A declared context that is red on the candidate holds where the release
 * admits today, and the receipt names it rather than only counting it.
 */
pipeline test_a_red_declared_context_refuses_the_candidate(task: any) {
  const set = release_context_set(REQUIRED, [E2E_LANE], PRODUCIBLE, "manifest")
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    set.contexts,
    [
      release_drift_commit_evidence(
        MOVED,
        4,
        set.contexts,
        [run("CI status", "SUCCESS"), run("drift", "SUCCESS"), run(E2E_LANE, "FAILURE")],
        [],
      ),
    ],
    "2026-09-06T03:00:00Z",
    set,
  )
  assert_eq(evidence.green, false)
  assert_eq(evidence.blocking_check, E2E_LANE)
  assert_eq(evidence.readiness.failing_names, [E2E_LANE])
  assert(contains(evidence.reason, "0 pending, 1 failing of 3 required"))
}

/**
 * Every caller that passes no set keeps the old signature's behavior, and the
 * receipt still carries a set so a reader never has to special-case its
 * absence.
 */
pipeline test_an_absent_set_degenerates_to_the_ruleset_set(task: any) {
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [green_commit(MOVED)],
    "2026-09-06T03:00:00Z",
  )
  assert_eq([evidence.green, evidence.context_set.contexts], [true, REQUIRED])
  assert_eq(evidence.context_set.declaration_source, "none")
  assert_eq([evidence.context_set.declared, evidence.context_set.refused], [[], []])
}
