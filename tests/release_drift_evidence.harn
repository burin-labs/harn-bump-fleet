import {
  ReleaseDriftCommit,
  release_drift_commit_evidence,
  release_drift_evidence,
  release_drift_lane_contexts,
  release_required_contexts_from_rulesets,
} from "../lib/release_drift_evidence"

const BASE = "1111111111111111111111111111111111111111"

const MOVED = "2222222222222222222222222222222222222222"

// The two contexts burin-labs/harn actually requires on main, read from its
// rulesets on 2026-09-03.
const REQUIRED = ["CI status", "drift"]

fn run(name: string, conclusion: string) {
  return {name: name, status: "COMPLETED", conclusion: conclusion, __typename: "CheckRun"}
}

fn green_commit(sha: string) -> ReleaseDriftCommit {
  return release_drift_commit_evidence(
    sha,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS")],
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
  )
}

/**
 * The measured shape. `drift` appears on 2 of the 20 most recent main commits
 * and on 20 of 20 pull-request heads, so a reader that only looked at the main
 * commit would call a green branch unproved and defer every release.
 */
pipeline test_drift_evidence_falls_back_to_the_pull_request_head(task: any) {
  const commit = green_commit(MOVED)
  assert_eq(commit.green, true)
  assert_eq(
    commit.checks.map({ check -> check.name + "@" + check.source }),
    ["CI status@main_commit", "drift@pull_request_head"],
  )
}

/** A required context found in neither place is missing, and missing is not green. */
pipeline test_drift_evidence_refuses_a_context_nobody_ran(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS")],
    [run("CI status", "SUCCESS")],
  )
  assert_eq([commit.green, commit.blocking_check], [false, "drift"])
  assert_eq(commit.checks.map({ check -> check.state }), ["SUCCESS", "MISSING"])
}

/**
 * A rerun leaves a stale failure beside a fresh success, observed on 2 of those
 * 20 main commits. The latest row per name is what the rollup means, so this
 * commit is green.
 */
pipeline test_drift_evidence_reduces_a_rerun_to_its_latest_row(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "FAILURE"), run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
  )
  assert_eq(
    [commit.green, commit.checks.map({ check -> check.state })],
    [true, ["SUCCESS", "SUCCESS"]],
  )
}

/**
 * The real wreck as a negative control. Merge commit 7c953ee2, the v0.10.128
 * cut, carries `CI status=failure`. A drifted commit that looks like this must
 * stop the release rather than ride along inside the version.
 */
pipeline test_drift_evidence_refuses_the_v128_merge_commit_shape(task: any) {
  const commit = release_drift_commit_evidence(
    "7c953ee2b749c153531c5d6df6a341ca3fada4e7",
    7897,
    REQUIRED,
    [run("CI status", "FAILURE"), run("drift", "SUCCESS")],
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
  )
  const evidence = release_drift_evidence(BASE, MOVED, REQUIRED, [commit], "2026-09-03T03:00:00Z")
  assert_eq([evidence.green, evidence.blocking_check], [false, "CI status"])
  assert_eq(evidence.blocking_sha, "7c953ee2b749c153531c5d6df6a341ca3fada4e7")
  assert(contains(evidence.reason, "without passing CI status"))
}

/** The whole drift is green only when every commit in it is. */
pipeline test_drift_evidence_is_green_only_when_every_commit_is(task: any) {
  const green = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [green_commit(MOVED), green_commit(BASE)],
    "2026-09-03T03:00:00Z",
  )
  const red = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [
      green_commit(MOVED),
      release_drift_commit_evidence(BASE, 1, REQUIRED, [run("CI status", "FAILURE")], []),
    ],
    "2026-09-03T03:00:00Z",
  )
  assert_eq(green.green, true)
  assert(contains(green.reason, "passed CI status, drift"))
  assert_eq([red.green, red.blocking_sha], [false, BASE])
}

/**
 * An unreadable required set is refused, not satisfied. A branch whose rules
 * could not be read looks exactly like a branch with nothing to satisfy, and
 * the second reading would admit every drifted commit on a failed API call.
 */
pipeline test_drift_evidence_refuses_an_unreadable_required_set(task: any) {
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    [],
    [green_commit(MOVED)],
    "2026-09-03T03:00:00Z",
  )
  assert_eq(evidence.green, false)
  assert(contains(evidence.reason, "required checks could not be read"))
}

/** Main moved but nothing was reported: an unproved comparison, not a clean one. */
pipeline test_drift_evidence_refuses_a_drift_with_no_commits(task: any) {
  const evidence = release_drift_evidence(BASE, MOVED, REQUIRED, [], "2026-09-03T03:00:00Z")
  assert_eq(evidence.green, false)
  assert(contains(evidence.reason, "no drifted commit was reported"))
}

/**
 * The required set comes from the rulesets endpoint, because classic branch
 * protection answers 404 on this branch. Only active rulesets count: harn's
 * merge-queue ruleset is disabled, which is why nothing serialised the release
 * merge in the first place.
 */
pipeline test_required_contexts_come_from_active_rulesets_only(task: any) {
  const contexts = release_required_contexts_from_rulesets(
    [
      {
        name: "main protection",
        enforcement: "active",
        rules: [
          {
            type: "required_status_checks",
            parameters: {required_status_checks: [{context: "CI status"}]},
          },
          {type: "deletion"},
        ],
      },
      {
        name: "release drift required",
        enforcement: "active",
        rules: [
          {
            type: "required_status_checks",
            parameters: {required_status_checks: [{context: "drift"}]},
          },
        ],
      },
      {
        name: "merge queue",
        enforcement: "disabled",
        rules: [
          {
            type: "required_status_checks",
            parameters: {required_status_checks: [{context: "never enforced"}]},
          },
        ],
      },
    ],
  )
  assert_eq(contexts, ["CI status", "drift"])
}

/** No rulesets at all reads as no required contexts, which the verdict refuses. */
pipeline test_required_contexts_are_empty_when_nothing_is_enforced(task: any) {
  assert_eq(release_required_contexts_from_rulesets([]), [])
  assert_eq(release_required_contexts_from_rulesets(nil), [])
}

const LANES = ["Workspace nextest (macos-latest)", "Workspace nextest (windows-latest)"]

/**
 * A release-only lane is required of a drifted commit only when that commit
 * touched a path the lane bears on. Without the condition, a documentation
 * commit would owe a workspace test run its own pull request never triggered,
 * and the release would wait forever for a result nobody is going to produce.
 */
pipeline test_lane_contexts_follow_what_the_commit_changed(task: any) {
  assert_eq(
    release_drift_lane_contexts(
      LANES,
      ["crates/harn-core/src/lib.rs"],
      ["crates/harn-core/src/lib.rs"],
    ),
    LANES,
  )
  assert_eq(release_drift_lane_contexts(LANES, ["changelog.d/1.fixed.md"], []), [])
  assert_eq(release_drift_lane_contexts([], ["crates/a.rs"], ["crates/a.rs"]), [])
}

/**
 * The change the pull-request trigger buys. A lane that ran green on the
 * drifted commit's own pull request head satisfies the release, so the cut
 * merges without running a thirty-four minute job of its own.
 */
pipeline test_a_lane_green_on_the_pull_request_head_satisfies_the_release(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS")],
    [
      run("CI status", "SUCCESS"),
      run("drift", "SUCCESS"),
      run("Workspace nextest (windows-latest)", "SUCCESS"),
      run("Workspace nextest (macos-latest)", "SUCCESS"),
    ],
    LANES,
  )
  assert_eq([commit.green, commit.blocking_check, commit.pending_check], [true, "", ""])
  assert(commit.checks.any({ check -> check.release_only && check.state == "SUCCESS" }))
}

/**
 * A lane that has not reported is not a lane that failed. These lanes are not
 * required by the branch, so a commit can merge before they finish, and the
 * evidence says "waiting" so the release holds rather than giving up the cut.
 */
pipeline test_an_unfinished_lane_waits_rather_than_refusing(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
    LANES,
  )
  assert_eq([commit.green, commit.blocking_check], [false, ""])
  assert_eq(commit.pending_check, "Workspace nextest (macos-latest)")
  const evidence = release_drift_evidence(BASE, MOVED, REQUIRED, [commit], "2026-09-03T03:00:00Z")
  assert_eq([evidence.green, evidence.pending], [false, true])
  assert(contains(evidence.reason, "still waiting on"))
}

/** A lane that actually failed refuses, and outranks any other commit's wait. */
pipeline test_a_failed_lane_refuses_and_outranks_a_wait(task: any) {
  const failed = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [
      run("Workspace nextest (windows-latest)", "FAILURE"),
      run("Workspace nextest (macos-latest)", "SUCCESS"),
    ],
    LANES,
  )
  const waiting = release_drift_commit_evidence(
    BASE,
    7891,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
    LANES,
  )
  assert_eq(failed.blocking_check, "Workspace nextest (windows-latest)")
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    REQUIRED,
    [waiting, failed],
    "2026-09-03T03:00:00Z",
  )
  assert_eq([evidence.green, evidence.pending], [false, false])
  assert_eq(evidence.blocking_check, "Workspace nextest (windows-latest)")
}

/** A commit that owes no lane is green on the branch's own checks alone. */
pipeline test_a_paperwork_commit_owes_no_lane(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7885,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
    [],
  )
  assert_eq([commit.green, commit.pending_check], [true, ""])
}

/**
 * A required context that skipped, held for completeness.
 *
 * `Deploy docs` is used here as a name only. It is NOT one of the contexts
 * burin-labs/harn requires: rulesets 15807155 and 16571690 require exactly
 * `CI status` and `drift`. The case that reproduces the v0.10.129 refusal is
 * the lane one below; this one holds the same rule on the other arm.
 */
pipeline test_a_path_gated_required_check_that_skipped_does_not_block(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7918,
    ["CI status", "Deploy docs"],
    [run("CI status", "SUCCESS"), run("Deploy docs", "SKIPPED")],
    [],
  )
  assert_eq(commit.blocking_check, "")
  assert_eq(commit.pending_check, "")
  assert_eq(commit.green, true)
  const evidence = release_drift_evidence(
    BASE,
    MOVED,
    ["CI status", "Deploy docs"],
    [commit],
    "2026-09-03T07:18:13Z",
  )
  assert_eq(evidence.green, true)
  assert_eq(evidence.blocking_check, "")
}

/**
 * The negative controls for the same rule. A skip is admissible; a settled
 * failure and a context that never reported are not, and both still name
 * themselves.
 */
pipeline test_a_failure_and_a_missing_context_still_block(task: any) {
  const failed = release_drift_commit_evidence(
    MOVED,
    7918,
    ["CI status", "Deploy docs"],
    [run("CI status", "SUCCESS"), run("Deploy docs", "FAILURE")],
    [],
  )
  assert_eq(failed.blocking_check, "Deploy docs")
  assert_eq(failed.green, false)
  const missing = release_drift_commit_evidence(
    MOVED,
    7918,
    ["CI status", "Deploy docs"],
    [run("CI status", "SUCCESS")],
    [],
  )
  assert_eq(missing.blocking_check, "Deploy docs")
  assert_eq(missing.green, false)
  const neutral = release_drift_commit_evidence(
    MOVED,
    7918,
    ["CI status", "Deploy docs"],
    [run("CI status", "SUCCESS"), run("Deploy docs", "NEUTRAL")],
    [],
  )
  assert_eq(neutral.blocking_check, "")
  assert_eq(neutral.green, true)
}

/**
 * The v0.10.129 cut, reproduced on the arm that actually refused.
 *
 * Run 33717920114 refused with "commit 2937eb1d929a5dd9736fb94371f6e97aa37b9119
 * landed on main without passing Deploy docs". `Deploy docs` reached the
 * evidence as a LANE, not as a required context: `release_pull_request_lane_set`
 * harvests every job name from every certification workflow carrying a
 * `pull_request` trigger, and `ci.yml` is one of them with twenty-nine such
 * jobs. `Deploy docs` is one of those twenty-nine, it is path-gated, and the
 * commit touched no documentation, so it concluded `SKIPPED`.
 *
 * A census of the twelve main commits before the refusal found it skipped on
 * nine and successful on three, so the old rule deferred a cut on almost any
 * drift rather than on a rare one.
 */
pipeline test_a_skipped_lane_does_not_block_or_wait(task: any) {
  const commit = release_drift_commit_evidence(
    MOVED,
    7918,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS"), run("Deploy docs", "SKIPPED")],
    [],
    ["Deploy docs"],
  )
  assert_eq(commit.blocking_check, "")
  assert_eq(commit.pending_check, "")
  assert_eq(commit.green, true)
}

/** The lane arm's controls: a failed lane refuses, an unreported one waits. */
pipeline test_a_failed_lane_refuses_and_an_absent_lane_still_waits(task: any) {
  const failed = release_drift_commit_evidence(
    MOVED,
    7918,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS"), run("Deploy docs", "FAILURE")],
    [],
    ["Deploy docs"],
  )
  assert_eq(failed.blocking_check, "Deploy docs")
  assert_eq(failed.green, false)
  const absent = release_drift_commit_evidence(
    MOVED,
    7918,
    REQUIRED,
    [run("CI status", "SUCCESS"), run("drift", "SUCCESS")],
    [],
    ["Deploy docs"],
  )
  assert_eq(absent.blocking_check, "")
  assert_eq(absent.pending_check, "Deploy docs")
  assert_eq(absent.green, false)
}
