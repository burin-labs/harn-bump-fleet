import { parse_bump_fleet_args } from "../lib/bump_fleet_options"

pipeline test_bump_fleet_options_normalize_cli_parser_output(task) {
  const options = parse_bump_fleet_args(
    [
      "v0.10.23",
      "--dry-run",
      "--only",
      "burin-labs/harn-cloud",
      "--no-chat",
      "--chat-run",
      "known-run",
      "--chat-timeout-s",
      "45",
      "--retry-failed",
      "3",
      "--harn-repo",
      "/tmp/harn",
    ],
  )
  assert_eq(options.target, "v0.10.23")
  assert_eq(options.dry_run, true)
  assert_eq(options.only, "burin-labs/harn-cloud")
  assert_eq(options.no_chat, true)
  assert_eq(options.chat_only, false)
  assert_eq(options.chat_run, "known-run")
  assert_eq(options.chat_timeout_s, 45)
  assert_eq(options.retry_failed, 3)
  assert_eq(options.harn_repo, "/tmp/harn")
}

pipeline test_bump_fleet_options_preserve_legacy_integer_fallbacks(task) {
  const options = parse_bump_fleet_args(
    [
      "--chat-only",
      "--chat-timeout-s",
      "not-a-number",
      "--retry-failed",
      "-1",
      "--harn-repo",
      "/tmp/harn",
    ],
  )
  assert_eq(options.target, nil)
  assert_eq(options.chat_only, true)
  assert_eq(options.chat_timeout_s, 60)
  assert_eq(options.retry_failed, 0)
  assert_eq(options.harn_repo, "/tmp/harn")
}
