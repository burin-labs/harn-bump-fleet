import {
  first_party_action_reference,
  render_first_party_action_pins,
  validate_first_party_action_census,
} from "../lib/first_party_actions"

fn fixture(reference: string) -> string {
  return """
name: Example
on: push
permissions:
  contents: read
jobs:
  proof:
    runs-on: ubuntu-24.04
    steps:
      - uses: ${reference}
        with:
          version: '0.10.152'
      - run: echo unchanged
"""
}

pipeline test_first_party_action_projection_refuses_collateral_run_or_env_replacement(
  harness: Harness,
  task: any,
) {
  const old = "burin-labs/harn/.github/actions/setup-harn@11681af676a5e4dc4200cfee683150cdec26763f"
  for collision in [
    "echo ${old}",
    "echo unchanged\n        env:\n          EXAMPLE: ${old}",
    "echo unchanged # ${old}",
  ] {
    const source = replace(fixture(old), "echo unchanged", collision)
    let refused = false
    try {
      render_first_party_action_pins(source)
    } catch (error) {
      assert(contains(to_string(error), "outside"), to_string(error))
      refused = true
    }
    assert(refused, collision)
  }
}

pipeline test_first_party_action_projection_changes_only_the_pin(harness: Harness, task: any) {
  for action in ["setup-harn", "git-push-credentials", "rust-toolchain", "free-disk-space"] {
    const old = "burin-labs/harn/.github/actions/${action}@11681af676a5e4dc4200cfee683150cdec26763f"
    const current = first_party_action_reference(action)
    const projection = render_first_party_action_pins(fixture(old))
    assert_eq(projection.references, 1)
    assert_eq(projection.source, fixture(current))
    assert_eq(render_first_party_action_pins(projection.source), projection)
  }
}

pipeline test_first_party_action_projection_preserves_rust_and_disk_inputs(
  harness: Harness,
  task: any,
) {
  for reviewed in [
    {
      action: "rust-toolchain",
      inputs: "components: clippy,rustfmt\n          targets: wasm32-unknown-unknown",
    },
    {action: "free-disk-space", inputs: "min-free-gb: '32'"},
  ] {
    const action = reviewed.action
    const old = "burin-labs/harn/.github/actions/${action}@6b541c0b50fb9c5dfab994ecb118ee1ea6004b44"
    const source = replace(fixture(old), "version: '0.10.152'", reviewed.inputs)
    const current = first_party_action_reference(action)
    assert_eq(
      current,
      "burin-labs/harn/.github/actions/${action}@786bc1c0a060575352f812e8314e12c8801c9d84",
    )
    assert_eq(render_first_party_action_pins(source).source, replace(source, old, current))
  }
  assert_eq(
    first_party_action_reference("setup-harn"),
    "burin-labs/harn/.github/actions/setup-harn@6b541c0b50fb9c5dfab994ecb118ee1ea6004b44",
  )
}

pipeline test_first_party_action_projection_refuses_unreviewed_or_mutable_refs(
  harness: Harness,
  task: any,
) {
  for reference in [
    "burin-labs/harn/.github/actions/setup-harn@main",
    "burin-labs/harn/.github/actions/setup-harn",
    "burin-labs/harn/.github/actions/setup-harn@667a6bb60582e6fcb08abc74621c5fc89fb77703@extra",
    "burin-labs/harn/.github/actions/unreviewed@667a6bb60582e6fcb08abc74621c5fc89fb77703",
  ] {
    let refused = false
    try {
      render_first_party_action_pins(fixture(reference))
    } catch (error) {
      refused = true
    }
    assert(refused, reference)
  }
}

pipeline test_first_party_action_projection_measures_absence_and_preserves_other_actions(
  harness: Harness,
  task: any,
) {
  const source = fixture("actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1")
  assert_eq(render_first_party_action_pins(source), {source: source, references: 0, actions: []})
}

pipeline test_first_party_action_census_refuses_missing_action_even_above_count_floors(
  harness: Harness,
  task: any,
) {
  validate_first_party_action_census(
    {workflows: 9, references: 9, actions: ["setup-harn", "git-push-credentials"]},
  )
  for census in [
    {workflows: 0, references: 0, actions: []},
    {workflows: 9, references: 9, actions: ["setup-harn"]},
    {workflows: 9, references: 9, actions: ["git-push-credentials"]},
  ] {
    let refused = false
    try {
      validate_first_party_action_census(census)
    } catch (error) {
      refused = true
    }
    assert(refused, to_string(census))
  }
}
