import {
  agent_transcript_context_metadata,
  release_compaction_policy,
  self_review_compaction_policy,
  self_review_context_eval_manifest,
  self_review_context_eval_markdown,
  self_review_context_eval_report,
  tool_repair_projection_policy,
} from "../lib/transcript_context"

fn flaky_tools() {
  let tools = tool_registry()
  let calls = 0
  let handler = fn(_args) {
    calls = calls + 1
    if calls == 1 {
      throw "tool error: first try"
    }
    return "ok"
  }
  return tool_define(
    tools,
    "run",
    "Run a step.",
    {handler: handler, parameters: {type: "object", properties: {}}, returns: {type: "string"}},
  )
}

pipeline test_release_compaction_policy_preserves_release_state(task) {
  let policy = release_compaction_policy("audit")
  assert_eq(policy.mode, "harn_release_audit")
  assert_eq(policy.author, "harn-bump-fleet/release_harn")
  assert_eq(policy.extend_default_instructions, true)
  assert_eq(contains(policy.instructions, "pin SHA"), true)
  assert_eq(policy.preserve.contains("CI failures"), true)
  assert_eq(release_compaction_policy(nil).mode, "harn_release_agent")
  assert_eq(self_review_compaction_policy(nil).mode, "harn_bump_fleet_self_review_synthesis")
}

pipeline test_self_review_context_eval_manifest_declares_variants(task) {
  let manifest = self_review_context_eval_manifest(
    {
      schema_version: "harn_bump_fleet.self_review.v1",
      run_id: "test-run",
      generated_at: "2026-05-24T00:00:00Z",
      release_runs: [{run_id: "release-1", next_version: "0.8.35"}],
      bump_runs: [{run_id: "bump-1"}],
      self_review_runs: [],
      source_refs: [{label: "release", path: "release_harn.harn"}],
      validation_ladder: {exists: false},
    },
  )
  assert_eq(manifest._type, "harn.context_eval.manifest.v1")
  assert_eq(manifest.id, "harn-bump-fleet-self-review-test-run")
  assert_eq(
    manifest.modes.map({ mode -> mode.id }),
    ["raw_facts", "projected_summary", "clean_tool_repair"],
  )
  assert_eq(manifest.modes[1].projection_policy, "summary_prefix")
  assert_eq(manifest.modes[2].projection_policy, "clean_tool_repair")
  assert_eq(manifest.tasks[0].expected.expected_artifact_ids, ["self_review_facts_summary"])
  let report = self_review_context_eval_report(manifest)
  assert_eq(report._type, "harn.context_eval.report.v1")
  assert_eq(report.total_runs, 3)
  assert_eq(report.passed_runs, 3)
  assert_eq(report.runs[1].projection.policy, "summary_prefix")
  assert_eq(
    contains(
      self_review_context_eval_markdown(report),
      "| self_review_context | projected_summary | yes |",
    ),
    true,
  )
}

pipeline test_agent_transcript_context_metadata_captures_projection_events(task) {
  llm_mock_clear()
  llm_mock({tool_calls: [{id: "call_1", name: "run", arguments: {}}]})
  llm_mock({tool_calls: [{id: "call_2", name: "run", arguments: {}}]})
  llm_mock({text: "Finished."})
  let result = agent_loop(
    "kick it off",
    "You are a test agent.",
    {
      provider: "mock",
      tools: flaky_tools(),
      tool_format: "native",
      max_iterations: 3,
      transcript_projection: tool_repair_projection_policy(),
      compaction: {strategy: "hybrid", keep_last_n: 4, policy: self_review_compaction_policy("test")},
    },
  )
  let metadata = agent_transcript_context_metadata(result)
  assert_eq(metadata.projection_event_count > 0, true)
  assert_eq(metadata.projection_events[0].policy, "clean_tool_repair")
  assert_eq(starts_with(metadata.projection_events[0].prefix_hash, "sha256:"), true)
}
