import {
  release_watch_progress,
  release_watch_progress_key,
  release_watch_progress_lines,
  release_watch_progress_should_emit,
  release_watch_progress_with_warm_cache,
} from "../lib/release_watch_progress"
import { ReleaseWatchState } from "../lib/release_watch_state"

pipeline test_release_watch_progress_lines_show_assets_and_runs(task: any) {
  const state: ReleaseWatchState = "pending"
  const progress = release_watch_progress(
    state,
    "waiting for assets",
    {
      ready: false,
      asset_names: ["harn-aarch64-unknown-linux-gnu.tar.gz"],
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz", "SHA256SUMS"],
    },
    [
      {
        workflow: "publish-release.yml",
        id: 501,
        status: "completed",
        conclusion: "success",
        head_branch: "v1.2.3",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        url: "https://github.com/burin-labs/harn/actions/runs/501",
      },
      {
        workflow: "build-release-binaries.yml",
        id: 502,
        status: "in_progress",
        conclusion: "",
        head_branch: "v1.2.3",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        url: "https://github.com/burin-labs/harn/actions/runs/502",
      },
    ],
    "2026-07-13T00:01:00Z",
  )
  assert_eq(
    release_watch_progress_lines(progress),
    [
      "assets  : 1 observed, 2 missing",
      "missing : harn-x86_64-apple-darwin.tar.gz, SHA256SUMS",
      "runs    : publish-release.yml#501:completed/success; build-release-binaries.yml#502:in_progress",
    ],
  )
}

pipeline test_release_watch_progress_shows_active_warm_job_and_deduplicates_poll_noise(task: any) {
  const state: ReleaseWatchState = "healthy"
  const base = release_watch_progress(
    state,
    "published",
    {ready: true, asset_names: ["SHA256SUMS"], missing_assets: []},
    [],
    "2026-07-13T00:01:00Z",
  )
  const progress = release_watch_progress_with_warm_cache(
    base,
    {
      state: "running",
      source_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      workflow_run_id: 9001,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/9001",
      attempt_count: 1,
      dispatched_at: "2026-07-13T00:01:00Z",
      started_at: "2026-07-13T00:01:10Z",
      finished_at: "",
      updated_at: "2026-07-13T00:02:00Z",
      message: "running",
    },
    {
      workflow_run_id: 9001,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/9001",
      source_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      event: "workflow_dispatch",
      head_branch: "main",
      status: "in_progress",
      conclusion: "",
      started_at: "2026-07-13T00:01:10Z",
      completed_at: "",
    },
    [
      {
        name: "Build x86_64-pc-windows-msvc",
        status: "in_progress",
        conclusion: "",
        active_step: "Build",
      },
    ],
  )
  const lines = release_watch_progress_lines(progress)
  assert(lines.any({ line -> contains(line, "running #9001:in_progress") }))
  assert(lines.any({ line -> contains(line, "x86_64-pc-windows-msvc in_progress step=Build") }))
  assert_eq(release_watch_progress_should_emit("", progress, 1, 0), true)
  const key = release_watch_progress_key(progress)
  assert_eq(release_watch_progress_should_emit(key, progress, 2, 1), false)
  assert_eq(release_watch_progress_should_emit(key, progress, 11, 1), true)
}
