import { command_result_fail, command_result_ok } from "std/command"
import { fleet_self_check, fleet_self_update_decision } from "../lib/fleet_selfcheck"

fn scripted_git(entries) {
  return { args ->
    const key = join(args, " ")
    for entry in entries {
      if entry.cmd == key {
        return entry.result
      }
    }
    throw "unexpected git: " + key
  }
}

fn entry(cmd, result) {
  return {cmd: cmd, result: result}
}

pipeline test_fleet_self_update_decision(task) {
  // Read-only audit never gates.
  assert_eq(fleet_self_update_decision({mode: "audit", fetch_ok: true, behind: true}).action, "skip")
  // Unknown fetch state -> warn, proceed without a freshness guarantee.
  const no_fetch = fleet_self_update_decision({mode: "prepare", fetch_ok: false})
  assert_eq(no_fetch.action, "warn")
  // Up to date -> proceed.
  assert_eq(
    fleet_self_update_decision({mode: "prepare", fetch_ok: true, equal: true}).action,
    "proceed",
  )
  // Behind and fast-forwardable (clean) -> auto fast-forward by default.
  const behind = fleet_self_update_decision(
    {
      mode: "prepare",
      fetch_ok: true,
      equal: false,
      behind: true,
      ahead: false,
      dirty: false,
      fleet_root: "/x",
    },
  )
  assert_eq(behind.action, "autoff")
  assert_eq(contains(behind.remediation, "git -C /x pull --ff-only"), true)
  // Behind but dirty -> fail with a stash+ff remediation.
  const behind_dirty = fleet_self_update_decision(
    {
      mode: "prepare",
      fetch_ok: true,
      equal: false,
      behind: true,
      ahead: false,
      dirty: true,
      fleet_root: "/x",
    },
  )
  assert_eq(behind_dirty.action, "fail")
  assert_eq(contains(behind_dirty.remediation, "git -C /x stash"), true)
  // Behind + dirty + opt-in -> force the fast-forward.
  const behind_dirty_opt = fleet_self_update_decision(
    {
      mode: "ship-pr",
      fetch_ok: true,
      equal: false,
      behind: true,
      ahead: false,
      dirty: true,
      opt_in: true,
    },
  )
  assert_eq(behind_dirty_opt.action, "autoff")
  // Ahead only (local unpushed) -> proceed on newer code.
  assert_eq(
    fleet_self_update_decision(
      {mode: "prepare", fetch_ok: true, equal: false, behind: false, ahead: true},
    ).action,
    "proceed",
  )
  // Diverged -> fail with a rebase remediation.
  const diverged = fleet_self_update_decision(
    {mode: "prepare", fetch_ok: true, equal: false, behind: true, ahead: true, fleet_root: "/x"},
  )
  assert_eq(diverged.action, "fail")
  assert_eq(contains(diverged.remediation, "pull --rebase"), true)
}

fn sh(cmd) {
  const r = shell(cmd)
  if !(r.success ?? false) {
    throw "fixture command failed: ${cmd}\n${r.stderr ?? ""}"
  }
  return r
}

fn git_runner_for(repo) {
  return { args -> shell("git -C '" + repo + "' " + join(args.map({ a -> "'" + a + "'" }), " ")) }
}

fn setup_behind_fleet() {
  const root = trim(sh("mktemp -d").stdout)
  const origin = root + "/origin.git"
  const work = root + "/work"
  sh("git init --bare -q '" + origin + "'")
  sh("git init -q '" + work + "'")
  sh("git -C '" + work + "' config user.email t@example.com")
  sh("git -C '" + work + "' config user.name test")
  sh("git -C '" + work + "' config commit.gpgsign false")
  sh("git -C '" + work + "' checkout -q -b main")
  // Marker file so the self-check confirms this is the bump-fleet checkout.
  sh("printf 'x\\n' > '" + work + "/release_harn.harn'")
  sh("git -C '" + work + "' add -A")
  sh("git -C '" + work + "' commit -q -m init")
  sh("git -C '" + work + "' remote add origin '" + origin + "'")
  sh("git -C '" + work + "' push -q -u origin main")
  // Advance origin by two commits, then rewind the local checkout behind it.
  sh("printf 'a\\n' >> '" + work + "/release_harn.harn'")
  sh("git -C '" + work + "' commit -q -am second")
  sh("printf 'b\\n' >> '" + work + "/release_harn.harn'")
  sh("git -C '" + work + "' commit -q -am third")
  sh("git -C '" + work + "' push -q origin main")
  sh("git -C '" + work + "' reset -q --hard HEAD~2")
  return {root: root, work: work}
}

pipeline test_fleet_self_check_dogfood_behind(task) {
  const fleet = setup_behind_fleet()
  const git = git_runner_for(fleet.work)
  const exists = { p -> shell("test -e '" + p + "'").success }
  // A clean, behind fleet fast-forwards in place by default (no opt-in needed)
  // and really catches up.
  const ff = fleet_self_check(git, exists, {mode: "prepare", default_branch: "main"})
  assert_eq(ff.action, "autoff")
  assert_eq(ff.ff.success, true)
  assert_eq(trim(git(["rev-list", "--count", "HEAD..origin/main"]).stdout), "0")
  sh("rm -rf '" + fleet.root + "'")
}

pipeline test_fleet_self_check_dogfood_behind_dirty_fails(task) {
  const fleet = setup_behind_fleet()
  // Uncommitted change in the behind checkout: refuse to fast-forward.
  sh("printf 'dirty\\n' >> '" + fleet.work + "/release_harn.harn'")
  const git = git_runner_for(fleet.work)
  const exists = { p -> shell("test -e '" + p + "'").success }
  const res = fleet_self_check(git, exists, {mode: "prepare", default_branch: "main"})
  assert_eq(res.action, "fail")
  assert_eq(contains(res.reason, "dirty"), true)
  // Still behind — nothing was mutated.
  assert_eq(trim(git(["rev-list", "--count", "HEAD..origin/main"]).stdout), "2")
  sh("rm -rf '" + fleet.root + "'")
}

pipeline test_fleet_self_check_dogfood_autoff(task) {
  const fleet = setup_behind_fleet()
  const git = git_runner_for(fleet.work)
  const exists = { p -> shell("test -e '" + p + "'").success }
  // With opt-in, the behind fleet fast-forwards and really catches up.
  const ff = fleet_self_check(git, exists, {mode: "ship-pr", opt_in: true, default_branch: "main"})
  assert_eq(ff.action, "autoff")
  assert_eq(ff.ff.success, true)
  assert_eq(trim(git(["rev-list", "--count", "HEAD..origin/main"]).stdout), "0")
  sh("rm -rf '" + fleet.root + "'")
}

pipeline test_fleet_self_check_wrapper(task) {
  const always_exists = { _p -> true }
  // Audit short-circuits before touching git.
  const skip = fleet_self_check({ _a -> command_result_ok("") }, always_exists, {mode: "audit"})
  assert_eq(skip.action, "skip")
  // Behind + clean -> autoff by default: status probed clean, merge --ff-only run.
  const behind_git = scripted_git(
    [
      entry("rev-parse --show-toplevel", command_result_ok("/fleet\n")),
      entry("fetch origin --quiet", command_result_ok("")),
      entry("rev-parse HEAD", command_result_ok("aaaa\n")),
      entry("rev-parse origin/main", command_result_ok("bbbb\n")),
      entry("rev-list --count HEAD..origin/main", command_result_ok("2\n")),
      entry("rev-list --count origin/main..HEAD", command_result_ok("0\n")),
      entry("status --porcelain --untracked-files=normal", command_result_ok("")),
      entry("merge --ff-only origin/main", command_result_ok("Updated\n")),
    ],
  )
  const behind = fleet_self_check(behind_git, always_exists, {mode: "prepare", default_branch: "main"})
  assert_eq(behind.action, "autoff")
  assert_eq(behind.fleet_root, "/fleet")
  assert_eq(behind.local_sha, "aaaa")
  assert_eq(behind.ff.success, true)
  // Behind + dirty + opt-in -> forced autoff.
  const ff_git = scripted_git(
    [
      entry("rev-parse --show-toplevel", command_result_ok("/fleet\n")),
      entry("fetch origin --quiet", command_result_ok("")),
      entry("rev-parse HEAD", command_result_ok("aaaa\n")),
      entry("rev-parse origin/main", command_result_ok("bbbb\n")),
      entry("rev-list --count HEAD..origin/main", command_result_ok("2\n")),
      entry("rev-list --count origin/main..HEAD", command_result_ok("0\n")),
      entry("status --porcelain --untracked-files=normal", command_result_ok(" M release_harn.harn\n")),
      entry("merge --ff-only origin/main", command_result_ok("Updated\n")),
    ],
  )
  const ff = fleet_self_check(ff_git, always_exists, {mode: "prepare", opt_in: true})
  assert_eq(ff.action, "autoff")
  assert_eq(ff.ff.success, true)
  // Behind + dirty + no opt-in -> fail, no merge attempted.
  const dirty_git = scripted_git(
    [
      entry("rev-parse --show-toplevel", command_result_ok("/fleet\n")),
      entry("fetch origin --quiet", command_result_ok("")),
      entry("rev-parse HEAD", command_result_ok("aaaa\n")),
      entry("rev-parse origin/main", command_result_ok("bbbb\n")),
      entry("rev-list --count HEAD..origin/main", command_result_ok("2\n")),
      entry("rev-list --count origin/main..HEAD", command_result_ok("0\n")),
      entry("status --porcelain --untracked-files=normal", command_result_ok(" M release_harn.harn\n")),
    ],
  )
  assert_eq(fleet_self_check(dirty_git, always_exists, {mode: "prepare"}).action, "fail")
  // Equal HEADs -> proceed.
  const equal_git = scripted_git(
    [
      entry("rev-parse --show-toplevel", command_result_ok("/fleet\n")),
      entry("fetch origin --quiet", command_result_ok("")),
      entry("rev-parse HEAD", command_result_ok("cccc\n")),
      entry("rev-parse origin/main", command_result_ok("cccc\n")),
      entry("rev-list --count HEAD..origin/main", command_result_ok("0\n")),
      entry("rev-list --count origin/main..HEAD", command_result_ok("0\n")),
    ],
  )
  assert_eq(fleet_self_check(equal_git, always_exists, {mode: "prepare"}).action, "proceed")
  // Resolved root is not the fleet checkout (marker missing) -> warn, no gating.
  const wrong = fleet_self_check(
    scripted_git([entry("rev-parse --show-toplevel", command_result_ok("/elsewhere\n"))]),
    { _p -> false },
    {mode: "prepare"},
  )
  assert_eq(wrong.action, "warn")
  // Fetch failure -> warn (cannot verify freshness).
  const no_fetch_git = scripted_git(
    [
      entry("rev-parse --show-toplevel", command_result_ok("/fleet\n")),
      entry("fetch origin --quiet", command_result_fail(1, "network down")),
      entry("rev-parse HEAD", command_result_ok("aaaa\n")),
      entry("rev-parse origin/main", command_result_fail(1, "unknown revision")),
    ],
  )
  assert_eq(fleet_self_check(no_fetch_git, always_exists, {mode: "ship-pr"}).action, "warn")
}
