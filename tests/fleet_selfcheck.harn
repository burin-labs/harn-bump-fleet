import { command_result_fail, command_result_ok } from "std/command"
import { fleet_self_check, fleet_self_update_decision } from "../lib/fleet_selfcheck"

fn scripted_git(entries) {
  return { args ->
    const key = join(args, " ")
    for entry in entries {
      if entry.cmd == key {
        return entry.result
      }
    }
    throw "unexpected git: " + key
  }
}

fn entry(cmd, result) {
  return {cmd: cmd, result: result}
}

fn behind_fleet_git(dirty: bool = false) {
  let head = "aaaa"
  return { args ->
    const command = join(args, " ")
    if command == "rev-parse --show-toplevel" {
      return command_result_ok("/fleet\n")
    }
    if command == "fetch origin --quiet" {
      return command_result_ok("")
    }
    if command == "rev-parse HEAD" {
      return command_result_ok(head + "\n")
    }
    if command == "rev-parse origin/main" {
      return command_result_ok("bbbb\n")
    }
    if command == "rev-list --count HEAD..origin/main" {
      return command_result_ok(
        if head == "bbbb" {
          "0\n"
        } else {
          "2\n"
        },
      )
    }
    if command == "rev-list --count origin/main..HEAD" {
      return command_result_ok("0\n")
    }
    if command == "status --porcelain --untracked-files=normal" {
      return command_result_ok(
        if dirty {
          " M release_harn.harn\n"
        } else {
          ""
        },
      )
    }
    if command == "merge --ff-only origin/main" {
      head = "bbbb"
      return command_result_ok("Updated\n")
    }
    throw "unexpected git: " + command
  }
}

fn fleet_marker_exists(path) {
  return path == "/fleet/release_harn.harn"
}

pipeline test_fleet_self_update_decision(task) {
  // Read-only audit never gates.
  assert_eq(fleet_self_update_decision({mode: "audit", fetch_ok: true, behind: true}).action, "skip")
  // Unknown fetch state -> warn, proceed without a freshness guarantee.
  const no_fetch = fleet_self_update_decision({mode: "prepare", fetch_ok: false})
  assert_eq(no_fetch.action, "warn")
  // Up to date -> proceed.
  assert_eq(
    fleet_self_update_decision({mode: "prepare", fetch_ok: true, equal: true}).action,
    "proceed",
  )
  // Behind and fast-forwardable (clean) -> auto fast-forward by default.
  const behind = fleet_self_update_decision(
    {
      mode: "prepare",
      fetch_ok: true,
      equal: false,
      behind: true,
      ahead: false,
      dirty: false,
      fleet_root: "/x",
    },
  )
  assert_eq(behind.action, "autoff")
  assert_eq(contains(behind.remediation, "git -C /x pull --ff-only"), true)
  // Behind but dirty -> fail with a stash+ff remediation.
  const behind_dirty = fleet_self_update_decision(
    {
      mode: "prepare",
      fetch_ok: true,
      equal: false,
      behind: true,
      ahead: false,
      dirty: true,
      fleet_root: "/x",
    },
  )
  assert_eq(behind_dirty.action, "fail")
  assert_eq(contains(behind_dirty.remediation, "git -C /x stash"), true)
  // Behind + dirty + opt-in -> force the fast-forward.
  const behind_dirty_opt = fleet_self_update_decision(
    {
      mode: "ship-pr",
      fetch_ok: true,
      equal: false,
      behind: true,
      ahead: false,
      dirty: true,
      opt_in: true,
    },
  )
  assert_eq(behind_dirty_opt.action, "autoff")
  // Ahead only (local unpushed) -> proceed on newer code.
  assert_eq(
    fleet_self_update_decision(
      {mode: "prepare", fetch_ok: true, equal: false, behind: false, ahead: true},
    ).action,
    "proceed",
  )
  // Diverged -> fail with a rebase remediation.
  const diverged = fleet_self_update_decision(
    {mode: "prepare", fetch_ok: true, equal: false, behind: true, ahead: true, fleet_root: "/x"},
  )
  assert_eq(diverged.action, "fail")
  assert_eq(contains(diverged.remediation, "pull --rebase"), true)
}

pipeline test_fleet_self_check_fast_forwards_in_process(task) {
  const git = behind_fleet_git()
  const ff = fleet_self_check(git, fleet_marker_exists, {mode: "prepare", default_branch: "main"})
  assert_eq(ff.action, "autoff")
  assert_eq(ff.fleet_root, "/fleet")
  assert_eq(ff.local_sha, "aaaa")
  assert_eq(ff.ff.success, true)
  assert_eq(trim(git(["rev-list", "--count", "HEAD..origin/main"]).stdout), "0")
}

pipeline test_fleet_self_check_refuses_dirty_tree_in_process(task) {
  const git = behind_fleet_git(true)
  const res = fleet_self_check(git, fleet_marker_exists, {mode: "prepare", default_branch: "main"})
  assert_eq(res.action, "fail")
  assert_eq(contains(res.reason, "dirty"), true)
  assert_eq(trim(git(["rev-list", "--count", "HEAD..origin/main"]).stdout), "2")
}

pipeline test_fleet_self_check_opt_in_fast_forwards_dirty_tree_in_process(task) {
  const git = behind_fleet_git(true)
  const ff = fleet_self_check(git, fleet_marker_exists, {mode: "ship-pr", opt_in: true, default_branch: "main"})
  assert_eq(ff.action, "autoff")
  assert_eq(ff.ff.success, true)
  assert_eq(trim(git(["rev-list", "--count", "HEAD..origin/main"]).stdout), "0")
}

pipeline test_fleet_self_check_wrapper(task) {
  const always_exists = { _p -> true }
  // Audit short-circuits before touching git.
  const skip = fleet_self_check({ _a -> command_result_ok("") }, always_exists, {mode: "audit"})
  assert_eq(skip.action, "skip")
  // Equal HEADs -> proceed.
  const equal_git = scripted_git(
    [
      entry("rev-parse --show-toplevel", command_result_ok("/fleet\n")),
      entry("fetch origin --quiet", command_result_ok("")),
      entry("rev-parse HEAD", command_result_ok("cccc\n")),
      entry("rev-parse origin/main", command_result_ok("cccc\n")),
      entry("rev-list --count HEAD..origin/main", command_result_ok("0\n")),
      entry("rev-list --count origin/main..HEAD", command_result_ok("0\n")),
    ],
  )
  assert_eq(fleet_self_check(equal_git, always_exists, {mode: "prepare"}).action, "proceed")
  // Resolved root is not the fleet checkout (marker missing) -> warn, no gating.
  const wrong = fleet_self_check(
    scripted_git([entry("rev-parse --show-toplevel", command_result_ok("/elsewhere\n"))]),
    { _p -> false },
    {mode: "prepare"},
  )
  assert_eq(wrong.action, "warn")
  // Fetch failure -> warn (cannot verify freshness).
  const no_fetch_git = scripted_git(
    [
      entry("rev-parse --show-toplevel", command_result_ok("/fleet\n")),
      entry("fetch origin --quiet", command_result_fail(1, "network down")),
      entry("rev-parse HEAD", command_result_ok("aaaa\n")),
      entry("rev-parse origin/main", command_result_fail(1, "unknown revision")),
    ],
  )
  assert_eq(fleet_self_check(no_fetch_git, always_exists, {mode: "ship-pr"}).action, "warn")
}
