import { render_bump_workflow } from "../lib/bump_workflow_projection"
import { FleetManifest, FleetRepository } from "../lib/fleet_manifest"
import {
  BUMP_ADAPTER_PATH,
  PACKAGE_CI_PATH,
  fleet_projection_sources,
  fleet_projection_targets,
  group_projection_targets_by_repository,
  projection_source_key,
} from "../lib/fleet_projection_targets"
import { render_package_ci } from "../lib/package_ci_projection"

fn bump_repo(slug: string, directory: string) -> FleetRepository {
  return {
    slug: slug,
    directory: directory,
    harn_bump: true,
    bump_workflow_ownership: "fleet",
    bump_validate_command: "harn check",
  }
}

fn bump_and_package_repo(slug: string, directory: string) -> FleetRepository {
  return {
    slug: slug,
    directory: directory,
    harn_bump: true,
    bump_workflow_ownership: "fleet",
    harn_package: true,
    package_ci_ownership: "fleet",
  }
}

fn manifest(repositories: list, projections: list) -> FleetManifest {
  return {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow:
        "owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      bump_workflow:
        "owner/harn/.github/workflows/bump.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    file_projections: projections,
    repositories: repositories,
  }
}

pipeline test_targets_are_the_bytes_the_manifest_renders() {
  const repo = bump_repo("owner/bumped", "bumped")
  const targets = fleet_projection_targets(manifest([repo], []), {})
  assert_eq(len(targets), 1)
  assert_eq(targets[0]?.slug, "owner/bumped")
  assert_eq(targets[0]?.path, BUMP_ADAPTER_PATH)
  assert_eq(targets[0]?.expected, render_bump_workflow(manifest([repo], []), repo))
}

pipeline test_a_repository_can_own_both_generated_workflows() {
  const repo = bump_and_package_repo("owner/both", "both")
  const targets = fleet_projection_targets(manifest([repo], []), {})
  assert_eq(targets.map({ target -> target.path }).to_list(), [BUMP_ADAPTER_PATH, PACKAGE_CI_PATH])
  assert_eq(targets[1]?.expected, render_package_ci(manifest([repo], []), repo))
}

pipeline test_only_whole_file_ownership_is_projected() {
  // `"pin"` package CI owns one `uses:` line inside a workflow the repository
  // otherwise writes itself. Rendering the whole file over it would delete that
  // repository's own jobs, so it must not appear as a target at all.
  const pinned: FleetRepository = {
    slug: "owner/pinned",
    directory: "pinned",
    harn_package: true,
    package_ci_ownership: "pin",
  }
  const unowned: FleetRepository = {slug: "owner/unowned", directory: "unowned", harn_bump: true}
  assert_eq(fleet_projection_targets(manifest([pinned, unowned], []), {}), [])
}

pipeline test_a_copied_projection_carries_its_source_bytes() {
  const projection = {
    source_slug: "owner/source",
    source_path: "index.toml",
    target_slug: "owner/target",
    target_path: "generated/index.toml",
  }
  const key = projection_source_key("owner/source", "index.toml")
  assert_eq(key, "owner/source:index.toml")
  let sources = {}
  sources[key] = "version = 2\n"
  const targets = fleet_projection_targets(manifest([], [projection]), sources)
  assert_eq(len(targets), 1)
  assert_eq(targets[0]?.slug, "owner/target")
  assert_eq(targets[0]?.path, "generated/index.toml")
  assert_eq(targets[0]?.expected, "version = 2\n")
  assert_eq(targets[0]?.origin, key)
}

pipeline test_a_copy_with_no_source_is_not_a_target() {
  // Falsifier for the tempting shortcut of defaulting an unread source to the
  // target's own bytes: that reports clean and ratifies the drift it was asked
  // to repair.
  const projection = {
    source_slug: "owner/source",
    source_path: "index.toml",
    target_slug: "owner/target",
    target_path: "generated/index.toml",
  }
  assert_eq(fleet_projection_targets(manifest([], [projection]), {}), [])
}

pipeline test_sources_are_listed_once_each() {
  const projection = {
    source_slug: "owner/source",
    source_path: "index.toml",
    target_slug: "owner/target",
    target_path: "a.toml",
  }
  const second = projection + {target_path: "b.toml"}
  const sources = fleet_projection_sources(manifest([], [projection, second]))
  assert_eq(len(sources), 1)
  assert_eq(sources[0]?.slug, "owner/source")
  assert_eq(sources[0]?.path, "index.toml")
}

pipeline test_grouping_gives_one_proposal_per_repository() {
  // Two drifted files in one repository must become one pull request, not two.
  const repo = bump_and_package_repo("owner/both", "both")
  const other = bump_repo("owner/other", "other")
  const groups = group_projection_targets_by_repository(
    fleet_projection_targets(manifest([repo, other], []), {}),
  )
  assert_eq(groups.map({ group -> group.slug }).to_list(), ["owner/both", "owner/other"])
  assert_eq(len(groups[0]?.targets ?? []), 2)
  assert_eq(len(groups[1]?.targets ?? []), 1)
}
