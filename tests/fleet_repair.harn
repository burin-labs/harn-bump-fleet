pipeline test_a_recovery_carries_the_title_area_its_consumer_declares(task: any) {
  const gated = repo("burin-labs/pkg") + {pr_title_gate: true, pr_title_area: "Harn"}
  const rows = snapshot(
    [
      {
        repo: "burin-labs/pkg",
        state: "failed",
        reason: "target_branch_missing_pull_request",
        pin: "0.10.94",
        branch_pin: "0.10.95",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      },
    ],
  )
  const plan = fleet_repair_plan(rows, [gated], POLICY)
  assert_eq(plan.recoveries[0]?.pr_title_area ?? "", "Harn")
  assert_eq(
    pr_title_for_consumer(plan.recoveries[0]?.pr_title_area ?? "", "Bump Harn runtime"),
    "[Harn] Bump Harn runtime",
  )
  const ungated = fleet_repair_plan(rows, [repo("burin-labs/pkg")], POLICY)
  assert_eq(
    pr_title_for_consumer(ungated.recoveries[0]?.pr_title_area ?? "", "Bump Harn runtime"),
    "Bump Harn runtime",
  )
}

pipeline test_manifest_default_admits_every_failed_repo(task: any) {
  const slugs = ["burin-labs/one", "burin-labs/two", "burin-labs/three", "burin-labs/four"]
  const repositories = slugs.map({ slug -> repo(slug) }).to_list()
  const rows = slugs.map(
    { slug ->
      {
        repo: slug,
        state: "failed",
        reason: "checks_failing",
        pr_number: 42,
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      }
    },
  )
    .to_list()
  const policy = POLICY
    + {max_repositories: fleet_repair_repository_limit(nil, len(repositories))}
  const plan = fleet_repair_plan(snapshot(rows), repositories, policy)
  assert_eq(len(plan.candidates), 4)
  assert_eq(plan.refused, [])
}

pipeline test_refuses_non_code_failure_and_missing_validator(task: any) {
  const plan = fleet_repair_plan(
    snapshot(
      [
        {repo: "burin-labs/ops", state: "failed", reason: "merge_state_blocked"},
        {
          repo: "burin-labs/pkg",
          state: "failed",
          reason: "checks_failing",
          pr_number: 42,
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        },
      ],
    ),
    [repo("burin-labs/ops"), repo("burin-labs/pkg", nil)],
    POLICY,
  )
  assert_eq(len(plan.candidates), 0)
  assert_eq(plan.refused[0]?.reason, "failure_not_code_repairable:merge_state_blocked")
  assert_eq(plan.refused[1]?.reason, "missing_manifest_validator")
}

