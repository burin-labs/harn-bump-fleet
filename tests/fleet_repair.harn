pipeline test_terminal_outcomes_distinguish_justified_noop_from_failed_noop(task: any) {
  const common = {
    repo: "burin-labs/pkg",
    old_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    attempts: [],
    known_cost_usd: 0.0,
    cost_status: "exact",
  }
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "repaired",
          reason: "validated_published_and_auto_merge_armed",
          new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          source_mutation: {
            before_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            after_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            commit_created: true,
            pushed_head_observed: true,
          },
        },
    ),
    "mutated",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "repaired",
          reason: "validated_published_and_auto_merge_armed",
          new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        },
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "repaired",
          reason: "validated_published_and_auto_merge_armed",
          new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          source_mutation: {
            before_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            after_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            commit_created: true,
            pushed_head_observed: false,
          },
        },
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "no_change",
          reason: "leased_checkout_already_valid",
          validation_evidence: [
            {attempt: 0, command: "harn package verify .", ok: true, diagnostic: "passed"},
          ],
        },
    ),
    "already_repaired",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common + {status: "no_change", reason: "validator_passed_without_repair_delta"},
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common + {status: "no_change", reason: "leased_checkout_already_valid"},
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "no_change",
          reason: "leased_checkout_already_valid",
          new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          validation_evidence: [
            {attempt: 0, command: "harn package verify .", ok: true, diagnostic: "passed"},
          ],
        },
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(common + {status: "refused", reason: "repair_disabled"}),
    "declined",
  )
}

pipeline test_identical_head_recovery_requires_observed_control_plane_change(task: any) {
  const common = {
    repo: "burin-labs/pkg",
    status: "repaired",
    old_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    new_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    attempts: [],
    known_cost_usd: 0.0,
    cost_status: "exact",
  }
  assert_eq(
    fleet_repair_terminal_outcome(common + {reason: "target_branch_presented_auto_merge_withheld"}),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          reason: "target_branch_presented_and_auto_merge_armed",
          control_plane_mutation: {
            pull_request_present_before: true,
            pull_request_present_after: true,
            auto_merge_before: true,
            auto_merge_after: true,
          },
        },
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          reason: "target_branch_presented_and_auto_merge_armed",
          control_plane_mutation: {
            pull_request_present_before: true,
            pull_request_present_after: true,
            auto_merge_before: false,
            auto_merge_after: true,
          },
        },
    ),
    "mutated",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          reason: "target_branch_presented_auto_merge_withheld",
          control_plane_mutation: {
            pull_request_present_before: false,
            pull_request_present_after: true,
            auto_merge_before: false,
            auto_merge_after: false,
          },
        },
    ),
    "mutated",
  )
}

pipeline test_receipt_fails_closed_on_unchanged_or_missing_red_repository(task: any) {
  const plan = terminal_plan()
  const unchanged = fleet_repair_receipt(
    plan,
    [
      {
        repo: "burin-labs/pkg",
        status: "no_change",
        reason: "validator_passed_without_repair_delta",
        old_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        attempts: [
          {
            attempt: 1,
            validation_ok: true,
            validation_output: "validation passed but the checkout did not change",
            agent_status: "completed",
            route: "value",
            route_reason: "initial repair attempt",
            provider: "test",
            model: "test",
            usage: {
              provider: "test",
              model: "test",
              tokens_used: 0,
              cost_status: "exact",
              cost_usd: 0.0,
              known_cost_usd: 0.0,
              unpriced_calls: 0,
              usage_unknown_calls: 0,
            },
          },
        ],
        known_cost_usd: 0.0,
        cost_status: "exact",
      },
    ],
    POLICY,
  )
  assert_eq(unchanged.ok, false)
  const unchanged_result = unchanged.results[0]
  assert(unchanged_result != nil)
  assert_eq(unchanged_result.terminal_outcome, "failed")
  assert_eq(unchanged_result.before_head_sha, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  assert_eq(unchanged_result.after_head_sha, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  assert_eq(unchanged_result.mutation.head_changed, false)
  assert_eq(unchanged_result.attempted_validations[0]?.command, "harn package verify .")
  assert_eq(unchanged_result.attempted_validations[0]?.ok, true)
  const missing = fleet_repair_receipt(plan, [], POLICY)
  assert_eq(missing.ok, false)
  assert_eq(missing.results[0]?.terminal_outcome, "failed")
  assert_eq(missing.results[0]?.reason, "missing_terminal_outcome")
}

pipeline test_receipt_accepts_an_observed_published_head(task: any) {
  const receipt = fleet_repair_receipt(
    terminal_plan(),
    [
      {
        repo: "burin-labs/pkg",
        status: "repaired",
        reason: "validated_published_and_auto_merge_armed",
        old_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        source_mutation: {
          before_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          after_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          commit_created: true,
          pushed_head_observed: true,
        },
        attempts: [],
        known_cost_usd: 0.0,
        cost_status: "exact",
      },
    ],
    POLICY,
  )
  assert_eq(receipt.ok, true)
  const result = receipt.results[0]
  assert(result != nil)
  assert_eq(result.terminal_outcome, "mutated")
  assert_eq(result.mutation.commit_created, true)
  assert_eq(result.mutation.pushed_head_observed, true)
}
