import { shell_quote } from "std/runtime"
import {
  FleetRepairPolicy,
  fleet_repair_authority_audit,
  fleet_repair_authorized_new_file_path,
  fleet_repair_new_file_allowed,
  fleet_repair_route,
  fleet_repair_session_id,
  fleet_repair_terminal_outcome,
  fleet_repair_validate_candidate,
  fleet_repair_validation_environment_blocked,
  fleet_repair_validation_findings,
  repair_fleet_candidate_in_checkout,
} from "../lib/fleet_repair"

const POLICY: FleetRepairPolicy = {
  max_repositories: 1,
  max_rounds: 4,
  max_attempts_per_repository: 2,
  max_tokens_per_attempt: 4000,
  max_cost_per_attempt_usd: 0.3,
  max_cost_per_repository_usd: 0.6,
  max_cost_per_run_usd: 4.0,
  runtime_provenance: {
    harn_version: "v0.10.96",
    controller_revision: "test",
    repair_contract_revision: "harn-update-repair-v11",
  },
  provider_secret_reference: "CEREBRAS_API_KEY",
}

fn thrown(callback: any) -> string {
  return try {
    callback()
    ""
  } catch (error) {
    to_string(error)
  }
}

fn checked_shell(process: HarnessProcess, command: string) {
  const result = process.shell(command)
  assert(result.success, result.combined)
  return result
}

/**
 * Replay the harn-cloud validator shape through the real deterministic repair
 * seam. The consumer command names its exact source checkout from the release
 * target and runner scratch root; neither value may come from ambient process
 * state, and scratch owned by the repair must not survive the validation.
 */
pipeline test_candidate_validation_receives_exact_target_and_owned_temp_context(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("fleet-validator-context-")
  const checkout = path_join(root, "consumer")
  const observed = path_join(root, "observed-context")
  harness.fs.mkdir(checkout)
  harness.fs.write_text(path_join(checkout, "seed.txt"), "seed\n")
  checked_shell(
    harness.process,
    "git -C "
      + shell_quote(checkout)
      + " init -q && git -C "
      + shell_quote(checkout)
      + " config user.email test@example.test && git -C "
      + shell_quote(checkout)
      + " config user.name test && git -C "
      + shell_quote(checkout)
      + " add seed.txt && git -C "
      + shell_quote(checkout)
      + " -c commit.gpgsign=false commit -q -m seed",
  )
  const head = trim(
    checked_shell(harness.process, "git -C " + shell_quote(checkout) + " rev-parse HEAD").stdout,
  )
  const command = "test \"$HARN_BUMP_TARGET_TAG\" = v0.10.125"
    + " && test -n \"$RUNNER_TEMP\""
    + " && test -d \"$RUNNER_TEMP\""
    + " && printf '%s\\n%s\\n' \"$HARN_BUMP_TARGET_TAG\" \"$RUNNER_TEMP\" > "
    + shell_quote(observed)
  const result = repair_fleet_candidate_in_checkout(
    harness,
    {
      repo: "burin-labs/harn-cloud",
      directory: checkout,
      pr_number: 42,
      pr_url: "https://github.com/burin-labs/harn-cloud/pull/42",
      head_sha: head,
      validation_command: command,
      failing_checks: [],
      allowed_new_files: [],
      branch: "automation/bump-harn-runtime",
      auto_arm: true,
      require_signed_head: true,
    },
    "v0.10.125",
    POLICY + {deterministic_only: true},
  )
  assert_eq([result.status, result.reason], ["no_change", "leased_checkout_already_valid"])
  const context = harness.fs.read_lines(observed)
  assert_eq(context[0], "v0.10.125")
  assert(starts_with(context[1], harness.fs.workspace_temp_dir() + "/"))
  assert_eq(harness.fs.exists(context[1]), false)
}

/** Invalid context is rejected before the consumer shell can execute. */
pipeline test_candidate_validation_refuses_malformed_target_and_temp_escape_before_launch(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("fleet-validator-refusal-")
  const checkout = path_join(root, "consumer")
  const marker = path_join(root, "validator-executed")
  const private_temp = harness.fs.mkdtemp_in_workspace("fleet-validator-valid-")
  harness.fs.mkdir(checkout)
  const candidate = {
    repo: "burin-labs/harn-cloud",
    directory: checkout,
    pr_number: 42,
    pr_url: "https://github.com/burin-labs/harn-cloud/pull/42",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    validation_command: "printf executed > " + shell_quote(marker),
    failing_checks: [],
    allowed_new_files: [],
    branch: "automation/bump-harn-runtime",
    auto_arm: true,
    require_signed_head: true,
  }
  const malformed = thrown(
    { ->
      fleet_repair_validate_candidate(
        pick(harness, ["fs", "process"]),
        candidate,
        {target: "v0.10.125; touch escaped", private_temp_root: private_temp},
      )
    },
  )
  assert(contains(malformed, "exact vX.Y.Z release tag"))
  assert_eq(harness.fs.exists(marker), false)
  const prerelease = thrown(
    { ->
      fleet_repair_validate_candidate(
        pick(harness, ["fs", "process"]),
        candidate,
        {target: "v0.10.125-rc.1", private_temp_root: private_temp},
      )
    },
  )
  assert(contains(prerelease, "exact vX.Y.Z release tag"))
  assert_eq(harness.fs.exists(marker), false)
  const escaped = thrown(
    { ->
      fleet_repair_validate_candidate(
        pick(harness, ["fs", "process"]),
        candidate,
        {
          target: "v0.10.125",
          private_temp_root: path_join(harness.fs.workspace_temp_dir(), "..", "escaped"),
        },
      )
    },
  )
  assert(contains(escaped, "validator temp root"))
  assert_eq(harness.fs.exists(marker), false)
  harness.fs.delete(private_temp)
}

pipeline test_new_files_require_one_exact_manifest_authorization(task: any) {
  const allowed = ["changelog.d/harn-update.fixed.md"]
  assert_eq(fleet_repair_new_file_allowed("changelog.d/harn-update.fixed.md", allowed), true)
  assert_eq(fleet_repair_new_file_allowed("changelog.d/other.fixed.md", allowed), false)
  assert_eq(fleet_repair_new_file_allowed("../secrets", allowed), false)
  const candidate = {
    repo: "burin-labs/pkg",
    directory: "/tmp/isolated-checkout",
    pr_number: 42,
    pr_url: "https://example.test/pkg/42",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    validation_command: "harn package verify .",
    failing_checks: [],
    allowed_new_files: allowed,
    branch: "automation/bump-harn-runtime",
    auto_arm: true,
    require_signed_head: true,
  }
  assert_eq(
    fleet_repair_authorized_new_file_path(candidate, "changelog.d/harn-update.fixed.md"),
    "/tmp/isolated-checkout/changelog.d/harn-update.fixed.md",
  )
  assert(
    contains(
      thrown(
        { -> fleet_repair_authorized_new_file_path(candidate, "changelog.d/not-authorized.md") },
      ),
      "manifest-authorized",
    ),
  )
}

pipeline test_repair_sessions_are_anchored_to_checkout_head_route_and_contract(task: any) {
  const candidate = {
    repo: "burin-labs/pkg",
    directory: "/tmp/one",
    pr_number: 42,
    pr_url: "https://example.test/pkg/42",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    validation_command: "harn package verify .",
    failing_checks: [],
    allowed_new_files: [],
    branch: "automation/bump-harn-runtime",
    auto_arm: true,
    require_signed_head: true,
  }
  const value = fleet_repair_route(POLICY, 1, [])
  const strong = fleet_repair_route(POLICY + {route_override: "strong"}, 1, [])
  const key = fleet_repair_session_id(
    candidate,
    POLICY.runtime_provenance,
    value,
    "openrouter",
    "qwen/value",
    1,
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate + {directory: "/tmp/two"},
        POLICY.runtime_provenance,
        value,
        "openrouter",
        "qwen/value",
        1,
      ),
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate + {head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
        POLICY.runtime_provenance,
        value,
        "openrouter",
        "qwen/value",
        1,
      ),
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate,
        POLICY.runtime_provenance,
        strong,
        "openrouter",
        "qwen/value",
        1,
      ),
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate,
        POLICY.runtime_provenance,
        value,
        "openrouter",
        "openai/strong",
        1,
      ),
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate,
        POLICY.runtime_provenance + {controller_revision: "other"},
        value,
        "openrouter",
        "qwen/value",
        1,
      ),
  )
  assert_eq(strong.reason, "explicit_rehearsal_route")
}

pipeline test_failed_validation_is_carried_to_the_next_repair_attempt(task: any) {
  const findings = fleet_repair_validation_findings(false, "clippy: exact failure")
  assert_eq(findings, ["clippy: exact failure"])
  assert_eq(fleet_repair_route(POLICY, 2, findings).tier, "strong")
  assert_eq(fleet_repair_validation_findings(true, "ignored"), [])
}

pipeline test_environment_failure_never_enters_source_repair(task: any) {
  assert_eq(
    fleet_repair_validation_environment_blocked(
      "error: Thrown: {category: environment, error: io_error, message: invalid argument}",
    ),
    true,
  )
  assert_eq(
    fleet_repair_validation_environment_blocked(
      "validator could not start under prepared process authority: outside launchable roots",
    ),
    true,
  )
  assert_eq(fleet_repair_validation_environment_blocked("error[E0308]: mismatched types"), false)
}

fn authority_plan() {
  return {
    target: "v0.10.78",
    recoveries: [],
    refused: [],
    candidates: [
      {
        repo: "burin-labs/pkg",
        directory: "/tmp/isolated-checkout",
        pr_number: 42,
        pr_url: "https://example.test/pkg/42",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        validation_command: "harn package verify .",
        failing_checks: [],
        allowed_new_files: [],
        branch: "automation/bump-harn-runtime",
        auto_arm: true,
        require_signed_head: true,
      },
    ],
  }
}

fn authority_result(reason: string, diagnostic: string) {
  return {
    repo: "burin-labs/pkg",
    status: "failed",
    reason: reason,
    validation_evidence: [
      {attempt: 0, command: "harn package verify .", ok: false, diagnostic: diagnostic},
    ],
    attempts: [],
    known_cost_usd: 0.0,
    cost_status: "exact",
  }
}

pipeline test_validator_authority_audit_distinguishes_started_denied_missing_and_malformed() {
  const key = "process:validator=burin-labs/pkg"
  const started = fleet_repair_authority_audit(
    authority_plan(),
    [authority_result("validation_attempts_exhausted", "package validation failed")],
    POLICY,
  )
  assert(started.requested.contains(key))
  assert(started.granted.contains(key))
  assert(started.used.contains(key))
  assert(!started.denied.contains(key))
  assert(started.granted.contains("filesystem:checkout-root=/tmp/isolated-checkout"))
  assert(!started.granted.contains("tool:repair_read"))
  const refused = fleet_repair_authority_audit(
    authority_plan(),
    [
      authority_result(
        "validator_environment_unavailable",
        "validator could not start under prepared process authority: outside launchable roots",
      ),
    ],
    POLICY,
  )
  assert(refused.requested.contains(key))
  assert(!refused.granted.contains(key))
  assert(!refused.used.contains(key))
  assert(refused.denied.contains(key))
  assert(refused.requested != refused.granted)
  const missing = fleet_repair_authority_audit(authority_plan(), [], POLICY)
  assert(missing.requested.contains(key))
  assert(!missing.granted.contains(key))
  assert(!missing.used.contains(key))
  assert(!missing.denied.contains(key))
  assert(missing.unused.contains(key))
  const malformed = fleet_repair_authority_audit(
    authority_plan(),
    [
      authority_result(
        "validation_attempts_exhausted",
        "validator could not start under prepared process authority: outside launchable roots",
      ),
    ],
    POLICY,
  )
  assert(!malformed.granted.contains(key))
  assert(!malformed.used.contains(key))
  assert(malformed.denied.contains("authority:malformed-validator-evidence=burin-labs/pkg"))
}

pipeline test_terminal_outcomes_distinguish_justified_noop_from_failed_noop(task: any) {
  const common = {
    repo: "burin-labs/pkg",
    old_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    attempts: [],
    known_cost_usd: 0.0,
    cost_status: "exact",
  }
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "repaired",
          reason: "validated_published_and_auto_merge_armed",
          new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          source_mutation: {
            before_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            after_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            commit_created: true,
            pushed_head_observed: true,
          },
        },
    ),
    "mutated",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "repaired",
          reason: "validated_published_and_auto_merge_armed",
          new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        },
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "repaired",
          reason: "validated_published_and_auto_merge_armed",
          new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          source_mutation: {
            before_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            after_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            commit_created: true,
            pushed_head_observed: false,
          },
        },
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "no_change",
          reason: "leased_checkout_already_valid",
          validation_evidence: [
            {attempt: 0, command: "harn package verify .", ok: true, diagnostic: "passed"},
          ],
        },
    ),
    "already_repaired",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common + {status: "no_change", reason: "validator_passed_without_repair_delta"},
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common + {status: "no_change", reason: "leased_checkout_already_valid"},
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          status: "no_change",
          reason: "leased_checkout_already_valid",
          new_head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          validation_evidence: [
            {attempt: 0, command: "harn package verify .", ok: true, diagnostic: "passed"},
          ],
        },
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(common + {status: "refused", reason: "repair_disabled"}),
    "declined",
  )
}

pipeline test_identical_head_recovery_requires_observed_control_plane_change(task: any) {
  const common = {
    repo: "burin-labs/pkg",
    status: "repaired",
    old_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    new_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    attempts: [],
    known_cost_usd: 0.0,
    cost_status: "exact",
  }
  assert_eq(
    fleet_repair_terminal_outcome(common + {reason: "target_branch_presented_auto_merge_withheld"}),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          reason: "target_branch_presented_and_auto_merge_armed",
          control_plane_mutation: {
            pull_request_present_before: true,
            pull_request_present_after: true,
            auto_merge_before: true,
            auto_merge_after: true,
          },
        },
    ),
    "failed",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          reason: "target_branch_presented_and_auto_merge_armed",
          control_plane_mutation: {
            pull_request_present_before: true,
            pull_request_present_after: true,
            auto_merge_before: false,
            auto_merge_after: true,
          },
        },
    ),
    "mutated",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          reason: "target_branch_presented_and_ship_armed",
          control_plane_mutation: {
            pull_request_present_before: true,
            pull_request_present_after: true,
            auto_merge_before: false,
            auto_merge_after: false,
            ship_before: false,
            ship_after: true,
          },
        },
    ),
    "mutated",
  )
  assert_eq(
    fleet_repair_terminal_outcome(
      common
        + {
          reason: "target_branch_presented_auto_merge_withheld",
          control_plane_mutation: {
            pull_request_present_before: false,
            pull_request_present_after: true,
            auto_merge_before: false,
            auto_merge_after: false,
          },
        },
    ),
    "mutated",
  )
}
