import { FleetConvergenceSnapshot } from "../lib/fleet_convergence"
import { FleetRepository } from "../lib/fleet_manifest"
import {
  FleetRepairPolicy,
  REPAIR_EGRESS_ALLOW,
  fleet_repair_authority_audit,
  fleet_repair_authorized_new_file_path,
  fleet_repair_egress_readiness,
  fleet_repair_new_file_allowed,
  fleet_repair_plan,
  fleet_repair_receipt,
  fleet_repair_repository_limit,
  fleet_repair_route,
  fleet_repair_safe_attempt_limit,
  fleet_repair_session_id,
  fleet_repair_terminal_outcome,
  fleet_repair_validation_environment_blocked,
  fleet_repair_validation_findings,
} from "../lib/fleet_repair"
import { pr_title_for_consumer } from "../lib/pr_title_convention"

const POLICY: FleetRepairPolicy = {
  max_repositories: 1,
  max_rounds: 4,
  max_attempts_per_repository: 2,
  max_tokens_per_attempt: 4000,
  max_cost_per_attempt_usd: 0.3,
  max_cost_per_repository_usd: 0.6,
  max_cost_per_run_usd: 4.0,
  runtime_provenance: {
    harn_version: "v0.10.96",
    controller_revision: "test",
    repair_contract_revision: "harn-update-repair-v10",
  },
  provider_secret_reference: "CEREBRAS_API_KEY",
}

fn thrown(callback: any) -> string {
  return try {
    callback()
    ""
  } catch (error) {
    to_string(error)
  }
}

pipeline test_default_repository_limit_covers_the_manifest() {
  assert_eq(fleet_repair_repository_limit(nil, 4), 4)
  assert_eq(fleet_repair_repository_limit(2, 4), 2)
}

pipeline test_repair_egress_requires_the_exact_prepared_allowlist(task: any) {
  assert_eq(
    fleet_repair_egress_readiness(REPAIR_EGRESS_ALLOW, "deny", "private"),
    {ready: true, reason: "exact repair destinations are prepared"},
  )
  assert_eq(fleet_repair_egress_readiness("api.github.com:443", "deny", "private").ready, false)
  assert_eq(fleet_repair_egress_readiness(REPAIR_EGRESS_ALLOW, "allow", "private").ready, false)
  assert_eq(fleet_repair_egress_readiness(REPAIR_EGRESS_ALLOW, "deny", "off").ready, false)
}

pipeline test_each_attempt_reserves_all_remaining_retry_budget() {
  const policy = POLICY + {max_attempts_per_repository: 3, max_cost_per_attempt_usd: 0.6}
  const first_limit = fleet_repair_safe_attempt_limit(policy, 0.0, 0.0)
  const late_limit = fleet_repair_safe_attempt_limit(policy, 0.0, 3.7)
  assert(first_limit > 0.199 && first_limit < 0.201)
  assert(late_limit > 0.099 && late_limit < 0.101)
}

pipeline test_new_files_require_one_exact_manifest_authorization(task: any) {
  const allowed = ["changelog.d/harn-update.fixed.md"]
  assert_eq(fleet_repair_new_file_allowed("changelog.d/harn-update.fixed.md", allowed), true)
  assert_eq(fleet_repair_new_file_allowed("changelog.d/other.fixed.md", allowed), false)
  assert_eq(fleet_repair_new_file_allowed("../secrets", allowed), false)
  const candidate = {
    repo: "burin-labs/pkg",
    directory: "/tmp/isolated-checkout",
    pr_number: 42,
    pr_url: "https://example.test/pkg/42",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    validation_command: "harn package verify .",
    failing_checks: [],
    allowed_new_files: allowed,
    branch: "automation/bump-harn-runtime",
    auto_arm: true,
    require_signed_head: true,
  }
  assert_eq(
    fleet_repair_authorized_new_file_path(candidate, "changelog.d/harn-update.fixed.md"),
    "/tmp/isolated-checkout/changelog.d/harn-update.fixed.md",
  )
  assert(
    contains(
      thrown(
        { -> fleet_repair_authorized_new_file_path(candidate, "changelog.d/not-authorized.md") },
      ),
      "manifest-authorized",
    ),
  )
}

pipeline test_repair_sessions_are_anchored_to_checkout_head_route_and_contract(task: any) {
  const candidate = {
    repo: "burin-labs/pkg",
    directory: "/tmp/one",
    pr_number: 42,
    pr_url: "https://example.test/pkg/42",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    validation_command: "harn package verify .",
    failing_checks: [],
    allowed_new_files: [],
    branch: "automation/bump-harn-runtime",
    auto_arm: true,
    require_signed_head: true,
  }
  const value = fleet_repair_route(POLICY, 1, [])
  const strong = fleet_repair_route(POLICY + {route_override: "strong"}, 1, [])
  const key = fleet_repair_session_id(
    candidate,
    POLICY.runtime_provenance,
    value,
    "openrouter",
    "qwen/value",
    1,
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate + {directory: "/tmp/two"},
        POLICY.runtime_provenance,
        value,
        "openrouter",
        "qwen/value",
        1,
      ),
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate + {head_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
        POLICY.runtime_provenance,
        value,
        "openrouter",
        "qwen/value",
        1,
      ),
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate,
        POLICY.runtime_provenance,
        strong,
        "openrouter",
        "qwen/value",
        1,
      ),
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate,
        POLICY.runtime_provenance,
        value,
        "openrouter",
        "openai/strong",
        1,
      ),
  )
  assert(
    key
      != fleet_repair_session_id(
        candidate,
        POLICY.runtime_provenance + {controller_revision: "other"},
        value,
        "openrouter",
        "qwen/value",
        1,
      ),
  )
  assert_eq(strong.reason, "explicit_rehearsal_route")
}

pipeline test_failed_validation_is_carried_to_the_next_repair_attempt(task: any) {
  const findings = fleet_repair_validation_findings(false, "clippy: exact failure")
  assert_eq(findings, ["clippy: exact failure"])
  assert_eq(fleet_repair_route(POLICY, 2, findings).tier, "strong")
  assert_eq(fleet_repair_validation_findings(true, "ignored"), [])
}

pipeline test_environment_failure_never_enters_source_repair(task: any) {
  assert_eq(
    fleet_repair_validation_environment_blocked(
      "error: Thrown: {category: environment, error: io_error, message: invalid argument}",
    ),
    true,
  )
  assert_eq(
    fleet_repair_validation_environment_blocked(
      "validator could not start under prepared process authority: outside launchable roots",
    ),
    true,
  )
  assert_eq(fleet_repair_validation_environment_blocked("error[E0308]: mismatched types"), false)
}

fn authority_plan() {
  return {
    target: "v0.10.78",
    recoveries: [],
    refused: [],
    candidates: [
      {
        repo: "burin-labs/pkg",
        directory: "/tmp/isolated-checkout",
        pr_number: 42,
        pr_url: "https://example.test/pkg/42",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        validation_command: "harn package verify .",
        failing_checks: [],
        allowed_new_files: [],
        branch: "automation/bump-harn-runtime",
        auto_arm: true,
        require_signed_head: true,
      },
    ],
  }
}

fn authority_result(reason: string, diagnostic: string) {
  return {
    repo: "burin-labs/pkg",
    status: "failed",
    reason: reason,
    validation_evidence: [
      {attempt: 0, command: "harn package verify .", ok: false, diagnostic: diagnostic},
    ],
    attempts: [],
    known_cost_usd: 0.0,
    cost_status: "exact",
  }
}

pipeline test_validator_authority_audit_distinguishes_started_denied_missing_and_malformed() {
  const key = "process:validator=burin-labs/pkg"
  const started = fleet_repair_authority_audit(
    authority_plan(),
    [authority_result("validation_attempts_exhausted", "package validation failed")],
    POLICY,
  )
  assert(started.requested.contains(key))
  assert(started.granted.contains(key))
  assert(started.used.contains(key))
  assert(!started.denied.contains(key))
  assert(started.granted.contains("filesystem:checkout-root=/tmp/isolated-checkout"))
  assert(!started.granted.contains("tool:repair_read"))
  const refused = fleet_repair_authority_audit(
    authority_plan(),
    [
      authority_result(
        "validator_environment_unavailable",
        "validator could not start under prepared process authority: outside launchable roots",
      ),
    ],
    POLICY,
  )
  assert(refused.requested.contains(key))
  assert(!refused.granted.contains(key))
  assert(!refused.used.contains(key))
  assert(refused.denied.contains(key))
  assert(refused.requested != refused.granted)
  const missing = fleet_repair_authority_audit(authority_plan(), [], POLICY)
  assert(missing.requested.contains(key))
  assert(!missing.granted.contains(key))
  assert(!missing.used.contains(key))
  assert(!missing.denied.contains(key))
  assert(missing.unused.contains(key))
  const malformed = fleet_repair_authority_audit(
    authority_plan(),
    [
      authority_result(
        "validation_attempts_exhausted",
        "validator could not start under prepared process authority: outside launchable roots",
      ),
    ],
    POLICY,
  )
  assert(!malformed.granted.contains(key))
  assert(!malformed.used.contains(key))
  assert(malformed.denied.contains("authority:malformed-validator-evidence=burin-labs/pkg"))
}

fn repo(slug: string, validator: string? = "harn package verify .") -> FleetRepository {
  if validator == nil {
    return {
      slug: slug,
      directory: replace(slug, "burin-labs/", ""),
      harn_bump: true,
      bump_workflow_ownership: "fleet",
    }
  }
  return {
    slug: slug,
    directory: replace(slug, "burin-labs/", ""),
    harn_bump: true,
    bump_workflow_ownership: "fleet",
    bump_validate_command: validator ?? "",
  }
}

fn snapshot(rows: any) -> FleetConvergenceSnapshot {
  return {
    target: "v0.10.78",
    complete: false,
    terminal: true,
    total_count: len(rows),
    pending_count: 0,
    failing_count: len(rows),
    repositories: rows,
  }
}

pipeline test_admits_exact_failed_pr_with_manifest_validator(task: any) {
  const plan = fleet_repair_plan(
    snapshot(
      [
        {
          repo: "burin-labs/pkg",
          state: "failed",
          reason: "checks_failing",
          pr_number: 42,
          pr_url: "https://github.com/burin-labs/pkg/pull/42",
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          failing_checks: [{name: "CI", details_url: "https://example.test/run/1"}],
        },
      ],
    ),
    [repo("burin-labs/pkg")],
    POLICY,
  )
  assert_eq(len(plan.candidates), 1)
  assert_eq(plan.recoveries, [])
  assert_eq(plan.candidates[0]?.pr_number, 42)
  assert_eq(plan.candidates[0]?.validation_command, "harn package verify .")
  assert_eq(len(plan.refused), 0)
}

