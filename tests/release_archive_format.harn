import {
  HARN_TAR_XZ_FIRST_RELEASE,
  harn_release_artifacts,
  missing_release_assets,
  required_harn_release_assets,
} from "../lib/release_readiness"

fn archives(version: string?) -> list<string> {
  return harn_release_artifacts(version).map({ artifact -> artifact.archive }).to_list()
}

fn archives_with(unix: string) -> list<string> {
  return [
    "harn-aarch64-apple-darwin.${unix}",
    "harn-aarch64-unknown-linux-gnu.${unix}",
    "harn-x86_64-apple-darwin.${unix}",
    "harn-x86_64-pc-windows-msvc.zip",
    "harn-x86_64-unknown-linux-gnu.${unix}",
  ]
}

pipeline test_archive_format_follows_the_release_version(harness: Harness) {
  assert_eq(HARN_TAR_XZ_FIRST_RELEASE, "0.10.179")
  assert_eq(archives("0.10.178"), archives_with("tar.gz"))
  assert_eq(archives("v0.10.178"), archives_with("tar.gz"))
  assert_eq(archives("0.10.179"), archives_with("tar.xz"))
  assert_eq(archives("v0.10.179"), archives_with("tar.xz"))
  assert_eq(archives("v0.11.0"), archives_with("tar.xz"))
  assert_eq(archives("v0.9.99"), archives_with("tar.gz"))
}

pipeline test_unknown_prerelease_and_missing_versions_get_the_newest_format(harness: Harness) {
  assert_eq(archives(nil), archives_with("tar.xz"))
  assert_eq(archives("v0.10.100-rc.1"), archives_with("tar.xz"))
  assert_eq(archives("not-a-version"), archives_with("tar.xz"))
}

pipeline test_required_and_missing_assets_use_the_release_format(harness: Harness) {
  assert_eq(
    required_harn_release_assets("v0.10.178"),
    archives_with("tar.gz") + ["SHA256SUMS", "release-assets.json"],
  )
  assert_eq(
    required_harn_release_assets("v0.10.179"),
    archives_with("tar.xz") + ["SHA256SUMS", "release-assets.json"],
  )
  const old_listing = required_harn_release_assets("v0.10.178")
  assert_eq(missing_release_assets(old_listing, nil, "v0.10.178"), [])
  assert_eq(
    missing_release_assets(old_listing, nil, "v0.10.179"),
    [
      "harn-aarch64-apple-darwin.tar.xz",
      "harn-aarch64-unknown-linux-gnu.tar.xz",
      "harn-x86_64-apple-darwin.tar.xz",
      "harn-x86_64-unknown-linux-gnu.tar.xz",
    ],
  )
}
