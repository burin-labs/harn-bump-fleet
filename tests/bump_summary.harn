import {
  bump_summary_deterministic_facts,
  bump_summary_format_ok,
  bump_summary_problem_outcome,
  bump_summary_result,
} from "../lib/bump_summary"

fn summary_payload() {
  return {
    repos_total: 3,
    repos_dispatched: 2,
    outcomes: [
      {
        slug: "burin-labs/current",
        status: "already_current",
        detail: "remote main pin matches target",
        local_pin: "v1.2.2",
        remote_pin: "1.2.3",
        auto_merge: nil,
        duration_ms: 1000,
      },
      {
        slug: "burin-labs/failed",
        status: "dispatch_failed",
        detail: "workflow dispatch denied",
        auto_merge: nil,
        duration_ms: 2000,
      },
      {
        slug: "burin-labs/slow",
        status: "pr_open",
        detail: "PR opened",
        auto_merge: "enabled",
        duration_ms: 45000,
      },
    ],
  }
}

pipeline test_bump_summary(task) {
  assert_eq(bump_summary_format_ok("- nothing anomalous"), true)
  assert_eq(bump_summary_format_ok("Summary:\n- nothing anomalous"), false)
  const recovered = bump_summary_result(summary_payload(), ["Summary:\n- dispatch failed"])
  assert_eq(recovered.source, "deterministic_fallback")
  assert_eq(contains(recovered.text, "- status counts:"), true)
  assert_eq(contains(recovered.text, "- dispatched workflows: 2 of 3 repos"), true)
  assert_eq(
    contains(
      recovered.text,
      "local checkout drift: 1 repo(s): burin-labs/current: local 1.2.2, remote 1.2.3",
    ),
    true,
  )
  assert_eq(contains(recovered.text, "burin-labs/failed: dispatch_failed"), true)
  assert_eq(recovered.deterministic_facts.failure_count, 1)
  assert_eq(recovered.deterministic_facts.local_checkout_mismatch_count, 1)
  assert_eq(len(recovered.model_attempts), 1)
  assert_eq(recovered.model_attempts[0].format_ok, false)
  const ok = bump_summary_result(summary_payload(), ["- nothing anomalous"])
  assert_eq(ok.source, "local_llm")
  assert_eq(ok.text, "- nothing anomalous")
  assert_eq(ok.deterministic_facts.failure_count, 1)
  assert_eq(
    bump_summary_deterministic_facts(summary_payload()).status_counts[1].status,
    "dispatch_failed",
  )
  assert_eq(bump_summary_problem_outcome({status: "pr_open_schema_metadata_failed"}), true)
  assert_eq(bump_summary_problem_outcome({status: "pr_open_for_target_schema_metadata_failed"}), true)
}
