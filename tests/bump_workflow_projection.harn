import { render_bump_workflow, sync_bump_workflow_repo } from "../lib/bump_workflow_projection"
import { FleetManifest, FleetRepository } from "../lib/fleet_manifest"
import { decode_github_workflow } from "../lib/github_workflow"

fn package_repo() -> FleetRepository {
  return {
    slug: "owner/harn-example-connector",
    directory: "harn-example-connector",
    harn_package: true,
    harn_bump: true,
    bump_workflow_ownership: "fleet",
  }
}

fn manifest(repo: FleetRepository) -> FleetManifest {
  return {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow:
        "owner/policy/.github/workflows/harn-package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      bump_workflow:
        "owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    file_projections: [],
    repositories: [repo],
  }
}

pipeline test_render_bump_workflow_is_exact_for_package_defaults() {
  const repo = package_repo()
  assert_eq(
    render_bump_workflow(manifest(repo), repo),
    """name: Bump Harn Runtime

# fleet.toml in harn-bump-fleet owns this generated dispatch adapter.
on:
  workflow_dispatch:
    inputs:
      version:
        description: "Optional exact Harn tag (vX.Y.Z). Defaults to latest."
        required: false
        type: string

permissions:
  contents: read

jobs:
  bump:
    uses: owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
    with:
      version: \${{ inputs.version }}
      validate-command: harn package verify .
    secrets:
      app-client-id: \${{ secrets.RELEASE_APP_CLIENT_ID }}
      app-private-key: \${{ secrets.RELEASE_APP_PRIVATE_KEY }}
"""
      + "\n",
  )
}

pipeline test_render_bump_workflow_projects_named_custom_commands() {
  const repo: FleetRepository = {
    slug: "owner/application",
    directory: "application",
    harn_bump: true,
    bump_workflow_ownership: "fleet",
    bump_refresh_command: "./scripts/refresh\n./scripts/generate",
    bump_validate_command: "./scripts/verify",
    bump_node_version: "22",
  }
  const rendered = render_bump_workflow(manifest(repo), repo)
  const workflow = decode_github_workflow(rendered)
  assert_eq(
    workflow.jobs.get("bump")?.with,
    {
      version: "$" + "{{ inputs.version }}",
      "refresh-command": "./scripts/refresh\n./scripts/generate",
      "validate-command": "./scripts/verify",
      "node-version": "22",
    },
  )
}

pipeline test_render_bump_workflow_rejects_unowned_repository() {
  const repo: FleetRepository = {
    slug: "owner/application",
    directory: "application",
    harn_bump: true,
    bump_validate_command: "./scripts/verify",
  }
  const result = try {
    render_bump_workflow(manifest(repo), repo)
  }
  assert(is_err(result))
  assert(contains(to_string(unwrap_err(result)), "does not delegate bump workflow ownership"))
}

pipeline test_sync_bump_workflow_is_idempotent(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("bump-workflow-")
  const repo = package_repo()
  const checkout = path_join(root, repo.directory)
  harness.fs.mkdir(path_join(checkout, ".github/workflows"), true)
  harness.fs.write_text(path_join(checkout, ".git"), "gitdir: fixture\n")
  harness.fs.write_text(path_join(checkout, ".github/workflows/bump-harn.yml"), "old\n")
  const declared = manifest(repo)
  assert_eq(sync_bump_workflow_repo(harness.fs, declared, repo, root, false).status, "drift")
  assert_eq(sync_bump_workflow_repo(harness.fs, declared, repo, root, true).status, "applied")
  assert_eq(sync_bump_workflow_repo(harness.fs, declared, repo, root, false).status, "clean")
  assert_eq(
    harness.fs.read_text(path_join(checkout, ".github/workflows/bump-harn.yml")),
    render_bump_workflow(declared, repo),
  )
}
