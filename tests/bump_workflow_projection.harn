import { render_bump_workflow, sync_bump_workflow_repo } from "../lib/bump_workflow_projection"
import { FleetManifest, FleetRepository } from "../lib/fleet_manifest"
import { decode_github_workflow } from "../lib/github_workflow"

fn package_repo() -> FleetRepository {
  return {
    slug: "owner/harn-example-connector",
    directory: "harn-example-connector",
    harn_package: true,
    harn_bump: true,
    bump_workflow_ownership: "fleet",
  }
}

fn manifest(repo: FleetRepository) -> FleetManifest {
  return {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow:
        "owner/policy/.github/workflows/harn-package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      bump_workflow:
        "owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    file_projections: [],
    repositories: [repo],
  }
}

pipeline test_render_bump_workflow_is_exact_for_package_defaults() {
  const repo = package_repo()
  assert_eq(
    render_bump_workflow(manifest(repo), repo),
    """name: Bump Harn Runtime

# fleet.toml in harn-bump-fleet owns this generated dispatch adapter.
on:
  workflow_dispatch:
    inputs:
      version:
        description: "Optional exact Harn tag (vX.Y.Z). Defaults to latest."
        required: false
        type: string

permissions:
  contents: read

jobs:
  bump:
    uses: owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
    with:
      version: \${{ inputs.version }}
      validate-command: harn package verify .
      apply-behavior-preserving-fixes: false
    secrets:
      app-client-id: \${{ secrets.RELEASE_APP_CLIENT_ID }}
      app-private-key: \${{ secrets.RELEASE_APP_PRIVATE_KEY }}
"""
      + "\n",
  )
}

pipeline test_render_bump_workflow_projects_named_custom_commands() {
  const repo: FleetRepository = {
    slug: "owner/application",
    directory: "application",
    harn_bump: true,
    bump_workflow_ownership: "fleet",
    bump_refresh_command: "./scripts/refresh\n./scripts/generate",
    bump_validate_command: "./scripts/verify",
    bump_node_version: "22",
  }
  const rendered = render_bump_workflow(manifest(repo), repo)
  const workflow = decode_github_workflow(rendered)
  assert_eq(
    workflow.jobs.get("bump")?.with,
    {
      version: "$" + "{{ inputs.version }}",
      "refresh-command": "./scripts/refresh\n./scripts/generate",
      "validate-command": "./scripts/verify",
      "apply-behavior-preserving-fixes": false,
      "node-version": "22",
    },
  )
}

pipeline test_render_bump_workflow_projects_repairable_failure_policy() {
  const repo = package_repo()
  const declared = manifest(repo)
  const rendered = render_bump_workflow(
    declared + {policy: declared.policy + {publish_failures_for_repair: true}},
    repo,
  )
  const workflow = decode_github_workflow(rendered)
  assert_eq(workflow.jobs.get("bump")?.with?.get("publish-failure-for-repair"), true)
}

pipeline test_render_bump_workflow_rejects_unowned_repository() {
  const repo: FleetRepository = {
    slug: "owner/application",
    directory: "application",
    harn_bump: true,
    bump_validate_command: "./scripts/verify",
  }
  const result = try {
    render_bump_workflow(manifest(repo), repo)
  }
  assert(is_err(result))
  assert(contains(to_string(unwrap_err(result)), "does not delegate bump workflow ownership"))
}

pipeline test_sync_bump_workflow_is_idempotent(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("bump-workflow-")
  const repo = package_repo()
  const checkout = path_join(root, repo.directory)
  harness.fs.mkdir(path_join(checkout, ".github/workflows"), true)
  harness.fs.write_text(path_join(checkout, ".git"), "gitdir: fixture\n")
  harness.fs.write_text(path_join(checkout, ".github/workflows/bump-harn.yml"), "old\n")
  const declared = manifest(repo)
  assert_eq(sync_bump_workflow_repo(harness.fs, declared, repo, root, false).status, "drift")
  assert_eq(sync_bump_workflow_repo(harness.fs, declared, repo, root, true).status, "applied")
  assert_eq(sync_bump_workflow_repo(harness.fs, declared, repo, root, false).status, "clean")
  assert_eq(
    harness.fs.read_text(path_join(checkout, ".github/workflows/bump-harn.yml")),
    render_bump_workflow(declared, repo),
  )
}

pipeline test_refresh_notes_render_as_comments_without_changing_inputs() {
  // Rationale for a generated adapter has to live in the manifest that owns it.
  // Hand-editing it into the projected file puts it exactly where the next
  // `--apply` deletes it, which is how harn-cloud's --no-sandbox explanation
  // ended up as untracked drift.
  const repo: FleetRepository = {
    slug: "owner/application",
    directory: "application",
    harn_bump: true,
    bump_workflow_ownership: "fleet",
    bump_refresh_notes: "why the flag is here\n\n  indented detail stays indented",
    bump_refresh_command: "./scripts/refresh",
    bump_validate_command: "./scripts/verify",
  }
  const rendered = render_bump_workflow(manifest(repo), repo)
  assert(contains(rendered, "      # why the flag is here\n"))
  // A blank note line becomes a bare `#`, never `# ` with a trailing space.
  assert(contains(rendered, "\n      #\n"))
  assert(contains(rendered, "      #   indented detail stays indented\n"))
  // The comment sits directly above the command it explains.
  assert(contains(rendered, "      #   indented detail stays indented\n      refresh-command:"))
  // Comments are not inputs: the decoded `with:` mapping is untouched.
  const workflow = decode_github_workflow(rendered)
  assert_eq(
    workflow.jobs.get("bump")?.with,
    {
      version: "$" + "{{ inputs.version }}",
      "refresh-command": "./scripts/refresh",
      "validate-command": "./scripts/verify",
      "apply-behavior-preserving-fixes": false,
    },
  )
}

fn projected_behavior_preserving_fixes(declared: FleetManifest, repo: FleetRepository) -> any {
  return decode_github_workflow(render_bump_workflow(declared, repo)).jobs.get("bump")?.with?.get(
    "apply-behavior-preserving-fixes",
  )
}

pipeline test_behavior_preserving_fix_pass_is_off_by_fleet_default() {
  // harn#6837: the pass ships behavior-changing edits under a
  // behavior-preserving safety tier, so a repository that declares nothing
  // must not inherit the reusable workflow's own `default: true`.
  const repo = package_repo()
  assert_eq(projected_behavior_preserving_fixes(manifest(repo), repo), false)
}

pipeline test_repository_opts_back_into_the_behavior_preserving_fix_pass() {
  const repo = package_repo() + {bump_apply_behavior_preserving_fixes: true}
  assert_eq(projected_behavior_preserving_fixes(manifest(repo), repo), true)
}

pipeline test_policy_restores_the_behavior_preserving_fix_pass_fleet_wide() {
  // The documented revert once harn#6837 is fixed: one manifest line, not 28
  // repository edits.
  const repo = package_repo()
  const declared = manifest(repo)
  assert_eq(
    projected_behavior_preserving_fixes(
      declared + {policy: declared.policy + {apply_behavior_preserving_fixes: true}},
      repo,
    ),
    true,
  )
}

pipeline test_repository_opt_out_survives_a_restored_fleet_default() {
  // A present-but-false override must win over an enabled fleet default. If
  // the resolution treated a declared `false` as absent, this repository would
  // silently take the pass again the moment the fleet default returns.
  const repo = package_repo() + {bump_apply_behavior_preserving_fixes: false}
  const declared = manifest(repo)
  assert_eq(
    projected_behavior_preserving_fixes(
      declared + {policy: declared.policy + {apply_behavior_preserving_fixes: true}},
      repo,
    ),
    false,
  )
}

pipeline test_bump_arms_auto_merge_by_fleet_default() {
  // Armed stays the default: a routine bump should land on its own checks, and
  // the input is left absent rather than restated.
  const repo = package_repo()
  const rendered = render_bump_workflow(manifest(repo), repo)
  assert(!contains(rendered, "enable-auto-merge"))
  assert_eq(decode_github_workflow(rendered).jobs.get("bump")?.with?.get("enable-auto-merge"), nil)
}

pipeline test_repository_withholds_bump_auto_merge_arming() {
  // A repository whose bump decides something reserved for a person opens the
  // pull request but does not arm it.
  const repo = package_repo() + {bump_enable_auto_merge: false}
  assert_eq(
    decode_github_workflow(render_bump_workflow(manifest(repo), repo)).jobs.get("bump")?.with?.get(
      "enable-auto-merge",
    ),
    false,
  )
}

pipeline test_withholding_arming_leaves_the_fix_pass_projection_alone() {
  // The two bump overrides are independent; neither may quietly imply the other.
  const repo = package_repo() + {bump_enable_auto_merge: false}
  assert_eq(projected_behavior_preserving_fixes(manifest(repo), repo), false)
  const armed = package_repo() + {bump_apply_behavior_preserving_fixes: true}
  assert(!contains(render_bump_workflow(manifest(armed), armed), "enable-auto-merge"))
}

pipeline test_absent_refresh_notes_render_nothing() {
  const repo: FleetRepository = {
    slug: "owner/application",
    directory: "application",
    harn_bump: true,
    bump_workflow_ownership: "fleet",
    bump_refresh_command: "./scripts/refresh",
  }
  const rendered = render_bump_workflow(manifest(repo), repo)
  assert(!contains(rendered, "      #"))
  assert(contains(rendered, "      version: $" + "{{ inputs.version }}\n      refresh-command:"))
}
