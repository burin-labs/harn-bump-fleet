  planner_preflight_should_disable_binder,
} from "../lib/llm_defaults"

pipeline test_cost_budget(harness: Harness, task) {
  // Audit line renders the ceiling, or "uncapped" for a non-positive value.
  assert_eq(contains(cost_budget_audit_line(1.0), "$1"), true)
  assert_eq(contains(cost_budget_audit_line(1.0), "per run"), true)
  assert_eq(contains(cost_budget_audit_line(0.0), "uncapped"), true)
  // No env override -> default $1.00 ceiling is installed and returned.
  const limit = install_cost_budget(
    {env: harness.env, llm: harness.llm},
    "HARN_NONEXISTENT_COST_LIMIT_FOR_TEST",
  )
  assert_eq(limit, 1.0)
  // The Harn budget builtin now reports the installed ceiling.
  assert_eq(harness.llm.budget_remaining(), 1.0)
}

pipeline test_planner_defaults_with(task) {
  // No env at all -> cloud Qwen 3.6 default (ollama is never auto-selected).
  const cloud = planner_defaults_with({}, "HARN_RELEASE")
  assert_eq(cloud.provider, "openrouter")
  assert_eq(cloud.model, "qwen/qwen3.6-35b-a3b")
  assert_eq(cloud.source, "cloud_default")
  // OpenRouter key presence no longer changes the default — still cloud.
  const with_key = planner_defaults_with({OPENROUTER_API_KEY: "sk-or-test"}, "HARN_RELEASE")
  assert_eq(with_key.provider, "openrouter")
  assert_eq(with_key.model, "qwen/qwen3.6-35b-a3b")
  assert_eq(with_key.source, "cloud_default")
  // Ollama is opt-in only: name the provider explicitly to reach it, and
  // the local model fills in when no model override is given.
  const opt_in_local = planner_defaults_with({HARN_PLANNER_PROVIDER: "ollama"}, "HARN_RELEASE")
  assert_eq(opt_in_local.provider, "ollama")
  assert_eq(opt_in_local.model, "qwen3.6:35b-a3b-coding-nvfp4")
  assert_eq(opt_in_local.source, "env_planner_override")
  // Shared HARN_PLANNER_* override beats auto-detect.
  const shared = planner_defaults_with(
    {
      OPENROUTER_API_KEY: "sk-or-test",
      HARN_PLANNER_PROVIDER: "anthropic",
      HARN_PLANNER_MODEL: "claude-sonnet-4-7",
    },
    "HARN_RELEASE",
  )
  assert_eq(shared.provider, "anthropic")
  assert_eq(shared.model, "claude-sonnet-4-7")
  assert_eq(shared.source, "env_planner_override")
  // Per-role HARN_RELEASE_* beats the shared override.
  const role = planner_defaults_with(
    {
      OPENROUTER_API_KEY: "sk-or-test",
      HARN_PLANNER_PROVIDER: "anthropic",
      HARN_RELEASE_PROVIDER: "ollama",
      HARN_RELEASE_MODEL: "qwen3-coder:30b",
    },
    "HARN_RELEASE",
  )
  assert_eq(role.provider, "ollama")
  assert_eq(role.model, "qwen3-coder:30b")
  assert_eq(role.source, "env_role_override")
  // Empty role prefix skips per-role lookup; shared override still wins.
  const no_role = planner_defaults_with({HARN_PLANNER_MODEL: "x"}, "")
  assert_eq(no_role.source, "env_planner_override")
  assert_eq(no_role.model, "x")
}

pipeline test_binder_defaults_with(task) {
  // No env -> binder off because the default Cerebras provider has no key.
  const off = binder_defaults_with({})
  assert_eq(off.enabled, false)
  assert_eq(off.switch, "auto")
  assert_eq(off.provider, "cerebras")
  assert_eq(off.model, "gpt-oss-120b")
  assert_eq(contains(off.reason, "CEREBRAS_API_KEY"), true)
  // Auto-on when Cerebras key is present.
  const on = binder_defaults_with({CEREBRAS_API_KEY: "csk-test"})
  assert_eq(on.enabled, true)
  assert_eq(on.switch, "auto")
  assert_eq(on.provider, "cerebras")
  assert_eq(on.model, "gpt-oss-120b")
  assert_eq(on.timeout_ms, 100)
  assert_eq(on.max_tokens, 1024)
  assert_eq(on.reason, "")
  // HARN_EXT_BINDER=0 forces off even when the key is present.
  const forced_off = binder_defaults_with({CEREBRAS_API_KEY: "csk-test", HARN_EXT_BINDER: "0"})
  assert_eq(forced_off.enabled, false)
  assert_eq(forced_off.switch, "off")
  assert_eq(contains(forced_off.reason, "explicitly disabled"), true)
  // Custom provider override -> trust the operator, no key check.
  const custom = binder_defaults_with(
    {
      HARN_EXT_BINDER: "1",
      HARN_BINDER_PROVIDER: "openrouter",
      HARN_BINDER_MODEL: "deepseek/deepseek-v3.2",
    },
  )
  assert_eq(custom.enabled, true)
  assert_eq(custom.provider, "openrouter")
  assert_eq(custom.model, "deepseek/deepseek-v3.2")
  // Knob env vars take effect.
  const tuned = binder_defaults_with(
    {
      CEREBRAS_API_KEY: "csk-test",
      HARN_EXT_BINDER_TIMEOUT_MS: "250",
      HARN_EXT_BINDER_MAX_TOKENS: "2048",
    },
  )
  assert_eq(tuned.timeout_ms, 250)
  assert_eq(tuned.max_tokens, 2048)
}

pipeline test_install_binder(harness: Harness, task) {
  // Empty tool registry — install_binder must always return a `tools` and
  // `tool_caller` to spread, even when the binder is disabled.
  let registry = {tools: []}
  const installed = install_binder(harness, harness.clock, registry)
  assert_eq(type_of(installed.tools), "dict")
  assert_eq(type_of(installed.tool_caller), "closure")
  // The binder is off because the test process doesn't carry a Cerebras
  // key; the audit dict captures why.
  assert_eq(type_of(installed.audit), "dict")
}

pipeline test_install_binder_marks_nl_intent_optional(harness: Harness, task) {
  let registry = tool_registry()
  registry = tool_define(
    registry,
    "release_read",
    "Read",
    {
      handler: { _ -> "" },
      parameters: {type: "object", properties: {path: {type: "string"}}, required: ["path"]},
      returns: {type: "string"},
    },
  )
  const installed = install_binder_with_env(
    harness,
    harness.clock,
    registry,
    {CEREBRAS_API_KEY: "csk-test"},
  )
  const params = installed.tools.tools[0].parameters
  assert_eq(contains(params.properties.keys(), "_nl_intent"), true)
  assert_eq(contains(params.required, "_nl_intent"), false)
  assert_eq(params.properties._nl_intent.required, false)
  assert_eq(type_of(installed.tool_caller), "closure")
  assert_eq(installed.audit.enabled, true)
}

pipeline test_install_binder_accepts_optional_preflight_and_preserves_audit_schema(
  harness: Harness,
  task,
) {
  const installed = install_binder_after_preflight(harness, harness.clock, {}, nil)
  assert_eq(type_of(installed.tool_caller), "closure")
  assert_eq(type_of(installed.audit.timeout_ms), "int")
  assert_eq(type_of(installed.audit.max_tokens), "int")
  const disabled = install_binder_after_preflight(
    harness,
    harness.clock,
    {},
    {healthy: true, selected: nil, attempts: [], changed: false, disable_binder: true},
  )
  assert_eq(disabled.audit.enabled, false)
  assert_eq(type_of(disabled.audit.timeout_ms), "int")
  assert_eq(type_of(disabled.audit.max_tokens), "int")
  assert_eq(contains(disabled.audit.reason, "planner preflight"), true)
}

pipeline test_audit_lines(task) {
  const on_line = binder_audit_line(
    {enabled: true, provider: "cerebras", model: "gpt-oss-120b", timeout_ms: 100, max_tokens: 1024},
  )
  assert_eq(contains(on_line, "cerebras/gpt-oss-120b"), true)
  const off_line = binder_audit_line({enabled: false, reason: "no key"})
  assert_eq(contains(off_line, "off"), true)
  assert_eq(contains(off_line, "no key"), true)
  const pl = planner_audit_line({provider: "ollama", model: "qwen3.6", source: "env_role_override"})
  assert_eq(contains(pl, "ollama/qwen3.6 (env_role_override)"), true)
}

pipeline test_release_planner_preflight(task) {
  const candidates = planner_preflight_candidates(
    {provider: "cerebras", model: "gpt-oss-120b", source: "env_role_override"},
  )
  assert_eq(candidates[0]?.provider, "cerebras")
  assert_eq(candidates[1]?.provider, "openrouter")
  assert_eq(candidates[2]?.provider, "ollama")
  const health = {
    "cerebras/gpt-oss-120b": {
      valid: false,
      status: "invalid_request",
      message: "provider rejected reasoning_effort",
    },
    "openrouter/qwen/qwen3.6-35b-a3b": {valid: false, status: "auth", message: "quota exceeded"},
    "ollama/qwen3.6:35b-a3b-coding-nvfp4": {valid: true, status: "ok", message: "ready"},
  }
  const selected = planner_preflight_select_from_results(candidates, health)
  assert_eq(selected.healthy, true)
  assert_eq(selected.changed, true)
  assert_eq(selected.selected?.provider, "ollama")
  assert_eq(selected.attempts[0].classification, "wrong_api_option_shape")
  assert_eq(selected.attempts[1].classification, "auth_or_quota")
  assert_eq(contains(planner_preflight_audit_line(selected), "after fallback"), true)
  assert_eq(
    planner_preflight_should_disable_binder(
      selected,
      {enabled: true, provider: "cerebras", model: "gpt-oss-120b"},
    ),
    true,
  )
}

pipeline test_release_planner_preflight_accepts_ok_status_without_valid_boolean(task) {
  const candidates = planner_preflight_candidates(
    {provider: "openrouter", model: "qwen/qwen3.6-35b-a3b", source: "cloud_default"},
  )
  const health = {
    "openrouter/qwen/qwen3.6-35b-a3b": {
      status: "ok",
      message: "openrouter is ready; model qwen/qwen3.6-35b-a3b is served",
    },
  }
  const selected = planner_preflight_select_from_results(candidates, health)
  assert_eq(selected.healthy, true)
  assert_eq(selected.changed, false)
  assert_eq(selected.selected?.provider, "openrouter")
  assert_eq(selected.attempts[0].valid, true)
  assert_eq(selected.attempts[0].classification, "")
  const explicit_false = planner_preflight_select_from_results(
    candidates,
    {
      "openrouter/qwen/qwen3.6-35b-a3b": {
        valid: false,
        status: "ok",
        message: "contradictory provider result stays invalid",
      },
    },
  )
  assert_eq(explicit_false.healthy, false)
  assert_eq(explicit_false.attempts[0].valid, false)
}

pipeline test_release_planner_preflight_requires_generation_probe(task) {
  const health = {valid: true, status: "ok", message: "openrouter is reachable (HTTP 200)"}
  const quota_probe = {
    ok: false,
    status: "exception",
    error: {
      category: "auth",
      message: "openrouter HTTP 403 Forbidden [auth_failure]: Key limit exceeded (code: 403)",
    },
  }
  const failed = planner_generation_probe_health(health, quota_probe)
  assert_eq(failed.valid, false)
  assert_eq(failed.status, "generation_exception")
  assert_eq(contains(failed.message, "Key limit exceeded"), true)
  assert_eq(
    planner_preflight_failure_class("openrouter", "qwen/qwen3.6-35b-a3b", failed),
    "auth_or_quota",
  )
  const ok = planner_generation_probe_health(health, {ok: true, value: {text: "ok"}})
  assert_eq(ok.valid, true)
  assert_eq(ok.status, "ok")
  assert_eq(ok.message, "generation probe completed")
  assert_eq(ok.reachability_message, "openrouter is reachable (HTTP 200)")
}

pipeline test_release_planner_preflight_failure_classes(task) {
  assert_eq(
    planner_preflight_failure_class(
      "together_ai",
      "Qwen/Qwen3-Coder-Next-FP8",
      {valid: false, status: "bad_request", message: "dedicated endpoint unavailable"},
    ),
    "dedicated_endpoint_unavailable",
  )
  assert_eq(
    planner_preflight_failure_class(
      "minimax",
      "MiniMax-Text-01",
      {valid: false, status: "bad_request", message: "account plan does not support this model"},
    ),
    "unsupported_model",
  )
  assert_eq(
    planner_preflight_failure_class(
      "openrouter",
      "qwen/qwen3.6-35b-a3b",
      {valid: false, status: "unauthorized", message: "missing api key sk-test-secret"},
    ),
    "auth_or_quota",
  )
  assert_eq(
    planner_preflight_failure_class(
      "ollama",
      "qwen3.6:35b-a3b-coding-nvfp4",
      {valid: false, status: "connection_refused", message: "daemon unavailable"},
    ),
    "local_server_unavailable",
  )
}

pipeline test_release_planner_preflight_provider_signature_options(harness: Harness, task) {
  // Readiness probes stay provider-neutral and omit reasoning controls.
  const cerebras = planner_healthcheck_options(harness.llm, "cerebras", "gpt-oss-120b")
  assert_eq(cerebras.model, "gpt-oss-120b")
  assert_eq(cerebras.keys().contains("effort"), false)
  const generation = planner_generation_probe_options(harness.llm, "anthropic", "claude-sonnet-4-6")
  assert_eq(generation.provider, "anthropic")
  assert_eq(generation.model, "claude-sonnet-4-6")
  assert_eq(generation.max_tokens, 1)
  assert_eq(generation.keys().contains("effort"), false)
}
