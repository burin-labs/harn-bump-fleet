import { parse_json_typed } from "std/schema"
import {
  ProjectionRecoveryRequest,
  closed_projection_identity_matches,
  recover_projection_proposal,
  supersession_closure_provenance,
} from "../lib/remote_projection_recovery"
import { GithubClientOptions } from "harn-github-connector/default"

type ReopenBody = {state: string}

const BASE = "https://github.test"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const PRIOR = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const BRANCH = "automation/fleet-projections-aabbccddeeff"

const COMMENT = "exact canonical retirement comment"

const STAMP = "2026-10-01T07:34:04Z"

const ACTOR = {id: 278545796, login: "harn-release-bot[bot]", type: "Bot"}

fn pull() -> dict {
  return {
    number: 158,
    title: "Restore fleet-owned projections",
    state: "closed",
    merged: false,
    closed_at: STAMP,
    changed_files: 1,
    html_url: "https://github.com/octo/repo/pull/158",
    head: {ref: BRANCH, sha: SHA, repo: {full_name: "octo/repo", owner: {login: "octo"}}},
    base: {ref: "main", sha: PRIOR, repo: {full_name: "octo/repo", owner: {login: "octo"}}},
  }
}

fn timeline() -> list<dict> {
  return [{id: 32231193783, event: "closed", actor: ACTOR, created_at: STAMP, commit_id: nil}]
}

fn comments() -> list<dict> {
  return [{id: 5926889178, user: ACTOR, body: COMMENT, created_at: STAMP, updated_at: STAMP}]
}

fn request() -> ProjectionRecoveryRequest {
  return {
    slug: "octo/repo",
    branch: BRANCH,
    base: "main",
    expected_head: SHA,
    selected_paths: [".github/dependabot.yml"],
    title: "Restore fleet-owned projections",
    expected_comment: COMMENT,
  }
}

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "test-token"}
}

fn mock_recovery(testing: HarnessTesting, events: list<dict>, files: list<dict>) {
  const prefix = BASE + "/repos/octo/repo"
  testing.http_mock(
    "GET",
    prefix + "/pulls?state=closed&head=" + url_encode("octo:" + BRANCH) + "&base=main&per_page=100",
    {status: 200, body: json_stringify([pull()])},
  )
  testing.http_mock("GET", prefix + "/pulls/158", {status: 200, body: json_stringify(pull())})
  testing.http_mock(
    "GET",
    prefix + "/pulls/158/files?per_page=100&page=1",
    {status: 200, body: json_stringify(files)},
  )
  testing.http_mock(
    "GET",
    prefix + "/issues/158/timeline?per_page=100",
    {status: 200, body: json_stringify(events)},
  )
  testing.http_mock(
    "GET",
    prefix + "/issues/158/comments?per_page=100",
    {status: 200, body: json_stringify(comments())},
  )
  testing.http_mock(
    "PATCH",
    prefix + "/pulls/158",
    {status: 200, body: json_stringify(pull() + {state: "open"})},
  )
}

fn files() -> list<dict> {
  return [
    {
      filename: ".github/dependabot.yml",
      sha: SHA,
      status: "modified",
      additions: 1,
      deletions: 1,
      changes: 2,
    },
  ]
}

pipeline test_only_exact_bot_closure_and_comment_authorize_recovery(task: any) {
  assert(supersession_closure_provenance(pull(), timeline(), comments(), COMMENT))
  const human = {id: 1, login: "founder", type: "User"}
  assert(
    !supersession_closure_provenance(
      pull(),
      [(timeline()[0] ?? {}) + {actor: human}],
      comments(),
      COMMENT,
    ),
  )
  assert(
    !supersession_closure_provenance(
      pull(),
      timeline(),
      [(comments()[0] ?? {}) + {user: human}],
      COMMENT,
    ),
  )
  assert(!supersession_closure_provenance(pull(), timeline(), comments(), "substring"))
  assert(!supersession_closure_provenance(pull(), timeline(), [], COMMENT))
  assert(!supersession_closure_provenance(pull() + {merged: true}, timeline(), comments(), COMMENT))
  assert(!supersession_closure_provenance(pull(), [], comments(), COMMENT))
  assert(
    !supersession_closure_provenance(
      pull(),
      timeline(),
      [(comments()[0] ?? {}) + {updated_at: "2026-10-01T07:35:00Z"}],
      COMMENT,
    ),
  )
  const later = {id: 2, event: "reopened", actor: human, created_at: "2026-10-01T07:35:00Z"}
  assert(!supersession_closure_provenance(pull(), timeline() + [later], comments(), COMMENT))
  assert(
    !supersession_closure_provenance(
      pull(),
      range(0, 100).map({ _i -> timeline()[0] }).to_list(),
      comments(),
      COMMENT,
    ),
  )
  assert(
    !supersession_closure_provenance(
      pull(),
      timeline(),
      range(0, 100).map({ _i -> comments()[0] }).to_list(),
      COMMENT,
    ),
  )
  assert(closed_projection_identity_matches(pull(), request()))
  assert(!closed_projection_identity_matches(pull() + {head: {sha: PRIOR, ref: BRANCH}}, request()))
  assert(!closed_projection_identity_matches(pull() + {state: "open"}, request()))
  const committed = {event: "committed", sha: SHA, committer: {date: "2026-10-01T06:43:21Z"}}
  const reviewed = {event: "reviewed", submitted_at: "2026-10-01T06:51:58Z", commit_id: SHA}
  assert(supersession_closure_provenance(pull(), [reviewed] + timeline(), comments(), COMMENT))
  assert(
    !supersession_closure_provenance(
      pull(),
      [{event: "reviewed", commit_id: SHA}] + timeline(),
      comments(),
      COMMENT,
    ),
  )
  assert(supersession_closure_provenance(pull(), [committed] + timeline(), comments(), COMMENT))
  assert(
    !supersession_closure_provenance(
      pull(),
      [{event: "committed", sha: SHA}] + timeline(),
      comments(),
      COMMENT,
    ),
  )
}

pipeline test_scoped_bot_retirement_reopens_through_the_connector(harness: Harness, task: any) {
  mock_recovery(harness.testing, timeline(), files())
  const recovered = recover_projection_proposal(harness, request(), options())
  assert_eq(recovered.state, "reopened")
  assert_eq(recovered.pull_request, 158)
  const writes = harness.testing.http_mock_calls().filter({ call -> call.method == "PATCH" })
    .to_list()
  assert_eq(len(writes), 1, "actual existing connector PATCH fired")
  const body = unwrap(
    parse_json_typed<ReopenBody>(to_string(writes[0]?.body ?? ""), schema_of(ReopenBody)),
  )
  assert_eq(body.state, "open")
  const reads = harness.testing.http_mock_calls().filter(
    { call -> call.url == BASE + "/repos/octo/repo/pulls/158" && call.method == "GET" },
  )
    .to_list()
  assert_eq(len(reads), 4, "census brackets, provenance detail, and final disposition read fired")
}

pipeline test_human_closure_and_unrelated_scope_never_reopen(harness: Harness, task: any) {
  for human in [true, false] {
    harness.testing.http_mock_clear()
    const events = if human {
      [(timeline()[0] ?? {}) + {actor: {id: 1, login: "founder", type: "User"}}]
    } else {
      timeline()
    }
    const measured_files = if human {
      files()
    } else {
      [(files()[0] ?? {}) + {filename: "README.md"}]
    }
    mock_recovery(harness.testing, events, measured_files)
    assert_eq(recover_projection_proposal(harness, request(), options()).state, "retained")
    assert_eq(
      len(harness.testing.http_mock_calls().filter({ call -> call.method == "PATCH" }).to_list()),
      0,
    )
  }
}

pipeline test_missing_census_and_rename_origin_cannot_authorize_recovery(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  mock_recovery(harness.testing, timeline(), files())
  const prefix = BASE + "/repos/octo/repo"
  harness.testing.http_mock(
    "GET",
    prefix + "/pulls/158/files?per_page=100&page=1",
    {status: 200, body: "[]"},
  )
  const missing = try {
    recover_projection_proposal(harness, request(), options())
    false
  } catch (_error) {
    true
  }
  assert(missing, "unmeasured files refuse recovery")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "PATCH" }).to_list()),
    0,
  )
  harness.testing.http_mock_clear()
  mock_recovery(
    harness.testing,
    timeline(),
    [(files()[0] ?? {}) + {status: "renamed", previous_filename: "README.md"}],
  )
  assert_eq(recover_projection_proposal(harness, request(), options()).state, "retained")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "PATCH" }).to_list()),
    0,
  )
}
