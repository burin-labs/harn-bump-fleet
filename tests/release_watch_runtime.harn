import { run_release_watch } from "../lib/release_watch_runtime"
import { release_watch_receipt, release_watch_receipt_read } from "../lib/release_watch_state"

fn receipt() {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
}

fn receipt_path() {
  return path_join(harness.fs.temp_dir(), "watch-runtime-" + uuid_v7(), "receipt.json")
}

fn merged_pr_probe() {
  return {
    success: true,
    status: 0,
    stdout: json_stringify({data: {repository: {pullRequest: {number: 1, state: "MERGED"}}}}),
    stderr: "",
  }
}

fn workflow_success(workflow, id) {
  return {
    databaseId: id,
    status: "completed",
    conclusion: "success",
    headBranch: "v1.2.3",
    workflow: workflow,
  }
}

pipeline test_release_watch_runtime_completes_without_wall_clock_wait(task) {
  const dispatch_marker = path_join(harness.fs.temp_dir(), "watch-warm-" + uuid_v7())
  const adapter = {
    workflow_runs: fn(_slug, workflow) { return [
      workflow_success(
        workflow,
        if workflow == "publish-release.yml" {
          11
        } else {
          12
        },
      ),
    ] },
    readiness: fn(_tag) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, workflow, _fields) {
      if workflow == "build-release-binaries.yml" {
        const prior = if harness.fs.exists(dispatch_marker) {
          harness.fs.read_text(dispatch_marker)
        } else {
          ""
        }
        harness.fs.write_text(dispatch_marker, prior + "x")
      }
      return {success: true, status: 0, stdout: "", stderr: ""}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr_url) { return {success: true, status: 0} },
  }
  const path = receipt_path()
  const result = run_release_watch(harness, receipt(), path, {max_polls: 1, interval_ms: 0}, adapter)
  assert_eq(result.status, 0)
  assert_eq(result.polls, 1)
  assert_eq(result.state, "healthy")
  assert_eq(harness.fs.read_text(dispatch_marker), "x")
  const persisted = release_watch_receipt_read(path)
  if persisted == nil {
    throw "expected persisted release watch receipt"
  }
  assert_eq(persisted.state, "healthy")
  assert_eq(persisted.warm_cache.dispatched, true)
  const resumed = run_release_watch(harness, persisted, path, {max_polls: 1, interval_ms: 0}, adapter)
  assert_eq(resumed.status, 0)
  assert_eq(harness.fs.read_text(dispatch_marker), "x")
}

pipeline test_release_watch_runtime_persists_recovery_before_resuming(task) {
  const adapter = {
    workflow_runs: fn(_slug, workflow) { return [
      {
        databaseId: if workflow == "publish-release.yml" {
          21
        } else {
          22
        },
        status: "completed",
        conclusion: if workflow == "publish-release.yml" {
          "success"
        } else {
          "failure"
        },
        headBranch: "v1.2.3",
      },
    ] },
    readiness: fn(_tag) { return {ready: false, missing_assets: ["harn-x86_64-apple-darwin.tar.gz"]} },
    dispatch: fn(_slug, workflow, fields) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {tag: "v1.2.3"})
      return {success: true, status: 0, stdout: "", stderr: ""}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr_url) { return {success: true, status: 0} },
  }
  const path = receipt_path()
  const first = run_release_watch(
    harness,
    receipt(),
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(first.status, 3)
  const persisted = release_watch_receipt_read(path)
  if persisted == nil {
    throw "expected recovery receipt"
  }
  assert_eq(persisted.state, "recovering")
  assert_eq(persisted.recovery.dispatched, true)
  assert_eq(persisted.recovery.dispatch_status, "succeeded")
  const completed_adapter = {
    ...adapter,
    readiness: fn(_tag) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "recovery must not dispatch twice"
    },
  }
  const completed = run_release_watch(
    harness,
    persisted,
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    completed_adapter,
  )
  assert_eq(completed.status, 0)
  assert_eq(release_watch_receipt_read(path)?.state, "healthy")
}

pipeline test_release_watch_runtime_fails_publish_without_recovery_dispatch(task) {
  const adapter = {
    workflow_runs: fn(_slug, workflow) {
      if workflow != "publish-release.yml" {
        return []
      }
      return [{databaseId: 31, status: "completed", conclusion: "failure", headBranch: "v1.2.3"}]
    },
    readiness: fn(_tag) { return {ready: false, missing_assets: ["SHA256SUMS"]} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "publish failure must stay manual"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr_url) { return {success: true, status: 0} },
  }
  const result = run_release_watch(harness, receipt(), receipt_path(), {max_polls: 1, interval_ms: 0}, adapter)
  assert_eq(result.status, 2)
  assert_eq(result.state, "failed")
  assert_eq(
    result.reason,
    "publish for v1.2.3 is red: publish-release.yml (completed/failure) concluded in a failed state",
  )
}
