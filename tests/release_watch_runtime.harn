pipeline test_release_watch_runtime_projects_ancillary_publish_failure_from_jobs(
  harness: Harness,
  task: any,
) {
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) { return [
      {
        id: if workflow == "publish-release.yml" {
          41
        } else {
          42
        },
        created_at: "2026-07-13T00:00:00Z",
        event: "push",
        status: "completed",
        conclusion: if workflow == "publish-release.yml" {
          "failure"
        } else {
          "success"
        },
        head_branch: "v1.2.3",
        head_sha: RELEASE_MERGE_SHA,
      },
    ] },
    workflow_jobs: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 41)
      return {
        jobs: [
          {id: 101, name: "Detect tag drift", status: "completed", conclusion: "success"},
          {id: 102, name: "Publish release", status: "completed", conclusion: "success"},
          {
            id: 103,
            name: "Open post-release development bump",
            status: "completed",
            conclusion: "failure",
          },
        ],
      }
    },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "successful publication must not dispatch recovery"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warming is disabled"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    receipt(),
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.state, "healthy")
  assert_eq(contains(result.receipt.message, "ancillary failure remains"), true)
}

pipeline test_release_watch_runtime_attaches_publish_jobs_to_newest_failed_run(
