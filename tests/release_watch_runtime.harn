import {
  mock_release_watch_adapter,
  release_watch_replacement_pr,
  run_release_watch,
} from "../lib/release_watch_runtime"
import {
  ReleaseWatchReceipt,
  release_watch_apply_warm_cache_transition,
  release_watch_receipt,
  release_watch_receipt_read,
  release_watch_record_recovery_dispatch,
  release_watch_record_warm_cache_dispatch,
  release_watch_transition,
  release_watch_warm_cache_transition,
} from "../lib/release_watch_state"
import {
  accepted_warm_dispatch,
  completed_warm_run,
  matrix_success_jobs,
} from "./release_watch_runtime_fixtures"

const RELEASE_MERGE_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const WARM_SOURCE_SHA = "cccccccccccccccccccccccccccccccccccccccc"

fn receipt() -> ReleaseWatchReceipt {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      publication: {
        version: "1.2.3",
        local_branch: "release/v1.2.3",
        remote_ref: "release-attempt/v1.2.3/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        head_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      },
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
}

fn healthy_receipt() -> ReleaseWatchReceipt {
  return release_watch_transition(
    receipt(),
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:00:30Z"},
  ).receipt
}

fn receipt_path(harness: {fs: HarnessFs, random: HarnessRandom}) {
  return path_join(
    harness.fs.temp_dir(),
    "watch-runtime-" + harness.random.uuid_v7(),
    "receipt.json",
  )
}

fn merged_pr_probe() {
  return {
    number: 1,
    merged: true,
    github_state: "merged",
    merged_at: "2026-07-12T23:59:00Z",
    merge_commit_oid: RELEASE_MERGE_SHA,
    in_merge_queue: false,
    auto_merge_armed: false,
    mergeable_state: "unknown",
    head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
  }
}

fn open_pr_probe() {
  return {
    number: 1,
    merged: false,
    github_state: "open",
    merged_at: nil,
    merge_commit_oid: nil,
    in_merge_queue: false,
    auto_merge_armed: true,
    mergeable_state: "clean",
    head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
  }
}

fn closed_pr_probe() {
  return {
    number: 1,
    merged: false,
    github_state: "closed",
    merged_at: nil,
    merge_commit_oid: nil,
    in_merge_queue: false,
    auto_merge_armed: false,
    mergeable_state: "unknown",
    head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
  }
}

fn merged_replacement_pr() {
  const head_sha = "dddddddddddddddddddddddddddddddddddddddd"
  return {
    number: 2,
    url: "https://github.com/burin-labs/harn/pull/2",
    title: "Release v1.2.3",
    merged: true,
    github_state: "merged",
    merged_at: "2026-07-13T00:00:30Z",
    merge_commit_oid: RELEASE_MERGE_SHA,
    in_merge_queue: false,
    auto_merge_armed: false,
    mergeable_state: "unknown",
    base: {ref: "main"},
    head: {ref: "release-attempt/v1.2.3/${head_sha}", sha: head_sha},
  }
}

fn merged_certifier_pr() {
  const head_sha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  return {
    number: 4,
    url: "https://github.com/burin-labs/harn/pull/4",
    title: "Release v1.2.3",
    merged: true,
    github_state: "merged",
    merged_at: "2026-07-13T00:00:20Z",
    merge_commit_oid: RELEASE_MERGE_SHA,
    in_merge_queue: false,
    auto_merge_armed: false,
    mergeable_state: "unknown",
    base: {ref: "main"},
    head: {ref: "release-certify/${head_sha}", sha: head_sha},
  }
}

fn observed_at(poll: int) -> string {
  if poll == 0 {
    return "2026-07-13T00:01:00Z"
  }
  if poll == 1 {
    return "2026-07-13T00:02:00Z"
  }
  if poll == 2 {
    return "2026-07-13T00:03:00Z"
  }
  if poll == 3 {
    return "2026-07-13T00:04:00Z"
  }
  return "2026-07-13T00:05:00Z"
}

fn completed_release_run(workflow: string) {
  return {
    id: if workflow == "publish-release.yml" {
      11
    } else {
      12
    },
    created_at: "2026-07-12T23:00:00Z",
    event: "push",
    head_branch: "v1.2.3",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    status: "completed",
    conclusion: "success",
    url: "https://github.com/burin-labs/harn/actions/runs/11",
  }
}

pipeline test_release_watch_runtime_autonomously_completes_warming(harness: Harness, task: any) {
  const initial = receipt()
  const path = receipt_path({fs: harness.fs, random: harness.random})
  let progress_events = []
  const result = run_release_watch(
    harness,
    initial,
    path,
    {
      max_polls: 3,
      interval_ms: 0,
      on_progress: { progress, progress_path, poll ->
        progress_events = progress_events
          + [
            {
              poll: poll,
              path: progress_path,
              warm_state: progress.warm_cache.state,
              warm_jobs: len(progress.warm_cache.jobs),
            },
          ]
        return nil
      },
    },
    mock_release_watch_adapter(initial),
  )
  assert_eq(result.status, 0)
  assert_eq(result.polls, 3)
  assert_eq(result.receipt.state, "healthy")
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 9001)
  assert_eq(result.receipt.warm_cache.attempt_count, 1)
  assert_eq(len(result.progress.observed_assets), 7)
  assert_eq(len(progress_events), 3)
  assert_eq(progress_events[0]?.poll, 1)
  assert_eq(progress_events[2]?.warm_state, "completed")
  assert_eq(progress_events[2]?.warm_jobs, 5)
  assert_eq(release_watch_receipt_read(harness.fs, path), result.receipt)
}

pipeline test_release_watch_runtime_persists_identity_before_exact_observation(
  harness: Harness,
  task: any,
) {
  const initial = receipt()
  const path = receipt_path({fs: harness.fs, random: harness.random})
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) { return [completed_release_run(workflow)] },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, workflow, fields, _poll) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {warm_cache_only: true})
      return accepted_warm_dispatch(300)
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "exact run observation must occur only after identity persistence"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "jobs cannot be observed before the exact run"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(harness, initial, path, {max_polls: 1, interval_ms: 0}, adapter)
  assert_eq(result.status, 3)
  const persisted = release_watch_receipt_read(harness.fs, path)
  if persisted == nil {
    throw "expected dispatch identity receipt"
  }
  assert_eq(persisted.warm_cache.state, "dispatch_accepted")
  assert_eq(persisted.warm_cache.source_sha, WARM_SOURCE_SHA)
  assert(persisted.warm_cache.source_sha != initial.pin_sha)
  assert_eq(persisted.warm_cache.workflow_run_id, 300)
  assert_eq(
    persisted.warm_cache.workflow_run_url,
    "https://github.com/burin-labs/harn/actions/runs/300",
  )
  assert_eq(persisted.warm_cache.attempt_count, 1)
}

pipeline test_release_watch_runtime_normalizes_pending_github_conclusions(
  harness: Harness,
  task: any,
) {
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) { return [
      {...completed_release_run(workflow), status: "in_progress", conclusion: nil},
    ] },
    readiness: fn(_tag, _poll) { return {
      ready: false,
      missing_assets: ["harn-x86_64-unknown-linux-gnu.tar.gz"],
    } },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "pending runs must not dispatch recovery"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "release is not healthy"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    pr_probe: fn(_slug, _pr_url) { return open_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) {
      throw "auto-merge is already armed"
    },
  }
  const result = run_release_watch(
    harness,
    receipt(),
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(result.status, 3)
  assert_eq(result.state, "pending")
}

pipeline test_release_watch_runtime_adopts_equivalent_active_warm_run_across_receipts(
  harness: Harness,
  task: any,
) {
  let active_warm_run: dict? = nil
  let dispatch_count = 0
  let exact_observation_count = 0
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) {
      const release = completed_release_run(workflow)
      if workflow != "build-release-binaries.yml" {
        return [release]
      }
      let runs = [
        release,
        {
          ...completed_warm_run(279, "success"),
          workflow: workflow,
          event: "push",
          head_branch: "main",
          head_sha: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        },
        {
          ...completed_warm_run(280, "success"),
          workflow: workflow,
          event: "workflow_dispatch",
          head_branch: "main",
          head_sha: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        },
        {
          ...completed_warm_run(290, ""),
          workflow: workflow,
          head_sha: "dddddddddddddddddddddddddddddddddddddddd",
          status: "completed",
          conclusion: "success",
        },
        {
          id: 300,
          workflow: workflow,
          url: "https://github.com/burin-labs/harn/actions/runs/300",
          head_sha: WARM_SOURCE_SHA,
          event: "push",
          head_branch: "main",
          status: "completed",
          conclusion: "success",
          created_at: "2026-07-13T00:00:30Z",
          run_started_at: "2026-07-13T00:00:31Z",
          updated_at: "2026-07-13T00:00:40Z",
        },
        {
          ...completed_warm_run(298, ""),
          workflow: workflow,
          head_sha: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          status: "completed",
          conclusion: "success",
        },
      ]
      if active_warm_run != nil {
        runs = runs
          + [
            {
              ...active_warm_run,
              id: 299,
              url: "https://github.com/burin-labs/harn/actions/runs/299",
            },
            active_warm_run,
          ]
      }
      return runs
    },
    readiness: fn(_tag, _poll) {
      throw "healthy receipts must not re-read release readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, workflow, fields, _poll) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {warm_cache_only: true})
      dispatch_count = dispatch_count + 1
      active_warm_run = {
        ...completed_warm_run(301, ""),
        workflow: workflow,
        status: "queued",
        conclusion: nil,
        updated_at: "",
      }
      return accepted_warm_dispatch(301)
    },
    warm_run: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 301)
      exact_observation_count = exact_observation_count + 1
      return completed_warm_run(301, "success")
    },
    warm_jobs: fn(_slug, run_id, _poll) {
      if run_id == 299 {
        return {jobs: matrix_success_jobs()}
      }
      assert_eq(run_id, 301)
      return {jobs: matrix_success_jobs()}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const first = run_release_watch(
    harness,
    healthy_receipt(),
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(first.receipt.warm_cache.workflow_run_id, 301)
  assert_eq(dispatch_count, 1)
  const second_path = receipt_path({fs: harness.fs, random: harness.random})
  const second = run_release_watch(
    harness,
    healthy_receipt(),
    second_path,
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(second.receipt.warm_cache.workflow_run_id, first.receipt.warm_cache.workflow_run_id)
  assert_eq(second.receipt.warm_cache.workflow_run_url, first.receipt.warm_cache.workflow_run_url)
  assert_eq(second.receipt.warm_cache.source_sha, WARM_SOURCE_SHA)
  assert(contains(second.receipt.warm_cache.message, "adopted active"))
  assert_eq(dispatch_count, 1)
  const resumed = run_release_watch(
    harness,
    second.receipt,
    second_path,
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(resumed.status, 0)
  assert_eq(resumed.receipt.warm_cache.state, "completed")
  assert_eq(resumed.receipt.warm_cache.workflow_run_id, 301)
  assert_eq(exact_observation_count, 1)
  assert_eq(dispatch_count, 1)
}

pipeline test_release_watch_runtime_adopts_completed_exact_source_warm_run(harness: Harness) {
  let dispatch_count = 0
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) {
      const release = completed_release_run(workflow)
      if workflow != "build-release-binaries.yml" {
        return [release]
      }
      return [
        release,
        {
          ...completed_warm_run(300, "success"),
          workflow: workflow,
          event: "push",
          head_branch: "main",
        },
        {...completed_warm_run(301, "success"), workflow: workflow},
        {...completed_warm_run(302, "success"), workflow: workflow},
      ]
    },
    readiness: fn(_tag, _poll) {
      throw "healthy receipt must not re-read readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      dispatch_count = dispatch_count + 1
      return accepted_warm_dispatch(302)
    },
    warm_run: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 301)
      return completed_warm_run(301, "success")
    },
    warm_jobs: fn(_slug, run_id, _poll) {
      if run_id == 301 {
        return {jobs: matrix_success_jobs()}
      }
      assert_eq(run_id, 302)
      return {
        jobs: matrix_success_jobs().map(
          { job ->
            if job.name == "Build x86_64-pc-windows-msvc" {
              {...job, conclusion: "failure"}
            } else {
              job
            }
          },
        )
          .to_list(),
      }
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    healthy_receipt(),
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 2, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 301)
  assert(contains(result.receipt.warm_cache.message, "successful matrix build"))
  assert_eq(dispatch_count, 0)
}

pipeline test_release_watch_runtime_refuses_ambiguous_completed_warm_runs(harness: Harness) {
  let dispatch_count = 0
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) {
      const release = completed_release_run(workflow)
      if workflow != "build-release-binaries.yml" {
        return [release]
      }
      return [
        release,
        {
          ...completed_warm_run(300, "success"),
          workflow: workflow,
          event: "push",
          head_branch: "main",
        },
        {...completed_warm_run(301, "success"), workflow: workflow},
        {...completed_warm_run(302, "success"), workflow: workflow},
      ]
    },
    readiness: fn(_tag, _poll) {
      throw "healthy receipts must not re-read readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      dispatch_count = dispatch_count + 1
      return accepted_warm_dispatch(303)
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "an ambiguous completed warm run must not be adopted"
    },
    warm_jobs: fn(_slug, run_id, _poll) {
      assert(run_id == 301 || run_id == 302)
      return {jobs: matrix_success_jobs()}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    healthy_receipt(),
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 3)
  assert_eq(result.receipt.warm_cache.state, "not_requested")
  assert_eq(result.receipt.warm_cache.attempt_count, 0)
  assert_eq(dispatch_count, 0)
}

pipeline test_release_watch_runtime_waits_for_active_non_exact_release_binary_run(
  harness: Harness,
  task: any,
) {
  let dispatch_count = 0
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) {
      const release = completed_release_run(workflow)
      if workflow != "build-release-binaries.yml" {
        return [release]
      }
      return [
        release,
        {
          ...completed_warm_run(320, "success"),
          workflow: workflow,
          event: "push",
          head_branch: "main",
          head_sha: WARM_SOURCE_SHA,
        },
        {
          ...completed_warm_run(321, ""),
          workflow: workflow,
          status: "in_progress",
          conclusion: nil,
          head_sha: "dddddddddddddddddddddddddddddddddddddddd",
        },
      ]
    },
    readiness: fn(_tag, _poll) {
      throw "healthy receipt must not re-read readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      dispatch_count = dispatch_count + 1
      return accepted_warm_dispatch(322)
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "no warm run was accepted"
    },
    warm_jobs: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 321)
      return {
        jobs: [
          {name: "Resolve release context", status: "completed", conclusion: "success"},
          {name: "Build x86_64-apple-darwin", status: "in_progress", conclusion: ""},
        ],
      }
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    healthy_receipt(),
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 3)
  assert_eq(result.receipt.warm_cache.state, "not_requested")
  assert_eq(result.receipt.warm_cache.attempt_count, 0)
  assert_eq(dispatch_count, 0)
}

pipeline test_release_watch_runtime_never_warms_before_release_pr_merge(
  harness: Harness,
  task: any,
) {
  const initial = receipt()
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) { return [completed_release_run(workflow)] },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warm dispatch must wait for release PR merge"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    pr_probe: fn(_slug, _pr_url) { return open_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) {
      throw "already-armed release PR must not be mutated"
    },
  }
  const result = run_release_watch(
    harness,
    initial,
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 3)
  assert_eq(result.receipt.state, "healthy")
  assert_eq(result.receipt.warm_cache.state, "not_requested")
  assert(contains(result.receipt.warm_cache.message, "release pull request to merge"))
}

pipeline test_release_watch_runtime_reports_partial_asset_progress(harness: Harness, task: any) {
  const initial = receipt()
  let probed_pr = false
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) {
      if workflow == "publish-release.yml" {
        return [{...completed_release_run(workflow), id: 501}]
      }
      return [
        {
          id: 499,
          created_at: "2026-07-12T00:00:00Z",
          event: "push",
          head_branch: "main",
          head_sha: "dddddddddddddddddddddddddddddddddddddddd",
          status: "completed",
          conclusion: "success",
          url: "https://github.com/burin-labs/harn/actions/runs/499",
        },
        {
          id: 502,
          created_at: "2026-07-13T00:00:00Z",
          event: "push",
          head_branch: "v1.2.3",
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          status: "in_progress",
          conclusion: "",
          url: "https://github.com/burin-labs/harn/actions/runs/502",
        },
      ]
    },
    readiness: fn(_tag, _poll) { return {
      ready: false,
      asset_names: ["harn-aarch64-unknown-linux-gnu.tar.gz"],
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz", "SHA256SUMS"],
    } },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "in-progress binary build must not dispatch recovery"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "release is not healthy"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "release is not healthy"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "release is not healthy"
    },
    pr_probe: fn(_slug, _pr_url) {
      probed_pr = true
      return open_pr_probe()
    },
    enable_auto_merge: fn(_slug, _pr) {
      throw "already-armed release PR must not be mutated"
    },
  }
  const result = run_release_watch(
    harness,
    initial,
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 3)
  assert_eq(result.progress.observed_assets, ["harn-aarch64-unknown-linux-gnu.tar.gz"])
  assert_eq(result.progress.missing_assets, ["harn-x86_64-apple-darwin.tar.gz", "SHA256SUMS"])
  const publish_run = result.progress.runs[0]
  const binary_run = result.progress.runs[1]
  if publish_run == nil || binary_run == nil {
    throw "expected publish and binary workflow observations"
  }
  assert_eq(publish_run.workflow, "publish-release.yml")
  assert_eq(publish_run.status, "completed")
  assert_eq(binary_run.workflow, "build-release-binaries.yml")
  assert_eq(binary_run.status, "in_progress")
  assert_eq(probed_pr, true)
}

pipeline test_release_watch_runtime_observe_only_skips_mutating_surfaces(
  harness: Harness,
  task: any,
) {
  const initial = receipt()
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) {
      if workflow == "publish-release.yml" {
        return [{...completed_release_run(workflow), id: 501}]
      }
      return [
        {
          id: 502,
          created_at: "2026-07-13T00:00:00Z",
          event: "push",
          head_branch: "v1.2.3",
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          status: "in_progress",
          conclusion: "",
          url: "https://github.com/burin-labs/harn/actions/runs/502",
        },
      ]
    },
    readiness: fn(_tag, _poll) { return {
      ready: false,
      asset_names: ["harn-aarch64-unknown-linux-gnu.tar.gz"],
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz", "SHA256SUMS"],
    } },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "observe-only release watch must not dispatch recovery"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "observe-only release watch must not dispatch warm cache"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "observe-only release watch must not observe warm runs"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "observe-only release watch must not observe warm jobs"
    },
    pr_probe: fn(_slug, _pr_url) {
      throw "observe-only release watch must not probe or rearm the pull request"
    },
    enable_auto_merge: fn(_slug, _pr) {
      throw "observe-only release watch must not enable auto-merge"
    },
  }
  const result = run_release_watch(
    harness,
    initial,
    receipt_path({fs: harness.fs, random: harness.random}),
    {
      max_polls: 1,
      interval_ms: 0,
      dispatch_recovery: false,
      dispatch_warm_cache: false,
      keep_pr_armed: false,
    },
    adapter,
  )
  assert_eq(result.status, 3)
  assert_eq(result.watchdog, {action: "skip", reason: "pull_request_watchdog_disabled"})
  assert_eq(result.progress.observed_assets, ["harn-aarch64-unknown-linux-gnu.tar.gz"])
  assert_eq(result.progress.missing_assets, ["harn-x86_64-apple-darwin.tar.gz", "SHA256SUMS"])
  assert_eq(len(result.progress.runs), 2)
  const publish_run = result.progress.runs[0]
  const binary_run = result.progress.runs[1]
  if publish_run == nil || binary_run == nil {
    throw "expected publish and binary workflow observations"
  }
  assert_eq(publish_run.id, 501)
  assert_eq(binary_run.id, 502)
}

pipeline test_release_watch_runtime_restart_observes_exact_run_without_duplicate_dispatch(
  harness: Harness,
  task: any,
) {
  const initial = release_watch_record_warm_cache_dispatch(
    healthy_receipt(),
    {
      accepted: true,
      observed_at: "2026-07-13T00:01:00Z",
      workflow_run_id: 301,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/301",
      source_sha: WARM_SOURCE_SHA,
      message: "persisted before restart",
    },
  )
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) { return [completed_release_run(workflow)] },
    readiness: fn(_tag, _poll) {
      throw "healthy receipt must not re-read release readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "persisted warm run must not dispatch twice"
    },
    warm_run: fn(_slug, run_id, poll) {
      assert_eq(run_id, 301)
      if poll == 0 {
        return {
          ...completed_warm_run(301, ""),
          status: "in_progress",
          conclusion: nil,
          updated_at: "",
        }
      }
      return completed_warm_run(301, "success")
    },
    warm_jobs: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 301)
      return {jobs: matrix_success_jobs()}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    initial,
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 2, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 301)
  assert_eq(result.receipt.warm_cache.attempt_count, 1)
}

pipeline test_release_watch_runtime_restart_refreshes_rerun_after_terminal_failure(
  harness: Harness,
  task: any,
) {
  const accepted = release_watch_record_warm_cache_dispatch(
    healthy_receipt(),
    {
      accepted: true,
      observed_at: "2026-07-13T00:01:00Z",
      workflow_run_id: 302,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/302",
      source_sha: WARM_SOURCE_SHA,
      message: "dispatch accepted",
    },
  )
  const failed = release_watch_apply_warm_cache_transition(
    accepted,
    release_watch_warm_cache_transition(
      accepted.warm_cache,
      true,
      {
        observed_at: "2026-07-13T00:02:00Z",
        release_pr_merged: true,
        overlap_active: false,
        run: {
          workflow_run_id: 302,
          workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/302",
          source_sha: WARM_SOURCE_SHA,
          event: "workflow_dispatch",
          head_branch: "main",
          status: "completed",
          conclusion: "failure",
          started_at: "2026-07-13T00:01:10Z",
          completed_at: "2026-07-13T00:02:00Z",
        },
        jobs: [],
        jobs_observed: false,
      },
    ),
  )
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) { return [completed_release_run(workflow)] },
    readiness: fn(_tag, _poll) {
      throw "healthy receipt must not re-read release readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "a rerun keeps the same workflow run identity"
    },
    warm_run: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 302)
      return completed_warm_run(302, "success")
    },
    warm_jobs: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 302)
      return {jobs: matrix_success_jobs()}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    failed,
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 302)
}

pipeline test_release_watch_runtime_redispatches_cancelled_warm_once_and_persists_new_identity(
  harness: Harness,
  task: any,
) {
  const accepted = release_watch_record_warm_cache_dispatch(
    healthy_receipt(),
    {
      accepted: true,
      observed_at: "2026-07-13T00:01:00Z",
      workflow_run_id: 401,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/401",
      source_sha: WARM_SOURCE_SHA,
      message: "first dispatch accepted",
    },
  )
  const second_attempt = release_watch_record_warm_cache_dispatch(
    accepted,
    {
      accepted: true,
      observed_at: "2026-07-13T00:01:30Z",
      workflow_run_id: 401,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/401",
      source_sha: WARM_SOURCE_SHA,
      message: "second dispatch accepted",
    },
  )
  // Model a durable terminal receipt written by an older watcher. On restart,
  // the fixed watcher re-observes the exact run as cancelled and recovers from
  // `failed` rather than relying on an in-memory suppressed transition.
  const first = release_watch_apply_warm_cache_transition(
    second_attempt,
    release_watch_warm_cache_transition(
      second_attempt.warm_cache,
      true,
      {
        observed_at: "2026-07-13T00:02:00Z",
        release_pr_merged: true,
        overlap_active: false,
        run: {
          workflow_run_id: 401,
          workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/401",
          source_sha: WARM_SOURCE_SHA,
          event: "workflow_dispatch",
          head_branch: "main",
          status: "completed",
          conclusion: "failure",
          started_at: "2026-07-13T00:01:30Z",
          completed_at: "2026-07-13T00:02:00Z",
        },
        jobs: [],
        jobs_observed: false,
      },
    ),
  )
  let dispatch_count = 0
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) { return [completed_release_run(workflow)] },
    readiness: fn(_tag, _poll) {
      throw "healthy receipt must not re-read release readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, workflow, fields, _poll) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {warm_cache_only: true})
      dispatch_count = dispatch_count + 1
      return accepted_warm_dispatch(402)
    },
    warm_run: fn(_slug, run_id, _poll) {
      if run_id == 401 {
        return completed_warm_run(401, "cancelled")
      }
      assert_eq(run_id, 402)
      return completed_warm_run(402, "success")
    },
    warm_jobs: fn(_slug, run_id, _poll) {
      if run_id == 401 {
        return {jobs: matrix_success_jobs()}
      }
      assert_eq(run_id, 402)
      return {jobs: matrix_success_jobs()}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const path = receipt_path({fs: harness.fs, random: harness.random})
  const result = run_release_watch(harness, first, path, {max_polls: 3, interval_ms: 0}, adapter)
  assert_eq(result.status, 0)
  assert_eq(dispatch_count, 1)
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 402)
  assert_eq(result.receipt.warm_cache.attempt_count, 3)
  const persisted = release_watch_receipt_read(harness.fs, path)
  if persisted == nil {
    throw "expected retry identity receipt"
  }
  assert_eq(persisted.warm_cache.workflow_run_id, 402)
  assert_eq(persisted.warm_cache.attempt_count, 3)
}

pipeline test_release_watch_runtime_suppression_holds_then_retries_once(
  harness: Harness,
  task: any,
) {
  const recovered = release_watch_record_recovery_dispatch(receipt(), "2026-07-13T00:00:30Z", true)
  const released = release_watch_transition(
    recovered,
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:00:45Z"},
  ).receipt
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, poll) {
      const release = completed_release_run(workflow)
      if workflow == "build-release-binaries.yml" && (poll == 1 || poll == 2) {
        return [
          release,
          {
            id: 401,
            created_at: "2026-07-13T00:01:30Z",
            event: "workflow_dispatch",
            head_branch: "main",
            head_sha: "cccccccccccccccccccccccccccccccccccccccc",
            status: "in_progress",
            conclusion: "",
            url: "https://github.com/burin-labs/harn/actions/runs/401",
          },
        ]
      }
      return [release]
    },
    readiness: fn(_tag, _poll) {
      throw "healthy receipt must not re-read release readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, workflow, fields, poll) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {warm_cache_only: true})
      const run_id = if poll == 0 {
        402
      } else {
        403
      }
      return accepted_warm_dispatch(run_id)
    },
    warm_run: fn(_slug, run_id, _poll) { return completed_warm_run(run_id, "success") },
    warm_jobs: fn(_slug, run_id, _poll) {
      if run_id == 402 {
        return {
          jobs: [
            {name: "Resolve release context", status: "completed", conclusion: "success"},
            {name: "Build $" + "{{ matrix.target }}", status: "completed", conclusion: "skipped"},
          ],
        }
      }
      return {jobs: matrix_success_jobs()}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    released,
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 5, interval_ms: 0},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.polls, 5)
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 403)
  assert_eq(result.receipt.warm_cache.attempt_count, 2)
}

pipeline test_release_watch_runtime_persists_recovery_before_resuming(harness: Harness, task: any) {
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) { return [
      {
        id: if workflow == "publish-release.yml" {
          21
        } else {
          22
        },
        created_at: "2026-07-13T00:00:00Z",
        event: "push",
        status: "completed",
        conclusion: if workflow == "publish-release.yml" {
          "success"
        } else {
          "failure"
        },
        head_branch: "v1.2.3",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      },
    ] },
    readiness: fn(_tag, _poll) { return {
      ready: false,
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz"],
    } },
    dispatch: fn(_slug, workflow, fields) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {tag: "v1.2.3"})
      return {
        accepted: true,
        run_id: 777,
        url: "https://github.test/run/777",
        event: "workflow_dispatch",
        head_branch: "main",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      }
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warming is disabled"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const path = receipt_path({fs: harness.fs, random: harness.random})
  const first = run_release_watch(
    harness,
    receipt(),
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(first.status, 3)
  const persisted = release_watch_receipt_read(harness.fs, path)
  if persisted == nil {
    throw "expected recovery receipt"
  }
  assert_eq(persisted.state, "recovering")
  assert_eq(persisted.recovery.dispatch_status, "succeeded")
}

