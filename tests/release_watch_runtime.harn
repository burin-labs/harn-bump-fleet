      }
    },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "successful publication must not dispatch recovery"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warming is disabled"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    receipt(),
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.state, "healthy")
  assert_eq(contains(result.receipt.message, "ancillary failure remains"), true)
}

pipeline test_release_watch_runtime_retargets_closed_pr_to_merged_replacement(
  harness: Harness,
  task: any,
) {
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:05:00Z" },
    workflow_runs: fn(_slug, _workflow, _poll) { return [] },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release is already healthy"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warming is disabled"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    pr_probe: fn(_slug, pr_url) { return if pr_url.ends_with("/1") {
      closed_pr_probe()
    } else {
      merged_replacement_pr()
    } },
    replacement_prs: fn(slug, tag, _poll) {
      assert_eq(slug, "burin-labs/harn")
      assert_eq(tag, "v1.2.3")
      return {pull_requests: [closed_pr_probe(), merged_replacement_pr()]}
    },
    enable_auto_merge: fn(_slug, _pr) {
      throw "replacement is already merged"
    },
  }
  const path = receipt_path({fs: harness.fs, random: harness.random})
  const result = run_release_watch(
    harness,
    healthy_receipt(),
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.polls, 1)
  assert_eq(result.watchdog.reason, "release_pr_merged")
  assert_eq(result.receipt.pr_url, "https://github.com/burin-labs/harn/pull/2")
  assert(contains(result.reason, "warm cache not requested"))
  assert(!contains(result.reason, "waiting"))
  assert_eq(release_watch_receipt_read(harness.fs, path)?.pr_url, result.receipt.pr_url)
}

pipeline test_release_watch_runtime_retargets_zero_diff_attempt_to_merged_certifier(
  harness: Harness,
  task: any,
) {
  const certifier = merged_certifier_pr()
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:05:00Z" },
    workflow_runs: fn(_slug, _workflow, _poll) { return [] },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release is already healthy"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warming is disabled"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    pr_probe: fn(_slug, pr_url) { return if pr_url.ends_with("/1") {
      closed_pr_probe()
    } else {
      certifier
    } },
    replacement_prs: fn(_slug, _tag, _poll) { return {pull_requests: [certifier]} },
    enable_auto_merge: fn(_slug, _pr) {
      throw "certifier is already merged"
    },
  }
  const path = receipt_path({fs: harness.fs, random: harness.random})
  const result = run_release_watch(
    harness,
    healthy_receipt(),
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.watchdog.reason, "release_pr_merged")
  assert_eq(result.receipt.pr_url, certifier.url)
  assert(contains(result.reason, "warm cache not requested"))
}

pipeline test_release_watch_replacement_pr_revalidates_connector_results(
  harness: Harness,
  task: any,
) {
  const valid = merged_replacement_pr()
  const wrong_repo = {...valid, url: "https://github.com/example/harn/pull/2"}
  const wrong_base = {
    ...valid,
    url: "https://github.com/burin-labs/harn/pull/3",
    base: {ref: "next"},
  }
  const wrong_head = {
    ...valid,
    url: "https://github.com/burin-labs/harn/pull/4",
    head: {...valid.head, ref: "release-attempt/v9.9.9/${valid.head.sha}"},
  }
  const mismatched_oid = {
    ...valid,
    url: "https://github.com/burin-labs/harn/pull/6",
    head: {...valid.head, ref: "release-attempt/v1.2.3/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"},
  }
  const wrong_title = {
    ...valid,
    url: "https://github.com/burin-labs/harn/pull/7",
    title: "Release v9.9.9",
  }
  const closed = {
    ...valid,
    url: "https://github.com/burin-labs/harn/pull/5",
    merged: false,
    github_state: "closed",
  }
  const wrong_certifier = {
    ...merged_certifier_pr(),
    url: "https://github.com/burin-labs/harn/pull/8",
    head: {
      ref: "release-certify/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      sha: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
    },
  }
  const decision = release_watch_replacement_pr(
    receipt(),
    [
      wrong_repo,
      wrong_base,
      wrong_head,
      mismatched_oid,
      wrong_title,
      closed,
      wrong_certifier,
      valid,
    ],
  )
  assert_eq(decision.action, "retarget")
  assert_eq(decision.pull_request.url, valid.url)
}

pipeline test_release_watch_replacement_pr_rejects_ambiguity(harness: Harness, task: any) {
  const first = merged_replacement_pr()
  const second = {...first, url: "https://github.com/burin-labs/harn/pull/3"}
  const decision = release_watch_replacement_pr(receipt(), [second, first])
  assert_eq(decision.action, "fail")
  assert_eq(decision.urls, [first.url, second.url])
}
