import { mock_release_watch_adapter, run_release_watch } from "../lib/release_watch_runtime"
import {
  ReleaseWatchReceipt,
  release_watch_receipt,
  release_watch_receipt_read,
  release_watch_record_recovery_dispatch,
  release_watch_record_warm_cache_dispatch,
  release_watch_transition,
} from "../lib/release_watch_state"

const RELEASE_MERGE_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const WARM_SOURCE_SHA = "cccccccccccccccccccccccccccccccccccccccc"

fn receipt() -> ReleaseWatchReceipt {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
}

fn healthy_receipt() -> ReleaseWatchReceipt {
  return release_watch_transition(
    receipt(),
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:00:30Z"},
  ).receipt
}

fn receipt_path() {
  return path_join(harness.fs.temp_dir(), "watch-runtime-" + uuid_v7(), "receipt.json")
}

fn merged_pr_probe() {
  return {
    number: 1,
    merged: true,
    github_state: "merged",
    merged_at: "2026-07-12T23:59:00Z",
    merge_commit_oid: RELEASE_MERGE_SHA,
    in_merge_queue: false,
    auto_merge_armed: false,
    mergeable_state: "unknown",
    head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
  }
}

fn open_pr_probe() {
  return {
    number: 1,
    merged: false,
    github_state: "open",
    merged_at: nil,
    merge_commit_oid: nil,
    in_merge_queue: false,
    auto_merge_armed: true,
    mergeable_state: "clean",
    head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
  }
}

fn observed_at(poll: int) -> string {
  if poll == 0 {
    return "2026-07-13T00:01:00Z"
  }
  if poll == 1 {
    return "2026-07-13T00:02:00Z"
  }
  if poll == 2 {
    return "2026-07-13T00:03:00Z"
  }
  if poll == 3 {
    return "2026-07-13T00:04:00Z"
  }
  return "2026-07-13T00:05:00Z"
}

fn completed_release_run(workflow: string) {
  return {
    id: if workflow == "publish-release.yml" {
      11
    } else {
      12
    },
    created_at: "2026-07-12T23:00:00Z",
    event: "push",
    head_branch: "v1.2.3",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    status: "completed",
    conclusion: "success",
    url: "https://github.com/burin-labs/harn/actions/runs/11",
  }
}

fn completed_warm_run(run_id: int, conclusion: string) {
  return {
    id: run_id,
    url: "https://github.com/burin-labs/harn/actions/runs/${run_id}",
    head_sha: WARM_SOURCE_SHA,
    event: "workflow_dispatch",
    head_branch: "main",
    status: "completed",
    conclusion: conclusion,
    created_at: "2026-07-13T00:01:00Z",
    run_started_at: "2026-07-13T00:01:10Z",
    updated_at: "2026-07-13T00:02:00Z",
  }
}

fn accepted_warm_dispatch(run_id: int) {
  return {
    accepted: true,
    run_id: run_id,
    url: "https://github.com/burin-labs/harn/actions/runs/${run_id}",
    head_sha: WARM_SOURCE_SHA,
    event: "workflow_dispatch",
    head_branch: "main",
  }
}

fn matrix_success_jobs() {
  return [
    {name: "Resolve release context", status: "completed", conclusion: "success"},
    {name: "Build aarch64-apple-darwin", status: "completed", conclusion: "success"},
    {name: "Build aarch64-unknown-linux-gnu", status: "completed", conclusion: "success"},
    {name: "Build x86_64-apple-darwin", status: "completed", conclusion: "success"},
    {name: "Build x86_64-pc-windows-msvc", status: "completed", conclusion: "success"},
    {name: "Build x86_64-unknown-linux-gnu", status: "completed", conclusion: "success"},
  ]
}

pipeline test_release_watch_runtime_autonomously_completes_warming(task) {
  const initial = receipt()
  const path = receipt_path()
  const result = run_release_watch(
    harness,
    initial,
    path,
    {max_polls: 3, interval_ms: 0},
    mock_release_watch_adapter(initial),
  )
  assert_eq(result.status, 0)
  assert_eq(result.polls, 3)
  assert_eq(result.receipt.state, "healthy")
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 9001)
  assert_eq(result.receipt.warm_cache.attempt_count, 1)
  assert_eq(len(result.progress.observed_assets), 7)
  assert_eq(release_watch_receipt_read(path), result.receipt)
}

pipeline test_release_watch_runtime_persists_identity_before_exact_observation(task) {
  const initial = receipt()
  const path = receipt_path()
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) { return [completed_release_run(workflow)] },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, workflow, fields, _poll) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {warm_cache_only: true})
      return accepted_warm_dispatch(300)
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "exact run observation must occur only after identity persistence"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "jobs cannot be observed before the exact run"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(harness, initial, path, {max_polls: 1, interval_ms: 0}, adapter)
  assert_eq(result.status, 3)
  const persisted = release_watch_receipt_read(path)
  if persisted == nil {
    throw "expected dispatch identity receipt"
  }
  assert_eq(persisted.warm_cache.state, "dispatch_accepted")
  assert_eq(persisted.warm_cache.source_sha, WARM_SOURCE_SHA)
  assert(persisted.warm_cache.source_sha != initial.pin_sha)
  assert_eq(persisted.warm_cache.workflow_run_id, 300)
  assert_eq(
    persisted.warm_cache.workflow_run_url,
    "https://github.com/burin-labs/harn/actions/runs/300",
  )
  assert_eq(persisted.warm_cache.attempt_count, 1)
}

pipeline test_release_watch_runtime_never_warms_before_release_pr_merge(task) {
  const initial = receipt()
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) { return [completed_release_run(workflow)] },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "release recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warm dispatch must wait for release PR merge"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    pr_probe: fn(_slug, _pr_url) { return open_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) {
      throw "already-armed release PR must not be mutated"
    },
  }
  const result = run_release_watch(harness, initial, receipt_path(), {max_polls: 1, interval_ms: 0}, adapter)
  assert_eq(result.status, 3)
  assert_eq(result.receipt.state, "healthy")
  assert_eq(result.receipt.warm_cache.state, "not_requested")
  assert(contains(result.receipt.warm_cache.message, "release pull request to merge"))
}

pipeline test_release_watch_runtime_reports_partial_asset_progress(task) {
  const initial = receipt()
  const adapter = {
    now: fn(_poll) { return "2026-07-13T00:01:00Z" },
    workflow_runs: fn(_slug, workflow, _poll) {
      if workflow == "publish-release.yml" {
        return [{...completed_release_run(workflow), id: 501}]
      }
      return [
        {
          id: 502,
          created_at: "2026-07-13T00:00:00Z",
          event: "push",
          head_branch: "v1.2.3",
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          status: "in_progress",
          conclusion: "",
          url: "https://github.com/burin-labs/harn/actions/runs/502",
        },
      ]
    },
    readiness: fn(_tag, _poll) { return {
      ready: false,
      asset_names: ["harn-aarch64-unknown-linux-gnu.tar.gz"],
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz", "SHA256SUMS"],
    } },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "in-progress binary build must not dispatch recovery"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "release is not healthy"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "release is not healthy"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "release is not healthy"
    },
    pr_probe: fn(_slug, _pr_url) { return open_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) {
      throw "already-armed release PR must not be mutated"
    },
  }
  const result = run_release_watch(harness, initial, receipt_path(), {max_polls: 1, interval_ms: 0}, adapter)
  assert_eq(result.status, 3)
  assert_eq(result.progress.observed_assets, ["harn-aarch64-unknown-linux-gnu.tar.gz"])
  assert_eq(result.progress.missing_assets, ["harn-x86_64-apple-darwin.tar.gz", "SHA256SUMS"])
  assert_eq(result.progress.runs[0].workflow, "publish-release.yml")
  assert_eq(result.progress.runs[0].status, "completed")
  assert_eq(result.progress.runs[1].workflow, "build-release-binaries.yml")
  assert_eq(result.progress.runs[1].status, "in_progress")
}

pipeline test_release_watch_runtime_restart_observes_exact_run_without_duplicate_dispatch(task) {
  const initial = release_watch_record_warm_cache_dispatch(
    healthy_receipt(),
    {
      accepted: true,
      observed_at: "2026-07-13T00:01:00Z",
      workflow_run_id: 301,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/301",
      source_sha: WARM_SOURCE_SHA,
      message: "persisted before restart",
    },
  )
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) { return [completed_release_run(workflow)] },
    readiness: fn(_tag, _poll) {
      throw "healthy receipt must not re-read release readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "persisted warm run must not dispatch twice"
    },
    warm_run: fn(_slug, run_id, poll) {
      assert_eq(run_id, 301)
      if poll == 0 {
        return {...completed_warm_run(301, ""), status: "in_progress", conclusion: "", updated_at: ""}
      }
      return completed_warm_run(301, "success")
    },
    warm_jobs: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 301)
      return {jobs: matrix_success_jobs()}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(harness, initial, receipt_path(), {max_polls: 2, interval_ms: 0}, adapter)
  assert_eq(result.status, 0)
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 301)
  assert_eq(result.receipt.warm_cache.attempt_count, 1)
}

pipeline test_release_watch_runtime_suppression_holds_then_retries_once(task) {
  const recovered = release_watch_record_recovery_dispatch(receipt(), "2026-07-13T00:00:30Z", true)
  const released = release_watch_transition(
    recovered,
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:00:45Z"},
  ).receipt
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, poll) {
      const release = completed_release_run(workflow)
      if workflow == "build-release-binaries.yml" && (poll == 1 || poll == 2) {
        return [
          release,
          {
            id: 401,
            created_at: "2026-07-13T00:01:30Z",
            event: "workflow_dispatch",
            head_branch: "main",
            head_sha: "cccccccccccccccccccccccccccccccccccccccc",
            status: "in_progress",
            conclusion: "",
            url: "https://github.com/burin-labs/harn/actions/runs/401",
          },
        ]
      }
      return [release]
    },
    readiness: fn(_tag, _poll) {
      throw "healthy receipt must not re-read release readiness"
    },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "recovery must not dispatch"
    },
    warm_dispatch: fn(_slug, workflow, fields, poll) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {warm_cache_only: true})
      const run_id = if poll == 0 {
        402
      } else {
        403
      }
      return accepted_warm_dispatch(run_id)
    },
    warm_run: fn(_slug, run_id, _poll) { return completed_warm_run(run_id, "success") },
    warm_jobs: fn(_slug, run_id, _poll) {
      if run_id == 402 {
        return {
          jobs: [
            {name: "Resolve release context", status: "completed", conclusion: "success"},
            {name: "Build $" + "{{ matrix.target }}", status: "completed", conclusion: "skipped"},
          ],
        }
      }
      return {jobs: matrix_success_jobs()}
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(harness, released, receipt_path(), {max_polls: 5, interval_ms: 0}, adapter)
  assert_eq(result.status, 0)
  assert_eq(result.polls, 5)
  assert_eq(result.receipt.warm_cache.state, "completed")
  assert_eq(result.receipt.warm_cache.workflow_run_id, 403)
  assert_eq(result.receipt.warm_cache.attempt_count, 2)
}

pipeline test_release_watch_runtime_persists_recovery_before_resuming(task) {
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) { return [
      {
        id: if workflow == "publish-release.yml" {
          21
        } else {
          22
        },
        created_at: "2026-07-13T00:00:00Z",
        event: "push",
        status: "completed",
        conclusion: if workflow == "publish-release.yml" {
          "success"
        } else {
          "failure"
        },
        head_branch: "v1.2.3",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      },
    ] },
    readiness: fn(_tag, _poll) { return {ready: false, missing_assets: ["harn-x86_64-apple-darwin.tar.gz"]} },
    dispatch: fn(_slug, workflow, fields) {
      assert_eq(workflow, "build-release-binaries.yml")
      assert_eq(fields, {tag: "v1.2.3"})
      return {
        accepted: true,
        run_id: 777,
        url: "https://github.test/run/777",
        event: "workflow_dispatch",
        head_branch: "main",
        head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      }
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warming is disabled"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "no warm run exists"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const path = receipt_path()
  const first = run_release_watch(
    harness,
    receipt(),
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(first.status, 3)
  const persisted = release_watch_receipt_read(path)
  if persisted == nil {
    throw "expected recovery receipt"
  }
  assert_eq(persisted.state, "recovering")
  assert_eq(persisted.recovery.dispatch_status, "succeeded")
}

pipeline test_release_watch_runtime_fails_publish_without_recovery_dispatch(task) {
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) {
      if workflow != "publish-release.yml" {
        return []
      }
      return [
        {
          id: 31,
          created_at: "2026-07-13T00:00:00Z",
          event: "push",
          status: "completed",
          conclusion: "failure",
          head_branch: "v1.2.3",
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        },
      ]
    },
    readiness: fn(_tag, _poll) { return {ready: false, missing_assets: ["SHA256SUMS"]} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "publish failure must stay manual"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "publish is not healthy"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "publish is not healthy"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "publish is not healthy"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(harness, receipt(), receipt_path(), {max_polls: 1, interval_ms: 0}, adapter)
  assert_eq(result.status, 2)
  assert_eq(result.state, "failed")
}
