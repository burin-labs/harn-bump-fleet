import {
  parse_release_merge_lease_headline,
  release_merge_lease_admission,
  release_merge_lease_headline,
  release_merge_lease_observation,
  release_merge_lease_ref,
} from "../lib/release_merge_lease"

const BASE = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const LEASE_OID = "cccccccccccccccccccccccccccccccccccccccc"

fn lease() {
  return {
    repo: "burin-labs/harn",
    base_branch: "main",
    base_oid: BASE,
    candidate_pr: 7192,
    candidate_head: HEAD,
    generation: "hosted-123-attempt-2",
    tag: "v0.10.115",
    merge_method: "squash",
  }
}

fn active() {
  return release_merge_lease_observation(
    "burin-labs/harn",
    "main",
    {state: "present", oid: LEASE_OID, holder_headline: release_merge_lease_headline(lease())},
  )
}

pipeline test_lease_round_trips_one_typed_identity(task: any) {
  assert_eq(release_merge_lease_ref("main"), "refs/release-merge-lease/main")
  assert_eq(parse_release_merge_lease_headline(release_merge_lease_headline(lease())), lease())
  assert_eq(parse_release_merge_lease_headline("release lease maybe 7192"), nil)
}

pipeline test_only_exact_candidate_crosses_active_release_lease(task: any) {
  const exact = release_merge_lease_admission(
    active(),
    {repo: "burin-labs/harn", base_branch: "main", pr: 7192, head: HEAD},
  )
  assert(exact.allowed)
  for target in [
    {repo: "burin-labs/harn", base_branch: "main", pr: 7185, head: HEAD},
    {
      repo: "burin-labs/harn",
      base_branch: "main",
      pr: 7192,
      head: "dddddddddddddddddddddddddddddddddddddddd",
    },
    {repo: "burin-labs/other", base_branch: "main", pr: 7192, head: HEAD},
  ] {
    assert_eq(release_merge_lease_admission(active(), target).allowed, false)
  }
}

pipeline test_absence_is_measured_and_malformed_presence_fails_closed(task: any) {
  const clear = release_merge_lease_observation("burin-labs/harn", "main", {state: "absent"})
  assert_eq(clear.state, "clear")
  assert(
    release_merge_lease_admission(
      clear,
      {repo: "burin-labs/harn", base_branch: "main", pr: 7185, head: HEAD},
    ).allowed,
  )
  const invalid = release_merge_lease_observation(
    "burin-labs/harn",
    "main",
    {state: "present", oid: LEASE_OID, holder_headline: "not typed"},
  )
  assert_eq(invalid.state, "invalid")
  assert_eq(
    release_merge_lease_admission(
      invalid,
      {repo: "burin-labs/harn", base_branch: "main", pr: 7192, head: HEAD},
    ).allowed,
    false,
  )
  const unreadable = release_merge_lease_observation("burin-labs/harn", "main", nil)
  assert_eq(unreadable.state, "unreadable")
  assert_eq(
    release_merge_lease_admission(
      unreadable,
      {repo: "burin-labs/harn", base_branch: "main", pr: 7192, head: HEAD},
    ).allowed,
    false,
  )
}
