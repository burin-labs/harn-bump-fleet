import { dependabot_template_revisions } from "../lib/dependabot_template_source"
import {
  github_path_revision_pair,
  source_revision_pair_from_commits,
} from "../lib/github_source_head"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const CURRENT = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const PREVIOUS = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const PATH = "templates/dependabot.yml"

const REPO = "burin-labs/.github"

const HISTORY = BASE
  + "/repos/burin-labs/.github/commits?sha=main&path=templates%2Fdependabot.yml&per_page=2"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "test-token"}
}

fn mock_file(testing: HarnessTesting, ref: string, text: string) {
  testing.http_mock(
    "GET",
    BASE + "/repos/burin-labs/.github/contents/templates/dependabot.yml?ref=" + ref,
    {
      status: 200,
      body: json_stringify(
        {
          name: "dependabot.yml",
          path: PATH,
          sha: CURRENT,
          type: "file",
          size: len(text),
          encoding: "base64",
          content: base64_encode(text),
        },
      ),
    },
  )
}

pipeline test_default_template_recovery_reads_two_canonical_file_revisions(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock(
    "GET",
    HISTORY,
    {status: 200, body: json_stringify([{sha: CURRENT}, {sha: PREVIOUS}])},
  )
  mock_file(harness.testing, CURRENT, "current template\n")
  mock_file(harness.testing, PREVIOUS, "previous template\n")
  const measured = unwrap(dependabot_template_revisions(harness, "main", "", options()))
  assert_eq(measured.current, "current template\n")
  assert_eq(measured.previous, "previous template\n")
  assert_eq(
    len(harness.testing.http_mock_calls()),
    3,
    "history and both immutable template reads fired",
  )
  for call in harness.testing.http_mock_calls() {
    assert_eq(call.method, "GET")
  }
}

pipeline test_explicit_historical_template_override_preserves_the_operator_seam(
  harness: Harness,
  task: any,
) {
  mock_file(harness.testing, "main", "current template\n")
  mock_file(harness.testing, PREVIOUS, "previous template\n")
  const measured = unwrap(dependabot_template_revisions(harness, "main", PREVIOUS, options()))
  assert_eq(measured.previous, "previous template\n")
  assert_eq(
    len(harness.testing.http_mock_calls()),
    2,
    "explicit prior ref never silently reads current as previous",
  )
}

pipeline test_missing_repeated_and_malformed_file_history_is_not_a_previous_template(task: any) {
  const cases: list<list<dict>> = [
    [],
    [{sha: CURRENT}],
    [{sha: CURRENT}, {sha: CURRENT}],
    [{sha: CURRENT}, {sha: "bad"}],
  ]
  for rows in cases {
    assert(is_err(source_revision_pair_from_commits(rows, REPO, PATH, "main")))
  }
  assert_eq(
    unwrap(
      source_revision_pair_from_commits([{sha: CURRENT}, {sha: PREVIOUS}], REPO, PATH, "main"),
    ),
    {current: CURRENT, previous: PREVIOUS},
  )
}

pipeline test_unknown_history_response_cannot_be_an_empty_census(harness: Harness, task: any) {
  harness.testing.http_mock("GET", HISTORY, {status: 200, body: json_stringify({})})
  assert(is_err(github_path_revision_pair(harness, REPO, PATH, "main", options())))
  assert_eq(len(harness.testing.http_mock_calls()), 1)
}

pipeline test_empty_canonical_template_is_refused(harness: Harness, task: any) {
  mock_file(harness.testing, "main", "current template\n")
  mock_file(harness.testing, PREVIOUS, "")
  assert(is_err(dependabot_template_revisions(harness, "main", PREVIOUS, options())))
}
