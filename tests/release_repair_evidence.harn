import { validate_agent_attempt } from "../lib/release_agent_tools"
import { ReleaseAnalysis } from "../lib/release_analysis"
import { ReleaseNotesScope } from "../lib/release_runtime"

/**
 * A repair attempt that calls nothing cannot close an evidence gap.
 *
 * Observed in hosted release runs 31691040750 and 31691791479: the first
 * attempt made three tool calls and left the evidence contract open; the two
 * repair attempts that followed made ZERO tool calls each and simply rewrote
 * the prose. Each produced a better-looking audit — starting with `Audit:`,
 * carrying valid draft-changelog markers, citing a concrete post-tag PR and
 * commit — while `evidence.complete` stayed false the whole time.
 *
 * The run then reported only `agent_loop ended with status budget_exhausted`,
 * which describes turn accounting rather than the actual problem, and two
 * separate investigations read it as a provider failure.
 *
 * These tests pin that an attempt which calls nothing while the evidence
 * contract is open says so plainly.
 */
fn analysis_fixture() -> ReleaseAnalysis {
  const notes_scope: ReleaseNotesScope = "candidate_tree"
  return {
    fixup_mode: false,
    release_notes_scope: notes_scope,
    repo: "/tmp/harn",
    mode: "ship-pr",
    current_version: "0.10.89",
    next_version: "0.10.90",
    bump: "patch",
    pin_sha: "054a2558408af14de03bb3b34472236c8e6abc22",
    base_branch: "main",
    latest_tag: "v0.10.89",
    operator_focus: "",
    changelog_top: "0.10.90",
    changelog_section: "## v0.10.90\n\n### Fixed\n\n- Something.",
    changelog_unreleased_section: "",
    deterministic_findings: [],
    commits_since_latest_tag: "054a25584 feat: project generic tool permission activity (#6632)",
    expected_branch: "release/v0.10.90",
    provider: "mock",
    model: "mock",
    mock: true,
    branch: "release/v0.10.90",
    pin_sha_input: "",
    source_snapshot: {
      kind: "mock",
      requested_sha: "",
      resolved_sha: "054a2558408af14de03bb3b34472236c8e6abc22",
      analysis_head: "054a2558408af14de03bb3b34472236c8e6abc22",
      analysis_root: "/tmp/harn",
      source_repo: "/tmp/harn",
    },
    fixup_tag: "",
    fixup_pr_url: "",
    fixup_publication: nil,
    prepared_release: false,
    dirty_files: 0,
    status: "",
    diff_stat: "",
    diff_names: "CHANGELOG.md",
    commit_file_changes_since_latest_tag: "M CHANGELOG.md",
    commit_stats_since_latest_tag: "1 file changed",
    post_tag_pr_numbers: [6632],
    post_tag_pr_details: "PR #6632",
    recent_merged_prs: "[]",
    release_scripts: {release_ship: true, release_gate: true},
    workflows: {publish_release: true, build_release_binaries: true},
    release_scope_findings: [],
  }
}

/** The exact final-attempt shape from run 31691040750. */
fn tool_less_repair_result() -> dict {
  return {
    status: "budget_exhausted",
    tools: {calls: [], successful: [], rejected: [], mode: "native"},
    release_agent_evidence: {
      complete: false,
      observations: [],
      reason: "missing a successful exact-range delta observation for v0.10.89..054a2558",
    },
  }
}

const WELL_FORMED_AUDIT = "Audit:\n- Version/readiness: target `v0.10.90`.\n"
  + "- CHANGELOG coverage: 3 post-tag PRs merged; first post-tag PR is #6632.\n"
  + "- First post-tag commit: `054a25584 feat: project generic tool permission activity (#6632)`.\n"
  + "BEGIN_DRAFT_CHANGELOG\n## v0.10.90\n\n### Fixed\n\n- Something plausible.\n"
  + "END_DRAFT_CHANGELOG\n"

pipeline test_a_tool_less_attempt_names_the_evidence_gap() {
  const findings = validate_agent_attempt(
    analysis_fixture(),
    tool_less_repair_result(),
    WELL_FORMED_AUDIT,
  )
  let named_no_tool_calls = false
  let named_evidence_contract = false
  for finding in findings {
    if contains(finding, "made no tool calls") {
      named_no_tool_calls = true
    }
    if contains(finding, "evidence contract remained incomplete") {
      named_evidence_contract = true
    }
  }
  // Both must surface. Before this change the tool-count guard suppressed the
  // evidence finding and no finding named the missing tool calls at all, so
  // the ONLY finding was the loop-status one.
  assert_eq(named_no_tool_calls, true)
  assert_eq(named_evidence_contract, true)
}

pipeline test_the_loop_status_finding_is_not_the_only_finding() {
  const findings = validate_agent_attempt(
    analysis_fixture(),
    tool_less_repair_result(),
    WELL_FORMED_AUDIT,
  )
  // The regression this file guards: a findings list containing ONLY the
  // loop-status finding. That shape is what made six unevidenced audits read
  // as a near-pass.
  let only_loop_status = len(findings) > 0
  for finding in findings {
    if !starts_with(finding, "agent_loop ended with status") {
      only_loop_status = false
    }
  }
  assert_eq(only_loop_status, false)
}

pipeline test_a_closed_evidence_contract_does_not_trip_the_finding() {
  const closed = tool_less_repair_result()
    + {release_agent_evidence: {complete: true, observations: ["delta"], reason: ""}}
  const findings = validate_agent_attempt(analysis_fixture(), closed, WELL_FORMED_AUDIT)
  for finding in findings {
    assert_eq(contains(finding, "made no tool calls"), false)
    assert_eq(contains(finding, "evidence contract remained incomplete"), false)
  }
}

pipeline test_an_attempt_that_called_tools_does_not_trip_the_no_call_finding() {
  const called = tool_less_repair_result()
    + {tools: {calls: ["release_run"], successful: ["release_run"], rejected: [], mode: "native"}}
  const findings = validate_agent_attempt(analysis_fixture(), called, WELL_FORMED_AUDIT)
  for finding in findings {
    assert_eq(contains(finding, "made no tool calls"), false)
  }
}
