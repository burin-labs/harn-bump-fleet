import {
  changed_harn_diff_argv,
  changed_harn_line_ranges,
  changed_harn_lint_gate,
  changed_harn_patch_argv,
  changed_harn_paths,
  changed_lint_findings,
  lint_json_diagnostics,
  quoted_git_paths,
  source_line_at_byte,
  strict_harn_lint_argv,
} from "../lib/changed_harn_lint"
import { fail, ok } from "../lib/shell_util"

fn scripted_runner(entries) {
  return { spec ->
    const key = join(spec.argv, "\n")
    for entry in entries {
      if entry.key == key {
        return entry.result
      }
    }
    return fail(127, "unexpected command fixture: " + join(spec.argv, " "))
  }
}

fn lint_file(diagnostics) {
  return {
    path: "lib/new.harn",
    status: if len(diagnostics) == 0 {
      "ok"
    } else {
      "warning"
    },
    diagnostics: diagnostics,
    fixable: 0,
    fixed: 0,
  }
}

fn lint_report_value(diagnostics) {
  const clean = len(diagnostics) == 0
  return {
    schemaVersion: 1,
    ok: clean,
    data: {
      files: [lint_file(diagnostics)],
      summary: {
        ok: if clean {
          1
        } else {
          0
        },
        warnings: if clean {
          0
        } else {
          1
        },
        errors: 0,
        diagnostics: len(diagnostics),
        fixable: 0,
        fixed: 0,
      },
    },
    error: if clean {
      nil
    } else {
      {code: "lint_failed", message: "one or more files failed `harn lint`", details: nil}
    },
    warnings: [],
  }
}

fn lint_report(diagnostics) {
  return json_stringify(lint_report_value(diagnostics))
}

fn lint_diagnostic(start: int, end: int, message = "lint finding") {
  return {
    source: "lint",
    severity: "warning",
    code: "HARN-LNT-018",
    message: message,
    span: {start: start, end: end},
  }
}

fn report_with_file(file) {
  const report = lint_report_value([])
  return report + {data: report.data + {files: [file]}}
}

fn decoded_diagnostic(start: int, end: int, message = "lint finding") {
  return {
    path: "lib/new.harn",
    severity: "warning",
    code: "HARN-LNT-018",
    message: message,
    span: {start: start, end: end},
  }
}

fn source_reader(sources) {
  return { path -> sources[path] }
}

fn strict_lint_result(diagnostics) {
  return {
    success: len(diagnostics) == 0,
    status: if len(diagnostics) == 0 {
      0
    } else {
      1
    },
    stdout: lint_report(diagnostics),
    stderr: "",
  }
}

const PATCH = "diff --git a/lib/new.harn b/lib/new.harn\n+++ b/lib/new.harn\n@@ -0,0 +1 @@\n+let new_value = 1\n"

pipeline test_changed_harn_paths_preserve_whitespace_and_drop_duplicates(task) {
  assert_eq(
    changed_harn_paths("lib/new.harn\ntests/ spaced name.harn\nREADME.md\nlib/new.harn\n"),
    ["lib/new.harn", "tests/ spaced name.harn"],
  )
}

pipeline test_changed_harn_lint_argvs_are_direct_and_deterministic(task) {
  assert_eq(
    changed_harn_diff_argv("base-sha", "head-sha"),
    ["git", "diff", "--name-only", "--diff-filter=ACMR", "base-sha...head-sha", "--", "*.harn"],
  )
  assert_eq(
    changed_harn_patch_argv("base-sha", "head-sha", ["lib/a.harn", "tests/b.harn"]),
    [
      "git",
      "diff",
      "--no-color",
      "--unified=0",
      "base-sha...head-sha",
      "--",
      "lib/a.harn",
      "tests/b.harn",
    ],
  )
  assert_eq(
    strict_harn_lint_argv("/tmp/harn bin", ["lib/a.harn", "tests/b.harn"]),
    ["/tmp/harn bin", "lint", "--strict", "--json", "--", "lib/a.harn", "tests/b.harn"],
  )
}

pipeline test_changed_harn_line_ranges_parse_zero_context_hunks(task) {
  assert_eq(changed_harn_line_ranges(PATCH), [{path: "lib/new.harn", start: 1, end: 1}])
  assert_eq(changed_harn_line_ranges("+++ b/lib/new.harn\n@@ -4,2 +9,0 @@\n"), [])
}

pipeline test_source_line_at_byte_uses_utf8_offsets(task) {
  const source = "α\nbeta\n"
  assert_eq(source_line_at_byte(source, 0), 1)
  assert_eq(source_line_at_byte(source, 2), 1)
  assert_eq(source_line_at_byte(source, 3), 2)
  assert_eq(source_line_at_byte(source, 7), 2)
  assert_eq(source_line_at_byte(source, 8), 3)
  assert_eq(source_line_at_byte(source, 9), 0)
}

pipeline test_lint_json_diagnostics_rejects_malformed_envelopes(task) {
  const expected = ["lib/new.harn"]
  assert_eq(lint_json_diagnostics("not json", expected).ok, false)
  assert_eq(lint_json_diagnostics("[]", expected).ok, false)
  const valid = lint_report_value([])
  assert_eq(lint_json_diagnostics(json_stringify(valid + {schemaVersion: "1"}), expected).ok, false)
  assert_eq(lint_json_diagnostics(json_stringify(valid + {ok: "true"}), expected).ok, false)
  assert_eq(lint_json_diagnostics(json_stringify(valid + {data: nil}), expected).ok, false)
  assert_eq(lint_json_diagnostics(json_stringify(valid + {error: {}}), expected).ok, false)
  assert_eq(lint_json_diagnostics(json_stringify(valid + {warnings: {}}), expected).ok, false)
  assert_eq(
    lint_json_diagnostics(json_stringify(valid + {data: valid.data + {summary: {}}}), expected).ok,
    false,
  )
  assert_eq(
    lint_json_diagnostics(
      json_stringify(
        valid
          + {ok: false, error: {code: "lint_failed", message: "failed", details: nil}},
      ),
      expected,
    ).ok,
    false,
  )
}

pipeline test_lint_json_diagnostics_rejects_malformed_files_and_paths(task) {
  const expected = ["lib/new.harn"]
  const valid_file = lint_file([])
  assert_eq(
    lint_json_diagnostics(
      json_stringify(lint_report_value([]) + {data: lint_report_value([]).data + {files: {}}}),
      expected,
    ).ok,
    false,
  )
  assert_eq(lint_json_diagnostics(json_stringify(report_with_file("not a file")), expected).ok, false)
  for path in [nil, 1, "", "lib/other.harn"] {
    assert_eq(
      lint_json_diagnostics(json_stringify(report_with_file(valid_file + {path: path})), expected).ok,
      false,
    )
  }
  assert_eq(
    lint_json_diagnostics(
      json_stringify(
        lint_report_value([])
          + {data: lint_report_value([]).data + {files: [valid_file, valid_file]}},
      ),
      expected,
    ).ok,
    false,
  )
  assert_eq(
    lint_json_diagnostics(json_stringify(report_with_file(valid_file + {status: "unknown"})), expected).ok,
    false,
  )
  assert_eq(
    lint_json_diagnostics(json_stringify(report_with_file(valid_file + {diagnostics: {}})), expected).ok,
    false,
  )
}

pipeline test_lint_json_diagnostics_rejects_malformed_diagnostics_and_spans(task) {
  const expected = ["lib/new.harn"]
  const valid = lint_diagnostic(3, 11)
  for diagnostic in ["not a diagnostic", valid + {source: nil}, valid + {code: nil}, valid + {message: ""}] {
    assert_eq(lint_json_diagnostics(lint_report([diagnostic]), expected).ok, false)
  }
  for severity in [nil, 1, "fatal"] {
    assert_eq(lint_json_diagnostics(lint_report([valid + {severity: severity}]), expected).ok, false)
  }
  for span in [
    nil,
    "not a span",
    {},
    {start: 3},
    {start: "3", end: 11},
    {start: 3, end: "11"},
    {start: 3.5, end: 11},
    {start: -1, end: 11},
    {start: 12, end: 11},
  ] {
    assert_eq(lint_json_diagnostics(lint_report([valid + {span: span}]), expected).ok, false)
  }
}

pipeline test_lint_json_diagnostics_accepts_optional_code_and_span_but_preserves_absence(task) {
  const diagnostic = {source: "lint", severity: "warning", message: "diagnostic without location"}
  const decoded = lint_json_diagnostics(lint_report([diagnostic]), ["lib/new.harn"])
  assert_eq(decoded.error, "")
  assert_eq(decoded.ok, true)
  assert_eq(decoded.diagnostics[0]?.code, nil)
  assert_eq(decoded.diagnostics[0]?.span, nil)
  const selection = changed_lint_findings(
    decoded.diagnostics,
    [{path: "lib/new.harn", start: 1, end: 1}],
    source_reader({"lib/new.harn": "const value = 1\n"}),
  )
  assert_eq(selection.ok, false)
  assert_eq(selection.error, "lint diagnostic has no source span for lib/new.harn")
}

pipeline test_lint_json_diagnostics_rejects_inconsistent_file_and_summary_state(task) {
  const expected = ["lib/new.harn"]
  const warning = lint_diagnostic(0, 1)
  const report = lint_report_value([warning])
  assert_eq(
    lint_json_diagnostics(
      json_stringify(report_with_file(lint_file([warning]) + {status: "ok"})),
      expected,
    ).ok,
    false,
  )
  assert_eq(
    lint_json_diagnostics(
      json_stringify(report + {data: report.data + {summary: report.data.summary + {diagnostics: 0}}}),
      expected,
    ).ok,
    false,
  )
  assert_eq(
    lint_json_diagnostics(
      json_stringify(report + {error: {code: "other", message: "failed", details: nil}}),
      expected,
    ).ok,
    false,
  )
}

pipeline test_lint_json_diagnostics_preserves_full_span(task) {
  const decoded = lint_json_diagnostics(lint_report([lint_diagnostic(3, 11)]), ["lib/new.harn"])
  assert_eq(decoded.ok, true)
  assert_eq(decoded.diagnostics[0]?.span, {start: 3, end: 11})
}

pipeline test_changed_lint_findings_ignores_legacy_and_rejects_added_diagnostics(task) {
  const ranges = [{path: "lib/new.harn", start: 1, end: 1}]
  const sources = {"lib/new.harn": "let new_value = 1\nlet legacy_value = 2\n"}
  const legacy = [decoded_diagnostic(18, 38, "legacy")]
  assert_eq(changed_lint_findings(legacy, ranges, source_reader(sources)).findings, [])
  const added = [decoded_diagnostic(0, 17, "new")]
  const findings = changed_lint_findings(added, ranges, source_reader(sources)).findings
  assert_eq(len(findings), 1)
  assert_eq(findings[0]?.line, 1)
  const two_added = added + [{...added[0], code: "HARN-LNT-099", message: "second"}]
  assert_eq(len(changed_lint_findings(two_added, ranges, source_reader(sources)).findings), 2)
}

pipeline test_changed_lint_findings_uses_full_multiline_interval(task) {
  const source = "import \"z\"\nimport \"a\"\nconst value = 1\n"
  const sources = {"lib/new.harn": source}
  const added_second_import = [{path: "lib/new.harn", start: 2, end: 2}]
  const import_order = [decoded_diagnostic(0, 21, "imports are not ordered")]
  const selected = changed_lint_findings(import_order, added_second_import, source_reader(sources))
  assert_eq(selected.ok, true)
  assert_eq(selected.findings[0]?.line, 2)
  const added_third_line = [{path: "lib/new.harn", start: 3, end: 3}]
  assert_eq(
    changed_lint_findings(import_order, added_third_line, source_reader(sources)).findings,
    [],
  )
}

pipeline test_changed_lint_findings_honors_half_open_and_zero_width_spans(task) {
  const source = "first\nsecond\n"
  const sources = {"lib/new.harn": source}
  const line_two = [{path: "lib/new.harn", start: 2, end: 2}]
  assert_eq(
    changed_lint_findings([decoded_diagnostic(0, 6)], line_two, source_reader(sources)).findings,
    [],
  )
  assert_eq(
    len(changed_lint_findings([decoded_diagnostic(0, 7)], line_two, source_reader(sources)).findings),
    1,
  )
  assert_eq(
    len(changed_lint_findings([decoded_diagnostic(6, 6)], line_two, source_reader(sources)).findings),
    1,
  )
  assert_eq(
    changed_lint_findings([decoded_diagnostic(5, 5)], line_two, source_reader(sources)).findings,
    [],
  )
  const line_three = [{path: "lib/new.harn", start: 3, end: 3}]
  assert_eq(
    len(
      changed_lint_findings([decoded_diagnostic(13, 13)], line_three, source_reader(sources)).findings,
    ),
    1,
  )
}

pipeline test_changed_lint_findings_maps_unicode_bytes_and_rejects_out_of_bounds(task) {
  const source = "α\nlet value = 1\n"
  const sources = {"lib/new.harn": source}
  const line_two = [{path: "lib/new.harn", start: 2, end: 2}]
  const unicode = changed_lint_findings([decoded_diagnostic(3, 6)], line_two, source_reader(sources))
  assert_eq(unicode.ok, true)
  assert_eq(unicode.findings[0]?.line, 2)
  const invalid = changed_lint_findings([decoded_diagnostic(3, 100)], line_two, source_reader(sources))
  assert_eq(invalid.ok, false)
}

pipeline test_changed_harn_lint_allows_legacy_diagnostics_but_blocks_added_lines(task) {
  const diff_argv = changed_harn_diff_argv("base", "head")
  const patch_argv = changed_harn_patch_argv("base", "head", ["lib/new.harn"])
  const lint_argv = strict_harn_lint_argv("harn", ["lib/new.harn"])
  const sources = {"lib/new.harn": "let new_value = 1\nlet legacy_value = 2\n"}
  const legacy = [
    {
      source: "lint",
      severity: "warning",
      code: "HARN-LNT-018",
      message: "legacy",
      span: {start: 18, end: 34},
    },
  ]
  const legacy_gate = changed_harn_lint_gate(
    harness,
    "/repo",
    "base",
    "head",
    "harn",
    scripted_runner(
      [
        {key: join(diff_argv, "\n"), result: ok("lib/new.harn\n")},
        {key: join(patch_argv, "\n"), result: ok(PATCH)},
        {key: join(lint_argv, "\n"), result: strict_lint_result(legacy)},
      ],
    ),
    { spec -> sources[spec.path] },
  )
  assert_eq(legacy_gate.ok, true)
  const added = [
    {
      source: "lint",
      severity: "warning",
      code: "HARN-LNT-018",
      message: "new",
      span: {start: 0, end: 17},
    },
  ]
  const added_gate = changed_harn_lint_gate(
    harness,
    "/repo",
    "base",
    "head",
    "harn",
    scripted_runner(
      [
        {key: join(diff_argv, "\n"), result: ok("lib/new.harn\n")},
        {key: join(patch_argv, "\n"), result: ok(PATCH)},
        {key: join(lint_argv, "\n"), result: strict_lint_result(added)},
      ],
    ),
    { spec -> sources[spec.path] },
  )
  assert_eq(added_gate.ok, false)
  assert_eq(added_gate.kind, "changed_strict_lint_failed")
  assert(contains(added_gate.detail, "lib/new.harn:1: HARN-LNT-018"))
}

pipeline test_changed_harn_lint_gate_rejects_malformed_spans(task) {
  const diff_argv = changed_harn_diff_argv("base", "head")
  const patch_argv = changed_harn_patch_argv("base", "head", ["lib/new.harn"])
  const lint_argv = strict_harn_lint_argv("harn", ["lib/new.harn"])
  const malformed = lint_diagnostic(0, 17) + {span: {start: "0", end: 17}}
  const gate = changed_harn_lint_gate(
    harness,
    "/repo",
    "base",
    "head",
    "harn",
    scripted_runner(
      [
        {key: join(diff_argv, "\n"), result: ok("lib/new.harn\n")},
        {key: join(patch_argv, "\n"), result: ok(PATCH)},
        {
          key: join(lint_argv, "\n"),
          result: {success: false, status: 1, stdout: lint_report([malformed]), stderr: ""},
        },
      ],
    ),
  )
  assert_eq(gate.ok, false)
  assert_eq(gate.kind, "lint_json_invalid")
  assert(contains(gate.detail, ".span.start and .span.end must be non-negative integers"))
}

pipeline test_changed_harn_lint_gate_rejects_exit_status_envelope_mismatch(task) {
  const diff_argv = changed_harn_diff_argv("base", "head")
  const patch_argv = changed_harn_patch_argv("base", "head", ["lib/new.harn"])
  const lint_argv = strict_harn_lint_argv("harn", ["lib/new.harn"])
  const gate = changed_harn_lint_gate(
    harness,
    "/repo",
    "base",
    "head",
    "harn",
    scripted_runner(
      [
        {key: join(diff_argv, "\n"), result: ok("lib/new.harn\n")},
        {key: join(patch_argv, "\n"), result: ok(PATCH)},
        {
          key: join(lint_argv, "\n"),
          result: {success: false, status: 7, stdout: lint_report([]), stderr: "transport failed"},
        },
      ],
    ),
  )
  assert_eq(gate.ok, false)
  assert_eq(gate.kind, "lint_status_invalid")
  assert_eq(gate.status, 7)
}

pipeline test_changed_harn_lint_rejects_ambiguous_git_quoted_paths(task) {
  const diff_argv = changed_harn_diff_argv("base", "head")
  const quoted = "\"line\\nbreak.harn\""
  assert_eq(quoted_git_paths(quoted + "\n"), [quoted])
  const gate = changed_harn_lint_gate(
    harness,
    "/repo",
    "base",
    "head",
    "harn",
    scripted_runner([{key: join(diff_argv, "\n"), result: ok(quoted + "\n")}]),
  )
  assert_eq(gate.ok, false)
  assert_eq(gate.kind, "quoted_git_path")
  assert_eq(gate.status, 2)
}

pipeline test_changed_harn_lint_surfaces_git_range_failure(task) {
  const diff_argv = changed_harn_diff_argv("missing", "head")
  const gate = changed_harn_lint_gate(
    harness,
    "/repo",
    "missing",
    "head",
    "harn",
    scripted_runner([{key: join(diff_argv, "\n"), result: fail(128, "fatal: bad revision")}]),
  )
  assert_eq(gate.ok, false)
  assert_eq(gate.kind, "diff_failed")
  assert_eq(gate.status, 128)
  assert(contains(gate.detail, "bad revision"))
}
