import {
  HAND_TAG_CANDIDATE_TRAILER,
  HandTagEvidence,
  hand_tag_candidate_trailer,
  hand_tagged_candidate_verdict,
} from "../lib/hand_tagged_candidate"
import { ReleasePinConfig } from "../lib/release_runtime"

const CANDIDATE = "bd78be56d71af872affe677d482408565b87b391"

const OTHER = "4362643c36770ed3f07f7bc6e4bde8a6b6dbd70d"

const SIGNATURE = "-----BEGIN SSH SIGNATURE-----\n"
  + "U1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgAuIZSLlvpNUhvN8U2eLPtt89tc\n"
  + "-----END SSH SIGNATURE-----\n"

/** The real v0.10.133 tag message, which is what this was built against. */
fn message(candidate: string) -> string {
  return "Release v0.10.133\n\n${HAND_TAG_CANDIDATE_TRAILER}: ${candidate}\n" + SIGNATURE
}

fn evidence(overrides: dict = {}) -> HandTagEvidence {
  const base = {
    tag: "v0.10.133",
    object_type: "tag",
    signature_verified: true,
    message: message(CANDIDATE),
    tagged_commit: CANDIDATE,
    certify_branch_head: CANDIDATE,
  }
  return base + overrides
}

pipeline test_a_signed_annotated_tag_on_a_certified_candidate_is_admitted() {
  const verdict = hand_tagged_candidate_verdict(evidence(), true)
  assert_eq(verdict.admitted, true)
  assert_eq(verdict.candidate, CANDIDATE)
  assert_eq(verdict.refusal, nil)
}

/**
 * Negative control one: an unsigned tag.
 *
 * Without the signature the message is authored by whoever could write the
 * ref, so the trailer stops being evidence about who chose the candidate and
 * becomes text anyone with push access can supply.
 */
pipeline test_an_unsigned_tag_is_refused_with_its_own_cause() {
  const verdict = hand_tagged_candidate_verdict(evidence({signature_verified: false}), true)
  assert_eq(verdict.admitted, false)
  assert_eq(verdict.refusal, "tag_signature_unverified")
}

/**
 * Negative control two: a trailer naming the wrong commit.
 *
 * This is the shape that would let a resume run against a tree the harness
 * never certified, so it must not be reachable by any combination of the
 * other checks passing.
 */
pipeline test_a_trailer_naming_another_commit_is_refused_with_its_own_cause() {
  const verdict = hand_tagged_candidate_verdict(
    evidence({message: message(OTHER), certify_branch_head: OTHER}),
    true,
  )
  assert_eq(verdict.admitted, false)
  assert_eq(verdict.refusal, "tag_points_elsewhere")
  assert(contains(verdict.detail, OTHER))
}

/**
 * Negative control three: a bare sha with no tag behind it.
 *
 * A lightweight tag has no message, so there is nothing to sign and nothing to
 * name a candidate. This is the plain ancestry-less commit that the ancestry
 * check exists to refuse, and the override must not widen to admit it.
 */
pipeline test_a_lightweight_tag_is_refused_with_its_own_cause() {
  const verdict = hand_tagged_candidate_verdict(
    evidence({object_type: "commit", message: "", signature_verified: false}),
    true,
  )
  assert_eq(verdict.admitted, false)
  assert_eq(verdict.refusal, "tag_not_annotated")
}

/**
 * The override is scoped to a resume and nothing else.
 *
 * A fresh release skipping ancestry on the strength of a tag would let the tag
 * choose the tree, which inverts the direction of the whole release contract.
 */
pipeline test_a_fresh_release_still_requires_ancestry() {
  const verdict = hand_tagged_candidate_verdict(evidence(), false)
  assert_eq(verdict.admitted, false)
  assert_eq(verdict.refusal, "resume_not_requested")
}

/**
 * An uncertified candidate is refused even when the tag is perfect.
 *
 * The certification branch is the only part of this that the tagger cannot
 * write by tagging, so it is the part that actually ties the tag to a run of
 * the harness. If a missing branch admitted, the whole check would reduce to
 * "trust a signed tag".
 */
pipeline test_a_perfect_tag_on_an_uncertified_candidate_is_refused() {
  const absent = hand_tagged_candidate_verdict(evidence({certify_branch_head: ""}), true)
  assert_eq(absent.admitted, false)
  assert_eq(absent.refusal, "candidate_not_certified")
  assert(contains(absent.detail, "no such branch"))
  const moved = hand_tagged_candidate_verdict(evidence({certify_branch_head: OTHER}), true)
  assert_eq(moved.admitted, false)
  assert_eq(moved.refusal, "candidate_not_certified")
}

pipeline test_a_message_with_no_trailer_is_refused() {
  const verdict = hand_tagged_candidate_verdict(
    evidence({message: "Release v0.10.133\n" + SIGNATURE}),
    true,
  )
  assert_eq(verdict.admitted, false)
  assert_eq(verdict.refusal, "tag_missing_candidate_trailer")
}

/**
 * The trailer is read from the message, never from the signature bytes.
 *
 * The signature is base64 and can contain any characters, so a parser that
 * scanned the whole message would let the signature block declare what it is
 * signing. The fixture puts a well-formed trailer inside the signature and
 * asserts it is not seen.
 */
pipeline test_a_trailer_inside_the_signature_block_is_not_read() {
  const smuggled = "Release v0.10.133\n"
    + "-----BEGIN SSH SIGNATURE-----\n"
    + "${HAND_TAG_CANDIDATE_TRAILER}: ${CANDIDATE}\n"
    + "-----END SSH SIGNATURE-----\n"
  assert_eq(hand_tag_candidate_trailer(smuggled), nil)
  assert_eq(
    hand_tagged_candidate_verdict(evidence({message: smuggled}), true).refusal,
    "tag_missing_candidate_trailer",
  )
}

/** Two trailers disagreeing cannot both be the answer, so neither is. */
pipeline test_two_disagreeing_trailers_name_no_candidate() {
  const doubled = "Release v0.10.133\n\n"
    + "${HAND_TAG_CANDIDATE_TRAILER}: ${CANDIDATE}\n"
    + "${HAND_TAG_CANDIDATE_TRAILER}: ${OTHER}\n"
  assert_eq(hand_tag_candidate_trailer(doubled), nil)
}

/** A trailer repeated with the same value is one answer, not an ambiguity. */
pipeline test_a_repeated_identical_trailer_is_still_one_candidate() {
  const doubled = "Release v0.10.133\n\n"
    + "${HAND_TAG_CANDIDATE_TRAILER}: ${CANDIDATE}\n"
    + "${HAND_TAG_CANDIDATE_TRAILER}: ${CANDIDATE}\n"
  assert_eq(hand_tag_candidate_trailer(doubled), CANDIDATE)
}

/** A trailer that is present but not an object id names nothing. */
pipeline test_a_malformed_trailer_value_names_no_candidate() {
  for bad in ["", "bd78be56", "not-a-sha", "bd78be56d71af872affe677d482408565b87b39"] {
    assert_eq(
      hand_tag_candidate_trailer("Release v1\n\n${HAND_TAG_CANDIDATE_TRAILER}: ${bad}\n"),
      nil,
    )
  }
}

/** Case and surrounding whitespace are not part of an object id's identity. */
pipeline test_the_candidate_comparison_ignores_case_and_padding() {
  const verdict = hand_tagged_candidate_verdict(
    evidence(
      {
        message: "Release v1\n\n${HAND_TAG_CANDIDATE_TRAILER}:   ${uppercase(CANDIDATE)}  \n",
        tagged_commit: uppercase(CANDIDATE),
        certify_branch_head: "  ${uppercase(CANDIDATE)}  ",
      },
    ),
    true,
  )
  assert_eq(verdict.admitted, true)
  assert_eq(verdict.candidate, CANDIDATE)
}

/**
 * The resume flag survives the narrowing into the pin config.
 *
 * `resolve_pin_sha` takes `ReleasePinConfig`, a narrower shape than the
 * `ReleaseConfig` the planner builds, and the admission is scoped by a field
 * that was only on the wider one until this change. If the field did not
 * survive the narrowing, every hand-tagged resume would refuse with
 * `resume_not_requested` and the whole path would be unreachable while looking
 * correct. This asserts the value arrives, which is the difference between a
 * gate that is closed and a gate that is not wired.
 */
pipeline test_the_resume_flag_survives_the_pin_config_narrowing() {
  const planner_shaped: ReleasePinConfig = {
    mock: false,
    repo: ".",
    base: "main",
    mode: "ship-pr",
    yes_live_release: true,
    pin_sha_input: CANDIDATE,
    allow_base_drift: false,
    resume_tagged_release: true,
  }
  assert_eq(planner_shaped.resume_tagged_release, true)
  assert_eq(
    hand_tagged_candidate_verdict(evidence(), planner_shaped.resume_tagged_release ?? false)
      .admitted,
    true,
  )
  // And a config that never set it refuses rather than admitting.
  const older: ReleasePinConfig = {
    mock: false,
    repo: ".",
    base: "main",
    mode: "ship-pr",
    yes_live_release: true,
    pin_sha_input: CANDIDATE,
    allow_base_drift: false,
  }
  assert_eq(
    hand_tagged_candidate_verdict(evidence(), older.resume_tagged_release ?? false).refusal,
    "resume_not_requested",
  )
}
