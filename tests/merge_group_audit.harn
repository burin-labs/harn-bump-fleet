import {
  merge_group_audit_config,
  merge_group_audit_receipt,
  merge_group_audit_transition,
  release_audit_contract_required_jobs,
  resolve_merge_group_audit,
} from "../lib/merge_group_audit"

const PIN = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const BINARY_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const REQUIRED = ["Format check", "Rust lint", "Rust test", "Harn conformance + audit"]

fn config() {
  return merge_group_audit_config(PIN, REQUIRED)
}

fn run(head_sha = PIN) {
  return {
    id: 7001,
    url: "https://github.com/burin-labs/harn/actions/runs/7001",
    head_sha: head_sha,
    event: "merge_group",
    status: "completed",
    conclusion: "success",
  }
}

fn job(id, name, conclusion = "success", run_id = 7001) {
  return {
    id: id,
    run_id: run_id,
    name: name,
    url: "https://github.com/burin-labs/harn/actions/runs/${run_id}/job/${id}",
    status: "completed",
    conclusion: conclusion,
  }
}

fn jobs() {
  return [
    job(8001, REQUIRED[0]),
    job(8002, REQUIRED[1]),
    job(8003, REQUIRED[2]),
    job(8004, REQUIRED[3]),
    job(8005, "Rust on macOS (deny-warnings build + lint)", "skipped"),
  ]
}

fn observation(runs = nil, observed_jobs = nil) {
  const selected_runs = runs ?? [run()]
  const selected_jobs = observed_jobs ?? jobs()
  return {
    observed_at: "2026-07-13T12:00:00Z",
    total_runs: len(selected_runs),
    runs: selected_runs,
    total_jobs: len(selected_jobs),
    jobs: selected_jobs,
  }
}

pipeline test_release_contract_owns_required_job_identities(task) {
  const path = path_join(harness.fs.temp_dir(), "release-audit-contract-" + uuid_v7() + ".json")
  harness.fs
    .write_text(
    path,
    json_stringify(
      {
        schema_version: "harn.release_audit_contract.v1",
        lanes: [],
        merge_group_jobs: REQUIRED
          .map(
          { name -> return {name: name, job_id: "ignored", matrix_kind: "", proofs: ["proof"], steps: []} },
        )
          .to_list(),
      },
    ),
  )
  assert_eq(release_audit_contract_required_jobs(path), REQUIRED)
  harness.fs.write_text(path, json_stringify({merge_group_jobs: [{name: REQUIRED[0], proofs: []}]}))
  assert_eq(release_audit_contract_required_jobs(path), nil)
}

pipeline test_green_evidence_closes_the_harn_receipt(task) {
  const decision = merge_group_audit_transition(config(), observation())
  assert_eq(decision.reuse, true)
  assert(decision.evidence != nil)
  if decision.evidence != nil {
    const receipt = merge_group_audit_receipt(decision.evidence, BINARY_SHA)
    assert(receipt != nil)
    if receipt != nil {
      assert_eq(receipt.schema_version, "harn.release_audit_receipt.v1")
      assert_eq(receipt.run.id, 7001)
      assert_eq(receipt.run.workflow, "CI")
      assert_eq(receipt.jobs.map({ row -> row.name }).to_list(), REQUIRED)
      assert_eq(receipt.warm.command, "cargo build -p harn-cli --bin harn --locked")
      assert_eq(receipt.warm.binary_sha256, BINARY_SHA)
    }
  }
  assert_eq(merge_group_audit_receipt(decision.evidence, "bad"), nil)
}

pipeline test_wrong_sha_event_or_terminal_state_falls_back(task) {
  const wrong = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const wrong_sha = merge_group_audit_transition(config(), observation([run(wrong)]))
  assert_eq(wrong_sha.reuse, false)
  assert(contains(wrong_sha.reason, "expected ${PIN}"))
  const wrong_event = merge_group_audit_transition(config(), observation([{...run(), event: "pull_request"}]))
  assert_eq(wrong_event.reuse, false)
  assert(contains(wrong_event.reason, "expected merge_group"))
  const queued = merge_group_audit_transition(
    config(),
    observation([{...run(), status: "in_progress", conclusion: ""}]),
  )
  assert_eq(queued.reuse, false)
  const failed = merge_group_audit_transition(config(), observation([{...run(), conclusion: "failure"}]))
  assert_eq(failed.reuse, false)
}

pipeline test_zero_multiple_or_incomplete_snapshots_fall_back(task) {
  const zero = merge_group_audit_transition(config(), observation([], []))
  assert_eq(zero.reuse, false)
  assert(contains(zero.reason, "observed 0"))
  const multiple = merge_group_audit_transition(config(), observation([run(), {...run(), id: 7002}]))
  assert_eq(multiple.reuse, false)
  assert(contains(multiple.reason, "observed 2"))
  let incomplete = observation()
  incomplete.total_jobs = len(incomplete.jobs) + 1
  assert_eq(merge_group_audit_transition(config(), incomplete).reuse, false)
}

pipeline test_required_job_missing_ambiguous_skipped_or_failed_falls_back(task) {
  const missing = jobs().filter({ row -> row.name != REQUIRED[2] }).to_list()
  assert(
    contains(merge_group_audit_transition(config(), observation(nil, missing)).reason, REQUIRED[2]),
  )
  const duplicate = jobs() + [job(8010, REQUIRED[1])]
  assert(
    contains(merge_group_audit_transition(config(), observation(nil, duplicate)).reason, "ambiguous"),
  )
  const observed = jobs()
  const skipped = observed
    .map(
    { row ->
      if row.name == REQUIRED[0] {
        return {...row, conclusion: "skipped"}
      }
      return row
    },
  ).to_list()
  assert(
    contains(merge_group_audit_transition(config(), observation(nil, skipped)).reason, "successfully"),
  )
  const failed = observed
    .map(
    { row ->
      if row.name == REQUIRED[3] {
        return {...row, conclusion: "failure"}
      }
      return row
    },
  ).to_list()
  assert(
    contains(
      merge_group_audit_transition(config(), observation(nil, failed)).reason,
      "concluded failure",
    ),
  )
}

pipeline test_wrong_job_run_or_in_progress_job_falls_back(task) {
  const wrong_run = [{...jobs()[0], run_id: 9999}] + jobs()[1:]
  assert(
    contains(
      merge_group_audit_transition(config(), observation(nil, wrong_run)).reason,
      "belongs to run",
    ),
  )
  const active = [{...jobs()[0], status: "in_progress", conclusion: ""}] + jobs()[1:]
  assert(
    contains(merge_group_audit_transition(config(), observation(nil, active)).reason, "not completed"),
  )
}

pipeline test_query_and_schema_errors_fall_back_without_jobs_guessing(task) {
  const query_error = resolve_merge_group_audit(
    config(),
    {
      list_runs: fn(_config) { return {success: false, error: "workflow runs query failed"} },
      list_jobs: fn(_config, _run_id) { return {success: false, error: "unexpected jobs query"} },
    },
  )
  assert_eq(query_error.reuse, false)
  let jobs_queries = 0
  const schema_error = resolve_merge_group_audit(
    config(),
    {
      list_runs: fn(_config) { return {success: true, value: {total_runs: 1, runs: [{...run(), id: "bad"}]}, error: ""} },
      list_jobs: fn(_config, _run_id) {
        jobs_queries = jobs_queries + 1
        return {success: false, error: "unexpected jobs query"}
      },
    },
  )
  assert_eq(schema_error.reuse, false)
  assert(contains(schema_error.reason, "schema validation failed"))
  assert_eq(jobs_queries, 0)
  const jobs_schema_error = resolve_merge_group_audit(
    config(),
    {
      list_runs: fn(_config) { return {success: true, value: {total_runs: 1, runs: [run()]}, error: ""} },
      list_jobs: fn(_config, _run_id) { return {success: true, value: {total_jobs: 1, jobs: [{...job(8001, REQUIRED[0]), id: "bad"}]}, error: ""} },
    },
  )
  assert_eq(jobs_schema_error.reuse, false)
  assert(contains(jobs_schema_error.reason, "workflow-jobs schema validation failed"))
}
