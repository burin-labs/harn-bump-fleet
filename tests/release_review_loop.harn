import { release_agent_iteration_budget } from "../lib/release_agent"
import { release_analysis_evidence_decision } from "../lib/release_agent_evidence"
import {
  release_review_attempt_with_evidence,
  validate_agent_attempt,
} from "../lib/release_agent_tools"
import { release_review_post_turn } from "../lib/release_agent_tools"
import { ReleaseAnalysis } from "../lib/release_analysis"
import {
  agent_review_attempt_name,
  agent_review_attempt_values,
  agent_review_execute,
} from "../lib/release_review_loop"
import { ReleaseNotesScope } from "../lib/release_runtime"
import { agent_review_attempt_selection } from "../release_harn.harn"

/**
 * Regression tests for the release audit run -> validate -> repair loop after it
 * moved onto harn's `workflow_run_repair` primitive (inline executor + retry
 * context feedback). The parity contract these guard:
 *   - the loop runs at most 3 attempts and stops on the first clean attempt;
 *   - each attempt is named initial-review / validation-repair-1 / ...;
 *   - a failing attempt's findings thread into the next attempt (so the repair
 *     prompt for attempt N contains attempt N-1's findings) — a findings-LESS
 *     repair prompt would be a silent correctness regression.
 */
fn fake_record(name: any, text: any, findings: any) {
  return {
    name: name,
    text: text,
    validation_findings: findings,
    llm: {},
    tools: {},
    status: "completed",
  }
}

pipeline test_attempt_names(task: any) {
  assert_eq(agent_review_attempt_name(1), "initial-review")
  assert_eq(agent_review_attempt_name(2), "validation-repair-1")
  assert_eq(agent_review_attempt_name(3), "validation-repair-2")
}

pipeline test_release_audit_budget_includes_evidence_and_finalization_turns(task: any) {
  // Production run 31717246879 made three successful planner calls while
  // gathering evidence, then exhausted the former four-turn initial budget
  // before the callback-driven no-tool final audit. Keep two turns of bounded
  // recovery room beyond delta + content + callback + finalization.
  assert_eq(
    release_agent_iteration_budget(true),
    {mode: "adaptive", initial: 6, max: 12, extend_by: 2, expose_decisions: true},
  )
  assert_eq(
    release_agent_iteration_budget(false),
    {mode: "fixed", initial: 1, max: 1, extend_by: 0},
  )
  // This repo is not the source of the hosted `max: 8` receipt. The evidence
  // role asks for 12; Harn reports that value when expose_decisions is on.
  // Adaptive mode then declines to extend a tool-less, text-less turn — that
  // is progress policy, not a silent clamp of max down to 8.
  assert_eq(release_agent_iteration_budget(true).max == 8, false)
}

pipeline test_three_attempt_scenario_threads_prior_findings(harness: Harness, task: any) {
  const review = agent_review_execute(
    harness,
    {
      task: "BASE-PROMPT",
      max_attempts: 3,
      // Emulate production selection: attempt 1 runs the base prompt; every
      // repair attempt rebuilds its prompt from the prior attempt's findings.
      run_attempt: { ctx ->
        const prompt = if ctx.attempt <= 1 {
          "INITIAL-PROMPT"
        } else {
          "REPAIR prior_findings=[" + join(ctx.prior_findings, ", ") + "] prior_text="
            + ctx.prior_text
        }
        const findings_to_report = if ctx.attempt <= 2 {
          ["finding-from-attempt-" + to_string(ctx.attempt)]
        } else {
          []
        }
        {visible_text: prompt, findings_to_report: findings_to_report}
      },
      validate: { result, _text -> result["findings_to_report"] ?? [] },
      make_record: { name, text, findings, _result -> fake_record(name, text, findings) },
    },
  )
  // (a) exactly three attempt records with the canonical names.
  assert_eq(len(review.attempts), 3)
  assert_eq(review.attempts[0].name, "initial-review")
  assert_eq(review.attempts[1].name, "validation-repair-1")
  assert_eq(review.attempts[2].name, "validation-repair-2")
  // (b) the repair prompt for attempt 2 contains attempt-1's findings text, and
  // attempt 3 threads attempt-2's findings — proving feedback is not dropped.
  assert_eq(contains(review.attempts[1].text, "finding-from-attempt-1"), true)
  assert_eq(contains(review.attempts[2].text, "finding-from-attempt-2"), true)
  // Per-attempt findings are recorded on each attempt.
  assert_eq(review.attempts[0].validation_findings, ["finding-from-attempt-1"])
  assert_eq(review.attempts[1].validation_findings, ["finding-from-attempt-2"])
  assert_eq(review.attempts[2].validation_findings, [])
  // The loop stops on the first clean attempt; final values come from it.
  assert_eq(review.validation_findings, [])
  assert_eq(review.text, review.attempts[2].text)
  assert_eq(review.final_result.visible_text, review.attempts[2].text)
}

pipeline test_stops_when_first_attempt_passes(harness: Harness, task: any) {
  const review = agent_review_execute(
    harness,
    {
      task: "BASE",
      max_attempts: 3,
      run_attempt: { _ctx -> {visible_text: "clean audit"} },
      validate: { _result, _text -> [] },
      make_record: { name, text, findings, _result -> fake_record(name, text, findings) },
    },
  )
  assert_eq(len(review.attempts), 1)
  assert_eq(review.attempts[0].name, "initial-review")
  assert_eq(review.validation_findings, [])
}

pipeline test_attempt_values_prefer_canonical_workflow_surface(task: any) {
  const canonical = [{verification: {record: {name: "canonical"}}}]
  const nested = [{verification: {record: {name: "nested"}}}]
  assert_eq(
    agent_review_attempt_values({attempts: canonical, run: {stages: [{attempts: nested}]}}),
    canonical,
  )
  assert_eq(
    agent_review_attempt_values({attempts: [], run: {stages: [{attempts: nested}]}}),
    nested,
  )
}

pipeline test_validation_failure_preserves_attempt_error(harness: Harness, task: any) {
  let message = ""
  try {
    agent_review_execute(
      harness,
      {
        task: "BASE",
        max_attempts: 2,
        run_attempt: { _ctx -> {visible_text: "agent output"} },
        validate: { _result, _text ->
          throw "validator contract failed"
        },
        make_record: { name, text, findings, _result -> fake_record(name, text, findings) },
      },
    )
  } catch (error) {
    message = to_string(error)
  }
  assert_eq(contains(message, "release agent review produced no attempt records"), true)
  assert_eq(contains(message, "validator contract failed"), true)
  assert_eq(contains(message, "cannot access property"), false)
}

pipeline test_caps_at_max_attempts_when_findings_persist(harness: Harness, task: any) {
  const review = agent_review_execute(
    harness,
    {
      task: "BASE",
      max_attempts: 3,
      run_attempt: { ctx ->
        {visible_text: "t" + to_string(ctx.attempt), fnd: ["always-" + to_string(ctx.attempt)]}
      },
      validate: { result, _text -> result["fnd"] ?? [] },
      make_record: { name, text, findings, _result -> fake_record(name, text, findings) },
    },
  )
  // Never exceeds max_attempts even though every attempt still has findings.
  assert_eq(len(review.attempts), 3)
  assert_eq(review.attempts[2].name, "validation-repair-2")
  assert_eq(review.validation_findings, ["always-3"])
}

fn selection_analysis(fixup_mode: bool = false) -> ReleaseAnalysis {
  const notes_scope: ReleaseNotesScope = fixup_mode ? "frozen_artifact" : "candidate_tree"
  return {
    fixup_mode: fixup_mode,
    release_notes_scope: notes_scope,
    repo: "/tmp/harn",
    mode: "ship-pr",
    current_version: "1.2.2",
    next_version: "1.2.3",
    bump: "patch",
    pin_sha: "deadbeefcafe",
    base_branch: "main",
    latest_tag: "v1.2.2",
    operator_focus: "",
    changelog_top: "1.2.3",
    changelog_section: "## v1.2.3\n\n### Changed\n\n- Something.",
    changelog_unreleased_section: "",
    deterministic_findings: [],
    commits_since_latest_tag: "abc1234 release: important change",
    expected_branch: "release/v1.2.3",
    provider: "mock",
    model: "mock",
    mock: true,
    branch: "release/v1.2.3",
    pin_sha_input: "",
    source_snapshot: {
      kind: "mock",
      requested_sha: "",
      resolved_sha: "deadbeefcafe",
      analysis_head: "deadbeefcafe",
      analysis_root: "/tmp/harn",
      source_repo: "/tmp/harn",
    },
    fixup_tag: if fixup_mode {
      "v1.2.3"
    } else {
      ""
    },
    fixup_pr_url: "",
    fixup_publication: nil,
    prepared_release: false,
    dirty_files: 0,
    status: "",
    diff_stat: "",
    diff_names: "CHANGELOG.md",
    commit_file_changes_since_latest_tag: "M CHANGELOG.md",
    commit_stats_since_latest_tag: "1 file changed",
    post_tag_pr_numbers: [42],
    post_tag_pr_details: "PR #42",
    recent_merged_prs: "[]",
    release_scripts: {release_ship: true, release_gate: true},
    workflows: {publish_release: true, build_release_binaries: true},
    release_scope_findings: [],
  }
}

fn validated_audit_text() -> string {
  return "Audit:\n- Version/readiness: target `v1.2.3`.\n- CHANGELOG coverage: PR #42.\n- First post-tag commit: `abc1234 release: important change`.\n- Release risks: none.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Fixed\n\n- **Release audit completion.** Stop after deterministic validation.\nEND_DRAFT_CHANGELOG"
}

pipeline test_validated_tool_free_audit_stops_before_budget_exhaustion(
  harness: Harness,
  task: any,
) {
  const text = validated_audit_text()
  const verdict = release_review_post_turn(
    {fs: harness.fs, runtime: harness.runtime},
    {
      visible_text: text,
      text: text,
      has_tool_calls: false,
      successful_tool_names: [],
      session_successful_tools: [],
      dispatch: [],
    },
    selection_analysis(),
  )
  assert_eq(verdict?.stop, true)
  assert_eq(verdict?.stop_reason, "validated_release_audit")
}

pipeline test_validated_no_tool_repair_stops_with_carried_complete_evidence(
  harness: Harness,
  task: any,
) {
  const analysis = selection_analysis()
  const prior_evidence = release_analysis_evidence_decision(analysis)
  assert_eq(prior_evidence.complete, true)
  const evidence_cell = harness.runtime.shared_cell(
    {
      scope: "process",
      key: "release-review-complete-evidence-no-tool-repair",
      initial: prior_evidence.observations,
    },
  )
  const text = validated_audit_text()
  const verdict = release_review_post_turn(
    {fs: harness.fs, runtime: harness.runtime},
    {
      visible_text: text,
      text: text,
      has_tool_calls: false,
      successful_tool_names: [],
      session_successful_tools: [],
      dispatch: [],
    },
    analysis,
    evidence_cell,
  )
  assert_eq(verdict?.stop, true)
  assert_eq(verdict?.stop_reason, "validated_release_audit")
}

pipeline test_incomplete_tool_free_audit_does_not_stop(harness: Harness, task: any) {
  const verdict = release_review_post_turn(
    {fs: harness.fs, runtime: harness.runtime},
    {
      visible_text: "I need to inspect the release before writing the audit.",
      text: "I need to inspect the release before writing the audit.",
      has_tool_calls: false,
      successful_tool_names: [],
      session_successful_tools: [],
      dispatch: [],
    },
    selection_analysis(),
  )
  assert_eq(verdict, nil)
}

pipeline test_valid_audit_with_attempted_tool_call_stays_on_evidence_path(
  harness: Harness,
  task: any,
) {
  const text = validated_audit_text()
  const verdict = release_review_post_turn(
    {fs: harness.fs, runtime: harness.runtime},
    {
      visible_text: text,
      text: text,
      has_tool_calls: true,
      successful_tool_names: [],
      session_successful_tools: [],
      dispatch: [],
    },
    selection_analysis(),
  )
  assert_eq(verdict?.stop ?? false, false)
  assert_eq(contains(verdict?.message ?? "", "evidence remains incomplete"), true)
}

pipeline test_complete_evidence_survives_a_no_tool_repair_turn(task: any) {
  const complete_evidence = {
    complete: true,
    reason: "exact delta and concrete content observed",
    observations: [],
  }
  const initial = release_review_attempt_with_evidence(
    nil,
    {
      status: "budget_exhausted",
      tools: {successful: ["release_git", "release_read"]},
      release_agent_evidence: complete_evidence,
    },
  )
  const repaired = release_review_attempt_with_evidence(
    initial,
    {status: "budget_exhausted", tools: {successful: []}},
  )
  assert_eq(repaired.tools.successful, [])
  assert_eq(repaired.release_review_evidence.successful_tools, ["release_git", "release_read"])
  assert_eq(repaired.release_review_evidence.decision.complete, true)
  assert_eq(
    validate_agent_attempt(
      selection_analysis(true),
      repaired,
      "Audit:\n- The published release is internally consistent.",
    ),
    [],
  )
}

pipeline test_no_tool_repair_cannot_invent_missing_evidence(task: any) {
  const repaired = release_review_attempt_with_evidence(
    {status: "budget_exhausted", tools: {successful: []}},
    {status: "budget_exhausted", tools: {successful: []}},
  )
  const findings = validate_agent_attempt(
    selection_analysis(true),
    repaired,
    "Audit:\n- The published release is internally consistent.",
  )
  assert(findings.any({ finding -> contains(finding, "budget_exhausted") }))
}

pipeline test_attempt_selection_initial_uses_base_prompt(harness: Harness, task: any) {
  const selection = agent_review_attempt_selection(
    harness.fs,
    {attempt: 1, prior_findings: [], prior_text: ""},
    selection_analysis(),
    "BASE-SYSTEM",
    "BASE-USER-PROMPT",
  )
  assert_eq(selection.system, "BASE-SYSTEM")
  assert_eq(selection.prompt, "BASE-USER-PROMPT")
  assert_eq(selection.require_tool_evidence, true)
  assert_eq(selection.session_suffix, "")
}

pipeline test_attempt_selection_repair_prompt_threads_prior_findings(harness: Harness, task: any) {
  const marker = "MARKER-UNIQUE-FINDING-9f3a2b"
  const selection = agent_review_attempt_selection(
    harness.fs,
    {attempt: 2, prior_findings: [marker], prior_text: "prior audit text"},
    selection_analysis(),
    "BASE-SYSTEM",
    "BASE-USER-PROMPT",
  )
  // Repair attempts retain read-only tools so malformed calls can be repaired
  // and the typed evidence receipt can become complete.
  assert_eq(selection.require_tool_evidence, true)
  assert_eq(selection.session_suffix, "-repair-1")
  // The real repair prompt must embed the prior attempt's findings.
  assert_eq(contains(selection.prompt, marker), true)
  const selection3 = agent_review_attempt_selection(
    harness.fs,
    {attempt: 3, prior_findings: [marker], prior_text: "x"},
    selection_analysis(),
    "S",
    "P",
  )
  assert_eq(selection3.session_suffix, "-repair-2")
  assert_eq(contains(selection3.prompt, marker), true)
}

pipeline test_fixup_repair_selection_loads_its_contract(harness: Harness, task: any) {
  const standard_selection = agent_review_attempt_selection(
    harness.fs,
    {attempt: 2, prior_findings: ["retry"], prior_text: "prior audit"},
    selection_analysis(),
    "BASE-SYSTEM",
    "BASE-USER-PROMPT",
  )
  const selection = agent_review_attempt_selection(
    harness.fs,
    {attempt: 2, prior_findings: ["retry"], prior_text: "prior audit"},
    selection_analysis(true),
    "BASE-SYSTEM",
    "BASE-USER-PROMPT",
  )
  assert_eq(selection.system != "", true)
  // Fixup repairs must not fall back to the ordinary draft-authoring contract.
  assert_eq(selection.system != standard_selection.system, true)
  assert_eq(selection.require_tool_evidence, true)
  assert_eq(selection.session_suffix, "-repair-1")
}
