import {
  chat_cfg_from_run_dir,
  chat_enabled,
  classifier_payload,
  colorize_changelog,
  summarize_bump_run,
  summarize_release_run,
} from "../lib/chat_loop"

// -------------------------------------------------------------------------------------------------

// chat_enabled — kill-switch semantics. Cannot test the positive TTY branch
// from inside a non-TTY test runner; cover the deterministic short-circuits.

// -------------------------------------------------------------------------------------------------

pipeline test_chat_enabled_respects_no_chat(task) {
  assert_eq(chat_enabled({no_chat: true}), false)
  assert_eq(chat_enabled({}), false)
  assert_eq(chat_enabled({no_chat: false}), false)
}

// -------------------------------------------------------------------------------------------------
// classifier_payload — deterministic metrics on a synthetic changelog.
// -------------------------------------------------------------------------------------------------

pipeline test_classifier_payload_metrics(task) {
  let inputs = {
    changelog: """### Fixed

- a single fix bullet
""",
    pr_body: "Bump version.",
    findings: [],
  }
  let payload = classifier_payload(inputs)
  assert_eq(payload.metrics.breaking_hits, 0)
  assert_eq(payload.metrics.section_lines, 1)
  assert_eq(payload.metrics.bullet_lines, 1)
  assert_eq(payload.metrics.finding_count, 0)
}

pipeline test_classifier_payload_detects_breaking(task) {
  let inputs = {
    changelog: """### Changed

- BREAKING: rename the foo flag to bar (incompatible upgrade)
- restructure the bazr module
""",
    pr_body: "",
    findings: ["release scripts are missing or not executable"],
  }
  let payload = classifier_payload(inputs)
  assert_eq(payload.metrics.breaking_hits >= 1, true)
  assert_eq(payload.metrics.finding_count, 1)
  assert_eq(payload.metrics.bullet_lines, 2)
}

// -------------------------------------------------------------------------------------------------

// summarize_release_run / summarize_bump_run — fail-soft on missing dirs.
// We do not assume a specific fixture run exists (the repo is shared CI),
// so the negative path is the contract.

// -------------------------------------------------------------------------------------------------

pipeline test_summarize_release_run_handles_missing(task) {
  let summary = summarize_release_run(harness, "/nonexistent/run/path-that-does-not-exist")
  assert_eq(summary.ok, false)
  assert_eq(summary.version, "?")
}

pipeline test_summarize_bump_run_handles_missing(task) {
  let summary = summarize_bump_run(harness, "/nonexistent/run/path-that-does-not-exist")
  assert_eq(summary.ok, false)
  assert_eq(summary.version, "?")
}

// -------------------------------------------------------------------------------------------------
// chat_cfg_from_run_dir — path derivation.
// -------------------------------------------------------------------------------------------------

pipeline test_chat_cfg_from_run_dir_derives_release_paths(task) {
  let cfg = chat_cfg_from_run_dir(
    harness,
    {provider: "ollama", model: "test", timeout_s: 30},
    "release-harn",
    "/tmp/harn-runs/release-harn/01999999-0000-0000-0000-000000000000",
  )
  assert_eq(cfg.harness_kind, "release-harn")
  assert_eq(cfg.run_id, "01999999-0000-0000-0000-000000000000")
  assert_eq(
    cfg.audit_md_path,
    "/tmp/harn-runs/release-harn/01999999-0000-0000-0000-000000000000/release-audit.md",
  )
  assert_eq(
    cfg.audit_json_path,
    "/tmp/harn-runs/release-harn/01999999-0000-0000-0000-000000000000/release-audit.json",
  )
  // Base fields flow through.
  assert_eq(cfg.provider, "ollama")
  assert_eq(cfg.model, "test")
  assert_eq(cfg.timeout_s, 30)
}

pipeline test_chat_cfg_from_run_dir_derives_bump_paths(task) {
  let cfg = chat_cfg_from_run_dir(
    harness,
    {provider: "ollama"},
    "bump-fleet",
    "/tmp/harn-runs/bump-fleet/01999999-0000-0000-0000-000000000001",
  )
  assert_eq(cfg.harness_kind, "bump-fleet")
  assert_eq(
    cfg.audit_md_path,
    "/tmp/harn-runs/bump-fleet/01999999-0000-0000-0000-000000000001/audit.md",
  )
  assert_eq(
    cfg.audit_json_path,
    "/tmp/harn-runs/bump-fleet/01999999-0000-0000-0000-000000000001/audit.json",
  )
}

// -------------------------------------------------------------------------------------------------

// colorize_changelog — visual rules. The gate's printed overview leans on
// ANSI weight to make red/green/bold separation between sections (`##`,
// `###`) and entries (`-`) at a glance, plus a red flag on BREAKING bullets
// and dim weight on continuation indents. We assert the escape sequences
// land in the right slots and that already-coloured input is left alone so
// the helper stays idempotent if pre-coloured CHANGELOGs flow through.

// -------------------------------------------------------------------------------------------------

pipeline test_colorize_changelog_marks_sections_and_bullets(task) {
  let raw = """## v1.2.3

### Added

- A new feature
- BREAKING: removed legacy flag
  continuation detail
"""
  let coloured = colorize_changelog(raw)
  // The raw text content is preserved (we only wrap, never strip).
  assert_eq(contains(coloured, "## v1.2.3"), true)
  assert_eq(contains(coloured, "### Added"), true)
  assert_eq(contains(coloured, "A new feature"), true)
  // BREAKING entries keep the `- ` marker (red+bold path retains the line
  // verbatim so the operator can still read it as a bullet).
  assert_eq(contains(coloured, "- BREAKING: removed legacy flag"), true)
  // Colour codes land — at least one bold-cyan and one bold-yellow opener
  // plus a reset for the `## v1.2.3` / `### Added` headers. Use the same
  // raw ESC-byte strings the lib defines so the test stays in sync with
  // the renderer.
  let ansi_reset = "[0m"
  let ansi_bold_cyan = "[1m[36m"
  let ansi_bold_yellow = "[1m[33m"
  let ansi_green = "[32m"
  let ansi_red = "[31m"
  let ansi_dim = "[2m"
  assert_eq(contains(coloured, ansi_bold_cyan + "## v1.2.3" + ansi_reset), true)
  assert_eq(contains(coloured, ansi_bold_yellow + "### Added" + ansi_reset), true)
  assert_eq(contains(coloured, ansi_green + "+ " + ansi_reset + "A new feature"), true)
  assert_eq(contains(coloured, ansi_red + "[1m- BREAKING:"), true)
  assert_eq(contains(coloured, ansi_dim + "  continuation detail" + ansi_reset), true)
}

pipeline test_colorize_changelog_is_idempotent_on_coloured_input(task) {
  let ansi_reset = "[0m"
  let pre_coloured = "[1m[36m## v1.0.0" + ansi_reset + "\nfoo"
  let result = colorize_changelog(pre_coloured)
  assert_eq(result, pre_coloured)
}
