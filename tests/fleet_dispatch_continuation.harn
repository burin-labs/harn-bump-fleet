  parse_fleet_manifest,
} from "../lib/fleet_manifest"
import { FleetOutcomeReceipt } from "../lib/run_receipts"

const CHAIN_ID = "33000000000"

const CONTROLLER_RUN_ID = 33000000001

pipeline test_scoped_continuation_refuses_excluded_dispatch_and_changed_scope(harness: Harness) {
  const scope = fleet_dispatch_scope(nil, "[\"owner/slow\"]")
  const original = fleet_dispatch_lineage("v0.10.119", CHAIN_ID, scope, 1, CONTROLLER_RUN_ID, 1)
  const receipt = fleet_dispatch_continuation_receipt(original, [], [])
  assert(
    thrown(
      { ->
        require_fleet_dispatch_continuation_predecessor(
          receipt,
          original + {scope: fleet_dispatch_scope(nil, "[\"owner/other\"]")},
        )
      },
    ),
  )
  assert(
    thrown(
      { ->
        fleet_dispatch_continuation_entry_write(
          {fs: harness.fs, random: harness.random},
          "/tmp/should-not-write-scope-receipt",
          original,
          dispatch_repo() + {slug: "owner/excluded"},
          123,
          "https://github.test/123",
        )
      },
    ),
  )
}

fn thrown(callback: closure) -> string {
  return try {
    callback()
    ""
  } catch (error) {
    to_string(error)
  }
}

fn lineage(
  target: string = "v0.10.119",
  chain_id: string = CHAIN_ID,
  update_round: int = 1,
  controller_run_id: int = CONTROLLER_RUN_ID,
  controller_run_attempt: int = 1,
  only: string? = nil,
) {
  return fleet_dispatch_lineage(
    target,
    chain_id,
    fleet_dispatch_scope(only),
    update_round,
    controller_run_id,
    controller_run_attempt,
  )
}

fn dispatch_repo() {
  return {
    slug: "owner/slow",
    dir: "/workspace/slow",
    common_dir: "/workspace/.git",
    update: {
      repository: "owner/slow",
      base_branch: "main",
      workflow_path: ".github/workflows/bump-harn.yml",
      workflow_name: "bump-harn.yml",
      branch: "automation/bump-harn-runtime",
      pin: {kind: "auto"},
      repair_enabled: true,
      auto_arm: true,
      require_signed_head: true,
      prerequisites: [],
      max_releases_behind: 1,
      adapter: {
        repository_owned: false,
        workflow_reference:
          "owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        orchestration_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        refresh_command: "",
        validation_command: "",
        node_version: "",
        publish_failure_for_repair: false,
        apply_behavior_preserving_fixes: false,
        enable_auto_merge: true,
      },
    },
  }
}

fn missing_snapshot() -> FleetConvergenceSnapshot {
  return {
    target: "v0.10.119",
    complete: false,
    terminal: true,
    total_count: 1,
    pending_count: 0,
    failing_count: 1,
    repositories: [
      {
        repo: "owner/slow",
        state: "failed",
        reason: "missing_bump_pull_request",
        default_branch_pin: "0.10.118",
      },
    ],
  }
}

fn observed(status: string, conclusion: string = "") -> FleetDispatchRunObservation {
  return {
    repository: "owner/slow",
    run_id: 4242,
    run_url: "https://github.com/owner/slow/actions/runs/4242",
    contract_matches: true,
    probe_ok: true,
    status: status,
    conclusion: conclusion,
    detail: "fixture exact run",
  }
}

pipeline test_accepted_run_changes_missing_pr_from_terminal_failure_to_waiting(task: any) {
  const continued = continue_fleet_convergence(missing_snapshot(), [observed("in_progress")])
  assert_eq([continued.terminal, continued.pending_count, continued.failing_count], [false, 1, 0])
  assert_eq(continued.repositories[0]?.reason, "accepted_bump_run_in_progress: in_progress")
  assert_eq(continued.repositories[0]?.workflow_run_id, 4242)
}

pipeline test_completed_accepted_run_waits_for_its_late_exact_pr(task: any) {
  const continued = continue_fleet_convergence(
    missing_snapshot(),
    [observed("completed", "success")],
  )
  assert_eq([continued.terminal, continued.pending_count, continued.failing_count], [false, 1, 0])
  assert_eq(continued.repositories[0]?.reason, "accepted_bump_run_completed_awaiting_exact_pr")
}

pipeline test_existing_exact_pr_state_wins_over_old_dispatch_continuation(task: any) {
  const late_pr = missing_snapshot()
    + {
      terminal: false,
      pending_count: 1,
      failing_count: 0,
      repositories: [
        {
          repo: "owner/slow",
          state: "waiting",
          reason: "checks_pending",
          pr_number: 77,
          pr_url: "https://github.com/owner/slow/pull/77",
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        },
      ],
    }
  const continued = continue_fleet_convergence(late_pr, [observed("completed", "success")])
  assert_eq(continued.repositories, late_pr.repositories)
  assert_eq(continued.pending_count, 1)
}

pipeline test_unrelated_or_failed_exact_run_cannot_mask_a_missing_pr(task: any) {
  const unrelated = observed("in_progress") + {repository: "owner/other"}
  const unchanged = continue_fleet_convergence(missing_snapshot(), [unrelated])
  assert_eq([unchanged.terminal, unchanged.failing_count], [true, 1])
  const failed = continue_fleet_convergence(missing_snapshot(), [observed("completed", "failure")])
  assert_eq([failed.terminal, failed.pending_count, failed.failing_count], [true, 0, 1])
  assert(starts_with(failed.repositories[0]?.reason ?? "", "accepted_bump_run_failure"))
}

pipeline test_unreadable_exact_run_fails_with_bound_run_identity(task: any) {
  const unavailable = observed("unknown")
    + {probe_ok: false, detail: "fixture connector unavailable"}
  const continued = continue_fleet_convergence(missing_snapshot(), [unavailable])
  assert_eq([continued.terminal, continued.pending_count, continued.failing_count], [true, 0, 1])
  assert_eq(
    continued.repositories[0]?.reason,
    "accepted_bump_run_probe_failed: fixture connector unavailable",
  )
  assert_eq(continued.repositories[0]?.workflow_run_id, 4242)
}

pipeline test_exact_run_continuation_round_trips_as_a_typed_durable_receipt(
  harness: Harness,
  task: any,
) {
  const receipt: FleetDispatchContinuationReceipt = {
    schema_version: "harn_bump_fleet.dispatch_continuation.v4",
    target: "v0.10.119",
    chain_id: CHAIN_ID,
    scope: {kind: "fleet"},
    update_round: 1,
    controller_run_id: CONTROLLER_RUN_ID,
    controller_run_attempt: 1,
    dispatches: [
      {
        repository: "owner/slow",
        target: "v0.10.119",
        workflow: "bump-harn.yml",
        run_id: 4242,
        run_url: "https://github.com/owner/slow/actions/runs/4242",
        base_branch: "main",
        branch: "automation/bump-harn-runtime",
      },
    ],
    deferrals: [],
  }
  const root = harness.fs.mkdtemp_in_workspace("dispatch-continuation-")
  const path = path_join(root, "receipt.json")
  fleet_dispatch_continuation_write({fs: harness.fs, random: harness.random}, path, receipt)
  assert_eq(fleet_dispatch_continuation_read(harness.fs, path), receipt)
}

pipeline test_dispatch_acceptance_is_readable_before_the_aggregate_exists(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("dispatch-entry-")
  const path = path_join(root, "receipt.json")
  fleet_dispatch_continuation_entry_write(
    {fs: harness.fs, random: harness.random},
    path,
    lineage(),
    dispatch_repo(),
    4242,
    "https://github.com/owner/slow/actions/runs/4242",
  )
  assert_eq(harness.fs.exists(path), false)
  const recovered = fleet_dispatch_continuation_read(harness.fs, path)
  assert(recovered != nil)
  assert_eq([recovered.target, recovered.dispatches[0]?.run_id], ["v0.10.119", 4242])
}

pipeline test_two_round_workflow_handoff_keeps_exact_run_4242_and_one_dispatch(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("two-round-continuation-")
  const path = path_join(root, "fleet-dispatch-continuation.json")
  fleet_dispatch_continuation_entry_write(
    {fs: harness.fs, random: harness.random},
    path,
    lineage(),
    dispatch_repo(),
    4242,
    "https://github.com/owner/slow/actions/runs/4242",
  )
  const restored = require_fleet_dispatch_continuation_predecessor(
    fleet_dispatch_continuation_read(harness.fs, path),
    lineage(),
  )
  assert_eq(restored.dispatches.map({ dispatch -> dispatch.run_id }).to_list(), [4242])
  const round_two = fleet_dispatch_continuation_rebind(
    {fs: harness.fs, random: harness.random},
    path,
    restored,
    lineage("v0.10.119", CHAIN_ID, 2, CONTROLLER_RUN_ID + 1),
  )
  const successor = require_fleet_dispatch_continuation_predecessor(
    fleet_dispatch_continuation_read(harness.fs, path),
    lineage("v0.10.119", CHAIN_ID, 2, CONTROLLER_RUN_ID + 1),
  )
  assert_eq(successor.dispatches.map({ dispatch -> dispatch.run_id }).to_list(), [4242])
  assert_eq(len(round_two.dispatches), 1, "round 2 must preserve one accepted dispatch")
}

pipeline test_predecessor_restore_rejects_unrelated_lineage_and_absence(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("predecessor-negative-")
  const path = path_join(root, "fleet-dispatch-continuation.json")
  const receipt: FleetDispatchContinuationReceipt = {
    schema_version: "harn_bump_fleet.dispatch_continuation.v4",
    target: "v0.10.119",
    chain_id: CHAIN_ID,
    scope: {kind: "fleet"},
    update_round: 1,
    controller_run_id: CONTROLLER_RUN_ID,
    controller_run_attempt: 1,
    dispatches: [],
    deferrals: [],
  }
  fleet_dispatch_continuation_write({fs: harness.fs, random: harness.random}, path, receipt)
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage("v0.10.119", "unrelated-chain"),
          )
        },
      ),
      "chain mismatch",
    ),
  )
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID + 99),
          )
        },
      ),
      "run mismatch",
    ),
  )
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 2),
          )
        },
      ),
      "run attempt mismatch",
    ),
  )
  assert(
    contains(
      thrown({ -> require_fleet_dispatch_continuation_predecessor(nil, lineage()) }),
      "absent",
    ),
  )
  assert(
    contains(
      thrown(
        { ->
          fleet_dispatch_continuation_rebind(
            {fs: harness.fs, random: harness.random},
            path,
            receipt,
            lineage("v0.10.119", CHAIN_ID, 3, CONTROLLER_RUN_ID + 1),
          )
        },
      ),
      "one run attempt or one controller round",
    ),
  )
}

pipeline test_predecessor_restore_rejects_scope_narrowing_and_widening(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("predecessor-scope-negative-")
  const path = path_join(root, "fleet-dispatch-continuation.json")
  const fleet_receipt = fleet_dispatch_continuation_receipt(lineage(), [dispatch_repo()], [])
  fleet_dispatch_continuation_write({fs: harness.fs, random: harness.random}, path, fleet_receipt)
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 1, "owner/slow"),
          )
        },
      ),
      "scope mismatch",
    ),
  )
  const repository_receipt = fleet_dispatch_continuation_receipt(
    lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 1, "owner/slow"),
    [dispatch_repo()],
    [],
  )
  fleet_dispatch_continuation_write(
    {fs: harness.fs, random: harness.random},
    path,
    repository_receipt,
  )
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage(),
          )
        },
      ),
      "scope mismatch",
    ),
  )
}

pipeline test_rerun_rebind_requires_the_exact_next_attempt_and_preserves_child_runs(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("predecessor-attempt-")
  const path = path_join(root, "fleet-dispatch-continuation.json")
  fleet_dispatch_continuation_entry_write(
    {fs: harness.fs, random: harness.random},
    path,
    lineage(),
    dispatch_repo(),
    4242,
    "https://github.com/owner/slow/actions/runs/4242",
  )
  const predecessor = require_fleet_dispatch_continuation_predecessor(
    fleet_dispatch_continuation_read(harness.fs, path),
    lineage(),
  )
  const rebound = fleet_dispatch_continuation_rebind(
    {fs: harness.fs, random: harness.random},
    path,
    predecessor,
    lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 2),
  )
  assert_eq(
    [rebound.controller_run_id, rebound.controller_run_attempt, rebound.dispatches[0]?.run_id],
    [CONTROLLER_RUN_ID, 2, 4242],
  )
  assert(
    contains(
      thrown(
        { ->
          fleet_dispatch_continuation_rebind(
            {fs: harness.fs, random: harness.random},
            path,
            rebound,
            lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 4),
          )
        },
      ),
      "one run attempt",
    ),
  )
}

/**
 * The consumer-owned hydration seam.
 *
 * A repository that owns its own contract carries no pin path and no refresh or
 * validate command in fleet.toml, so resolving its update spec from the raw
 * manifest throws by design. Every caller hydrates those rows into a separate
 * list before observing, and the observation must read that list. Reading the
 * manifest instead aborted the whole v0.10.127 round.
 */
fn consumer_manifest() -> FleetManifest {
  return parse_fleet_manifest(
    {
      schema_version: 1,
      fleet: {default_root: "~/projects", default_branch: "main"},
      policy: {
        package_workflow:
          "owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        bump_workflow:
          "owner/policy/.github/workflows/bump.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      },
      repositories: [
        {
          slug: "owner/consumer",
          directory: "consumer",
          consumer_owned_contract: true,
          harn_bump: true,
          bump_workflow_ownership: "fleet",
        },
      ],
    },
  )
}

fn hydrated_consumer() -> FleetRepository {
  return schema_expect(
    {
      slug: "owner/consumer",
      directory: "consumer",
      consumer_owned_contract: true,
      harn_bump: true,
      bump_workflow_ownership: "fleet",
      harn_pin_kind: "version_file",
      harn_pin_path: "private/version",
      bump_refresh_command: "private/refresh",
      bump_validate_command: "private/validate",
    },
    FleetRepository,
  )
}

fn consumer_snapshot() -> FleetConvergenceSnapshot {
  return {
    target: "v0.10.127",
    complete: false,
    terminal: true,
    total_count: 1,
    pending_count: 0,
    failing_count: 1,
    repositories: [
      {
        repo: "owner/consumer",
        state: "failed",
        reason: "missing_bump_pull_request",
        default_branch_pin: "0.10.126",
      },
    ],
  }
}

fn consumer_receipt(repository: string = "owner/consumer") -> FleetDispatchContinuationReceipt {
  return {
    schema_version: "harn_bump_fleet.dispatch_continuation.v4",
    target: "v0.10.127",
    chain_id: CHAIN_ID,
    scope: fleet_dispatch_scope(),
    update_round: 2,
    controller_run_id: CONTROLLER_RUN_ID,
    controller_run_attempt: 1,
    dispatches: [
      {
        repository: repository,
        target: "v0.10.127",
        workflow: "not-the-current-workflow.yml",
        run_id: 4242,
        run_url: "https://github.com/owner/consumer/actions/runs/4242",
        base_branch: "main",
        branch: "automation/bump-harn-runtime",
      },
    ],
    deferrals: [],
  }
}

pipeline test_observation_resolves_a_consumer_from_the_hydrated_list(harness: Harness, task: any) {
  const observations = dispatch_run_observations(
    harness,
    consumer_manifest(),
    [hydrated_consumer()],
    "v0.10.127",
    consumer_receipt(),
    consumer_snapshot(),
  )
  assert_eq(
    len(observations),
    1,
    "the consumer's accepted dispatch must be observed, not thrown on",
  )
  assert_eq(observations[0]?.repository, "owner/consumer")
  assert_eq(
    observations[0]?.contract_matches,
    false,
    "a receipt naming a stale workflow is a contract mismatch, not an abort",
  )
}

pipeline test_observation_still_refuses_a_repository_that_was_never_hydrated(
  harness: Harness,
  task: any,
) {
  const manifest = consumer_manifest()
  assert(
    contains(
      thrown(
        { ->
          dispatch_run_observations(
            harness,
            manifest,
            manifest.repositories,
            "v0.10.127",
            consumer_receipt(),
            consumer_snapshot(),
          )
        },
      ),
      "consumer contract was not hydrated",
    ),
    "an un-hydrated repository must still refuse rather than observe a spec it cannot resolve",
  )
}

pipeline test_observation_ignores_a_dispatch_for_an_unlisted_repository(
  harness: Harness,
  task: any,
) {
  assert_eq(
    dispatch_run_observations(
      harness,
      consumer_manifest(),
      [hydrated_consumer()],
      "v0.10.127",
      consumer_receipt("owner/unrelated"),
      consumer_snapshot(),
    ),
    [],
    "a dispatch for a repository outside the missing set must be skipped, not resolved",
  )
}

// The three repository shapes that returned a successful bump run with an
// unchanged pin on the v0.10.95 fleet run. Each one is a different way for the
// same defect to look: no bump branch at all, a bump branch still on the old
// pin, and a bump branch whose pin surface reads empty.
const VERSION_PIN: HarnPinSpec = {kind: "version_file", path: ".harn-version"}

const BUMP_BRANCH = "automation/bump-harn-runtime"

const NO_OP_TARGET = "v0.10.95"

const NO_OP_RUN_ID = 31844979299

fn no_op_snapshot(repo: string) -> FleetConvergenceSnapshot {
  return {
    target: NO_OP_TARGET,
    complete: false,
    terminal: true,
    total_count: 1,
    pending_count: 0,
    failing_count: 1,
    repositories: [
      {
        repo: repo,
        state: "failed",
        reason: "missing_bump_pull_request",
        default_branch_pin: "0.10.94",
      },
    ],
  }
}

fn no_op_observed(repo: string, change: FleetTargetChangeProbe) -> FleetDispatchRunObservation {
  return {
    repository: repo,
    run_id: NO_OP_RUN_ID,
    run_url: "https://github.com/${repo}/actions/runs/${NO_OP_RUN_ID}",
    contract_matches: true,
    probe_ok: true,
    status: "completed",
    conclusion: "success",
    detail: "exact accepted workflow run concluded success",
    target_change: change,
  }
}

fn stale_main() -> HarnPinProbe {
  return harn_pin_text_probe("0.10.94", VERSION_PIN)
}

pipeline test_successful_no_op_run_is_typed_for_all_three_repository_shapes(task: any) {
  const shapes = [
    {repo: "burin-labs/harn-latex", branch: nil},
    {
      repo: "burin-labs/harn-microsoft-365-connector",
      branch: harn_pin_text_probe("0.10.94", VERSION_PIN),
    },
    {repo: "burin-labs/harn-sourcehut-connector", branch: harn_pin_text_probe("", VERSION_PIN)},
  ]
  for shape in shapes {
    const change = bump_target_change_probe(NO_OP_TARGET, stale_main(), shape.branch, BUMP_BRANCH)
    assert_eq(
      change.changed,
      "no",
      "${shape.repo}: a completed run that left every ref on 0.10.94 is a proven no-op",
    )
    const continued = continue_fleet_convergence(
      no_op_snapshot(shape.repo),
      [no_op_observed(shape.repo, change)],
    )
    const row = continued.repositories[0]
    assert_eq(
      [continued.terminal, continued.failing_count, continued.pending_count],
      [true, 1, 0],
      "${shape.repo}: a proven no-op is terminal, never another polling round",
    )
    assert_eq(row?.state, "failed", "${shape.repo}: state")
    assert(
      starts_with(row?.reason ?? "", "run_success_no_target_change: "),
      "${shape.repo}: the reason must name the adapter defect, got '${row?.reason ?? ""}'",
    )
    assert(
      contains(row?.reason ?? "", "0.10.95") && contains(row?.reason ?? "", "0.10.94"),
      "${shape.repo}: the reason must carry the resolved target and the pin left behind",
    )
    assert_eq(row?.workflow_run_id, NO_OP_RUN_ID, "${shape.repo}: run lineage")
    assert_eq(row?.default_branch_pin, "0.10.94", "${shape.repo}: pin evidence")
  }
}

pipeline test_a_successful_run_that_moved_a_ref_stays_a_wait(task: any) {
  const moved = bump_target_change_probe(
    NO_OP_TARGET,
    stale_main(),
    harn_pin_text_probe("0.10.95", VERSION_PIN),
    BUMP_BRANCH,
  )
  assert_eq(moved.changed, "yes")
  const continued = continue_fleet_convergence(
    no_op_snapshot("burin-labs/harn-latex"),
    [no_op_observed("burin-labs/harn-latex", moved)],
  )
  assert_eq(
    [continued.terminal, continued.pending_count, continued.failing_count],
    [false, 1, 0],
    "a run whose bump branch reached the target must keep waiting for its exact pull request",
  )
  assert_eq(continued.repositories[0]?.reason, "accepted_bump_run_completed_awaiting_exact_pr")
}

pipeline test_an_unreadable_post_run_pin_is_not_a_no_op(task: any) {
  const unknown = bump_target_change_probe(
    NO_OP_TARGET,
    harn_pin_text_probe(nil, VERSION_PIN),
    nil,
    BUMP_BRANCH,
  )
  assert_eq(unknown.changed, "unknown", "an unread pin surface is not a proven no-op")
  const continued = continue_fleet_convergence(
    no_op_snapshot("burin-labs/harn-sourcehut-connector"),
    [no_op_observed("burin-labs/harn-sourcehut-connector", unknown)],
  )
  assert_eq(
    [continued.terminal, continued.pending_count, continued.failing_count],
    [false, 1, 0],
    "a transport failure must never terminate a repository as a no-op",
  )
}

// --- Dependents withheld at a prerequisite ------------------------------------
//
// A dependent whose prerequisite has not landed is never dispatched, so it has
// no accepted run and no bump pull request. These cases pin the decision that
// keeps that absence readable as a choice: the controller records the
// withholding, and the observation phase keeps the repository waiting rather
// than failing it into repair, which is what ended the round in the live
// v0.10.126 fleet run.
const DEPENDENT = "owner/dependent"

const PREREQUISITE = "owner/prerequisite"

fn dependent_repo() {
  return dispatch_repo()
    + {
      slug: DEPENDENT,
      dir: "/workspace/dependent",
      update: dispatch_repo().update
        + {
          repository: DEPENDENT,
          prerequisites: [
            {
              repository: PREREQUISITE,
              base_branch: "main",
              pin: {kind: "formula", path: "Formula/harn.rb"},
            },
          ],
        },
    }
}

fn pending_outcome() -> FleetOutcomeReceipt {
  return {
    slug: DEPENDENT,
    status: "prerequisite_updates_pending",
    detail: "1/1 prerequisite update(s) pending: ${PREREQUISITE}=0.10.125",
  }
}

fn dispatched_outcome() -> FleetOutcomeReceipt {
  return {
    slug: DEPENDENT,
    status: "run_in_progress",
    detail: "workflow dispatch accepted",
    run_id: 4242,
    run_url: "https://github.com/owner/dependent/actions/runs/4242",
  }
}

fn dependent_missing_snapshot() -> FleetConvergenceSnapshot {
  return missing_snapshot()
    + {
      repositories: [
        {
          repo: DEPENDENT,
          state: "failed",
          reason: "missing_bump_pull_request",
          default_branch_pin: "0.10.125",
        },
      ],
    }
}

/**
 * The withheld dependent must reach the durable receipt.
 *
 * Dropping it is the whole defect: the builder previously kept only outcomes
 * carrying an accepted run identity, so a correctly deferred repository left no
 * trace at all and the successor round could not tell it from an unexplained gap.
 */
pipeline test_a_withheld_dependent_is_recorded_rather_than_dropped(task: any) {
  const receipt = fleet_dispatch_continuation_receipt(
    lineage(),
    [dependent_repo()],
    [pending_outcome()],
  )
  assert_eq(len(receipt.dispatches), 0, "a withheld dependent has no accepted run to observe")
  assert_eq(len(receipt.deferrals), 1, "a withheld dependent must survive as a typed deferral")
  const deferral = receipt.deferrals[0]
  assert_eq(deferral?.repository, DEPENDENT)
  assert_eq(deferral?.target, "v0.10.119")
  assert_eq(
    deferral?.prerequisites,
    [{repository: PREREQUISITE, pin_kind: "formula", pin_path: "Formula/harn.rb"}],
    "the deferral must name the exact prerequisite identity the dependent awaits",
  )
}

/**
 * A dispatched repository is never also deferred.
 *
 * The negative control for the case above: without it, a builder that appended
 * a deferral unconditionally would satisfy the assertion that deferrals exist
 * while quietly deferring repositories that already have runs in flight.
 */
pipeline test_an_accepted_run_is_not_also_recorded_as_a_deferral(task: any) {
  const receipt = fleet_dispatch_continuation_receipt(
    lineage(),
    [dependent_repo()],
    [dispatched_outcome()],
  )
  assert_eq(len(receipt.deferrals), 0)
  assert_eq(receipt.dispatches[0]?.run_id, 4242)
}

/**
 * The recorded withholding must change the convergence verdict, not just the file.
 *
 * `terminal` is the decision under test. A terminal round stops before proof and
 * hands the repository to repair, which refuses `missing_bump_pull_request` as
 * not code-repairable.
 */
pipeline test_a_deferred_dependent_waits_instead_of_failing(task: any) {
  const receipt = fleet_dispatch_continuation_receipt(
    lineage(),
    [dependent_repo()],
    [pending_outcome()],
  )
  const before = dependent_missing_snapshot()
  assert_eq(
    [before.terminal, before.failing_count],
    [true, 1],
    "without the deferral the round is terminal, which is the observed failure",
  )
  const continued = continue_fleet_deferrals(before, "v0.10.119", receipt)
  assert_eq(
    [continued.terminal, continued.pending_count, continued.failing_count],
    [false, 1, 0],
    "a deliberately withheld dependent is waiting, not a failure",
  )
  assert_eq(continued.repositories[0]?.state, "waiting")
  assert(
    starts_with(continued.repositories[0]?.reason ?? "", "deferred_prerequisite_updates_pending: "),
  )
}

/**
 * Nothing else may be softened.
 *
 * A repository with no recorded deferral, and a receipt for a different target,
 * must both leave the failure intact. Without these the case above would pass
 * for a function that unconditionally rewrote every missing-pull-request row.
 */
pipeline test_only_a_recorded_deferral_softens_a_missing_pull_request(task: any) {
  const empty = fleet_dispatch_continuation_receipt(lineage(), [dependent_repo()], [])
  const unchanged = continue_fleet_deferrals(dependent_missing_snapshot(), "v0.10.119", empty)
  assert_eq(
    [unchanged.terminal, unchanged.failing_count],
    [true, 1],
    "an undocumented missing pull request stays a failure",
  )
  const receipt = fleet_dispatch_continuation_receipt(
    lineage(),
    [dependent_repo()],
    [pending_outcome()],
  )
  const other_target = continue_fleet_deferrals(dependent_missing_snapshot(), "v0.10.200", receipt)
  assert_eq(
    [other_target.terminal, other_target.failing_count],
    [true, 1],
    "a deferral recorded for another target cannot excuse this one",
  )
  const absent = continue_fleet_deferrals(dependent_missing_snapshot(), "v0.10.119", nil)
  assert_eq([absent.terminal, absent.failing_count], [true, 1])
}

/**
 * The deferral must survive persistence and the successor round's rebind.
 *
 * The receipt is the only channel between the controller round that withheld the
 * repository and the round that has to know why it is missing.
 */
pipeline test_a_deferral_survives_the_receipt_round_trip_and_rebind(harness: Harness, task: any) {
  const root = harness.fs.mkdtemp_in_workspace("dispatch-deferral-")
  const path = path_join(root, "receipt.json")
  fleet_dispatch_continuation_write(
    {fs: harness.fs, random: harness.random},
    path,
    fleet_dispatch_continuation_receipt(lineage(), [dependent_repo()], [pending_outcome()]),
  )
  const reread = fleet_dispatch_continuation_read(harness.fs, path)
  assert_eq(len(reread?.deferrals ?? []), 1)
  const persisted = unwrap(reread).deferrals
  assert_eq(persisted[0]?.repository, DEPENDENT)
  assert_eq(persisted[0]?.prerequisites[0]?.repository, PREREQUISITE)
  const rebound = fleet_dispatch_continuation_rebind(
    {fs: harness.fs, random: harness.random},
    path,
    unwrap(reread),
    lineage("v0.10.119", CHAIN_ID, 2, CONTROLLER_RUN_ID + 1, 1),
  )
  assert_eq(
    len(rebound.deferrals),
    1,
    "the successor round must inherit why the dependent was withheld",
  )
  assert_eq(rebound.update_round, 2)
}

/**
 * Two rounds across a prerequisite that lands in between.
 *
 * Round one withholds the dependent and the round stays alive. Round two, with
 * the prerequisite satisfied, dispatches it, and the accepted run — not the
 * stale deferral — is what convergence then observes.
 */
pipeline test_a_later_round_dispatches_the_dependent_once_the_prerequisite_lands(task: any) {
  const first = fleet_dispatch_continuation_receipt(
    lineage(),
    [dependent_repo()],
    [pending_outcome()],
  )
  const round_one = continue_fleet_deferrals(dependent_missing_snapshot(), "v0.10.119", first)
  assert_eq(
    [round_one.terminal, round_one.pending_count],
    [false, 1],
    "the round must survive so a successor can run at all",
  )
  const second = fleet_dispatch_continuation_receipt(
    lineage("v0.10.119", CHAIN_ID, 2, CONTROLLER_RUN_ID + 1, 1),
    [dependent_repo()],
    [dispatched_outcome()],
  )
  assert_eq(
    [len(second.dispatches), len(second.deferrals)],
    [1, 0],
    "a satisfied prerequisite turns the deferral into an accepted run",
  )
  const round_two = continue_fleet_deferrals(
    continue_fleet_convergence(
      dependent_missing_snapshot(),
      [observed("in_progress") + {repository: DEPENDENT}],
    ),
    "v0.10.119",
    second,
  )
  assert_eq(round_two.repositories[0]?.workflow_run_id, 4242)
  assert_eq(
    round_two.repositories[0]?.reason,
    "accepted_bump_run_in_progress: in_progress",
    "the exact accepted run, not a deferral, owns the successor round's verdict",
  )
}

/**
 * The pin evidence proves a no-op happened. It cannot say why, and a reader who
 * has to open the run to find out is the reason three of these sat unexplained
 * through a whole stable release. The reason line must carry the run's own
 * account of what it did.
 */
pipeline test_a_proven_no_op_reason_names_what_the_downstream_run_actually_did(task: any) {
  const change = bump_target_change_probe(NO_OP_TARGET, stale_main(), nil, BUMP_BRANCH)
  const skipped_run = {
    repo: "burin-labs/harn-latex",
    run_id: NO_OP_RUN_ID,
    total_count: 1,
    jobs: [
      {
        id: 1,
        run_id: NO_OP_RUN_ID,
        name: "bump",
        status: "completed",
        conclusion: "success",
        head_sha: "a" * 40,
        url: "https://github.test/job/1",
        runner_name: "runner",
        started_at: nil,
        completed_at: nil,
        steps: [
          {
            number: 1,
            name: "Rewrite pin",
            status: "completed",
            conclusion: "skipped",
            started_at: nil,
            completed_at: nil,
          },
        ],
      },
    ],
    page: 1,
    per_page: 100,
  }
  const observed = no_op_observed("burin-labs/harn-latex", change)
    + {no_op_diagnosis: bump_no_op_diagnosis(skipped_run)}
  const continued = continue_fleet_convergence(no_op_snapshot("burin-labs/harn-latex"), [observed])
  const reason = continued.repositories[0]?.reason ?? ""
  assert(starts_with(reason, "run_success_no_target_change: "))
  assert(contains(reason, "all_steps_skipped"), "the cause must be named, got '${reason}'")
  assert(contains(reason, "what gated them"))
  // Without the diagnosis the reason keeps its old shape rather than reading as
  // an explained no-op.
  const undiagnosed = continue_fleet_convergence(
    no_op_snapshot("burin-labs/harn-latex"),
    [no_op_observed("burin-labs/harn-latex", change)],
  )
  const plain = undiagnosed.repositories[0]?.reason ?? ""
  assert(starts_with(plain, "run_success_no_target_change: "))
  assert_eq(contains(plain, "all_steps_skipped"), false)
}
