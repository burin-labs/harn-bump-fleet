import {
  FleetConvergenceSnapshot,
  FleetDispatchRunObservation,
  continue_fleet_convergence,
  dispatch_run_observations,
} from "../lib/fleet_convergence"
import {
  FleetDispatchContinuationReceipt,
  fleet_dispatch_continuation_entry_write,
  fleet_dispatch_continuation_read,
  fleet_dispatch_continuation_rebind,
  fleet_dispatch_continuation_receipt,
  fleet_dispatch_continuation_write,
  fleet_dispatch_lineage,
  fleet_dispatch_scope,
  require_fleet_dispatch_continuation_predecessor,
} from "../lib/fleet_dispatch_continuation"
import { FleetManifest, FleetRepository, parse_fleet_manifest } from "../lib/fleet_manifest"

const CHAIN_ID = "33000000000"

const CONTROLLER_RUN_ID = 33000000001

fn thrown(callback: closure) -> string {
  return try {
    callback()
    ""
  } catch (error) {
    to_string(error)
  }
}

fn lineage(
  target: string = "v0.10.119",
  chain_id: string = CHAIN_ID,
  update_round: int = 1,
  controller_run_id: int = CONTROLLER_RUN_ID,
  controller_run_attempt: int = 1,
  only: string? = nil,
) {
  return fleet_dispatch_lineage(
    target,
    chain_id,
    fleet_dispatch_scope(only),
    update_round,
    controller_run_id,
    controller_run_attempt,
  )
}

fn dispatch_repo() {
  return {
    slug: "owner/slow",
    dir: "/workspace/slow",
    common_dir: "/workspace/.git",
    update: {
      repository: "owner/slow",
      base_branch: "main",
      workflow_path: ".github/workflows/bump-harn.yml",
      workflow_name: "bump-harn.yml",
      branch: "automation/bump-harn-runtime",
      pin: {kind: "auto"},
      repair_enabled: true,
      auto_arm: true,
      require_signed_head: true,
      prerequisites: [],
      max_releases_behind: 1,
      adapter: {
        repository_owned: false,
        workflow_reference:
          "owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        orchestration_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        refresh_command: "",
        validation_command: "",
        node_version: "",
        publish_failure_for_repair: false,
        apply_behavior_preserving_fixes: false,
        enable_auto_merge: true,
      },
    },
  }
}

fn missing_snapshot() -> FleetConvergenceSnapshot {
  return {
    target: "v0.10.119",
    complete: false,
    terminal: true,
    total_count: 1,
    pending_count: 0,
    failing_count: 1,
    repositories: [
      {
        repo: "owner/slow",
        state: "failed",
        reason: "missing_bump_pull_request",
        default_branch_pin: "0.10.118",
      },
    ],
  }
}

fn observed(status: string, conclusion: string = "") -> FleetDispatchRunObservation {
  return {
    repository: "owner/slow",
    run_id: 4242,
    run_url: "https://github.com/owner/slow/actions/runs/4242",
    contract_matches: true,
    probe_ok: true,
    status: status,
    conclusion: conclusion,
    detail: "fixture exact run",
  }
}

pipeline test_accepted_run_changes_missing_pr_from_terminal_failure_to_waiting(task: any) {
  const continued = continue_fleet_convergence(missing_snapshot(), [observed("in_progress")])
  assert_eq([continued.terminal, continued.pending_count, continued.failing_count], [false, 1, 0])
  assert_eq(continued.repositories[0]?.reason, "accepted_bump_run_in_progress: in_progress")
  assert_eq(continued.repositories[0]?.workflow_run_id, 4242)
}

pipeline test_completed_accepted_run_waits_for_its_late_exact_pr(task: any) {
  const continued = continue_fleet_convergence(
    missing_snapshot(),
    [observed("completed", "success")],
  )
  assert_eq([continued.terminal, continued.pending_count, continued.failing_count], [false, 1, 0])
  assert_eq(continued.repositories[0]?.reason, "accepted_bump_run_completed_awaiting_exact_pr")
}

pipeline test_existing_exact_pr_state_wins_over_old_dispatch_continuation(task: any) {
  const late_pr = missing_snapshot()
    + {
      terminal: false,
      pending_count: 1,
      failing_count: 0,
      repositories: [
        {
          repo: "owner/slow",
          state: "waiting",
          reason: "checks_pending",
          pr_number: 77,
          pr_url: "https://github.com/owner/slow/pull/77",
          head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        },
      ],
    }
  const continued = continue_fleet_convergence(late_pr, [observed("completed", "success")])
  assert_eq(continued.repositories, late_pr.repositories)
  assert_eq(continued.pending_count, 1)
}

pipeline test_unrelated_or_failed_exact_run_cannot_mask_a_missing_pr(task: any) {
  const unrelated = observed("in_progress") + {repository: "owner/other"}
  const unchanged = continue_fleet_convergence(missing_snapshot(), [unrelated])
  assert_eq([unchanged.terminal, unchanged.failing_count], [true, 1])
  const failed = continue_fleet_convergence(missing_snapshot(), [observed("completed", "failure")])
  assert_eq([failed.terminal, failed.pending_count, failed.failing_count], [true, 0, 1])
  assert(starts_with(failed.repositories[0]?.reason ?? "", "accepted_bump_run_failure"))
}

pipeline test_unreadable_exact_run_fails_with_bound_run_identity(task: any) {
  const unavailable = observed("unknown")
    + {probe_ok: false, detail: "fixture connector unavailable"}
  const continued = continue_fleet_convergence(missing_snapshot(), [unavailable])
  assert_eq([continued.terminal, continued.pending_count, continued.failing_count], [true, 0, 1])
  assert_eq(
    continued.repositories[0]?.reason,
    "accepted_bump_run_probe_failed: fixture connector unavailable",
  )
  assert_eq(continued.repositories[0]?.workflow_run_id, 4242)
}

pipeline test_exact_run_continuation_round_trips_as_a_typed_durable_receipt(
  harness: Harness,
  task: any,
) {
  const receipt: FleetDispatchContinuationReceipt = {
    schema_version: "harn_bump_fleet.dispatch_continuation.v3",
    target: "v0.10.119",
    chain_id: CHAIN_ID,
    scope: {kind: "fleet"},
    update_round: 1,
    controller_run_id: CONTROLLER_RUN_ID,
    controller_run_attempt: 1,
    dispatches: [
      {
        repository: "owner/slow",
        target: "v0.10.119",
        workflow: "bump-harn.yml",
        run_id: 4242,
        run_url: "https://github.com/owner/slow/actions/runs/4242",
        base_branch: "main",
        branch: "automation/bump-harn-runtime",
      },
    ],
  }
  const root = harness.fs.mkdtemp_in_workspace("dispatch-continuation-")
  const path = path_join(root, "receipt.json")
  fleet_dispatch_continuation_write({fs: harness.fs, random: harness.random}, path, receipt)
  assert_eq(fleet_dispatch_continuation_read(harness.fs, path), receipt)
}

pipeline test_dispatch_acceptance_is_readable_before_the_aggregate_exists(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("dispatch-entry-")
  const path = path_join(root, "receipt.json")
  fleet_dispatch_continuation_entry_write(
    {fs: harness.fs, random: harness.random},
    path,
    lineage(),
    dispatch_repo(),
    4242,
    "https://github.com/owner/slow/actions/runs/4242",
  )
  assert_eq(harness.fs.exists(path), false)
  const recovered = fleet_dispatch_continuation_read(harness.fs, path)
  assert(recovered != nil)
  assert_eq([recovered.target, recovered.dispatches[0]?.run_id], ["v0.10.119", 4242])
}

pipeline test_two_round_workflow_handoff_keeps_exact_run_4242_and_one_dispatch(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("two-round-continuation-")
  const path = path_join(root, "fleet-dispatch-continuation.json")
  fleet_dispatch_continuation_entry_write(
    {fs: harness.fs, random: harness.random},
    path,
    lineage(),
    dispatch_repo(),
    4242,
    "https://github.com/owner/slow/actions/runs/4242",
  )
  const restored = require_fleet_dispatch_continuation_predecessor(
    fleet_dispatch_continuation_read(harness.fs, path),
    lineage(),
  )
  assert_eq(restored.dispatches.map({ dispatch -> dispatch.run_id }).to_list(), [4242])
  const round_two = fleet_dispatch_continuation_rebind(
    {fs: harness.fs, random: harness.random},
    path,
    restored,
    lineage("v0.10.119", CHAIN_ID, 2, CONTROLLER_RUN_ID + 1),
  )
  const successor = require_fleet_dispatch_continuation_predecessor(
    fleet_dispatch_continuation_read(harness.fs, path),
    lineage("v0.10.119", CHAIN_ID, 2, CONTROLLER_RUN_ID + 1),
  )
  assert_eq(successor.dispatches.map({ dispatch -> dispatch.run_id }).to_list(), [4242])
  assert_eq(len(round_two.dispatches), 1, "round 2 must preserve one accepted dispatch")
}

pipeline test_predecessor_restore_rejects_unrelated_lineage_and_absence(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("predecessor-negative-")
  const path = path_join(root, "fleet-dispatch-continuation.json")
  const receipt: FleetDispatchContinuationReceipt = {
    schema_version: "harn_bump_fleet.dispatch_continuation.v3",
    target: "v0.10.119",
    chain_id: CHAIN_ID,
    scope: {kind: "fleet"},
    update_round: 1,
    controller_run_id: CONTROLLER_RUN_ID,
    controller_run_attempt: 1,
    dispatches: [],
  }
  fleet_dispatch_continuation_write({fs: harness.fs, random: harness.random}, path, receipt)
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage("v0.10.119", "unrelated-chain"),
          )
        },
      ),
      "chain mismatch",
    ),
  )
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID + 99),
          )
        },
      ),
      "run mismatch",
    ),
  )
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 2),
          )
        },
      ),
      "run attempt mismatch",
    ),
  )
  assert(
    contains(
      thrown({ -> require_fleet_dispatch_continuation_predecessor(nil, lineage()) }),
      "absent",
    ),
  )
  assert(
    contains(
      thrown(
        { ->
          fleet_dispatch_continuation_rebind(
            {fs: harness.fs, random: harness.random},
            path,
            receipt,
            lineage("v0.10.119", CHAIN_ID, 3, CONTROLLER_RUN_ID + 1),
          )
        },
      ),
      "one run attempt or one controller round",
    ),
  )
}

pipeline test_predecessor_restore_rejects_scope_narrowing_and_widening(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("predecessor-scope-negative-")
  const path = path_join(root, "fleet-dispatch-continuation.json")
  const fleet_receipt = fleet_dispatch_continuation_receipt(lineage(), [dispatch_repo()], [])
  fleet_dispatch_continuation_write({fs: harness.fs, random: harness.random}, path, fleet_receipt)
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 1, "owner/slow"),
          )
        },
      ),
      "scope mismatch",
    ),
  )
  const repository_receipt = fleet_dispatch_continuation_receipt(
    lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 1, "owner/slow"),
    [dispatch_repo()],
    [],
  )
  fleet_dispatch_continuation_write(
    {fs: harness.fs, random: harness.random},
    path,
    repository_receipt,
  )
  assert(
    contains(
      thrown(
        { ->
          require_fleet_dispatch_continuation_predecessor(
            fleet_dispatch_continuation_read(harness.fs, path),
            lineage(),
          )
        },
      ),
      "scope mismatch",
    ),
  )
}

pipeline test_rerun_rebind_requires_the_exact_next_attempt_and_preserves_child_runs(
  harness: Harness,
  task: any,
) {
  const root = harness.fs.mkdtemp_in_workspace("predecessor-attempt-")
  const path = path_join(root, "fleet-dispatch-continuation.json")
  fleet_dispatch_continuation_entry_write(
    {fs: harness.fs, random: harness.random},
    path,
    lineage(),
    dispatch_repo(),
    4242,
    "https://github.com/owner/slow/actions/runs/4242",
  )
  const predecessor = require_fleet_dispatch_continuation_predecessor(
    fleet_dispatch_continuation_read(harness.fs, path),
    lineage(),
  )
  const rebound = fleet_dispatch_continuation_rebind(
    {fs: harness.fs, random: harness.random},
    path,
    predecessor,
    lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 2),
  )
  assert_eq(
    [rebound.controller_run_id, rebound.controller_run_attempt, rebound.dispatches[0]?.run_id],
    [CONTROLLER_RUN_ID, 2, 4242],
  )
  assert(
    contains(
      thrown(
        { ->
          fleet_dispatch_continuation_rebind(
            {fs: harness.fs, random: harness.random},
            path,
            rebound,
            lineage("v0.10.119", CHAIN_ID, 1, CONTROLLER_RUN_ID, 4),
          )
        },
      ),
      "one run attempt",
    ),
  )
}

/**
 * The consumer-owned hydration seam.
 *
 * A repository that owns its own contract carries no pin path and no refresh or
 * validate command in fleet.toml, so resolving its update spec from the raw
 * manifest throws by design. Every caller hydrates those rows into a separate
 * list before observing, and the observation must read that list. Reading the
 * manifest instead aborted the whole v0.10.127 round.
 */
fn consumer_manifest() -> FleetManifest {
  return parse_fleet_manifest(
    {
      schema_version: 1,
      fleet: {default_root: "~/projects", default_branch: "main"},
      policy: {
        package_workflow:
          "owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        bump_workflow:
          "owner/policy/.github/workflows/bump.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      },
      repositories: [
        {
          slug: "owner/consumer",
          directory: "consumer",
          consumer_owned_contract: true,
          harn_bump: true,
          bump_workflow_ownership: "fleet",
        },
      ],
    },
  )
}

fn hydrated_consumer() -> FleetRepository {
  return schema_expect(
    {
      slug: "owner/consumer",
      directory: "consumer",
      consumer_owned_contract: true,
      harn_bump: true,
      bump_workflow_ownership: "fleet",
      harn_pin_kind: "version_file",
      harn_pin_path: "private/version",
      bump_refresh_command: "private/refresh",
      bump_validate_command: "private/validate",
    },
    FleetRepository,
  )
}

fn consumer_snapshot() -> FleetConvergenceSnapshot {
  return {
    target: "v0.10.127",
    complete: false,
    terminal: true,
    total_count: 1,
    pending_count: 0,
    failing_count: 1,
    repositories: [
      {
        repo: "owner/consumer",
        state: "failed",
        reason: "missing_bump_pull_request",
        default_branch_pin: "0.10.126",
      },
    ],
  }
}

fn consumer_receipt(repository: string = "owner/consumer") -> FleetDispatchContinuationReceipt {
  return {
    schema_version: "harn_bump_fleet.dispatch_continuation.v3",
    target: "v0.10.127",
    chain_id: CHAIN_ID,
    scope: fleet_dispatch_scope(),
    update_round: 2,
    controller_run_id: CONTROLLER_RUN_ID,
    controller_run_attempt: 1,
    dispatches: [
      {
        repository: repository,
        target: "v0.10.127",
        workflow: "not-the-current-workflow.yml",
        run_id: 4242,
        run_url: "https://github.com/owner/consumer/actions/runs/4242",
        base_branch: "main",
        branch: "automation/bump-harn-runtime",
      },
    ],
  }
}

pipeline test_observation_resolves_a_consumer_from_the_hydrated_list(harness: Harness, task: any) {
  const observations = dispatch_run_observations(
    harness,
    consumer_manifest(),
    [hydrated_consumer()],
    "v0.10.127",
    consumer_receipt(),
    consumer_snapshot(),
  )
  assert_eq(
    len(observations),
    1,
    "the consumer's accepted dispatch must be observed, not thrown on",
  )
  assert_eq(observations[0]?.repository, "owner/consumer")
  assert_eq(
    observations[0]?.contract_matches,
    false,
    "a receipt naming a stale workflow is a contract mismatch, not an abort",
  )
}

pipeline test_observation_still_refuses_a_repository_that_was_never_hydrated(
  harness: Harness,
  task: any,
) {
  const manifest = consumer_manifest()
  assert(
    contains(
      thrown(
        { ->
          dispatch_run_observations(
            harness,
            manifest,
            manifest.repositories,
            "v0.10.127",
            consumer_receipt(),
            consumer_snapshot(),
          )
        },
      ),
      "consumer contract was not hydrated",
    ),
    "an un-hydrated repository must still refuse rather than observe a spec it cannot resolve",
  )
}

pipeline test_observation_ignores_a_dispatch_for_an_unlisted_repository(
  harness: Harness,
  task: any,
) {
  assert_eq(
    dispatch_run_observations(
      harness,
      consumer_manifest(),
      [hydrated_consumer()],
      "v0.10.127",
      consumer_receipt("owner/unrelated"),
      consumer_snapshot(),
    ),
    [],
    "a dispatch for a repository outside the missing set must be skipped, not resolved",
  )
}
