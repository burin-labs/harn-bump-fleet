import { decode_github_workflow, github_projection_has_trigger } from "../lib/github_workflow"

fn workflow_source(fs: HarnessFs) -> string {
  return fs.read_text(
    path_join(dirname(fs.cwd()), ".github", "workflows", "prless-branch-audit.yml"),
  )
}

pipeline test_branch_audit_runs_daily_and_on_manual_dispatch(harness: Harness) {
  const source = workflow_source(harness.fs)
  const workflow = decode_github_workflow(source)
  assert_eq(github_projection_has_trigger(workflow, "schedule"), true)
  assert_eq(github_projection_has_trigger(workflow, "workflow_dispatch"), true)
  assert(contains(source, "check_prless_branches.harn"))
  assert(contains(source, "group: check-prless-branches"))
}

pipeline test_branch_audit_has_only_read_branch_authority_and_issue_write(harness: Harness) {
  const source = workflow_source(harness.fs)
  assert(contains(source, "permission-contents: read"))
  assert(contains(source, "permission-pull-requests: read"))
  assert(contains(source, "permission-issues: write"))
  assert_eq(contains(source, "permission-contents: write"), false)
  assert_eq(contains(source, "git push"), false)
  assert_eq(contains(source, "branches.delete"), false)
}

pipeline test_branch_audit_always_uploads_the_receipt(harness: Harness) {
  const source = workflow_source(harness.fs)
  assert(contains(source, "if: always()"))
  assert(contains(source, "if-no-files-found: error"))
  assert(contains(source, "prless-branch-audit-receipt.json"))
}
