import { decode_github_workflow, github_projection_has_trigger } from "../lib/github_workflow"

fn workflow_source(fs: HarnessFs) -> string {
  return fs.read_text(
    path_join(dirname(fs.cwd()), ".github", "workflows", "prless-branch-audit.yml"),
  )
}

pipeline test_branch_audit_runs_daily_and_on_manual_dispatch(harness: Harness) {
  const source = workflow_source(harness.fs)
  const workflow = decode_github_workflow(source)
  assert_eq(github_projection_has_trigger(workflow, "schedule"), true)
  assert_eq(github_projection_has_trigger(workflow, "workflow_dispatch"), true)
  assert(contains(source, "check_prless_branches.harn"))
  assert(contains(source, "group: check-prless-branches"))
}

fn has_read_only_inventory_token(source: string) -> bool {
  const workflow = decode_github_workflow(source)
  let tokens = 0
  for job in workflow.jobs {
    for step in job.value.steps ?? [] {
      if !starts_with(step.uses ?? "", "actions/create-github-app-token@") {
        continue
      }
      tokens = tokens + 1
      const inputs = step.with ?? {}
      if inputs["permission-contents"] != "read"
        || inputs["permission-pull-requests"] != "read" {
        return false
      }
      for input in inputs {
        if starts_with(input.key, "permission-")
          && input.key != "permission-contents"
          && input.key != "permission-pull-requests" {
          return false
        }
      }
    }
  }
  return tokens == 1
}

pipeline test_branch_inventory_has_no_github_mutation_authority(harness: Harness) {
  const source = workflow_source(harness.fs)
  assert(has_read_only_inventory_token(source))
  const former_grant = source.replace(
    "permission-pull-requests: read",
    "permission-pull-requests: read\n          permission-issues: write",
  )
  assert_eq(has_read_only_inventory_token(former_grant), false)
}

pipeline test_branch_audit_always_uploads_the_receipt(harness: Harness) {
  const source = workflow_source(harness.fs)
  assert(contains(source, "if: always()"))
  assert(contains(source, "if-no-files-found: error"))
  assert(contains(source, "prless-branch-audit-receipt.json"))
}

/**
 * The daily sweep must not opt into failing on findings. If it ever does, the
 * scheduled run goes back to being red every day and the signal that the audit
 * itself broke is lost in the noise. The switch exists for a gating caller.
 */
pipeline test_the_scheduled_sweep_does_not_opt_into_failing_on_findings(harness: Harness) {
  const source = workflow_source(harness.fs)
  assert_eq(contains(source, "--fail-on-findings"), false)
  // Positive control: the same read does find the flags the sweep DOES pass,
  // so the absence above is measured rather than an empty file.
  assert(contains(source, "--only"))
  assert_eq(contains(source, "--dry-run"), false)
}
