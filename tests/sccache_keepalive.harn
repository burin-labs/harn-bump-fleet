import { shell_quote } from "std/runtime"
import { with_temp_dir } from "std/testing"

struct FakeSccache {
  bin_dir: string
  observed_cap_path: string
  cap_state_path: string
  command_log_path: string
}

struct KeepaliveRun {
  observed_cap: string
  command_log: string
  stdout: string
}

fn keepalive_script_path(harness: HarnessFs) -> string {
  return path_normalize(path_join(harness.source_dir(), "..", "scripts", "sccache_keepalive.sh"))
}

fn fake_sccache(harness: {fs: HarnessFs, process: HarnessProcess}, root: string) -> FakeSccache {
  const bin_dir = path_join(root, "bin")
  const executable = path_join(bin_dir, "sccache")
  const pgrep_executable = path_join(bin_dir, "pgrep")
  const observed_cap_path = path_join(root, "observed-cap")
  const cap_state_path = path_join(root, "cap-state")
  const command_log_path = path_join(root, "commands")
  harness.fs.mkdir(bin_dir, true)
  harness.fs.write_text(
    executable,
    "#!/bin/sh\n"
      + "case \"$1\" in\n"
      + "  --show-stats)\n"
      + "    if [ -f \"$SCCACHE_FAKE_CAP_STATE\" ]; then cap=$(cat \"$SCCACHE_FAKE_CAP_STATE\"); else cap=\"$SCCACHE_FAKE_INITIAL_CAP\"; fi\n"
      + "    printf 'Cache errors 0\\nMax cache size %s\\n' \"$cap\"\n"
      + "    ;;\n"
      + "  --stop-server) printf 'stop\\n' >> \"$SCCACHE_FAKE_COMMAND_LOG\" ;;\n"
      + "  --start-server)\n"
      + "    printf 'start\\n' >> \"$SCCACHE_FAKE_COMMAND_LOG\"\n"
      + "    printf '%s' \"$SCCACHE_CACHE_SIZE\" > \"$SCCACHE_OBSERVED_CAP\"\n"
      + "    case \"$SCCACHE_CACHE_SIZE\" in 24G) cap='24 GiB' ;; 8G) cap='8 GiB' ;; *) cap=\"$SCCACHE_CACHE_SIZE\" ;; esac\n"
      + "    printf '%s' \"$cap\" > \"$SCCACHE_FAKE_CAP_STATE\"\n"
      + "    ;;\n"
      + "  *) exit 2 ;;\n"
      + "esac\n",
  )
  harness.fs.write_text(
    pgrep_executable,
    "#!/bin/sh\nif [ \"$SCCACHE_FAKE_BUSY\" = 1 ]; then exit 0; fi\nexit 1\n",
  )
  const chmod = harness.process.shell(
    "chmod +x " + shell_quote(executable) + " " + shell_quote(pgrep_executable),
  )
  if !chmod.success {
    throw "could not make fake executables: " + to_string(chmod.stderr)
  }
  return FakeSccache(
    {
      bin_dir: bin_dir,
      observed_cap_path: observed_cap_path,
      cap_state_path: cap_state_path,
      command_log_path: command_log_path,
    },
  )
}

fn run_keepalive(
  harness: {fs: HarnessFs, process: HarnessProcess},
  fake: FakeSccache,
  cap: string = "",
  initial_cap: string = "99 GiB",
  busy: bool = false,
) -> KeepaliveRun {
  const command = "PATH="
    + shell_quote(fake.bin_dir + ":/usr/bin:/bin:/usr/sbin:/sbin")
    + " SCCACHE_OBSERVED_CAP="
    + shell_quote(fake.observed_cap_path)
    + " SCCACHE_FAKE_CAP_STATE="
    + shell_quote(fake.cap_state_path)
    + " SCCACHE_FAKE_COMMAND_LOG="
    + shell_quote(fake.command_log_path)
    + " SCCACHE_FAKE_INITIAL_CAP="
    + shell_quote(initial_cap)
    + " SCCACHE_FAKE_BUSY="
    + if busy {
    "1"
  } else {
    "0"
  }
    + " SCCACHE_CACHE_SIZE="
    + shell_quote(cap)
    + " "
    + shell_quote(keepalive_script_path(harness.fs))
  const result = harness.process.shell(command)
  if !result.success {
    throw "keepalive should succeed: " + to_string(result.stderr)
  }
  return KeepaliveRun(
    {
      observed_cap: if harness.fs.exists(fake.observed_cap_path) {
        to_string(harness.fs.read_text(fake.observed_cap_path))
      } else {
        ""
      },
      command_log: if harness.fs.exists(fake.command_log_path) {
        to_string(harness.fs.read_text(fake.command_log_path))
      } else {
        ""
      },
      stdout: to_string(result.stdout),
    },
  )
}

pipeline test_keepalive_restarts_persistent_server_with_bounded_default(harness: Harness, _task) {
  with_temp_dir(
    harness.fs,
    { root ->
      const result = run_keepalive(
        {fs: harness.fs, process: harness.process},
        fake_sccache({fs: harness.fs, process: harness.process}, root),
      )
      assert_eq(result.observed_cap, "24G")
      assert_eq(result.command_log, "stop\nstart\n")
    },
  )
}

pipeline test_keepalive_preserves_operator_cache_size_override(harness: Harness, _task) {
  with_temp_dir(
    harness.fs,
    { root ->
      const result = run_keepalive(
        {fs: harness.fs, process: harness.process},
        fake_sccache({fs: harness.fs, process: harness.process}, root),
        "8G",
      )
      assert_eq(result.observed_cap, "8G")
      assert_eq(result.command_log, "stop\nstart\n")
    },
  )
}

pipeline test_keepalive_does_not_restart_matching_persistent_server(harness: Harness, _task) {
  with_temp_dir(
    harness.fs,
    { root ->
      const result = run_keepalive(
        {fs: harness.fs, process: harness.process},
        fake_sccache({fs: harness.fs, process: harness.process}, root),
        "",
        "24 GiB",
      )
      assert_eq(result.observed_cap, "24G")
      assert_eq(result.command_log, "start\n")
    },
  )
}

pipeline test_keepalive_defers_mismatched_restart_while_compiler_is_active(
  harness: Harness,
  _task,
) {
  with_temp_dir(
    harness.fs,
    { root ->
      const result = run_keepalive(
        {fs: harness.fs, process: harness.process},
        fake_sccache({fs: harness.fs, process: harness.process}, root),
        "",
        "99 GiB",
        true,
      )
      assert_eq(result.observed_cap, "")
      assert_eq(result.command_log, "")
      assert(contains(result.stdout, "restart deferred"))
    },
  )
}
