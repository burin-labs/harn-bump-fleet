import { with_temp_dir } from "std/testing"
import { safe_shell_arg } from "../lib/shell_util"

struct FakeSccache {
  bin_dir: string
  observed_cap_path: string
}

fn keepalive_script_path() -> string {
  return path_normalize(path_join(source_dir(), "..", "scripts", "sccache_keepalive.sh"))
}

fn fake_sccache(root: string) -> FakeSccache {
  const bin_dir = path_join(root, "bin")
  const executable = path_join(bin_dir, "sccache")
  const observed_cap_path = path_join(root, "observed-cap")
  harness.fs.mkdir(bin_dir, true)
  harness.fs
    .write_text(
    executable,
    "#!/bin/sh\n"
      + "case \"$1\" in\n"
      + "  --show-stats) printf '%s\\n' 'Cache errors 0' ;;\n"
      + "  --start-server) printf '%s' \""
      + "$"
      + "{SCCACHE_CACHE_SIZE:-}\" > \""
      + "$"
      + "SCCACHE_OBSERVED_CAP\" ;;\n"
      + "  *) exit 2 ;;\n"
      + "esac\n",
  )
  const chmod = shell("chmod +x " + safe_shell_arg(executable))
  if chmod.status != 0 {
    throw "could not make fake sccache executable: " + to_string(chmod.stderr)
  }
  return FakeSccache({bin_dir: bin_dir, observed_cap_path: observed_cap_path})
}

fn run_keepalive(fake: FakeSccache, cap: string = "") -> string {
  const cap_assignment = "SCCACHE_CACHE_SIZE=" + safe_shell_arg(cap) + " "
  const command = "PATH="
    + safe_shell_arg(fake.bin_dir + ":/usr/bin:/bin:/usr/sbin:/sbin")
    + " SCCACHE_OBSERVED_CAP="
    + safe_shell_arg(fake.observed_cap_path)
    + " "
    + cap_assignment
    + safe_shell_arg(keepalive_script_path())
  const result = shell(command)
  if result.status != 0 {
    throw "keepalive should start the healthy fake server: " + to_string(result.stderr)
  }
  return to_string(harness.fs.read_text(fake.observed_cap_path))
}

pipeline test_keepalive_uses_bounded_default_cache_size(_task) {
  with_temp_dir({ root -> assert_eq(run_keepalive(fake_sccache(root)), "24G") })
}

pipeline test_keepalive_preserves_operator_cache_size_override(_task) {
  with_temp_dir({ root -> assert_eq(run_keepalive(fake_sccache(root), "8G"), "8G") })
}
