import {
  RepositoryBranchAudit,
  fleet_branch_audit_receipt,
  parse_private_names,
  prless_branch_disposition,
  prless_branch_issue_body,
  prless_branch_issue_marker,
  prless_content_verdict,
  prless_disposition_count,
  public_branch_audit,
  survey_repository_branches,
} from "../lib/prless_branch_audit"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

const OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "branch-audit-test-token"}
}

fn branches_url(page: int = 1) -> string {
  return BASE
    + "/repos/octo-org/octo-repo/branches?page=${to_string(page)}&per_page=100"
}

fn pulls_url(page: int = 1) -> string {
  return BASE
    + "/repos/octo-org/octo-repo/pulls?state=open&per_page=30&page=${to_string(page)}"
}

fn branch(name: string, oid: string = OID) -> dict {
  return {name: name, commit: {sha: oid}, protected: name == "main"}
}

fn pull(number: int, name: string, head_repo: string = SLUG) -> dict {
  return {
    number: number,
    title: "Branch owner",
    state: "open",
    html_url: "https://github.test/octo-org/octo-repo/pull/${to_string(number)}",
    base: {ref: "main", sha: OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
    head: {
      ref: name,
      sha: OID,
      repo: {full_name: head_repo, owner: {login: split(head_repo, "/")[0]}},
    },
  }
}

fn mock_branches(testing: HarnessTesting, rows: list<dict>, page: int = 1) {
  testing.http_mock("GET", branches_url(page), {status: 200, body: json_stringify(rows)})
}

fn mock_pulls(testing: HarnessTesting, rows: list<dict>, page: int = 1) {
  testing.http_mock("GET", pulls_url(page), {status: 200, body: json_stringify(rows)})
}

/**
 * The reachability read asks the compare graph whether the default branch
 * already has the branch tip. The default branch is the base and the tip is
 * the head, so a reachable tip diffs to nothing.
 */
fn compare_url(tip: string) -> string {
  return BASE + "/repos/octo-org/octo-repo/compare/main...${tip}"
}

/** `status` is from the tip's side (`ahead`: main has the tip); GitHub answers from main's. */
fn mock_compare(testing: HarnessTesting, tip: string, status: string) {
  const answered = if status == "ahead" {
    "behind"
  } else if status == "behind" {
    "ahead"
  } else {
    status
  }
  testing.http_mock(
    "GET",
    compare_url(tip),
    {status: 200, body: json_stringify({status: answered})},
  )
}

const DEFAULT_TIP = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"

/** The content read: the same compare, asking for its file list. */
fn mock_content_compare(testing: HarnessTesting, tip: string, files: list<dict>) {
  testing.http_mock(
    "GET",
    compare_url(tip) + "?per_page=1",
    {
      status: 200,
      body: json_stringify({status: "ahead", base_commit: {sha: DEFAULT_TIP}, files: files}),
    },
  )
}

fn changed(filename: string, status: string = "modified", previous: string? = nil) -> dict {
  return if previous == nil {
    {filename: filename, status: status}
  } else {
    {filename: filename, status: status, previous_filename: previous}
  }
}

/** One GraphQL blob answer: `pairs` is [branch_oid?, default_oid?] per path, in order. */
fn blob_answer(pairs: list<list>) -> dict {
  let repository = {}
  let index = 0
  for pair in pairs {
    const suffix = to_string(index)
    index = index + 1
    const branch_oid = pair[0]
    const default_oid = pair[1]
    repository["b${suffix}"] = if branch_oid == nil {
      nil
    } else {
      {oid: branch_oid}
    }
    repository["d${suffix}"] = if default_oid == nil {
      nil
    } else {
      {oid: default_oid}
    }
  }
  return {status: 200, body: json_stringify({data: {repository: repository}})}
}

pipeline test_clean_requires_the_default_branch_and_matches_open_heads(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_branches(harness.testing, [branch("main"), branch("feature/owned")])
  mock_pulls(harness.testing, [pull(7, "feature/owned")])
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "clean")
  assert_eq(result.branch_count, 2)
  assert_eq(result.open_pr_head_count, 1)
  assert_eq(result.prless_branch_count, 0)
}

pipeline test_same_name_on_a_fork_does_not_claim_the_repository_branch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_branches(
    harness.testing,
    [branch("main"), branch("feature/owned"), branch("feature/fork-only")],
  )
  mock_pulls(
    harness.testing,
    [pull(7, "feature/owned"), pull(8, "feature/fork-only", "fork-user/octo-repo")],
  )
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "findings")
  assert_eq(result.open_pr_head_count, 1)
  assert_eq(result.prless_branch_count, 1)
  assert_eq(result.prless_branches[0]?.name, "feature/fork-only")
}

/** A measured empty list is invalid because every repository has a default branch. */
pipeline test_zero_branches_is_unmeasured_not_clean(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_branches(harness.testing, [])
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "measurement_failed")
  assert_eq(result.error_code, "empty_branch_read")
  assert_eq(result.branch_count, nil)
  assert_eq(
    len(
      harness.testing.http_mock_calls().filter({ call -> contains(call.url, "/pulls?") }).to_list(),
    ),
    0,
    "a failed positive control does not continue into a misleading pull-request read",
  )
}

pipeline test_missing_default_branch_refuses_a_partial_nonempty_read(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_branches(harness.testing, [branch("feature/only")])
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "measurement_failed")
  assert_eq(result.error_code, "default_branch_missing")
}

pipeline test_malformed_branch_identity_is_a_measurement_failure(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_branches(harness.testing, [branch("main", "not-a-commit")])
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "measurement_failed")
  assert_eq(result.error_code, "branch_response_malformed")
}

pipeline test_branch_pages_are_bounded_and_complete(harness: Harness) {
  harness.testing.http_mock_clear()
  let first = [branch("main")]
  for index in range(1, 100) {
    first = first + [branch("archive/${to_string(index)}")]
  }
  mock_branches(harness.testing, first, 1)
  mock_branches(harness.testing, [branch("archive/100")], 2)
  mock_pulls(harness.testing, [])
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "findings")
  assert_eq(result.branch_count, 101)
  assert_eq(result.prless_branch_count, 100)
  assert_eq(
    len(
      harness.testing.http_mock_calls().filter({ call -> contains(call.url, "/branches?") })
        .to_list(),
    ),
    4,
  )
}

pipeline test_a_moving_branch_inventory_is_unmeasured(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    branches_url(),
    {
      responses: [
        {status: 200, body: json_stringify([branch("main"), branch("feature/first")])},
        {status: 200, body: json_stringify([branch("main"), branch("feature/second")])},
      ],
    },
  )
  mock_pulls(harness.testing, [])
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "measurement_failed")
  assert_eq(result.error_code, "branch_snapshot_moved")
}

pipeline test_a_moving_pull_request_inventory_is_unmeasured(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_branches(harness.testing, [branch("main"), branch("feature/owned")])
  harness.testing.http_mock(
    "GET",
    pulls_url(),
    {
      responses: [
        {status: 200, body: json_stringify([pull(7, "feature/owned")])},
        {status: 200, body: json_stringify([])},
      ],
    },
  )
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "measurement_failed")
  assert_eq(result.error_code, "pull_request_snapshot_moved")
}

pipeline test_receipt_preserves_failed_scanned_and_finding_counts() {
  const clean: RepositoryBranchAudit = {
    slug: "octo-org/clean",
    default_branch: "main",
    state: "clean",
    branch_count: 3,
    merge_queue_ref_count: 0,
    open_pr_head_count: 2,
    prless_branch_count: 0,
    prless_branches: [],
    prless_findings: [],
    merged_branch_count: 0,
    content_merged_branch_count: 0,
    unmerged_branch_count: 0,
    undetermined_branch_count: 0,
    detail: "clean",
  }
  const finding: RepositoryBranchAudit = {
    slug: "octo-org/finding",
    default_branch: "main",
    state: "findings",
    branch_count: 4,
    merge_queue_ref_count: 0,
    open_pr_head_count: 1,
    prless_branch_count: 2,
    prless_branches: [
      {name: "one", head_oid: OID, protected: false},
      {name: "two", head_oid: OID, protected: false},
    ],
    prless_findings: [
      {
        name: "one",
        head_oid: OID,
        protected: false,
        disposition: "merged",
        disposition_detail: "merged",
      },
      {
        name: "two",
        head_oid: OID,
        protected: false,
        disposition: "unmerged",
        disposition_detail: "unmerged",
      },
    ],
    merged_branch_count: 1,
    content_merged_branch_count: 0,
    unmerged_branch_count: 1,
    undetermined_branch_count: 0,
    detail: "findings",
  }
  const failed: RepositoryBranchAudit = {
    slug: "octo-org/failed",
    default_branch: "main",
    state: "measurement_failed",
    branch_count: nil,
    merge_queue_ref_count: nil,
    open_pr_head_count: nil,
    prless_branch_count: nil,
    prless_branches: [],
    prless_findings: [],
    merged_branch_count: nil,
    content_merged_branch_count: nil,
    unmerged_branch_count: nil,
    undetermined_branch_count: nil,
    error_code: "empty_branch_read",
    detail: "unmeasured",
  }
  const receipt = fleet_branch_audit_receipt([clean, finding, failed])
  assert_eq(receipt.requested_repository_count, 3)
  assert_eq(receipt.scanned_repository_count, 2)
  assert_eq(receipt.failed_repository_count, 1)
  assert_eq(receipt.branch_count, 7)
  assert_eq(receipt.open_pr_head_count, 3)
  assert_eq(receipt.prless_branch_count, 2)
}

pipeline test_issue_body_uses_a_stable_marker_and_names_the_non_mutating_contract() {
  const row: RepositoryBranchAudit = {
    slug: SLUG,
    default_branch: "main",
    state: "findings",
    branch_count: 2,
    merge_queue_ref_count: 0,
    open_pr_head_count: 0,
    prless_branch_count: 1,
    prless_branches: [{name: "feature/one", head_oid: OID, protected: false}],
    prless_findings: [
      {
        name: "feature/one",
        head_oid: OID,
        protected: false,
        disposition: "unmerged",
        disposition_detail: "the tip is not reachable from main",
      },
    ],
    merged_branch_count: 0,
    content_merged_branch_count: 0,
    unmerged_branch_count: 1,
    undetermined_branch_count: 0,
    detail: "finding",
  }
  const body = prless_branch_issue_body(row, "https://github.test/runs/1")
  assert(starts_with(body, prless_branch_issue_marker(SLUG)))
  assert(contains(body, "feature/one"))
  assert(contains(body, "never deletes branches"))
  assert(contains(body, "https://github.test/runs/1"))
}

/**
 * The whole point of the disposition is that it separates a branch nothing
 * needs from a branch that is the only copy of its work. An unreadable compare
 * is its own answer, because the one thing it must never become is the answer
 * that reads as safe to delete.
 */
pipeline test_an_unreadable_compare_is_never_reported_as_safe_to_delete() {
  const branch = {name: "lane/work", head_oid: OID, protected: false}
  const landed = prless_content_verdict([{path: "a", branch_blob: OID, default_blob: OID}])
  const differs = prless_content_verdict([{path: "a", branch_blob: OID, default_blob: nil}])
  const unread = {verdict: "unknown", path_count: nil, differing_path_count: nil, detail: "x"}
  const merged = prless_branch_disposition(branch, "main", true, nil)
  const content_merged = prless_branch_disposition(branch, "main", false, landed)
  const unmerged = prless_branch_disposition(branch, "main", false, differs)
  const unknown = prless_branch_disposition(branch, "main", nil, nil)
  const unread_content = prless_branch_disposition(branch, "main", false, unread)
  const unchecked_content = prless_branch_disposition(branch, "main", false, nil)
  assert_eq(merged.disposition, "merged")
  assert_eq(content_merged.disposition, "content_merged")
  assert_eq(unmerged.disposition, "unmerged")
  assert_eq(unknown.disposition, "unknown")
  // An unreachable tip whose content could not be read, or was never read,
  // must not become either verdict that reads as an answer.
  assert_eq(unread_content.disposition, "unknown")
  assert_eq(unchecked_content.disposition, "unknown")
  assert(contains(merged.disposition_detail, "loses nothing"))
  assert(contains(content_merged.disposition_detail, "loses no file content"))
  assert(contains(unmerged.disposition_detail, "only copy"))
  assert(contains(unknown.disposition_detail, "makes no claim"))
  assert(contains(unread_content.disposition_detail, "makes no claim"))
  assert_eq(merged.name, "lane/work")
  assert_eq(merged.head_oid, OID)
  const all = [merged, content_merged, unmerged, unknown, unread_content]
  assert_eq(prless_disposition_count(all, "merged"), 1)
  assert_eq(prless_disposition_count(all, "content_merged"), 1)
  assert_eq(prless_disposition_count(all, "unmerged"), 1)
  assert_eq(prless_disposition_count(all, "unknown"), 2)
  assert_eq(prless_disposition_count([], "merged"), 0)
}

/**
 * The content verdict in both directions. A path absent on both sides is a
 * match, a path the branch deleted that the default branch still has is not,
 * and one differing path among matches is enough to keep the branch.
 */
pipeline test_the_content_verdict_needs_every_changed_path_to_match() {
  const other = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  assert_eq(prless_content_verdict([]).verdict, "landed")
  assert_eq(
    prless_content_verdict(
      [
        {path: "kept", branch_blob: OID, default_blob: OID},
        {path: "deleted-on-both", branch_blob: nil, default_blob: nil},
      ],
    ).verdict,
    "landed",
  )
  const partial = prless_content_verdict(
    [
      {path: "kept", branch_blob: OID, default_blob: OID},
      {path: "edited", branch_blob: OID, default_blob: other},
    ],
  )
  assert_eq(partial.verdict, "differs")
  assert_eq(partial.differing_path_count, 1)
  assert_eq(partial.path_count, 2)
  assert_eq(
    prless_content_verdict([{path: "removed-here", branch_blob: nil, default_blob: OID}]).verdict,
    "differs",
  )
}

/**
 * A reader who deletes what the issue lists must be able to see which rows are
 * safe from the issue alone, without re-deriving ancestry per branch.
 */
pipeline test_the_issue_body_separates_deletable_branches_from_the_rest(task: unknown) {
  const row: RepositoryBranchAudit = {
    slug: SLUG,
    default_branch: "main",
    state: "findings",
    branch_count: 5,
    merge_queue_ref_count: 0,
    open_pr_head_count: 0,
    prless_branch_count: 4,
    prless_branches: [],
    prless_findings: [
      prless_branch_disposition({name: "done", head_oid: OID, protected: false}, "main", true, nil),
      prless_branch_disposition(
        {name: "squashed", head_oid: OID, protected: false},
        "main",
        false,
        prless_content_verdict([]),
      ),
      prless_branch_disposition(
        {name: "wip", head_oid: OID, protected: false},
        "main",
        false,
        prless_content_verdict([{path: "a", branch_blob: OID, default_blob: nil}]),
      ),
      prless_branch_disposition(
        {name: "opaque", head_oid: OID, protected: false},
        "main",
        nil,
        nil,
      ),
    ],
    merged_branch_count: 1,
    content_merged_branch_count: 1,
    unmerged_branch_count: 1,
    undetermined_branch_count: 1,
    detail: "findings",
  }
  const body = prless_branch_issue_body(row, nil)
  assert(contains(body, "done"))
  assert(contains(body, "wip"))
  assert(contains(body, "opaque"))
  assert(contains(body, "squashed"))
  assert(contains(body, "Delete only the `merged` and `content_merged` ones"))
  assert(contains(body, "\"disposition\": \"content_merged\""))
  assert(contains(body, "could not compare is not a branch it found safe"))
  assert(contains(body, "\"disposition\": \"merged\""))
  assert(contains(body, "\"disposition\": \"unknown\""))
}

/**
 * Branch names carry the machine that saved them, and the audited repositories
 * are public. This drives the real survey, applies the published projection,
 * and renders every surface that leaves the job: the issue body and the
 * receipt printed to the log. A machine name embedded mid-segment and one in
 * different case must both go, and two branches that differ only by machine
 * stay distinguishable by head.
 */
pipeline test_published_branch_names_never_carry_a_private_machine_name(harness: Harness) {
  harness.testing.http_mock_clear()
  const first_oid = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const second_oid = "cccccccccccccccccccccccccccccccccccccccc"
  mock_branches(
    harness.testing,
    [
      branch("main"),
      branch("winddown-wip/labhost-2/lane-eval-7", first_oid),
      branch("winddown-wip/DevBox/lane-eval-7", second_oid),
      branch("recovered/codex-grind-devbox-9"),
    ],
  )
  mock_pulls(harness.testing, [])
  const raw = survey_repository_branches(harness, SLUG, "main", options())
  // Positive control: the raw census does hold the names being removed.
  assert(contains(json_stringify(raw), "labhost-2"))
  const names = unwrap(parse_private_names(" devbox,\nlabhost-2  labhost "))
  const published = public_branch_audit(raw, names)
  const surfaces = [
    prless_branch_issue_body(published, nil),
    json_stringify_pretty(fleet_branch_audit_receipt([published])),
  ]
  for surface in surfaces {
    const folded = lowercase(surface)
    assert_eq(contains(folded, "devbox"), false)
    assert_eq(contains(folded, "labhost"), false)
    assert(contains(surface, "winddown-wip/[host]/lane-eval-7"))
    assert(contains(surface, "recovered/codex-grind-[host]-9"))
    assert(contains(surface, first_oid))
    assert(contains(surface, second_oid))
  }
  assert_eq(published.prless_branch_count, 3)
}

/** A missing secret must stop the audit before it publishes, not redact nothing. */
pipeline test_an_unset_private_name_list_refuses_instead_of_publishing(task: unknown) {
  assert(is_err(parse_private_names("")))
  assert(is_err(parse_private_names(" \n , ")))
  assert(is_err(parse_private_names("devbox,a")))
  assert(is_err(parse_private_names("dev.box")))
  assert_eq(unwrap(parse_private_names("devbox")), ["devbox"])
}

/**
 * The classifier is only worth anything if the survey actually calls it. This
 * drives the real survey with a mocked compare graph and asserts the row that
 * comes out, so a wiring regression cannot hide behind a green unit test of
 * the pure function.
 */
pipeline test_the_survey_carries_each_findings_disposition_into_its_row(harness: Harness) {
  harness.testing.http_mock_clear()
  const done_oid = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const wip_oid = "cccccccccccccccccccccccccccccccccccccccc"
  const opaque_oid = "dddddddddddddddddddddddddddddddddddddddd"
  mock_branches(
    harness.testing,
    [
      branch("main"),
      branch("done", done_oid),
      branch("wip", wip_oid),
      branch("opaque", opaque_oid),
    ],
  )
  mock_pulls(harness.testing, [])
  mock_compare(harness.testing, done_oid, "ahead")
  mock_compare(harness.testing, wip_oid, "diverged")
  mock_content_compare(harness.testing, wip_oid, [changed("src/wip.rs", "added")])
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    blob_answer([["ffffffffffffffffffffffffffffffffffffffff", nil]]),
  )
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "findings")
  assert_eq(result.prless_branch_count, 3)
  assert_eq(result.merged_branch_count, 1)
  assert_eq(result.unmerged_branch_count, 1)
  // "opaque" has no mocked compare, so the read fails and the audit says so
  // rather than guessing.
  assert_eq(result.undetermined_branch_count, 1)
  const by_name = { name -> result.prless_findings.find({ row -> row.name == name })?.disposition }
  assert_eq(by_name("done"), "merged")
  assert_eq(by_name("wip"), "unmerged")
  assert_eq(by_name("opaque"), "unknown")
}

/**
 * GitHub owns `gh-readonly-queue/` branches and removes them when the queue
 * entry finishes, so they are never abandoned work. The exclusion is by that
 * exact leading prefix: a branch that merely resembles it is still audited,
 * and the excluded count is reported rather than silently dropped.
 */
pipeline test_merge_queue_refs_are_excluded_by_their_exact_prefix_and_counted(harness: Harness) {
  harness.testing.http_mock_clear()
  const queue_ref = "gh-readonly-queue/main/pr-7994-0123456789abcdef0123456789abcdef01234567"
  mock_branches(
    harness.testing,
    [
      branch("main"),
      branch("feature/owned"),
      branch(queue_ref),
      branch("gh-readonly-queue-foo"),
      branch("x/gh-readonly-queue/main/pr-3-abc"),
    ],
  )
  mock_pulls(harness.testing, [pull(7, "feature/owned")])
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "findings")
  assert_eq(result.branch_count, 5)
  assert_eq(result.merge_queue_ref_count, 1)
  assert_eq(result.prless_branch_count, 2)
  const names = result.prless_branches.map({ row -> row.name }).to_list().sort()
  assert_eq(names, ["gh-readonly-queue-foo", "x/gh-readonly-queue/main/pr-3-abc"])
  assert_eq(result.prless_findings.any({ row -> row.name == queue_ref }), false)
  const receipt = fleet_branch_audit_receipt([result])
  assert_eq(receipt.merge_queue_ref_count, 1)
  assert(contains(prless_branch_issue_body(result, nil), "left out 1 merge-queue ref(s)"))
}

/**
 * A repository whose only non-default, PR-less branches are queue refs is
 * clean, so its issue closes. A queue ref that appears between the two
 * inventory reads is ordinary queue churn, not a moving census.
 */
pipeline test_queue_refs_alone_leave_a_repository_clean_even_while_they_churn(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    branches_url(),
    {
      responses: [
        {
          status: 200,
          body: json_stringify([branch("main"), branch("gh-readonly-queue/main/pr-1-aaaa")]),
        },
        {
          status: 200,
          body: json_stringify(
            [
              branch("main"),
              branch("gh-readonly-queue/main/pr-1-aaaa"),
              branch("gh-readonly-queue/main/pr-2-bbbb"),
            ],
          ),
        },
      ],
    },
  )
  mock_pulls(harness.testing, [])
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.state, "clean")
  assert_eq(result.prless_branch_count, 0)
  assert_eq(result.merge_queue_ref_count, 2)
}

/**
 * The squash-merge case, in both directions, through the real survey. Both
 * tips are unreachable from main. The squashed branch's changed paths all
 * hold the same blob on main, including a removal and a rename whose old path
 * is gone on both sides. The other branch changes the same paths plus one file
 * main does not have, so it must stay the only copy of that work.
 */
pipeline test_a_squash_merged_branch_is_content_merged_and_one_extra_file_is_not(harness: Harness) {
  harness.testing.http_mock_clear()
  const squashed_oid = "1111111111111111111111111111111111111111"
  const extra_oid = "2222222222222222222222222222222222222222"
  const blob_a = "3333333333333333333333333333333333333333"
  const blob_renamed = "4444444444444444444444444444444444444444"
  const blob_extra = "5555555555555555555555555555555555555555"
  mock_branches(
    harness.testing,
    [branch("main"), branch("squashed", squashed_oid), branch("extra", extra_oid)],
  )
  mock_pulls(harness.testing, [])
  mock_compare(harness.testing, squashed_oid, "diverged")
  mock_compare(harness.testing, extra_oid, "diverged")
  const files = [
    changed("src/a.rs"),
    changed("docs/old.md", "removed"),
    changed("src/new.rs", "renamed", "src/old.rs"),
  ]
  mock_content_compare(harness.testing, squashed_oid, files)
  mock_content_compare(harness.testing, extra_oid, files + [changed("src/extra.rs", "added")])
  const landed_pairs = [[blob_a, blob_a], [nil, nil], [blob_renamed, blob_renamed], [nil, nil]]
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {responses: [blob_answer(landed_pairs), blob_answer(landed_pairs + [[blob_extra, nil]])]},
  )
  const result = survey_repository_branches(harness, SLUG, "main", options())
  const by_name = { name -> result.prless_findings.find({ row -> row.name == name }) }
  assert_eq(by_name("squashed")?.disposition, "content_merged")
  assert_eq(by_name("extra")?.disposition, "unmerged")
  assert(contains(by_name("extra")?.disposition_detail ?? "", "1 of 5 changed path(s) differ"))
  assert_eq(result.content_merged_branch_count, 1)
  assert_eq(result.unmerged_branch_count, 1)
  assert_eq(result.merged_branch_count, 0)
  // The lookups name exact commits on both sides, so a main that moves during
  // the audit cannot mix two trees into one answer.
  const lookups = harness.testing.http_mock_calls().filter(
    { call -> contains(call.url, "/graphql") },
  )
    .to_list()
  assert_eq(len(lookups), 2)
  assert(contains(to_string(lookups[0].body), "${squashed_oid}:src/a.rs"))
  assert(contains(to_string(lookups[0].body), "${DEFAULT_TIP}:src/old.rs"))
}

/**
 * Each way the content read can fail stays `unknown`: a file list at GitHub's
 * cap, a GraphQL error, and a lookup that says a path the compare reports as
 * modified is absent on the branch. None may become a verdict.
 */
pipeline test_a_failed_or_inconsistent_content_read_stays_unknown(harness: Harness) {
  harness.testing.http_mock_clear()
  const capped_oid = "6666666666666666666666666666666666666666"
  const errored_oid = "7777777777777777777777777777777777777777"
  const inconsistent_oid = "8888888888888888888888888888888888888888"
  mock_branches(
    harness.testing,
    [
      branch("main"),
      branch("capped", capped_oid),
      branch("errored", errored_oid),
      branch("inconsistent", inconsistent_oid),
    ],
  )
  mock_pulls(harness.testing, [])
  let capped_files = []
  for index in range(0, 300) {
    capped_files = capped_files + [changed("f/${to_string(index)}")]
  }
  for tip in [capped_oid, errored_oid, inconsistent_oid] {
    mock_compare(harness.testing, tip, "diverged")
  }
  mock_content_compare(harness.testing, capped_oid, capped_files)
  mock_content_compare(harness.testing, errored_oid, [changed("src/a.rs")])
  mock_content_compare(harness.testing, inconsistent_oid, [changed("src/a.rs")])
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      responses: [
        {status: 200, body: json_stringify({data: nil, errors: [{message: "boom"}]})},
        blob_answer([[nil, nil]]),
      ],
    },
  )
  const result = survey_repository_branches(harness, SLUG, "main", options())
  assert_eq(result.undetermined_branch_count, 3)
  assert_eq(result.content_merged_branch_count, 0)
  assert_eq(result.unmerged_branch_count, 0)
  const detail = { name ->
    result.prless_findings.find({ row -> row.name == name })?.disposition_detail ?? ""
  }
  assert(contains(detail("capped"), "content_compare_truncated"))
  assert(contains(detail("errored"), "blob_lookup_failed"))
  assert(contains(detail("inconsistent"), "blob_lookup_inconsistent"))
}
