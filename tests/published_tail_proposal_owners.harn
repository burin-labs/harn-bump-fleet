import { PrerequisiteWaitReceipt } from "../lib/prerequisite_wait"
import { BinarySizePolicy, render_binary_size_policy } from "../lib/release_size_baseline"
import {
  observe_bump_workflow_projection_results,
  select_bump_workflow_commit,
} from "../promote_bump_workflow.harn"
import {
  ReleaseBinarySizeBaselineRequest,
  reconcile_exact_baseline_proposal,
  reconcile_release_binary_size_baseline,
  run_release_binary_size_baseline,
} from "../refresh_release_binary_size_baseline.harn"

const REQUESTED = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const CURRENT = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const MAIN = "cccccccccccccccccccccccccccccccccccccccc"

fn baseline_request(fields: any = {}) -> ReleaseBinarySizeBaselineRequest {
  return {
    tag: fields.tag ?? "v0.10.130",
    repo: fields.repo ?? "/tmp/harn",
    slug: fields.slug ?? "burin-labs/harn",
    release_commit_oid: fields.release_commit_oid ?? REQUESTED,
    apply: fields.apply ?? false,
    auto_merge: fields.auto_merge ?? true,
  }
}

fn policy(version: string, source_sha: string) -> BinarySizePolicy {
  return {
    schema_version: 1,
    default_target: "x86_64-unknown-linux-gnu",
    targets: [
      {
        target: "x86_64-unknown-linux-gnu",
        distribution_fuse_bytes: 1200,
        growth: {warn_bytes: 100, warn_percent_hundredths: 500},
        baseline: {
          version: version,
          source_sha: source_sha,
          bytes: 1000,
          observed_at: "2026-09-04T12:00:00Z",
          build_identity: {
            profile: "dist",
            codegen_units: 1,
            lto: "fat",
            strip: "symbols",
            rustc: "1.95.0",
            aot_embedded: true,
          },
        },
        accepted_growth: [],
      },
    ],
  }
}

pipeline test_baseline_read_only_reconciliation_requires_exact_version_and_source(task: any) {
  const request = baseline_request()
  const exact = reconcile_release_binary_size_baseline(policy("0.10.130", REQUESTED), request)
  assert_eq(exact.state, "proven")
  assert_eq(exact.observed_version, "0.10.130")
  assert_eq(exact.observed_source_sha, REQUESTED)
  const stale = reconcile_release_binary_size_baseline(policy("0.10.129", CURRENT), request)
  assert_eq(stale.state, "pending")
  const wrong_source = reconcile_release_binary_size_baseline(policy("0.10.130", CURRENT), request)
  assert_eq(wrong_source.state, "pending")
}

pipeline test_newer_baseline_refuses_before_any_release_artifact_work(harness: Harness, task: any) {
  const artifact_touched = harness.fs.mkdtemp_in_workspace("baseline-no-artifact-")
    + "/touched"
  const receipt = run_release_binary_size_baseline(
    harness,
    baseline_request({apply: true}),
    {
      download: fn(_run_id, _artifact, _destination) {
        harness.fs.write_text(artifact_touched, "unexpected")
        return {success: false, message: "unexpected"}
      },
    },
    {
      read: fn(_slug) { return Ok(
        {head_oid: MAIN, text: render_binary_size_policy(policy("0.10.131", CURRENT))},
      ) },
    },
  )
  assert_eq(receipt.state, "failed")
  assert(contains(receipt.detail, "newer than requested"))
  assert_eq(harness.fs.exists(artifact_touched), false)
}

pipeline test_existing_exact_baseline_proposal_is_adopted_without_any_write(
  harness: Harness,
  task: any,
) {
  const fixture = harness.fs.mkdtemp_in_workspace("baseline-existing-proposal-")
  const artifact_touched = fixture + "/artifact"
  const proposal_touched = fixture + "/proposal"
  const receipt = run_release_binary_size_baseline(
    harness,
    baseline_request({apply: true}),
    {
      download: fn(_run_id, _artifact, _destination) {
        harness.fs.write_text(artifact_touched, "unexpected")
        return {success: false, message: "unexpected"}
      },
    },
    {
      read: fn(_slug) { return Ok(
        {head_oid: MAIN, text: render_binary_size_policy(policy("0.10.129", CURRENT))},
      ) },
    },
    {
      read: fn(_request) { return Ok(
        {
          state: "pending",
          detail: "existing exact proposal remains open",
          observed_version: "0.10.130",
          observed_source_sha: REQUESTED,
          pull_request: 42,
          url: "https://github.com/burin-labs/harn/pull/42",
          commit: CURRENT,
          effect_absent: false,
        },
      ) },
    },
    {
      publish: fn(_request) {
        harness.fs.write_text(proposal_touched, "unexpected")
        return Err("unexpected proposal write")
      },
    },
  )
  assert_eq(receipt.state, "pending")
  assert_eq(receipt.pull_request, 42)
  assert_eq(harness.fs.exists(artifact_touched), false)
  assert_eq(harness.fs.exists(proposal_touched), false)
}

pipeline test_exact_baseline_proposal_reads_the_raw_github_rest_shape(task: any) {
  const reconciled = reconcile_release_binary_size_baseline(
    policy("0.10.130", REQUESTED),
    baseline_request(),
  )
  const merged = unwrap(
    reconcile_exact_baseline_proposal(
      CURRENT,
      reconciled,
      [
        {
          number: 8068,
          state: "closed",
          merged_at: "2026-09-05T05:42:37Z",
          html_url: "https://github.com/burin-labs/harn/pull/8068",
          head: {sha: CURRENT, ref: "automation/release-binary-size-baseline"},
          base: {ref: "main"},
        },
      ],
    ),
  )
  assert_eq(merged.state, "pending")
  assert_eq(merged.pull_request, 8068)
  assert_eq(merged.url, "https://github.com/burin-labs/harn/pull/8068")
  assert(contains(merged.detail, "merged"))
  const invalid_number = unwrap(
    reconcile_exact_baseline_proposal(
      CURRENT,
      reconciled,
      [
        {
          number: 0,
          state: "closed",
          merged_at: "2026-09-05T05:42:37Z",
          html_url: "https://github.com/burin-labs/harn/pull/0",
          head: {sha: CURRENT, ref: "automation/release-binary-size-baseline"},
          base: {ref: "main"},
        },
      ],
    ),
  )
  assert_eq(invalid_number.state, "failed")
  assert_eq(invalid_number.pull_request, nil)
}

pipeline test_read_only_baseline_proves_a_crash_had_no_effect_without_writing(
  harness: Harness,
  task: any,
) {
  const fixture = harness.fs.mkdtemp_in_workspace("baseline-effect-absent-")
  const artifact_touched = fixture + "/artifact"
  const proposal_touched = fixture + "/proposal"
  const receipt = run_release_binary_size_baseline(
    harness,
    baseline_request({apply: false}),
    {
      download: fn(_run_id, _artifact, _destination) {
        harness.fs.write_text(artifact_touched, "unexpected")
        return {success: false, message: "unexpected"}
      },
    },
    {
      read: fn(_slug) { return Ok(
        {head_oid: MAIN, text: render_binary_size_policy(policy("0.10.129", CURRENT))},
      ) },
    },
    {
      read: fn(_request) { return Ok(
        {
          state: "absent",
          detail: "no same-target baseline effect exists",
          observed_version: "",
          observed_source_sha: "",
          effect_absent: true,
        },
      ) },
    },
    {
      publish: fn(_request) {
        harness.fs.write_text(proposal_touched, "unexpected")
        return Err("unexpected proposal write")
      },
    },
  )
  assert_eq(receipt.state, "pending")
  assert_eq(receipt.effect_absent, true)
  assert_eq(harness.fs.exists(artifact_touched), false)
  assert_eq(harness.fs.exists(proposal_touched), false)
}

pipeline test_promotion_preserves_only_a_proved_descendant(task: any) {
  const advanced = select_bump_workflow_commit(CURRENT, REQUESTED, "ahead")
  assert_eq(advanced.state, "selected")
  assert_eq(advanced.effective_commit_oid, CURRENT)
  assert_eq(advanced.preserved_advanced, true)
  const behind = select_bump_workflow_commit(CURRENT, REQUESTED, "behind")
  assert_eq(behind.effective_commit_oid, REQUESTED)
  assert_eq(behind.preserved_advanced, false)
  const diverged = select_bump_workflow_commit(CURRENT, REQUESTED, "diverged")
  assert_eq(diverged.state, "failed")
  assert_eq(diverged.effective_commit_oid, "")
}

pipeline test_projection_proof_carries_a_nonzero_complete_target_census(task: any) {
  const clean = {slug: "burin-labs/harn-bump-fleet", status: "clean", drifted: []}
  const drift = {slug: "burin-labs/burin-code", status: "drift", drifted: ["bump-harn.yml"]}
  const observed = observe_bump_workflow_projection_results(
    [{result: clean, target_count: 2}, {result: drift, target_count: 3}],
    [],
    false,
  )
  assert_eq(observed.state, "pending")
  assert_eq(observed.expected_target_count, 5)
  assert_eq(observed.observed_clean_count, 2)
  const complete = observe_bump_workflow_projection_results(
    [{result: clean, target_count: 2}, {result: clean, target_count: 3}],
    [],
    false,
  )
  assert_eq(complete.state, "proven")
  assert_eq(complete.expected_target_count, 5)
  assert_eq(complete.observed_clean_count, 5)
  const absent = observe_bump_workflow_projection_results([], [], false)
  assert_eq(absent.state, "failed")
  assert_eq(absent.expected_target_count, 0)
}

fn satisfied_wait(repo: string, number: int, head_oid: string) -> PrerequisiteWaitReceipt {
  return {
    schema_version: "harn_bump_fleet.prerequisite_wait.v2",
    ok: true,
    status: "satisfied",
    repo: repo,
    number: number,
    expected_head_oid: head_oid,
    attempts: 1,
    retry_count: 0,
    last_status: "satisfied",
    checks_observed: true,
    check_count: 1,
    pending_check_count: 0,
    failing_check_count: 0,
    failing_check_names: [],
    elapsed_ms: 1,
    detail: "exact proposal merged",
    admitted_projection: false,
  }
}

pipeline test_projection_write_proof_requires_a_matching_exact_wait(task: any) {
  const applied = {
    slug: "burin-labs/burin-code",
    status: "applied",
    drifted: [".github/workflows/bump-harn.yml"],
    pull_request: 42,
    commit: CURRENT,
  }
  const missing = observe_bump_workflow_projection_results(
    [{result: applied, target_count: 3}],
    [],
    true,
  )
  assert_eq(missing.state, "failed")
  assert_eq(missing.observed_clean_count, 0)
  const wrong_head = observe_bump_workflow_projection_results(
    [{result: applied, target_count: 3}],
    [satisfied_wait(applied.slug, applied.pull_request ?? 0, REQUESTED)],
    true,
  )
  assert_eq(wrong_head.state, "failed")
  assert_eq(wrong_head.observed_clean_count, 0)
  const exact = observe_bump_workflow_projection_results(
    [{result: applied, target_count: 3}],
    [satisfied_wait(applied.slug, applied.pull_request ?? 0, applied.commit ?? "")],
    true,
  )
  assert_eq(exact.state, "proven")
  assert_eq(exact.expected_target_count, 3)
  assert_eq(exact.observed_clean_count, 3)
}

pipeline test_projection_absence_requires_a_complete_mixed_clean_or_absent_census(task: any) {
  const clean = {slug: "burin-labs/harn-bump-fleet", status: "clean", drifted: []}
  const absent = {
    slug: "burin-labs/burin-code",
    status: "drift",
    drifted: [".github/workflows/bump-harn.yml"],
    effect_absent: true,
  }
  const complete = observe_bump_workflow_projection_results(
    [{result: clean, target_count: 2}, {result: absent, target_count: 3}],
    [],
    false,
  )
  assert_eq(complete.state, "pending")
  assert_eq(complete.effect_absent, true)
  assert_eq(complete.expected_target_count, 5)
  assert_eq(complete.observed_clean_count, 2)
  const unknown = observe_bump_workflow_projection_results(
    [
      {result: absent, target_count: 3},
      {
        result: {slug: "burin-labs/harn-cloud", status: "drift", drifted: ["bump-harn.yml"]},
        target_count: 1,
      },
    ],
    [],
    false,
  )
  assert_eq(unknown.effect_absent, false)
  const already_proven = observe_bump_workflow_projection_results(
    [{result: clean, target_count: 2}],
    [],
    false,
  )
  assert_eq(already_proven.state, "proven")
  assert_eq(already_proven.effect_absent, false)
}
