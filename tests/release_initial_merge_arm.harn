import { mock_release_watch_adapter, run_release_watch } from "../lib/release_watch_runtime"
import {
  release_watch_receipt,
  release_watch_receipt_bind_main_commit,
  release_watch_receipt_parse,
  release_watch_receipt_read,
} from "../lib/release_watch_state"

const candidate = "1111111111111111111111111111111111111111"

fn fresh_receipt() {
  return release_watch_receipt_bind_main_commit(
    release_watch_receipt(
      {
        tag: "v1.2.3",
        slug: "burin-labs/harn",
        pin_sha: "2222222222222222222222222222222222222222",
        publication: {
          version: "1.2.3",
          local_branch: "release/v1.2.3",
          remote_ref: "release-attempt/v1.2.3/${candidate}",
          head_oid: candidate,
        },
        pr_url: "https://github.com/burin-labs/harn/pull/42",
        merge_lease_generation: "initial-arm-test",
        authorize_initial_merge: true,
        created_at: "2026-09-14T00:00:00Z",
      },
    ),
    candidate,
    "2026-09-14T00:01:00Z",
  )
}

pipeline test_fresh_tagged_handoff_arms_exact_candidate(harness: Harness) {
  const original = fresh_receipt()
  let arms = 0
  let disabled = false
  const path = harness.fs.mkdtemp_in_workspace("initial-arm-") + "/watch.json"
  const adapter = mock_release_watch_adapter(original)
    + {
      pr_probe: fn(_slug, _url) { return {
        number: 42,
        merged: false,
        merged_at: nil,
        merge_commit_oid: nil,
        github_state: "open",
        mergeable_state: "clean",
        head: {sha: candidate},
        base: {ref: "main"},
        in_merge_queue: false,
        auto_merge_armed: arms > 0 && !disabled,
      } },
      enable_auto_merge: fn(slug, pr) {
        assert_eq(slug, original.slug)
        assert_eq(pr.head.sha, candidate)
        assert_eq(release_watch_receipt_read(harness.fs, path)?.initial_merge_request, "attempted")
        arms = arms + 1
        return {state: "enabled"}
      },
    }
  const result = run_release_watch(
    harness,
    original,
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(arms, 1)
  assert_eq(result.watchdog.reason, "release_pr_auto_merge_armed")
  disabled = true
  const persisted = release_watch_receipt_read(harness.fs, path)
  assert(persisted != nil)
  const resumed = run_release_watch(
    harness,
    persisted,
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(arms, 1)
  assert_eq(resumed.watchdog.reason, "release_pr_merge_authority_revoked")
  assert(!resumed.reason.contains("signature"))
}

pipeline test_lost_initial_response_cannot_repeat_request(harness: Harness) {
  const original = fresh_receipt()
  const path = harness.fs.mkdtemp_in_workspace("lost-arm-") + "/watch.json"
  let arms = 0
  const adapter = mock_release_watch_adapter(original)
    + {
      pr_probe: fn(_slug, _url) { return {
        number: 42,
        merged: false,
        merged_at: nil,
        merge_commit_oid: nil,
        github_state: "open",
        mergeable_state: "clean",
        head: {sha: candidate},
        base: {ref: "main"},
        in_merge_queue: false,
        auto_merge_armed: false,
      } },
      enable_auto_merge: fn(_slug, _pr) {
        arms = arms + 1
        throw "connection lost after request"
      },
    }
  const first = try {
    run_release_watch(
      harness,
      original,
      path,
      {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
      adapter,
    )
  }
  assert(is_err(first))
  const persisted = release_watch_receipt_read(harness.fs, path)
  assert(persisted != nil)
  assert_eq(persisted.initial_merge_request, "attempted")
  const resumed = run_release_watch(
    harness,
    persisted,
    path,
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(arms, 1)
  assert_eq(resumed.watchdog.reason, "release_pr_merge_authority_revoked")
}

pipeline test_legacy_receipt_never_invents_initial_authority() {
  const legacy = fresh_receipt() + {schema_version: "release_harn.publish_watch.v9"}
  let historical = {}
  for key in legacy.keys() {
    if key != "initial_merge_request" {
      historical[key] = legacy[key]
    }
  }
  const parsed = release_watch_receipt_parse(historical)
  assert(parsed != nil)
  assert_eq(parsed.initial_merge_request, "not_authorized")
}

pipeline test_initial_request_refuses_wrong_identity_before_mutation(harness: Harness) {
  const original = fresh_receipt()
  const exact = {
    number: 42,
    merged: false,
    merged_at: nil,
    merge_commit_oid: nil,
    github_state: "open",
    mergeable_state: "clean",
    head: {sha: candidate},
    base: {ref: "main"},
    in_merge_queue: false,
    auto_merge_armed: false,
  }
  for changed in [
    {head: {sha: "3333333333333333333333333333333333333333"}},
    {number: 43},
    {base: {ref: "other"}},
  ] {
    let arms = 0
    const adapter = mock_release_watch_adapter(original)
      + {
        pr_probe: fn(_slug, _url) { return exact + changed },
        enable_auto_merge: fn(_slug, _pr) {
          arms = arms + 1
          return {state: "enabled"}
        },
      }
    const result = try {
      run_release_watch(
        harness,
        original,
        harness.fs.mkdtemp_in_workspace("wrong-arm-") + "/watch.json",
        {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
        adapter,
      )
    }
    assert(is_err(result))
    assert_eq(arms, 0)
  }
}

pipeline test_existing_merge_request_is_adopted_without_resending(harness: Harness) {
  const original = fresh_receipt()
  let arms = 0
  const adapter = mock_release_watch_adapter(original)
    + {
      pr_probe: fn(_slug, _url) { return {
        number: 42,
        merged: false,
        merged_at: nil,
        merge_commit_oid: nil,
        github_state: "open",
        mergeable_state: "clean",
        head: {sha: candidate},
        base: {ref: "main"},
        in_merge_queue: false,
        auto_merge_armed: true,
      } },
      enable_auto_merge: fn(_slug, _pr) {
        arms = arms + 1
        return {state: "enabled"}
      },
    }
  const result = run_release_watch(
    harness,
    original,
    harness.fs.mkdtemp_in_workspace("adopt-arm-") + "/watch.json",
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(arms, 0)
  assert_eq(result.receipt.initial_merge_request, "observed")
}
