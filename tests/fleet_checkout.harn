import { materialize_fleet_checkouts } from "../lib/fleet_checkout"

fn thrown(callback) -> string {
  return try {
    callback()
    ""
  } catch (e) {
    to_string(e)
  }
}

pipeline test_materializes_typed_repositories_without_shell_interpolation(harness: Harness, task) {
  const root = harness.fs.mkdtemp_in_workspace("fleet-checkouts-")
  let calls = []
  const results = materialize_fleet_checkouts(
    {fs: harness.fs, process: harness.process},
    [{slug: "burin-labs/one", directory: "one"}, {slug: "burin-labs/two", directory: "two"}],
    "main",
    root,
    {
      clone: fn(slug, branch, destination) {
        calls = calls + [{slug: slug, branch: branch, destination: destination}]
        return {success: true, stdout: "", stderr: ""}
      },
    },
  )
  assert_eq(results.map({ row -> row.status }), ["cloned", "cloned"])
  assert_eq(calls[0].slug, "burin-labs/one")
  assert_eq(calls[0].branch, "main")
  assert_eq(calls[0].destination, path_join(root, "one"))
}

pipeline test_materialization_stops_at_first_failed_clone(harness: Harness, task) {
  const root = harness.fs.mkdtemp_in_workspace("fleet-checkouts-")
  let calls = []
  const results = materialize_fleet_checkouts(
    {fs: harness.fs, process: harness.process},
    [{slug: "burin-labs/one", directory: "one"}, {slug: "burin-labs/two", directory: "two"}],
    "main",
    root,
    {
      clone: fn(slug, _branch, _destination) {
        calls = calls + [slug]
        return {success: false, stderr: "denied"}
      },
    },
  )
  assert_eq(calls, ["burin-labs/one"])
  assert_eq(results[0]?.status, "failed")
  assert_eq(results[0]?.detail, "denied")
}

pipeline test_materialization_requires_an_absolute_root(harness: Harness, task) {
  assert(
    thrown(
      { ->
        materialize_fleet_checkouts(
          {fs: harness.fs, process: harness.process},
          [],
          "main",
          "relative",
        )
      },
    ),
  )
}
