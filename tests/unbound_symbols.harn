import { is_screaming_snake, unbound_symbol_findings } from "../lib/unbound_symbols"

fn tok(kind, lexeme) {
  return {kind: kind, lexeme: lexeme, line: 1}
}

fn finding_names(tokens) {
  return unbound_symbol_findings(tokens).map({ f -> return f.name })
}

pipeline test_is_screaming_snake_predicate(task) {
  assert_eq(is_screaming_snake("FOO_BAR"), true)
  assert_eq(is_screaming_snake("RELEASE_RUN_ARGV_PREFIXES"), true)
  assert_eq(is_screaming_snake("A_1"), true)
  // No underscore, a single word, lowercase, PascalCase, and empties do not
  // qualify, so ordinary types/locals never enter the sweep.
  assert_eq(is_screaming_snake("FOO"), false)
  assert_eq(is_screaming_snake("foo_bar"), false)
  assert_eq(is_screaming_snake("Harness"), false)
  assert_eq(is_screaming_snake("_FOO"), false)
  assert_eq(is_screaming_snake(""), false)
  assert_eq(is_screaming_snake("X"), false)
}

pipeline test_unbound_reference_is_flagged(task) {
  // `const x = ORPHAN_CONST` with no binding for ORPHAN_CONST anywhere.
  const tokens = [
    tok("Const", "const"),
    tok("Identifier", "x"),
    tok("Assign", "="),
    tok("Identifier", "ORPHAN_CONST"),
  ]
  assert_eq(finding_names(tokens), ["ORPHAN_CONST"])
}

pipeline test_orphaned_stage_split_constant_is_caught(task) {
  // The #323 defect: a reference to a module constant the stage split dropped.
  const referenced_only = [tok("Return", "return"), tok("Identifier", "RELEASE_RUN_ARGV_PREFIXES")]
  assert_eq(finding_names(referenced_only), ["RELEASE_RUN_ARGV_PREFIXES"])
  // Restoring the top-level `const` binding clears the finding.
  const with_definition = [
    tok("Const", "const"),
    tok("Identifier", "RELEASE_RUN_ARGV_PREFIXES"),
    tok("Assign", "="),
    tok("LBracket", "["),
    tok("RBracket", "]"),
    tok("Return", "return"),
    tok("Identifier", "RELEASE_RUN_ARGV_PREFIXES"),
  ]
  assert_eq(finding_names(with_definition), [])
}

pipeline test_local_and_imported_bindings_resolve(task) {
  // Top-level const binding used later resolves.
  const local_def = [
    tok("Const", "const"),
    tok("Identifier", "MY_CONST"),
    tok("Assign", "="),
    tok("IntLiteral", "5"),
    tok("Const", "const"),
    tok("Identifier", "z"),
    tok("Assign", "="),
    tok("Identifier", "MY_CONST"),
  ]
  assert_eq(finding_names(local_def), [])
  // Imported names (including aliases) count as defined.
  const imported = [
    tok("Import", "import"),
    tok("LBrace", "{"),
    tok("Identifier", "IMPORTED_CONST"),
    tok("RBrace", "}"),
    tok("From", "from"),
    tok("StringLiteral", "\"lib/x\""),
    tok("Return", "return"),
    tok("Identifier", "IMPORTED_CONST"),
  ]
  assert_eq(finding_names(imported), [])
}

pipeline test_non_reference_positions_are_skipped(task) {
  // Field access `cfg.FIELD_NAME` and optional-chain `cfg?.FIELD_NAME`.
  const field = [tok("Identifier", "cfg"), tok("Dot", "."), tok("Identifier", "FIELD_NAME")]
  assert_eq(finding_names(field), [])
  const opt_field = [tok("Identifier", "cfg"), tok("QuestionDot", "?."), tok("Identifier", "FIELD_NAME")]
  assert_eq(finding_names(opt_field), [])
  // Object key `{ KEY_NAME: 1 }` is a label, not a reference.
  const key = [
    tok("LBrace", "{"),
    tok("Identifier", "KEY_NAME"),
    tok("Colon", ":"),
    tok("IntLiteral", "1"),
    tok("RBrace", "}"),
  ]
  assert_eq(finding_names(key), [])
  // Call targets are validated by `harn check`, so the sweep leaves them alone.
  const call = [tok("Identifier", "MAKE_THING"), tok("LParen", "("), tok("RParen", ")")]
  assert_eq(finding_names(call), [])
}

pipeline test_loop_and_lambda_params_bind(task) {
  // `for LOOP_VAR in xs { ... LOOP_VAR }` — the loop variable is a binding.
  const loop = [
    tok("For", "for"),
    tok("Identifier", "LOOP_VAR"),
    tok("In", "in"),
    tok("Identifier", "xs"),
    tok("LBrace", "{"),
    tok("Identifier", "LOOP_VAR"),
    tok("RBrace", "}"),
  ]
  assert_eq(finding_names(loop), [])
  // `{ LAMBDA_ARG -> LAMBDA_ARG }` — the lambda parameter is a binding.
  const lambda = [
    tok("LBrace", "{"),
    tok("Identifier", "LAMBDA_ARG"),
    tok("Arrow", "->"),
    tok("Identifier", "LAMBDA_ARG"),
    tok("RBrace", "}"),
  ]
  assert_eq(finding_names(lambda), [])
}
