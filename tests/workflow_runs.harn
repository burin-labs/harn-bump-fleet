import { newest_workflow_run_after, pre_tag_binary_gate_verdict } from "../lib/workflow_runs"

const RELEASE_SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn gate_config() {
  return {
    workflow: "build-release-binaries.yml",
    event: "workflow_dispatch",
    policy_ref: "main",
    expected_policy_sha: RELEASE_SHA,
    source_ref: "release/v1.2.3",
    expected_source_sha: RELEASE_SHA,
    target_job: "Build x86_64-unknown-linux-gnu",
    required_source_step: "Verify benchmark source revision",
    required_size_step: "Check binary size budget",
    benchmark_only: true,
    runner_profile: "standard",
    targets: "x86_64-unknown-linux-gnu",
    completion_timeout_ms: 10800000,
    completion_interval_ms: 30000,
    transient_view_retry_max_attempts: 3,
    transient_view_retry_base_ms: 1000,
    transient_view_retry_cap_ms: 5000,
  }
}

fn run_snapshot(id, status, conclusion, head_sha = RELEASE_SHA) {
  return {
    id: id,
    event: "workflow_dispatch",
    head_branch: "main",
    head_sha: head_sha,
    status: status,
    conclusion: conclusion,
    url: "https://github.test/run/${id}",
  }
}

fn green_jobs() {
  return [
    {
      name: "Resolve release context",
      status: "completed",
      conclusion: "success",
      steps: [{name: "Resolve release context", status: "completed", conclusion: "success"}],
    },
    {
      name: "Build x86_64-unknown-linux-gnu",
      status: "completed",
      conclusion: "success",
      steps: [
        {name: "Verify benchmark source revision", status: "completed", conclusion: "success"},
        {name: "Check binary size budget", status: "completed", conclusion: "success"},
      ],
    },
  ]
}

pipeline test_newest_workflow_run_after_ignores_older_runs(task) {
  const run = newest_workflow_run_after(
    [
      {id: 1, created_at: "2026-07-02T10:00:00Z", status: "completed", conclusion: "success"},
      {id: 2, created_at: "2026-07-02T10:10:00Z", status: "completed", conclusion: "failure"},
      {id: 3, created_at: "2026-07-02T09:59:59Z", status: "in_progress", conclusion: ""},
    ],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run.id, 2)
  assert_eq(run.status, "completed")
  assert_eq(run.conclusion, "failure")
}

pipeline test_pre_tag_binary_gate_green_exact_run(task) {
  const passed = pre_tag_binary_gate_verdict(
    gate_config(),
    run_snapshot(11, "completed", "success"),
    green_jobs(),
  )
  assert_eq(passed.action, "pass")
  assert(contains(passed.message, RELEASE_SHA))
}

pipeline test_pre_tag_binary_gate_rejects_wrong_identity(task) {
  const wrong_sha = pre_tag_binary_gate_verdict(
    gate_config(),
    run_snapshot(20, "completed", "success", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"),
    green_jobs(),
  )
  assert_eq(wrong_sha.action, "fail")
  assert(contains(wrong_sha.message, "policy SHA"))
  const wrong_event = pre_tag_binary_gate_verdict(
    gate_config(),
    run_snapshot(21, "completed", "success") + {event: "push"},
    green_jobs(),
  )
  assert_eq(wrong_event.action, "fail")
  assert(contains(wrong_event.message, "identity changed"))
}

pipeline test_pre_tag_binary_gate_rejects_red_or_suppressed_run(task) {
  const failed = pre_tag_binary_gate_verdict(
    gate_config(),
    run_snapshot(30, "completed", "failure"),
    green_jobs(),
  )
  assert_eq(failed.action, "fail")
  assert(contains(failed.message, "failure"))
  const skipped = pre_tag_binary_gate_verdict(
    gate_config(),
    run_snapshot(31, "completed", "success"),
    [
      {name: "Resolve release context", status: "completed", conclusion: "success", steps: []},
      {
        name: "Build x86_64-unknown-linux-gnu",
        status: "completed",
        conclusion: "skipped",
        steps: [],
      },
    ],
  )
  assert_eq(skipped.action, "fail")
  assert(contains(skipped.message, "did not execute successfully"))
}

pipeline test_pre_tag_binary_gate_requires_source_verification(task) {
  let jobs = green_jobs()
  jobs[1].steps = [{name: "Check binary size budget", status: "completed", conclusion: "success"}]
  const missing_source = pre_tag_binary_gate_verdict(
    gate_config(),
    run_snapshot(39, "completed", "success"),
    jobs,
  )
  assert_eq(missing_source.action, "fail")
  assert(contains(missing_source.message, "verify the immutable source"))
}

pipeline test_pre_tag_binary_gate_requires_successful_size_step(task) {
  let jobs = green_jobs()
  jobs[1].steps = [
    {name: "Verify benchmark source revision", status: "completed", conclusion: "success"},
    {name: "Check binary size budget", status: "completed", conclusion: "skipped"},
  ]
  const skipped_step = pre_tag_binary_gate_verdict(
    gate_config(),
    run_snapshot(40, "completed", "success"),
    jobs,
  )
  assert_eq(skipped_step.action, "fail")
  assert(contains(skipped_step.message, "size-budget step"))
  jobs[1].steps = [
    {name: "Verify benchmark source revision", status: "completed", conclusion: "success"},
  ]
  const missing_step = pre_tag_binary_gate_verdict(
    gate_config(),
    run_snapshot(41, "completed", "success"),
    jobs,
  )
  assert_eq(missing_step.action, "fail")
  assert(contains(missing_step.message, "size-budget step"))
}
