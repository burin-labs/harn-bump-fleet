import { newest_workflow_run_after, workflow_run_poll_result } from "../lib/workflow_runs"

pipeline test_newest_workflow_run_after_ignores_older_runs(task) {
  let run = newest_workflow_run_after(
    [
      {databaseId: 1, createdAt: "2026-07-02T10:00:00Z", status: "completed", conclusion: "success"},
      {databaseId: 2, createdAt: "2026-07-02T10:10:00Z", status: "completed", conclusion: "failure"},
      {databaseId: 3, createdAt: "2026-07-02T09:59:59Z", status: "in_progress", conclusion: ""},
    ],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run.id, 2)
  assert_eq(run.status, "completed")
  assert_eq(run.conclusion, "failure")
}

pipeline test_workflow_run_poll_result_preserves_running_state(task) {
  let run = workflow_run_poll_result(
    [
      {
        databaseId: 42,
        createdAt: "2026-07-02T10:00:01Z",
        status: "in_progress",
        conclusion: "",
        url: "https://github.test/run/42",
      },
    ],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run.id, 42)
  assert_eq(run.status, "in_progress")
  assert_eq(run.url, "https://github.test/run/42")
}

pipeline test_workflow_run_poll_result_returns_nil_when_no_post_dispatch_run(task) {
  let run = workflow_run_poll_result(
    [{databaseId: 7, createdAt: "2026-07-02T09:59:59Z", status: "completed", conclusion: "success"}],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run, nil)
}

pipeline test_workflow_run_poll_result_normalizes_cli_field_names(task) {
  let run = workflow_run_poll_result(
    [
      {
        id: 55,
        created_at: "2026-07-02T10:00:01Z",
        status: "Queued",
        conclusion: nil,
        html_url: "https://github.test/run/55",
      },
    ],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run.id, 55)
  assert_eq(run.status, "queued")
  assert_eq(run.conclusion, "unknown")
  assert_eq(run.url, "https://github.test/run/55")
}
