import {
  newest_workflow_run_after,
  pre_tag_binary_gate_initial_state,
  pre_tag_binary_gate_transition,
  workflow_run_poll_result,
} from "../lib/workflow_runs"

const RELEASE_SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn gate_config() {
  return {
    workflow: "build-release-binaries.yml",
    event: "workflow_dispatch",
    ref: "release/v1.2.3",
    expected_head_sha: RELEASE_SHA,
    target_job: "Build x86_64-unknown-linux-gnu",
    required_step: "Check binary size budget",
    benchmark_only: true,
    targets: "x86_64-unknown-linux-gnu",
    discovery_timeout_ms: 300000,
    discovery_interval_ms: 2000,
    completion_timeout_ms: 10800000,
    completion_interval_ms: 30000,
  }
}

fn run_snapshot(id, status, conclusion, head_sha = RELEASE_SHA) {
  return {
    databaseId: id,
    event: "workflow_dispatch",
    headBranch: "release/v1.2.3",
    headSha: head_sha,
    status: status,
    conclusion: conclusion,
    url: "https://github.test/run/${id}",
  }
}

fn green_jobs() {
  return [
    {
      name: "Resolve release context",
      status: "completed",
      conclusion: "success",
      steps: [{name: "Resolve release context", status: "completed", conclusion: "success"}],
    },
    {
      name: "Build x86_64-unknown-linux-gnu",
      status: "completed",
      conclusion: "success",
      steps: [{name: "Check binary size budget", status: "completed", conclusion: "success"}],
    },
  ]
}

pipeline test_newest_workflow_run_after_ignores_older_runs(task) {
  let run = newest_workflow_run_after(
    [
      {databaseId: 1, createdAt: "2026-07-02T10:00:00Z", status: "completed", conclusion: "success"},
      {databaseId: 2, createdAt: "2026-07-02T10:10:00Z", status: "completed", conclusion: "failure"},
      {databaseId: 3, createdAt: "2026-07-02T09:59:59Z", status: "in_progress", conclusion: ""},
    ],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run.id, 2)
  assert_eq(run.status, "completed")
  assert_eq(run.conclusion, "failure")
}

pipeline test_workflow_run_poll_result_preserves_running_state(task) {
  let run = workflow_run_poll_result(
    [
      {
        databaseId: 42,
        createdAt: "2026-07-02T10:00:01Z",
        status: "in_progress",
        conclusion: "",
        url: "https://github.test/run/42",
      },
    ],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run.id, 42)
  assert_eq(run.status, "in_progress")
  assert_eq(run.url, "https://github.test/run/42")
}

pipeline test_workflow_run_poll_result_returns_nil_when_no_post_dispatch_run(task) {
  let run = workflow_run_poll_result(
    [{databaseId: 7, createdAt: "2026-07-02T09:59:59Z", status: "completed", conclusion: "success"}],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run, nil)
}

pipeline test_workflow_run_poll_result_normalizes_cli_field_names(task) {
  let run = workflow_run_poll_result(
    [
      {
        id: 55,
        created_at: "2026-07-02T10:00:01Z",
        status: "Queued",
        conclusion: nil,
        html_url: "https://github.test/run/55",
      },
    ],
    "2026-07-02T10:00:00Z",
  )
  assert_eq(run.id, 55)
  assert_eq(run.status, "queued")
  assert_eq(run.conclusion, "unknown")
  assert_eq(run.url, "https://github.test/run/55")
}

pipeline test_pre_tag_binary_gate_green_virtual_transition(task) {
  let state = pre_tag_binary_gate_initial_state([run_snapshot(10, "completed", "success")])
  let discovered = pre_tag_binary_gate_transition(
    gate_config(),
    state,
    {runs: [run_snapshot(10, "completed", "success"), run_snapshot(11, "queued", "")]},
  )
  assert_eq(discovered.action, "wait")
  assert_eq(discovered.state.run_id, 11)
  let passed = pre_tag_binary_gate_transition(
    gate_config(),
    discovered.state,
    {
      runs: [run_snapshot(11, "completed", "success"), run_snapshot(12, "queued", "")],
      jobs: green_jobs(),
    },
  )
  assert_eq(passed.action, "pass")
  assert_eq(passed.state.run_id, 11)
  assert(contains(passed.message, RELEASE_SHA))
}

pipeline test_pre_tag_binary_gate_rejects_wrong_sha_and_ambiguous_dispatches(task) {
  let initial = pre_tag_binary_gate_initial_state([])
  let wrong_sha = pre_tag_binary_gate_transition(
    gate_config(),
    initial,
    {runs: [run_snapshot(20, "completed", "success", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")]},
  )
  assert_eq(wrong_sha.action, "fail")
  assert(contains(wrong_sha.message, "head SHA"))
  let ambiguous = pre_tag_binary_gate_transition(
    gate_config(),
    initial,
    {runs: [run_snapshot(21, "queued", ""), run_snapshot(22, "queued", "")]},
  )
  assert_eq(ambiguous.action, "fail")
  assert(contains(ambiguous.message, "exact dispatched run"))
}

pipeline test_pre_tag_binary_gate_rejects_red_or_suppressed_run(task) {
  let failed = pre_tag_binary_gate_transition(
    gate_config(),
    pre_tag_binary_gate_initial_state([]),
    {runs: [run_snapshot(30, "completed", "failure")]},
  )
  assert_eq(failed.action, "fail")
  assert(contains(failed.message, "failure"))
  let skipped = pre_tag_binary_gate_transition(
    gate_config(),
    pre_tag_binary_gate_initial_state([]),
    {
      runs: [run_snapshot(31, "completed", "success")],
      jobs: [
        {name: "Resolve release context", status: "completed", conclusion: "success", steps: []},
        {name: "Build x86_64-unknown-linux-gnu", status: "completed", conclusion: "skipped", steps: []},
      ],
    },
  )
  assert_eq(skipped.action, "fail")
  assert(contains(skipped.message, "did not execute successfully"))
}

pipeline test_pre_tag_binary_gate_requires_successful_size_step(task) {
  let jobs = green_jobs()
  jobs[1].steps = [{name: "Check binary size budget", status: "completed", conclusion: "skipped"}]
  let skipped_step = pre_tag_binary_gate_transition(
    gate_config(),
    pre_tag_binary_gate_initial_state([]),
    {runs: [run_snapshot(40, "completed", "success")], jobs: jobs},
  )
  assert_eq(skipped_step.action, "fail")
  assert(contains(skipped_step.message, "size-budget step"))
  jobs[1].steps = []
  let missing_step = pre_tag_binary_gate_transition(
    gate_config(),
    pre_tag_binary_gate_initial_state([]),
    {runs: [run_snapshot(41, "completed", "success")], jobs: jobs},
  )
  assert_eq(missing_step.action, "fail")
  assert(contains(missing_step.message, "size-budget step"))
}
