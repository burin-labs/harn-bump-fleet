import { FleetProjectionTarget } from "../lib/fleet_projection_targets"
import { REMOTE_PROJECTION_BRANCH, converge_remote_repository } from "../lib/remote_projection"
import { GithubClientOptions } from "harn-github-connector/default"

/**
 * The remote convergence loop, exercised through the real connector dispatch
 * path against mocked endpoints.
 *
 * Every claim this makes is about a write to somebody else's repository, so the
 * evidence has to be which requests were issued, not only what was returned. A
 * dry run that quietly opened a pull request and a repeat run that quietly
 * pushed a duplicate commit would both still report the right status.
 */
const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

const PATH = "PROJECTION.yml"

const BASE_OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const BRANCH_OID = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const COMMIT_OID = "cccccccccccccccccccccccccccccccccccccccc"

const EXPECTED = "name: projection\n"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "convergence-test-token"}
}

fn targets() -> list<FleetProjectionTarget> {
  return [{slug: SLUG, path: PATH, expected: EXPECTED, origin: "fleet.toml test projection"}]
}

fn file_url(ref: string) -> string {
  return BASE + "/repos/octo-org/octo-repo/contents/" + PATH + "?ref=" + replace(ref, "/", "%2F")
}

fn file_body(text: string) -> string {
  return json_stringify(
    {
      name: PATH,
      path: PATH,
      sha: "dddddddddddddddddddddddddddddddddddddddd",
      size: len(text),
      type: "file",
      encoding: "base64",
      content: base64_encode(text),
    },
  )
}

fn mock_file(testing: HarnessTesting, ref: string, text: string) {
  testing.http_mock("GET", file_url(ref), {status: 200, body: file_body(text)})
}

fn mock_branch_head(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/" + REMOTE_PROJECTION_BRANCH,
    {status: 200, body: json_stringify({name: REMOTE_PROJECTION_BRANCH})},
  )
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main",
    {status: 200, body: json_stringify({name: "main", commit: {sha: BASE_OID}})},
  )
}

fn refs_url() -> string {
  return BASE + "/repos/octo-org/octo-repo/git/refs"
}

fn methods_called(testing: HarnessTesting) -> list<string> {
  return testing.http_mock_calls().map(
    { call -> to_string(call?.method ?? "") + " " + to_string(call?.url ?? "") },
  )
    .to_list()
}

fn wrote_anything(testing: HarnessTesting) -> bool {
  for call in methods_called(testing) {
    if !starts_with(call, "GET ") {
      return true
    }
  }
  return false
}

pipeline test_matching_bytes_need_no_proposal(harness: Harness, task) {
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", EXPECTED)
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, options())
  assert_eq(result.status, "clean")
  assert_eq(result.drifted, [])
  assert_eq(wrote_anything(harness.testing), false)
}

pipeline test_a_dry_run_reports_drift_and_writes_nothing(harness: Harness, task) {
  // The safety property of the default mode. A status of `drift` proves only
  // that the run noticed; the request log is what proves it stayed read-only.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  const result = converge_remote_repository(harness, SLUG, "main", targets(), false, options())
  assert_eq(result.status, "drift")
  assert_eq(result.drifted, [PATH])
  assert_eq(wrote_anything(harness.testing), false)
}

pipeline test_applying_proposes_the_projection_on_a_branch(harness: Harness, task) {
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {
      status: 201,
      body: json_stringify(
        {ref: "refs/heads/" + REMOTE_PROJECTION_BRANCH, object: {sha: BASE_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: COMMIT_OID,
                url: "https://github.com/octo-org/octo-repo/commit/" + COMMIT_OID,
                signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
              },
              ref: {name: REMOTE_PROJECTION_BRANCH, target: {oid: COMMIT_OID}},
            },
          },
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head=octo-org%3Aautomation%2Ffleet-projections&base=main&per_page=2",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/pulls",
    {
      status: 201,
      body: json_stringify(
        {
          number: 77,
          title: "chore: restore fleet-owned projections",
          body: "body",
          state: "open",
          html_url: "https://github.com/octo-org/octo-repo/pull/77",
          base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
          head: {
            ref: REMOTE_PROJECTION_BRANCH,
            sha: COMMIT_OID,
            repo: {full_name: SLUG, owner: {login: "octo-org"}},
          },
        },
      ),
    },
  )
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, options())
  assert_eq(result.status, "applied")
  assert_eq(result.drifted, [PATH])
  assert_eq(result.branch, REMOTE_PROJECTION_BRANCH)
  assert_eq(result.commit, COMMIT_OID)
  assert_eq(result.pull_request, 77)
  assert_eq(contains(methods_called(harness.testing), "POST " + BASE + "/graphql"), true)
}

pipeline test_an_open_proposal_is_not_proposed_again(harness: Harness, task) {
  // Idempotence is the whole difference between a convergence loop and a
  // nightly stream of duplicate commits: the branch already says what this run
  // would say, so the run must stop before the commit.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, REMOTE_PROJECTION_BRANCH, EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + REMOTE_PROJECTION_BRANCH,
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + REMOTE_PROJECTION_BRANCH, object: {sha: BRANCH_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BRANCH_OID,
    {status: 200, body: json_stringify({sha: BRANCH_OID, message: "chore: restore\n"})},
  )
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, options())
  assert_eq(result.status, "pending")
  assert_eq(result.branch, REMOTE_PROJECTION_BRANCH)
  assert_eq(contains(methods_called(harness.testing), "POST " + BASE + "/graphql"), false)
}

pipeline test_one_repository_failing_does_not_raise(harness: Harness, task) {
  // Twenty-six repositories share a run. A provider failure has to end this
  // repository and report itself, not abort the fleet.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main",
    {status: 500, body: json_stringify({message: "server error"})},
  )
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, options())
  assert_eq(result.status, "error")
  assert_eq(result.slug, SLUG)
  assert_eq(contains(result.error ?? "", "branch head lookup failed"), true)
}
