import { FleetProjectionTarget } from "../lib/fleet_projection_targets"
import {
  DEFAULT_PROJECTION_PR_AGE_BUDGET_DAYS,
  REMOTE_PROJECTION_BRANCH_PREFIX,
  RemoteConvergenceResult,
  converge_remote_repository,
  projection_status_line,
  pull_request_age_days,
  pull_request_older_than,
  remote_convergence_failed,
  remote_projection_branch,
  with_projection_pr_age,
} from "../lib/remote_projection"
import { GithubClientOptions } from "harn-github-connector/default"

/**
 * The remote convergence loop, exercised through the real connector dispatch
 * path against mocked endpoints.
 *
 * Every claim this makes is about a write to somebody else's repository, so the
 * evidence has to be which requests were issued, not only what was returned. A
 * dry run that quietly opened a pull request and a repeat run that quietly
 * pushed a duplicate commit would both still report the right status.
 */
const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

const PATH = "PROJECTION.yml"

const BASE_OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const BRANCH_OID = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const COMMIT_OID = "cccccccccccccccccccccccccccccccccccccccc"

const RACE_OID = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"

const EXPECTED = "name: projection\n"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "convergence-test-token"}
}

fn targets() -> list<FleetProjectionTarget> {
  return [{slug: SLUG, path: PATH, expected: EXPECTED, origin: "fleet.toml test projection"}]
}

fn branch() -> string {
  return remote_projection_branch(targets())
}

fn file_url(ref: string) -> string {
  return BASE + "/repos/octo-org/octo-repo/contents/" + PATH + "?ref=" + replace(ref, "/", "%2F")
}

fn file_body(text: string) -> string {
  return json_stringify(
    {
      name: PATH,
      path: PATH,
      sha: "dddddddddddddddddddddddddddddddddddddddd",
      size: len(text),
      type: "file",
      encoding: "base64",
      content: base64_encode(text),
    },
  )
}

fn mock_file(testing: HarnessTesting, ref: string, text: string) {
  testing.http_mock("GET", file_url(ref), {status: 200, body: file_body(text)})
}

fn mock_branch_head(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/" + branch(),
    {status: 200, body: json_stringify({name: branch()})},
  )
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main",
    {status: 200, body: json_stringify({name: "main", commit: {sha: BASE_OID}})},
  )
}

fn refs_url() -> string {
  return BASE + "/repos/octo-org/octo-repo/git/refs"
}

const PROJECTION_TITLE = "chore: restore fleet-owned projections"

/** The branch every proposal shared before each rendered projection got its own. */
const LEGACY_BRANCH = REMOTE_PROJECTION_BRANCH_PREFIX

fn pulls_url() -> string {
  return BASE + "/repos/octo-org/octo-repo/pulls?state=open&base=main&per_page=100"
}

fn issue_url(number: int) -> string {
  return BASE + "/repos/octo-org/octo-repo/issues/" + to_string(number)
}

fn open_pull(number: int, ref: string, title: string) -> dict {
  return {
    number: number,
    title: title,
    state: "open",
    html_url: "https://github.com/octo-org/octo-repo/pull/" + to_string(number),
    base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
    head: {ref: ref, sha: BRANCH_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
  }
}

fn mock_open_proposals(testing: HarnessTesting, pulls: list<dict>) {
  testing.http_mock("GET", pulls_url(), {status: 200, body: json_stringify(pulls)})
}

fn mock_closable(testing: HarnessTesting, number: int) {
  testing.http_mock(
    "POST",
    issue_url(number) + "/comments",
    {status: 201, body: json_stringify({id: number})},
  )
  testing.http_mock(
    "PATCH",
    issue_url(number),
    {status: 200, body: json_stringify({number: number, state: "closed"})},
  )
}

/** The comment a close carried, which is the only place its reason is stated. */
fn close_comment(testing: HarnessTesting, number: int) -> string {
  for call in testing.http_mock_calls() {
    if to_string(call?.method ?? "") == "POST"
      && to_string(call?.url ?? "")
        == issue_url(number)
          + "/comments" {
      return to_string(json_parse(to_string(call?.body ?? "")).get("body") ?? "")
    }
  }
  return ""
}

fn closed_numbers(result: dict) -> list<int> {
  return (result.sweep?.superseded ?? []).filter({ proposal -> proposal.state == "closed" }).map(
    { proposal -> proposal.pull_request },
  )
    .to_list()
}

fn methods_called(testing: HarnessTesting) -> list<string> {
  return testing.http_mock_calls().map(
    { call -> to_string(call?.method ?? "") + " " + to_string(call?.url ?? "") },
  )
    .to_list()
}

fn wrote_anything(testing: HarnessTesting) -> bool {
  for call in methods_called(testing) {
    if !starts_with(call, "GET ") {
      return true
    }
  }
  return false
}

pipeline test_each_exact_projection_has_one_stable_fresh_branch(task: any) {
  const first = remote_projection_branch(targets())
  const repeated = remote_projection_branch(targets())
  const changed = remote_projection_branch(
    [{slug: SLUG, path: PATH, expected: "name: next\n", origin: "fleet.toml test projection"}],
  )
  const pair = targets()
    + [{slug: SLUG, path: "SECOND.yml", expected: "name: second\n", origin: "second source"}]
  assert_eq(first, repeated, "repeat convergence must reuse one identity branch")
  assert(starts_with(first, REMOTE_PROJECTION_BRANCH_PREFIX + "-"))
  assert(first != changed, "new rendered bytes must start from a fresh branch")
  assert_eq(
    remote_projection_branch(pair),
    remote_projection_branch(pair.reverse().to_list()),
    "manifest ordering must not change the projection identity",
  )
}

pipeline test_matching_bytes_need_no_proposal(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", EXPECTED)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "clean")
  assert_eq(result.drifted, [])
  assert_eq(wrote_anything(harness.testing), false)
}

pipeline test_a_dry_run_reports_drift_and_writes_nothing(harness: Harness, task: any) {
  // The safety property of the default mode. A status of `drift` proves only
  // that the run noticed; the request log is what proves it stayed read-only.
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", "name: stale\n")
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    false,
    false,
    options(),
  )
  assert_eq(result.status, "drift")
  assert_eq(result.drifted, [PATH])
  assert_eq(wrote_anything(harness.testing), false)
}

pipeline test_partial_projection_refuses_changed_repository_bytes(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  const stale = "name: stale\n"
  mock_file(harness.testing, "main", stale)
  mock_file(harness.testing, branch(), "name: changed while converging\n")
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {
      status: 201,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BASE_OID, type: "commit"}},
      ),
    },
  )
  const derived = targets().map({ target -> target + {derived_from_sha256: sha256(stale)} })
    .to_list()
  const result = converge_remote_repository(harness, SLUG, "main", derived, true, false, options())
  assert_eq(result.status, "error")
  assert(contains(result.error ?? "", "changed after its pin projection was derived"))
  assert(
    !contains(methods_called(harness.testing), "POST " + BASE + "/graphql"),
    "changed repository-owned bytes must never be committed",
  )
}

pipeline test_applying_proposes_the_projection_on_a_branch(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", "name: stale\n")
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {
      status: 201,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BASE_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: COMMIT_OID,
                url: "https://github.com/octo-org/octo-repo/commit/" + COMMIT_OID,
                signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
              },
              ref: {name: branch(), target: {oid: COMMIT_OID}},
            },
          },
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main&per_page=2",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/pulls",
    {
      status: 201,
      body: json_stringify(
        {
          number: 77,
          title: "chore: restore fleet-owned projections",
          body: "body",
          state: "open",
          html_url: "https://github.com/octo-org/octo-repo/pull/77",
          base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
          head: {
            ref: branch(),
            sha: COMMIT_OID,
            repo: {full_name: SLUG, owner: {login: "octo-org"}},
          },
        },
      ),
    },
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "applied")
  assert_eq(result.drifted, [PATH])
  assert_eq(result.branch, branch())
  assert_eq(result.commit, COMMIT_OID)
  assert_eq(result.pull_request, 77)
  assert_eq(contains(methods_called(harness.testing), "POST " + BASE + "/graphql"), true)
}

pipeline test_a_concurrent_projection_commit_is_reconciled_once(harness: Harness, task: any) {
  // Two fleet runs can publish the same generated bytes at once. The first
  // run must adopt the winner's fresh head without adding a duplicate commit;
  // treating that expected race as terminal strands every later repository.
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {
      responses: [
        {
          status: 201,
          body: json_stringify(
            {ref: "refs/heads/" + branch(), object: {sha: BASE_OID, type: "commit"}},
          ),
        },
        {status: 422, body: json_stringify({message: "Reference already exists"})},
      ],
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: COMMIT_OID,
                url: "https://github.com/octo-org/octo-repo/commit/" + COMMIT_OID,
                signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
              },
              ref: {name: branch(), target: {oid: COMMIT_OID}},
            },
          },
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main&per_page=2",
    {
      status: 200,
      body: json_stringify(
        [
          {
            number: 77,
            title: "chore: restore fleet-owned projections",
            state: "open",
            html_url: "https://github.com/octo-org/octo-repo/pull/77",
            base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
            head: {
              ref: branch(),
              sha: RACE_OID,
              repo: {full_name: SLUG, owner: {login: "octo-org"}},
            },
          },
        ],
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: RACE_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + RACE_OID,
    {status: 200, body: json_stringify({sha: RACE_OID, message: "chore: restore\n"})},
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "pending")
  assert_eq(result.commit, RACE_OID)
  assert_eq(result.auto_merge?.state, "held")
  const graphql_calls = methods_called(harness.testing).filter(
    { call -> call == "POST " + BASE + "/graphql" },
  )
    .to_list()
  assert_eq(len(graphql_calls), 1, "the retry must not publish a second commit")
}

pipeline test_an_open_proposal_is_not_proposed_again(harness: Harness, task: any) {
  // Idempotence is the whole difference between a convergence loop and a
  // nightly stream of duplicate commits: the branch already says what this run
  // would say, so the run must stop before the commit.
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BRANCH_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BRANCH_OID,
    {status: 200, body: json_stringify({sha: BRANCH_OID, message: "chore: restore\n"})},
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "pending")
  assert_eq(result.branch, branch())
  assert_eq(contains(methods_called(harness.testing), "POST " + BASE + "/graphql"), false)
}

pipeline test_one_repository_failing_does_not_raise(harness: Harness, task: any) {
  // Twenty-six repositories share a run. A provider failure has to end this
  // repository and report itself, not abort the fleet.
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", "name: stale\n")
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main",
    {status: 500, body: json_stringify({message: "server error"})},
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "error")
  assert_eq(result.slug, SLUG)
  assert_eq(contains(result.error ?? "", "branch head lookup failed"), true)
}

// -------------------------------------------------------------------------------------------------

// Arming
//
// The loop proposes and then asks GitHub to merge the proposal once the target
// repository's own required checks pass. Every claim below is about which
// request was issued and with which lease, because a receipt saying `armed` is
// exactly what a run that armed the wrong commit would also print.
//
// One mock per method-and-URL replaces the previous one rather than queueing,
// so the single `POST /graphql` mock answers both the commit mutation and the
// arming mutation. Each mutation reads only its own key out of `data`, and the
// request bodies below are what actually separate them.

// -------------------------------------------------------------------------------------------------

const AUTO_MERGE_PR = 77

fn graphql_request_containing(testing: HarnessTesting, needle: string) -> dict? {
  for call in testing.http_mock_calls() {
    if to_string(call?.method ?? "") == "POST" && to_string(call?.url ?? "") == BASE + "/graphql"
      && contains(to_string(call?.body ?? ""), needle) {
      return call
    }
  }
  return nil
}

fn mock_commit_and_arm_graphql(testing: HarnessTesting) {
  testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: COMMIT_OID,
                url: "https://github.com/octo-org/octo-repo/commit/" + COMMIT_OID,
                signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
              },
              ref: {name: branch(), target: {oid: COMMIT_OID}},
            },
            enablePullRequestAutoMerge: {
              actor: {login: "harn-fleet"},
              pullRequest: {
                number: AUTO_MERGE_PR,
                url: "https://github.com/octo-org/octo-repo/pull/77",
                mergeStateStatus: "BLOCKED",
                autoMergeRequest: {enabledAt: "2026-08-04T18:00:00Z", mergeMethod: "SQUASH"},
              },
            },
          },
        },
      ),
    },
  )
}

fn mock_pull_for_arming(testing: HarnessTesting, head_oid: string) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/pulls/" + to_string(AUTO_MERGE_PR),
    {
      status: 200,
      body: json_stringify(
        {
          number: AUTO_MERGE_PR,
          node_id: "PR_node_77",
          state: "open",
          html_url: "https://github.com/octo-org/octo-repo/pull/77",
          auto_merge: nil,
          base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
          head: {ref: branch(), sha: head_oid, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
        },
      ),
    },
  )
}

fn mock_created_pull(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main&per_page=2",
    {status: 200, body: "[]"},
  )
  testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/pulls",
    {
      status: 201,
      body: json_stringify(
        {
          number: AUTO_MERGE_PR,
          title: "chore: restore fleet-owned projections",
          body: "body",
          state: "open",
          html_url: "https://github.com/octo-org/octo-repo/pull/77",
          base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
          head: {
            ref: branch(),
            sha: COMMIT_OID,
            repo: {full_name: SLUG, owner: {login: "octo-org"}},
          },
        },
      ),
    },
  )
}

fn mock_fresh_proposal(testing: HarnessTesting) {
  testing.http_mock_clear()
  mock_open_proposals(testing, [])
  mock_file(testing, "main", "name: stale\n")
  mock_branch_head(testing)
  testing.http_mock(
    "POST",
    refs_url(),
    {
      status: 201,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BASE_OID, type: "commit"}},
      ),
    },
  )
  mock_commit_and_arm_graphql(testing)
  mock_created_pull(testing)
}

pipeline test_arming_leases_the_commit_this_run_published(harness: Harness, task: any) {
  // The lease is the safety property. Arming against the branch name, or
  // against the base it forked from, would let a commit appended between the
  // publication and this call ride in on the fleet's authority.
  mock_fresh_proposal(harness.testing)
  mock_pull_for_arming(harness.testing, COMMIT_OID)
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "applied")
  assert_eq(result.auto_merge?.state, "armed")
  assert_eq(result.auto_merge?.method, "SQUASH")
  const mutation = graphql_request_containing(harness.testing, "EnableAutoMerge")
  assert(mutation != nil, "an auto-merge mutation was issued")
  const variables = json_parse(to_string(mutation?.body ?? "")).get("variables")
  assert_eq(variables.get("expectedHeadOid"), COMMIT_OID)
  assert_eq(variables.get("pullRequestId"), "PR_node_77")
}

pipeline test_a_stale_branch_head_is_refused_rather_than_armed(harness: Harness, task: any) {
  // The falsifier for the test above: if the lease were decorative, a pull
  // request whose head moved after publication would still be armed.
  mock_fresh_proposal(harness.testing)
  mock_pull_for_arming(harness.testing, BRANCH_OID)
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "applied")
  assert_eq(result.auto_merge?.state, "refused")
  assert_eq(graphql_request_containing(harness.testing, "EnableAutoMerge"), nil)
}

pipeline test_holding_arming_still_proposes(harness: Harness, task: any) {
  // `--no-auto-merge` has to leave the repair and remove only the arming.
  mock_fresh_proposal(harness.testing)
  mock_pull_for_arming(harness.testing, COMMIT_OID)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "applied")
  assert_eq(result.pull_request, AUTO_MERGE_PR)
  assert_eq(result.auto_merge?.state, "held")
  assert_eq(graphql_request_containing(harness.testing, "EnableAutoMerge"), nil)
}

pipeline test_a_refused_arming_fails_the_repository(harness: Harness, task: any) {
  // A repository with auto-merge switched off, or a gate the App may not
  // satisfy, leaves a proposal a human can still merge — and used to leave the
  // job green forever. The refusal must fail the run so that silence cannot
  // hide a fleet that stopped converging.
  mock_fresh_proposal(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/pulls/" + to_string(AUTO_MERGE_PR),
    {status: 403, body: json_stringify({message: "Resource not accessible by integration"})},
  )
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "applied")
  assert_eq(result.auto_merge?.state, "refused")
  assert_eq(remote_convergence_failed(result), true)
  assert(trim(result.auto_merge?.error ?? "") != "", "a refusal names why")
}

pipeline test_an_already_proposed_repair_is_armed_without_a_second_commit(
  harness: Harness,
  task: any,
) {
  // The recovery path. A run that published a commit but could not arm it must
  // arm on the next run, or one transient refusal parks that repository
  // forever — the pile-up this loop exists to prevent, one repository at a
  // time. It must do that without publishing the duplicate commit that
  // idempotence forbids.
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BRANCH_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BRANCH_OID,
    {status: 200, body: json_stringify({sha: BRANCH_OID, message: "chore: restore\n"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main",
    {
      status: 200,
      body: json_stringify(
        [
          {
            number: AUTO_MERGE_PR,
            title: "chore: restore fleet-owned projections",
            state: "open",
            html_url: "https://github.com/octo-org/octo-repo/pull/77",
            base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
            head: {
              ref: branch(),
              sha: BRANCH_OID,
              repo: {full_name: SLUG, owner: {login: "octo-org"}},
            },
          },
        ],
      ),
    },
  )
  mock_commit_and_arm_graphql(harness.testing)
  mock_pull_for_arming(harness.testing, BRANCH_OID)
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "pending")
  assert_eq(result.pull_request, AUTO_MERGE_PR)
  assert_eq(result.auto_merge?.state, "armed")
  assert_eq(graphql_request_containing(harness.testing, "CreateCommitOnBranch"), nil)
  const mutation = graphql_request_containing(harness.testing, "EnableAutoMerge")
  assert(mutation != nil, "the standing proposal was armed")
  assert_eq(
    json_parse(to_string(mutation?.body ?? "")).get("variables").get("expectedHeadOid"),
    BRANCH_OID,
  )
}

pipeline test_a_closed_proposal_is_not_reopened_by_a_cron_job(harness: Harness, task: any) {
  // Closing the pull request is how a person says no. The drift is still
  // reported, but a nightly run must not overrule that decision.
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BRANCH_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BRANCH_OID,
    {status: 200, body: json_stringify({sha: BRANCH_OID, message: "chore: restore\n"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main",
    {status: 200, body: "[]"},
  )
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "pending")
  assert_eq(result.pull_request, nil)
  assert_eq(result.auto_merge, nil)
  for call in methods_called(harness.testing) {
    assert_eq(starts_with(call, "POST " + BASE + "/repos/octo-org/octo-repo/pulls"), false)
  }
}

// -------------------------------------------------------------------------------------------------

// Retiring superseded proposals
//
// A proposal lives on a branch named for the exact bytes it carries, so one on
// any other projection branch is proposing bytes the manifest has moved past.
// Nothing else in the loop looks at it again, and it keeps an armed auto-merge
// that can never fire once its pull request conflicts, so it reads like active
// work forever. Every claim below is about which request was issued, because a
// receipt saying `closed` is exactly what a run that closed the wrong pull
// request would also print.

// -------------------------------------------------------------------------------------------------

pipeline test_a_superseded_proposal_is_retired_with_its_reason(harness: Harness, task: any) {
  mock_fresh_proposal(harness.testing)
  mock_open_proposals(harness.testing, [open_pull(59, LEGACY_BRANCH, PROJECTION_TITLE)])
  mock_closable(harness.testing, 59)
  mock_pull_for_arming(harness.testing, COMMIT_OID)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "applied")
  assert_eq(closed_numbers(result), [59])
  assert(
    contains(methods_called(harness.testing), "PATCH " + issue_url(59)),
    "the superseded proposal was actually closed, not only reported",
  )
  // The comment is the whole audit trail a reader arriving at a closed pull
  // request has, so it must name the branch that replaced this one.
  assert(contains(close_comment(harness.testing, 59), branch()))
  assert(contains(close_comment(harness.testing, 59), "superseded"))
}

pipeline test_the_branch_this_run_renders_is_never_swept(harness: Harness, task: any) {
  // The falsifier for the test above. A sweep that matched on the prefix alone
  // would close the proposal this same run just published.
  mock_fresh_proposal(harness.testing)
  mock_open_proposals(
    harness.testing,
    [open_pull(90, branch(), PROJECTION_TITLE), open_pull(59, LEGACY_BRANCH, PROJECTION_TITLE)],
  )
  mock_closable(harness.testing, 59)
  mock_closable(harness.testing, 90)
  mock_pull_for_arming(harness.testing, COMMIT_OID)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(closed_numbers(result), [59])
  assert_eq(
    contains(methods_called(harness.testing), "PATCH " + issue_url(90)),
    false,
    "the proposal this run renders must survive its own sweep",
  )
}

pipeline test_a_clean_repository_still_retires_its_orphans(harness: Harness, task: any) {
  // The case that produced the debris this sweep exists for: the repair landed
  // by some other path, so the repository reads clean and the stale proposal it
  // is still holding has nothing left to propose. Gating the sweep on drift
  // would miss exactly this.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", EXPECTED)
  mock_open_proposals(harness.testing, [open_pull(59, LEGACY_BRANCH, PROJECTION_TITLE)])
  mock_closable(harness.testing, 59)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "clean")
  assert_eq(result.drifted, [])
  assert_eq(closed_numbers(result), [59])
  assert(contains(close_comment(harness.testing, 59), "no drift left to repair"))
}

pipeline test_a_dry_run_names_superseded_proposals_without_closing_one(
  harness: Harness,
  task: any,
) {
  // The same safety property the repair has. A status of `would_close` proves
  // only that the run noticed; the request log is what proves it stayed
  // read-only.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  mock_open_proposals(harness.testing, [open_pull(59, LEGACY_BRANCH, PROJECTION_TITLE)])
  mock_closable(harness.testing, 59)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    false,
    false,
    options(),
  )
  assert_eq(result.status, "drift")
  assert_eq(len(result.sweep?.superseded ?? []), 1)
  assert_eq((result.sweep?.superseded ?? [])[0]?.state, "would_close")
  assert_eq((result.sweep?.superseded ?? [])[0]?.pull_request, 59)
  assert_eq(wrote_anything(harness.testing), false)
}

pipeline test_a_proposal_someone_renamed_is_left_to_its_owner(harness: Harness, task: any) {
  // Renaming a proposal is how a person takes it over. Closing it would be the
  // same overreach as reopening one they closed, and a branch that merely looks
  // like a projection branch is not this loop's to retire either.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", EXPECTED)
  mock_open_proposals(
    harness.testing,
    [
      open_pull(59, LEGACY_BRANCH, "chore: restore fleet-owned projections (hold, under review)"),
      open_pull(60, "ksinder/manual-projection-fix", PROJECTION_TITLE),
    ],
  )
  mock_closable(harness.testing, 59)
  mock_closable(harness.testing, 60)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "clean")
  assert_eq(result.sweep?.superseded, [])
  for call in methods_called(harness.testing) {
    assert_eq(starts_with(call, "PATCH " + BASE + "/repos/octo-org/octo-repo/issues"), false)
  }
}

pipeline test_a_sweep_that_cannot_list_fails_the_run(harness: Harness, task: any) {
  // A sweep that stopped working looks exactly like a fleet with nothing to
  // retire. The listing failure must fail the run; hiding it in the receipt
  // is the silence the alarm exists to end.
  mock_fresh_proposal(harness.testing)
  harness.testing.http_mock(
    "GET",
    pulls_url(),
    {status: 500, body: json_stringify({message: "server error"})},
  )
  mock_pull_for_arming(harness.testing, COMMIT_OID)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "applied")
  assert_eq(remote_convergence_failed(result), true)
  assert(trim(result.sweep?.error ?? "") != "", "a sweep that could not look says so")
  assert_eq(result.sweep?.superseded, [])
}

pipeline test_a_refused_close_is_reported_rather_than_raised(harness: Harness, task: any) {
  // One repository declining a close must not end the run that was repairing
  // twenty-six others.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", EXPECTED)
  mock_open_proposals(harness.testing, [open_pull(59, LEGACY_BRANCH, PROJECTION_TITLE)])
  harness.testing.http_mock(
    "POST",
    issue_url(59) + "/comments",
    {status: 403, body: json_stringify({message: "Resource not accessible by integration"})},
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "clean")
  assert_eq(remote_convergence_failed(result), false)
  assert_eq((result.sweep?.superseded ?? [])[0]?.state, "refused")
  assert(trim((result.sweep?.superseded ?? [])[0]?.error ?? "") != "", "a refusal names why")
}

fn pending_result(created_at: string) -> RemoteConvergenceResult {
  return {
    slug: SLUG,
    status: "pending",
    drifted: [PATH],
    pull_request: AUTO_MERGE_PR,
    created_at: created_at,
  }
}

pipeline test_pull_request_age_is_measured_in_whole_days(task: any) {
  // The issue's named gap: created_at / age_days / older_than existed
  // nowhere on the projection path. A stamp two days old is still inside a
  // three-day budget; a stamp three days old is not.
  assert_eq(pull_request_age_days("2026-08-25T00:00:00Z", "2026-08-28T00:00:00Z"), 3)
  assert_eq(pull_request_age_days("2026-08-26T00:00:00Z", "2026-08-28T00:00:00Z"), 2)
  assert_eq(pull_request_age_days("", "2026-08-28T00:00:00Z"), nil)
  assert_eq(pull_request_age_days("not-a-date", "2026-08-28T00:00:00Z"), nil)
  assert_eq(pull_request_older_than("2026-08-25T00:00:00Z", "2026-08-28T00:00:00Z", 3), true)
  assert_eq(pull_request_older_than("2026-08-26T00:00:00Z", "2026-08-28T00:00:00Z", 3), false)
  assert_eq(DEFAULT_PROJECTION_PR_AGE_BUDGET_DAYS, 3)
}

pipeline test_a_young_pending_proposal_does_not_fail(task: any) {
  const young = with_projection_pr_age(
    pending_result("2026-08-27T00:00:00Z"),
    "2026-08-28T00:00:00Z",
    3,
  )
  assert_eq(young.age_days, 1)
  assert_eq(young.overdue, false)
  assert_eq(remote_convergence_failed(young), false)
}

pipeline test_a_pending_proposal_past_its_age_budget_fails(task: any) {
  const overdue = with_projection_pr_age(
    pending_result("2026-08-20T00:00:00Z"),
    "2026-08-28T00:00:00Z",
    3,
  )
  assert_eq(overdue.age_days, 8)
  assert_eq(overdue.overdue, true)
  assert_eq(remote_convergence_failed(overdue), true)
}

pipeline test_a_human_closed_proposal_has_no_age(task: any) {
  // Closing the pull request is how a person says no. Measuring that branch
  // would invent a clock for a decision the cron is forbidden to reopen.
  const closed_pending: RemoteConvergenceResult = {
    slug: SLUG,
    status: "pending",
    drifted: [PATH],
    created_at: "2026-08-01T00:00:00Z",
  }
  const closed = with_projection_pr_age(closed_pending, "2026-08-28T00:00:00Z", 3)
  assert_eq(closed.age_days, nil)
  assert_eq(closed.overdue, nil)
  assert_eq(remote_convergence_failed(closed), false)
}

pipeline test_a_standing_proposal_reads_created_at_and_escalates(harness: Harness, task: any) {
  // The production path: github.pr.list has no timestamps, so age is read
  // from the typed view. A proposal that has sat past the budget must fail
  // the repository, not stay pending-and-green.
  harness.testing.http_mock_clear()
  mock_open_proposals(harness.testing, [])
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BRANCH_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BRANCH_OID,
    {status: 200, body: json_stringify({sha: BRANCH_OID, message: "chore: restore\n"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main",
    {
      status: 200,
      body: json_stringify(
        [
          {
            number: AUTO_MERGE_PR,
            title: "chore: restore fleet-owned projections",
            state: "open",
            html_url: "https://github.com/octo-org/octo-repo/pull/77",
            base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
            head: {
              ref: branch(),
              sha: BRANCH_OID,
              repo: {full_name: SLUG, owner: {login: "octo-org"}},
            },
          },
        ],
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/pulls/" + to_string(AUTO_MERGE_PR),
    {
      status: 200,
      body: json_stringify(
        {
          number: AUTO_MERGE_PR,
          node_id: "PR_node_77",
          title: "chore: restore fleet-owned projections",
          state: "open",
          html_url: "https://github.com/octo-org/octo-repo/pull/77",
          created_at: "2026-08-20T00:00:00Z",
          auto_merge: nil,
          base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
          head: {
            ref: branch(),
            sha: BRANCH_OID,
            repo: {full_name: SLUG, owner: {login: "octo-org"}},
          },
        },
      ),
    },
  )
  // github.pr.view also loads branch protection. A 404 is "unprotected" and
  // must not erase the created_at this test exists to prove we read.
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main/protection",
    {status: 404, body: json_stringify({message: "Not Found"})},
  )
  mock_commit_and_arm_graphql(harness.testing)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    true,
    options(),
    "2026-08-28T00:00:00Z",
    3,
  )
  assert_eq(result.status, "pending")
  assert_eq(result.pull_request, AUTO_MERGE_PR)
  assert_eq(result.created_at, "2026-08-20T00:00:00Z")
  assert_eq(result.age_days, 8)
  assert_eq(result.overdue, true)
  assert_eq(remote_convergence_failed(result), true)
}

pipeline test_a_clean_status_line_is_one_human_sentence(task: any) {
  assert_eq(
    projection_status_line({slug: SLUG, status: "clean", drifted: []}),
    "clean octo-org/octo-repo: ",
  )
}

pipeline test_an_error_status_line_names_the_failure(task: any) {
  assert_eq(
    projection_status_line({slug: SLUG, status: "error", drifted: [], error: "contents 404"}),
    "error octo-org/octo-repo: contents 404",
  )
}

pipeline test_a_refused_arming_is_named_on_the_status_line(task: any) {
  assert_eq(
    projection_status_line(
      {
        slug: SLUG,
        status: "pending",
        drifted: [PATH],
        auto_merge: {state: "refused", error: "auto-merge disabled"},
      },
