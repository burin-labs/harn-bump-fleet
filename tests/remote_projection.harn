pipeline test_an_overdue_proposal_is_named_on_the_status_line(task: any) {
  assert_eq(
    projection_status_line(
      {slug: SLUG, status: "pending", drifted: [PATH], age_days: 8, overdue: true},
    ),
    "pending octo-org/octo-repo: PROJECTION.yml [overdue: 8d]",
  )
}

pipeline test_a_sweep_is_named_on_the_status_line(task: any) {
  assert_eq(
    projection_status_line(
      {
        slug: SLUG,
        status: "applied",
        drifted: [PATH],
        sweep: {
          superseded: [
            {
              pull_request: 59,
              branch: "automation/fleet-projections-old",
              url: "https://github.test/octo-org/octo-repo/pull/59",
              state: "closed",
            },
          ],
        },
      },
    ),
    "applied octo-org/octo-repo: PROJECTION.yml [superseded: #59 closed]",
  )
}
