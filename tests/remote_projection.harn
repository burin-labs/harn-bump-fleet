import { FleetProjectionTarget } from "../lib/fleet_projection_targets"
import {
  REMOTE_PROJECTION_BRANCH_PREFIX,
  converge_remote_repository,
  remote_convergence_failed,
  remote_projection_branch,
} from "../lib/remote_projection"
import { GithubClientOptions } from "harn-github-connector/default"

/**
 * The remote convergence loop, exercised through the real connector dispatch
 * path against mocked endpoints.
 *
 * Every claim this makes is about a write to somebody else's repository, so the
 * evidence has to be which requests were issued, not only what was returned. A
 * dry run that quietly opened a pull request and a repeat run that quietly
 * pushed a duplicate commit would both still report the right status.
 */
const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

const PATH = "PROJECTION.yml"

const BASE_OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const BRANCH_OID = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const COMMIT_OID = "cccccccccccccccccccccccccccccccccccccccc"

const RACE_OID = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"

const EXPECTED = "name: projection\n"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "convergence-test-token"}
}

fn targets() -> list<FleetProjectionTarget> {
  return [{slug: SLUG, path: PATH, expected: EXPECTED, origin: "fleet.toml test projection"}]
}

fn branch() -> string {
  return remote_projection_branch(targets())
}

fn file_url(ref: string) -> string {
  return BASE + "/repos/octo-org/octo-repo/contents/" + PATH + "?ref=" + replace(ref, "/", "%2F")
}

fn file_body(text: string) -> string {
  return json_stringify(
    {
      name: PATH,
      path: PATH,
      sha: "dddddddddddddddddddddddddddddddddddddddd",
      size: len(text),
      type: "file",
      encoding: "base64",
      content: base64_encode(text),
    },
  )
}

fn mock_file(testing: HarnessTesting, ref: string, text: string) {
  testing.http_mock("GET", file_url(ref), {status: 200, body: file_body(text)})
}

fn mock_branch_head(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/" + branch(),
    {status: 200, body: json_stringify({name: branch()})},
  )
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main",
    {status: 200, body: json_stringify({name: "main", commit: {sha: BASE_OID}})},
  )
}

fn refs_url() -> string {
  return BASE + "/repos/octo-org/octo-repo/git/refs"
}

fn methods_called(testing: HarnessTesting) -> list<string> {
  return testing.http_mock_calls().map(
    { call -> to_string(call?.method ?? "") + " " + to_string(call?.url ?? "") },
  )
    .to_list()
}

fn wrote_anything(testing: HarnessTesting) -> bool {
  for call in methods_called(testing) {
    if !starts_with(call, "GET ") {
      return true
    }
  }
  return false
}

pipeline test_each_exact_projection_has_one_stable_fresh_branch(task) {
  const first = remote_projection_branch(targets())
  const repeated = remote_projection_branch(targets())
  const changed = remote_projection_branch(
    [{slug: SLUG, path: PATH, expected: "name: next\n", origin: "fleet.toml test projection"}],
  )
  const pair = targets()
    + [
    {slug: SLUG, path: "SECOND.yml", expected: "name: second\n", origin: "second source"},
  ]
  assert_eq(first, repeated, "repeat convergence must reuse one identity branch")
  assert(starts_with(first, REMOTE_PROJECTION_BRANCH_PREFIX + "-"))
  assert(first != changed, "new rendered bytes must start from a fresh branch")
  assert_eq(
    remote_projection_branch(pair),
    remote_projection_branch(pair.reverse().to_list()),
    "manifest ordering must not change the projection identity",
  )
}

pipeline test_matching_bytes_need_no_proposal(harness: Harness, task) {
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", EXPECTED)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "clean")
  assert_eq(result.drifted, [])
  assert_eq(wrote_anything(harness.testing), false)
}

pipeline test_a_dry_run_reports_drift_and_writes_nothing(harness: Harness, task) {
  // The safety property of the default mode. A status of `drift` proves only
  // that the run noticed; the request log is what proves it stayed read-only.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    false,
    false,
    options(),
  )
  assert_eq(result.status, "drift")
  assert_eq(result.drifted, [PATH])
  assert_eq(wrote_anything(harness.testing), false)
}

pipeline test_partial_projection_refuses_changed_repository_bytes(harness: Harness, task) {
  harness.testing.http_mock_clear()
  const stale = "name: stale\n"
  mock_file(harness.testing, "main", stale)
  mock_file(harness.testing, branch(), "name: changed while converging\n")
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {
      status: 201,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BASE_OID, type: "commit"}},
      ),
    },
  )
  const derived = targets().map({ target -> target + {derived_from_sha256: sha256(stale)} })
    .to_list()
  const result = converge_remote_repository(harness, SLUG, "main", derived, true, false, options())
  assert_eq(result.status, "error")
  assert(contains(result.error ?? "", "changed after its pin projection was derived"))
  assert(
    !contains(methods_called(harness.testing), "POST " + BASE + "/graphql"),
    "changed repository-owned bytes must never be committed",
  )
}

pipeline test_applying_proposes_the_projection_on_a_branch(harness: Harness, task) {
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {
      status: 201,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BASE_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: COMMIT_OID,
                url: "https://github.com/octo-org/octo-repo/commit/" + COMMIT_OID,
                signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
              },
              ref: {name: branch(), target: {oid: COMMIT_OID}},
            },
          },
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main&per_page=2",
    {status: 200, body: "[]"},
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/pulls",
    {
      status: 201,
      body: json_stringify(
        {
          number: 77,
          title: "chore: restore fleet-owned projections",
          body: "body",
          state: "open",
          html_url: "https://github.com/octo-org/octo-repo/pull/77",
          base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
          head: {
            ref: branch(),
            sha: COMMIT_OID,
            repo: {full_name: SLUG, owner: {login: "octo-org"}},
          },
        },
      ),
    },
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "applied")
  assert_eq(result.drifted, [PATH])
  assert_eq(result.branch, branch())
  assert_eq(result.commit, COMMIT_OID)
  assert_eq(result.pull_request, 77)
  assert_eq(contains(methods_called(harness.testing), "POST " + BASE + "/graphql"), true)
}

pipeline test_a_concurrent_projection_commit_is_reconciled_once(harness: Harness, task) {
  // Two fleet runs can publish the same generated bytes at once. The first
  // run must adopt the winner's fresh head without adding a duplicate commit;
  // treating that expected race as terminal strands every later repository.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {
      responses: [
        {
          status: 201,
          body: json_stringify(
            {ref: "refs/heads/" + branch(), object: {sha: BASE_OID, type: "commit"}},
          ),
        },
        {status: 422, body: json_stringify({message: "Reference already exists"})},
      ],
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: COMMIT_OID,
                url: "https://github.com/octo-org/octo-repo/commit/" + COMMIT_OID,
                signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
              },
              ref: {name: branch(), target: {oid: COMMIT_OID}},
            },
          },
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main&per_page=2",
    {
      status: 200,
      body: json_stringify(
        [
          {
            number: 77,
            title: "chore: restore fleet-owned projections",
            state: "open",
            html_url: "https://github.com/octo-org/octo-repo/pull/77",
            base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
            head: {
              ref: branch(),
              sha: RACE_OID,
              repo: {full_name: SLUG, owner: {login: "octo-org"}},
            },
          },
        ],
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: RACE_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + RACE_OID,
    {status: 200, body: json_stringify({sha: RACE_OID, message: "chore: restore\n"})},
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "pending")
  assert_eq(result.commit, RACE_OID)
  assert_eq(result.auto_merge?.state, "held")
  const graphql_calls = methods_called(harness.testing).filter(
    { call -> call == "POST " + BASE + "/graphql" },
  )
    .to_list()
  assert_eq(len(graphql_calls), 1, "the retry must not publish a second commit")
}

pipeline test_an_open_proposal_is_not_proposed_again(harness: Harness, task) {
  // Idempotence is the whole difference between a convergence loop and a
  // nightly stream of duplicate commits: the branch already says what this run
  // would say, so the run must stop before the commit.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BRANCH_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BRANCH_OID,
    {status: 200, body: json_stringify({sha: BRANCH_OID, message: "chore: restore\n"})},
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "pending")
  assert_eq(result.branch, branch())
  assert_eq(contains(methods_called(harness.testing), "POST " + BASE + "/graphql"), false)
}

pipeline test_one_repository_failing_does_not_raise(harness: Harness, task) {
  // Twenty-six repositories share a run. A provider failure has to end this
  // repository and report itself, not abort the fleet.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main",
    {status: 500, body: json_stringify({message: "server error"})},
  )
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "error")
  assert_eq(result.slug, SLUG)
  assert_eq(contains(result.error ?? "", "branch head lookup failed"), true)
}

// -------------------------------------------------------------------------------------------------

// Arming
//
// The loop proposes and then asks GitHub to merge the proposal once the target
// repository's own required checks pass. Every claim below is about which
// request was issued and with which lease, because a receipt saying `armed` is
// exactly what a run that armed the wrong commit would also print.
//
// One mock per method-and-URL replaces the previous one rather than queueing,
// so the single `POST /graphql` mock answers both the commit mutation and the
// arming mutation. Each mutation reads only its own key out of `data`, and the
// request bodies below are what actually separate them.

// -------------------------------------------------------------------------------------------------

const AUTO_MERGE_PR = 77

fn graphql_request_containing(testing: HarnessTesting, needle: string) -> dict? {
  for call in testing.http_mock_calls() {
    if to_string(call?.method ?? "") == "POST" && to_string(call?.url ?? "") == BASE + "/graphql"
      && contains(
      to_string(call?.body ?? ""),
      needle,
    ) {
      return call
    }
  }
  return nil
}

fn mock_commit_and_arm_graphql(testing: HarnessTesting) {
  testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: COMMIT_OID,
                url: "https://github.com/octo-org/octo-repo/commit/" + COMMIT_OID,
                signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
              },
              ref: {name: branch(), target: {oid: COMMIT_OID}},
            },
            enablePullRequestAutoMerge: {
              actor: {login: "harn-fleet"},
              pullRequest: {
                number: AUTO_MERGE_PR,
                url: "https://github.com/octo-org/octo-repo/pull/77",
                mergeStateStatus: "BLOCKED",
                autoMergeRequest: {enabledAt: "2026-08-04T18:00:00Z", mergeMethod: "SQUASH"},
              },
            },
          },
        },
      ),
    },
  )
}

fn mock_pull_for_arming(testing: HarnessTesting, head_oid: string) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/pulls/" + to_string(AUTO_MERGE_PR),
    {
      status: 200,
      body: json_stringify(
        {
          number: AUTO_MERGE_PR,
          node_id: "PR_node_77",
          state: "open",
          html_url: "https://github.com/octo-org/octo-repo/pull/77",
          auto_merge: nil,
          base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
          head: {ref: branch(), sha: head_oid, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
        },
      ),
    },
  )
}

fn mock_created_pull(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main&per_page=2",
    {status: 200, body: "[]"},
  )
  testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/pulls",
    {
      status: 201,
      body: json_stringify(
        {
          number: AUTO_MERGE_PR,
          title: "chore: restore fleet-owned projections",
          body: "body",
          state: "open",
          html_url: "https://github.com/octo-org/octo-repo/pull/77",
          base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
          head: {
            ref: branch(),
            sha: COMMIT_OID,
            repo: {full_name: SLUG, owner: {login: "octo-org"}},
          },
        },
      ),
    },
  )
}

fn mock_fresh_proposal(testing: HarnessTesting) {
  testing.http_mock_clear()
  mock_file(testing, "main", "name: stale\n")
  mock_branch_head(testing)
  testing.http_mock(
    "POST",
    refs_url(),
    {
      status: 201,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BASE_OID, type: "commit"}},
      ),
    },
  )
  mock_commit_and_arm_graphql(testing)
  mock_created_pull(testing)
}

pipeline test_arming_leases_the_commit_this_run_published(harness: Harness, task) {
  // The lease is the safety property. Arming against the branch name, or
  // against the base it forked from, would let a commit appended between the
  // publication and this call ride in on the fleet's authority.
  mock_fresh_proposal(harness.testing)
  mock_pull_for_arming(harness.testing, COMMIT_OID)
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "applied")
  assert_eq(result.auto_merge?.state, "armed")
  assert_eq(result.auto_merge?.method, "SQUASH")
  const mutation = graphql_request_containing(harness.testing, "EnableAutoMerge")
  assert(mutation != nil, "an auto-merge mutation was issued")
  const variables = json_parse(to_string(mutation?.body ?? "")).get("variables")
  assert_eq(variables.get("expectedHeadOid"), COMMIT_OID)
  assert_eq(variables.get("pullRequestId"), "PR_node_77")
}

pipeline test_a_stale_branch_head_is_refused_rather_than_armed(harness: Harness, task) {
  // The falsifier for the test above: if the lease were decorative, a pull
  // request whose head moved after publication would still be armed.
  mock_fresh_proposal(harness.testing)
  mock_pull_for_arming(harness.testing, BRANCH_OID)
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "applied")
  assert_eq(result.auto_merge?.state, "refused")
  assert_eq(graphql_request_containing(harness.testing, "EnableAutoMerge"), nil)
}

pipeline test_holding_arming_still_proposes(harness: Harness, task) {
  // `--no-auto-merge` has to leave the repair and remove only the arming.
  mock_fresh_proposal(harness.testing)
  mock_pull_for_arming(harness.testing, COMMIT_OID)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets(),
    true,
    false,
    options(),
  )
  assert_eq(result.status, "applied")
  assert_eq(result.pull_request, AUTO_MERGE_PR)
  assert_eq(result.auto_merge?.state, "held")
  assert_eq(graphql_request_containing(harness.testing, "EnableAutoMerge"), nil)
}

pipeline test_a_refused_arming_does_not_fail_the_repository(harness: Harness, task) {
  // A repository with auto-merge switched off, or a gate the App may not
  // satisfy, leaves a proposal a human can still merge — which is the behavior
  // this loop had before arming existed. It must be reported, and it must not
  // turn a successful repair into a failed run.
  mock_fresh_proposal(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/pulls/" + to_string(AUTO_MERGE_PR),
    {status: 403, body: json_stringify({message: "Resource not accessible by integration"})},
  )
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "applied")
  assert_eq(result.auto_merge?.state, "refused")
  assert_eq(remote_convergence_failed(result), false)
  assert(trim(result.auto_merge?.error ?? "") != "", "a refusal names why")
}

pipeline test_an_already_proposed_repair_is_armed_without_a_second_commit(harness: Harness, task) {
  // The recovery path. A run that published a commit but could not arm it must
  // arm on the next run, or one transient refusal parks that repository
  // forever — the pile-up this loop exists to prevent, one repository at a
  // time. It must do that without publishing the duplicate commit that
  // idempotence forbids.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BRANCH_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BRANCH_OID,
    {status: 200, body: json_stringify({sha: BRANCH_OID, message: "chore: restore\n"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main",
    {
      status: 200,
      body: json_stringify(
        [
          {
            number: AUTO_MERGE_PR,
            title: "chore: restore fleet-owned projections",
            state: "open",
            html_url: "https://github.com/octo-org/octo-repo/pull/77",
            base: {ref: "main", sha: BASE_OID, repo: {full_name: SLUG, owner: {login: "octo-org"}}},
            head: {
              ref: branch(),
              sha: BRANCH_OID,
              repo: {full_name: SLUG, owner: {login: "octo-org"}},
            },
          },
        ],
      ),
    },
  )
  mock_commit_and_arm_graphql(harness.testing)
  mock_pull_for_arming(harness.testing, BRANCH_OID)
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "pending")
  assert_eq(result.pull_request, AUTO_MERGE_PR)
  assert_eq(result.auto_merge?.state, "armed")
  assert_eq(graphql_request_containing(harness.testing, "CreateCommitOnBranch"), nil)
  const mutation = graphql_request_containing(harness.testing, "EnableAutoMerge")
  assert(mutation != nil, "the standing proposal was armed")
  assert_eq(
    json_parse(to_string(mutation?.body ?? "")).get("variables").get("expectedHeadOid"),
    BRANCH_OID,
  )
}

pipeline test_a_closed_proposal_is_not_reopened_by_a_cron_job(harness: Harness, task) {
  // Closing the pull request is how a person says no. The drift is still
  // reported, but a nightly run must not overrule that decision.
  harness.testing.http_mock_clear()
  mock_file(harness.testing, "main", "name: stale\n")
  mock_file(harness.testing, branch(), EXPECTED)
  mock_branch_head(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/" + branch(),
    {
      status: 200,
      body: json_stringify(
        {ref: "refs/heads/" + branch(), object: {sha: BRANCH_OID, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BRANCH_OID,
    {status: 200, body: json_stringify({sha: BRANCH_OID, message: "chore: restore\n"})},
  )
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/pulls?state=open&head="
      + url_encode("octo-org:" + branch())
      + "&base=main",
    {status: 200, body: "[]"},
  )
  const result = converge_remote_repository(harness, SLUG, "main", targets(), true, true, options())
  assert_eq(result.status, "pending")
  assert_eq(result.pull_request, nil)
  assert_eq(result.auto_merge, nil)
  for call in methods_called(harness.testing) {
    assert_eq(starts_with(call, "POST " + BASE + "/repos/octo-org/octo-repo/pulls"), false)
  }
}
