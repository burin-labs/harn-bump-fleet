import { record_release_landing } from "../lib/release_merge_lease"
import {
  release_watch_receipt,
  release_watch_receipt_bind_main_commit,
  release_watch_receipt_read,
  release_watch_receipt_write,
} from "../lib/release_watch_state"

fn git(process: HarnessProcess, repo: string, args: list<string>) -> string {
  const result = process.run({program: "git", args: ["-C", repo] + args})
  assert(result.success, result.stderr)
  return trim(result.stdout)
}

pipeline test_recovery_cli_accepts_certified_untagged_receipt_without_binding_it(harness: Harness) {
  const root = path_join(harness.fs.temp_dir(), "recovery-identity-" + harness.random.uuid_v7())
  harness.fs.mkdir(root)
  git(harness.process, root, ["init", "-q", "-b", "main"])
  git(
    harness.process,
    root,
    [
      "-c",
      "user.name=Fixture",
      "-c",
      "user.email=fixture@example.com",
      "-c",
      "commit.gpgsign=false",
      "commit",
      "--allow-empty",
      "-qm",
      "fixture",
    ],
  )
  git(harness.process, root, ["remote", "add", "origin", root])
  const oid = git(harness.process, root, ["rev-parse", "HEAD"])
  const tree = git(harness.process, root, ["rev-parse", "HEAD^{tree}"])
  const now = "2026-09-12T00:00:00Z"
  const receipt = record_release_landing(
    release_watch_receipt(
      {
        tag: "v1.2.3",
        slug: "burin-labs/harn",
        pin_sha: oid,
        publication: {
          version: "1.2.3",
          local_branch: "release/v1.2.3",
          remote_ref: "release-attempt/v1.2.3/${oid}",
          head_oid: oid,
        },
        pr_url: "https://github.com/burin-labs/harn/pull/1",
        merge_lease_generation: "fixture",
        merge_lease_method: "squash",
        created_at: now,
      },
    ),
    {
      schema_version: "harn_bump_fleet.release_landing.v1",
      tag_oid: oid,
      release_pr: 1,
      merge_method: "squash",
      merge_commit_oid: oid,
      merged_tree_oid: tree,
      candidate_tree_oid: tree,
    },
    now,
  )
  const receipt_path = path_join(root, "receipt.json")
  const binary = path_join(harness.env.get("PWD") ?? "", ".harn/bin/harn")
  const script = path_join(harness.env.get("PWD") ?? "", "verify_release_recovery_identity.harn")
  for case in [
    {name: "untagged", published: "", requested: oid, tag: "v1.2.3", accepted: true},
    {name: "published", published: oid, requested: oid, tag: "v1.2.3", accepted: true},
    {
      name: "wrong candidate",
      published: "",
      requested: "1111111111111111111111111111111111111111",
      tag: "v1.2.3",
      accepted: false,
    },
    {
      name: "wrong binding",
      published: "1111111111111111111111111111111111111111",
      requested: oid,
      tag: "v1.2.3",
      accepted: false,
    },
    {name: "wrong tag", published: "", requested: oid, tag: "v1.2.4", accepted: false},
  ] {
    const input = if case.published == "" {
      receipt
    } else {
      release_watch_receipt_bind_main_commit(receipt, case.published, now)
    }
    release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, input)
    const result = harness.process.run(
      {
        program: binary,
        args: [
          "run",
          "--write-root",
          root,
          script,
          "--",
          "--repo",
          root,
          "--tag",
          case.tag,
          "--tagged-oid",
          case.requested,
          "--receipt",
          receipt_path,
        ],
      },
    )
    assert_eq(result.success, case.accepted, case.name + ": " + result.stderr)
    if case.accepted {
      assert(contains(result.stdout, "\"valid\": true"), result.stdout)
    } else {
      assert(contains(result.stderr, "certified tag identity"), result.stderr)
    }
    assert_eq(
      release_watch_receipt_read(harness.fs, receipt_path)?.release_commit_oid,
      case.published,
    )
  }
}
