import { ReleasePublication } from "../lib/release_publication"
import { ensure_release_tag_pushed } from "../lib/release_tag"

pipeline test_github_unknown_local_signer_blocks_tag_push(harness: Harness, task) {
  const publication: ReleasePublication = {
    version: "0.7.53",
    local_branch: "release/v0.7.53",
    remote_ref: "release-attempt/v0.7.53/9999999999999999999999999999999999999999",
    head_oid: "9999999999999999999999999999999999999999",
  }
  const steps = ensure_release_tag_pushed(
    harness,
    {mock: true, mock_unknown_github_signing_key: true, repo: "/mock/harn"},
    "0.7.53",
    publication,
    [],
    "unknown-signer-test",
  )
  const trust = steps.filter({ step -> step.name == "verify-release-tag-github-trust" }).to_list()
  assert_eq(len(trust), 1)
  assert_eq(trust[0].success, false)
  assert(contains(trust[0].stderr, "not registered as a GitHub signing key"))
  assert(
    steps.any({ step -> step.name == "inspect-release-tag-signing-config" }),
    "failure records the exact config scopes selecting each candidate key",
  )
  assert_eq(
    steps.any({ step -> step.name == "push-release-tag" }),
    false,
    "an unknown signing key must stop before the release-build trigger",
  )
}

pipeline test_github_registered_local_signer_reaches_tag_push(harness: Harness, task) {
  const publication: ReleasePublication = {
    version: "0.7.53",
    local_branch: "release/v0.7.53",
    remote_ref: "release-attempt/v0.7.53/9999999999999999999999999999999999999999",
    head_oid: "9999999999999999999999999999999999999999",
  }
  const steps = ensure_release_tag_pushed(
    harness,
    {mock: true, repo: "/mock/harn"},
    "0.7.53",
    publication,
    [],
    "registered-signer-test",
  )
  const trust = steps.filter({ step -> step.name == "verify-release-tag-github-trust" }).to_list()
  assert_eq(len(trust), 1)
  assert_eq(trust[0].success, true)
  assert(
    steps.any({ step -> step.name == "push-release-tag" && step.success }),
    "a registered exact signer preserves the canonical tag push",
  )
}

pipeline test_hosted_app_signer_records_harn_trust_root_exception(harness: Harness, task) {
  const publication: ReleasePublication = {
    version: "0.7.53",
    local_branch: "release/v0.7.53",
    remote_ref: "release-attempt/v0.7.53/9999999999999999999999999999999999999999",
    head_oid: "9999999999999999999999999999999999999999",
  }
  const steps = ensure_release_tag_pushed(
    harness,
    {mock: true, github_signed_commit: true, repo: "/mock/harn"},
    "0.7.53",
    publication,
    [],
    "hosted-signer-test",
  )
  assert(
    steps.any(
      { step ->
        step.name == "verify-release-tag-github-trust-skipped" && step.success
          && contains(step.stdout, "Harn-owned allowed-signers policy")
      },
    ),
    "the hosted exception must remain explicit evidence rather than a silent bypass",
  )
  assert(steps.any({ step -> step.name == "push-release-tag" && step.success }))
}
