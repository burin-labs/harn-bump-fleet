import {
  release_body_source_unavailable_reason,
  release_repo_path_error,
  release_repo_path_guard_error,
  require_release_repo_path,
} from "../lib/release_repo_guard"

pipeline test_release_repo_guard_messages(task) {
  const missing = release_repo_path_error(
    {repo: "/tmp/harn-release-missing", exists: false, git_marker_exists: false},
    "agent tool setup",
  )
    ?? ""
  assert(contains(missing, "--repo path is missing before agent tool setup"))
  assert(contains(missing, "/tmp/harn-release-missing"))
  assert(contains(missing, "Rerun with --repo PATH"))
  assert(contains(missing, "agent tools would run without the target checkout"))
  const not_git = release_repo_path_error(
    {repo: "/tmp/harn-release-not-git", exists: true, git_marker_exists: false},
    "pin resolution",
  )
    ?? ""
  assert(contains(not_git, "not a git checkout before pin resolution"))
  assert(contains(not_git, "/tmp/harn-release-not-git/.git"))
  assert_eq(
    release_repo_path_error(
      {repo: "/tmp/harn-release-ok", exists: true, git_marker_exists: true},
      "analysis",
    ),
    nil,
  )
}

pipeline test_release_repo_guard_uses_filesystem_state(harness: Harness, task) {
  const missing = path_join(
    harness.fs.temp_dir(),
    "harn-release-missing-" + harness.random.uuid_v7(),
  )
  const caught = try {
    require_release_repo_path(harness.fs, {repo: missing, mock: false}, "agent tool setup")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(caught, "before agent tool setup"))
  assert(contains(caught, missing))
  const root = path_join(harness.fs.temp_dir(), "harn-release-guard-" + harness.random.uuid_v7())
  harness.fs.mkdir(root, true)
  harness.fs.write_text(path_join(root, ".git"), "gitdir: .git\n")
  assert_eq(release_repo_path_guard_error(harness.fs, {repo: root, mock: false}, "startup"), nil)
  assert_eq(release_repo_path_guard_error(harness.fs, {repo: missing, mock: true}, "startup"), nil)
}

@serial(group: "release-repo-guard-fs")
pipeline test_a_shallow_checkout_names_itself_in_the_body_gate_reason(harness: Harness, task) {
  // The failure this replaces was a blocking gate that said only "could not be
  // derived": `git merge-base` against a shallow boundary commit exits non-zero
  // with an empty stderr, so nothing downstream had the cause to report.
  const root = path_join(harness.fs.temp_dir(), "harn-shallow-" + harness.random.uuid_v7())
  harness.fs.mkdir(path_join(root, ".git"), true)
  const complete = release_body_source_unavailable_reason(harness.fs, root)
  assert_eq(complete, "the immutable pin-time release notes could not be derived")
  assert(!contains(complete, "shallow"))
  harness.fs.write_text(
    path_join(root, ".git/shallow"),
    "0000000000000000000000000000000000000000\n",
  )
  const shallow = release_body_source_unavailable_reason(harness.fs, root)
  assert(contains(shallow, "this checkout is shallow"))
  assert(contains(shallow, "git fetch --unshallow origin"))
  assert(contains(shallow, root))
  // An unset repo must not claim a diagnosis it never made.
  assert_eq(
    release_body_source_unavailable_reason(harness.fs, ""),
    "the immutable pin-time release notes could not be derived",
  )
}
