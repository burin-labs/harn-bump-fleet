import { parse_args } from "std/cli"
import {
  prompt_asset,
  release_cli_help_requested,
  release_harness_root,
  release_run_root,
} from "../release_harn.harn"

const HELP_ARG_SPEC = [{kind: "flag", name: "help", flags: ["--help", "-h"]}]

pipeline test_release_cli_help_uses_std_cli_help_marker(task) {
  const parsed = parse_args(["--help"], HELP_ARG_SPEC)
  assert_eq(parsed._help, true)
  assert_eq(parsed.help, false)
  assert_eq(release_cli_help_requested(parsed), true)
  assert_eq(release_cli_help_requested(parse_args([], HELP_ARG_SPEC)), false)
}

pipeline test_release_harness_paths_anchor_to_checkout(task) {
  const root = release_harness_root()
  assert_eq(harness.fs.exists(path_join(root, "release_harn.harn")), true)
  assert_eq(
    prompt_asset("release_report.harn.prompt"),
    path_join(root, "prompts", "release_report.harn.prompt"),
  )
  assert_eq(release_run_root(), path_join(root, ".harn-runs/release-harn"))
}
