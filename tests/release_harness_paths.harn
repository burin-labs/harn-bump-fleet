import { release_timed_phase } from "../lib/release_runtime"
import { prompt_asset, release_harness_root, release_run_root } from "../release_harn.harn"

pipeline test_release_harness_paths_anchor_to_checkout(task) {
  const root = release_harness_root()
  assert_eq(harness.fs.exists(path_join(root, "release_harn.harn")), true)
  assert_eq(
    prompt_asset("release_report.harn.prompt"),
    path_join(root, "prompts", "release_report.harn.prompt"),
  )
  assert_eq(release_run_root(), path_join(root, ".harn-runs/release-harn"))
}

pipeline test_release_fixup_prompts_describe_immutable_recovery(task) {
  const prompts = [
    harness.fs.read_text(prompt_asset("release_fixup_system.harn.prompt")),
    harness.fs.read_text(prompt_asset("release_fixup_user.harn.prompt")),
  ]
  for prompt in prompts {
    assert_eq(contains(prompt, "origin/release/v"), false)
    assert_eq(contains(prompt, "Force-pushed"), false)
    assert_eq(contains(lowercase(prompt), "immutable"), true)
  }
  assert_eq(
    contains(prompts[0] ?? "", "after tag publication but before it created the Release PR"),
    true,
  )
  assert_eq(contains(prompts[1] ?? "", "{{ recovery_oid }}..origin/{{ base_branch }}"), true)
  assert_eq(contains(prompts[1] ?? "", "{{ fixup_tag }}..origin/{{ base_branch }}"), false)
}

pipeline test_release_fixup_system_prompt_renders_one_recovery_source(task) {
  const prompt = prompt_asset("release_fixup_system.harn.prompt")
  const from_pr = render(
    prompt,
    {
      target_version: "1.2.3",
      fixup_pr_url: "https://github.com/example/harn/pull/42",
      fixup_tag: "v1.2.3",
      base_branch: "main",
    },
  )
  assert(contains(from_pr, "open Release PR `https://github.com/example/harn/pull/42`"))
  assert_eq(contains(from_pr, "durable recovery source is tag"), false)
  const from_tag = render(
    prompt,
    {target_version: "1.2.3", fixup_pr_url: "", fixup_tag: "v1.2.3", base_branch: "main"},
  )
  assert(contains(from_tag, "durable recovery source is tag `v1.2.3`"))
  assert_eq(contains(from_tag, "open Release PR"), false)
}

pipeline test_prompt_assets_use_harn_control_syntax(task) {
  const prompts_dir = path_join(release_harness_root(), "prompts")
  for name in harness.fs.list_dir(prompts_dir).sort() {
    if ends_with(name, ".harn.prompt") {
      assert_eq(contains(harness.fs.read_text(path_join(prompts_dir, name)), "{%"), false)
    }
  }
}

pipeline test_release_pr_body_renders_local_branch_conditionally(task) {
  const prompt = prompt_asset("release_pr_body.harn.prompt")
  const base = {
    next_version: "1.2.3",
    current_version: "1.2.2",
    branch: "release-attempt/v1.2.3/head",
    base_branch: "main",
    pin_sha: "abc123",
    pin_sha_note: "",
    tag_publish_note: "already published",
    run_session_view_fixture_status: "passed",
    run_session_view_summary: "fixtures stable",
    run_session_view_release_note: "no contract-file change detected",
    execution_step_count: 0,
    execution_status_summary: "all ok",
    execution_summary: "none",
    latest_tag: "v1.2.2",
    commits_since_latest_tag: "abc123 release",
    run_id: "test-run",
  }
  const with_branch = render(prompt, {...base, local_branch: "release/v1.2.3"})
  assert(contains(with_branch, "Local preparation branch:** `release/v1.2.3`"))
  assert_eq(contains(with_branch, "{%"), false)
  const without_branch = render(prompt, {...base, local_branch: ""})
  assert_eq(contains(without_branch, "Local preparation branch"), false)
  assert_eq(contains(without_branch, "{%"), false)
}

fn read_run_events(run_id) {
  const path = path_join(release_run_root(), run_id, "run-events.jsonl")
  return harness.fs.read_text(path)
    .split("\n")
    .filter({ line -> trim(line) != "" })
    .map({ line -> json_parse(line) })
    .to_list()
}

pipeline test_release_timed_phase_emits_start_and_finish_events(task) {
  const run_id = "test-phase-" + uuid_v7()
  const result = release_timed_phase(
    harness,
    run_id,
    "analysis",
    "release.analysis",
    {mode: "audit", mock: true},
    { -> return "done" },
  )
  assert_eq(result, "done")
  const events = read_run_events(run_id)
  assert_eq(events.map({ event -> event.event_type }), ["phase_started", "phase_finished"])
  assert_eq(events[0].data.phase, "analysis")
  assert_eq(events[0].data.timing, "release.analysis")
  assert_eq(events[1].data.status, "ok")
}

pipeline test_release_timed_phase_logs_error_before_rethrow(task) {
  const run_id = "test-phase-error-" + uuid_v7()
  try {
    release_timed_phase(
      harness,
      run_id,
      "analysis",
      "release.analysis",
      {mode: "audit", mock: true},
      { ->
        throw "boom"
      },
    )
    throw "expected release_timed_phase to rethrow"
  } catch (e) {
    assert_eq(to_string(e), "boom")
  }
  const events = read_run_events(run_id)
  assert_eq(events.map({ event -> event.event_type }), ["phase_started", "phase_finished"])
  assert_eq(events[1].data.status, "error")
  assert_eq(events[1].data.error, "boom")
}
