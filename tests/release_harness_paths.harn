}

// Collapsing identity material to the runner's secret scratch is what makes the
// grant survive a writer that replaces the file instead of truncating it. These
// run the resolver directly, because the property under test is which roots
// come out, not which lines the script contains.
@test
pipeline test_identity_roots_collapse_runner_temp_and_dedupe(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_identity_roots.sh")
  const temp = "/runner/work/_temp"
  const result = harness.process.run(
    {
      program: "bash",
      args: [
        "-c",
        "RUNNER_TEMP=${shell_quote(temp)} ${shell_quote(script)}"
          + " ${shell_quote(path_join(temp, "release-signing-key"))}"
          + " ${shell_quote(path_join(temp, "git-credentials"))}",
      ],
    },
  )
  assert_eq(result.exit_code, 0)
  // Two files, one directory: a rename-based writer cannot invalidate this.
  assert_eq(split(trim(result.stdout ?? ""), "\n"), [temp])
}

@test
pipeline test_identity_roots_keep_operator_material_file_scoped(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_identity_roots.sh")
  const key = "/home/operator/.ssh/id_ed25519"
  const store = "/home/operator/.config/git-credentials"
  const result = harness.process.run(
    {
      program: "bash",
      args: ["-c", "RUNNER_TEMP= ${shell_quote(script)} ${shell_quote(key)} ${shell_quote(store)}"],
    },
  )
  assert_eq(result.exit_code, 0)
  // A home directory is not a secret scratch, so it must never be collapsed.
  assert_eq(split(trim(result.stdout ?? ""), "\n"), [key, store])
}

@test
pipeline test_identity_roots_collapse_only_the_runner_temp_entry(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_identity_roots.sh")
  const temp = "/runner/work/_temp"
  const operator_key = "/home/operator/.ssh/id_ed25519"
  const result = harness.process.run(
    {
      program: "bash",
      args: [
        "-c",
        "RUNNER_TEMP=${shell_quote(temp)} ${shell_quote(script)}"
          + " ${shell_quote(path_join(temp, "release-signing-key"))}"
          + " ${shell_quote(operator_key)}",
      ],
    },
  )
  assert_eq(result.exit_code, 0)
  assert_eq(split(trim(result.stdout ?? ""), "\n"), [temp, operator_key])
}
