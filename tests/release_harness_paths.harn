}

pipeline test_release_pr_body_renders_local_branch_conditionally(harness: Harness, task: any) {
  const prompt = prompt_asset(harness.fs, "release_pr_body.harn.prompt")
  const base = {
    next_version: "1.2.3",
    current_version: "1.2.2",
    branch: "release-attempt/v1.2.3/head",
    base_branch: "main",
    pin_sha: "abc123",
    pin_sha_note: "",
    tag_publish_note: "already published",
    run_session_view_fixture_status: "passed",
    run_session_view_summary: "fixtures stable",
    run_session_view_release_note: "no contract-file change detected",
    execution_step_count: 0,
    execution_status_summary: "all ok",
    execution_summary: "none",
    latest_tag: "v1.2.2",
    commits_since_latest_tag: "abc123 release",
    run_id: "test-run",
  }
  const with_branch = harness.fs.render_prompt(prompt, {...base, local_branch: "release/v1.2.3"})
  assert(contains(with_branch, "Local preparation branch:** `release/v1.2.3`"))
  assert_eq(contains(with_branch, "{%"), false)
  const without_branch = harness.fs.render_prompt(prompt, {...base, local_branch: ""})
  assert_eq(contains(without_branch, "Local preparation branch"), false)
  assert_eq(contains(without_branch, "{%"), false)
}

fn read_run_events(fs: HarnessFs, run_id: any) {
  const path = path_join(release_run_root(fs), run_id, "run-events.jsonl")
  return fs.read_text(path).split("\n").filter({ line -> trim(line) != "" }).map(
    { line -> json_parse(line) },
  )
    .to_list()
}

pipeline test_release_timed_phase_emits_start_and_finish_events(harness: Harness, task: any) {
  const run_id = "test-phase-" + harness.random.uuid_v7()
  const result = release_timed_phase(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "analysis",
    "release.analysis",
    {mode: "audit", mock: true},
    { -> return "done" },
  )
  assert_eq(result, "done")
  const events = read_run_events(harness.fs, run_id)
  assert_eq(events.map({ event -> event.event_type }), ["phase_started", "phase_finished"])
  assert_eq(events[0].data.phase, "analysis")
  assert_eq(events[0].data.timing, "release.analysis")
  assert_eq(events[1].data.status, "ok")
}

pipeline test_release_timed_phase_logs_error_before_rethrow(harness: Harness, task: any) {
  const run_id = "test-phase-error-" + harness.random.uuid_v7()
  try {
    release_timed_phase(
      {clock: harness.clock, fs: harness.fs},
      run_id,
      "analysis",
      "release.analysis",
      {mode: "audit", mock: true},
      { ->
        throw "boom"
      },
    )
    throw "expected release_timed_phase to rethrow"
  } catch (e) {
    assert_eq(to_string(e), "boom")
  }
  const events = read_run_events(harness.fs, run_id)
  assert_eq(events.map({ event -> event.event_type }), ["phase_started", "phase_finished"])
  assert_eq(events[1].data.status, "error")
  assert_eq(events[1].data.error, "boom")
}

// The confined release must be able to read the key it will sign the tag with.
// These cases are behavioral on purpose: the defect they cover was a *silent*
// skip of an unreachable key, which every text-containment assertion in this
// file would have happily passed.
@test
pipeline test_signing_key_root_grants_a_reachable_key(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_signing_key_root.sh")
  with_temp_dir(
    harness.fs,
    { dir ->
      const key = path_join(dir, "release-signing-key")
      const cfg = path_join(dir, "gitconfig")
      harness.fs.write_text(key, "key-material-stand-in\n")
      harness.fs.write_text(cfg, "[gpg]\n\tformat = ssh\n[user]\n\tsigningkey = ${key}\n")
      const result = harness.process.run(
        {
          program: "bash",
          args: ["-c", "GIT_CONFIG_GLOBAL=${shell_quote(cfg)} ${shell_quote(script)}"],
        },
      )
      assert_eq(result.exit_code, 0)
      assert_eq(trim(result.stdout ?? ""), key)
    },
  )
}

@test
pipeline test_signing_key_root_refuses_an_unreachable_key(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_signing_key_root.sh")
  with_temp_dir(
    harness.fs,
    { dir ->
      const missing = path_join(dir, "never-written")
      const cfg = path_join(dir, "gitconfig")
      harness.fs.write_text(cfg, "[gpg]\n\tformat = ssh\n[user]\n\tsigningkey = ${missing}\n")
      const result = harness.process.run(
        {
          program: "bash",
          args: ["-c", "GIT_CONFIG_GLOBAL=${shell_quote(cfg)} ${shell_quote(script)}"],
        },
      )
      // The whole point: configured-but-unreachable must stop the run here,
      // not degrade to an empty grant that fails once the tag is created.
      assert_eq(result.exit_code, 2)
      assert_eq(trim(result.stdout ?? ""), "")
      assert(contains(result.stderr ?? "", "no such file exists"))
    },
  )
}

@test
pipeline test_signing_key_root_is_silent_when_signing_is_not_configured(
  harness: Harness,
  task: any,
) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_signing_key_root.sh")
  with_temp_dir(
    harness.fs,
    { dir ->
      const cfg = path_join(dir, "gitconfig")
      harness.fs.write_text(cfg, "[user]\n\tname = nobody\n")
      const result = harness.process.run(
        {
          program: "bash",
          args: ["-c", "GIT_CONFIG_GLOBAL=${shell_quote(cfg)} ${shell_quote(script)}"],
        },
      )
      assert_eq(result.exit_code, 0)
      assert_eq(trim(result.stdout ?? ""), "")
    },
  )
}

// The confined tag push must be able to read the credential store its helper
// is configured with. Same silent-skip class as the signing key, one step
// later: every confined git call works until the transport consults the
// helper, so an ungranted store surfaces only on the push that publishes.
@test
pipeline test_credential_store_root_grants_a_reachable_store(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_credential_store_root.sh")
  with_temp_dir(
    harness.fs,
    { dir ->
      const store = path_join(dir, "git-credentials")
      const cfg = path_join(dir, "gitconfig")
      harness.fs.write_text(store, "credential-stand-in\n")
      harness.fs.write_text(cfg, "[credential]\n\thelper = store --file=${store}\n")
      const result = harness.process.run(
        {
          program: "bash",
          args: ["-c", "GIT_CONFIG_GLOBAL=${shell_quote(cfg)} ${shell_quote(script)}"],
        },
      )
      assert_eq(result.exit_code, 0)
      assert_eq(trim(result.stdout ?? ""), store)
    },
  )
}

@test
pipeline test_credential_store_root_refuses_an_unreachable_store(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_credential_store_root.sh")
  with_temp_dir(
    harness.fs,
    { dir ->
      const missing = path_join(dir, "never-written")
      const cfg = path_join(dir, "gitconfig")
      harness.fs.write_text(cfg, "[credential]\n\thelper = store --file=${missing}\n")
      const result = harness.process.run(
        {
          program: "bash",
          args: ["-c", "GIT_CONFIG_GLOBAL=${shell_quote(cfg)} ${shell_quote(script)}"],
        },
      )
      // Configured-but-unreachable must stop the run at confinement time, not
      // degrade to a push that fails after the release commit has merged.
      assert_eq(result.exit_code, 2)
      assert_eq(trim(result.stdout ?? ""), "")
      assert(contains(result.stderr ?? "", "no such file exists"))
    },
  )
}

@test
pipeline test_credential_store_root_is_silent_without_a_file_backed_helper(
  harness: Harness,
  task: any,
) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_credential_store_root.sh")
  with_temp_dir(
    harness.fs,
    { dir ->
      const cfg = path_join(dir, "gitconfig")
      harness.fs.write_text(cfg, "[credential]\n\thelper = osxkeychain\n")
      const result = harness.process.run(
        {
          program: "bash",
          args: ["-c", "GIT_CONFIG_GLOBAL=${shell_quote(cfg)} ${shell_quote(script)}"],
        },
      )
      assert_eq(result.exit_code, 0)
      assert_eq(trim(result.stdout ?? ""), "")
    },
  )
}

// Collapsing identity material to the runner's secret scratch is what makes the
// grant survive a writer that replaces the file instead of truncating it. These
// run the resolver directly, because the property under test is which roots
// come out, not which lines the script contains.
@test
pipeline test_identity_roots_collapse_runner_temp_and_dedupe(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_identity_roots.sh")
  const temp = "/runner/work/_temp"
  const result = harness.process.run(
    {
      program: "bash",
      args: [
        "-c",
        "RUNNER_TEMP=${shell_quote(temp)} ${shell_quote(script)}"
          + " ${shell_quote(path_join(temp, "release-signing-key"))}"
          + " ${shell_quote(path_join(temp, "git-credentials"))}",
      ],
    },
  )
  assert_eq(result.exit_code, 0)
  // Two files, one directory: a rename-based writer cannot invalidate this.
  assert_eq(split(trim(result.stdout ?? ""), "\n"), [temp])
}

@test
pipeline test_identity_roots_keep_operator_material_file_scoped(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_identity_roots.sh")
  const key = "/home/operator/.ssh/id_ed25519"
  const store = "/home/operator/.config/git-credentials"
  const result = harness.process.run(
    {
      program: "bash",
      args: ["-c", "RUNNER_TEMP= ${shell_quote(script)} ${shell_quote(key)} ${shell_quote(store)}"],
    },
  )
  assert_eq(result.exit_code, 0)
  // A home directory is not a secret scratch, so it must never be collapsed.
  assert_eq(split(trim(result.stdout ?? ""), "\n"), [key, store])
}

@test
pipeline test_identity_roots_collapse_only_the_runner_temp_entry(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const script = path_join(root, "scripts/release_identity_roots.sh")
  const temp = "/runner/work/_temp"
  const operator_key = "/home/operator/.ssh/id_ed25519"
  const result = harness.process.run(
    {
      program: "bash",
      args: [
        "-c",
        "RUNNER_TEMP=${shell_quote(temp)} ${shell_quote(script)}"
          + " ${shell_quote(path_join(temp, "release-signing-key"))}"
          + " ${shell_quote(operator_key)}",
      ],
    },
  )
  assert_eq(result.exit_code, 0)
  assert_eq(split(trim(result.stdout ?? ""), "\n"), [temp, operator_key])
}
