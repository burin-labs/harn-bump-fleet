}

pipeline test_release_pr_body_renders_local_branch_conditionally(harness: Harness, task: any) {
  const prompt = prompt_asset(harness.fs, "release_pr_body.harn.prompt")
  const base = {
    next_version: "1.2.3",
    current_version: "1.2.2",
    branch: "release-attempt/v1.2.3/head",
    base_branch: "main",
    pin_sha: "abc123",
    pin_sha_note: "",
    tag_publish_note: "already published",
    run_session_view_fixture_status: "passed",
    run_session_view_summary: "fixtures stable",
    run_session_view_release_note: "no contract-file change detected",
    execution_step_count: 0,
    execution_status_summary: "all ok",
    execution_summary: "none",
    latest_tag: "v1.2.2",
    commits_since_latest_tag: "abc123 release",
    run_id: "test-run",
  }
  const with_branch = harness.fs.render_prompt(prompt, {...base, local_branch: "release/v1.2.3"})
  assert(contains(with_branch, "Local preparation branch:** `release/v1.2.3`"))
