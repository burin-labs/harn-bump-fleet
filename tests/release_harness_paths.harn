import { shell_quote } from "std/runtime"
import { with_temp_dir } from "std/testing"
import { release_timed_phase } from "../lib/release_runtime"
import { prompt_asset, release_harness_root, release_run_root } from "../release_harn.harn"

fn pinned_test_binary(harness: Harness, root: string) -> string {
  const local = path_join(root, ".harn/bin/harn")
  const binary = if harness.fs.exists(local) {
    local
  } else {
    "harn"
  }
  const version = harness.process.run({program: binary, args: ["--version"]})
  assert_eq(version.exit_code, 0)
  const expected = trim(harness.fs.read_text(path_join(root, ".harn-version")))
  assert_eq(trim(version.stdout ?? ""), "harn ${expected}")
  return binary
}

pipeline test_release_harness_paths_anchor_to_checkout(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  assert_eq(harness.fs.exists(path_join(root, "release_harn.harn")), true)
  assert_eq(
    prompt_asset(harness.fs, "release_report.harn.prompt"),
    path_join(root, "prompts", "release_report.harn.prompt"),
  )
  assert_eq(release_run_root(harness.fs), path_join(root, ".harn-runs/release-harn"))
}

pipeline test_release_fixup_prompts_describe_immutable_recovery(harness: Harness, task: any) {
  const prompts = [
    harness.fs.read_text(prompt_asset(harness.fs, "release_fixup_system.harn.prompt")),
    harness.fs.read_text(prompt_asset(harness.fs, "release_fixup_user.harn.prompt")),
  ]
  for prompt in prompts {
    assert_eq(contains(prompt, "origin/release/v"), false)
    assert_eq(contains(prompt, "Force-pushed"), false)
    assert_eq(contains(lowercase(prompt), "immutable"), true)
  }
  assert_eq(contains(prompts[0] ?? "", "fresh candidate"), true)
  assert_eq(contains(prompts[0] ?? "", "frozen artifact"), true)
  assert_eq(contains(prompts[1] ?? "", "{{ recovery_oid }}..origin/{{ base_branch }}"), true)
  assert_eq(contains(prompts[1] ?? "", "{{ fixup_tag }}..origin/{{ base_branch }}"), false)
}

pipeline test_operator_guidance_uses_repo_pinned_launcher(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const guidance = [
    "AGENTS.md",
    "README.md",
    "docs/dependabot-fleet-template.md",
    "docs/how-to/reserve-the-release-queue.md",
    "lib/release_usage.harn",
    "watch_harn_release.harn",
  ]
  let canonical_commands = 0
  for relative in guidance {
    const contents = harness.fs.read_text(path_join(root, relative))
    for line in contents.split("\n") {
      const command = trim(line)
      assert_eq(starts_with(command, "harn run --no-sandbox"), false)
      if starts_with(command, "scripts/run_harn_release.sh") {
        canonical_commands = canonical_commands + 1
      }
    }
  }
  assert(canonical_commands >= 10)
}

pipeline test_release_launcher_keeps_sandbox_and_grants_owned_roots(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const launcher = harness.fs.read_text(path_join(root, "scripts/run_harn_release.sh"))
  const boundary = harness.fs.read_text(path_join(root, "scripts/harn_confined.sh"))
  const auth = harness.fs.read_text(path_join(root, "scripts/with_github_auth.sh"))
  assert(contains(launcher, "/harn_confined.sh"))
  assert(contains(boundary, "--allow-process-network"))
  assert(contains(boundary, "--write-root"))
  assert(contains(boundary, "rev-parse --path-format=absolute --git-common-dir"))
  assert(contains(boundary, "-release-workspaces"))
  assert(contains(boundary, "--write-root \"$release_workspace_root\""))
  const workspace = harness.fs.read_text(path_join(root, "lib/release_workspace.harn"))
  assert(contains(workspace, "basename(primary_checkout) + \"-release-workspaces\""))
  assert_eq(contains(workspace, "basename(primary_checkout) + \"-worktrees\""), false)
  assert(contains(workspace, "if !harness.fs.exists(workspace_parent)"))
  assert(contains(workspace, "harness.fs.mkdir(workspace_parent, true)"))
  assert(contains(boundary, "sandbox_args+=("))
  assert(contains(boundary, "add_process_root read"))
  assert(contains(boundary, "add_process_root write"))
  assert(contains(boundary, "add_harn_write_root"))
  assert(contains(boundary, "HARN_HOST_LEASE_ROOT"))
  assert(contains(boundary, "script_args+=(--repo"))
  assert(contains(boundary, "/with_github_auth.sh"))
  assert(contains(auth, "gh auth token"))
  assert(contains(auth, "export GH_TOKEN"))
  assert_eq(contains(auth, "echo \"$github_token\""), false)
  assert_eq(contains(launcher, "--no-sandbox"), false)
  assert_eq(contains(boundary, "--no-sandbox"), false)
  assert(contains(launcher, "/release_harn.harn"))
}

pipeline test_release_boundary_announces_every_dispatch(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const launcher = harness.fs.read_text(path_join(root, "scripts/run_harn_release.sh"))
  // Both exec routes must announce, or the boundary has a silent path.
  assert(contains(launcher, "announce_release_boundary hosted"))
  assert(contains(launcher, "announce_release_boundary confined"))
  // stderr is unconditional; the file sink is opt-in, because where a fleet
  // keeps its board is local configuration and not this repo's to hardcode.
  assert(contains(launcher, "printf '%s\\n' \"$line\" >&2"))
  assert(contains(launcher, "HARN_EXT_RELEASE_ANNOUNCE_FILE"))
  // Caller-supplied identity. The GitHub actor field reads as the shared
  // account on every dispatch and therefore identifies nobody.
  assert(contains(launcher, "HARN_EXT_RELEASE_ACTOR"))
  // The record must carry what makes a dispatch attributable and locatable.
  for field in ["ts=", "actor=", "mode=", "route=", "live=", "at_sha=", "repo="] {
    assert(contains(launcher, field))
  }
  // An unwritable board must not stop a release.
  assert(contains(launcher, "could not append release announcement"))
}

pipeline test_macos_live_release_hands_off_to_closed_hosted_inputs(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const launcher = harness.fs.read_text(path_join(root, "scripts/run_harn_release.sh"))
  const dispatch = harness.fs.read_text(path_join(root, "scripts/dispatch_hosted_release.sh"))
  assert(contains(launcher, "$(uname -s)"))
  assert(contains(launcher, "/dispatch_hosted_release.sh"))
  assert(contains(launcher, "--mock)"))
  assert(contains(dispatch, "/with_env.sh"))
  assert(contains(dispatch, "harn run --no-sandbox"))
  assert(contains(dispatch, "/dispatch_hosted_release.harn"))
  assert_eq(contains(dispatch, "gh workflow run"), false)
  assert_eq(contains(dispatch, "eval"), false)
}

pipeline test_release_preflight_refuses_bare_main_before_dispatch_and_accepts_dev(
  harness: Harness,
  task: any,
) {
  const source_root = release_harness_root(harness.fs)
  const fixture = path_join(
    harness.fs.workspace_temp_dir(),
    "release-preflight-" + harness.random.uuid_v7(),
  )
  const scripts = path_join(fixture, "scripts")
  const target = path_join(fixture, "harn")
  const dispatch_log = path_join(fixture, "dispatch.log")
  harness.fs.mkdir(scripts, true)
  harness.fs.mkdir(target, true)
  harness.fs.write_text(
    path_join(scripts, "run_harn_release.sh"),
    harness.fs.read_text(path_join(source_root, "scripts", "run_harn_release.sh")),
  )
  harness.fs.write_text(
    path_join(scripts, "harn_confined.sh"),
    "#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$HARN_TEST_DISPATCH_LOG\"\n",
  )
  const launcher = path_join(scripts, "run_harn_release.sh")
  const setup = "git -C "
    + shell_quote(target)
    + " init -q && git -C "
    + shell_quote(target)
    + " config user.email test@example.test && git -C "
    + shell_quote(target)
    + " config user.name test && chmod +x "
    + shell_quote(launcher)
    + " "
    + shell_quote(path_join(scripts, "harn_confined.sh"))
  assert(harness.process.shell(setup).success)
  fn commit_workspace_version(process: HarnessProcess, repo: string, version: string) {
    const manifest = path_join(repo, "Cargo.toml")
    const write = "printf '[workspace.package]\\nversion = \""
      + version
      + "\"\\n' > "
      + shell_quote(manifest)
      + " && git -C "
      + shell_quote(repo)
      + " add Cargo.toml && git -C "
      + shell_quote(repo)
      + " commit -q -m version && git -C "
      + shell_quote(repo)
      + " update-ref refs/remotes/origin/main HEAD"
    assert(process.shell(write).success)
  }
  commit_workspace_version(harness.process, target, "1.2.3")
  const env = "HARN_EXT_RELEASE_REPO="
    + shell_quote(target)
    + " HARN_TEST_DISPATCH_LOG="
    + shell_quote(dispatch_log)
  const bare = harness.process.shell(
    env + " " + shell_quote(launcher) + " --mock --mode ship-pr --yes-live-release",
  )
  assert_eq(bare.success, false)
  assert(contains(bare.combined, "exact X.Y.Z-dev"), bare.combined)
  assert(contains(bare.combined, "observed '1.2.3'"), bare.combined)
  assert_eq(harness.fs.exists(dispatch_log), false)
  commit_workspace_version(harness.process, target, "1.2.4-dev")
  const ready = harness.process.shell(
    env + " " + shell_quote(launcher) + " --mock --mode ship-pr --yes-live-release",
  )
  assert(ready.success, ready.combined)
  assert(contains(ready.combined, "workspace_version=1.2.4-dev"), ready.combined)
  assert(contains(harness.fs.read_text(dispatch_log), "release_harn.harn"))
  harness.fs.delete(fixture)
}

pipeline test_release_launcher_routes_canonical_audits_and_macos_mutations_to_hosted(
  harness: Harness,
  task: any,
) {
  const source_root = release_harness_root(harness.fs)
  const fixture = path_join(harness.fs.temp_dir(), "release-launcher-" + harness.random.uuid_v7())
  const scripts = path_join(fixture, "scripts")
  const bin = path_join(fixture, "bin")
  const target = path_join(fixture, "projects", "harn")
  const dispatch_log = path_join(fixture, "dispatch.log")
  const local_log = path_join(fixture, "local.log")
  harness.fs.mkdir(fixture, true)
  harness.fs.mkdir(scripts, true)
  harness.fs.mkdir(bin, true)
  harness.fs.mkdir(path_join(fixture, "projects"), true)
  harness.fs.mkdir(target, true)
  for name in ["run_harn_release.sh", "dispatch_hosted_release.sh"] {
    harness.fs.write_text(
      path_join(scripts, name),
      harness.fs.read_text(path_join(source_root, "scripts", name)),
    )
  }
  harness.fs.write_text(path_join(bin, "uname"), "#!/bin/sh\nprintf 'Darwin\\n'\n")
  harness.fs.write_text(
    path_join(scripts, "with_env.sh"),
    "#!/bin/sh\nprintf '%s\\n' \"$*\" > \"$HARN_EXT_DISPATCH_LOG\"\ncase \" $* \" in *\" --focus \"*) exit 2;; esac\n",
  )
  harness.fs.write_text(
    path_join(scripts, "harn_confined.sh"),
    "#!/bin/sh\nprintf '%s\\n' \"$*\" > \"$HARN_EXT_LOCAL_LOG\"\n",
  )
  const executable_paths = [
    path_join(scripts, "run_harn_release.sh"),
    path_join(scripts, "dispatch_hosted_release.sh"),
    path_join(scripts, "with_env.sh"),
    path_join(scripts, "harn_confined.sh"),
    path_join(bin, "uname"),
  ]
  const chmod = harness.process.shell("chmod +x " + join(executable_paths.map(shell_quote), " "))
  assert_eq(chmod.success, true)
  const prepare_target = "git -C "
    + shell_quote(target)
    + " init -q && git -C "
    + shell_quote(target)
    + " config user.email test@example.test && git -C "
    + shell_quote(target)
    + " config user.name test && printf '[workspace.package]\\nversion = \"1.2.4-dev\"\\n' > "
    + shell_quote(path_join(target, "Cargo.toml"))
    + " && git -C "
    + shell_quote(target)
    + " add Cargo.toml && git -C "
    + shell_quote(target)
    + " commit -q -m version && git -C "
    + shell_quote(target)
    + " branch -M main && git -C "
    + shell_quote(target)
    + " remote add origin "
    + shell_quote(target)
    + " && git -C "
    + shell_quote(target)
    + " update-ref refs/remotes/origin/main HEAD"
  assert(harness.process.shell(prepare_target).success)
  const env = "PATH="
    + shell_quote(bin + ":/usr/bin:/bin:/usr/sbin:/sbin")
    + " HOME="
    + shell_quote(fixture)
    + " HARN_EXT_DISPATCH_LOG="
    + shell_quote(dispatch_log)
    + " HARN_EXT_LOCAL_LOG="
    + shell_quote(local_log)
  const launcher = shell_quote(path_join(scripts, "run_harn_release.sh"))
  const pin = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const hosted = harness.process.shell(
    env
      + " "
      + launcher
      + " --mode ship-pr --bump patch --at-sha "
      + pin
      + " --agent --yes-live-release",
  )
  assert(hosted.success, hosted.combined)
  const invocation = harness.fs.read_text(dispatch_log)
  assert(contains(invocation, "harn run --no-sandbox"))
  assert(contains(invocation, "dispatch_hosted_release.harn"))
  assert(contains(invocation, "--mode ship-pr"))
  assert(contains(invocation, "--bump patch"))
  assert(contains(invocation, "--at-sha ${pin}"))
  assert_eq(harness.fs.exists(local_log), false)
  harness.fs.write_text(dispatch_log, "before unsupported\n")
  const unsupported = harness.process.shell(
    env + " " + launcher + " --mode ship-pr --yes-live-release --focus nope",
  )
  assert_eq(unsupported.success, false)
  assert(contains(harness.fs.read_text(dispatch_log), "--focus nope"))
  harness.fs.write_text(dispatch_log, "before custom repo\n")
  const custom_repo = harness.process.shell(
    env
      + " HARN_EXT_RELEASE_REPO="
      + shell_quote(path_join(fixture, "fork"))
      + " "
      + launcher
      + " --mode ship-pr --yes-live-release",
  )
  assert_eq(custom_repo.success, false)
  assert_eq(harness.fs.read_text(dispatch_log), "before custom repo\n")
  harness.fs.write_text(dispatch_log, "before mock\n")
  const mock_ship = harness.process.shell(
    env + " " + launcher + " --mock --mode ship-pr --yes-live-release",
  )
  assert_eq(mock_ship.success, true)
  assert_eq(harness.fs.read_text(dispatch_log), "before mock\n")
  assert(
    contains(
      harness.fs.read_text(local_log),
      "release_harn.harn -- --mock --mode ship-pr --yes-live-release",
    ),
  )
  harness.fs.delete(local_log)
  harness.fs.write_text(path_join(bin, "uname"), "#!/bin/sh\nprintf 'Linux\\n'\n")
  const default_audit = harness.process.shell(env + " " + launcher)
  assert_eq(default_audit.success, true)
  assert(contains(harness.fs.read_text(dispatch_log), "dispatch_hosted_release.harn --"))
  assert_eq(harness.fs.exists(local_log), false)
  const audit = harness.process.shell(env + " " + launcher + " --mode audit")
  assert_eq(audit.success, true)
  assert(
    contains(harness.fs.read_text(dispatch_log), "dispatch_hosted_release.harn -- --mode audit"),
  )
  assert_eq(harness.fs.exists(local_log), false)
  const local_audit = harness.process.shell(env + " " + launcher + " --mode audit --local-audit")
  assert_eq(local_audit.success, true)
  assert(
    contains(harness.fs.read_text(local_log), "release_harn.harn -- --mode audit --local-audit"),
  )
  harness.fs.delete(local_log)
  const env_false_audit = harness.process.shell(
    env + " HARN_EXT_RELEASE_LOCAL_AUDIT=0 " + launcher + " --mode audit",
  )
  assert_eq(env_false_audit.success, true)
  assert(
    contains(harness.fs.read_text(dispatch_log), "dispatch_hosted_release.harn -- --mode audit"),
  )
  assert_eq(harness.fs.exists(local_log), false)
  harness.fs.write_text(dispatch_log, "before env local audit\n")
  const env_local_audit = harness.process.shell(
    env + " HARN_EXT_RELEASE_LOCAL_AUDIT=1 " + launcher + " --mode audit",
  )
  assert_eq(env_local_audit.success, true)
  assert_eq(harness.fs.read_text(dispatch_log), "before env local audit\n")
  assert(contains(harness.fs.read_text(local_log), "release_harn.harn -- --mode audit"))
  harness.fs.delete(local_log)
  const mock = harness.process.shell(env + " " + launcher + " --mode audit --mock")
  assert_eq(mock.success, true)
  assert(contains(harness.fs.read_text(local_log), "release_harn.harn -- --mode audit --mock"))
  harness.fs.delete(fixture)
}

pipeline test_release_watch_launcher_carries_cleanup_authority_and_exact_egress(
  harness: Harness,
  task: any,
) {
  const root = release_harness_root(harness.fs)
  const launcher = harness.fs.read_text(path_join(root, "scripts/watch_harn_release.sh"))
  const confined = harness.fs.read_text(path_join(root, "scripts/harn_confined.sh"))
  const release_egress = harness.fs.read_text(path_join(root, "scripts/with_release_egress.sh"))
  assert(contains(launcher, "/harn_confined.sh"))
  assert(contains(launcher, "--approve-risky git.push"))
  assert_eq(contains(launcher, "--no-sandbox"), false)
  assert(contains(launcher, "/watch_harn_release.harn"))
  assert(contains(confined, "/with_env.sh"))
  assert(contains(confined, "/with_release_egress.sh"))
  const import_phase = index_of(confined, "if [ \"$artifact_import_egress\" -eq 1 ]")
  const normal_env = index_of(confined, "/with_env.sh\"")
  assert(import_phase >= 0)
  assert(normal_env > import_phase)
  const import_body = substring(confined, import_phase, normal_env)
  assert(contains(import_body, "--github-artifact-import"))
  assert_eq(contains(import_body, "/with_env.sh"), false)
  assert(
    contains(
      release_egress,
      "HARN_EGRESS_ALLOW=\"api.github.com:443,github.com:443,crates.io:443,static.crates.io:443\"",
    ),
  )
  assert(contains(release_egress, "api.github.com:443,*.blob.core.windows.net:443"))
  assert(contains(confined, "--github-artifact-import-egress"))
  assert(contains(confined, "--private-config-root"))
  assert(contains(confined, "--minimal-artifact-env"))
  assert(contains(launcher, "--import-hosted-receipt-only"))
  assert(contains(release_egress, "HARN_EGRESS_DEFAULT=\"deny\""))
  assert(contains(release_egress, "HARN_EGRESS_BLOCK_PRIVATE=\"private\""))
  assert(contains(release_egress, "HARN_EGRESS_ALLOW_LOOPBACK=\"0\""))
  assert(contains(release_egress, "unset HARN_EGRESS_ALLOW"))
  assert(contains(release_egress, "unset HARN_EGRESS_DENY"))
  assert(contains(release_egress, "unset HARN_EGRESS_DEFAULT"))
  assert(contains(release_egress, "unset HARN_EGRESS_BLOCK_PRIVATE"))
  assert(contains(release_egress, "unset HARN_EGRESS_ALLOW_LOOPBACK"))
  const guidance = [
    "AGENTS.md",
    "README.md",
    "docs/how-to/reserve-the-release-queue.md",
    "watch_harn_release.harn",
  ]
  for relative in guidance {
    const contents = harness.fs.read_text(path_join(root, relative))
    assert(contains(contents, "scripts/watch_harn_release.sh"))
    assert_eq(
      contains(contents, "scripts/with_env.sh harn run --no-sandbox watch_harn_release.harn"),
      false,
    )
  }
  const hosted_workflow = harness.fs.read_text(
    path_join(root, ".github/workflows/hosted-release.yml"),
  )
  assert(contains(hosted_workflow, "./scripts/watch_hosted_harn_release.sh"))
  assert_eq(
    contains(hosted_workflow, "scripts/with_env.sh harn run --no-sandbox watch_harn_release.harn"),
    false,
  )
}

/** The canonical launcher imports once under narrow egress, then watches normally. */
pipeline test_release_watch_launcher_splits_hosted_import_from_watch(harness: Harness, task: any) {
  const source_root = release_harness_root(harness.fs)
  const fixture = harness.fs.mkdtemp_in_workspace("release-watch-launcher-")
  const scripts = path_join(fixture, "scripts")
  const target = path_join(fixture, "harn")
  const log = path_join(fixture, "calls")
  harness.fs.mkdir(scripts, true)
  harness.fs.mkdir(target, true)
  harness.fs.write_text(
    path_join(scripts, "watch_harn_release.sh"),
    harness.fs.read_text(path_join(source_root, "scripts", "watch_harn_release.sh")),
  )
  harness.fs.write_text(
    path_join(scripts, "harn_confined.sh"),
    "#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$HARN_TEST_WATCH_CALLS\"\ncase \"$*\" in *--import-hosted-receipt-only*) ;; *) printf '{\"phase\":\"watch\"}\\n' ;; esac\n",
  )
  const chmod = harness.process.shell(
    "chmod +x "
      + shell_quote(path_join(scripts, "watch_harn_release.sh"))
      + " "
      + shell_quote(path_join(scripts, "harn_confined.sh")),
  )
  assert(chmod.success, chmod.combined)
  const result = harness.process.shell(
    "HARN_EXT_RELEASE_REPO="
      + shell_quote(target)
      + " HARN_TEST_WATCH_CALLS="
      + shell_quote(log)
      + " "
      + shell_quote(path_join(scripts, "watch_harn_release.sh"))
      + " --tag v0.10.130 --hosted-run 42 --observe-only --max-polls 1 --yes-live-release --json",
  )
  assert(result.success, result.combined)
  assert_eq(json_parse(trim(result.stdout ?? "")), {phase: "watch"})
  const calls = harness.fs.read_lines(log)
  assert_eq(len(calls), 2)
  assert(contains(calls[0], "--github-artifact-import-egress"))
  assert(contains(calls[0], "--import-hosted-receipt-only"))
  assert_eq(contains(calls[0], "--json"), false)
  assert_eq(contains(calls[1], "--github-artifact-import-egress"), false)
  assert_eq(contains(calls[1], "--import-hosted-receipt-only"), false)
  assert(contains(calls[1], "--json"))
}

/** Authentication resolves before the child is isolated from the operator config. */
pipeline test_github_auth_uses_and_cleans_owned_private_config(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const fixture = harness.fs.mkdtemp_in_workspace("github-auth-private-config-")
  const bin = path_join(fixture, "bin")
  const private_root = path_join(fixture, "private")
  const ambient = path_join(fixture, "ambient")
  const log = path_join(fixture, "calls")
  harness.fs.mkdir(bin, true)
  harness.fs.mkdir(ambient, true)
  harness.fs.write_text(
    path_join(bin, "gh"),
    "#!/bin/sh\nprintf 'auth:%s\\n' \"\${GH_CONFIG_DIR:-unset}\" >> \"$HARN_TEST_AUTH_LOG\"\nprintf 'fixture-token\\n'\n",
  )
  harness.fs.write_text(
    path_join(bin, "child"),
    "#!/bin/sh\nprintf 'child:%s:%s:%s\\n' \"$GH_CONFIG_DIR\" \"\${GH_TOKEN:+set}\" \"\${CEREBRAS_API_KEY:-absent}\"\ntouch \"$GH_CONFIG_DIR/probe\"\n",
  )
  const chmod = harness.process.shell(
    "chmod +x " + shell_quote(path_join(bin, "gh")) + " " + shell_quote(path_join(bin, "child")),
  )
  assert(chmod.success, chmod.combined)
  const command = "env -u GH_TOKEN -u GITHUB_TOKEN PATH="
    + shell_quote(bin + ":" + (harness.env.get("PATH") ?? ""))
    + " GH_CONFIG_DIR="
    + shell_quote(ambient)
    + " CEREBRAS_API_KEY=must-not-reach-child"
    + " HARN_TEST_AUTH_LOG="
    + shell_quote(log)
    + " "
    + shell_quote(path_join(root, "scripts/with_github_auth.sh"))
    + " --private-config-root "
    + shell_quote(private_root)
    + " --minimal-artifact-env"
    + " "
    + shell_quote(path_join(bin, "child"))
  const result = harness.process.shell(command)
  assert(result.success, result.combined)
  const calls = harness.fs.read_lines(log)
  assert_eq(calls[0], "auth:" + ambient)
  const child_call = trim(result.stdout ?? "")
  assert(starts_with(child_call, "child:" + private_root + "/session."))
  assert(ends_with(child_call, ":set:absent"))
  assert_eq(harness.fs.list_dir(private_root), [])
}

/** Import mode enters the same single-writer guard before touching the receipt. */
pipeline test_hosted_import_acquires_receipt_writer_guard_before_download(
  harness: Harness,
  task: any,
) {
  const source = harness.fs.read_text(
    path_join(release_harness_root(harness.fs), "watch_harn_release.harn"),
  )
  const import_mode = substring(source, index_of(source, "if parsed.import_hosted_receipt_only"))
  const guard_index = index_of(import_mode, "release_watch_guard_acquire(")
  const download = index_of(import_mode, "import_hosted_release_watch_receipt(")
  assert(guard_index >= 0)
  assert(download >= 0)
  assert(guard_index < download)
  assert(index_of(import_mode, "release_watch_guard_finish(") > download)
}

/** Azure artifact authority is absent from the normal long-lived watcher profile. */
pipeline test_release_egress_profiles_are_exact(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const fixture = harness.fs.mkdtemp_in_workspace("release-egress-profiles-")
  const child = path_join(fixture, "capture")
  const normal_log = path_join(fixture, "normal")
  const import_log = path_join(fixture, "import")
  harness.fs.write_text(
    child,
    "#!/bin/sh\nprintf '%s|%s|%s|%s\\n' \"$HARN_EGRESS_ALLOW\" \"$HARN_EGRESS_DEFAULT\" \"$HARN_EGRESS_BLOCK_PRIVATE\" \"$HARN_EGRESS_ALLOW_LOOPBACK\" > \"$1\"\n",
  )
  const chmod = harness.process.shell("chmod +x " + shell_quote(child))
  assert(chmod.success, chmod.combined)
  const boundary = shell_quote(path_join(root, "scripts/with_release_egress.sh"))
  const normal = harness.process.shell(
    boundary + " " + shell_quote(child) + " " + shell_quote(normal_log),
  )
  assert(normal.success, normal.combined)
  const artifact = harness.process.shell(
    boundary + " --github-artifact-import " + shell_quote(child) + " " + shell_quote(import_log),
  )
  assert(artifact.success, artifact.combined)
  assert_eq(
    trim(harness.fs.read_text(normal_log)),
    "api.github.com:443,github.com:443,crates.io:443,static.crates.io:443|deny|private|0",
  )
  assert_eq(
    trim(harness.fs.read_text(import_log)),
    "api.github.com:443,*.blob.core.windows.net:443|deny|private|0",
  )
}

/** Signed redirect queries are removed before Harn records subprocess output. */
pipeline test_artifact_downloader_redacts_before_process_boundary(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const fixture = harness.fs.mkdtemp_in_workspace("artifact-downloader-redaction-")
  const bin = path_join(fixture, "bin")
  const destination = path_join(fixture, "download")
  harness.fs.mkdir(bin, true)
  harness.fs.mkdir(destination, true)
  harness.fs.write_text(
    path_join(bin, "gh"),
    "#!/bin/sh\nprintf '%s\\n' 'download failed: https://productionresultssa8.blob.core.windows.net/archive.zip?sig=SECRET-SAS&se=later' >&2\nexit 23\n",
  )
  const chmod = harness.process.shell("chmod +x " + shell_quote(path_join(bin, "gh")))
  assert(chmod.success, chmod.combined)
  const result = harness.process.run(
    {
      program: path_join(root, "scripts/download_github_artifact.sh"),
      args: ["42", "release-run-42", destination],
      env: {PATH: bin + ":" + (harness.env.get("PATH") ?? "")},
    },
  )
  assert_eq(result.exit_code, 23)
  assert(contains(result.stderr ?? "", "productionresultssa8.blob.core.windows.net"))
  assert(contains(result.stderr ?? "", "?[redacted-query]"))
  assert_eq(contains(result.stderr ?? "", "SECRET-SAS"), false)
  assert_eq(harness.fs.list_dir(destination), [])
}

pipeline test_abandon_release_apply_guidance_carries_ref_mutation_authority(
  harness: Harness,
  task: any,
) {
  const root = release_harness_root(harness.fs)
  for relative in ["README.md", "abandon_release_attempts.harn"] {
    const contents = harness.fs.read_text(path_join(root, relative))
    let apply_commands = 0
    for line in contents.split("\n") {
      if contains(line, "abandon_release_attempts.harn") && contains(line, "--apply") {
        apply_commands = apply_commands + 1
        assert(contains(line, "--approve-risky git.push"))
      }
    }
    assert_eq(apply_commands, 1)
  }
}

pipeline test_abandon_release_proves_repository_identity_before_any_lane_or_ref_mutation(
  harness: Harness,
  task: any,
) {
  const root = release_harness_root(harness.fs)
  const source = harness.fs.read_text(path_join(root, "abandon_release_attempts.harn"))
  const main_source = source.split("pipeline main(harness: Harness) {")[1] ?? ""
  const identity = main_source.index_of("const repository_identity = remote_mutation_slug_check(")
  const local_lane = main_source.index_of("release_owner_guard_acquire(")
  const fleet_lane = main_source.index_of("fleet_lane = claim_release_lane(")
  const abandon = main_source.index_of("result = run_release_attempt_abandon(")
  assert(identity >= 0, "abandon entrypoint must check checkout/repository identity")
  assert(local_lane > identity, "local release lane must follow repository identity")
  assert(fleet_lane > identity, "fleet lane mutation must follow repository identity")
  assert(abandon > identity, "archive/delete runner must follow repository identity")
  const refusal = main_source.index_of("if !repository_identity.ok {")
  assert(refusal > identity)
  assert(main_source.index_of("return 2", refusal) < local_lane)
}

@test
pipeline test_abandon_release_repository_mismatch_makes_no_lane_or_ref_write(
  harness: Harness,
  task: any,
) {
  const root = release_harness_root(harness.fs)
  with_temp_dir(
    harness.fs,
    { dir ->
      const checkout = path_join(dir, "wrong-repository")
      const lease_root = path_join(dir, "host-leases")
      assert(
        harness.process.shell(
          "git init -q "
            + shell_quote(checkout)
            + " && git -C "
            + shell_quote(checkout)
            + " config user.email test@example.com && git -C "
            + shell_quote(checkout)
            + " config user.name test && git -C "
            + shell_quote(checkout)
            + " commit -q --allow-empty -m seed && git -C "
            + shell_quote(checkout)
            + " remote add origin https://github.com/another-owner/harn.git",
        ).success,
      )
      const refs_before = harness.process.run({program: "git", args: ["-C", checkout, "show-ref"]})
      assert_eq(refs_before.exit_code, 0)
      assert(trim(refs_before.stdout ?? "") != "", "fixture must positively measure a local ref")
      const result = harness.process.run(
        {
          program: pinned_test_binary(harness, root),
          args: [
            "run",
            "--no-sandbox",
            "--approve-risky",
            "git.push",
            path_join(root, "abandon_release_attempts.harn"),
            "--",
            "--repo",
            checkout,
            "--slug",
            "burin-labs/harn",
            "--version",
            "0.10.130",
            "--attempt-oid",
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--apply",
            "--yes-live-release",
          ],
          env: {HARN_HOST_LEASE_ROOT: lease_root, GH_TOKEN: "invalid-test-token"},
        },
      )
      assert_eq(result.exit_code, 2)
      assert(contains(result.stdout ?? "", "checkout origin is another-owner/harn"))
      assert_eq(
        harness.fs.exists(lease_root),
        false,
        "repository mismatch must return before the local release lane is written",
      )
      const refs_after = harness.process.run({program: "git", args: ["-C", checkout, "show-ref"]})
      assert_eq(refs_after.exit_code, 0)
      assert_eq(
        refs_after.stdout,
        refs_before.stdout,
        "repository mismatch must not create or delete a ref",
      )
    },
  )
}

