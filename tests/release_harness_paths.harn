            "--repo",
            checkout,
            "--slug",
            "burin-labs/harn",
            "--version",
            "0.10.130",
            "--attempt-oid",
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "--apply",
