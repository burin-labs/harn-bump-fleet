      assert_eq(refs_after.stdout, refs_before.stdout)
    },
  )
}

pipeline test_release_fixup_system_prompt_renders_one_recovery_source(harness: Harness, task: any) {
  const prompt = prompt_asset(harness.fs, "release_fixup_system.harn.prompt")
  const from_pr = harness.fs.render_prompt(
    prompt,
    {
      target_version: "1.2.3",
      fixup_pr_url: "https://github.com/example/harn/pull/42",
      fixup_tag: "v1.2.3",
      base_branch: "main",
      candidate_tree_notes: false,
    },
  )
  assert(contains(from_pr, "open Release PR `https://github.com/example/harn/pull/42`"))
  assert_eq(contains(from_pr, "durable recovery source is tag or immutable attempt"), false)
  assert(contains(from_pr, "frozen artifact's release body"))
  const from_tag = harness.fs.render_prompt(
    prompt,
    {
      target_version: "1.2.3",
      fixup_pr_url: "",
      fixup_tag: "v1.2.3",
      base_branch: "main",
      candidate_tree_notes: true,
    },
  )
  assert(contains(from_tag, "durable recovery source is tag or immutable attempt `v1.2.3`"))
  assert_eq(contains(from_tag, "open Release PR"), false)
  assert(contains(from_tag, "complete current note set"))
  assert_eq(contains(from_tag, "frozen artifact's release body"), false)
}

