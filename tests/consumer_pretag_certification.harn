import { run_consumer_pretag_certification } from "../lib/consumer_pretag_certification"
import { ConsumerPretagGateAdapter, ConsumerPretagRunRow } from "../lib/consumer_pretag_dispatch"
import { ConsumerPretagGateTarget } from "../lib/consumer_pretag_gate"

const REVISION = "1234567890abcdef1234567890abcdef12345678"

const CANDIDATE = {version: "v0.10.130", revision: REVISION}

fn target() -> ConsumerPretagGateTarget {
  return {
    slug: "owner/consumer",
    workflow: "candidate-gate.yml",
    revision: REVISION,
    inputs: {source_revision: REVISION},
  }
}

fn row(conclusion: string) -> ConsumerPretagRunRow {
  return {
    id: 11,
    status: "completed",
    conclusion: conclusion,
    html_url: "https://runs.test/11",
    display_title: "Harn candidate v0.10.130 @ ${REVISION}",
  }
}

fn adapter(conclusion: string) -> ConsumerPretagGateAdapter {
  return schema_expect(
    {
      dispatch: fn(_target) { return Ok(nil) },
      runs: fn(_target) { return Ok([row(conclusion)]) },
      run: fn(_target, _run_id) { return Ok(row(conclusion)) },
      wait: fn(_ms) { return nil },
      now_ms: fn() { return 0 },
    },
    ConsumerPretagGateAdapter,
  )
}

pipeline test_a_green_consumer_certifies_the_candidate(harness: Harness) {
  const result = run_consumer_pretag_certification(
    harness,
    {mock: false},
    CANDIDATE,
    [target()],
    adapter("success"),
  )
  assert(result.success)
  const step = result.steps[0] ?? {}
  assert_eq(step.consumer_pretag_verdict?.declared, 1)
  assert(contains(to_string(step.name ?? ""), "consumer-pretag-gate"))
}

pipeline test_a_red_consumer_stops_the_tag(harness: Harness) {
  const result = run_consumer_pretag_certification(
    harness,
    {mock: false},
    CANDIDATE,
    [target()],
    adapter("failure"),
  )
  assert(!result.success)
  assert_eq(
    (result.steps[0] ?? {}).consumer_pretag_verdict?.failing,
    ["owner/consumer:candidate-gate.yml"],
  )
}

pipeline test_no_declared_gate_is_reported_as_nothing_measured(harness: Harness) {
  const result = run_consumer_pretag_certification(
    harness,
    {mock: false},
    CANDIDATE,
    [],
    adapter("success"),
  )
  assert(result.success)
  const verdict = (result.steps[0] ?? {}).consumer_pretag_verdict
  assert_eq(verdict?.declared, 0)
  assert(contains(to_string(verdict?.summary ?? ""), "judged by nothing downstream"))
}

pipeline test_a_mock_release_says_it_dispatched_nothing(harness: Harness) {
  const result = run_consumer_pretag_certification(harness, {mock: true}, CANDIDATE, [target()])
  assert(result.success)
  assert(contains(to_string((result.steps[0] ?? {}).stdout ?? ""), "were not dispatched"))
}
