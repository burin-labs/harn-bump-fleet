import {
  cancel_recorded_consumer_pretag_runs,
  consumer_pretag_dispatch_registry,
  record_consumer_pretag_dispatch,
  run_consumer_pretag_certification,
  run_consumer_pretag_certification_plan,
} from "../lib/consumer_pretag_certification"
import { ConsumerPretagGateAdapter, ConsumerPretagRunRow } from "../lib/consumer_pretag_dispatch"
import { ConsumerPretagGateTarget } from "../lib/consumer_pretag_gate"

const REVISION = "1234567890abcdef1234567890abcdef12345678"

const CANDIDATE = {version: "v0.10.130", revision: REVISION}

fn target() -> ConsumerPretagGateTarget {
  return {
    slug: "owner/consumer",
    workflow: "candidate-gate.yml",
    revision: REVISION,
    inputs: {source_revision: REVISION},
  }
}

fn row(conclusion: string) -> ConsumerPretagRunRow {
  return {
    id: 11,
    status: "completed",
    conclusion: conclusion,
    html_url: "https://runs.test/11",
    display_title: "Harn candidate v0.10.130 @ ${REVISION}",
  }
}

fn adapter(conclusion: string) -> ConsumerPretagGateAdapter {
  return schema_expect(
    {
      dispatch: fn(_target) { return Ok(nil) },
      runs: fn(_target) { return Ok([row(conclusion)]) },
      run: fn(_target, _run_id) { return Ok(row(conclusion)) },
      wait: fn(_ms) { return nil },
      now_ms: fn() { return 0 },
    },
    ConsumerPretagGateAdapter,
  )
}

pipeline test_a_green_consumer_certifies_the_candidate(harness: Harness) {
  const result = run_consumer_pretag_certification(
    harness,
    {mock: false},
    CANDIDATE,
    [target()],
    adapter("success"),
  )
  assert(result.success)
  const step = result.steps[0] ?? {}
  assert_eq(step.consumer_pretag_verdict?.declared, 1)
  assert(contains(to_string(step.name ?? ""), "consumer-pretag-gate"))
}

pipeline test_a_red_consumer_stops_the_tag(harness: Harness) {
  const result = run_consumer_pretag_certification(
    harness,
    {mock: false},
    CANDIDATE,
    [target()],
    adapter("failure"),
  )
  assert(!result.success)
  assert_eq(
    (result.steps[0] ?? {}).consumer_pretag_verdict?.failing,
    ["owner/consumer:candidate-gate.yml"],
  )
}

pipeline test_no_declared_gate_is_reported_as_nothing_measured(harness: Harness) {
  const result = run_consumer_pretag_certification(
    harness,
    {mock: false},
    CANDIDATE,
    [],
    adapter("success"),
  )
  assert(result.success)
  const verdict = (result.steps[0] ?? {}).consumer_pretag_verdict
  assert_eq(verdict?.declared, 0)
  assert(contains(to_string(verdict?.summary ?? ""), "judged by nothing downstream"))
}

pipeline test_a_mock_release_says_it_dispatched_nothing(harness: Harness) {
  const result = run_consumer_pretag_certification(harness, {mock: true}, CANDIDATE, [target()])
  assert(result.success)
  assert(contains(to_string((result.steps[0] ?? {}).stdout ?? ""), "were not dispatched"))
}

pipeline test_a_cancelled_gate_cancels_the_run_it_dispatched(harness: Harness) {
  // THE falsifier for harn-bump-fleet#1140. A consumer gate is a full runtime
  // build on that consumer's largest runner class, so a cancelled certification
  // that leaves the run going holds a scarce lane for tens of minutes after the
  // release already decided to stop.
  const registry = consumer_pretag_dispatch_registry(harness.runtime, "cancel-test-${REVISION}")
  record_consumer_pretag_dispatch(harness.runtime, registry, "owner/consumer", 11)
  const cleanup = cancel_recorded_consumer_pretag_runs(harness, [target()], registry, true)
  assert_eq(len(cleanup), 1)
  assert_eq(cleanup[0]?.slug, "owner/consumer")
  assert_eq(cleanup[0]?.run_id, 11)
  assert(cleanup[0]?.success)
}

pipeline test_a_gate_that_never_reached_a_run_reclaims_nothing(harness: Harness) {
  // An empty cleanup has to be able to mean "nothing was running", or the
  // receipt above cannot be trusted to mean "something was".
  const registry = consumer_pretag_dispatch_registry(harness.runtime, "nocancel-test-${REVISION}")
  assert_eq(cancel_recorded_consumer_pretag_runs(harness, [target()], registry, true), [])
}

pipeline test_the_run_id_is_recorded_while_the_gate_is_still_polling(harness: Harness) {
  // Recording at settle time would be too late: cancellation arrives while the
  // gate is mid-poll, and a run whose id was never published cannot be reached.
  let recorded: list<string> = []
  const result = run_consumer_pretag_certification(
    harness,
    {mock: false},
    CANDIDATE,
    [target()],
    adapter("success"),
    fn(slug, run_id) {
      recorded = recorded + ["${slug}:${to_string(run_id)}"]
      return nil
    },
  )
  assert(result.success)
  assert_eq(recorded, ["owner/consumer:11"])
}

pipeline test_unreadable_consumer_contracts_refuse_the_candidate(harness: Harness) {
  // Not "no consumer declared a gate". The distinction is the whole point.
  const plan = {targets: [], error: "branch lookup failed"}
  const result = run_consumer_pretag_certification_plan(harness, {mock: false}, CANDIDATE, plan)
  assert(!result.success)
  assert(contains(to_string((result.steps[0] ?? {}).stderr ?? ""), "judged by none of them"))
}
