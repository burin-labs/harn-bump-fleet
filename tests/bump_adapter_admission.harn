import { live_bump_adapter_admission } from "../lib/bump_adapter_admission"
import { bump_summary_problem_outcome } from "../lib/bump_summary"
import { FleetManifest, resolve_harn_update_spec } from "../lib/fleet_manifest"
import { bump_repository_capability_admission } from "../lib/fleet_policy"
import { github_repository_auto_merge_enabled } from "../lib/github_repository_settings"

const BASE = "https://admission.test"

const REPOSITORY = BASE + "/repos/owner/consumer"

const OPTIONS = {
  api_base_url: BASE,
  installation_token: "synthetic-admission-token",
  retry: {max_attempts: 1},
}

const SOURCE = """
on:
  workflow_dispatch:
    inputs:
      version:
        type: string
jobs:
  bump:
    runs-on: ubuntu-24.04
    steps:
      - run: echo bump
"""

fn update(auto_merge: bool) {
  const manifest: FleetManifest = {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow:
        "owner/harn/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      bump_workflow:
        "owner/harn/.github/workflows/bump-harn.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    },
    repositories: [],
  }
  return resolve_harn_update_spec(
    manifest,
    {
      slug: "owner/consumer",
      directory: "consumer",
      harn_bump: true,
      bump_workflow_ownership: "repository",
      bump_enable_auto_merge: auto_merge,
    },
    "v0.10.165",
  )
}

fn mock_adapter(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    REPOSITORY + "/contents/.github/workflows/bump-harn.yml?ref=main",
    {
      status: 200,
      body: json_stringify(
        {
          type: "file",
          path: ".github/workflows/bump-harn.yml",
          sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          encoding: "base64",
          content: base64_encode(SOURCE),
        },
      ),
    },
  )
}

pipeline test_live_admission_refuses_disabled_auto_merge_before_dispatch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_adapter(harness.testing)
  harness.testing.http_mock("GET", REPOSITORY, {status: 200, body: "{\"allow_auto_merge\":false}"})
  const result = live_bump_adapter_admission(harness, update(true), OPTIONS)
  assert_eq(result.ok, false)
  assert(bump_summary_problem_outcome(result), "the fleet command must fail for a refused dispatch")
  assert_eq(
    result.status,
    "auto_merge_unavailable",
    json_stringify(result) + json_stringify(harness.testing.http_mock_calls()),
  )
  assert_eq(
    harness.testing.http_mock_calls().map({ call -> call.method }).to_list(),
    ["GET", "GET"],
  )
}

pipeline test_live_admission_accepts_measured_auto_merge(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_adapter(harness.testing)
  harness.testing.http_mock("GET", REPOSITORY, {status: 200, body: "{\"allow_auto_merge\":true}"})
  const result = live_bump_adapter_admission(harness, update(true), OPTIONS)
  assert(result.ok, json_stringify(result) + json_stringify(harness.testing.http_mock_calls()))
  assert_eq(len(harness.testing.http_mock_calls()), 2)
}

pipeline test_non_auto_merge_contract_never_requests_the_capability(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_adapter(harness.testing)
  const result = live_bump_adapter_admission(harness, update(false), OPTIONS)
  assert(result.ok, json_stringify(result) + json_stringify(harness.testing.http_mock_calls()))
  assert_eq(len(harness.testing.http_mock_calls()), 1)
  assert_eq(
    bump_repository_capability_admission(
      update(false).adapter,
      { ->
        throw "must not read"
      },
    ).ok,
    true,
  )
}

pipeline test_unknown_repository_capability_never_reads_as_permission(harness: Harness) {
  for body in ["{}", "{\"allow_auto_merge\":null}", "{\"allow_auto_merge\":\"true\"}"] {
    harness.testing.http_mock_clear()
    harness.testing.http_mock("GET", REPOSITORY, {status: 200, body: body})
    const measured = github_repository_auto_merge_enabled(harness, "owner/consumer", OPTIONS)
    assert(is_err(measured))
    assert_eq(
      bump_repository_capability_admission(update(true).adapter, { -> measured }).status,
      "preflight_error",
    )
    assert_eq(len(harness.testing.http_mock_calls()), 1)
  }
}

pipeline test_repository_lookup_failure_stays_a_preflight_refusal(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock("GET", REPOSITORY, {status: 404, body: "{\"message\":\"Not Found\"}"})
  const result = bump_repository_capability_admission(
    update(true).adapter,
    { -> github_repository_auto_merge_enabled(harness, "owner/consumer", OPTIONS) },
  )
  assert_eq(result.ok, false)
  assert_eq(result.status, "preflight_error")
  assert(
    bump_summary_problem_outcome(result),
    "an unreadable permission must fail the fleet command",
  )
  assert_eq(len(harness.testing.http_mock_calls()), 1)
}
