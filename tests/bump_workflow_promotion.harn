import {
  bump_workflow_promotion_targets,
  promote_bump_workflow_manifest,
  promote_bump_workflow_manifest_text,
  released_bump_workflow_reference,
} from "../lib/bump_workflow_promotion"
import { FleetManifest } from "../lib/fleet_manifest"

const OLD = "1111111111111111111111111111111111111111"

const RELEASED = "2222222222222222222222222222222222222222"

fn manifest() -> FleetManifest {
  return {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow: "burin-labs/.github/.github/workflows/harn-package.yml@" + OLD,
      bump_workflow: "burin-labs/harn/.github/workflows/bump-harn.yml@" + OLD,
    },
    file_projections: [],
    repositories: [
      {
        slug: "burin-labs/harn-bump-fleet",
        directory: "harn-bump-fleet",
        harn_package: true,
        package_ci_ownership: "pin",
        harn_bump: true,
        bump_workflow_ownership: "fleet",
      },
    ],
  }
}

pipeline test_released_reference_requires_exact_lowercase_commit(task) {
  assert_eq(
    released_bump_workflow_reference(RELEASED),
    "burin-labs/harn/.github/workflows/bump-harn.yml@" + RELEASED,
  )
  for invalid in ["main", "A" + substring(RELEASED, 1), substring(RELEASED, 1)] {
    const result = try {
      released_bump_workflow_reference(invalid)
    }
    assert(is_err(result))
  }
}

pipeline test_manifest_promotion_changes_only_bump_policy(task) {
  const before = manifest()
  const after = promote_bump_workflow_manifest(before, RELEASED)
  assert_eq(after.policy.package_workflow, before.policy.package_workflow)
  assert_eq(after.policy.bump_workflow, released_bump_workflow_reference(RELEASED))
  assert_eq(after.policy.publish_failures_for_repair, true)
  assert_eq(after.repositories, before.repositories)
}

pipeline test_source_rewrite_requires_one_canonical_assignment(task) {
  const before = manifest()
  const line = "bump_workflow = \"${before.policy.bump_workflow}\""
  const source = "[policy]\n${line}\n"
  assert_eq(
    promote_bump_workflow_manifest_text(source, before, RELEASED),
    "[policy]\nbump_workflow = \"${released_bump_workflow_reference(RELEASED)}\"\npublish_failures_for_repair = true\n",
  )
  assert(
    is_err(
      try {
        promote_bump_workflow_manifest_text("[policy]\n", before, RELEASED)
      },
    ),
  )
  assert(
    is_err(
      try {
        promote_bump_workflow_manifest_text(source + line, before, RELEASED)
      },
    ),
  )
}

pipeline test_source_rewrite_normalizes_existing_repair_policy(task) {
  const before = manifest()
  const line = "bump_workflow = \"${before.policy.bump_workflow}\""
  const source = "[policy]\n${line}\npublish_failures_for_repair = false\n"
  assert_eq(
    promote_bump_workflow_manifest_text(source, before, RELEASED),
    "[policy]\nbump_workflow = \"${released_bump_workflow_reference(RELEASED)}\"\npublish_failures_for_repair = true\n",
  )
}

pipeline test_promotion_stages_manifest_and_its_own_adapter(task) {
  const promoted = promote_bump_workflow_manifest(manifest(), RELEASED)
  const targets = bump_workflow_promotion_targets(promoted, "promoted manifest\n")
  assert_eq(
    targets.map({ target -> target.path }).to_list(),
    ["fleet.toml", ".github/workflows/bump-harn.yml"],
  )
  assert(contains(targets[1]?.expected ?? "", released_bump_workflow_reference(RELEASED)))
  assert(contains(targets[1]?.expected ?? "", "publish-failure-for-repair: true"))
}
