import {
  WorkflowCheckoutSource,
  workflow_checkout_census,
  workflow_checkout_violation_lines,
} from "../lib/workflow_checkout_policy"

const HARDENED = "on: [push]\njobs:\n"
  + "  build:\n"
  + "    steps:\n"
  + "      - name: Checkout\n"
  + "        uses: actions/checkout@v7\n"
  + "        with:\n"
  + "          persist-credentials: false\n"

const BARE = "on: [push]\njobs:\n"
  + "  build:\n"
  + "    steps:\n"
  + "      - name: Checkout\n"
  + "        uses: actions/checkout@v7\n"

const PERSISTED = "on: [push]\njobs:\n"
  + "  build:\n"
  + "    steps:\n"
  + "      - name: Checkout\n"
  + "        uses: actions/checkout@v7\n"
  + "        with:\n"
  + "          persist-credentials: true\n"

fn sources(entries: list<WorkflowCheckoutSource>) -> list<WorkflowCheckoutSource> {
  return entries
}

pipeline test_hardened_checkout_passes_and_is_measured(harness: Harness, task: any) {
  const census = workflow_checkout_census(sources([{path: "a.yml", source: HARDENED}]))
  assert_eq(census.ok, true)
  assert_eq(len(census.measured), 1)
  assert_eq(len(census.violations), 0)
}

pipeline test_a_checkout_without_the_setting_is_a_violation(harness: Harness, task: any) {
  const census = workflow_checkout_census(sources([{path: "a.yml", source: BARE}]))
  assert_eq(census.ok, false)
  assert_eq(len(census.violations), 1)
  assert_eq(census.violations[0]?.persist_credentials_declared, false)
  assert(
    contains(
      workflow_checkout_violation_lines(census)[0] ?? "",
      "does not set persist-credentials",
    ),
  )
}

pipeline test_a_checkout_declaring_true_is_a_violation(harness: Harness, task: any) {
  const census = workflow_checkout_census(sources([{path: "a.yml", source: PERSISTED}]))
  assert_eq(census.ok, false)
  assert_eq(len(census.violations), 1)
  assert_eq(census.violations[0]?.persist_credentials_declared, true)
  assert(contains(workflow_checkout_violation_lines(census)[0] ?? "", "sets persist-credentials"))
}

/**
 * Absence must not read as success.
 *
 * An inventory that returns nothing, and a workflow the decoder cannot read,
 * both produce zero violations. Neither is a clean repository, and a census
 * that returned `ok` for either would go green the day the inventory or the
 * decoder quietly stops working.
 */
pipeline test_an_empty_census_refuses(harness: Harness, task: any) {
  const census = workflow_checkout_census(sources([]))
  assert_eq(census.ok, false)
  assert_eq(len(census.violations), 0)
  assert(contains(workflow_checkout_violation_lines(census)[0] ?? "", "proved nothing"))
}

pipeline test_a_workflow_with_no_checkout_at_all_refuses(harness: Harness, task: any) {
  const census = workflow_checkout_census(
    sources(
      [{path: "a.yml", source: "on: [push]\njobs:\n  build:\n    steps:\n      - run: true\n"}],
    ),
  )
  assert_eq(census.ok, false)
  assert_eq(len(census.measured), 0)
}

pipeline test_an_undecodable_workflow_refuses(harness: Harness, task: any) {
  const census = workflow_checkout_census(
    sources(
      [{path: "good.yml", source: HARDENED}, {path: "bad.yml", source: "on: [push]\njobs: 7\n"}],
    ),
  )
  assert_eq(census.ok, false)
  assert_eq(census.unreadable, ["bad.yml"])
  assert(contains(workflow_checkout_violation_lines(census)[0] ?? "", "unmeasured"))
}

/** The repository's own workflows are the case the CI gate actually decides. */
pipeline test_every_workflow_in_this_repository_is_hardened(harness: Harness, task: any) {
  const root = dirname(harness.fs.cwd())
  let entries: list<WorkflowCheckoutSource> = []
  for name in harness.fs.list_dir(path_join(root, ".github/workflows")) {
    if !ends_with(name, ".yml") {
      continue
    }
    entries = entries
      + [{path: name, source: harness.fs.read_text(path_join(root, ".github/workflows", name))}]
  }
  const census = workflow_checkout_census(entries)
  assert_eq(workflow_checkout_violation_lines(census), [])
  assert_eq(census.ok, true)
  assert(len(census.measured) >= 15)
}
