import { bump_workflow_has_manual_dispatch } from "../lib/bump_fleet_pre_dispatch"

/**
 * The bump workflow is a thin caller of Harn's reusable `workflow_call`
 * workflow. Everything the previous hand-rolled state machine implemented here
 * — readiness gate, stale-branch disarm, no-op tree comparison, signed
 * `createCommitOnBranch`, PR + auto-merge — now lives in the `std/bump`
 * modules and is tested in burin-labs/harn. What stays this repo's
 * responsibility, and so what these tests pin, is the caller contract.
 */
pipeline test_bump_workflow_delegates_to_pinned_reusable_workflow(task) {
  const workflow = harness.fs.read_text(
    path_join(dirname(cwd()), ".github", "workflows", "bump-harn.yml"),
  )
  assert(
    contains(
      workflow,
      "uses: burin-labs/harn/.github/workflows/bump-harn.yml@e9e1ac66009672132267261a47cdcd19705e40f1",
    ),
  )
  assert(contains(workflow, "app-client-id: $" + "{{ secrets.RELEASE_APP_CLIENT_ID }}"))
  assert(contains(workflow, "app-private-key: $" + "{{ secrets.RELEASE_APP_PRIVATE_KEY }}"))
  // The copied state machine must be gone, not merely bypassed.
  assert_eq(contains(workflow, "createCommitOnBranch"), false)
  assert_eq(contains(workflow, "MAIN_TREE"), false)
  assert_eq(contains(workflow, "scripts/install_harn.sh"), false)
  assert_eq(contains(workflow, "rust-toolchain"), false)
  assert_eq(contains(workflow, "scripts/wait_harn_release_ready.sh"), false)
}

/**
 * The fleet decides a repo is bumpable by looking for a manual trigger at
 * exactly two-space indentation (`lib/bump_fleet_pre_dispatch.harn`). This repo
 * dispatches itself, so losing or re-indenting that key would silently drop
 * harn-bump-fleet out of its own fleet.
 */
pipeline test_bump_workflow_stays_fleet_dispatchable(task) {
  const workflow = harness.fs.read_text(
    path_join(dirname(cwd()), ".github", "workflows", "bump-harn.yml"),
  )
  assert(bump_workflow_has_manual_dispatch(workflow))
}

/**
 * The single `validate-command` is the only place repo knowledge lives now, so
 * it must keep matching the gate `harn-static.yml` enforces on PRs.
 */
pipeline test_bump_workflow_validate_command_matches_static_gate(task) {
  const workflow = harness.fs.read_text(
    path_join(dirname(cwd()), ".github", "workflows", "bump-harn.yml"),
  )
  assert(contains(workflow, "harn check --strict-types $files"))
  assert(contains(workflow, "harn lint --strict $files"))
  assert(contains(workflow, "harn run --no-sandbox check_source_length.harn"))
  assert(contains(workflow, "harn test tests/ --parallel --verbose"))
  // POSIX sh only: the runner's default shell may be dash, not bash.
  assert_eq(contains(workflow, "mapfile"), false)
  assert_eq(contains(workflow, "pipefail"), false)
}

/** The remaining first-party CI workflows still pin setup-harn by SHA. */
pipeline test_ci_workflows_use_immutable_first_party_harn_setup(task) {
  const workflows = ["harn-static.yml", "release-rehearsal.yml"]
  for name in workflows {
    const workflow = harness.fs.read_text(path_join(dirname(cwd()), ".github", "workflows", name))
    assert(
      contains(
        workflow,
        "uses: burin-labs/harn/.github/actions/setup-harn@05e43962cdefae44a511e81942adeebc6fe47675",
      ),
    )
    assert_eq(contains(workflow, "scripts/install_harn.sh"), false)
    assert_eq(contains(workflow, "rust-toolchain"), false)
  }
}
