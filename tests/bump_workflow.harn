import { bump_workflow_has_manual_dispatch } from "../lib/bump_fleet_pre_dispatch"
import { decode_github_workflow } from "../lib/github_workflow"

const BUMP_WORKFLOW =
  "burin-labs/harn/.github/workflows/bump-harn.yml@88bdd139836493d3e1a11ef68856a0d8802a4066"

const SETUP_ACTION =
  "burin-labs/harn/.github/actions/setup-harn@7313a4bd8fe95b93239971457513a5adb6d46fcd"

fn workflow_source(name: string) -> string {
  return harness.fs.read_text(path_join(dirname(cwd()), ".github", "workflows", name))
}

/** The bump adapter pins Harn's reusable workflow and contains no local engine. */
pipeline test_bump_workflow_delegates_to_pinned_reusable_workflow(task) {
  const workflow = decode_github_workflow(workflow_source("bump-harn.yml"))
  assert_eq(workflow.jobs.keys(), ["bump"])
  const bump = workflow.jobs.get("bump") ?? {}
  assert_eq(bump.uses, BUMP_WORKFLOW)
  assert_eq(
    bump.secrets,
    {
      "app-client-id": "$" + "{{ secrets.RELEASE_APP_CLIENT_ID }}",
      "app-private-key": "$" + "{{ secrets.RELEASE_APP_PRIVATE_KEY }}",
    },
  )
  assert_eq(bump.steps, nil)
}

/**
 * The fleet decides a repo is bumpable by looking for a manual trigger at
 * exactly two-space indentation (`lib/bump_fleet_pre_dispatch.harn`). This repo
 * dispatches itself, so losing or re-indenting that key would silently drop
 * harn-bump-fleet out of its own fleet.
 */
pipeline test_bump_workflow_stays_fleet_dispatchable(task) {
  assert(bump_workflow_has_manual_dispatch(workflow_source("bump-harn.yml")))
}

/**
 * This orchestration application is not a publishable Harn package, so its
 * bump adapter preserves the same strict project contract as CI.
 */
pipeline test_bump_workflow_uses_application_validation(task) {
  const workflow = decode_github_workflow(workflow_source("bump-harn.yml"))
  const bump = workflow.jobs.get("bump") ?? {}
  assert_eq(
    bump.with,
    {
      version: "$" + "{{ inputs.version }}",
      "validate-command": join(
        [
          "set -eu",
          "scripts/harn-project.sh --tracked-only format",
          "scripts/harn-project.sh --tracked-only verify",
          "harn run --no-sandbox check_source_length.harn",
          "harn test tests/ --parallel",
          "harn test tests-risky/release_ref_cleanup_git_push.harn --approve-risky git.push",
          "",
        ],
        "\n",
      ),
    },
  )
}

/** The remaining first-party CI workflows still pin setup-harn by SHA. */
pipeline test_ci_workflows_use_immutable_first_party_harn_setup(task) {
  const workflows = ["ci.yml", "bump-fleet.yml", "release-rehearsal.yml"]
  for name in workflows {
    const workflow = decode_github_workflow(workflow_source(name))
    let setup_steps = []
    for job in workflow.jobs {
      for step in job.value.steps ?? [] {
        if step.uses == SETUP_ACTION {
          setup_steps = setup_steps + [step.uses]
        }
      }
    }
    assert_eq(setup_steps, [SETUP_ACTION], name)
  }
}
