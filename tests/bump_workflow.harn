pipeline test_bump_workflow_prevents_noop_duplicate_pr(task) {
  const workflow = harness.fs.read_text(path_join(dirname(cwd()), ".github", "workflows", "bump-harn.yml"))
  assert(contains(workflow, "--disable-auto"))
  assert(contains(workflow, "duplicate no-op PR onto main"))
  assert(contains(workflow, "MAIN_TREE"))
  assert(contains(workflow, "BRANCH_TREE"))
  assert(contains(workflow, "gh pr close"))
  assert(contains(workflow, "bump branch tree already matches main"))
}
