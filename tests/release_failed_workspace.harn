import { failed_release_workspace_authorization } from "../lib/release_failed_workspace"
import { release_run_dir } from "../lib/release_paths"

fn event(event_type: string, data: dict) -> string {
  return json_stringify(
    {
      schema_version: "release_harn.run_event.v1",
      timestamp: "2026-08-03T00:00:00Z",
      event_type: event_type,
      data: data,
    },
  )
}

fn write_failed_workspace_events(
  fs: HarnessFs,
  run_id: string,
  workspace: string,
  branch: string,
  extra: list<string> = [],
) -> nil {
  const run_dir = release_run_dir(fs, run_id)
  fs.mkdir(run_dir, true)
  const lines = [
    event(
      "release_workspace_created",
      {workspace: workspace, pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    ),
  ]
    + extra
    + [
    event("release_workspace_preserved", {path: workspace, branch: branch, preserved: true}),
    event("run_finished", {success: false}),
  ]
  fs.write_text(path_join(run_dir, "run-events.jsonl"), join(lines, "\n") + "\n")
  return nil
}

pipeline test_failed_workspace_authorization_requires_exact_terminal_prepublication_receipts(
  harness: Harness,
  task,
) {
  const run_id = harness.random.uuid_v7()
  const workspace = "/tmp/release-${run_id}"
  const branch = "release/v1.2.3"
  write_failed_workspace_events(harness.fs, run_id, workspace, branch)
  const authorized = failed_release_workspace_authorization(harness.fs, workspace, branch)
  assert_eq(authorized.authorized, true)
  assert_eq(authorized.run_id, run_id)
  assert_eq(authorized.pin_sha, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  const wrong_workspace = failed_release_workspace_authorization(
    harness.fs,
    "/tmp/release-${harness.random.uuid_v7()}",
    branch,
  )
  assert_eq(wrong_workspace.authorized, false)
}

pipeline test_failed_workspace_authorization_rejects_any_publication_start(harness: Harness, task) {
  const run_id = harness.random.uuid_v7()
  const workspace = "/tmp/release-${run_id}"
  const branch = "release/v1.2.3"
  write_failed_workspace_events(
    harness.fs,
    run_id,
    workspace,
    branch,
    [event("immutable_publication_started", {remote_ref: "release-attempt/v1.2.3/abc"})],
  )
  const denied = failed_release_workspace_authorization(harness.fs, workspace, branch)
  assert_eq(denied.authorized, false)
  assert(contains(denied.reason, "publication"))
}
