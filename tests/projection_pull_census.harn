import { projection_pull_census } from "../lib/projection_pull_census"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "census-test-token"}
}

fn page_url(page: int) -> string {
  return BASE + "/repos/octo-org/octo-repo/pulls?state=open&base=main&per_page=10&page=${page}"
}

fn pull(number: int) -> dict {
  return {
    number: number,
    title: "[CI] Restore fleet-owned projections",
    state: "open",
    html_url: "https://github.com/${SLUG}/pull/${number}",
    base: {ref: "main", sha: "base", repo: {full_name: SLUG, owner: {login: "octo-org"}}},
    head: {
      ref: "automation/fleet-projections-${number}",
      sha: "head-${number}",
      repo: {full_name: SLUG, owner: {login: "octo-org"}},
    },
  }
}

fn full_page(first: int) -> list<dict> {
  let rows: list<dict> = []
  let number = first
  while number < first + 10 {
    rows = rows + [pull(number)]
    number = number + 1
  }
  return rows
}

fn mock_page(testing: HarnessTesting, page: int, rows: list<dict>) {
  testing.http_mock("GET", page_url(page), {status: 200, body: json_stringify(rows)})
}

pipeline test_census_reaches_proposal_beyond_original_first_hundred(harness: Harness) {
  let page = 1
  while page <= 10 {
    mock_page(harness.testing, page, full_page((page - 1) * 10 + 1))
    page = page + 1
  }
  mock_page(harness.testing, 11, [pull(101)])
  const result = projection_pull_census(harness, SLUG, "main", options())
  assert(is_ok(result))
  assert_eq(unwrap(result).pages, 11)
  assert_eq(len(unwrap(result).pulls), 101)
  assert_eq(unwrap(result).pulls[100].number, 101)
  assert_eq(len(harness.testing.http_mock_calls()), 11)
}

pipeline test_census_later_page_failure_is_not_partial_success(harness: Harness) {
  mock_page(harness.testing, 1, full_page(1))
  harness.testing.http_mock("GET", page_url(2), {status: 403, body: "denied"})
  const result = projection_pull_census(harness, SLUG, "main", options())
  assert(is_err(result))
  assert(contains(unwrap_err(result), "page 2 after 10 pull requests"))
}

pipeline test_census_duplicate_identity_refuses_changed_inventory(harness: Harness) {
  mock_page(harness.testing, 1, full_page(1))
  mock_page(harness.testing, 2, [pull(10)])
  const result = projection_pull_census(harness, SLUG, "main", options())
  assert(is_err(result))
  assert(contains(unwrap_err(result), "duplicate pull request 10"))
}

pipeline test_census_empty_inventory_is_measured(harness: Harness) {
  mock_page(harness.testing, 1, [])
  const result = projection_pull_census(harness, SLUG, "main", options())
  assert(is_ok(result))
  assert_eq(unwrap(result).pages, 1)
  assert_eq(len(unwrap(result).pulls), 0)
  assert_eq(len(harness.testing.http_mock_calls()), 1)
}

pipeline test_census_exhausted_bound_is_not_complete(harness: Harness) {
  let page = 1
  while page <= 250 {
    mock_page(harness.testing, page, full_page((page - 1) * 10 + 1))
    page = page + 1
  }
  const result = projection_pull_census(harness, SLUG, "main", options())
  assert(is_err(result))
  assert(contains(unwrap_err(result), "exhausted 250 pages after 2500 pull requests"))
  assert_eq(len(harness.testing.http_mock_calls()), 250)
}
