import {
  classify_package_test_compatibility,
  package_test_compatibility_passed,
  package_test_compatibility_scan,
} from "../lib/package_test_compatibility"

fn command(success: bool, exit_code: int, stdout: string = "") -> dict {
  return {success: success, exit_code: exit_code, stdout: stdout, stderr: ""}
}

fn inventory(ok: bool, selected: int, discovered: int) -> string {
  return if ok {
    json_stringify(
      {
        schemaVersion: 1,
        ok: true,
        data: {
          selected_file_count: selected,
          discovered_test_count: discovered,
          files_without_tests: [],
          files_with_errors: [],
          allow_empty: false,
        },
      },
    )
  } else {
    json_stringify(
      {
        schemaVersion: 1,
        ok: false,
        error: {
          code: "package_test_discovery_failed",
          message: "package test discovery failed",
          details: {
            inventory: {
              selected_file_count: selected,
              discovered_test_count: discovered,
              files_without_tests: [{path: "tests/noop.harn", sha256: "sha256:abc"}],
              files_with_errors: [],
              allow_empty: false,
            },
            problems: ["tests/noop.harn contains no discoverable test pipeline"],
          },
        },
      },
    )
  }
}

pipeline test_classification_preserves_failed_receipt_and_counts(task: unknown) {
  const raw = inventory(false, 1, 0)
  const row = classify_package_test_compatibility(
    {
      repository: "burin-labs/example",
      revision: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      before: sha256("clean"),
      after: sha256("clean"),
      command: command(false, 1, raw),
      receipt_text: raw,
    },
  )
  assert_eq(row.status, "failed")
  assert_eq(row.selected_file_count, 1)
  assert_eq(row.discovered_test_count, 0)
  assert_eq(row.receipt_sha256, sha256(raw))
  assert(
    contains(json_stringify(row.receipt), "tests/noop.harn contains no discoverable test pipeline"),
  )
}

pipeline test_classification_refuses_absent_measurement_and_mutation(task: unknown) {
  const absent = classify_package_test_compatibility(
    {
      repository: "burin-labs/example",
      revision: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      before: sha256("clean"),
      after: sha256("clean"),
      command: command(false, 1),
      receipt_text: "",
    },
  )
  assert_eq(absent.status, "unmeasured")
  assert_eq(absent.selected_file_count, nil)
  const raw = inventory(true, 1, 1)
  const mutated = classify_package_test_compatibility(
    {
      repository: "burin-labs/example",
      revision: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      before: sha256("before"),
      after: sha256("after"),
      command: command(true, 0, raw),
      receipt_text: raw,
    },
  )
  assert_eq(mutated.status, "failed")
  assert_eq(mutated.reason, "package test inventory mutated the repository")
}

pipeline test_fleet_scan_counts_every_selected_repository_without_vacuous_green(
  harness: Harness,
  task: unknown,
) {
  const root = harness.fs.mkdtemp_in_workspace("package-compatibility-root-")
  const receipts = harness.fs.mkdtemp_in_workspace("package-compatibility-receipts-")
  const harn_bin = path_join(root, "harn")
  harness.fs.write_text(harn_bin, "candidate")
  const receipt = package_test_compatibility_scan(
    {fs: harness.fs, process: harness.process},
    [{slug: "burin-labs/pass", directory: "pass"}, {slug: "burin-labs/fail", directory: "fail"}],
    root,
    harn_bin,
    receipts,
    {
      revision: fn(_directory) { return "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
      fingerprint: fn(_directory) { return sha256("clean") },
      inventory: fn(directory, _receipt_path) {
        const passed = ends_with(directory, "/pass")
        const raw = inventory(
          passed,
          1,
          if passed {
            1
          } else {
            0
          },
        )
        return command(
          passed,
          if passed {
            0
          } else {
            1
          },
          raw,
        )
      },
    },
  )
  assert_eq(receipt.selected_count, 2)
  assert_eq(receipt.passed_count, 1)
  assert_eq(receipt.failed_count, 1)
  assert_eq(receipt.unmeasured_count, 0)
  assert(!package_test_compatibility_passed(receipt))
}
