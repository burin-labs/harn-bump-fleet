import { decode_github_workflow, github_projection_has_trigger } from "../lib/github_workflow"

fn workflow(fs: HarnessFs) {
  return decode_github_workflow(
    fs.read_text(path_join(dirname(fs.cwd()), ".github", "workflows", "bump-fleet.yml")),
  )
}

pipeline test_hosted_bump_runs_the_canonical_controller(harness: Harness, task) {
  const projected = workflow(harness.fs)
  assert(github_projection_has_trigger(projected, "workflow_dispatch"))
  let source = ""
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      source = source + "\n" + (step.run ?? "")
    }
  }
  assert(contains(source, "materialize_fleet.harn"))
  assert(contains(source, "bump_fleet.harn"))
  assert(contains(source, "wait_fleet_convergence.harn"))
  assert(contains(source, "--fleet-root"))
  assert_eq(contains(source, "dispatch_bump_fleet.harn"), false)
}

/**
 * API authentication does not authenticate raw HTTPS Git. Materialization
 * includes private repositories, so the App token must be installed as a Git
 * helper before the checkout controller runs, without embedding it in a URL.
 */
pipeline test_private_fleet_clone_credentials_are_armed_before_materialization(
  harness: Harness,
  task,
) {
  const steps = workflow(harness.fs).jobs.get("converge")?.steps ?? []
  let arm_index = -1
  let materialize_index = -1
  let index = 0
  for step in steps {
    if step.name == "Arm Git credentials for private fleet clones" {
      arm_index = index
      assert_eq(step.env?.get("GH_TOKEN"), "$" + "{{ steps.app-token.outputs.token }}")
      assert(contains(step.run ?? "", "gh auth setup-git --hostname github.com"))
      assert_eq(contains(step.run ?? "", "x-access-token:"), false)
    }
    if contains(step.run ?? "", "materialize_fleet.harn") {
      materialize_index = index
    }
    index = index + 1
  }
  assert(arm_index >= 0)
  assert(materialize_index > arm_index)
}

pipeline test_hosted_bump_token_has_only_required_write_scopes(harness: Harness, task) {
  const projected = workflow(harness.fs)
  let minted = []
  let minted_count = 0
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if starts_with(step.uses ?? "", "actions/create-github-app-token@") {
        minted = minted + [(step.with ?? {}).keys().sorted()]
        minted_count = minted_count + 1
      }
    }
  }
  const required_scopes = [
    "client-id",
    "owner",
    "permission-actions",
    "permission-contents",
    "permission-pull-requests",
    "private-key",
  ]
  assert_eq(minted_count, 7)
  for scopes in minted {
    assert_eq(scopes, required_scopes)
  }
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if starts_with(step.uses ?? "", "actions/create-github-app-token@") {
        assert_eq(step.with["permission-contents"], "write")
      }
    }
  }
}

/**
 * GitHub App installation tokens expire after one hour. Fleet observation can
 * legitimately outlive that, so every bounded observation epoch must mint its
 * own token immediately before polling instead of borrowing the job's startup
 * token. The timeout margin leaves enough time for action and API teardown.
 */
pipeline test_convergence_waits_use_fresh_bounded_token_epochs(harness: Harness, task) {
  const job = workflow(harness.fs).jobs.get("converge")
  const steps = job?.steps ?? []
  assert_eq(job?.env?.FLEET_TOKEN_EPOCH_TIMEOUT_S, "3000")
  let waits = 0
  let previous = nil
  for step in steps {
    if contains(step.run ?? "", "wait_fleet_convergence.harn") {
      waits = waits + 1
      assert(starts_with(previous?.uses ?? "", "actions/create-github-app-token@"))
      const token_ref = "$" + "{{ steps." + (previous?.id ?? "") + ".outputs.token }}"
      assert_eq(step.env?.GH_TOKEN, token_ref)
      assert_eq(step.env?.GITHUB_TOKEN, token_ref)
      assert(contains(step.run ?? "", "--timeout-s \"$FLEET_TOKEN_EPOCH_TIMEOUT_S\""))
      assert_eq(contains(step.run ?? "", "--timeout-s 7200"), false)
    }
    previous = step
  }
  assert_eq(waits, 3)
}

pipeline test_failed_convergence_runs_bounded_repair_then_reproves(harness: Harness, task) {
  const projected = workflow(harness.fs)
  let converge = nil
  let observe = nil
  let repair = nil
  let prove = nil
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if step.name == "Converge Harn consumers" {
        converge = step
      }
      if step.name == "Observe fleet convergence" {
        observe = step
      }
      if step.name == "Repair failed downstream bump pull requests" {
        repair = step
      }
      if step.name == "Prove fleet convergence" {
        prove = step
      }
    }
  }
  assert_eq(converge?.["continue-on-error"], true)
  assert_eq(observe?.["continue-on-error"], true)
  assert(contains(repair?.if ?? "", "observe-convergence.outcome == 'failure'"))
  assert(contains(repair?.run ?? "", "repair_fleet_convergence.harn"))
  assert(contains(repair?.run ?? "", "--fleet-root \"$FLEET_ROOT\" --max-attempts 2"))
  assert(!contains(repair?.run ?? "", "--max-repositories"))
  assert(contains(repair?.env?.OPENROUTER_API_KEY ?? "", "secrets.OPENROUTER_API_KEY"))
  assert(contains(repair?.env?.CEREBRAS_API_KEY ?? "", "secrets.CEREBRAS_API_KEY"))
  assert_eq(repair?.["continue-on-error"], true)
  assert_eq(prove?.if, "always()")
  assert_eq(prove?.["continue-on-error"], true)
  assert(contains(prove?.run ?? "", "fleet-convergence-final-receipt.json"))
}

pipeline test_scoped_bump_preserves_one_scope_through_observe_repair_and_proof(
  harness: Harness,
  task,
) {
  const steps = workflow(harness.fs).jobs.get("converge")?.steps ?? []
  let consumers = 0
  for step in steps {
    const run = step.run ?? ""
    if contains(run, "materialize_fleet.harn")
      || contains(run, "bump_fleet.harn")
      || contains(run, "wait_fleet_convergence.harn")
      || contains(run, "repair_fleet_convergence.harn") {
      consumers = consumers + 1
      assert_eq(step.env?.ONLY, "$" + "{{ inputs.only }}")
      assert(contains(run, "args+=(--only \"$ONLY\")"))
    }
  }
  assert_eq(consumers, 6)
}
