    assert(contains(source, "--summary-file runtime-usage/${name}.json"))
  }
  assert(contains(source, "include-hidden-files: true"))
}

pipeline test_failed_target_resolution_stops_unprepared_dependents(harness: Harness, task: any) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let guarded = []
  for step in steps {
    if step.name == "Mint proof GitHub App token"
      || step.name == "Prove Harn updates"
      || step.name
        == "Schedule the next hosted round when proof is still incomplete"
      || step.name
        == "Mint projection verification GitHub App token"
      || step.name == "Require exact update proof" {
      guarded = guarded + [step]
    }
  }
  assert_eq(len(guarded), 5)
  for step in guarded {
    assert(contains(step.if ?? "", "always()"))
    assert(contains(step.if ?? "", "steps.update-plan.outcome == 'success'"))
    assert(requires_valid_dispatch_lineage(step.if ?? ""))
  }
}

pipeline test_rejected_predecessor_cannot_reach_proof_upload_or_schedule(
  harness: Harness,
  task: any,
) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  const guarded_names = [
    "Check Harn updates",
    "Persist repair launch receipt before provider credentials",
    "Mint repair GitHub App token",
    "Repair failed Harn updates",
    "Mint proof GitHub App token",
    "Prove Harn updates",
    "Upload dispatch continuation for successor",
    "Schedule the next hosted round when proof is still incomplete",
    "Mint projection verification GitHub App token",
    "Verify remote fleet projections",
    "Persist exact runtime cost receipt",
    "Upload fleet receipts",
    "Require exact update proof",
  ]
  let reached = 0
  let admission = nil
  for step in steps {
    if step.name == "Admit initial or validated dispatch lineage" {
      admission = step
    }
    if guarded_names.contains(step.name ?? "") {
      reached = reached + 1
      assert(requires_valid_dispatch_lineage(step.if ?? ""))
    }
  }
  assert_eq(reached, len(guarded_names), "the negative control must inspect every side effect")
  assert_eq(admission?.if, "always() && steps.update-plan.outcome == 'success'")
  assert(
    contains(
      admission?.run ?? "",
      "if [[ \"$NEEDS_PREDECESSOR\" == \"false\" || \"$VALIDATION_OUTCOME\" == \"success\" ]]; then",
    ),
  )
  assert(contains(admission?.run ?? "", "proof and side effects are blocked"))
  assert_eq(
    requires_valid_dispatch_lineage("always() && steps.update-plan.outcome == 'success'"),
    false,
    "the old under-gated condition must fail the control",
  )
}

pipeline test_reruns_restore_attempt_qualified_artifacts_without_redispatch_or_overwrite(
  harness: Harness,
  task: any,
) {
  const source = workflow_source(harness.fs)
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let start = nil
  let restore = nil
  let persist = nil
  for step in steps {
    if step.name == "Start Harn updates" {
      start = step
    }
    if step.name == "Restore predecessor dispatch continuation" {
      restore = step
    }
    if step.name == "Upload dispatch continuation for successor" {
      persist = step
    }
  }
  assert(contains(source, "if (( GITHUB_RUN_ATTEMPT > 1 )); then"))
  assert(contains(source, "predecessor_run_id=\"$GITHUB_RUN_ID\""))
  assert(contains(source, "predecessor_run_attempt=\"$((GITHUB_RUN_ATTEMPT - 1))\""))
  assert(contains(start?.if ?? "", "steps.dispatch-lineage.outcome == 'success'"))
  assert(contains(start?.if ?? "", "steps.update-plan.outputs.needs_predecessor == 'false'"))
  assert_eq(restore?.if, "steps.update-plan.outputs.needs_predecessor == 'true'")
  assert(contains(to_string(restore?.with?.get("name") ?? ""), "predecessor_artifact_name"))
  assert(
    is_attempt_qualified_immutable_artifact(
      persist?.with?.get("name"),
      persist?.with?.get("overwrite"),
    ),
  )
  assert_eq(
    is_attempt_qualified_immutable_artifact("harn-update-dispatch-continuation", true),
    false,
    "the old fixed-name overwrite must fire the negative control",
  )
  const expression = "$"
  assert(
    contains(
      source,
      "harn-update-receipts-"
        + expression
        + "{{ github.run_id }}-"
        + expression
        + "{{ github.run_attempt }}",
    ),
  )
  assert_eq(
    contains(
      source.replace("if (( GITHUB_RUN_ATTEMPT > 1 )); then", "if false; then"),
      "if (( GITHUB_RUN_ATTEMPT > 1 )); then",
    ),
    false,
    "removing the rerun branch must fire the negative control",
  )
}

pipeline test_repair_launch_receipt_precedes_repair_credentials(harness: Harness, task: any) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let receipt_index = -1
  let token_index = -1
  let repair_index = -1
  let index = 0
  for step in steps {
    if step.name == "Persist repair launch receipt before provider credentials" {
      receipt_index = index
      assert(contains(step.run ?? "", "\"status\":\"launch_pending\""))
      assert_eq(step.env?.CEREBRAS_API_KEY, nil)
    }
    if step.name == "Mint repair GitHub App token" {
      token_index = index
    }
    if step.name == "Repair failed Harn updates" {
      repair_index = index
      assert(contains(step.run ?? "", "harn_startup_failed_before_controller_entry"))
    }
    index = index + 1
  }
  assert(receipt_index >= 0)
  assert(token_index > receipt_index)
  assert(repair_index > token_index)
}

pipeline test_scoped_bump_preserves_one_scope_through_observe_repair_and_proof(
  harness: Harness,
  task: any,
) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let consumers = 0
  for step in steps {
    const run = step.run ?? ""
    if contains(run, "materialize_fleet.harn --")
      || contains(run, "bump_fleet.harn --")
      || contains(run, "wait_fleet_convergence.harn --")
      || contains(run, "repair_fleet_convergence.harn --")
      || contains(run, "continue_harn_update.harn --") {
      consumers = consumers + 1
      assert_eq(step.env?.ONLY, "$" + "{{ inputs.only }}")
      assert(contains(run, "args+=(--only \"$ONLY\")"))
    }
  }
  assert_eq(consumers, 6)
}

/**
 * The daily scheduled trigger carries no version input, so target resolution
 * asks the GitHub API for the latest Harn release. gh refuses to call the API
 * in a hosted workflow without a token, so every scheduled round died during
 * target resolution (observed 2026-08-15) while dispatched continuation
 * rounds, which pass an explicit version, sailed past the same step.
 */
pipeline test_scheduled_target_resolution_carries_a_token(harness: Harness, task: any) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let resolve = nil
  for step in steps {
    if step.name == "Resolve exact update target and bounded round" {
      resolve = step
    }
  }
  assert(resolve != nil)
  assert(contains(resolve?.run ?? "", "releases/latest"))
  assert_eq(resolve?.env?.get("GH_TOKEN"), "$" + "{{ github.token }}")
}
