import { decode_github_workflow, github_projection_has_trigger } from "../lib/github_workflow"

fn workflow(fs: HarnessFs) {
  return decode_github_workflow(
    fs.read_text(path_join(dirname(fs.cwd()), ".github", "workflows", "bump-fleet.yml")),
  )
}

pipeline test_hosted_bump_runs_the_canonical_controller(harness: Harness, task) {
  const projected = workflow(harness.fs)
  assert(github_projection_has_trigger(projected, "workflow_dispatch"))
  let source = ""
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      source = source + "\n" + (step.run ?? "")
    }
  }
  assert(contains(source, "materialize_fleet.harn"))
  assert(contains(source, "bump_fleet.harn"))
  assert(contains(source, "wait_fleet_convergence.harn"))
  assert(contains(source, "--fleet-root"))
  assert_eq(contains(source, "dispatch_bump_fleet.harn"), false)
}

pipeline test_hosted_bump_token_has_only_required_write_scopes(harness: Harness, task) {
  const projected = workflow(harness.fs)
  let minted = []
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if starts_with(step.uses ?? "", "actions/create-github-app-token@") {
        minted = minted + [(step.with ?? {}).keys().sorted()]
      }
    }
  }
  assert_eq(
    minted,
    [
      [
        "client-id",
        "owner",
        "permission-actions",
        "permission-contents",
        "permission-pull-requests",
        "private-key",
      ],
    ],
  )
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if starts_with(step.uses ?? "", "actions/create-github-app-token@") {
        assert_eq(step.with["permission-contents"], "write")
      }
    }
  }
}

pipeline test_failed_convergence_runs_bounded_repair_then_reproves(harness: Harness, task) {
  const projected = workflow(harness.fs)
  let observe = nil
  let repair = nil
  let prove = nil
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if step.name == "Observe fleet convergence" {
        observe = step
      }
      if step.name == "Repair failed downstream bump pull requests" {
        repair = step
      }
      if step.name == "Prove fleet convergence" {
        prove = step
      }
    }
  }
  assert_eq(observe?.["continue-on-error"], true)
  assert(contains(repair?.if ?? "", "observe-convergence.outcome == 'failure'"))
  assert(contains(repair?.run ?? "", "repair_fleet_convergence.harn"))
  assert(contains(repair?.run ?? "", "--max-repositories 2 --max-attempts 2"))
  assert(contains(repair?.env?.OPENROUTER_API_KEY ?? "", "secrets.OPENROUTER_API_KEY"))
  assert(contains(repair?.env?.CEREBRAS_API_KEY ?? "", "secrets.CEREBRAS_API_KEY"))
  assert_eq(prove?.if, "always()")
  assert(contains(prove?.run ?? "", "fleet-convergence-final-receipt.json"))
}
