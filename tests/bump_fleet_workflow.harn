import { decode_github_workflow, github_projection_has_trigger } from "../lib/github_workflow"
import { harn_update_continuation_workflow_probe } from "../lib/harn_update_continuation"

fn workflow_source(fs: HarnessFs) -> string {
  return fs.read_text(path_join(dirname(fs.cwd()), ".github", "workflows", "bump-fleet.yml"))
}

fn workflow(fs: HarnessFs) {
  return decode_github_workflow(workflow_source(fs))
}

fn requires_valid_dispatch_lineage(condition: string) -> bool {
  return contains(condition, "steps.dispatch-lineage.outcome == 'success'")
}

fn is_attempt_qualified_immutable_artifact(name: any, overwrite: any) -> bool {
  return contains(to_string(name ?? ""), "artifact_name") && overwrite == nil
}

pipeline test_hosted_bump_runs_the_canonical_controller(harness: Harness, task: any) {
  const projected = workflow(harness.fs)
  assert(github_projection_has_trigger(projected, "workflow_dispatch"))
  let source = ""
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      source = source + "\n" + (step.run ?? "")
    }
  }
  assert(contains(source, "materialize_fleet.harn"))
  assert(contains(source, "bump_fleet.harn"))
  assert(contains(source, "wait_fleet_convergence.harn"))
  assert(contains(source, "--fleet-root"))
  assert_eq(contains(source, "dispatch_bump_fleet.harn"), false)
}

/**
 * API authentication does not authenticate raw HTTPS Git. Materialization
 * includes private repositories, so the App token must be installed as a Git
 * helper before the checkout controller runs, without embedding it in a URL.
 */
pipeline test_private_fleet_clone_credentials_are_armed_before_materialization(
  harness: Harness,
  task: any,
) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let arm_index = -1
  let materialize_index = -1
  let index = 0
  for step in steps {
    if step.name == "Arm Git credentials for private fleet clones" {
      arm_index = index
      assert_eq(step.env?.get("GH_TOKEN"), "$" + "{{ steps.app-token.outputs.token }}")
      assert(contains(step.run ?? "", "gh auth setup-git --hostname github.com"))
      assert_eq(contains(step.run ?? "", "x-access-token:"), false)
    }
    if contains(step.run ?? "", "materialize_fleet.harn") {
      materialize_index = index
    }
    index = index + 1
  }
  assert(arm_index >= 0)
  assert(materialize_index > arm_index)
}

pipeline test_hosted_repair_enters_the_brokered_release_environment(harness: Harness, task: any) {
  const source = workflow_source(harness.fs)
  assert(contains(source, "environment: release"))
  assert(!contains(source, "OPENROUTER_API_KEY"))
  assert(!contains(source, "FIREWORKS_API_KEY"))
  assert(contains(source, "CEREBRAS_API_KEY: $" + "{{ secrets.CEREBRAS_API_KEY }}"))
  assert(!contains(source, "HARN_UPDATE_PROVIDER_SECRET_REFERENCE"))
  assert(contains(source, "--provider-secret-reference CEREBRAS_API_KEY"))
  assert(contains(source, "HARN_UPDATE_VALUE_PROVIDER: cerebras"))
  assert(contains(source, "HARN_UPDATE_VALUE_MODEL: gpt-oss-120b"))
  assert(contains(source, "HARN_UPDATE_STRONG_PROVIDER: cerebras"))
  assert(contains(source, "HARN_UPDATE_STRONG_MODEL: zai-glm-4.7"))
}

pipeline test_hosted_repair_bootstraps_the_exact_target_runtime(harness: Harness, task: any) {
  const source = workflow_source(harness.fs)
  assert(contains(source, "- name: Resolve exact update target and bounded round"))
  assert(contains(source, "- name: Install exact target Harn"))
  assert(contains(source, "version: $" + "{{ steps.update-plan.outputs.target }}"))
  assert(!contains(source, "HARN_UPDATE_CONTROLLER_REVISION"))
  assert(contains(source, "--controller-revision \"$" + "{{ github.sha }}\""))
}

pipeline test_hosted_bump_token_has_only_required_write_scopes(harness: Harness, task: any) {
  const projected = workflow(harness.fs)
  let minted = []
  let minted_count = 0
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if starts_with(step.uses ?? "", "actions/create-github-app-token@") {
        minted = minted + [(step.with ?? {}).keys().sorted()]
        minted_count = minted_count + 1
      }
    }
  }
  const required_scopes = [
    "client-id",
    "owner",
    "permission-actions",
    "permission-contents",
    "permission-pull-requests",
    "permission-workflows",
    "private-key",
  ]
  assert_eq(minted_count, 6)
  for scopes in minted {
    assert_eq(scopes, required_scopes)
  }
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if starts_with(step.uses ?? "", "actions/create-github-app-token@") {
        assert_eq(step.with["permission-contents"], "write")
      }
    }
  }
}

pipeline test_continuation_authority_is_preflighted_before_fleet_work(harness: Harness, task: any) {
  const source = workflow_source(harness.fs)
  const ready = harn_update_continuation_workflow_probe(source)
  assert_eq(ready, {ok: true, reason: "controller_token_and_preflight_ready"})
  // Negative control: the same production projection without Workflows write
  // permission must be measured as blocked, not as an empty or missing read.
  const under_scoped = harn_update_continuation_workflow_probe(
    source.replace("          permission-workflows: write\n", ""),
  )
  assert_eq(under_scoped.ok, false)
  assert(contains(under_scoped.reason, "lacks controller lease scopes"))
}

pipeline test_authorization_failure_receipt_is_persisted_before_the_preflight_fails(
  harness: Harness,
  task: any,
) {
  const root = dirname(harness.fs.cwd())
  const script = harness.fs.read_text(path_join(root, "preflight_harn_update_continuation.harn"))
  const write_index = script.index_of("harness.fs.write_text(options.receipt, rendered)")
  const failure_index = script.index_of("if !receipt.authorized")
  assert(write_index >= 0)
  assert(failure_index > write_index)
  assert(
    contains(workflow_source(harness.fs), "fleet-update-continuation-authorization-receipt.json"),
  )
}

/**
 * GitHub App installation tokens expire after one hour. Fleet observation can
 * legitimately outlive that, so every bounded observation period must mint its
 * own token immediately before polling instead of borrowing the job's startup
 * token. The timeout margin leaves enough time for action and API teardown.
 */
pipeline test_convergence_waits_use_fresh_bounded_tokens(harness: Harness, task: any) {
  const job = workflow(harness.fs).jobs.get("update")
  const steps = job?.steps ?? []
  assert_eq(job?.env?.FLEET_TOKEN_EPOCH_TIMEOUT_S, "3000")
  let waits = 0
  let previous = nil
  for step in steps {
    if contains(step.run ?? "", "wait_fleet_convergence.harn") {
      waits = waits + 1
      assert(starts_with(previous?.uses ?? "", "actions/create-github-app-token@"))
      const token_ref = "$" + "{{ steps." + (previous?.id ?? "") + ".outputs.token }}"
      assert_eq(step.env?.GH_TOKEN, token_ref)
      assert_eq(step.env?.GITHUB_TOKEN, token_ref)
      assert(contains(step.run ?? "", "--timeout-s \"$FLEET_TOKEN_EPOCH_TIMEOUT_S\""))
      assert_eq(contains(step.run ?? "", "--timeout-s 7200"), false)
    }
    previous = step
  }
  assert_eq(waits, 2)
}

pipeline test_failed_convergence_runs_bounded_repair_then_reproves(harness: Harness, task: any) {
  const projected = workflow(harness.fs)
  let converge = nil
  let observe = nil
  let repair = nil
  let prove = nil
  for job in projected.jobs {
    for step in job.value.steps ?? [] {
      if step.name == "Start Harn updates" {
        converge = step
      }
      if step.name == "Check Harn updates" {
        observe = step
      }
      if step.name == "Repair failed Harn updates" {
        repair = step
      }
      if step.name == "Prove Harn updates" {
        prove = step
      }
    }
  }
  assert_eq(converge?.["continue-on-error"], true)
  assert(contains(converge?.run ?? "", "--continuation-receipt fleet-dispatch-continuation.json"))
  assert_eq(observe?.["continue-on-error"], true)
  assert(contains(observe?.run ?? "", "--continuation-receipt fleet-dispatch-continuation.json"))
  assert(contains(repair?.if ?? "", "observe-convergence.outcome == 'failure'"))
  assert(contains(repair?.run ?? "", "repair_fleet_convergence.harn"))
  assert(contains(repair?.run ?? "", "--fleet-root \"$FLEET_ROOT\""))
  assert(contains(repair?.run ?? "", "--max-attempts 3"))
  assert(contains(repair?.run ?? "", "--max-cost-per-repository-usd 0.90"))
  assert(contains(repair?.run ?? "", "--max-cost-per-run-usd 4.00"))
  assert(contains(repair?.run ?? "", "--continuation-receipt fleet-dispatch-continuation.json"))
  assert(contains(repair?.run ?? "", "--write-root \"$FLEET_ROOT\""))
  assert(contains(repair?.run ?? "", "--sandbox-write-root \"$FLEET_ROOT\""))
  const expression = "$"
  assert_eq(repair?.env?.FLEET_ROOT, expression + "{{ github.workspace }}/.fleet")
  assert(contains(repair?.run ?? "", "--allow-process-network"))
  assert(contains(repair?.run ?? "", "--environment-policy granted"))
  assert(!contains(repair?.run ?? "", "--no-sandbox"))
  assert(contains(repair?.run ?? "", "repair_provider=env:CEREBRAS_API_KEY"))
  assert_eq(repair?.env?.HARN_EGRESS_ALLOW, "api.github.com:443,api.cerebras.ai:443")
  assert_eq(repair?.env?.HARN_EGRESS_DEFAULT, "deny")
  assert_eq(repair?.env?.HARN_EGRESS_BLOCK_PRIVATE, "private")
  assert(contains(repair?.run ?? "", "repair_egress_allow=env:HARN_EGRESS_ALLOW"))
  assert(contains(repair?.run ?? "", "repair_egress_default=env:HARN_EGRESS_DEFAULT"))
  assert(contains(repair?.run ?? "", "repair_egress_private=env:HARN_EGRESS_BLOCK_PRIVATE"))
  assert(!contains(repair?.env?.HARN_EGRESS_ALLOW ?? "", "*"))
  assert(!contains(repair?.run ?? "", "--max-repositories"))
  assert_eq(repair?.env?.OPENROUTER_API_KEY, nil)
  assert(contains(repair?.env?.CEREBRAS_API_KEY ?? "", "secrets.CEREBRAS_API_KEY"))
  assert_eq(repair?.["continue-on-error"], true)
  assert(contains(prove?.if ?? "", "always()"))
  assert(requires_valid_dispatch_lineage(prove?.if ?? ""))
  assert_eq(prove?.["continue-on-error"], true)
  assert(contains(prove?.run ?? "", "--continuation-receipt fleet-dispatch-continuation.json"))
  assert(contains(prove?.run ?? "", "fleet-convergence-proof-receipt.json"))
}

pipeline test_incomplete_proof_schedules_one_fresh_hosted_round(harness: Harness, task: any) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let continuation = nil
  let repair_count = 0
  for step in steps {
    if step.name == "Schedule the next hosted round when proof is still incomplete" {
      continuation = step
    }
    if contains(step.run ?? "", "repair_fleet_convergence.harn") {
      repair_count = repair_count + 1
    }
  }
  assert(contains(continuation?.if ?? "", "always()"))
  assert(requires_valid_dispatch_lineage(continuation?.if ?? ""))
  assert(
    contains(continuation?.if ?? "", "steps.persist-dispatch-continuation.outcome == 'success'"),
  )
  assert(contains(continuation?.run ?? "", "continue_harn_update.harn"))
  assert(contains(continuation?.run ?? "", "--proof-receipt fleet-convergence-proof-receipt.json"))
  assert(contains(continuation?.run ?? "", "--chain-id \"$CHAIN_ID\""))
  assert(contains(continuation?.run ?? "", "--controller-revision \"$GITHUB_SHA\""))
  assert_eq(continuation?.env?.TARGET, "$" + "{{ steps.update-plan.outputs.target }}")
  assert_eq(continuation?.env?.CHAIN_ID, "$" + "{{ steps.update-plan.outputs.chain_id }}")
  assert(contains(workflow_source(harness.fs), "run-name: Update Harn fleet /"))
  assert_eq(repair_count, 1)
}

pipeline test_successor_restores_exact_predecessor_before_fleet_work(harness: Harness, task: any) {
  const projected = workflow(harness.fs)
  const predecessor = projected.workflow_dispatch?.inputs?.get("predecessor_run_id")
  const predecessor_attempt = projected.workflow_dispatch?.inputs?.get("predecessor_run_attempt")
  assert(predecessor != nil, "successor dispatch must declare its predecessor run")
  assert_eq(predecessor?.type, "string")
  assert(predecessor_attempt != nil, "successor dispatch must declare its predecessor attempt")
  assert_eq(predecessor_attempt?.type, "string")
  const steps = projected.jobs.get("update")?.steps ?? []
  let restore = nil
  let validate = nil
  let start = nil
  let observe = nil
  let persist = nil
  let schedule = nil
  let restore_index = -1
  let validate_index = -1
  let start_index = -1
  let observe_index = -1
  let persist_index = -1
  let schedule_index = -1
  let index = 0
  for step in steps {
    if step.name == "Restore predecessor dispatch continuation" {
      restore = step
      restore_index = index
    }
    if step.name == "Validate predecessor dispatch continuation" {
      validate = step
      validate_index = index
    }
    if step.name == "Start Harn updates" {
      start = step
      start_index = index
    }
    if step.name == "Check Harn updates" {
      observe = step
      observe_index = index
    }
    if step.name == "Upload dispatch continuation for successor" {
      persist = step
      persist_index = index
    }
    if step.name == "Schedule the next hosted round when proof is still incomplete" {
      schedule = step
      schedule_index = index
    }
    index = index + 1
  }
  assert(starts_with(restore?.uses ?? "", "actions/download-artifact@"))
  assert_eq(
    restore?.with?.get("name"),
    "$" + "{{ steps.update-plan.outputs.predecessor_artifact_name }}",
  )
  assert_eq(
    restore?.with?.get("run-id"),
    "$" + "{{ steps.update-plan.outputs.predecessor_run_id }}",
  )
  assert(contains(validate?.run ?? "", "validate_fleet_dispatch_continuation.harn"))
  assert(contains(validate?.run ?? "", "--current-run-id \"$GITHUB_RUN_ID\""))
  assert(contains(validate?.run ?? "", "--current-run-attempt \"$GITHUB_RUN_ATTEMPT\""))
  assert(contains(validate?.run ?? "", "--predecessor-run-attempt"))
  assert(contains(validate?.run ?? "", "args+=(--only \"$ONLY\")"))
  assert(restore_index >= 0 && validate_index > restore_index)
  assert(start_index > validate_index && observe_index > validate_index)
  assert(contains(start?.if ?? "", "steps.dispatch-lineage.outcome == 'success'"))
  assert(contains(start?.if ?? "", "steps.update-plan.outputs.needs_predecessor == 'false'"))
  assert(starts_with(persist?.uses ?? "", "actions/upload-artifact@"))
  assert_eq(persist?.with?.get("name"), "$" + "{{ steps.update-plan.outputs.artifact_name }}")
  assert_eq(persist?.with?.get("overwrite"), nil)
  assert(persist_index > observe_index && schedule_index > persist_index)
  assert(contains(schedule?.if ?? "", "steps.persist-dispatch-continuation.outcome == 'success'"))
  assert(contains(schedule?.run ?? "", "--controller-run-id \"$GITHUB_RUN_ID\""))
  assert(contains(schedule?.run ?? "", "--controller-run-attempt \"$GITHUB_RUN_ATTEMPT\""))
  assert(
    contains(
      workflow_source(harness.fs),
      "continuation rounds require an exact positive predecessor run ID and attempt",
    ),
  )
}

pipeline test_hosted_artifact_keeps_startup_and_terminal_authority_receipts(
  harness: Harness,
  task: any,
) {
  const source = workflow_source(harness.fs)
  assert(contains(source, "fleet-repair-startup-receipt.json"))
  assert(contains(source, "fleet-dispatch-continuation.json"))
  assert(contains(source, "fleet-repair-bootstrap-failure-receipt.json"))
  assert(contains(source, "fleet-repair-receipt.json"))
  assert(contains(source, "fleet-convergence-proof-receipt.json"))
  assert(contains(source, "fleet-runtime-cost-receipt.json"))
  assert(contains(source, "harn_bump_fleet.runtime_cost.v2"))
