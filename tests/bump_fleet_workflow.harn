pipeline test_unproven_round_names_the_blocking_repositories(harness: Harness, task: any) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  const proof = steps.find({ step -> step.name == "Require exact update proof" })
  assert(proof != nil, "the hosted round must keep an exact update proof gate")
  const script = (proof ?? {}).run ?? ""
  assert(contains(script, "fleet-convergence-proof-receipt.json"))
  assert(
    contains(script, "select(.state != \"proven\")"),
    "the failure must name the unproven repositories instead of leaving the receipt to be parsed",
  )
  assert(contains(script, "unproven: \\(.repo) [\\(.state)] \\(.reason)"))
}

pipeline test_failed_target_resolution_stops_unprepared_dependents(harness: Harness, task: any) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let guarded = []
  for step in steps {
    if step.name == "Mint proof GitHub App token"
      || step.name == "Prove Harn updates"
      || step.name
        == "Schedule the next hosted round when proof is still incomplete"
      || step.name
        == "Mint projection verification GitHub App token"
      || step.name == "Require exact update proof" {
      guarded = guarded + [step]
    }
  }
  assert_eq(len(guarded), 5)
  for step in guarded {
    assert(contains(step.if ?? "", "always()"))
    assert(contains(step.if ?? "", "steps.update-plan.outcome == 'success'"))
    assert(requires_valid_dispatch_lineage(step.if ?? ""))
  }
}

pipeline test_rejected_predecessor_cannot_reach_proof_upload_or_schedule(
  harness: Harness,
  task: any,
) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  const guarded_names = [
    "Check Harn updates",
    "Persist repair launch receipt before provider credentials",
    "Mint repair GitHub App token",
    "Repair failed Harn updates",
    "Mint proof GitHub App token",
    "Prove Harn updates",
    "Upload dispatch continuation for successor",
    "Schedule the next hosted round when proof is still incomplete",
    "Mint projection verification GitHub App token",
    "Verify remote fleet projections",
    "Persist exact runtime cost receipt",
    "Upload fleet receipts",
    "Require exact update proof",
  ]
  let reached = 0
  let admission = nil
  for step in steps {
    if step.name == "Admit initial or validated dispatch lineage" {
      admission = step
    }
    if guarded_names.contains(step.name ?? "") {
      reached = reached + 1
      assert(requires_valid_dispatch_lineage(step.if ?? ""))
    }
  }
  assert_eq(reached, len(guarded_names), "the negative control must inspect every side effect")
  assert_eq(
    admission?.if,
    "always() && steps.update-plan.outcome == 'success' && steps.require-release-ready.outcome == 'success'",
  )
  assert(
    contains(
      admission?.run ?? "",
      "if [[ \"$NEEDS_PREDECESSOR\" == \"false\" || \"$VALIDATION_OUTCOME\" == \"success\" ]]; then",
    ),
  )
  assert(contains(admission?.run ?? "", "proof and side effects are blocked"))
  assert_eq(
    requires_valid_dispatch_lineage("always() && steps.update-plan.outcome == 'success'"),
    false,
    "the old under-gated condition must fail the control",
  )
}

pipeline test_reruns_restore_attempt_qualified_artifacts_without_redispatch_or_overwrite(
  harness: Harness,
  task: any,
) {
  const source = workflow_source(harness.fs)
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let start = nil
  let restore = nil
  let persist = nil
  for step in steps {
    if step.name == "Start Harn updates" {
      start = step
    }
    if step.name == "Restore predecessor dispatch continuation" {
      restore = step
    }
    if step.name == "Upload dispatch continuation for successor" {
      persist = step
    }
  }
  assert(contains(source, "if (( GITHUB_RUN_ATTEMPT > 1 )); then"))
  assert(contains(source, "predecessor_run_id=\"$GITHUB_RUN_ID\""))
  assert(contains(source, "predecessor_run_attempt=\"$((GITHUB_RUN_ATTEMPT - 1))\""))
  assert(contains(start?.if ?? "", "steps.dispatch-lineage.outcome == 'success'"))
  assert(contains(start?.if ?? "", "steps.update-plan.outputs.needs_predecessor == 'false'"))
  assert_eq(restore?.if, "steps.update-plan.outputs.needs_predecessor == 'true'")
  assert(contains(to_string(restore?.with?.get("name") ?? ""), "predecessor_artifact_name"))
  assert(
    is_attempt_qualified_immutable_artifact(
      persist?.with?.get("name"),
      persist?.with?.get("overwrite"),
    ),
  )
  assert_eq(
    is_attempt_qualified_immutable_artifact("harn-update-dispatch-continuation", true),
    false,
    "the old fixed-name overwrite must fire the negative control",
  )
  const expression = "$"
  assert(
    contains(
      source,
      "harn-update-receipts-"
        + expression
        + "{{ github.run_id }}-"
        + expression
        + "{{ github.run_attempt }}",
    ),
  )
  assert_eq(
    contains(
      source.replace("if (( GITHUB_RUN_ATTEMPT > 1 )); then", "if false; then"),
      "if (( GITHUB_RUN_ATTEMPT > 1 )); then",
    ),
    false,
    "removing the rerun branch must fire the negative control",
  )
}

pipeline test_repair_launch_receipt_precedes_repair_credentials(harness: Harness, task: any) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let receipt_index = -1
  let token_index = -1
  let repair_index = -1
  let index = 0
  for step in steps {
    if step.name == "Persist repair launch receipt before provider credentials" {
      receipt_index = index
      assert(contains(step.run ?? "", "\"status\":\"launch_pending\""))
      assert_eq(step.env?.CEREBRAS_API_KEY, nil)
    }
    if step.name == "Mint repair GitHub App token" {
      token_index = index
    }
    if step.name == "Repair failed Harn updates" {
      repair_index = index
      assert(contains(step.run ?? "", "harn_startup_failed_before_controller_entry"))
    }
    index = index + 1
  }
  assert(receipt_index >= 0)
  assert(token_index > receipt_index)
  assert(repair_index > token_index)
}

pipeline test_scoped_bump_preserves_one_scope_through_every_controller_entrypoint(
  harness: Harness,
  task: any,
) {
  const projected = workflow(harness.fs)
  const repositories = projected.workflow_dispatch?.inputs?.get("repositories_json")
  assert_eq(repositories?.type, "string")
  assert_eq(repositories?.required, false)
  const source = workflow_source(harness.fs)
  assert_eq(source.split("\n")[1], "run-name: " + fleet_workflow_chain_run_name())
  assert_eq(projected.workflow_dispatch?.inputs?.get("scope_digest")?.type, "string")
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  const preflight = steps.find({ step -> step.name == "Validate exact fleet scope identity" })
  assert_eq(preflight?.env?.ONLY, "$" + "{{ inputs.only }}")
  assert_eq(preflight?.env?.REPOSITORIES_JSON, "$" + "{{ inputs.repositories_json }}")
  assert_eq(preflight?.env?.SCOPE_DIGEST, "$" + "{{ inputs.scope_digest }}")
  assert(contains(preflight?.run ?? "", "--scope-digest \"$SCOPE_DIGEST\""))
  assert(contains(preflight?.run ?? "", "validate_fleet_scope.harn"))
  assert(contains(preflight?.run ?? "", "--require-canonical-repositories-json"))
  let preflight_index = -1
  let first_effect_index = -1
  let step_index = 0
  for step in steps {
    if step.name == "Validate exact fleet scope identity" {
      preflight_index = step_index
    }
    if step.name == "Preflight continuation controller authority" {
      first_effect_index = step_index
    }
    step_index = step_index + 1
  }
  assert(preflight_index >= 0 && first_effect_index > preflight_index)
  const consumers = [
    "Validate predecessor dispatch continuation",
    "Materialize manifest-owned fleet",
    "Start Harn updates",
    "Check Harn updates",
    "Repair failed Harn updates",
    "Prove Harn updates",
    "Schedule the next hosted round when proof is still incomplete",
    "Verify remote fleet projections",
  ]
  let reached = 0
  for step in steps {
    if consumers.contains(step.name ?? "") {
      reached = reached + 1
      assert_eq(step.env?.ONLY, "$" + "{{ inputs.only }}")
      assert_eq(step.env?.REPOSITORIES_JSON, "$" + "{{ inputs.repositories_json }}")
      assert(contains(step.run ?? "", "if [[ -n \"$ONLY\" ]]; then"))
      assert(contains(step.run ?? "", "args+=(--only \"$ONLY\")"))
      assert(contains(step.run ?? "", "if [[ -n \"$REPOSITORIES_JSON\" ]]; then"))
      assert(contains(step.run ?? "", "args+=(--repositories-json \"$REPOSITORIES_JSON\")"))
    }
  }
  assert_eq(reached, len(consumers))
}

pipeline test_direct_workflow_scope_refuses_noncanonical_title_identity_before_work(
  harness: Harness,
  task: any,
) {
  const root = dirname(harness.fs.cwd())
  const harn = pinned_test_runtime({fs: harness.fs, process: harness.process}, root)
  const entry = path_join(root, "validate_fleet_scope.harn")
  const prefix = "cd "
    + shell_quote(root)
    + " && "
    + shell_quote(harn)
    + " run --no-sandbox "
    + shell_quote(entry)
    + " -- --require-canonical-repositories-json --repositories-json "
  const canonical = harness.process.shell(
    prefix + "'[\"burin-labs/20eq\",\"burin-labs/harn-cloud\"]'",
  )
  assert(canonical.success, canonical.combined)
  const wire = "[\"burin-labs/20eq\",\"burin-labs/harn-cloud\"]"
  const digest = fleet_scope_digest(fleet_operation_scope(nil, wire))
  const bound = harness.process.shell(prefix + shell_quote(wire) + " --scope-digest " + digest)
  assert(bound.success, bound.combined)
  for invalid in ["", "wrong", fleet_scope_digest(fleet_operation_scope("burin-labs/harn-cloud"))] {
    const refused = harness.process.shell(
      prefix + shell_quote(wire) + " --scope-digest " + shell_quote(invalid),
    )
    assert(!refused.success)
    assert(contains(refused.combined, "canonical repository scope digest"), refused.combined)
  }
  const missing_controller = harness.process.shell(
    prefix + "'[\"burin-labs/20eq\",\"burin-labs/harn-cloud\"]' --require-controller",
  )
  assert_eq(missing_controller.success, false)
  assert(contains(missing_controller.combined, "required harn-bump-fleet controller"))
  const with_controller = harness.process.shell(
    prefix + "'[\"burin-labs/harn-bump-fleet\",\"burin-labs/harn-cloud\"]' --require-controller",
  )
  assert(with_controller.success, with_controller.combined)
  const noncanonical = harness.process.shell(
    prefix + "'[\"burin-labs/harn-cloud\", \"burin-labs/20eq\"]'",
  )
  assert_eq(noncanonical.success, false)
  assert(contains(noncanonical.combined, "canonical compact sorted repository list"))
}

/**
 * The daily scheduled trigger carries no version input, so target resolution
 * asks the GitHub API for the latest Harn release. gh refuses to call the API
 * in a hosted workflow without a token, so every scheduled round died during
 * target resolution (observed 2026-08-15) while dispatched continuation
 * rounds, which pass an explicit version, sailed past the same step.
 */
pipeline test_scheduled_target_resolution_carries_a_token(harness: Harness, task: any) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  let resolve = nil
  for step in steps {
    if step.name == "Resolve exact update target and bounded round" {
      resolve = step
    }
  }
  assert(resolve != nil)
  assert(contains(resolve?.run ?? "", "releases/latest"))
  assert_eq(resolve?.env?.get("GH_TOKEN"), "$" + "{{ github.token }}")
}

/**
 * Scheduled cron and chain follow-ups must not share one concurrency group.
 * The old static `group: bump-harn-fleet` discarded whichever run queued
 * second, including the daily schedule, with no jobs and no notification.
 */
pipeline test_fleet_concurrency_separates_schedule_from_chain(harness: Harness, task: any) {
  const source = workflow_source(harness.fs)
  assert(contains(source, "github.event_name == 'schedule'"))
  assert(contains(source, "bump-harn-fleet-schedule"))
  assert(contains(source, "bump-harn-fleet-chain-"))
  assert(contains(source, "inputs.chain_id || github.run_id"))
  assert(contains(source, "cancel-in-progress: false"))
  assert_eq(
    contains(source, "group: bump-harn-fleet"),
    false,
    "the old static concurrency group must be gone",
  )
}

/**
 * A run cancelled from the queue produces no jobs. This sibling workflow is
 * the durable page: it fires on the bump-fleet name, gates on cancelled, and
 * fails so GitHub treats the eviction like a failed run.
 */
pipeline test_cancelled_fleet_bump_is_reported_as_failure(harness: Harness, task: any) {
  const source = cancelled_reporter_source(harness.fs)
  const projected = decode_github_workflow(source)
  assert_eq(github_projection_has_trigger(projected, "workflow_run"), true)
  assert(contains(source, "workflows: [Update repositories for a Harn release]"))
  assert(contains(source, "types: [completed]"))
  assert(contains(source, "github.event.workflow_run.conclusion == 'cancelled'"))
  assert(contains(source, "exit 1"))
  assert(contains(source, "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a"))
  assert(contains(source, "if: always()"))
  assert(contains(source, "cancelled-fleet-bump-receipt.json"))
  assert(contains(source, "source_run_id"))
  // Folding this into bump-fleet.yml would not run when GitHub cancels the
  // parent from the queue before any job starts.
  assert_eq(contains(workflow_source(harness.fs), "report-cancelled-fleet-bump"), false)
}

/**
 * The fleet bootstraps the runtime it is rolling out, so the target release's
 * binaries have to exist before this job can run at all. That made the readiness
 * wait unreachable in the one case it exists for. On v0.10.127 a dispatch at
 * 15:43Z died at 15:45Z inside the setup action on a missing SHA256SUMS, the
 * first release asset landed at 16:10Z, and no repository was dispatched: the
 * Homebrew tap stayed on the previous release until a person dispatched it.
 *
 * The wait must therefore run before the target runtime is installed, on a
 * runtime that exists by definition, or a setup action decides the readiness
 * question by failing and nothing reports which assets were missing.
 */
pipeline test_release_readiness_is_reachable_before_the_target_runtime(
  harness: Harness,
  task: any,
) {
  const source = workflow_source(harness.fs)
  const pinned_install = source.index_of("- name: Install the pinned Harn runtime")
  const wait = source.index_of("- name: Wait for the target release to be ready")
  const target_install = source.index_of("- name: Install exact target Harn")
  assert(pinned_install >= 0, "the fleet installs a runtime that already exists")
  assert(wait >= 0, "the fleet waits for the target release to be ready")
  assert(target_install >= 0, "the fleet still installs the exact target runtime")
  assert(pinned_install < wait, "the readiness wait needs a runtime before it can run")
  assert(wait < target_install, "waiting after the target install is waiting too late")
  // The wait reaches GitHub through the installed connector package.
  const deps = source.index_of("- name: Install locked Harn dependencies for the readiness wait")
  assert(deps > pinned_install && deps < wait, "the lockfile is installed before the wait")
  // The readiness runtime must not be the target, or the deadlock is unchanged.
  const pinned_block = source.slice(pinned_install, deps)
  assert(!contains(pinned_block, "steps.update-plan.outputs.target"))
  assert(contains(pinned_block, "steps.pinned-harn.outputs.version"))
}

/**
 * Fleet run 33950604192 exhausted its readiness poll with `ready=false`, but
 * the shared wait command intentionally returned zero for skip semantics. The
 * workflow treated process success as release readiness, installed the target,
 * and reached mutation preflight with an App token minted 62 minutes earlier.
 */
pipeline test_false_readiness_blocks_target_setup_and_mints_fresh_mutation_authority(
  harness: Harness,
  task: any,
) {
  const steps = workflow(harness.fs).jobs.get("update")?.steps ?? []
  const wait_index = steps.find_index(
    { step -> step.name == "Wait for the target release to be ready" },
  )
  const gate_index = steps.find_index(
    { step -> step.name == "Require positive target release readiness" },
  )
  const target_index = steps.find_index({ step -> step.name == "Install exact target Harn" })
  const token_index = steps.find_index({ step -> step.name == "Mint fleet GitHub App token" })
  const preflight_index = steps.find_index(
    { step -> step.name == "Preflight continuation controller authority" },
  )
  const dispatch_index = steps.find_index({ step -> step.name == "Start Harn updates" })
  assert(
    wait_index >= 0 && gate_index > wait_index && target_index > gate_index
      && token_index > target_index
      && preflight_index > token_index
      && dispatch_index > preflight_index,
    "readiness, exact setup, and freshly minted mutation authority must stay ordered",
  )
  const wait = steps[wait_index]
  assert_eq(wait.id, "release-ready")
  assert_eq(wait.env?.GH_TOKEN, "$" + "{{ github.token }}")
  assert_eq(wait.env?.GITHUB_TOKEN, "$" + "{{ github.token }}")
  assert_eq(contains(wait.env?.GH_TOKEN ?? "", "app-token"), false)
  const gate = steps[gate_index]
  assert_eq(gate.env?.RELEASE_READY, "$" + "{{ steps.release-ready.outputs.ready }}")
  const false_readiness = harness.process.shell(
    "RELEASE_READY=false bash -c " + shell_quote(gate.run ?? ""),
  )
  assert_eq(false_readiness.success, false)
  assert(contains(false_readiness.combined, "repository updates remain blocked"))
  const positive_readiness = harness.process.shell(
    "RELEASE_READY=true bash -c " + shell_quote(gate.run ?? ""),
  )
  assert(positive_readiness.success, positive_readiness.combined)
  const lineage = steps.find({ step -> step.name == "Admit initial or validated dispatch lineage" })
  assert(contains(lineage?.if ?? "", "steps.require-release-ready.outcome == 'success'"))
  const lease_token = steps.find(
    { step -> step.name == "Mint chain lease release GitHub App token" },
  )
  assert(contains(lease_token?.if ?? "", "steps.require-release-ready.outcome == 'success'"))
}

/**
 * The chain lease must have an owner on every exit, including the failing ones.
 *
 * On v0.10.127 round 2 the proof step aborted, the successor scheduler died on
 * the wreckage, and nothing released `harn-update-chain/33659789177`. The lease
 * sat held at an exact OID that predates the fix while a fresh chain had to be
 * started around it. The release step therefore has to run last and
 * unconditionally, after the gate that exits 1, and it has to read the
 * scheduler's own outcome rather than guess whether a successor exists.
 */
pipeline test_every_round_ends_with_an_owner_for_the_chain_lease(harness: Harness, task: any) {
  const projected = workflow(harness.fs)
  let steps: list<any> = []
  for job in projected.jobs {
    if job.key == "update" {
      steps = job.value.steps ?? []
    }
  }
  assert(len(steps) > 0, "the update job must be projected")
  const last = unwrap(steps[len(steps) - 1])
  assert(
    contains(to_string(last.name ?? ""), "Release the chain lease"),
    "the lease release must be the LAST step, so a failing proof gate cannot skip it, got '${to_string(last.name ?? "")}'",
  )
  const condition = to_string(last.if ?? "")
  assert(
    contains(condition, "always()"),
    "the lease release must run on a failing and a cancelled round, not only a green one",
  )
  const body = to_string(last.run ?? "")
  assert(contains(body, "release_harn_update_chain.harn"))
  assert(
    contains(body, "--scheduler-outcome"),
    "the release must read whether a successor was dispatched from the scheduler's own outcome",
  )
  // The scheduler needs an id for that outcome to be readable at all. Without
  // it the expression silently evaluates to the empty string, which the script
  // would read as an unknown successor and refuse forever.
  let scheduler_id = ""
  for step in steps {
    if contains(to_string(step.name ?? ""), "Schedule the next hosted round") {
      scheduler_id = to_string(step.id ?? "")
    }
  }
  assert_eq(scheduler_id, "schedule-successor")
  assert(contains(to_string(last.env?.SCHEDULER_OUTCOME ?? ""), "steps.${scheduler_id}.outcome"))
}
