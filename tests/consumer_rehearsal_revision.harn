import { rehearsal_revision } from "../lib/consumer_rehearsal"
import { GithubClientOptions } from "harn-github-connector/default"

const TIP = "c591312c7aa0b1ee9a7c50f5b0d0f5a8e2a4b6d1"

const PIN = "0f68969aa0b1ee9a7c50f5b0d0f5a8e2a4b6d1c5"

const BASE = "https://github.test"

const OPTIONS: GithubClientOptions = {
  api_base_url: BASE,
  installation_token: "rehearsal-test-token",
}

pipeline test_unpinned_rehearsal_reads_the_connector_branch_oid(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main",
    {status: 200, body: json_stringify({name: "main", commit: {sha: TIP}})},
  )
  const revision = rehearsal_revision(harness, "octo-org/octo-repo", "main", "", OPTIONS)
  assert_eq(unwrap(revision), TIP)
}

pipeline test_release_pin_does_not_depend_on_a_moving_or_unreadable_branch(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/branches/main",
    {status: 404, body: json_stringify({message: "Not Found"})},
  )
  assert_eq(unwrap(rehearsal_revision(harness, "octo-org/octo-repo", "main", PIN, OPTIONS)), PIN)
  assert(is_err(rehearsal_revision(harness, "octo-org/octo-repo", "main", "", OPTIONS)))
}

pipeline test_malformed_revision_is_refused(harness: Harness) {
  for pin in ["nil", "c591312", "main"] {
    const result = rehearsal_revision(harness, "octo-org/octo-repo", "main", pin, OPTIONS)
    assert(is_err(result))
    assert_eq(unwrap_err(result).code, "invalid_rehearsal_revision")
  }
}
