import { shell_quote } from "std/runtime"
import { strip_v } from "std/semver"

/** Resolve only the repository pin, in the local installer or CI PATH layout. */
pub fn pinned_test_runtime(
  harness: {fs: HarnessFs, process: HarnessProcess},
  root: string,
  search_path: string? = nil,
) -> string {
  const local = path_join(root, ".harn", "bin", "harn")
  const lookup = if search_path == nil {
    ""
  } else {
    "PATH=" + shell_quote(search_path ?? "") + "; "
  }
    + "if [ -x "
    + shell_quote(local)
    + " ]; then printf '%s' "
    + shell_quote(local)
    + "; else command -v harn; fi"
  const found = harness.process.shell(lookup)
  const binary = trim(found.stdout)
  if !found.success || binary == "" {
    throw "pinned test runtime is missing"
  }
  const expected = strip_v(trim(harness.fs.read_text(path_join(root, ".harn-version"))))
  const version = harness.process.shell(shell_quote(binary) + " --version")
  if !version.success || trim(version.stdout) != "harn " + expected {
    throw "test runtime does not match repository pin " + expected
  }
  return binary
}

pipeline test_pinned_runtime_supports_ci_path_and_refuses_missing_or_wrong_version(
  harness: Harness,
  task: any,
) {
  const root = path_join(
    harness.fs.workspace_temp_dir(),
    "runtime-layout-" + harness.random.uuid_v7(),
  )
  const bin = path_join(root, "ci-bin")
  harness.fs.mkdir(bin)
  harness.fs.write_text(path_join(root, ".harn-version"), "v0.10.129\n")
  const caps = {fs: harness.fs, process: harness.process}
  const missing = try {
    pinned_test_runtime(caps, root, bin)
  } catch (error) {
    to_string(error)
  }
  assert(contains(missing, "pinned test runtime is missing"), missing)
  const executable = path_join(bin, "harn")
  harness.fs.write_text(executable, "#!/bin/sh\nprintf 'harn 0.10.129\\n'\n")
  const chmod = harness.process.shell("chmod +x " + shell_quote(executable))
  assert(chmod.success, chmod.combined)
  assert_eq(pinned_test_runtime(caps, root, bin), executable)
  harness.fs.write_text(executable, "#!/bin/sh\nprintf 'harn 0.10.128\\n'\n")
  const wrong = try {
    pinned_test_runtime(caps, root, bin)
  } catch (error) {
    to_string(error)
  }
  assert(contains(wrong, "does not match repository pin"), wrong)
  // An installed but stale local binary must not silently fall through to PATH.
  const local_dir = path_join(root, ".harn", "bin")
  harness.fs.mkdir(local_dir)
  const local = path_join(local_dir, "harn")
  harness.fs.write_text(local, "#!/bin/sh\nprintf 'harn 0.10.128\\n'\n")
  assert(harness.process.shell("chmod +x " + shell_quote(local)).success)
  harness.fs.write_text(executable, "#!/bin/sh\nprintf 'harn 0.10.129\\n'\n")
  const stale_local = try {
    pinned_test_runtime(caps, root, bin)
  } catch (error) {
    to_string(error)
  }
  assert(contains(stale_local, "does not match repository pin"), stale_local)
}
