import {
  release_tag_github_trust,
  release_tag_identity_verification,
  ssh_signing_key_fingerprint,
} from "../lib/release_tag_identity"

fn tag_contents(tag: string, target: string) -> string {
  return "object ${target}\ntype commit\ntag ${tag}\ntagger Test <test@example.com> 1 +0000\n\nRelease\n"
}

pipeline test_release_tag_identity_requires_embedded_tag_name(task: any) {
  const oid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const target = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const accepted = release_tag_identity_verification(
    "v1.2.3",
    oid,
    target,
    oid,
    target,
    tag_contents("v1.2.3", target),
    true,
  )
  assert_eq(accepted.success, true)
  const wrong_name = release_tag_identity_verification(
    "v1.2.3",
    oid,
    target,
    oid,
    target,
    tag_contents("v9.9.9", target),
    true,
  )
  assert_eq(wrong_name.success, false)
  assert_eq(contains(wrong_name.reason, "embeds tag v9.9.9, not v1.2.3"), true)
}

pipeline test_release_tag_identity_requires_direct_commit_and_signature(task: any) {
  const oid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  const target = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const indirect = release_tag_identity_verification(
    "v1.2.3",
    oid,
    target,
    oid,
    target,
    "object ${target}\ntype tag\ntag v1.2.3\n\nRelease\n",
    true,
  )
  assert_eq(indirect.success, false)
  assert_eq(contains(indirect.reason, "object type tag, not commit"), true)
  const unsigned = release_tag_identity_verification(
    "v1.2.3",
    oid,
    target,
    oid,
    target,
    tag_contents("v1.2.3", target),
    false,
  )
  assert_eq(unsigned.success, false)
  assert_eq(contains(unsigned.reason, "failed signature verification"), true)
}

pipeline test_release_tag_github_trust_requires_exact_registered_signer(task: any) {
  const public_key =
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIALiGUi5b6TVIbzfFNniz7bfPbXJcbzWjLguThg5EpKw"
  const fingerprint = "SHA256:Vf3ne/4ERhdAwPTfWNGNE0dIYy9hH7tiHtiL2Lz46MU"
  assert_eq(ssh_signing_key_fingerprint(public_key), fingerprint.replace("/", "_"))
  const accepted = release_tag_github_trust(
    "Good git signature with ED25519 key ${fingerprint}",
    [{id: 1, key: public_key, title: "release", created_at: "2026-01-01T00:00:00Z"}],
  )
  assert_eq(accepted.success, true)
  assert_eq(accepted.fingerprint, fingerprint)
  const rejected = release_tag_github_trust(
    "Good git signature with ED25519 key ${fingerprint}",
    [
      {
        id: 2,
        key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB60zaJI1YRp31GcmMTPiJ7fQxrE9kUf5M2KWWo7kIj",
        title: "other",
        created_at: "2026-01-01T00:00:00Z",
      },
    ],
  )
  assert_eq(rejected.success, false)
  assert(contains(rejected.reason, "not registered as a GitHub signing key"))
}
