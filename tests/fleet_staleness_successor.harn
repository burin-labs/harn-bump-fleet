import {
  StalledBumpWorkflow,
  bump_successor,
  start_stalled_bump,
} from "../check_fleet_pin_staleness.harn"
import { BumpSuccessorResult, PinStalenessRow, pin_staleness_verdict } from "../lib/fleet_staleness"
import { GithubClientOptions } from "harn-github-connector/default"

// Every request is answered from this fake origin, so no test here can reach
// GitHub or read an ambient credential.
const BASE = "https://github.test"

const SLUG = "burin-labs/stuck"

const REPO = BASE + "/repos/burin-labs/stuck"

const RUNS = REPO + "/actions/workflows/bump-harn.yml/runs?branch=main&per_page=10"

const PULLS = REPO + "/pulls?state=open&head="
  + url_encode("burin-labs:automation/bump-harn-runtime")
  + "&per_page=10"

const DISPATCH = REPO + "/actions/workflows/bump-harn.yml/dispatches"

type DispatchBody = {ref: string, inputs: {version: string, ...rest}, ...rest}

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "staleness-successor-token"}
}

fn plan(dry_run: bool = false) {
  return {max_releases_behind: "1", dry_run: dry_run, target: nil, only: nil, run_url: nil}
}

fn stale_row() -> PinStalenessRow {
  return pin_staleness_verdict("0.10.114", "v0.10.115", 1, 0) + {slug: SLUG, pin: "0.10.114"}
}

/** When the target release published: 2026-10-18T02:49:36Z. */
const PUBLISHED_S = 1792291776

fn update() -> StalledBumpWorkflow {
  return {
    workflow_name: "bump-harn.yml",
    base_branch: "main",
    branch: "automation/bump-harn-runtime",
  }
}

fn run(
  id: int,
  status: string,
  conclusion: string?,
  event: string = "push",
  created_at: string = "2026-10-18T03:35:00Z",
) -> dict {
  return {
    id: id,
    name: "Bump Harn Runtime",
    display_title: "Bump Harn Runtime",
    path: ".github/workflows/bump-harn.yml",
    event: event,
    created_at: created_at,
    status: status,
    conclusion: conclusion,
    head_branch: "main",
    head_sha: "a" * 40,
    html_url: "https://github.test/burin-labs/stuck/actions/runs/${to_string(id)}",
  }
}

fn mock_runs(testing: HarnessTesting, runs: list<dict>) {
  testing.http_mock(
    "GET",
    RUNS,
    {status: 200, body: json_stringify({total_count: len(runs), workflow_runs: runs})},
  )
}

fn mock_pulls(testing: HarnessTesting, pulls: list<dict>) {
  testing.http_mock("GET", PULLS, {status: 200, body: json_stringify(pulls)})
}

fn completed_page() -> list<dict> {
  return range(1, 11).map({ id -> run(id, "completed", "success") }).to_list()
}

fn mock_two_pages(testing: HarnessTesting, second: list<dict>, total: int = 11) {
  testing.http_mock(
    "GET",
    RUNS,
    {status: 200, body: json_stringify({total_count: total, workflow_runs: completed_page()})},
  )
  testing.http_mock(
    "GET",
    RUNS + "&page=2",
    {status: 200, body: json_stringify({total_count: total, workflow_runs: second})},
  )
}

pipeline test_an_active_bump_on_page_two_prevents_dispatch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_two_pages(harness.testing, [run(11, "in_progress", nil)])
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert_eq(result.action, "bump_running", result.detail)
  assert_eq(len(dispatches(harness.testing)), 0)
}

pipeline test_a_failed_retry_on_page_two_prevents_dispatch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_two_pages(harness.testing, [run(11, "completed", "failure", "workflow_dispatch")])
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert_eq(result.action, "already_retried", result.detail)
  assert_eq(len(dispatches(harness.testing)), 0)
}

pipeline test_an_incomplete_second_page_refuses_dispatch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_two_pages(harness.testing, [])
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert(!result.ok)
  assert_eq(result.action, "probe_failed", result.detail)
  assert_eq(len(dispatches(harness.testing)), 0)
}

pipeline test_a_repeated_run_on_page_two_refuses_dispatch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_two_pages(harness.testing, [run(1, "completed", "success")])
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert(!result.ok)
  assert_eq(result.action, "probe_failed", result.detail)
  assert_eq(len(dispatches(harness.testing)), 0)
}

pipeline test_a_changed_total_on_page_two_refuses_dispatch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_two_pages(harness.testing, [run(11, "completed", "success")])
  harness.testing.http_mock(
    "GET",
    RUNS + "&page=2",
    {
      status: 200,
      body: json_stringify({total_count: 12, workflow_runs: [run(11, "completed", "success")]}),
    },
  )
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert(!result.ok)
  assert_eq(result.action, "probe_failed", result.detail)
  assert_eq(len(dispatches(harness.testing)), 0)
}

pipeline test_an_unreadable_second_page_refuses_dispatch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_two_pages(harness.testing, [run(11, "completed", "success")])
  harness.testing.http_mock("GET", RUNS + "&page=2", {status: 500, body: "{}"})
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert(!result.ok)
  assert_eq(result.action, "probe_failed", result.detail)
  assert_eq(len(dispatches(harness.testing)), 0)
}

pipeline test_a_complete_two_page_inventory_may_dispatch(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_two_pages(harness.testing, [run(11, "completed", "success")])
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert(result.ok, result.detail)
  assert_eq(result.action, "would_dispatch", result.detail)
  const reads = harness.testing.http_mock_calls().filter({ call -> contains(call.url, "page=2") })
    .to_list()
  assert_eq(len(reads), 1, "the complete second page must actually be read")
  assert_eq(len(dispatches(harness.testing)), 0)
}

pipeline test_the_inventory_page_budget_refuses_instead_of_dispatching(harness: Harness) {
  harness.testing.http_mock_clear()
  for page in range(1, 101) {
    const runs = range(0, 10).map({ index -> run(page * 10 + index, "completed", "success") })
      .to_list()
    const url = RUNS + if page == 1 {
      ""
    } else {
      "&page=${to_string(page)}"
    }
    harness.testing.http_mock(
      "GET",
      url,
      {status: 200, body: json_stringify({total_count: 1001, workflow_runs: runs})},
    )
  }
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert(!result.ok)
  assert_eq(result.action, "probe_failed", result.detail)
  assert(contains(result.detail, "page budget"), result.detail)
  assert_eq(len(dispatches(harness.testing)), 0)
}

fn dispatches(testing: HarnessTesting) -> list {
  return testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()
}

fn start(harness: Harness, dry_run: bool = false) -> BumpSuccessorResult {
  return start_stalled_bump(
    harness,
    stale_row(),
    update(),
    "v0.10.115",
    PUBLISHED_S,
    plan(dry_run),
    options(),
  )
}

/**
 * The defect this exists for: the adapter's push run ended without a pull
 * request, so nothing else will ever start the next bump.
 */
pipeline test_a_stalled_consumer_gets_its_bump_dispatched(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_runs(harness.testing, [run(39094162789, "completed", "failure")])
  mock_pulls(harness.testing, [])
  harness.testing.http_mock(
    "POST",
    DISPATCH,
    {
      status: 200,
      body: json_stringify(
        {
          workflow_run_id: 4242,
          run_url: REPO + "/actions/runs/4242",
          html_url: "https://github.test/burin-labs/stuck/actions/runs/4242",
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    REPO + "/actions/runs/4242",
    {status: 200, body: json_stringify(run(4242, "queued", nil) + {event: "workflow_dispatch"})},
  )
  const result = start(harness)
  assert_eq(result.action, "dispatched", result.detail)
  const posts = dispatches(harness.testing)
  assert_eq(len(posts), 1, "exactly one bump is dispatched")
  const sent = schema_expect(json_parse(posts[0].body), DispatchBody)
  assert_eq(sent.ref, "main")
  assert_eq(sent.inputs.version, "v0.10.115")
}

/** A bump still running is the successor already; a second would race it. */
pipeline test_a_running_bump_is_left_alone(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_runs(harness.testing, [run(7, "in_progress", nil)])
  const result = start(harness)
  assert(result.ok, result.detail)
  assert_eq(result.action, "bump_running")
  assert_eq(len(dispatches(harness.testing)), 0)
}

/** An open bump pull request is the repair path; redoing the refresh would discard it. */
pipeline test_an_open_bump_pull_request_is_left_alone(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_runs(harness.testing, [run(7, "completed", "failure")])
  mock_pulls(
    harness.testing,
    [
      {
        number: 11245,
        title: "Bump Harn runtime",
        state: "open",
        base: {ref: "main"},
        head: {ref: "automation/bump-harn-runtime", sha: "b" * 40},
      },
    ],
  )
  const result = start(harness)
  assert(result.ok, result.detail)
  assert_eq(result.action, "bump_pr_open")
  assert_eq(result.detail, "#11245")
  assert_eq(len(dispatches(harness.testing)), 0)
}

pipeline test_a_dry_run_reports_the_dispatch_without_sending_it(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_runs(harness.testing, [])
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert(result.ok, result.detail)
  assert_eq(result.action, "would_dispatch")
  assert_eq(len(dispatches(harness.testing)), 0)
}

/** An unreadable run list must fail the check, not read as "nothing running". */
pipeline test_an_unreadable_run_list_fails_instead_of_dispatching(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock("GET", RUNS, {status: 500, body: "{}"})
  const result = start(harness)
  assert(!result.ok, "an unread run list is not an idle one")
  assert_eq(result.action, "probe_failed")
  assert_eq(len(dispatches(harness.testing)), 0)
}

/** Queued and waiting runs are in flight too; only a completed run frees the slot. */
pipeline test_queued_and_waiting_bumps_are_left_alone(harness: Harness) {
  for status in ["queued", "waiting", "pending"] {
    harness.testing.http_mock_clear()
    mock_runs(harness.testing, [run(7, status, nil)])
    const result = start(harness)
    assert(result.ok, result.detail)
    assert_eq(result.action, "bump_running", status)
    assert_eq(len(dispatches(harness.testing)), 0, status)
  }
}

/**
 * The retry bound. A dispatched bump for this release that already finished
 * without success would fail the same way again, so it is not re-dispatched.
 */
pipeline test_a_failed_dispatch_for_this_release_is_not_retried(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_runs(
    harness.testing,
    [run(8, "completed", "failure", "workflow_dispatch", "2026-10-18T05:00:00Z")],
  )
  mock_pulls(harness.testing, [])
  const result = start(harness)
  assert(result.ok, result.detail)
  assert_eq(result.action, "already_retried")
  assert_eq(len(dispatches(harness.testing)), 0)
}

/** A dispatch from before this release was for an older target and does not count. */
pipeline test_a_failed_dispatch_for_an_older_release_does_not_block(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_runs(
    harness.testing,
    [run(8, "completed", "failure", "workflow_dispatch", "2026-10-16T05:00:00Z")],
  )
  mock_pulls(harness.testing, [])
  const result = start(harness, true)
  assert(result.ok, result.detail)
  assert_eq(result.action, "would_dispatch")
}

/** An unreadable pull-request list must fail, not read as "no bump pull request". */
pipeline test_an_unreadable_pull_request_list_fails_instead_of_dispatching(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_runs(harness.testing, [])
  harness.testing.http_mock("GET", PULLS, {status: 500, body: "{}"})
  const result = start(harness)
  assert(!result.ok, "an unread pull-request list is not an empty one")
  assert_eq(result.action, "probe_failed")
  assert_eq(len(dispatches(harness.testing)), 0)
}

/** Without a publication time the retry bound cannot be read, so nothing is dispatched. */
pipeline test_an_unreadable_publication_time_fails_instead_of_dispatching(harness: Harness) {
  harness.testing.http_mock_clear()
  const result = start_stalled_bump(
    harness,
    stale_row(),
    update(),
    "v0.10.115",
    nil,
    plan(),
    options(),
  )
  assert(!result.ok, result.detail)
  assert_eq(result.action, "probe_failed")
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}

/**
 * An unknown pin keeps its alarm but must not dispatch: a failed or malformed
 * pin read would otherwise start a bump on every tick.
 */
pipeline test_an_unknown_pin_never_dispatches(harness: Harness) {
  harness.testing.http_mock_clear()
  const unknown: PinStalenessRow = pin_staleness_verdict(nil, "v0.10.115", 0, 0) + {slug: SLUG}
  assert_eq(unknown.state, "unknown")
  assert(unknown.stale, "an unknown pin still alarms")
  const successor = bump_successor(
    harness,
    unknown,
    true,
    update(),
    "v0.10.115",
    PUBLISHED_S,
    plan(),
    options(),
  )
  assert_eq(successor, nil)
  assert_eq(len(harness.testing.http_mock_calls()), 0, "an unknown pin makes no request")
}

/** A repository the fleet does not bump gets the alarm only. */
pipeline test_a_repository_the_fleet_does_not_bump_never_dispatches(harness: Harness) {
  harness.testing.http_mock_clear()
  const successor = bump_successor(
    harness,
    stale_row(),
    false,
    update(),
    "v0.10.115",
    PUBLISHED_S,
    plan(),
    options(),
  )
  assert_eq(successor, nil)
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}
