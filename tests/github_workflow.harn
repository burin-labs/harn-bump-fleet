import {
  decode_github_workflow,
  github_projection_has_trigger,
  github_reusable_jobs,
  github_workflow_dispatch_input,
  github_workflow_dispatch_input_is_string,
} from "../lib/github_workflow"

@test
pipeline test_workflow_projection_decodes_owned_fields(task: any) {
  const source = join(
    [
      "'on':",
      "  workflow_dispatch:",
      "jobs:",
      "  package:",
      "    uses: owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "    with:",
      "      strict: true",
      "    secrets:",
      "      token: $" + "{{ secrets.TOKEN }}",
      "  status:",
      "    if: always()",
      "    steps:",
      "      - uses: owner/policy/.github/actions/require-successful-needs@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "        with:",
      "          results-json: $" + "{{ toJSON(needs.*.result) }}",
      "",
    ],
    "\n",
  )
  const workflow = decode_github_workflow(source)
  assert_eq(workflow.triggers, ["workflow_dispatch"])
  assert_eq(github_workflow_dispatch_input(workflow, "version"), nil)
  const jobs = github_reusable_jobs(
    workflow,
    "owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  )
  assert_eq(jobs.count, 1)
  const job = (jobs[0] ?? {key: "", value: {}}).value
  assert_eq(job.with, {strict: true})
  assert_eq(job.secrets, {token: "$" + "{{ secrets.TOKEN }}"})
  const status = workflow.jobs.get("status") ?? {}
  assert_eq(status.if, "always()")
  assert_eq(status.steps?.[0]?.with, {"results-json": "$" + "{{ toJSON(needs.*.result) }}"})
}

@test
pipeline test_trigger_projection_normalizes_supported_github_syntax(task: any) {
  for source in [
    "on: workflow_dispatch\njobs: {}\n",
    "on: [push, workflow_dispatch]\njobs: {}\n",
    "on: {workflow_dispatch: null}\njobs: {}\n",
  ] {
    assert(github_projection_has_trigger(decode_github_workflow(source), "workflow_dispatch"))
  }
}

@test
pipeline test_workflow_projection_fails_closed_on_wrong_shape_or_malformed_yaml(task: any) {
  for source in [
    "on: 42\njobs: {}\n",
    "on: [\n",
    "on: push\njobs:\n  status:\n    steps:\n      - uses: owner/action@v1\n        with:\n          results-json:\n            nested: invalid\n",
  ] {
    let failure = nil
    try {
      decode_github_workflow(source)
    } catch (caught) {
      failure = caught
    }
    assert_eq(failure?.code, "invalid_workflow_projection")
    assert((failure?.detail ?? "") != "", "decode failure retains operator detail")
  }
}

@test
pipeline test_dispatch_inputs_are_typed_and_fail_closed(task: any) {
  const workflow = decode_github_workflow(
    "on:\n  workflow_dispatch:\n    inputs:\n      version:\n        required: true\n        type: string\njobs: {}\n",
  )
  assert_eq(github_workflow_dispatch_input(workflow, "version")?.type, "string")
  const default_string = decode_github_workflow(
    "on:\n  workflow_dispatch:\n    inputs:\n      version:\n        required: false\njobs: {}\n",
  )
  assert(github_workflow_dispatch_input_is_string(default_string, "version"))
  const non_string = decode_github_workflow(
    "on:\n  workflow_dispatch:\n    inputs:\n      version:\n        type: boolean\njobs: {}\n",
  )
  assert_eq(github_workflow_dispatch_input_is_string(non_string, "version"), false)
  let failure = nil
  try {
    decode_github_workflow("on:\n  workflow_dispatch:\n    inputs: []\njobs: {}\n")
  } catch (caught) {
    failure = caught
  }
  assert_eq(failure?.code, "invalid_workflow_projection")
  assert((failure?.detail ?? "") != "", "decode failure retains operator detail")
}
