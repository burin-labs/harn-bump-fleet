import {
  decode_github_workflow,
  github_reusable_jobs,
  github_workflow_dispatch_has_input,
  github_workflow_trigger_probe,
} from "../lib/github_workflow"

@test
pipeline test_workflow_projection_decodes_owned_fields(task) {
  const source = join(
    [
      "'on':",
      "  workflow_dispatch:",
      "jobs:",
      "  package:",
      "    uses: owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "    with:",
      "      strict: true",
      "    secrets:",
      "      token: $" + "{{ secrets.TOKEN }}",
      "",
    ],
    "\n",
  )
  const workflow = decode_github_workflow(source)
  assert_eq(workflow.triggers, ["workflow_dispatch"])
  assert_eq(github_workflow_dispatch_has_input(workflow, "version"), false)
  const jobs = github_reusable_jobs(
    workflow,
    "owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  )
  assert_eq(jobs.count, 1)
  const job = (jobs[0] ?? {key: "", value: {}}).value
  assert_eq(job.with, {strict: true})
  assert_eq(job.secrets, {token: "$" + "{{ secrets.TOKEN }}"})
}

@test
pipeline test_trigger_probe_fails_closed_on_wrong_shape_or_malformed_yaml(task) {
  for source in [
    "on: workflow_dispatch\njobs: {}\n",
    "on: [push, workflow_dispatch]\njobs: {}\n",
    "on: {workflow_dispatch: null}\njobs: {}\n",
  ] {
    assert_eq(
      github_workflow_trigger_probe(source, "workflow_dispatch"),
      {valid: true, present: true, error: nil},
    )
  }
  for source in ["on: 42\njobs: {}\n", "on: [\n"] {
    const probe = github_workflow_trigger_probe(source, "workflow_dispatch")
    assert_eq(probe.valid, false)
    assert_eq(probe.present, false)
    assert(probe.error != nil)
  }
}

@test
pipeline test_dispatch_inputs_are_typed_and_fail_closed(task) {
  const workflow = decode_github_workflow(
    "on:\n  workflow_dispatch:\n    inputs:\n      version:\n        required: true\n        type: string\njobs: {}\n",
  )
  assert(github_workflow_dispatch_has_input(workflow, "version"))
  const probe = github_workflow_trigger_probe(
    "on:\n  workflow_dispatch:\n    inputs: []\njobs: {}\n",
    "workflow_dispatch",
  )
  assert_eq(probe.valid, false)
  assert(probe.error != nil)
}
