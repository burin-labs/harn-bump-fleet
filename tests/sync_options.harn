import {
  convergence_path_matches,
  missing_convergence_paths,
  parse_convergence_options,
  parse_sync_options,
  sync_target_matches,
} from "../lib/sync_options"

pipeline test_sync_options_are_dry_run_first() {
  assert_eq(parse_sync_options([]), {apply: false, manifest: "fleet.toml", root: nil, only: nil})
  assert_eq(
    parse_sync_options(
      ["--apply", "--manifest", "custom.toml", "--root", "/tmp/repos", "--only", "owner/repo"],
    ),
    {apply: true, manifest: "custom.toml", root: "/tmp/repos", only: "owner/repo"},
  )
}

pipeline test_sync_options_reject_conflicting_modes() {
  const result = try {
    parse_sync_options(["--apply", "--check"])
  }
  assert(is_err(result))
  assert(contains(to_string(unwrap_err(result)), "cannot be combined"))
}

pipeline test_sync_target_accepts_slug_or_directory() {
  assert(sync_target_matches("owner/repo", "repo", nil))
  assert(sync_target_matches("owner/repo", "repo", "owner/repo"))
  assert(sync_target_matches("owner/repo", "repo", "repo"))
  assert(!sync_target_matches("owner/repo", "repo", "other"))
}

pipeline test_convergence_options_accept_repeatable_exact_paths() {
  const options = parse_convergence_options(
    [
      "--apply",
      "--only",
      "owner/repo",
      "--only-path",
      "scripts/guard.harn",
      "--only-path",
      "scripts/policy.harn",
    ],
  )
  assert(options.sync.apply)
  assert_eq(options.sync.only, "owner/repo")
  assert_eq(options.only_paths, ["scripts/guard.harn", "scripts/policy.harn"])
  assert(options.arm_auto_merge)
}

pipeline test_convergence_path_filter_is_exact_and_fails_closed() {
  const selected = ["scripts/guard.harn", "scripts/policy.harn"]
  assert(convergence_path_matches("scripts/guard.harn", selected))
  assert(!convergence_path_matches("scripts/guard.harn.bak", selected))
  assert(convergence_path_matches("anything", []))
  assert_eq(missing_convergence_paths(selected, ["scripts/guard.harn"]), ["scripts/policy.harn"])
}
