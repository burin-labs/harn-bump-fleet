import { harn_update_route, harn_update_usage } from "../lib/harn_update"

pipeline test_repair_route_escalates_only_after_evidenced_no_progress(task: any) {
  assert_eq(harn_update_route(1, "checks_failing", false).tier, "value")
  assert_eq(harn_update_route(2, "validation_changed", false).tier, "value")
  assert_eq(harn_update_route(2, "same_validation_failure", true).tier, "strong")
}

pipeline test_usage_receipt_distinguishes_exact_and_lower_bound_cost(task: any) {
  const exact = harn_update_usage(
    "openrouter",
    "value-model",
    {
      tokens_used: 1200,
      cost_usd: 0.07,
      known_cost_usd: 0.07,
      unpriced_calls: 0,
      usage_unknown_calls: 0,
    },
  )
  assert_eq(exact.cost_status, "exact")
  assert_eq(exact.cost_usd, 0.07)
  const partial = harn_update_usage(
    "openrouter",
    "unknown-price-model",
    {
      tokens_used: 900,
      cost_usd: nil,
      known_cost_usd: 0.02,
      unpriced_calls: 1,
      usage_unknown_calls: 0,
    },
  )
  assert_eq(partial.cost_status, "lower_bound")
  const failed = harn_update_usage(
    "openai",
    "gpt-5.3-codex",
    {status: "provider_error", cost_usd: 0.0, known_cost_usd: 0.0},
  )
  assert_eq(failed.cost_status, "unknown")
  const no_call = harn_update_usage(
    "openai",
    "unavailable",
    {status: "provider_error", provider_call_count: 0},
  )
  assert_eq(no_call.cost_status, "exact")
  assert_eq(no_call.cost_usd, 0.0)
  assert_eq(no_call.known_cost_usd, 0.0)
  assert_eq(
    harn_update_usage(
      "openai",
      "unavailable",
      {status: "provider_error", provider_call_count: 1, tokens_used: 0},
    ).cost_status,
    "unknown",
  )
  assert_eq(partial.known_cost_usd, 0.02)
}
