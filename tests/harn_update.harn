import {
  HarnUpdateBudgetPolicy,
  HarnUpdateProofFacts,
  harn_update_budget_decision,
  harn_update_continuation,
  harn_update_proof,
  harn_update_proof_receipt_complete,
  harn_update_route,
  harn_update_runtime_readiness,
  harn_update_usage,
} from "../lib/harn_update"

type UpdateContractProjection = {
  properties: {
    schema_version: {const: string},
    workflow: {properties: {inputs: {properties: {enable_repair: {default: bool}}}}},
    runtime_readiness: {properties: {requires_exact_target_runtime: {const: bool}}},
    repair_authority: {properties: {secret_references: {const: list<string>}}},
    migrations: {const: list<string>},
  },
}

fn update_contract(fs: HarnessFs) -> UpdateContractProjection {
  return schema_expect(
    json_parse(fs.read_text(path_join(dirname(fs.cwd()), "docs", "harn-update-contract.v1.json"))),
    schema_of(UpdateContractProjection),
  )
}

fn repair_controller_source(fs: HarnessFs) -> string {
  return fs.read_text(path_join(dirname(fs.cwd()), "repair_fleet_convergence.harn"))
}

const BUDGET: HarnUpdateBudgetPolicy = {
  max_rounds: 4,
  max_attempts_per_repository: 3,
  max_tokens_per_attempt: 6000,
  max_cost_per_attempt_usd: 0.3,
  max_cost_per_repository_usd: 0.9,
  max_cost_per_run_usd: 4.0,
}

fn proven_pull_request() {
  return {
    number: 6239,
    url: "https://github.com/burin-labs/burin-code/pull/6239",
    state: "merged",
    head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    head_pin: "0.10.97",
    check_state: "green",
    checks_head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    merge_commit_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    merge_reachable_from_default_branch: true,
  }
}

fn proven_facts() -> HarnUpdateProofFacts {
  return {
    repository: "burin-labs/burin-code",
    target: "v0.10.97",
    default_branch_pin: "0.10.97",
    default_branch_head_sha: "dddddddddddddddddddddddddddddddddddddddd",
    pull_request: proven_pull_request(),
  }
}

pipeline test_current_pin_is_not_completion_without_exact_merge_and_ci_lineage(task) {
  const proof = harn_update_proof(proven_facts() + {pull_request: nil})
  assert_eq(proof.ok, false)
  assert_eq(proof.reason, "missing_update_pull_request_lineage")
}

pipeline test_exact_green_merged_pull_request_proves_the_update(task) {
  const proof = harn_update_proof(proven_facts())
  assert_eq(proof.ok, true)
  assert_eq(proof.pull_request_number, 6239)
  assert_eq(proof.checked_head_sha, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  assert_eq(proof.merge_commit_sha, "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
}

pipeline test_changed_head_or_unreachable_merge_blocks_completion(task) {
  const mismatched = harn_update_proof(
    proven_facts()
      + {
        pull_request: proven_pull_request()
          + {checks_head_sha: "cccccccccccccccccccccccccccccccccccccccc"},
      },
  )
  assert_eq(mismatched.reason, "checks_do_not_match_update_head")
  const unreachable = harn_update_proof(
    proven_facts()
      + {pull_request: proven_pull_request() + {merge_reachable_from_default_branch: false}},
  )
  assert_eq(unreachable.reason, "merge_not_on_default_branch")
}

pipeline test_attempt_repository_and_run_budgets_are_independent(task) {
  assert_eq(harn_update_budget_decision(BUDGET, 1, 0.2, 3.2).allowed, true)
  assert_eq(
    harn_update_budget_decision(BUDGET, 3, 0.2, 3.2).reason,
    "repository_attempt_limit_reached",
  )
  assert_eq(
    harn_update_budget_decision(BUDGET, 1, 0.9, 3.2).reason,
    "repository_cost_limit_reached",
  )
  assert_eq(harn_update_budget_decision(BUDGET, 1, 0.2, 4.0).reason, "run_cost_limit_reached")
}

pipeline test_repair_route_escalates_only_after_evidenced_no_progress(task) {
  assert_eq(harn_update_route(1, "checks_failing", false).tier, "value")
  assert_eq(harn_update_route(2, "validation_changed", false).tier, "value")
  assert_eq(harn_update_route(2, "same_validation_failure", true).tier, "strong")
}

pipeline test_failed_proof_gets_one_fresh_hosted_round_only_when_repair_is_enabled(task) {
  const next = harn_update_continuation(1, 4, false, true)
  assert_eq(next.continue, true)
  assert_eq(next.next_round, 2)
  assert_eq(next.reason, "fresh_hosted_round_required")
  assert_eq(harn_update_continuation(4, 4, false, true).reason, "repair_round_limit_reached")
  assert_eq(harn_update_continuation(1, 4, false, false).reason, "repair_disabled")
  assert_eq(harn_update_continuation(1, 4, true, true).reason, "update_proven")
}

pipeline test_persisted_proof_completion_is_read_from_json_not_the_parser_wrapper(task) {
  assert_eq(harn_update_proof_receipt_complete(unwrap(json_parse("{\"complete\": true}"))), true)
  assert_eq(harn_update_proof_receipt_complete(unwrap(json_parse("{\"complete\": false}"))), false)
}

pipeline test_runtime_provenance_blocks_stale_or_incompatible_controllers(task) {
  const ready = harn_update_runtime_readiness(
    "v0.10.97",
    {
      harn_version: "v0.10.97",
      controller_revision: "abc123",
      repair_contract_revision: "harn-update-repair-v5",
    },
  )
  assert_eq(ready.ready, true)
  const stale = harn_update_runtime_readiness(
    "v0.10.97",
    ready.provenance + {harn_version: "v0.10.96"},
  )
  assert_eq(stale.ready, false)
  assert_eq(stale.reason, "runtime_version_does_not_match_target")
}

pipeline test_usage_receipt_distinguishes_exact_and_lower_bound_cost(task) {
  const exact = harn_update_usage(
    "openrouter",
    "value-model",
    {
      tokens_used: 1200,
      cost_usd: 0.07,
      known_cost_usd: 0.07,
      unpriced_calls: 0,
      usage_unknown_calls: 0,
    },
  )
  assert_eq(exact.cost_status, "exact")
  assert_eq(exact.cost_usd, 0.07)
  const partial = harn_update_usage(
    "openrouter",
    "unknown-price-model",
    {
      tokens_used: 900,
      cost_usd: nil,
      known_cost_usd: 0.02,
      unpriced_calls: 1,
      usage_unknown_calls: 0,
    },
  )
  assert_eq(partial.cost_status, "lower_bound")
  const failed = harn_update_usage(
    "openai",
    "gpt-5.3-codex",
    {status: "provider_error", cost_usd: 0.0, known_cost_usd: 0.0},
  )
  assert_eq(failed.cost_status, "unknown")
  assert_eq(partial.known_cost_usd, 0.02)
}

pipeline test_versioned_update_contract_keeps_authority_and_migration_machine_readable(
  harness: Harness,
  task,
) {
  const contract = update_contract(harness.fs)
  assert_eq(contract.properties.schema_version.const, "harn_update_contract.v1")
  assert_eq(contract.properties.workflow.properties.inputs.properties.enable_repair.default, true)
  assert_eq(
    contract.properties.runtime_readiness.properties.requires_exact_target_runtime.const,
    true,
  )
  assert_eq(
    contract.properties.repair_authority.properties.secret_references.const,
    ["CEREBRAS_API_KEY"],
  )
  assert(
    contains(
      contract.properties.migrations.const[2] ?? "",
      "OpenRouter and Fireworks credential forwarding removed",
    ),
  )
  assert(contains(contract.properties.migrations.const[3] ?? "", "typed command inputs"))
}

pipeline test_startup_receipt_precedes_runtime_work(harness: Harness, task) {
  const source = repair_controller_source(harness.fs)
  const receipt = source.index_of("harness.fs.write_text(options.startup_receipt")
  assert(receipt >= 0)
  assert(receipt < source.index_of("options.target ?? github_latest_release_tag"))
  assert(receipt < source.index_of("harness.llm.budget"))
  assert(receipt < source.index_of("const snapshot = fleet_convergence_snapshot"))
  assert(contains(source, "options.provider_secret_reference"))
  assert(!contains(source, "HARN_UPDATE_PROVIDER_SECRET_REFERENCE"))
}
