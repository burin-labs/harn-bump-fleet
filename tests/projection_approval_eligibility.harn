import { shell_quote } from "std/runtime"
import { with_temp_dir } from "std/testing"
import {
  AGENT_GUIDANCE_PATH,
  BUMP_ADAPTER_PATH,
  DEPENDABOT_CONFIG_PATH,
  PACKAGE_CI_PATH,
  SMART_SHIP_CALLER_PATH,
} from "../lib/fleet_projection_targets"

type ApprovalPaths = {orchestration_pin: list<string>, other_projections: list<string>}

type FileEdit = {filename: string, status: string, patch?: string}

type ReviewPost = {commit_id: string, event: string, body: string}

type NotApplicable = {
  schema: string,
  status: string,
  approved: bool,
  head: string,
  paths: list<string>,
}

type ApprovalProbe = {
  success: bool,
  stdout: string,
  post_count: int,
  post: ReviewPost?,
  calls: string,
}

const HEAD = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const RELEASED = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const PREVIOUS = "cccccccccccccccccccccccccccccccccccccccc"

fn source_path(fs: HarnessFs, path: string) -> string {
  return path_normalize(path_join(fs.source_dir(), "..", path))
}

fn edit(path: string) -> FileEdit {
  return {filename: path, status: "modified", patch: "-pin=${PREVIOUS}\n+pin=${RELEASED}\n"}
}

fn probe(
  harness: Harness,
  files: list<FileEdit>,
  mode: "normal" | "unreadable" | "unknown" | "moved" | "unsigned" | "unpublished" = "normal",
) -> ApprovalProbe {
  return with_temp_dir(
    harness.fs,
    { root ->
      harness.fs.mkdir(path_join(root, "bin"), true)
      const gh = path_join(root, "bin/gh")
      harness.fs.write_text(
        gh,
        harness.fs.read_text(
          path_join(harness.fs.source_dir(), "fixtures/projection-approval-gh.sh"),
        ),
      )
      assert(harness.process.shell("chmod +x ${shell_quote(gh)}").success)
      const meta = {
        state: "open",
        draft: false,
        base: {ref: "main"},
        user: {login: "harn-release-bot[bot]", type: "Bot"},
        head: {
          repo: {full_name: "burin-labs/harn-bump-fleet"},
          ref: "automation/fleet-projections-123abc",
          sha: HEAD,
        },
      }
      harness.fs.write_text(
        path_join(root, "meta.json"),
        mode == "unknown" ? "{}" : json_stringify(meta),
      )
      harness.fs.write_text(
        path_join(root, "commits.json"),
        json_stringify([[{commit: {verification: {verified: mode != "unsigned"}}}]]),
      )
      harness.fs.write_text(path_join(root, "files.json"), json_stringify([files]))
      harness.fs.write_text(path_join(root, "head"), mode == "moved" ? PREVIOUS : HEAD)
      harness.fs.write_text(
        path_join(root, "released"),
        mode == "unpublished" ? PREVIOUS : RELEASED,
      )
      harness.fs.write_text(path_join(root, "posts"), "")
      harness.fs.write_text(path_join(root, "calls"), "")
      if mode == "unreadable" {
        harness.fs.write_text(path_join(root, "unreadable"), "")
      }
      const path = "${path_join(root, "bin")}:${harness.env.get_or("PATH", "") }"
      const script = source_path(harness.fs, "scripts/approve_projection_pr.sh")
      const result = harness.process.shell(
        "PATH=${shell_quote(path)} GH_TOKEN=fixture-only GITHUB_REPOSITORY=burin-labs/harn-bump-fleet PROJECTION_APPROVAL_FIXTURE=${shell_quote(root)} bash ${shell_quote(script)} 42",
      )
      const calls = harness.fs.read_text(path_join(root, "calls"))
      assert(contains(calls, "repos/burin-labs/harn-bump-fleet/pulls/42"))
      const posts = split(harness.fs.read_text(path_join(root, "posts")), "\n").filter(
        { line -> line != "" },
      )
        .to_list()
      let post: ReviewPost? = nil
      if len(posts) > 0 {
        post = unwrap(
          json_decode(harness.fs.read_text(path_join(root, "review.json")), schema_of(ReviewPost)),
        )
      }
      return {
        success: result.success,
        stdout: result.stdout,
        post_count: len(posts),
        post: post,
        calls: calls,
      }
    },
  )
}

pipeline test_approval_path_policy_matches_owned_projection_registry(harness: Harness) {
  const policy: ApprovalPaths = unwrap(
    json_decode(
      harness.fs.read_text(source_path(harness.fs, "scripts/projection-approval-paths.json")),
      schema_of(ApprovalPaths),
    ),
  )
  assert_eq(policy.orchestration_pin, ["fleet.toml", BUMP_ADAPTER_PATH])
  assert_eq(
    policy.other_projections,
    [PACKAGE_CI_PATH, SMART_SHIP_CALLER_PATH, AGENT_GUIDANCE_PATH, DEPENDABOT_CONFIG_PATH],
  )
}

pipeline test_smart_ship_projection_declines_without_approval(harness: Harness) {
  const result = probe(harness, [edit(SMART_SHIP_CALLER_PATH)])
  assert_eq(result.success, true)
  assert_eq(result.post_count, 0)
  const receipt: NotApplicable = unwrap(json_decode(trim(result.stdout), schema_of(NotApplicable)))
  assert_eq(receipt.status, "NOT_APPLICABLE")
  assert_eq(receipt.approved, false)
  assert_eq(receipt.head, HEAD)
  assert_eq(receipt.paths, [SMART_SHIP_CALLER_PATH])
}

pipeline test_other_known_projections_decline_without_approval(harness: Harness) {
  const result = probe(
    harness,
    [edit(PACKAGE_CI_PATH), edit(AGENT_GUIDANCE_PATH), edit(DEPENDABOT_CONFIG_PATH)],
  )
  assert_eq(result.success, true)
  assert_eq(result.post_count, 0)
  const receipt: NotApplicable = unwrap(json_decode(trim(result.stdout), schema_of(NotApplicable)))
  assert_eq(receipt.status, "NOT_APPLICABLE")
  assert_eq(receipt.approved, false)
}

pipeline test_claimed_pin_projection_keeps_integrity_refusals(harness: Harness) {
  const invalid = [
    [edit("fleet.toml"), edit(SMART_SHIP_CALLER_PATH)],
    [edit("fleet.toml"), edit("unowned.txt")],
    [{filename: "fleet.toml", status: "modified", patch: "-policy=false\n+policy=true\n"}],
    [{filename: "fleet.toml", status: "modified"}],
    [{filename: SMART_SHIP_CALLER_PATH, status: "deleted", patch: "-contents"}],
    [edit("unowned.txt")],
    [],
  ]
  for files in invalid {
    const result = probe(harness, files)
    assert_eq(result.success, false, json_stringify(files))
    assert_eq(result.post_count, 0, json_stringify(files))
  }
}

pipeline test_unknown_or_unreadable_metadata_never_approves(harness: Harness) {
  for mode in ["unknown", "unreadable", "unsigned"] {
    const result = probe(harness, [edit("fleet.toml")], mode)
    assert_eq(result.success, false, mode)
    assert_eq(result.post_count, 0, mode)
  }
}

pipeline test_valid_published_pin_reaches_actual_review_post(harness: Harness) {
  const result = probe(harness, [edit("fleet.toml"), edit(BUMP_ADAPTER_PATH)])
  assert_eq(result.success, true)
  assert_eq(result.post_count, 1)
  assert_eq(result.post?.commit_id, HEAD)
  assert_eq(result.post?.event, "APPROVE")
  assert(contains(result.post?.body ?? "", "v0.10.185"))
}

pipeline test_release_and_final_head_checks_still_refuse(harness: Harness) {
  for mode in ["moved", "unpublished"] {
    const result = probe(harness, [edit("fleet.toml")], mode)
    assert_eq(result.success, false, mode)
    assert_eq(result.post_count, 0, mode)
  }
}
