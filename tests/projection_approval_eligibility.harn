import { shell_quote } from "std/runtime"
import { with_temp_dir } from "std/testing"
import {
  AGENT_GUIDANCE_PATH,
  BUMP_ADAPTER_PATH,
  DEPENDABOT_CONFIG_PATH,
  PACKAGE_CI_PATH,
  SMART_SHIP_CALLER_PATH,
} from "../lib/fleet_projection_targets"

type ApprovalPaths = {
  orchestration_pin: list<string>,
  other_projections: list<string>,
  runtime_bump: list<string>,
}

type FileEdit = {filename: string, status: string, patch?: string}

type ReviewPost = {commit_id: string, event: string, body: string}

type NotApplicable = {
  schema: string,
  status: string,
  approved: bool,
  head: string,
  paths: list<string>,
}

type ApprovalProbe = {
  success: bool,
  stdout: string,
  post_count: int,
  post: ReviewPost?,
  calls: string,
}

fn bot_commit(verified: bool) -> dict {
  return {
    author: {login: "harn-release-bot[bot]"},
    committer: {login: "web-flow"},
    commit: {verification: {verified: verified}},
  }
}

const HEAD = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const RELEASED = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const PREVIOUS = "cccccccccccccccccccccccccccccccccccccccc"

fn source_path(fs: HarnessFs, path: string) -> string {
  return path_normalize(path_join(fs.source_dir(), "..", path))
}

fn edit(path: string) -> FileEdit {
  return {filename: path, status: "modified", patch: "-pin=${PREVIOUS}\n+pin=${RELEASED}\n"}
}

fn probe(
  harness: Harness,
  files: list<FileEdit>,
  mode: "normal" | "unreadable" | "unknown" | "moved" | "unsigned" | "unpublished" = "normal",
) -> ApprovalProbe {
  return with_temp_dir(
    harness.fs,
    { root ->
      harness.fs.mkdir(path_join(root, "bin"), true)
      const gh = path_join(root, "bin/gh")
      harness.fs.write_text(
        gh,
        harness.fs.read_text(
          path_join(harness.fs.source_dir(), "fixtures/projection-approval-gh.sh"),
        ),
      )
      assert(harness.process.shell("chmod +x ${shell_quote(gh)}").success)
      const meta = {
        state: "open",
        draft: false,
        base: {ref: "main"},
        user: {login: "harn-release-bot[bot]", type: "Bot"},
        head: {
          repo: {full_name: "burin-labs/harn-bump-fleet"},
          ref: "automation/fleet-projections-123abc",
          sha: HEAD,
        },
      }
      harness.fs.write_text(
        path_join(root, "meta.json"),
        mode == "unknown" ? "{}" : json_stringify(meta),
      )
      harness.fs.write_text(
        path_join(root, "commits.json"),
        json_stringify([[bot_commit(mode != "unsigned")]]),
      )
      harness.fs.write_text(path_join(root, "files.json"), json_stringify([files]))
      harness.fs.write_text(path_join(root, "head"), mode == "moved" ? PREVIOUS : HEAD)
      harness.fs.write_text(
        path_join(root, "released"),
        mode == "unpublished" ? PREVIOUS : RELEASED,
      )
      harness.fs.write_text(path_join(root, "posts"), "")
      harness.fs.write_text(path_join(root, "calls"), "")
      if mode == "unreadable" {
        harness.fs.write_text(path_join(root, "unreadable"), "")
      }
      const path = "${path_join(root, "bin")}:${harness.env.get_or("PATH", "") }"
      const script = source_path(harness.fs, "scripts/approve_projection_pr.sh")
      const result = harness.process.shell(
        "PATH=${shell_quote(path)} GH_TOKEN=fixture-only GITHUB_REPOSITORY=burin-labs/harn-bump-fleet PROJECTION_APPROVAL_FIXTURE=${shell_quote(root)} bash ${shell_quote(script)} 42",
      )
      const calls = harness.fs.read_text(path_join(root, "calls"))
      assert(contains(calls, "repos/burin-labs/harn-bump-fleet/pulls/42"))
      const posts = split(harness.fs.read_text(path_join(root, "posts")), "\n").filter(
        { line -> line != "" },
      )
        .to_list()
      let post: ReviewPost? = nil
      if len(posts) > 0 {
        post = unwrap(
          json_decode(harness.fs.read_text(path_join(root, "review.json")), schema_of(ReviewPost)),
        )
      }
      return {
        success: result.success,
        stdout: result.stdout,
        post_count: len(posts),
        post: post,
        calls: calls,
      }
    },
  )
}

pipeline test_approval_path_policy_matches_owned_projection_registry(harness: Harness) {
  const policy: ApprovalPaths = unwrap(
    json_decode(
      harness.fs.read_text(source_path(harness.fs, "scripts/projection-approval-paths.json")),
      schema_of(ApprovalPaths),
    ),
  )
  assert_eq(policy.orchestration_pin, ["fleet.toml", BUMP_ADAPTER_PATH])
  assert_eq(
    policy.other_projections,
    [PACKAGE_CI_PATH, SMART_SHIP_CALLER_PATH, AGENT_GUIDANCE_PATH, DEPENDABOT_CONFIG_PATH],
  )
  assert_eq(policy.runtime_bump, [".harn-version", "harn.lock"])
}

pipeline test_smart_ship_projection_declines_without_approval(harness: Harness) {
  const result = probe(harness, [edit(SMART_SHIP_CALLER_PATH)])
  assert_eq(result.success, true)
  assert_eq(result.post_count, 0)
  const receipt: NotApplicable = unwrap(json_decode(trim(result.stdout), schema_of(NotApplicable)))
  assert_eq(receipt.status, "NOT_APPLICABLE")
  assert_eq(receipt.approved, false)
  assert_eq(receipt.head, HEAD)
  assert_eq(receipt.paths, [SMART_SHIP_CALLER_PATH])
}

pipeline test_other_known_projections_decline_without_approval(harness: Harness) {
  const result = probe(
    harness,
    [edit(PACKAGE_CI_PATH), edit(AGENT_GUIDANCE_PATH), edit(DEPENDABOT_CONFIG_PATH)],
  )
  assert_eq(result.success, true)
  assert_eq(result.post_count, 0)
  const receipt: NotApplicable = unwrap(json_decode(trim(result.stdout), schema_of(NotApplicable)))
  assert_eq(receipt.status, "NOT_APPLICABLE")
  assert_eq(receipt.approved, false)
}

pipeline test_claimed_pin_projection_keeps_integrity_refusals(harness: Harness) {
  const invalid = [
    [edit("fleet.toml"), edit(SMART_SHIP_CALLER_PATH)],
    [edit("fleet.toml"), edit("unowned.txt")],
    [{filename: "fleet.toml", status: "modified", patch: "-policy=false\n+policy=true\n"}],
    [{filename: "fleet.toml", status: "modified"}],
    [{filename: SMART_SHIP_CALLER_PATH, status: "deleted", patch: "-contents"}],
    [edit("unowned.txt")],
    [],
  ]
  for files in invalid {
    const result = probe(harness, files)
    assert_eq(result.success, false, json_stringify(files))
    assert_eq(result.post_count, 0, json_stringify(files))
  }
}

pipeline test_unknown_or_unreadable_metadata_never_approves(harness: Harness) {
  for mode in ["unknown", "unreadable", "unsigned"] {
    const result = probe(harness, [edit("fleet.toml")], mode)
    assert_eq(result.success, false, mode)
    assert_eq(result.post_count, 0, mode)
  }
}

/** The review.author_evidence.v1 receipt Smart Ship reads from a bot approval's last line. */
type AuthorEvidence = {
  schema: string,
  repository_digest: string,
  pr: int,
  head_sha: string,
  replies: list<dict>,
}

const RECEIPT_PREFIX = "<!-- fleet-approval-review-author-evidence: "

fn receipt_of(body: string) -> AuthorEvidence {
  const lines = body.trim_end().split("\n")
  const line = lines[len(lines) - 1] ?? ""
  assert(line.starts_with(RECEIPT_PREFIX) && line.ends_with(" -->"), line)
  return unwrap(
    json_decode(line[len(RECEIPT_PREFIX):len(line) - 4], schema_of(AuthorEvidence)),
  )
}

fn assert_bound(body: string, repository: string) {
  const receipt = receipt_of(body)
  assert_eq(receipt.schema, "review.author_evidence.v1")
  assert_eq(receipt.repository_digest, sha256(repository))
  assert_eq(receipt.pr, 42)
  assert_eq(receipt.head_sha, HEAD)
  assert_eq(receipt.replies, [])
}

pipeline test_valid_published_pin_reaches_actual_review_post(harness: Harness) {
  const result = probe(harness, [edit("fleet.toml"), edit(BUMP_ADAPTER_PATH)])
  assert_eq(result.success, true)
  assert_eq(result.post_count, 1)
  assert_eq(result.post?.commit_id, HEAD)
  assert_eq(result.post?.event, "APPROVE")
  assert(contains(result.post?.body ?? "", "v0.10.185"))
  assert_bound(result.post?.body ?? "", "burin-labs/harn-bump-fleet")
}

pipeline test_release_and_final_head_checks_still_refuse(harness: Harness) {
  for mode in ["moved", "unpublished"] {
    const result = probe(harness, [edit("fleet.toml")], mode)
    assert_eq(result.success, false, mode)
    assert_eq(result.post_count, 0, mode)
  }
}

type ConsumerCase = {
  files: list<FileEdit>,
  head_ref?: string,
  body?: string,
  unsigned?: bool,
  threads?: int,
  checks?: list<dict>,
  release_state?: string,
  extra_commit?: dict,
  reviews?: list<dict>,
}

type ConsumerReceipt = {
  schema: string,
  status: string,
  approved: bool,
  pull_request: int,
  reason: string,
}

const CONSUMER = "burin-labs/harn-canon"

fn green_checks() -> list<dict> {
  return [
    {name: "CI status", status: "completed", conclusion: "success"},
    {name: "harn / Verify Harn package", status: "completed", conclusion: "success"},
    {name: "ship / ship (42)", status: "in_progress", conclusion: nil},
    {name: "approve / Approve fleet PR", status: "in_progress", conclusion: nil},
  ]
}

fn version_edit(path: string, from: string, to: string) -> FileEdit {
  if path == ".harn-version" {
    return {filename: path, status: "modified", patch: "@@ -1 +1 @@\n-${from}\n+${to}\n"}
  }
  return {
    filename: path,
    status: "modified",
    patch:
      "@@ -1,2 +1,2 @@\n-generator_version = \"${from}\"\n-protocol_artifact_version = \"${from}\"\n+generator_version = \"${to}\"\n+protocol_artifact_version = \"${to}\"\n",
  }
}

fn consumer_probe(harness: Harness, spec: ConsumerCase) -> ApprovalProbe {
  return with_temp_dir(
    harness.fs,
    { root ->
      harness.fs.mkdir(path_join(root, "bin"), true)
      const gh = path_join(root, "bin/gh")
      harness.fs.write_text(
        gh,
        harness.fs.read_text(
          path_join(harness.fs.source_dir(), "fixtures/projection-approval-gh.sh"),
        ),
      )
      assert(harness.process.shell("chmod +x ${shell_quote(gh)}").success)
      const meta = {
        state: "open",
        draft: false,
        base: {ref: "main"},
        user: {login: "harn-release-bot[bot]", type: "Bot"},
        body: spec.body ?? "",
        head: {
          repo: {full_name: CONSUMER},
          ref: spec.head_ref ?? "automation/bump-harn-runtime",
          sha: HEAD,
        },
      }
      harness.fs.write_text(path_join(root, "meta.json"), json_stringify(meta))
      harness.fs.write_text(
        path_join(root, "commits.json"),
        json_stringify(
          [[bot_commit(!(spec.unsigned ?? false))]]
            + (spec.extra_commit != nil ? [[spec.extra_commit]] : []),
        ),
      )
      harness.fs.write_text(path_join(root, "files.json"), json_stringify([spec.files]))
      harness.fs.write_text(path_join(root, "head"), HEAD)
      harness.fs.write_text(path_join(root, "released"), RELEASED)
      harness.fs.write_text(path_join(root, "release-state"), spec.release_state ?? "false\tfalse")
      harness.fs.write_text(path_join(root, "threads"), to_string(spec.threads ?? 0))
      const runs = spec.checks ?? green_checks()
      harness.fs.write_text(
        path_join(root, "checks.json"),
        json_stringify({total_count: len(runs), check_runs: runs}),
      )
      if spec.reviews != nil {
        harness.fs.write_text(path_join(root, "reviews.json"), json_stringify([spec.reviews]))
      }
      harness.fs.write_text(path_join(root, "posts"), "")
      harness.fs.write_text(path_join(root, "calls"), "")
      const path = "${path_join(root, "bin")}:${harness.env.get_or("PATH", "") }"
      const script = source_path(harness.fs, "scripts/approve_projection_pr.sh")
      const result = harness.process.shell(
        "PATH=${shell_quote(path)} GH_TOKEN=fixture-only GITHUB_REPOSITORY=${CONSUMER} APPROVAL_SCOPE=consumer PROJECTION_APPROVAL_REPO=${CONSUMER} PROJECTION_APPROVAL_FIXTURE=${shell_quote(root)} bash ${shell_quote(script)} 42",
      )
      const posts = split(harness.fs.read_text(path_join(root, "posts")), "\n").filter(
        { line -> line != "" },
      )
        .to_list()
      let post: ReviewPost? = nil
      if len(posts) > 0 {
        post = unwrap(
          json_decode(harness.fs.read_text(path_join(root, "review.json")), schema_of(ReviewPost)),
        )
      }
      return {
        success: result.success,
        stdout: result.stdout,
        post_count: len(posts),
        post: post,
        calls: harness.fs.read_text(path_join(root, "calls")),
      }
    },
  )
}

fn declined(result: ApprovalProbe, reason: string) {
  assert_eq(result.success, true, result.stdout)
  assert_eq(result.post_count, 0, result.stdout)
  const receipt: ConsumerReceipt = unwrap(
    json_decode(trim(result.stdout), schema_of(ConsumerReceipt)),
  )
  assert_eq(receipt.status, "DECLINED")
  assert_eq(receipt.approved, false)
  assert(contains(receipt.reason, reason), receipt.reason)
}

pipeline test_consumer_runtime_bump_with_lockfile_is_approved(harness: Harness) {
  const result = consumer_probe(
    harness,
    {
      files: [
        version_edit(".harn-version", "0.10.190", "0.10.191"),
        version_edit("harn.lock", "0.10.190", "0.10.191"),
      ],
    },
  )
  assert_eq(result.success, true, result.stdout)
  assert_eq(result.post_count, 1)
  assert(contains(result.stdout, "v0.10.191"))
  assert_bound(result.post?.body ?? "", CONSUMER)
}

pipeline test_consumer_approval_bound_to_this_head_is_not_posted_twice(harness: Harness) {
  const files = [version_edit(".harn-version", "0.10.190", "0.10.191")]
  const first = consumer_probe(harness, {files: files})
  assert_eq(first.post_count, 1)
  const body = first.post?.body ?? ""
  const again = consumer_probe(harness, {files: files, reviews: [{state: "APPROVED", body: body}]})
  assert_eq(again.success, true, again.stdout)
  assert_eq(again.post_count, 0)
  // A receipt for another head does not stand in for this one.
  const stale = body.replace(HEAD, PREVIOUS)
  const moved = consumer_probe(harness, {files: files, reviews: [{state: "APPROVED", body: stale}]})
  assert_eq(moved.post_count, 1)
  assert_bound(moved.post?.body ?? "", CONSUMER)
}

pipeline test_consumer_runtime_bump_with_one_extra_file_is_declined(harness: Harness) {
  declined(
    consumer_probe(
      harness,
      {
        files: [
          version_edit(".harn-version", "0.10.190", "0.10.191"),
          {filename: "scripts/run.sh", status: "modified", patch: "@@ -1 +1 @@\n-a\n+b\n"},
        ],
      },
    ),
    "outside the runtime bump allowlist",
  )
}

pipeline test_consumer_runtime_bump_declines_anything_but_a_version_number(harness: Harness) {
  declined(
    consumer_probe(
      harness,
      {
        files: [
          {
            filename: "harn.lock",
            status: "modified",
            patch:
              "@@ -1 +1 @@\n-source = \"git+https://example.invalid/a\"\n+source = \"git+https://example.invalid/b\"\n",
          },
        ],
      },
    ),
    "more than a Harn version number changed",
  )
  declined(
    consumer_probe(
      harness,
      {
        files: [
          {
            filename: ".harn-version",
            status: "modified",
            patch: "@@ -1 +1,2 @@\n-0.10.190\n+0.10.191\n+0.10.192\n",
          },
        ],
      },
    ),
    "not only replaced",
  )
}

pipeline test_consumer_runtime_bump_needs_a_published_stable_release(harness: Harness) {
  declined(
    consumer_probe(
      harness,
      {
        files: [version_edit(".harn-version", "0.10.190", "0.10.191")],
        release_state: "false\ttrue",
      },
    ),
    "not a published stable Harn release",
  )
}

pipeline test_consumer_pull_request_waits_for_green_checks_and_threads(harness: Harness) {
  const files = [version_edit(".harn-version", "0.10.190", "0.10.191")]
  declined(
    consumer_probe(
      harness,
      {
        files: files,
        checks: [
          {name: "CI status", status: "completed", conclusion: "success"},
          {name: "unit", status: "completed", conclusion: "failure"},
        ],
      },
    ),
    "checks are not green: unit",
  )
  declined(
    consumer_probe(
      harness,
      {files: files, checks: [{name: "unit", status: "completed", conclusion: "success"}]},
    ),
    "CI status check has not succeeded",
  )
  declined(consumer_probe(harness, {files: files, threads: 1}), "unresolved review threads")
  declined(consumer_probe(harness, {files: files, unsigned: true}), "not GitHub-verified")
  declined(
    consumer_probe(harness, {files: files, head_ref: "someone/else"}),
    "not a fleet automation branch",
  )
}

pipeline test_consumer_projection_restore_needs_matching_trailers_and_allowed_paths(
  harness: Harness,
) {
  const restore = "automation/fleet-projections-abc123"
  const bump = {filename: BUMP_ADAPTER_PATH, status: "modified", patch: "@@ -1 +1 @@\n-a\n+b\n"}
  const ci = {filename: PACKAGE_CI_PATH, status: "modified", patch: "@@ -1 +1 @@\n-a\n+b\n"}
  const approved = consumer_probe(
    harness,
    {
      files: [bump, ci],
      head_ref: restore,
      body:
        "x\n\nFleet-owned-projection-restore: ${BUMP_ADAPTER_PATH}\nFleet-owned-projection-restore: ${PACKAGE_CI_PATH}",
    },
  )
  assert_eq(approved.success, true, approved.stdout)
  assert_eq(approved.post_count, 1)
  declined(
    consumer_probe(
      harness,
      {
        files: [bump, ci],
        head_ref: restore,
        body: "Fleet-owned-projection-restore: ${BUMP_ADAPTER_PATH}",
      },
    ),
    "trailers do not name exactly the changed files",
  )
  const outside = {filename: "fleet.toml", status: "modified", patch: "@@ -1 +1 @@\n-a\n+b\n"}
  declined(
    consumer_probe(
      harness,
      {
        files: [bump, outside],
        head_ref: restore,
        body:
          "Fleet-owned-projection-restore: ${BUMP_ADAPTER_PATH}\nFleet-owned-projection-restore: fleet.toml",
      },
    ),
    "outside the fleet-rendered allowlist",
  )
  declined(
    consumer_probe(
      harness,
      {
        files: [{filename: BUMP_ADAPTER_PATH, status: "removed", patch: "-a"}],
        head_ref: restore,
        body: "Fleet-owned-projection-restore: ${BUMP_ADAPTER_PATH}",
      },
    ),
    "missing, renamed, deleted",
  )
}

pipeline test_consumer_declines_a_verified_commit_a_person_authored(harness: Harness) {
  const files = [version_edit(".harn-version", "0.10.190", "0.10.191")]
  const human = {
    author: {login: "someone"},
    committer: {login: "web-flow"},
    commit: {verification: {verified: true}},
  }
  declined(consumer_probe(harness, {files: files, extra_commit: human}), "not authored by")
  const forged = {
    author: {login: "harn-release-bot[bot]"},
    committer: {login: "someone"},
    commit: {verification: {verified: true}},
  }
  declined(consumer_probe(harness, {files: files, extra_commit: forged}), "not authored by")
}
