import {
  rehearsal_coverage,
  rehearsal_proof_claim,
  rehearsal_proof_ref,
  rehearsal_work_plan,
} from "../lib/consumer_rehearsal"
import { rehearsal_input_identity } from "../lib/rehearsal_inputs"

const REVISION = "1111111111111111111111111111111111111111"

const NEXT = "2222222222222222222222222222222222222222"

const CONTRACT = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn source_tree(docs: string = REVISION, crates: string = REVISION) -> dict {
  return {
    sha: NEXT,
    truncated: false,
    tree: [
      {path: "Cargo.toml", mode: "100644", type: "blob", sha: REVISION},
      {path: "Cargo.lock", mode: "100644", type: "blob", sha: REVISION},
      {path: "rust-toolchain.toml", mode: "100644", type: "blob", sha: REVISION},
      {path: "crates", mode: "040000", type: "tree", sha: crates},
      {path: "docs", mode: "040000", type: "tree", sha: docs},
    ],
  }
}

pipeline test_docs_only_change_preserves_planning_and_release_coverage() {
  const before = unwrap(rehearsal_input_identity(REVISION, source_tree()))
  const after = unwrap(rehearsal_input_identity(NEXT, source_tree(NEXT)))
  assert_eq(before.digest, after.digest)
  assert(before.revision != after.revision)
  assert_eq(before.entries, 4)
  const subject = {slug: "example/consumer", contract_digest: CONTRACT}
  const subjects = [subject]
  const claim = rehearsal_proof_claim(before, subject, "successful consumer gate")
  const recorded = claim.ref
  assert(contains(claim.payload.message, "harn-revision: ${REVISION}\n"))
  assert(contains(claim.payload.message, "input-digest: ${before.digest}\n"))
  const plan = rehearsal_work_plan(after.digest, subjects, [recorded])
  assert_eq(plan.considered, 1)
  assert_eq(len(plan.unproved), 0)
  assert(plan.no_op)
  const coverage = rehearsal_coverage(after.digest, subjects, Ok([recorded]))
  assert_eq(coverage.considered, 1)
  assert_eq(coverage.missing, [])
  assert(coverage.covered)
}

pipeline test_crate_change_invalidates_the_compatibility_identity() {
  const before = unwrap(rehearsal_input_identity(REVISION, source_tree()))
  const after = unwrap(rehearsal_input_identity(NEXT, source_tree(REVISION, NEXT)))
  assert(before.digest != after.digest)
  const subjects = [{slug: "example/consumer", contract_digest: CONTRACT}]
  const recorded = rehearsal_proof_ref(before.digest, "example/consumer", CONTRACT)
  const coverage = rehearsal_coverage(after.digest, subjects, Ok([recorded]))
  assert(!coverage.covered)
  assert_eq(coverage.considered, 1)
  assert_eq(coverage.missing, ["example/consumer"])
}

pipeline test_build_configuration_assets_and_unknown_roots_invalidate_coverage() {
  const original = source_tree()
  const before = unwrap(rehearsal_input_identity(REVISION, original))
  for name in ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "crates"] {
    const changed = original.tree.map(
      { entry ->
        return if entry.path == name {
          entry + {sha: NEXT}
        } else {
          entry
        }
      },
    )
      .to_list()
    const after = unwrap(rehearsal_input_identity(NEXT, original + {tree: changed}))
    assert(before.digest != after.digest, "changed input must invalidate: ${name}")
  }
  for name in [".github", "scripts", "future-build-input"] {
    const changed = original.tree + [{path: name, mode: "040000", type: "tree", sha: NEXT}]
    const after = unwrap(rehearsal_input_identity(NEXT, original + {tree: changed}))
    assert(before.digest != after.digest, "new input must invalidate: ${name}")
  }
}

pipeline test_only_documentation_directories_are_excluded_not_symlink_targets() {
  const original = source_tree()
  const before = unwrap(rehearsal_input_identity(REVISION, original))
  const linked = original.tree.map(
    { entry ->
      return if entry.path == "docs" {
        entry + {type: "blob", mode: "120000"}
      } else {
        entry
      }
    },
  )
    .to_list()
  const after = unwrap(rehearsal_input_identity(NEXT, original + {tree: linked}))
  assert(before.digest != after.digest)
}

pipeline test_malformed_duplicate_or_missing_required_entries_refuse() {
  const original = source_tree()
  const missing = original.tree.filter({ entry -> return entry.path != "crates" }).to_list()
  assert(is_err(rehearsal_input_identity(REVISION, original + {tree: missing})))
  const duplicate = original.tree + original.tree
  assert(is_err(rehearsal_input_identity(REVISION, original + {tree: duplicate})))
  for invalid in [
    {path: "nested/file", mode: "100644", type: "blob", sha: NEXT},
    {path: "new", mode: "100644", type: "blob", sha: ""},
    {path: "new", mode: "777777", type: "blob", sha: NEXT},
  ] {
    assert(is_err(rehearsal_input_identity(REVISION, original + {tree: original.tree + [invalid]})))
  }
}

pipeline test_missing_or_partial_inventory_is_not_a_measured_zero() {
  for invalid in [nil, {}, {sha: NEXT, tree: []}, {sha: NEXT, truncated: false, tree: []}] {
    assert(is_err(rehearsal_input_identity(REVISION, invalid)))
  }
  const partial = source_tree() + {truncated: true}
  assert(is_err(rehearsal_input_identity(REVISION, partial)))
  assert(is_err(rehearsal_input_identity("", source_tree())))
}
