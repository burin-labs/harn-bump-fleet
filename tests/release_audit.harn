import {
  agent_changelog_section,
  agent_result_text,
  raw_agent_changelog_section,
  validate_release_agent_audit,
  validate_release_agent_audit_with_context,
} from "../lib/release_audit"

fn good_audit() {
  return "Audit:\n- Version/readiness: v1.2.3 is ready.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Added\n\n- **Useful feature.** Release note body.\n\n### Removed\n\n- This unsupported section should not be applied.\nEND_DRAFT_CHANGELOG"
}

pipeline test_release_audit(task) {
  let result = {status: "done", visible_text: good_audit()}
  assert_eq(agent_result_text(result), good_audit())
  assert_eq(contains(raw_agent_changelog_section(good_audit()), "## v1.2.3"), true)
  let section = agent_changelog_section(good_audit(), "1.2.3")
  assert_eq(contains(section, "### Added"), true)
  assert_eq(contains(section, "### Removed"), false)
  assert_eq(validate_release_agent_audit("1.2.3", result, good_audit()), [])
  let malformed = "Audit:\n<tool_call>{}</tool_call>\nBEGIN_DRAFT_CHANGELOG\n## v1.2.4\nEND_DRAFT_CHANGELOG\ntrailing"
  let findings = validate_release_agent_audit("1.2.3", {status: "done"}, malformed)
  assert_eq(len(findings) >= 3, true)
  assert_eq(
    validate_release_agent_audit("1.2.3", {status: "stuck"}, good_audit())
      .contains(
      "agent_loop ended with status `stuck` instead of `done`; the audit text may be incomplete",
    ),
    true,
  )
  let context_findings = validate_release_agent_audit_with_context(
    "1.2.3",
    {status: "done"},
    "Notes first.\n\nBEGIN_DRAFT_CHANGELOG\n## Unreleased\nEND_DRAFT_CHANGELOG",
    {first_post_tag_commit: "abc1234 release: important change"},
  )
  assert_eq(contains(context_findings.join("\n"), "must start with `Audit:`"), true)
  assert_eq(contains(context_findings.join("\n"), "## Unreleased"), true)
  assert_eq(contains(context_findings.join("\n"), "abc1234 release: important change"), true)
}
