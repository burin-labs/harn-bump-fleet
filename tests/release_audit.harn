import { repeat_string } from "std/text"
import {
  agent_changelog_section,
  agent_result_text,
  normalize_agent_audit_text,
  raw_agent_changelog_section,
  validate_release_agent_audit,
  validate_release_agent_audit_with_context,
  validate_release_fixup_audit,
} from "../lib/release_audit"

fn good_audit() {
  return "Audit:\n- Version/readiness: v1.2.3 is ready.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Added\n\n- **Useful feature.** Release note body.\n\n### Removed\n\n- This unsupported section should not be applied.\nEND_DRAFT_CHANGELOG"
}

pipeline test_release_audit(task: any) {
  const result = {status: "done", visible_text: good_audit()}
  assert_eq(agent_result_text(result), good_audit())
  assert_eq(agent_result_text({visible_text: "```text\nvisible\n```", text: "fallback"}), "visible")
  assert_eq(agent_result_text({text: "fallback"}), "fallback")
  assert(contains(agent_result_text({status: "done"}), "Raw result:"))
  assert_eq(contains(raw_agent_changelog_section(good_audit()), "## v1.2.3"), true)
  const section = agent_changelog_section(good_audit(), "1.2.3")
  assert_eq(contains(section, "### Added"), true)
  assert_eq(contains(section, "### Removed"), false)
  assert_eq(validate_release_agent_audit("1.2.3", result.status, good_audit()), [])
  const malformed =
    "Audit:\n<tool_call>{}</tool_call>\nBEGIN_DRAFT_CHANGELOG\n## v1.2.4\nEND_DRAFT_CHANGELOG\ntrailing"
  const findings = validate_release_agent_audit("1.2.3", "done", malformed)
  assert_eq(len(findings) >= 3, true)
  assert_eq(
    validate_release_agent_audit("1.2.3", "stuck", good_audit()).contains(
      "agent_loop ended with status `stuck` instead of `done`; the audit text may be incomplete",
    ),
    true,
  )
  const context_findings = validate_release_agent_audit_with_context(
    "1.2.3",
    "done",
    "Notes first.\n\nBEGIN_DRAFT_CHANGELOG\n## Unreleased\nEND_DRAFT_CHANGELOG",
    {first_post_tag_commit: "abc1234 release: important change"},
  )
  assert_eq(contains(context_findings.join("\n"), "must start with `Audit:`"), true)
  assert_eq(
    contains(
      context_findings.join("\n"),
      "agent draft changelog contains an `## Unreleased` heading",
    ),
    true,
  )
  assert_eq(contains(context_findings.join("\n"), "abc1234 release: important change"), true)
  // A draft whose authored heading is `## v1.2.3` but whose bullet prose
  // describes the literal string `## Unreleased` (e.g. an entry recording a
  // release_ship.sh auto-rename fix) must NOT be flagged — only an actual
  // `## Unreleased` ATX heading on its own line should trigger the finding.
  const prose_mentions_unreleased =
    "Audit:\n- Version/readiness: target `v1.2.3`.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Fixed\n\n- **`release_ship.sh --prepare` auto-renames `## Unreleased` -> `## vX.Y.Z`.**\n  Wraps a prior bug where the heading promotion was missed.\nEND_DRAFT_CHANGELOG"
  const prose_findings = validate_release_agent_audit_with_context(
    "1.2.3",
    "done",
    prose_mentions_unreleased,
    {first_post_tag_commit: "(none)"},
  )
  assert_eq(
    contains(
      prose_findings.join("\n"),
      "agent draft changelog contains an `## Unreleased` heading",
    ),
    false,
  )
  const unwrapped =
    "Audit:\n- Version/readiness: target `v1.2.3`.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Added\n- This release note is intentionally long enough to exceed the markdownlint line length limit so the harness asks the agent to wrap it before applying the changelog draft.\nEND_DRAFT_CHANGELOG"
  const style_findings = validate_release_agent_audit("1.2.3", "done", unwrapped)
  assert_eq(
    contains(style_findings.join("\n"), "heading on line 3 must be followed by a blank line"),
    true,
  )
  // Wrappable overlong prose is normalized deterministically rather than
  // failing the run: the section comes back word-wrapped under 120 columns
  // with two-space bullet continuation indentation, and no wrap finding fires.
  assert_eq(contains(style_findings.join("\n"), "wrap prose to 120 characters or fewer"), false)
  const wrapped_section = agent_changelog_section(unwrapped, "1.2.3")
  for line in split(wrapped_section, "\n") {
    assert_eq(len(line) <= 120, true)
  }
  assert_eq(
    contains(wrapped_section, "\n  agent to wrap it before applying the changelog draft."),
    true,
  )
  // A single token longer than 120 columns cannot be word-wrapped; it passes
  // through unchanged and the style finding still fires.
  const giant_token = repeat_string("x", 130)
  const unwrappable =
    "Audit:\n- Version/readiness: target `v1.2.3`.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Added\n\n- ${giant_token}\nEND_DRAFT_CHANGELOG"
  const unwrappable_findings = validate_release_agent_audit("1.2.3", "done", unwrappable)
  assert_eq(
    contains(unwrappable_findings.join("\n"), "wrap prose to 120 characters or fewer"),
    true,
  )
  const checklist_echo =
    "Audit:\n- Version/readiness: v1.2.3 is ready.\n- CHANGELOG coverage: the draft preserves the prepared release notes.\n- Release risks: none.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Changed\n\n- **Release update.** Keeps the release notes current.\nEND_DRAFT_CHANGELOG"
  const checklist_findings = validate_release_agent_audit_with_context(
    "1.2.3",
    "done",
    checklist_echo,
    {post_tag_pr_numbers: [101, 102]},
  )
  assert_eq(contains(checklist_findings.join("\n"), "CHANGELOG coverage is too generic"), true)
  const pr_outside_coverage = checklist_echo.replace(
    "- Release risks: none.",
    "- First post-tag commit: abc1234 Merge PR #101.\n- Release risks: none.",
  )
  assert_eq(
    contains(
      validate_release_agent_audit_with_context(
        "1.2.3",
        "done",
        pr_outside_coverage,
        {post_tag_pr_numbers: [101, 102]},
      )
        .join("\n"),
      "CHANGELOG coverage is too generic",
    ),
    true,
  )
  const pr_evidence = checklist_echo.replace("prepared release notes", "PR #101 and #102")
  assert_eq(
    contains(
      validate_release_agent_audit_with_context(
        "1.2.3",
        "done",
        pr_evidence,
        {post_tag_pr_numbers: [101, 102]},
      )
        .join("\n"),
      "CHANGELOG coverage is too generic",
    ),
    false,
  )
  const count_evidence = checklist_echo.replace(
    "prepared release notes",
    "2 PRs in the post-tag range",
  )
  assert_eq(
    contains(
      validate_release_agent_audit_with_context(
        "1.2.3",
        "done",
        count_evidence,
        {post_tag_pr_numbers: [101, 102]},
      )
        .join("\n"),
      "CHANGELOG coverage is too generic",
    ),
    false,
  )
}

pipeline test_fixup_audit_rejects_draft_envelopes_not_marker_prose(task: any) {
  const explanatory_prose =
    "Audit:\n- The previous audit mentioned `BEGIN_DRAFT_CHANGELOG`, but this fixup returns no draft.\n- Tag/artifact: unchanged."
  assert_eq(validate_release_fixup_audit("done", explanatory_prose), [])
  const actual_envelope =
    "Audit:\n- Tag/artifact: unchanged.\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\nEND_DRAFT_CHANGELOG"
  assert_eq(
    len(validate_release_fixup_audit("done", actual_envelope))
      > 0,
    true,
  )
}

pipeline test_release_audit_rejects_degenerate_repetition(task: any) {
  const repeated =
    "Audit:\n- Version/readiness: v1.2.3 is ready.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Fixed\n\n- **Bootstrap install race.** Make installation deterministic.\n- Bootstrap-install race: make installation deterministic!\n- **Bootstrap install race.** Make installation deterministic.\n- Bootstrap-install race: make installation deterministic!\n\n### Fixed\n\n- A distinct note.\nEND_DRAFT_CHANGELOG"
  const findings = validate_release_agent_audit("1.2.3", "done", repeated).join("\n")
  assert(contains(findings, "repeats normalized bullet"))
  assert(contains(findings, "repeats normalized heading"))
  assert(contains(findings, "extreme repetition ratio"))
}

pipeline test_release_audit_rejects_a_second_version_section(task: any) {
  const contradictory = good_audit().replace(
    "END_DRAFT_CHANGELOG",
    "\n## v9.9.9\n\n### Changed\n\n- Wrong release range.\nEND_DRAFT_CHANGELOG",
  )
  const findings = validate_release_agent_audit("1.2.3", "done", contradictory).join("\n")
  assert(contains(findings, "contradicts the release version"))
}

pipeline test_release_audit_rejects_a_contradictory_release_range(task: any) {
  const contradictory = good_audit().replace(
    "Version/readiness: v1.2.3 is ready.",
    "Version/readiness: v1.2.3 is ready for v1.2.2..deadbeef.",
  )
  const findings = validate_release_agent_audit_with_context(
    "1.2.3",
    "done",
    contradictory,
    {latest_tag: "v1.2.2", pin_sha: "0123456789abcdef0123456789abcdef01234567"},
  )
    .join("\n")
  assert(contains(findings, "contradicts the pinned release range"))
}

/**
 * The historical failure: a model wrote a command with inline triple backticks,
 * the fence check rejected the whole run, and the release lane failed at
 * `agent-review-validation` with an otherwise clean audit. `strip_code_fences`
 * alone does not cover this — it only drops fence *lines* — so assert on
 * `agent_result_text`, the ingest seam the review loop actually uses.
 */
pipeline test_release_audit_normalizes_inline_code_fences(task: any) {
  const inline_fence = good_audit().replace(
    "v1.2.3 is ready.",
    "v1.2.3 is ready; verified with ```make check``` and ```cargo test```.",
  )
  assert(contains(inline_fence, "```"))
  const ingested = agent_result_text({status: "done", visible_text: inline_fence})
  assert_eq(contains(ingested, "```"), false)
  // Normalization preserves the command, it does not delete the line.
  assert(contains(ingested, "verified with `make check` and `cargo test`."))
  assert_eq(validate_release_agent_audit("1.2.3", "done", ingested), [])
  // A fence line wrapping a command survives as its content, and the draft
  // envelope markers stay plain marker lines either way.
  const fence_block = good_audit().replace(
    "v1.2.3 is ready.",
    "v1.2.3 is ready.\n\n```bash\nmake check\n```",
  )
  const block_ingested = agent_result_text({status: "done", visible_text: fence_block})
  assert_eq(contains(block_ingested, "```"), false)
  assert(contains(block_ingested, "make check"))
  assert(contains(raw_agent_changelog_section(block_ingested), "## v1.2.3"))
  assert_eq(validate_release_agent_audit("1.2.3", "done", block_ingested), [])
  // Normalization is total and idempotent: nothing that reaches CHANGELOG.md
  // can carry a fence, whichever seam the text arrived through. This invariant
  // is what makes dropping the old fence finding safe.
  assert_eq(normalize_agent_audit_text(normalize_agent_audit_text(fence_block)), block_ingested)
  const fenced_draft = good_audit().replace(
    "### Added\n",
    "### Added\n\n```text\nnot a release note\n```\n",
  )
  assert(contains(fenced_draft, "```"))
  assert_eq(contains(agent_changelog_section(fenced_draft, "1.2.3"), "```"), false)
  assert_eq(contains(normalize_agent_audit_text("a ````quad```` b"), "```"), false)
}
