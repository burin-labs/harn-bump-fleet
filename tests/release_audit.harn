import { repeat_string } from "std/text"
import {
  agent_changelog_section,
  agent_result_text,
  raw_agent_changelog_section,
  validate_release_agent_audit,
  validate_release_agent_audit_with_context,
  validate_release_fixup_audit_with_context,
} from "../lib/release_audit"

fn good_audit() {
  return "Audit:\n- Version/readiness: v1.2.3 is ready.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Added\n\n- **Useful feature.** Release note body.\n\n### Removed\n\n- This unsupported section should not be applied.\nEND_DRAFT_CHANGELOG"
}

pipeline test_release_audit(task) {
  const result = {status: "done", visible_text: good_audit()}
  assert_eq(agent_result_text(result), good_audit())
  assert_eq(contains(raw_agent_changelog_section(good_audit()), "## v1.2.3"), true)
  const section = agent_changelog_section(good_audit(), "1.2.3")
  assert_eq(contains(section, "### Added"), true)
  assert_eq(contains(section, "### Removed"), false)
  assert_eq(validate_release_agent_audit("1.2.3", result, good_audit()), [])
  const malformed = "Audit:\n<tool_call>{}</tool_call>\nBEGIN_DRAFT_CHANGELOG\n## v1.2.4\nEND_DRAFT_CHANGELOG\ntrailing"
  const findings = validate_release_agent_audit("1.2.3", {status: "done"}, malformed)
  assert_eq(len(findings) >= 3, true)
  assert_eq(
    validate_release_agent_audit("1.2.3", {status: "stuck"}, good_audit()).contains(
      "agent_loop ended with status `stuck` instead of `done`; the audit text may be incomplete",
    ),
    true,
  )
  const context_findings = validate_release_agent_audit_with_context(
    "1.2.3",
    {status: "done"},
    "Notes first.\n\nBEGIN_DRAFT_CHANGELOG\n## Unreleased\nEND_DRAFT_CHANGELOG",
    {first_post_tag_commit: "abc1234 release: important change"},
  )
  assert_eq(contains(context_findings.join("\n"), "must start with `Audit:`"), true)
  assert_eq(
    contains(context_findings.join("\n"), "agent draft changelog contains an `## Unreleased` heading"),
    true,
  )
  assert_eq(contains(context_findings.join("\n"), "abc1234 release: important change"), true)
  // A draft whose authored heading is `## v1.2.3` but whose bullet prose
  // describes the literal string `## Unreleased` (e.g. an entry recording a
  // release_ship.sh auto-rename fix) must NOT be flagged — only an actual
  // `## Unreleased` ATX heading on its own line should trigger the finding.
  const prose_mentions_unreleased = "Audit:\n- Version/readiness: target `v1.2.3`.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Fixed\n\n- **`release_ship.sh --prepare` auto-renames `## Unreleased` -> `## vX.Y.Z`.**\n  Wraps a prior bug where the heading promotion was missed.\nEND_DRAFT_CHANGELOG"
  const prose_findings = validate_release_agent_audit_with_context(
    "1.2.3",
    {status: "done"},
    prose_mentions_unreleased,
    {first_post_tag_commit: "(none)"},
  )
  assert_eq(
    contains(prose_findings.join("\n"), "agent draft changelog contains an `## Unreleased` heading"),
    false,
  )
  const unwrapped = "Audit:\n- Version/readiness: target `v1.2.3`.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Added\n- This release note is intentionally long enough to exceed the markdownlint line length limit so the harness asks the agent to wrap it before applying the changelog draft.\nEND_DRAFT_CHANGELOG"
  const style_findings = validate_release_agent_audit("1.2.3", {status: "done"}, unwrapped)
  assert_eq(
    contains(style_findings.join("\n"), "heading on line 3 must be followed by a blank line"),
    true,
  )
  // Wrappable overlong prose is normalized deterministically rather than
  // failing the run: the section comes back word-wrapped under 120 columns
  // with two-space bullet continuation indentation, and no wrap finding fires.
  assert_eq(contains(style_findings.join("\n"), "wrap prose to 120 characters or fewer"), false)
  const wrapped_section = agent_changelog_section(unwrapped, "1.2.3")
  for line in split(wrapped_section, "\n") {
    assert_eq(len(line) <= 120, true)
  }
  assert_eq(
    contains(wrapped_section, "\n  agent to wrap it before applying the changelog draft."),
    true,
  )
  // A single token longer than 120 columns cannot be word-wrapped; it passes
  // through unchanged and the style finding still fires.
  const giant_token = repeat_string("x", 130)
  const unwrappable = "Audit:\n- Version/readiness: target `v1.2.3`.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Added\n\n- ${giant_token}\nEND_DRAFT_CHANGELOG"
  const unwrappable_findings = validate_release_agent_audit("1.2.3", {status: "done"}, unwrappable)
  assert_eq(contains(unwrappable_findings.join("\n"), "wrap prose to 120 characters or fewer"), true)
  const checklist_echo = "Audit:\n- Version/readiness: v1.2.3 is ready.\n- CHANGELOG coverage: the draft preserves the prepared release notes.\n- Release risks: none.\n\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\n\n### Changed\n\n- **Release update.** Keeps the release notes current.\nEND_DRAFT_CHANGELOG"
  const checklist_findings = validate_release_agent_audit_with_context(
    "1.2.3",
    {status: "done"},
    checklist_echo,
    {post_tag_pr_numbers: [101, 102]},
  )
  assert_eq(contains(checklist_findings.join("\n"), "CHANGELOG coverage is too generic"), true)
  const pr_outside_coverage = checklist_echo.replace(
    "- Release risks: none.",
    "- First post-tag commit: abc1234 Merge PR #101.\n- Release risks: none.",
  )
  assert_eq(
    contains(
      validate_release_agent_audit_with_context(
        "1.2.3",
        {status: "done"},
        pr_outside_coverage,
        {post_tag_pr_numbers: [101, 102]},
      )
        .join("\n"),
      "CHANGELOG coverage is too generic",
    ),
    true,
  )
  const pr_evidence = checklist_echo.replace("prepared release notes", "PR #101 and #102")
  assert_eq(
    contains(
      validate_release_agent_audit_with_context(
        "1.2.3",
        {status: "done"},
        pr_evidence,
        {post_tag_pr_numbers: [101, 102]},
      )
        .join("\n"),
      "CHANGELOG coverage is too generic",
    ),
    false,
  )
  const count_evidence = checklist_echo.replace("prepared release notes", "2 PRs in the post-tag range")
  assert_eq(
    contains(
      validate_release_agent_audit_with_context(
        "1.2.3",
        {status: "done"},
        count_evidence,
        {post_tag_pr_numbers: [101, 102]},
      )
        .join("\n"),
      "CHANGELOG coverage is too generic",
    ),
    false,
  )
}

pipeline test_fixup_audit_rejects_draft_envelopes_not_marker_prose(task) {
  const explanatory_prose = "Audit:\n- The previous audit mentioned `BEGIN_DRAFT_CHANGELOG`, but this fixup returns no draft.\n- Tag/artifact: unchanged."
  assert_eq(
    validate_release_fixup_audit_with_context("1.2.3", {status: "done"}, explanatory_prose, {}),
    [],
  )
  const actual_envelope = "Audit:\n- Tag/artifact: unchanged.\nBEGIN_DRAFT_CHANGELOG\n## v1.2.3\nEND_DRAFT_CHANGELOG"
  assert_eq(
    len(validate_release_fixup_audit_with_context("1.2.3", {status: "done"}, actual_envelope, {}))
      > 0,
    true,
  )
}
