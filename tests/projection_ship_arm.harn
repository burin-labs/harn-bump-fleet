import { arm_projection_ship } from "../lib/projection_ship_arm"

const API = "https://github.test"

const REPO = "octo-org/octo-repo"

const MAIN = "a".repeat(40)

const HEAD = "b".repeat(40)

const CALLER = """
on:
  pull_request_target:
    types: [labeled, synchronize]
  schedule:
    - cron: "7,22,37,52 * * * *"
jobs:
  ship:
    uses: burin-labs/.github/.github/workflows/smart-ship.yml@12f9468a8ba51a6c38d15624ca0a50d178be7e6a
"""

fn mock_arm(testing: HarnessTesting, head: string, caller: string) {
  testing.http_mock_clear()
  testing.http_mock(
    "GET",
    API + "/repos/" + REPO + "/branches/main",
    {status: 200, body: json_stringify({name: "main", commit: {sha: MAIN}})},
  )
  testing.http_mock(
    "GET",
    API + "/repos/" + REPO + "/contents/.github/workflows/smart-ship.yml?ref=" + MAIN,
    {
      status: 200,
      body: json_stringify(
        {
          name: "smart-ship.yml",
          path: ".github/workflows/smart-ship.yml",
          sha: MAIN,
          size: len(caller),
          type: "file",
          encoding: "base64",
          content: base64_encode(caller),
        },
      ),
    },
  )
  testing.http_mock(
    "GET",
    API + "/repos/" + REPO + "/pulls/77",
    {
      status: 200,
      body: json_stringify(
        {
          number: 77,
          node_id: "PR_77",
          title: "[CI] Restore projections",
          state: "open",
          html_url: "https://github.com/" + REPO + "/pull/77",
          auto_merge: nil,
          base: {ref: "main", sha: MAIN, repo: {full_name: REPO, owner: {login: "octo-org"}}},
          head: {
            ref: "automation/fleet-projections-123456789abc",
            sha: head,
            repo: {full_name: REPO, owner: {login: "octo-org"}},
          },
        },
      ),
    },
  )
  testing.http_mock(
    "GET",
    API + "/repos/" + REPO + "/branches/main/protection",
    {status: 404, body: "{}"},
  )
  testing.http_mock(
    "POST",
    API + "/repos/" + REPO + "/issues/77/labels",
    {status: 200, body: json_stringify([{name: "ship"}])},
  )
}

pipeline test_real_connector_adds_ship_without_raw_auto_merge(harness: Harness) {
  const options = {api_base_url: API, installation_token: "fixture-token"}
  mock_arm(harness.testing, HEAD, CALLER)
  const result = arm_projection_ship(harness, REPO, "main", 77, HEAD, options)
  assert_eq(result.state, "armed", to_string(result.error ?? ""))
  const posts =
    harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()
  assert_eq(len(posts), 1)
  assert(posts[0].url.ends_with("/issues/77/labels"))
  assert(posts[0].body.contains("ship"))
  assert(!posts.any({ call -> call.url.ends_with("/graphql") }))
}

pipeline test_changed_head_or_caller_never_adds_ship(harness: Harness) {
  const options = {api_base_url: API, installation_token: "fixture-token"}
  for row in [{head: MAIN, caller: CALLER}, {head: HEAD, caller: ""}] {
    mock_arm(harness.testing, row.head, row.caller)
    const result = arm_projection_ship(harness, REPO, "main", 77, HEAD, options)
    assert_eq(result.state, "refused", json_stringify(row))
    assert(
      !harness.testing.http_mock_calls().any(
        { call -> call.method == "POST" && call.url.ends_with("/issues/77/labels") },
      ),
    )
  }
}
