//
// A real `regex_captures` reader, kept as the coverage census's known non-null
// probe. The census claims that a call site inside a declaration a test reaches
// is covered; this file gives that claim something to be true about, so a zero
// pending count can be told apart from a census that measured nothing.
/** Read a release line, returning `major.minor` or nil when the line is not one. */
pub fn probe_release_version(line: string) -> string? {
  const captured = regex_captures("^release v([0-9]+)\\.([0-9]+)$", trim(line))
  if len(captured) != 1 {
    return nil
  }
  return "${captured[0].groups[0]}.${captured[0].groups[1]}"
}
