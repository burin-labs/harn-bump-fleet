import { dry_run_predispatch_outcome } from "../lib/bump_decision"

fn base(local_pin, remote_pin) {
  return {slug: "burin-labs/demo", local_pin: local_pin, remote_pin: remote_pin}
}

pipeline test_dry_run_remote_current_uses_remote_pin(task) {
  let outcome = dry_run_predispatch_outcome(base("0.8.44", "0.8.45"), "v0.8.45", "0.8.45", "0.8.45")
  assert_eq(outcome.status, "already_current")
  assert_eq(contains(outcome.detail, "remote main pin is 0.8.45; matches target"), true)
  assert_eq(contains(outcome.detail, "local checkout pin is 0.8.44"), true)
}

pipeline test_dry_run_existing_target_pr_no_dispatch(task) {
  let pr = {number: 42, url: "https://example.test/pr/42", autoMergeRequest: {}}
  let probe = {matches: true, evidence: "PR head pin is 0.8.45; target is 0.8.45"}
  let outcome = dry_run_predispatch_outcome(base("0.8.44", "0.8.44"), "v0.8.45", "0.8.45", "0.8.44", pr, probe)
  assert_eq(outcome.status, "dry_run_pr_open_for_target")
  assert_eq(outcome.pr_number, 42)
  assert_eq(outcome.auto_merge, "already_enabled")
}

pipeline test_dry_run_stale_pr_mentions_close_then_dispatch(task) {
  let pr = {number: 7, url: "https://example.test/pr/7", autoMergeRequest: nil}
  let probe = {matches: false, evidence: "PR head pin is 0.8.44; target is 0.8.45"}
  let outcome = dry_run_predispatch_outcome(base("0.8.44", "0.8.44"), "v0.8.45", "0.8.45", "0.8.44", pr, probe)
  assert_eq(outcome.status, "dry_run_stale_pr")
  assert_eq(contains(outcome.detail, "would close stale PR #7"), true)
  assert_eq(contains(outcome.detail, "then dispatch bump-harn.yml with version=v0.8.45"), true)
}

pipeline test_dry_run_unresolved_repo_would_dispatch(task) {
  let outcome = dry_run_predispatch_outcome(base("0.8.44", "0.8.44"), "v0.8.45", "0.8.45", "0.8.44")
  assert_eq(outcome.status, "dry_run")
  assert_eq(outcome.detail, "would dispatch bump-harn.yml with version=v0.8.45")
}
