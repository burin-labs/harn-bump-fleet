import {
  dry_run_predispatch_outcome,
  harn_pin_decision,
  satisfied_main_pr_decision,
} from "../lib/bump_decision"
import { FleetOutcomeReceipt } from "../lib/run_receipts"

fn base(local_pin: string, remote_pin: string) -> FleetOutcomeReceipt {
  return {
    slug: "burin-labs/demo",
    status: "pending",
    detail: "",
    local_pin: local_pin,
    remote_pin: remote_pin,
  }
}

pipeline test_dry_run_remote_current_uses_remote_pin(task: any) {
  const outcome = dry_run_predispatch_outcome(
    base("0.8.44", "0.8.45"),
    "v0.8.45",
    "0.8.45",
    "0.8.45",
  )
  assert_eq(outcome.status, "already_current")
  assert_eq(contains(outcome.detail, "remote main pin is 0.8.45; matches target"), true)
  assert_eq(contains(outcome.detail, "local checkout pin is 0.8.44"), true)
}

pipeline test_pin_decision_is_monotonic_and_fails_closed(task: any) {
  const behind = harn_pin_decision("v0.10.83", "v0.10.84")
  assert_eq(behind.ok, true)
  assert_eq(behind.relation, "behind")
  assert_eq(behind.satisfies_target, false)
  const equal = harn_pin_decision("0.10.84", "v0.10.84")
  assert_eq(equal.relation, "equal")
  assert_eq(equal.satisfies_target, true)
  const ahead = harn_pin_decision("v0.10.85", "v0.10.84")
  assert_eq(ahead.relation, "ahead")
  assert_eq(ahead.satisfies_target, true)
  const invalid = harn_pin_decision("latest", "v0.10.84")
  assert_eq(invalid.ok, false)
  assert_eq(invalid.satisfies_target, false)
  assert_eq(invalid.relation, nil)
}

pipeline test_dry_run_newer_remote_never_dispatches_and_would_close_stale_pr(task: any) {
  const pr = {number: 91, url: "https://example.test/pr/91", auto_merge_armed: true}
  const probe = {
    matches: true,
    pin: "0.10.84",
    evidence: "PR head pin is 0.10.84; target is 0.10.84",
  }
  const outcome = dry_run_predispatch_outcome(
    base("0.10.85", "0.10.85"),
    "v0.10.84",
    "0.10.84",
    "0.10.85",
    pr,
    probe,
  )
  assert_eq(outcome.status, "already_current")
  assert_eq(contains(outcome.detail, "newer than target 0.10.84"), true)
  assert_eq(contains(outcome.detail, "would close redundant or regressive bump PR #91"), true)
}

pipeline test_satisfied_main_preserves_only_forward_bump_prs(task: any) {
  const forward = satisfied_main_pr_decision("0.10.84", "0.10.85")
  assert_eq(forward.action, "preserve")
  assert_eq(forward.relation, "ahead")
  const duplicate = satisfied_main_pr_decision("0.10.84", "0.10.84")
  assert_eq(duplicate.action, "close")
  assert_eq(duplicate.relation, "equal")
  const downgrade = satisfied_main_pr_decision("0.10.85", "0.10.84")
  assert_eq(downgrade.action, "close")
  assert_eq(downgrade.relation, "behind")
  const unknown = satisfied_main_pr_decision("0.10.85", nil)
  assert_eq(unknown.action, "refuse")
  assert_eq(unknown.relation, nil)
}

pipeline test_dry_run_older_audit_preserves_newer_forward_bump_pr(task: any) {
  const pr = {number: 92, url: "https://example.test/pr/92", auto_merge_armed: true}
  const probe = {matches: false, pin: "0.10.85", evidence: "PR head pin is 0.10.85"}
  const outcome = dry_run_predispatch_outcome(
    base("0.10.84", "0.10.84"),
    "v0.10.84",
    "0.10.84",
    "0.10.84",
    pr,
    probe,
  )
  assert_eq(outcome.status, "already_current")
  assert_eq(contains(outcome.detail, "would preserve forward bump PR #92"), true)
}

pipeline test_dry_run_existing_target_pr_no_dispatch(task: any) {
  const pr = {number: 42, url: "https://example.test/pr/42", auto_merge_armed: true}
  const probe = {matches: true, evidence: "PR head pin is 0.8.45; target is 0.8.45"}
  const outcome = dry_run_predispatch_outcome(
    base("0.8.44", "0.8.44"),
    "v0.8.45",
    "0.8.45",
    "0.8.44",
    pr,
    probe,
  )
  assert_eq(outcome.status, "dry_run_pr_open_for_target")
  assert_eq(outcome.pr_number, 42)
  assert_eq(outcome.auto_merge, "already_enabled")
}

pipeline test_dry_run_stale_pr_mentions_close_then_dispatch(task: any) {
  const pr = {number: 7, url: "https://example.test/pr/7", auto_merge_armed: false}
  const probe = {matches: false, evidence: "PR head pin is 0.8.44; target is 0.8.45"}
  const outcome = dry_run_predispatch_outcome(
    base("0.8.44", "0.8.44"),
    "v0.8.45",
    "0.8.45",
    "0.8.44",
    pr,
    probe,
  )
  assert_eq(outcome.status, "dry_run_stale_pr")
  assert_eq(contains(outcome.detail, "would close stale PR #7"), true)
  assert_eq(contains(outcome.detail, "then dispatch bump-harn.yml with version=v0.8.45"), true)
}

pipeline test_dry_run_unresolved_repo_would_dispatch(task: any) {
  const outcome = dry_run_predispatch_outcome(
    base("0.8.44", "0.8.44"),
    "v0.8.45",
    "0.8.45",
    "0.8.44",
  )
  assert_eq(outcome.status, "dry_run")
  assert_eq(outcome.detail, "would dispatch bump-harn.yml with version=v0.8.45")
}
