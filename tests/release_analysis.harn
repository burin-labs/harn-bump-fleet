import {
  last_published_release_version,
  next_release_version,
  release_body_gate_version,
} from "../lib/release_analysis"

fn release_error(current: string, latest_tag: string, bump: string, preid: string) -> string {
  return try {
    next_release_version(current, latest_tag, bump, preid)
    ""
  } catch (error) {
    to_string(error)
  }
}

pipeline test_release_analysis() {
  assert_eq(next_release_version("0.10.95", "v0.10.96", "patch", ""), "0.10.97")
  assert_eq(next_release_version("0.10.96", "v0.10.96", "patch", ""), "0.10.97")
  assert_eq(next_release_version("0.10.96", "v0.10.95", "patch", ""), "0.10.97")
}

pipeline test_release_analysis_strips_the_declared_development_suffix() {
  assert_eq(next_release_version("0.10.115-dev", "v0.10.114", "patch", ""), "0.10.115")
}

pipeline test_release_analysis_rejects_a_stale_development_target() {
  assert(
    contains(
      release_error("0.10.114-dev", "v0.10.114", "patch", ""),
      "does not name the patch after v0.10.114",
    ),
  )
}

pipeline test_release_analysis_rejects_reinterpreting_a_development_target() {
  assert(
    contains(
      release_error("0.10.115-dev", "v0.10.114", "minor", ""),
      "use a patch release to strip -dev",
    ),
  )
  assert(
    contains(
      release_error("0.10.115-dev", "v0.10.114", "prepatch", "rc"),
      "use a patch release to strip -dev",
    ),
  )
}

pipeline test_last_published_release_version_resolves_a_development_workspace() {
  assert_eq(last_published_release_version("0.10.115-dev", "v0.10.114"), "0.10.114")
}

pipeline test_last_published_release_version_keeps_a_released_workspace() {
  assert_eq(last_published_release_version("0.10.114", "v0.10.114"), "0.10.114")
  assert_eq(last_published_release_version("0.10.114", "v0.10.113"), "0.10.114")
}

pipeline test_last_published_release_version_keeps_a_development_workspace_without_a_tag() {
  assert_eq(last_published_release_version("0.10.115-dev", ""), "0.10.115-dev")
  assert_eq(last_published_release_version("0.10.115-dev", "   "), "0.10.115-dev")
}

pipeline test_release_body_gate_verifies_the_release_that_already_shipped() {
  // The gate must look up v0.10.114, the release that exists, not the
  // v0.10.115-dev workspace version that names the candidate.
  assert_eq(release_body_gate_version("0.10.115-dev", "0.10.115", "v0.10.114", false), "0.10.114")
  assert_eq(release_body_gate_version("0.10.114", "0.10.115", "v0.10.114", false), "0.10.114")
}

pipeline test_release_body_gate_verifies_a_republished_fixup_candidate() {
  assert_eq(release_body_gate_version("0.10.115-dev", "0.10.115", "v0.10.114", true), "0.10.115")
}
