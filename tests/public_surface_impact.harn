import {
  public_surface_candidates_from_analysis,
  public_surface_candidates_from_text,
  public_surface_impact_for_repo,
  public_surface_impact_for_repos,
  public_surface_impact_markdown,
  public_surface_impact_report,
  public_surface_usage_from_repo,
  public_surface_usage_from_text,
} from "../lib/public_surface_impact"
import { fail, ok } from "../lib/shell_util"

fn grep_runner(rows) {
  return { repo, surface ->
    const key = repo + "|" + surface
    return rows[key] ?? fail(1, "")
  }
}

pipeline test_public_surface_candidates_from_release_text(task) {
  const text = join(
    [
      "### Removed",
      "- Removed `std/json.safe_parse`; use `try { json_parse(...) }` instead.",
      "- Changed internal docs only.",
      "- BREAKING: renamed harn_host.run-command to `harn_host.run_command`.",
      "- Retry an empty-completion and no longer do transcript search.",
      "- v1.2.3 is not a public surface.",
    ],
    "\n",
  )
  const surfaces = public_surface_candidates_from_text(text)
  assert_eq(surfaces, ["harn_host.run-command", "harn_host.run_command", "std/json.safe_parse"])
}

pipeline test_public_surface_candidates_from_analysis(task) {
  const analysis = {
    changelog_section: "- Removed `std/json.safe_parse`.\n",
    changelog_unreleased_section: "",
    diff_names: "crates/harn-stdlib/src/json.harn\n",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
  }
  assert_eq(public_surface_candidates_from_analysis(analysis), ["std/json.safe_parse"])
}

pipeline test_public_surface_usage_from_text(task) {
  const usage = public_surface_usage_from_text(
    "burin-code",
    "import { safe_parse } from \"std/json\"\nconst parsed = std/json.safe_parse(raw)",
    ["std/json.safe_parse", "harn_host.run_command"],
  )
  assert_eq(usage.repo, "burin-code")
  assert_eq(usage.match_count, 1)
  assert_eq(usage.matches[0]?.surface, "std/json.safe_parse")
}

pipeline test_public_surface_usage_from_repo_with_injected_runner(task) {
  const usage = public_surface_usage_from_repo(
    "/tmp/burin-code",
    ["std/json.safe_parse", "harn_host.run_command"],
    grep_runner(
      {"/tmp/burin-code|std/json.safe_parse": ok("scripts/foo.harn:7:std/json.safe_parse(raw)\n")},
    ),
  )
  assert_eq(usage.match_count, 1)
  assert_eq(usage.matches[0]?.surface, "std/json.safe_parse")
  assert(contains(usage.matches[0]?.evidence ?? "", "scripts/foo.harn"))
}

pipeline test_public_surface_impact_for_repos_scans_discovered_checkout_dirs(task) {
  const analysis = {
    changelog_section: "- Removed `std/json.safe_parse`.\n",
    changelog_unreleased_section: "",
    diff_names: "",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
  }
  const report = public_surface_impact_for_repos(
    "v1.2.3",
    analysis,
    [{slug: "burin-labs/burin-code", dir: "/tmp/burin-code"}],
    grep_runner(
      {"/tmp/burin-code|std/json.safe_parse": ok("Sources/foo.harn:3:std/json.safe_parse(raw)\n")},
    ),
  )
  assert_eq(report.source_status, "analysis")
  assert_eq(report.surface_count, 1)
  assert_eq(report.affected_repo_count, 1)
  assert_eq(report.affected_repos[0]?.repo, "burin-labs/burin-code")
}

pipeline test_public_surface_impact_for_repo_filters_report(task) {
  const report = public_surface_impact_report(
    "v1.2.3",
    {
      changelog_section: "- Removed `std/json.safe_parse`.\n",
      changelog_unreleased_section: "",
      diff_names: "",
      commit_file_changes_since_latest_tag: "",
      commit_stats_since_latest_tag: "",
    },
    [
      {
        repo: "burin-labs/burin-code",
        match_count: 1,
        matches: [{surface: "std/json.safe_parse", evidence: "x"}],
      },
      {
        repo: "burin-labs/harn-canon",
        match_count: 1,
        matches: [{surface: "std/json.safe_parse", evidence: "y"}],
      },
    ],
  )
  const filtered = public_surface_impact_for_repo(report, "burin-labs/harn-canon")
  assert_eq(filtered.affected_repo_count, 1)
  assert_eq(filtered.affected_repos[0]?.repo, "burin-labs/harn-canon")
}

pipeline test_public_surface_impact_report_and_markdown(task) {
  const analysis = {
    changelog_section: "- Removed `std/json.safe_parse`; use json_parse guarded by try/catch.\n",
    changelog_unreleased_section: "",
    diff_names: "",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
  }
  const usage = public_surface_usage_from_text(
    "burin-code",
    "let parsed = std/json.safe_parse(raw)",
    ["std/json.safe_parse"],
  )
  const report = public_surface_impact_report("v1.2.3", analysis, [usage])
  assert_eq(report.surface_count, 1)
  assert_eq(report.affected_repo_count, 1)
  const body = public_surface_impact_markdown("v1.2.3", report)
  assert(contains(body, "Harn public-surface impact"))
  assert(contains(body, "Target Harn version: `v1.2.3`"))
  assert(contains(body, "Evidence source: `analysis`"))
  assert(contains(body, "`std/json.safe_parse`"))
  assert(contains(body, "`burin-code`: std/json.safe_parse"))
}
