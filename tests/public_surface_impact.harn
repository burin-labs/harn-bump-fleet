pipeline test_public_surface_impact_for_repo_filters_report(task) {
  const report = public_surface_impact_report(
    "v1.2.3",
    {
      changelog_section: "- Removed `std/json.safe_parse`.\n",
      changelog_unreleased_section: "",
      diff_names: "",
      commit_file_changes_since_latest_tag: "",
      commit_stats_since_latest_tag: "",
    },
    [
      {
        repo: "burin-labs/burin-code",
        match_count: 1,
        matches: [{surface: "std/json.safe_parse", evidence: "x"}],
      },
      {
        repo: "burin-labs/harn-canon",
        match_count: 1,
        matches: [{surface: "std/json.safe_parse", evidence: "y"}],
      },
    ],
  )
  const filtered = public_surface_impact_for_repo(report, "burin-labs/harn-canon")
  assert_eq(filtered.affected_repo_count, 1)
  assert_eq(filtered.affected_repos[0]?.repo, "burin-labs/harn-canon")
}

pipeline test_public_surface_impact_report_and_markdown(task) {
  const analysis = {
    changelog_section: "- Removed `std/json.safe_parse`; use json_parse guarded by try/catch.\n",
    changelog_unreleased_section: "",
    diff_names: "",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
  }
  const usage = public_surface_usage_from_text(
    "burin-code",
    "let parsed = std/json.safe_parse(raw)",
    ["std/json.safe_parse"],
  )
  const report = public_surface_impact_report("v1.2.3", analysis, [usage])
  assert_eq(report.surface_count, 1)
  assert_eq(report.affected_repo_count, 1)
  const body = public_surface_impact_markdown("v1.2.3", report)
  assert(contains(body, "Harn public-surface impact"))
  assert(contains(body, "Target Harn version: `v1.2.3`"))
  assert(contains(body, "Evidence source: `analysis`"))
  assert(contains(body, "`std/json.safe_parse`"))
  assert(contains(body, "`burin-code`: std/json.safe_parse"))
}
