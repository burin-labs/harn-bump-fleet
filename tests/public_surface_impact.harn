pipeline test_public_surface_diff_paths_limit_to_contract_sources(task) {
  const paths = public_surface_diff_paths_from_text(
    join(
      [
        "README.md",
        "crates/harn-cli/src/commands/provider_report.rs",
        "crates/harn-vm/src/llm/tool_conformance_tests.rs",
        "crates/harn-vm/tests/run_view_fixtures.rs",
        "stdlib/llm/tools.harn",
        "scripts/tests/provider_tool_probe_campaign_test.harn",
        "spec/acp-registry/harn/agent.json",
        "tree-sitter-harn/src/parser.c",
        "crates/harn-cli/Cargo.toml",
      ],
      "\n",
    ),
  )
  assert_eq(
    paths,
    [
      "crates/harn-cli/src/commands/provider_report.rs",
      "spec/acp-registry/harn/agent.json",
      "stdlib/llm/tools.harn",
    ],
  )
}

pipeline test_public_surface_release_diff_reads_only_eligible_sources(task) {
  const diff = join(
    [
      "diff --git a/stdlib/llm/tools.harn b/stdlib/llm/tools.harn",
      "@@ -1 +1 @@",
      "-pub fn old_tool() {}",
      "+pub fn safe_parse() {}",
    ],
    "\n",
  )
  const result = public_surface_release_diff(
    "1.2.3",
    "/tmp/harn",
    git_runner(
      {
        "git describe --tags --abbrev=0 v1.2.3^": command_result_ok("v1.2.2\n"),
        "git diff --name-only v1.2.2..v1.2.3": command_result_ok(
          "README.md\ncrates/harn-cli/src/commands/provider_report.rs\nstdlib/llm/tools.harn\n",
        ),
        "git diff --unified=0 --no-ext-diff v1.2.2..v1.2.3 -- crates/harn-cli/src/commands/provider_report.rs stdlib/llm/tools.harn": command_result_ok(
          diff,
        ),
      },
    ),
  )
  assert_eq(result.known, true)
  assert_eq(result.status, "git_release_diff")
  assert_eq(result.base_tag, "v1.2.2")
  assert_eq(result.target_tag, "v1.2.3")
  assert_eq(
    result.paths,
    ["crates/harn-cli/src/commands/provider_report.rs", "stdlib/llm/tools.harn"],
  )
  assert_eq(result.patch, diff)
}

pipeline test_public_surface_release_diff_is_nonblocking_when_history_is_unavailable(task) {
  const result = public_surface_release_diff(
    "v1.2.3",
    "/tmp/harn",
    git_runner(
      {"git describe --tags --abbrev=0 v1.2.3^": command_result_fail(1, "unknown revision")},
    ),
  )
  assert_eq(result.known, false)
  assert_eq(result.status, "previous_tag_unavailable")
  assert_eq(result.patch, "")
  assert(contains(result.detail, "unknown revision"))
}

pipeline test_public_surface_release_diff_is_nonblocking_when_source_read_fails(task) {
  const result = public_surface_release_diff(
    "v1.2.3",
    "/tmp/harn",
    git_runner(
      {
        "git describe --tags --abbrev=0 v1.2.3^": command_result_ok("v1.2.2\n"),
        "git diff --name-only v1.2.2..v1.2.3": command_result_ok("stdlib/llm/tools.harn\n"),
        "git diff --unified=0 --no-ext-diff v1.2.2..v1.2.3 -- stdlib/llm/tools.harn": command_result_fail(
          1,
          "object missing",
        ),
      },
    ),
  )
  assert_eq(result.known, false)
  assert_eq(result.status, "release_diff_unavailable")
  assert_eq(result.paths, ["stdlib/llm/tools.harn"])
  assert_eq(result.patch, "")
  assert(contains(result.detail, "object missing"))
}

pipeline test_changelog_silent_diff_derives_contract_candidates(task) {
  const diff = join(
    [
      "diff --git a/crates/harn-acp/src/protocol.rs b/crates/harn-acp/src/protocol.rs",
      "@@ -1 +1 @@",
      "+#[derive(Debug, Serialize)]",
      "+pub struct ToolScorecardRoute {",
      "+  pub observed_probe_cases: Vec<&'static str>,",
      "+}",
      "+const SCHEMA_VERSION: u8 = 3;",
      "+const TOOL_CONFORMANCE_REQUEST_AUDIT_SCHEMA_VERSION: u32 = 4;",
      "+const TERMINAL_EVENT: &str = \"harn.agent_terminal.v1\";",
      "+#[command(name = \"dispatch-audit\")]",
      "+pub fn safe_parse(input) {}",
    ],
    "\n",
  )
  const surfaces = public_surface_candidates_from_diff(diff)
  assert(contains(surfaces, "ToolScorecardRoute"))
  assert(contains(surfaces, "observed_probe_cases"))
  assert(contains(surfaces, "SCHEMA_VERSION"))
  assert(contains(surfaces, "TOOL_CONFORMANCE_REQUEST_AUDIT_SCHEMA_VERSION"))
  assert(contains(surfaces, "harn.agent_terminal.v1"))
  assert(contains(surfaces, "dispatch-audit"))
  assert(contains(surfaces, "safe_parse"))
}

pipeline test_changelog_silent_diff_flows_into_downstream_impact(task) {
  const analysis = {
    changelog_section: "",
    changelog_unreleased_section: "",
    diff_names: "",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
    public_surface_diff:
      "+#[derive(Debug, Serialize)]\n+pub struct ToolConformanceRequestAuditReport {\n+  pub not_applicable_count: usize,\n+}",
  }
  const report = public_surface_impact_for_repos(
    "v1.2.3",
    analysis,
    [{slug: "burin-labs/burin-code", dir: "/tmp/burin-code"}],
    grep_runner(
      {
        "/tmp/burin-code|not_applicable_count": command_result_ok(
          "Sources/BurinCore/ToolAudit.swift:7:not_applicable_count\n",
        ),
      },
    ),
  )
  assert(contains(report.surfaces, "ToolConformanceRequestAuditReport"))
  assert(contains(report.surfaces, "not_applicable_count"))
  assert_eq(report.affected_repo_count, 1)
  assert_eq(report.affected_repos[0]?.repo, "burin-labs/burin-code")
  assert_eq(report.affected_repos[0]?.matches?.[0]?.surface, "not_applicable_count")
}

pipeline test_public_surface_usage_from_text(task) {
  const usage = public_surface_usage_from_text(
    "burin-code",
    "import { safe_parse } from \"std/json\"\nconst parsed = std/json.safe_parse(raw)",
    ["std/json.safe_parse", "harn_host.run_command"],
  )
  assert_eq(usage.repo, "burin-code")
  assert_eq(usage.match_count, 1)
  assert_eq(usage.matches[0]?.surface, "std/json.safe_parse")
}

pipeline test_public_surface_usage_from_repo_with_injected_runner(task) {
  const usage = public_surface_usage_from_repo(
    "/tmp/burin-code",
    ["std/json.safe_parse", "harn_host.run_command"],
    grep_runner(
      {
        "/tmp/burin-code|std/json.safe_parse": command_result_ok(
          "scripts/foo.harn:7:std/json.safe_parse(raw)\n",
        ),
      },
    ),
  )
  assert_eq(usage.match_count, 1)
  assert_eq(usage.matches[0]?.surface, "std/json.safe_parse")
  assert(contains(usage.matches[0]?.evidence ?? "", "scripts/foo.harn"))
}

pipeline test_public_surface_impact_for_repos_scans_discovered_checkout_dirs(task) {
  const analysis = {
    changelog_section: "- Removed `std/json.safe_parse`.\n",
    changelog_unreleased_section: "",
    diff_names: "",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
  }
  const report = public_surface_impact_for_repos(
    "v1.2.3",
    analysis,
    [{slug: "burin-labs/burin-code", dir: "/tmp/burin-code"}],
    grep_runner(
      {
        "/tmp/burin-code|std/json.safe_parse": command_result_ok(
          "Sources/foo.harn:3:std/json.safe_parse(raw)\n",
        ),
      },
    ),
  )
  assert_eq(report.source_status, "analysis")
  assert_eq(report.surface_count, 1)
