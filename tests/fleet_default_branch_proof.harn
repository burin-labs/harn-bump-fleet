import {
  fleet_default_branch_observation,
  fleet_default_branch_verdict,
} from "../lib/fleet_default_branch_proof"

const SHA = "1111111111111111111111111111111111111111"

pipeline test_default_branch_proof_requires_positive_exact_head_checks(task: any) {
  const green = {name: "CI status", head_sha: SHA, status: "completed", conclusion: "success"}
  assert(fleet_default_branch_verdict(SHA, SHA, ["CI status"], [green], 1).ok)
  assert_eq(
    fleet_default_branch_verdict(SHA, SHA, ["CI status"], [green + {conclusion: "failure"}], 1)
      .state,
    "failed",
  )
  assert_eq(fleet_default_branch_verdict(SHA, SHA, ["CI status"], [], 0).state, "pending")
  assert_eq(
    fleet_default_branch_verdict(SHA, SHA, ["CI status"], [green + {conclusion: "skipped"}], 1)
      .state,
    "pending",
  )
  for conclusion in ["skipped", "neutral", "failure", "cancelled", ""] {
    assert(
      !fleet_default_branch_verdict(SHA, SHA, ["CI status"], [green + {conclusion: conclusion}], 1)
        .ok,
    )
  }
  assert(
    !fleet_default_branch_verdict(SHA, SHA, ["CI status"], [green + {status: "in_progress"}], 1).ok,
  )
  assert(!fleet_default_branch_verdict(SHA, SHA, ["CI status"], [], 0).ok)
  assert(!fleet_default_branch_verdict(SHA, SHA, ["CI status"], [green], 2).ok)
  assert(!fleet_default_branch_verdict(SHA, SHA, [], [green], 1).ok)
  assert(
    !fleet_default_branch_verdict(
      SHA,
      "2222222222222222222222222222222222222222",
      ["CI status"],
      [green],
      1,
    ).ok,
  )
  assert(
    !fleet_default_branch_verdict(SHA, SHA, ["CI status"], [green + {head_sha: "wrong"}], 1).ok,
  )
  assert(!fleet_default_branch_verdict(SHA, SHA, ["CI status"], [green, green], 2).ok)
}

pipeline test_default_branch_observation_names_the_call_that_failed(task: any) {
  // Falsifier, refusing direction: a call that failed is named, with its error.
  const policy_only = fleet_default_branch_observation("ruleset 403", "", "")
  assert(policy_only.refused)
  assert_eq(len(policy_only.unproven), 1)
  assert(contains(to_string(policy_only.unproven[0]), "branch policy"))
  assert(contains(to_string(policy_only.unproven[0]), "ruleset 403"))
  const checks_only = fleet_default_branch_observation("", "checks 502", "")
  assert(checks_only.refused)
  assert_eq(len(checks_only.unproven), 1)
  assert(contains(to_string(checks_only.unproven[0]), "exact-head check census"))
  assert(contains(to_string(checks_only.unproven[0]), "checks 502"))
  const head_only = fleet_default_branch_observation("", "", "head timeout")
  assert(head_only.refused)
  assert_eq(len(head_only.unproven), 1)
  assert(contains(to_string(head_only.unproven[0]), "final default branch head"))
  assert(contains(to_string(head_only.unproven[0]), "head timeout"))
  // Every failing call is named, not just the first.
  const all_three = fleet_default_branch_observation("a", "b", "c")
  assert(all_three.refused)
  assert_eq(len(all_three.unproven), 3)
  // Falsifier, allowing direction: a call that succeeded is never named.
  assert(!contains(to_string(policy_only.unproven[0]), "exact-head check census"))
  assert(!contains(to_string(policy_only.unproven[0]), "final default branch head"))
  // Falsifier, non-refusing direction: three good reads refuse nothing.
  const clean = fleet_default_branch_observation("", "", "")
  assert(!clean.refused)
  assert_eq(len(clean.unproven), 0)
}
