pipeline test_red_run_or_duplicate_jobs_fails_closed_and_cleans_up(harness: Harness, task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const red_adapter: PlatformCertificationAdapter = {
    acquire: base.acquire,
    run: fn(id) {
      const result = base.run(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const run = unwrap(result)
      return Ok(
        {
          ...run,
          conclusion: if id == 6001 {
            "failure"
          } else {
            "success"
          },
        },
      )
    },
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const red = resolve_platform_certification(harness, cfg, BINARY_SHA, red_adapter)
  assert_eq(red.success, false)
  assert_eq(red.code, "lane_failed")
  assert_eq(red.cause?.category, "platform_proof")
  assert_eq(red.cause?.code, "run_unsuccessful")
  assert_eq(len(red.cancellations), 2)
  const duplicate_adapter: PlatformCertificationAdapter = {
    acquire: base.acquire,
    run: base.run,
    jobs: fn(id) {
      const result = base.jobs(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const page = unwrap(result)
      return Ok(
        {
          ...page,
          total_count: 2,
          jobs: page.jobs + [{...page.jobs[0], id: page.jobs[0]?.id + 1000}],
        },
      )
    },
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const duplicate = resolve_platform_certification(harness, cfg, BINARY_SHA, duplicate_adapter)
  assert_eq(duplicate.success, false)
  assert_eq(duplicate.code, "lane_failed")
  assert_eq(duplicate.cause?.category, "platform_proof")
  assert_eq(duplicate.cause?.code, "jobs_duplicate_identity")
  assert_eq(len(duplicate.cancellations), 2)
}

pipeline test_source_movement_discards_all_successful_lane_evidence(harness: Harness, task) {
  const cfg = config()
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, moved_base_adapter(cfg))
  assert_eq(decision.success, false)
  assert_eq(decision.code, "source_ref_moved")
  assert_eq(decision.receipt, nil)
  assert_eq(len(decision.cancellations), 2)
}

/** A certification branch that cannot be re-read still fails closed. */
pipeline test_unreadable_remote_fails_closed(harness: Harness, task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    acquire: base.acquire,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: fn() { return Err({code: "remote_sha_failed", message: "ls-remote exploded"}) },
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  assert_eq(decision.code, "remote_reread_failed")
  assert_eq(decision.receipt, nil)
}

pipeline test_missing_local_source_contract_fails_closed(harness: Harness, task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    acquire: base.acquire,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: fn() {
      const result = base.source_lanes()
      if is_err(result) {
        return Err(unwrap_err(result))
