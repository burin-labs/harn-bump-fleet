import { git_ls_remote, git_push } from "std/git"
import {
  PlatformCertificationAdapter,
  PlatformCertificationConfig,
  begin_platform_certification,
  cancel_recorded_platform_certification_runs,
  ensure_platform_certification_branch,
  finish_platform_certification,
  mock_platform_certification_adapter,
  platform_certification_branch,
  platform_certification_dispatch_registry,
  platform_certification_duration_ms,
  platform_certification_join,
  record_platform_certification_dispatch,
  resolve_platform_certification,
} from "../lib/platform_certification"

pipeline test_recorded_hosted_runs_cancel_by_exact_run_id(harness: Harness, task: any) {
  const recorded = platform_certification_dispatch_registry(
    harness.runtime,
    "recorded-platform-cancellation",
  )
  record_platform_certification_dispatch(harness.runtime, recorded, "windows", 6001)
  record_platform_certification_dispatch(harness.runtime, recorded, "macos", 6002)
  const receipts = cancel_recorded_platform_certification_runs(
    harness,
    "burin-labs/harn",
    recorded,
    true,
  )
  assert_eq(
    receipts.map({ receipt -> {run_id: receipt.run_id, success: receipt.success} }).to_list(),
    [{run_id: 6001, success: true}, {run_id: 6002, success: true}],
  )
}

const PIN = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const BINARY_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

/** A certification-branch head that advanced past `PIN` while lanes were running. */
const MOVED_SHA = "dddddddddddddddddddddddddddddddddddddddd"

/**
 * The shared certification config.
 *
 * Production prepare publishes `release-certify/<pin>` first; these unit tests
 * keep that branch name so identity fixtures match the live dispatch ref shape.
 */
fn config() -> PlatformCertificationConfig {
  return {
    repo: "burin-labs/harn",
    branch: platform_certification_branch(PIN),
    pin_sha: PIN,
    workspace: "/tmp/harn",
    harn_bin: "/tmp/harn-bin",
  }
}

fn sh(process: HarnessProcess, command: any) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn certify_fixture(harness: Harness) {
  const root = path_join(harness.fs.temp_dir(), "release-certify-" + harness.random.uuid_v7())
  const origin = path_join(root, "origin.git")
  const work = path_join(root, "work")
  sh(harness.process, "git init --bare -q '" + origin + "'")
  sh(harness.process, "git init -q '" + work + "'")
  sh(harness.process, "git -C '" + work + "' config user.email test@example.com")
  sh(harness.process, "git -C '" + work + "' config user.name test")
  sh(harness.process, "git -C '" + work + "' checkout -q -b main")
  harness.fs.write_text(path_join(work, "fixture.txt"), "first\n")
  sh(
    harness.process,
    "git -C '" + work + "' add fixture.txt && git -C '" + work + "' commit -q -m first",
  )
  sh(harness.process, "git -C '" + work + "' remote add origin '" + origin + "'")
  return {
    root: root,
    origin: origin,
    work: work,
    pin: trim(sh(harness.process, "git -C '" + work + "' rev-parse HEAD").stdout),
  }
}

pipeline test_platform_certification_branch_is_oid_qualified(task: any) {
  assert_eq(platform_certification_branch(PIN), "release-certify/${PIN}")
  const error = try {
    platform_certification_branch("not-a-sha")
  } catch (e) {
    e
  }
  assert(contains(to_string(error), "full 40-hex OID"))
}

pipeline test_ensure_platform_certification_branch_publishes_and_resumes(
  harness: Harness,
  task: any,
) {
  const f = certify_fixture(harness)
  const branch = platform_certification_branch(f.pin)
  const first = ensure_platform_certification_branch(harness.process, f.work, f.pin, false)
  assert_eq(first.success, true)
  assert_eq(first.action, "published")
  assert_eq(first.branch, branch)
  const remote = git_ls_remote(
    harness.process,
    "origin",
    {repo: f.work, refs: ["refs/heads/${branch}"], heads: true},
  )
  assert_eq(remote.success, true)
  assert_eq(remote.data.refs[0]?.oid, f.pin)
  const resumed = ensure_platform_certification_branch(harness.process, f.work, f.pin, false)
  assert_eq(resumed.success, true)
  assert_eq(resumed.action, "resume")
  const mock = ensure_platform_certification_branch(harness.process, f.work, f.pin, true)
  assert_eq(mock.success, true)
  assert_eq(mock.action, "mock")
}

pipeline test_ensure_platform_certification_branch_refuses_conflicting_tip(
  harness: Harness,
  task: any,
) {
  const f = certify_fixture(harness)
  const branch = platform_certification_branch(f.pin)
  assert_eq(
    ensure_platform_certification_branch(harness.process, f.work, f.pin, false).success,
    true,
  )
  harness.fs.write_text(path_join(f.work, "fixture.txt"), "second\n")
  sh(
    harness.process,
    "git -C '" + f.work + "' add fixture.txt && git -C '" + f.work + "' commit -q -m second",
  )
  const other = trim(sh(harness.process, "git -C '" + f.work + "' rev-parse HEAD").stdout)
  // Force the OID-named ref onto a different commit to model corruption.
  assert_eq(
    git_push(harness.process, "origin", "+${other}:refs/heads/${branch}", f.work).success,
    true,
  )
  const conflict = ensure_platform_certification_branch(harness.process, f.work, f.pin, false)
  assert_eq(conflict.success, false)
  assert_eq(conflict.action, "conflict")
  assert(contains(conflict.reason, "refusing to overwrite"))
}

/** An adapter whose post-lane re-read reports the certify branch advanced past the pin. */
fn moved_base_adapter(cfg: PlatformCertificationConfig) -> PlatformCertificationAdapter {
  const base = mock_platform_certification_adapter(cfg)
  return {
    acquire: base.acquire,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: fn() {
      const result = base.remote_sha()
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Ok(MOVED_SHA)
    },
    now_ms: base.now_ms,
    wait: base.wait,
  }
}

pipeline test_boundary_failures_have_typed_decision_codes(harness: Harness, task: any) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const invalid_binary = resolve_platform_certification(harness, cfg, "not-a-sha", base)
  assert_eq(invalid_binary.success, false)
  assert_eq(invalid_binary.code, "invalid_binary_sha")
  assert_eq(invalid_binary.cancellations, [])
  const dispatch_failure: PlatformCertificationAdapter = {
    acquire: fn(_spec) { return Err({code: "network", message: "offline"}) },
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const failed_dispatch = resolve_platform_certification(harness, cfg, BINARY_SHA, dispatch_failure)
  assert_eq(failed_dispatch.success, false)
  assert_eq(failed_dispatch.code, "dispatch_failed")
  assert_eq(failed_dispatch.cancellations, [])
  const local_source_failure: PlatformCertificationAdapter = {
    acquire: base.acquire,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: fn() { return Err({code: "provider_detail", message: "local audit failed"}) },
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const failed_local_source = resolve_platform_certification(
    harness,
    cfg,
    BINARY_SHA,
    local_source_failure,
  )
  assert_eq(failed_local_source.code, "lane_failed")
  assert_eq(failed_local_source.cause?.category, "local_source")
  assert_eq(failed_local_source.cause?.code, "local_source_failed")
}

pipeline test_acquired_session_closes_once_without_duplicate_dispatch(harness: Harness, task: any) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  let acquisitions = 0
  const adapter: PlatformCertificationAdapter = {
    acquire: fn(spec) {
      acquisitions = acquisitions + 1
      return base.acquire(spec)
    },
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const session = begin_platform_certification(harness, cfg, adapter)
  assert_eq(session.success, true)
  assert_eq(session.code, "acquired")
  assert_eq(session.dispatches.map({ row -> row.run_id }).to_list(), [6001, 6002])
  assert_eq(acquisitions, 2)
  const decision = finish_platform_certification(harness, cfg, BINARY_SHA, session, adapter)
  assert_eq(decision.success, true)
  assert_eq(decision.receipt?.warm?.binary_sha256, BINARY_SHA)
  assert_eq(acquisitions, 2)
}

pipeline test_acquired_session_cancels_if_warm_digest_is_invalid(harness: Harness, task: any) {
  const cfg = config()
  const adapter = mock_platform_certification_adapter(cfg)
  const session = begin_platform_certification(harness, cfg, adapter)
  const decision = finish_platform_certification(harness, cfg, "not-a-sha", session, adapter)
  assert_eq(decision.success, false)
  assert_eq(decision.code, "invalid_binary_sha")
  assert_eq(decision.cancellations.map({ row -> row.run_id }).to_list(), [6001, 6002])
}

pipeline test_exact_hosted_and_local_evidence_closes_v2_receipt(harness: Harness, task: any) {
  const cfg = config()
  const decision = resolve_platform_certification(
    harness,
    cfg,
    BINARY_SHA,
    mock_platform_certification_adapter(cfg),
  )
  assert_eq(decision.success, true)
  assert_eq(decision.code, "certified")
  const receipt = decision.receipt
  assert(receipt != nil)
  if receipt != nil {
    assert_eq(receipt.schema_version, "harn.release_audit_receipt.v2")
    assert_eq(receipt.proof_kind, "hosted_platform")
    assert_eq(receipt.source.sha, PIN)
    assert_eq(receipt.source.remote_sha_after, PIN)
    assert_eq(receipt.platforms.map({ proof -> proof.platform }).to_list(), ["windows", "macos"])
    assert_eq(receipt.local_source.lane_names, ["rust-audit", "harn-audit", "package-audit"])
    assert(
      receipt.join.duration_ms
        >= receipt.platforms.map({ proof -> proof.duration_ms }).max(),
    )
    assert(receipt.join.duration_ms >= receipt.local_source.duration_ms)
    assert_eq(receipt.warm.binary_sha256, BINARY_SHA)
  }
}

pipeline test_join_timing_is_the_longest_overlapped_lane_not_the_sum(task: any) {
  const join = platform_certification_join(
    [
      {platform: "windows", started_at_ms: 100, completed_at_ms: 1000, duration_ms: 900},
      {platform: "macos", started_at_ms: 100, completed_at_ms: 800, duration_ms: 700},
    ],
    {started_at_ms: 100, completed_at_ms: 600, duration_ms: 500},
  )
  assert_eq(join.started_at_ms, 100)
  assert_eq(join.completed_at_ms, 1000)
  assert_eq(join.duration_ms, 900)
  assert_eq(join.critical_path, "windows")
  assert(join.duration_ms < 900 + 700 + 500)
}

pipeline test_receipt_duration_normalizes_legacy_epoch_seconds(task: any) {
  assert_eq(
    platform_certification_duration_ms(
      {started_at_ms: 1784938127, completed_at_ms: 1784940213, duration_ms: 2086},
    ),
    2086000,
  )
  assert_eq(
    platform_certification_duration_ms(
      {started_at_ms: 1784938127000, completed_at_ms: 1784940213000, duration_ms: 2086000},
    ),
    2086000,
  )
}

pipeline test_typed_network_reads_retry_the_exact_dispatched_runs(harness: Harness, task: any) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const run_reads = harness.runtime.shared_map(
    {scope: "task_group", key: "network-run-reads-${harness.random.uuid_v7()}"},
  )
  const job_reads = harness.runtime.shared_map(
    {scope: "task_group", key: "network-job-reads-${harness.random.uuid_v7()}"},
  )
  const waits = harness.runtime.atomic(0)
  const adapter: PlatformCertificationAdapter = {
    acquire: base.acquire,
    run: fn(id) {
      const key = to_string(id)
      const attempts = harness.runtime.shared_map_get(run_reads, key, 0) + 1
      harness.runtime.shared_map_set(run_reads, key, attempts)
      if attempts == 1 {
        return Err({code: "network", message: "temporary run read failure"})
      }
      return base.run(id)
    },
    jobs: fn(id) {
      const key = to_string(id)
      const attempts = harness.runtime.shared_map_get(job_reads, key, 0) + 1
      harness.runtime.shared_map_set(job_reads, key, attempts)
      if attempts == 1 {
        return Err({code: "network", message: "temporary job read failure"})
      }
      return base.jobs(id)
    },
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: fn(ms) {
      if ms == 1000 {
        harness.runtime.atomic_add(waits, 1)
      }
      return nil
    },
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, true)
  assert_eq(harness.runtime.shared_map_get(run_reads, "6001", nil), 2)
  assert_eq(harness.runtime.shared_map_get(run_reads, "6002", nil), 2)
  assert_eq(harness.runtime.shared_map_get(job_reads, "6001", nil), 2)
  assert_eq(harness.runtime.shared_map_get(job_reads, "6002", nil), 2)
  assert_eq(harness.runtime.atomic_get(waits), 4)
  assert_eq(decision.receipt?.platforms[0]?.run.id, 6001)
  assert_eq(decision.receipt?.platforms[1]?.run.id, 6002)
}

pipeline test_rerun_waits_for_the_selected_attempt_before_reading_jobs(
  harness: Harness,
  task: any,
) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const run_reads = harness.runtime.shared_map(
    {scope: "task_group", key: "rerun-run-reads-${harness.random.uuid_v7()}"},
  )
  const adapter: PlatformCertificationAdapter = {
    acquire: fn(spec) {
      const result = base.acquire(spec)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Ok(
        {
          ...unwrap(result),
          run_attempt: 2,
          action: "rerun_failed",
          selection_reason: "retryable_failed_run",
          reused: true,
        },
      )
    },
    run: fn(id) {
      const key = to_string(id)
      const reads = harness.runtime.shared_map_get(run_reads, key, 0) + 1
      harness.runtime.shared_map_set(run_reads, key, reads)
      const result = base.run(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Ok(
        {
          ...unwrap(result),
          run_attempt: if reads == 1 {
            1
          } else {
            2
          },
        },
      )
    },
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, true)
  assert_eq(harness.runtime.shared_map_get(run_reads, "6001", nil), 2)
  assert_eq(harness.runtime.shared_map_get(run_reads, "6002", nil), 2)
  assert_eq(decision.receipt?.platforms[0]?.run.run_attempt, 2)
  assert_eq(decision.receipt?.platforms[0]?.acquisition.action, "rerun_failed")
  assert_eq(decision.receipt?.platforms[0]?.acquisition.selection_reason, "retryable_failed_run")
  assert_eq(decision.receipt?.platforms[0]?.acquisition.reused, true)
}

pipeline test_dispatch_identity_mismatch_cancels_exact_returned_run(harness: Harness, task: any) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    acquire: fn(spec) {
      const result = base.acquire(spec)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const dispatch = unwrap(result)
      return Ok({...dispatch, head_sha: "cccccccccccccccccccccccccccccccccccccccc"})
    },
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  assert_eq(decision.code, "dispatch_identity_invalid")
  assert_eq(len(decision.cancellations), 1)
  assert_eq(decision.cancellations[0]?.run_id, 6001)
}

pipeline test_dispatch_identity_uses_requested_ref_not_provider_branch_alias(
  harness: Harness,
  task: any,
) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const alias = "gh-readonly-queue/main/pr-5733-deadbeef"
  const adapter: PlatformCertificationAdapter = {
    acquire: fn(spec) {
      const result = base.acquire(spec)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Ok({...unwrap(result), head_branch: alias})
    },
    run: fn(id) {
      const result = base.run(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Ok({...unwrap(result), head_branch: alias})
    },
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, true)
  assert_eq(decision.receipt?.source.remote_sha_after, PIN)
}

