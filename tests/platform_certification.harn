import { git_ls_remote, git_push } from "std/git"
import {
  PlatformCertificationAdapter,
  PlatformCertificationConfig,
  ensure_platform_certification_branch,
  mock_platform_certification_adapter,
  platform_certification_branch,
  platform_certification_duration_ms,
  platform_certification_join,
  resolve_platform_certification,
} from "../lib/platform_certification"

const PIN = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const BINARY_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

/** A certification-branch head that advanced past `PIN` while lanes were running. */
const MOVED_SHA = "dddddddddddddddddddddddddddddddddddddddd"

/**
 * The shared certification config.
 *
 * `explicit_pin` is a parameter rather than a second constructor so the movement
 * pair below differs in exactly that one field and nothing else. Production
 * prepare publishes `release-certify/<pin>` first; these unit tests keep that
 * branch name so identity fixtures match the live dispatch ref shape.
 */
fn config(explicit_pin: bool = false) -> PlatformCertificationConfig {
  return {
    repo: "burin-labs/harn",
    branch: platform_certification_branch(PIN),
    pin_sha: PIN,
    workspace: "/tmp/harn",
    harn_bin: "/tmp/harn-bin",
    explicit_pin: explicit_pin,
  }
}

fn sh(command) {
  const result = shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn certify_fixture() {
  const root = path_join(harness.fs.temp_dir(), "release-certify-" + uuid_v7())
  const origin = path_join(root, "origin.git")
  const work = path_join(root, "work")
  sh("git init --bare -q '" + origin + "'")
  sh("git init -q '" + work + "'")
  sh("git -C '" + work + "' config user.email test@example.com")
  sh("git -C '" + work + "' config user.name test")
  sh("git -C '" + work + "' checkout -q -b main")
  harness.fs.write_text(path_join(work, "fixture.txt"), "first\n")
  sh("git -C '" + work + "' add fixture.txt && git -C '" + work + "' commit -q -m first")
  sh("git -C '" + work + "' remote add origin '" + origin + "'")
  return {
    root: root,
    origin: origin,
    work: work,
    pin: trim(sh("git -C '" + work + "' rev-parse HEAD").stdout),
  }
}

pipeline test_platform_certification_branch_is_oid_qualified(task) {
  assert_eq(platform_certification_branch(PIN), "release-certify/${PIN}")
  const error = try {
    platform_certification_branch("not-a-sha")
  } catch (e) {
    e
  }
  assert(contains(to_string(error), "full 40-hex OID"))
}

pipeline test_ensure_platform_certification_branch_publishes_and_resumes(task) {
  const f = certify_fixture()
  const branch = platform_certification_branch(f.pin)
  const first = ensure_platform_certification_branch(f.work, f.pin, false)
  assert_eq(first.success, true)
  assert_eq(first.action, "published")
  assert_eq(first.branch, branch)
  const remote = git_ls_remote(
    "origin",
    {repo: f.work, refs: ["refs/heads/${branch}"], heads: true},
  )
  assert_eq(remote.success, true)
  assert_eq(remote.data.refs[0]?.oid, f.pin)
  const resumed = ensure_platform_certification_branch(f.work, f.pin, false)
  assert_eq(resumed.success, true)
  assert_eq(resumed.action, "resume")
  const mock = ensure_platform_certification_branch(f.work, f.pin, true)
  assert_eq(mock.success, true)
  assert_eq(mock.action, "mock")
}

pipeline test_ensure_platform_certification_branch_refuses_conflicting_tip(task) {
  const f = certify_fixture()
  const branch = platform_certification_branch(f.pin)
  assert_eq(ensure_platform_certification_branch(f.work, f.pin, false).success, true)
  harness.fs.write_text(path_join(f.work, "fixture.txt"), "second\n")
  sh("git -C '" + f.work + "' add fixture.txt && git -C '" + f.work + "' commit -q -m second")
  const other = trim(sh("git -C '" + f.work + "' rev-parse HEAD").stdout)
  // Force the OID-named ref onto a different commit to model corruption.
  assert_eq(git_push("origin", "+${other}:refs/heads/${branch}", f.work).success, true)
  const conflict = ensure_platform_certification_branch(f.work, f.pin, false)
  assert_eq(conflict.success, false)
  assert_eq(conflict.action, "conflict")
  assert(contains(conflict.reason, "refusing to overwrite"))
}

/** An adapter whose post-lane re-read reports the certify branch advanced past the pin. */
fn moved_base_adapter(cfg: PlatformCertificationConfig) -> PlatformCertificationAdapter {
  const base = mock_platform_certification_adapter(cfg)
  return {
    dispatch: base.dispatch,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: fn() {
      const result = base.remote_sha()
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Ok(MOVED_SHA)
    },
    now_ms: base.now_ms,
    wait: base.wait,
  }
}

pipeline test_exact_hosted_and_local_evidence_closes_v2_receipt(task) {
  const cfg = config()
  const decision = resolve_platform_certification(
    harness,
    cfg,
    BINARY_SHA,
    mock_platform_certification_adapter(cfg),
  )
  assert_eq(decision.success, true)
  const receipt = decision.receipt
  assert(receipt != nil)
  if receipt != nil {
    assert_eq(receipt.schema_version, "harn.release_audit_receipt.v2")
    assert_eq(receipt.proof_kind, "hosted_platform")
    assert_eq(receipt.source.sha, PIN)
    assert_eq(receipt.source.remote_sha_after, PIN)
    assert_eq(receipt.platforms.map({ proof -> proof.platform }).to_list(), ["windows", "macos"])
    assert_eq(receipt.local_source.lane_names, ["rust-audit", "harn-audit", "package-audit"])
    assert(
      receipt.join.duration_ms
        >= receipt.platforms.map({ proof -> proof.duration_ms }).max(),
    )
    assert(receipt.join.duration_ms >= receipt.local_source.duration_ms)
    assert_eq(receipt.warm.binary_sha256, BINARY_SHA)
  }
}

pipeline test_join_timing_is_the_longest_overlapped_lane_not_the_sum(task) {
  const join = platform_certification_join(
    [
      {platform: "windows", started_at_ms: 100, completed_at_ms: 1000, duration_ms: 900},
      {platform: "macos", started_at_ms: 100, completed_at_ms: 800, duration_ms: 700},
    ],
    {started_at_ms: 100, completed_at_ms: 600, duration_ms: 500},
  )
  assert_eq(join.started_at_ms, 100)
  assert_eq(join.completed_at_ms, 1000)
  assert_eq(join.duration_ms, 900)
  assert_eq(join.critical_path, "windows")
  assert(join.duration_ms < 900 + 700 + 500)
}

pipeline test_receipt_duration_normalizes_legacy_epoch_seconds(task) {
  assert_eq(
    platform_certification_duration_ms(
      {started_at_ms: 1784938127, completed_at_ms: 1784940213, duration_ms: 2086},
    ),
    2086000,
  )
  assert_eq(
    platform_certification_duration_ms(
      {started_at_ms: 1784938127000, completed_at_ms: 1784940213000, duration_ms: 2086000},
    ),
    2086000,
  )
}

pipeline test_typed_network_reads_retry_the_exact_dispatched_runs(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  let run_reads: dict = {}
  let job_reads: dict = {}
  let waits = []
  const adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: fn(id) {
      const attempts = (run_reads[to_string(id)] ?? 0) + 1
      run_reads[to_string(id)] = attempts
      if attempts == 1 {
        return Err({code: "network", message: "temporary run read failure"})
      }
      return base.run(id)
    },
    jobs: fn(id) {
      const attempts = (job_reads[to_string(id)] ?? 0) + 1
      job_reads[to_string(id)] = attempts
      if attempts == 1 {
        return Err({code: "network", message: "temporary job read failure"})
      }
      return base.jobs(id)
    },
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: fn(ms) { waits = waits + [ms] },
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, true)
  assert_eq(run_reads["6001"], 2)
  assert_eq(run_reads["6002"], 2)
  assert_eq(job_reads["6001"], 2)
  assert_eq(job_reads["6002"], 2)
  assert_eq(waits.filter({ ms -> ms == 1000 }).count(), 4)
  assert_eq(decision.receipt?.platforms[0]?.run.id, 6001)
  assert_eq(decision.receipt?.platforms[1]?.run.id, 6002)
}

pipeline test_dispatch_identity_mismatch_cancels_exact_returned_run(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    dispatch: fn(spec) {
      const result = base.dispatch(spec)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const dispatch = unwrap(result)
      return Ok({...dispatch, head_sha: "cccccccccccccccccccccccccccccccccccccccc"})
    },
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  assert(contains(decision.reason, "malformed exact identity"))
  assert_eq(len(decision.cancellations), 1)
  assert_eq(decision.cancellations[0]?.run_id, 6001)
}

pipeline test_red_run_or_duplicate_jobs_fails_closed_and_cleans_up(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const red_adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: fn(id) {
      const result = base.run(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const run = unwrap(result)
      return Ok(
        {
          ...run,
          conclusion: if id == 6001 {
            "failure"
          } else {
            "success"
          },
        },
      )
    },
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const red = resolve_platform_certification(harness, cfg, BINARY_SHA, red_adapter)
  assert_eq(red.success, false)
  assert_eq(len(red.cancellations), 2)
  const duplicate_adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: base.run,
    jobs: fn(id) {
      const result = base.jobs(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const page = unwrap(result)
      return Ok(
        {
          ...page,
          total_count: 2,
          jobs: page.jobs + [{...page.jobs[0], id: page.jobs[0]?.id + 1000}],
        },
      )
    },
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const duplicate = resolve_platform_certification(harness, cfg, BINARY_SHA, duplicate_adapter)
  assert_eq(duplicate.success, false)
  assert(contains(duplicate.reason, "duplicate identities"))
  assert_eq(len(duplicate.cancellations), 2)
}

pipeline test_source_movement_discards_all_successful_lane_evidence(task) {
  const cfg = config()
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, moved_base_adapter(cfg))
  assert_eq(decision.success, false)
  assert(contains(decision.reason, "source branch moved"))
  assert_eq(decision.receipt, nil)
  assert_eq(len(decision.cancellations), 2)
}

/**
 * An operator-named `--at-sha` pin closes its receipt even when the certify
 * branch moved. Paired with the test above, which holds everything else equal
 * and only drops `explicit_pin`, this pins the tolerance to that one field.
 */
pipeline test_explicit_pin_survives_base_movement(task) {
  const cfg = config(true)
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, moved_base_adapter(cfg))
  assert_eq(decision.success, true)
  assert(decision.receipt != nil)
  assert_eq(len(decision.cancellations), 0)
  const receipt = decision.receipt ?? {}
  // The pin is what was certified; the moved head is still reported rather than
  // smoothed over, so the receipt cannot imply the certify branch held still.
  assert_eq(receipt.source.sha, PIN)
  assert_eq(receipt.source.remote_sha_after, MOVED_SHA)
}

/** A certification branch that cannot be re-read still fails closed, explicit pin or not. */
pipeline test_unreadable_remote_fails_closed_even_with_explicit_pin(task) {
  const cfg = config(true)
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: fn() { return Err({code: "remote_sha_failed", message: "ls-remote exploded"}) },
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  assert(contains(decision.reason, "could not re-read"))
  assert_eq(decision.receipt, nil)
}

pipeline test_missing_local_source_contract_fails_closed(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: fn() {
      const result = base.source_lanes()
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Err({code: "missing", message: "contract missing"})
    },
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  assert(contains(decision.reason, "omitted exact local source lanes"))
  assert_eq(len(decision.cancellations), 2)
}

/**
 * A lane that reaches a terminal failure stops its siblings from polling on.
 *
 * `parallel settle` never cancels, which is what the receipt needs -- every
 * lane's outcome is recorded -- but before the cooperative abort a doomed run
 * still paid for the slowest sibling to finish, up to 720 polls. The mock's
 * `wait` is a no-op, so the poll count is the observable, not wall time.
 */
pipeline test_a_failed_lane_stops_its_sibling_from_polling_on(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  // The task bodies run in isolated interpreters, so a plain counter would not
  // survive the boundary. The shared cell is both the counter here and the
  // mechanism under test.
  const polls = shared_cell({scope: "process", key: "macos_poll_count", initial: 0})
  const adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: fn(id) {
      const result = base.run(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const run = unwrap(result)
      if id == 6001 {
        return Ok({...run, status: "completed", conclusion: "failure"})
      }
      shared_set(polls, shared_get(polls) + 1)
      return Ok({...run, status: "in_progress", conclusion: nil})
    },
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  // The windows verdict is the cause. An abandoned sibling must never become
  // the headline reason, or the receipt would hide what actually went red.
  assert(!contains(decision.reason, "abandoned"))
  assert(contains(decision.reason, "windows"))
  // Without the abort this lane polls the full 720 times before giving up.
  const observed = shared_get(polls)
  assert(observed < 100)
  assert(observed > 0)
}
