import {
  PlatformCertificationAdapter,
  PlatformCertificationConfig,
  mock_platform_certification_adapter,
  platform_certification_join,
  resolve_platform_certification,
} from "../lib/platform_certification"

const PIN = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const BINARY_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn config() -> PlatformCertificationConfig {
  return {
    repo: "burin-labs/harn",
    branch: "main",
    pin_sha: PIN,
    workspace: "/tmp/harn",
    harn_bin: "/tmp/harn-bin",
  }
}

pipeline test_exact_hosted_and_local_evidence_closes_v2_receipt(task) {
  const cfg = config()
  const decision = resolve_platform_certification(
    harness,
    cfg,
    BINARY_SHA,
    mock_platform_certification_adapter(cfg),
  )
  assert_eq(decision.success, true)
  const receipt = decision.receipt
  assert(receipt != nil)
  if receipt != nil {
    assert_eq(receipt.schema_version, "harn.release_audit_receipt.v2")
    assert_eq(receipt.proof_kind, "hosted_platform")
    assert_eq(receipt.source.sha, PIN)
    assert_eq(receipt.source.remote_sha_after, PIN)
    assert_eq(receipt.platforms.map({ proof -> proof.platform }).to_list(), ["windows", "macos"])
    assert_eq(receipt.local_source.lane_names, ["rust-audit", "harn-audit", "package-audit"])
    assert(
      receipt.join.duration_ms
        >= receipt.platforms.map({ proof -> proof.duration_ms }).max(),
    )
    assert(receipt.join.duration_ms >= receipt.local_source.duration_ms)
    assert_eq(receipt.warm.binary_sha256, BINARY_SHA)
  }
}

pipeline test_join_timing_is_the_longest_overlapped_lane_not_the_sum(task) {
  const join = platform_certification_join(
    [
      {platform: "windows", started_at_ms: 100, completed_at_ms: 1000, duration_ms: 900},
      {platform: "macos", started_at_ms: 100, completed_at_ms: 800, duration_ms: 700},
    ],
    {started_at_ms: 100, completed_at_ms: 600, duration_ms: 500},
  )
  assert_eq(join.started_at_ms, 100)
  assert_eq(join.completed_at_ms, 1000)
  assert_eq(join.duration_ms, 900)
  assert_eq(join.critical_path, "windows")
  assert(join.duration_ms < 900 + 700 + 500)
}

pipeline test_typed_network_reads_retry_the_exact_dispatched_runs(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  let run_reads: dict = {}
  let job_reads: dict = {}
  let waits = []
  const adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: fn(id) {
      const attempts = (run_reads[to_string(id)] ?? 0) + 1
      run_reads[to_string(id)] = attempts
      if attempts == 1 {
        return Err({code: "network", message: "temporary run read failure"})
      }
      return base.run(id)
    },
    jobs: fn(id) {
      const attempts = (job_reads[to_string(id)] ?? 0) + 1
      job_reads[to_string(id)] = attempts
      if attempts == 1 {
        return Err({code: "network", message: "temporary job read failure"})
      }
      return base.jobs(id)
    },
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: fn(ms) { waits = waits + [ms] },
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, true)
  assert_eq(run_reads["6001"], 2)
  assert_eq(run_reads["6002"], 2)
  assert_eq(job_reads["6001"], 2)
  assert_eq(job_reads["6002"], 2)
  assert_eq(waits.filter({ ms -> ms == 1000 }).count(), 4)
  assert_eq(decision.receipt?.platforms[0]?.run.id, 6001)
  assert_eq(decision.receipt?.platforms[1]?.run.id, 6002)
}

pipeline test_dispatch_identity_mismatch_cancels_exact_returned_run(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    dispatch: fn(spec) {
      const result = base.dispatch(spec)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const dispatch = unwrap(result)
      return Ok({...dispatch, head_sha: "cccccccccccccccccccccccccccccccccccccccc"})
    },
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  assert(contains(decision.reason, "malformed exact identity"))
  assert_eq(len(decision.cancellations), 1)
  assert_eq(decision.cancellations[0]?.run_id, 6001)
}

pipeline test_red_run_or_duplicate_jobs_fails_closed_and_cleans_up(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const red_adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: fn(id) {
      const result = base.run(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const run = unwrap(result)
      return Ok(
        {
          ...run,
          conclusion: if id == 6001 {
            "failure"
          } else {
            "success"
          },
        },
      )
    },
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const red = resolve_platform_certification(harness, cfg, BINARY_SHA, red_adapter)
  assert_eq(red.success, false)
  assert_eq(len(red.cancellations), 2)
  const duplicate_adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: base.run,
    jobs: fn(id) {
      const result = base.jobs(id)
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      const page = unwrap(result)
      return Ok(
        {
          ...page,
          total_count: 2,
          jobs: page.jobs + [{...page.jobs[0], id: page.jobs[0]?.id + 1000}],
        },
      )
    },
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const duplicate = resolve_platform_certification(harness, cfg, BINARY_SHA, duplicate_adapter)
  assert_eq(duplicate.success, false)
  assert(contains(duplicate.reason, "duplicate identities"))
  assert_eq(len(duplicate.cancellations), 2)
}

pipeline test_source_movement_discards_all_successful_lane_evidence(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: base.source_lanes,
    remote_sha: fn() {
      const result = base.remote_sha()
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Ok("dddddddddddddddddddddddddddddddddddddddd")
    },
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  assert(contains(decision.reason, "source branch moved"))
  assert_eq(decision.receipt, nil)
  assert_eq(len(decision.cancellations), 2)
}

pipeline test_missing_local_source_contract_fails_closed(task) {
  const cfg = config()
  const base = mock_platform_certification_adapter(cfg)
  const adapter: PlatformCertificationAdapter = {
    dispatch: base.dispatch,
    run: base.run,
    jobs: base.jobs,
    cancel: base.cancel,
    local_source: base.local_source,
    source_lanes: fn() {
      const result = base.source_lanes()
      if is_err(result) {
        return Err(unwrap_err(result))
      }
      return Err({code: "missing", message: "contract missing"})
    },
    remote_sha: base.remote_sha,
    now_ms: base.now_ms,
    wait: base.wait,
  }
  const decision = resolve_platform_certification(harness, cfg, BINARY_SHA, adapter)
  assert_eq(decision.success, false)
  assert(contains(decision.reason, "omitted exact local source lanes"))
  assert_eq(len(decision.cancellations), 2)
}
