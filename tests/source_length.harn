import {
  source_length_violations,
  source_line_count,
  tracked_source_paths,
} from "../lib/source_length"

pipeline test_source_line_count_handles_trailing_newlines(task) {
  assert_eq(source_line_count(""), 0)
  assert_eq(source_line_count("one"), 1)
  assert_eq(source_line_count("one\n"), 1)
  assert_eq(source_line_count("one\ntwo\n"), 2)
}

pipeline test_source_length_violations_are_sorted_and_down_only(task) {
  const entries = [
    {path: "z.harn", lines: 1501},
    {path: "ok.harn", lines: 1500},
    {path: "a.harn", lines: 1600},
  ]
  assert_eq(
    source_length_violations(entries),
    [{path: "a.harn", lines: 1600}, {path: "z.harn", lines: 1501}],
  )
}

pipeline test_tracked_source_paths_preserve_valid_newline_paths_and_policy_scope(task) {
  const listing =
    "release_harn.harn\0README.md\0.github/workflows/harn-static.yml\0docs/guide.yaml\0"
    + "notes/line\nbreak.harn\0CLAUDE.md\0"
  assert_eq(
    tracked_source_paths(listing),
    [
      ".github/workflows/harn-static.yml",
      "README.md",
      "notes/line\nbreak.harn",
      "release_harn.harn",
    ],
  )
}
