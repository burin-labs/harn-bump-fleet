  return {
    repo: HOSTED_RELEASE_WORKFLOW_REPO,
    id: RUN_ID,
    workflow_id: 71,
    workflow_path: HOSTED_RELEASE_WORKFLOW_PATH,
    run_number: 88,
    run_attempt: RUN_ATTEMPT,
    name: HOSTED_RELEASE_WORKFLOW_NAME,
    display_title: HOSTED_RELEASE_WORKFLOW_NAME,
    event: "workflow_dispatch",
    status: status,
    conclusion: conclusion,
    head_branch: "main",
    head_sha: HEAD,
    url: "https://github.com/burin-labs/harn-bump-fleet/actions/runs/1012",
    created_at: "2026-08-26T17:00:00Z",
    run_started_at: "2026-08-26T17:00:10Z",
    updated_at: "2026-08-26T18:00:00Z",
  }
}

fn jobs() {
  return {
    repo: HOSTED_RELEASE_WORKFLOW_REPO,
    run_id: RUN_ID,
    total_count: 1,
    page: 1,
    per_page: 100,
    jobs: [
      {
        id: 9001,
        run_id: RUN_ID,
        name: "ship-pr v-next (patch)",
        status: "completed",
        conclusion: "cancelled",
        head_sha: HEAD,
        url: "https://github.com/burin-labs/harn-bump-fleet/actions/runs/1012/job/9001",
        runner_name: "GitHub Actions 1",
