const RUN_ID = 1012

const RUN_ATTEMPT = 1

const HEAD = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const CLAIM_OID = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const SUCCESSOR_OID = "cccccccccccccccccccccccccccccccccccccccc"

fn holder() -> ReleaseLaneHolder {
  return {
    run_id: "019fd000",
    host: "hosted-runner",
    mode: "ship-pr",
    started_at: "2026-08-26T17:00:00Z",
    workflow_run_id: RUN_ID,
    workflow_run_attempt: RUN_ATTEMPT,
  }
}

fn request() -> HostedReleaseLaneCleanupRequest {
  return {
    workflow_repo: HOSTED_RELEASE_WORKFLOW_REPO,
    workflow_name: HOSTED_RELEASE_WORKFLOW_NAME,
    workflow_path: HOSTED_RELEASE_WORKFLOW_PATH,
    workflow_run_id: RUN_ID,
    workflow_run_attempt: RUN_ATTEMPT,
    workflow_head_sha: HEAD,
    artifact_outcome: "success",
    updated_at: "2026-08-26T18:00:00Z",
  }
}

fn claim() -> HostedReleaseLaneClaimReceipt {
  return {
    schema_version: "harn_bump_fleet.hosted_release_lane_claim.v1",
    release_repo: "burin-labs/harn",
    version: "0.10.118",
    ref: release_lane_ref("0.10.118"),
    oid: CLAIM_OID,
    holder: holder(),
    workflow_repo: HOSTED_RELEASE_WORKFLOW_REPO,
    workflow_name: HOSTED_RELEASE_WORKFLOW_NAME,
    workflow_run_id: RUN_ID,
    workflow_run_attempt: RUN_ATTEMPT,
    workflow_head_sha: HEAD,
    claimed_at: holder().started_at,
  }
}

