}

fn observed(oid: string, claimant: ReleaseLaneHolder) -> GithubRefSnapshot {
  return {
    repo: "burin-labs/harn",
    ref: release_lane_ref("0.10.118"),
    state: "present",
    oid: oid,
    holder_headline: release_lane_headline("0.10.118", claimant),
  }
}

pipeline test_terminal_cancellation_releases_the_exact_claimed_oid(task: any) {
  let released: list<string> = []
  const adapter: HostedReleaseLaneCleanupAdapter = {
    run: fn(_id) { return Ok(run()) },
    jobs: fn(_id) { return Ok(jobs()) },
    lane: fn(_slug, _ref) { return Ok(observed(CLAIM_OID, holder())) },
    release: fn(_slug, _version, oid) {
      released = released + [oid]
      return Ok(
        {
          repo: "burin-labs/harn",
          ref: release_lane_ref("0.10.118"),
          oid: oid,
          released: true,
          reason: "released",
        },
      )
    },
  }
  const result = cleanup_cancelled_hosted_release_lane(request(), claim(), adapter)
  assert_eq(result.decision, "released")
  assert_eq(result.workflow_status, "completed")
  assert_eq(result.workflow_conclusion, "cancelled")
  assert_eq(result.workflow_run_id, RUN_ID)
  assert_eq(result.workflow_run_attempt, RUN_ATTEMPT)
  assert_eq(result.lane_run_id, holder().run_id)
  assert_eq(result.observed_lane_run_id, holder().run_id)
  assert_eq(result.expected_oid, CLAIM_OID)
  assert_eq(result.observed_oid, CLAIM_OID)
  assert_eq(released, [CLAIM_OID])
}

pipeline test_changed_successor_claim_is_retained_and_cleanup_fails_closed(task: any) {
  let releases = 0
  const successor: ReleaseLaneHolder = {
    run_id: "019fd999",
    host: "successor-runner",
    mode: "ship-pr",
    started_at: "2026-08-26T18:01:00Z",
    workflow_run_id: RUN_ID + 1,
    workflow_run_attempt: 1,
  }
  const adapter: HostedReleaseLaneCleanupAdapter = {
    run: fn(_id) { return Ok(run()) },
    jobs: fn(_id) { return Ok(jobs()) },
    lane: fn(_slug, _ref) { return Ok(observed(SUCCESSOR_OID, successor)) },
    release: fn(_slug, _version, _oid) {
      releases = releases + 1
      return Err({code: "must_not_release"})
    },
  }
  const result = cleanup_cancelled_hosted_release_lane(request(), claim(), adapter)
  assert_eq(result.decision, "rejected")
  assert(contains(result.reason, "changed"))
  assert_eq(result.expected_oid, CLAIM_OID)
  assert_eq(result.observed_oid, SUCCESSOR_OID)
  assert_eq(result.observed_lane_run_id, successor.run_id)
  assert_eq(releases, 0, "successor claim must remain untouched")
}

pipeline test_live_exact_workflow_claim_is_retained_before_lane_mutation(task: any) {
  let lane_reads = 0
  let releases = 0
  const adapter: HostedReleaseLaneCleanupAdapter = {
    run: fn(_id) { return Ok(run("in_progress", nil)) },
    jobs: fn(_id) { return Ok(jobs()) },
    lane: fn(_slug, _ref) {
      lane_reads = lane_reads + 1
      return Ok(observed(CLAIM_OID, holder()))
    },
    release: fn(_slug, _version, _oid) {
      releases = releases + 1
      return Err({code: "must_not_release"})
    },
  }
  const result = cleanup_cancelled_hosted_release_lane(request(), claim(), adapter)
  assert_eq(result.decision, "rejected")
  assert(contains(result.reason, "not terminal cancelled"))
  assert_eq(lane_reads, 0)
  assert_eq(releases, 0, "a live claimant must remain untouched")
}

pipeline test_missing_claim_artifact_cannot_read_as_success_after_release_started(task: any) {
  const missing = request() + {artifact_outcome: "failure"}
  let lane_reads = 0
  const adapter: HostedReleaseLaneCleanupAdapter = {
    run: fn(_id) { return Ok(run()) },
    jobs: fn(_id) { return Ok(jobs()) },
    lane: fn(_slug, _ref) {
      lane_reads = lane_reads + 1
      return Err({code: "must_not_read"})
    },
    release: fn(_slug, _version, _oid) { return Err({code: "must_not_release"}) },
  }
  const result = cleanup_cancelled_hosted_release_lane(missing, nil, adapter)
  assert_eq(result.decision, "rejected")
  assert(contains(result.reason, "claim receipt is unavailable"))
  assert_eq(lane_reads, 0)
}

const API = "https://github.test"

fn api_options() -> GithubClientOptions {
  return {api_base_url: API, installation_token: "terminal-cleanup-test-token"}
}

fn mock_json(testing: HarnessTesting, method: string, path: string, status: int, body: any) {
  testing.http_mock(method, API + path, {status: status, body: json_stringify(body)})
}

fn mock_terminal_run_and_jobs(testing: HarnessTesting) {
  mock_json(
    testing,
    "GET",
    "/repos/burin-labs/harn-bump-fleet/actions/runs/1012",
    200,
    {
      id: RUN_ID,
      workflow_id: 71,
      path: HOSTED_RELEASE_WORKFLOW_PATH,
      run_number: 88,
      run_attempt: RUN_ATTEMPT,
      name: HOSTED_RELEASE_WORKFLOW_NAME,
      display_title: HOSTED_RELEASE_WORKFLOW_NAME,
      event: "workflow_dispatch",
      status: "completed",
      conclusion: "cancelled",
      head_branch: "main",
      head_sha: HEAD,
      html_url: "https://github.com/burin-labs/harn-bump-fleet/actions/runs/1012",
      created_at: "2026-08-26T17:00:00Z",
      run_started_at: "2026-08-26T17:00:10Z",
      updated_at: "2026-08-26T18:00:00Z",
    },
  )
  const page = jobs()
  mock_json(
    testing,
    "GET",
    "/repos/burin-labs/harn-bump-fleet/actions/runs/1012/jobs?filter=latest&per_page=100",
    200,
    {total_count: page.total_count, jobs: page.jobs},
  )
}

fn mock_ref_snapshot(testing: HarnessTesting, oid: string, claimant: ReleaseLaneHolder) {
  mock_json(
    testing,
    "GET",
    "/repos/burin-labs/harn/git/ref/release-lane/v0.10.118",
    200,
    {ref: release_lane_ref("0.10.118"), object: {sha: oid, type: "commit"}},
  )
  mock_json(
    testing,
    "GET",
    "/repos/burin-labs/harn/git/commits/${oid}",
    200,
    {sha: oid, message: release_lane_headline("0.10.118", claimant)},
  )
}

fn delete_calls(testing: HarnessTesting) -> list<dict> {
  return testing.http_mock_calls().filter({ call -> call.method == "DELETE" }).to_list()
}

pipeline test_hosted_integration_rechecks_terminal_claim_and_exact_oid_before_delete(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  mock_terminal_run_and_jobs(harness.testing)
  mock_ref_snapshot(harness.testing, CLAIM_OID, holder())
  // `github.ref.release` performs its own second OID read immediately before
  // deletion. The snapshot above proves claimant identity; this read closes
  // the race between that proof and the mutation.
  mock_json(
    harness.testing,
    "GET",
    "/repos/burin-labs/harn/git/ref/release-lane/v0.10.118",
    200,
    {ref: release_lane_ref("0.10.118"), object: {sha: CLAIM_OID, type: "commit"}},
  )
  mock_json(
    harness.testing,
    "DELETE",
    "/repos/burin-labs/harn/git/refs/release-lane/v0.10.118",
    204,
    {},
  )
  const adapter = live_hosted_release_lane_cleanup_adapter(harness, api_options(), api_options())
  const result = cleanup_cancelled_hosted_release_lane(request(), claim(), adapter)
  assert_eq(result.decision, "released")
  assert_eq(result.expected_oid, CLAIM_OID)
  assert_eq(result.observed_oid, CLAIM_OID)
  assert_eq(len(delete_calls(harness.testing)), 1)
  const base_tip = "dddddddddddddddddddddddddddddddddddddddd"
  const base_tree = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
  const abandon_oid = "ffffffffffffffffffffffffffffffffffffffff"
  mock_json(
    harness.testing,
    "GET",
    "/repos/burin-labs/harn/git/ref/heads/main",
    200,
    {ref: "refs/heads/main", object: {sha: base_tip, type: "commit"}},
  )
  mock_json(
    harness.testing,
    "GET",
    "/repos/burin-labs/harn/git/commits/${base_tip}",
    200,
    {sha: base_tip, tree: {sha: base_tree}},
  )
  mock_json(
    harness.testing,
    "POST",
    "/repos/burin-labs/harn/git/commits",
    201,
    {sha: abandon_oid, tree: {sha: base_tree}},
  )
  mock_json(
    harness.testing,
    "POST",
    "/repos/burin-labs/harn/git/refs",
    201,
    {ref: release_lane_ref("0.10.118")},
  )
  const abandon = claim_release_lane(
    harness,
    {
      slug: "burin-labs/harn",
      base_branch: "main",
      version: "0.10.118",
      holder: {
        run_id: "official-abandon-1012",
        host: "operator-host",
        mode: "abandon",
        started_at: "2026-08-26T18:00:01Z",
      },
      now: "2026-08-26T18:00:01Z",
      options: api_options(),
    },
  )
  assert_eq(abandon.state, "acquired", "official abandon path can take the lane immediately")
}

pipeline test_hosted_integration_changed_claim_never_reaches_delete(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  mock_terminal_run_and_jobs(harness.testing)
  const successor: ReleaseLaneHolder = holder()
    + {run_id: "019fd999", workflow_run_id: RUN_ID + 1}
  mock_ref_snapshot(harness.testing, SUCCESSOR_OID, successor)
  const adapter = live_hosted_release_lane_cleanup_adapter(harness, api_options(), api_options())
  const result = cleanup_cancelled_hosted_release_lane(request(), claim(), adapter)
  assert_eq(result.decision, "rejected")
  assert_eq(result.observed_oid, SUCCESSOR_OID)
  assert_eq(result.observed_lane_run_id, successor.run_id)
  assert_eq(len(delete_calls(harness.testing)), 0)
}

pipeline test_hosted_integration_live_run_never_reads_or_deletes_lane(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  mock_json(
    harness.testing,
    "GET",
    "/repos/burin-labs/harn-bump-fleet/actions/runs/1012",
    200,
    {
      id: RUN_ID,
      workflow_id: 71,
      path: HOSTED_RELEASE_WORKFLOW_PATH,
      run_number: 88,
      run_attempt: RUN_ATTEMPT,
      name: HOSTED_RELEASE_WORKFLOW_NAME,
      display_title: HOSTED_RELEASE_WORKFLOW_NAME,
      event: "workflow_dispatch",
      status: "in_progress",
      conclusion: nil,
      head_branch: "main",
      head_sha: HEAD,
      html_url: "https://github.com/burin-labs/harn-bump-fleet/actions/runs/1012",
      created_at: "2026-08-26T17:00:00Z",
      run_started_at: "2026-08-26T17:00:10Z",
      updated_at: "2026-08-26T17:30:00Z",
    },
  )
  const adapter = live_hosted_release_lane_cleanup_adapter(harness, api_options(), api_options())
  const result = cleanup_cancelled_hosted_release_lane(request(), claim(), adapter)
  assert_eq(result.decision, "rejected")
  assert(contains(result.reason, "not terminal cancelled"))
  const lane_calls = harness.testing.http_mock_calls().filter(
    { call -> contains(call.url, "/repos/burin-labs/harn/git/ref") },
  )
    .to_list()
  assert_eq(len(lane_calls), 0)
  assert_eq(len(delete_calls(harness.testing)), 0)
}
