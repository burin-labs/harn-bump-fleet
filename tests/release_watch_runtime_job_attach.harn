import { run_release_watch } from "../lib/release_watch_runtime"
import { ReleaseWatchReceipt, release_watch_receipt } from "../lib/release_watch_state"

const RELEASE_MERGE_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn receipt() -> ReleaseWatchReceipt {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      publication: {
        version: "1.2.3",
        local_branch: "release/v1.2.3",
        remote_ref: "release-attempt/v1.2.3/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        head_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      },
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      created_at: "2026-07-13T00:00:00Z",
    },
  )
}

fn receipt_path(harness: {fs: HarnessFs, random: HarnessRandom}) {
  return path_join(
    harness.fs.temp_dir(),
    "watch-runtime-" + harness.random.uuid_v7(),
    "receipt.json",
  )
}

fn merged_pr_probe() {
  return {
    number: 1,
    merged: true,
    github_state: "merged",
    merged_at: "2026-07-12T23:59:00Z",
    merge_commit_oid: RELEASE_MERGE_SHA,
    in_merge_queue: false,
    auto_merge_armed: false,
    mergeable_state: "unknown",
    head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
  }
}

fn observed_at(poll: int) -> string {
  if poll == 0 {
    return "2026-07-13T00:01:00Z"
  }
  return "2026-07-13T00:02:00Z"
}

pipeline test_release_watch_runtime_attaches_publish_jobs_to_newest_failed_run(
  harness: Harness,
  task: any,
) {
  const adapter = {
    now: fn(poll) { return observed_at(poll) },
    workflow_runs: fn(_slug, workflow, _poll) {
      if workflow == "publish-release.yml" {
        return [
          {
            id: 40,
            created_at: "2026-07-13T00:00:00Z",
            event: "push",
            status: "completed",
            conclusion: "failure",
            head_branch: "v1.2.3",
            head_sha: RELEASE_MERGE_SHA,
          },
          {
            id: 41,
            created_at: "2026-07-13T00:10:00Z",
            event: "push",
            status: "completed",
            conclusion: "failure",
            head_branch: "v1.2.3",
            head_sha: RELEASE_MERGE_SHA,
          },
        ]
      }
      return [
        {
          id: 42,
          created_at: "2026-07-13T00:00:00Z",
          event: "push",
          status: "completed",
          conclusion: "success",
          head_branch: "v1.2.3",
          head_sha: RELEASE_MERGE_SHA,
        },
      ]
    },
    workflow_jobs: fn(_slug, run_id, _poll) {
      assert_eq(run_id, 41)
      return {
        jobs: [
          {id: 101, name: "Detect tag drift", status: "completed", conclusion: "success"},
          {id: 102, name: "Publish release", status: "completed", conclusion: "success"},
          {
            id: 103,
            name: "Open post-release development bump",
            status: "completed",
            conclusion: "failure",
          },
        ],
      }
    },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) {
      throw "successful publication must not dispatch recovery"
    },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) {
      throw "warming is disabled"
    },
    warm_run: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    warm_jobs: fn(_slug, _run_id, _poll) {
      throw "warming is disabled"
    },
    pr_probe: fn(_slug, _pr_url) { return merged_pr_probe() },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
  const result = run_release_watch(
    harness,
    receipt(),
    receipt_path({fs: harness.fs, random: harness.random}),
    {max_polls: 1, interval_ms: 0, dispatch_warm_cache: false},
    adapter,
  )
  assert_eq(result.status, 0)
  assert_eq(result.state, "healthy")
  assert_eq(contains(result.receipt.message, "ancillary failure remains"), true)
}
