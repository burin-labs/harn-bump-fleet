import {
  cargo_vcs_info_from_crate_bytes,
  cargo_vcs_info_from_json,
  crates_io_crate_archive_url,
  download_crate_archive_bytes,
  registry_version_probe_from_identities,
} from "../lib/release_readiness"

const SOURCE = "7ad37b6af71f81549ba63baf4b7717fdb7c67f20"

pipeline test_cargo_vcs_info_parses_crate_archive_identity(task: any) {
  const json = json_stringify({git: {sha1: SOURCE, dirty: true}, path_in_vcs: "crates/harn-vm"})
  const info = cargo_vcs_info_from_json(json)
  assert_eq(info?.sha1, SOURCE)
  assert_eq(info?.dirty, true)
  assert_eq(cargo_vcs_info_from_json("{not-json"), nil)
  assert_eq(cargo_vcs_info_from_json("{\"git\":{\"sha1\":\"not-a-sha\"}}"), nil)
  const archive = gzip_encode(
    tar_create([{path: "harn-vm-1.2.3/.cargo_vcs_info.json", content: json, mode: 420}]),
  )
  assert_eq(cargo_vcs_info_from_crate_bytes(archive, "harn-vm", "1.2.3")?.sha1, SOURCE)
  assert_eq(cargo_vcs_info_from_crate_bytes(archive, "harn-vm", "1.2.4"), nil)
}

pipeline test_registry_archive_download_accepts_source_crates_above_http_default(harness: Harness) {
  const body = "x".repeat(1048577)
  harness.testing.http_mock(
    "GET",
    crates_io_crate_archive_url("harn-vm", "1.2.3"),
    {status: 200, body: body},
  )
  const downloaded = download_crate_archive_bytes(harness, "harn-vm", "1.2.3")
  assert_eq(len(downloaded ?? bytes_from_base64("")), len(body))
}

pipeline test_registry_probe_collapses_sentinel_identities(task: any) {
  const published = {published: true, state: "published"}
  assert_eq(
    registry_version_probe_from_identities("1.2.3", {published: false, state: "not_found"}, [])
      .identity_state,
    "unpublished",
  )
  assert_eq(
    registry_version_probe_from_identities("1.2.3", {published: false, state: "unknown"}, [])
      .identity_state,
    "unknown",
  )
  const first = {
    crate_name: "harn-vm",
    info: {sha1: SOURCE, path_in_vcs: "crates/harn-vm", dirty: false},
  }
  const second = {
    crate_name: "harn-cli",
    info: {sha1: SOURCE, path_in_vcs: "crates/harn-cli", dirty: true},
  }
  const matched = registry_version_probe_from_identities("1.2.3", published, [first, second])
  assert_eq([matched.identity_state, matched.source_oid], ["matched", SOURCE])
  const conflicting = second
    + {info: second.info + {sha1: "d12e3b14a779c320bb9780bffc7868f459333092"}}
  assert_eq(
    registry_version_probe_from_identities("1.2.3", published, [first, conflicting]).identity_state,
    "conflict",
  )
  assert_eq(
    registry_version_probe_from_identities(
      "1.2.3",
      published,
      [{crate_name: "harn-vm", info: nil}],
    ).identity_state,
    "missing_vcs",
  )
}
