import { registry_immutability_decision, with_fixup_state } from "../lib/release_fixup"
import { release_publication } from "../lib/release_publication"
import {
  HARN_REGISTRY_CRATE_ARCHIVE_MAX_BYTES,
  cargo_vcs_info_from_crate_bytes,
  cargo_vcs_info_from_json,
  crates_io_crate_archive_url,
  download_crate_archive_bytes,
  registry_version_probe_from_identities,
} from "../lib/release_readiness"
import { parse_release_args } from "../lib/release_runtime"

const SOURCE = "7ad37b6af71f81549ba63baf4b7717fdb7c67f20"

const OTHER = "d12e3b14a779c320bb9780bffc7868f459333092"

fn visibility(published, state = "") {
  return {
    published: published,
    state: if state != "" {
      state
    } else if published {
      "published"
    } else {
      "not_found"
    },
  }
}

fn matched_probe(version = "1.2.3") {
  return {
    version: version,
    visibility: visibility(true),
    identity_state: "matched",
    source_oid: SOURCE,
    crates: ["harn-vm", "harn-cli"],
  }
}

fn vcs_json(sha1, dirty = false) {
  return json_stringify({git: {sha1: sha1, dirty: dirty}, path_in_vcs: "crates/harn-vm"})
}

pipeline test_cargo_vcs_info_parses_crate_archive_identity(task) {
  const info = cargo_vcs_info_from_json(vcs_json(SOURCE, true))
  assert_eq(info?.sha1, SOURCE)
  assert_eq(info?.dirty, true)
  assert_eq(cargo_vcs_info_from_json("{not-json"), nil)
  const archive = gzip_encode(
    tar_create(
      [{path: "harn-vm-1.2.3/.cargo_vcs_info.json", content: vcs_json(SOURCE), mode: 420}],
    ),
  )
  const from_crate = cargo_vcs_info_from_crate_bytes(archive, "harn-vm", "1.2.3")
  assert_eq(from_crate?.sha1, SOURCE)
  assert_eq(
    crates_io_crate_archive_url("harn-vm", "1.2.3"),
    "https://static.crates.io/crates/harn-vm/harn-vm-1.2.3.crate",
  )
}

pipeline test_registry_archive_download_accepts_source_crates_above_http_default(
  harness: Harness,
  task,
) {
  const crate_name = "harn-vm"
  const version = "1.2.3"
  const body = "x".repeat(1048577)
  harness.testing.http_mock(
    "GET",
    crates_io_crate_archive_url(crate_name, version),
    {status: 200, body: body},
  )
  const downloaded = download_crate_archive_bytes(harness, crate_name, version)
  assert_eq(len(downloaded ?? bytes_from_base64("")), len(body))
  assert_eq(HARN_REGISTRY_CRATE_ARCHIVE_MAX_BYTES, 67108864)
}

pipeline test_registry_probe_collapses_sentinel_identities(task) {
  const unpublished = registry_version_probe_from_identities("1.2.3", visibility(false), [])
  assert_eq(unpublished.identity_state, "unpublished")
  const unknown = registry_version_probe_from_identities("1.2.3", visibility(false, "unknown"), [])
  assert_eq(unknown.identity_state, "unknown")
  const matched = registry_version_probe_from_identities(
    "1.2.3",
    visibility(true),
    [
      {crate_name: "harn-vm", info: {sha1: SOURCE, path_in_vcs: "crates/harn-vm", dirty: false}},
      {crate_name: "harn-cli", info: {sha1: SOURCE, path_in_vcs: "crates/harn-cli", dirty: true}},
    ],
  )
  assert_eq([matched.identity_state, matched.source_oid], ["matched", SOURCE])
  const conflict = registry_version_probe_from_identities(
    "1.2.3",
    visibility(true),
    [
      {crate_name: "harn-vm", info: {sha1: SOURCE, path_in_vcs: "crates/harn-vm", dirty: false}},
      {crate_name: "harn-cli", info: {sha1: OTHER, path_in_vcs: "crates/harn-cli", dirty: false}},
    ],
  )
  assert_eq(conflict.identity_state, "conflict")
  const missing = registry_version_probe_from_identities(
    "1.2.3",
    visibility(true),
    [{crate_name: "harn-vm", info: nil}],
  )
  assert_eq(missing.identity_state, "missing_vcs")
}

pipeline test_registry_published_without_github_refs_refuses_fresh_candidate(task) {
  const refused = registry_immutability_decision(matched_probe(), "", "", "", false)
  assert_eq(refused.action, "refuse")
  assert(contains(refused.message, "refusing to prepare a fresh v1.2.3 candidate"))
  assert(contains(refused.message, SOURCE))
  assert(contains(refused.message, "never rebuilt"))
}

pipeline test_registry_matching_source_routes_to_published_recovery(task) {
  const recovered = registry_immutability_decision(matched_probe(), "", "", SOURCE, false)
  assert_eq(recovered.action, "recover_published")
  assert_eq(recovered.source_oid, SOURCE)
  assert(contains(recovered.message, "post-publish recovery"))
}

pipeline test_registry_pin_mismatch_refuses_before_prepare(task) {
  const refused = registry_immutability_decision(matched_probe(), OTHER, OTHER, "", false)
  assert_eq(refused.action, "refuse")
  assert(contains(refused.message, "disagrees with requested --at-sha"))
  assert(contains(refused.message, OTHER))
  assert_eq(refused.source_oid, SOURCE)
}

pipeline test_registry_unpublished_keeps_existing_recovery_behavior(task) {
  const probe = {
    version: "1.2.3",
    visibility: visibility(false),
    identity_state: "unpublished",
    source_oid: "",
    crates: [],
  }
  assert_eq(registry_immutability_decision(probe, "", "", "", false).action, "allow")
  assert_eq(registry_immutability_decision(probe, OTHER, OTHER, "", true).action, "allow")
  assert_eq(registry_immutability_decision(probe, "", "", SOURCE, true).action, "allow")
}

pipeline test_registry_blocks_supersede_and_wrong_attempt(task) {
  const supersede = registry_immutability_decision(matched_probe(), "", "", SOURCE, true)
  assert_eq(supersede.action, "refuse")
  assert(contains(supersede.message, "refusing to supersede"))
  const wrong = registry_immutability_decision(matched_probe(), "", "", OTHER, false)
  assert_eq(wrong.action, "refuse")
  assert(contains(wrong.message, "crates.io packaged ${SOURCE}"))
}

pipeline test_registry_publication_forces_skip_tag_without_github_tag(harness: Harness, task) {
  const cfg = parse_release_args(harness.env, [])
  const fixed = with_fixup_state(
    cfg,
    {
      publication: release_publication("1.2.3", SOURCE),
      tag: "v1.2.3",
      pr_url: "",
      original_pin: OTHER,
      pin_unreleased: "## Unreleased\n",
      release_body_source: "attempt-release-section",
      tag_exists: false,
      release_exists: true,
      missing_assets: ["SHA256SUMS"],
      conflicting: false,
      pre_tag_resume: false,
    },
  )
  assert_eq(fixed.fixup_mode, true)
  assert_eq(fixed.skip_tag, true)
  assert_eq(fixed.release_notes_scope, "frozen_artifact")
}
