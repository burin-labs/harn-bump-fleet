import {
  fleet_settled_default_branch_proof,
  fleet_settled_proof_candidates,
} from "../lib/fleet_default_branch_proof"
import { GithubClientOptions } from "harn-github-connector/default"

const HEAD = "1111111111111111111111111111111111111111"

const MID = "2222222222222222222222222222222222222222"

const MERGE = "3333333333333333333333333333333333333333"

const OLDER = "4444444444444444444444444444444444444444"

const API = "https://fleet-settled-proof.test"

const ROOT = API + "/repos/owner/project"

fn options() -> GithubClientOptions {
  return {api_base_url: API, installation_token: "settled-proof-fixture", retry: {max_attempts: 1}}
}

fn checks_url(sha: string) -> string {
  return ROOT + "/commits/" + sha + "/check-runs?filter=latest&per_page=100"
}

fn mock_checks(testing: HarnessTesting, sha: string, rows: list) {
  const body = {status: 200, body: json_stringify({total_count: len(rows), check_runs: rows})}
  testing.http_mock("GET", checks_url(sha), body)
  testing.http_mock("GET", checks_url(sha) + "&page=1", body)
  testing.http_mock(
    "GET",
    ROOT + "/commits/" + sha + "/status?per_page=100&page=1",
    {status: 200, body: json_stringify({sha: sha, total_count: 0, statuses: []})},
  )
}

fn ci(sha: string, conclusion: string) -> dict {
  return {id: 7, name: "CI status", head_sha: sha, status: "completed", conclusion: conclusion}
}

/** The head's evidence is still arriving; MID settled with `mid_conclusion`. */
fn setup(testing: HarnessTesting, history: list<string>, mid_conclusion: string, compare: string) {
  testing.http_mock_clear()
  testing.http_mock(
    "GET",
    ROOT + "/rules/branches/main",
    {
      status: 200,
      body: json_stringify(
        [
          {
            type: "required_status_checks",
            parameters: {required_status_checks: [{context: "CI status"}]},
          },
        ],
      ),
    },
  )
  testing.http_mock(
    "GET",
    ROOT + "/branches/main",
    {status: 200, body: json_stringify({name: "main", commit: {sha: HEAD}})},
  )
  mock_checks(testing, HEAD, [])
  mock_checks(testing, MID, [ci(MID, mid_conclusion)])
  mock_checks(testing, MERGE, [ci(MERGE, "success")])
  testing.http_mock(
    "GET",
    ROOT + "/commits?sha=" + HEAD + "&per_page=20",
    {status: 200, body: json_stringify(history.map({ sha -> {sha: sha} }).to_list())},
  )
  testing.http_mock(
    "GET",
    ROOT + "/compare/" + MID + "..." + MERGE,
    {status: 200, body: json_stringify({status: compare})},
  )
}

fn prove(harness: Harness) {
  return fleet_settled_default_branch_proof(
    harness,
    {repository: "owner/project", branch: "main", head_sha: HEAD, merge_commit_sha: MERGE},
    options(),
  )
}

pipeline test_candidates_run_from_below_the_head_down_to_the_merge() {
  assert_eq(
    fleet_settled_proof_candidates(
      [{sha: HEAD}, {sha: MID}, {sha: MERGE}, {sha: OLDER}],
      HEAD,
      MERGE,
    ),
    [MID, MERGE],
  )
  // A window that never reaches the merge, or does not start at the head, proves nothing.
  assert_eq(fleet_settled_proof_candidates([{sha: HEAD}, {sha: MID}], HEAD, MERGE), [])
  assert_eq(fleet_settled_proof_candidates([{sha: MID}, {sha: MERGE}], HEAD, MERGE), [])
  assert_eq(fleet_settled_proof_candidates([], HEAD, MERGE), [])
  assert_eq(fleet_settled_proof_candidates([{sha: HEAD}, {sha: MID}], HEAD, ""), [])
}

pipeline test_a_settled_green_commit_with_the_update_proves_the_branch(harness: Harness) {
  // GitHub answers MID...MERGE from MID's side: MERGE is behind, so MID contains it.
  setup(harness.testing, [HEAD, MID, MERGE, OLDER], "success", "behind")
  const proof = prove(harness)
  assert(proof.ok, json_stringify(proof))
  assert_eq(proof.head_sha, MID)
}

pipeline test_a_settled_red_commit_keeps_waiting_on_the_head(harness: Harness) {
  setup(harness.testing, [HEAD, MID, MERGE], "failure", "behind")
  const proof = prove(harness)
  assert(!proof.ok)
  assert_eq(proof.state, "pending")
  assert_eq(proof.head_sha, HEAD)
}

pipeline test_a_commit_without_the_update_cannot_stand_in_for_the_head(harness: Harness) {
  setup(harness.testing, [HEAD, MID, MERGE], "success", "diverged")
  const proof = prove(harness)
  assert(!proof.ok)
  assert_eq(proof.head_sha, HEAD)
}

pipeline test_a_window_that_misses_the_merge_keeps_waiting_on_the_head(harness: Harness) {
  setup(harness.testing, [HEAD, MID], "success", "behind")
  const proof = prove(harness)
  assert(!proof.ok)
  assert_eq(proof.head_sha, HEAD)
}
