import { FleetManifest, FleetRepository } from "../lib/fleet_manifest"
import { decode_github_workflow } from "../lib/github_workflow"
import { render_package_ci, sync_package_ci_repo } from "../lib/package_ci_projection"

fn manifest(repo: FleetRepository) -> FleetManifest {
  return {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow:
        "owner/policy/.github/workflows/harn-package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      bump_workflow:
        "owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    file_projections: [],
    repositories: [repo],
  }
}

fn connector(run_poll_tick: bool = false, test_jobs: int = 0) -> FleetRepository {
  return {
    slug: "owner/harn-example-connector",
    directory: "harn-example-connector",
    harn_package: true,
    package_ci_ownership: "fleet",
    run_poll_tick: run_poll_tick,
    test_jobs: test_jobs,
  }
}

pipeline test_render_package_ci_is_exact_and_co_versioned() {
  const repo = connector()
  const rendered = render_package_ci(manifest(repo), repo)
  assert_eq(
    rendered,
    """name: CI

on:
  pull_request:
  push:
    branches: [main]
  merge_group:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  harn:
    uses: owner/policy/.github/workflows/harn-package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

  ci-status:
    name: CI status
    if: \${{ always() }}
    needs: [harn]
    runs-on: ubuntu-latest
    steps:
      - name: Enforce required jobs
        uses: owner/policy/.github/actions/require-successful-needs@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
        with:
          results-json: \${{ toJSON(needs.*.result) }}
"""
      + "\n",
  )
}

pipeline test_render_package_ci_projects_declared_inputs() {
  const repo = connector(true, 2)
    + {
    package_validate_command: "harn run scripts/validate.harn\nharn run scripts/fixtures.harn",
  }
  const rendered = render_package_ci(manifest(repo), repo)
  const workflow = decode_github_workflow(rendered)
  assert_eq(
    workflow.jobs.get("harn")?.with,
    {
      "run-poll-tick": true,
      "test-jobs": 2,
      "validate-command": "harn run scripts/validate.harn\nharn run scripts/fixtures.harn",
    },
  )
}

pipeline test_render_package_ci_rejects_unowned_repository() {
  const repo: FleetRepository = {
    slug: "owner/custom-package",
    directory: "custom-package",
    harn_package: true,
  }
  const result = try {
    render_package_ci(manifest(repo), repo)
  }
  assert(is_err(result))
  assert(contains(to_string(unwrap_err(result)), "does not delegate package CI ownership"))
}

pipeline test_sync_package_ci_is_idempotent(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("package-ci-")
  const repo = connector()
  const checkout = path_join(root, repo.directory)
  harness.fs.mkdir(path_join(checkout, ".github/workflows"), true)
  harness.fs.write_text(path_join(checkout, ".git"), "gitdir: fixture\n")
  harness.fs.write_text(path_join(checkout, ".github/workflows/ci.yml"), "old\n")
  const declared = manifest(repo)
  const drift = sync_package_ci_repo(harness.fs, declared, repo, root, false)
  assert_eq(drift.status, "drift")
  const applied = sync_package_ci_repo(harness.fs, declared, repo, root, true)
  assert_eq(applied.status, "applied")
  const clean = sync_package_ci_repo(harness.fs, declared, repo, root, false)
  assert_eq(clean.status, "clean")
  assert_eq(
    harness.fs.read_text(path_join(checkout, ".github/workflows/ci.yml")),
    render_package_ci(declared, repo),
  )
}
