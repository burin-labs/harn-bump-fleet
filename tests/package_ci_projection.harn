import {
  FleetManifest,
  FleetRepository,
  package_status_action_reference,
} from "../lib/fleet_manifest"
import { decode_github_workflow, github_reusable_jobs } from "../lib/github_workflow"
import {
  render_package_ci,
  render_package_ci_pin,
  sync_package_ci_repo,
} from "../lib/package_ci_projection"

fn manifest(repo: FleetRepository) -> FleetManifest {
  return {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow:
        "owner/policy/.github/workflows/harn-package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      bump_workflow:
        "owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    file_projections: [],
    repositories: [repo],
  }
}

fn connector(run_poll_tick: bool = false, test_jobs: int = 0) -> FleetRepository {
  return {
    slug: "owner/harn-example-connector",
    directory: "harn-example-connector",
    harn_package: true,
    package_ci_ownership: "fleet",
    run_poll_tick: run_poll_tick,
    test_jobs: test_jobs,
  }
}

pipeline test_render_package_ci_is_exact_and_co_versioned() {
  const repo = connector()
  const rendered = render_package_ci(manifest(repo), repo)
  assert_eq(
    rendered,
    """name: CI

on:
  pull_request:
  push:
    branches: [main]
  merge_group:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  harn:
    uses: owner/policy/.github/workflows/harn-package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

  ci-status:
    name: CI status
    if: \${{ always() }}
    needs: [harn]
    runs-on: ubuntu-latest
    steps:
      - name: Enforce required jobs
        uses: owner/policy/.github/actions/require-successful-needs@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
        with:
          results-json: \${{ toJSON(needs.*.result) }}
"""
      + "\n",
  )
}

pipeline test_render_package_ci_projects_declared_inputs() {
  const repo = connector(true, 2)
    + {
    package_validate_command: "harn run scripts/validate.harn\nharn run scripts/fixtures.harn",
  }
  const rendered = render_package_ci(manifest(repo), repo)
  const workflow = decode_github_workflow(rendered)
  assert_eq(
    workflow.jobs.get("harn")?.with,
    {
      "run-poll-tick": true,
      "test-jobs": 2,
      "validate-command": "harn run scripts/validate.harn\nharn run scripts/fixtures.harn",
    },
  )
}

pipeline test_render_package_ci_rejects_unowned_repository() {
  const repo: FleetRepository = {
    slug: "owner/custom-package",
    directory: "custom-package",
    harn_package: true,
  }
  const result = try {
    render_package_ci(manifest(repo), repo)
  }
  assert(is_err(result))
  assert(contains(to_string(unwrap_err(result)), "does not delegate package CI ownership"))
}

pipeline test_sync_package_ci_is_idempotent(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("package-ci-")
  const repo = connector()
  const checkout = path_join(root, repo.directory)
  harness.fs.mkdir(path_join(checkout, ".github/workflows"), true)
  harness.fs.write_text(path_join(checkout, ".git"), "gitdir: fixture\n")
  harness.fs.write_text(path_join(checkout, ".github/workflows/ci.yml"), "old\n")
  const declared = manifest(repo)
  const drift = sync_package_ci_repo(harness.fs, declared, repo, root, false)
  assert_eq(drift.status, "drift")
  const applied = sync_package_ci_repo(harness.fs, declared, repo, root, true)
  assert_eq(applied.status, "applied")
  const clean = sync_package_ci_repo(harness.fs, declared, repo, root, false)
  assert_eq(clean.status, "clean")
  assert_eq(
    harness.fs.read_text(path_join(checkout, ".github/workflows/ci.yml")),
    render_package_ci(declared, repo),
  )
}

fn thrown(callback) -> string {
  return try {
    callback()
    ""
  } catch (e) {
    to_string(e)
  }
}

fn superset_repo() -> FleetRepository {
  return {
    slug: "owner/harn-superset",
    directory: "harn-superset",
    harn_package: true,
    package_ci_ownership: "pin",
  }
}

fn superset_ci(reference: string) -> string {
  return join(
    [
      "name: CI",
      "",
      "on:",
      "  pull_request:",
      "  push:",
      "    branches: [main]",
      "  merge_group:",
      "  workflow_dispatch:",
      "",
      "permissions:",
      "  contents: read",
      "",
      "jobs:",
      "  harn:",
      "    uses: ${reference}",
      "",
      "  extension-bundle:",
      "    runs-on: ubuntu-latest",
      "    steps:",
      "      - run: make bundle",
      "",
    ],
    "\n",
  )
}

pipeline test_pin_only_projection_moves_the_pin_and_keeps_repo_jobs(harness: Harness, task) {
  // A superset repository runs the canonical package job beside jobs that are
  // its own. Rewriting the whole file is what makes it undeclarable, so the
  // projection has to move one line and leave the rest byte-identical.
  const repo = superset_repo()
  const stale =
    "owner/policy/.github/workflows/harn-package.yml@cccccccccccccccccccccccccccccccccccccccc"
  const rendered = render_package_ci_pin(manifest(repo), repo, superset_ci(stale))
  assert_eq(rendered, superset_ci(manifest(repo).policy.package_workflow))
  assert(contains(rendered, "extension-bundle"))
  assert(contains(rendered, "make bundle"))
  assert_eq(contains(rendered, stale), false)
  // Structural proof, not a substring: the decoded workflow is at the pin the
  // policy checker will look for.
  assert_eq(
    len(
      github_reusable_jobs(
        decode_github_workflow(rendered),
        manifest(repo).policy.package_workflow,
      ),
    ),
    1,
  )
}

pipeline test_pin_only_projection_is_a_fixed_point(harness: Harness, task) {
  const repo = superset_repo()
  const pinned = superset_ci(manifest(repo).policy.package_workflow)
  assert_eq(render_package_ci_pin(manifest(repo), repo, pinned), pinned)
}

pipeline test_pin_only_projection_refuses_an_ambiguous_workflow(harness: Harness, task) {
  // Two canonical jobs, or none, means the projection cannot know which pin it
  // owns. Refusing is the only safe answer; guessing rewrites someone's CI.
  const repo = superset_repo()
  const doubled = superset_ci(
    "owner/policy/.github/workflows/harn-package.yml@cccccccccccccccccccccccccccccccccccccccc",
  )
    + join(
    [
      "  second:",
      "    uses: owner/policy/.github/workflows/harn-package.yml@dddddddddddddddddddddddddddddddddddddddd",
      "",
    ],
    "\n",
  )
  assert(
    contains(
      thrown({ -> render_package_ci_pin(manifest(repo), repo, doubled) }),
      "exactly one job",
    ),
  )
  const none = join(
    [
      "name: CI",
      "",
      "on:",
      "  pull_request:",
      "",
      "jobs:",
      "  build:",
      "    runs-on: ubuntu-latest",
      "    steps:",
      "      - run: make",
      "",
    ],
    "\n",
  )
  assert(
    contains(thrown({ -> render_package_ci_pin(manifest(repo), repo, none) }), "exactly one job"),
  )
}

pipeline test_pin_only_projection_refuses_a_repository_that_did_not_delegate(
  harness: Harness,
  task,
) {
  const repo = connector()
  const stale =
    "owner/policy/.github/workflows/harn-package.yml@cccccccccccccccccccccccccccccccccccccccc"
  assert(
    contains(
      thrown({ -> render_package_ci_pin(manifest(repo), repo, superset_ci(stale)) }),
      "does not delegate package CI pinning",
    ),
  )
}

/** A superset workflow that also rolls its jobs up through the shared action. */
fn superset_ci_with_status(workflow_ref: string, status_ref: string) -> string {
  return join(
    [
      "name: CI",
      "",
      "on:",
      "  pull_request:",
      "",
      "jobs:",
      "  harn:",
      "    uses: ${workflow_ref}",
      "",
      "  extension-bundle:",
      "    runs-on: ubuntu-latest",
      "    steps:",
      "      - run: make bundle",
      "",
      "  status:",
      "    name: CI status",
      "    needs: [harn, extension-bundle]",
      "    runs-on: ubuntu-latest",
      "    steps:",
      "      - name: Enforce required jobs",
      "        uses: ${status_ref}",
      "",
    ],
    "\n",
  )
}

pipeline test_pin_only_projection_moves_both_co_versioned_lines(harness: Harness, task) {
  // The package workflow checks its policy actions out at `job.workflow_sha`,
  // and the shared policy refuses a workflow whose status roll-up names a
  // different revision than the package job. Moving one and not the other
  // leaves the pair split, which surfaces as a red policy check in every
  // superset repository at once rather than as anything local.
  const repo = superset_repo()
  const stale = "cccccccccccccccccccccccccccccccccccccccc"
  const rendered = render_package_ci_pin(
    manifest(repo),
    repo,
    superset_ci_with_status(
      "owner/policy/.github/workflows/harn-package.yml@${stale}",
      "owner/policy/.github/actions/require-successful-needs@${stale}",
    ),
  )
  assert_eq(contains(rendered, stale), false)
  assert_eq(
    rendered,
    superset_ci_with_status(
      manifest(repo).policy.package_workflow,
      package_status_action_reference(manifest(repo).policy.package_workflow),
    ),
  )
  assert(contains(rendered, "make bundle"))
}

pipeline test_pin_only_projection_leaves_a_workflow_with_no_status_action_alone(
  harness: Harness,
  task,
) {
  // The status roll-up is the repository's to declare. The projection owns its
  // revision when it is there, and does not add one when it is not.
  const repo = superset_repo()
  const rendered = render_package_ci_pin(
    manifest(repo),
    repo,
    superset_ci(
      "owner/policy/.github/workflows/harn-package.yml@cccccccccccccccccccccccccccccccccccccccc",
    ),
  )
  assert_eq(rendered, superset_ci(manifest(repo).policy.package_workflow))
  assert_eq(contains(rendered, "require-successful-needs"), false)
}
