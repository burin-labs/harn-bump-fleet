import {
  census_refusals,
  coverage_census,
  is_test_module,
  ratchet_findings,
  resolve_import_target,
  summarize_module,
} from "../lib/regex_captures_coverage"
import { probe_release_version } from "./fixtures/regex_captures_probe"

const PROBE_MODULE = "tests/fixtures/regex_captures_probe.harn"

const PROBE_SOURCE = "fixtures/regex_captures_probe.harn"

type HarnParseEnvelope = {ok: bool, data: any}

fn call_node(name: string, line: int) -> any {
  return {kind: "FunctionCall", fields: {name: name, args: []}, span: {line: line}}
}

fn declaration(kind: string, name: string, body: list<any>) -> any {
  return {kind: kind, fields: {name: name, body: body}, span: {line: 1}}
}

fn attributed(name: string, decl: any) -> any {
  return {kind: "AttributedDecl", fields: {attributes: [{name: name, args: []}], inner: decl}}
}

fn selective_import(path: string, names: list<string>) -> any {
  return {kind: "SelectiveImport", fields: {path: path, names: names, is_pub: false}}
}

fn program(body: list<any>) -> any {
  return {kind: "Program", body: body}
}

/**
 * The census reads a real parse of a real file, so this anchors the fixture
 * shapes below against the parser rather than against a model of it. A test
 * built only on hand-written AST dicts could agree with a wrong model of the
 * AST exactly the way a stubbed `regex_captures` agrees with a wrong model of
 * `regex_captures`.
 */
pipeline test_the_summarizer_reads_the_real_parser(harness: Harness, task: any) {
  assert_eq(probe_release_version("release v0.10"), "0.10")
  assert_eq(probe_release_version("release v0.10.132"), nil)
  const staged = path_join(harness.fs.workspace_temp_dir(), "regex_captures_probe.harn")
  harness.fs.write_text(staged, harness.fs.read_text(PROBE_SOURCE))
  const parsed = harness.process.run({program: "harn", args: ["parse", "--json", staged]})
  assert_eq(parsed.success, true)
  const document = json_parse(parsed.stdout)
  assert(schema_is(document, schema_of(HarnParseEnvelope)))
  const envelope = schema_expect(document, schema_of(HarnParseEnvelope))
  assert_eq(envelope.ok, true)
  const summary = summarize_module(PROBE_MODULE, envelope.data)
  assert_eq(summary.file_capture_total, 1)
  assert_eq(len(summary.functions), 1)
  assert_eq(summary.functions[0]?.name, "probe_release_version")
  assert_eq(len(summary.functions[0]?.capture_lines ?? []), 1)
  assert(contains(summary.functions[0]?.calls ?? [], "regex_captures"))
  assert(contains(summary.functions[0]?.calls ?? [], "trim"))
}

pipeline test_module_summary_owns_every_declaration_shape(task: any) {
  const summary = summarize_module(
    "tests/example.harn",
    program(
      [
        selective_import("../lib/thing", ["helper"]),
        declaration("FnDecl", "reader", [call_node("regex_captures", 12)]),
        attributed("test", declaration("Pipeline", "test_reader", [call_node("reader", 20)])),
        declaration("Pipeline", "not_a_test", [call_node("helper", 30)]),
      ],
    ),
  )
  assert_eq(summary.file_capture_total, 1)
  assert_eq(len(summary.imports), 1)
  assert_eq(summary.imports[0]?.path, "../lib/thing")
  assert_eq(len(summary.functions), 3)
  assert_eq(summary.functions[0]?.capture_lines, [12])
  assert_eq(summary.functions[0]?.is_test_root, false)
  assert_eq(summary.functions[1]?.name, "test_reader")
  assert_eq(summary.functions[1]?.is_test_root, true)
  assert_eq(summary.functions[2]?.is_test_root, false)
}

pipeline test_a_test_pipeline_outside_a_test_directory_is_not_a_root(task: any) {
  assert_eq(is_test_module("tests/a.harn"), true)
  assert_eq(is_test_module("tests-risky/a.harn"), true)
  assert_eq(is_test_module("lib/tests_helper.harn"), false)
  const summary = summarize_module(
    "lib/looks_like_a_test.harn",
    program([declaration("Pipeline", "test_reader", [call_node("regex_captures", 3)])]),
  )
  assert_eq(summary.functions[0]?.is_test_root, false)
}

pipeline test_import_paths_resolve_sibling_first_then_root(task: any) {
  const known = ["lib/thing.harn", "lib/nested/thing.harn", "release_harn.harn"]
  assert_eq(resolve_import_target("lib/caller.harn", "std/fs", known), nil)
  assert_eq(resolve_import_target("lib/caller.harn", "./thing", known), "lib/thing.harn")
  assert_eq(resolve_import_target("tests/a.harn", "../lib/thing", known), "lib/thing.harn")
  assert_eq(resolve_import_target("lib/nested/a.harn", "./thing", known), "lib/nested/thing.harn")
  assert_eq(resolve_import_target("lib/a.harn", "thing", known), "lib/thing.harn")
  assert_eq(resolve_import_target("lib/a.harn", "lib/thing", known), "lib/thing.harn")
  assert_eq(
    resolve_import_target("tests/a.harn", "../release_harn.harn", known),
    "release_harn.harn",
  )
  assert_eq(resolve_import_target("lib/a.harn", "harn-github-connector/default", known), nil)
  assert_eq(resolve_import_target("lib/a.harn", "", known), nil)
}

fn library_module() -> any {
  return summarize_module(
    "lib/reader.harn",
    program([declaration("FnDecl", "read_tag", [call_node("regex_captures", 7)])]),
  )
}

fn covering_test_module() -> any {
  return summarize_module(
    "tests/reader.harn",
    program(
      [
        selective_import("../lib/reader", ["read_tag"]),
        declaration("Pipeline", "test_read_tag", [call_node("read_tag", 4)]),
      ],
    ),
  )
}

fn silent_test_module() -> any {
  return summarize_module(
    "tests/reader.harn",
    program(
      [
        selective_import("../lib/reader", ["read_tag"]),
        declaration("Pipeline", "test_something_else", [call_node("len", 4)]),
      ],
    ),
  )
}

pipeline test_a_site_a_test_reaches_is_covered(task: any) {
  const census = coverage_census([library_module(), covering_test_module()])
  assert_eq(census.module_count, 2)
  assert_eq(census.site_count, 1)
  assert_eq(census.covered_count, 1)
  assert_eq(census.uncovered, [])
  assert_eq(census.unowned, [])
  assert_eq(ratchet_findings(census, []), [])
}

/**
 * The negative control the class turns on: take the covering test away and the
 * site must be reported by name as uncovered. A census that quietly dropped it
 * would go green on exactly the change that removes the protection.
 */
pipeline test_removing_the_covering_test_reports_the_site_not_zero(task: any) {
  const census = coverage_census([library_module(), silent_test_module()])
  assert_eq(census.site_count, 1)
  assert_eq(census.covered_count, 0)
  assert_eq(len(census.uncovered), 1)
  assert_eq(census.uncovered[0]?.module, "lib/reader.harn")
  assert_eq(census.uncovered[0]?.function, "read_tag")
  assert_eq(census.uncovered[0]?.line, 7)
  const findings = ratchet_findings(census, [])
  assert_eq(len(findings), 1)
  assert(contains(findings[0] ?? "", "lib/reader.harn:7"))
  assert(contains(findings[0] ?? "", "read_tag"))
}

pipeline test_reachability_follows_a_chain_and_stops_where_it_breaks(task: any) {
  const deep = summarize_module(
    "lib/deep.harn",
    program([declaration("FnDecl", "deep_read", [call_node("regex_captures", 9)])]),
  )
  const middle = summarize_module(
    "lib/middle.harn",
    program(
      [
        selective_import("./deep", ["deep_read"]),
        declaration("FnDecl", "middle_read", [call_node("deep_read", 5)]),
      ],
    ),
  )
  const test_module = summarize_module(
    "tests/chain.harn",
    program(
      [
        selective_import("../lib/middle", ["middle_read"]),
        declaration("Pipeline", "test_chain", [call_node("middle_read", 3)]),
      ],
    ),
  )
  assert_eq(coverage_census([deep, middle, test_module]).covered_count, 1)
  const broken = summarize_module(
    "lib/middle.harn",
    program(
      [
        selective_import("./deep", ["deep_read"]),
        declaration("FnDecl", "middle_read", [call_node("len", 5)]),
      ],
    ),
  )
  const cut = coverage_census([deep, broken, test_module])
  assert_eq(cut.covered_count, 0)
  assert_eq(cut.uncovered[0]?.function, "deep_read")
}

/**
 * A call site the declaration walk cannot attribute has to surface as a shape
 * discrepancy. Dropping it would let a whole class of sites leave the census
 * without ever being counted as pending.
 */
pipeline test_a_site_outside_every_declaration_is_reported_unowned(task: any) {
  const summary = summarize_module(
    "lib/toplevel.harn",
    program(
      [
        {
          kind: "ConstBinding",
          fields: {
            pattern: {kind: "Identifier", fields: "TAGS"},
            value: call_node("regex_captures", 2),
          },
          span: {line: 2},
        },
      ],
    ),
  )
  assert_eq(summary.file_capture_total, 1)
  assert_eq(len(summary.functions), 0)
  const census = coverage_census([summary])
  assert_eq(census.site_count, 0)
  assert_eq(len(census.unowned), 1)
  assert(contains(census.unowned[0] ?? "", "lib/toplevel.harn"))
  const findings = ratchet_findings(census, [])
  assert_eq(len(findings), 1)
  assert(contains(findings[0] ?? "", "unattributed call site"))
}

pipeline test_the_baseline_ratchet_fails_in_both_directions(task: any) {
  const uncovered = coverage_census([library_module(), silent_test_module()])
  const exact = [{module: "lib/reader.harn", function: "read_tag", reason: "recorded"}]
  assert_eq(ratchet_findings(uncovered, exact), [])
  const wrong_name = [{module: "lib/reader.harn", function: "other", reason: "recorded"}]
  const too_tight = ratchet_findings(uncovered, wrong_name)
  assert_eq(len(too_tight), 2)
  assert(contains(too_tight[0] ?? "", "not reached by any test"))
  assert(contains(too_tight[1] ?? "", "remove it from the baseline"))
  const covered = coverage_census([library_module(), covering_test_module()])
  const too_loose = ratchet_findings(covered, exact)
  assert_eq(len(too_loose), 1)
  assert(contains(too_loose[0] ?? "", "remove it from the baseline"))
}

/**
 * A measured zero is not the same as measuring nothing. Each of these inputs
 * would otherwise reach the ratchet with an empty uncovered list and pass.
 */
pipeline test_a_census_that_measured_nothing_refuses(task: any) {
  const empty = coverage_census([])
  assert_eq(empty.site_count, 0)
  const no_modules = census_refusals(empty, [])
  assert_eq(len(no_modules), 2)
  assert(contains(no_modules[0] ?? "", "no modules were inventoried"))
  assert(contains(no_modules[1] ?? "", "no `regex_captures` call site"))
  const siteless = coverage_census(
    [summarize_module("lib/quiet.harn", program([declaration("FnDecl", "quiet", [])]))],
  )
  const no_sites = census_refusals(siteless, [])
  assert_eq(len(no_sites), 1)
  assert(contains(no_sites[0] ?? "", "broken census rather than a clean one"))
  const healthy = coverage_census([library_module(), covering_test_module()])
  assert_eq(census_refusals(healthy, []), [])
  const unreadable = census_refusals(healthy, ["lib/broken.harn"])
  assert_eq(len(unreadable), 1)
  assert(contains(unreadable[0] ?? "", "could not parse lib/broken.harn"))
}
