import { release_candidate_tree_decision } from "../lib/release_candidate_tree_contract"
import { candidate_tree_release_note_fold } from "../lib/release_note_fold"
import { release_harness_root } from "../lib/release_runtime"

fn fixture_shell(process: HarnessProcess, command: string) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

/**
 * The real-shape contract check must stay wired to the gates it claims to
 * cover. A check that stops importing a decision function silently stops
 * covering it, which is the failure mode it exists to prevent.
 */
pipeline test_contract_check_drives_the_real_gate_decisions(harness: Harness, task) {
  const root = release_harness_root(harness.fs)
  const source = harness.fs.read_text(path_join(root, "check_release_contract.harn"))
  // The three gates that broke at live cuts when the version scheme changed.
  assert(contains(source, "prior_release_fold_decision"))
  assert(contains(source, "next_release_version"))
  assert(contains(source, "last_published_release_version"))
  assert(contains(source, "release_body_gate_version"))
  assert(contains(source, "release_candidate_tree_decision"))
  assert(contains(source, "candidate_tree_release_note_fold"))
  // It must read the target repo's REAL state, not a fixture.
  assert(contains(source, ":Cargo.toml"))
  assert(contains(source, ":CHANGELOG.md"))
  // It must never mutate the target repo or dispatch anything.
  assert_eq(contains(source, "gh workflow run"), false)
  assert_eq(contains(source, "git push"), false)
}

pipeline test_candidate_tree_contract_ignores_ordinary_development_tree(task) {
  const decision = release_candidate_tree_decision(
    "1.2.3-dev",
    "1.2.3-dev",
    {
      success: true,
      message: "",
      text: "",
      changed: false,
      fragments: [],
      fragment_paths: [],
      fragment_section: "",
      agent_notes: "",
      valid: true,
      findings: [],
    },
  )
  assert_eq([decision.applicable, decision.proceed], [false, true])
}

@test
pipeline test_merge_queue_tree_rejects_post_candidate_fragment_and_accepts_exact_refold(
  harness: Harness,
  task,
) {
  const root = path_join(harness.fs.temp_dir(), "release-tree-" + harness.random.uuid_v7())
  const repo = path_join(root, "repo")
  harness.fs.mkdir(path_join(repo, "changelog.d"), true)
  fixture_shell(harness.process, "git init -q '" + repo + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + repo + "' switch -qc main")
  harness.fs.write_text(
    path_join(repo, "Cargo.toml"),
    "[workspace.package]\nversion = \"1.2.3-dev\"\n",
  )
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## Unreleased\n\n### Fixed\n\n- Pin fix.\n\n## v1.2.2\n\n- Prior.\n",
  )
  harness.fs.write_text(path_join(repo, "changelog.d/pin.fixed.md"), "Pin fix.\n")
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add . && git -C '" + repo + "' commit -qm pin",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' switch -qc release")
  harness.fs.write_text(path_join(repo, "Cargo.toml"), "[workspace.package]\nversion = \"1.2.3\"\n")
  const prepared = candidate_tree_release_note_fold(
    {fs: harness.fs, process: harness.process},
    {repo: repo, mock: false},
    "1.2.3",
    nil,
  )
  assert(prepared.success && prepared.valid && prepared.changed)
  harness.fs.write_text(path_join(repo, "CHANGELOG.md"), prepared.text)
  for path in prepared.fragment_paths {
    harness.fs.delete(path)
  }
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add -A && git -C '" + repo + "' commit -qm candidate",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' switch -q main")
  harness.fs.write_text(path_join(repo, "changelog.d/late.fixed.md"), "Late fix.\n")
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add . && git -C '" + repo + "' commit -qm late",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' merge -q --no-edit release")
  const synthetic = candidate_tree_release_note_fold(
    {fs: harness.fs, process: harness.process},
    {repo: repo, mock: false},
    "1.2.3",
    nil,
  )
  const rejected = release_candidate_tree_decision("1.2.3-dev", "1.2.3", synthetic)
  assert_eq([rejected.applicable, rejected.proceed], [true, false])
  assert_eq(len(synthetic.fragment_paths), 1)
  assert(contains(rejected.reason, "regenerate the immutable candidate"))
  harness.fs.write_text(path_join(repo, "CHANGELOG.md"), synthetic.text)
  for path in synthetic.fragment_paths {
    harness.fs.delete(path)
  }
  const exact = candidate_tree_release_note_fold(
    {fs: harness.fs, process: harness.process},
    {repo: repo, mock: false},
    "1.2.3",
    nil,
  )
  const accepted = release_candidate_tree_decision("1.2.3-dev", "1.2.3", exact)
  assert_eq([accepted.applicable, accepted.proceed], [true, true])
  harness.fs.delete(root)
}
