import { release_contract_check_phase, run_release_contract_check } from "../check_release_contract"
import {
  candidate_range_evidence,
  candidate_tree_range_scope,
  partition_candidate_fragments,
  release_candidate_tree_decision,
} from "../lib/release_candidate_tree_contract"
import { candidate_tree_release_note_fold } from "../lib/release_note_fold"
import { release_harness_root } from "../lib/release_runtime"
import { release_contract_fixture } from "./release_contract_fixture"

fn fixture_shell(process: HarnessProcess, command: string) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn git_at(process: HarnessProcess, repo: string, command: string) -> string {
  return trim(fixture_shell(process, "git -C '" + repo + "' " + command).stdout)
}

fn init_contract_phase_fixture(harness: Harness) {
  const root = path_join(
    harness.fs.temp_dir(),
    "release-contract-phase-" + harness.random.uuid_v7(),
  )
  const repo = path_join(root, "repo")
  const origin = path_join(root, "origin.git")
  harness.fs.mkdir(path_join(repo, "scripts"), true)
  fixture_shell(harness.process, "git init -q --bare '" + origin + "'")
  fixture_shell(harness.process, "git init -q '" + repo + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + repo + "' remote add origin '" + origin + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' switch -qc main")
  harness.fs.write_text(
    path_join(repo, "scripts/release_contract.json"),
    json_stringify(release_contract_fixture()) + "\n",
  )
  harness.fs.write_text(path_join(repo, "Cargo.toml"), "[workspace.package]\nversion = \"1.2.3\"\n")
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## v1.2.3\n\n- Published.\n",
  )
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add . && git -C '" + repo + "' commit -qm published",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' tag v1.2.3")
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin main v1.2.3")
  harness.fs.write_text(path_join(repo, "Cargo.toml"), "[workspace.package]\nversion = \"1.2.4\"\n")
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## v1.2.4\n\n- Pending.\n\n## v1.2.3\n\n- Published.\n",
  )
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add . && git -C '" + repo + "' commit -qm 'Release v1.2.4'",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin main")
  return {root: root, repo: repo}
}

fn run_contract_check(harness: Harness, repo: string) {
  let lines: list<string> = []
  const exit_code = run_release_contract_check(
    {
      fs: harness.fs,
      process: harness.process,
      println: fn(line) {
        lines = lines + [line]
        return nil
      },
    },
    ["--repo", repo, "--base", "main", "--contract-ref", "HEAD"],
  )
  return {exit_code: exit_code, output: join(lines, "\n")}
}

fn clean_fold() {
  return {
    success: true,
    message: "",
    text: "",
    changed: false,
    fragments: [],
    fragment_paths: [],
    fragment_section: "",
    agent_notes: "",
    valid: true,
    findings: [],
  }
}

fn clean_scope() {
  return {owned: [], deferred: [], scoped: true, detail: "", scoped_changed: false}
}

pipeline test_contract_check_defers_an_unchanged_contract_while_publication_is_pending(task: any) {
  const contract = release_contract_fixture()
  const pending = release_contract_check_phase(contract, "1.2.4", "1.2.4", "v1.2.3", false)
  assert_eq(pending, {state: "publication_pending", version: "1.2.4"})
}

pipeline test_contract_check_does_not_hide_release_semantics_changes_during_publication(task: any) {
  const contract = release_contract_fixture()
  const changed = release_contract_check_phase(contract, "1.2.4", "1.2.4", "v1.2.3", true)
  assert_eq(changed, {state: "pending_contract_changed", version: "1.2.4"})
}

pipeline test_contract_check_rejects_shapes_that_are_not_exactly_the_next_pending_release(
  task: any,
) {
  const contract = release_contract_fixture()
  for [workspace, changelog] in [["1.2.5", "1.2.5"], ["1.2.4", "1.2.3"], ["1.2.4-dev", "1.2.4"]] {
    assert_eq(
      release_contract_check_phase(contract, workspace, changelog, "v1.2.3", false),
      {state: "evaluate", version: ""},
    )
  }
  assert_eq(
    release_contract_check_phase(contract, "1.2.4", "1.2.4", "not-a-tag", false),
    {state: "evaluate", version: ""},
  )
}

@test
pipeline test_contract_check_command_distinguishes_pending_publication_from_missing_evidence(
  harness: Harness,
  task: any,
) {
  const fixture = init_contract_phase_fixture(harness)
  const repo = fixture.repo
  const pending = run_contract_check(harness, repo)
  assert_eq(pending.exit_code, 0)
  assert(contains(pending.output, "phase : publication pending for v1.2.4"))
  assert(contains(pending.output, "publication is not yet proven"))
  const contract_path = path_join(repo, "scripts/release_contract.json")
  const original_contract = harness.fs.read_text(contract_path)
  harness.fs.write_text(
    contract_path,
    original_contract.replace("Release v{version}", "Cut v{version}"),
  )
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add scripts/release_contract.json"
      + " && git -C '"
      + repo
      + "' commit -qm 'change release contract'",
  )
  const changed = run_contract_check(harness, repo)
  assert_eq(changed.exit_code, 1)
  assert(contains(changed.output, "release contract changed while the repository is between"))
  harness.fs.write_text(contract_path, original_contract)
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add scripts/release_contract.json"
      + " && git -C '"
      + repo
      + "' commit -qm 'restore release contract'",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' tag v1.2.4 origin/main")
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin v1.2.4")
  const published = run_contract_check(harness, repo)
  assert_eq(published.exit_code, 0)
  assert(contains(published.output, "✓ prior-release fold"))
  assert_eq(contains(published.output, "publication pending"), false)
  fixture_shell(harness.process, "git -C '" + repo + "' branch contract-head HEAD")
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' switch -q main"
      + " && git -C '"
      + repo
      + "' rm -q scripts/release_contract.json"
      + " && git -C '"
      + repo
      + "' commit -qm 'missing base contract'"
      + " && git -C '"
      + repo
      + "' push -q origin main"
      + " && git -C '"
      + repo
      + "' switch -q contract-head",
  )
  const missing = try {
    run_contract_check(harness, repo)
  }
  assert(is_err(missing))
  assert(contains(unwrap_err(missing), "origin/main:scripts/release_contract.json"))
  harness.fs.delete(fixture.root)
}

/**
 * Build a default branch as it stands before a candidate is prepared: one
 * authored `## Unreleased` entry with its matching changelog fragment, and an
 * origin the immutable attempt refs can be published to.
 */
fn init_release_fixture(harness: Harness) {
  const root = path_join(harness.fs.temp_dir(), "release-tree-" + harness.random.uuid_v7())
  const repo = path_join(root, "repo")
  const origin = path_join(root, "origin.git")
  harness.fs.mkdir(path_join(repo, "changelog.d"), true)
  fixture_shell(harness.process, "git init -q --bare '" + origin + "'")
  fixture_shell(harness.process, "git init -q '" + repo + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + repo + "' remote add origin '" + origin + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' switch -qc main")
  harness.fs.write_text(
    path_join(repo, "Cargo.toml"),
    "[workspace.package]\nversion = \"1.2.3-dev\"\n",
  )
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## Unreleased\n\n### Fixed\n\n- Pin fix.\n\n## v1.2.2\n\n- Prior.\n",
  )
  harness.fs.write_text(path_join(repo, "changelog.d/pin.fixed.md"), "Pin fix.\n")
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add . && git -C '" + repo + "' commit -qm pin",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin main")
  return {root: root, repo: repo, origin: origin}
}

/**
 * Prepare an immutable candidate and publish it under its content-addressed
 * attempt ref, the way a release run does. `unfolded` names fragments the
 * candidate carries without folding them.
 */
fn prepare_candidate(
  harness: {fs: HarnessFs, process: HarnessProcess},
  repo: string,
  branch: string,
  unfolded: list<string>,
) -> string {
  fixture_shell(harness.process, "git -C '" + repo + "' switch -qc " + branch + " main")
  harness.fs.write_text(path_join(repo, "Cargo.toml"), "[workspace.package]\nversion = \"1.2.3\"\n")
  const prepared = candidate_tree_release_note_fold(
    {fs: harness.fs, process: harness.process},
    {repo: repo, mock: false},
    "1.2.3",
    nil,
  )
  if !(prepared.success && prepared.valid && prepared.changed) {
    throw "fixture candidate did not fold cleanly: ${prepared.message}"
  }
  harness.fs.write_text(path_join(repo, "CHANGELOG.md"), prepared.text)
  for path in prepared.fragment_paths {
    harness.fs.delete(path)
  }
  for name in unfolded {
    harness.fs.write_text(path_join(repo, "changelog.d/" + name), "Candidate note ${name}.\n")
  }
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add -A && git -C '" + repo + "' commit -qm candidate",
  )
  const oid = git_at(harness.process, repo, "rev-parse HEAD")
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' push -q origin HEAD:refs/heads/release-attempt/v1.2.3/" + oid,
  )
  return oid
}

/** Land fragments on the default branch after the candidate was prepared. */
fn land_later_fragments(
  harness: {fs: HarnessFs, process: HarnessProcess},
  repo: string,
  names: list<string>,
) -> nil {
  fixture_shell(harness.process, "git -C '" + repo + "' switch -q main")
  for name in names {
    harness.fs.write_text(path_join(repo, "changelog.d/" + name), "Later note ${name}.\n")
  }
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add -A && git -C '" + repo + "' commit -qm later",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin main")
  return nil
}

/** Check out the tree a pull-request run sees: the candidate merged with main. */
fn checkout_merge_tree(
  harness: {fs: HarnessFs, process: HarnessProcess},
  repo: string,
  branch: string,
  candidate_branch: string,
) -> nil {
  fixture_shell(harness.process, "git -C '" + repo + "' switch -qc " + branch + " main")
  fixture_shell(harness.process, "git -C '" + repo + "' merge -q --no-edit " + candidate_branch)
  return nil
}

/** Check out the tree a squashing merge queue sees: one commit, no link back. */
fn checkout_squash_tree(
  harness: {fs: HarnessFs, process: HarnessProcess},
  repo: string,
  branch: string,
  candidate_branch: string,
) -> nil {
  fixture_shell(harness.process, "git -C '" + repo + "' switch -qc " + branch + " main")
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' merge -q --squash " + candidate_branch
      + " && git -C '"
      + repo
      + "' commit -qm queued",
  )
  return nil
}

/** Count the parents of the checked-out commit. */
fn head_parent_count(process: HarnessProcess, repo: string) -> int {
  const line = git_at(process, repo, "rev-list --parents -n 1 HEAD")
  return len(split(line, " ")) - 1
}

/** Run the whole contract over the checked-out tree, exactly as the check does. */
fn tree_contract(harness: {fs: HarnessFs, process: HarnessProcess}, repo: string) {
  const cfg = {repo: repo, mock: false}
  const fold = candidate_tree_release_note_fold(
    {fs: harness.fs, process: harness.process},
    cfg,
    "1.2.3",
    nil,
  )
  const evidence = candidate_range_evidence(harness.process, cfg, "1.2.3")
  const scope = candidate_tree_range_scope(harness.fs, cfg, fold, evidence, "1.2.3")
  return {
    fold: fold,
    evidence: evidence,
    scope: scope,
    decision: release_candidate_tree_decision("1.2.3-dev", "1.2.3", fold, scope),
  }
}

/**
 * The real-shape contract check must stay wired to the gates it claims to
 * cover. A check that stops importing a decision function silently stops
 * covering it, which is the failure mode it exists to prevent.
 */
pipeline test_contract_check_drives_the_real_gate_decisions(harness: Harness, task: any) {
  const root = release_harness_root(harness.fs)
  const source = harness.fs.read_text(path_join(root, "check_release_contract.harn"))
  // The three gates that broke at live cuts when the version scheme changed.
  assert(contains(source, "prior_release_fold_decision"))
  assert(contains(source, "contract_next_release_version"))
  assert(contains(source, "contract_last_published_release_version"))
  assert(contains(source, "scripts/release_contract.json"))
  assert(contains(source, "--contract-ref"))
  assert(contains(source, "run_release_contract_check("))
  assert(contains(source, "println: fn(line) { return harness.stdio.println(line) }"))
  assert(contains(source, "publication is not yet proven"))
  assert(contains(source, "contract_text != base_contract_text"))
  assert(contains(source, "release_candidate_tree_decision"))
  assert(contains(source, "candidate_tree_release_note_fold"))
  // The candidate-tree gate is range-scoped, so the check must gather the
  // range evidence too. Without it every surviving fragment counts as owned.
  assert(contains(source, "candidate_range_evidence"))
  assert(contains(source, "candidate_tree_range_scope"))
  // It must read the target repo's REAL state, not a fixture.
  assert(contains(source, ":Cargo.toml"))
  assert(contains(source, ":CHANGELOG.md"))
  // It must never mutate the target repo or dispatch anything.
  assert_eq(contains(source, "gh workflow run"), false)
  assert_eq(contains(source, "git push"), false)
}

pipeline test_candidate_tree_contract_ignores_ordinary_development_tree(task: any) {
  const decision = release_candidate_tree_decision(
    "1.2.3-dev",
    "1.2.3-dev",
    clean_fold(),
    clean_scope(),
  )
  assert_eq([decision.applicable, decision.proceed], [false, true])
}

pipeline test_candidate_tree_contract_ignores_unrelated_candidate_version(task: any) {
  const decision = release_candidate_tree_decision(
    "1.2.3-dev",
    "1.3.0",
    clean_fold(),
    clean_scope(),
  )
  assert_eq([decision.applicable, decision.proceed], [false, true])
}

pipeline test_candidate_tree_contract_still_rejects_an_unfoldable_tree(task: any) {
  const decision = release_candidate_tree_decision(
    "1.2.3-dev",
    "1.2.3",
    {...clean_fold(), success: false, message: "missing CHANGELOG.md"},
    clean_scope(),
  )
  assert_eq([decision.applicable, decision.proceed], [true, false])
  assert(contains(decision.reason, "cannot be folded"))
}

pipeline test_candidate_tree_contract_still_rejects_an_invalid_release_section(task: any) {
  const decision = release_candidate_tree_decision(
    "1.2.3-dev",
    "1.2.3",
    {...clean_fold(), valid: false, findings: ["`## v1.2.3` section has no categorized bullets"]},
    clean_scope(),
  )
  assert_eq([decision.applicable, decision.proceed], [true, false])
  assert(contains(decision.reason, "invalid v1.2.3 section"))
  assert(contains(decision.reason, "no categorized bullets"))
}

/**
 * `changed` alone no longer rejects, but the fold state it used to protect
 * still does: unreleased notes the candidate left outside its release section.
 */
pipeline test_candidate_tree_contract_rejects_unfolded_notes_without_owned_fragments(task: any) {
  const decision = release_candidate_tree_decision(
    "1.2.3-dev",
    "1.2.3",
    {...clean_fold(), changed: true},
    {
      owned: [],
      deferred: ["/repo/changelog.d/later.fixed.md"],
      scoped: true,
      detail: "",
      scoped_changed: true,
    },
  )
  assert_eq([decision.applicable, decision.proceed], [true, false])
  assert(contains(decision.reason, "unreleased notes this candidate did not fold"))
}

/** An unproven range must not let its rejection imply a range it does not have. */
pipeline test_unscoped_rejection_says_it_could_not_scope(task: any) {
  const decision = release_candidate_tree_decision(
    "1.2.3-dev",
    "1.2.3",
    {...clean_fold(), changed: true, fragment_paths: ["/repo/changelog.d/later.fixed.md"]},
    {
      owned: ["/repo/changelog.d/later.fixed.md"],
      deferred: [],
      scoped: false,
      detail: "no immutable release attempt for v1.2.3 is present in this clone",
      scoped_changed: true,
    },
  )
  assert_eq([decision.applicable, decision.proceed], [true, false])
  assert(contains(decision.reason, "could not be identified"))
  assert(contains(decision.reason, "no fragment was deferred"))
  assert_eq(contains(decision.reason, "own range"), false)
}

pipeline test_partition_candidate_fragments_splits_on_the_candidates_own_commit(task: any) {
  const partition = partition_candidate_fragments(
    [
      "/tmp/repo/changelog.d/later-one.fixed.md",
      "/tmp/repo/changelog.d/own.fixed.md",
      "/tmp/repo/changelog.d/later-two.fixed.md",
    ],
    ["changelog.d/own.fixed.md", "changelog.d/already-folded.added.md"],
  )
  assert_eq(partition.owned, ["/tmp/repo/changelog.d/own.fixed.md"])
  assert_eq(
    partition.deferred,
    ["/tmp/repo/changelog.d/later-one.fixed.md", "/tmp/repo/changelog.d/later-two.fixed.md"],
  )
}

pipeline test_partition_candidate_fragments_defers_everything_for_an_empty_candidate(task: any) {
  const partition = partition_candidate_fragments(["/tmp/repo/changelog.d/later.fixed.md"], [])
  assert_eq(partition.owned, [])
  assert_eq(partition.deferred, ["/tmp/repo/changelog.d/later.fixed.md"])
}

pipeline test_partition_candidate_fragments_owns_nothing_when_no_fragment_survives(task: any) {
  const partition = partition_candidate_fragments([], ["changelog.d/own.fixed.md"])
  assert_eq([partition.owned, partition.deferred], [[], []])
}

/**
 * The regression this contract exists to prevent. A queue rebuilds the
 * candidate as a merge on one trigger and as a squash on another. Commit
 * identity survives the first and not the second, so the same candidate and
 * the same late fragments must still produce the same decision.
 */
@test
pipeline test_candidate_range_resolution_is_trigger_independent(harness: Harness, task: any) {
  const fixture = init_release_fixture(harness)
  const repo = fixture.repo
  prepare_candidate({fs: harness.fs, process: harness.process}, repo, "release", [])
  land_later_fragments(
    {fs: harness.fs, process: harness.process},
    repo,
    ["later-one.fixed.md", "later-two.fixed.md"],
  )
  checkout_merge_tree({fs: harness.fs, process: harness.process}, repo, "queue-merge", "release")
  assert_eq(head_parent_count(harness.process, repo), 2)
  const merged = tree_contract({fs: harness.fs, process: harness.process}, repo)
  checkout_squash_tree({fs: harness.fs, process: harness.process}, repo, "queue-squash", "release")
  assert_eq(head_parent_count(harness.process, repo), 1)
  const squashed = tree_contract({fs: harness.fs, process: harness.process}, repo)
  // The two shapes are genuinely different commits over the same content.
  assert_eq(merged.fold.text == squashed.fold.text, true)
  // Same candidate, same resolution, same decision.
  assert_eq(merged.evidence.commit, squashed.evidence.commit)
  assert_eq([merged.evidence.resolved, squashed.evidence.resolved], [true, true])
  assert_eq(merged.decision, squashed.decision)
  assert_eq([merged.decision.applicable, merged.decision.proceed], [true, true])
  assert(contains(merged.decision.reason, "2 fragment(s) arrived after this candidate's base"))
  harness.fs.delete(fixture.root)
}

@test
pipeline test_squash_queue_tree_defers_fragments_that_landed_after_the_candidate_base(
  harness: Harness,
  task: any,
) {
  const fixture = init_release_fixture(harness)
  const repo = fixture.repo
  const candidate = prepare_candidate(
    {fs: harness.fs, process: harness.process},
    repo,
    "release",
    [],
  )
  land_later_fragments(
    {fs: harness.fs, process: harness.process},
    repo,
    ["later-one.fixed.md", "later-two.fixed.md"],
  )
  checkout_squash_tree({fs: harness.fs, process: harness.process}, repo, "queue", "release")
  const observed = tree_contract({fs: harness.fs, process: harness.process}, repo)
  // The candidate is resolved by content, not by walking to a parent that a
  // squash does not have.
  assert_eq(head_parent_count(harness.process, repo), 1)
  assert_eq([observed.evidence.resolved, observed.evidence.commit], [true, candidate])
  assert_eq(observed.evidence.fragment_paths, [])
  assert_eq(len(observed.fold.fragment_paths), 2)
  assert_eq(observed.fold.changed, true)
  assert_eq([observed.scope.owned, observed.scope.scoped], [[], true])
  assert_eq(len(observed.scope.deferred), 2)
  assert_eq([observed.decision.applicable, observed.decision.proceed], [true, true])
  assert(contains(observed.decision.reason, "2 fragment(s) arrived after this candidate's base"))
  assert(contains(observed.decision.reason, "later-one.fixed.md"))
  assert(contains(observed.decision.reason, "later-two.fixed.md"))
  harness.fs.delete(fixture.root)
}

@test
pipeline test_candidate_tree_rejects_a_fragment_the_candidate_itself_left_unfolded(
  harness: Harness,
  task: any,
) {
  const fixture = init_release_fixture(harness)
  const repo = fixture.repo
  prepare_candidate({fs: harness.fs, process: harness.process}, repo, "release", ["own.fixed.md"])
  land_later_fragments({fs: harness.fs, process: harness.process}, repo, ["later-one.fixed.md"])
  checkout_squash_tree({fs: harness.fs, process: harness.process}, repo, "queue", "release")
  const observed = tree_contract({fs: harness.fs, process: harness.process}, repo)
  // Prove the rejection is the range-scoped fragment gate and not one of the
  // gates ahead of it: the fold itself succeeds and validates.
  assert_eq([observed.fold.success, observed.fold.valid], [true, true])
  assert_eq(observed.evidence.fragment_paths, ["changelog.d/own.fixed.md"])
  assert_eq(len(observed.scope.owned), 1)
  assert_eq(len(observed.scope.deferred), 1)
  assert_eq(observed.scope.scoped, true)
  assert_eq([observed.decision.applicable, observed.decision.proceed], [true, false])
  assert(contains(observed.decision.reason, "1 fragment(s) from this candidate's own range"))
  assert(contains(observed.decision.reason, "own.fixed.md"))
  assert_eq(contains(observed.decision.reason, "later-one.fixed.md"), false)
  harness.fs.delete(fixture.root)
}

/**
 * Deferring fragments must not smuggle a half-folded candidate past the gate.
 * `fold.changed` is true here for both of its reasons at once, so only the
 * deferred-withheld refold can tell them apart.
 */
@test
pipeline test_queue_tree_rejects_unreleased_notes_the_candidate_did_not_fold(
  harness: Harness,
  task: any,
) {
  const fixture = init_release_fixture(harness)
  const repo = fixture.repo
  fixture_shell(harness.process, "git -C '" + repo + "' switch -qc release main")
  harness.fs.write_text(path_join(repo, "Cargo.toml"), "[workspace.package]\nversion = \"1.2.3\"\n")
  // A candidate that folded its fragment but left an `## Unreleased` body
  // behind, which is the state `fold.changed` alone used to catch.
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## Unreleased\n\n### Fixed\n\n- Straggler fix.\n\n"
      + "## v1.2.3\n\n### Fixed\n\n- Pin fix.\n\n## v1.2.2\n\n- Prior.\n",
  )
  harness.fs.delete(path_join(repo, "changelog.d/pin.fixed.md"))
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' add -A && git -C '" + repo + "' commit -qm candidate",
  )
  const oid = git_at(harness.process, repo, "rev-parse HEAD")
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' push -q origin HEAD:refs/heads/release-attempt/v1.2.3/" + oid,
  )
  land_later_fragments({fs: harness.fs, process: harness.process}, repo, ["later-one.fixed.md"])
  checkout_squash_tree({fs: harness.fs, process: harness.process}, repo, "queue", "release")
  const observed = tree_contract({fs: harness.fs, process: harness.process}, repo)
  assert_eq([observed.fold.success, observed.fold.valid], [true, true])
  assert_eq([observed.fold.changed, observed.scope.scoped], [true, true])
  assert_eq(observed.scope.owned, [])
  assert_eq(len(observed.scope.deferred), 1)
  assert_eq(observed.scope.scoped_changed, true)
  assert_eq([observed.decision.applicable, observed.decision.proceed], [true, false])
  assert(contains(observed.decision.reason, "unreleased notes this candidate did not fold"))
  harness.fs.delete(fixture.root)
}

@test
pipeline test_candidate_tree_accepts_a_fully_folded_candidate_with_no_fragments(
  harness: Harness,
  task: any,
) {
  const fixture = init_release_fixture(harness)
  const repo = fixture.repo
  prepare_candidate({fs: harness.fs, process: harness.process}, repo, "release", [])
  const observed = tree_contract({fs: harness.fs, process: harness.process}, repo)
  assert_eq(observed.fold.fragment_paths, [])
  assert_eq(observed.fold.changed, false)
  assert_eq([observed.scope.owned, observed.scope.deferred], [[], []])
  assert_eq([observed.decision.applicable, observed.decision.proceed], [true, true])
  assert_eq(observed.decision.reason, "exact release tree is already fully folded for v1.2.3")
  harness.fs.delete(fixture.root)
}

/**
 * Two standing attempts for one version is a real state, not a hypothetical:
 * a regenerated candidate supersedes an earlier one and both refs remain until
 * the lane is swept. The tree's own release notes must pick out the attempt it
 * was built from, and only that one.
 */
@test
pipeline test_competing_attempts_resolve_to_the_one_this_tree_was_built_from(
  harness: Harness,
  task: any,
) {
  const fixture = init_release_fixture(harness)
  const repo = fixture.repo
  const superseded = prepare_candidate(
    {fs: harness.fs, process: harness.process},
    repo,
    "release-first",
    [],
  )
  land_later_fragments({fs: harness.fs, process: harness.process}, repo, ["later-one.fixed.md"])
  // The regenerated candidate folds the later fragment too, so its release
  // notes differ from the superseded attempt's.
  const regenerated = prepare_candidate(
    {fs: harness.fs, process: harness.process},
    repo,
    "release-second",
    [],
  )
  land_later_fragments({fs: harness.fs, process: harness.process}, repo, ["later-two.fixed.md"])
  assert_eq(superseded == regenerated, false)
  checkout_squash_tree(
    {fs: harness.fs, process: harness.process},
    repo,
    "queue-first",
    "release-first",
  )
  const first = tree_contract({fs: harness.fs, process: harness.process}, repo)
  assert_eq([first.evidence.resolved, first.evidence.commit], [true, superseded])
  checkout_squash_tree(
    {fs: harness.fs, process: harness.process},
    repo,
    "queue-second",
    "release-second",
  )
  const second = tree_contract({fs: harness.fs, process: harness.process}, repo)
  assert_eq([second.evidence.resolved, second.evidence.commit], [true, regenerated])
  harness.fs.delete(fixture.root)
}

/**
 * A pull-request checkout retains the exact candidate as its second parent.
 * That structural identity must win when two attempts happen to have the same
 * release-notes blob but record different fragment ranges.
 */
@test
pipeline test_exact_candidate_parent_disambiguates_identical_release_notes(
  harness: Harness,
  task: any,
) {
  const fixture = init_release_fixture(harness)
  const repo = fixture.repo
  const selected = prepare_candidate(
    {fs: harness.fs, process: harness.process},
    repo,
    "release-selected",
    [],
  )
  const competing = prepare_candidate(
    {fs: harness.fs, process: harness.process},
    repo,
    "release-competing",
    ["competing.fixed.md"],
  )
  assert_eq(selected == competing, false)
  assert_eq(
    git_at(harness.process, repo, "rev-parse ${selected}:CHANGELOG.md"),
    git_at(harness.process, repo, "rev-parse ${competing}:CHANGELOG.md"),
  )
  land_later_fragments({fs: harness.fs, process: harness.process}, repo, ["later.fixed.md"])
  checkout_merge_tree(
    {fs: harness.fs, process: harness.process},
    repo,
    "queue-merge",
    "release-selected",
  )
  const observed = tree_contract({fs: harness.fs, process: harness.process}, repo)
  assert_eq([observed.evidence.resolved, observed.evidence.commit], [true, selected])
  assert_eq(observed.evidence.fragment_paths, [])
  assert_eq([observed.scope.owned, len(observed.scope.deferred)], [[], 1])
  assert_eq([observed.decision.applicable, observed.decision.proceed], [true, true])
  checkout_squash_tree(
    {fs: harness.fs, process: harness.process},
    repo,
    "queue-squash",
    "release-selected",
  )
  const unlinked = tree_contract({fs: harness.fs, process: harness.process}, repo)
  assert_eq(unlinked.evidence.resolved, false)
  assert(contains(unlinked.evidence.detail, "2 immutable attempts"))
  assert_eq([unlinked.scope.scoped, unlinked.decision.proceed], [false, false])
  harness.fs.delete(fixture.root)
}

/**
 * Scoping is only sound when exactly one attempt explains this tree. A tree no
 * published attempt accounts for keeps the strict contract and defers nothing.
 */
@test
pipeline test_unexplained_tree_keeps_the_strict_contract(harness: Harness, task: any) {
  const fixture = init_release_fixture(harness)
  const repo = fixture.repo
  prepare_candidate({fs: harness.fs, process: harness.process}, repo, "release", [])
  land_later_fragments({fs: harness.fs, process: harness.process}, repo, ["later-one.fixed.md"])
  checkout_squash_tree({fs: harness.fs, process: harness.process}, repo, "queue", "release")
  // Drop the published attempt, leaving a tree nothing accounts for.
  fixture_shell(
    harness.process,
    "git -C '" + repo + "' for-each-ref --format='%(refname)'"
      + " 'refs/remotes/*/release-attempt/v1.2.3/*' | xargs -n1 git -C '"
      + repo
      + "' update-ref -d",
  )
  const observed = tree_contract({fs: harness.fs, process: harness.process}, repo)
  assert_eq(observed.evidence.resolved, false)
  assert(contains(observed.evidence.detail, "no immutable release attempt for v1.2.3"))
  assert_eq(observed.scope.scoped, false)
  assert_eq(len(observed.scope.owned), 1)
  assert_eq(observed.scope.deferred, [])
  assert_eq([observed.decision.applicable, observed.decision.proceed], [true, false])
  assert(contains(observed.decision.reason, "could not be identified"))
  assert(contains(observed.decision.reason, "no fragment was deferred"))
  assert_eq(contains(observed.decision.reason, "own range"), false)
  harness.fs.delete(fixture.root)
}
