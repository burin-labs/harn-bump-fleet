import {
  bot_pr_rewrite_command_plan,
  bot_pr_rewrite_plan,
  commit_is_signed,
  gh_open_prs_query_args,
  gh_pr_query_args,
  is_bot_login,
  parse_pr_selector,
  parse_pr_selector_list,
  unsigned_commit_oids,
  validate_checkout_slug,
} from "../lib/bot_pr_rewrite"
import { fail, ok } from "../lib/shell_util"

fn sample_pr(fields = nil) {
  return {
    number: 42,
    title: "build(deps): bump example",
    author: {login: "dependabot"},
    headRefName: "dependabot/cargo/example-1.2.3",
    headRefOid: "abcdef1234567890abcdef1234567890abcdef12",
    headRepositoryOwner: {login: "burin-labs"},
    headRepository: {nameWithOwner: "burin-labs/harn"},
    baseRefName: "main",
    isInMergeQueue: false,
    mergeQueueEntry: nil,
    autoMergeRequest: nil,
    commits: {
      nodes: [
        {
          commit: {
            oid: "abcdef1234567890abcdef1234567890abcdef12",
            signature: nil,
            authors: {nodes: [{user: {login: "dependabot"}}]},
          },
        },
      ],
    },
  }
    + (fields ?? {})
}

pipeline test_bot_pr_rewrite_helpers(task) {
  assert_eq(parse_pr_selector("burin-labs/harn#3711"), {slug: "burin-labs/harn", number: 3711})
  assert_eq(parse_pr_selector("3711", "burin-labs/harn"), {slug: "burin-labs/harn", number: 3711})
  assert_eq(parse_pr_selector("3711"), nil)
  assert_eq(
    parse_pr_selector_list("burin-labs/harn#1, 2", "burin-labs/harn"),
    [{slug: "burin-labs/harn", number: 1}, {slug: "burin-labs/harn", number: 2}],
  )
  assert_eq(is_bot_login("dependabot"), true)
  assert_eq(is_bot_login("dependabot[bot]"), true)
  assert_eq(is_bot_login("renovate[bot]"), true)
  assert_eq(is_bot_login("kennethsinder"), false)
  assert_eq(commit_is_signed({signature: {isValid: true, state: "VALID"}}), true)
  assert_eq(commit_is_signed({signature: {isValid: false, state: "BAD_CERT"}}), false)
  assert_eq(unsigned_commit_oids(sample_pr()), ["abcdef1234567890abcdef1234567890abcdef12"])
  let gql = gh_pr_query_args("burin-labs/harn", 3711)
  assert_eq(gql[0:3], ["api", "graphql", "-f"])
  assert(contains(join(gql, " "), "signature{ isValid state signer{login} }"))
  let open_args = gh_open_prs_query_args("burin-labs/harn", 25)
  assert(contains(join(open_args, " "), "first=25"))
}

pipeline test_bot_pr_rewrite_guardrails(task) {
  let rewrite = bot_pr_rewrite_plan("burin-labs/harn", sample_pr())
  assert_eq(rewrite.status, "rewrite")
  assert_eq(rewrite.eligible, true)
  assert(contains(rewrite.detail, "unsigned"))
  let signed = sample_pr(
    {
      commits: {
        nodes: [
          {
            commit: {
              oid: "abcdef1234567890abcdef1234567890abcdef12",
              signature: {isValid: true, state: "VALID", signer: {login: "kennethsinder"}},
              authors: {nodes: [{user: {login: "kennethsinder"}}]},
            },
          },
        ],
      },
    },
  )
  let signed_plan = bot_pr_rewrite_plan("burin-labs/harn", signed)
  assert_eq(signed_plan.status, "already_signed")
  assert_eq(signed_plan.needs_rewrite, false)
  let fork = bot_pr_rewrite_plan(
    "burin-labs/harn",
    sample_pr({headRepository: {nameWithOwner: "other/harn"}, headRepositoryOwner: {login: "other"}}),
  )
  assert_eq(fork.status, "refused")
  assert(contains(fork.detail, "in-repository"))
  let queued = bot_pr_rewrite_plan("burin-labs/harn", sample_pr({isInMergeQueue: true}))
  assert_eq(queued.status, "refused")
  assert(contains(queued.detail, "merge queue"))
  let human = bot_pr_rewrite_plan("burin-labs/harn", sample_pr({author: {login: "kennethsinder"}}))
  assert_eq(human.status, "refused")
  assert(contains(human.detail, "not a recognized bot"))
  let human_commit = bot_pr_rewrite_plan(
    "burin-labs/harn",
    sample_pr(
      {
        commits: {
          nodes: [
            {
              commit: {
                oid: "abcdef1234567890abcdef1234567890abcdef12",
                signature: nil,
                authors: {nodes: [{user: {login: "kennethsinder"}}]},
              },
            },
          ],
        },
      },
    ),
  )
  assert_eq(human_commit.status, "refused")
  assert(contains(human_commit.detail, "non-bot commit authors"))
  let allowed_human = bot_pr_rewrite_plan(
    "burin-labs/harn",
    sample_pr({author: {login: "kennethsinder"}}),
    {allow_human_authors: true},
  )
  assert_eq(allowed_human.status, "rewrite")
}

pipeline test_bot_pr_rewrite_commands(task) {
  let pr = sample_pr()
  let commands = bot_pr_rewrite_command_plan("/repo/harn", "/tmp/rewrite", pr)
  assert_eq(
    commands[0].argv,
    [
      "git",
      "-C",
      "/repo/harn",
      "fetch",
      "origin",
      "main",
      "refs/heads/dependabot/cargo/example-1.2.3:refs/remotes/origin/dependabot/cargo/example-1.2.3",
      "--quiet",
    ],
  )
  assert_eq(commands[2].argv, ["git", "-C", "/tmp/rewrite", "config", "core.fsmonitor", "false"])
  assert_eq(
    commands[4].argv,
    ["git", "-C", "/tmp/rewrite", "read-tree", "--reset", "-u", "origin/dependabot/cargo/example-1.2.3"],
  )
  assert_eq(
    commands[7].argv,
    [
      "git",
      "-C",
      "/tmp/rewrite",
      "push",
      "origin",
      "HEAD:refs/heads/dependabot/cargo/example-1.2.3",
      "--force-with-lease=refs/heads/dependabot/cargo/example-1.2.3:abcdef1234567890abcdef1234567890abcdef12",
    ],
  )
}

pipeline test_checkout_slug_validation(task) {
  let ok_result = validate_checkout_slug(
    "/repo/harn",
    "burin-labs/harn",
    { _argv -> ok("git@github.com:burin-labs/harn.git\n") },
  )
  assert_eq(ok_result.ok, true)
  let mismatch = validate_checkout_slug(
    "/repo/harn",
    "burin-labs/harn",
    { _argv -> ok("git@github.com:other/harn.git\n") },
  )
  assert_eq(mismatch.ok, false)
  assert(contains(mismatch.detail, "expected burin-labs/harn"))
  let unreadable = validate_checkout_slug("/repo/harn", "burin-labs/harn", { _argv -> fail(1, "no remote") })
  assert_eq(unreadable.ok, false)
}
