import { release_main_tag_decision, run_release_main_tag } from "../lib/release_main_tag"
import { release_publication } from "../lib/release_publication"
import { release_watch_receipt, release_watch_receipt_read } from "../lib/release_watch_state"

const CANDIDATE = "1111111111111111111111111111111111111111"

const MERGED_MAIN = "2222222222222222222222222222222222222222"

const CERTIFIED_TREE = "4444444444444444444444444444444444444444"

/** Main did not move: the merged commit carries the tree the release certified. */
fn agreeing_trees(merge_sha: string) {
  return {
    candidate_commit: CANDIDATE,
    candidate_tree: CERTIFIED_TREE,
    merged_commit: merge_sha,
    merged_tree: CERTIFIED_TREE,
    drifted_paths: [],
  }
}

/** Main did not move while the release pull request was open. */
fn unmoved_base(certified_base: string) {
  return {certified_base: certified_base, current_base: certified_base, drifted_paths: []}
}

/**
 * Every case below the open-PR base probe predates it and asserts something
 * else. Default them to a base that never moved so each still fails for its own
 * reason; the base-drift cases pass their own probe explicitly.
 */
fn decide(
  watch: any,
  pull: any,
  remote_tag_target: string,
  trees: any,
  base: any = unmoved_base,
) {
  return release_main_tag_decision(watch, pull, remote_tag_target, trees, base)
}

fn receipt() {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "0000000000000000000000000000000000000000",
      publication: release_publication("1.2.3", CANDIDATE),
      pr_url: "https://github.com/burin-labs/harn/pull/42",
      created_at: "2026-08-24T00:00:00Z",
    },
  )
}

fn pull_request(overrides: dict = {}) {
  return {
    number: 42,
    merged: false,
    merge_commit_oid: nil,
    github_state: "open",
    auto_merge_armed: true,
    in_merge_queue: false,
    base: {ref: "main"},
    head: {ref: "release-attempt/v1.2.3/${CANDIDATE}", sha: CANDIDATE},
    ...overrides,
  }
}

pipeline test_release_tag_waits_until_exact_pr_merges(task: any) {
  const decision = decide(receipt(), pull_request(), "", agreeing_trees)
  assert_eq([decision.action, decision.merge_sha], ["wait", ""])
}

pipeline test_release_tag_rearms_an_unowned_open_pr(task: any) {
  const decision = decide(
    receipt(),
    pull_request({auto_merge_armed: false}),
    "",
    agreeing_trees,
  )
  assert_eq(decision.action, "rearm")
}

pipeline test_release_tag_mints_only_at_merged_main_commit(task: any) {
  const decision = decide(
    receipt(),
    pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN}),
    "",
    agreeing_trees,
  )
  assert_eq([decision.action, decision.merge_sha], ["tag", MERGED_MAIN])
}

pipeline test_release_tag_reuses_only_the_exact_merged_main_target(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const reused = decide(receipt(), merged, MERGED_MAIN, agreeing_trees)
  const moved = decide(
    receipt(),
    merged,
    "3333333333333333333333333333333333333333",
    agreeing_trees,
  )
  assert_eq(reused.action, "reuse")
  assert_eq(moved.action, "abort")
}

pipeline test_release_tag_rejects_publication_before_merge(task: any) {
  const decision = decide(receipt(), pull_request(), CANDIDATE, agreeing_trees)
  assert_eq(decision.action, "abort")
}

pipeline test_release_tag_rejects_wrong_pr_identity(task: any) {
  const wrong_head = decide(
    receipt(),
    pull_request({head: {ref: "release-attempt/v1.2.3/${CANDIDATE}", sha: MERGED_MAIN}}),
    "",
    agreeing_trees,
  )
  const wrong_base = decide(
    receipt(),
    pull_request({base: {ref: "other"}}),
    "",
    agreeing_trees,
  )
  assert_eq([wrong_head.action, wrong_base.action], ["abort", "abort"])
}

pipeline test_release_tag_rejects_missing_or_malformed_merge_identity(task: any) {
  const missing = decide(
    receipt(),
    pull_request({merged: true, github_state: "merged"}),
    "",
    agreeing_trees,
  )
  const malformed = decide(receipt(), nil, "not-a-sha", agreeing_trees)
  assert_eq([missing.action, malformed.action], ["abort", "abort"])
}

pipeline test_release_main_tag_path_rearms_then_binds_merged_main(harness: Harness, task: any) {
  const original = receipt()
  const path = path_join(harness.fs.workspace_temp_dir(), "release-main-tag.json")
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    original,
    path,
    {max_polls: 3, interval_ms: 0},
    {
      pull_request: fn(poll) { return if poll == 0 {
        pull_request({auto_merge_armed: false})
      } else {
        merged
      } },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      base_drift: fn(base) { return unmoved_base(base) },
      rearm: fn(_pr) { return true },
      disarm: fn(_pr) { return true },
      merged_main_ancestor: fn(sha) { return sha == MERGED_MAIN },
      push_tag: fn(sha) { return [{name: "push-release-tag", success: sha == MERGED_MAIN}] },
      now: fn(_poll) { return "2026-08-24T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  const persisted = release_watch_receipt_read(harness.fs, path)
  assert_eq([result.status, result.polls, result.receipt.release_commit_oid], [0, 2, MERGED_MAIN])
  assert_eq(persisted?.release_commit_oid, MERGED_MAIN)
  assert(result.steps.any({ step -> step.name == "push-release-tag" && step.success }))
}

pipeline test_release_main_tag_path_rejects_non_main_merge(harness: Harness, task: any) {
  const original = receipt()
  const path = path_join(harness.fs.workspace_temp_dir(), "release-non-main-tag.json")
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    original,
    path,
    {max_polls: 1, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request(
        {merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN},
      ) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      base_drift: fn(base) { return unmoved_base(base) },
      rearm: fn(_pr) { return true },
      disarm: fn(_pr) { return true },
      merged_main_ancestor: fn(_sha) { return false },
      push_tag: fn(_sha) { return [{name: "unexpected", success: true}] },
      now: fn(_poll) { return "2026-08-24T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert(contains(result.reason, "not reachable from origin/main"))
  assert_eq(harness.fs.exists(path), false)
}

// The real v0.10.126 identities, read from the GitHub API on 2026-09-02. Kept
// literal so this falsifier can be audited against the incident rather than
// against a shape someone assembled from memory.
const V126_CANDIDATE = "915be8e34045eca93df430373cc4db8c268db442"

const V126_CANDIDATE_TREE = "2eb4fa3c8e4e7397b31eec7e4e5a0b85a8d5a98b"

const V126_TAG_COMMIT = "47f05a2fdee2c7a0bcf460411505156f2fc94a1f"

const V126_TAG_TREE = "708167f925671ec98ab81ecefb445b4e49712dca"

fn v126_receipt() {
  return release_watch_receipt(
    {
      tag: "v0.10.126",
      slug: "burin-labs/harn",
      pin_sha: "e125cffbe3cad0cf8fc2fdec284876019f94390e",
      publication: release_publication("0.10.126", V126_CANDIDATE),
      pr_url: "https://github.com/burin-labs/harn/pull/7822",
      created_at: "2026-09-02T05:00:00Z",
    },
  )
}

fn v126_merged_pull_request() {
  return {
    number: 7822,
    merged: true,
    merge_commit_oid: V126_TAG_COMMIT,
    github_state: "merged",
    auto_merge_armed: false,
    in_merge_queue: false,
    base: {ref: "main"},
    head: {ref: "release-attempt/v0.10.126/${V126_CANDIDATE}", sha: V126_CANDIDATE},
  }
}

/**
 * Replay the real v0.10.126 cut. The candidate froze at e125cffb, harn#7807 and
 * harn#7809 landed on main before pull request 7822 merged, and the tag was
 * minted on merge commit 47f05a2 whose tree differs from the candidate's across
 * 68 files. Certification never saw those two commits, and publication reads the
 * tag tree, so they shipped inside the version.
 */
pipeline test_release_tag_refuses_a_main_that_moved_since_certification(task: any) {
  const decision = decide(
    v126_receipt(),
    v126_merged_pull_request(),
    "",
    fn(merge_sha) { return {
      candidate_commit: V126_CANDIDATE,
      candidate_tree: V126_CANDIDATE_TREE,
      merged_commit: merge_sha,
      merged_tree: V126_TAG_TREE,
      drifted_paths: [".github/workflows/pr-gates.yml", "AGENTS.md"],
    } },
  )
  assert_eq(decision.action, "certification_drift")
  assert_eq(decision.merge_sha, V126_TAG_COMMIT)
  assert_eq(decision.drifted_paths, [".github/workflows/pr-gates.yml", "AGENTS.md"])
  assert(
    contains(decision.reason, "main moved since certification; re-dispatch at ${V126_TAG_COMMIT}"),
  )
  assert(contains(decision.reason, V126_CANDIDATE_TREE))
  assert(contains(decision.reason, V126_TAG_TREE))
  assert(contains(decision.reason, ".github/workflows/pr-gates.yml"))
}

/**
 * The same real cut with main held still: the merge commit would have carried
 * the certified tree and the tag is minted. This is what keeps the test above
 * from passing on a gate that refuses every release.
 */
pipeline test_release_tag_mints_the_same_cut_when_main_was_frozen(task: any) {
  const decision = decide(
    v126_receipt(),
    v126_merged_pull_request(),
    "",
    fn(merge_sha) { return {
      candidate_commit: V126_CANDIDATE,
      candidate_tree: V126_CANDIDATE_TREE,
      merged_commit: merge_sha,
      merged_tree: V126_CANDIDATE_TREE,
      drifted_paths: [],
    } },
  )
  assert_eq([decision.action, decision.merge_sha], ["tag", V126_TAG_COMMIT])
}

/**
 * The negative control for the line above: a cut where nothing landed between
 * certification and the merge still mints its tag. Without this the gate could
 * refuse every release and its falsifier would still pass.
 */
pipeline test_release_tag_mints_when_main_did_not_move(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const decision = decide(receipt(), merged, "", agreeing_trees)
  assert_eq([decision.action, decision.merge_sha], ["tag", MERGED_MAIN])
  assert_eq(decision.drifted_paths, [])
}

/**
 * An unresolved tree is not agreement. Two empty strings compare equal, so a
 * probe that answered nothing would otherwise read as a clean release: the
 * exact shape where absence reads as success.
 */
pipeline test_release_tag_refuses_when_the_certified_tree_cannot_be_proved(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const unprovable = decide(receipt(), merged, "", fn(_sha) { return nil })
  assert_eq(unprovable.action, "abort")
  assert(contains(unprovable.reason, "could not prove"))
  const empty = decide(
    receipt(),
    merged,
    "",
    fn(merge_sha) { return {
      candidate_commit: CANDIDATE,
      candidate_tree: "",
      merged_commit: merge_sha,
      merged_tree: "",
      drifted_paths: [],
    } },
  )
  assert_eq(empty.action, "certification_drift")
}

/** A drifted tree refuses through the driver too, not only in the predicate. */
pipeline test_release_main_tag_path_refuses_a_drifted_merge(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-drifted-tag.json")
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 1, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request(
        {merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN},
      ) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(merge_sha) { return {
        candidate_commit: CANDIDATE,
        candidate_tree: CERTIFIED_TREE,
        merged_commit: merge_sha,
        merged_tree: "5555555555555555555555555555555555555555",
        drifted_paths: ["Cargo.lock"],
      } },
      base_drift: fn(base) { return unmoved_base(base) },
      rearm: fn(_pr) { return true },
      disarm: fn(_pr) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-08-24T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert(contains(result.reason, "main moved since certification"))
  assert(contains(result.reason, "Cargo.lock"))
  // The tag must not have been pushed and the receipt must not be bound.
  assert_eq(result.steps, [])
  assert_eq(harness.fs.exists(path), false)
}

// The real v0.10.128 identities, read from the GitHub API on 2026-09-03. Kept
// literal so this falsifier can be audited against the incident rather than
// against a shape someone assembled from memory. The cut pinned main at
// 4dc66d34, main advanced to 5fac945b while release pull request 7897 was open
// and armed, and the tree refusal only fired after 7897 had merged at 7c953ee2
// -- by which point the fold was on main with no tag and no executable escape.
const V128_BASE_PIN = "4dc66d34bd60a6222db79cc5db68c9dfa0b2260c"

const V128_MOVED_BASE = "5fac945b43fd091f9f80c55cc667630fcbc7910a"

const V128_CANDIDATE = "9890aace3409d3ddd7b77ef1ddda46ae362f4b91"

const V128_DRIFTED = [
  "changelog.d/7865-judge-declined-unassessed.fixed.md",
  "crates/harn-session-store/src/control.rs",
  "crates/harn-stdlib/src/stdlib/agent/judge.harn",
  "scripts/loop_equivalence_probe.harn",
  "scripts/tests/loop_equivalence_probe_test.harn",
  "tests/agent/completion_requirement_contract_test.harn",
]

fn v128_receipt() {
  return release_watch_receipt(
    {
      tag: "v0.10.128",
      slug: "burin-labs/harn",
      pin_sha: V128_BASE_PIN,
      publication: release_publication("0.10.128", V128_CANDIDATE),
      pr_url: "https://github.com/burin-labs/harn/pull/7897",
      created_at: "2026-09-02T23:48:02Z",
    },
  )
}

fn v128_open_pull_request(overrides: dict = {}) {
  return {
    number: 7897,
    merged: false,
    merge_commit_oid: nil,
    github_state: "open",
    auto_merge_armed: true,
    in_merge_queue: false,
    base: {ref: "main"},
    head: {ref: "release-attempt/v0.10.128/${V128_CANDIDATE}", sha: V128_CANDIDATE},
    ...overrides,
  }
}

/**
 * Replay the real v0.10.128 cut at the moment the cheap outcome was still
 * available. Main had already moved off the certified pin while pull request
 * 7897 was open, and the harness said `wait`. The refusal must happen here.
 */
pipeline test_release_tag_refuses_a_base_that_moved_while_the_pr_is_open(task: any) {
  const decision = decide(
    v128_receipt(),
    v128_open_pull_request(),
    "",
    agreeing_trees,
    fn(certified_base) { return {
      certified_base: certified_base,
      current_base: V128_MOVED_BASE,
      drifted_paths: V128_DRIFTED,
    } },
  )
  assert_eq(decision.action, "base_drift")
  assert_eq(decision.drifted_paths, V128_DRIFTED)
  assert(contains(decision.reason, "re-dispatch at ${V128_MOVED_BASE}"))
  assert(contains(decision.reason, V128_BASE_PIN))
  assert(contains(decision.reason, "crates/harn-stdlib/src/stdlib/agent/judge.harn"))
}

/**
 * The negative control. The same open pull request with main held still keeps
 * waiting for its merge, so the gate above cannot pass by refusing every cut.
 */
pipeline test_release_tag_keeps_waiting_when_the_base_did_not_move(task: any) {
  const decision = decide(v128_receipt(), v128_open_pull_request(), "", agreeing_trees)
  assert_eq(decision.action, "wait")
  assert_eq(decision.drifted_paths, [])
}

/**
 * The default branch advancing is not by itself drift. A commit that landed and
 * was reverted leaves the certified tree intact, and refusing there would refuse
 * a release that is still exactly what it certified.
 */
pipeline test_release_tag_tolerates_a_moved_base_that_changed_no_path(task: any) {
  const decision = decide(
    v128_receipt(),
    v128_open_pull_request(),
    "",
    agreeing_trees,
    fn(certified_base) { return {
      certified_base: certified_base,
      current_base: V128_MOVED_BASE,
      drifted_paths: [],
    } },
  )
  assert_eq(decision.action, "wait")
}

/**
 * An unresolved base is not an unmoved base. A probe that answered nothing must
 * refuse, or the gate passes by not running -- the same shape
 * `test_release_tag_refuses_when_the_certified_tree_cannot_be_proved` guards on
 * the post-merge side.
 */
pipeline test_release_tag_refuses_when_the_base_cannot_be_proved(task: any) {
  const unprovable = decide(
    v128_receipt(),
    v128_open_pull_request(),
    "",
    agreeing_trees,
    fn(_base) { return nil },
  )
  assert_eq(unprovable.action, "abort")
  assert(contains(unprovable.reason, "could not prove the release base"))
  const empty = decide(
    v128_receipt(),
    v128_open_pull_request(),
    "",
    agreeing_trees,
    fn(_base) { return {certified_base: "", current_base: "", drifted_paths: []} },
  )
  assert_eq(empty.action, "base_drift")
}

/**
 * A base-drift verdict that leaves auto-merge armed refuses nothing: the pull
 * request merges seconds later and the release is stranded exactly as v0.10.128
 * was. The driver must take the handoff away before it reports.
 */
pipeline test_release_main_tag_path_holds_the_pr_it_refuses(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-base-drift.json")
  let disarmed = []
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    v128_receipt(),
    path,
    {max_polls: 1, interval_ms: 0},
    {
      pull_request: fn(_poll) { return v128_open_pull_request() },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      base_drift: fn(certified_base) { return {
        certified_base: certified_base,
        current_base: V128_MOVED_BASE,
        drifted_paths: V128_DRIFTED,
      } },
      rearm: fn(_pr) { return true },
      disarm: fn(pr) {
        disarmed = disarmed + [pr.number]
        return true
      },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-09-03T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert_eq(disarmed, [7897])
  assert(contains(result.reason, "auto-merge held"))
  assert(contains(result.reason, "re-dispatch at ${V128_MOVED_BASE}"))
  assert_eq(result.steps, [])
  assert_eq(harness.fs.exists(path), false)
}

/** A hold that fails must say so, not report a refusal it did not achieve. */
pipeline test_release_main_tag_path_names_a_hold_it_could_not_take(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-base-drift-unheld.json")
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    v128_receipt(),
    path,
    {max_polls: 1, interval_ms: 0},
    {
      pull_request: fn(_poll) { return v128_open_pull_request() },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      base_drift: fn(certified_base) { return {
        certified_base: certified_base,
        current_base: V128_MOVED_BASE,
        drifted_paths: V128_DRIFTED,
      } },
      rearm: fn(_pr) { return true },
      disarm: fn(_pr) { return false },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-09-03T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert(contains(result.reason, "could NOT be held"))
}
