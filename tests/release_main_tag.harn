  assert_eq([wrong_head.action, wrong_base.action], ["abort", "abort"])
}

pipeline test_release_tag_rejects_missing_or_malformed_merge_identity(task: any) {
  const missing = release_main_tag_decision(
    receipt(),
    pull_request({merged: true, github_state: "merged"}),
    "",
    agreeing_trees,
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  const malformed = release_main_tag_decision(
    receipt(),
    nil,
    "not-a-sha",
    agreeing_trees,
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq([missing.action, malformed.action], ["abort", "abort"])
}

pipeline test_release_main_tag_path_arms_then_binds_merged_main(harness: Harness, task: any) {
  const original = receipt()
  const path = path_join(harness.fs.workspace_temp_dir(), "release-main-tag.json")
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    original,
    path,
    {max_polls: 3, interval_ms: 0},
    {
      pull_request: fn(poll) { return if poll == 0 {
        pull_request({auto_merge_armed: false})
      } else {
        merged
      } },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: stable_gate(PIN),
      merge: fn(_pr) { return true },
      main_delta: fn(sha) { return certified_delta(sha) },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(sha) { return sha == MERGED_MAIN },
      push_tag: fn(sha) { return [{name: "push-release-tag", success: sha == MERGED_MAIN}] },
      now: fn(_poll) { return "2026-08-24T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  const persisted = release_watch_receipt_read(harness.fs, path)
  assert_eq([result.status, result.polls, result.receipt.release_commit_oid], [0, 2, MERGED_MAIN])
  assert_eq(persisted?.release_commit_oid, MERGED_MAIN)
  assert(result.steps.any({ step -> step.name == "push-release-tag" && step.success }))
}

pipeline test_release_main_tag_path_rejects_non_main_merge(harness: Harness, task: any) {
  const original = receipt()
  const path = path_join(harness.fs.workspace_temp_dir(), "release-non-main-tag.json")
  // A previous run of this workspace may have left a receipt here, and these
  // claims are about what this run wrote.
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    original,
    path,
    {max_polls: 1, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request(
        {merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN},
      ) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: stable_gate(PIN),
      merge: fn(_pr) { return true },
      main_delta: fn(sha) { return certified_delta(sha) },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return false },
      push_tag: fn(_sha) { return [{name: "unexpected", success: true}] },
      now: fn(_poll) { return "2026-08-24T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert(contains(result.reason, "not reachable from origin/main"))
  assert_eq(harness.fs.exists(path), false)
}

// The real v0.10.126 identities, read from the GitHub API on 2026-09-02. Kept
// literal so this falsifier can be audited against the incident rather than
// against a shape someone assembled from memory.
const V126_CANDIDATE = "915be8e34045eca93df430373cc4db8c268db442"

const V126_CANDIDATE_TREE = "2eb4fa3c8e4e7397b31eec7e4e5a0b85a8d5a98b"

const V126_TAG_COMMIT = "47f05a2fdee2c7a0bcf460411505156f2fc94a1f"

const V126_TAG_TREE = "708167f925671ec98ab81ecefb445b4e49712dca"

fn v126_receipt() {
  return release_watch_receipt(
    {
      tag: "v0.10.126",
      slug: "burin-labs/harn",
      pin_sha: "e125cffbe3cad0cf8fc2fdec284876019f94390e",
      publication: release_publication("0.10.126", V126_CANDIDATE),
      pr_url: "https://github.com/burin-labs/harn/pull/7822",
      created_at: "2026-09-02T05:00:00Z",
    },
  )
}

fn v126_merged_pull_request() {
  return {
    number: 7822,
    merged: true,
    merge_commit_oid: V126_TAG_COMMIT,
    github_state: "merged",
    auto_merge_armed: false,
    in_merge_queue: false,
    base: {ref: "main"},
    head: {ref: "release-attempt/v0.10.126/${V126_CANDIDATE}", sha: V126_CANDIDATE},
  }
}

/**
 * Replay the real v0.10.126 cut. The candidate froze at e125cffb, harn#7807 and
 * harn#7809 landed on main before pull request 7822 merged, and the tag was
 * minted on merge commit 47f05a2 whose tree differs from the candidate's across
 * 68 files. Certification never saw those two commits, and publication reads the
 * tag tree, so they shipped inside the version.
 */
pipeline test_release_tag_refuses_a_main_that_moved_since_certification(task: any) {
  const decision = release_main_tag_decision(
    v126_receipt(),
    v126_merged_pull_request(),
    "",
    fn(merge_sha) { return {
      candidate_commit: V126_CANDIDATE,
      candidate_tree: V126_CANDIDATE_TREE,
      merged_commit: merge_sha,
      merged_base_commit: "e125cffbe3cad0cf8fc2fdec284876019f94390e",
      merged_tree: V126_TAG_TREE,
      drifted_paths: [".github/workflows/pr-gates.yml", "AGENTS.md"],
    } },
    stable_gate("e125cffbe3cad0cf8fc2fdec284876019f94390e"),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq(decision.action, "certification_drift")
  assert_eq(decision.merge_sha, V126_TAG_COMMIT)
  assert_eq(decision.drifted_paths, [".github/workflows/pr-gates.yml", "AGENTS.md"])
  assert(contains(decision.reason, "main moved between certification and the merge"))
  assert(contains(decision.reason, V126_TAG_COMMIT))
  assert(contains(decision.reason, "mode tag-stranded-main"))
  assert(contains(decision.reason, V126_CANDIDATE_TREE))
  assert(contains(decision.reason, V126_TAG_TREE))
  assert(contains(decision.reason, ".github/workflows/pr-gates.yml"))
}

/**
 * The same real cut with main held still: the merge commit would have carried
 * the certified tree and the tag is minted. This is what keeps the test above
 * from passing on a gate that refuses every release.
 */
pipeline test_release_tag_mints_the_same_cut_when_main_was_frozen(task: any) {
  const decision = release_main_tag_decision(
    v126_receipt(),
    v126_merged_pull_request(),
    "",
    fn(merge_sha) { return {
      candidate_commit: V126_CANDIDATE,
      candidate_tree: V126_CANDIDATE_TREE,
      merged_commit: merge_sha,
      merged_base_commit: "e125cffbe3cad0cf8fc2fdec284876019f94390e",
      merged_tree: V126_CANDIDATE_TREE,
      drifted_paths: [],
    } },
    stable_gate("e125cffbe3cad0cf8fc2fdec284876019f94390e"),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq([decision.action, decision.merge_sha], ["tag", V126_TAG_COMMIT])
}

/**
 * The negative control for the line above: a cut where nothing landed between
 * certification and the merge still mints its tag. Without this the gate could
 * refuse every release and its falsifier would still pass.
 */
pipeline test_release_tag_mints_when_main_did_not_move(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const decision = release_main_tag_decision(
    receipt(),
    merged,
    "",
    agreeing_trees,
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq([decision.action, decision.merge_sha], ["tag", MERGED_MAIN])
  assert_eq(decision.drifted_paths, [])
}

/**
 * An unresolved tree is not agreement. Two empty strings compare equal, so a
 * probe that answered nothing would otherwise read as a clean release: the
 * exact shape where absence reads as success.
 */
pipeline test_release_tag_refuses_when_the_certified_tree_cannot_be_proved(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const unprovable = release_main_tag_decision(
    receipt(),
    merged,
    "",
    fn(_sha) { return nil },
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq(unprovable.action, "abort")
  assert(contains(unprovable.reason, "could not prove"))
  const empty = release_main_tag_decision(
    receipt(),
    merged,
    "",
    fn(merge_sha) { return {
      candidate_commit: CANDIDATE,
      candidate_tree: "",
      merged_commit: merge_sha,
      merged_base_commit: PIN,
      merged_tree: "",
      drifted_paths: [],
    } },
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq(empty.action, "certification_drift")
}

/** A drifted tree refuses through the driver too, not only in the predicate. */
pipeline test_release_main_tag_path_refuses_a_drifted_merge(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-drifted-tag.json")
  // A previous run of this workspace may have left a receipt here, and these
  // claims are about what this run wrote.
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 1, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request(
        {merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN},
      ) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(merge_sha) { return {
        candidate_commit: CANDIDATE,
        candidate_tree: CERTIFIED_TREE,
        merged_commit: merge_sha,
        merged_base_commit: PIN,
        merged_tree: "5555555555555555555555555555555555555555",
        drifted_paths: ["Cargo.lock"],
      } },
      merge_gate: stable_gate(PIN),
      merge: fn(_pr) { return true },
      main_delta: fn(sha) { return certified_delta(sha) },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-08-24T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert(contains(result.reason, "main moved between certification and the merge"))
  assert(contains(result.reason, "Cargo.lock"))
  // The tag must not have been pushed and the receipt must not be bound.
  assert_eq(result.steps, [])
  assert_eq(harness.fs.exists(path), false)
}

const MOVED_MAIN = "6666666666666666666666666666666666666666"

const LATER_MAIN = "8888888888888888888888888888888888888888"

/** A path a callback writes to so the test can prove it ran. */
fn marker(fs: HarnessFs, name: string) -> string {
  const path = path_join(fs.workspace_temp_dir(), "marker-" + name + ".txt")
  if fs.exists(path) {
    fs.delete(path)
  }
  return path
}

/** What a callback recorded, or the empty string when it never ran. */
fn marked(fs: HarnessFs, path: string) -> string {
  if !fs.exists(path) {
    return ""
  }
  return trim(fs.read_text(path))
}

fn check_run(name: string, conclusion: string) {
  return {name: name, status: "COMPLETED", conclusion: conclusion, __typename: "CheckRun"}
}

fn drift_gate(paths: list<string>, conclusion: string, release_only: list<string>) {
  return { _pr ->
    return {
      certified_base: PIN,
      observed_main: MOVED_MAIN,
      mergeable_state: "clean",
      mergeable_resolved: true,
      drifted_paths: paths,
      evidence: release_drift_evidence(
        PIN,
        MOVED_MAIN,
        ["CI status"],
        [
          release_drift_commit_evidence(
            MOVED_MAIN,
            7885,
            ["CI status"],
            [check_run("CI status", conclusion)],
            [],
          ),
        ],
        "2026-09-03T03:00:00Z",
      ),
      release_only_checks: release_only,
    }
  }
}

/**
 * The contract, through the driver. Main moved by code, every drifted commit
 * passed the branch's own required checks, so the release merges onto it under
 * its head lease. The lanes only a release runs have still not seen that tree,
 * so they run on the merged main commit, and only when they pass is the tag
 * minted. The merge is not the publication act; the tag is.
 *
 * Every claim here is read from what the runner itself produced: a callback's
 * writes do not survive back into this scope, but the receipt the runner wrote
 * does, and it is the artifact an operator would check afterwards anyway.
 */
pipeline test_release_main_tag_path_certifies_main_before_it_tags(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-delta-merge.json")
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 5, interval_ms: 0},
    {
      pull_request: fn(poll) { return if poll < 1 {
        pull_request({auto_merge_armed: false})
      } else {
        pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
      } },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: drift_gate(
        ["crates/harn-core/src/lib.rs"],
        "SUCCESS",
        ["Workspace nextest (windows-latest)"],
      ),
      merge: fn(_pr) { return true },
      // Not started on the poll that merges, running on the next, passed after
      // that. A tag on any earlier poll would mean the gate did not hold.
      main_delta: fn(sha, poll) { return if poll < 2 {
        delta("not_started", sha, "")
      } else if poll < 3 {
        delta("running", sha, "")
      } else {
        delta("passed", sha, "")
      } },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(sha) { return [{name: "push-release-tag", success: sha == MERGED_MAIN}] },
      now: fn(_poll) { return "2026-09-03T03:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 0)
  assert(result.steps.any({ step -> step.name == "push-release-tag" && step.success }))
  const recorded = release_watch_receipt_read(harness.fs, path)?.certification_drift
  assert_eq(recorded?.state, "recorded")
  assert_eq(recorded?.observed_main, MOVED_MAIN)
  assert_eq(recorded?.required_contexts, ["CI status"])
  assert_eq(recorded?.drifted_paths, ["crates/harn-core/src/lib.rs"])
  assert_eq(recorded?.commits?.map({ commit -> commit.green }), [true])
}

/**
 * The merged tree failed a lane only a release runs. No tag is minted, and the
 * harness opens the revert itself rather than leaving main carrying a bumped
 * version that no cut can follow. This is the wreck of run 33696723720, with
 * the recovery that had to be written by hand that night done by the machine.
 */
pipeline test_release_main_tag_path_unfolds_a_failed_post_merge_delta(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-delta-failed.json")
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 3, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request(
        {merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN},
      ) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: drift_gate(
        ["crates/harn-core/src/lib.rs"],
        "SUCCESS",
        ["Workspace nextest (windows-latest)"],
      ),
      merge: fn(_pr) { return true },
      main_delta:
        fn(sha, _poll) { return delta("failed", sha, "Workspace nextest (windows-latest)") },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return {
        action: "open",
        reason: "opened pull request 4242 to revert the bump",
        terminal_reason: "",
        branch: "release-unfold/v0.10.128",
        title: "unfold",
      } },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-09-03T03:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert(contains(result.reason, "RELEASE DEFERRED"))
  assert(contains(result.reason, "Workspace nextest (windows-latest)"))
  assert(contains(result.reason, "opened pull request 4242"))
  assert(!result.steps.any({ step -> step.name == "unexpected-tag-push" }))
  const recorded = release_watch_receipt_read(harness.fs, path)?.main_delta
  assert_eq(
    [recorded?.state, recorded?.failing_check],
    ["failed", "Workspace nextest (windows-latest)"],
  )
  // The bump already merged; this refusal is about the tag, never about
  // admitting the candidate, which happened already.
  assert_eq(result.phase, "tag")
}

/**
 * A delta nobody could read refuses the tag. An unreadable lane and a passing
 * lane are the same absence of a failure, and reading the first as the second
 * is exactly how a gate becomes decoration.
 */
pipeline test_release_main_tag_path_refuses_to_tag_an_unobserved_delta(
  harness: Harness,
  task: any,
) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-delta-unobserved.json")
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 2, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request(
        {merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN},
      ) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: drift_gate(
        ["crates/harn-core/src/lib.rs"],
        "SUCCESS",
        ["Workspace nextest (windows-latest)"],
      ),
      merge: fn(_pr) { return true },
      main_delta: fn(_sha, _poll) { return release_main_delta_unobserved() },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-09-03T03:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert(contains(result.reason, "never observed on the merged main commit"))
  assert(!result.steps.any({ step -> step.name == "unexpected-tag-push" }))
}

/**
 * The v0.10.128 shape. A drifted commit that did not pass the branch's own
 * required checks stops the release: nothing merges, main keeps its development
 * version, and a fresh cut stays admissible.
 */
pipeline test_release_main_tag_path_defers_drift_that_is_not_green(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-red-drift.json")
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const merged = marker(harness.fs, "red-merged")
  const disarmed = marker(harness.fs, "red-disarmed")
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 3, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request({auto_merge_armed: true}) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: drift_gate(
        ["crates/harn-core/src/lib.rs"],
        "FAILURE",
        ["Workspace nextest (windows-latest)"],
      ),
      merge: fn(_pr) {
        harness.fs.write_text(merged, "merged")
        return true
      },
      main_delta: fn(sha) { return certified_delta(sha) },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, observed_main) {
        harness.fs.write_text(disarmed, observed_main)
        return true
      },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-09-03T03:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(
    [to_string(result.status), marked(harness.fs, merged), marked(harness.fs, disarmed)],
    ["2", "", MOVED_MAIN],
  )
  assert(contains(result.reason, "did not pass CI status"))
  assert(contains(result.reason, "Nothing was merged and main is untouched"))
  assert_eq(harness.fs.exists(path), false)
  // Nothing merged, so this refusal is about admitting the candidate onto
  // main, not about the tag. A reader who reads this as a tag-time refusal is
  // exactly the confusion the phase field exists to prevent.
  assert_eq(result.phase, "main_tag_admission")
}

/**
 * The driver observes the gate again immediately before the irreversible
 * merge. That fresh observation must be admitted too: recording a newly red
 * head as the parent lease would let its same-path content pass the later tree
 * containment check.
 */
pipeline test_release_main_tag_path_refuses_an_approved_then_red_gate(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-approved-then-red.json")
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const observed = marker(harness.fs, "approved-then-red-observed")
  const merged = marker(harness.fs, "approved-then-red-merged")
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 1, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request({auto_merge_armed: false}) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: { pr ->
        if !harness.fs.exists(observed) {
          harness.fs.write_text(observed, "approved")
          const approved = drift_gate(
            ["crates/harn-core/src/lib.rs"],
            "SUCCESS",
            ["Workspace nextest (windows-latest)"],
          )
          return approved(pr)
        }
        const rejected = drift_gate(
          ["crates/harn-core/src/lib.rs"],
          "FAILURE",
          ["Workspace nextest (windows-latest)"],
        )
        return rejected(pr)
      },
      merge: fn(_pr) {
        harness.fs.write_text(merged, "merged")
        return true
      },
      main_delta: fn(sha) { return certified_delta(sha) },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-09-03T03:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq([to_string(result.status), marked(harness.fs, merged)], ["2", ""])
  assert(contains(result.reason, "did not pass CI status"))
  assert_eq(harness.fs.exists(path), false)
}

/**
 * The common cut, end to end. An ordinary pull request added a changelog
 * fragment while the release certified, so the merged tree carries the
 * certified tree plus paperwork. The release merges and tags without paying for
 * a delta run at all, because the tree it will tag is the one it already
 * certified.
 *
 * The unfold adapter would refuse if it were reached, so a run that reaches its
 * tag proves the failure path was never entered.
 */
pipeline test_release_main_tag_path_merges_green_paperwork_drift(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-paperwork-drift.json")
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 3, interval_ms: 0},
    {
      pull_request: fn(poll) { return if poll < 1 {
        pull_request({auto_merge_armed: false})
      } else {
        pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
      } },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: drift_gate(
        ["changelog.d/7885.fixed.md"],
        "SUCCESS",
        ["Workspace nextest (windows-latest)"],
      ),
      merge: fn(_pr) { return true },
      main_delta: fn(sha, _poll) { return certified_delta(sha) },
      // Reaching either of these would mean the gate asked for a proof it
      // already had.
      dispatch_main_delta: fn(_sha) { return false },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(sha) { return [{name: "push-release-tag", success: sha == MERGED_MAIN}] },
      now: fn(_poll) { return "2026-09-03T03:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 0)
  assert(result.steps.any({ step -> step.name == "push-release-tag" && step.success }))
  const recorded = release_watch_receipt_read(harness.fs, path)?.certification_drift
  assert_eq(recorded?.state, "recorded")
  assert_eq(recorded?.drifted_paths, ["changelog.d/7885.fixed.md"])
}

/** An unobservable main head refuses the merge instead of reading as stable. */
pipeline test_release_main_tag_path_refuses_an_unobservable_main(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-unobserved-main.json")
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const merged = marker(harness.fs, "unobserved-merged")
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 2, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request({auto_merge_armed: false}) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: { _pr -> return nil },
      merge: fn(_pr) {
        harness.fs.write_text(merged, "merged")
        return true
      },
      main_delta: fn(sha) { return certified_delta(sha) },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-09-03T03:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq([to_string(result.status), marked(harness.fs, merged)], ["2", ""])
  assert(contains(result.reason, "could not observe origin/main"))
}

/**
 * The tag gate, reworded for the contract. The merged tree is allowed to differ
 * from the certified one exactly where the recorded drift accounts for it, and
 * nowhere else. Identity is no longer the test, because main moves during every
 * cut, but an unaccounted file still stops the tag.
 */
fn drifted_receipt(recorded_paths: list<string>) {
  return receipt()
    + {
      certification_drift: {
        state: "recorded",
        certified_base: PIN,
        observed_main: MOVED_MAIN,
        required_contexts: ["CI status"],
        commits: [
          {
            sha: MOVED_MAIN,
            pull_number: 7885,
            checks: [{name: "CI status", state: "SUCCESS", source: "main_commit"}],
            green: true,
            blocking_check: "",
          },
        ],
        drifted_paths: recorded_paths,
        release_only_checks: ["Workspace nextest (windows-latest)"],
        delta_verified_at: MOVED_MAIN,
        delta_iterations: 1,
        observed_at: "2026-09-03T03:00:00Z",
      },
    }
}

fn drifted_trees(merge_sha: string, paths: list<string>, merged_base_commit: string = MOVED_MAIN) {
  return {
    candidate_commit: CANDIDATE,
    candidate_tree: CERTIFIED_TREE,
    merged_commit: merge_sha,
    merged_base_commit: merged_base_commit,
    merged_tree: "7777777777777777777777777777777777777777",
    drifted_paths: paths,
  }
}

pipeline test_release_tag_accepts_a_tree_the_recorded_drift_accounts_for(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const decision = release_main_tag_decision(
    drifted_receipt(["crates/harn-core/src/lib.rs"]),
    merged,
    "",
    fn(sha) { return drifted_trees(sha, ["crates/harn-core/src/lib.rs"]) },
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq([decision.action, decision.merge_sha], ["tag", MERGED_MAIN])
}

/**
 * Exact race falsifier: after the gate records MOVED_MAIN, another pull request
 * changes the same path before GitHub performs the squash merge. Path
 * containment alone cannot distinguish the later content from the content the
 * gate actually observed, so the squash commit's parent must hold the lease.
 */
pipeline test_release_tag_refuses_recorded_paths_when_the_squash_base_moved(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const decision = release_main_tag_decision(
    drifted_receipt(["crates/harn-core/src/lib.rs"]),
    merged,
    "",
    fn(sha) { return drifted_trees(sha, ["crates/harn-core/src/lib.rs"], LATER_MAIN) },
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq(decision.action, "certification_drift")
  assert(contains(decision.reason, LATER_MAIN))
  assert(contains(decision.reason, MOVED_MAIN))
}

pipeline test_release_tag_refuses_a_file_the_record_never_named(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const decision = release_main_tag_decision(
    drifted_receipt(["crates/harn-core/src/lib.rs"]),
    merged,
    "",
    fn(sha) { return drifted_trees(
      sha,
      ["crates/harn-core/src/lib.rs", "crates/harn-cli/src/main.rs"],
    ) },
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq(decision.action, "certification_drift")
  assert(contains(decision.reason, "crates/harn-cli/src/main.rs"))
  assert(contains(decision.reason, "mode tag-stranded-main"))
}

/** A record that was never written accounts for nothing, so identity is required. */
pipeline test_release_tag_requires_identity_without_a_record(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const decision = release_main_tag_decision(
    receipt(),
    merged,
    "",
    fn(sha) { return drifted_trees(sha, ["crates/harn-core/src/lib.rs"]) },
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq(decision.action, "certification_drift")
}

/**
 * An exhausted loop must say what state main is actually in. A release whose
 * bump merged and whose post-merge lanes were still running is not a release
 * that "did not merge", and reporting it that way sends an operator to cut
 * again against a branch whose preflight refuses it.
 */
pipeline test_release_main_tag_path_reports_a_merged_bump_when_polls_run_out(
  harness: Harness,
  task: any,
) {
  const path = path_join(harness.fs.workspace_temp_dir(), "release-delta-timeout.json")
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    {max_polls: 2, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request(
        {merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN},
      ) },
      remote_tag_target: fn(_poll) { return "" },
      certification_trees: fn(sha) { return agreeing_trees(sha) },
      merge_gate: drift_gate(
        ["crates/harn-core/src/lib.rs"],
        "SUCCESS",
        ["Workspace nextest (windows-latest)"],
      ),
      merge: fn(_pr) { return true },
      main_delta: fn(sha, _poll) { return delta("running", sha, "") },
      dispatch_main_delta: fn(_sha) { return true },
      unfold: fn(_sha) { return no_unfold() },
      disarm: fn(_pr, _observed_main) { return true },
      merged_main_ancestor: fn(_sha) { return true },
      push_tag: fn(_sha) { return [{name: "unexpected-tag-push", success: true}] },
      now: fn(_poll) { return "2026-09-03T03:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 3)
  assert(contains(result.reason, "the release PR merged at ${MERGED_MAIN}"))
  assert(contains(result.reason, "not a fresh-cut state"))
  assert(!result.steps.any({ step -> step.name == "unexpected-tag-push" }))
  // The bump is already on main; an exhausted loop here is waiting on the tag,
  // never on admission.
  assert_eq(result.phase, "tag")
}
