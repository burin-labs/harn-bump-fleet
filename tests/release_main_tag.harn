import {
  release_drift_commit_evidence,
  release_drift_evidence,
} from "../lib/release_drift_evidence"
import { ReleaseMainDelta, release_main_delta_unobserved } from "../lib/release_main_delta"
import { release_main_tag_decision, run_release_main_tag } from "../lib/release_main_tag"
import { release_publication } from "../lib/release_publication"
import { ReleaseUnfoldDecision } from "../lib/release_unfold"
import { release_watch_receipt, release_watch_receipt_read } from "../lib/release_watch_state"

const CANDIDATE = "1111111111111111111111111111111111111111"

const MERGED_MAIN = "2222222222222222222222222222222222222222"

const CERTIFIED_TREE = "4444444444444444444444444444444444444444"

/** Main did not move: the merged commit carries the tree the release certified. */
fn agreeing_trees(merge_sha: string) {
  return {
    candidate_commit: CANDIDATE,
    candidate_tree: CERTIFIED_TREE,
    merged_commit: merge_sha,
    merged_base_commit: PIN,
    merged_tree: CERTIFIED_TREE,
    drifted_paths: [],
  }
}

/** One post-merge delta observation, built by state. */
fn delta(state: string, sha: string, failing: string) -> ReleaseMainDelta {
  return {
    state: state,
    commit: sha,
    lanes: ["Workspace nextest (windows-latest)"],
    checks: [],
    failing_check: failing,
    observed_at: "2026-09-03T03:00:00Z",
  }
}

/**
 * The merged tree is the one the release certified, so the release-only lanes
 * have nothing new to prove and the delta is skipped by a named verdict.
 */
fn certified_delta(sha: string) -> ReleaseMainDelta {
  return delta("skipped_tree_already_certified", sha, "")
}

/** An unfold adapter that refuses, for the runs that must never reach it. */
fn no_unfold() -> ReleaseUnfoldDecision {
  return {
    action: "refuse",
    reason: "the unfold path was reached by a run that should have tagged",
    terminal_reason: "unexpected_unfold",
    branch: "",
    title: "",
  }
}

/** Main is still the certified base and GitHub would merge the release now. */
fn stable_gate(base: string) {
  return { _pr ->
    return {
      certified_base: base,
      observed_main: base,
      mergeable_state: "clean",
      mergeable_resolved: true,
      drifted_paths: [],
      evidence: nil,
      release_only_checks: [],
    }
  }
}

const PIN = "0000000000000000000000000000000000000000"

fn receipt() {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: PIN,
      publication: release_publication("1.2.3", CANDIDATE),
      pr_url: "https://github.com/burin-labs/harn/pull/42",
      created_at: "2026-08-24T00:00:00Z",
    },
  )
}

fn pull_request(overrides: dict = {}) {
  return {
    number: 42,
    merged: false,
    merge_commit_oid: nil,
    github_state: "open",
    auto_merge_armed: true,
    in_merge_queue: false,
    base: {ref: "main"},
    head: {ref: "release-attempt/v1.2.3/${CANDIDATE}", sha: CANDIDATE},
    ...overrides,
  }
}

/**
 * An open pull request at the certified base is merged by the release itself,
 * not left to GitHub. Arming at pull-request open is what let a merge land at a
 * base nobody re-observed.
 */
pipeline test_release_tag_merges_the_exact_pr_at_its_certified_base(task: any) {
  const decision = release_main_tag_decision(
    receipt(),
    pull_request(),
    "",
    agreeing_trees,
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq([decision.action, decision.merge_sha], ["merge", ""])
}

/** An unarmed pull request is exactly the normal case now: the release merges it. */
pipeline test_release_tag_merges_an_unarmed_open_pr(task: any) {
  const decision = release_main_tag_decision(
    receipt(),
    pull_request({auto_merge_armed: false}),
    "",
    agreeing_trees,
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq(decision.action, "merge")
}

pipeline test_release_tag_mints_only_at_merged_main_commit(task: any) {
  const decision = release_main_tag_decision(
    receipt(),
    pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN}),
    "",
    agreeing_trees,
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq([decision.action, decision.merge_sha], ["tag", MERGED_MAIN])
}

pipeline test_release_tag_reuses_only_the_exact_merged_main_target(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const reused = release_main_tag_decision(
    receipt(),
    merged,
    MERGED_MAIN,
    agreeing_trees,
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  const moved = release_main_tag_decision(
    receipt(),
    merged,
    "3333333333333333333333333333333333333333",
    agreeing_trees,
    stable_gate(PIN),
    { sha, _poll -> return certified_delta(sha) },
    0,
  )
  assert_eq(reused.action, "reuse")
  assert_eq(moved.action, "abort")
}

pipeline test_release_tag_rejects_publication_before_merge(task: any) {
