import { release_main_tag_decision, run_release_main_tag } from "../lib/release_main_tag"
import { release_publication } from "../lib/release_publication"
import { release_watch_receipt, release_watch_receipt_read } from "../lib/release_watch_state"

const CANDIDATE = "1111111111111111111111111111111111111111"

const MERGED_MAIN = "2222222222222222222222222222222222222222"

fn receipt() {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "0000000000000000000000000000000000000000",
      publication: release_publication("1.2.3", CANDIDATE),
      pr_url: "https://github.com/burin-labs/harn/pull/42",
      created_at: "2026-08-24T00:00:00Z",
    },
  )
}

fn pull_request(overrides: dict = {}) {
  return {
    number: 42,
    merged: false,
    merge_commit_oid: nil,
    github_state: "open",
    auto_merge_armed: true,
    in_merge_queue: false,
    base: {ref: "main"},
    head: {ref: "release-attempt/v1.2.3/${CANDIDATE}", sha: CANDIDATE},
    ...overrides,
  }
}

pipeline test_release_tag_waits_until_exact_pr_merges(task: any) {
  const decision = release_main_tag_decision(receipt(), pull_request(), "")
  assert_eq([decision.action, decision.merge_sha], ["wait", ""])
}

pipeline test_release_tag_rearms_an_unowned_open_pr(task: any) {
  const decision = release_main_tag_decision(receipt(), pull_request({auto_merge_armed: false}), "")
  assert_eq(decision.action, "rearm")
}

pipeline test_release_tag_mints_only_at_merged_main_commit(task: any) {
  const decision = release_main_tag_decision(
    receipt(),
    pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN}),
    "",
  )
  assert_eq([decision.action, decision.merge_sha], ["tag", MERGED_MAIN])
}

pipeline test_release_tag_reuses_only_the_exact_merged_main_target(task: any) {
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const reused = release_main_tag_decision(receipt(), merged, MERGED_MAIN)
  const moved = release_main_tag_decision(
    receipt(),
    merged,
    "3333333333333333333333333333333333333333",
  )
  assert_eq(reused.action, "reuse")
  assert_eq(moved.action, "abort")
}

pipeline test_release_tag_rejects_publication_before_merge(task: any) {
  const decision = release_main_tag_decision(receipt(), pull_request(), CANDIDATE)
  assert_eq(decision.action, "abort")
}

pipeline test_release_tag_rejects_wrong_pr_identity(task: any) {
  const wrong_head = release_main_tag_decision(
    receipt(),
    pull_request({head: {ref: "release-attempt/v1.2.3/${CANDIDATE}", sha: MERGED_MAIN}}),
    "",
  )
  const wrong_base = release_main_tag_decision(receipt(), pull_request({base: {ref: "other"}}), "")
  assert_eq([wrong_head.action, wrong_base.action], ["abort", "abort"])
}

pipeline test_release_tag_rejects_missing_or_malformed_merge_identity(task: any) {
  const missing = release_main_tag_decision(
    receipt(),
    pull_request({merged: true, github_state: "merged"}),
    "",
  )
  const malformed = release_main_tag_decision(receipt(), nil, "not-a-sha")
  assert_eq([missing.action, malformed.action], ["abort", "abort"])
}

pipeline test_release_main_tag_path_rearms_then_binds_merged_main(harness: Harness, task: any) {
  const original = receipt()
  const path = path_join(harness.fs.workspace_temp_dir(), "release-main-tag.json")
  const merged = pull_request({merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN})
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    original,
    path,
    {max_polls: 3, interval_ms: 0},
    {
      pull_request: fn(poll) { return if poll == 0 {
        pull_request({auto_merge_armed: false})
      } else {
        merged
      } },
      remote_tag_target: fn(_poll) { return "" },
      rearm: fn(_pr) { return true },
      merged_main_ancestor: fn(sha) { return sha == MERGED_MAIN },
      push_tag: fn(sha) { return [{name: "push-release-tag", success: sha == MERGED_MAIN}] },
      now: fn(_poll) { return "2026-08-24T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  const persisted = release_watch_receipt_read(harness.fs, path)
  assert_eq([result.status, result.polls, result.receipt.release_commit_oid], [0, 2, MERGED_MAIN])
  assert_eq(persisted?.release_commit_oid, MERGED_MAIN)
  assert(result.steps.any({ step -> step.name == "push-release-tag" && step.success }))
}

pipeline test_release_main_tag_path_rejects_non_main_merge(harness: Harness, task: any) {
  const original = receipt()
  const path = path_join(harness.fs.workspace_temp_dir(), "release-non-main-tag.json")
  const result = run_release_main_tag(
    harness,
    {mock: true, repo: "/mock/harn"},
    original,
    path,
    {max_polls: 1, interval_ms: 0},
    {
      pull_request: fn(_poll) { return pull_request(
        {merged: true, github_state: "merged", merge_commit_oid: MERGED_MAIN},
      ) },
      remote_tag_target: fn(_poll) { return "" },
      rearm: fn(_pr) { return true },
      merged_main_ancestor: fn(_sha) { return false },
      push_tag: fn(_sha) { return [{name: "unexpected", success: true}] },
      now: fn(_poll) { return "2026-08-24T01:00:00Z" },
      wait: fn(_delay_ms) { return nil },
    },
  )
  assert_eq(result.status, 2)
  assert(contains(result.reason, "not reachable from origin/main"))
  assert_eq(harness.fs.exists(path), false)
}
