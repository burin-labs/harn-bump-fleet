import {
  HostedReleaseDispatchAdapter,
  HostedReleaseDispatchReceipt,
  HostedReleaseInputs,
  hosted_release_dispatch,
  hosted_release_receipt_read,
  hosted_release_receipt_write,
  hosted_release_replace,
  hosted_release_source_repo_error,
} from "../lib/hosted_release_dispatch"

const REPO = "burin-labs/harn-bump-fleet"

const WORKFLOW = "hosted-release.yml"

const WORKFLOW_PATH = ".github/workflows/hosted-release.yml"

const REF = "main"

const POLICY_SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const RELEASE_SHA = "98a2d2b9c046a1a93078c6bcd27b1b2bc8c761dd"

fn inputs() -> HostedReleaseInputs {
  return {
    mode: "ship-pr",
    bump: "patch",
    prerelease_identifier: "",
    at_sha: RELEASE_SHA,
    converge_fleet: true,
    expected_prs: [6664],
  }
}

fn dispatch_receipt(id: int) {
  return {
    repo: REPO,
    accepted: true,
    run_id: id,
    workflow_id: "1234",
    workflow_path: WORKFLOW_PATH,
    run_attempt: 1,
    ref: REF,
    head_sha: POLICY_SHA,
    head_branch: REF,
    event: "workflow_dispatch",
    url: "https://github.com/${REPO}/actions/runs/${id}",
    created_at: "2026-08-13T00:00:00Z",
  }
}

fn workflow_run(id: int, status: string) {
  return {
    repo: REPO,
    id: id,
    workflow_id: 1234,
    workflow_path: WORKFLOW_PATH,
    run_number: id,
    run_attempt: 1,
    name: "Hosted harn release",
    event: "workflow_dispatch",
    status: status,
    conclusion: nil,
    head_branch: REF,
    head_sha: POLICY_SHA,
    url: "https://github.com/${REPO}/actions/runs/${id}",
    created_at: "2026-08-13T00:00:00Z",
    run_started_at: nil,
    updated_at: "2026-08-13T00:00:00Z",
  }
}

fn cancelled(id: int) {
  return {repo: REPO, run_id: id, accepted: true, state: "cancel_requested"}
}

fn initial_receipt() -> HostedReleaseDispatchReceipt {
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) { return Ok(dispatch_receipt(1001)) },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  return unwrap(hosted_release_dispatch(REPO, WORKFLOW, REF, inputs(), adapter))
}

pipeline test_dispatch_receipt_retains_complete_nondefault_input_tuple(task) {
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, inputs(), adapter)
  assert(is_ok(result))
  const receipt = unwrap(result)
  assert_eq(observed, inputs())
  assert_eq(receipt.inputs.at_sha, RELEASE_SHA)
  assert_eq(receipt.inputs.mode, "ship-pr")
  assert_eq(receipt.inputs.bump, "patch")
  assert_eq(receipt.inputs.prerelease_identifier, "")
  assert_eq(receipt.inputs.converge_fleet, true)
  assert_eq(receipt.inputs.expected_prs, [6664])
  assert_eq(receipt.run_id, 1001)
  assert_eq(receipt.replacement, nil)
}

pipeline test_read_only_audit_is_a_closed_hosted_mode(task) {
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const audit: HostedReleaseInputs = inputs() + {mode: "audit", converge_fleet: false}
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, audit, adapter)
  assert(is_ok(result))
  assert_eq(observed, audit)
}

pipeline test_invalid_source_pin_fails_before_dispatch(task) {
  let dispatches = 0
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) {
      dispatches = dispatches + 1
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const invalid: HostedReleaseInputs = {
    mode: "ship-pr",
    bump: "patch",
    prerelease_identifier: "",
    at_sha: "not-a-commit",
    converge_fleet: true,
    expected_prs: [],
  }
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, invalid, adapter)
  assert(is_err(result))
  assert_eq(unwrap_err(result).code, "invalid_inputs")
  assert_eq(dispatches, 0)
}

pipeline test_legacy_receipt_inputs_normalize_without_expected_prs(task) {
  const legacy: HostedReleaseInputs = {
    mode: "ship-pr",
    bump: "patch",
    prerelease_identifier: "",
    at_sha: RELEASE_SHA,
    converge_fleet: true,
  }
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  assert(is_ok(hosted_release_dispatch(REPO, WORKFLOW, REF, legacy, adapter)))
  assert_eq(observed?.expected_prs, [])
}

pipeline test_invalid_expected_pr_fails_before_dispatch(task) {
  let dispatches = 0
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) {
      dispatches = dispatches + 1
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const invalid = inputs() + {expected_prs: [6664, 0]}
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, invalid, adapter)
  assert(is_err(result))
  assert_eq(unwrap_err(result).code, "invalid_inputs")
  assert_eq(dispatches, 0)
}

pipeline test_hosted_source_repo_accepts_only_canonical_checkout(task) {
  const canonical = "/Users/example/projects/harn"
  assert_eq(hosted_release_source_repo_error(nil, canonical), nil)
  assert_eq(hosted_release_source_repo_error(canonical, canonical), nil)
  assert(
    contains(
      hosted_release_source_repo_error("/private/tmp/harn", canonical) ?? "",
      "canonical Harn checkout",
    ),
  )
}

pipeline test_replacement_replays_prior_tuple_and_records_both_run_ids(task) {
  const prior = initial_receipt()
  let observed: HostedReleaseInputs? = nil
  let run_lookups = 0
  let cancelled_ids: list<int> = []
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1002))
    },
    run: fn(id) {
      assert_eq(id, 1001)
      run_lookups = run_lookups + 1
      return Ok(workflow_run(id, "waiting"))
    },
    cancel: fn(id) {
      cancelled_ids = cancelled_ids + [id]
      return Ok(cancelled(id))
    },
  }
  const result = hosted_release_replace(prior, adapter)
  assert(is_ok(result))
  const receipt = unwrap(result)
  assert_eq(observed, prior.inputs)
  assert_eq(receipt.inputs, prior.inputs)
  assert_eq(receipt.run_id, 1002)
  assert_eq(receipt.replacement?.previous_run_id, 1001)
  assert_eq(receipt.replacement?.previous_status, "waiting")
  assert_eq(receipt.replacement?.cancellation.run_id, 1001)
  assert_eq(run_lookups, 2)
  assert_eq(cancelled_ids, [1001])
}

pipeline test_replacement_race_rolls_back_new_run_and_preserves_old(task) {
  const prior = initial_receipt()
  let run_lookups = 0
  let cancelled_ids: list<int> = []
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) { return Ok(dispatch_receipt(1002)) },
    run: fn(id) {
      run_lookups = run_lookups + 1
      return Ok(
        workflow_run(
          id,
          if run_lookups == 1 {
            "queued"
          } else {
            "in_progress"
          },
        ),
      )
    },
    cancel: fn(id) {
      cancelled_ids = cancelled_ids + [id]
      return Ok(cancelled(id))
    },
  }
  const result = hosted_release_replace(prior, adapter)
  assert(is_err(result))
  const failure = unwrap_err(result)
  assert_eq(failure.code, "replacement_race")
  assert_eq(failure.previous_run_id, 1001)
  assert_eq(failure.replacement_run_id, 1002)
  assert_eq(failure.rollback?.run_id, 1002)
  assert_eq(cancelled_ids, [1002])
}

pipeline test_replacement_cancel_refusal_rolls_back_new_run(task) {
  const prior = initial_receipt()
  let cancelled_ids: list<int> = []
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) { return Ok(dispatch_receipt(1002)) },
    run: fn(id) { return Ok(workflow_run(id, "queued")) },
    cancel: fn(id) {
      cancelled_ids = cancelled_ids + [id]
      return if id == 1001 {
        Err({code: "provider_refused"})
      } else {
        Ok(cancelled(id))
      }
    },
  }
  const result = hosted_release_replace(prior, adapter)
  assert(is_err(result))
  const failure = unwrap_err(result)
  assert_eq(failure.code, "replacement_cancel_failed")
  assert_eq(failure.rollback?.run_id, 1002)
  assert_eq(cancelled_ids, [1001, 1002])
}

pipeline test_receipt_round_trips_through_typed_atomic_store(harness: Harness, task) {
  const receipt = initial_receipt()
  const path = path_join(harness.fs.workspace_temp_dir(), "receipts", "dispatch.json")
  hosted_release_receipt_write({fs: harness.fs, random: harness.random}, path, receipt)
  assert_eq(hosted_release_receipt_read(harness.fs, path), receipt)
}
