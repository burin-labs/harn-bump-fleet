import { shell_quote } from "std/runtime"
import { hosted_release_repository_scope } from "../dispatch_hosted_release"
import { harn_bump_repositories, read_fleet_manifest } from "../lib/fleet_manifest"
import {
  HostedReleaseDispatchAdapter,
  HostedReleaseDispatchReceipt,
  HostedReleaseInputs,
  hosted_release_dispatch,
  hosted_release_receipt_read,
  hosted_release_receipt_write,
  hosted_release_replace,
  hosted_release_source_repo_error,
} from "../lib/hosted_release_dispatch"
import { pinned_test_runtime } from "./pinned_runtime"

const REPO = "burin-labs/harn-bump-fleet"

const WORKFLOW = "hosted-release.yml"

const WORKFLOW_PATH = ".github/workflows/hosted-release.yml"

const REF = "main"

const POLICY_SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const RELEASE_SHA = "98a2d2b9c046a1a93078c6bcd27b1b2bc8c761dd"

fn refused(callback: closure) -> bool {
  try {
    callback()
    return false
  } catch (_error) {
    return true
  }
}

fn inputs() -> HostedReleaseInputs {
  return {
    mode: "ship-pr",
    bump: "patch",
    prerelease_identifier: "",
    at_sha: RELEASE_SHA,
    converge_fleet: true,
    expected_prs: [6664],
    resume_tagged_release: false,
  }
}

fn dispatch_receipt(id: int) {
  return {
    repo: REPO,
    accepted: true,
    run_id: id,
    workflow_id: "1234",
    workflow_path: WORKFLOW_PATH,
    run_attempt: 1,
    ref: REF,
    head_sha: POLICY_SHA,
    head_branch: REF,
    event: "workflow_dispatch",
    url: "https://github.com/${REPO}/actions/runs/${id}",
    created_at: "2026-08-13T00:00:00Z",
  }
}

fn workflow_run(id: int, status: string) {
  return {
    repo: REPO,
    id: id,
    workflow_id: 1234,
    workflow_path: WORKFLOW_PATH,
    run_number: id,
    run_attempt: 1,
    name: "Hosted harn release",
    event: "workflow_dispatch",
    status: status,
    conclusion: nil,
    head_branch: REF,
    head_sha: POLICY_SHA,
    url: "https://github.com/${REPO}/actions/runs/${id}",
    created_at: "2026-08-13T00:00:00Z",
    run_started_at: nil,
    updated_at: "2026-08-13T00:00:00Z",
  }
}

fn cancelled(id: int) {
  return {repo: REPO, run_id: id, accepted: true, state: "cancel_requested"}
}

fn initial_receipt() -> HostedReleaseDispatchReceipt {
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) { return Ok(dispatch_receipt(1001)) },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  return unwrap(hosted_release_dispatch(REPO, WORKFLOW, REF, inputs(), adapter))
}

pipeline test_dispatch_receipt_retains_complete_nondefault_input_tuple(task: any) {
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, inputs(), adapter)
  assert(is_ok(result))
  const receipt = unwrap(result)
  assert_eq(observed, inputs())
  assert_eq(receipt.inputs.at_sha, RELEASE_SHA)
  assert_eq(receipt.inputs.mode, "ship-pr")
  assert_eq(receipt.inputs.bump, "patch")
  assert_eq(receipt.inputs.prerelease_identifier, "")
  assert_eq(receipt.inputs.converge_fleet, true)
  assert_eq(receipt.inputs.repositories_json, nil)
  assert_eq(receipt.inputs.expected_prs, [6664])
  assert_eq(receipt.run_id, 1001)
  assert_eq(receipt.replacement, nil)
}

pipeline test_read_only_audit_is_a_closed_hosted_mode(task: any) {
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const audit: HostedReleaseInputs = inputs() + {mode: "audit", converge_fleet: false}
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, audit, adapter)
  assert(is_ok(result))
  assert_eq(observed, audit)
}

pipeline test_invalid_source_pin_fails_before_dispatch(task: any) {
  let dispatches = 0
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) {
      dispatches = dispatches + 1
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const invalid: HostedReleaseInputs = {
    mode: "ship-pr",
    bump: "patch",
    prerelease_identifier: "",
    at_sha: "not-a-commit",
    converge_fleet: true,
    expected_prs: [],
  }
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, invalid, adapter)
  assert(is_err(result))
  assert_eq(unwrap_err(result).code, "invalid_inputs")
  assert_eq(dispatches, 0)
}

pipeline test_explicit_consumer_proof_runs_validate_before_dispatch(task: any) {
  let dispatches = 0
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) {
      dispatches = dispatches + 1
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const invalid = inputs() + {consumer_proof_runs_json: "{\"burin-labs/burin-code\":0}"}
  const refused = hosted_release_dispatch(REPO, WORKFLOW, REF, invalid, adapter)
  assert(is_err(refused))
  assert_eq(unwrap_err(refused).code, "invalid_inputs")
  assert_eq(dispatches, 0)
  const valid = inputs()
    + {consumer_proof_runs_json: "{ \"burin-labs/burin-code\" : 33993812541 }"}
  const accepted = hosted_release_dispatch(REPO, WORKFLOW, REF, valid, adapter)
  assert(is_ok(accepted))
  assert_eq(
    unwrap(accepted).inputs.consumer_proof_runs_json,
    "{\"burin-labs/burin-code\":33993812541}",
  )
  assert_eq(dispatches, 1)
}

pipeline test_legacy_receipt_inputs_normalize_without_expected_prs(task: any) {
  const legacy: HostedReleaseInputs = {
    mode: "ship-pr",
    bump: "patch",
    prerelease_identifier: "",
    at_sha: RELEASE_SHA,
    converge_fleet: true,
  }
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  assert(is_ok(hosted_release_dispatch(REPO, WORKFLOW, REF, legacy, adapter)))
  assert_eq(observed?.expected_prs, [])
  // A v1 receipt predates the resume input; replaying it must not resume.
  assert_eq(observed?.resume_tagged_release, false)
  assert_eq(observed?.consumer_proof_runs_json, nil)
  // Absence is the legacy full-fleet spelling; it must not become an explicit
  // empty scope, which the scope owner correctly refuses.
  assert_eq(observed?.repositories_json, nil)
}

pipeline test_explicit_repository_scope_is_normalized_and_persisted(task: any) {
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const scoped = inputs()
    + {
      repositories_json:
        "[\"burin-labs/harn-cloud\", \"burin-labs/20eq\",\"burin-labs/harn-bump-fleet\"]",
    }
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, scoped, adapter)
  assert(is_ok(result))
  const normalized =
    "[\"burin-labs/20eq\",\"burin-labs/harn-bump-fleet\",\"burin-labs/harn-cloud\"]"
  assert_eq(observed?.repositories_json, normalized)
  assert_eq(unwrap(result).inputs.repositories_json, normalized)
}

pipeline test_skip_consumers_becomes_one_exact_durable_inclusion_scope(
  harness: Harness,
  task: any,
) {
  const manifest = read_fleet_manifest(
    harness.fs,
    path_join(dirname(harness.fs.cwd()), "fleet.toml"),
  )
  const managed = harn_bump_repositories(manifest).map({ repo -> repo.slug }).to_list().sort()
  assert(len(managed) > 1)
  const skipped = managed[0]
  const normalized = hosted_release_repository_scope(manifest, nil, json_stringify([skipped]))
  assert_eq(normalized, json_stringify(managed.filter({ slug -> slug != skipped }).to_list()))
  assert_eq(contains(json_parse(unwrap(normalized)), skipped), false)
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const dispatched = hosted_release_dispatch(
    REPO,
    WORKFLOW,
    REF,
    inputs() + {repositories_json: unwrap(normalized)},
    adapter,
  )
  assert(is_ok(dispatched))
  assert_eq(observed?.repositories_json, normalized)
  assert_eq(unwrap(dispatched).inputs.repositories_json, normalized)
  assert(
    refused(
      { ->
        hosted_release_repository_scope(
          manifest,
          json_stringify([managed[1]]),
          json_stringify([skipped]),
        )
      },
    ),
    "public inclusion and exclusion selectors must not create competing scope identities",
  )
  assert_eq(
    hosted_release_repository_scope(manifest, nil, ""),
    nil,
    "blank is the one no-exclusion spelling",
  )
  assert(
    refused({ -> hosted_release_repository_scope(manifest, nil, "[]") }),
    "an explicit empty exclusion list must not masquerade as omission",
  )
}

pipeline test_empty_or_duplicate_repository_scope_fails_before_dispatch(task: any) {
  let dispatches = 0
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(_request) {
      dispatches = dispatches + 1
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  for repositories_json in [
    "[]",
    "[\"burin-labs/harn\",\"burin-labs/harn\"]",
    "not-json",
    "[\"burin-labs/harn-cloud\"]",
  ] {
    const result = hosted_release_dispatch(
      REPO,
      WORKFLOW,
      REF,
      inputs() + {repositories_json: repositories_json},
      adapter,
    )
    assert(is_err(result))
    assert_eq(unwrap_err(result).code, "invalid_inputs")
  }
  assert_eq(dispatches, 0)
}

pipeline test_dispatcher_refuses_unknown_scope_and_replacement_retarget_before_github(
  harness: Harness,
  task: any,
) {
  const root = dirname(harness.fs.cwd())
  const harn = pinned_test_runtime({fs: harness.fs, process: harness.process}, root)
  const entry = path_join(root, "dispatch_hosted_release.harn")
  const prefix = "cd "
    + shell_quote(root)
    + " && "
    + shell_quote(harn)
    + " run --no-sandbox "
    + shell_quote(entry)
    + " -- "
  const unknown = harness.process.shell(
    prefix + "--mode ship-pr --repositories-json '[\"burin-labs/not-managed\"]'",
  )
  assert_eq(unknown.success, false)
  assert(contains(unknown.combined, "not a managed Harn bump repository"), unknown.combined)
  const retarget = harness.process.shell(
    prefix
      + "--replace-receipt missing.json --repositories-json '[\"burin-labs/harn-cloud\"]'",
  )
  assert_eq(retarget.success, false)
  assert(contains(retarget.combined, "release input flags are not accepted"), retarget.combined)
  const unknown_skip = harness.process.shell(
    prefix + "--mode ship-pr --skip-consumers-json '[\"burin-labs/not-managed\"]'",
  )
  assert_eq(unknown_skip.success, false)
  assert(
    contains(unknown_skip.combined, "not a managed Harn bump repository"),
    unknown_skip.combined,
  )
}

/**
 * The falsifier for the line above: normalization must carry an explicit resume
 * through rather than defaulting every tuple to false, or the dispatcher would
 * accept `--resume-tagged-release` and silently drop it.
 */
pipeline test_resume_tagged_release_survives_normalization(task: any) {
  let observed: HostedReleaseInputs? = nil
  const adapter: HostedReleaseDispatchAdapter = {
    dispatch: fn(request) {
      observed = request
      return Ok(dispatch_receipt(1001))
    },
    run: fn(_id) { return Err({code: "unexpected_run_lookup"}) },
    cancel: fn(_id) { return Err({code: "unexpected_cancel"}) },
  }
  const resumed: HostedReleaseInputs = inputs() + {resume_tagged_release: true}
  const result = hosted_release_dispatch(REPO, WORKFLOW, REF, resumed, adapter)
  assert(is_ok(result))
  assert_eq(observed?.resume_tagged_release, true)
  assert_eq(unwrap(result).inputs.resume_tagged_release, true)
}

