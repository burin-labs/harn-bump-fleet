import {
  ReleaseLandingReceipt,
  release_landing_admission,
  release_landing_receipt,
} from "../lib/release_merge_lease"

const TAGGED = "1111111111111111111111111111111111111111"

const LANDED = "2222222222222222222222222222222222222222"

const TREE = "3333333333333333333333333333333333333333"

const OTHER_TREE = "4444444444444444444444444444444444444444"

const V010134_TAGGED = "4e23ab86944ddf96c62287fdb501285f7aa91eb6"

const V010134_LANDED = "a3542240916f3421a017f2f6b8854ba6c65fafb3"

const V010134_TREE = "00dbd7cac6cba5508061070b1197858e460d2579"

fn lease(method: "merge" | "rebase" | "squash") {
  return {
    repo: "burin-labs/harn",
    base_branch: "main",
    base_oid: "0000000000000000000000000000000000000000",
    candidate_pr: 8377,
    candidate_head: TAGGED,
    generation: "hosted-34325287636-attempt-1",
    tag: "v0.10.134",
    merge_method: method,
  }
}

fn merged_pull() {
  return {
    number: 8377,
    merged: true,
    merge_commit_oid: LANDED,
    base: {ref: "main"},
    head: {sha: TAGGED},
  }
}

fn landing(method: "merge" | "rebase" | "squash", merged_tree: string = TREE) {
  return release_landing_receipt(lease(method), merged_pull(), TREE, merged_tree)
}

pipeline test_merge_commit_landing_requires_candidate_and_merge_ancestry(task: any) {
  const accepted = release_landing_admission(
    landing("merge"),
    fn(oid) { return oid == TAGGED || oid == LANDED },
  )
  assert(accepted.valid)
  const missing_candidate = release_landing_admission(
    landing("merge"),
    fn(oid) { return oid == LANDED },
  )
  assert_eq(missing_candidate.valid, false)
}

pipeline test_identical_tree_squash_is_accepted_and_records_both_identities(task: any) {
  const receipt = landing("squash")
  const accepted = release_landing_admission(receipt, fn(oid) { return oid == LANDED })
  assert(accepted.valid)
  assert_eq(receipt?.tag_oid, TAGGED)
  assert_eq(receipt?.merge_commit_oid, LANDED)
  assert_eq(receipt?.release_pr, 8377)
  assert_eq(receipt?.candidate_tree_oid, receipt?.merged_tree_oid)
}

pipeline test_different_tree_squash_is_refused(task: any) {
  const refused = release_landing_admission(
    landing("squash", OTHER_TREE),
    fn(oid) { return oid == LANDED },
  )
  assert_eq(refused.valid, false)
  assert(contains(refused.reason, "tree differs"))
}

pipeline test_unrelated_merge_commit_is_refused(task: any) {
  const refused = release_landing_admission(landing("squash"), fn(oid) { return false })
  assert_eq(refused.valid, false)
  assert(contains(refused.reason, "not on main"))
}

fn v010134_replay() -> ReleaseLandingReceipt {
  return {
    schema_version: "harn_bump_fleet.release_landing.v1",
    tag_oid: V010134_TAGGED,
    release_pr: 8377,
    merge_method: "squash",
    merge_commit_oid: V010134_LANDED,
    merged_tree_oid: V010134_TREE,
    candidate_tree_oid: V010134_TREE,
  }
}

pipeline test_replay_automatic_recovery_run_34336207324(task: any) {
  const admitted = release_landing_admission(
    v010134_replay(),
    fn(oid) { return oid == V010134_LANDED },
  )
  assert(admitted.valid)
}

pipeline test_replay_manual_recovery_run_34340136016(task: any) {
  const admitted = release_landing_admission(
    v010134_replay(),
    fn(oid) { return oid == V010134_LANDED },
  )
  assert(admitted.valid)
}

pipeline test_landing_schema_and_all_consumers_share_one_accessor(harness: Harness) {
  assert(schema_is(v010134_replay(), schema_of(ReleaseLandingReceipt)))
  for path in [
    "../verify_release_recovery_identity.harn",
    "../lib/release_published_tail_live.harn",
    "../lib/release_tail_recovery.harn",
    "../report_failed_hosted_release.harn",
    "../lib/release_watch_runtime.harn",
  ] {
    const source = harness.fs.read_text(path)
    assert(contains(source, "release_landing_admission"))
    assert(!contains(source, "candidate_tree_oid =="))
  }
}
