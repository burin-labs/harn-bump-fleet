import {
  render_agent_guidance,
  resolve_projects_root,
  shared_agent_guidance_block,
  sync_agent_guidance_repo,
} from "../lib/agent_guidance"
import { FleetRepository } from "../lib/fleet_manifest"

fn sample_repo() -> FleetRepository {
  return {slug: "burin-labs/sample", directory: "sample"}
}

pipeline test_agent_guidance_append_preserves_local_rules() {
  const local = "# AGENTS.md\n\n## Commands\n\nRun `make test`.\n"
  const result = render_agent_guidance(local)
  assert(result.ok)
  assert(result.changed)
  assert(starts_with(result.text, local))
  assert(contains(result.text, "Run `make test`."))
  assert(contains(result.text, shared_agent_guidance_block()))
}

pipeline test_agent_guidance_replace_changes_only_owned_block() {
  const local = "# AGENTS.md\n\nBefore\n\n" + shared_agent_guidance_block() + "\n\nAfter\n"
  const result = render_agent_guidance(local)
  assert(result.ok)
  assert_eq(result.changed, false)
  assert_eq(result.text, local)
}

pipeline test_agent_guidance_rejects_malformed_markers() {
  const current =
    "# AGENTS.md\n\n<!-- BEGIN HARN SHARED AGENT CONTRACT: managed by harn-bump-fleet -->\n"
  const result = render_agent_guidance(current)
  assert_eq(result.ok, false)
  assert_eq(result.changed, false)
  assert(contains(result.error ?? "", "incomplete or duplicated"))
}

pipeline test_agent_guidance_root_expansion() {
  assert_eq(resolve_projects_root("~/projects", "/Users/test"), "/Users/test/projects")
  assert_eq(resolve_projects_root("~", "/Users/test"), "/Users/test")
  assert_eq(resolve_projects_root("/srv/repos", "/Users/test"), "/srv/repos")
}

pipeline test_agent_guidance_apply_is_idempotent_and_preserves_local_rules(harness: Harness) {
  const projects = harness.fs.mkdtemp_in_workspace("agent-guidance-")
  const repo = path_join(projects, "sample")
  harness.fs.mkdir(repo, true)
  harness.fs.write_text(path_join(repo, ".git"), "gitdir: fixture\n")
  harness.fs.write_text(path_join(repo, "AGENTS.md"), "# Local rules\n\nRun `make verify`.\n")
  const target = sample_repo()
  const applied = sync_agent_guidance_repo(
    {fs: harness.fs, tools: harness.tools},
    target,
    projects,
    true,
  )
  assert_eq(applied.status, "applied")
  const content = harness.fs.read_text(path_join(repo, "AGENTS.md"))
  assert(contains(content, "Run `make verify`."))
  assert(contains(content, shared_agent_guidance_block()))
  const checked = sync_agent_guidance_repo(
    {fs: harness.fs, tools: harness.tools},
    target,
    projects,
    false,
  )
  assert_eq(checked.status, "clean")
}

pipeline test_agent_guidance_apply_bootstraps_missing_canonical_file(harness: Harness) {
  const projects = harness.fs.mkdtemp_in_workspace("agent-guidance-empty-")
  const repo = path_join(projects, "sample")
  harness.fs.mkdir(repo, true)
  harness.fs.write_text(path_join(repo, ".git"), "gitdir: fixture\n")
  const target = sample_repo()
  const applied = sync_agent_guidance_repo(
    {fs: harness.fs, tools: harness.tools},
    target,
    projects,
    true,
  )
  assert_eq(applied.status, "applied")
  const content = harness.fs.read_text(path_join(repo, "AGENTS.md"))
  assert(starts_with(content, "# AGENTS.md\n"))
  assert(contains(content, shared_agent_guidance_block()))
}
