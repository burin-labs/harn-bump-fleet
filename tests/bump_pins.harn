import { cargo_harn_pin_probe, harn_version_pin_probe } from "../lib/bump_pins"

pipeline test_harn_version_pin_probe(task) {
  assert_eq(harn_version_pin_probe("v0.8.169\n").pin, "0.8.169")
  assert_eq(harn_version_pin_probe("0.8.169\n").pin, "0.8.169")
  assert_eq(harn_version_pin_probe("").pin, nil)
}

pipeline test_cargo_harn_pin_probe_single_version(task) {
  const cargo = join(
    [
      "[dependencies]",
      "harn-clock = \"=0.8.169\"",
      "harn-hostlib = { version = \"=0.8.169\", features = [\"git\"] }",
      "harn-serve = \"=0.8.169\"",
      "harn-vm = \"=0.8.169\"",
    ],
    "\n",
  )
  const probe = cargo_harn_pin_probe(cargo)
  assert_eq(probe.pin, "0.8.169")
  assert_eq(contains(probe.evidence, "harn-clock"), true)
  assert_eq(contains(probe.evidence, "harn-vm"), true)
}

pipeline test_cargo_harn_pin_probe_mixed_versions(task) {
  const cargo = join(
    [
      "[dependencies]",
      "harn-clock = \"=0.8.169\"",
      "harn-hostlib = \"=0.8.168\"",
      "harn-serve = \"=0.8.169\"",
      "harn-vm = \"=0.8.169\"",
    ],
    "\n",
  )
  const probe = cargo_harn_pin_probe(cargo)
  assert_eq(probe.pin, nil)
  assert_eq(contains(probe.evidence, "mixed"), true)
  assert_eq(contains(probe.evidence, "harn-hostlib=0.8.168"), true)
}

pipeline test_cargo_harn_pin_probe_ignores_repo_local_path_deps(task) {
  const cargo = join(
    [
      "[dependencies]",
      "harn-cloud-data = { path = \"crates/harn-cloud-data\" }",
      "harn-cloud-test-support = { path = \"crates/harn-cloud-test-support\" }",
      "harn-vm = \"=0.8.169\"",
    ],
    "\n",
  )
  const probe = cargo_harn_pin_probe(cargo)
  assert_eq(probe.pin, "0.8.169")
  assert_eq(contains(probe.evidence, "harn-cloud-data"), false)
}

pipeline test_cargo_harn_pin_probe_empty_when_only_repo_local_deps(task) {
  const cargo = join(
    [
      "[dependencies]",
      "harn-cloud-data = { path = \"crates/harn-cloud-data\" }",
      "harn-cloud-test-support = { path = \"crates/harn-cloud-test-support\" }",
    ],
    "\n",
  )
  const probe = cargo_harn_pin_probe(cargo)
  assert_eq(probe.pin, nil)
  assert_eq(contains(probe.evidence, "no exact Harn Cargo pins"), true)
}
