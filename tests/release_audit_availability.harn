import {
  EMPTY_AUDIT_FINDING,
  NO_VISIBLE_AUDIT_FINDING,
  audit_findings_are_availability_only,
  audit_findings_are_loop_status_only,
} from "../lib/release_audit"

/**
 * The release-readiness review is evidence, not an availability gate — but a
 * short findings list is not proof that the audit is sound.
 *
 * Three finding classes, three handlings:
 *
 *   availability — the review never arrived. A provider failure (auth, rate
 *     limit, empty response) that says nothing about the release. Advisory
 *     when deterministic release notes already exist.
 *   loop status  — the loop ended on something other than `done`. Says nothing
 *     about the audit either, BUT it is the shape a repair attempt that made
 *     no tool calls produces, so it is advisory ONLY alongside a closed
 *     evidence contract.
 *   content      — the review arrived and proposes a malformed draft. Always
 *     blocks; that draft would reach CHANGELOG.md.
 *
 * The trap this file exists to pin: in the ten investigated failures, a repair
 * attempt made zero tool calls and produced a polished audit that started with
 * `Audit:`, carried valid draft markers, and cited a PR and commit — resting on
 * no observation at all (`evidence.complete: false`). Its ONLY finding was the
 * loop-status one. Relaxing on "it was the only finding" would have shipped it.
 * Shape is not evidence.
 */
const CONTENT_FINDING = "agent draft changelog does not start with expected heading `## v0.10.115`"

const LOOP_STATUS_FINDING =
  "agent_loop ended with status `budget_exhausted` instead of `done`; the audit text may be incomplete"

pipeline test_an_absent_review_is_an_availability_finding() {
  assert_eq(audit_findings_are_availability_only([NO_VISIBLE_AUDIT_FINDING]), true)
  assert_eq(audit_findings_are_availability_only([EMPTY_AUDIT_FINDING]), true)
  assert_eq(
    audit_findings_are_availability_only([NO_VISIBLE_AUDIT_FINDING, EMPTY_AUDIT_FINDING]),
    true,
  )
}

pipeline test_content_findings_are_not_availability() {
  assert_eq(audit_findings_are_availability_only([CONTENT_FINDING]), false)
  // A single content finding among availability findings still blocks: the
  // draft it describes would reach CHANGELOG.md.
  assert_eq(
    audit_findings_are_availability_only([NO_VISIBLE_AUDIT_FINDING, CONTENT_FINDING]),
    false,
  )
}

pipeline test_no_findings_is_not_an_availability_result() {
  // An empty list means the review passed validation. It must not be reported
  // as "availability only", which would read as a degraded run.
  assert_eq(audit_findings_are_availability_only([]), false)
  assert_eq(audit_findings_are_loop_status_only([]), false)
}

pipeline test_loop_status_is_its_own_class() {
  assert_eq(audit_findings_are_loop_status_only([LOOP_STATUS_FINDING]), true)
  // It is NOT an availability finding; the review did arrive.
  assert_eq(audit_findings_are_availability_only([LOOP_STATUS_FINDING]), false)
}

pipeline test_loop_status_alongside_content_still_blocks() {
  assert_eq(audit_findings_are_loop_status_only([LOOP_STATUS_FINDING, CONTENT_FINDING]), false)
  assert_eq(
    audit_findings_are_loop_status_only(
      [
        LOOP_STATUS_FINDING,
        "agent evidence contract remained incomplete: missing a successful exact-range delta observation",
      ],
    ),
    false,
  )
}

/**
 * The load-bearing falsifier for this change.
 *
 * `audit_findings_are_loop_status_only` returning true is deliberately NOT
 * sufficient to relax the gate. If this classifier is ever wired up without
 * the `evidence_complete` conjunct, the six investigated releases would ship
 * on audits backed by zero observations.
 */
pipeline test_loop_status_only_is_insufficient_without_evidence() {
  const findings = [LOOP_STATUS_FINDING]
  assert_eq(audit_findings_are_loop_status_only(findings), true)
  // The exact shape observed in runs 31691040750 and 31691791479: sole
  // loop-status finding, zero tool calls, incomplete evidence contract.
  const evidence_complete = false
  const advisory = audit_findings_are_loop_status_only(findings) && evidence_complete
  assert_eq(advisory, false)
  // The same findings WITH a closed evidence contract may proceed.
  const evidenced_advisory = audit_findings_are_loop_status_only(findings) && true
  assert_eq(evidenced_advisory, true)
}
