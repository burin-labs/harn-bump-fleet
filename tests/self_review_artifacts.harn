import {
  run_artifact_read_json_result,
  run_artifact_write_json,
  run_artifact_write_json_raw,
  run_artifacts_from_dir,
} from "std/run_artifacts"
import {
  self_review_bump_run_summary,
  self_review_facts_descriptor,
  self_review_release_run_summary,
} from "../lib/self_review_artifacts"

fn artifact_run(kind) {
  const dir = path_join(harness.fs.temp_dir(), "self-review-artifacts-" + uuid_v7())
  return run_artifacts_from_dir(kind, dir)
}

fn release_receipt() {
  return {
    schema_version: "release_harn.audit.v1",
    run_id: "release-run",
    started_iso: "2026-07-19T10:00:00Z",
    finished_iso: "2026-07-19T10:00:01Z",
    duration_ms: 1000,
    operator: "operator",
    host: "host",
    config: {mode: "ship-pr"},
    analysis: {
      current_version: "1.2.2",
      next_version: "1.2.3",
      branch: "main",
      changelog_top: "1.2.3",
      deterministic_findings: ["stable"],
    },
    agent_review: "ok",
    agent_review_detail: {validation_findings: ["typed"]},
    execution: [{name: "check", success: true, status: "completed"}],
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
}

fn fleet_receipt() {
  return {
    schema_version: "harn_bump_fleet.audit.v1",
    run_id: "fleet-run",
    started_iso: "2026-07-19T10:00:00Z",
    finished_iso: "2026-07-19T10:00:01Z",
    duration_ms: 1000,
    operator: "operator",
    host: "host",
    target_version: "v1.2.3",
    mode: "live",
    repos_total: 1,
    repos_dispatched: 1,
    summary_model: "deterministic",
    summary_text: "ok",
    summary: {},
    outcomes: [{slug: "example/repo", status: "success", detail: "done"}],
    run_session_view: {},
    public_surface_impact: {},
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
}

pipeline test_self_review_summarizes_typed_release_and_fleet_receipts(task) {
  const release_run = artifact_run("release-harn")
  run_artifact_write_json_raw(release_run, "release-audit.json", release_receipt())
  run_artifact_write_json_raw(release_run, "agent-result.json", {status: "done"})
  const release = self_review_release_run_summary(harness, release_run.dir)
  assert_eq(release.ok, true)
  assert_eq(release.next_version, "1.2.3")
  assert_eq(release.execution_steps[0].classification, "")
  const fleet_run = artifact_run("bump-fleet")
  run_artifact_write_json_raw(fleet_run, "audit.json", fleet_receipt())
  const fleet = self_review_bump_run_summary(harness, fleet_run.dir)
  assert_eq(fleet.ok, true)
  assert_eq(fleet.status_counts.success, 1)
  assert_eq(fleet.outcome_refs[0].slug, "example/repo")
}

pipeline test_self_review_rejects_malformed_input_receipts_at_the_reader_boundary(task) {
  const run = artifact_run("release-harn")
  run_artifact_write_json_raw(run, "release-audit.json", {...release_receipt(), finished_iso: 42})
  const summary = self_review_release_run_summary(harness, run.dir)
  assert_eq(summary.ok, false)
  assert_eq(summary.error.kind, "schema_invalid")
}

pipeline test_self_review_facts_reject_wrong_versions_without_replacing_artifact(task) {
  const run = artifact_run("harness-self-review")
  run_artifact_write_json_raw(run, "facts.json", {sentinel: "preserve"})
  const invalid = {schema_version: "harn_bump_fleet.self_review.v0"}
  const result = try {
    run_artifact_write_json(run, self_review_facts_descriptor(), invalid)
  }
  assert(is_err(result))
  const decoded = run_artifact_read_json_result(run, self_review_facts_descriptor())
  assert(is_err(decoded))
  assert_eq(harness.fs.read_text(run.paths.facts), "{\"sentinel\":\"preserve\"}\n")
}
