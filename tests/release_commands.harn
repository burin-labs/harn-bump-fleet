import { append_std_command_step, append_std_github_command_step } from "../lib/release_commands"
import { fail, ok } from "../lib/shell_util"
import { user_timing_spans } from "../lib/timing_report"

pipeline test_release_commands(task) {
  let cfg = {repo: cwd()}
  let ok_step = append_std_command_step(
    harness,
    cfg,
    [],
    "sample",
    "printf sample",
    { _spec, _options -> ok("sample\n") },
  )
  assert_eq(ok_step.success, true)
  assert_eq(ok_step.step.classification, "ok")
  assert_eq(ok_step.step.stdout, "sample\n")
  let failed = append_std_command_step(
    harness,
    cfg,
    [],
    "lint",
    "make -s lint-md",
    { _spec, _options -> fail(2, "MD013 line too long") },
  )
  assert_eq(failed.success, false)
  assert_eq(failed.step.classification, "generated_markdown_lint_failed")
  assert(contains(failed.step.recovery_hint, "markdown lint"))
  mock_time(1700000000000)
  let retried = append_std_github_command_step(
    harness,
    cfg,
    [],
    "gh-transient",
    "gh pr list --repo burin-labs/harn",
    { _spec, _options ->
      if harness.clock.now_ms() == 1700000000000 {
        fail(1, "HTTP 503 service unavailable")
      } else {
        ok("[]\n")
      }
    },
  )
  assert_eq(retried.success, true)
  assert_eq(len(retried.step.attempts), 2)
  assert_eq(harness.clock.now_ms(), 1700000003000)
  unmock_time()
  // Argv-mode spec: list inputs build an argv command with the
  // shell-equivalent label lifted onto step.command so downstream classifiers
  // and audit logs still see a sensible string.
  let argv_step = append_std_command_step(
    harness,
    cfg,
    [],
    "argv-sample",
    ["git", "status", "--porcelain"],
    { spec, _options -> ok(spec.command ?? "") },
  )
  assert_eq(argv_step.success, true)
  assert_eq(argv_step.step.command, "git status --porcelain")
  assert_eq(argv_step.step.argv, ["git", "status", "--porcelain"])
  let command_spans = user_timing_spans().filter({ span -> span.name == "release.command" })
  assert(len(command_spans) >= 4)
  let argv_spans = command_spans.filter({ span -> span.attributes.step == "argv-sample" })
  assert_eq(len(argv_spans), 1)
  assert_eq(argv_spans[0].attributes.category, "git")
  assert_eq(argv_spans[0].status, "ok")
  let failed_spans = command_spans.filter({ span -> span.attributes.step == "lint" })
  assert_eq(len(failed_spans), 1)
  assert_eq(failed_spans[0].status, "error")
}
