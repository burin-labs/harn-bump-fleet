import { append_std_command_step, append_std_github_command_step } from "../lib/release_commands"
import { fail, ok } from "../lib/shell_util"

pipeline test_release_commands(task) {
  let cfg = {repo: cwd()}
  let ok_step = append_std_command_step(cfg, [], "sample", "printf sample", { _spec, _options -> ok("sample\n") })
  assert_eq(ok_step.success, true)
  assert_eq(ok_step.step.classification, "ok")
  assert_eq(ok_step.step.stdout, "sample\n")
  let failed = append_std_command_step(
    cfg,
    [],
    "lint",
    "make -s lint-md",
    { _spec, _options -> fail(2, "MD013 line too long") },
  )
  assert_eq(failed.success, false)
  assert_eq(failed.step.classification, "generated_markdown_lint_failed")
  assert(contains(failed.step.recovery_hint, "markdown lint"))
  mock_time(1700000000000)
  let retried = append_std_github_command_step(
    cfg,
    [],
    "gh-transient",
    "gh pr list --repo burin-labs/harn",
    { _spec, _options ->
      if now_ms() == 1700000000000 {
        fail(1, "HTTP 503 service unavailable")
      } else {
        ok("[]\n")
      }
    },
  )
  assert_eq(retried.success, true)
  assert_eq(len(retried.step.attempts), 2)
  assert_eq(now_ms(), 1700000003000)
  unmock_time()
}
