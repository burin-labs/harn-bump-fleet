import {
  ConsumerPretagGateReceipt,
  ConsumerPretagGateStatus,
  ConsumerPretagGateTarget,
  consumer_pretag_gate_targets,
  consumer_pretag_gate_verdict,
  resolve_consumer_pretag_inputs,
  validate_consumer_pretag_contract,
} from "../lib/consumer_pretag_gate"
import { FleetRepository } from "../lib/fleet_manifest"

fn thrown(callback: closure) -> string {
  return try {
    callback()
    ""
  } catch (e) {
    to_string(e)
  }
}

const CANDIDATE = {version: "v0.10.130", revision: "1234567890abcdef1234567890abcdef12345678"}

fn consumer(overrides: dict = {}) -> FleetRepository {
  return schema_expect(
    {
      slug: "owner/consumer",
      directory: "consumer",
      consumer_owned_contract: true,
      pretag_gate_workflow: "candidate-gate.yml",
      pretag_gate_inputs: {target: "{version}", source_revision: "{revision}"},
    }
      + overrides,
    FleetRepository,
  )
}

fn target(overrides: dict = {}) -> ConsumerPretagGateTarget {
  return schema_expect(
    {
      slug: "owner/consumer",
      workflow: "candidate-gate.yml",
      revision: CANDIDATE.revision,
      inputs: {},
    }
      + overrides,
    ConsumerPretagGateTarget,
  )
}

fn receipt(status: ConsumerPretagGateStatus, overrides: dict = {}) -> ConsumerPretagGateReceipt {
  return schema_expect(
    {
      slug: "owner/consumer",
      workflow: "candidate-gate.yml",
      status: status,
      run_url: "https://example.test/run/1",
      detail: "",
    }
      + overrides,
    ConsumerPretagGateReceipt,
  )
}

pipeline test_candidate_identity_reaches_the_consumers_own_input_names() {
  const targets = consumer_pretag_gate_targets([consumer()], CANDIDATE)
  assert_eq(len(targets), 1)
  assert_eq(targets[0]?.slug, "owner/consumer")
  assert_eq(targets[0]?.workflow, "candidate-gate.yml")
  assert_eq(
    targets[0]?.inputs,
    {target: "v0.10.130", source_revision: "1234567890abcdef1234567890abcdef12345678"},
  )
}

pipeline test_a_repository_that_declares_no_gate_is_not_a_target() {
  assert_eq(
    consumer_pretag_gate_targets(
      [consumer({pretag_gate_workflow: nil, pretag_gate_inputs: nil})],
      CANDIDATE,
    ),
    [],
  )
}

pipeline test_a_gate_that_never_receives_the_candidate_commit_is_refused() {
  // The falsifier for the whole mechanism. Inputs that carry only the version
  // would let the consumer resolve its own published pin and pass without ever
  // building the candidate, which is a gate that cannot fail.
  assert(
    contains(
      thrown({ -> validate_consumer_pretag_contract("candidate-gate.yml", {target: "{version}"}) }),
      "never sees the candidate",
    ),
  )
}

pipeline test_an_undispatchable_contract_is_refused_rather_than_skipped() {
  assert(
    contains(
      thrown({ -> validate_consumer_pretag_contract("../evil/gate.yml", {rev: "{revision}"}) }),
      "one workflow file name",
    ),
  )
  assert(
    contains(
      thrown({ -> validate_consumer_pretag_contract("candidate-gate.yml", {}) }),
      "at least one workflow input",
    ),
  )
  assert(
    contains(
      thrown(
        { -> validate_consumer_pretag_contract("candidate-gate.yml", {rev: "{revision}{sha}"}) },
      ),
      "unknown placeholder",
    ),
  )
  assert(
    contains(
      thrown(
        { -> validate_consumer_pretag_contract("candidate-gate.yml", {"bad name": "{revision}"}) },
      ),
      "workflow input identifier",
    ),
  )
}

pipeline test_a_malformed_candidate_is_refused_before_any_dispatch() {
  assert(
    contains(
      thrown({ -> consumer_pretag_gate_targets([consumer()], CANDIDATE + {revision: "abc"}) }),
      "40-character commit SHA",
    ),
  )
  assert(
    contains(
      thrown({ -> consumer_pretag_gate_targets([consumer()], CANDIDATE + {version: "latest"}) }),
      "release version",
    ),
  )
}

pipeline test_only_a_pass_proves_a_candidate() {
  const targets = [target()]
  assert(consumer_pretag_gate_verdict(targets, [receipt("passed")]).proven)
  const unproven_statuses: list<ConsumerPretagGateStatus> = ["failed", "pending", "unreadable"]
  for unproven in unproven_statuses {
    const verdict = consumer_pretag_gate_verdict(targets, [receipt(unproven)])
    assert(!verdict.proven, "'${unproven}' must not prove a candidate")
    assert_eq(verdict.declared, 1)
  }
  assert_eq(
    consumer_pretag_gate_verdict(targets, [receipt("failed")]).failing,
    ["owner/consumer:candidate-gate.yml"],
  )
  assert_eq(
    consumer_pretag_gate_verdict(targets, [receipt("pending")]).pending,
    ["owner/consumer:candidate-gate.yml"],
  )
}

pipeline test_a_target_that_answered_nothing_is_named_not_omitted() {
  // Silence is the quietest way a gate reads green. A declared target with no
  // receipt must appear, and must leave the candidate unproven.
  const verdict = consumer_pretag_gate_verdict([target()], [])
  assert(!verdict.proven)
  assert_eq(verdict.unreadable, ["owner/consumer:candidate-gate.yml (no receipt)"])
  assert_eq(verdict.declared, 1)
}

pipeline test_measuring_nothing_is_distinguishable_from_measuring_zero_failures() {
  const nothing = consumer_pretag_gate_verdict([], [])
  const everything = consumer_pretag_gate_verdict([target()], [receipt("passed")])
  assert(nothing.proven)
  assert(everything.proven)
  assert_eq(nothing.declared, 0)
  assert_eq(everything.declared, 1)
  assert(contains(nothing.summary, "no consumer declared a pre-tag gate"))
  assert(contains(everything.summary, "1/1 consumer pre-tag gates passed"))
}

pipeline test_templates_substitute_every_occurrence() {
  assert_eq(
    resolve_consumer_pretag_inputs({ref: "{version}-{revision}-{version}"}, CANDIDATE),
    {ref: "v0.10.130-1234567890abcdef1234567890abcdef12345678-v0.10.130"},
  )
}
