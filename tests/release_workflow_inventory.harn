import { release_workflow_inventory_with_reader } from "../lib/release_workflow_inventory"

const CANDIDATE = "1111111111111111111111111111111111111111"

const MERGED = "2222222222222222222222222222222222222222"

const WINDOWS_CANDIDATE = """
name: Windows nightly
on:
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (windows-latest)
    steps:
      - run: cargo nextest run
"""

const WINDOWS_MERGED = """
name: Windows nightly
on:
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (windows-latest)
    steps:
      - run: cargo nextest run
  release-audit:
    name: Audit merged release policy
    steps:
      - run: ./scripts/release-audit.sh
"""

const MACOS = """
name: macOS nightly
on:
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (macos-latest)
    steps:
      - run: cargo nextest run
"""

const WINDOWS_PULL_REQUEST = """
name: Windows nightly
on:
  pull_request:
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (windows-latest)
    steps:
      - run: cargo nextest run
"""

const MACOS_PULL_REQUEST = """
name: macOS nightly
on:
  pull_request:
  workflow_dispatch:
jobs:
  nextest:
    name: Workspace nextest (macos-latest)
    steps:
      - run: cargo nextest run
"""

const CI = """
name: CI
on:
  push:
    branches: [main]
jobs:
  status:
    name: CI status
    steps:
      - run: cargo check
"""

/**
 * The end-to-end suite, reduced to what the inventory reads. Its shape is the
 * whole point: a push trigger to the default branch makes it branch-covered, so
 * it is not release-only, and no ruleset requires it, so it was in neither set
 * the release computed until a repository could declare it.
 */
const E2E = """
name: CLI end-to-end behavior
on:
  push:
    branches: [main]
  schedule:
    - cron: "0 3 * * *"
  pull_request:
    types: [labeled, synchronize]
  workflow_dispatch:
jobs:
  capacity:
    name: Name the E2E runner capacity decision
    steps:
      - run: ./scripts/decide-runner.sh
  e2e:
    name: Slow E2E suite
    steps:
      - run: cargo nextest run --profile e2e
"""

fn source_at(revision: string, path: string) -> Result<string, string> {
  if path == ".github/workflows/e2e.yml" {
    return Ok(E2E)
  }
  if path == ".github/workflows/windows-nightly.yml" {
    return Ok(
      if revision == MERGED {
        WINDOWS_MERGED
      } else {
        WINDOWS_CANDIDATE
      },
    )
  }
  if path == ".github/workflows/macos-nightly.yml" {
    return Ok(MACOS)
  }
  if path == ".github/workflows/ci.yml" {
    return Ok(CI)
  }
  return Err("unexpected workflow path ${path}")
}

/**
 * Falsifier for reading the watcher's frozen checkout: the candidate does not
 * define the job that the final merged revision introduces.
 */
pipeline test_final_revision_inventory_includes_a_new_release_only_job(task: any) {
  const candidate = release_workflow_inventory_with_reader(CANDIDATE, source_at)
  const merged = release_workflow_inventory_with_reader(MERGED, source_at)
  assert(!candidate.release_only.checks.contains("Audit merged release policy"))
  assert(merged.release_only.checks.contains("Audit merged release policy"))
  assert(merged.all.checks.contains("Audit merged release policy"))
  assert_eq(merged.revision, MERGED)
  assert_eq(
    merged.release_only.source_workflows,
    [".github/workflows/macos-nightly.yml", ".github/workflows/windows-nightly.yml"],
  )
}

/** Missing input is not an empty, successfully measured lane inventory. */
pipeline test_exact_revision_inventory_fails_when_a_registered_workflow_is_missing(task: any) {
  const missing = { revision, path ->
    if path == ".github/workflows/macos-nightly.yml" {
      return Err("missing at ${revision}")
    }
    return source_at(revision, path)
  }
  const failure = try {
    release_workflow_inventory_with_reader(MERGED, missing)
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(failure, ".github/workflows/macos-nightly.yml"))
  assert(contains(failure, MERGED))
}

/** A symbolic or partial ref cannot become the persisted revision identity. */
pipeline test_exact_revision_inventory_rejects_a_symbolic_revision(task: any) {
  const failure = try {
    release_workflow_inventory_with_reader("origin/main", source_at)
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(failure, "exact 40-character revision"))
}

/** A complete exact inventory can legitimately contain zero release-only jobs. */
pipeline test_exact_revision_inventory_preserves_a_measured_zero(task: any) {
  const all_pull_request = { _revision, path ->
    if path == ".github/workflows/windows-nightly.yml" {
      return Ok(WINDOWS_PULL_REQUEST)
    }
    if path == ".github/workflows/macos-nightly.yml" {
      return Ok(MACOS_PULL_REQUEST)
    }
    return source_at(_revision, path)
  }
  const inventory = release_workflow_inventory_with_reader(MERGED, all_pull_request)
  assert_eq(inventory.release_only.checks, [])
  assert_eq(inventory.release_only.source_workflows, [])
  assert(inventory.pull_request.checks.contains("Workspace nextest (macos-latest)"))
  assert(inventory.pull_request.checks.contains("Workspace nextest (windows-latest)"))
}

/**
 * A declared release context has to be checkable, and that means the workflow
 * producing it has to be in the registry the release reads.
 *
 * `Slow E2E suite` belongs to `all` and to neither of the other two sets. That
 * is the exact shape of the gap: branch-covered, so the release-only classifier
 * correctly does not wait for it, and folded into the branch aggregate, so it
 * is not a pull-request lane either. Nothing read it until a repository could
 * name it, and naming it is only meaningful if the release can tell "declared
 * and not green" from "declared and no longer exists".
 */
pipeline test_the_registry_carries_the_branch_covered_end_to_end_suite(task: any) {
  const inventory = release_workflow_inventory_with_reader(MERGED, source_at)
  assert(inventory.all.checks.contains("Slow E2E suite"))
  assert(inventory.all.source_workflows.contains(".github/workflows/e2e.yml"))
  assert_eq(inventory.release_only.checks.contains("Slow E2E suite"), false)
  assert_eq(inventory.pull_request.checks.contains("Slow E2E suite"), false)
}

/** A registered workflow that cannot be read is not a smaller inventory. */
pipeline test_a_missing_end_to_end_workflow_refuses_the_inventory(task: any) {
  const missing = { revision, path ->
    if path == ".github/workflows/e2e.yml" {
      return Err("missing at ${revision}")
    }
    return source_at(revision, path)
  }
  const failure = try {
    release_workflow_inventory_with_reader(MERGED, missing)
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(failure, ".github/workflows/e2e.yml"))
}
