import {
  HeartbeatReconciliation,
  PinStalenessHeartbeatOptions,
  reconcile_heartbeat,
} from "../check_fleet_pin_staleness_heartbeat.harn"
import {
  HEARTBEAT_ISSUE_MARKER,
  HEARTBEAT_LABEL,
  HeartbeatVerdict,
  heartbeat_issue_title,
  pin_staleness_heartbeat_verdict,
} from "../lib/fleet_pin_heartbeat"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const SLUG = "burin-labs/harn-bump-fleet"

const ISSUES = BASE + "/repos/burin-labs/harn-bump-fleet/issues"

const NOW = "2026-08-28T13:37:00Z"

type IssueCreateBody = {title: string, body: string, labels: list<string>, ...rest}

type IssueUpdateBody = {state?: string, title?: string, body?: string, ...rest}

fn sent_create(raw: string) -> IssueCreateBody {
  return schema_expect(json_parse(raw), IssueCreateBody)
}

fn sent_update(raw: string) -> IssueUpdateBody {
  return schema_expect(json_parse(raw), IssueUpdateBody)
}

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "heartbeat-write-path-token"}
}

fn plan(dry_run: bool = false) -> PinStalenessHeartbeatOptions {
  return {
    repo: SLUG,
    workflow: "fleet-pin-staleness.yml",
    max_age_days: "2",
    dry_run: dry_run,
    run_url: nil,
  }
}

fn silent_verdict() -> HeartbeatVerdict {
  return pin_staleness_heartbeat_verdict([], NOW, 2)
}

fn fresh_verdict() -> HeartbeatVerdict {
  return pin_staleness_heartbeat_verdict(
    [
      {
        id: 11,
        status: "completed",
        conclusion: "success",
        created_at: "2026-08-28T11:37:00Z",
        updated_at: "2026-08-28T11:37:00Z",
        url: "https://github.test/runs/11",
      },
    ],
    NOW,
    2,
  )
}

fn existing_alarm() -> dict {
  return {
    number: 42,
    title: heartbeat_issue_title(),
    body: HEARTBEAT_ISSUE_MARKER + "\n\nolder body",
    state: "open",
  }
}

fn mock_open_issues(testing: HarnessTesting, issues: list<dict>) {
  testing.http_mock(
    "GET",
    ISSUES + "?labels=${HEARTBEAT_LABEL}&per_page=100&state=open",
    {status: 200, body: json_stringify(issues)},
  )
}

fn reconcile(
  harness: Harness,
  verdict: HeartbeatVerdict,
  dry_run: bool = false,
) -> HeartbeatReconciliation {
  return reconcile_heartbeat(harness, verdict, plan(dry_run), 2, options())
}

pipeline test_silence_opens_one_labelled_heartbeat_issue(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [])
  harness.testing.http_mock("POST", ISSUES, {status: 201, body: json_stringify({number: 7})})
  const result = reconcile(harness, silent_verdict())
  assert(result.ok, result.detail)
  assert_eq(result.action, "opened")
  const posts =
    harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()
  assert_eq(len(posts), 1, "exactly one issue is created")
  const sent = sent_create(posts[0].body)
  assert_eq(sent.labels, [HEARTBEAT_LABEL])
  assert_eq(sent.title, heartbeat_issue_title())
  assert(contains(sent.body, HEARTBEAT_ISSUE_MARKER), sent.body)
}

pipeline test_an_existing_heartbeat_issue_is_refreshed_rather_than_duplicated(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [existing_alarm()])
  harness.testing.http_mock(
    "PATCH",
    ISSUES + "/42",
    {status: 200, body: json_stringify({number: 42})},
  )
  const result = reconcile(harness, silent_verdict())
  assert(result.ok, result.detail)
  assert_eq(result.action, "refreshed")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()),
    0,
    "refreshing must not open a second issue",
  )
}

pipeline test_a_fresh_pulse_closes_the_heartbeat_issue(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [existing_alarm()])
  harness.testing.http_mock(
    "PATCH",
    ISSUES + "/42",
    {status: 200, body: json_stringify({number: 42})},
  )
  const result = reconcile(harness, fresh_verdict())
  assert(result.ok, result.detail)
  assert_eq(result.action, "closed")
  const sent = sent_update(
    harness.testing.http_mock_calls().filter({ call -> call.method == "PATCH" }).to_list()[0].body,
  )
  assert_eq(sent.state, "closed")
}

pipeline test_a_labelled_pull_request_is_not_mistaken_for_the_heartbeat_issue(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    ISSUES + "?labels=${HEARTBEAT_LABEL}&per_page=100&state=open",
    {
      status: 200,
      body: json_stringify(
        [
          {
            number: 99,
            title: heartbeat_issue_title(),
            body: HEARTBEAT_ISSUE_MARKER,
            state: "open",
            pull_request: {url: "https://github.test/pulls/99"},
          },
        ],
      ),
    },
  )
  harness.testing.http_mock("POST", ISSUES, {status: 201, body: json_stringify({number: 8})})
  assert_eq(reconcile(harness, silent_verdict()).action, "opened")
}

pipeline test_dry_run_decides_without_writing(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [])
  const result = reconcile(harness, silent_verdict(), true)
  assert(result.ok, result.detail)
  assert_eq(result.action, "would_open")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method != "GET" }).to_list()),
    0,
    "a dry run never writes",
  )
}

pipeline test_a_failed_write_is_reported_not_swallowed(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [])
  harness.testing.http_mock(
    "POST",
    ISSUES,
    {status: 403, body: json_stringify({message: "Resource not accessible by integration"})},
  )
  const result = reconcile(harness, silent_verdict())
  assert(!result.ok, "a refused issue write must not report success")
  assert_eq(result.action, "open_failed")
}

pipeline test_a_failed_issue_probe_is_reported_not_treated_as_empty(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    ISSUES + "?labels=${HEARTBEAT_LABEL}&per_page=100&state=open",
    {status: 500, body: json_stringify({message: "server error"})},
  )
  const result = reconcile(harness, silent_verdict())
  assert(!result.ok, "a failed probe must not read as an empty issue list")
  assert_eq(result.action, "probe_failed")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()),
    0,
    "a failed probe must not fall through into opening a duplicate",
  )
}
