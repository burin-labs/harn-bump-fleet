import {
  ReleaseOwnerConfig,
  ReleaseOwnerIdentity,
  owner_reclaimed_dead_for_version,
  release_owner_guard_acquire,
  release_owner_guard_finish,
  release_owner_guard_required,
  release_owner_guard_update,
  release_owner_lease_options,
} from "../lib/release_owner_guard"

fn live_cfg(domain: string) -> ReleaseOwnerConfig {
  return {
    mode: "ship-pr",
    yes_live_release: true,
    repo: "/tmp/harn",
    base: "main",
    bump: "patch",
    pin_sha: "abc123",
    owner_guard_domain: domain,
  }
}

pipeline test_release_owner_guard_required_only_for_live_mutations(task: any) {
  assert_eq(release_owner_guard_required({mode: "audit", yes_live_release: true}), false)
  assert_eq(release_owner_guard_required({mode: "prepare", yes_live_release: false}), false)
  assert_eq(
    release_owner_guard_required({mode: "ship-pr", yes_live_release: true, mock: true}),
    false,
  )
  assert_eq(release_owner_guard_required({mode: "prepare", yes_live_release: true}), true)
  assert_eq(release_owner_guard_required({mode: "ship-pr", yes_live_release: true}), true)
}

pipeline test_abandon_takes_the_lane_in_both_modes(task: any) {
  // Abandoning inspects the refs a live release is mid-way through pushing, so
  // its dry run must serialize too: the plan a dry run prints is what an
  // operator acts on, and a plan sampled mid-cut classifies an in-flight
  // candidate as an unclaimed orphan.
  assert_eq(release_owner_guard_required({mode: "abandon", yes_live_release: false}), true)
  assert_eq(release_owner_guard_required({mode: "abandon", yes_live_release: true}), true)
  assert_eq(
    release_owner_guard_required({mode: "abandon", yes_live_release: true, mock: true}),
    false,
  )
}

@serial(group: "host-lease-store")
pipeline test_a_live_release_blocks_an_abandon_on_the_same_lane(harness: Harness, task: any) {
  // The exact incident this guard exists for: a release is mid-cut for a
  // version, holding the lane, and an abandon run for that same version must
  // not get far enough to classify — let alone archive — its candidates.
  const domain = "release-owner-" + harness.random.uuid_v7()
  const releasing = release_owner_guard_acquire(
    harness.host_lease,
    live_cfg(domain),
    {current_version: "1.2.2", next_version: "1.2.3"},
    "release-run",
  )
  assert_eq(releasing.state, "owned")
  let abandon_cfg = live_cfg(domain)
  abandon_cfg["mode"] = "abandon"
  abandon_cfg["yes_live_release"] = false
  const refused = try {
    release_owner_guard_acquire(harness.host_lease, abandon_cfg, {next_version: "1.2.3"}, "abandon")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(refused, "another live Harn release"))
  assert(contains(refused, "release-run"))
  release_owner_guard_finish(harness.host_lease, releasing, "ok", true)
  // Once the release lets go, the same abandon run proceeds against settled refs.
  const allowed = release_owner_guard_acquire(
    harness.host_lease,
    abandon_cfg,
    {next_version: "1.2.3"},
    "abandon",
  )
  assert_eq(allowed.state, "owned")
  assert_eq(allowed.record.next_version, "1.2.3")
  release_owner_guard_finish(harness.host_lease, allowed, "ok", true)
}

@serial(group: "host-lease-store")
pipeline test_an_abandon_in_flight_blocks_a_release_from_starting(harness: Harness, task: any) {
  // The lane is symmetric. A release must not begin minting candidates while an
  // abandon run is part-way through rewriting that version's attempt refs.
  const domain = "release-owner-" + harness.random.uuid_v7()
  let abandon_cfg = live_cfg(domain)
  abandon_cfg["mode"] = "abandon"
  abandon_cfg["yes_live_release"] = true
  const abandoning = release_owner_guard_acquire(
    harness.host_lease,
    abandon_cfg,
    {next_version: "1.2.3"},
    "abandon-run",
  )
  assert_eq(abandoning.state, "owned")
  const refused = try {
    release_owner_guard_acquire(
      harness.host_lease,
      live_cfg(domain),
      {next_version: "1.2.3"},
      "rel",
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(refused, "abandon-run"))
  release_owner_guard_finish(harness.host_lease, abandoning, "ok", true)
}

pipeline test_release_owner_lease_options_are_typed_and_stable(task: any) {
  const options = release_owner_lease_options(
    live_cfg("release-owner-test"),
    {current_version: "1.2.2", next_version: "1.2.3"},
    "run-a",
  )
  assert_eq(options.resource_class, "whole-machine")
  assert_eq(options.domain, "release-owner-test")
  assert_eq(options.wait_timeout_ms, 0)
  assert_eq(options.metadata.next_version, "1.2.3")
  assert_eq(options.metadata.tag, "v1.2.3")
  assert_eq(options.metadata.pin_sha, "abc123")
}

@serial(group: "host-lease-store")
pipeline test_release_owner_lease_blocks_then_releases_in_process(harness: Harness, task: any) {
  const cfg = live_cfg("release-owner-" + harness.random.uuid_v7())
  const first = release_owner_guard_acquire(
    harness.host_lease,
    cfg,
    {current_version: "1.2.2", next_version: "1.2.3"},
    "run-a",
  )
  if first.state != "owned" {
    throw "expected live owner guard"
  }
  assert_eq(first.state, "owned")
  assert_eq(first.record.next_version, "1.2.3")
  const blocked = try {
    release_owner_guard_acquire(harness.host_lease, cfg, {next_version: "1.2.3"}, "run-b")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "another live Harn release"))
  const finished = release_owner_guard_finish(harness.host_lease, first, "ok", true)
  assert_eq(finished.released, true)
  const second = release_owner_guard_acquire(
    harness.host_lease,
    cfg,
    {next_version: "1.2.3"},
    "run-b",
  )
  assert_eq(second.state, "owned")
  release_owner_guard_finish(harness.host_lease, second, "ok", true)
}

@serial(group: "host-lease-store")
pipeline test_release_owner_update_replaces_metadata_under_same_guard(harness: Harness, task: any) {
  const cfg = live_cfg("release-owner-" + harness.random.uuid_v7())
  const owner = release_owner_guard_acquire(harness.host_lease, cfg, {}, "run-a")
  if owner.state != "owned" {
    throw "expected live owner guard"
  }
  let updated_cfg = cfg
  updated_cfg["pin_sha"] = "def456"
  const updated = release_owner_guard_update(
    harness.host_lease,
    owner,
    updated_cfg,
    {current_version: "1.2.2", next_version: "1.2.3"},
  )
  if updated.state != "owned" {
    throw "expected updated owner guard"
  }
  assert_eq(updated.record.next_version, "1.2.3")
  assert_eq(updated.record.pin_sha, "def456")
  assert_eq(updated.record.lease_id, owner.record.lease_id)
  const finished = release_owner_guard_finish(harness.host_lease, updated, "ok", true)
  assert_eq(finished.released, true)
}

fn reclaimed_identity(next_version: string) -> ReleaseOwnerIdentity {
  return {
    run_id: "prior-run",
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    current_version: "1.2.2",
    next_version: next_version,
    tag: "v" + next_version,
    pin_sha: "abc123",
    owner: "release-harn.prior-run",
    host: "local",
    owner_pid: 42,
    lease_id: "prior-lease",
    domain: "release-owner-test",
  }
}

@serial(group: "host-lease-store")
pipeline test_dead_owner_reclaim_requires_exact_version_metadata(harness: Harness, task: any) {
  let owner = release_owner_guard_acquire(
    harness.host_lease,
    live_cfg("release-owner-" + harness.random.uuid_v7()),
    {},
    "run-a",
  )
  if owner.state != "owned" {
    throw "expected live owner guard"
  }
  assert_eq(owner_reclaimed_dead_for_version(owner, "1.2.3"), false)
  let record = owner.record
  record["reclaimed_prior"] = reclaimed_identity("1.2.3")
  owner["record"] = record
  assert_eq(owner_reclaimed_dead_for_version(owner, "1.2.3"), true)
  assert_eq(owner_reclaimed_dead_for_version(owner, "1.2.4"), false)
  release_owner_guard_finish(harness.host_lease, owner, "ok", true)
}
