pipeline test_release_owner_guard_records_real_pid_when_unpinned(task) {
  mock_time(1700000000000)
  let root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  let path = path_join(root, "owner.json")
  // No owner_guard_pid / HARN_RELEASE_OWNER_PID: the guard must record its own
  // real pid so a later run can probe this record's liveness. A 0 here is the
  // defect that let a crashed run be mistaken for a live one.
  let cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
    owner_guard_ttl_ms: 60000,
  }
  let acquired = release_owner_guard_acquire(harness, cfg, {next_version: "0.9.1"}, "run-a")
  assert_eq(acquired.enabled, true)
  assert(acquired.record.owner_pid > 0)
  let persisted = json_parse(harness.fs.read_text(path))
  assert(persisted.owner_pid > 0)
  unmock_time()
}

pipeline test_release_owner_guard_reclaims_orphaned_pid_when_no_live_process(task) {
  // Reproduces the stalled-cut scenario: a crashed run left status=active with
  // owner_pid=0 on this host. With no live release_harn process, the guard
  // auto-reclaims with a receipt instead of demanding a manual takeover.
  mock_time(1700000000000)
  let root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  let path = path_join(root, "owner.json")
  harness.fs.mkdir(root, true)
  harness.fs
    .write_text(
    path,
    json_stringify(
      {
        schema_version: 1,
        status: "active",
        run_id: "crashed-run",
        repo: "/tmp/harn",
        base: "main",
        mode: "ship-pr",
        bump: "patch",
        next_version: "0.10.17",
        tag: "v0.10.17",
        pin_sha: "abc123",
        operator: "ksinder",
        host: hostname(),
        owner_pid: 0,
        started_iso: "2026-07-14T13:00:00Z",
        started_ms: 1699999990000,
        updated_ms: 1699999990000,
        ttl_ms: 43200000,
        path: path,
      },
    ),
  )
  let cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "def456",
    owner_guard_path: path,
    owner_guard_ttl_ms: 43200000,
    owner_guard_pid: 5252,
    owner_guard_host_process_alive: false,
    owner_guard_existing_owner_completed: false,
  }
  let acquired = release_owner_guard_acquire(
    harness,
    cfg,
    {current_version: "0.10.16", next_version: "0.10.17"},
    "fresh-run",
  )
  assert_eq(acquired.enabled, true)
  assert_eq(acquired.decision.action, "replace_orphaned_lock")
  assert_eq(acquired.record.run_id, "fresh-run")
  assert_eq(acquired.record.owner_pid, 5252)
  assert_eq(acquired.record.reclaimed_prior.run_id, "crashed-run")
  assert_eq(acquired.record.reclaimed_prior.owner_pid, 0)
  unmock_time()
}

pipeline test_release_owner_guard_blocks_orphaned_pid_while_a_live_process_exists(task) {
  // Same orphaned owner_pid=0 record, but a live release_harn process is still
  // running on the host: reclaiming would let two lanes push the same tag, so
  // the guard must block instead.
  mock_time(1700000000000)
  let root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  let path = path_join(root, "owner.json")
  harness.fs.mkdir(root, true)
  harness.fs
    .write_text(
    path,
    json_stringify(
      {
        schema_version: 1,
        status: "active",
        run_id: "live-run",
        repo: "/tmp/harn",
        base: "main",
        mode: "ship-pr",
        bump: "patch",
        next_version: "0.10.17",
        tag: "v0.10.17",
        pin_sha: "abc123",
        operator: "ksinder",
        host: hostname(),
        owner_pid: 0,
        started_iso: "2026-07-14T13:00:00Z",
        started_ms: 1699999990000,
        updated_ms: 1699999990000,
        ttl_ms: 43200000,
        path: path,
      },
    ),
  )
  let cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "def456",
    owner_guard_path: path,
    owner_guard_ttl_ms: 43200000,
    owner_guard_host_process_alive: true,
    owner_guard_existing_owner_completed: false,
  }
  let blocked = try {
    release_owner_guard_acquire(
      harness,
      cfg,
      {current_version: "0.10.16", next_version: "0.10.17"},
      "fresh-run",
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "another live Harn release appears active"))
  assert(contains(blocked, "live-run"))
  let persisted = json_parse(harness.fs.read_text(path))
  assert_eq(persisted.run_id, "live-run")
  unmock_time()
}

pipeline test_release_owner_guard_blocks_when_atomic_lock_is_held(task) {
  mock_time(1700000000000)
  let root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  let path = path_join(root, "owner.json")
  let lock = release_owner_lock_path(path)
  let _ = coord_acquire_dir_lock(
    path,
    {
      id: "run-held",
      run_id: "run-held",
      repo: "/tmp/harn",
      mode: "ship-pr",
      operator: "codex",
      host: "workstation",
    },
    {lock_path: lock, ttl_ms: 60000, token: "held-lock"},
  )
  let cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
    owner_guard_lock_ttl_ms: 60000,
  }
  let blocked = try {
    release_owner_guard_acquire(harness, cfg, {next_version: "0.9.1"}, "run-b")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "release owner guard lock is held"))
  assert(contains(blocked, "run-held"))
  assert_eq(harness.fs.exists(path), false)
  unmock_time()
}

pipeline test_release_owner_guard_update_blocks_when_atomic_lock_is_held(task) {
  mock_time(1700000000000)
  let root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  let path = path_join(root, "owner.json")
