import {
  owner_reclaimed_dead_for_version,
  release_owner_guard_acquire,
  release_owner_guard_finish,
  release_owner_guard_required,
  release_owner_guard_update,
  release_owner_lease_options,
} from "../lib/release_owner_guard"

fn live_cfg(domain) {
  return {
    mode: "ship-pr",
    yes_live_release: true,
    repo: "/tmp/harn",
    base: "main",
    bump: "patch",
    pin_sha: "abc123",
    owner_guard_domain: domain,
  }
}

pipeline test_release_owner_guard_required_only_for_live_mutations(task) {
  assert_eq(release_owner_guard_required({mode: "audit", yes_live_release: true}), false)
  assert_eq(release_owner_guard_required({mode: "prepare", yes_live_release: false}), false)
  assert_eq(
    release_owner_guard_required({mode: "ship-pr", yes_live_release: true, mock: true}),
    false,
  )
  assert_eq(release_owner_guard_required({mode: "prepare", yes_live_release: true}), true)
  assert_eq(release_owner_guard_required({mode: "ship-pr", yes_live_release: true}), true)
}

pipeline test_release_owner_lease_options_are_typed_and_stable(task) {
  const options = release_owner_lease_options(
    live_cfg("release-owner-test"),
    {current_version: "1.2.2", next_version: "1.2.3"},
    "run-a",
  )
  assert_eq(options.resource_class, "whole-machine")
  assert_eq(options.domain, "release-owner-test")
  assert_eq(options.wait_timeout_ms, 0)
  assert_eq(options.metadata.next_version, "1.2.3")
  assert_eq(options.metadata.tag, "v1.2.3")
  assert_eq(options.metadata.pin_sha, "abc123")
}

pipeline test_release_owner_lease_blocks_then_releases_in_process(task) {
  const cfg = live_cfg("release-owner-" + uuid_v7())
  const first = release_owner_guard_acquire(
    harness,
    cfg,
    {current_version: "1.2.2", next_version: "1.2.3"},
    "run-a",
  )
  assert_eq(first.enabled, true)
  assert_eq(first.record.next_version, "1.2.3")
  const blocked = try {
    release_owner_guard_acquire(harness, cfg, {next_version: "1.2.3"}, "run-b")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "another live Harn release"))
  const finished = release_owner_guard_finish(harness, first, "ok", true)
  assert_eq(finished.released, true)
  const second = release_owner_guard_acquire(harness, cfg, {next_version: "1.2.3"}, "run-b")
  assert_eq(second.enabled, true)
  release_owner_guard_finish(harness, second, "ok", true)
}

pipeline test_release_owner_update_replaces_metadata_under_same_guard(task) {
  const cfg = live_cfg("release-owner-" + uuid_v7())
  const owner = release_owner_guard_acquire(harness, cfg, {}, "run-a")
  const updated = release_owner_guard_update(
    harness,
    owner,
    {...cfg, pin_sha: "def456"},
    {current_version: "1.2.2", next_version: "1.2.3"},
  )
  assert_eq(updated.record.next_version, "1.2.3")
  assert_eq(updated.record.pin_sha, "def456")
  assert_eq(updated.record.lease_id, owner.record.lease_id)
  assert_eq(release_owner_guard_finish(harness, updated, "ok", true).released, true)
}

pipeline test_dead_owner_reclaim_requires_exact_version_metadata(task) {
  const owner = {enabled: true, acquire: {recovered: {metadata: {next_version: "1.2.3"}}}}
  assert_eq(owner_reclaimed_dead_for_version(owner, "1.2.3"), true)
  assert_eq(owner_reclaimed_dead_for_version(owner, "1.2.4"), false)
  assert_eq(owner_reclaimed_dead_for_version({enabled: true, acquire: {}}, "1.2.3"), false)
}
