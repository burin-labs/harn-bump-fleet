pipeline test_release_owner_guard_records_real_pid_when_unpinned(task) {
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  // No owner_guard_pid / HARN_RELEASE_OWNER_PID: the guard must record its own
  // real pid so a later run can probe this record's liveness. A 0 here is the
  // defect that let a crashed run be mistaken for a live one.
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
    owner_guard_ttl_ms: 60000,
  }
  const acquired = release_owner_guard_acquire(harness, cfg, {next_version: "0.9.1"}, "run-a")
  assert_eq(acquired.enabled, true)
  assert(acquired.record.owner_pid > 0)
  const persisted = persisted_release_owner(harness, path)
  assert(persisted.owner_pid > 0)
  unmock_time()
}

pipeline test_release_owner_guard_reclaims_orphaned_pid_when_no_live_process(task) {
  // Reproduces the stalled-cut scenario: a crashed run left status=active with
  // owner_pid=0 on this host. With no live release_harn process, the guard
  // auto-reclaims with a receipt instead of demanding a manual takeover.
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  harness.fs.mkdir(root, true)
  harness.fs
    .write_text(
    path,
    json_stringify(
      {
        schema_version: 1,
        status: "active",
        run_id: "crashed-run",
        repo: "/tmp/harn",
        base: "main",
        mode: "ship-pr",
        bump: "patch",
        next_version: "0.10.17",
        tag: "v0.10.17",
        pin_sha: "abc123",
        operator: "ksinder",
        host: hostname(),
        owner_pid: 0,
        started_iso: "2026-07-14T13:00:00Z",
        started_ms: 1699999990000,
        updated_ms: 1699999990000,
        ttl_ms: 43200000,
        path: path,
      },
    ),
  )
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "def456",
    owner_guard_path: path,
    owner_guard_ttl_ms: 43200000,
    owner_guard_pid: 5252,
    owner_guard_host_process_alive: false,
    owner_guard_existing_owner_completed: false,
  }
  const acquired = release_owner_guard_acquire(
    harness,
    cfg,
    {current_version: "0.10.16", next_version: "0.10.17"},
    "fresh-run",
  )
  assert_eq(acquired.enabled, true)
  assert_eq(acquired.decision.action, "replace_orphaned_lock")
  assert_eq(acquired.record.run_id, "fresh-run")
  assert_eq(acquired.record.owner_pid, 5252)
  assert_eq(acquired.record.reclaimed_prior.run_id, "crashed-run")
  assert_eq(acquired.record.reclaimed_prior.owner_pid, 0)
  unmock_time()
}

pipeline test_release_owner_guard_blocks_orphaned_pid_while_a_live_process_exists(task) {
  // Same orphaned owner_pid=0 record, but a live release_harn process is still
  // running on the host: reclaiming would let two lanes push the same tag, so
  // the guard must block instead.
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  harness.fs.mkdir(root, true)
  harness.fs
    .write_text(
    path,
    json_stringify(
      {
        schema_version: 1,
        status: "active",
        run_id: "live-run",
        repo: "/tmp/harn",
        base: "main",
        mode: "ship-pr",
        bump: "patch",
        next_version: "0.10.17",
        tag: "v0.10.17",
        pin_sha: "abc123",
        operator: "ksinder",
        host: hostname(),
        owner_pid: 0,
        started_iso: "2026-07-14T13:00:00Z",
        started_ms: 1699999990000,
        updated_ms: 1699999990000,
        ttl_ms: 43200000,
        path: path,
      },
    ),
  )
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "def456",
    owner_guard_path: path,
    owner_guard_ttl_ms: 43200000,
    owner_guard_host_process_alive: true,
    owner_guard_existing_owner_completed: false,
  }
  const blocked = try {
    release_owner_guard_acquire(
      harness,
      cfg,
      {current_version: "0.10.16", next_version: "0.10.17"},
      "fresh-run",
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "another live Harn release appears active"))
  assert(contains(blocked, "live-run"))
  const persisted = persisted_release_owner(harness, path)
  assert_eq(persisted.run_id, "live-run")
  unmock_time()
}

pipeline test_release_owner_guard_raw_harn_process_blocks_then_releases_ownership(task) {
  const root = path_join(harness.fs.temp_dir(), "release-owner-process-" + uuid_v7())
  const path = path_join(root, "owner.json")
  const log_path = path_join(root, "holder.log")
  const holder = path_join(project_root() ?? cwd(), "testdata/release_owner_guard_holder.harn")
  const harn_bin = harness.env.get_or("HARN_BIN", "harn")
  harness.fs.mkdir(root, true)
  const start = process_shell(
    "env -u HARN_RELEASE_OWNER_PID "
      + shell_quote(harn_bin)
      + " run --no-sandbox "
      + shell_quote(holder)
      + " -- "
      + shell_quote(path)
      + " >"
      + shell_quote(log_path)
      + " 2>&1 & echo $!",
  )
  assert(process_result_success(start), "failed to start raw Harn owner process")
  const child_pid = trim(start.stdout ?? "")
  assert(child_pid != "", "raw Harn owner process did not report its pid")
  const outcome = try {
    wait_for_file(harness, path, 200)
    const child_owner = persisted_release_owner(harness, path)
    assert_eq(child_owner.run_id, "holder-run")
    assert_eq(child_owner.owner_pid, to_int(child_pid))
    const cfg = {
      repo: "/tmp/harn-owner-guard-holder",
      base: "main",
      mode: "ship-pr",
      bump: "patch",
      yes_live_release: true,
      mock: false,
      pin_sha: "replacement-pin",
      owner_guard_path: path,
      owner_guard_ttl_ms: 60000,
    }
    const blocked = try {
      release_owner_guard_acquire(
        harness,
        cfg,
        {current_version: "0.0.1", next_version: "0.0.2"},
        "replacement-run",
      )
      nil
    } catch (e) {
      e
    }
    assert(blocked != nil, "a live owner process must block replacement")
    assert_eq(persisted_release_owner(harness, path).run_id, "holder-run")
    assert(stop_process(child_pid), "raw Harn owner process did not exit")
    const acquired = release_owner_guard_acquire(
      harness,
      cfg,
      {current_version: "0.0.1", next_version: "0.0.2"},
      "replacement-run",
    )
    assert_eq(acquired.decision.action, "replace_dead_process")
    assert_eq(acquired.record.run_id, "replacement-run")
    assert_eq(acquired.record.owner_pid, pid())
    {error: nil}
  } catch (e) {
    {error: e}
  }
  const stopped = stop_process(child_pid)
  assert(stopped, "raw Harn owner process cleanup failed")
  if outcome.error != nil {
    throw outcome.error
  }
}

pipeline test_release_owner_guard_finish_cannot_overwrite_a_replacement(task) {
  const root = path_join(harness.fs.temp_dir(), "release-owner-replacement-" + uuid_v7())
  const path = path_join(root, "owner.json")
  const base_cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "first-pin",
    owner_guard_path: path,
    owner_guard_pid: 111,
    owner_guard_existing_owner_alive: true,
  }
  const first = release_owner_guard_acquire(
    harness,
    base_cfg,
    {current_version: "0.9.0", next_version: "0.9.1"},
    "first-run",
  )
  const second = release_owner_guard_acquire(
    harness,
    {...base_cfg, pin_sha: "second-pin", owner_guard_pid: 222, owner_guard_takeover: true},
    {current_version: "0.9.0", next_version: "0.9.1"},
    "second-run",
  )
  assert_eq(second.record.run_id, "second-run")
  assert_eq(release_owner_guard_finish(harness, first, "stale finish", false, base_cfg), nil)
  const persisted = persisted_release_owner(harness, path)
  assert_eq(persisted.run_id, "second-run")
  assert_eq(persisted.status, "active")
  assert_eq(persisted.pin_sha, "second-pin")
}

pipeline test_release_owner_guard_blocks_when_atomic_lock_is_held(task) {
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  const lock = release_owner_lock_path(path)
  let _ = coord_acquire_dir_lock(
    path,
    {
      id: "run-held",
      run_id: "run-held",
      repo: "/tmp/harn",
      mode: "ship-pr",
      operator: "codex",
      host: "workstation",
    },
    {lock_path: lock, ttl_ms: 60000, token: "held-lock"},
  )
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
    owner_guard_lock_ttl_ms: 60000,
  }
  const blocked = try {
    release_owner_guard_acquire(harness, cfg, {next_version: "0.9.1"}, "run-b")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "release owner guard lock is held"))
  assert(contains(blocked, "run-held"))
  assert_eq(harness.fs.exists(path), false)
  unmock_time()
}

pipeline test_release_owner_guard_update_blocks_when_atomic_lock_is_held(task) {
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
    owner_guard_lock_ttl_ms: 60000,
  }
  const owner = release_owner_guard_acquire(harness, cfg, {next_version: "0.9.1"}, "run-a")
  const lock = release_owner_lock_path(path)
  let _ = coord_acquire_dir_lock(
    path,
    {id: "run-held", run_id: "run-held", repo: "/tmp/harn", mode: "ship-pr"},
    {lock_path: lock, ttl_ms: 60000, token: "held-lock"},
  )
  const blocked = try {
    release_owner_guard_update(harness, owner, {...cfg, pin_sha: "after"}, {next_version: "0.9.2"})
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "release owner guard lock is held"))
  const persisted = persisted_release_owner(harness, path)
  assert_eq(persisted.run_id, "run-a")
  assert_eq(persisted.next_version, "0.9.1")
  assert_eq(persisted.pin_sha, "abc123")
  unmock_time()
}

pipeline test_release_owner_guard_finish_blocks_when_atomic_lock_is_held(task) {
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
    owner_guard_lock_ttl_ms: 60000,
  }
  const owner = release_owner_guard_acquire(harness, cfg, {next_version: "0.9.1"}, "run-a")
  const lock = release_owner_lock_path(path)
  let _ = coord_acquire_dir_lock(
    path,
    {id: "run-held", run_id: "run-held", repo: "/tmp/harn", mode: "ship-pr"},
    {lock_path: lock, ttl_ms: 60000, token: "held-lock"},
  )
  const blocked = try {
    release_owner_guard_finish(harness, owner, "ok", true, cfg)
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "release owner guard lock is held"))
  const persisted = persisted_release_owner(harness, path)
  assert_eq(persisted.run_id, "run-a")
  assert_eq(persisted.status, "active")
  unmock_time()
}

pipeline test_release_owner_guard_replaces_stale_atomic_lock(task) {
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  const lock = release_owner_lock_path(path)
  mock_time(1699999900000)
  let _ = coord_acquire_dir_lock(
    path,
    {id: "run-stale", run_id: "run-stale", repo: "/tmp/harn", mode: "prepare"},
    {lock_path: lock, ttl_ms: 1000, token: "stale-lock"},
  )
  mock_time(1700000000000)
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "prepare",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
    owner_guard_lock_ttl_ms: 1000,
  }
  const acquired = release_owner_guard_acquire(harness, cfg, {next_version: "0.9.1"}, "run-fresh")
  assert_eq(acquired.enabled, true)
  assert_eq(acquired.record.run_id, "run-fresh")
  assert_eq(harness.fs.exists(path), true)
  assert_eq(harness.fs.exists(lock), false)
  unmock_time()
}

pipeline test_release_owner_guard_update_enriches_active_record(task) {
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "prepare",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "pin-before-analysis",
    owner_guard_path: path,
    owner_guard_ttl_ms: 60000,
  }
  const owner = release_owner_guard_acquire(harness, cfg, {}, "run-a")
  const before = persisted_release_owner(harness, path)
  assert_eq(before.next_version, "")
  mock_time(1700000001000)
  const updated = release_owner_guard_update(
    harness,
    owner,
    {...cfg, pin_sha: "pin-after-analysis"},
    {current_version: "0.9.0", next_version: "0.9.1"},
  )
  assert_eq(updated.record.next_version, "0.9.1")
  assert_eq(updated.record.tag, "v0.9.1")
  assert_eq(updated.record.pin_sha, "pin-after-analysis")
  const persisted = persisted_release_owner(harness, path)
  assert_eq(persisted.next_version, "0.9.1")
  assert_eq(persisted.updated_ms, 1700000001000)
  unmock_time()
}

pipeline test_release_owner_guard_malformed_file_requires_takeover(task) {
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  harness.fs.mkdir(root, true)
  harness.fs.write_text(path, "{not json}\n")
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "prepare",
    bump: "patch",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
  }
  const blocked = try {
    release_owner_guard_acquire(harness, cfg, {next_version: "0.9.1"}, "run-a")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "release owner guard file is malformed"))
  assert_eq(harness.fs.exists(release_owner_lock_path(path)), false)
  const acquired = release_owner_guard_acquire(
    harness,
    {...cfg, owner_guard_takeover: true},
    {next_version: "0.9.1"},
    "run-a",
  )
  assert_eq(acquired.enabled, true)
  assert_eq(acquired.decision.action, "replace_malformed")
}
