import { coord_acquire_dir_lock } from "std/coordination"
import { process_result_success, process_shell, shell_quote } from "std/runtime"
import { parse_json_typed } from "std/schema"
import {
  owner_reclaimed_dead_for_version,
  release_owner_guard_acquire,
  release_owner_guard_decision,
  release_owner_guard_finish,
  release_owner_guard_required,
  release_owner_guard_update,
  release_owner_lock_path,
} from "../lib/release_owner_guard"

type PersistedReleaseOwner = {run_id: string, pin_sha: string, owner_pid: int, status: string, next_version: string, updated_ms: int, ...rest}

fn persisted_release_owner(harness: Harness, path: string) -> PersistedReleaseOwner {
  const parsed = parse_json_typed(harness.fs.read_text(path), PersistedReleaseOwner)
  require parsed != nil, "release owner guard must persist a valid owner record"
  return parsed
}

pipeline test_owner_reclaimed_dead_for_version(task) {
  const dead = {
    enabled: true,
    decision: {action: "replace_dead_process"},
    record: {reclaimed_prior: {next_version: "0.10.17"}},
  }
  assert_eq(owner_reclaimed_dead_for_version(dead, "0.10.17"), true)
  const orphan = {
    enabled: true,
    decision: {action: "replace_orphaned_lock"},
    record: {reclaimed_prior: {next_version: "0.10.17"}},
  }
  assert_eq(owner_reclaimed_dead_for_version(orphan, "0.10.17"), true)
  // Version mismatch: the reclaimed owner targeted a different cut.
  assert_eq(owner_reclaimed_dead_for_version(dead, "0.10.18"), false)
  // Non-dead reclaim kinds are not proof the process is gone.
  assert_eq(
    owner_reclaimed_dead_for_version(
      {
        enabled: true,
        decision: {action: "replace_stale"},
        record: {reclaimed_prior: {next_version: "0.10.17"}},
      },
      "0.10.17",
    ),
    false,
  )
  // Disabled guard, a plain acquire, or a missing prior all yield false.
  assert_eq(owner_reclaimed_dead_for_version({enabled: false}, "0.10.17"), false)
  assert_eq(
    owner_reclaimed_dead_for_version(
      {enabled: true, decision: {action: "acquire"}, record: {}},
      "0.10.17",
    ),
    false,
  )
}

fn wait_for_file(harness: Harness, path, attempts) {
  let remaining = attempts
  while !harness.fs.exists(path) && remaining > 0 {
    sleep(25ms)
    remaining = remaining - 1
  }
  require harness.fs.exists(path), "timed out waiting for " + path
}

fn process_alive(pid_text) {
  const result = process_shell("kill -0 " + pid_text + " >/dev/null 2>&1", {timeout_ms: 2000})
  return process_result_success(result)
}

fn wait_for_process_exit(pid_text, attempts) {
  let remaining = attempts
  while process_alive(pid_text) && remaining > 0 {
    sleep(25ms)
    remaining = remaining - 1
  }
  return !process_alive(pid_text)
}

fn stop_process(pid_text) {
  const _ = process_shell("kill -TERM " + pid_text + " >/dev/null 2>&1 || true")
  return wait_for_process_exit(pid_text, 200)
}

pipeline test_release_owner_guard_required_only_for_live_mutations(task) {
  assert_eq(release_owner_guard_required({mode: "audit", yes_live_release: true}), false)
  assert_eq(release_owner_guard_required({mode: "prepare", yes_live_release: false}), false)
  assert_eq(
    release_owner_guard_required({mode: "ship-pr", yes_live_release: true, mock: true}),
    false,
  )
  assert_eq(release_owner_guard_required({mode: "prepare", yes_live_release: true}), true)
  assert_eq(release_owner_guard_required({mode: "ship-pr", yes_live_release: true}), true)
}

pipeline test_release_owner_guard_decision_blocks_active_owner(task) {
  const existing = {
    status: "active",
    run_id: "run-a",
    operator: "codex",
    host: "workstation",
    repo: "/tmp/harn",
    mode: "ship-pr",
    next_version: "0.9.0",
    tag: "v0.9.0",
    pin_sha: "abc123",
    started_iso: "2026-07-03T00:00:00Z",
    started_ms: 1000,
    updated_ms: 5000,
    ttl_ms: 60000,
  }
  const requested = {...existing, run_id: "run-b", next_version: "0.9.1", tag: "v0.9.1"}
  const decision = release_owner_guard_decision(existing, requested, 10000, 60000, false)
  assert_eq(decision.action, "block")
  assert(contains(decision.reason, "another live Harn release appears active"))
  assert(contains(decision.reason, "run-a"))
  assert(contains(decision.reason, "run-b"))
  assert(contains(decision.reason, "HARN_RELEASE_OWNER_TAKEOVER=1"))
}

pipeline test_release_owner_guard_decision_replaces_stale_or_taken_over_owner(task) {
  const active = {status: "active", run_id: "run-a", updated_ms: 1000, ttl_ms: 1000}
  const requested = {status: "active", run_id: "run-b", updated_ms: 3000, ttl_ms: 1000}
  assert_eq(
    release_owner_guard_decision(active, requested, 3000, 1000, false).action,
    "replace_stale",
  )
  assert_eq(release_owner_guard_decision(active, requested, 1500, 1000, true).action, "replace")
  assert_eq(
    release_owner_guard_decision({...active, status: "finished"}, requested, 1500, 1000, false).action,
    "acquire",
  )
  assert_eq(
    release_owner_guard_decision(active, {...requested, run_id: "run-a"}, 1500, 1000, false).action,
    "refresh",
  )
}

pipeline test_release_owner_guard_decision_replaces_dead_owner_process(task) {
  const active = {
    status: "active",
    run_id: "run-a",
    host: hostname(),
    owner_pid: 12345,
    updated_ms: 5000,
    ttl_ms: 60000,
  }
  const requested = {...active, run_id: "run-b"}
  assert_eq(
    release_owner_guard_decision(active, requested, 10000, 60000, false, false).action,
    "replace_dead_process",
  )
  assert_eq(
    release_owner_guard_decision(active, requested, 10000, 60000, false, true).action,
    "block",
  )
}

pipeline test_release_owner_guard_decision_replaces_completed_release_without_live_process(task) {
  const active = {status: "active", run_id: "run-a", updated_ms: 5000, ttl_ms: 60000, tag: "v0.9.12"}
  const requested = {...active, run_id: "run-b", tag: "v0.9.13"}
  assert_eq(
    release_owner_guard_decision(active, requested, 10000, 60000, false, nil, true).action,
    "replace_completed_release",
  )
  assert_eq(
    release_owner_guard_decision(active, requested, 10000, 60000, false, true, true).action,
    "block",
  )
}

pipeline test_release_owner_guard_file_roundtrip(task) {
  mock_time(1700000000000)
  const root = path_join(harness.fs.temp_dir(), "release-owner-guard-" + uuid_v7())
  const path = path_join(root, "owner.json")
  const cfg = {
    repo: "/tmp/harn",
    base: "main",
    mode: "ship-pr",
    bump: "minor",
    yes_live_release: true,
    mock: false,
    pin_sha: "abc123",
    owner_guard_path: path,
    owner_guard_ttl_ms: 60000,
    owner_guard_pid: 4242,
    owner_guard_existing_owner_alive: true,
  }
  const analysis = {current_version: "0.8.169", next_version: "0.9.0"}
  const first = release_owner_guard_acquire(harness, cfg, analysis, "run-a")
  assert_eq(first.enabled, true)
  assert_eq(first.record.owner_pid, 4242)
  assert_eq(harness.fs.exists(path), true)
  const blocked = try {
    release_owner_guard_acquire(harness, cfg, analysis, "run-b")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(blocked, "another live Harn release appears active"))
  assert(contains(blocked, "Guard file: " + path))
  assert_eq(harness.fs.exists(release_owner_lock_path(path)), false)
  const finished = release_owner_guard_finish(harness, first, "ok", true)
  assert_eq(finished.status, "finished")
  assert_eq(finished.success, true)
  const second = release_owner_guard_acquire(harness, cfg, analysis, "run-b")
  assert_eq(second.enabled, true)
  assert_eq(second.decision.action, "acquire")
  unmock_time()
}

