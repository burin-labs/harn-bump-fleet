import { FleetProjectionTarget } from "../lib/fleet_projection_targets"
import {
  converge_remote_repository,
  remote_convergence_failed,
  remote_projection_branch,
} from "../lib/remote_projection"

const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

const HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const MAIN = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn targets(text: string) -> list<FleetProjectionTarget> {
  return [{slug: SLUG, path: "PROJECTION.yml", expected: text, origin: "fleet.toml"}]
}

fn proposal(fields: dict) -> dict {
  return {
    number: 59,
    title: "[CI] Restore fleet-owned projections",
    state: "open",
    html_url: "https://github.com/${SLUG}/pull/59",
    changed_files: 1,
    base: {ref: "main", sha: MAIN, repo: {full_name: SLUG}},
    head: {ref: remote_projection_branch(targets("old\n")), sha: HEAD, repo: {full_name: SLUG}},
  }
    + fields
}

fn setup(testing: HarnessTesting, fields: dict, census_fields: dict = {}) {
  testing.http_mock_clear()
  testing.http_mock(
    "GET",
    "${BASE}/repos/${SLUG}/branches/main",
    {status: 200, body: json_stringify({name: "main", commit: {sha: MAIN}})},
  )
  testing.http_mock(
    "POST",
    "${BASE}/repos/${SLUG}/git/refs",
    {status: 403, body: json_stringify({message: "unexpected branch creation"})},
  )
  testing.http_mock(
    "GET",
    "${BASE}/repos/${SLUG}/contents/PROJECTION.yml?ref=main",
    {
      status: 200,
      body: json_stringify(
        {
          name: "PROJECTION.yml",
          path: "PROJECTION.yml",
          sha: MAIN,
          size: 4,
          type: "file",
          encoding: "base64",
          content: base64_encode("old\n"),
        },
      ),
    },
  )
  testing.http_mock(
    "GET",
    "${BASE}/repos/${SLUG}/pulls?state=open&base=main&per_page=10&page=1",
    {status: 200, body: json_stringify([proposal({draft: false, labels: []} + census_fields)])},
  )
  testing.http_mock(
    "GET",
    "${BASE}/repos/${SLUG}/pulls/59",
    {status: 200, body: json_stringify(proposal(fields))},
  )
  testing.http_mock(
    "GET",
    "${BASE}/repos/${SLUG}/pulls/59/files?per_page=100&page=1",
    {
      status: 200,
      body: json_stringify(
        [
          {
            filename: "PROJECTION.yml",
            status: "modified",
            sha: HEAD,
            additions: 1,
            deletions: 1,
            changes: 2,
          },
        ],
      ),
    },
  )
}

fn assert_no_mutation(testing: HarnessTesting, minimum_reads: int = 3) {
  const calls = testing.http_mock_calls()
  assert(len(calls) >= minimum_reads, "the actual admission reads must be reached")
  for call in calls {
    assert_eq(call.method, "GET", "held or unmeasured work must not issue a mutation")
  }
}

@test(cases: [{name: "draft_apply", args: [{draft: true, labels: []}, true]}, {name: "draft_check", args: [{draft: true, labels: []}, false]}, {name: "dnm_apply", args: [{draft: false, labels: [{name: "do-not-merge"}]}, true]}, {name: "dnm_check", args: [{draft: false, labels: [{name: "do-not-merge"}]}, false]}, {name: "hold_apply", args: [{draft: false, labels: [{name: "hold"}]}, true]}, {name: "renamed_draft", args: [{title: "Manual review in progress", draft: true, labels: []}, true]}])
pipeline test_changed_manifest_defers_the_old_held_proposal_before_any_write(
  harness: Harness,
  fields: dict,
  apply: bool,
) {
  setup(harness.testing, fields)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets("new\n"),
    apply,
    true,
    {api_base_url: BASE, installation_token: "test-token"},
  )
  assert_eq(result.status, "pending", json_stringify(result))
  assert_eq(result.pull_request, 59)
  assert_eq(result.branch, remote_projection_branch(targets("old\n")))
  assert(result.branch != remote_projection_branch(targets("new\n")))
  assert_eq(result.commit, HEAD)
  assert_eq(result.auto_merge?.state, "held")
  assert(result.auto_merge?.hold_reason != nil)
  assert_eq(result.sweep?.superseded, [])
  assert_eq(remote_convergence_failed(result), false)
  assert_no_mutation(harness.testing)
}

@test(cases: [{name: "missing_draft", args: [{labels: []}]}, {name: "missing_labels", args: [{draft: false}]}, {name: "null_draft", args: [{draft: nil, labels: []}]}, {name: "null_labels", args: [{draft: false, labels: nil}]}, {name: "unknown_label", args: [{draft: false, labels: [{name: ""}]}]}, {name: "closed_since_census", args: [{draft: false, labels: [], state: "closed"}]}, {name: "different_pull", args: [{number: 60, draft: false, labels: []}]}])
pipeline test_incomplete_or_changed_hold_admission_refuses_before_any_write(
  harness: Harness,
  fields: dict,
) {
  setup(harness.testing, fields)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets("new\n"),
    true,
    true,
    {api_base_url: BASE, installation_token: "test-token"},
  )
  assert_eq(result.status, "error")
  assert(trim(result.error ?? "") != "")
  assert_eq(remote_convergence_failed(result), true)
  assert_no_mutation(harness.testing)
}

pipeline test_unheld_changed_manifest_still_reports_replacement_and_supersession(harness: Harness) {
  setup(harness.testing, {draft: false, labels: []})
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets("new\n"),
    false,
    false,
    {api_base_url: BASE, installation_token: "test-token"},
  )
  assert_eq(result.status, "drift", json_stringify(result))
  assert_eq(result.branch, remote_projection_branch(targets("new\n")))
  assert_eq(result.sweep?.superseded?.[0]?.pull_request, 59)
  assert_eq(result.sweep?.superseded?.[0]?.state, "would_close")
  assert_no_mutation(harness.testing)
}

@test(cases: [{name: "missing_branch", args: ["branch"]}, {name: "missing_head", args: ["head"]}, {name: "missing_number", args: ["number"]}])
pipeline test_incomplete_census_identity_cannot_hide_an_existing_proposal(
  harness: Harness,
  missing: string,
) {
  const fields: dict = if missing == "number" {
    {number: 0}
  } else {
    {
      head: {
        ref: if missing == "branch" {
          ""
        } else {
          "automation/fleet-projections-old"
        },
        sha: if missing == "head" {
          ""
        } else {
          HEAD
        },
        repo: {full_name: SLUG},
      },
    }
  }
  setup(harness.testing, {draft: true, labels: []}, fields)
  const result = converge_remote_repository(
    harness,
    SLUG,
    "main",
    targets("new\n"),
    true,
    true,
    {api_base_url: BASE, installation_token: "test-token"},
  )
  assert_eq(result.status, "error")
  assert(trim(result.error ?? "") != "")
  assert_no_mutation(harness.testing, 2)
}
