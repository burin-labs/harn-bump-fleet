import {
  ReleaseMainDelta,
  release_main_delta_decision,
  release_main_delta_deferral_reason,
  release_main_delta_proved_by_drift,
  release_main_delta_unobserved,
} from "../lib/release_main_delta"

const MERGED = "2222222222222222222222222222222222222222"

const OTHER = "3333333333333333333333333333333333333333"

const LANES = ["Workspace nextest (macos-latest)", "Workspace nextest (windows-latest)"]

const CODE_DRIFT = ["crates/harn-core/src/lib.rs"]

fn delta(state: string, sha: string, failing: string = "") -> ReleaseMainDelta {
  return {
    state: state,
    commit: sha,
    lanes: LANES,
    checks: [],
    failing_check: failing,
    observed_at: "2026-09-03T03:00:00Z",
  }
}

/**
 * The gate that stands in front of the publication act. The lanes only a
 * release runs have not seen the merged tree, and something in it is a path
 * they bear on, so they run before the tag rather than after it.
 */
pipeline test_main_delta_runs_the_lanes_before_the_tag(task: any) {
  const decision = release_main_delta_decision(delta("not_started", MERGED), MERGED, CODE_DRIFT)
  assert_eq(decision.action, "dispatch")
  assert(contains(decision.reason, "crates/harn-core/src/lib.rs"))
  assert(contains(decision.reason, "Workspace nextest (windows-latest)"))
}

/** While they run, nothing is minted. */
pipeline test_main_delta_waits_while_the_lanes_run(task: any) {
  assert_eq(
    release_main_delta_decision(delta("running", MERGED), MERGED, CODE_DRIFT).action,
    "wait",
  )
}

/** Green lanes on the merged commit are what earns the tag. */
pipeline test_main_delta_tags_when_the_lanes_pass(task: any) {
  const decision = release_main_delta_decision(delta("passed", MERGED), MERGED, CODE_DRIFT)
  assert_eq(decision.action, "tag")
  assert(contains(decision.reason, MERGED))
}

/**
 * A merged tree that is already the certified one skips the lanes by a named
 * verdict rather than by falling through. Re-proving a tree that already
 * carries this exact proof costs thirty-four minutes on every quiet cut.
 */
pipeline test_main_delta_skips_a_tree_it_already_certified(task: any) {
  const decision = release_main_delta_decision(
    delta("skipped_tree_already_certified", MERGED),
    MERGED,
    [],
  )
  assert_eq(decision.action, "tag")
  assert(contains(decision.reason, "already certified"))
}

/**
 * Drift that touches nothing the release-only lanes bear on does not pay for
 * them either. This is the common cut: a changelog fragment landed mid-release.
 */
pipeline test_main_delta_skips_drift_the_lanes_do_not_bear_on(task: any) {
  const decision = release_main_delta_decision(delta("not_started", MERGED), MERGED, [])
  assert_eq(decision.action, "skip")
}

/**
 * The failure the whole design is arranged around. A red lane on the merged
 * commit does not merely stop: the bump is reverted, because a bump on main
 * with no tag is what left the branch stuck the night this was written.
 */
pipeline test_main_delta_unfolds_a_red_lane(task: any) {
  const decision = release_main_delta_decision(
    delta("failed", MERGED, "Workspace nextest (windows-latest)"),
    MERGED,
    CODE_DRIFT,
  )
  assert_eq([decision.action, decision.terminal_reason], ["unfold", "main_delta_failed"])
  assert(contains(decision.reason, "Workspace nextest (windows-latest)"))
}

/**
 * The absence rule. A delta nobody could read is not a passing delta, and the
 * two are indistinguishable to anything that only checks for a failure.
 */
pipeline test_main_delta_refuses_a_tag_it_never_observed(task: any) {
  const decision = release_main_delta_decision(release_main_delta_unobserved(), MERGED, CODE_DRIFT)
  assert_eq([decision.action, decision.terminal_reason], ["abort", "main_delta_not_observed"])
}

/**
 * A pass proved on some other commit is not a pass on this one. Without this,
 * an observation left over from an earlier poll would tag a tree it never saw.
 */
pipeline test_main_delta_refuses_a_proof_of_another_tree(task: any) {
  const decision = release_main_delta_decision(delta("passed", OTHER), MERGED, CODE_DRIFT)
  assert_eq([decision.action, decision.terminal_reason], ["abort", "main_delta_is_stale"])
  assert(contains(decision.reason, OTHER))
}

/**
 * What an operator reads. Both halves are named: the commits that changed the
 * tree, and the check that refused it. Either alone sends them back to the API.
 */
pipeline test_main_delta_deferral_names_the_commits_and_the_check(task: any) {
  const reason = release_main_delta_deferral_reason(
    "v0.10.128",
    delta("failed", MERGED, "Workspace nextest (windows-latest)"),
    "7c953ee2b749c153531c5d6df6a341ca3fada4e7",
  )
  assert(contains(reason, "RELEASE DEFERRED"))
  assert(contains(reason, "v0.10.128"))
  assert(contains(reason, "Workspace nextest (windows-latest)"))
  assert(contains(reason, "7c953ee2b749c153531c5d6df6a341ca3fada4e7"))
  assert(contains(reason, "No tag was minted"))
}

fn recorded_check(name: string, state: string, release_only: bool) {
  return {name: name, state: state, source: "pull_request_head", release_only: release_only}
}

/**
 * Once the lanes run on ordinary pull requests, every drifted commit carries
 * their result on its own head and the merge gate refused to merge until each
 * was green. Re-running them on the merged commit would spend thirty-four
 * minutes re-proving what the receipt already records.
 */
pipeline test_delta_is_proved_by_a_recorded_green_drift(task: any) {
  assert_eq(
    release_main_delta_proved_by_drift(
      "recorded",
      [
        {
          green: true,
          checks: [
            recorded_check("CI status", "SUCCESS", false),
            recorded_check("Workspace nextest (windows-latest)", "SUCCESS", true),
          ],
        },
      ],
      LANES,
    ),
    true,
  )
}

/**
 * Fails closed in every direction that matters. An unrecorded drift proves
 * nothing; a red commit proves nothing; and a record that names no
 * release-only row at all proves nothing either, because a drift with no lane
 * evidence looks exactly like a drift whose lanes nobody read.
 */
pipeline test_delta_is_not_proved_by_an_absent_or_red_record(task: any) {
  const green_lane = [
    {green: true, checks: [recorded_check("Workspace nextest (windows-latest)", "SUCCESS", true)]},
  ]
  assert_eq(release_main_delta_proved_by_drift("not_observed", green_lane, LANES), false)
  assert_eq(release_main_delta_proved_by_drift("no_drift", green_lane, LANES), false)
  assert_eq(release_main_delta_proved_by_drift("recorded", [], LANES), false)
  assert_eq(release_main_delta_proved_by_drift("recorded", green_lane, []), false)
  assert_eq(
    release_main_delta_proved_by_drift(
      "recorded",
      [{green: true, checks: [recorded_check("CI status", "SUCCESS", false)]}],
      LANES,
    ),
    false,
  )
  assert_eq(
    release_main_delta_proved_by_drift(
      "recorded",
      [
        {
          green: false,
          checks: [recorded_check("Workspace nextest (windows-latest)", "SUCCESS", true)],
        },
      ],
      LANES,
    ),
    false,
  )
  assert_eq(
    release_main_delta_proved_by_drift(
      "recorded",
      [
        {
          green: true,
          checks: [recorded_check("Workspace nextest (windows-latest)", "FAILURE", true)],
        },
      ],
      LANES,
    ),
    false,
  )
}
