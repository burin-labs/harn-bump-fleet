import {
  PrerequisiteCheckEvidence,
  classify_prerequisite_pr,
  verify_projection_equivalent_head,
} from "../lib/prerequisite_prs"

const EXPECTED = "319915d939525a7751403f91c441640f8eeddb96"

const MERGED_HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const BRANCH = "automation/fleet-projections-example"

const CONTENTS = "name: Bump Harn\n"

fn pr(fields: dict = {}) {
  return {
    number: 4872,
    title: "Classify completion sentinels as natural terminals",
    url: "https://github.com/burin-labs/harn/pull/4872",
    github_state: "open",
    merged: false,
    merged_at: nil,
    merge_commit_oid: nil,
    mergeable_state: "clean",
    mergeable: true,
    auto_merge_armed: true,
    base: {ref: "main"},
    head: {ref: BRANCH, sha: EXPECTED},
  }
    + fields
}

fn checks(fields: dict = {}) -> PrerequisiteCheckEvidence {
  return {
    head_oid: fields.head_oid ?? EXPECTED,
    state: fields.state ?? "pending",
    check_count: fields.check_count ?? 2,
    pending_count: fields.pending_count ?? 1,
    failing_count: fields.failing_count ?? 0,
    failing_names: fields.failing_names ?? [],
  }
}

fn lease() {
  return {
    head_ref: BRANCH,
    base_ref: "main",
    files: [{path: ".github/workflows/bump-harn.yml", contents: CONTENTS}],
  }
}

fn descendant_evidence(fields: any = {}) {
  return {
    commits_head_oid: MERGED_HEAD,
    final_head_oid: MERGED_HEAD,
    commits: [
      {sha: EXPECTED, signature: {verified: true}},
      {sha: MERGED_HEAD, signature: {verified: true}},
    ],
    changed_paths: [".github/workflows/bump-harn.yml"],
    files_complete: true,
    head_contents: {".github/workflows/bump-harn.yml": CONTENTS},
    missing_paths: [],
  }
    + fields
}

pipeline test_open_pending_pr_retries_with_non_vacuous_check_shape(task: any) {
  const status = classify_prerequisite_pr("burin-labs/harn", 4872, pr(), EXPECTED, false, checks())
  assert_eq(status.ok, false)
  assert_eq(status.status, "pending")
  assert_eq(status.head_oid, EXPECTED)
  assert_eq(status.checks_observed, true)
  assert_eq(status.check_count, 2)
  assert_eq(status.pending_check_count, 1)
}

pipeline test_terminal_red_names_exact_head_failures(task: any) {
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr(),
    EXPECTED,
    false,
    checks(
      {
        state: "failing",
        pending_count: 0,
        failing_count: 2,
        failing_names: ["CI / lint", "CI / test"],
      },
    ),
  )
  assert_eq(status.status, "terminal_failure")
  assert_eq(status.failing_check_count, 2)
  assert_eq(status.failing_check_names, ["CI / lint", "CI / test"])
}

pipeline test_non_mergeable_pr_lifecycle_states_are_terminal(task: any) {
  const closed = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr({github_state: "closed"}),
    EXPECTED,
  )
  const dirty = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr({mergeable: false, mergeable_state: "dirty"}),
    EXPECTED,
    false,
    checks(),
  )
  const draft = classify_prerequisite_pr("burin-labs/harn", 4872, pr({draft: true}), EXPECTED)
  assert_eq(closed.status, "terminal_failure")
  assert_eq(dirty.status, "terminal_failure")
  assert_eq(draft.status, "terminal_failure")
}

pipeline test_open_pr_without_exact_head_checks_is_not_success(task: any) {
  const missing = classify_prerequisite_pr("burin-labs/harn", 4872, pr(), EXPECTED)
  const wrong_head = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr(),
    EXPECTED,
    false,
    checks({head_oid: MERGED_HEAD}),
  )
  assert_eq(missing.status, "missing_check_evidence")
  assert_eq(missing.checks_observed, false)
  assert_eq(wrong_head.status, "missing_check_evidence")
}

pipeline test_measured_zero_checks_stays_pending(task: any) {
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr(),
    EXPECTED,
    false,
    checks({check_count: 0, pending_count: 0}),
  )
  assert_eq(status.status, "pending")
  assert_eq(status.checks_observed, true)
  assert_eq(status.check_count, 0)
}

pipeline test_merged_pr_with_merge_evidence_passes(task: any) {
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr(
      {
        github_state: "merged",
        merged: true,
        merged_at: "2026-07-16T15:30:00Z",
        merge_commit_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      },
    ),
    EXPECTED,
  )
  assert_eq(status.ok, true)
  assert_eq(status.status, "satisfied")
  assert_eq(status.merge_commit_oid, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
}

pipeline test_wrong_head_blocks_before_merge_state(task: any) {
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr({head: {ref: BRANCH, sha: MERGED_HEAD}}),
    EXPECTED,
  )
  assert_eq(status.ok, false)
  assert_eq(status.status, "unexpected_head")
  assert(contains(status.detail, "does not match expected"))
}

pipeline test_signed_base_merge_with_exact_projection_is_equivalent(task: any) {
  const advanced = pr({head: {ref: BRANCH, sha: MERGED_HEAD}})
  const verification = verify_projection_equivalent_head(
    advanced,
    EXPECTED,
    lease(),
    descendant_evidence(),
  )
  assert_eq(verification.ok, true)
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    advanced,
    EXPECTED,
    verification.ok,
    checks({head_oid: MERGED_HEAD}),
  )
  assert_eq(status.status, "pending")
  assert_eq(status.head_verification, "projection_equivalent")
}

pipeline test_projection_descendant_rejects_unsigned_or_widened_changes(task: any) {
  const advanced = pr({head: {ref: BRANCH, sha: MERGED_HEAD}})
  const unsigned = descendant_evidence(
    {
      commits: [
        {sha: EXPECTED, signature: {verified: true}},
        {sha: MERGED_HEAD, signature: {verified: false}},
      ],
    },
  )
  const widened = descendant_evidence(
    {changed_paths: [".github/workflows/bump-harn.yml", ".github/workflows/ci.yml"]},
  )
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), unsigned).ok, false)
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), widened).ok, false)
}

pipeline test_projection_descendant_rejects_head_race_or_rewritten_proposal(task: any) {
  const advanced = pr({head: {ref: BRANCH, sha: MERGED_HEAD}})
  const raced = descendant_evidence({final_head_oid: "cccccccccccccccccccccccccccccccccccccccc"})
  const rewritten = descendant_evidence(
    {commits: [{sha: MERGED_HEAD, signature: {verified: true}}]},
  )
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), raced).ok, false)
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), rewritten).ok, false)
}

pipeline test_projection_descendant_rejects_changed_bytes_or_lease_identity(task: any) {
  const advanced = pr({head: {ref: BRANCH, sha: MERGED_HEAD}})
  const changed = descendant_evidence(
    {head_contents: {".github/workflows/bump-harn.yml": "name: Different\n"}},
  )
  const wrong_branch = pr({head: {ref: "automation/unleased", sha: MERGED_HEAD}})
  const wrong_base = pr({base: {ref: "release"}, head: {ref: BRANCH, sha: MERGED_HEAD}})
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), changed).ok, false)
  assert_eq(
    verify_projection_equivalent_head(wrong_branch, EXPECTED, lease(), descendant_evidence()).ok,
    false,
  )
  assert_eq(
    verify_projection_equivalent_head(wrong_base, EXPECTED, lease(), descendant_evidence()).ok,
    false,
  )
}

pipeline test_missing_merge_commit_blocks_merged_pr(task: any) {
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr({github_state: "merged", merged: true, merged_at: "2026-07-16T15:30:00Z"}),
    "",
  )
  assert_eq(status.ok, false)
  assert_eq(status.status, "missing_merge_evidence")
}

pipeline test_nil_pr_blocks_as_missing(task: any) {
  const status = classify_prerequisite_pr("burin-labs/harn", 4872, nil, "")
  assert_eq(status.ok, false)
  assert_eq(status.status, "missing_pull_request")
}
