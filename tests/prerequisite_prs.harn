import {
  classify_prerequisite_pr,
  verify_projection_equivalent_head,
} from "../lib/prerequisite_prs"

const EXPECTED = "319915d939525a7751403f91c441640f8eeddb96"

const MERGED_HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const BRANCH = "automation/fleet-projections-example"

const CONTENTS = "name: Bump Harn\n"

fn pr(fields = {}) {
  return {
    number: 4872,
    title: "Classify completion sentinels as natural terminals",
    url: "https://github.com/burin-labs/harn/pull/4872",
    github_state: "open",
    merged: false,
    merged_at: nil,
    merge_commit_oid: nil,
    mergeable_state: "clean",
    base: {ref: "main"},
    head: {ref: BRANCH, sha: EXPECTED},
  }
    + fields
}

fn lease() {
  return {
    head_ref: BRANCH,
    base_ref: "main",
    files: [{path: ".github/workflows/bump-harn.yml", contents: CONTENTS}],
  }
}

fn descendant_evidence(fields = {}) {
  return {
    commits_head_oid: MERGED_HEAD,
    final_head_oid: MERGED_HEAD,
    commits: [
      {sha: EXPECTED, signature: {verified: true}},
      {sha: MERGED_HEAD, signature: {verified: true}},
    ],
    changed_paths: [".github/workflows/bump-harn.yml"],
    files_complete: true,
    head_contents: {".github/workflows/bump-harn.yml": CONTENTS},
    missing_paths: [],
  }
    + fields
}

pipeline test_open_pr_blocks_even_when_head_matches(task) {
  const status = classify_prerequisite_pr("burin-labs/harn", 4872, pr(), EXPECTED)
  assert_eq(status.ok, false)
  assert_eq(status.status, "not_merged")
  assert_eq(status.head_oid, EXPECTED)
  assert(contains(status.detail, "not merged"))
}

pipeline test_merged_pr_with_merge_evidence_passes(task) {
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr(
      {
        github_state: "merged",
        merged: true,
        merged_at: "2026-07-16T15:30:00Z",
        merge_commit_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      },
    ),
    EXPECTED,
  )
  assert_eq(status.ok, true)
  assert_eq(status.status, "satisfied")
  assert_eq(status.merge_commit_oid, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
}

pipeline test_wrong_head_blocks_before_merge_state(task) {
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr({head: {ref: BRANCH, sha: MERGED_HEAD}}),
    EXPECTED,
  )
  assert_eq(status.ok, false)
  assert_eq(status.status, "unexpected_head")
  assert(contains(status.detail, "does not match expected"))
}

pipeline test_signed_base_merge_with_exact_projection_is_equivalent(task) {
  const advanced = pr({head: {ref: BRANCH, sha: MERGED_HEAD}})
  const verification = verify_projection_equivalent_head(
    advanced,
    EXPECTED,
    lease(),
    descendant_evidence(),
  )
  assert_eq(verification.ok, true)
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    advanced,
    EXPECTED,
    verification.ok,
  )
  assert_eq(status.status, "not_merged")
  assert_eq(status.head_verification, "projection_equivalent")
}

pipeline test_projection_descendant_rejects_unsigned_or_widened_changes(task) {
  const advanced = pr({head: {ref: BRANCH, sha: MERGED_HEAD}})
  const unsigned = descendant_evidence(
    {
      commits: [
        {sha: EXPECTED, signature: {verified: true}},
        {sha: MERGED_HEAD, signature: {verified: false}},
      ],
    },
  )
  const widened = descendant_evidence(
    {changed_paths: [".github/workflows/bump-harn.yml", ".github/workflows/ci.yml"]},
  )
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), unsigned).ok, false)
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), widened).ok, false)
}

pipeline test_projection_descendant_rejects_head_race_or_rewritten_proposal(task) {
  const advanced = pr({head: {ref: BRANCH, sha: MERGED_HEAD}})
  const raced = descendant_evidence({final_head_oid: "cccccccccccccccccccccccccccccccccccccccc"})
  const rewritten = descendant_evidence(
    {commits: [{sha: MERGED_HEAD, signature: {verified: true}}]},
  )
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), raced).ok, false)
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), rewritten).ok, false)
}

pipeline test_projection_descendant_rejects_changed_bytes_or_lease_identity(task) {
  const advanced = pr({head: {ref: BRANCH, sha: MERGED_HEAD}})
  const changed = descendant_evidence(
    {head_contents: {".github/workflows/bump-harn.yml": "name: Different\n"}},
  )
  const wrong_branch = pr({head: {ref: "automation/unleased", sha: MERGED_HEAD}})
  const wrong_base = pr({base: {ref: "release"}, head: {ref: BRANCH, sha: MERGED_HEAD}})
  assert_eq(verify_projection_equivalent_head(advanced, EXPECTED, lease(), changed).ok, false)
  assert_eq(
    verify_projection_equivalent_head(wrong_branch, EXPECTED, lease(), descendant_evidence()).ok,
    false,
  )
  assert_eq(
    verify_projection_equivalent_head(wrong_base, EXPECTED, lease(), descendant_evidence()).ok,
    false,
  )
}

pipeline test_missing_merge_commit_blocks_merged_pr(task) {
  const status = classify_prerequisite_pr(
    "burin-labs/harn",
    4872,
    pr({github_state: "merged", merged: true, merged_at: "2026-07-16T15:30:00Z"}),
    "",
  )
  assert_eq(status.ok, false)
  assert_eq(status.status, "missing_merge_evidence")
}

pipeline test_nil_pr_blocks_as_missing(task) {
  const status = classify_prerequisite_pr("burin-labs/harn", 4872, nil, "")
  assert_eq(status.ok, false)
  assert_eq(status.status, "missing_pull_request")
}
