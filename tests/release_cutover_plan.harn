import { release_cutover_plan, release_cutover_plan_summary } from "../lib/release_cutover_plan"
import { release_fold_owed, release_fold_repair_decision } from "../lib/release_fold_repair"
import { release_contract_fixture } from "../testdata/release_contract_fixture"

fn plan_for(latest_tag: string, workspace: string, changelog_top: string, existing: string) {
  const owed = release_fold_owed(release_contract_fixture(), latest_tag, workspace, changelog_top)
  return release_cutover_plan(
    release_fold_repair_decision(owed, {repository: "burin-labs/harn", base: "main"}, existing),
    "burin-labs/harn",
  )
}

pipeline test_a_stranded_release_plans_the_pull_request_it_would_open(task: any) {
  const plan = plan_for("v0.10.133", "0.10.133-dev", "0.10.132", "")
  assert_eq(plan.outcome, "planned")
  assert_eq(plan.repository, "burin-labs/harn")
  assert_eq(plan.head, "automation/development-0.10.134-dev")
  assert_eq(plan.title, "[Release] Start 0.10.134-dev development")
}

pipeline test_the_plan_never_says_a_repair_happened(task: any) {
  /**
   * The whole point of a separate dry-run receipt. A plan that read like a
   * performed repair would put a false line in the one record a release owner
   * reads, and they would stop looking for the cutover that never opened.
   *
   * Asserted on the summary as well as the outcome, because the summary is the
   * part anyone actually reads and it is the part that drifts.
   */
  const planned = plan_for("v0.10.133", "0.10.133-dev", "0.10.132", "")
  assert_eq(planned.outcome, "planned")
  const summary = release_cutover_plan_summary(planned)
  assert(starts_with(summary, "would open "))
  // Both outcomes, not just the interesting one: a refusal that read as a
  // completed action would be the same failure with a quieter symptom. Every
  // summary speaks conditionally, which is the invariant rather than the
  // absence of any particular word.
  const refused = plan_for("v1.2.3", "1.2.4-dev", "1.2.3", "")
  for line in [summary, release_cutover_plan_summary(refused)] {
    assert(contains(line, "would"))
    assert_eq(contains(line, "has been"), false)
    assert_eq(contains(line, "was opened"), false)
  }
}

pipeline test_a_cutover_already_open_is_named_rather_than_duplicated(task: any) {
  const plan = plan_for("v0.10.133", "0.10.133-dev", "0.10.132", "burin-labs/harn#8400")
  assert_eq(plan.outcome, "refused")
  assert_eq(plan.code, "already_open")
  assert_eq(plan.existing_pr, "burin-labs/harn#8400")
  assert_eq(plan.head, "")
  assert(contains(release_cutover_plan_summary(plan), "no cutover pull request would be opened"))
}

pipeline test_a_folded_release_plans_nothing_and_says_why(task: any) {
  const plan = plan_for("v1.2.3", "1.2.4-dev", "1.2.3", "")
  assert_eq(plan.outcome, "refused")
  assert_eq(plan.code, "nothing_owed")
}

pipeline test_a_changelog_only_debt_is_refused_not_planned(task: any) {
  // The cutover writes only the workspace version, so opening one here would
  // carry no change while the real cause stood.
  const plan = plan_for("v1.2.3", "1.2.4-dev", "1.2.2", "")
  assert_eq(plan.outcome, "refused")
  assert_eq(plan.code, "not_repairable_here")
}

pipeline test_a_plan_that_fixes_only_half_says_so_in_its_summary(task: any) {
  const plan = plan_for("v0.10.133", "0.10.133-dev", "0.10.132", "")
  assert(contains(plan.unrepaired, "changelog"))
  assert(contains(release_cutover_plan_summary(plan), "would not fix"))
  const whole = plan_for("v1.2.3", "1.2.3-dev", "1.2.3", "")
  assert_eq(whole.unrepaired, "")
  assert_eq(contains(release_cutover_plan_summary(whole), "would not fix"), false)
}

pipeline test_a_decision_carrying_neither_is_a_defect_not_an_empty_plan(task: any) {
  /**
   * An empty plan is indistinguishable from a release that owes nothing, so a
   * decision carrying neither half must stop rather than render.
   */
  const neither = {
    schema_version: "harn_bump_fleet.release_fold_repair.v1",
    pull_request: nil,
    refusal: nil,
  }
  // The reason is asserted, not just that something threw. Reading a nil half
  // throws on its own, so a test that accepted any throw would pass with the
  // guard deleted and prove nothing about the guard.
  const reason = try {
    release_cutover_plan(neither, "burin-labs/harn")
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(reason, "neither a pull request nor a refusal"))
  // And the opposite malformation, which no unwrap would catch at all: a
  // decision carrying both halves silently prefers one and hides the other.
  const both_reason = try {
    release_cutover_plan(
      {
        schema_version: "harn_bump_fleet.release_fold_repair.v1",
        pull_request: {
          repository: "burin-labs/harn",
          base: "main",
          head: "automation/development-1.2.4-dev",
          title: "[Release] Start 1.2.4-dev development",
          owed: release_fold_owed(release_contract_fixture(), "v1.2.3", "1.2.3-dev", "1.2.3"),
          unrepaired: "",
          reason: "owed",
        },
        refusal: {code: "already_open", reason: "also refused", existing_pr: "owner/repo#1"},
      },
      "burin-labs/harn",
    )
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(both_reason, "both a pull request and a refusal"))
}
