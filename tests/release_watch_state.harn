import {
  ReleaseWatchReceipt,
  ReleaseWatchWarmCacheJob,
  ReleaseWatchWarmCacheRun,
  release_watch_apply_warm_cache_transition,
  release_watch_receipt,
  release_watch_receipt_parse,
  release_watch_receipt_path,
  release_watch_receipt_read,
  release_watch_receipt_write,
  release_watch_record_recovery_dispatch,
  release_watch_record_warm_cache_dispatch,
  release_watch_transition,
  release_watch_warm_cache_overlap,
  release_watch_warm_cache_transition,
} from "../lib/release_watch_state"

const REQUIRED = ["publish-release.yml", "build-release-binaries.yml"]

const WARM_SOURCE_SHA = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn initial() -> ReleaseWatchReceipt {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      publication: {
        version: "1.2.3",
        local_branch: "release/v1.2.3",
        remote_ref: "release-attempt/v1.2.3/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        head_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      },
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      required_workflows: REQUIRED,
      created_at: "2026-07-13T00:00:00Z",
    },
  )
}

fn healthy() -> ReleaseWatchReceipt {
  return release_watch_transition(
    initial(),
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:01:00Z"},
  ).receipt
}

fn accepted(receipt: ReleaseWatchReceipt, run_id: int) -> ReleaseWatchReceipt {
  return release_watch_record_warm_cache_dispatch(
    receipt,
    {
      accepted: true,
      observed_at: "2026-07-13T00:02:00Z",
      workflow_run_id: run_id,
      workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/${run_id}",
      source_sha: WARM_SOURCE_SHA,
      message: "dispatch accepted",
    },
  )
}

fn warm_run(run_id: int, status: string, conclusion: string) -> ReleaseWatchWarmCacheRun {
  return {
    workflow_run_id: run_id,
    workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/${run_id}",
    source_sha: WARM_SOURCE_SHA,
    event: "workflow_dispatch",
    head_branch: "main",
    status: status,
    conclusion: conclusion,
    started_at: "2026-07-13T00:03:00Z",
    completed_at: if status == "completed" {
      "2026-07-13T00:04:00Z"
    } else {
      ""
    },
  }
}

fn warm_jobs(conclusion: string) -> list<ReleaseWatchWarmCacheJob> {
  return [
    {name: "Resolve release context", status: "completed", conclusion: "success"},
    {name: "Build aarch64-apple-darwin", status: "completed", conclusion: conclusion},
    {name: "Build aarch64-unknown-linux-gnu", status: "completed", conclusion: conclusion},
    {name: "Build x86_64-apple-darwin", status: "completed", conclusion: conclusion},
    {name: "Build x86_64-pc-windows-msvc", status: "completed", conclusion: conclusion},
    {name: "Build x86_64-unknown-linux-gnu", status: "completed", conclusion: conclusion},
  ]
}

pipeline test_release_watch_state_is_deterministic_and_resumable(task) {
  const receipt = initial()
  const pending = release_watch_transition(
    receipt,
    {
      runs: [
        {
          id: 11,
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          head_branch: "v1.2.3",
        },
        {
          id: 12,
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          head_branch: "v1.2.3",
        },
      ],
      assets_ready: false,
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz"],
      observed_at: "2026-07-13T00:01:00Z",
    },
  )
  assert_eq(pending.action, "wait")
  assert_eq(pending.receipt.observed_run_ids, [11, 12])
  const complete = release_watch_transition(
    pending.receipt,
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:02:00Z"},
  )
  assert_eq(complete.action, "complete")
  assert_eq(complete.receipt.state, "healthy")
}

pipeline test_warm_cache_initial_dispatch_persists_exact_identity(task) {
  const receipt = healthy()
  const decision = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:02:00Z",
      release_pr_merged: true,
      overlap_active: false,
      run: nil,
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(decision.action, "dispatch")
  const persisted = accepted(receipt, 101)
  assert_eq(persisted.warm_cache.state, "dispatch_accepted")
  assert_eq(persisted.warm_cache.source_sha, WARM_SOURCE_SHA)
  assert_eq(persisted.warm_cache.workflow_run_id, 101)
  assert_eq(
    persisted.warm_cache.workflow_run_url,
    "https://github.com/burin-labs/harn/actions/runs/101",
  )
  assert_eq(persisted.warm_cache.attempt_count, 1)
}

pipeline test_warm_cache_running_resume_never_redispatches(task) {
  const receipt = accepted(healthy(), 102)
  const running = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:03:00Z",
      release_pr_merged: true,
      overlap_active: false,
      run: warm_run(102, "in_progress", ""),
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(running.action, "wait")
  assert_eq(running.warm_cache.state, "running")
  const resumed = release_watch_warm_cache_transition(
    running.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:03:30Z",
      release_pr_merged: true,
      overlap_active: false,
      run: warm_run(102, "in_progress", ""),
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(resumed.action, "wait")
  assert_eq(resumed.warm_cache.workflow_run_id, 102)
  assert_eq(resumed.warm_cache.attempt_count, 1)
}

pipeline test_warm_cache_suppression_retries_only_after_overlap_clears(task) {
  const receipt = accepted(healthy(), 103)
  const suppressed = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:04:00Z",
      release_pr_merged: true,
      overlap_active: true,
      run: warm_run(103, "completed", "success"),
      jobs: [
        {name: "Resolve release context", status: "completed", conclusion: "success"},
        {name: "Build $" + "{{ matrix.target }}", status: "completed", conclusion: "skipped"},
      ],
      jobs_observed: true,
    },
  )
  assert_eq(suppressed.warm_cache.state, "suppressed")
  const held = release_watch_warm_cache_transition(
    suppressed.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:05:00Z",
      release_pr_merged: true,
      overlap_active: true,
      run: nil,
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(held.action, "wait")
  assert_eq(held.warm_cache.attempt_count, 1)
  const retried = release_watch_warm_cache_transition(
    held.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:06:00Z",
      release_pr_merged: true,
      overlap_active: false,
      run: nil,
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(retried.action, "dispatch")
}

pipeline test_warm_cache_waits_for_release_pr_merge(task) {
  const receipt = healthy()
  const held = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:02:00Z",
      release_pr_merged: false,
      overlap_active: false,
      run: nil,
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(held.action, "wait")
  assert(contains(held.warm_cache.message, "release pull request to merge"))
}

pipeline test_warm_cache_matrix_success_is_terminal(task) {
  const receipt = accepted(healthy(), 104)
  const completed = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:04:00Z",
      release_pr_merged: true,
      overlap_active: false,
      run: warm_run(104, "completed", "success"),
      jobs: warm_jobs("success"),
      jobs_observed: true,
    },
  )
  assert_eq(completed.action, "complete")
  assert_eq(completed.warm_cache.state, "completed")
  assert(contains(completed.warm_cache.message, "5 successful matrix build job"))
  const applied = release_watch_apply_warm_cache_transition(receipt, completed)
  assert_eq(applied.warm_cache.finished_at, "2026-07-13T00:04:00Z")
}

pipeline test_warm_cache_terminal_failure_is_explicit(task) {
  const receipt = accepted(healthy(), 105)
  const failed = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:04:00Z",
      release_pr_merged: true,
      overlap_active: false,
      run: warm_run(105, "completed", "failure"),
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(failed.action, "fail")
  assert_eq(failed.warm_cache.state, "failed")
  assert(contains(failed.warm_cache.message, "completed with failure"))
  const partial = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:05:00Z",
      release_pr_merged: true,
      overlap_active: false,
      run: warm_run(105, "completed", "success"),
      jobs: [
        {name: "Build x86_64-apple-darwin", status: "completed", conclusion: "success"},
        {name: "Build x86_64-unknown-linux-gnu", status: "completed", conclusion: "skipped"},
      ],
      jobs_observed: true,
    },
  )
  assert_eq(partial.action, "fail")
  assert(contains(partial.warm_cache.message, "skipped part"))
  const missing_matrix = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:06:00Z",
      release_pr_merged: true,
      overlap_active: false,
      run: warm_run(105, "completed", "success"),
      jobs: [{name: "Resolve release context", status: "completed", conclusion: "success"}],
      jobs_observed: true,
    },
  )
  assert_eq(missing_matrix.action, "fail")
  assert(contains(missing_matrix.warm_cache.message, "no matrix build jobs"))
  const incomplete_matrix = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:06:30Z",
      release_pr_merged: true,
      overlap_active: false,
      run: warm_run(105, "completed", "success"),
      jobs: [
        {name: "Build x86_64-apple-darwin", status: "completed", conclusion: "success"},
        {name: "Build x86_64-unknown-linux-gnu", status: "completed", conclusion: "success"},
      ],
      jobs_observed: true,
    },
  )
  assert_eq(incomplete_matrix.action, "fail")
  assert(contains(incomplete_matrix.warm_cache.message, "matrix identity drifted"))
  const wrong_run: ReleaseWatchWarmCacheRun = {
    workflow_run_id: 105,
    workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/105",
    source_sha: "cccccccccccccccccccccccccccccccccccccccc",
    event: "workflow_dispatch",
    head_branch: "main",
    status: "in_progress",
    conclusion: "",
    started_at: "2026-07-13T00:03:00Z",
    completed_at: "",
  }
  const wrong_source = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:07:00Z",
      release_pr_merged: true,
      overlap_active: false,
      run: wrong_run,
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(wrong_source.action, "fail")
  assert(contains(wrong_source.warm_cache.message, "identity changed"))
  const wrong_event_run: ReleaseWatchWarmCacheRun = {
    workflow_run_id: 105,
    workflow_run_url: "https://github.com/burin-labs/harn/actions/runs/105",
    source_sha: WARM_SOURCE_SHA,
    event: "push",
    head_branch: "main",
    status: "in_progress",
    conclusion: "",
    started_at: "2026-07-13T00:03:00Z",
    completed_at: "",
  }
  const wrong_event = release_watch_warm_cache_transition(
    receipt.warm_cache,
    true,
    {
      observed_at: "2026-07-13T00:07:30Z",
      release_pr_merged: true,
      overlap_active: false,
      run: wrong_event_run,
      jobs: [],
      jobs_observed: false,
    },
  )
  assert_eq(wrong_event.action, "fail")
  assert(contains(wrong_event.warm_cache.message, "identity changed"))
}

pipeline test_release_watch_warm_cache_recovery_overlap_is_conservative_without_run_identity(task) {
  const receipt = release_watch_record_recovery_dispatch(healthy(), "2026-07-13T00:02:00Z", true)
  const active_recovery = {
    id: 201,
    event: "workflow_dispatch",
    head_branch: "main",
    head_sha: "cccccccccccccccccccccccccccccccccccccccc",
    created_at: "2026-07-13T00:02:01Z",
    status: "in_progress",
  }
  assert_eq(release_watch_warm_cache_overlap(receipt, [active_recovery]), true)
  assert_eq(
    release_watch_warm_cache_overlap(receipt, [{...active_recovery, status: "completed"}]),
    false,
  )
  assert_eq(
    release_watch_warm_cache_overlap(
      receipt,
      [{...active_recovery, id: 202, created_at: "2026-07-13T00:01:59Z"}],
    ),
    false,
  )
}

pipeline test_release_watch_receipt_v3_persistence_rejects_legacy_or_malformed_state(task) {
  const path = path_join(harness.fs.temp_dir(), "release-watch-" + uuid_v7(), "v1.2.3.json")
  const receipt = accepted(healthy(), 106)
  release_watch_receipt_write(path, receipt)
  assert_eq(release_watch_receipt_read(path), receipt)
  assert_eq(release_watch_receipt_parse({...receipt, state: "invented-state"}), nil)
  assert_eq(
    release_watch_receipt_parse({...receipt, schema_version: "release_harn.publish_watch.v2"}),
    nil,
  )
  assert_eq(
    release_watch_receipt_parse({...receipt, publication: {...receipt.publication, head_oid: "bad"}}),
    nil,
  )
  assert_eq(
    release_watch_receipt_parse({...receipt, warm_cache: {...receipt.warm_cache, workflow_run_id: 0}}),
    nil,
  )
  const never_dispatched = initial()
  assert_eq(
    release_watch_receipt_parse(
      {...never_dispatched, warm_cache: {...never_dispatched.warm_cache, attempt_count: 1}},
    ),
    nil,
  )
  assert_eq(
    release_watch_receipt_path("/tmp/release-runs", "v1.2.3"),
    "/tmp/release-runs/watches/v1.2.3.json",
  )
  const invalid = try {
    release_watch_receipt_path("/tmp/release-runs", "../bad")
  }
  assert(is_err(invalid))
}
