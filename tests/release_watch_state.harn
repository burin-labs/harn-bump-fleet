import {
  release_watch_receipt,
  release_watch_receipt_parse,
  release_watch_receipt_path,
  release_watch_receipt_read,
  release_watch_receipt_write,
  release_watch_record_recovery_dispatch,
  release_watch_transition,
} from "../lib/release_watch_state"

const REQUIRED = ["publish-release.yml", "build-release-binaries.yml"]

fn initial() {
  return release_watch_receipt(
    {
      tag: "v1.2.3",
      slug: "burin-labs/harn",
      pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      pr_url: "https://github.com/burin-labs/harn/pull/1",
      required_workflows: REQUIRED,
      created_at: "2026-07-13T00:00:00Z",
    },
  )
}

pipeline test_release_watch_state_is_deterministic_and_resumable(task) {
  const receipt = initial()
  assert_eq(receipt.state, "pending")
  assert_eq(receipt.recovery.dispatched, false)
  const pending = release_watch_transition(
    receipt,
    {
      runs: [
        {
          databaseId: 10,
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v1.2.2",
        },
        {
          databaseId: 11,
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "success",
          headBranch: "v1.2.3",
        },
        {
          databaseId: 12,
          workflow: "build-release-binaries.yml",
          status: "in_progress",
          conclusion: "",
          headBranch: "v1.2.3",
        },
      ],
      assets_ready: false,
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz"],
      observed_at: "2026-07-13T00:01:00Z",
    },
  )
  assert_eq(pending.action, "wait")
  assert_eq(pending.receipt.state, "pending")
  assert_eq(pending.receipt.observed_run_ids, [11, 12])
  const recovered = release_watch_transition(
    pending.receipt,
    {
      runs: pending.receipt.observed_run_ids
        .map(
        { id ->
          if id == 11 {
            return {
              databaseId: id,
              workflow: "publish-release.yml",
              status: "completed",
              conclusion: "success",
              headBranch: "v1.2.3",
            }
          }
          return {
            databaseId: id,
            workflow: "build-release-binaries.yml",
            status: "completed",
            conclusion: "failure",
            headBranch: "v1.2.3",
          }
        },
      ),
      assets_ready: false,
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz"],
      observed_at: "2026-07-13T00:02:00Z",
    },
  )
  assert_eq(recovered.action, "dispatch_binary_recovery")
  assert_eq(recovered.recovery_workflow, "build-release-binaries.yml")
  const dispatched = release_watch_record_recovery_dispatch(recovered.receipt, "2026-07-13T00:02:01Z", true)
  const resumed = release_watch_transition(
    dispatched,
    {
      runs: [],
      assets_ready: false,
      missing_assets: ["harn-x86_64-apple-darwin.tar.gz"],
      observed_at: "2026-07-13T00:03:00Z",
    },
  )
  assert_eq(resumed.action, "wait")
  assert_eq(resumed.receipt.recovery.dispatched, true)
  assert_eq(resumed.receipt.observed_run_ids, [11, 12])
  const complete = release_watch_transition(
    resumed.receipt,
    {runs: [], assets_ready: true, missing_assets: [], observed_at: "2026-07-13T00:04:00Z"},
  )
  assert_eq(complete.action, "complete")
  assert_eq(complete.receipt.state, "healthy")
}

pipeline test_release_watch_state_keeps_publish_failure_manual(task) {
  const transition = release_watch_transition(
    initial(),
    {
      runs: [
        {
          databaseId: 21,
          workflow: "publish-release.yml",
          status: "completed",
          conclusion: "failure",
          headBranch: "v1.2.3",
        },
      ],
      assets_ready: false,
      missing_assets: ["SHA256SUMS"],
      observed_at: "2026-07-13T00:01:00Z",
    },
  )
  assert_eq(transition.action, "fail")
  assert_eq(transition.receipt.state, "failed")
}

pipeline test_release_watch_receipt_persistence_is_typed_and_atomic(task) {
  const path = path_join(harness.fs.temp_dir(), "release-watch-" + uuid_v7(), "v1.2.3.json")
  const receipt = initial()
  release_watch_receipt_write(path, receipt)
  const loaded = release_watch_receipt_read(path)
  assert(loaded != nil)
  assert_eq(loaded, receipt)
  assert_eq(harness.fs.exists(path), true)
  assert_eq(release_watch_receipt_parse({...receipt, state: "invented-state"}), nil)
  assert_eq(release_watch_receipt_parse({...receipt, unexpected: true}), nil)
  assert_eq(
    release_watch_receipt_path("/tmp/release-runs", "v1.2.3"),
    "/tmp/release-runs/watches/v1.2.3.json",
  )
  const invalid = try {
    release_watch_receipt_path("/tmp/release-runs", "../bad")
  }
  assert(is_err(invalid))
}
