import { ReleaseChainDriverAdapter, release_chain_drive } from "../lib/release_chain_driver"
import { ReleaseChainPlannedEffect } from "../lib/release_chain_effect"
import {
  ReleaseChainExactValueRead,
  release_chain_observed_value,
} from "../lib/release_chain_observe"
import {
  ReleaseChainControlReceipt,
  ReleaseChainEffectReceipt,
  ReleaseChainReceipt,
  ReleaseChainStage,
  release_chain_append_stage,
  release_chain_expected_stages,
  release_chain_new,
} from "../lib/release_chain_state"
import { ReleaseChainObservation, release_chain_reduce } from "../lib/release_chain_transition"

const SHA = "1111111111111111111111111111111111111111"

const NOW = "2026-09-07T21:00:00Z"

fn fresh_chain() -> ReleaseChainReceipt {
  return release_chain_new(
    "v0.10.133-main",
    {
      version: "0.10.133",
      tag: "v0.10.133",
      source_repo: "burin-labs/harn",
      base_ref: "main",
      initial_pin_sha: SHA,
    },
    NOW,
  )
}

fn exact_read(subject: string, expected: string, observed: string) -> ReleaseChainExactValueRead {
  return {
    subject: subject,
    kind: "fixture_read",
    expected: expected,
    observed: observed,
    source: "driver fixture",
    ref: "main",
    identity: SHA,
    readable: true,
    observed_at: NOW,
  }
}

fn proven_observation(stage: ReleaseChainStage) -> ReleaseChainObservation {
  return {
    schema_version: "harn.release-chain.observation.v1",
    stage: stage,
    predicate: "known non-null read equals its expected value",
    subjects: [
      release_chain_observed_value(exact_read("known subject", "yes", "yes"), "unknown", false),
    ],
    observed_at: NOW,
  }
}

fn empty_observation(stage: ReleaseChainStage) -> ReleaseChainObservation {
  return {
    schema_version: "harn.release-chain.observation.v1",
    stage: stage,
    predicate: "an empty scope proves nothing",
    subjects: [],
    observed_at: NOW,
  }
}

/** An unproven subject whose typed cause has exactly one bounded repair. */
fn repairable_observation(stage: ReleaseChainStage) -> ReleaseChainObservation {
  return {
    schema_version: "harn.release-chain.observation.v1",
    stage: stage,
    predicate: "the default branch carries the next development version",
    subjects: [
      {
        evidence: {
          subject: "harn Cargo.toml version",
          kind: "fixture_read",
          status: "missing",
          expected: "0.10.134-dev",
          observed: "0.10.133",
          source: "driver fixture",
          ref: "main",
          identity: SHA,
          observed_at: NOW,
        },
        proven: false,
        cause: "development_version_missing",
        retryable: true,
        detail: "main still carries the released version",
      },
    ],
    observed_at: NOW,
  }
}

fn stop_control(receipt: ReleaseChainReceipt) -> ReleaseChainControlReceipt {
  return {
    schema_version: "harn.release-chain.control.v1",
    chain_id: receipt.chain_id,
    revision: receipt.revision,
    sequence: 1,
    kind: "stop",
    actor: "release operator",
    reason: "stand down before the immutable tag",
    field: "",
    value: "",
    identity_bearing: false,
    created_at: NOW,
  }
}

fn effect_receipt(planned: ReleaseChainPlannedEffect) -> ReleaseChainEffectReceipt {
  return {
    kind: planned.kind,
    idempotency_key: planned.idempotency_key,
    target: planned.target,
    accepted_identity: SHA,
    read_back: [
      {
        subject: planned.subject,
        kind: "fixture_read_back",
        status: "observed",
        expected: "accepted",
        observed: "accepted",
        source: "driver fixture",
        ref: "main",
        identity: SHA,
        observed_at: NOW,
      },
    ],
    accepted_at: NOW,
  }
}

fn adapter(
  observation: fn(ReleaseChainStage) -> ReleaseChainObservation?,
  controls: list<ReleaseChainControlReceipt> = [],
) -> ReleaseChainDriverAdapter {
  return {
    observe: observation,
    apply_effect: fn(planned) { return effect_receipt(planned) },
    controls: fn(_cursor) { return controls },
    now: fn() { return NOW },
  }
}

fn advance_to(target: ReleaseChainStage) -> ReleaseChainReceipt {
  let receipt = fresh_chain()
  while receipt.current_stage != target {
    const decision = release_chain_reduce(receipt, proven_observation(receipt.current_stage), [])
    if decision.stage_receipt == nil {
      throw "fixture advance did not produce a stage receipt"
    }
    receipt = release_chain_append_stage(receipt, decision.stage_receipt, NOW)
  }
  return receipt
}

fn thrown(callback: closure) -> string {
  return try {
    callback()
    ""
  } catch (error) {
    to_string(error)
  }
}

/** The positive control the stop test below is measured against. */
pipeline test_a_clean_chain_drives_every_stage_to_complete(task: any) {
  const run = release_chain_drive(fresh_chain(), adapter(fn(stage) { proven_observation(stage) }))
  assert_eq(run.outcome, "complete")
  assert_eq(run.pending_count, 0)
  assert_eq(run.pending_stages, [])
  assert_eq(run.abandoned_stages, [])
  assert_eq(run.effects_applied, 0)
  assert_eq(run.proven_stages, release_chain_expected_stages(run.receipt))
  // One step per stage, then the step that reads the finished chain and says so.
  assert_eq(len(run.steps), len(release_chain_expected_stages(run.receipt)) + 1)
  assert_eq(unwrap(run.steps[0]).outcome, "advanced")
  assert_eq(unwrap(run.steps[len(run.steps) - 1]).action, "complete")
}

/**
 * The falsifier sub-ask 4 asks for. A stand-down mid-chain must abandon the
 * remaining stages, not merely stop the reporting, so both doors to the world
 * are tripwires: if the driver looks at the next stage or applies its effect,
 * the adapter throws and names what it touched.
 *
 * The positive control above drives this same fixture through every stage when
 * the control is absent, so a driver that silently did nothing at all would
 * fail there rather than pass here.
 */
pipeline test_a_stop_abandons_every_remaining_stage_without_touching_it(task: any) {
  const receipt = advance_to("cut")
  const tripwire: ReleaseChainDriverAdapter = {
    observe: fn(stage) {
      throw "the driver observed ${stage} after a stop"
    },
    apply_effect: fn(planned) {
      throw "the driver applied ${planned.kind} after a stop"
    },
    controls: fn(_cursor) { return [stop_control(receipt)] },
    now: fn() { return NOW },
  }
  const run = release_chain_drive(receipt, tripwire)
  assert_eq(run.outcome, "stopped")
  assert_eq(run.effects_applied, 0)
  assert_eq(len(run.steps), 1)
  assert_eq(unwrap(run.steps[0]).observed, false)
  assert(contains(run.abandoned_stages, "tag"))
  assert(contains(run.abandoned_stages, "publish"))
  assert(contains(run.abandoned_stages, "converge"))
  assert_eq(run.abandoned_count, run.pending_count)
  assert(!contains(run.abandoned_stages, "preflight"))
  assert(contains(run.proven_stages, "preflight"))
}

/** The tripwire fires when it should, so the stop test above cannot pass vacuously. */
pipeline test_the_tripwire_adapter_fires_without_the_stop(task: any) {
  const receipt = advance_to("cut")
  const tripwire: ReleaseChainDriverAdapter = {
    observe: fn(stage) {
      throw "the driver observed ${stage} after a stop"
    },
    apply_effect: fn(planned) {
      throw "the driver applied ${planned.kind} after a stop"
    },
    controls: fn(_cursor) { return [] },
    now: fn() { return NOW },
  }
  assert(contains(thrown({ -> release_chain_drive(receipt, tripwire) }), "the driver observed cut"))
}

/**
 * A run that is waiting owes the same stages a stopped run walked away from,
 * and the two must never read the same. Collapsing them would let a chain that
 * was stood down look like one that is still going to finish.
 */
pipeline test_waiting_owes_its_pending_stages_and_abandons_none(task: any) {
  const run = release_chain_drive(advance_to("cut"), adapter(fn(_stage) { nil }))
  assert_eq(run.outcome, "waiting")
  assert_eq(run.abandoned_stages, [])
  assert_eq(run.abandoned_count, 0)
  assert(run.pending_count > 0)
  assert(contains(run.pending_stages, "cut"))
  assert_eq(run.effects_applied, 0)
}

/** Only a planned repair may apply an effect, and only the effect it planned. */
pipeline test_an_effect_is_applied_only_from_a_planned_repair(task: any) {
  const run = release_chain_drive(
    fresh_chain(),
    adapter(
      fn(stage) { return if stage == "preflight" {
        repairable_observation(stage)
      } else {
        proven_observation(stage)
      } },
    ),
    2,
  )
  assert_eq(unwrap(run.steps[0]).action, "plan_repair")
  assert_eq(unwrap(run.steps[0]).outcome, "repairing")
  assert_eq(run.effects_applied, 1)
  assert_eq(len(unwrap(run.steps[0]).effects_applied), 1)
  assert_eq(unwrap(unwrap(run.steps[0]).effects_applied[0]).kind, "dispatch_development_cutover")
  // The bound is one attempt, so the second round escalates rather than
  // dispatching the same cutover again. A repair loop with no ceiling turns one
  // failure into a queue of identical failures.
  assert_eq(unwrap(run.steps[1]).outcome, "escalated")
  assert_eq(len(unwrap(run.steps[1]).effects_applied), 0)
  assert(contains(unwrap(run.steps[1]).reason, "bounded repair policy refused"))
  assert_eq(run.outcome, "escalated")
  assert(contains(run.pending_stages, "preflight"))
  // Every other outcome leaves the world alone.
  const advancing = release_chain_drive(
    fresh_chain(),
    adapter(fn(stage) { proven_observation(stage) }),
  )
  assert_eq(advancing.effects_applied, 0)
}

/**
 * An adapter that answered with some other effect's receipt would let the chain
 * record a repair it never made. The driver refuses rather than believing it.
 */
pipeline test_an_effect_receipt_must_describe_the_effect_that_was_planned(task: any) {
  const observation = fn(stage) { return repairable_observation(stage) }
  const wrong_key: ReleaseChainDriverAdapter = adapter(observation)
    + {
      apply_effect: fn(planned) { return effect_receipt(planned)
        + {idempotency_key: "release-chain:somebody-elses-key"} },
    }
  assert(
    contains(
      thrown({ -> release_chain_drive(fresh_chain(), wrong_key, 1) }),
      "does not carry the planned idempotency key",
    ),
  )
  const unread: ReleaseChainDriverAdapter = adapter(observation)
    + {apply_effect: fn(planned) { return effect_receipt(planned) + {read_back: []} }}
  assert(
    contains(
      thrown({ -> release_chain_drive(fresh_chain(), unread, 1) }),
      "must read back what it changed",
    ),
  )
  const wrong_target: ReleaseChainDriverAdapter = adapter(observation)
    + {apply_effect: fn(planned) { return effect_receipt(planned) + {target: "some other tag"} }}
  assert(
    contains(
      thrown({ -> release_chain_drive(fresh_chain(), wrong_target, 1) }),
      "names some other",
    ),
  )
}

/**
 * A driver that runs out of steps has proven nothing about the stages it never
 * reached, so it reports waiting with them named rather than an outcome that
 * reads like an ending.
 */
pipeline test_a_step_ceiling_reports_waiting_with_the_stages_still_owed(task: any) {
  const run = release_chain_drive(
    fresh_chain(),
    adapter(fn(stage) { proven_observation(stage) }),
    2,
  )
  assert_eq(run.outcome, "waiting")
  assert(contains(run.reason, "step ceiling"))
  assert_eq(len(run.steps), 2)
  assert(run.pending_count > 0)
  assert(contains(run.pending_stages, "converge"))
  assert_eq(run.abandoned_stages, [])
  assert_eq(run.proven_stages, ["preflight", "prepare"])
  const zero_steps = thrown(
    { -> release_chain_drive(fresh_chain(), adapter(fn(stage) { proven_observation(stage) }), 0) },
  )
  assert(contains(zero_steps, "at least one step"))
}

/** An empty subject scope escalates, and escalation applies nothing. */
pipeline test_an_empty_scope_escalates_and_applies_nothing(task: any) {
  const run = release_chain_drive(fresh_chain(), adapter(fn(stage) { empty_observation(stage) }))
  assert_eq(run.outcome, "escalated")
  assert_eq(run.effects_applied, 0)
  assert_eq(run.proven_stages, [])
  assert_eq(run.abandoned_count, run.pending_count)
  assert(run.pending_count > 0)
  assert(contains(unwrap(run.steps[0]).reason, "absence is not proof"))
}
