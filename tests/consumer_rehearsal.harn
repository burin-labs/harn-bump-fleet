import {
  REHEARSAL_PROOF_PREFIX,
  RehearsalSubject,
  rehearsal_contract_digest,
  rehearsal_coverage,
  rehearsal_proof_listing,
  rehearsal_proof_ref,
  rehearsal_proof_refs_from_ls_remote,
  rehearsal_proof_slug,
  rehearsal_subjects,
  rehearsal_work_plan,
} from "../lib/consumer_rehearsal"
import { ConsumerPretagProofJob } from "../lib/fleet_manifest"

const TIP = "c591312c7aa0b1ee9a7c50f5b0d0f5a8e2a4b6d1"

const OTHER_TIP = "0f68969aa0b1ee9a7c50f5b0d0f5a8e2a4b6d1c5"

const DIGEST = "69a9ccc7b50068e2dc11374519ef9b425a8e3e4d"

fn subject(slug: string, digest: string = DIGEST) -> RehearsalSubject {
  return {slug: slug, contract_digest: digest}
}

fn ref_for(slug: string, tip: string = TIP, digest: string = DIGEST) -> string {
  return rehearsal_proof_ref(tip, slug, digest)
}

pipeline test_a_proof_ref_names_the_revision_the_consumer_and_the_contract() {
  const ref = rehearsal_proof_ref(TIP, "burin-labs/harn-cloud", DIGEST)
  assert(starts_with(ref, "${REHEARSAL_PROOF_PREFIX}/${TIP}/"))
  assert(contains(ref, "burin-labs__harn-cloud"))
  assert(contains(ref, DIGEST.substring(0, 12)))
  assert_eq(rehearsal_proof_slug("Burin-Labs/Harn-Cloud"), "burin-labs__harn-cloud")
}

/**
 * The three things that must change the ref, each on its own.
 *
 * If any of them did not, a tick would skip a consumer whose situation had
 * actually changed, which is the whole failure this record exists to prevent:
 * a release standing on a rehearsal of something else.
 */
pipeline test_the_revision_the_consumer_and_the_contract_each_change_the_proof() {
  const base = rehearsal_proof_ref(TIP, "burin-labs/harn-cloud", DIGEST)
  assert(rehearsal_proof_ref(OTHER_TIP, "burin-labs/harn-cloud", DIGEST) != base)
  assert(rehearsal_proof_ref(TIP, "burin-labs/burin-code", DIGEST) != base)
  assert(rehearsal_proof_ref(TIP, "burin-labs/harn-cloud", "ffffffffffffffff") != base)
}

pipeline test_a_malformed_revision_or_digest_is_refused_rather_than_encoded() {
  for bad_tip in ["", "c591312", "not-a-sha"] {
    const err = try {
      rehearsal_proof_ref(bad_tip, "a/b", DIGEST)
      ""
    } catch (e) {
      to_string(e)
    }
    assert(contains(err, "40-hex"), "a malformed revision must refuse, got: ${err}")
  }
  const digest_err = try {
    rehearsal_proof_ref(TIP, "a/b", "zz")
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(digest_err, "hex contract digest"))
}

pipeline test_an_unproved_fleet_is_all_work() {
  const subjects = [subject("burin-labs/harn-cloud"), subject("burin-labs/burin-code")]
  const plan = rehearsal_work_plan(TIP, subjects, [])
  assert_eq(plan.no_op, false)
  assert_eq(len(plan.unproved), 2)
  assert_eq(len(plan.proved), 0)
  assert_eq(plan.considered, 2)
}

/**
 * The change-gate itself: an unchanged fleet costs one listing.
 *
 * This is the ruling this module exists to satisfy. Without it an hourly tick
 * runs thirty-two full runtime builds to re-learn what it already knew.
 */
pipeline test_an_unchanged_fleet_is_a_no_op_naming_the_revision() {
  const subjects = [subject("burin-labs/harn-cloud"), subject("burin-labs/burin-code")]
  const plan = rehearsal_work_plan(
    TIP,
    subjects,
    [ref_for("burin-labs/harn-cloud"), ref_for("burin-labs/burin-code")],
  )
  assert_eq(plan.no_op, true)
  assert_eq(len(plan.unproved), 0)
  assert(contains(plan.detail, "unchanged since ${TIP}"))
}

/** A moved Harn tip invalidates every proof, because every proof named the old one. */
pipeline test_a_moved_harn_tip_makes_the_whole_fleet_unproved_again() {
  const subjects = [subject("burin-labs/harn-cloud"), subject("burin-labs/burin-code")]
  const plan = rehearsal_work_plan(
    OTHER_TIP,
    subjects,
    [ref_for("burin-labs/harn-cloud"), ref_for("burin-labs/burin-code")],
  )
  assert_eq(plan.no_op, false)
  assert_eq(len(plan.unproved), 2)
}

/** A consumer whose gate contract changed is unproved even at the same tip. */
pipeline test_a_changed_consumer_contract_makes_only_that_consumer_unproved() {
  const plan = rehearsal_work_plan(
    TIP,
    [subject("burin-labs/harn-cloud", "aaaaaaaaaaaaaaaa"), subject("burin-labs/burin-code")],
    [ref_for("burin-labs/harn-cloud"), ref_for("burin-labs/burin-code")],
  )
  assert_eq(plan.no_op, false)
  assert_eq(len(plan.unproved), 1)
  assert_eq(plan.unproved[0]?.slug, "burin-labs/harn-cloud")
  assert_eq(len(plan.proved), 1)
}

/**
 * An unreadable listing is not an empty one, and the difference is not guessable.
 *
 * Treating a failed remote read as "nothing proved" would re-gate the whole
 * fleet on every transient failure. Treating it as "all proved" would let a
 * release cut on a rehearsal that was never read. So it refuses instead of
 * choosing, and the caller has to say which it saw.
 */
/**
 * A rehearsal with no subjects is not a no-op.
 *
 * This is the negative control for the whole plan. An empty fleet satisfies
 * "nothing is unproved" trivially, and recording that as a successful tick
 * would leave a proof that stands for nothing.
 */
pipeline test_a_rehearsal_with_no_subjects_does_not_count_as_proved() {
  const plan = rehearsal_work_plan(TIP, [], [])
  assert_eq(plan.no_op, false)
  assert_eq(plan.considered, 0)
  assert(contains(plan.detail, "proved nothing"))
}

pipeline test_coverage_admits_a_release_whose_every_consumer_is_proved_at_its_tip() {
  const coverage = rehearsal_coverage(
    TIP,
    [subject("burin-labs/harn-cloud"), subject("burin-labs/burin-code")],
    Ok([ref_for("burin-labs/harn-cloud"), ref_for("burin-labs/burin-code")]),
  )
  assert_eq(coverage.covered, true)
  assert_eq(coverage.considered, 2)
}

pipeline test_coverage_names_the_consumers_that_are_missing() {
  const coverage = rehearsal_coverage(
    TIP,
    [subject("burin-labs/harn-cloud"), subject("burin-labs/burin-code")],
    Ok([ref_for("burin-labs/harn-cloud")]),
  )
  assert_eq(coverage.covered, false)
  assert_eq(coverage.missing, ["burin-labs/burin-code"])
  assert(contains(coverage.detail, "burin-labs/burin-code"))
}

/**
 * The two ways coverage could pass vacuously, both refused.
 *
 * An empty subject list satisfies "nothing is missing", and an unreadable
 * listing produces no misses either. Both would admit a release on the strength
 * of not having looked.
 */
pipeline test_coverage_refuses_when_it_has_nothing_to_check_or_could_not_look() {
  const empty = rehearsal_coverage(TIP, [], Ok([]))
  assert_eq(empty.covered, false)
  assert(contains(empty.detail, "verdict over nothing"))
  const unreadable = rehearsal_coverage(
    TIP,
    [subject("burin-labs/harn-cloud")],
    Err(
      {
        kind: "proof_listing_unreadable",
        detail: "the rehearsal proof listing could not be read, so no consumer can be shown proved",
      },
    ),
  )
  assert_eq(unreadable.covered, false)
  assert(contains(unreadable.detail, "could not be read"))
}

fn repo(
  slug: string = "burin-labs/harn-cloud",
  workflow: string = "harn-pin-gate.yml",
  inputs: dict<string, string> = {revision: "{revision}", version: "{version}"},
  proof_job: ConsumerPretagProofJob? = nil,
  contract: string = "aa11bb22",
) -> FleetRepository {
  const job = proof_job
  if job == nil {
    return {
      slug: slug,
      directory: slug,
      pretag_gate_workflow: workflow,
      pretag_gate_inputs: inputs,
      consumer_contract_sha256: contract,
    }
  }
  return {
    slug: slug,
    directory: slug,
    pretag_gate_workflow: workflow,
    pretag_gate_inputs: inputs,
    pretag_gate_proof_job: job,
    consumer_contract_sha256: contract,
  }
}

const DEFAULT_INPUTS: dict<string, string> = {revision: "{revision}", version: "{version}"}

/**
 * Everything a consumer can change under a fixed Harn revision moves the digest.
 *
 * Each of these is a real way a consumer's answer stops meaning what the last
 * proof said it meant, and a digest that missed any one of them would let a
 * release stand on a rehearsal of a different question.
 */
pipeline test_every_part_of_a_consumers_contract_changes_its_digest() {
  const base = rehearsal_contract_digest(repo())
  assert(rehearsal_contract_digest(repo("burin-labs/harn-cloud", "other.yml")) != base)
  assert(
    rehearsal_contract_digest(
      repo("burin-labs/harn-cloud", "harn-pin-gate.yml", {revision: "{revision}"}),
    )
      != base,
  )
  assert(
    rehearsal_contract_digest(
      repo("burin-labs/harn-cloud", "harn-pin-gate.yml", DEFAULT_INPUTS, {name: "b", step: "t"}),
    )
      != base,
  )
  assert(
    rehearsal_contract_digest(
      repo("burin-labs/harn-cloud", "harn-pin-gate.yml", DEFAULT_INPUTS, nil, "ffff"),
    )
      != base,
  )
  // An unresolved contract is its own identity, never the same as a real one.
  assert(
    rehearsal_contract_digest(
      repo("burin-labs/harn-cloud", "harn-pin-gate.yml", DEFAULT_INPUTS, nil, ""),
    )
      != base,
  )
}

/** The digest is stable, or every tick would re-gate an unchanged fleet forever. */
pipeline test_an_unchanged_contract_keeps_its_digest() {
  assert_eq(rehearsal_contract_digest(repo()), rehearsal_contract_digest(repo()))
  // Input order is not a change. A dict that iterated differently would
  // invalidate every proof on a whim.
  assert_eq(
    rehearsal_contract_digest(
      repo(
        "burin-labs/harn-cloud",
        "harn-pin-gate.yml",
        {version: "{version}", revision: "{revision}"},
      ),
    ),
    rehearsal_contract_digest(repo()),
  )
}

/**
 * Only consumers that declare a pre-tag gate are subjects.
 *
 * A row without one is never dispatched, so counting it would leave coverage
 * permanently short of a consumer no rehearsal can ever prove. A row whose
 * contract went unread is still a subject: dropping that one would shrink the
 * fleet silently and let coverage read complete over a smaller set.
 */
pipeline test_subjects_are_the_consumers_that_declare_a_gate() {
  const subjects = rehearsal_subjects(
    [
      repo(),
      repo("burin-labs/burin-code", "harn-pin-gate.yml", DEFAULT_INPUTS, nil, ""),
      repo("burin-labs/harn-documents", ""),
    ],
  )
  assert_eq(len(subjects), 2)
  assert_eq(subjects[0]?.slug, "burin-labs/harn-cloud")
  assert_eq(subjects[1]?.slug, "burin-labs/burin-code")
  assert(subjects[0]?.contract_digest != subjects[1]?.contract_digest)
}

pipeline test_the_proof_listing_reads_ref_names_and_drops_half_lines() {
  const proved = ref_for("burin-labs/harn-cloud")
  const refs = rehearsal_proof_refs_from_ls_remote(
    "aa\t${proved}\nbb\trefs/heads/main\nnot-a-line\n\n",
  )
  assert_eq(refs, [proved])
}

/**
 * The listing refuses a revision it cannot have been given by a real caller.
 *
 * A short or non-hex tip would build a ref pattern that matches nothing, and
 * an empty match reads exactly like a fleet with no proofs, which is the one
 * answer this must never invent.
 */
pipeline test_the_proof_listing_refuses_a_malformed_revision(harness: Harness) {
  const result = rehearsal_proof_listing(harness.process, "not-a-sha")
  assert(is_err(result))
  assert_eq(unwrap_err(result).kind, "invalid_revision")
  assert(contains(unwrap_err(result).detail, "40-hex"))
}

/**
 * A failed listing is a typed error and an empty one is a successful read.
 *
 * This is the seam the whole change gate rests on: Err re-gates nothing and
 * stops the tick, while Ok([]) re-gates the entire fleet. Collapsing
 * them would either admit a release on an unread remote or burn thirty-two
 * builds on every transient failure.
 */
pipeline test_an_unreadable_listing_is_typed_and_an_empty_one_is_successful(harness: Harness) {
  const unreadable = rehearsal_proof_listing(harness.process, TIP, "/definitely/not-a-repository")
  assert(is_err(unreadable))
  assert_eq(unwrap_err(unreadable).kind, "proof_listing_unreadable")
  assert_eq(rehearsal_proof_listing(harness.process, TIP, "."), Ok([]))
}
