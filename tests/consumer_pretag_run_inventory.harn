/**
 * The bounded run inventory, in bytes and in what absence means.
 *
 * Split from the dispatch suite so neither file grows past the handwritten
 * source cap, and kept together because both halves answer one question: a
 * page is a byte budget, and a budget changes what an empty answer proves.
 */
import { ConsumerPretagRunRow, run_consumer_pretag_gates } from "../lib/consumer_pretag_dispatch"
import { GITHUB_ACTIONS_RUNS_PAGE } from "../lib/github"
import {
  FAST,
  REVISION,
  adapter,
  dated_row,
  row,
  target,
} from "../testdata/consumer_pretag_fixtures"

/**
 * A page of other candidates' runs, newest first, the way GitHub lists them.
 * Both keys descend together because the live listing's do: run numbers are
 * issued in creation order.
 */
fn other_runs(size: int) -> list<ConsumerPretagRunRow> {
  let rows: list<ConsumerPretagRunRow> = []
  for index in range(0, size) {
    rows = rows
      + [
        dated_row(
          row(900 - index, "completed", "success", "Some other candidate"),
          "2026-09-20T12:00:${to_string(59 - index)}Z",
        ),
      ]
  }
  return rows
}

/**
 * A full page on the RECOVERY read is refused, not treated as "no run yet".
 *
 * The recovery read polls for a run an interrupted earlier attempt may have
 * started. Its answers are wait longer or give up, and a full page supports
 * neither: a run pushed off the end and a run that never existed arrive
 * identically. The bound is reported instead of being silently resolved.
 */
pipeline test_a_full_page_on_the_recovery_read_refuses_instead_of_redispatching() {
  let dispatches = 0
  let reads = 0
  const partial = other_runs(GITHUB_ACTIONS_RUNS_PAGE - 1)
  const full = other_runs(GITHUB_ACTIONS_RUNS_PAGE)
  assert_eq(len(full), GITHUB_ACTIONS_RUNS_PAGE)
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [row(11, "completed", "success")],
      {
        dispatch: fn(_target) {
          dispatches = dispatches + 1
          return Ok({run_id: 11, head_sha: REVISION})
        },
        runs: fn(_target) {
          reads = reads + 1
          // The first read is the pre-dispatch one; the page fills underneath
          // the gate before the recovery poll reads it again.
          return Ok(
            if reads == 1 {
              partial
            } else {
              full
            },
          )
        },
      },
    ),
    FAST + {recovery_visibility_ms: 10},
  )
  assert(reads > 1, "the recovery read never ran, so this proves nothing about it")
  assert_eq(dispatches, 0)
  assert_eq(receipts[0]?.status, "unreadable")
  assert(contains(receipts[0]?.detail ?? "", "filled its page"))
  assert(contains(receipts[0]?.detail ?? "", "recovery-visible"))
}

/**
 * Negative control for the case above: a page that did NOT fill still means
 * what it says, so a genuinely undispatched candidate is still dispatched.
 * Without this the refusal could be a blanket stop rather than a bound.
 */
pipeline test_a_partial_inventory_page_still_dispatches_an_unseen_candidate() {
  let dispatches = 0
  const crowd = other_runs(GITHUB_ACTIONS_RUNS_PAGE - 1)
  assert_eq(len(crowd), GITHUB_ACTIONS_RUNS_PAGE - 1)
  let listed = crowd
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [row(11, "completed", "success")],
      {
        dispatch: fn(_target) {
          dispatches = dispatches + 1
          listed = [row(11, "completed", "success")] + crowd
          return Ok({run_id: 11, head_sha: REVISION})
        },
        runs: fn(_target) { return Ok(listed) },
      },
    ),
    FAST,
  )
  assert_eq(dispatches, 1)
  assert_eq(receipts[0]?.status, "passed")
}

/**
 * A FULL page before dispatch still dispatches, and that is the point of
 * splitting the rule by read.
 *
 * This candidate's run, if it existed, would have been created after every
 * run the page displaced, so a newest-first page answers "has it been
 * dispatched" whether or not it filled. Refusing here instead would stop the
 * gate permanently on any consumer with a long dispatch history, which is
 * exactly what a blanket full-page refusal did on 2026-09-20: a consumer with
 * 67 prior runs could never be gated again.
 */
pipeline test_a_full_page_before_dispatch_still_dispatches_an_unseen_candidate() {
  let dispatches = 0
  const crowd = other_runs(GITHUB_ACTIONS_RUNS_PAGE)
  assert_eq(len(crowd), GITHUB_ACTIONS_RUNS_PAGE)
  let listed = crowd
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [row(11, "completed", "success")],
      {
        dispatch: fn(_target) {
          dispatches = dispatches + 1
          listed = [row(11, "completed", "success")] + crowd
          return Ok({run_id: 11, head_sha: REVISION})
        },
        runs: fn(_target) { return Ok(listed) },
      },
    ),
    FAST,
  )
  assert_eq(dispatches, 1)
  assert_eq(receipts[0]?.status, "passed")
}

/**
 * Control for the premise the case above rests on: an inventory that is not
 * newest first is refused by name rather than read as absence.
 *
 * Nothing in the API contract we can check guarantees the ordering, so the
 * gate checks it on every read. The day it changes, this refuses instead of
 * dispatching duplicates silently.
 */
pipeline test_an_unsorted_inventory_page_refuses_before_dispatch() {
  let dispatches = 0
  const ordered = other_runs(4)
  // One run out of place by creation time: an older run listed above a newer.
  const jumbled = [ordered[1] ?? row(0, "completed", "success")]
    + [ordered[0] ?? row(0, "completed", "success")]
    + [ordered[2] ?? row(0, "completed", "success")]
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [row(11, "completed", "success")],
      {
        dispatch: fn(_target) {
          dispatches = dispatches + 1
          return Ok({run_id: 11, head_sha: REVISION})
        },
        runs: fn(_target) { return Ok(jumbled) },
      },
    ),
    FAST,
  )
  assert_eq(dispatches, 0)
  assert_eq(receipts[0]?.status, "unreadable")
  assert(contains(receipts[0]?.detail ?? "", "descending creation order"))
}

/**
 * The same premise where the listing carries no creation times: the run
 * number is issued in creation order, so it carries the ordering instead.
 * Without this arm a listing with the timestamps omitted would be admitted
 * unchecked, and absence would quietly stop meaning anything.
 */
pipeline test_an_unsorted_page_without_timestamps_refuses_before_dispatch() {
  let dispatches = 0
  const jumbled = [
    row(100, "completed", "success", "Some other candidate"),
    row(200, "completed", "success", "Some other candidate"),
  ]
  const receipts = run_consumer_pretag_gates(
    [target()],
    adapter(
      [row(11, "completed", "success")],
      {
        dispatch: fn(_target) {
          dispatches = dispatches + 1
          return Ok({run_id: 11, head_sha: REVISION})
        },
        runs: fn(_target) { return Ok(jumbled) },
      },
    ),
    FAST,
  )
  assert_eq(dispatches, 0)
  assert_eq(receipts[0]?.status, "unreadable")
  assert(contains(receipts[0]?.detail ?? "", "lower-numbered run"))
}

/**
 * The run inventory page must fit under the runtime's response ceiling.
 *
 * The ceiling is a real refusal, not a style rule: the runtime rejects a
 * response over 1 MiB as a network error, so a page that grows past it does
 * not degrade, it stops the reader entirely. On 2026-09-20 one consumer's
 * dispatch history reached 1,055,742 bytes across 67 runs at a page of 100,
 * crossing the ceiling by about 7 KB, and every inventory read began failing
 * with no change on either side. That is why this asserts the BYTE BOUND and
 * not merely the page number: a future page size is safe only if its worst
 * observed run size still fits, and a count alone cannot say that.
 *
 * The per-run figure is the measured worst case from that incident, rounded
 * up. It is deliberately not an average of anything smaller.
 */
pipeline test_the_run_inventory_page_fits_under_the_response_ceiling() {
  const response_ceiling_bytes = 1048576
  const observed_bytes_per_run = 15758
  const worst_case = GITHUB_ACTIONS_RUNS_PAGE * observed_bytes_per_run
  assert(
    worst_case < response_ceiling_bytes,
    "a page of ${to_string(GITHUB_ACTIONS_RUNS_PAGE)} runs at ${to_string(observed_bytes_per_run)}"
      + " bytes each is ${to_string(worst_case)} bytes, over the ${to_string(response_ceiling_bytes)}"
      + " byte ceiling",
  )
  // Margin, not a bare pass. A page sized to just fit today fails on the first
  // consumer whose runs carry more, and the failure reads as a network fault.
  assert(
    worst_case * 2 < response_ceiling_bytes,
    "a page of ${to_string(GITHUB_ACTIONS_RUNS_PAGE)} leaves under 2x headroom against the"
      + " response ceiling: ${to_string(worst_case)} of ${to_string(response_ceiling_bytes)} bytes",
  )
  // Negative control: the page size this replaced is genuinely over the
  // ceiling, so the bound above is a real constraint and not vacuous.
  assert(
    100 * observed_bytes_per_run > response_ceiling_bytes,
    "the incident's own page of 100 must not read as fitting, or this asserts nothing",
  )
}
