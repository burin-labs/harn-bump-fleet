import { decode_github_workflow } from "../lib/github_workflow"
import {
  shell_environment_reads,
  shell_github_env_exports,
  undeclared_job_variables,
} from "../lib/workflow_step_environment"

fn one_job_workflow(body: string) -> string {
  return "name: fixture\non: workflow_dispatch\njobs:\n  release:\n" + body
}

pipeline test_a_step_reading_a_variable_its_env_declares_is_clean(task: any) {
  const workflow = decode_github_workflow(
    one_job_workflow(
      "    runs-on: ubuntu-latest\n"
        + "    steps:\n"
        + "      - name: Run release harness\n"
        + "        env:\n"
        + "          RELEASE_MODE: prepare\n"
        + "        run: echo \"\${RELEASE_MODE}\"\n",
    ),
  )
  assert_eq(undeclared_job_variables(workflow.jobs.get("release") ?? {}), [])
}

pipeline test_a_step_reading_a_variable_nothing_declares_is_named(task: any) {
  // The exact regression this rule exists for: the read stayed in the body
  // after the `env:` entry was dropped, and under `set -u` the step aborts
  // well past the checkout, the mint, and the build.
  const workflow = decode_github_workflow(
    one_job_workflow(
      "    runs-on: ubuntu-latest\n"
        + "    steps:\n"
        + "      - name: Run release harness\n"
        + "        run: |\n"
        + "          set -euo pipefail\n"
        + "          echo \"\${RELEASE_MODE}\"\n",
    ),
  )
  const findings = undeclared_job_variables(workflow.jobs.get("release") ?? {})
  assert_eq(len(findings), 1)
  assert_eq(findings[0]?.step, "Run release harness")
  assert_eq(findings[0]?.variable, "RELEASE_MODE")
}

pipeline test_a_job_level_env_entry_declares_a_variable_for_every_step(task: any) {
  const workflow = decode_github_workflow(
    one_job_workflow(
      "    runs-on: ubuntu-latest\n"
        + "    env:\n"
        + "      RELEASE_MODE: prepare\n"
        + "    steps:\n"
        + "      - name: Later\n"
        + "        run: echo \"\${RELEASE_MODE}\"\n",
    ),
  )
  assert_eq(undeclared_job_variables(workflow.jobs.get("release") ?? {}), [])
}

pipeline test_an_earlier_step_can_declare_a_variable_through_github_env(task: any) {
  const workflow = decode_github_workflow(
    one_job_workflow(
      "    runs-on: ubuntu-latest\n"
        + "    steps:\n"
        + "      - name: Validate\n"
        + "        run: echo \"RELEASE_AT_SHA=abc\" >> \"$GITHUB_ENV\"\n"
        + "      - name: Later\n"
        + "        run: echo \"\${RELEASE_AT_SHA}\"\n",
    ),
  )
  assert_eq(undeclared_job_variables(workflow.jobs.get("release") ?? {}), [])
}

pipeline test_a_later_export_does_not_declare_an_earlier_read(task: any) {
  // Steps run in order, so a variable exported after the reader is not a
  // declaration. Accepting one would let the same abort through in reverse.
  const workflow = decode_github_workflow(
    one_job_workflow(
      "    runs-on: ubuntu-latest\n"
        + "    steps:\n"
        + "      - name: Early\n"
        + "        run: echo \"\${RELEASE_AT_SHA}\"\n"
        + "      - name: Validate\n"
        + "        run: echo \"RELEASE_AT_SHA=abc\" >> \"$GITHUB_ENV\"\n",
    ),
  )
  const findings = undeclared_job_variables(workflow.jobs.get("release") ?? {})
  assert_eq(len(findings), 1)
  assert_eq(findings[0]?.step, "Early")
}

pipeline test_the_runners_own_variables_need_no_declaration(task: any) {
  const workflow = decode_github_workflow(
    one_job_workflow(
      "    runs-on: ubuntu-latest\n"
        + "    steps:\n"
        + "      - name: Paths\n"
        + "        run: echo \"\${GITHUB_WORKSPACE}\" \"$RUNNER_TEMP\" \"$HOME\"\n",
    ),
  )
  assert_eq(undeclared_job_variables(workflow.jobs.get("release") ?? {}), [])
}

pipeline test_a_shell_local_and_a_github_expression_are_not_environment_reads(task: any) {
  // Case is the discriminator: lower case is a variable the body assigns, and
  // a `\${{ ... }}` expression is substituted before the shell ever sees it.
  const reads = shell_environment_reads(
    "args=(--mode \"\${RELEASE_MODE}\")\nprintf '%s' \"\${args[@]}\" \"\${{ inputs.mode }}\"\n",
  )
  assert_eq(reads, ["RELEASE_MODE"])
}

pipeline test_both_shell_read_forms_are_recognised(task: any) {
  const reads = shell_environment_reads("echo \"$RELEASE_BUMP\" \"\${RELEASE_PREID}\"\n")
  assert_eq(len(reads), 2)
  assert_eq(reads.contains("RELEASE_BUMP"), true)
  assert_eq(reads.contains("RELEASE_PREID"), true)
}

pipeline test_a_default_expansion_still_counts_as_a_read(task: any) {
  assert_eq(shell_environment_reads("echo \"\${RELEASE_PREID:-}\"\n"), ["RELEASE_PREID"])
}

pipeline test_an_export_is_read_from_the_redirect_not_from_prose(task: any) {
  const exports = shell_github_env_exports(
    "# RELEASE_DECOY=1 is not exported\necho \"RELEASE_AT_SHA=\${resolved}\" >> \"$GITHUB_ENV\"\n",
  )
  assert_eq(exports, ["RELEASE_AT_SHA"])
}
