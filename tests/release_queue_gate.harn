import { command_result_ok } from "std/command"
import { recorded_step } from "../lib/release_execution"
import { ReleaseQueueGate, release_queue_execute_reserved } from "../lib/release_queue_gate"
import { ReleaseQueueReservationPlan } from "../lib/release_queue_reservation"

pipeline test_active_reservation_is_refreshed_throughout_release_work(harness: Harness, task) {
  const refreshes = harness.runtime.shared_cell(
    {scope: "task_group", key: "queue-refresh-test-${harness.random.uuid_v7()}", initial: 0},
  )
  const plan: ReleaseQueueReservationPlan = {
    schema_version: "harn.release_queue.plan.v1",
    reservation_id: "test-reservation",
    repo: "burin-labs/harn",
    base_branch: "main",
    base_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    critical: [],
    options: {live_pull_numbers: [], noncritical_live_overrides: []},
    observed_entries: [],
    holds: [],
    preserved: [],
    refusals: [],
    safe: true,
  }
  const gate: ReleaseQueueGate = {
    enabled: true,
    root: harness.fs.temp_dir(),
    failure: "",
    plan: plan,
    audit: nil,
  }
  const result = release_queue_execute_reserved(
    harness,
    gate,
    { ->
      harness.clock.sleep_ms(95)
      return [recorded_step("release-complete", "mock", command_result_ok("done\n"))]
    },
    20,
    { ->
      harness.runtime.shared_set(refreshes, harness.runtime.shared_get(refreshes) + 1)
      return true
    },
  )
  assert_eq(result[0]?.name, "release-complete")
  assert(harness.runtime.shared_get(refreshes) >= 3)
}
