import { decode_github_workflow } from "../lib/github_workflow"
import {
  REHEARSAL_RATE_LIMIT_MARGIN_S,
  RehearsalApiBudget,
  RehearsalRateLimitDecision,
  read_rehearsal_api_budget,
  rehearsal_api_budget_line,
  rehearsal_api_spend_line,
  rehearsal_rate_limit_decision,
  rehearsal_revision_within_budget,
} from "../lib/rehearsal_rate_limit"
import {
  GithubClientOptions,
  GithubConnectorError,
  GithubConnectorResult,
} from "harn-github-connector/default"

const API = "https://rehearsal-rate-limit.test"

const SHA = "3333333333333333333333333333333333333333"

const NOW: int = 1790000000

// The record the connector returned on the run that lost the release an hour.
// Category and code are what the decision reads; the message is only for
// people, and nothing keys on it.
const RATE_LIMITED: GithubConnectorError = {
  code: "rate_limited",
  category: "rate_limit",
  http_status: 403,
  message: "github API request failed with status 403: API rate limit exceeded for installation",
}

const MISSING_SCOPES: GithubConnectorError = {
  code: "missing_scopes",
  category: "permission",
  http_status: 403,
  message: "github API request failed with status 403: Resource not accessible by integration",
}

fn budget(remaining: int, reset_epoch_s: int, limit: int = 5000) -> RehearsalApiBudget {
  return {
    observed: true,
    limit: limit,
    remaining: remaining,
    used: limit - remaining,
    reset_epoch_s: reset_epoch_s,
    reset_at: date_format(reset_epoch_s, "%Y-%m-%dT%H:%M:%SZ"),
    detail: "",
  }
}

fn unobserved() -> RehearsalApiBudget {
  return {
    observed: false,
    limit: 0,
    remaining: 0,
    used: 0,
    reset_epoch_s: 0,
    reset_at: "",
    detail: "the rate limit read itself failed",
  }
}

/** Index the decision list through a refusal, so a missing one is not a nil read. */
fn first_decision(decisions: list<RehearsalRateLimitDecision>) -> RehearsalRateLimitDecision {
  if len(decisions) == 0 {
    throw "the outcome recorded no decision"
  }
  return decisions[0]
    ?? {
      action: "fail",
      reason: "",
      summary: "",
      wait_seconds: 0,
      job_budget_remaining_s: 0,
      budget: unobserved(),
    }
}

/**
 * The two readings a mocked revision read can return, declared with their
 * full result type so a closure that only ever refuses still types as one.
 */
fn refused() -> GithubConnectorResult<string> {
  return Err(RATE_LIMITED)
}

fn proceeded() -> GithubConnectorResult<string> {
  return Ok(SHA)
}

fn options() -> GithubClientOptions {
  return {api_base_url: API, installation_token: "rate-limit-fixture", retry: {max_attempts: 1}}
}

fn mock_rate_limit(testing: HarnessTesting, remaining: int, reset_epoch_s: int) {
  testing.http_mock(
    "GET",
    API + "/rate_limit",
    {
      status: 200,
      body: json_stringify(
        {
          resources: {
            core: {limit: 5000, remaining: remaining, used: 5000 - remaining, reset: reset_epoch_s},
          },
        },
      ),
    },
  )
}

/**
 * The headline case: the limit lifts inside the time the job still holds.
 *
 * This is the run that was lost. It met the limit on its first call with
 * eighty-nine of its ninety minutes left, and abandoning the only proof a
 * release preflight can read cost the release an hour.
 */
pipeline test_a_reset_inside_the_job_budget_is_a_wait() {
  const decision = rehearsal_rate_limit_decision(RATE_LIMITED, budget(0, NOW + 600), NOW, 5400)
  assert_eq(decision.action, "wait")
  assert_eq(decision.reason, "rate_limit_reset_within_job_budget")
  assert_eq(decision.wait_seconds, 600)
  // The receipt must carry the time, not only the verdict.
  assert(contains(decision.summary, decision.budget.reset_at))
  assert(contains(decision.summary, "5400s left"))
}

/**
 * The control on the other side. A reset the job cannot outlast is a failure,
 * and the failure has to say when a retry can succeed; otherwise the cheapest
 * next move is a re-dispatch straight back into the same limit.
 */
pipeline test_a_reset_outside_the_job_budget_fails_naming_the_time() {
  const decision = rehearsal_rate_limit_decision(RATE_LIMITED, budget(0, NOW + 3000), NOW, 600)
  assert_eq(decision.action, "fail")
  assert_eq(decision.reason, "rate_limit_reset_outside_job_budget")
  assert(contains(decision.summary, decision.budget.reset_at))
  assert(contains(decision.summary, "3000s away"))
  assert(contains(decision.summary, "600s left"))
  assert(contains(decision.summary, "re-dispatch after"))
}

/**
 * The margin is load-bearing, so it gets its own case.
 *
 * A wait that ends exactly as the job dies spends the whole window and proves
 * nothing. The boundary is the reset plus the work the run still owes.
 */
pipeline test_a_wait_that_leaves_no_time_to_work_is_a_failure() {
  const fits = rehearsal_rate_limit_decision(
    RATE_LIMITED,
    budget(0, NOW + 600),
    NOW,
    600 + REHEARSAL_RATE_LIMIT_MARGIN_S,
  )
  assert_eq(fits.action, "wait")
  const does_not = rehearsal_rate_limit_decision(
    RATE_LIMITED,
    budget(0, NOW + 600),
    NOW,
    600 + REHEARSAL_RATE_LIMIT_MARGIN_S - 1,
  )
  assert_eq(does_not.action, "fail")
  assert_eq(does_not.reason, "rate_limit_reset_outside_job_budget")
}

/** The third control: a 403 that is not a rate limit is not this module's. */
pipeline test_a_non_rate_limit_403_is_left_to_the_existing_failure_path() {
  const decision = rehearsal_rate_limit_decision(MISSING_SCOPES, budget(0, NOW + 60), NOW, 5400)
  assert_eq(decision.action, "not_rate_limited")
  assert_eq(decision.wait_seconds, 0)
  assert(contains(decision.summary, "missing_scopes"))
  assert(contains(decision.summary, "permission"))
}

/**
 * An unreadable budget is not an exhausted one.
 *
 * Waiting needs a time to wait for. Without one there is nothing to sleep
 * until and nothing honest to print, so this refuses instead of sleeping on a
 * number it invented.
 */
pipeline test_an_unreadable_budget_refuses_rather_than_waiting_blind() {
  const decision = rehearsal_rate_limit_decision(RATE_LIMITED, unobserved(), NOW, 5400)
  assert_eq(decision.action, "fail")
  assert_eq(decision.reason, "rate_limit_reset_unknown")
  assert_eq(decision.wait_seconds, 0)
}

/**
 * A rate-limit refusal with core budget left is a secondary limit, and the
 * core reset is the wrong clock for it. Waiting on that clock would spend the
 * job's window on an unrelated deadline.
 */
pipeline test_a_secondary_limit_does_not_wait_on_the_core_reset() {
  const decision = rehearsal_rate_limit_decision(RATE_LIMITED, budget(4200, NOW + 60), NOW, 5400)
  assert_eq(decision.action, "fail")
  assert_eq(decision.reason, "rate_limit_without_exhausted_core_budget")
  assert(contains(decision.summary, "4200 of 5000"))
  assert(contains(decision.summary, "secondary limit"))
}

/** A reset already in the past is a wait of nothing, never a negative one. */
pipeline test_a_reset_already_past_waits_zero() {
  const decision = rehearsal_rate_limit_decision(RATE_LIMITED, budget(0, NOW - 90), NOW, 5400)
  assert_eq(decision.action, "wait")
  assert_eq(decision.wait_seconds, 0)
}

/** The budget reading is read from GitHub's own accounting, field by field. */
pipeline test_the_budget_is_read_from_the_rate_limit_endpoint(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_rate_limit(harness.testing, 17, NOW + 120)
  const observed = read_rehearsal_api_budget(harness, options())
  assert(observed.observed)
  assert_eq(observed.remaining, 17)
  assert_eq(observed.limit, 5000)
  assert_eq(observed.used, 4983)
  assert_eq(observed.reset_epoch_s, NOW + 120)
  assert(contains(rehearsal_api_budget_line("opening API budget", observed), "17 of 5000"))
}

/**
 * A budget read that fails reports that it failed.
 *
 * Returning zeros would be indistinguishable from an exhausted budget, and the
 * decision above would then wait until an epoch-zero reset, which is to say
 * not at all, while reporting that it had waited.
 */
pipeline test_a_failed_budget_read_is_unobserved_not_empty(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    API + "/rate_limit",
    {status: 500, body: json_stringify({message: "upstream is unwell"})},
  )
  const observed = read_rehearsal_api_budget(harness, options())
  assert_eq(observed.observed, false)
  assert_eq(observed.reset_epoch_s, 0)
  assert(contains(rehearsal_api_budget_line("opening API budget", observed), "could not be read"))
}

/**
 * The wiring, not only the decision.
 *
 * The revision read is mocked to refuse once with the rate limit and succeed
 * afterwards, with a reset two seconds out so the wait is real but short. A
 * test of the decision alone would leave the retry unproven, and the retry is
 * the behaviour the release path depends on.
 */
pipeline test_a_rate_limited_read_waits_and_then_proceeds(harness: Harness) {
  harness.testing.http_mock_clear()
  const reset = (to_int(date_parse(harness.clock.date_iso())) ?? 0) + 2
  mock_rate_limit(harness.testing, 0, reset)
  let attempts = 0
  const outcome = rehearsal_revision_within_budget(
    harness,
    fn() {
      attempts = attempts + 1
      return if attempts == 1 {
        Err(RATE_LIMITED)
      } else {
        Ok(SHA)
      }
    },
    5400,
    options(),
  )
  assert_eq(attempts, 2, "the read must be retried after the wait")
  assert_eq(unwrap(outcome.revision), SHA)
  assert_eq(len(outcome.decisions), 1)
  assert_eq(first_decision(outcome.decisions).action, "wait")
  assert(outcome.waited_s >= 0)
}

/** The retry is single. A limit that did not lift must not become a loop. */
pipeline test_a_limit_that_does_not_lift_is_not_retried_forever(harness: Harness) {
  harness.testing.http_mock_clear()
  const reset = (to_int(date_parse(harness.clock.date_iso())) ?? 0) + 1
  mock_rate_limit(harness.testing, 0, reset)
  let attempts = 0
  const outcome = rehearsal_revision_within_budget(
    harness,
    fn() {
      attempts = attempts + 1
      return refused()
    },
    5400,
    options(),
  )
  assert_eq(attempts, 2, "exactly one retry, never a loop against a standing limit")
  assert(is_err(outcome.revision))
}

/**
 * A reset the job cannot outlast costs no wait and no second call.
 *
 * This is the case that used to end the run, and it still ends the run. What
 * changed is that the receipt now names when a retry can succeed.
 */
pipeline test_a_reset_outside_the_budget_does_not_retry(harness: Harness) {
  harness.testing.http_mock_clear()
  const reset = (to_int(date_parse(harness.clock.date_iso())) ?? 0) + 3000
  mock_rate_limit(harness.testing, 0, reset)
  let attempts = 0
  const outcome = rehearsal_revision_within_budget(
    harness,
    fn() {
      attempts = attempts + 1
      return refused()
    },
    600,
    options(),
  )
  assert_eq(attempts, 1)
  assert_eq(outcome.waited_s, 0)
  assert_eq(first_decision(outcome.decisions).reason, "rate_limit_reset_outside_job_budget")
  assert(is_err(outcome.revision))
}

/**
 * A successful read spends nothing extra and decides nothing.
 *
 * The budget probe is the cost of handling a refusal, so a run that never
 * refuses must not pay it.
 */
pipeline test_a_successful_read_makes_no_budget_probe(harness: Harness) {
  harness.testing.http_mock_clear()
  // No /rate_limit mock at all: reaching for one would fail the test rather
  // than pass quietly, which is the point.
  let attempts = 0
  const outcome = rehearsal_revision_within_budget(
    harness,
    fn() {
      attempts = attempts + 1
      return proceeded()
    },
    5400,
    options(),
  )
  assert_eq(attempts, 1)
  assert_eq(outcome.api_calls, 0)
  assert_eq(len(outcome.decisions), 0)
  assert_eq(unwrap(outcome.revision), SHA)
}

/**
 * The spend line reports two numbers and says which is which.
 *
 * Neither is the run's exact total. Presenting either alone as "the API calls
 * this run made" would be the wrong number stated confidently, which is worse
 * than two bounds stated honestly.
 */
pipeline test_the_spend_line_names_a_floor_and_a_ceiling() {
  const line = rehearsal_api_spend_line(4, budget(5000, NOW + 60), budget(4880, NOW + 60))
  assert(contains(line, "directly: 4"))
  assert(contains(line, "a floor"))
  assert(contains(line, "charged while this run was open: 120"))
  assert(contains(line, "a ceiling"))
  const unknown = rehearsal_api_spend_line(4, unobserved(), budget(4880, NOW + 60))
  assert(contains(unknown, "unknown because a budget reading was missing"))
}

/**
 * The job's timeout is declared in two places, so a test holds them together.
 *
 * The workflow's `timeout-minutes` governs when the runner kills the job; the
 * seconds handed to the rehearsal govern whether it thinks a wait fits. If
 * those drift apart the rehearsal either waits past its own death or refuses a
 * wait it could have afforded, and neither shows up as a test failure anywhere
 * else.
 */
pipeline test_the_declared_job_budget_matches_the_workflow_timeout(harness: Harness) {
  const workflow = decode_github_workflow(
    harness.fs.read_text(
      path_join(dirname(harness.fs.cwd()), ".github", "workflows", "consumer-rehearsal.yml"),
    ),
  )
  const job = workflow.jobs["rehearse"]
  const timeout_minutes = to_int(job["timeout-minutes"])
  assert(timeout_minutes != nil, "the rehearsal job must declare a timeout")
  let declared_seconds = nil
  for step in job["steps"] {
    const env = step.get("env")
    if env != nil && env.get("JOB_TIMEOUT_S") != nil {
      declared_seconds = to_int(env["JOB_TIMEOUT_S"])
    }
  }
  assert(declared_seconds != nil, "the rehearsal step must hand its job budget to the pipeline")
  assert_eq(
    declared_seconds,
    unwrap(timeout_minutes) * 60,
    "the budget handed to the rehearsal must be the job's own timeout",
  )
}
