import { command_result_ok } from "std/command"
import {
  ReleasePrepareAuditConfig,
  release_candidate_audit_evidence,
  release_candidate_materialization_plan,
  release_candidate_residual_audit_command,
} from "../lib/release_prepare"
import { release_publication } from "../lib/release_publication"
import { release_prepare_audit_plan } from "../release_harn.harn"

fn mock_config(temp_root: string, warm_failure: bool) -> ReleasePrepareAuditConfig {
  return {
    mock: true,
    mock_pin_warm_fail: warm_failure,
    local_audit: false,
    pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    repo: path_join(temp_root, "repo"),
    base: "main",
    release_cargo_target_dir: path_join(temp_root, "target"),
    bootstrap_new_crates: false,
    bump: "patch",
  }
}

fn mock_ship_report(harness: Harness, warm_failure: bool) {
  const temp_root = harness.fs.temp_dir()
  const cfg = mock_config(temp_root, warm_failure)
  const plan = release_prepare_audit_plan(harness, cfg)
  return {
    repo: cfg.repo,
    execution: plan.steps + [{...command_result_ok(""), name: "prepare", command: plan.command}],
  }
}

pipeline test_candidate_materialization_precedes_exact_publication_certification(
  harness: Harness,
  task,
) {
  const cfg = mock_config(harness.fs.temp_dir(), false)
  const materialization = release_candidate_materialization_plan(harness, cfg)
  assert_eq(named_step_index(materialization.steps, "warm-exact-pin-harn-cli"), 0)
  assert_eq(materialization.steps[0]?.timeout_ms, 1800000)
  assert_eq(named_step_index(materialization.steps, "hosted-platform-certification"), nil)
  assert(contains(materialization.command, "--materialize-candidate"))
  assert_eq(contains(materialization.command, "--audit-receipt"), false)
  const candidate_sha = "cccccccccccccccccccccccccccccccccccccccc"
  const publication = release_publication("1.2.3", candidate_sha)
  const evidence = release_candidate_audit_evidence(harness, cfg, publication, "candidate-run")
  const receipt_step = named_step_index(evidence.steps, "hosted-platform-certification")
  assert(receipt_step != nil)
  if receipt_step != nil {
    const receipt = evidence.steps[receipt_step]?.platform_certification_receipt
    assert_eq(receipt.source.sha, candidate_sha)
    assert_eq(receipt.source.branch, "release-certify/${candidate_sha}")
    assert_eq(receipt.warm.head_sha, candidate_sha)
  }
  const residual = release_candidate_residual_audit_command(cfg, evidence)
  assert(contains(residual, "./scripts/release_gate.sh audit --receipt"))
  assert_eq(contains(residual, "release_ship.sh --prepare"), false)
}

pipeline test_prerelease_identifier_reaches_prepare_and_materialization_commands(
  harness: Harness,
  task,
) {
  const cfg = mock_config(harness.fs.temp_dir(), false)
    + {bump: "prepatch", preid: "rc"}
  const prepare = release_prepare_audit_plan(harness, cfg)
  const materialization = release_candidate_materialization_plan(harness, cfg)
  assert(contains(prepare.command, "--bump prepatch --preid 'rc'"))
  assert(contains(materialization.command, "--bump 'prepatch' --preid 'rc'"))
}

fn named_step_index(execution, name) {
  for {index, value} in execution.enumerate() {
    if value.name == name {
      return index
    }
  }
  return nil
}

pipeline test_mock_ship_passes_hosted_receipt_only_after_exact_pin_warm_succeeds(
  harness: Harness,
  task,
) {
  const reused = mock_ship_report(harness, false)
  const receipt_index = named_step_index(reused.execution, "hosted-platform-certification")
  const start_index = named_step_index(reused.execution, "start-hosted-platform-certification")
  const warm_index = named_step_index(reused.execution, "warm-exact-pin-harn-cli")
  const prepare_index = named_step_index(reused.execution, "prepare")
  assert(receipt_index != nil && start_index != nil && warm_index != nil && prepare_index != nil)
  if receipt_index != nil && start_index != nil && warm_index != nil && prepare_index != nil {
    assert(start_index < warm_index)
    assert(warm_index < receipt_index)
    assert(receipt_index < prepare_index)
    assert_eq(reused.execution[warm_index]?.success, true)
    const prepare_command = reused.execution[prepare_index]?.command ?? ""
    assert(contains(prepare_command, "--audit-receipt"))
    assert(contains(prepare_command, " HARN_BIN='"))
    assert(contains(prepare_command, path_join(reused.repo, ".harn", "release-audit-receipts")))
    assert_eq(contains(prepare_command, "--skip-audit"), false)
    const receipt = reused.execution[receipt_index]?.platform_certification_receipt
    assert_eq(receipt.schema_version, "harn.release_audit_receipt.v2")
    assert_eq(receipt.proof_kind, "hosted_platform")
    assert_eq(receipt.source.branch, "release-certify/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    assert_eq(receipt.source.sha, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    assert_eq(receipt.platforms[0]?.run.id, 6001)
    assert_eq(receipt.platforms[1]?.run.id, 6002)
    assert_eq(receipt.local_source.status, "success")
    assert_eq(
      receipt.warm.binary_sha256,
      "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    )
    const ensure_index = named_step_index(reused.execution, "ensure-platform-certification-branch")
    assert(ensure_index != nil)
    if ensure_index != nil {
      assert(ensure_index < receipt_index)
      assert_eq(reused.execution[ensure_index]?.success, true)
      assert_eq(
        reused.execution[ensure_index]?.certification_branch,
        "release-certify/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      )
    }
    const receipt_path = reused.execution[receipt_index]?.platform_certification_receipt_path ?? ""
    const artifact_path = reused.execution[receipt_index]
      ?.platform_certification_receipt_artifact_path
      ?? ""
    assert(contains(receipt_path, path_join(reused.repo, ".harn", "release-audit-receipts")))
    assert(contains(artifact_path, ".harn-runs/release-harn/"))
    assert(harness.fs.exists(receipt_path))
    assert(harness.fs.exists(artifact_path))
  }
  const fallback = mock_ship_report(harness, true)
  const fallback_start_index = named_step_index(
    fallback.execution,
    "start-hosted-platform-certification",
  )
  const fallback_warm_index = named_step_index(fallback.execution, "warm-exact-pin-harn-cli")
  const fallback_cancel_index = named_step_index(
    fallback.execution,
    "cancel-hosted-platform-certification",
  )
  const fallback_prepare_index = named_step_index(fallback.execution, "prepare")
  assert(
    fallback_start_index != nil && fallback_warm_index != nil && fallback_cancel_index != nil
      && fallback_prepare_index
        != nil,
  )
  if fallback_start_index != nil && fallback_warm_index != nil && fallback_cancel_index != nil
    && fallback_prepare_index
      != nil {
    assert(fallback_start_index < fallback_warm_index)
    assert(fallback_warm_index < fallback_prepare_index)
    assert(fallback_warm_index < fallback_cancel_index)
    assert_eq(len(fallback.execution[fallback_cancel_index]?.cancellations ?? []), 2)
    assert_eq(fallback.execution[fallback_warm_index]?.success, false)
    const fallback_command = fallback.execution[fallback_prepare_index]?.command ?? ""
    assert_eq(contains(fallback_command, "--audit-receipt"), false)
    assert_eq(contains(fallback_command, " HARN_BIN='"), false)
    assert(contains(fallback_command, "hosted platform certification receipt is required"))
  }
}
