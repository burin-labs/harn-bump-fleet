import {
  HarnPinHistoryEntry,
  harn_update_lineage_commit,
  harn_update_lineage_pull_request,
} from "../lib/harn_update_lineage"

const TARGET: string = "0.10.131"

fn entry(commit_sha: string, pin: string?) -> HarnPinHistoryEntry {
  return {commit_sha: commit_sha, pin: pin}
}

/**
 * The window that this replaces held the twenty most recent closed pull
 * requests. A repin older than that fell out of view and the proof then
 * reported missing lineage forever, because the pin already read the target so
 * no later round ever opened another update. History has no such horizon.
 */
pipeline test_a_repin_older_than_the_old_window_is_still_found(task: any) {
  const found = harn_update_lineage_commit(
    [entry("aaa1", "0.10.131"), entry("bbb2", "0.10.130"), entry("ccc3", "0.10.129")],
    TARGET,
    true,
  )
  assert_eq(found.found, true)
  assert_eq(found.commit_sha, "aaa1")
  assert_eq(found.reason, "pin_set_to_target")
}

/**
 * The negative control for the same defect. Under the window every green merged
 * pull request branched after the repin read the target pin at its own head and
 * satisfied the proof. Selecting by history asks a different question, so a
 * commit that did not touch the pin is never the answer: only commits that
 * changed the pin file are candidates at all, and among those the answer is the
 * one that moved the pin onto the target.
 */
pipeline test_a_later_commit_that_did_not_set_the_pin_is_not_the_lineage(task: any) {
  const found = harn_update_lineage_commit(
    [
      entry("newest", "0.10.131"),
      entry("middle", "0.10.131"),
      entry("setter", "0.10.131"),
      entry("before", "0.10.130"),
    ],
    TARGET,
    false,
  )
  assert_eq(found.found, true)
  assert_eq(found.commit_sha, "setter")
}

/** A default branch that has not reached the target has no lineage yet. */
pipeline test_a_default_branch_below_the_target_reports_no_lineage(task: any) {
  const found = harn_update_lineage_commit([entry("aaa1", "0.10.130")], TARGET, true)
  assert_eq(found.found, false)
  assert_eq(found.reason, "default_branch_pin_not_at_target")
}

/** A pin ahead of the target still satisfies it, as everywhere else in the proof. */
pipeline test_a_pin_ahead_of_the_target_satisfies_it(task: any) {
  const found = harn_update_lineage_commit(
    [entry("aaa1", "0.10.140"), entry("bbb2", "0.10.100")],
    TARGET,
    true,
  )
  assert_eq(found.found, true)
  assert_eq(found.commit_sha, "aaa1")
}

/**
 * Absence must not read as success. When every commit in the page satisfies the
 * target and the page is full, the commit that set it is out of view, and the
 * oldest entry seen is not an answer. Reporting it as one would be the same
 * accidental pass the window produced.
 */
pipeline test_a_truncated_history_is_unresolved_not_the_oldest_entry(task: any) {
  const found = harn_update_lineage_commit(
    [entry("aaa1", "0.10.131"), entry("bbb2", "0.10.131")],
    TARGET,
    false,
  )
  assert_eq(found.found, false)
  assert_eq(found.reason, "pin_history_window_exhausted")
}

/** The same page, once known to reach the start of history, does answer. */
pipeline test_a_complete_history_answers_where_a_truncated_one_cannot(task: any) {
  const found = harn_update_lineage_commit(
    [entry("aaa1", "0.10.131"), entry("bbb2", "0.10.131")],
    TARGET,
    true,
  )
  assert_eq(found.found, true)
  assert_eq(found.commit_sha, "bbb2")
}

/** No history at all is reported by name rather than as a refusal to prove. */
pipeline test_an_empty_history_is_named(task: any) {
  const found = harn_update_lineage_commit([], TARGET, true)
  assert_eq(found.found, false)
  assert_eq(found.reason, "pin_history_unavailable")
}

/** A commit whose pin is unreadable does not satisfy the target. */
pipeline test_an_unreadable_pin_does_not_satisfy_the_target(task: any) {
  const found = harn_update_lineage_commit([entry("aaa1", nil)], TARGET, true)
  assert_eq(found.found, false)
  assert_eq(found.reason, "default_branch_pin_not_at_target")
}

/** A squash or rebase merge makes the lineage commit the merge commit itself. */
pipeline test_a_squash_merged_pull_request_is_the_lineage_record(task: any) {
  const selected = harn_update_lineage_pull_request(
    [
      {
        number: 8159,
        merged_at: "2026-09-05T23:23:48Z",
        merge_commit_sha: "abc",
        base: {ref: "main"},
      },
    ],
    "abc",
    "main",
  )
  assert_eq(selected.found, true)
  assert_eq(selected.number, 8159)
  assert_eq(selected.reason, "lineage_pull_request_merge_commit")
}

/** An ordinary merge leaves the lineage commit inside the branch, and still counts. */
pipeline test_a_merge_commit_pull_request_containing_the_commit_counts(task: any) {
  const selected = harn_update_lineage_pull_request(
    [{number: 42, merged_at: "2026-09-05T23:23:48Z", merge_commit_sha: "top", base: {ref: "main"}}],
    "inside",
    "main",
  )
  assert_eq(selected.found, true)
  assert_eq(selected.number, 42)
  assert_eq(selected.reason, "lineage_pull_request_contains_commit")
}

/** An open pull request associated with the commit does not prove the update. */
pipeline test_an_unmerged_pull_request_does_not_prove(task: any) {
  const selected = harn_update_lineage_pull_request(
    [{number: 7, merged_at: "", merge_commit_sha: "", base: {ref: "main"}}],
    "abc",
    "main",
  )
  assert_eq(selected.found, false)
  assert_eq(selected.reason, "lineage_pull_request_not_merged")
}

/** A pull request merged somewhere other than the default branch does not prove. */
pipeline test_a_pull_request_merged_to_another_branch_does_not_prove(task: any) {
  const selected = harn_update_lineage_pull_request(
    [
      {
        number: 9,
        merged_at: "2026-09-05T23:23:48Z",
        merge_commit_sha: "abc",
        base: {ref: "release/0.10"},
      },
    ],
    "abc",
    "main",
  )
  assert_eq(selected.found, false)
  assert_eq(selected.reason, "lineage_pull_request_merged_to_another_branch")
}

/** A pin set by a direct push is named as that, not reported as a missing record. */
pipeline test_a_direct_push_is_named_rather_than_missing(task: any) {
  const selected = harn_update_lineage_pull_request([], "abc", "main")
  assert_eq(selected.found, false)
  assert_eq(selected.reason, "pin_set_by_direct_push_without_pull_request")
}

/**
 * The observation that produced this change, as a fixture.
 *
 * These are the real pin-file history and commit association for the two
 * consumers the fleet was waiting on, read on 2026-09-06. Under the twenty-most
 * recent-closed-pull-requests window the first repository's update record was
 * already out of view: its repin landed the previous evening and the window had
 * moved on to a range that did not contain it. History resolves it exactly, and
 * the association is a squash merge, so the lineage commit is the pull
 * request's own merge commit.
 */
pipeline test_the_observed_workbench_history_resolves_its_repin(task: any) {
  const found = harn_update_lineage_commit(
    [
      entry("fdce8975e6c681ba2385cb488da6a46c0f87307b", "v0.10.131"),
      entry("f01d81b3266e1a6f046899727d5da5b28e1aa43f", "v0.10.130"),
      entry("64c9b5917563a6362eb80e5fc9efbc2505d949d9", "v0.10.129"),
    ],
    TARGET,
    false,
  )
  assert_eq(found.found, true)
  assert_eq(found.commit_sha, "fdce8975e6c681ba2385cb488da6a46c0f87307b")
  const selected = harn_update_lineage_pull_request(
    [
      {
        number: 8159,
        merged_at: "2026-09-06T06:23:49Z",
        merge_commit_sha: "fdce8975e6c681ba2385cb488da6a46c0f87307b",
        base: {ref: "main"},
      },
    ],
    found.commit_sha,
    "main",
  )
  assert_eq(selected.found, true)
  assert_eq(selected.number, 8159)
}

/** The second consumer, whose repin landed the same morning, resolves the same way. */
pipeline test_the_observed_hosted_history_resolves_its_repin(task: any) {
  const found = harn_update_lineage_commit(
    [
      entry("32104d6e86326043598625f13595ed4463925908", "0.10.131"),
      entry("eafc713b9440399f6ad3ad43cf86de6d9501aed7", "0.10.130"),
    ],
    TARGET,
    false,
  )
  assert_eq(found.found, true)
  assert_eq(found.commit_sha, "32104d6e86326043598625f13595ed4463925908")
  const selected = harn_update_lineage_pull_request(
    [
      {
        number: 1876,
        merged_at: "2026-09-06T12:04:31Z",
        merge_commit_sha: "32104d6e86326043598625f13595ed4463925908",
        base: {ref: "main"},
      },
    ],
    found.commit_sha,
    "main",
  )
  assert_eq(selected.found, true)
  assert_eq(selected.number, 1876)
}
