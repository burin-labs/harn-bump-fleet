import {
  fleet_chain_branch,
  fleet_chain_ref,
  require_fleet_chain_claim,
} from "../lib/fleet_chain_ref"
import { GithubRefClaim } from "harn-github-connector/default"

const CHAIN_ID = "31906254877"

const REVISION = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn claim(oid: string, ref: string = "refs/heads/harn-update-chain/31906254877") -> GithubRefClaim {
  return {
    repo: "burin-labs/harn-bump-fleet",
    ref: ref,
    oid: oid,
    claimed: true,
    holder_headline: "",
  }
}

pipeline test_chain_ref_has_one_plain_branch_spelling(task) {
  assert_eq(fleet_chain_branch(CHAIN_ID), "harn-update-chain/31906254877")
  assert_eq(fleet_chain_ref(CHAIN_ID), "refs/heads/harn-update-chain/31906254877")
}

pipeline test_new_or_existing_exact_claim_is_admitted(task) {
  assert_eq(require_fleet_chain_claim(claim(REVISION), CHAIN_ID, REVISION).oid, REVISION)
  assert_eq(
    require_fleet_chain_claim(claim(REVISION) + {claimed: false}, CHAIN_ID, REVISION).oid,
    REVISION,
  )
}

pipeline test_chain_ref_held_by_another_controller_fails_closed(task) {
  let message = ""
  try {
    require_fleet_chain_claim(claim("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"), CHAIN_ID, REVISION)
  } catch (error) {
    message = to_string(error)
  }
  assert(contains(message, "another controller revision"))
}

pipeline test_partial_revision_and_wrong_ref_fail_closed(task) {
  let partial_message = ""
  try {
    require_fleet_chain_claim(claim(REVISION), CHAIN_ID, "aaaaaaaa")
  } catch (error) {
    partial_message = to_string(error)
  }
  assert(contains(partial_message, "full lowercase controller revision"))
  let ref_message = ""
  try {
    require_fleet_chain_claim(claim(REVISION, "refs/heads/main"), CHAIN_ID, REVISION)
  } catch (error) {
    ref_message = to_string(error)
  }
  assert(contains(ref_message, "another controller revision"))
}
