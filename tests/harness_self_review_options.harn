import { parse_self_review_args } from "../lib/harness_self_review_options"

pipeline test_self_review_options_normalize_cli_parser_output(task) {
  const options = parse_self_review_args(
    [
      "--facts-only",
      "--recent",
      "8",
      "--model",
      "test-model",
      "--provider",
      "test-provider",
      "--tool-format",
      "native",
      "--with-tools",
      "--projects-root",
      "/tmp/projects",
      "--harn-repo",
      "/tmp/projects/harn",
    ],
  )
  assert_eq(options.facts_only, true)
  assert_eq(options.help, false)
  assert_eq(options.recent, 8)
  assert_eq(options.model, "test-model")
  assert_eq(options.provider, "test-provider")
  assert_eq(options.tool_format, "native")
  assert_eq(options.with_tools, true)
  assert_eq(options.projects_root, "/tmp/projects")
  assert_eq(options.harn_repo, "/tmp/projects/harn")
}

pipeline test_self_review_options_reject_nonpositive_recent(task) {
  const error = try {
    parse_self_review_args(["--recent", "0"])
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(error, "--recent must be positive"))
}
