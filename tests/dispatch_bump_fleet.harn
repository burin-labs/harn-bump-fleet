import { parse_dispatch_fleet_args } from "../dispatch_bump_fleet.harn"

fn thrown(callback) -> string {
  return try {
    callback()
    ""
  } catch (e) {
    to_string(e)
  }
}

pipeline test_dispatch_fleet_cli_boundary() {
  const parsed = parse_dispatch_fleet_args(
    ["--dry-run", "--only", "burin-labs/harn-canon", "v1.2.3"],
  )
  assert_eq(parsed.dry_run, true)
  assert_eq(parsed.only, "burin-labs/harn-canon")
  assert_eq(parsed.target, "v1.2.3")
  assert(contains(thrown({ -> parse_dispatch_fleet_args(["--unknown"]) }), "no flag named"))
}
