fn public_release() -> GithubReleaseLookup {
  return {
    repo: "burin-labs/harn",
    tag: "v0.10.157",
    state: "found",
    found: true,
    lease: {
      release_id: 402780934,
      tag_ref_oid: "8790905b0d1ad6f3304cf8ae8bdcf9813812e184",
      tag_target_oid: archive_producer().source,
      tag_target_type: "commit",
    },
    release: {
      id: 402780934,
      tag_name: "v0.10.157",
      name: "Release v0.10.157",
      draft: false,
      prerelease: false,
      url: "https://github.com/burin-labs/harn/releases/tag/v0.10.157",
      target_commitish: "main",
      body: "",
      published_at: "2026-10-04T02:05:11Z",
      // Asset IDs and unasserted metadata are illustrative; actual measured
      // file digests live in the independent public-readback fixtures.
      assets: required_harn_release_assets().map(
        { name ->
          {
            id: 1,
            name: name,
            size: 1,
            state: "uploaded",
            content_type: "application/octet-stream",
            download_count: 0,
            url: "https://github.com/burin-labs/harn/releases/download/v0.10.157/${name}",
            created_at: nil,
            updated_at: nil,
          }
        },
      )
        .to_list(),
    },
  }
}

fn workflow_dispatch() -> GithubWorkflowDispatchReceipt {
  return {
    repo: "burin-labs/harn",
    accepted: true,
    run_id: 41,
    workflow_id: "bump-release.yml",
    workflow_path: ".github/workflows/bump-release.yml",
    run_attempt: 1,
    ref: "main",
    head_sha: "213a5793a8b25d72e49160b4f6182c3b59026ca3",
    head_branch: "main",
    event: "workflow_dispatch",
    url: "https://github.com/burin-labs/harn/actions/runs/41",
    created_at: nil,
  }
}

fn archive_producer() -> ReleaseArchiveProducer {
  return {
    repository: "burin-labs/harn",
    workflow: "build-release-binaries.yml",
    source: "6f1796501c9870074644c47c50200b05f4548e03",
    run_id: 37167101058,
    run_attempt: 1,
    status: "completed",
    conclusion: "success",
  }
}

fn release_pr() -> GithubPullRequestSummary {
  return {
    repo: "burin-labs/harn",
    number: 9326,
    title: "Release v0.10.157",
    url: "https://github.com/burin-labs/harn/pull/9326",
    state: "merged",
    github_state: "closed",
    draft: false,
    merged: true,
    merged_at: "2026-10-04T01:21:36Z",
    merge_commit_oid: archive_producer().source,
    mergeable: nil,
    mergeable_state: "unknown",
    base: {ref: "main", sha: workflow_dispatch().head_sha, repo: "harn", owner: "burin-labs"},
    head: {
      ref: "release/v0.10.157",
      sha: workflow_dispatch().head_sha,
      repo: "harn",
      owner: "burin-labs",
    },
    labels: [],
    auto_merge_armed: false,
    auto_merge_method: nil,
    in_merge_queue: false,
  }
}

fn producer_run() -> GithubWorkflowRun {
  const producer = archive_producer()
  return {
    repo: producer.repository,
    id: producer.run_id,
    workflow_id: nil,
    workflow_path: ".github/workflows/build-release-binaries.yml",
    run_number: nil,
    run_attempt: producer.run_attempt,
    name: "Build release binaries",
    display_title: "Release v0.10.157",
    event: "merge_group",
    status: producer.status,
    conclusion: producer.conclusion,
    head_branch: "gh-readonly-queue/main/pr-9326",
    head_sha: producer.source,
    url: "https://github.com/burin-labs/harn/actions/runs/${producer.run_id}",
    created_at: nil,
    run_started_at: nil,
    updated_at: nil,
  }
}

fn selected_handoff() {
  return release_workflow_handoff_select_producer(
    release_workflow_handoff_bind_pr(release_workflow_handoff(workflow_dispatch()), release_pr()),
    producer_run(),
  )
}

fn canonical_watch_fixture(
  fs: HarnessFs,
  pr: GithubPullRequestSummary = release_pr(),
  run: GithubWorkflowRun = producer_run(),
) -> ReleaseWorkflowWatchAdapter {
  return {
    pull_request: fn(number) {
      assert_eq(number, pr.number)
      return Ok(pr)
    },
    producer_run: fn(id) {
      assert_eq(id, run.id)
      return Ok(run)
    },
    source_on_main: fn(source) {
      assert_eq(source, pr.merge_commit_oid)
      return Ok(true)
    },
    manifest: fn(actual) {
      assert_eq(actual.id, run.id)
      return Ok(
        fs.read_text(
          path_join(
            release_harness_root(fs),
            "tests/fixtures/release-controller-157-manifest.json",
          ),
        ),
      )
    },
    release: fn(tag) {
      assert_eq(tag, "v0.10.157")
      return Ok(public_release())
    },
    archives: fn(tag, manifest) {
      assert_eq(tag, "v0.10.157")
      assert(manifest.contains(archive_producer().source))
      return Ok(release_public_readbacks(fs) + release_public_readbacks(fs, true))
    },
  }
}

pipeline test_read_only_workflow_watch_reaches_archives_without_claiming_publication(
  harness: Harness,
) {
  const path = path_join(harness.fs.mkdtemp_in_workspace("canonical-watch-"), "handoff.json")
  const result = observe_release_workflow(
    harness,
    release_workflow_handoff(workflow_dispatch()),
    path,
    {release_pr: 9326, producer_run: 37167101058},
    canonical_watch_fixture(harness.fs),
  )
  assert_eq(result.state, "pending")
  assert_eq(result.archive_observation?.state, "verified")
  assert_eq(result.archive_observation?.measured_files, 7)
  assert_eq(result.failing_names, [])
  assert_eq(
    result.pending_names,
    ["crate_publication", "versioned_container", "development_bump", "downstream_convergence"],
  )
  const resumed = unwrap(release_workflow_handoff_read(harness.fs, path))
  assert_eq(resumed, result.receipt)
  const next = observe_release_workflow(
    harness,
    resumed,
    path,
    {release_pr: 0, producer_run: 0},
    canonical_watch_fixture(harness.fs),
  )
  assert_eq(next.receipt, resumed)
  assert_eq(next.archive_observation?.state, "verified")
}

pipeline test_read_only_workflow_watch_pins_pending_attempt_before_resuming(harness: Harness) {
  const path = path_join(
    harness.fs.mkdtemp_in_workspace("canonical-watch-pending-"),
    "handoff.json",
  )
  const result = observe_release_workflow(
    harness,
    release_workflow_handoff(workflow_dispatch()),
    path,
    {release_pr: 9326, producer_run: 37167101058},
    canonical_watch_fixture(
      harness.fs,
      release_pr(),
      producer_run() + {status: "in_progress", conclusion: nil},
    ),
  )
  assert_eq(result.pending_names, ["archive_producer"])
  assert_eq(result.receipt.producer, nil)
  const persisted = unwrap(release_workflow_handoff_read(harness.fs, path))
  assert_eq(persisted.producer_run_id, 37167101058)
  assert_eq(persisted.producer_run_attempt, 1)
  const replaced = observe_release_workflow(
    harness,
    persisted,
    path,
    {release_pr: 0, producer_run: 0},
    canonical_watch_fixture(harness.fs, release_pr(), producer_run() + {run_attempt: 2}),
  )
  assert_eq(replaced.state, "failed")
  assert_eq(replaced.failing_names, ["archive_producer_identity"])
  assert_eq(unwrap(release_workflow_handoff_read(harness.fs, path)), persisted)
}

pipeline test_public_promotion_requires_exact_tag_source_listing_and_bytes(harness: Harness) {
  const base = canonical_watch_fixture(harness.fs)
  const path = path_join(harness.fs.mkdtemp_in_workspace("canonical-promotion-"), "handoff.json")
  const observed = observe_release_workflow(
    harness,
    release_workflow_handoff(workflow_dispatch()),
    path,
    {release_pr: 9326, producer_run: 37167101058},
    base,
  )
  assert(observed.archive_observation != nil)
  const files = observed.archive_observation
  assert_eq(
    observe_release_promotion(public_release(), "v0.10.157", archive_producer().source, files)
      .state,
    "verified",
  )
  assert_eq(
    observe_release_promotion(public_release(), "v0.10.157", archive_producer().source)
      .pending_names,
    ["public_asset_bytes"],
  )
  const actual = public_release()
  const lease = actual.lease!
  const release = actual.release!
  for changed in [
    actual + {repo: "other/harn"},
    actual + {tag: "v0.10.156"},
    actual + {lease: lease + {tag_target_oid: workflow_dispatch().head_sha}},
    actual + {lease: lease + {tag_target_type: "tree"}},
    actual + {lease: lease + {release_id: 1}},
    actual + {release: release + {assets: release.assets + [release.assets[0]!]}},
    actual
      + {
        release: release
          + {assets: release.assets.map({ asset -> asset + {state: "new"} }).to_list()},
      },
  ] {
    let downloads = 0
    const isolated = path_join(
      harness.fs.mkdtemp_in_workspace("canonical-promotion-refusal-"),
      "handoff.json",
    )
    const result = observe_release_workflow(
      harness,
      release_workflow_handoff(workflow_dispatch()),
      isolated,
      {release_pr: 9326, producer_run: 37167101058},
      base
        + {
          release: fn(tag) { return Ok(changed) },
          archives: fn(tag, manifest) {
            downloads = downloads + 1
            return base.archives(tag, manifest)
          },
        },
    )
    assert_eq(result.state, "failed")
    assert(len(result.failing_names) > 0)
    assert_eq(downloads, 0)
  }
  for changed in [
    {
      repo: "burin-labs/harn",
      tag: "v0.10.157",
      state: "absent",
      found: false,
      release: nil,
      lease: nil,
    },
    actual + {release: release + {draft: true}},
    actual + {release: release + {published_at: nil}},
    actual + {release: release + {assets: []}},
  ] {
    const pending = observe_release_promotion(
      changed,
      "v0.10.157",
      archive_producer().source,
      files,
    )
    assert_eq(pending.state, "pending")
    assert(len(pending.pending_names) > 0)
  }
}

pipeline test_read_only_workflow_watch_missing_selection_is_not_success(harness: Harness) {
  let reached = 0
  const adapter = canonical_watch_fixture(harness.fs)
    + {
      pull_request: fn(number) {
        reached = reached + 1
        return Ok(release_pr())
      },
    }
  const path = path_join(
    harness.fs.mkdtemp_in_workspace("canonical-watch-missing-"),
    "handoff.json",
  )
  const result = observe_release_workflow(
    harness,
    release_workflow_handoff(workflow_dispatch()),
    path,
    {release_pr: 0, producer_run: 0},
    adapter,
  )
  assert_eq(reached, 0)
  assert_eq(result.state, "pending")
  assert_eq(result.pending_names, ["release_pull_request"])
  assert_eq(result.archive_observation, nil)
}

pipeline test_read_only_workflow_watch_refuses_failed_wrong_and_unreported_producers(
  harness: Harness,
) {
  for run in [
    producer_run() + {conclusion: "failure"},
    producer_run() + {conclusion: nil},
    producer_run() + {head_sha: workflow_dispatch().head_sha},
    producer_run() + {workflow_path: ".github/workflows/promote-release.yml"},
    producer_run() + {event: "workflow_dispatch"},
    producer_run() + {event: ""},
  ] {
    let manifests = 0
    const adapter = canonical_watch_fixture(harness.fs, release_pr(), run)
      + {
        manifest: fn(actual) {
          manifests = manifests + 1
          return Ok("{}")
        },
      }
    const path = path_join(
      harness.fs.mkdtemp_in_workspace("canonical-watch-refusal-"),
      "handoff.json",
    )
    const result = observe_release_workflow(
      harness,
      release_workflow_handoff(workflow_dispatch()),
      path,
      {release_pr: 9326, producer_run: 37167101058},
      adapter,
    )
    assert_eq(result.archive_observation, nil)
    assert(len(result.pending_names) + len(result.failing_names) > 0)
    assert_eq(manifests, 0)
  }
}

pipeline test_read_only_workflow_watch_missing_and_corrupt_public_bytes_cannot_verify(
  harness: Harness,
) {
  const base = canonical_watch_fixture(harness.fs)
  const measured = unwrap(base.archives("v0.10.157", unwrap(base.manifest(producer_run()))))
  for rows in [
    [],
    measured.slice(0, 4),
    measured.map({ row -> row + {sha256: "0".repeat(64)} }).to_list(),
  ] {
    const path = path_join(
      harness.fs.mkdtemp_in_workspace("canonical-watch-bytes-"),
      "handoff.json",
    )
    const result = observe_release_workflow(
      harness,
      release_workflow_handoff(workflow_dispatch()),
      path,
      {release_pr: 9326, producer_run: 37167101058},
      base + {archives: fn(tag, manifest) { return Ok(rows) }},
    )
    assert(result.archive_observation != nil)
    assert(result.archive_observation.state != "verified")
    assert(len(result.archive_observation.pending_names ?? []) + len(result.failing_names) > 0)
  }
}

pipeline test_live_ship_delegates_only_the_canonical_empty_input_opener(harness: Harness) {
  const cfg = parse_release_args(harness.env, ["--mode", "ship-pr", "--yes-live-release"])
  let dispatches = 0
  const result = release_workflow_open(
    harness,
    cfg,
    fn(repository, workflow, inputs, ref) {
      dispatches = dispatches + 1
      assert_eq(repository, "burin-labs/harn")
      assert_eq(workflow, "bump-release.yml")
      assert_eq(inputs, {})
      assert_eq(ref, "main")
      return Ok(workflow_dispatch() + {run_id: 424243})
    },
  )
  assert_eq(dispatches, 1)
  assert_eq(result.state, "pending")
  assert_eq(result.receipt.producer, nil)
  assert(result.pending_names.contains("archive_producer"))
  assert_eq(unwrap(release_workflow_handoff_read(harness.fs, result.receipt_path)), result.receipt)
}

pipeline test_live_ship_refuses_retired_local_overrides_before_dispatch(harness: Harness) {
  const cfg = parse_release_args(harness.env, ["--mode", "ship-pr", "--yes-live-release"])
  let dispatches = 0
  const opener = fn(repository, workflow, inputs, ref) {
    dispatches = dispatches + 1
    return Ok(workflow_dispatch())
  }
  for invalid in [
    cfg + {yes_live_release: false},
    cfg + {mode: "prepare"},
    cfg + {pin_sha_input: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    cfg + {bump: "minor"},
    cfg + {base: "release/v0.10.147"},
    cfg + {bootstrap_new_crates: true},
    cfg + {resume_tagged_release: true},
    cfg + {queue_live_prs: [1]},
    cfg + {chat_only: true},
    cfg + {agent: true},
  ] {
    assert(
      is_err(
        try {
          release_workflow_open(harness, invalid, opener)
        },
      ),
    )
  }
  assert_eq(dispatches, 0)
}

pipeline test_live_ship_dispatch_failure_does_not_enter_a_legacy_fallback(harness: Harness) {
  const cfg = parse_release_args(harness.env, ["--mode", "ship-pr", "--yes-live-release"])
  let dispatches = 0
  const result = try {
    release_workflow_open(
      harness,
      cfg,
      fn(repository, workflow, inputs, ref) {
        dispatches = dispatches + 1
        return Err({code: "http_error", category: "transport", message: "refused dispatch"})
      },
    )
  }
  assert(is_err(result))
  assert_eq(dispatches, 1)
  assert(to_string(unwrap_err(result)).contains("no legacy release fallback"))
}

pipeline test_workflow_handoff_persists_and_resumes_the_actual_producer(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("release-workflow-handoff-")
  const path = path_join(root, "handoff.json")
  const opened = release_workflow_handoff(workflow_dispatch())
  assert_eq(opened.producer, nil)
  assert_eq(opened.merged_source, "")
  release_workflow_handoff_write(pick(harness, ["fs", "random"]), path, opened)
  assert_eq(unwrap(release_workflow_handoff_read(harness.fs, path)), opened)
  const producer = archive_producer()
  const manifest = harness.fs.read_text(
    path_join(
      release_harness_root(harness.fs),
      "tests/fixtures/release-controller-157-manifest.json",
    ),
  )
  const selected = release_workflow_handoff_select_producer(
    release_workflow_handoff_bind_pr(opened, release_pr()),
    producer_run(),
  )
  const bound = release_workflow_handoff_bind_producer(
    selected,
    producer.source,
    producer,
    manifest,
  )
  assert(bound.opener_source != bound.merged_source)
  release_workflow_handoff_write(pick(harness, ["fs", "random"]), path, bound)
  const resumed = unwrap(release_workflow_handoff_read(harness.fs, path))
  assert_eq(resumed, bound)
  assert_eq(
    release_workflow_handoff_bind_producer(resumed, producer.source, producer, manifest),
    bound,
  )
  // A different later attempt cannot replace the actual certified producer.
  assert(
    is_err(
      try {
        release_workflow_handoff_write(
          pick(harness, ["fs", "random"]),
          path,
          bound + {producer: producer + {run_attempt: 2}},
        )
      },
    ),
  )
  assert(
    is_err(
      try {
        release_workflow_handoff_write(pick(harness, ["fs", "random"]), path, opened)
      },
    ),
  )
  assert_eq(unwrap(release_workflow_handoff_read(harness.fs, path)), bound)
}

pipeline test_workflow_handoff_refuses_absent_failed_and_unbound_certification(harness: Harness) {
  const opened = selected_handoff()
  const producer = archive_producer()
  const manifest = harness.fs.read_text(
    path_join(
      release_harness_root(harness.fs),
      "tests/fixtures/release-controller-157-manifest.json",
    ),
  )
  for invalid in [
    producer + {status: "in_progress", conclusion: ""},
    producer + {conclusion: "failure"},
    producer + {run_attempt: 2},
    producer + {run_id: 0},
    producer + {workflow: "promote-release.yml"},
    producer + {source: opened.opener_source},
  ] {
    assert(
      is_err(
        try {
          release_workflow_handoff_bind_producer(opened, producer.source, invalid, manifest)
        },
      ),
    )
  }
  assert(
    is_err(
      try {
        release_workflow_handoff_bind_producer(opened, opened.opener_source, producer, manifest)
      },
    ),
  )
  assert(
    is_err(
      try {
        release_workflow_handoff_bind_producer(opened, producer.source, producer, "{}")
      },
    ),
  )
}

pipeline test_workflow_handoff_refuses_missing_legacy_and_wrong_opener(harness: Harness) {
  const root = harness.fs.mkdtemp_in_workspace("release-workflow-handoff-refusal-")
  const path = path_join(root, "handoff.json")
  assert(is_err(release_workflow_handoff_read(harness.fs, path)))
  harness.fs.write_text(path, "{}")
  assert(is_err(release_workflow_handoff_read(harness.fs, path)))
  for invalid in [
    workflow_dispatch() + {accepted: false},
    workflow_dispatch() + {run_id: 0},
    workflow_dispatch() + {run_attempt: nil},
    workflow_dispatch() + {workflow_path: ".github/workflows/build-release-binaries.yml"},
    workflow_dispatch() + {ref: "release/v0.10.147"},
    workflow_dispatch() + {event: "push"},
    workflow_dispatch() + {head_sha: "main"},
  ] {
    assert(
      is_err(
        try {
          release_workflow_handoff(invalid)
        },
      ),
    )
  }
  assert(
    is_err(
      try {
        release_workflow_handoff_write(
          pick(harness, ["fs", "random"]),
          path,
          release_workflow_handoff(workflow_dispatch()),
        )
      },
    ),
  )
  assert_eq(harness.fs.read_text(path), "{}")
}

fn receipt(tag: string, head: string) {
  return release_watch_receipt(
    {
      tag: tag,
      slug: "burin-labs/harn",
      pin_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      publication: {
        version: tag.substring(1),
        local_branch: "release/${tag}",
        remote_ref: "release-attempt/${tag}/${head}",
        head_oid: head,
      },
      pr_url: "https://github.com/burin-labs/harn/pull/123",
      created_at: "2026-08-10T00:00:00Z",
    },
  )
}

fn fixture(fs: HarnessFs, tag: string) {
  const root = fs.mkdtemp_in_workspace("release-watch-handoff-test-")
  const destination = path_join(root, "watches", tag + ".json")
  return {root: root, destination: destination}
}

pipeline test_imports_the_uploaded_artifact_root_receipt(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  const expected = receipt("v1.2.3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  let downloads = 0
  const imported = import_hosted_release_watch_receipt(
    harness,
    {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
    {
      download: fn(run_id, destination) {
        downloads = downloads + 1
        assert_eq(run_id, 42)
        const source = path_join(destination, "release-harn", "watches", "v1.2.3.json")
        release_watch_receipt_write(pick(harness, ["fs", "random"]), source, expected)
        return {success: true, message: ""}
      },
    },
  )
  assert_eq(imported, expected)
  assert_eq(release_watch_receipt_read(harness.fs, f.destination), expected)
  assert_eq(downloads, 1)
}

pipeline test_imports_the_nested_legacy_receipt(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  const expected = receipt("v1.2.3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  const imported = import_hosted_release_watch_receipt(
    harness,
    {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
    {
      download: fn(_run_id, destination) {
        const source = path_join(
          destination,
          ".harn-runs",
          "release-harn",
          "watches",
          "v1.2.3.json",
        )
        release_watch_receipt_write(pick(harness, ["fs", "random"]), source, expected)
        return {success: true, message: ""}
      },
    },
  )
  assert_eq(imported, expected)
}

pipeline test_imports_the_newest_valid_attempt_receipt(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  const expected = receipt("v1.2.3", "cccccccccccccccccccccccccccccccccccccccc")
  const imported = import_hosted_release_watch_receipt(
    harness,
    {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
    {
      download: fn(_run_id, destination) {
        for {attempt, value} in [
          {attempt: 2, value: expected},
          {attempt: 1, value: receipt("v1.2.3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")},
        ] {
          const source = path_join(
            destination,
            "release-run-42-attempt-${attempt}",
            "release-harn",
            "watches",
            "v1.2.3.json",
          )
          release_watch_receipt_write(pick(harness, ["fs", "random"]), source, value)
        }
        return {success: true, message: ""}
      },
    },
  )
  assert_eq(imported, expected)
}

pipeline test_incomplete_retry_falls_back_to_prior_valid_attempt(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  const expected = receipt("v1.2.3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  const imported = import_hosted_release_watch_receipt(
    harness,
    {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
    {
      download: fn(_run_id, destination) {
        const newest = path_join(
          destination,
          "release-run-42-attempt-2",
          "release-harn",
          "watches",
          "v1.2.3.json",
        )
        harness.fs.write_text(newest, "{}")
        const prior = path_join(
          destination,
          "release-run-42-attempt-1",
          "release-harn",
          "watches",
          "v1.2.3.json",
        )
        release_watch_receipt_write(pick(harness, ["fs", "random"]), prior, expected)
        return {success: true, message: ""}
      },
    },
  )
  assert_eq(imported, expected)
}

pipeline test_retries_a_transient_download_in_a_clean_staging_directory(
  harness: Harness,
  task: any,
) {
  const f = fixture(harness.fs, "v1.2.3")
  const expected = receipt("v1.2.3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  let downloads = 0
  let failed_destination = ""
  const imported = import_hosted_release_watch_receipt(
    harness,
    {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
    {
      download: fn(_run_id, destination) {
        downloads = downloads + 1
        if downloads == 1 {
          failed_destination = destination
          harness.fs.write_text(path_join(destination, "partial-download"), "poison")
          return {success: false, message: "HTTP 403: signed artifact URL expired"}
        }
        assert(destination != failed_destination)
        assert(!harness.fs.exists(failed_destination))
        const source = path_join(destination, "release-harn", "watches", "v1.2.3.json")
        release_watch_receipt_write(pick(harness, ["fs", "random"]), source, expected)
        return {success: true, message: ""}
      },
    },
  )
  assert_eq(imported, expected)
  assert_eq(downloads, 2)
}

pipeline test_stops_after_three_failed_download_attempts(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  let downloads = 0
  const failed = try {
    import_hosted_release_watch_receipt(
      harness,
      {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
      {
        download: fn(_run_id, _destination) {
          downloads = downloads + 1
          return {success: false, message: "transient failure ${downloads}"}
        },
      },
    )
    ""
  } catch (error) {
    to_string(error)
  }
  assert_eq(downloads, 3)
  assert(contains(failed, "after 3 attempts"))
  assert(contains(failed, "transient failure 3"))
  assert(!harness.fs.exists(f.destination))
}

/** Signed artifact query credentials never enter the durable failure detail. */
pipeline test_download_failure_redacts_signed_redirect_query(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  const signed = "https://productionresultssa8.blob.core.windows.net/actions-results/run.zip"
    + "?se=2026-09-05T00%3A00%3A00Z&sig=SECRET-SAS-SIGNATURE&sp=r"
  const failed = try {
    import_hosted_release_watch_receipt(
      harness,
      {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
      {download: fn(_run_id, _destination) { return {success: false, message: signed} }},
    )
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(failed, "productionresultssa8.blob.core.windows.net"))
  assert(contains(failed, "[redacted-query]"))
  assert_eq(contains(failed, "SECRET-SAS-SIGNATURE"), false)
  assert_eq(contains(failed, "?se="), false)
}

pipeline test_conflicting_artifact_layouts_fail_without_publishing(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  const failed = try {
    import_hosted_release_watch_receipt(
      harness,
      {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
      {
        download: fn(_run_id, destination) {
          const uploaded = path_join(destination, "release-harn", "watches", "v1.2.3.json")
          const nested = path_join(
            destination,
            ".harn-runs",
            "release-harn",
            "watches",
            "v1.2.3.json",
          )
          release_watch_receipt_write(
            pick(harness, ["fs", "random"]),
            uploaded,
            receipt("v1.2.3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"),
          )
          release_watch_receipt_write(
            pick(harness, ["fs", "random"]),
            nested,
            receipt("v1.2.3", "cccccccccccccccccccccccccccccccccccccccc"),
          )
          return {success: true, message: ""}
        },
      },
    )
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(failed, "contained conflicting watch receipts"))
  assert(!harness.fs.exists(f.destination))
}

pipeline test_existing_valid_receipt_wins_without_a_download(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  const expected = receipt("v1.2.3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  release_watch_receipt_write(pick(harness, ["fs", "random"]), f.destination, expected)
  let downloads = 0
  const imported = import_hosted_release_watch_receipt(
    harness,
    {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
    {
      download: fn(_run_id, _destination) {
        downloads = downloads + 1
        return {success: false, message: "must not run"}
      },
    },
  )
  assert_eq(imported, expected)
  assert_eq(downloads, 0)
}

pipeline test_invalid_hosted_receipt_fails_without_publishing(harness: Harness, task: any) {
  const f = fixture(harness.fs, "v1.2.3")
  const failed = try {
    import_hosted_release_watch_receipt(
      harness,
      {repo_root: ".", tag: "v1.2.3", run_id: 42, destination: f.destination},
      {
        download: fn(_run_id, destination) {
          const source = path_join(
            destination,
            ".harn-runs",
            "release-harn",
            "watches",
            "v1.2.3.json",
          )
          harness.fs.write_text(source, "{}")
          return {success: true, message: ""}
        },
      },
    )
    ""
  } catch (error) {
    to_string(error)
  }
  assert(contains(failed, "did not contain a valid watch receipt"))
