import { GitRemoteRef } from "std/git"
import {
  ReleaseAttemptAbandonAdapter,
  ReleaseAttemptClaim,
  release_abandoned_attempt_ref,
  release_attempt_abandon_decision,
  release_attempt_abandon_entry,
  release_attempt_archive_claim,
  release_attempt_archive_claim_receipt,
  run_release_attempt_abandon,
} from "../lib/release_attempt_abandon"
import { release_remote_ref_sweep_entry } from "../lib/release_ref_sweep"
import { GithubClientOptions } from "harn-github-connector/default"

const FIRST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const SECOND = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn remote(name: string, oid: string) -> GitRemoteRef {
  return {ref: name, name: name, oid: oid, peeled: false}
}

fn attempt(oid: string, version: string = "1.2.3") -> GitRemoteRef {
  return remote("refs/heads/release-attempt/v${version}/${oid}", oid)
}

fn unclaimed() -> ReleaseAttemptClaim {
  return {tag_target_oid: "", release_exists: false, open_pr: ""}
}

/**
 * Effects are observed through outcomes rather than a call log: a list handed
 * to the adapter is copied, so a recorded-calls side channel cannot be read
 * back. `delete_guard` lets a test assert that the delete never runs.
 */
fn effect_adapter(
  refs: list<GitRemoteRef>,
  claim: ReleaseAttemptClaim = {tag_target_oid: "", release_exists: false, open_pr: ""},
  archive_ok: bool = true,
  delete_ok: bool = true,
  delete_guard: string = "",
) -> ReleaseAttemptAbandonAdapter {
  return {
    now: fn() { return "2026-08-03T00:00:00Z" },
    attempt_refs: fn(_repo, _version) { return refs },
    claim: fn(_repo, _version, _oid) { return claim },
    archive_ref: fn(request) { return {
      success: archive_ok,
      created: archive_ok,
      observed_oid: if archive_ok {
        request.expected_oid
      } else {
        ""
      },
      message: if archive_ok {
        "pushed"
      } else {
        "remote rejected the archive push"
      },
    } },
    delete_ref: fn(_repo, _ref, _oid) {
      if trim(delete_guard) != "" {
        throw delete_guard
      }
      return {
        success: delete_ok,
        message: if delete_ok {
          "deleted"
        } else {
          "remote rejected the delete"
        },
      }
    },
  }
}

const API = "https://github.test"

fn api_options() -> GithubClientOptions {
  return {api_base_url: API, installation_token: "attempt-abandon-test-token"}
}

fn archive_request() {
  return {
    repo: "/tmp/harn",
    source_ref: "refs/heads/release-attempt/v1.2.3/${FIRST}",
    expected_oid: FIRST,
    archive_ref: "refs/heads/release-failed/v1.2.3/${FIRST}-abandoned",
  }
}

pipeline test_archive_claim_creates_only_an_absent_destination(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    API + "/repos/burin-labs/harn/git/refs",
    {status: 201, body: json_stringify({ref: archive_request().archive_ref})},
  )
  const archived = release_attempt_archive_claim(
    harness,
    "burin-labs/harn",
    archive_request(),
    api_options(),
  )
  assert_eq(archived.success, true)
  assert_eq(archived.created, true)
  assert_eq(archived.observed_oid, FIRST)
}

pipeline test_archive_claim_refuses_a_different_existing_object(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    API + "/repos/burin-labs/harn/git/refs",
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    API + "/repos/burin-labs/harn/git/ref/heads/release-failed/v1.2.3/${FIRST}-abandoned",
    {
      status: 200,
      body: json_stringify(
        {ref: archive_request().archive_ref, object: {sha: SECOND, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    API + "/repos/burin-labs/harn/git/commits/${SECOND}",
    {status: 200, body: json_stringify({sha: SECOND, message: "collision"})},
  )
  const archived = release_attempt_archive_claim(
    harness,
    "burin-labs/harn",
    archive_request(),
    api_options(),
  )
  assert_eq(archived.success, false)
  assert_eq(archived.created, false)
  assert_eq(archived.observed_oid, SECOND)
  assert(contains(archived.message, "already exists"))
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()),
    1,
    "the conflicting archive was never overwritten",
  )
}

pipeline test_archive_claim_adopts_only_the_same_existing_object(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    API + "/repos/burin-labs/harn/git/refs",
    {status: 422, body: json_stringify({message: "Reference already exists"})},
  )
  harness.testing.http_mock(
    "GET",
    API + "/repos/burin-labs/harn/git/ref/heads/release-failed/v1.2.3/${FIRST}-abandoned",
    {
      status: 200,
      body: json_stringify(
        {ref: archive_request().archive_ref, object: {sha: FIRST, type: "commit"}},
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    API + "/repos/burin-labs/harn/git/commits/${FIRST}",
    {status: 200, body: json_stringify({sha: FIRST, message: "prior recovery"})},
  )
  const archived = release_attempt_archive_claim(
    harness,
    "burin-labs/harn",
    archive_request(),
    api_options(),
  )
  assert_eq(archived.success, true)
  assert_eq(archived.created, false)
  assert_eq(archived.observed_oid, FIRST)
}

pipeline test_archive_claim_false_success_identity_fails_closed(task: any) {
  for observed_oid in ["", SECOND] {
    const result = release_attempt_archive_claim_receipt(
      archive_request(),
      {
        repo: "burin-labs/harn",
        ref: archive_request().archive_ref,
        oid: observed_oid,
        claimed: true,
        holder_headline: "",
      },
    )
    assert_eq(result.success, false)
    assert_eq(result.created, true)
    assert_eq(result.observed_oid, observed_oid)
  }
}

fn run(
  refs: list<GitRemoteRef>,
  mode: string = "apply",
  claim: ReleaseAttemptClaim = {tag_target_oid: "", release_exists: false, open_pr: ""},
  archive_ok: bool = true,
  delete_ok: bool = true,
  delete_guard: string = "",
) {
  return run_release_attempt_abandon(
    effect_adapter(refs, claim, archive_ok, delete_ok, delete_guard),
    {repo: "/tmp/harn", version: "1.2.3", mode: mode},
  )
}

pipeline test_unclaimed_attempt_is_planned_for_archive(task: any) {
  const entry = release_attempt_abandon_entry("1.2.3", attempt(FIRST), unclaimed())
  assert_eq(entry.action, "archive")
  assert_eq(entry.outcome, "planned")
  assert_eq(entry.reason_code, "unclaimed_pre_tag_candidate")
  assert_eq(entry.archive_ref, "refs/heads/release-failed/v1.2.3/${FIRST}-abandoned")
}

pipeline test_prerelease_attempt_is_planned_for_archive(task: any) {
  const entry = release_attempt_abandon_entry(
    "1.2.4-rc.10",
    attempt(FIRST, "1.2.4-rc.10"),
    unclaimed(),
  )
  assert_eq(entry.action, "archive")
  assert_eq(entry.archive_ref, "refs/heads/release-failed/v1.2.4-rc.10/${FIRST}-abandoned")
}

pipeline test_every_claim_retains_the_attempt(task: any) {
  const claims = [
    {claim: {tag_target_oid: FIRST, release_exists: false, open_pr: ""}, code: "claimed_by_tag"},
    {claim: {tag_target_oid: "", release_exists: true, open_pr: ""}, code: "claimed_by_release"},
    {
      claim: {tag_target_oid: "", release_exists: false, open_pr: "https://example.test/pr/7"},
      code: "claimed_by_open_pr",
    },
  ]
  for case in claims {
    const decision = release_attempt_abandon_decision(FIRST, case.claim)
    assert_eq(decision.action, "retain")
    assert_eq(decision.reason_code, case.code)
    const entry = release_attempt_abandon_entry("1.2.3", attempt(FIRST), case.claim)
    assert_eq(entry.outcome, "retained")
    assert_eq(entry.archive_ref, "")
  }
}

pipeline test_orphan_left_by_a_tag_on_another_oid_is_archived(task: any) {
  // The release tagged SECOND, so FIRST is a losing candidate. No tag can ever
  // recover it, so sweep_release_refs retains it forever; this harness is the
  // only thing that retires it.
  const claim = {tag_target_oid: SECOND, release_exists: true, open_pr: ""}
  const decision = release_attempt_abandon_decision(FIRST, claim)
  assert_eq(decision.action, "archive")
  assert_eq(decision.reason_code, "orphaned_by_shipped_tag")
  const entry = release_attempt_abandon_entry("1.2.3", attempt(FIRST), claim)
  assert_eq(entry.action, "archive")
  assert_eq(entry.archive_ref, "refs/heads/release-failed/v1.2.3/${FIRST}-abandoned")
}

pipeline test_open_pr_outranks_a_tag_on_another_oid(task: any) {
  const decision = release_attempt_abandon_decision(
    FIRST,
    {tag_target_oid: SECOND, release_exists: true, open_pr: "https://example.test/pr/11"},
  )
  assert_eq(decision.action, "retain")
  assert_eq(decision.reason_code, "claimed_by_open_pr")
}

pipeline test_moved_ref_is_never_abandoned(task: any) {
  // The ref name claims FIRST but origin has it pointing at SECOND, so the ref
  // is not provably the attempt it names.
  const entry = release_attempt_abandon_entry(
    "1.2.3",
    remote("refs/heads/release-attempt/v1.2.3/${FIRST}", SECOND),
    unclaimed(),
  )
  assert_eq(entry.action, "retain")
  assert_eq(entry.reason_code, "moved_ref")
}

pipeline test_other_version_attempt_is_never_abandoned(task: any) {
  const entry = release_attempt_abandon_entry("1.2.3", attempt(FIRST, "1.2.4"), unclaimed())
  assert_eq(entry.action, "retain")
  assert_eq(entry.reason_code, "version_mismatch")
}

pipeline test_dry_run_plans_without_touching_any_ref(task: any) {
  // The guard proves the dry run reaches no effect at all.
  const result = run(
    [attempt(FIRST), attempt(SECOND)],
    "dry_run",
    unclaimed(),
    true,
    true,
    "dry run must not delete any ref",
  )
  assert_eq(result.state, "planned")
  assert_eq(len(result.attempts), 2)
  assert_eq(result.attempts[0]?.outcome, "planned")
}

pipeline test_apply_archives_before_deleting(task: any) {
  const result = run([attempt(FIRST)])
  assert_eq(result.state, "abandoned")
  assert_eq(result.attempts[0]?.outcome, "archived")
  assert_eq(
    contains(
      result.attempts[0]?.message ?? "",
      "refs/heads/release-failed/v1.2.3/${FIRST}-abandoned",
    ),
    true,
  )
}

pipeline test_one_claimed_attempt_blocks_every_sibling(task: any) {
  // Freeing only part of the set would leave recovery wedged on the remainder,
  // so the guard must never fire.
  const result = run(
    [attempt(FIRST), attempt(SECOND)],
    "apply",
    {tag_target_oid: "", release_exists: false, open_pr: "https://example.test/pr/9"},
    true,
    true,
    "a claimed version must not delete any ref",
  )
  assert_eq(result.state, "blocked")
  assert_eq(result.attempts[0]?.outcome, "retained")
}

pipeline test_exact_selection_preserves_a_claimed_sibling(task: any) {
  const adapter: ReleaseAttemptAbandonAdapter = {
    now: fn() { return "2026-08-03T00:00:00Z" },
    attempt_refs: fn(_repo, _version) { return [attempt(FIRST), attempt(SECOND)] },
    claim: fn(_repo, _version, oid) {
      if oid == FIRST {
        throw "an unselected sibling must not be probed or changed"
      }
      return unclaimed()
    },
    archive_ref: fn(_request) {
      throw "dry run must not archive"
    },
    delete_ref: fn(_repo, _ref, _oid) {
      throw "dry run must not delete"
    },
  }
  const result = run_release_attempt_abandon(
    adapter,
    {repo: "/tmp/harn", version: "1.2.3", mode: "dry_run", selected_attempt_oid: SECOND},
  )
  assert_eq(result.state, "planned")
  assert_eq(result.selected_attempt_oid, SECOND)
  assert_eq(result.attempts[0]?.reason_code, "not_selected")
  assert_eq(result.attempts[1]?.action, "archive")
}

pipeline test_exact_selection_refuses_a_missing_attempt(task: any) {
  const result = run_release_attempt_abandon(
    effect_adapter([attempt(FIRST)]),
    {repo: "/tmp/harn", version: "1.2.3", mode: "apply", selected_attempt_oid: SECOND},
  )
  assert_eq(result.state, "blocked")
  assert_eq(result.attempts[0]?.reason_code, "not_selected")
  assert_eq(result.attempts[1]?.reason_code, "selected_attempt_missing")
}

pipeline test_exact_selection_refuses_a_moved_attempt(task: any) {
  const result = run_release_attempt_abandon(
    effect_adapter(
      [remote("refs/heads/release-attempt/v1.2.3/${SECOND}", FIRST)],
      unclaimed(),
      true,
      true,
      "a moved selected ref must not be deleted",
    ),
    {repo: "/tmp/harn", version: "1.2.3", mode: "apply", selected_attempt_oid: SECOND},
  )
  assert_eq(result.state, "blocked")
  assert_eq(result.attempts[0]?.reason_code, "moved_ref")
}

pipeline test_exact_selection_refuses_a_claimed_attempt(task: any) {
  const result = run_release_attempt_abandon(
    effect_adapter(
      [attempt(FIRST), attempt(SECOND)],
      {tag_target_oid: "", release_exists: false, open_pr: "https://example.test/pr/9"},
      true,
      true,
      "a claimed selected ref must not be deleted",
    ),
    {repo: "/tmp/harn", version: "1.2.3", mode: "apply", selected_attempt_oid: SECOND},
  )
  assert_eq(result.state, "blocked")
  assert_eq(result.attempts[0]?.reason_code, "not_selected")
  assert_eq(result.attempts[1]?.reason_code, "claimed_by_open_pr")
}

pipeline test_exact_selection_mutates_only_the_selected_attempt(task: any) {
  const adapter: ReleaseAttemptAbandonAdapter = {
    now: fn() { return "2026-08-03T00:00:00Z" },
    attempt_refs: fn(_repo, _version) { return [attempt(FIRST), attempt(SECOND)] },
    claim: fn(_repo, _version, oid) {
      if oid != SECOND {
        throw "an unselected sibling must not be probed"
      }
      return unclaimed()
    },
    archive_ref: fn(request) {
      if request.expected_oid != SECOND {
        throw "an unselected sibling must not be archived"
      }
      return {success: true, created: true, observed_oid: SECOND, message: "created"}
    },
    delete_ref: fn(_repo, ref, oid) {
      if oid != SECOND || ref != "refs/heads/release-attempt/v1.2.3/${SECOND}" {
        throw "an unselected sibling must not be deleted"
      }
      return {success: true, observed_oid: SECOND, message: "deleted"}
    },
  }
  const result = run_release_attempt_abandon(
    adapter,
    {repo: "/tmp/harn", version: "1.2.3", mode: "apply", selected_attempt_oid: SECOND},
  )
  assert_eq(result.state, "abandoned")
  assert_eq(result.attempts[0]?.reason_code, "not_selected")
  assert_eq(result.attempts[1]?.outcome, "archived")
  assert_eq(result.attempts[1]?.archive_created, true)
  assert_eq(result.attempts[1]?.source_delete_observed_oid, SECOND)
}

pipeline test_apply_rechecks_the_selected_source_before_archiving(task: any) {
  let inventories = 0
  const adapter: ReleaseAttemptAbandonAdapter = {
    now: fn() { return "2026-08-03T00:00:00Z" },
    attempt_refs: fn(_repo, _version) {
      inventories = inventories + 1
      return if inventories == 1 {
        [attempt(SECOND)]
      } else {
        [remote("refs/heads/release-attempt/v1.2.3/${SECOND}", FIRST)]
      }
    },
    claim: fn(_repo, _version, _oid) { return unclaimed() },
    archive_ref: fn(_request) {
      throw "a moved source must not be archived"
    },
    delete_ref: fn(_repo, _ref, _oid) {
      throw "a moved source must not be deleted"
    },
  }
  const result = run_release_attempt_abandon(
    adapter,
    {repo: "/tmp/harn", version: "1.2.3", mode: "apply", selected_attempt_oid: SECOND},
  )
  assert_eq(inventories, 2)
  assert_eq(result.state, "blocked")
  assert_eq(result.attempts[0]?.reason_code, "moved_ref")
}

pipeline test_apply_rechecks_the_selected_claim_before_archiving(task: any) {
  let claims = 0
  const adapter: ReleaseAttemptAbandonAdapter = {
    now: fn() { return "2026-08-03T00:00:00Z" },
    attempt_refs: fn(_repo, _version) { return [attempt(SECOND)] },
    claim: fn(_repo, _version, _oid) {
      claims = claims + 1
      return if claims == 1 {
        unclaimed()
      } else {
        {tag_target_oid: "", release_exists: false, open_pr: "https://example.test/pr/10"}
      }
    },
    archive_ref: fn(_request) {
      throw "a newly claimed source must not be archived"
    },
    delete_ref: fn(_repo, _ref, _oid) {
      throw "a newly claimed source must not be deleted"
    },
  }
  const result = run_release_attempt_abandon(
    adapter,
    {repo: "/tmp/harn", version: "1.2.3", mode: "apply", selected_attempt_oid: SECOND},
  )
  assert_eq(claims, 2)
  assert_eq(result.state, "blocked")
  assert_eq(result.attempts[0]?.reason_code, "claimed_by_open_pr")
}

pipeline test_failed_archive_keeps_the_attempt_ref(task: any) {
  // Archive before delete is the whole safety property: a failed archive must
  // never reach the delete, or the attempt would exist nowhere on origin.
  const result = run(
    [attempt(FIRST)],
    "apply",
    unclaimed(),
    false,
    true,
    "delete must not run after a failed archive",
  )
  assert_eq(result.state, "failed")
  assert_eq(result.attempts[0]?.outcome, "failed")
  assert_eq(contains(result.attempts[0]?.message ?? "", "could not archive"), true)
}

pipeline test_false_archive_success_without_identity_never_deletes(task: any) {
  for observed_oid in ["", SECOND] {
    const adapter: ReleaseAttemptAbandonAdapter = {
      now: fn() { return "2026-08-03T00:00:00Z" },
      attempt_refs: fn(_repo, _version) { return [attempt(FIRST)] },
      claim: fn(_repo, _version, _oid) { return unclaimed() },
      archive_ref: fn(_request) { return {
        success: true,
        created: true,
        observed_oid: observed_oid,
        message: "claimed success",
      } },
      delete_ref: fn(_repo, _ref, _oid) {
        throw "unmeasured or wrong archive identity must never authorize deletion"
      },
    }
    const result = run_release_attempt_abandon(
      adapter,
      {repo: "/tmp/harn", version: "1.2.3", mode: "apply"},
    )
    assert_eq(result.state, "failed")
    assert_eq(result.attempts[0]?.outcome, "failed")
    assert_eq(result.attempts[0]?.archive_observed_oid, observed_oid)
    assert_eq(result.attempts[0]?.partial, false)
    assert(contains(result.attempts[0]?.message ?? "", "did not prove"))
  }
}

pipeline test_failed_delete_reports_the_archived_copy(task: any) {
  const result = run([attempt(FIRST)], "apply", unclaimed(), true, false)
  assert_eq(result.state, "failed")
  assert_eq(result.attempts[0]?.outcome, "failed")
  assert_eq(result.attempts[0]?.partial, true)
  assert_eq(result.attempts[0]?.archive_observed_oid, FIRST)
  assert_eq(
    contains(
      result.attempts[0]?.message ?? "",
      "refs/heads/release-failed/v1.2.3/${FIRST}-abandoned",
    ),
    true,
  )
}

pipeline test_version_without_attempts_is_already_clear(task: any) {
  const result = run([])
  assert_eq(result.state, "clear")
  assert_eq(len(result.attempts), 0)
}

pipeline test_archive_namespace_is_the_one_the_sweep_owns(task: any) {
  // The archive name is only useful if `sweep_release_refs` still recognizes
  // it; an unowned namespace would be retained as malformed forever.
  const archived = release_abandoned_attempt_ref("1.2.3", FIRST)
  const entry = release_remote_ref_sweep_entry(
    "burin-labs/harn",
    remote(archived, FIRST),
    fn(_slug, _ref) { return "1.2.3" },
    fn(_oid) { return false },
    fn(version, ref_oid, _slug) { return {
      version: version,
      tag: "v${version}",
      ref_oid: ref_oid,
      tag_target_oid: FIRST,
      signed_tag: true,
      hosted_terminal: true,
      withdrawn: false,
      message: "signed published tag and terminal hosted release recover exact OID",
    } },
  )
  assert_eq(entry.reason_code, "tag_backed_terminal_release")
  assert_eq(entry.action, "delete")
}

pipeline test_shipped_attempt_does_not_block_its_orphan_siblings(task: any) {
  // The live shape after v0.10.53: the tag recovers one attempt and a losing
  // candidate sits beside it. Pre-tag all-or-nothing would strand the orphan,
  // which is the only ref nothing else can retire.
  const claim = {tag_target_oid: FIRST, release_exists: true, open_pr: ""}
  const planned = run([attempt(FIRST), attempt(SECOND)], "dry_run", claim)
  assert_eq(planned.state, "planned")
  assert_eq(planned.attempts[0]?.reason_code, "claimed_by_tag")
  assert_eq(planned.attempts[0]?.action, "retain")
  assert_eq(planned.attempts[1]?.reason_code, "orphaned_by_shipped_tag")
  assert_eq(planned.attempts[1]?.action, "archive")
  const applied = run([attempt(FIRST), attempt(SECOND)], "apply", claim)
  assert_eq(applied.state, "abandoned")
  assert_eq(applied.attempts[0]?.outcome, "retained")
  assert_eq(applied.attempts[1]?.outcome, "archived")
}

pipeline test_only_the_shipped_attempt_is_already_clear(task: any) {
  // Nothing to retire, and the guard proves no ref is touched.
  const result = run(
    [attempt(FIRST)],
    "apply",
    {tag_target_oid: FIRST, release_exists: true, open_pr: ""},
    true,
    true,
    "a tag-recovered attempt must not be deleted",
  )
  assert_eq(result.state, "clear")
  assert_eq(result.attempts[0]?.outcome, "retained")
}

pipeline test_open_pr_still_blocks_orphan_cleanup(task: any) {
  // A live PR is unresolved ownership, so it must still stop everything.
  const result = run(
    [attempt(FIRST), attempt(SECOND)],
    "apply",
    {tag_target_oid: SECOND, release_exists: true, open_pr: "https://example.test/pr/12"},
    true,
    true,
    "a blocked version must not delete any ref",
  )
  assert_eq(result.state, "blocked")
}
