import { ChainRefRun, chain_ref_identity } from "../lib/chain_ref_reap"
import {
  claim_fleet_version_lease_with_adapter,
  fleet_version_lease_decision,
  fleet_version_lease_glob,
  fleet_version_lease_holder,
  fleet_version_lease_identity,
  fleet_version_lease_ref,
  fleet_version_lease_unreadable_holder,
} from "../lib/fleet_version_lease"
import { decode_github_workflow } from "../lib/github_workflow"

const VERSION = "v0.10.140"

// The two chains that ran side by side. Real ids, because the refusal's whole
// value is naming a run a person can open.
const HOLDER = "35585351929"

const MINE = "35712201495"

const REVISION = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn running() -> list<ChainRefRun> {
  return [
    {id: 1, status: "completed", conclusion: "failure"},
    {id: 2, status: "in_progress", conclusion: ""},
  ]
}

fn finished() -> list<ChainRefRun> {
  return [
    {id: 1, status: "completed", conclusion: "failure"},
    {id: 2, status: "completed", conclusion: "failure"},
  ]
}

fn named(chain_id: string) -> {chain_id: string, ref: string, oid: string} {
  return {chain_id: chain_id, ref: fleet_version_lease_ref(VERSION, chain_id), oid: REVISION}
}

/** The ref carries both facts, so a refusal can name the holder from the name alone. */
pipeline test_the_lease_ref_names_the_version_and_the_chain() {
  const ref = fleet_version_lease_ref(VERSION, HOLDER)
  assert_eq(ref, "refs/heads/harn-update-version/v0.10.140/" + HOLDER)
  const identity = fleet_version_lease_identity(ref)
  assert(identity != nil)
  assert_eq(unwrap(identity).version, VERSION)
  assert_eq(unwrap(identity).chain_id, HOLDER)
  assert_eq(fleet_version_lease_glob(VERSION), "refs/heads/harn-update-version/v0.10.140/*")
  assert_eq(fleet_version_lease_identity("refs/heads/harn-update-chain/" + HOLDER), nil)
  assert_eq(fleet_version_lease_identity("refs/heads/main"), nil)
}

/** A version that is not an exact release tag has no lease to take. */
pipeline test_an_inexact_version_is_refused_before_any_ref_is_named() {
  for bad in ["", "0.10.140", "v0.10", "v0.10.140-dev", "latest"] {
    let refused = false
    try {
      fleet_version_lease_ref(bad, HOLDER)
    } catch {
      refused = true
    }
    assert(refused, "an inexact version must not produce a lease ref")
  }
}

/**
 * The falsifier. A second round 1 for a version another chain is updating
 * refuses, and says which chain.
 */
pipeline test_a_second_round_one_refuses_and_names_the_live_holder() {
  const decision = fleet_version_lease_decision(
    MINE,
    1,
    [fleet_version_lease_holder(named(HOLDER), running())],
  )
  assert_eq(decision.action, "refuse")
  assert_eq(decision.reason, "version_held_by_a_live_chain")
  assert_eq(decision.holder_chain_id, HOLDER)
  assert_eq(decision.blocking, [HOLDER])
  assert(contains(decision.summary, HOLDER))
  assert(contains(decision.summary, "schedules nothing"))
}

/** The control: once the holder's rounds are all finished, a new chain proceeds. */
pipeline test_a_finished_holder_does_not_block_a_new_chain() {
  const decision = fleet_version_lease_decision(
    MINE,
    1,
    [fleet_version_lease_holder(named(HOLDER), finished())],
  )
  assert_eq(decision.action, "reclaim_then_proceed")
  assert_eq(decision.reason, "stale_holder_reclaimed")
  assert_eq(decision.reclaimable, [HOLDER])
  assert_eq(decision.holder_chain_id, MINE)
  assert(contains(decision.summary, HOLDER), "the reclaim names what it took")
}

/**
 * A holder whose runs GitHub no longer has is stale, not live.
 *
 * Retention removes the runs long before anyone thinks to clear the ref, and a
 * lease that can never be reclaimed would block that version forever.
 */
pipeline test_a_holder_with_no_runs_left_is_stale() {
  const decision = fleet_version_lease_decision(
    MINE,
    1,
    [fleet_version_lease_holder(named(HOLDER), [])],
  )
  assert_eq(decision.action, "reclaim_then_proceed")
  assert_eq(decision.reclaimable, [HOLDER])
}

/**
 * A read that failed is not a free lease.
 *
 * This is the direction that costs money. Treating an unreadable holder as
 * finished starts the second chain, which is the failure this exists to stop,
 * so an unknown liveness refuses.
 */
pipeline test_an_unreadable_holder_refuses_rather_than_reclaiming() {
  const decision = fleet_version_lease_decision(
    MINE,
    1,
    [fleet_version_lease_unreadable_holder(named(HOLDER), "the run list could not be read")],
  )
  assert_eq(decision.action, "refuse")
  assert_eq(decision.reason, "holder_liveness_unreadable")
  assert_eq(decision.holder_chain_id, HOLDER)
  assert_eq(decision.reclaimable, [])
}

/** A live holder outranks a stale one; one live chain is enough to refuse. */
pipeline test_one_live_holder_refuses_even_beside_a_stale_one() {
  const decision = fleet_version_lease_decision(
    MINE,
    1,
    [
      fleet_version_lease_holder(named("35585351920"), finished()),
      fleet_version_lease_holder(named(HOLDER), running()),
    ],
  )
  assert_eq(decision.action, "refuse")
  assert_eq(decision.holder_chain_id, HOLDER)
  assert_eq(decision.reclaimable, [], "nothing is reclaimed while a live chain holds the version")
}

/**
 * A chain never blocks itself.
 *
 * Round 1 takes the lease, so every later round of that chain finds it held.
 * A lock that does not know who is asking stops every chain at round two.
 */
pipeline test_a_later_round_of_the_holding_chain_proceeds() {
  const own = fleet_version_lease_decision(
    MINE,
    1,
    [fleet_version_lease_holder(named(MINE), running())],
  )
  assert_eq(own.action, "proceed")
  assert_eq(own.reason, "version_unheld")
  const later = fleet_version_lease_decision(
    MINE,
    3,
    [fleet_version_lease_holder(named(HOLDER), running())],
  )
  assert_eq(later.action, "proceed")
  assert_eq(later.reason, "successor_round_of_an_existing_chain")
}

/** An unheld version is taken without ceremony. */
pipeline test_an_unheld_version_proceeds() {
  const decision = fleet_version_lease_decision(MINE, 1, [])
  assert_eq(decision.action, "proceed")
  assert_eq(decision.reason, "version_unheld")
  assert_eq(decision.holder_chain_id, MINE)
}

/**
 * The wiring, not only the decision: a blocked round takes no lease and
 * reclaims nothing.
 */
pipeline test_a_blocked_round_claims_nothing_and_clears_nothing() {
  let cleared: list<string> = []
  let claimed: list<string> = []
  let listed: list<string> = []
  const receipt = claim_fleet_version_lease_with_adapter(
    VERSION,
    MINE,
    1,
    {
      refs: fn(glob) {
        listed = listed + [glob]
        return [{ref: fleet_version_lease_ref(VERSION, HOLDER), oid: REVISION}]
      },
      runs: fn(_chain_id) { return running() },
      clear: fn(ref, _oid) {
        cleared = cleared + [ref]
        return nil
      },
      claim: fn(ref, _chain_id) {
        claimed = claimed + [ref]
        return nil
      },
    },
  )
  assert_eq(receipt.decision.action, "refuse")
  assert_eq(receipt.claimed, false)
  assert_eq(receipt.cleared, [])
  assert_eq(claimed, [], "a blocked round must take no lease")
  assert_eq(cleared, [], "a blocked round must reclaim nothing")
  assert_eq(listed, [fleet_version_lease_glob(VERSION)])
}

/** The reclaim happens, is recorded by chain, and the new lease is taken. */
pipeline test_a_stale_holder_is_reclaimed_then_the_lease_is_taken() {
  let cleared: list<string> = []
  let claimed: list<string> = []
  const receipt = claim_fleet_version_lease_with_adapter(
    VERSION,
    MINE,
    1,
    {
      refs: fn(_glob) { return [{ref: fleet_version_lease_ref(VERSION, HOLDER), oid: REVISION}] },
      runs: fn(_chain_id) { return finished() },
      clear: fn(ref, _oid) {
        cleared = cleared + [ref]
        return nil
      },
      claim: fn(ref, _chain_id) {
        claimed = claimed + [ref]
        return nil
      },
    },
  )
  assert_eq(receipt.decision.action, "reclaim_then_proceed")
  assert_eq(receipt.cleared, [HOLDER])
  assert_eq(cleared, [fleet_version_lease_ref(VERSION, HOLDER)])
  assert_eq(claimed, [fleet_version_lease_ref(VERSION, MINE)])
  assert(receipt.claimed)
}

/**
 * An inventory that could not be read refuses.
 *
 * An empty listing and a failed listing want opposite answers, and only one of
 * them is safe to guess.
 */
pipeline test_an_unreadable_inventory_refuses() {
  const receipt = claim_fleet_version_lease_with_adapter(
    VERSION,
    MINE,
    1,
    {
      refs: fn(_glob) {
        throw "git ls-remote failed"
      },
      runs: fn(_chain_id) { return [] },
      clear: fn(_ref, _oid) { return nil },
      claim: fn(_ref, _chain) { return nil },
    },
  )
  assert_eq(receipt.inventory, "unreadable")
  assert_eq(receipt.decision.action, "refuse")
  assert_eq(receipt.decision.reason, "version_lease_inventory_unreadable")
  assert_eq(receipt.claimed, false)
}

/** A later round reads nothing and takes nothing; the lease is already its own. */
pipeline test_a_later_round_touches_no_refs_at_all() {
  let listed: list<string> = []
  let claimed: list<string> = []
  const receipt = claim_fleet_version_lease_with_adapter(
    VERSION,
    MINE,
    2,
    {
      refs: fn(glob) {
        listed = listed + [glob]
        return []
      },
      runs: fn(_chain_id) { return [] },
      clear: fn(_ref, _oid) { return nil },
      claim: fn(ref, _chain_id) {
        claimed = claimed + [ref]
        return nil
      },
    },
  )
  assert_eq(receipt.decision.action, "proceed")
  assert_eq(listed, [], "a later round must not pay for an inventory it cannot act on")
  assert_eq(claimed, [])
}

/**
 * The reaper has to know this namespace exists.
 *
 * A lease is left behind by every chain that ends, and a version whose chain
 * never runs again keeps its ref forever. Without the reaper's pattern the
 * namespace only grows, and nothing in the fleet can clear it.
 */
pipeline test_the_reaper_recognizes_a_version_lease_ref() {
  assert_eq(chain_ref_identity(fleet_version_lease_ref(VERSION, HOLDER)), HOLDER)
  assert_eq(chain_ref_identity("refs/heads/harn-update-chain/" + HOLDER), HOLDER)
  assert_eq(chain_ref_identity("refs/heads/harn-update-version/notaversion/" + HOLDER), nil)
}

/**
 * The gate runs before anything is dispatched, and before the fleet is
 * materialized. A lease checked after the spend has started has not prevented
 * the spend.
 */
pipeline test_the_lease_step_precedes_every_fleet_side_effect(harness: Harness) {
  const workflow = decode_github_workflow(
    harness.fs.read_text(
      path_join(dirname(harness.fs.cwd()), ".github", "workflows", "bump-fleet.yml"),
    ),
  )
  let lease_at = -1
  let first_effect_at = -1
  let index = 0
  for step in workflow.jobs["update"]["steps"] {
    const name = to_string(step.get("name") ?? "")
    if name == "Hold the version lease for this chain" {
      lease_at = index
    }
    if first_effect_at < 0
      && (name == "Materialize manifest-owned fleet" || name == "Start Harn updates") {
      first_effect_at = index
    }
    index = index + 1
  }
  assert(lease_at >= 0, "the version lease step must exist")
  assert(first_effect_at >= 0, "the fleet side-effect steps must still exist")
  assert(lease_at < first_effect_at, "the lease must be held before the fleet is touched")
}
