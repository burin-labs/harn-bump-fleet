import { pre_tag_size_reuse_decision, run_pre_tag_size_gate } from "../lib/pretag_size_gate"
import { pre_tag_binary_size_gate_config } from "../lib/release_execution"
import { PreTagBinaryGateConfig } from "../lib/workflow_runs"

const SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn run_snapshot(id: int, status: string, conclusion: string?) {
  return {
    id: id,
    event: "workflow_dispatch",
    head_branch: "main",
    head_sha: SHA,
    status: status,
    conclusion: conclusion,
    url: "https://github.test/run/${id}",
  }
}

fn run_view(
  conclusion: string,
  job_conclusion: string = "success",
  step_conclusion: string = "success",
) {
  return run_snapshot(11, "completed", conclusion)
    + {
      jobs: [
        {
          id: 101,
          name: "Build x86_64-unknown-linux-gnu",
          status: "completed",
          conclusion: job_conclusion,
          started_at: "2026-07-13T10:00:00Z",
          completed_at: "2026-07-13T10:10:00Z",
          url: "https://github.test/job/101",
          steps: [
            {
              number: 7,
              name: "Verify benchmark source revision",
              status: "completed",
              conclusion: step_conclusion,
              started_at: "2026-07-13T10:08:00Z",
              completed_at: "2026-07-13T10:08:05Z",
            },
            {
              number: 8,
              name: "Check the distribution fuse",
              status: "completed",
              conclusion: step_conclusion,
              started_at: "2026-07-13T10:08:30Z",
              completed_at: "2026-07-13T10:08:35Z",
            },
            {
              number: 9,
              name: "Evaluate the binary-size growth signal",
              status: "completed",
              conclusion: step_conclusion,
              started_at: "2026-07-13T10:09:00Z",
              completed_at: "2026-07-13T10:09:05Z",
            },
          ],
        },
      ],
    }
}

fn virtual_adapter(terminal_view: dict) {
  let views = 0
  return {
    dispatch: fn(_config) { return {
      accepted: true,
      run_id: 11,
      url: "https://github.test/run/11",
      event: "workflow_dispatch",
      head_branch: "main",
      head_sha: SHA,
    } },
    view_run: fn(run_id) {
      views = views + 1
      if run_id != 11 {
        return Err({code: "wrong_run", message: "unexpected run"})
      }
      if views == 1 {
        return {run: run_snapshot(11, "in_progress", ""), jobs: []}
      }
      return {run: terminal_view, jobs: terminal_view.jobs ?? []}
    },
    wait: fn(_interval_ms) {
    },
  }
}

pipeline test_pre_tag_size_gate_green_from_virtual_snapshots(task: any) {
  let started_events = []
  const result = run_pre_tag_size_gate(
    pre_tag_binary_size_gate_config("main", SHA, "release/v1.2.3", SHA),
    virtual_adapter(run_view("success")),
    { event -> started_events = started_events + [event] },
  )
  assert_eq(result.success, true)
  assert_eq(result.run_id, 11)
  assert_eq(result.run_url, "https://github.test/run/11")
  assert(contains(result.message, SHA))
  assert_eq(len(started_events), 1)
  assert_eq(started_events[0].run_id, 11)
  assert_eq(started_events[0].run_url, "https://github.test/run/11")
  assert_eq(started_events[0].policy_ref, "main")
  assert_eq(started_events[0].expected_policy_sha, SHA)
  assert_eq(started_events[0].source_ref, "release/v1.2.3")
  assert_eq(started_events[0].expected_source_sha, SHA)
  assert_eq(started_events[0].observed_head_sha, SHA)
  assert_eq(started_events[0].target_job, "Build x86_64-unknown-linux-gnu")
  assert_eq(started_events[0].required_source_step, "Verify benchmark source revision")
  assert_eq(started_events[0].required_size_step, "Evaluate the binary-size growth signal")
  assert_eq(started_events[0].required_fuse_step, "Check the distribution fuse")
  assert_eq(started_events[0].transient_view_retry_max_attempts, 3)
  assert_eq(started_events[0].transient_view_retry_base_ms, 1000)
  assert_eq(started_events[0].transient_view_retry_cap_ms, 5000)
}

pipeline test_pre_tag_size_gate_red_uses_terminal_view_verdict(task: any) {
  const result = run_pre_tag_size_gate(
    pre_tag_binary_size_gate_config("main", SHA, "release/v1.2.3", SHA),
    virtual_adapter(run_view("failure")),
  )
  assert_eq(result.success, false)
  assert_eq(result.phase, "complete")
  assert(contains(result.message, "conclusion failure"))
}

pipeline test_pre_tag_size_gate_times_out_on_virtual_active_snapshots(task: any) {
  const base = pre_tag_binary_size_gate_config("main", SHA, "release/v1.2.3", SHA)
  const config: PreTagBinaryGateConfig = {
    workflow: base.workflow,
    event: base.event,
    policy_ref: base.policy_ref,
    expected_policy_sha: base.expected_policy_sha,
    source_ref: base.source_ref,
    expected_source_sha: base.expected_source_sha,
    target_job: base.target_job,
    required_source_step: base.required_source_step,
    required_fuse_step: base.required_fuse_step,
    required_size_step: base.required_size_step,
    benchmark_only: base.benchmark_only,
    runner_profile: base.runner_profile,
    targets: base.targets,
    completion_timeout_ms: 20,
    completion_interval_ms: 10,
    transient_view_retry_max_attempts: base.transient_view_retry_max_attempts,
    transient_view_retry_base_ms: base.transient_view_retry_base_ms,
    transient_view_retry_cap_ms: base.transient_view_retry_cap_ms,
  }
  const result = run_pre_tag_size_gate(
    config,
    virtual_adapter(run_snapshot(11, "in_progress", nil) + {jobs: []}),
  )
  assert_eq(result.success, false)
  assert_eq(result.phase, "complete")
  assert_eq(result.run_id, 11)
  assert_eq(result.completion_timeout_ms, 20)
  assert(contains(result.message, "within 20ms"))
}

pipeline test_pre_tag_size_gate_fails_closed_on_view_error(task: any) {
  const config = pre_tag_binary_size_gate_config("main", SHA, "release/v1.2.3", SHA)
  const result = run_pre_tag_size_gate(
    config,
    {
      dispatch: fn(_config) { return {
        accepted: true,
        run_id: 11,
        url: "https://github.test/run/11",
        event: config.event,
        head_branch: config.policy_ref,
        head_sha: config.expected_policy_sha,
      } },
      view_run:
        fn(_run_id) { return Err({code: "invalid_response", message: "missing run evidence"}) },
      wait: fn(_interval_ms) {
      },
    },
  )
  assert_eq(result.success, false)
  assert_eq(result.phase, "inspect")
  assert(contains(result.message, "missing run evidence"))
}

pipeline test_pre_tag_size_gate_recovers_one_typed_transient_view_error_without_redispatch(
  task: any,
) {
  const config = pre_tag_binary_size_gate_config("main", SHA, "release/v1.2.3", SHA)
  let dispatches = 0
  let view_ids = []
  let waits = []
  const result = run_pre_tag_size_gate(
    config,
    {
      dispatch: fn(_config) {
        dispatches = dispatches + 1
        return {
          accepted: true,
          run_id: 11,
          url: "https://github.test/run/11",
          event: config.event,
          head_branch: config.policy_ref,
          head_sha: config.expected_policy_sha,
        }
      },
      view_run: fn(run_id) {
        view_ids = view_ids + [run_id]
        if len(view_ids) == 1 {
          return Err({code: "network", message: "temporary GitHub API failure"})
        }
        const terminal = run_view("success")
        return {run: terminal, jobs: terminal.jobs ?? []}
      },
      wait: fn(delay_ms) { waits = waits + [delay_ms] },
    },
  )
  assert_eq(result.success, true)
  assert_eq(dispatches, 1)
  assert_eq(view_ids, [11, 11])
  assert_eq(waits, [config.transient_view_retry_base_ms])
  assert_eq(result.view_attempts, 2)
  assert_eq(result.transient_view_retries, 1)
  assert(contains(result.message, "1 transient status-read retries"))
}

pipeline test_pre_tag_size_gate_exhausts_only_typed_transient_view_retries(task: any) {
  const config = pre_tag_binary_size_gate_config("main", SHA, "release/v1.2.3", SHA)
  let dispatches = 0
  let views = 0
  let waits = []
  const result = run_pre_tag_size_gate(
    config,
    {
      dispatch: fn(_config) {
        dispatches = dispatches + 1
        return {
          accepted: true,
          run_id: 11,
          url: "https://github.test/run/11",
          event: config.event,
          head_branch: config.policy_ref,
          head_sha: config.expected_policy_sha,
        }
      },
      view_run: fn(_run_id) {
        views = views + 1
        return Err({code: "network", message: "temporary GitHub API failure"})
      },
      wait: fn(delay_ms) { waits = waits + [delay_ms] },
    },
  )
  assert_eq(result.success, false)
  assert_eq(result.phase, "inspect")
  assert_eq(dispatches, 1)
  assert_eq(views, config.transient_view_retry_max_attempts)
  assert_eq(result.view_attempts, config.transient_view_retry_max_attempts)
  assert_eq(result.transient_view_retries, config.transient_view_retry_max_attempts - 1)
  assert_eq(waits, [config.transient_view_retry_base_ms, config.transient_view_retry_base_ms * 2])
  assert(contains(result.message, "after 2 transient status-read retries"))
}

