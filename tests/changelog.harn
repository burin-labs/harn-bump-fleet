import {
  changelog_fold_unreleased_into_existing_release,
  changelog_latest_version_section_from_text,
  changelog_named_section_from_text,
  changelog_release_section_body,
  changelog_release_section_update,
  changelog_top_from_text,
} from "../lib/changelog"

pipeline test_changelog(task) {
  let existing = "# Changelog\n\n## Unreleased\n\n- Pending item.\n\n## v0.7.52\n\n- Old item.\n"
  assert_eq(changelog_top_from_text(existing), "0.7.52")
  assert_eq(changelog_named_section_from_text(existing, "## Unreleased"), "- Pending item.")
  assert_eq(changelog_latest_version_section_from_text(existing), "- Old item.")
  let draft = "## v0.7.53\n\n- New release note."
  let promoted = changelog_release_section_update(existing, "0.7.53", draft)
  assert_eq(promoted.success, true)
  assert_eq(promoted.changed, true)
  assert_eq(changelog_top_from_text(promoted.text), "0.7.53")
  assert_eq(contains(promoted.text, "## Unreleased"), false)
  assert_eq(contains(promoted.text, "- Old item."), true)
  let refreshed = changelog_release_section_update(promoted.text, "0.7.53", "## v0.7.53\n\n- Better note.")
  assert_eq(refreshed.success, true)
  assert_eq(refreshed.changed, false)
  assert_eq(contains(refreshed.text, "- Better note."), false)
  assert_eq(contains(refreshed.text, "- New release note."), true)
  let prepared_existing = "# Changelog\n\n## Unreleased\n\n### Added\n\n- Pending tool middleware note.\n\n## v0.8.0\n\n### Added\n\n- Existing v0.8.0 note.\n\n### Changed\n\n- Existing change.\n\n## v0.7.62\n\n- Old item.\n"
  let prepared_refreshed = changelog_release_section_update(prepared_existing, "0.8.0", "## v0.8.0\n\n- Final v0.8.0 note.")
  assert_eq(prepared_refreshed.success, true)
  assert_eq(contains(prepared_refreshed.text, "## Unreleased"), false)
  assert_eq(contains(prepared_refreshed.text, "- Pending tool middleware note."), true)
  assert_eq(contains(prepared_refreshed.text, "- Existing v0.8.0 note."), true)
  assert_eq(contains(prepared_refreshed.text, "- Existing change."), true)
  assert_eq(contains(prepared_refreshed.text, "- Final v0.8.0 note."), false)
  assert_eq(len(regex_captures("(?m)^## v0[.]8[.]0$", prepared_refreshed.text)), 1)
  assert_eq(contains(prepared_refreshed.text, "- Old item."), true)
  let rejected = changelog_release_section_update(existing, "0.7.53", "## v0.7.54\n\n- Wrong version.")
  assert_eq(rejected.success, false)
  // changelog_release_section_body returns the body under `## vX.Y.Z`.
  let release_with_subsections = "# Changelog\n\n## v0.8.5\n\n### Changed\n\n- Shipped item.\n\n## v0.8.4\n\n- Old.\n"
  assert_eq(
    changelog_release_section_body(release_with_subsections, "0.8.5"),
    "### Changed\n\n- Shipped item.",
  )
  assert_eq(changelog_release_section_body(release_with_subsections, "0.8.6"), "")
  // Post-publish fixup: tag v0.8.5 already shipped; main has drifted with
  // new ## Unreleased entries; fold them into the originally-shipped v0.8.5
  // body without re-authoring the section.
  let main_post_drift = "# Changelog\n\n## Unreleased\n\n### Changed\n\n- Late-landing CHANGELOG note.\n\n## v0.8.4\n\n- Old.\n"
  let shipped_body = "### Changed\n\n- Originally-shipped item."
  let folded = changelog_fold_unreleased_into_existing_release(main_post_drift, "0.8.5", shipped_body)
  assert_eq(folded.success, true)
  assert_eq(folded.changed, true)
  assert_eq(contains(folded.text, "## Unreleased"), false)
  assert_eq(contains(folded.text, "- Late-landing CHANGELOG note."), true)
  assert_eq(contains(folded.text, "- Originally-shipped item."), true)
  assert_eq(contains(folded.text, "- Old."), true)
  assert_eq(len(regex_captures("(?m)^## v0[.]8[.]5$", folded.text)), 1)
  // Idempotent rerun: no new Unreleased, just inject the shipped body.
  let main_no_unreleased = "# Changelog\n\n## v0.8.4\n\n- Old.\n"
  let folded_idempotent = changelog_fold_unreleased_into_existing_release(main_no_unreleased, "0.8.5", shipped_body)
  assert_eq(folded_idempotent.success, true)
  assert_eq(folded_idempotent.changed, true)
  assert_eq(contains(folded_idempotent.text, "- Originally-shipped item."), true)
  assert_eq(len(regex_captures("(?m)^## v0[.]8[.]5$", folded_idempotent.text)), 1)
  let folded_twice = changelog_fold_unreleased_into_existing_release(folded_idempotent.text, "0.8.5", shipped_body)
  assert_eq(folded_twice.success, true)
  assert_eq(folded_twice.changed, false)
  // Empty existing body is rejected.
  let rejected_fixup = changelog_fold_unreleased_into_existing_release(main_post_drift, "0.8.5", "")
  assert_eq(rejected_fixup.success, false)
}
