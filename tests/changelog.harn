import {
  changelog_latest_version_section_from_text,
  changelog_named_section_from_text,
  changelog_release_section_update,
  changelog_top_from_text,
} from "../lib/changelog"

pipeline test_changelog(task) {
  let existing = "# Changelog\n\n## Unreleased\n\n- Pending item.\n\n## v0.7.52\n\n- Old item.\n"
  assert_eq(changelog_top_from_text(existing), "0.7.52")
  assert_eq(changelog_named_section_from_text(existing, "## Unreleased"), "- Pending item.")
  assert_eq(changelog_latest_version_section_from_text(existing), "- Old item.")
  let draft = "## v0.7.53\n\n- New release note."
  let promoted = changelog_release_section_update(existing, "0.7.53", draft)
  assert_eq(promoted.success, true)
  assert_eq(promoted.changed, true)
  assert_eq(changelog_top_from_text(promoted.text), "0.7.53")
  assert_eq(contains(promoted.text, "## Unreleased"), false)
  assert_eq(contains(promoted.text, "- Old item."), true)
  let refreshed = changelog_release_section_update(promoted.text, "0.7.53", "## v0.7.53\n\n- Better note.")
  assert_eq(refreshed.success, true)
  assert_eq(contains(refreshed.text, "- Better note."), true)
  assert_eq(contains(refreshed.text, "- New release note."), false)
  let rejected = changelog_release_section_update(existing, "0.7.53", "## v0.7.54\n\n- Wrong version.")
  assert_eq(rejected.success, false)
}
