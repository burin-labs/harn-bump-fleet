import {
  assemble_fragments_section,
  changelog_archive_below_version,
  changelog_bullet_count,
  changelog_fixup_release_body,
  changelog_latest_version_section_from_text,
  changelog_merge_fragments_into_unreleased,
  changelog_named_section_from_text,
  changelog_promote_pin_time_unreleased,
  changelog_release_section_body,
  changelog_release_section_update,
  changelog_release_section_valid,
  changelog_repair_post_merge_drift,
  changelog_replace_top_section,
  changelog_top_from_text,
  fragment_category_heading,
  fragment_category_order,
  parse_fragment_filename,
} from "../lib/changelog"

pipeline test_changelog(task) {
  let existing = "# Changelog\n\n## Unreleased\n\n- Pending item.\n\n## v0.7.52\n\n- Old item.\n"
  assert_eq(changelog_top_from_text(existing), "0.7.52")
  assert_eq(changelog_named_section_from_text(existing, "## Unreleased"), "- Pending item.")
  assert_eq(changelog_latest_version_section_from_text(existing), "- Old item.")
  // Authored Unreleased is the source of truth — the agent draft does NOT
  // overwrite it. The promoted section preserves the operator's bullets
  // verbatim under the new `## v0.7.53` heading; the draft is ignored.
  let draft = "## v0.7.53\n\n- New release note."
  let promoted = changelog_release_section_update(existing, "0.7.53", draft)
  assert_eq(promoted.success, true)
  assert_eq(promoted.changed, true)
  assert_eq(changelog_top_from_text(promoted.text), "0.7.53")
  assert_eq(contains(promoted.text, "## Unreleased"), false)
  assert_eq(contains(promoted.text, "- Pending item."), true)
  assert_eq(contains(promoted.text, "- New release note."), false)
  assert_eq(contains(promoted.text, "- Old item."), true)
  let refreshed = changelog_release_section_update(promoted.text, "0.7.53", "## v0.7.53\n\n- Better note.")
  assert_eq(refreshed.success, true)
  assert_eq(refreshed.changed, false)
  assert_eq(contains(refreshed.text, "- Better note."), false)
  assert_eq(contains(refreshed.text, "- Pending item."), true)
  // Empty Unreleased: the agent draft IS the source of post-tag content
  // and gets inserted above the previous version heading.
  let no_unreleased_entries = "# Changelog\n\n## Unreleased\n\n## v0.7.52\n\n- Old item.\n"
  let from_draft = changelog_release_section_update(no_unreleased_entries, "0.7.53", "## v0.7.53\n\n- Drafted note.")
  assert_eq(from_draft.success, true)
  assert_eq(from_draft.changed, true)
  assert_eq(contains(from_draft.text, "- Drafted note."), true)
  assert_eq(contains(from_draft.text, "## Unreleased"), false)
  let prepared_existing = "# Changelog\n\n## Unreleased\n\n### Added\n\n- Pending tool middleware note.\n\n## v0.8.0\n\n### Added\n\n- Existing v0.8.0 note.\n\n### Changed\n\n- Existing change.\n\n## v0.7.62\n\n- Old item.\n"
  let prepared_refreshed = changelog_release_section_update(prepared_existing, "0.8.0", "## v0.8.0\n\n- Final v0.8.0 note.")
  assert_eq(prepared_refreshed.success, true)
  assert_eq(contains(prepared_refreshed.text, "## Unreleased"), false)
  assert_eq(contains(prepared_refreshed.text, "- Pending tool middleware note."), true)
  assert_eq(contains(prepared_refreshed.text, "- Existing v0.8.0 note."), true)
  assert_eq(contains(prepared_refreshed.text, "- Existing change."), true)
  assert_eq(contains(prepared_refreshed.text, "- Final v0.8.0 note."), false)
  assert_eq(len(regex_captures("(?m)^## v0[.]8[.]0$", prepared_refreshed.text)), 1)
  assert_eq(contains(prepared_refreshed.text, "- Old item."), true)
  // Wrong-version draft is rejected when there is no authored Unreleased
  // to fall back on. (When Unreleased is non-empty, the rename path
  // ignores the draft entirely, so version mismatch is moot.)
  let rejected = changelog_release_section_update(no_unreleased_entries, "0.7.53", "## v0.7.54\n\n- Wrong version.")
  assert_eq(rejected.success, false)
  // Truncated draft still rejected on the empty-Unreleased path so token
  // truncation in the agent's finalize turn cannot ship a half-written
  // section to CHANGELOG.md.
  let truncated = changelog_release_section_update(
    no_unreleased_entries,
    "0.7.53",
    "## v0.7.53\n\n- Note.\n\n<assistant prose truncated by turn policy: max_tokens reached>",
  )
  assert_eq(truncated.success, false)
  // changelog_release_section_body returns the body under `## vX.Y.Z`.
  let release_with_subsections = "# Changelog\n\n## v0.8.5\n\n### Changed\n\n- Shipped item.\n\n## v0.8.4\n\n- Old.\n"
  assert_eq(
    changelog_release_section_body(release_with_subsections, "0.8.5"),
    "### Changed\n\n- Shipped item.",
  )
  assert_eq(changelog_release_section_body(release_with_subsections, "0.8.6"), "")
  // changelog_promote_pin_time_unreleased: review-pr fix path.
  // Case 1: current Unreleased == pin-time Unreleased (no post-pin drift).
  // Subtraction succeeds; Unreleased ends up empty.
  let pin_unreleased = "### Added\n\n- A.\n- B.\n- C."
  let main_at_pin = "# Changelog\n\n## Unreleased\n\n### Added\n\n- A.\n- B.\n- C.\n\n## v0.8.5\n\n- Old.\n"
  let promoted_clean = changelog_promote_pin_time_unreleased(main_at_pin, "0.8.6", pin_unreleased)
  assert_eq(promoted_clean.success, true)
  assert_eq(promoted_clean.changed, true)
  assert_eq(promoted_clean.subtract_path, "direct")
  assert_eq(contains(promoted_clean.text, "## v0.8.6"), true)
  assert_eq(contains(promoted_clean.text, "- A."), true)
  // No leftover Unreleased section (subtraction emptied it).
  assert_eq(contains(promoted_clean.text, "## Unreleased"), false)
  // Older sections preserved.
  assert_eq(contains(promoted_clean.text, "- Old."), true)
  // Case 2: post-pin drift — another session appended to Unreleased.
  // Subtraction strips pin-time bullets, leaving the new bullet behind.
  let main_with_drift = "# Changelog\n\n## Unreleased\n\n### Added\n\n- A.\n- B.\n- C.\n- D (post-pin).\n\n## v0.8.5\n\n- Old.\n"
  let promoted_drift = changelog_promote_pin_time_unreleased(main_with_drift, "0.8.6", pin_unreleased)
  assert_eq(promoted_drift.success, true)
  assert_eq(promoted_drift.changed, true)
  assert_eq(promoted_drift.subtract_path, "direct")
  // Drift bullet survives in Unreleased.
  assert_eq(contains(promoted_drift.text, "## Unreleased"), true)
  assert_eq(contains(promoted_drift.text, "- D (post-pin)."), true)
  // v0.8.6 has the pin-time content.
  assert_eq(contains(promoted_drift.text, "## v0.8.6"), true)
  // Case 3: another session prepended a bullet ABOVE the pin-time content
  // in `### Added`. The full pin-time body is no longer a contiguous
  // substring, but the bullet block under the leading subheading still
  // is — the bullets-only fallback should catch it and leave only the
  // prepended bullet behind in Unreleased.
  let main_with_prepend = "# Changelog\n\n## Unreleased\n\n### Added\n\n- New (prepended by another session).\n- A.\n- B.\n- C.\n\n## v0.8.5\n\n- Old.\n"
  let promoted_prepend = changelog_promote_pin_time_unreleased(main_with_prepend, "0.8.6", pin_unreleased)
  assert_eq(promoted_prepend.success, true)
  assert_eq(promoted_prepend.changed, true)
  assert_eq(promoted_prepend.subtract_path, "bullets-only")
  // The prepended bullet survives in Unreleased.
  assert_eq(contains(promoted_prepend.text, "## Unreleased"), true)
  assert_eq(contains(promoted_prepend.text, "- New (prepended by another session)."), true)
  // Pin-time bullets land in v0.8.6.
  assert_eq(contains(promoted_prepend.text, "## v0.8.6"), true)
  // Pin-time bullets do NOT remain in `## Unreleased` (no duplicates).
  let unreleased_after_prepend = changelog_named_section_from_text(promoted_prepend.text, "## Unreleased")
  assert_eq(contains(unreleased_after_prepend, "- A."), false)
  assert_eq(contains(unreleased_after_prepend, "- B."), false)
  assert_eq(contains(unreleased_after_prepend, "- C."), false)
  // Case 4: current Unreleased was edited (not append-only and not a clean
  // prepend) — fall back to preserve-everything; operator dedupes manually.
  let main_with_edit = "# Changelog\n\n## Unreleased\n\n### Added\n\n- A (edited).\n- B.\n- C.\n\n## v0.8.5\n\n- Old.\n"
  let promoted_edit = changelog_promote_pin_time_unreleased(main_with_edit, "0.8.6", pin_unreleased)
  assert_eq(promoted_edit.success, true)
  assert_eq(promoted_edit.changed, true)
  assert_eq(promoted_edit.subtract_path, "fallback")
  // Both Unreleased and v0.8.6 are present (duplicate-ish) since safe subtract failed.
  assert_eq(contains(promoted_edit.text, "## Unreleased"), true)
  assert_eq(contains(promoted_edit.text, "- A (edited)."), true)
  assert_eq(contains(promoted_edit.text, "## v0.8.6"), true)
  // Case 5: idempotent — rerunning over an already-promoted CHANGELOG returns unchanged.
  let promoted_twice = changelog_promote_pin_time_unreleased(promoted_clean.text, "0.8.6", pin_unreleased)
  assert_eq(promoted_twice.success, true)
  assert_eq(promoted_twice.changed, false)
  // Case 6: empty pin-time body rejected.
  let rejected_promote = changelog_promote_pin_time_unreleased(main_at_pin, "0.8.6", "")
  assert_eq(rejected_promote.success, false)
  // Case 7: fixup cherry-pick scenario. The release_harn fixup path
  // cherry-picks the existing release branch's prepare commits onto
  // fresh `<base>`, then `git checkout HEAD -- CHANGELOG.md` resets
  // CHANGELOG.md so smart-subtract is authoritative. This case mirrors
  // that intermediate state: CHANGELOG.md is exactly fresh-`<base>`
  // (drift Unreleased preserved verbatim, no `## v$ver` heading yet),
  // and the pin-time body comes from `git show <pin>:CHANGELOG.md`
  // recovered during fixup detection.
  let realistic_pin_unreleased = "### Added\n\n- **Cherry-picked fixup path.** Replace `release_ship.sh --prepare` rerun with cherry-pick of the existing prepare commits."
  let realistic_fresh_base = "# Changelog\n\n## Unreleased\n\n### Added\n\n- **Cherry-picked fixup path.** Replace `release_ship.sh --prepare` rerun with cherry-pick of the existing prepare commits.\n- **Post-pin drift bullet.** Landed on main between pin and fixup; belongs in the NEXT release.\n\n## v0.8.5\n\n- Earlier shipped release.\n"
  let cherry_pick_result = changelog_promote_pin_time_unreleased(realistic_fresh_base, "0.8.6", realistic_pin_unreleased)
  assert_eq(cherry_pick_result.success, true)
  assert_eq(cherry_pick_result.changed, true)
  assert_eq(cherry_pick_result.subtract_path, "direct")
  // v0.8.6 owns the pin-time bullet (the actual shipped artifact's notes).
  assert_eq(contains(cherry_pick_result.text, "## v0.8.6"), true)
  assert_eq(contains(cherry_pick_result.text, "- **Cherry-picked fixup path.**"), true)
  // Drift bullet stays in Unreleased — it describes work landing AFTER
  // the published artifact, never the one that already shipped.
  assert_eq(contains(cherry_pick_result.text, "## Unreleased"), true)
  assert_eq(contains(cherry_pick_result.text, "- **Post-pin drift bullet.**"), true)
  // Older sections are untouched.
  assert_eq(contains(cherry_pick_result.text, "- Earlier shipped release."), true)
  // The pin-time bullet appears exactly once — under v0.8.6, not duplicated in Unreleased.
  let pin_bullet_occurrences = len(regex_captures("Cherry-picked fixup path", cherry_pick_result.text))
  assert_eq(pin_bullet_occurrences, 1)
  // changelog_bullet_count: counts top-level `-` bullets and skips
  // `### Subsection` headings and continuation lines.
  assert_eq(changelog_bullet_count("### Added\n\n- A.\n- B.\n  continuation\n- C."), 3)
  assert_eq(changelog_bullet_count(""), 0)
}

pipeline test_changelog_fixup_release_body(task) {
  let pin_with_unreleased = "# Changelog\n\n## Unreleased\n\n### Added\n\n- Pin-time note.\n\n## v0.8.5\n\n- Old.\n"
  let prepared_release = "# Changelog\n\n## v0.8.6\n\n### Added\n\n- Prepared release note.\n\n## v0.8.5\n\n- Old.\n"
  let from_pin = changelog_fixup_release_body(pin_with_unreleased, prepared_release, "0.8.6")
  assert_eq(from_pin.success, true)
  assert_eq(from_pin.source, "pin-unreleased")
  assert_eq(contains(from_pin.body, "Pin-time note"), true)
  assert_eq(contains(from_pin.body, "Prepared release note"), false)
  let fragment_pin = "# Changelog\n\n## v0.8.5\n\n- Old.\n"
  let from_prepared = changelog_fixup_release_body(fragment_pin, prepared_release, "0.8.6")
  assert_eq(from_prepared.success, true)
  assert_eq(from_prepared.source, "release-section")
  assert_eq(contains(from_prepared.body, "Prepared release note"), true)
  let missing = changelog_fixup_release_body(fragment_pin, "# Changelog\n\n## v0.8.5\n\n- Old.\n", "0.8.6")
  assert_eq(missing.success, false)
}

pipeline test_post_merge_paperwork_repair(task) {
  // Setup: a CHANGELOG where v0.9.0 absorbed a drift bullet at merge time.
  // pin-time `## Unreleased` had only the pin bullet; main's `## v0.9.0` now
  // contains pin bullet AND a drift bullet that should belong in Unreleased.
  let pin_body = "### Added\n\n- Pin bullet that shipped in v0.9.0."
  // Drift bullet was inserted ABOVE the pin bullet by GitHub's 3-way merge,
  // so the pin baseline is no longer a contiguous substring (the bullets-only
  // subtract path covers this — same behavior as the existing promote path).
  let drifted = "# Changelog\n\n## v0.9.0\n\n### Added\n\n- Drift bullet not in shipped binary.\n- Pin bullet that shipped in v0.9.0.\n\n## v0.8.5\n\n- Older note.\n"
  let repair = changelog_repair_post_merge_drift(drifted, "0.9.0", pin_body)
  assert_eq(repair.success, true)
  assert_eq(repair.changed, true)
  assert_eq(repair.subtract_path, "bullets-only")
  // `## Unreleased` is now created, with the drift bullet inside it.
  let new_unreleased = changelog_named_section_from_text(repair.text, "## Unreleased")
  assert_eq(contains(new_unreleased, "Drift bullet not in shipped binary"), true)
  assert_eq(contains(new_unreleased, "Pin bullet that shipped"), false)
  // `## v0.9.0` body matches pin-time exactly.
  let new_v090 = changelog_release_section_body(repair.text, "0.9.0")
  assert_eq(trim(new_v090), pin_body)
  // Idempotency: re-running over the repaired text is a no-op.
  let again = changelog_repair_post_merge_drift(repair.text, "0.9.0", pin_body)
  assert_eq(again.success, true)
  assert_eq(again.changed, false)
}

pipeline test_post_merge_paperwork_repair_existing_unreleased(task) {
  // Setup: drift section AND a non-empty `## Unreleased` already exists
  // (the operator added new bullets after the drifted release shipped).
  // The repair must MERGE drift bullets into the existing Unreleased
  // without losing the operator's bullets.
  let pin_body = "### Added\n\n- Pin bullet."
  let drifted = "# Changelog\n\n## Unreleased\n\n### Added\n\n- Operator's new bullet for next release.\n\n## v0.9.0\n\n### Added\n\n- Drift bullet.\n- Pin bullet.\n\n## v0.8.5\n\n- Older note.\n"
  let repair = changelog_repair_post_merge_drift(drifted, "0.9.0", pin_body)
  assert_eq(repair.success, true)
  assert_eq(repair.changed, true)
  let new_unreleased = changelog_named_section_from_text(repair.text, "## Unreleased")
  assert_eq(contains(new_unreleased, "Drift bullet"), true)
  assert_eq(contains(new_unreleased, "Operator's new bullet for next release"), true)
  // v0.9.0 body matches pin-time exactly (Operator's bullet stays in Unreleased).
  let new_v090 = changelog_release_section_body(repair.text, "0.9.0")
  assert_eq(trim(new_v090), pin_body)
  assert_eq(contains(new_v090, "Operator's new bullet"), false)
}

pipeline test_post_merge_paperwork_repair_no_drift(task) {
  // Setup: v0.9.0's body already matches the pin-time Unreleased.
  // No drift to repair — idempotent no-op.
  let pin_body = "### Added\n\n- Only bullet."
  let clean = "# Changelog\n\n## v0.9.0\n\n### Added\n\n- Only bullet.\n\n## v0.8.5\n\n- Older.\n"
  let repair = changelog_repair_post_merge_drift(clean, "0.9.0", pin_body)
  assert_eq(repair.success, true)
  assert_eq(repair.changed, false)
}

pipeline test_post_merge_paperwork_repair_unsafe_edit(task) {
  // Setup: the published section was edited (a pin bullet was renamed),
  // not just appended-to. Smart subtract cannot safely identify drift.
  let pin_body = "### Added\n\n- Pin bullet original wording."
  let edited = "# Changelog\n\n## v0.9.0\n\n### Added\n\n- Pin bullet edited wording.\n- Drift bullet.\n\n## v0.8.5\n\n- Older.\n"
  let repair = changelog_repair_post_merge_drift(edited, "0.9.0", pin_body)
  assert_eq(repair.success, false)
  assert_eq(contains(repair.message, "could not safely subtract"), true)
}

pipeline test_post_merge_paperwork_repair_missing_version(task) {
  // Defensive: the requested `## v$version` heading doesn't exist.
  let clean = "# Changelog\n\n## v0.8.5\n\n- Older.\n"
  let repair = changelog_repair_post_merge_drift(clean, "0.9.0", "### Added\n\n- Pin bullet.")
  assert_eq(repair.success, false)
  assert_eq(contains(repair.message, "v0.9.0"), true)
}

pipeline test_parse_fragment_filename(task) {
  // Known categories return parsed {id, category}.
  let added = parse_fragment_filename("2492.added.md")
  assert_eq(added.id, "2492")
  assert_eq(added.category, "added")
  let breaking = parse_fragment_filename("issue-2310.breaking.md")
  assert_eq(breaking.id, "issue-2310")
  assert_eq(breaking.category, "breaking")
  // Unknown category → nil (not a fragment).
  assert_eq(parse_fragment_filename("2492.misc.md"), nil)
  // Non-md files → nil.
  assert_eq(parse_fragment_filename("README.md.bak"), nil)
  assert_eq(parse_fragment_filename(".gitkeep"), nil)
  // README-like names (no two-segment id.category) → nil.
  assert_eq(parse_fragment_filename("README.md"), nil)
  // Every canonical category resolves.
  for category in fragment_category_order() {
    assert_eq(fragment_category_heading(category) != nil, true)
    let probe = parse_fragment_filename("42." + category + ".md")
    assert_eq(probe.category, category)
  }
}

pipeline test_assemble_fragments_section_empty(task) {
  assert_eq(assemble_fragments_section([]), "")
  assert_eq(assemble_fragments_section([{id: "1", category: "added", body: ""}]), "")
  assert_eq(assemble_fragments_section([{id: "1", category: "added", body: "   \n"}]), "")
}

pipeline test_assemble_fragments_section_single_category(task) {
  let fragments = [
    {id: "10", category: "added", body: "- Second bullet."},
    {id: "5", category: "added", body: "- First bullet by id sort."},
  ]
  let out = assemble_fragments_section(fragments)
  assert_eq(out, "### Added\n\n- First bullet by id sort.\n- Second bullet.")
}

pipeline test_assemble_fragments_section_normalizes_plain_text_body(task) {
  let fragments = [
    {
      id: "3730",
      category: "added",
      body: "`harn provider tool-probe` accepts `--repeat` for live provider reliability checks.",
    },
    {
      id: "stream-tool-arg-split",
      category: "fixed",
      body: "Split concatenated streamed OpenAI-compatible tool-call argument objects into separate\n"
        + "tool calls instead of surfacing a parse error.",
    },
  ]
  let out = assemble_fragments_section(fragments)
  assert_eq(
    out,
    "### Added\n\n"
      + "- `harn provider tool-probe` accepts `--repeat` for live provider reliability checks.\n\n"
      + "### Fixed\n\n"
      + "- Split concatenated streamed OpenAI-compatible tool-call argument objects into separate\n"
      + "  tool calls instead of surfacing a parse error.",
  )
}

pipeline test_assemble_fragments_section_canonical_order(task) {
  // Categories must come out in fragment_category_order regardless of input order.
  let fragments = [
    {id: "1", category: "fixed", body: "- A fix."},
    {id: "2", category: "breaking", body: "- A break."},
    {id: "3", category: "added", body: "- An add."},
    {id: "4", category: "security", body: "- A patch."},
  ]
  let out = assemble_fragments_section(fragments)
  let break_idx = out.index_of("### Breaking")
  let added_idx = out.index_of("### Added")
  let fixed_idx = out.index_of("### Fixed")
  let security_idx = out.index_of("### Security")
  assert_eq(break_idx < added_idx, true)
  assert_eq(added_idx < fixed_idx, true)
  assert_eq(fixed_idx < security_idx, true)
}

pipeline test_assemble_fragments_section_non_numeric_id_stable(task) {
  // Non-numeric ids land at the end of their category, in insertion order.
  let fragments = [
    {id: "abc", category: "added", body: "- Alpha id bullet."},
    {id: "100", category: "added", body: "- Numeric id bullet."},
  ]
  let out = assemble_fragments_section(fragments)
  let numeric_idx = out.index_of("Numeric id bullet")
  let alpha_idx = out.index_of("Alpha id bullet")
  assert_eq(numeric_idx < alpha_idx, true)
}

pipeline test_changelog_merge_fragments_into_unreleased_basic(task) {
  let existing = "# Changelog\n\n## Unreleased\n\n### Added\n\n- Operator-authored.\n\n## v0.8.45\n\n- Old.\n"
  let assembled = "### Added\n\n- Fragment bullet.\n\n### Fixed\n\n- Fragment fix."
  let merged = changelog_merge_fragments_into_unreleased(existing, assembled)
  assert_eq(merged.success, true)
  assert_eq(merged.changed, true)
  // Operator bullet preserved.
  assert_eq(contains(merged.text, "- Operator-authored."), true)
  // Fragment bullets folded in.
  assert_eq(contains(merged.text, "- Fragment bullet."), true)
  assert_eq(contains(merged.text, "- Fragment fix."), true)
  // Added subsection coalesces (only one `### Added` under Unreleased).
  let unreleased = changelog_named_section_from_text(merged.text, "## Unreleased")
  let added_occurrences = len(regex_captures("(?m)^### Added$", unreleased))
  assert_eq(added_occurrences, 1)
  // v0.8.45 untouched.
  assert_eq(contains(merged.text, "- Old."), true)
}

pipeline test_changelog_merge_fragments_no_existing_unreleased(task) {
  let existing = "# Changelog\n\n## v0.8.45\n\n- Old.\n"
  let assembled = "### Added\n\n- Fresh fragment."
  let merged = changelog_merge_fragments_into_unreleased(existing, assembled)
  assert_eq(merged.success, true)
  assert_eq(merged.changed, true)
  assert_eq(contains(merged.text, "## Unreleased"), true)
  assert_eq(contains(merged.text, "- Fresh fragment."), true)
  // Unreleased sits above v0.8.45.
  let unreleased_idx = merged.text.index_of("## Unreleased")
  let version_idx = merged.text.index_of("## v0.8.45")
  assert_eq(unreleased_idx < version_idx, true)
}

pipeline test_changelog_merge_fragments_empty_input(task) {
  let existing = "# Changelog\n\n## Unreleased\n\n- Existing.\n\n## v0.8.45\n\n- Old.\n"
  let merged = changelog_merge_fragments_into_unreleased(existing, "")
  assert_eq(merged.success, true)
  assert_eq(merged.changed, false)
  // Text unchanged.
  assert_eq(merged.text, existing)
}

pipeline test_changelog_archive_below_version_basic(task) {
  let text = "# Changelog\n\nIntro paragraph.\n\n## Unreleased\n\n- Pending.\n\n## v0.9.1\n\n- Latest.\n\n## v0.9.0\n\n- First v0.9.\n\n## v0.8.45\n\n- Old patch.\n\n## v0.8.44\n\n- Older patch.\n\n## v0.7.0\n\n- Oldest.\n"
  let result = changelog_archive_below_version(text, "0.9")
  assert_eq(result.success, true)
  assert_eq(result.changed, true)
  assert_eq(result.count, 3)
  assert_eq(result.suggested_archive_filename, "CHANGELOG-pre-0.9.md")
  // Kept retains intro, Unreleased, v0.9.* sections.
  assert_eq(contains(result.kept, "Intro paragraph."), true)
  assert_eq(contains(result.kept, "## Unreleased"), true)
  assert_eq(contains(result.kept, "## v0.9.1"), true)
  assert_eq(contains(result.kept, "## v0.9.0"), true)
  assert_eq(contains(result.kept, "## v0.8.45"), false)
  assert_eq(contains(result.kept, "## v0.7.0"), false)
  // Archived gets the moved sections in their original order.
  assert_eq(contains(result.archived, "## v0.8.45"), true)
  assert_eq(contains(result.archived, "## v0.8.44"), true)
  assert_eq(contains(result.archived, "## v0.7.0"), true)
  assert_eq(contains(result.archived, "## v0.9.0"), false)
  let v845_idx = result.archived.index_of("## v0.8.45")
  let v70_idx = result.archived.index_of("## v0.7.0")
  assert_eq(v845_idx < v70_idx, true)
}

pipeline test_changelog_archive_below_version_no_match(task) {
  // Threshold below the oldest version → nothing to archive.
  let text = "# Changelog\n\n## Unreleased\n\n- Pending.\n\n## v0.9.0\n\n- Only.\n"
  let result = changelog_archive_below_version(text, "0.9")
  assert_eq(result.success, true)
  assert_eq(result.changed, false)
  assert_eq(result.count, 0)
  assert_eq(result.kept, text)
  assert_eq(result.archived, "")
}

pipeline test_changelog_archive_below_version_malformed_threshold(task) {
  let text = "# Changelog\n\n## v0.9.0\n\n- Only.\n"
  let result = changelog_archive_below_version(text, "garbage")
  assert_eq(result.success, false)
  assert_eq(contains(result.message, "MAJOR.MINOR"), true)
}

pipeline test_changelog_release_section_valid(task) {
  let fragments = [
    {id: "10", category: "added", body: "- Added a widget."},
    {id: "11", category: "fixed", body: "- Fixed a crash."},
  ]
  // Valid: correct heading, bullets, every fragment represented.
  let good = "# Changelog\n\n## v1.2.3\n\n### Added\n\n- Added a widget.\n\n### Fixed\n\n- Fixed a crash.\n"
  let ok_gate = changelog_release_section_valid(good, "1.2.3", fragments)
  assert_eq(ok_gate.valid, true)
  assert_eq(len(ok_gate.findings), 0)
  // Wrong heading version -> invalid.
  let wrong = "# Changelog\n\n## v1.2.2\n\n- Added a widget.\n- Fixed a crash.\n"
  assert_eq(changelog_release_section_valid(wrong, "1.2.3", fragments).valid, false)
  // Still `## Unreleased` (unfolded) -> invalid.
  let unfolded = "# Changelog\n\n## Unreleased\n\n- Added a widget.\n"
  assert_eq(changelog_release_section_valid(unfolded, "1.2.3", fragments).valid, false)
  // Heading present but empty section (no bullets) -> invalid.
  let empty = "# Changelog\n\n## v1.2.3\n\n## v1.2.2\n\n- Old.\n"
  let empty_gate = changelog_release_section_valid(empty, "1.2.3", [])
  assert_eq(empty_gate.valid, false)
  // A dropped fragment (fixed bullet missing) -> invalid, names the fragment.
  let lossy = "# Changelog\n\n## v1.2.3\n\n### Added\n\n- Added a widget.\n"
  let lossy_gate = changelog_release_section_valid(lossy, "1.2.3", fragments)
  assert_eq(lossy_gate.valid, false)
  assert_eq(contains(join(lossy_gate.findings, " "), "11"), true)
}

pipeline test_changelog_fold_recovery_flow(task) {
  // Mirror the deterministic fold pipeline in apply_draft_release_notes: plant
  // fragments, fold them, and assert the gate now passes; before folding the
  // gate flags the unfolded state.
  let fragments = [
    {id: "20", category: "added", body: "- New public API."},
    {id: "21", category: "fixed", body: "- Fixed a panic."},
  ]
  let section = assemble_fragments_section(fragments)
  let original = "# Changelog\n\n## Unreleased\n\n## v1.2.2\n\n- Old.\n"
  // Pre-fold: no valid `## v1.2.3` section yet.
  assert_eq(changelog_release_section_valid(original, "1.2.3", fragments).valid, false)
  // Deterministic fold: merge fragments into Unreleased, then rename to v1.2.3.
  let merged = changelog_merge_fragments_into_unreleased(original, section)
  assert_eq(merged.success, true)
  let update = changelog_release_section_update(merged.text, "1.2.3", "")
  assert_eq(update.success, true)
  let gate = changelog_release_section_valid(update.text, "1.2.3", fragments)
  assert_eq(gate.valid, true)
  assert_eq(changelog_top_from_text(update.text), "1.2.3")
  // Both fragment bullets survived the fold.
  assert_eq(contains(update.text, "- New public API."), true)
  assert_eq(contains(update.text, "- Fixed a panic."), true)
}

pipeline test_changelog_replace_top_section(task) {
  let text = "# Changelog\n\n## Unreleased\n\n- broken half-written\n\n## v1.0.0\n\n- Old.\n"
  let fixed = changelog_replace_top_section(text, "## v1.2.3\n\n### Added\n\n- Real bullet.")
  // Top section replaced, lower sections and preamble preserved.
  assert_eq(changelog_top_from_text(fixed), "1.2.3")
  assert_eq(contains(fixed, "- Real bullet."), true)
  assert_eq(contains(fixed, "## v1.0.0"), true)
  assert_eq(contains(fixed, "- Old."), true)
  assert_eq(contains(fixed, "broken half-written"), false)
  assert_eq(starts_with(fixed, "# Changelog"), true)
}
