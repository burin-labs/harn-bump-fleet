import { ReleaseAgentReviewResult } from "../lib/release_agent"
import { ReleaseAnalysis } from "../lib/release_analysis"
import { pre_release_pr_body_text, release_recovery_note_report } from "../lib/release_reporting"
import { ReleaseNotesScope } from "../lib/release_runtime"

fn analysis(changelog_top: string, changelog_section: string) -> ReleaseAnalysis {
  const notes_scope: ReleaseNotesScope = "candidate_tree"
  return {
    repo: "/tmp/harn",
    mode: "ship-pr",
    bump: "patch",
    model: "mock",
    provider: "mock",
    mock: true,
    operator_focus: "",
    branch: "main",
    expected_branch: "release/v1.2.3",
    base_branch: "main",
    pin_sha: "0123456789abcdef0123456789abcdef01234567",
    pin_sha_input: "",
    source_snapshot: {
      kind: "mock",
      requested_sha: "",
      resolved_sha: "0123456789abcdef0123456789abcdef01234567",
      analysis_head: "0123456789abcdef0123456789abcdef01234567",
      analysis_root: "/tmp/harn",
      source_repo: "/tmp/harn",
    },
    fixup_mode: false,
    release_notes_scope: notes_scope,
    fixup_tag: "",
    fixup_pr_url: "",
    fixup_publication: nil,
    current_version: "1.2.2",
    next_version: "1.2.3",
    prepared_release: false,
    latest_tag: "v1.2.2",
    changelog_top: changelog_top,
    dirty_files: 0,
    status: "",
    diff_stat: "",
    diff_names: "CHANGELOG.md",
    commits_since_latest_tag: "abc1234 change",
    commit_file_changes_since_latest_tag: "M CHANGELOG.md",
    commit_stats_since_latest_tag: "1 file changed",
    post_tag_pr_numbers: [42],
    post_tag_pr_details: "PR #42",
    recent_merged_prs: "[]",
    changelog_section: changelog_section,
    changelog_unreleased_section: "",
    release_scripts: {release_ship: true, release_gate: true},
    workflows: {publish_release: true, build_release_binaries: true},
    release_scope_findings: [],
    deterministic_findings: [],
  }
}

fn agent_review() -> ReleaseAgentReviewResult {
  return {
    text: "audit",
    attempts: [],
    validation_findings: [],
    draft_changelog: nil,
    artifacts: {},
    evidence_complete: true,
  }
}

pipeline test_recovery_note_reporting_is_owned_by_typed_scope(task: any) {
  const base = {
    version: "1.2.3",
    base: "main",
    artifact_bullet_count: 4,
    artifact_source: "attempt-release-section",
    current_unreleased_bullet_count: 2,
  }
  assert_eq(
    release_recovery_note_report(base + {scope: "immutable_checkpoint"}),
    {
      artifact_line: "v1.2.3: 4 checkpoint release-note entries from attempt-release-section",
      notes_line:
        "the immutable pre-tag candidate is reused byte-for-byte; current notes and fragments are not folded",
      plan:
        "re-verify the signed commit, immutable ref, certified parent, exact-SHA size gate, and cutoff; then publish the tag and create the PR without rebuilding the release commit.",
    },
  )
  assert_eq(
    release_recovery_note_report(base + {scope: "candidate_tree"}),
    {
      artifact_line: nil,
      notes_line:
        "2 current ## Unreleased entries on main; current ## Unreleased entries and tracked changelog.d fragments are folded into the fresh candidate",
      plan:
        "recreate the local release workspace on fresh main, fold its current notes into v1.2.3, version bump, publish a new immutable attempt, and refresh the PR handoff.",
    },
  )
  assert_eq(
    release_recovery_note_report(base + {scope: "frozen_artifact"}),
    {
      artifact_line: "v1.2.3: 4 recovered release-note entries from attempt-release-section",
      notes_line:
        "2 current ## Unreleased entries on main; post-pin bullets stay in ## Unreleased for the next release",
      plan:
        "recreate the local release workspace on fresh main, preserve the frozen artifact notes in v1.2.3, version bump, and refresh the PR handoff without moving the tag.",
    },
  )
}

pipeline test_pre_release_pr_body_does_not_present_previous_release_as_next(
  harness: Harness,
  task: any,
) {
  const body = pre_release_pr_body_text(
    harness.fs,
    analysis("1.2.2", "PREVIOUS_RELEASE_SENTINEL"),
    agent_review(),
    "preview-run",
  )
  assert_eq(contains(body, "Changelog pending prepare"), true)
  assert_eq(contains(body, "PREVIOUS_RELEASE_SENTINEL"), false)
  assert_eq(contains(body, "prepared v1.2.3 changelog"), true)
}

pipeline test_pre_release_pr_body_shows_an_already_prepared_section(harness: Harness, task: any) {
  const body = pre_release_pr_body_text(
    harness.fs,
    analysis("1.2.3", "### Fixed\n\n- PREPARED_RELEASE_SENTINEL"),
    agent_review(),
    "preview-run",
  )
  assert_eq(contains(body, "PREPARED_RELEASE_SENTINEL"), true)
  assert_eq(contains(body, "Changelog pending prepare"), false)
}
