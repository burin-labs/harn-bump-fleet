import { RELEASE_CHECKPOINT_NAMES } from "../lib/release_checkpoint"
import {
  ReleaseCheckpointEvidence,
  checkpoint_consumer_pin_precondition,
  checkpoint_development_version_precondition,
  checkpoint_fragment_precondition,
  checkpoint_release_contract_precondition,
  checkpoint_unfolded_fragments,
  release_checkpoint_preconditions,
  release_checkpoint_unavailable,
} from "../lib/release_checkpoint"
import { release_contract_fixture } from "../testdata/release_contract_fixture"

/**
 * A tree that satisfies every checkpoint assertion.
 *
 * Each test below moves exactly one fact away from this and asserts the
 * matching precondition reds. That is the negative control: the assertion has
 * to be the thing that fails, not the fixture.
 */
fn healthy_evidence(
  overrides: {
    commit?: string,
    latest_tag?: string,
    cargo_toml?: string,
    changelog?: string,
    fragment_entries?: list<string>?,
    fragment_unread_reason?: string,
    consumer_pins?: list<{slug: string, pin: string?, evidence: string}>?,
    consumer_pins_unread_reason?: string,
  } = {},
) -> ReleaseCheckpointEvidence {
  return {
    commit: overrides.commit ?? "v1.2.3",
    base_ref: "burin-labs/harn@main",
    latest_tag: overrides.latest_tag ?? "v1.2.3",
    cargo_toml: overrides.cargo_toml ?? "[workspace.package]\nversion = \"1.2.4-dev\"\n",
    changelog: overrides.changelog ?? "# Changelog\n\n## Unreleased\n\n## v1.2.3\n\n- Shipped.\n",
    contract: release_contract_fixture(),
    fragment_entries: if "fragment_entries" in overrides {
      overrides.fragment_entries
    } else {
      [".gitkeep", "README.md", ".markdownlint-cli2.jsonc"]
    },
    fragment_unread_reason: overrides.fragment_unread_reason ?? "",
    consumer_pins: if "consumer_pins" in overrides {
      overrides.consumer_pins
    } else {
      [{slug: "burin-labs/burin-code", pin: "v1.2.3", evidence: "Cargo.toml"}]
    },
    consumer_pins_unread_reason: overrides.consumer_pins_unread_reason ?? "",
  }
}

pipeline test_a_healthy_tree_passes_every_checkpoint_assertion(task: any) {
  const checks = release_checkpoint_preconditions(healthy_evidence())
  assert_eq(len(checks), 4)
  for check in checks {
    assert_eq(check.status, "pass")
  }
}

pipeline test_the_checkpoint_names_every_assertion_it_reports(task: any) {
  let names: list<string> = []
  for check in release_checkpoint_preconditions(healthy_evidence()) {
    names = names + [check.name]
  }
  assert_eq(names, RELEASE_CHECKPOINT_NAMES)
}

pipeline test_the_released_version_left_on_the_branch_fails_the_cutover(task: any) {
  // The negative control for assertion one. The release contract's own fold
  // gate accepts this shape, so a checkpoint that delegated to it would pass a
  // branch whose post-release cutover never landed.
  const check = checkpoint_development_version_precondition(
    healthy_evidence({cargo_toml: "[workspace.package]\nversion = \"1.2.3\"\n"}),
  )
  assert_eq(check.status, "fail")
  assert_eq(contains(check.detail, "1.2.4-dev"), true)
}

pipeline test_a_skipped_development_target_fails_the_cutover(task: any) {
  const check = checkpoint_development_version_precondition(
    healthy_evidence({cargo_toml: "[workspace.package]\nversion = \"1.3.0-dev\"\n"}),
  )
  assert_eq(check.status, "fail")
}

pipeline test_an_unreadable_workspace_version_fails_rather_than_passes(task: any) {
  const check = checkpoint_development_version_precondition(
    healthy_evidence({cargo_toml: "# no workspace package here\n"}),
  )
  assert_eq(check.status, "fail")
}

pipeline test_a_repository_with_no_prior_release_owes_no_cutover(task: any) {
  const check = checkpoint_development_version_precondition(healthy_evidence({latest_tag: ""}))
  assert_eq(check.status, "pass")
}

pipeline test_an_unfolded_changelog_fails_the_release_contract(task: any) {
  // The negative control for assertion two. The tag exists and the workspace
  // moved on, but the notes were never folded, which is what a check run's
  // conclusion cannot tell you.
  const check = checkpoint_release_contract_precondition(
    healthy_evidence({changelog: "# Changelog\n\n## Unreleased\n\n## v1.2.2\n\n- Older.\n"}),
  )
  assert_eq(check.status, "fail")
  assert_eq(contains(check.detail, "CHANGELOG top"), true)
}

pipeline test_a_stray_fragment_refuses_the_tag(task: any) {
  // The negative control for assertion three, in the shape three of the last
  // nine real tags carried.
  const check = checkpoint_fragment_precondition(
    healthy_evidence(
      {commit: "v1.2.4", fragment_entries: [".gitkeep", "8060.fixed.md", "README.md"]},
    ),
  )
  assert_eq(check.status, "fail")
  assert_eq(contains(check.detail, "8060.fixed.md"), true)
  assert_eq(contains(check.detail, "v1.2.4"), true)
}

pipeline test_infrastructure_files_in_the_fragment_directory_are_not_fragments(task: any) {
  const strays = checkpoint_unfolded_fragments(
    [".gitkeep", "README.md", ".markdownlint-cli2.jsonc", "notes.md", "8060.fixed.md"],
  )
  // `notes.md` carries no category slug, so it is not a fragment either.
  assert_eq(strays, ["8060.fixed.md"])
}

pipeline test_an_unread_fragment_listing_is_not_reported_as_zero(task: any) {
  // A directory nobody could list and a directory that is clean are the two
  // answers this assertion exists to keep apart.
  const check = checkpoint_fragment_precondition(
    healthy_evidence(
      {fragment_entries: nil, fragment_unread_reason: "the listing request was refused"},
    ),
  )
  assert_eq(check.status, "unavailable")
  assert_eq(contains(check.detail, "the listing request was refused"), true)
}

pipeline test_an_absent_fragment_directory_is_a_clean_read(task: any) {
  const check = checkpoint_fragment_precondition(healthy_evidence({fragment_entries: []}))
  assert_eq(check.status, "pass")
}

pipeline test_a_consumer_whose_pin_could_not_be_read_is_named(task: any) {
  // The negative control for assertion four. Convergence used to be proven by
  // orchestrator state, so an unreadable consumer counted as a converged one.
  const check = checkpoint_consumer_pin_precondition(
    healthy_evidence(
      {
        consumer_pins: [
          {slug: "burin-labs/burin-code", pin: "v1.2.3", evidence: "Cargo.toml"},
          {slug: "burin-labs/harn-cloud", pin: nil, evidence: "contract was not hydrated"},
        ],
      },
    ),
  )
  assert_eq(check.status, "fail")
  assert_eq(contains(check.detail, "burin-labs/harn-cloud"), true)
  assert_eq(contains(check.detail, "contract was not hydrated"), true)
  assert_eq(contains(check.detail, "1 of 2"), true)
}

pipeline test_a_blank_pin_counts_as_unread_rather_than_read(task: any) {
  const check = checkpoint_consumer_pin_precondition(
    healthy_evidence(
      {consumer_pins: [{slug: "burin-labs/burin-code", pin: "   ", evidence: "Cargo.toml"}]},
    ),
  )
  assert_eq(check.status, "fail")
}

pipeline test_an_empty_consumer_set_fails_rather_than_passing_vacuously(task: any) {
  // Every pin in an empty set is known, which is exactly the reading that
  // would let a manifest resolving to nothing look like a converged fleet.
  const check = checkpoint_consumer_pin_precondition(healthy_evidence({consumer_pins: []}))
  assert_eq(check.status, "fail")
  assert_eq(contains(check.detail, "named no consumer"), true)
}

pipeline test_unread_consumer_pins_are_not_reported_as_all_known(task: any) {
  const check = checkpoint_consumer_pin_precondition(
    healthy_evidence(
      {consumer_pins: nil, consumer_pins_unread_reason: "the fleet manifest could not be read"},
    ),
  )
  assert_eq(check.status, "unavailable")
  assert_eq(contains(check.detail, "the fleet manifest could not be read"), true)
}

pipeline test_a_context_that_cannot_ask_still_names_all_four(task: any) {
  const checks = release_checkpoint_unavailable("--offline")
  assert_eq(len(checks), 4)
  let names: list<string> = []
  for check in checks {
    assert_eq(check.status, "unavailable")
    assert_eq(contains(check.detail, "--offline"), true)
    names = names + [check.name]
  }
  assert_eq(names, RELEASE_CHECKPOINT_NAMES)
}
