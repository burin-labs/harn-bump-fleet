pipeline test_github_app_token_profiles_are_closed_and_least_privilege(harness: Harness, task) {
  const root = dirname(harness.fs.cwd())
  const result = harness.process.shell(
    "node --test '" + path_join(root, "scripts", "github_app_token_profiles.test.mjs") + "'",
  )
  if !result.success {
    throw result.combined
  }
  assert(contains(result.combined, "pass 3"))
  assert(contains(result.combined, "fail 0"))
}
