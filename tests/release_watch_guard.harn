import {
  release_watch_guard_acquire,
  release_watch_guard_cleanup_warning,
  release_watch_guard_finish,
  release_watch_guard_options,
} from "../lib/release_watch_guard"
import { import_hosted_release_watch_receipt_guarded } from "../watch_harn_release.harn"

pipeline test_release_watch_guard_options_are_stable(task: any) {
  const options = release_watch_guard_options(
    {tag: "v1.2.3", receipt_path: "/tmp/watches/v1.2.3.json", domain: "release-watch-test"},
  )
  assert_eq(options.owner, "watch-harn-release.v1.2.3")
  assert_eq(options.resource_class, "whole-machine")
  assert_eq(options.domain, "release-watch-test")
  assert_eq(options.wait_timeout_ms, 0)
  assert_eq(options.metadata.tag, "v1.2.3")
  assert_eq(options.metadata.receipt_path, "/tmp/watches/v1.2.3.json")
}

@serial(group: "host-lease-store")
pipeline test_release_watch_guard_allows_one_receipt_writer(harness: Harness, task: any) {
  const domain = "release-watch-" + harness.random.uuid_v7()
  const first = release_watch_guard_acquire(
    harness.host_lease,
    {tag: "v1.2.3", receipt_path: "/tmp/first.json", domain: domain},
  )
  assert_eq(first.state, "owned")
  const refused = try {
    release_watch_guard_acquire(
      harness.host_lease,
      {tag: "v1.2.4", receipt_path: "/tmp/second.json", domain: domain},
    )
    ""
  } catch (e) {
    to_string(e)
  }
  assert(contains(refused, "another release watcher"))
  assert(contains(refused, "tag v1.2.3"))
  const finished = release_watch_guard_finish(harness.host_lease, first)
  assert_eq(finished?.released, true)
  assert_eq(finished?.error, nil)
  const second = release_watch_guard_acquire(
    harness.host_lease,
    {tag: "v1.2.4", receipt_path: "/tmp/second.json", domain: domain},
  )
  assert_eq(second.state, "owned")
  release_watch_guard_finish(harness.host_lease, second)
}

@serial(group: "host-lease-store")
pipeline test_hosted_receipt_import_refuses_before_download_when_writer_is_occupied(
  harness: Harness,
  task: any,
) {
  const domain = "release-watch-import-" + harness.random.uuid_v7()
  const fixture = harness.fs.mkdtemp_in_workspace("release-watch-import-guard-")
  const destination = path_join(fixture, "watch.json")
  const download_marker = path_join(fixture, "downloaded")
  const owner = release_watch_guard_acquire(
    harness.host_lease,
    {tag: "v1.2.3", receipt_path: path_join(fixture, "owner.json"), domain: domain},
  )
  try {
    const refused = try {
      import_hosted_release_watch_receipt_guarded(
        harness,
        {repo_root: fixture, tag: "v1.2.4", run_id: 42, destination: destination},
        false,
        domain,
        {
          download: fn(_run_id, _download_destination) {
            harness.fs.write_text(download_marker, "unexpected")
            return {success: false, message: "unexpected download"}
          },
        },
      )
      ""
    } catch (e) {
      to_string(e)
    }
    assert(contains(refused, "another release watcher"))
    assert_eq(harness.fs.exists(download_marker), false)
    assert_eq(harness.fs.exists(destination), false)
  } finally {
    release_watch_guard_finish(harness.host_lease, owner)
  }
}

pipeline test_mock_release_watch_does_not_take_live_lease(harness: Harness, task: any) {
  const lease = release_watch_guard_acquire(
    harness.host_lease,
    {
      tag: "v1.2.3",
      receipt_path: "/tmp/mock.json",
      domain: "release-watch-" + harness.random.uuid_v7(),
      mock: true,
    },
  )
  assert_eq(lease.state, "disabled")
  assert_eq(release_watch_guard_finish(harness.host_lease, lease), nil)
}

pipeline test_watch_guard_cleanup_warning_is_silent_without_an_error(task: any) {
  assert_eq(release_watch_guard_cleanup_warning(nil, true), nil)
  assert_eq(release_watch_guard_cleanup_warning("", false), nil)
  assert_eq(release_watch_guard_cleanup_warning("   ", true), nil)
}

pipeline test_watch_guard_cleanup_warning_does_not_claim_a_written_result_on_the_throwing_path(
  task: any,
) {
  const warning = release_watch_guard_cleanup_warning("host lease store unavailable", false)
  assert(warning != nil)
  assert(contains(warning ?? "", "before a durable watch result was written"))
  assert(!contains(warning ?? "", "after the durable watch result was written"))
  assert(contains(warning ?? "", "host lease store unavailable"))
}

pipeline test_watch_guard_cleanup_warning_claims_a_written_result_only_after_the_body_completes(
  task: any,
) {
  const warning = release_watch_guard_cleanup_warning("host lease store unavailable", true)
  assert(warning != nil)
  assert(contains(warning ?? "", "after the durable watch result was written"))
  assert(!contains(warning ?? "", "before a durable watch result was written"))
}
