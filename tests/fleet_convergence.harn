import { convergence_snapshot_from_rows, pin_probe_at_ref } from "../lib/fleet_convergence"
import { HarnUpdateSpec } from "../lib/fleet_manifest"

pipeline test_unread_evidence_is_separate_from_updates_that_are_not_proven() {
  const snapshot = convergence_snapshot_from_rows(
    "v1.2.3",
    [
      {repo: "example/green", state: "proven", reason: "merged"},
      {repo: "example/unread", state: "unread", reason: "census unavailable"},
      {repo: "example/red", state: "failed", reason: "CI failed"},
      {repo: "example/pending", state: "waiting", reason: "CI running"},
    ],
  )
  assert(!snapshot.complete)
  assert_eq(snapshot.total_count, 4)
  assert_eq(snapshot.unread_count, 1)
  assert_eq(snapshot.unread_repositories, ["example/unread"])
  assert_eq(snapshot.unproven_count, 2)
  assert_eq(snapshot.unproven_repositories, ["example/red", "example/pending"])
  assert_eq(snapshot.failing_count, 1)
  assert_eq(snapshot.pending_count, 1)
  const only_unread = convergence_snapshot_from_rows(
    "v1.2.3",
    [{repo: "example/unread", state: "unread", reason: "census unavailable"}],
  )
  assert(!only_unread.complete)
  assert(!only_unread.terminal)
  assert_eq(only_unread.unproven_count, 0)
  assert_eq(only_unread.unread_count, 1)
}

pipeline test_an_empty_repository_scope_is_unproven_not_converged(task: any) {
  const snapshot = convergence_snapshot_from_rows("v1.2.3", [])
  assert_eq(snapshot.complete, false)
  assert_eq(snapshot.terminal, true)
  assert_eq(snapshot.scope_proven, false)
  assert_eq(snapshot.total_count, 0)
  assert_eq(snapshot.pending_count, 0)
  assert_eq(snapshot.unproven_count, 1)
  assert_eq(snapshot.unproven_repositories, ["<empty repository scope>"])
}

fn update(pin: any) -> HarnUpdateSpec {
  return {
    repository: "burin-labs/example",
    base_branch: "main",
    workflow_path: ".github/workflows/bump-harn.yml",
    workflow_name: "bump-harn.yml",
    branch: "automation/bump-harn-runtime",
    pin: pin,
    repair_enabled: true,
    auto_arm: true,
    require_signed_head: true,
    prerequisites: [],
    max_releases_behind: 1,
    adapter: {
      repository_owned: false,
      workflow_reference:
        "owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      orchestration_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      refresh_command: "",
      finalize_refresh_command: "",
      validation_command: "",
      node_version: "",
      publish_failure_for_repair: false,
      apply_behavior_preserving_fixes: false,
      enable_auto_merge: true,
    },
  }
}

pipeline test_non_default_formula_pin_reads_the_declared_path_on_every_ref(
  harness: Harness,
  task: any,
) {
  let reads = []
  const probe = pin_probe_at_ref(
    harness.fs,
    update({kind: "formula", path: "Formula/harn.rb"}),
    "0123456789abcdef",
    { path, ref ->
      reads = reads + [path + "@" + ref]
      return if path == "Formula/harn.rb" {
        "class Harn < Formula\n  version \"0.10.116\"\nend\n"
      } else {
        nil
      }
    },
  )
  assert_eq(probe.pin, "0.10.116")
  assert_eq(reads, ["Formula/harn.rb@0123456789abcdef"])
}

pipeline test_missing_declared_pin_never_falls_through_to_a_default_surface(
  harness: Harness,
  task: any,
) {
  let reads = []
  const probe = pin_probe_at_ref(
    harness.fs,
    update({kind: "formula", path: "Formula/harn.rb"}),
    "main",
    { path, ref ->
      reads = reads + [path + "@" + ref]
      return if path == ".harn-version" {
        "v9.9.9\n"
      } else {
        nil
      }
    },
  )
  assert_eq(probe.pin, nil)
  assert(contains(probe.evidence, "Formula/harn.rb"))
  assert_eq(reads, ["Formula/harn.rb@main"])
}
