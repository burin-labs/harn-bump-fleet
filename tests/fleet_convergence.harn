import { merged_update_pull_request_query, pin_probe_at_ref } from "../lib/fleet_convergence"
import { HarnUpdateSpec } from "../lib/fleet_manifest"

pipeline test_merged_update_proof_accepts_any_exact_green_adoption_branch(task: any) {
  const query = merged_update_pull_request_query()
  assert_eq(query, {base: "main", state: "closed", limit: 20})
  assert_eq(query.head, nil)
}

fn update(pin: any) -> HarnUpdateSpec {
  return {
    repository: "burin-labs/example",
    base_branch: "main",
    workflow_path: ".github/workflows/bump-harn.yml",
    workflow_name: "bump-harn.yml",
    branch: "automation/bump-harn-runtime",
    pin: pin,
    repair_enabled: true,
    auto_arm: true,
    require_signed_head: true,
    prerequisites: [],
    max_releases_behind: 1,
    adapter: {
      workflow_reference:
        "owner/harn/.github/workflows/bump-harn.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      orchestration_sha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      refresh_command: "",
      validation_command: "",
      node_version: "",
      publish_failure_for_repair: false,
      apply_behavior_preserving_fixes: false,
      enable_auto_merge: true,
    },
  }
}

pipeline test_non_default_formula_pin_reads_the_declared_path_on_every_ref(
  harness: Harness,
  task: any,
) {
  let reads = []
  const probe = pin_probe_at_ref(
    harness.fs,
    update({kind: "formula", path: "Formula/harn.rb"}),
    "0123456789abcdef",
    { path, ref ->
      reads = reads + [path + "@" + ref]
      return if path == "Formula/harn.rb" {
        "class Harn < Formula\n  version \"0.10.116\"\nend\n"
      } else {
        nil
      }
    },
  )
  assert_eq(probe.pin, "0.10.116")
  assert_eq(reads, ["Formula/harn.rb@0123456789abcdef"])
}

pipeline test_missing_declared_pin_never_falls_through_to_a_default_surface(
  harness: Harness,
  task: any,
) {
  let reads = []
  const probe = pin_probe_at_ref(
    harness.fs,
    update({kind: "formula", path: "Formula/harn.rb"}),
    "main",
    { path, ref ->
      reads = reads + [path + "@" + ref]
      return if path == ".harn-version" {
        "v9.9.9\n"
      } else {
        nil
      }
    },
  )
  assert_eq(probe.pin, nil)
  assert(contains(probe.evidence, "Formula/harn.rb"))
  assert_eq(reads, ["Formula/harn.rb@main"])
}
