import { merged_update_pull_request_query } from "../lib/fleet_convergence"

pipeline test_merged_update_proof_accepts_any_exact_green_adoption_branch(task) {
  const query = merged_update_pull_request_query()
  assert_eq(query, {base: "main", state: "closed", limit: 20})
  assert_eq(query.head, nil)
}
