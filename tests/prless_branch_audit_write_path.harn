import {
  BranchAuditIssueReconciliation,
  BranchAuditOptions,
  reconcile_branch_audit_issue,
} from "../check_prless_branches.harn"
import {
  PRLESS_BRANCH_LABEL,
  RepositoryBranchAudit,
  prless_branch_issue_marker,
} from "../lib/prless_branch_audit"
import { GithubClientOptions } from "harn-github-connector/default"

const BASE = "https://github.test"

const SLUG = "octo-org/octo-repo"

const ISSUES = BASE + "/repos/octo-org/octo-repo/issues"

const LABEL = BASE + "/repos/octo-org/octo-repo/labels/fleet%2Fprless-branch-audit"

const OID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

type IssueCreateBody = {title: string, body: string, labels: list<string>, ...rest}

type IssueUpdateBody = {state?: string, title?: string, body?: string, ...rest}

fn options() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "branch-audit-write-test-token"}
}

fn plan(dry_run: bool = false) -> BranchAuditOptions {
  return {only: nil, dry_run: dry_run, run_url: nil, fail_on_findings: false}
}

fn finding() -> RepositoryBranchAudit {
  return {
    slug: SLUG,
    default_branch: "main",
    state: "findings",
    branch_count: 2,
    open_pr_head_count: 0,
    prless_branch_count: 1,
    prless_branches: [{name: "feature/one", head_oid: OID, protected: false}],
    prless_findings: [
      {
        name: "feature/one",
        head_oid: OID,
        protected: false,
        disposition: "unmerged",
        disposition_detail: "the tip is not reachable from main",
      },
    ],
    merged_branch_count: 0,
    unmerged_branch_count: 1,
    undetermined_branch_count: 0,
    detail: "one finding",
  }
}

fn clean() -> RepositoryBranchAudit {
  return {
    slug: SLUG,
    default_branch: "main",
    state: "clean",
    branch_count: 1,
    open_pr_head_count: 0,
    prless_branch_count: 0,
    prless_branches: [],
    prless_findings: [],
    merged_branch_count: 0,
    unmerged_branch_count: 0,
    undetermined_branch_count: 0,
    detail: "clean",
  }
}

fn failed() -> RepositoryBranchAudit {
  return {
    slug: SLUG,
    default_branch: "main",
    state: "measurement_failed",
    branch_count: nil,
    open_pr_head_count: nil,
    prless_branch_count: nil,
    prless_branches: [],
    prless_findings: [],
    merged_branch_count: nil,
    unmerged_branch_count: nil,
    undetermined_branch_count: nil,
    error_code: "empty_branch_read",
    detail: "empty_branch_read: GitHub returned zero branches",
  }
}

fn existing() -> dict {
  return {
    number: 42,
    title: "older title",
    body: prless_branch_issue_marker(SLUG) + "\n\nolder body",
    state: "open",
  }
}

fn mock_open_issues(testing: HarnessTesting, rows: list<dict>) {
  testing.http_mock(
    "GET",
    LABEL,
    {status: 200, body: json_stringify({name: PRLESS_BRANCH_LABEL, color: "B60205"})},
  )
  testing.http_mock(
    "GET",
    ISSUES + "?labels=${PRLESS_BRANCH_LABEL}&page=1&per_page=100&state=all",
    {status: 200, body: json_stringify(rows)},
  )
}

fn mock_missing_label(testing: HarnessTesting) {
  testing.http_mock("GET", LABEL, {status: 404, body: json_stringify({message: "Not Found"})})
}

fn reconcile(
  harness: Harness,
  row: RepositoryBranchAudit,
  dry_run: bool = false,
) -> BranchAuditIssueReconciliation {
  return reconcile_branch_audit_issue(harness, row, plan(dry_run), options())
}

pipeline test_a_finding_opens_one_marker_owned_issue(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [])
  harness.testing.http_mock("POST", ISSUES, {status: 201, body: json_stringify({number: 7})})
  const result = reconcile(harness, finding())
  assert(result.ok, result.detail)
  assert_eq(result.action, "opened")
  const post =
    harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()[0]
  const body = schema_expect(json_parse(post.body), IssueCreateBody)
  assert_eq(body.labels, [PRLESS_BRANCH_LABEL])
  assert(contains(body.body, prless_branch_issue_marker(SLUG)))
}

pipeline test_a_missing_identity_label_is_created_before_the_issue(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_missing_label(harness.testing)
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/labels",
    {status: 201, body: json_stringify({name: PRLESS_BRANCH_LABEL, color: "B60205"})},
  )
  harness.testing.http_mock(
    "GET",
    ISSUES + "?labels=${PRLESS_BRANCH_LABEL}&page=1&per_page=100&state=all",
    {status: 200, body: json_stringify([])},
  )
  harness.testing.http_mock("POST", ISSUES, {status: 201, body: json_stringify({number: 7})})
  const result = reconcile(harness, finding())
  assert(result.ok, result.detail)
  const posts =
    harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()
  assert_eq(len(posts), 2)
  assert(ends_with(posts[0].url, "/labels"), "the lookup key is established before issue creation")
  assert(
    ends_with(posts[1].url, "/issues"),
    "the issue is created only after its lookup key exists",
  )
}

pipeline test_dry_run_does_not_create_a_missing_identity_label(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_missing_label(harness.testing)
  harness.testing.http_mock(
    "GET",
    ISSUES + "?labels=${PRLESS_BRANCH_LABEL}&page=1&per_page=100&state=all",
    {status: 200, body: json_stringify([])},
  )
  const result = reconcile(harness, finding(), true)
  assert(result.ok, result.detail)
  assert_eq(result.action, "would_open")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method != "GET" }).to_list()),
    0,
  )
}

pipeline test_an_existing_issue_is_refreshed_not_duplicated(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [existing()])
  harness.testing.http_mock(
    "PATCH",
    ISSUES + "/42",
    {status: 200, body: json_stringify({number: 42})},
  )
  const result = reconcile(harness, finding())
  assert(result.ok, result.detail)
  assert_eq(result.action, "refreshed")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()),
    0,
  )
}

pipeline test_a_closed_issue_is_reopened_instead_of_replaced(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [existing() + {state: "closed"}])
  harness.testing.http_mock(
    "PATCH",
    ISSUES + "/42",
    {status: 200, body: json_stringify({number: 42})},
  )
  const result = reconcile(harness, finding())
  assert(result.ok, result.detail)
  assert_eq(result.action, "refreshed")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()),
    0,
    "the stable issue number is reused after recovery",
  )
  const patch = harness.testing.http_mock_calls().filter({ call -> call.method == "PATCH" })
    .to_list()[0]
  assert_eq(schema_expect(json_parse(patch.body), IssueUpdateBody).state, "open")
}

pipeline test_a_clean_repository_closes_its_existing_issue(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [existing()])
  harness.testing.http_mock(
    "PATCH",
    ISSUES + "/42",
    {status: 200, body: json_stringify({number: 42})},
  )
  const result = reconcile(harness, clean())
  assert(result.ok, result.detail)
  assert_eq(result.action, "closed")
  const patch = harness.testing.http_mock_calls().filter({ call -> call.method == "PATCH" })
    .to_list()[0]
  assert_eq(schema_expect(json_parse(patch.body), IssueUpdateBody).state, "closed")
}

pipeline test_a_measurement_failure_is_durable_not_silent(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [])
  harness.testing.http_mock("POST", ISSUES, {status: 201, body: json_stringify({number: 8})})
  const result = reconcile(harness, failed())
  assert(result.ok, result.detail)
  assert_eq(result.action, "opened")
  const post =
    harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()[0]
  const body = schema_expect(json_parse(post.body), IssueCreateBody)
  assert(contains(body.title, "could not measure"))
  assert(contains(body.body, "refusing to report inbox zero"))
}

pipeline test_a_failed_issue_read_does_not_open_a_duplicate(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    ISSUES + "?labels=${PRLESS_BRANCH_LABEL}&page=1&per_page=100&state=all",
    {status: 500, body: json_stringify({message: "server error"})},
  )
  const result = reconcile(harness, finding())
  assert_eq(result.ok, false)
  assert_eq(result.action, "probe_failed")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "POST" }).to_list()),
    0,
  )
}

pipeline test_duplicate_marker_issues_fail_instead_of_picking_one(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [existing(), existing() + {number: 43}])
  const result = reconcile(harness, finding())
  assert_eq(result.ok, false)
  assert_eq(result.action, "duplicate_issue")
}

pipeline test_dry_run_makes_no_write(harness: Harness) {
  harness.testing.http_mock_clear()
  mock_open_issues(harness.testing, [])
  const result = reconcile(harness, finding(), true)
  assert_eq(result.action, "would_open")
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method != "GET" }).to_list()),
    0,
  )
}
