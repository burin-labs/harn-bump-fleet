import { fleet_summary_context, release_chat_context } from "../lib/context_projection"
import { FleetAuditReceipt, ReleaseAuditReceipt } from "../lib/run_receipts"

fn fleet_payload(outcomes: any, summary_text: any = "") -> FleetAuditReceipt {
  return {
    schema_version: "harn_bump_fleet.audit.v1",
    run_id: "run-1",
    started_iso: "2026-08-02T00:00:00Z",
    finished_iso: "2026-08-02T00:01:00Z",
    duration_ms: 60000,
    operator: "operator",
    host: "host",
    target_version: "v0.10.52",
    mode: "live",
    repos_total: len(outcomes),
    repos_dispatched: len(outcomes),
    summary_model: "model",
    summary_text: summary_text,
    summary: {model_authored_text: summary_text},
    outcomes: outcomes,
    run_session_view: {ok: true, check: {status: "pass"}, target_change: {status: "none"}},
    public_surface_impact: {source_status: "pass", surface_count: 1, affected_repo_count: 0},
    trace_spans: [],
    timing_summary: {},
  }
}

fn outcome(index: int) {
  return {
    slug: "owner/repo-${index}",
    status: "run_success",
    detail: "detail-${index} " + "outcome detail ".repeat(80),
    pr_url: "https://github.com/owner/repo/pull/${index}",
    run_url: "https://github.com/owner/repo/actions/runs/${index}",
    auto_merge: "enabled",
    duration_ms: index * 1000,
  }
}

pipeline test_fleet_context_is_bounded_and_excludes_recursive_summary(task: any) {
  let outcomes = []
  for index in range(0, 81) {
    outcomes = outcomes + [outcome(index)]
  }
  const recursive = "PRIOR_MODEL_TRANSCRIPT "
    + json_stringify({audit: fleet_payload(outcomes), prior: json_stringify(outcomes)})
  const context = fleet_summary_context(fleet_payload(outcomes, recursive))
  const rendered = json_stringify(context)
  assert(len(rendered) <= 12000)
  assert_eq(context.schema_version, "harn_bump_fleet.model_context.v1")
  assert_eq(context.outcomes_truncated, true)
  assert_eq(context.summary_text, nil)
  assert_eq(contains(rendered, "PRIOR_MODEL_TRANSCRIPT"), false)
  assert_eq(len(context.source_digest), 24)
}

pipeline test_release_chat_context_keeps_only_bounded_evidence(task: any) {
  const payload: ReleaseAuditReceipt = {
    schema_version: "release_harn.audit.v1",
    run_id: "release-1",
    started_iso: "2026-08-02T00:00:00Z",
    finished_iso: "2026-08-02T00:01:00Z",
    duration_ms: 60000,
    operator: "operator",
    host: "host",
    config: {mode: "ship-pr"},
    analysis: {
      current_version: "0.10.51",
      next_version: "0.10.52",
      branch: "release/v0.10.52",
      changelog_top: "",
      deterministic_findings: ["finding " + "x".repeat(1000)],
    },
    agent_review: "agent-result transcript ".repeat(1000),
    agent_review_detail: {validation_findings: []},
    execution: [],
    cleanup: nil,
    trace_spans: [],
    timing_summary: {},
  }
  const context = release_chat_context(payload)
  assert(len(json_stringify(context)) <= 12000)
  assert_eq(contains(json_stringify(context), "agent-result transcript"), false)
  assert_eq(len(context.source_digest), 24)
}
