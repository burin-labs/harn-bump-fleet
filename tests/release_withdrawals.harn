import { parse_release_withdrawals, release_withdrawal_binding } from "../lib/release_withdrawals"

const TAG_COMMIT = "d55201f77f196de7c311d69d6d9fee122ab620fe"

fn registry(overrides: dict? = nil) -> string {
  return json_stringify(
    {
      schema_version: 1,
      releases: [
        {
          version: "0.10.51",
          tag_commit: TAG_COMMIT,
          distribution_version: "0.10.50",
          replacement: "0.10.52",
          reason: "invalid_tagged_candidate",
        }
          + (overrides ?? {}),
      ],
    },
  )
}

fn assert_rejected(body) {
  let rejected = false
  try {
    body()
  } catch (_) {
    rejected = true
  }
  require rejected, "expected invalid withdrawal registry to be rejected"
}

pipeline test_release_withdrawal_binds_only_the_exact_tag(_task) {
  const parsed = parse_release_withdrawals(registry())
  assert_eq(parsed.count, 1)
  assert_eq(parsed[0]?.replacement, "0.10.52")
  assert_eq(release_withdrawal_binding(registry(), "0.10.50", TAG_COMMIT), nil)
  assert_eq(
    release_withdrawal_binding(registry(), "0.10.51", TAG_COMMIT)?.distribution_version,
    "0.10.50",
  )
  assert_rejected(
    { ->
      release_withdrawal_binding(registry(), "0.10.51", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    },
  )
}

pipeline test_release_withdrawal_contract_rejects_malformed_or_open_data(_task) {
  assert_rejected({ -> parse_release_withdrawals("[]") })
  assert_rejected(
    { -> parse_release_withdrawals(json_stringify({schema_version: 2, releases: []})) },
  )
  assert_rejected({ -> parse_release_withdrawals(registry({extra: true})) })
  assert_rejected({ -> parse_release_withdrawals(registry({reason: "transient_failure"})) })
  assert_rejected({ -> parse_release_withdrawals(registry({replacement: "0.10.53"})) })
  assert_rejected({ -> parse_release_withdrawals(registry({distribution_version: "0.10.51"})) })
}
