import {
  CONSUMER_PROJECTION_MANIFEST_PATH,
  consumer_projection_repositories,
  parse_consumer_projection_manifest,
  resolve_consumer_projection_manifests,
} from "../lib/consumer_projection_manifest"
import { FleetManifest, FleetRepository } from "../lib/fleet_manifest"

fn thrown(callback: closure) -> string {
  return try {
    callback()
    ""
  } catch (error) {
    to_string(error)
  }
}

fn fleet() -> FleetManifest {
  return {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow:
        "owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      bump_workflow:
        "owner/policy/.github/workflows/bump.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    repositories: [
      {slug: "owner/source", directory: "source"},
      {slug: "owner/consumer", directory: "consumer", file_projection_consumer: true},
    ],
  }
}

fn consumer(manifest: FleetManifest) -> FleetRepository {
  return schema_expect(
    manifest.repositories.find({ repo -> repo.slug == "owner/consumer" }),
    FleetRepository,
  )
}

const VALID: string = """
schema_version = 1

[[file_projections]]
source_slug = "owner/source"
source_path = "index.toml"
target_path = "generated/index.toml"
"""

pipeline test_consumer_owns_only_the_destination_half_of_a_projection() {
  const manifest = fleet()
  const projections = parse_consumer_projection_manifest(manifest, consumer(manifest), VALID)
  assert_eq(
    projections,
    [
      {
        source_slug: "owner/source",
        source_path: "index.toml",
        target_slug: "owner/consumer",
        target_path: "generated/index.toml",
      },
    ],
  )
  assert_eq(
    consumer_projection_repositories(manifest).map({ repo -> repo.slug }).to_list(),
    ["owner/consumer"],
  )
  assert_eq(CONSUMER_PROJECTION_MANIFEST_PATH, ".harn/fleet-projections.toml")
}

pipeline test_missing_manifest_is_an_explicit_failure_not_an_empty_success() {
  const resolution = resolve_consumer_projection_manifests(fleet(), {})
  assert_eq(resolution.projections, [])
  assert_eq(len(resolution.errors), 1)
  assert(contains(resolution.errors[0] ?? "", "manifest is missing"))
}

pipeline test_consumer_manifest_rejects_undeclared_sources_and_unsafe_or_duplicate_targets() {
  const manifest = fleet()
  const target = consumer(manifest)
  const undeclared = replace(VALID, "owner/source", "owner/private")
  assert(
    contains(
      thrown({ -> parse_consumer_projection_manifest(manifest, target, undeclared) }),
      "not declared",
    ),
  )
  const unsafe = replace(VALID, "generated/index.toml", "../private/index.toml")
  assert(
    contains(
      thrown({ -> parse_consumer_projection_manifest(manifest, target, unsafe) }),
      "invalid",
    ),
  )
  const duplicate = VALID
    + """

[[file_projections]]
source_slug = "owner/source"
source_path = "other.toml"
target_path = "generated/index.toml"
"""
  assert(
    contains(
      thrown({ -> parse_consumer_projection_manifest(manifest, target, duplicate) }),
      "repeats target",
    ),
  )
}

pipeline test_manifest_schema_rejects_unknown_or_wrong_version_fields() {
  const manifest = fleet()
  const target = consumer(manifest)
  assert(
    contains(
      thrown(
        { ->
          parse_consumer_projection_manifest(
            manifest,
            target,
            replace(VALID, "schema_version = 1", "schema_version = 2"),
          )
        },
      ),
      "schema",
    ),
  )
  const unknown_field = thrown(
    { -> parse_consumer_projection_manifest(manifest, target, VALID + "unknown = true\n") },
  )
  assert(trim(unknown_field) != "", "unknown projection field was accepted")
}
