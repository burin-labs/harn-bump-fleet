import {
  CONSUMER_PROJECTION_MANIFEST_PATH,
  consumer_projection_repositories,
  parse_consumer_contract_manifest,
  read_remote_consumer_projection_manifests,
  resolve_consumer_projection_manifests,
} from "../lib/consumer_projection_manifest"
import { FleetManifest, FleetRepository } from "../lib/fleet_manifest"
import { GithubClientOptions } from "harn-github-connector/default"

fn thrown(callback: closure) -> string {
  return try {
    callback()
    ""
  } catch (error) {
    to_string(error)
  }
}

fn fleet() -> FleetManifest {
  return {
    schema_version: 1,
    fleet: {default_root: "~/projects", default_branch: "main"},
    policy: {
      package_workflow:
        "owner/policy/.github/workflows/package.yml@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      bump_workflow:
        "owner/policy/.github/workflows/bump.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    repositories: [
      {slug: "owner/source", directory: "source"},
      {slug: "owner/consumer", directory: "consumer", consumer_owned_contract: true},
    ],
  }
}

fn consumer(manifest: FleetManifest) -> FleetRepository {
  return schema_expect(
    manifest.repositories.find({ repo -> repo.slug == "owner/consumer" }),
    FleetRepository,
  )
}

const VALID: string = """
schema_version = 1

[harn_pin]
kind = "version_file"
path = "runtime-version.txt"

[bump]
refresh_command = "./scripts/refresh-runtime"
validate_command = "./scripts/validate-runtime"
node_version = "22"
allowed_new_files = ["generated/runtime.json"]

[[file_projections]]
source_slug = "owner/source"
source_path = "index.toml"
target_path = "generated/index.toml"
"""

const API: string = "https://consumer-contract.test"

const CONTRACT_SHA: string = "cccccccccccccccccccccccccccccccccccccccc"

fn github_options() -> GithubClientOptions {
  return {api_base_url: API, installation_token: "consumer-contract-test-token"}
}

pipeline test_consumer_owns_only_the_destination_half_of_a_projection() {
  const manifest = fleet()
  const parsed = parse_consumer_contract_manifest(manifest, consumer(manifest), VALID)
  const projections = parsed.projections
  assert_eq(
    projections,
    [
      {
        source_slug: "owner/source",
        source_path: "index.toml",
        target_slug: "owner/consumer",
        target_path: "generated/index.toml",
      },
    ],
  )
  assert_eq(
    consumer_projection_repositories(manifest).map({ repo -> repo.slug }).to_list(),
    ["owner/consumer"],
  )
  assert_eq(CONSUMER_PROJECTION_MANIFEST_PATH, ".harn/fleet-projections.toml")
  assert_eq(parsed.repository.harn_pin_kind, "version_file")
  assert_eq(parsed.repository.harn_pin_path, "runtime-version.txt")
  assert_eq(parsed.repository.bump_refresh_command, "./scripts/refresh-runtime")
  assert_eq(parsed.repository.bump_validate_command, "./scripts/validate-runtime")
  assert_eq(parsed.repository.bump_allowed_new_files, ["generated/runtime.json"])
}

pipeline test_missing_manifest_is_an_explicit_failure_not_an_empty_success() {
  const resolution = resolve_consumer_projection_manifests(fleet(), {})
  assert_eq(resolution.projections, [])
  assert_eq(resolution.contract_refs, {})
  assert_eq(resolution.contract_sha256, {})
  assert_eq(len(resolution.errors), 1)
  assert(contains(resolution.errors[0] ?? "", "manifest is missing"))
}

pipeline test_remote_contract_is_read_once_at_its_immutable_branch_head(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    API + "/repos/owner/consumer/branches/main",
    {status: 200, body: json_stringify({name: "main", commit: {sha: CONTRACT_SHA}})},
  )
  harness.testing.http_mock(
    "GET",
    API
      + "/repos/owner/consumer/contents/"
      + CONSUMER_PROJECTION_MANIFEST_PATH
      + "?ref="
      + CONTRACT_SHA,
    {
      status: 200,
      body: json_stringify(
        {
          name: "fleet-projections.toml",
          path: CONSUMER_PROJECTION_MANIFEST_PATH,
          sha: "dddddddddddddddddddddddddddddddddddddddd",
          size: len(VALID),
          type: "file",
          encoding: "base64",
          content: base64_encode(VALID),
        },
      ),
    },
  )
  const resolved = read_remote_consumer_projection_manifests(
    harness,
    fleet(),
    "main",
    consumer_projection_repositories(fleet()),
    github_options(),
  )
  assert_eq(resolved.errors, [])
  assert_eq(resolved.contract_refs, {"owner/consumer": CONTRACT_SHA})
  assert_eq(resolved.contract_sha256, {"owner/consumer": sha256(VALID)})
  assert_eq(resolved.repositories[0]?.consumer_contract_sha256, sha256(VALID))
  const calls = harness.testing.http_mock_calls()
  assert_eq(len(calls), 2)
  assert(contains(calls[1]?.url ?? "", "?ref=" + CONTRACT_SHA))
  assert_eq(contains(calls[1]?.url ?? "", "?ref=main"), false)
}

pipeline test_consumer_manifest_rejects_undeclared_sources_and_unsafe_or_duplicate_targets() {
  const manifest = fleet()
  const target = consumer(manifest)
  const undeclared = replace(VALID, "owner/source", "owner/private")
  assert(
    contains(
      thrown({ -> parse_consumer_contract_manifest(manifest, target, undeclared) }),
      "not declared",
    ),
  )
  const unsafe = replace(VALID, "generated/index.toml", "../private/index.toml")
  assert(
    contains(thrown({ -> parse_consumer_contract_manifest(manifest, target, unsafe) }), "invalid"),
  )
  const duplicate = VALID
    + """

[[file_projections]]
source_slug = "owner/source"
source_path = "other.toml"
target_path = "generated/index.toml"
"""
  assert(
    contains(
      thrown({ -> parse_consumer_contract_manifest(manifest, target, duplicate) }),
      "repeats target",
    ),
  )
}

pipeline test_manifest_schema_rejects_unknown_or_wrong_version_fields() {
  const manifest = fleet()
  const target = consumer(manifest)
  assert(
    contains(
      thrown(
        { ->
          parse_consumer_contract_manifest(
            manifest,
            target,
            replace(VALID, "schema_version = 1", "schema_version = 2"),
          )
        },
      ),
      "schema",
    ),
  )
  const unknown_field = thrown(
    { -> parse_consumer_contract_manifest(manifest, target, VALID + "unknown = true\n") },
  )
  assert(trim(unknown_field) != "", "unknown projection field was accepted")
}
