import { plan_fleet_dispatch } from "../lib/fleet_dispatch"
import { read_fleet_manifest } from "../lib/fleet_manifest"

fn thrown(callback) -> string {
  return try {
    callback()
    ""
  } catch (error) {
    to_string(error)
  }
}

pipeline test_full_fleet_dispatch_is_the_default(harness: Harness, task) {
  const plan = plan_fleet_dispatch(read_fleet_manifest(harness.fs, "../fleet.toml"), "v0.10.92", "")
  assert_eq(plan.scope, {kind: "full_fleet"})
  assert_eq(plan.workflow_inputs, {version: "v0.10.92"})
}

pipeline test_repository_dispatch_uses_one_manifest_owned_scope(harness: Harness, task) {
  const plan = plan_fleet_dispatch(
    read_fleet_manifest(harness.fs, "../fleet.toml"),
    "v0.10.92",
    "burin-labs/harn-cloud",
  )
  assert_eq(plan.scope, {kind: "repository", repository: "burin-labs/harn-cloud"})
  assert_eq(plan.workflow_inputs, {version: "v0.10.92", only: "burin-labs/harn-cloud"})
}

pipeline test_release_run_identity_is_projected_into_the_fleet_chain(harness: Harness, task) {
  const plan = plan_fleet_dispatch(
    read_fleet_manifest(harness.fs, "../fleet.toml"),
    "v0.10.92",
    "",
    "31900000001",
  )
  assert_eq(plan.workflow_inputs, {version: "v0.10.92", chain_id: "31900000001"})
  assert(
    thrown(
      { ->
        plan_fleet_dispatch(read_fleet_manifest(harness.fs, "../fleet.toml"), "v0.10.92", "", "bad")
      },
    ),
  )
}

pipeline test_unknown_repository_and_invalid_release_fail_before_dispatch(harness: Harness, task) {
  const manifest = read_fleet_manifest(harness.fs, "../fleet.toml")
  assert(thrown({ -> plan_fleet_dispatch(manifest, "v0.10.92", "burin-labs/not-managed") }))
  assert(thrown({ -> plan_fleet_dispatch(manifest, "0.10.92", "") }))
  assert(thrown({ -> plan_fleet_dispatch(manifest, "v0.10.92-rc.1", "") }))
}
