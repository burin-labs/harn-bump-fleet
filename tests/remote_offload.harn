import {
  audit_offload_decision,
  coordination_hw_post_command,
  offload_probe_command,
  release_audit_offload_enabled,
  release_publish_dryrun_offload_enabled,
  remote_audit_context,
  remote_audit_disk_command,
  remote_audit_log_path,
  remote_audit_log_path_from_output,
  remote_audit_prereq_command,
  remote_audit_resource_command,
  remote_audit_setup_and_run_command,
  remote_audit_skip_decision,
  remote_publish_dryrun_command,
  resolve_offload_host,
  resolve_offload_hosts,
  resolve_remote_audit_min_free_gb,
} from "../lib/remote_offload"

pipeline test_audit_offload_decision(task) {
  // Disabled: always local, even with a reachable host.
  let disabled = audit_offload_decision({enabled: false, host: "tornadough", probe_ok: true})
  assert_eq(disabled.target, "local")
  assert_eq(contains(disabled.reason, "disabled"), true)
  // Enabled but no host configured: local.
  assert_eq(audit_offload_decision({enabled: true, host: "", probe_ok: true}).target, "local")
  // THE fail-open case: enabled + reachable name but probe failed (host down):
  // fall back to local with no regression.
  let unreachable = audit_offload_decision({enabled: true, host: "tornadough", probe_ok: false})
  assert_eq(unreachable.target, "local")
  assert_eq(contains(unreachable.reason, "unreachable"), true)
  // Enabled + reachable: offload to the remote.
  let remote = audit_offload_decision({enabled: true, host: "tornadough", probe_ok: true})
  assert_eq(remote.target, "remote")
  assert_eq(contains(remote.reason, "offloading"), true)
}

pipeline test_remote_audit_skip_decision(task) {
  // Only a clean setup + exit-0 audit earns a local-audit skip.
  let green = remote_audit_skip_decision({setup_ok: true, audit_status: 0, host: "tornadough"})
  assert_eq(green.skip_local_audit, true)
  assert_eq(green.abort_release, false)
  // Red remote audit: keep the local audit as the backstop (not an abort).
  let red = remote_audit_skip_decision({setup_ok: true, audit_status: 1, host: "tornadough"})
  assert_eq(red.skip_local_audit, false)
  assert_eq(red.abort_release, false)
  assert_eq(contains(red.reason, "exit 1"), true)
  let red_next = remote_audit_skip_decision(
    {
      setup_ok: true,
      audit_status: 1,
      host: "tornadough",
      fallback_action: "trying the next remote audit host",
    },
  )
  assert_eq(red_next.skip_local_audit, false)
  assert_eq(red_next.abort_release, false)
  assert_eq(contains(red_next.reason, "trying the next remote audit host"), true)
  let red_required = remote_audit_skip_decision(
    {setup_ok: true, audit_status: 1, host: "tornadough", require_remote: true},
  )
  assert_eq(red_required.skip_local_audit, false)
  assert_eq(red_required.abort_release, true)
  assert_eq(contains(red_required.reason, "remote audit is required"), true)
  // ssh transport drop during the audit (255): fall back to local.
  let dropped = remote_audit_skip_decision({setup_ok: true, audit_status: 255})
  assert_eq(dropped.skip_local_audit, false)
  assert_eq(dropped.abort_release, false)
  assert_eq(contains(dropped.reason, "connection dropped"), true)
  // Setup (clone/fetch/checkout) failed: fall back to local.
  let no_setup = remote_audit_skip_decision({setup_ok: false, audit_status: -1})
  assert_eq(no_setup.skip_local_audit, false)
  assert_eq(no_setup.abort_release, false)
  assert_eq(contains(no_setup.reason, "setup"), true)
  let no_setup_required = remote_audit_skip_decision(
    {setup_ok: false, audit_status: -1, host: "tornadough", require_remote: true},
  )
  assert_eq(no_setup_required.abort_release, true)
  assert_eq(contains(no_setup_required.reason, "local fallback"), true)
}

pipeline test_remote_offload_commands(task) {
  assert_eq(
    offload_probe_command("tornadough"),
    "'ssh' '-o' 'ConnectTimeout=5' '-o' 'BatchMode=yes' 'tornadough' 'true'",
  )
  let prereq = remote_audit_prereq_command("tornadough")
  assert_eq(contains(prereq, "'ssh' '-o' 'BatchMode=yes' 'tornadough' 'bash' '-s' '--'"), true)
  assert_eq(contains(prereq, "$HOME/.cargo/bin:$HOME/.local/bin:/opt/homebrew/bin"), true)
  assert_eq(contains(prereq, "bash git cargo cargo-nextest make python3 npm rg"), true)
  assert_eq(contains(prereq, "missing remote audit tool(s):"), true)
  assert_eq(contains(prereq, "<<'HARN_REMOTE_SCRIPT'"), true)
  assert_eq(resolve_offload_host(""), "tornadough")
  assert_eq(resolve_offload_host("  builder "), "builder")
  assert_eq(resolve_offload_hosts(""), ["tornadough", "cattrick"])
  assert_eq(
    resolve_offload_hosts("  builder-a,builder-b builder-c "),
    ["builder-a", "builder-b", "builder-c"],
  )
  let audit = remote_audit_setup_and_run_command(
    {
      host: "tornadough",
      remote_dir: "/tmp/audit",
      repo_url: "git@github.com:burin-labs/harn.git",
      pin_sha: "abc123",
    },
  )
  assert_eq(
    contains(
      audit,
      "'ssh' '-o' 'BatchMode=yes' 'tornadough' 'bash' '-s' '--' '/tmp/audit' 'git@github.com:burin-labs/harn.git' 'abc123'",
    ),
    true,
  )
  assert_eq(contains(audit, "git init"), true)
  assert_eq(contains(audit, "git remote set-url origin \"$repo\""), true)
  assert_eq(contains(audit, "git remote add origin \"$repo\""), true)
  assert_eq(contains(audit, "git rev-parse --verify HEAD"), true)
  assert_eq(contains(audit, "git checkout -q"), true)
  assert_eq(contains(audit, "git checkout -q \"$pin\""), true)
  assert_eq(contains(audit, "git clean -ffdx -e target/ -e .release-audit.lock/"), true)
  assert_eq(contains(audit, "cd"), true)
  assert_eq(contains(audit, "/tmp/audit"), true)
  assert_eq(contains(audit, "mkdir -p \"$dir\""), true)
  assert_eq(contains(audit, "$HOME/.cargo/bin:$HOME/.local/bin:/opt/homebrew/bin"), true)
  assert_eq(contains(audit, "dir=$1"), true)
  assert_eq(contains(audit, "repo=$2"), true)
  assert_eq(contains(audit, "pin=$3"), true)
  assert_eq(contains(audit, ".release-audit.lock"), true)
  assert_eq(contains(audit, "if ! mkdir \"$lock\" 2>/dev/null; then"), true)
  assert_eq(contains(audit, "remote audit lease held:"), true)
  assert_eq(contains(audit, "sed -n '1,80p' \"$lock/owner\""), true)
  assert_eq(contains(audit, "trap cleanup_remote_audit_lease EXIT HUP INT TERM"), true)
  assert_eq(contains(audit, "LEASE_OWNER"), true)
  assert_eq(contains(audit, "set +e"), true)
  let disk = remote_audit_disk_command({host: "tornadough", remote_dir: "/tmp/audit", min_free_gb: 200})
  assert_eq(
    contains(disk, "'ssh' '-o' 'BatchMode=yes' 'tornadough' 'bash' '-s' '--' '/tmp/audit' '200'"),
    true,
  )
  assert_eq(contains(disk, "df -Pk \"$dir\""), true)
  assert_eq(contains(disk, "du -sk \"$dir/target\""), true)
  assert_eq(contains(disk, "rm -rf \"$dir/target\""), true)
  assert_eq(contains(disk, "$HOME/.cargo/bin:$HOME/.local/bin:/opt/homebrew/bin"), true)
  assert_eq(contains(disk, "remote audit disk:"), true)
  assert_eq(contains(disk, "remote audit disk after prune:"), true)
  assert_eq(contains(disk, "pruning managed target cache"), true)
  assert_eq(contains(disk, "remote audit disk below minimum free space"), true)
  let resources = remote_audit_resource_command({host: "tornadough", remote_dir: "/tmp/audit"})
  assert_eq(
    contains(resources, "'ssh' '-o' 'BatchMode=yes' 'tornadough' 'bash' '-s' '--' '/tmp/audit' '8' '0'"),
    true,
  )
  assert_eq(contains(resources, "remote audit resources:"), true)
  assert_eq(contains(resources, "MemAvailable:"), true)
  assert_eq(contains(resources, "active_cargo_procs"), true)
  assert_eq(contains(resources, "remote audit builder already has active Cargo/Rust work"), true)
  assert_eq(contains(resources, "remote audit swap free below 512 MiB"), true)
  let quoted_audit = remote_audit_setup_and_run_command(
    {
      host: "builder host",
      remote_dir: "/tmp/release audit",
      repo_url: "git@github.com:burin-labs/harn's.git",
      pin_sha: "abc123",
    },
  )
  assert_eq(contains(quoted_audit, "'builder host'"), true)
  assert_eq(contains(quoted_audit, "'/tmp/release audit'"), true)
  assert_eq(contains(quoted_audit, "'git@github.com:burin-labs/harn'\\''s.git'"), true)
  assert_eq(contains(quoted_audit, "\\''"), true)
  assert_eq(contains(quoted_audit, "git remote add origin 'git@github.com"), false)
  assert_eq(contains(quoted_audit, "mkdir -p '/tmp/release audit'"), false)
  // Empty remote_dir falls back to the default scratch dir.
  assert_eq(
    contains(
      remote_audit_setup_and_run_command({host: "h", repo_url: "u", pin_sha: "s"}),
      "harn-release-audit",
    ),
    true,
  )
  assert_eq(
    contains(
      remote_audit_setup_and_run_command({host: "h", repo_url: "u", pin_sha: "s"}),
      "~/harn-release-audit",
    ),
    false,
  )
  assert_eq(contains(audit, "cd \"$dir\""), true)
  assert_eq(contains(audit, "printf \"remote audit log: %s/%s\\n\" \"$PWD\" \"$log\""), true)
  assert_eq(contains(audit, "./scripts/release_gate.sh audit > \"$log\" 2>&1"), true)
  assert_eq(contains(audit, "release-audit.offload.log"), true)
  assert_eq(contains(audit, "2>&1"), true)
  assert_eq(contains(audit, "remote audit log:"), true)
  assert_eq(contains(audit, "--- remote audit failure header ---"), true)
  assert_eq(contains(audit, "sed -n '1,220p' \"$log\""), true)
  assert_eq(contains(audit, "--- remote audit final tail ---"), true)
  assert_eq(contains(audit, "tail -n 160"), true)
  assert_eq(contains(audit, "exit $__harn_status"), true)
  assert_eq(contains(audit, "<<'HARN_REMOTE_SCRIPT'"), true)
  assert_eq(remote_audit_log_path({remote_dir: "/tmp/audit"}), "/tmp/audit/release-audit.offload.log")
  assert_eq(remote_audit_log_path({}), "harn-release-audit/release-audit.offload.log")
  assert_eq(contains(remote_audit_log_path({}), "~/"), false)
  assert_eq(
    remote_audit_log_path_from_output(
      "remote audit log: /home/ksinder/harn-release-audit/release-audit.offload.log\nexit 1\n",
    ),
    "/home/ksinder/harn-release-audit/release-audit.offload.log",
  )
  let context = remote_audit_context(
    {
      host: "tornadough",
      remote_dir: "harn-release-audit",
      output: "remote audit log: /home/ksinder/harn-release-audit/release-audit.offload.log\nerror tail\n",
    },
  )
  assert_eq(context.remote_host, "tornadough")
  assert_eq(context.remote_dir, "harn-release-audit")
  assert_eq(context.remote_log_path, "/home/ksinder/harn-release-audit/release-audit.offload.log")
  assert_eq(contains(context.diagnostic_output, "error tail"), true)
  let fallback_context = remote_audit_context({host: "builder", remote_dir: "/tmp/audit"})
  assert_eq(fallback_context.remote_log_path, "/tmp/audit/release-audit.offload.log")
  assert_eq(resolve_remote_audit_min_free_gb(""), 120)
  assert_eq(resolve_remote_audit_min_free_gb("bogus"), 120)
  assert_eq(resolve_remote_audit_min_free_gb("0"), 120)
  assert_eq(resolve_remote_audit_min_free_gb("200"), 200)
}

pipeline test_publish_dryrun_offload(task) {
  // The publish dry-run reuses the setup+lease+log harness with a distinct gate
  // command and log file, on the same host/checkout.
  let cmd = remote_publish_dryrun_command(
    {
      host: "tornadough",
      remote_dir: "/tmp/audit",
      repo_url: "git@github.com:burin-labs/harn.git",
      pin_sha: "abc123",
    },
  )
  assert_eq(contains(cmd, "./scripts/release_gate.sh publish --dry-run > \"$log\" 2>&1"), true)
  assert_eq(contains(cmd, "release-publish-dryrun.offload.log"), true)
  // Still the same guarded remote lease + pin checkout harness.
  assert_eq(contains(cmd, ".release-audit.lock"), true)
  assert_eq(contains(cmd, "git reset --hard \"$pin\""), true)
  // The default audit builder is unchanged (byte-identical gate line + log).
  let audit = remote_audit_setup_and_run_command(
    {host: "h", remote_dir: "/tmp/audit", repo_url: "u", pin_sha: "s"},
  )
  assert_eq(contains(audit, "./scripts/release_gate.sh audit > \"$log\" 2>&1"), true)
  assert_eq(contains(audit, "log=release-audit.offload.log"), true)
  assert_eq(contains(audit, "release-publish-dryrun"), false)
  // An explicit gate_command flows through the generalized builder.
  let custom = remote_audit_setup_and_run_command(
    {
      host: "h",
      repo_url: "u",
      pin_sha: "s",
      gate_command: "./scripts/release_gate.sh publish --dry-run",
    },
  )
  assert_eq(contains(custom, "./scripts/release_gate.sh publish --dry-run > \"$log\" 2>&1"), true)
  // Publish dry-run offload defaults off; opt-in via flag or env.
  assert_eq(release_publish_dryrun_offload_enabled({}), false)
  assert_eq(release_publish_dryrun_offload_enabled({explicit_offload: true}), true)
  assert_eq(release_publish_dryrun_offload_enabled({env_offload: true}), true)
  assert_eq(release_publish_dryrun_offload_enabled({env_offload: false}), false)
  assert_eq(
    release_publish_dryrun_offload_enabled({explicit_offload: true, local_publish: true}),
    false,
  )
  // Coordination hw-post is guarded so a missing helper never fails the release.
  let post = coordination_hw_post_command(
    {host: "tornadough", purpose: "harn release audit", workdir: "/tmp/audit"},
  )
  assert_eq(contains(post, "command -v burin-coord-post"), true)
  assert_eq(contains(post, "|| true"), true)
  assert_eq(contains(post, "'--machine' 'tornadough'"), true)
  assert_eq(contains(post, "'harn release audit'"), true)
  assert_eq(contains(post, "'/tmp/audit'"), true)
}

pipeline test_release_audit_offload_defaulting(task) {
  assert_eq(release_audit_offload_enabled({mode: "audit", yes_live_release: false}), false)
  assert_eq(release_audit_offload_enabled({mode: "prepare", yes_live_release: true}), true)
  assert_eq(release_audit_offload_enabled({mode: "ship-pr", yes_live_release: true}), true)
  assert_eq(
    release_audit_offload_enabled({mode: "prepare", yes_live_release: true, env_offload: false}),
    false,
  )
  assert_eq(
    release_audit_offload_enabled({mode: "audit", yes_live_release: false, explicit_offload: true}),
    true,
  )
  assert_eq(
    release_audit_offload_enabled(
      {mode: "ship-pr", yes_live_release: true, explicit_offload: true, local_audit: true},
    ),
    false,
  )
}
