import { ReleaseStrandedRecoveryState } from "../lib/release_merge_gate"
import { release_publication } from "../lib/release_publication"
import {
  release_stranded_receipt_identity,
  run_release_stranded_recovery,
} from "../lib/release_stranded_recovery"
import {
  release_watch_receipt,
  release_watch_receipt_read,
  release_watch_receipt_record_certification_drift,
} from "../lib/release_watch_state"

const CANDIDATE = "1111111111111111111111111111111111111111"

const MAIN_HEAD = "2222222222222222222222222222222222222222"

const OBSERVED_MAIN = "3333333333333333333333333333333333333333"

const CERTIFIED_TREE = "4444444444444444444444444444444444444444"

const DRIFTED_TREE = "5555555555555555555555555555555555555555"

fn merged_pull(overrides: dict = {}) {
  return {
    number: 8040,
    title: "Release v0.10.129",
    state: "closed",
    merged_at: "2026-09-04T14:31:16Z",
    merge_commit_sha: MAIN_HEAD,
    html_url: "https://github.com/burin-labs/harn/pull/8040",
    base: {ref: "main"},
    head: {ref: "release-attempt/v0.10.129/${CANDIDATE}", sha: CANDIDATE},
  }
    + overrides
}

pipeline test_stranded_receipt_identity_requires_the_exact_merged_release_pr(task: any) {
  const identity = release_stranded_receipt_identity("v0.10.129", MAIN_HEAD, [merged_pull()])
  assert_eq(identity?.candidate_commit, CANDIDATE)
  assert_eq(identity?.pull_number, 8040)
  assert_eq(
    release_stranded_receipt_identity(
      "v0.10.129",
      MAIN_HEAD,
      [merged_pull({merge_commit_sha: "9999999999999999999999999999999999999999"})],
    ),
    nil,
  )
  assert_eq(
    release_stranded_receipt_identity(
      "v0.10.129",
      MAIN_HEAD,
      [merged_pull({head: {ref: "release/v0.10.129", sha: CANDIDATE}})],
    ),
    nil,
  )
  assert_eq(
    release_stranded_receipt_identity(
      "v0.10.129",
      MAIN_HEAD,
      [merged_pull(), merged_pull({number: 8041})],
    ),
    nil,
  )
}

fn receipt() {
  return release_watch_receipt(
    {
      tag: "v0.10.128",
      slug: "burin-labs/harn",
      pin_sha: "0000000000000000000000000000000000000000",
      publication: release_publication("0.10.128", CANDIDATE),
      pr_url: "https://github.com/burin-labs/harn/pull/7899",
      created_at: "2026-09-03T00:00:00Z",
    },
  )
}

fn receipt_with_green_drift() {
  return release_watch_receipt_record_certification_drift(
    receipt(),
    {
      state: "recorded",
      certified_base: "0000000000000000000000000000000000000000",
      observed_main: OBSERVED_MAIN,
      required_contexts: ["CI status"],
      commits: [
        {
          sha: MAIN_HEAD,
          pull_number: 8039,
          checks: [
            {name: "CI status", state: "SUCCESS", source: "main_commit", release_only: false},
          ],
          green: true,
          blocking_check: "",
        },
      ],
      drifted_paths: ["crates/harn-vm/src/lib.rs"],
      release_only_checks: [],
      observed_at: "2026-09-04T14:30:00Z",
    },
    "2026-09-04T14:30:00Z",
  )
}

fn string_list(value: any) -> list<string> {
  let out: list<string> = []
  for item in value {
    out = out + [to_string(item)]
  }
  return out
}

fn observed(overrides: dict = {}) -> ReleaseStrandedRecoveryState {
  const merged = {
    tag: "v0.10.128",
    tag_exists: false,
    tag_target: "",
    target_commit: MAIN_HEAD,
    target_base_commit: OBSERVED_MAIN,
    target_version: "0.10.128",
    certified_tree: CERTIFIED_TREE,
    target_tree: CERTIFIED_TREE,
    drifted_paths: [],
  }
    + overrides
  return {
    tag: to_string(merged.tag),
    tag_exists: merged.tag_exists == true,
    tag_target: to_string(merged.tag_target),
    target_commit: to_string(merged.target_commit),
    target_base_commit: to_string(merged.target_base_commit),
    target_version: to_string(merged.target_version),
    certified_tree: to_string(merged.certified_tree),
    target_tree: to_string(merged.target_tree),
    drifted_paths: string_list(merged.drifted_paths),
  }
}

/**
 * The stranded state v0.10.128 landed in: main carries the bumped version and no
 * tag exists. When main's tree is the one the release certified, recovery mints
 * the tag there and binds the receipt, so the release finishes without a revert.
 */
pipeline test_stranded_recovery_tags_main_where_it_stands(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "stranded-clean.json")
  let tagged = ""
  const result = run_release_stranded_recovery(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    MAIN_HEAD,
    {
      observe: fn() { return observed() },
      merged_main_ancestor: fn(commit) { return commit == MAIN_HEAD },
      push_tag: fn(commit) {
        tagged = commit
        return [{name: "push-release-tag", success: true}]
      },
      now: fn() { return "2026-09-03T02:00:00Z" },
    },
  )
  const persisted = release_watch_receipt_read(harness.fs, path)
  assert_eq([result.status, result.action, tagged], [0, "tag", MAIN_HEAD])
  assert_eq(persisted?.release_commit_oid, MAIN_HEAD)
}

/**
 * The same stranded state with uncertified code on main. Recovery refuses, mints
 * nothing, and names the remediation. Without this the mode would launder the
 * exact defect the tree gate exists to catch.
 */
pipeline test_stranded_recovery_refuses_uncertified_code(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "stranded-bearing.json")
  // A previous run of this workspace may have left a receipt here, and the
  // claim below is that this run wrote none.
  if harness.fs.exists(path) {
    harness.fs.delete(path)
  }
  let tagged = ""
  const result = run_release_stranded_recovery(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    MAIN_HEAD,
    {
      observe: fn() { return observed(
        {target_tree: DRIFTED_TREE, drifted_paths: ["crates/harn-core/src/lib.rs"]},
      ) },
      merged_main_ancestor: fn(_commit) { return true },
      push_tag: fn(commit) {
        tagged = commit
        return [{name: "unexpected-tag-push", success: true}]
      },
      now: fn() { return "2026-09-03T02:00:00Z" },
    },
  )
  assert_eq([result.status, result.action, tagged], [2, "refuse", ""])
  assert(contains(result.reason, "Revert the version bump on main"))
  assert(contains(result.reason, "crates/harn-core/src/lib.rs"))
  assert_eq(harness.fs.exists(path), false)
}

/** A lost receipt may be rebuilt, but only re-proved green drift can transfer certification. */
pipeline test_stranded_recovery_tags_reproved_green_main_drift(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "stranded-reproved-drift.json")
  let tagged = ""
  const result = run_release_stranded_recovery(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt_with_green_drift(),
    path,
    MAIN_HEAD,
    {
      observe: fn() { return observed(
        {target_tree: DRIFTED_TREE, drifted_paths: ["crates/harn-vm/src/lib.rs"]},
      ) },
      merged_main_ancestor: fn(_commit) { return true },
      push_tag: fn(commit) {
        tagged = commit
        return [{name: "push-release-tag", success: true}]
      },
      now: fn() { return "2026-09-04T15:00:00Z" },
    },
  )
  assert_eq([result.status, result.action, tagged], [0, "tag", MAIN_HEAD])
}

/** Recovery is bound to the same observed main parent as the original tag path. */
pipeline test_stranded_recovery_refuses_green_drift_merged_on_a_later_base(
  harness: Harness,
  task: any,
) {
  const path = path_join(harness.fs.workspace_temp_dir(), "stranded-later-base.json")
  let tagged = ""
  const later_main = "9999999999999999999999999999999999999999"
  const result = run_release_stranded_recovery(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt_with_green_drift(),
    path,
    MAIN_HEAD,
    {
      observe: fn() { return observed(
        {
          target_base_commit: later_main,
          target_tree: DRIFTED_TREE,
          drifted_paths: ["crates/harn-vm/src/lib.rs"],
        },
      ) },
      merged_main_ancestor: fn(_commit) { return true },
      push_tag: fn(commit) {
        tagged = commit
        return [{name: "unexpected-tag-push", success: true}]
      },
      now: fn() { return "2026-09-04T15:00:00Z" },
    },
  )
  assert_eq([result.status, result.action, tagged], [2, "refuse", ""])
}

/** A recovery that could not observe its inputs refuses rather than tags. */
pipeline test_stranded_recovery_refuses_an_unobservable_repository(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "stranded-blind.json")
  let tagged = ""
  const result = run_release_stranded_recovery(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    MAIN_HEAD,
    {
      observe: fn() { return nil },
      merged_main_ancestor: fn(_commit) { return true },
      push_tag: fn(commit) {
        tagged = commit
        return [{name: "unexpected-tag-push", success: true}]
      },
      now: fn() { return "2026-09-03T02:00:00Z" },
    },
  )
  assert_eq([result.status, tagged], [2, ""])
  assert(contains(result.reason, "refusing to tag without that proof"))
}

/** Recovery never tags a commit it cannot reach from main. */
pipeline test_stranded_recovery_refuses_an_unreachable_commit(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "stranded-unreachable.json")
  let tagged = ""
  const result = run_release_stranded_recovery(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    MAIN_HEAD,
    {
      observe: fn() { return observed() },
      merged_main_ancestor: fn(_commit) { return false },
      push_tag: fn(commit) {
        tagged = commit
        return [{name: "unexpected-tag-push", success: true}]
      },
      now: fn() { return "2026-09-03T02:00:00Z" },
    },
  )
  assert_eq([result.status, tagged], [2, ""])
  assert(contains(result.reason, "not reachable from origin/main"))
}

/** Re-running a completed recovery re-proves the tag instead of minting a second. */
pipeline test_stranded_recovery_is_idempotent(harness: Harness, task: any) {
  const path = path_join(harness.fs.workspace_temp_dir(), "stranded-idempotent.json")
  let tagged = ""
  const result = run_release_stranded_recovery(
    harness,
    {mock: true, repo: "/mock/harn"},
    receipt(),
    path,
    MAIN_HEAD,
    {
      observe: fn() { return observed({tag_exists: true, tag_target: MAIN_HEAD}) },
      merged_main_ancestor: fn(_commit) { return true },
      push_tag: fn(commit) {
        tagged = commit
        return [{name: "unexpected-tag-push", success: true}]
      },
      now: fn() { return "2026-09-03T02:00:00Z" },
    },
  )
  assert_eq([result.status, result.action, tagged], [0, "already_published", ""])
}
