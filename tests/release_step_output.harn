import {
  RELEASE_FAILURE_TAIL_LIMIT,
  log_step_finished,
  release_output_tail,
  release_redact_secrets,
  release_run_dir,
  release_step_failure_detail,
} from "../lib/release_runtime"

type StepFinishedEvent = {
  event_type: string,
  data: {step: string, success: bool, exit_code: int?, stderr_tail?: string, ...rest},
  ...event_rest,
}

pipeline test_release_redact_secrets_strips_credential_shapes(task) {
  assert_eq(
    release_redact_secrets("fatal: could not read Username for 'https://ghp_abc123DEF@github.com'"),
    "fatal: could not read Username for 'https://[redacted-token]@github.com'",
  )
  assert_eq(
    release_redact_secrets("remote: https://ksinder:hunter2@github.com/burin-labs/harn"),
    "remote: https://[redacted]@github.com/burin-labs/harn",
  )
  assert(contains(release_redact_secrets("Authorization: Bearer abc.def"), "[redacted]"))
  assert_eq(contains(release_redact_secrets("Authorization: Bearer abc.def"), "abc.def"), false)
  assert_eq(contains(release_redact_secrets("key=sk-live-9f8e7d6c"), "9f8e7d6c"), false)
  // Ordinary build output must survive untouched, or the tail is useless.
  const build_error = "error[E0433]: failed to resolve: use of undeclared crate `serde`"
  assert_eq(release_redact_secrets(build_error), build_error)
}

pipeline test_release_output_tail_keeps_the_end_and_marks_truncation(task) {
  assert_eq(release_output_tail("   compact  \n"), "compact")
  assert_eq(release_output_tail(""), "")
  // The end of a build log holds the error, so truncation drops the head.
  const long = repeat("a", RELEASE_FAILURE_TAIL_LIMIT) + "FINAL_ERROR_LINE"
  const tail = release_output_tail(long)
  assert(starts_with(tail, "...[truncated]..."))
  assert(ends_with(tail, "FINAL_ERROR_LINE"))
  assert_eq(len(tail) <= RELEASE_FAILURE_TAIL_LIMIT + 20, true)
  const short = "only a little output"
  assert_eq(release_output_tail(short), short)
}

pipeline test_release_step_failure_detail_is_quiet_on_success(task) {
  assert_eq(
    release_step_failure_detail(
      {success: true, status: "completed", exit_code: 0, stdout: "noisy", stderr: "noisy"},
    ),
    {},
  )
  assert_eq(release_step_failure_detail({success: false, status: "completed", exit_code: 2}), {})
}

pipeline test_release_step_failure_detail_carries_redacted_output(task) {
  const detail = release_step_failure_detail(
    {
      success: false,
      status: "completed",
      exit_code: 2,
      stdout: "=== Checking release/package CLI AOT payload ===",
      stderr: "make: *** [check-cli-aot] Error 101 (token ghp_leakedSECRET1)",
    },
  )
  assert(contains(detail.stderr_tail ?? "", "Error 101"))
  assert(contains(detail.stderr_tail ?? "", "[redacted-token]"))
  assert_eq(contains(detail.stderr_tail ?? "", "leakedSECRET1"), false)
  assert(contains(detail.stdout_tail ?? "", "CLI AOT payload"))
}

/**
 * The durable record is what a later operator reads. An exit code with no
 * output made a transient release failure unreproducible once its workspace
 * moved on, so a failed step must persist why it failed.
 */
pipeline test_failed_step_event_records_why_it_failed(harness: Harness, task) {
  const run_id = "test-step-output-" + harness.random.uuid_v7()
  log_step_finished(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "release-cli-aot",
    {
      success: false,
      status: "completed",
      exit_code: 2,
      stderr: "error: linking with `cc` failed: exit status: 1",
    },
    nil,
  )
  log_step_finished(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "release-markdown-lint",
    {success: true, status: "completed", exit_code: 0, stderr: "warning: ignored"},
    nil,
  )
  const events = split(
    trim(harness.fs.read_text(path_join(release_run_dir(harness.fs, run_id), "run-events.jsonl"))),
    "\n",
  )
  assert_eq(len(events), 2)
  const failed: StepFinishedEvent = json_parse(events[0])
  assert_eq(failed.event_type, "step_finished")
  assert_eq(failed.data.step, "release-cli-aot")
  assert(contains(failed.data.stderr_tail ?? "", "linking with `cc` failed"))
  // A successful step stays quiet so the stream does not fill with noise.
  const passed: StepFinishedEvent = json_parse(events[1])
  assert_eq(passed.data.stderr_tail ?? "", "")
}
