import { decode_github_workflow, github_projection_has_trigger } from "../lib/github_workflow"
import { PROJECTION_CONVERGENCE_RECEIPT_NAME } from "../lib/remote_projection"

/**
 * Shape ratchets for the workflow that runs the convergence loop.
 *
 * This is the one workflow in the fleet that writes to repositories the fleet
 * does not own, so the properties that keep it safe belong in a test rather
 * than in a reviewer's memory.
 */
fn convergence_workflow(fs: HarnessFs) -> string {
  return fs.read_text(
    path_join(dirname(fs.cwd()), ".github", "workflows", "fleet-projection-convergence.yml"),
  )
}

pipeline test_convergence_runs_on_a_schedule(harness: Harness, task: any) {
  // A repair that only runs when someone remembers to run it is the state this
  // workflow exists to leave.
  const workflow = decode_github_workflow(convergence_workflow(harness.fs))
  assert_eq(github_projection_has_trigger(workflow, "schedule"), true)
  assert_eq(github_projection_has_trigger(workflow, "workflow_dispatch"), true)
}

pipeline test_convergence_proposes_and_never_merges(harness: Harness, task: any) {
  // The safety argument is that each repository keeps its own gate. This test
  // once also forbade arming auto-merge, on the reading that arming and merging
  // take the same thing away. They do not: a merge step decides the gate is
  // satisfied, while arming asks GitHub to merge only once the repository's own
  // required checks say so. The owner lifted the arming prohibition on
  // 2026-08-04; merging directly stays forbidden, and is what this pins.
  //
  // Deciding it here, on the workflow, is deliberate. `gh pr merge` in a step
  // would answer to nothing but this file, whereas the arming the loop does is
  // leased to an exact commit and covered by `tests/remote_projection.harn`.
  const workflow = decode_github_workflow(convergence_workflow(harness.fs))
  for job in workflow.jobs {
    for step in job.value.steps ?? [] {
      assert_eq(
        contains(step.run ?? "", "pr merge"),
        false,
        "a convergence step must not merge a pull request itself",
      )
      assert_eq(
        contains(step.run ?? "", "merge_queue"),
        false,
        "a convergence step must not enqueue a pull request itself",
      )
      assert_eq(contains(step.uses ?? "", "merge"), false, "a convergence step must not merge")
    }
  }
}

pipeline test_the_convergence_run_does_not_hold_arming(harness: Harness, task: any) {
  // The workflow is where a scheduled run's arming would be silently switched
  // off, and a fleet that proposes without arming looks identical in the logs
  // to a fleet with nothing to propose. If a hold is ever wanted, it belongs in
  // this assertion first.
  const workflow = decode_github_workflow(convergence_workflow(harness.fs))
  for job in workflow.jobs {
    for step in job.value.steps ?? [] {
      assert_eq(
        contains(step.run ?? "", "--no-auto-merge"),
        false,
        "the scheduled convergence run must arm what it proposes",
      )
    }
  }
}

pipeline test_the_minted_token_carries_exactly_the_projection_write_scopes(
  harness: Harness,
  task: any,
) {
  // The fleet's App can do far more than this run needs. Pinning the exact
  // `with` keys means a widened scope has to be argued for here first.
  const workflow = decode_github_workflow(convergence_workflow(harness.fs))
  let minted = []
  for job in workflow.jobs {
    for step in job.value.steps ?? [] {
      if starts_with(step.uses ?? "", "actions/create-github-app-token@") {
        minted = minted + [(step.with ?? {}).keys().sorted()]
      }
    }
  }
  assert_eq(
    minted,
    [
      [
        "client-id",
        "owner",
        "permission-contents",
        "permission-pull-requests",
        "permission-workflows",
        "private-key",
      ],
    ],
  )
}

pipeline test_the_projection_receipt_is_not_the_bump_wait_receipt(harness: Harness, task: any) {
  // Two workflows used to write different schemas to the same filename. A
  // reader who opened the artifact after a projection run would see
  // `harn.fleet-projection-convergence.v1` or `harn_bump_fleet.harn_update.v1`
  // depending on which job ran last. The names must stay distinct.
  const workflow = convergence_workflow(harness.fs)
  assert_eq(contains(workflow, PROJECTION_CONVERGENCE_RECEIPT_NAME), true)
  assert_eq(contains(workflow, "tee fleet-convergence-receipt.json"), false)
  assert_eq(contains(workflow, "path: fleet-convergence-receipt.json"), false)
}

pipeline test_human_status_lines_do_not_share_stdout_with_the_receipt(harness: Harness, task: any) {
  // The workflow tees stdout into the JSON artifact. A `println` of
  // `clean slug:` on that stream is what made `jq` fail. Status belongs on
  // stderr; stdout is the document.
  const reporter = harness.fs.read_text(
    path_join(dirname(harness.fs.cwd()), "lib", "remote_projection.harn"),
  )
  assert_eq(contains(reporter, "stdio.eprintln(projection_status_line(result))"), true)
  assert_eq(contains(reporter, "stdio.println(projection_status_line(result))"), false)
  const entry = harness.fs.read_text(
    path_join(dirname(harness.fs.cwd()), "converge_fleet_projections.harn"),
  )
  assert_eq(contains(entry, "report_projection_status(harness.stdio, result)"), true)
}
