import {
  release_git_remote_observation_is_transient,
  retry_release_git_remote_observation,
} from "../lib/release_git_remote_retry"
import { ReleaseGitRemoteObservation } from "../lib/release_runtime"

fn failed(stderr: string) -> ReleaseGitRemoteObservation {
  return {success: false, exit_code: 128, refs: [], receipt: nil, stderr: stderr}
}

fn succeeded() -> ReleaseGitRemoteObservation {
  return {success: true, exit_code: 0, refs: [], receipt: nil, stderr: ""}
}

pipeline test_remote_ref_observation_retries_transient_dns_failure(harness: Harness, task: any) {
  let calls = 0
  harness.testing.clock_set(0)
  const result = retry_release_git_remote_observation(
    harness.clock,
    fn() {
      calls = calls + 1
      if calls == 1 {
        return failed("fatal: unable to access origin: Could not resolve host: github.com")
      }
      return succeeded()
    },
    {max_attempts: 4, base_delay_ms: 1, cap_delay_ms: 4},
  )
  harness.testing.clock_reset()
  assert(result.success)
  assert_eq(calls, 2)
  assert_eq(result.attempts, 2)
  assert_eq(result.transient_retries, 1)
}

pipeline test_remote_ref_observation_exhaustion_is_bounded(harness: Harness, task: any) {
  let calls = 0
  harness.testing.clock_set(0)
  const result = retry_release_git_remote_observation(
    harness.clock,
    fn() {
      calls = calls + 1
      return failed("fatal: unable to access origin: Connection reset by peer")
    },
    {max_attempts: 4, base_delay_ms: 1, cap_delay_ms: 4},
  )
  harness.testing.clock_reset()
  assert(!result.success)
  assert_eq(calls, 4)
  assert_eq(result.attempts, 4)
  assert_eq(result.transient_retries, 3)
}

pipeline test_remote_ref_observation_does_not_retry_deterministic_git_failure(
  harness: Harness,
  task: any,
) {
  let calls = 0
  const result = retry_release_git_remote_observation(
    harness.clock,
    fn() {
      calls = calls + 1
      return failed("fatal: repository 'https://github.com/example/missing' not found")
    },
    {max_attempts: 4, base_delay_ms: 0, cap_delay_ms: 0},
  )
  assert(!result.success)
  assert_eq(calls, 1)
  assert_eq(result.attempts, 1)
  assert_eq(result.transient_retries, 0)
  assert(!release_git_remote_observation_is_transient(result))
}
