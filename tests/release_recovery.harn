import { command_result_fail, command_result_ok } from "std/command"
import { recorded_step } from "../lib/release_execution"
import { release_note_reset_plan, reset_release_note_sources } from "../lib/release_modes"
import { apply_deterministic_candidate_tree_release_notes } from "../lib/release_note_fold"
import {
  ReleaseFixupBinaryRequest,
  ReleaseFixupConfig,
  ReleasePrepareWarmEvidence,
  execute_fixup_reconciliation,
  release_fixup_fragment_delete_conflict_allowed,
} from "../lib/release_prepare"
import { ReleasePublication } from "../lib/release_publication"
import { ReleaseNotesScope } from "../lib/release_runtime"
import { prepare_repair_changed } from "../release_harn.harn"

fn recovery_fixture_shell(process: HarnessProcess, command: any) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn recovery_fixup_config(
  repo: string,
  release_target: string,
  head_oid: string,
) -> ReleaseFixupConfig {
  const publication: ReleasePublication = {
    version: "0.10.24",
    local_branch: "release/v0.10.24",
    head_oid: head_oid,
    remote_ref: "release-attempt/v0.10.24/${head_oid}",
  }
  return {
    mock: false,
    pin_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    quiet: true,
    repo: repo,
    base: "main",
    bump: "patch",
    bootstrap_new_crates: false,
    release_cargo_target_dir: release_target,
    fixup_publication: publication,
  }
}

fn fixture_fixup_binary(
  _harness: Harness,
  request: ReleaseFixupBinaryRequest,
) -> ReleasePrepareWarmEvidence {
  return {
    steps: request.steps
      + [
        recorded_step(
          "warm-exact-pin-harn-cli",
          "fixture exact-pin Harn CLI",
          command_result_ok("/bin/sh"),
        ),
      ],
    harn_bin: "/bin/sh",
  }
}

fn failed_fixture_fixup_binary(
  _harness: Harness,
  request: ReleaseFixupBinaryRequest,
) -> ReleasePrepareWarmEvidence {
  return {
    steps: request.steps
      + [
        recorded_step(
          "warm-exact-pin-harn-cli",
          "fixture exact-pin Harn CLI",
          command_result_fail(2, "fixture warm failed"),
        ),
      ],
    harn_bin: "",
  }
}

@test
pipeline test_prepare_retry_requires_a_changed_valid_fingerprint(task: any) {
  assert_eq(prepare_repair_changed("before", "after"), true)
  assert_eq(prepare_repair_changed("same", "same"), false)
  assert_eq(prepare_repair_changed("", "after"), false)
  assert_eq(prepare_repair_changed("before", ""), false)
}

@test
pipeline test_fixup_fragment_conflict_policy_fails_closed(task: any) {
  assert_eq(
    release_fixup_fragment_delete_conflict_allowed("changelog.d/shipped.fixed.md", ["1", "2"]),
    true,
  )
  assert_eq(release_fixup_fragment_delete_conflict_allowed("src/lib.rs", ["1", "2"]), false)
  assert_eq(
    release_fixup_fragment_delete_conflict_allowed("changelog.d/../src/lib.rs", ["1", "2"]),
    false,
  )
  assert_eq(
    release_fixup_fragment_delete_conflict_allowed("changelog.d/shipped.fixed.md", ["1", "3"]),
    false,
  )
  assert_eq(
    release_fixup_fragment_delete_conflict_allowed("changelog.d/shipped.fixed.md", ["1", "2", "3"]),
    false,
  )
}

@test
pipeline test_recovery_note_reset_tracks_the_single_typed_scope(task: any) {
  const candidate: ReleaseNotesScope = "candidate_tree"
  const frozen: ReleaseNotesScope = "frozen_artifact"
  const checkpoint: ReleaseNotesScope = "immutable_checkpoint"
  assert_eq(
    release_note_reset_plan(candidate, "changelog.d/entry.fixed.md\n"),
    {
      paths: ["CHANGELOG.md", "changelog.d"],
      argv: ["git", "checkout", "HEAD", "--", "CHANGELOG.md", "changelog.d"],
    },
  )
  assert_eq(
    release_note_reset_plan(candidate, ""),
    {paths: ["CHANGELOG.md"], argv: ["git", "checkout", "HEAD", "--", "CHANGELOG.md"]},
  )
  assert_eq(release_note_reset_plan(frozen), release_note_reset_plan(candidate, ""))
  assert_eq(release_note_reset_plan(checkpoint), {paths: [], argv: []})
}

@test
pipeline test_candidate_note_reset_accepts_tree_without_tracked_fragments(
  harness: Harness,
  task: any,
) {
  const repo = path_join(
    harness.fs.temp_dir(),
    "release-note-reset-empty-" + harness.random.uuid_v7(),
  )
  harness.fs.mkdir(repo, true)
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' init -q")
  recovery_fixture_shell(
    harness.process,
    "git -C '" + repo + "' config user.email 'test@example.com'",
  )
  recovery_fixture_shell(
    harness.process,
    "git -C '" + repo + "' config user.name 'Release Fixture'",
  )
  const changelog = path_join(repo, "CHANGELOG.md")
  const original = "# Changelog\n\n## Unreleased\n\n- Ready.\n"
  harness.fs.write_text(changelog, original)
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' add CHANGELOG.md")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' commit -qm 'seed notes'")
  harness.fs.write_text(changelog, "# Changelog\n\n## Unreleased\n\n- Dirty.\n")
  const reset = reset_release_note_sources(
    harness,
    {repo: repo, mock: false},
    "candidate_tree",
    [],
    "test-empty-fragment-reset-" + harness.random.uuid_v7(),
  )
  assert_eq(reset.success, true)
  assert_eq(
    reset.steps.map({ step -> step.name }),
    ["fixup-probe-release-note-sources", "fixup-reset-release-note-sources"],
  )
  assert_eq(harness.fs.read_text(changelog), original)
}

@test
pipeline test_fixup_reconciles_fresh_base_before_replaying_immutable_attempt(
  harness: Harness,
  task: any,
) {
  const root = path_join(
    harness.fs.temp_dir(),
    "release-fixup-reconcile-" + harness.random.uuid_v7(),
  )
  const origin = path_join(root, "origin.git")
  const repo = path_join(root, "repo")
  const release_target = path_join(root, "target")
  const vm_manifest = path_join(repo, "crates", "harn-vm", "Cargo.toml")
  const clock_manifest = path_join(repo, "crates", "harn-clock", "Cargo.toml")
  const sqlite_manifest = path_join(repo, "crates", "harn-sqlite", "Cargo.toml")
  const old_fragment = path_join(repo, "changelog.d", "shipped.added.md")
  const new_fragment = path_join(repo, "changelog.d", "post-pin.fixed.md")
  const release_gate = path_join(repo, "scripts", "release_gate.sh")
  recovery_fixture_shell(harness.process, "git init --bare -q '" + origin + "'")
  recovery_fixture_shell(harness.process, "git init -q '" + repo + "'")
  recovery_fixture_shell(
    harness.process,
    "git -C '" + repo + "' config user.email test@example.com",
  )
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' config user.name test")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' checkout -q -b main")
  harness.fs.mkdir(path_join(repo, "crates", "harn-vm"), true)
  harness.fs.mkdir(path_join(repo, "crates", "harn-clock"), true)
  harness.fs.mkdir(path_join(repo, "changelog.d"), true)
  harness.fs.mkdir(path_join(repo, "scripts"), true)
  harness.fs.mkdir(release_target, true)
  harness.fs.write_text(
    path_join(repo, "Cargo.toml"),
    "[workspace]\nmembers = [\"crates/harn-clock\", \"crates/harn-vm\"]\n\n[workspace.package]\nversion = \"0.10.23\"\n",
  )
  harness.fs.write_text(
    clock_manifest,
    "[package]\nname = \"harn-clock\"\nversion.workspace = true\n",
  )
  harness.fs.write_text(
    vm_manifest,
    "[package]\nname = \"harn-vm\"\nversion.workspace = true\n\n[dependencies]\nharn-clock = { path = \"../harn-clock\", version = \"=0.10.23\" }\n",
  )
  harness.fs.write_text(
    path_join(repo, "Cargo.lock"),
    "name = \"harn-vm\"\nversion = \"0.10.23\"\n",
  )
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## Unreleased\n\n### Added\n\n- Pin baseline.\n\n## v0.10.23\n\n- Prior.\n",
  )
  harness.fs.write_text(old_fragment, "- Fragment-only shipped capability.\n")
  harness.fs.write_text(
    release_gate,
    """
#!/bin/sh
set -eu
test "$HARN_BIN" = /bin/sh
test "$HARN_RELEASE_METADATA_BIN" = /bin/sh
test "$1" = prepare
test "$2" = --bump
test "$3" = patch
test "$4" = --allow-dirty
python3 - <<'PY'
from pathlib import Path
root = Path("Cargo.toml")
root.write_text(root.read_text().replace('version = "0.10.23"', 'version = "0.10.24"'))
for path in [*Path("crates").glob("*/Cargo.toml"), Path("Cargo.lock")]:
    path.write_text(path.read_text().replace("0.10.23", "0.10.24"))
Path(".canonical-prepare-ran").write_text("ok\n")
PY
""",
  )
  recovery_fixture_shell(harness.process, "chmod +x '" + release_gate + "'")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' add .")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' commit -q -m pin")
  recovery_fixture_shell(
    harness.process,
    "git -C '" + repo + "' remote add origin '" + origin + "'",
  )
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' push -q -u origin main")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' checkout -q -b release-old")
  harness.fs.write_text(
    path_join(repo, "Cargo.toml"),
    replace(harness.fs.read_text(path_join(repo, "Cargo.toml")), "0.10.23", "0.10.24"),
  )
  harness.fs.write_text(
    vm_manifest,
    replace(harness.fs.read_text(vm_manifest), "0.10.23", "0.10.24"),
  )
  harness.fs.write_text(
    path_join(repo, "Cargo.lock"),
    replace(harness.fs.read_text(path_join(repo, "Cargo.lock")), "0.10.23", "0.10.24"),
  )
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## v0.10.24\n\n### Added\n\n- Pin baseline.\n- Fragment-only shipped capability.\n\n## v0.10.23\n\n- Prior.\n",
  )
  harness.fs.delete(old_fragment)
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' add -u")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' commit -q -m 'Release v0.10.24'")
  const attempt = trim(
    recovery_fixture_shell(harness.process, "git -C '" + repo + "' rev-parse HEAD").stdout,
  )
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' checkout -q main")
  harness.fs.write_text(old_fragment, "- Fragment-only shipped capability, clarified later.\n")
  harness.fs.mkdir(path_join(repo, "crates", "harn-sqlite"), true)
  harness.fs.write_text(
    sqlite_manifest,
    "[package]\nname = \"harn-sqlite\"\nversion.workspace = true\n",
  )
  harness.fs.write_text(
    path_join(repo, "Cargo.toml"),
    replace(
      harness.fs.read_text(path_join(repo, "Cargo.toml")),
      "\"crates/harn-vm\"",
      "\"crates/harn-sqlite\", \"crates/harn-vm\"",
    ),
  )
  harness.fs.write_text(
    vm_manifest,
    replace(
      harness.fs.read_text(vm_manifest),
      "harn-clock = { path = \"../harn-clock\", version = \"=0.10.23\" }",
      "harn-clock = { path = \"../harn-clock\", version = \"=0.10.23\" }\nharn-sqlite = { path = \"../harn-sqlite\", version = \"=0.10.23\" }",
    ),
  )
  harness.fs.write_text(new_fragment, "- Post-pin repair.\n")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' add .")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' commit -q -m 'post-pin sibling'")
  recovery_fixture_shell(harness.process, "git -C '" + repo + "' push -q origin main")
  const invalid_steps = execute_fixup_reconciliation(
    harness,
    recovery_fixup_config(repo, release_target, "deadbeef"),
    {current_version: "0.10.23", next_version: "0.10.24"},
    [],
    "test-fixup-invalid-attempt-" + harness.random.uuid_v7(),
    fixture_fixup_binary,
  )
  assert_eq(invalid_steps.map({ step -> step.name }), ["fixup-list-prepare-commits"])
  assert_eq(invalid_steps[0].success, false)
  assert_eq(harness.fs.exists(path_join(repo, ".canonical-prepare-ran")), false)
  const warm_failed_steps = execute_fixup_reconciliation(
    harness,
    recovery_fixup_config(repo, release_target, attempt),
    {current_version: "0.10.23", next_version: "0.10.24"},
    [],
    "test-fixup-warm-failed-" + harness.random.uuid_v7(),
    failed_fixture_fixup_binary,
  )
  assert_eq(warm_failed_steps.map({ step -> step.name }), ["warm-exact-pin-harn-cli"])
  assert_eq(warm_failed_steps[0].success, false)
  assert_eq(harness.fs.exists(path_join(repo, ".canonical-prepare-ran")), false)
  const version_mismatch_steps = execute_fixup_reconciliation(
    harness,
    recovery_fixup_config(repo, release_target, attempt),
    {current_version: "0.10.22", next_version: "0.10.24"},
    [],
    "test-fixup-version-mismatch-" + harness.random.uuid_v7(),
    fixture_fixup_binary,
  )
  assert_eq(
    version_mismatch_steps.map({ step -> step.name }),
    ["warm-exact-pin-harn-cli", "fixup-reconcile-fresh-base-release-metadata"],
  )
  assert_eq(version_mismatch_steps[1].success, false)
  assert_eq(harness.fs.exists(path_join(repo, ".canonical-prepare-ran")), false)
  assert_eq(
    trim(
      recovery_fixture_shell(harness.process, "git -C '" + repo + "' status --porcelain").stdout,
    ),
    "",
  )
  const steps = execute_fixup_reconciliation(
    harness,
    recovery_fixup_config(repo, release_target, attempt),
    {current_version: "0.10.23", next_version: "0.10.24"},
    [],
    "test-fixup-reconcile-" + harness.random.uuid_v7(),
    fixture_fixup_binary,
  )
  assert_eq(
    steps.map({ step -> step.name }),
    [
      "warm-exact-pin-harn-cli",
      "fixup-reconcile-fresh-base-release-metadata",
      "fixup-cherry-pick-prepare-commits",
    ],
  )
  assert_eq(steps.map({ step -> step.success }).to_list(), [true, true, true])
  assert_eq(steps[2]?.reconciliation?.action, "resolved")
  assert_eq(steps[2]?.reconciliation?.paths, ["changelog.d/shipped.added.md"])
  const reset = reset_release_note_sources(
    harness,
    {repo: repo, mock: false},
    "candidate_tree",
    [],
    "test-fixup-reset-" + harness.random.uuid_v7(),
  )
  assert_eq(reset.success, true)
  assert_eq(
    reset.steps.map({ step -> step.name }),
    ["fixup-probe-release-note-sources", "fixup-reset-release-note-sources"],
  )
  const notes = apply_deterministic_candidate_tree_release_notes(
    {fs: harness.fs, process: harness.process},
    {mock: false, repo: repo},
    "0.10.24",
    nil,
  )
  assert_eq(notes.success, true)
  assert(contains(harness.fs.read_text(path_join(repo, "Cargo.toml")), "version = \"0.10.24\""))
  const reconciled_vm = harness.fs.read_text(vm_manifest)
  assert(
    contains(reconciled_vm, "harn-clock = { path = \"../harn-clock\", version = \"=0.10.24\" }"),
  )
  assert(
    contains(reconciled_vm, "harn-sqlite = { path = \"../harn-sqlite\", version = \"=0.10.24\" }"),
  )
  assert(contains(harness.fs.read_text(path_join(repo, "Cargo.lock")), "version = \"0.10.24\""))
  assert(contains(harness.fs.read_text(sqlite_manifest), "version.workspace = true"))
  const changelog = harness.fs.read_text(path_join(repo, "CHANGELOG.md"))
  assert_eq(len(regex_captures("(?m)^## v0[.]10[.]24$", changelog)), 1)
  assert_eq(len(regex_captures("(?m)^## Unreleased$", changelog)), 0)
  assert_eq(len(regex_captures("Pin baseline", changelog)), 1)
  assert_eq(len(regex_captures("Fragment-only shipped capability", changelog)), 1)
  assert_eq(len(regex_captures("Post-pin repair", changelog)), 1)
  assert_eq(harness.fs.exists(old_fragment), false)
  assert_eq(harness.fs.exists(new_fragment), false)
  assert_eq(harness.fs.exists(path_join(repo, ".canonical-prepare-ran")), true)
  harness.fs.delete(root)
}
