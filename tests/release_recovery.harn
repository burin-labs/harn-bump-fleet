import { changelog_promote_pin_time_unreleased } from "../lib/changelog"
import { execute_fixup_reconciliation } from "../lib/release_prepare"
import { prepare_repair_changed } from "../release_harn.harn"

fn recovery_fixture_shell(command) {
  const result = shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

@test
pipeline test_prepare_retry_requires_a_changed_valid_fingerprint(task) {
  assert_eq(prepare_repair_changed("before", "after"), true)
  assert_eq(prepare_repair_changed("same", "same"), false)
  assert_eq(prepare_repair_changed("", "after"), false)
  assert_eq(prepare_repair_changed("before", ""), false)
}

@test
pipeline test_fixup_reconciles_fresh_base_before_replaying_immutable_attempt(task) {
  const root = path_join(harness.fs.temp_dir(), "release-fixup-reconcile-" + uuid_v7())
  const origin = path_join(root, "origin.git")
  const repo = path_join(root, "repo")
  const release_target = path_join(root, "target")
  const vm_manifest = path_join(repo, "crates", "harn-vm", "Cargo.toml")
  const clock_manifest = path_join(repo, "crates", "harn-clock", "Cargo.toml")
  const sqlite_manifest = path_join(repo, "crates", "harn-sqlite", "Cargo.toml")
  const old_fragment = path_join(repo, "changelog.d", "shipped.added.md")
  const new_fragment = path_join(repo, "changelog.d", "post-pin.fixed.md")
  const release_gate = path_join(repo, "scripts", "release_gate.sh")
  recovery_fixture_shell("git init --bare -q '" + origin + "'")
  recovery_fixture_shell("git init -q '" + repo + "'")
  recovery_fixture_shell("git -C '" + repo + "' config user.email test@example.com")
  recovery_fixture_shell("git -C '" + repo + "' config user.name test")
  recovery_fixture_shell("git -C '" + repo + "' checkout -q -b main")
  harness.fs.mkdir(path_join(repo, "crates", "harn-vm"), true)
  harness.fs.mkdir(path_join(repo, "crates", "harn-clock"), true)
  harness.fs.mkdir(path_join(repo, "changelog.d"), true)
  harness.fs.mkdir(path_join(repo, "scripts"), true)
  harness.fs.mkdir(release_target, true)
  harness.fs.write_text(
    path_join(repo, "Cargo.toml"),
    "[workspace]\nmembers = [\"crates/harn-clock\", \"crates/harn-vm\"]\n\n[workspace.package]\nversion = \"0.10.23\"\n",
  )
  harness.fs.write_text(
    clock_manifest,
    "[package]\nname = \"harn-clock\"\nversion.workspace = true\n",
  )
  harness.fs.write_text(
    vm_manifest,
    "[package]\nname = \"harn-vm\"\nversion.workspace = true\n\n[dependencies]\nharn-clock = { path = \"../harn-clock\", version = \"=0.10.23\" }\n",
  )
  harness.fs.write_text(
    path_join(repo, "Cargo.lock"),
    "name = \"harn-vm\"\nversion = \"0.10.23\"\n",
  )
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## Unreleased\n\n### Added\n\n- Shipped capability.\n\n## v0.10.23\n\n- Prior.\n",
  )
  harness.fs.write_text(old_fragment, "- Shipped capability.\n")
  harness.fs.write_text(
    release_gate,
    """
#!/bin/sh
set -eu
test "$1" = prepare
test "$2" = --bump
test "$3" = patch
test "$4" = --allow-dirty
python3 - <<'PY'
from pathlib import Path
root = Path("Cargo.toml")
root.write_text(root.read_text().replace('version = "0.10.23"', 'version = "0.10.24"'))
for path in [*Path("crates").glob("*/Cargo.toml"), Path("Cargo.lock")]:
    path.write_text(path.read_text().replace("0.10.23", "0.10.24"))
Path(".canonical-prepare-ran").write_text("ok\n")
PY
""",
  )
  recovery_fixture_shell("chmod +x '" + release_gate + "'")
  recovery_fixture_shell("git -C '" + repo + "' add .")
  recovery_fixture_shell("git -C '" + repo + "' commit -q -m pin")
  recovery_fixture_shell("git -C '" + repo + "' remote add origin '" + origin + "'")
  recovery_fixture_shell("git -C '" + repo + "' push -q -u origin main")
  recovery_fixture_shell("git -C '" + repo + "' checkout -q -b release-old")
  harness.fs.write_text(
    path_join(repo, "Cargo.toml"),
    replace(harness.fs.read_text(path_join(repo, "Cargo.toml")), "0.10.23", "0.10.24"),
  )
  harness.fs.write_text(
    vm_manifest,
    replace(harness.fs.read_text(vm_manifest), "0.10.23", "0.10.24"),
  )
  harness.fs.write_text(
    path_join(repo, "Cargo.lock"),
    replace(harness.fs.read_text(path_join(repo, "Cargo.lock")), "0.10.23", "0.10.24"),
  )
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    "# Changelog\n\n## v0.10.24\n\n### Added\n\n- Shipped capability.\n\n## v0.10.23\n\n- Prior.\n",
  )
  harness.fs.remove(old_fragment)
  recovery_fixture_shell("git -C '" + repo + "' add -u")
  recovery_fixture_shell("git -C '" + repo + "' commit -q -m 'Release v0.10.24'")
  const attempt = trim(recovery_fixture_shell("git -C '" + repo + "' rev-parse HEAD").stdout)
  recovery_fixture_shell("git -C '" + repo + "' checkout -q main")
  harness.fs.mkdir(path_join(repo, "crates", "harn-sqlite"), true)
  harness.fs.write_text(
    sqlite_manifest,
    "[package]\nname = \"harn-sqlite\"\nversion.workspace = true\n",
  )
  harness.fs.write_text(
    path_join(repo, "Cargo.toml"),
    replace(
      harness.fs.read_text(path_join(repo, "Cargo.toml")),
      "\"crates/harn-vm\"",
      "\"crates/harn-sqlite\", \"crates/harn-vm\"",
    ),
  )
  harness.fs.write_text(
    vm_manifest,
    replace(
      harness.fs.read_text(vm_manifest),
      "harn-clock = { path = \"../harn-clock\", version = \"=0.10.23\" }",
      "harn-clock = { path = \"../harn-clock\", version = \"=0.10.23\" }\nharn-sqlite = { path = \"../harn-sqlite\", version = \"=0.10.23\" }",
    ),
  )
  harness.fs.write_text(
    path_join(repo, "CHANGELOG.md"),
    replace(
      harness.fs.read_text(path_join(repo, "CHANGELOG.md")),
      "- Shipped capability.",
      "- Shipped capability.\n- Post-pin repair.",
    ),
  )
  harness.fs.write_text(new_fragment, "- Post-pin repair.\n")
  recovery_fixture_shell("git -C '" + repo + "' add .")
  recovery_fixture_shell("git -C '" + repo + "' commit -q -m 'post-pin sibling'")
  recovery_fixture_shell("git -C '" + repo + "' push -q origin main")
  const invalid_steps = execute_fixup_reconciliation(
    harness,
    {
      mock: false,
      quiet: true,
      repo: repo,
      base: "main",
      bump: "patch",
      bootstrap_new_crates: false,
      release_cargo_target_dir: release_target,
      fixup_publication: {head_oid: "deadbeef", remote_ref: "release-attempt/v0.10.24/deadbeef"},
    },
    {current_version: "0.10.23", next_version: "0.10.24"},
    [],
    "test-fixup-invalid-attempt-" + uuid_v7(),
  )
  assert_eq(invalid_steps.map({ step -> step.name }), ["fixup-list-prepare-commits"])
  assert_eq(invalid_steps[0].success, false)
  assert_eq(harness.fs.exists(path_join(repo, ".canonical-prepare-ran")), false)
  const version_mismatch_steps = execute_fixup_reconciliation(
    harness,
    {
      mock: false,
      quiet: true,
      repo: repo,
      base: "main",
      bump: "patch",
      bootstrap_new_crates: false,
      release_cargo_target_dir: release_target,
      fixup_publication: {head_oid: attempt, remote_ref: "release-attempt/v0.10.24/${attempt}"},
    },
    {current_version: "0.10.22", next_version: "0.10.24"},
    [],
    "test-fixup-version-mismatch-" + uuid_v7(),
  )
  assert_eq(
    version_mismatch_steps.map({ step -> step.name }),
    ["fixup-reconcile-fresh-base-release-metadata"],
  )
  assert_eq(version_mismatch_steps[0].success, false)
  assert_eq(harness.fs.exists(path_join(repo, ".canonical-prepare-ran")), false)
  assert_eq(trim(recovery_fixture_shell("git -C '" + repo + "' status --porcelain").stdout), "")
  const steps = execute_fixup_reconciliation(
    harness,
    {
      mock: false,
      quiet: true,
      repo: repo,
      base: "main",
      bump: "patch",
      bootstrap_new_crates: false,
      release_cargo_target_dir: release_target,
      fixup_publication: {head_oid: attempt, remote_ref: "release-attempt/v0.10.24/${attempt}"},
    },
    {current_version: "0.10.23", next_version: "0.10.24"},
    [],
    "test-fixup-reconcile-" + uuid_v7(),
  )
  assert_eq(
    steps.map({ step -> step.name }),
    ["fixup-reconcile-fresh-base-release-metadata", "fixup-cherry-pick-prepare-commits"],
  )
  assert(steps.all({ step -> step.success }))
  recovery_fixture_shell("git -C '" + repo + "' checkout HEAD -- CHANGELOG.md")
  const promoted = changelog_promote_pin_time_unreleased(
    harness.fs.read_text(path_join(repo, "CHANGELOG.md")),
    "0.10.24",
    "### Added\n\n- Shipped capability.",
  )
  assert_eq(promoted.success, true)
  harness.fs.write_text(path_join(repo, "CHANGELOG.md"), promoted.text)
  assert(contains(harness.fs.read_text(path_join(repo, "Cargo.toml")), "version = \"0.10.24\""))
  const reconciled_vm = harness.fs.read_text(vm_manifest)
  assert(
    contains(reconciled_vm, "harn-clock = { path = \"../harn-clock\", version = \"=0.10.24\" }"),
  )
  assert(
    contains(reconciled_vm, "harn-sqlite = { path = \"../harn-sqlite\", version = \"=0.10.24\" }"),
  )
  assert(contains(harness.fs.read_text(path_join(repo, "Cargo.lock")), "version = \"0.10.24\""))
  assert(contains(harness.fs.read_text(sqlite_manifest), "version.workspace = true"))
  const changelog = harness.fs.read_text(path_join(repo, "CHANGELOG.md"))
  assert_eq(len(regex_captures("(?m)^## v0[.]10[.]24$", changelog)), 1)
  assert_eq(len(regex_captures("Shipped capability", changelog)), 1)
  assert_eq(len(regex_captures("Post-pin repair", changelog)), 1)
  assert(contains(changelog, "## Unreleased\n\n- Post-pin repair."))
  assert_eq(harness.fs.exists(old_fragment), false)
  assert_eq(harness.fs.exists(new_fragment), true)
  assert_eq(harness.fs.exists(path_join(repo, ".canonical-prepare-ran")), true)
  recovery_fixture_shell("rm -rf '" + root + "'")
}
