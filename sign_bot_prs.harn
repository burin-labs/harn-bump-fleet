#!/usr/bin/env harn
//
// sign_bot_prs.harn - rewrite selected in-repo bot PR heads as signed commits
// when required-signatures rulesets block merge-queue admission.
//
// Default mode is dry-run. Live mode requires --live and never bypasses CI.
import { cli_options } from "lib/cli_options"
import { ensure_unrestricted_sandbox } from "lib/sandbox_preflight"
import {
  live_checkout_origin_check,
  load_pr_signature_metadata,
  load_queued_pr_numbers,
  maybe_enable_auto_merge,
  parse_pr_numbers,
  rewrite_command_plan,
  run_rewrite_commands,
  signed_bot_pr_decision,
  unsigned_commits,
} from "lib/signed_bot_prs"

type RawSignOptions = {
  repo: string,
  prs?: string,
  pr?: string,
  checkout: string,
  base: string,
  temp_root: string,
  trailer: string,
  live: bool,
  allow_non_bot: bool,
  allow_fork: bool,
  no_auto_merge: bool,
}

pub type SignOptions = {
  repo: string,
  prs: list<int>,
  checkout: string,
  base: string,
  temp_root: string,
  trailer: string,
  live: bool,
  allow_non_bot: bool,
  allow_fork: bool,
  auto_merge: bool,
}

const ARG_SPEC = {
  name: "sign-bot-prs",
  args: [
    {kind: "flag", name: "repo", long: "--repo", required: true},
    {kind: "flag", name: "prs", long: "--prs"},
    {kind: "flag", name: "pr", long: "--pr"},
    {kind: "flag", name: "checkout", long: "--checkout", default: ""},
    {kind: "flag", name: "base", long: "--base", default: "main"},
    {kind: "flag", name: "temp_root", long: "--temp-root", default: "/tmp/harn-signed-bot-prs"},
    {
      kind: "flag",
      name: "trailer",
      long: "--trailer",
      default: "Co-Authored-By: Codex <codex@openai.com>",
    },
    {kind: "switch", name: "live", long: "--live"},
    {kind: "switch", name: "allow_non_bot", long: "--allow-non-bot"},
    {kind: "switch", name: "allow_fork", long: "--allow-fork"},
    {kind: "switch", name: "no_auto_merge", long: "--no-auto-merge"},
  ],
}

pub fn parse_sign_args(args: list<string>) -> SignOptions {
  const parsed = cli_options<RawSignOptions>(ARG_SPEC, args, schema_of(RawSignOptions))
  const combined = join([parsed.pr ?? "", parsed.prs ?? ""].filter({ v -> trim(v) != "" }), ",")
  const prs = parse_pr_numbers(combined)
  if len(prs) == 0 {
    throw "--pr N or --prs N,N is required"
  }
  return {
    repo: parsed.repo,
    prs: prs,
    checkout: parsed.checkout,
    base: parsed.base,
    temp_root: parsed.temp_root,
    trailer: parsed.trailer,
    live: parsed.live,
    allow_non_bot: parsed.allow_non_bot,
    allow_fork: parsed.allow_fork,
    auto_merge: !parsed.no_auto_merge,
  }
}

fn options_from_cfg(cfg) {
  let out = {
    base: cfg.base,
    home: harness.env.get_or("HOME", ""),
    temp_root: cfg.temp_root,
    trailer: cfg.trailer,
    allow_non_bot: cfg.allow_non_bot,
    allow_fork: cfg.allow_fork,
  }
  if trim(cfg.checkout ?? "") != "" {
    out["checkout"] = cfg.checkout
  }
  return out
}

fn print_plan(pr, decision, plan) {
  if pr == nil {
    harness.stdio.println("PR: metadata unavailable")
    harness.stdio.println("  decision    : ${decision.action} - ${decision.detail}")
    return
  }
  harness.stdio.println("PR #${pr.number}: ${pr.title}")
  harness.stdio.println("  branch      : ${pr.head_ref_name}")
  harness.stdio.println("  head        : ${substring(pr.head_oid, 0, 12)}")
  harness.stdio.println("  author      : ${pr.author_login} (${pr.author_type})")
  harness.stdio.println("  unsigned    : ${decision.unsigned_count}")
  harness.stdio.println("  decision    : ${decision.action} - ${decision.detail}")
  if plan != nil {
    harness.stdio.println("  checkout    : ${plan.checkout}")
    harness.stdio.println("  temp        : ${plan.temp_path}")
    harness.stdio.println("  push guard  : refs/heads/${plan.branch}:${plan.old_head}")
  }
}

fn run_one(cfg, queued, pr_number) {
  const pr = load_pr_signature_metadata(cfg.repo, pr_number)
  const decision = signed_bot_pr_decision(pr, queued, options_from_cfg(cfg))
  const plan = if decision.eligible {
    rewrite_command_plan(cfg.repo, pr, options_from_cfg(cfg))
  } else {
    nil
  }
  print_plan(pr, decision, plan)
  if !decision.eligible {
    return {
      ok: decision.action == "already_signed",
      action: decision.action,
      pr: pr_number,
      detail: decision.detail,
    }
  }
  if !cfg.live {
    harness.stdio.println("  dry-run     : no branch rewrite performed")
    return {ok: true, action: "dry_run", pr: pr_number, detail: decision.detail}
  }
  const checkout_check = live_checkout_origin_check(plan.checkout, cfg.repo)
  if !checkout_check.ok {
    harness.stdio.eprintln("  checkout    : " + checkout_check.detail)
    return {ok: false, action: "checkout_mismatch", pr: pr_number, detail: checkout_check.detail}
  }
  const unsigned_before = unsigned_commits(pr).map({ c -> c.oid })
  harness.stdio.println("  live        : rewriting ${len(unsigned_before)} commit(s)")
  const result = run_rewrite_commands(plan)
  if !result.success {
    harness.stdio.eprintln("  failed      : " + result.failed_step)
    return {ok: false, action: "rewrite_failed", pr: pr_number, detail: result.failed_step}
  }
  const after = load_pr_signature_metadata(cfg.repo, pr_number)
  if after == nil {
    return {
      ok: false,
      action: "post_push_metadata_missing",
      pr: pr_number,
      detail: "could not reload PR metadata",
    }
  }
  const after_unsigned = unsigned_commits(after)
  harness.stdio.println(
    "  after       : head " + substring(after.head_oid, 0, 12) + ", unsigned="
      + to_string(
      len(after_unsigned),
    )
      + ", mergeState="
      + (after.merge_state_status ?? "unknown"),
  )
  if len(after_unsigned) > 0 {
    return {
      ok: false,
      action: "signature_unverified",
      pr: pr_number,
      detail: "unsigned commits remain after push",
    }
  }
  const auto_merge = maybe_enable_auto_merge(cfg.repo, pr_number, after.head_oid, cfg.auto_merge)
  if is_err(auto_merge) {
    const detail = to_string(unwrap_err(auto_merge))
    harness.stdio.eprintln("  auto-merge  : failed: " + detail)
    return {ok: false, action: "auto_merge_failed", pr: pr_number, detail: detail}
  }
  harness.stdio.println("  auto-merge  : " + auto_merge.state)
  return {ok: true, action: "rewritten", pr: pr_number, detail: "rewritten and auto-merge checked"}
}

pipeline main() {
  const preflight = ensure_unrestricted_sandbox(harness, "sign_bot_prs.harn")
  if preflight != nil {
    return preflight
  }
  const cfg = parse_sign_args(argv)
  const mode = if cfg.live {
    "live"
  } else {
    "dry-run"
  }
  harness.stdio.println("== signed bot PR rewrite")
  harness.stdio.println("   repo : ${cfg.repo}")
  harness.stdio.println("   base : ${cfg.base}")
  harness.stdio.println("   mode : ${mode}")
  const queued = load_queued_pr_numbers(cfg.repo, cfg.base)
  if len(queued) > 0 {
    harness.stdio.println("   queued PRs: " + join(queued.map({ n -> "#" + to_string(n) }), ", "))
  }
  let results = []
  for pr_number in cfg.prs {
    results = results + [run_one(cfg, queued, pr_number)]
  }
  const failures = results.filter({ r -> !r.ok })
  if len(failures) > 0 {
    harness.stdio.eprintln(
      "failed: " + join(failures.map({ r -> "#" + to_string(r.pr) + " " + r.action }), ", "),
    )
    return 1
  }
  return 0
}
