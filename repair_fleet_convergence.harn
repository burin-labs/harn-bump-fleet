#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { fleet_convergence_snapshot } from "lib/fleet_convergence"
import { read_fleet_manifest, scoped_harn_bump_repositories } from "lib/fleet_manifest"
import {
  FleetRepairPolicy,
  fleet_repair_plan,
  fleet_repair_repository_limit,
  repair_fleet_plan,
} from "lib/fleet_repair"
import { github_latest_release_tag } from "lib/github"
import { cost_budget_audit_line, install_cost_budget } from "lib/llm_defaults"

type Options = {
  target?: string,
  fleet_root: string,
  max_repositories?: int,
  max_attempts: int,
  max_tokens_per_attempt: int,
  only?: string,
}

const ARG_SPEC: ParserSpec = {
  name: "repair-fleet-convergence",
  args: [
    {kind: "positional", name: "target", required: false},
    {kind: "flag", name: "fleet_root", long: "--fleet-root", required: true},
    {kind: "flag", name: "max_repositories", long: "--max-repositories", parse: "int"},
    {kind: "flag", name: "max_attempts", long: "--max-attempts", parse: "int", default: 2},
    {kind: "flag", name: "only", long: "--only"},
    {
      kind: "flag",
      name: "max_tokens_per_attempt",
      long: "--max-tokens-per-attempt",
      parse: "int",
      default: 4000,
    },
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if !starts_with(options.fleet_root, "/") {
    throw "--fleet-root must be absolute"
  }
  const manifest = read_fleet_manifest(harness.fs)
  let repositories = scoped_harn_bump_repositories(manifest, options.only)
  const policy: FleetRepairPolicy = {
    max_repositories: fleet_repair_repository_limit(options.max_repositories, len(repositories)),
    max_attempts: options.max_attempts,
    max_tokens_per_attempt: options.max_tokens_per_attempt,
  }
  if policy.max_repositories < 1 || policy.max_attempts < 1
    || policy.max_tokens_per_attempt
    < 256 {
    throw "repair budgets must be positive and max tokens must be at least 256"
  }
  const cost_limit = install_cost_budget(
    {env: harness.env, llm: harness.llm},
    "HARN_EXT_FLEET_REPAIR_COST_LIMIT_USD",
  )
  harness.stdio.eprintln(cost_budget_audit_line(cost_limit))
  repositories = repositories.map(
    { repo -> repo + {directory: path_join(options.fleet_root, repo.directory)} },
  )
    .to_list()
  const target = options.target ?? github_latest_release_tag(harness, "burin-labs/harn")
  const snapshot = fleet_convergence_snapshot(harness, repositories, target)
  const receipt = repair_fleet_plan(
    harness,
    fleet_repair_plan(snapshot, repositories, policy),
    policy,
  )
  harness.stdio.println(
    json_stringify_pretty(
      receipt
        + {
        scope: if options.only == nil {
          {kind: "fleet"}
        } else {
          {kind: "repository", repository: options.only}
        },
      },
    ),
  )
  return if receipt.ok {
    0
  } else {
    1
  }
}
