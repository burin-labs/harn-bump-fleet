import { help_requested } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import {
  AdmissionReceipt,
  admission_merge_via_gh,
  admission_merge_via_rest,
  admission_receipt_line,
  admit_green_apply,
  admit_green_observe,
} from "lib/pr_admission"

type AdmitGreenOptions = {specs: string, head: string, required: string, apply: bool, json: bool}

const ARG_SPEC = {
  name: "admit-green",
  args: [
    {kind: "positional", name: "specs", required: true},
    {kind: "flag", name: "head", long: "--head", required: false, default: ""},
    {kind: "flag", name: "required", long: "--required", required: false, default: "CI status"},
    {kind: "switch", name: "apply", long: "--apply"},
    {kind: "switch", name: "json", long: "--json"},
  ],
}

pub type AdmitGreenSpec = {repo: string, pr: int}

/** Split `owner/name:123[,owner/name:124]` into typed targets. */
pub fn parse_admit_green_specs(raw: string) -> list<AdmitGreenSpec> {
  let specs = []
  for part in split(trim(raw ?? ""), ",") {
    const spec = trim(part)
    if spec == "" {
      continue
    }
    const parts = split(spec, ":")
    if len(parts) != 2 {
      throw "spec must look like owner/name:123, got '${spec}'"
    }
    const repo = trim(parts[0])
    const number = to_int(trim(parts[1]))
    if number == nil || number <= 0 || !contains(repo, "/") {
      throw "spec must look like owner/name:123, got '${spec}'"
    }
    specs = specs + [{repo: repo, pr: number}]
  }
  if len(specs) == 0 {
    throw "no pull request specs given"
  }
  return specs
}

pub fn parse_admit_green_args(args: list<string>) -> AdmitGreenOptions {
  const options = cli_options<AdmitGreenOptions>(ARG_SPEC, args, schema_of(AdmitGreenOptions))
  if options.apply && len(parse_admit_green_specs(options.specs)) > 1 && trim(options.head) != "" {
    throw "--head names one pull request's head; use it with a single spec"
  }
  return options
}

fn usage() {
  return "usage: harn run admit_green.harn -- owner/name:123[,owner/name:124] [--head <40-hex>] [--required \"CI status\"] [--apply] [--json]\n\nDry run by default: it prints the decision and merges nothing. --apply merges.\nThe GitHub reads need egress, so today it runs under `harn run --no-sandbox`."
}

pipeline main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(usage())
    return
  }
  const parsed = parse_admit_green_args(argv)
  const specs = parse_admit_green_specs(parsed.specs)
  const dry_run = !parsed.apply
  let receipts: list<AdmissionReceipt> = []
  for spec in specs {
    const verdict = admit_green_observe(
      harness,
      spec.repo,
      spec.pr,
      parsed.required,
      if len(specs) == 1 {
        parsed.head
      } else {
        ""
      },
    )
    const receipt = admit_green_apply(
      verdict,
      dry_run,
      { number, head -> return admission_merge_via_gh(harness.process, spec.repo, number, head) },
      { number, head -> return admission_merge_via_rest(harness.process, spec.repo, number, head) },
    )
    receipts = receipts + [receipt]
    if !parsed.json {
      harness.stdio.println(admission_receipt_line(receipt))
    }
  }
  if parsed.json {
    harness.stdio.println(json_stringify(receipts))
  }
}
