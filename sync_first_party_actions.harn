import {
  render_first_party_action_pins,
  validate_first_party_action_census,
} from "lib/first_party_actions"

/** Local workflow projection only; remote convergence remains Fleet's existing controller. */
fn main(harness: Harness) -> int {
  if argv != ["--check"] && argv != ["--apply"] {
    throw "usage: sync_first_party_actions.harn --check|--apply"
  }
  const directory = path_join(harness.fs.cwd(), ".github", "workflows")
  let references = 0
  let workflows = 0
  let changed = 0
  let actions: list<string> = []
  let changes: list<{path: string, source: string}> = []
  for name in harness.fs.list_dir(directory).sort() {
    if !ends_with(name, ".yml") && !ends_with(name, ".yaml") {
      continue
    }
    const path = path_join(directory, name)
    const source = harness.fs.read_text(path)
    const projection = render_first_party_action_pins(source)
    references = references + projection.references
    actions = actions + projection.actions
    workflows = workflows + 1
    if source != projection.source {
      changed = changed + 1
      harness.stdio.println("drift ${name}")
      changes = changes + [{path: path, source: projection.source}]
    }
  }
  validate_first_party_action_census(
    {workflows: workflows, references: references, actions: actions},
  )
  if argv == ["--apply"] {
    for change in changes {
      harness.fs.write_text(change.path, change.source)
    }
  }
  harness.stdio.println("${workflows} workflows, ${references} references, ${changed} changed")
  return if changed > 0 && argv == ["--check"] {
    1
  } else {
    0
  }
}
