<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent that keeps a healthy, unconfined sccache server running.
  Install with scripts/install_sccache_keepalive.sh, which substitutes
  __SCRIPT__ with the absolute path to scripts/sccache_keepalive.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.burincode.sccache-keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>
  <!-- Claim the daemon, unconfined, at login before any build runs. -->
  <key>RunAtLoad</key>
  <true/>
  <!-- Re-assert health every 2 minutes: heals a daemon a sandboxed build
       managed to poison, and respawns one that crashed. -->
  <key>StartInterval</key>
  <integer>120</integer>
  <key>StandardOutPath</key>
  <string>/tmp/sccache-keepalive.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/sccache-keepalive.log</string>
</dict>
</plist>
