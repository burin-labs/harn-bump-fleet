#!/usr/bin/env harn
//
// report_release_follow_through.harn — say, out loud and at the time it
// happens, whether the post-publication tail actually ran.
//
// A skipped promotion used to be a grey square in a job view. The orchestration
// anchor it writes has exactly one writer, so a promotion that never runs
// leaves every consumer pinned to the previous cycle with no signal anywhere.
// Pin staleness cannot supply that signal either: an anchor that was never
// written and an anchor that is merely trailing look identical from outside,
// and only one of them is fine.
//
// So this reports the tail's terminal state and exits non-zero when the
// promotion did not run — whatever the reason, including a publication prover
// that failed against a release which is genuinely published.
//
// Usage: harn run report_release_follow_through.harn -- \
//          --proof PATH --prover OUTCOME --promotion OUTCOME
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import {
  ReleasePublicationProof,
  post_publication_follow_through,
  post_publication_outcome,
} from "lib/release_publication_proof"

type Options = {proof: string, prover: string, promotion: string}

const ARG_SPEC: ParserSpec = {
  name: "report-release-follow-through",
  args: [
    {kind: "flag", name: "proof", long: "--proof", default: ""},
    {kind: "flag", name: "prover", long: "--prover", default: ""},
    {kind: "flag", name: "promotion", long: "--promotion", default: ""},
  ],
}

/**
 * Read the proof the publication step wrote, or nil.
 *
 * An absent, unreadable, or malformed proof is deliberately nil rather than a
 * throw: "no proof" is the exact input this report exists to turn into a loud
 * halt, so it must survive long enough to be reported.
 */
fn read_proof(fs: HarnessFs, path: string) -> ReleasePublicationProof? {
  if path == "" || !fs.exists(path) {
    return nil
  }
  const decoded = try {
    json_parse(fs.read_text(path))
  } catch (_error) {
    nil
  }
  if type_of(decoded) != "dict" || type_of(decoded?.published) != "bool" {
    return nil
  }
  return {
    schema_version: to_string(decoded?.schema_version ?? ""),
    tag: to_string(decoded?.tag ?? ""),
    published: decoded.published,
    reasons: (decoded?.reasons ?? []).map({ reason -> to_string(reason) }).to_list(),
    detail: to_string(decoded?.detail ?? ""),
  }
}

pipeline main(harness: Harness) -> int {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const proof = read_proof(harness.fs, trim(options.proof))
  const follow_through = post_publication_follow_through(proof, options.prover)
  const outcome = post_publication_outcome(follow_through, options.promotion)
  harness.stdio.println("## Post-publication follow-through")
  harness.stdio.println("")
  harness.stdio.println(outcome.headline)
  harness.stdio.println("")
  for line in outcome.lines {
    harness.stdio.println("- ${line}")
  }
  if outcome.status != 0 {
    harness.stdio.eprintln(outcome.headline)
    harness.stdio.eprintln(follow_through.message)
  }
  return outcome.status
}
