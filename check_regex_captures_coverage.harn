#!/usr/bin/env harn
//
// Census every `regex_captures` call site in this repository and report, per
// site, whether a test pipeline reaches the declaration that holds it.
//
// A call site that no test has ever run is untested against the shape defect
// this gate exists for, however much coverage surrounds it, because the only
// thing that falsifies a misreading of what `regex_captures` returns is running
// the real builtin. The census therefore reports the pending count and the
// uncovered names rather than a verdict, and separates a census that measured
// nothing from one that ran and found nothing to report.
import { read_json_typed_result } from "std/fs"
import { git_run } from "std/git"
import {
  CaptureCoverageExemption,
  ModuleSummary,
  census_refusals,
  coverage_census,
  ratchet_findings,
  summarize_module,
} from "lib/regex_captures_coverage"

const BASELINE_PATH = "regex-captures-coverage-baseline.json"

type HarnParseEnvelope = {ok: bool, data: any}

type CoverageBaseline = {
  schema_version: "harn_bump_fleet.regex_captures_coverage.v1",
  exemptions: list<CaptureCoverageExemption>,
}

fn tracked_harn_paths(output: string) -> list<string> {
  return split(output, "\0").filter({ path -> return ends_with(path, ".harn") }).to_list().sort()
}

pipeline main(harness: Harness) {
  const inventory = git_run(harness.process, ["ls-files", "-z", "*.harn"])
  if !inventory.ok {
    harness.stdio.eprintln(
      "regex_captures coverage: unable to inventory tracked modules: ${inventory.combined}",
    )
    return 1
  }
  const paths = tracked_harn_paths(inventory.stdout)
  let modules: list<ModuleSummary> = []
  let parse_failures: list<string> = []
  for path in paths {
    const parsed = harness.process.run({program: "harn", args: ["parse", "--json", path]})
    if !parsed.success {
      parse_failures = parse_failures + [path]
      continue
    }
    const document = json_parse(parsed.stdout)
    if !schema_is(document, schema_of(HarnParseEnvelope)) {
      parse_failures = parse_failures + [path]
      continue
    }
    const envelope = schema_expect(document, schema_of(HarnParseEnvelope))
    if !envelope.ok {
      parse_failures = parse_failures + [path]
      continue
    }
    modules = modules + [summarize_module(path, envelope.data)]
  }
  const census = coverage_census(modules)
  const refusals = census_refusals(census, parse_failures)
  if len(refusals) > 0 {
    harness.stdio.eprintln("regex_captures coverage: refused, the census is not trustworthy")
    for refusal in refusals {
      harness.stdio.eprintln("  ${refusal}")
    }
    return 1
  }
  const baseline_result = read_json_typed_result<CoverageBaseline>(
    harness.fs,
    BASELINE_PATH,
    schema_of(CoverageBaseline),
  )
  if is_err(baseline_result) {
    harness.stdio.eprintln(
      "regex_captures coverage: refused, could not read ${BASELINE_PATH}: "
        + "${to_string(unwrap_err(baseline_result))}",
    )
    return 1
  }
  const baseline = unwrap(baseline_result)
  harness.stdio.println(
    "regex_captures coverage: ${census.module_count} modules, ${census.site_count} call sites, "
      + "${census.covered_count} reached by a test, ${len(census.uncovered)} pending, "
      + "${len(baseline.exemptions)} baselined",
  )
  for site in census.uncovered {
    harness.stdio.println("  pending ${site.module}:${site.line} in `${site.function}`")
  }
  const findings = ratchet_findings(census, baseline.exemptions)
  if len(findings) > 0 {
    harness.stdio.eprintln("regex_captures coverage: ${len(findings)} finding(s)")
    for finding in findings {
      harness.stdio.eprintln("  ${finding}")
    }
    return 1
  }
  return 0
}
