#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { plan_fleet_dispatch } from "lib/fleet_dispatch"
import { read_fleet_manifest } from "lib/fleet_manifest"
import { wait_fleet_workflow_run } from "lib/fleet_workflow_run"
import { github_workflow_dispatch } from "lib/github"

type Options = {
  target: string,
  timeout_s: int,
  interval_s: int,
  no_wait: bool,
  only: string,
  chain_id: string,
}

const ARG_SPEC: ParserSpec = {
  name: "dispatch-fleet-convergence",
  args: [
    {kind: "positional", name: "target", required: true},
    {kind: "flag", name: "timeout_s", long: "--timeout-s", parse: "int", default: 10800},
    {kind: "flag", name: "interval_s", long: "--interval-s", parse: "int", default: 30},
    {kind: "switch", name: "no_wait", long: "--no-wait"},
    {kind: "flag", name: "only", long: "--only", default: ""},
    {kind: "flag", name: "chain_id", long: "--chain-id", default: ""},
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if options.timeout_s < 1 || options.interval_s < 1 {
    throw "fleet workflow timeout and interval must be positive"
  }
  const plan = plan_fleet_dispatch(
    read_fleet_manifest(harness.fs),
    options.target,
    options.only,
    options.chain_id,
  )
  const dispatched = github_workflow_dispatch(
    harness,
    "burin-labs/harn-bump-fleet",
    "bump-fleet.yml",
    plan.workflow_inputs,
  )
  if is_err(dispatched) {
    throw "fleet workflow dispatch failed: " + to_string(unwrap_err(dispatched))
  }
  const run = unwrap(dispatched)
  const receipt = if options.no_wait {
    {
      schema_version: "harn_bump_fleet.hosted_dispatch.v1",
      target: plan.target,
      scope: plan.scope,
      run_id: run.run_id,
      run_url: run.url,
      status: "dispatched",
      conclusion: "",
      controller_revision: nil,
      display_title: nil,
      elapsed_ms: 0,
      observation_attempts: 0,
      transient_retries: 0,
    }
  } else {
    wait_fleet_workflow_run(
      harness,
      plan.target,
      plan.scope,
      run.run_id,
      run.url,
      options.timeout_s,
      options.interval_s,
    )
  }
  harness.stdio.println(json_stringify_pretty(receipt))
  return if options.no_wait || (receipt.status == "completed" && receipt.conclusion == "success") {
    0
  } else {
    1
  }
}
