#!/usr/bin/env harn
import { help_requested } from "std/cli/argparse"
import { env_str } from "std/config"
import { cli_options } from "lib/cli_options"
import { run_release_ref_sweep } from "lib/release_ref_sweep"
import { ensure_unrestricted_sandbox } from "lib/sandbox_preflight"

pub type ReleaseRefSweepCliOptions = {
  repo: string,
  slug: string,
  receipt: string,
  apply: bool,
  yes_live_release: bool,
  json: bool,
}

const ARG_SPEC = {
  name: "sweep-release-refs",
  args: [
    {kind: "flag", name: "repo", long: "--repo", default: ""},
    {kind: "flag", name: "slug", long: "--slug", default: "burin-labs/harn"},
    {kind: "flag", name: "receipt", long: "--receipt", default: ""},
    {kind: "switch", name: "apply", long: "--apply"},
    {kind: "switch", name: "yes_live_release", long: "--yes-live-release"},
    {kind: "switch", name: "json", long: "--json"},
  ],
}

pub fn parse_release_ref_sweep_args(args: list<string>) -> ReleaseRefSweepCliOptions {
  const parsed = cli_options<ReleaseRefSweepCliOptions>(
    ARG_SPEC,
    args,
    schema_of(ReleaseRefSweepCliOptions),
  )
  if parsed.apply && !parsed.yes_live_release {
    throw "--apply requires --yes-live-release"
  }
  if len(split(trim(parsed.slug), "/")) != 2 {
    throw "--slug must be an owner/name repository"
  }
  return parsed
}

fn usage() {
  return """
Usage:
  harn run --no-sandbox sweep_release_refs.harn
  harn run --no-sandbox sweep_release_refs.harn -- --apply --yes-live-release

Inventories every release-prefixed local and remote Harn ref. The default is a
dry run. Apply mode deletes only exact content-addressed refs recoverable from
a verified signed tag and terminal hosted release; worktree-held, unique,
moved, unpublished, and malformed refs remain with an explicit reason.

Flags:
  --repo PATH           Harn checkout (default ~/projects/harn).
  --slug OWNER/REPO     Hosted repository (default burin-labs/harn).
  --receipt PATH        Durable JSON receipt path.
  --apply               Apply exact planned deletions; default is dry-run.
  --yes-live-release    Required with --apply.
  --json                Print the complete machine-readable receipt.
"""
}

pipeline main() {
  if help_requested(argv) {
    harness.stdio.println(usage())
    return 0
  }
  const sandbox_error = ensure_unrestricted_sandbox(harness, "sweep_release_refs.harn")
  if sandbox_error != nil {
    return sandbox_error
  }
  const parsed = parse_release_ref_sweep_args(argv)
  const repo = if trim(parsed.repo) != "" {
    parsed.repo
  } else {
    path_join(env_str("HOME") ?? "", "projects/harn")
  }
  const receipt_path = if trim(parsed.receipt) != "" {
    parsed.receipt
  } else {
    path_join(repo, ".harn/release-ref-sweep.json")
  }
  const result = run_release_ref_sweep(
    harness,
    {
      repo: repo,
      slug: parsed.slug,
      mode: if parsed.apply {
        "apply"
      } else {
        "dry_run"
      },
      receipt_path: receipt_path,
    },
  )
  if parsed.json {
    harness.stdio.println(json_stringify(result))
  } else {
    const deletions = result.refs.filter({ entry -> entry.action == "delete" }).count()
    const retained = result.refs.filter({ entry -> entry.action == "retain" }).count()
    harness.stdio.println("== release ref sweep: ${result.state}")
    harness.stdio.println("   disposable: ${deletions}")
    harness.stdio.println("   retained  : ${retained}")
    harness.stdio.println("   receipt   : ${receipt_path}")
    for entry in result.refs {
      harness.stdio.println("   ${entry.outcome} ${entry.resource} ${entry.name}: ${entry.message}")
    }
  }
  return if result.state == "blocked" {
    2
  } else {
    0
  }
}
