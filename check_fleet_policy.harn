#!/usr/bin/env harn
//
// Verify every remote default-branch projection against fleet.toml. This is
// the live complement to typed manifest validation and runs with the fleet App
// token immediately before scheduled bump dispatch.
import { parse_workflow_policy_reference, read_fleet_manifest } from "lib/fleet_manifest"
import {
  evaluate_file_projection,
  evaluate_fleet_policy,
  evaluate_workflow_policy_anchor,
} from "lib/fleet_policy"
import { github_file_text_at_ref } from "lib/github"

pipeline main() {
  const manifest = read_fleet_manifest()
  let results = []
  let failed = false
  let workflow_policies = []
  for policy in [
    {name: "package_workflow", reference: manifest.policy.package_workflow},
    {name: "bump_workflow", reference: manifest.policy.bump_workflow},
  ] {
    const parsed = parse_workflow_policy_reference(policy.reference)
    const pinned = github_file_text_at_ref(harness, parsed.slug, parsed.path, parsed.ref)
    const current = github_file_text_at_ref(
      harness,
      parsed.slug,
      parsed.path,
      manifest.fleet.default_branch,
    )
    const result = evaluate_workflow_policy_anchor(policy.name, policy.reference, pinned, current)
    workflow_policies = workflow_policies + [result]
    failed = failed || !result.ok
  }
  for repo in manifest.repositories {
    if !(repo.harn_package ?? false) && !(repo.harn_bump ?? false) {
      continue
    }
    const package_workflow = if repo.harn_package ?? false {
      github_file_text_at_ref(
        harness,
        repo.slug,
        ".github/workflows/ci.yml",
        manifest.fleet.default_branch,
      )
    } else {
      nil
    }
    const bump_workflow = if repo.harn_bump ?? false {
      github_file_text_at_ref(
        harness,
        repo.slug,
        ".github/workflows/bump-harn.yml",
        manifest.fleet.default_branch,
      )
    } else {
      nil
    }
    const result = evaluate_fleet_policy(manifest, repo, package_workflow, bump_workflow)
    results = results + [result]
    failed = failed || !result.ok
  }
  let file_projections = []
  for projection in manifest.file_projections {
    const source = github_file_text_at_ref(
      harness,
      projection.source_slug,
      projection.source_path,
      manifest.fleet.default_branch,
    )
    const target = github_file_text_at_ref(
      harness,
      projection.target_slug,
      projection.target_path,
      manifest.fleet.default_branch,
    )
    const result = evaluate_file_projection(projection, source, target)
    file_projections = file_projections + [result]
    failed = failed || !result.ok
  }
  harness.stdio.println(
    json_stringify_pretty(
      {
        schema_version: "harn.fleet-policy.v1",
        ok: !failed,
        policy: manifest.policy,
        workflow_policies: workflow_policies,
        checked_repository_count: len(results),
        repositories: results,
        file_projections: file_projections,
      },
    ),
  )
  return if failed {
    1
  } else {
    0
  }
}
