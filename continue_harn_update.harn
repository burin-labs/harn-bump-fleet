#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { fleet_chain_branch, fleet_chain_ref, require_fleet_chain_claim } from "lib/fleet_chain_ref"
import { github_claim_ref, github_release_ref, github_workflow_dispatch } from "lib/github"
import { harn_update_continuation, harn_update_proof_receipt_complete } from "lib/harn_update"

type Options = {
  target: string,
  proof_receipt: string,
  update_round: int,
  max_rounds: int,
  enable_repair: string,
  only?: string,
  chain_id: string,
  controller_revision: string,
}

const ARG_SPEC: ParserSpec = {
  name: "continue-harn-update",
  args: [
    {kind: "flag", name: "target", long: "--target", required: true},
    {kind: "flag", name: "proof_receipt", long: "--proof-receipt", required: true},
    {kind: "flag", name: "update_round", long: "--update-round", parse: "int", default: 1},
    {kind: "flag", name: "max_rounds", long: "--max-rounds", parse: "int", default: 4},
    {kind: "flag", name: "enable_repair", long: "--enable-repair", default: "true"},
    {kind: "flag", name: "only", long: "--only"},
    {kind: "flag", name: "chain_id", long: "--chain-id", required: true},
    {kind: "flag", name: "controller_revision", long: "--controller-revision", required: true},
  ],
}

fn repair_enabled(value: string) -> bool {
  const normalized = lowercase(trim(value))
  if normalized == "true" {
    return true
  }
  if normalized == "false" {
    return false
  }
  throw "--enable-repair must be true or false"
}

fn proof_complete(fs: HarnessFs, path: string) -> bool {
  const decoded = try {
    unwrap(json_parse(fs.read_text(path)))
  } catch (error) {
    throw "cannot read update proof receipt '${path}': " + to_string(error)
  }
  return harn_update_proof_receipt_complete(decoded)
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const continuation = harn_update_continuation(
    options.update_round,
    options.max_rounds,
    proof_complete(harness.fs, options.proof_receipt),
    repair_enabled(options.enable_repair),
  )
  let dispatch = nil
  let chain_claim = nil
  let chain_release = nil
  if continuation.continue {
    let fields = {
      version: options.target,
      update_round: to_string(continuation.next_round ?? 0),
      max_rounds: to_string(options.max_rounds),
      enable_repair: true,
    }
    if options.only != nil && trim(options.only ?? "") != "" {
      fields.only = options.only
    }
    fields.chain_id = options.chain_id
    const chain_id = options.chain_id
    const branch = fleet_chain_branch(chain_id)
    const claimed = github_claim_ref(
      harness,
      "burin-labs/harn-bump-fleet",
      fleet_chain_ref(chain_id),
      {oid: options.controller_revision},
    )
    if is_err(claimed) {
      throw "failed to lease the immutable Harn update controller: "
        + to_string(unwrap_err(claimed))
    }
    chain_claim = require_fleet_chain_claim(unwrap(claimed), chain_id, options.controller_revision)
    const started = github_workflow_dispatch(
      harness,
      "burin-labs/harn-bump-fleet",
      "bump-fleet.yml",
      fields,
      branch,
    )
    if is_err(started) {
      const released = github_release_ref(
        harness,
        "burin-labs/harn-bump-fleet",
        fleet_chain_ref(chain_id),
        options.controller_revision,
      )
      if is_err(released) || unwrap(released).reason == "held_by_another" {
        throw "failed to dispatch the next Harn update round and could not release its controller lease"
      }
      throw "failed to dispatch the next Harn update round: " + to_string(unwrap_err(started))
    }
    dispatch = unwrap(started)
  } else {
    const released = github_release_ref(
      harness,
      "burin-labs/harn-bump-fleet",
      fleet_chain_ref(options.chain_id),
      options.controller_revision,
    )
    if is_err(released) || unwrap(released).reason == "held_by_another" {
      throw "failed to release the immutable Harn update controller"
    }
    chain_release = unwrap(released)
  }
  harness.stdio.println(
    json_stringify_pretty(
      {
        schema_version: "harn_bump_fleet.harn_update_continuation.v2",
        target: options.target,
        update_round: options.update_round,
        max_rounds: options.max_rounds,
        proof_complete: proof_complete(harness.fs, options.proof_receipt),
        continuation: continuation,
        controller_revision: options.controller_revision,
        controller_ref: fleet_chain_ref(options.chain_id),
        chain_claim: chain_claim,
        chain_release: chain_release,
        dispatch: dispatch,
      },
    ),
  )
}
