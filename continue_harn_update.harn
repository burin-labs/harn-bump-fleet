#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { fleet_dispatch_scope } from "lib/fleet_dispatch_continuation"
import { read_fleet_manifest, scoped_harn_bump_repositories } from "lib/fleet_manifest"
import { github_claim_ref, github_release_ref, github_workflow_dispatch } from "lib/github"
import { harn_update_proof_receipt_complete_at } from "lib/harn_update"
import {
  HarnUpdateContinuationAdapter,
  HarnUpdateContinuationRequest,
  continue_harn_update_with_adapter,
} from "lib/harn_update_continuation"

type Options = {
  target: string,
  proof_receipt: string,
  update_round: int,
  max_rounds: int,
  enable_repair: string,
  only?: string,
  repositories_json?: string,
  chain_id: string,
  controller_revision: string,
  controller_run_id: int,
  controller_run_attempt: int,
}

const ARG_SPEC: ParserSpec = {
  name: "continue-harn-update",
  args: [
    {kind: "flag", name: "target", long: "--target", required: true},
    {kind: "flag", name: "proof_receipt", long: "--proof-receipt", required: true},
    {kind: "flag", name: "update_round", long: "--update-round", parse: "int", default: 1},
    {kind: "flag", name: "max_rounds", long: "--max-rounds", parse: "int", default: 4},
    {kind: "flag", name: "enable_repair", long: "--enable-repair", default: "true"},
    {kind: "flag", name: "only", long: "--only"},
    {kind: "flag", name: "repositories_json", long: "--repositories-json"},
    {kind: "flag", name: "chain_id", long: "--chain-id", required: true},
    {kind: "flag", name: "controller_revision", long: "--controller-revision", required: true},
    {
      kind: "flag",
      name: "controller_run_id",
      long: "--controller-run-id",
      parse: "int",
      required: true,
    },
    {
      kind: "flag",
      name: "controller_run_attempt",
      long: "--controller-run-attempt",
      parse: "int",
      required: true,
    },
  ],
}

fn repair_enabled(value: string) -> bool {
  const normalized = lowercase(trim(value))
  if normalized == "true" {
    return true
  }
  if normalized == "false" {
    return false
  }
  throw "--enable-repair must be true or false"
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  scoped_harn_bump_repositories(
    read_fleet_manifest(harness.fs),
    options.only,
    options.repositories_json,
  )
  const adapter: HarnUpdateContinuationAdapter = {
    claim: fn(ref, oid) { return github_claim_ref(
      harness,
      "burin-labs/harn-bump-fleet",
      ref,
      {oid: oid},
    ) },
    release: fn(ref, expected_oid) { return github_release_ref(
      harness,
      "burin-labs/harn-bump-fleet",
      ref,
      expected_oid,
    ) },
    dispatch: fn(fields, branch) { return github_workflow_dispatch(
      harness,
      "burin-labs/harn-bump-fleet",
      "bump-fleet.yml",
      fields,
      branch,
    ) },
  }
  let request: HarnUpdateContinuationRequest = {
    target: options.target,
    proof_complete: harn_update_proof_receipt_complete_at(
      {fs: harness.fs, stdio: harness.stdio},
      options.proof_receipt,
      if options.repositories_json == nil {
        nil
      } else {
        fleet_dispatch_scope(options.only, options.repositories_json)
      },
    ),
    update_round: options.update_round,
    max_rounds: options.max_rounds,
    repair_enabled: repair_enabled(options.enable_repair),
    chain_id: options.chain_id,
    controller_revision: options.controller_revision,
    controller_run_id: options.controller_run_id,
    controller_run_attempt: options.controller_run_attempt,
  }
  if options.only != nil {
    request.only = unwrap(options.only)
  }
  if options.repositories_json != nil {
    request.repositories_json = options.repositories_json
  }
  const receipt = continue_harn_update_with_adapter(request, adapter)
  harness.stdio.println(json_stringify_pretty(receipt))
  if receipt.status == "blocked" {
    throw "Harn update continuation blocked: " + (receipt.failure?.code ?? "unknown")
  }
}
