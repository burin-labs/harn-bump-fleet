import { help_requested } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { operator_pr_patrol } from "lib/operator_pr_patrol"

type OperatorPrPatrolOptions = {repo: string, pr: int, json: bool}

const ARG_SPEC = {
  name: "operator-pr-patrol",
  args: [
    {kind: "flag", name: "repo", long: "--repo", required: true},
    {kind: "flag", name: "pr", long: "--pr", required: true, parse: "int"},
    {kind: "switch", name: "json", long: "--json"},
  ],
}

pub fn parse_operator_pr_patrol_args(args: list<string>) -> OperatorPrPatrolOptions {
  const options = cli_options<OperatorPrPatrolOptions>(ARG_SPEC, args, schema_of(OperatorPrPatrolOptions))
  if options.pr <= 0 {
    throw "--pr must be a positive integer"
  }
  return options
}

fn usage() {
  return "usage: harn run operator_pr_patrol.harn -- --repo owner/name --pr 123 [--json]"
}

pipeline main() {
  if help_requested(argv) {
    harness.stdio.println(usage())
    return
  }
  const parsed = parse_operator_pr_patrol_args(argv)
  const row = operator_pr_patrol(parsed.repo, parsed.pr)
  if parsed.json {
    harness.stdio.println(json_stringify(row))
    return
  }
  harness.stdio
    .println(
    "${row.repo}#${row.pr_number}: ${row.human_action} (${row.reason}) checks=${row.check_state} merge=${row.merge_state} queue=${row.queue_state} head=${row.head_sha}",
  )
}
