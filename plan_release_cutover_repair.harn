#!/usr/bin/env harn
//
// Say what cutover pull request a stranded release would need, and open none.
//
// When a release publishes, its default branch must move to the next
// development version. A job inside the release-binary workflow opens that pull
// request, and when it does not, nothing notices until the next cut refuses on
// a precondition hours later naming causes that are not the reason. That has
// happened three times in the nine-release window this came from.
//
// This is the read half of the repair. It decides what is owed, looks for a
// cutover already open, and writes what it would do. It opens nothing, and its
// receipt says "would open" rather than "opened", so a dry run can never be
// mistaken in the record for a repair that happened.
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { github_file_text_at_ref, github_latest_release_tag, github_pr_list } from "lib/github"
import { harn_release_contract_from_text } from "lib/harn_release_contract"
import {
  ReleaseCutoverPlan,
  release_cutover_plan,
  release_cutover_plan_summary,
} from "lib/release_cutover_plan"
import {
  release_cutover_pr_is_ours,
  release_fold_owed,
  release_fold_repair_decision,
} from "lib/release_fold_repair"

type Options = {slug: string, base: string, receipt_out: string}

const ARG_SPEC: ParserSpec = {
  name: "plan-release-cutover-repair",
  args: [
    {kind: "flag", name: "slug", long: "--slug", default: "burin-labs/harn"},
    {kind: "flag", name: "base", long: "--base", default: "main"},
    {
      kind: "flag",
      name: "receipt_out",
      long: "--receipt-out",
      default: ".harn-runs/release-cutover-plan.json",
    },
  ],
}

/** The top version the changelog records, or "" when it records none. */
fn changelog_top_version(changelog: string) -> string {
  for line in split(changelog, "\n") {
    const heading = trim(line)
    if starts_with(heading, "## v") {
      return trim(heading[4:len(heading)])
    }
  }
  return ""
}

/** The workspace version the manifest declares, or "" when it declares none. */
fn workspace_version(cargo_toml: string) -> string {
  for line in split(cargo_toml, "\n") {
    const declaration = trim(line)
    if starts_with(declaration, "version = \"") {
      const rest = declaration[11:len(declaration)]
      const close = index_of(rest, "\"")
      if close > 0 {
        return rest[0:close]
      }
    }
  }
  return ""
}

/**
 * The cutover already open for this version, or "" when there is none.
 *
 * An unreadable pull request list throws rather than answering "none", because
 * "I could not look" and "I looked and there is none" select opposite actions:
 * the first must stop, and the second opens one.
 */
fn existing_cutover(harness: Harness, slug: string, development_version: string) -> string {
  const listed = github_pr_list(harness, slug, {state: "open", limit: 100})
  if is_err(listed) {
    throw "could not list open pull requests on ${slug}, so a cutover already open cannot be "
      + "ruled out: "
      + to_string(unwrap_err(listed))
  }
  for pr in unwrap(listed).pull_requests {
    if release_cutover_pr_is_ours(pr.head.ref, development_version) {
      return "${slug}#${to_string(pr.number)}"
    }
  }
  return ""
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const slug = trim(options.slug)
  const base = trim(options.base)
  const contract_text = github_file_text_at_ref(
    harness,
    slug,
    "scripts/release_contract.json",
    base,
  )
  if contract_text == nil {
    harness.stdio.eprintln("release cutover plan: ${slug}@${base} has no release contract")
    return 2
  }
  const contract = harn_release_contract_from_text(contract_text ?? "")
  if contract == nil {
    harness.stdio.eprintln(
      "release cutover plan: the release contract at ${slug}@${base} did "
        + "not parse",
    )
    return 2
  }
  const owed = release_fold_owed(
    contract ?? {},
    github_latest_release_tag(harness, slug),
    workspace_version(github_file_text_at_ref(harness, slug, "Cargo.toml", base) ?? ""),
    changelog_top_version(github_file_text_at_ref(harness, slug, "CHANGELOG.md", base) ?? ""),
  )
  const open_cutover = trim(owed.development_version) == "" ? "" : existing_cutover(
    harness,
    slug,
    owed.development_version,
  )
  const plan: ReleaseCutoverPlan = release_cutover_plan(
    release_fold_repair_decision(owed, {repository: slug, base: base}, open_cutover),
    slug,
  )
  harness.fs.write_text(options.receipt_out, json_stringify_pretty(plan) + "\n")
  harness.stdio.println(release_cutover_plan_summary(plan))
  return 0
}
