#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { is_absolute, normalize } from "std/path"
import { cli_options } from "lib/cli_options"
import {
  PublicMetadataEntry,
  private_metadata_tokens,
  public_metadata_hits,
} from "lib/public_metadata_scan"

type Options = {repository_dir: string, denylist: string}

const ARG_SPEC: ParserSpec = {
  name: "check-public-metadata",
  args: [
    {kind: "flag", name: "repository_dir", long: "--repository-dir", required: true},
    {kind: "flag", name: "denylist", long: "--denylist", required: true},
  ],
}

fn tracked_text_entries(
  host: {fs: HarnessFs, process: HarnessProcess},
  repository_dir: string,
) -> list<PublicMetadataEntry> {
  const listed = host.process.run({program: "git", args: ["ls-files", "-z"], cwd: repository_dir})
  if !listed.success {
    throw "could not enumerate the public repository"
  }
  let entries = []
  for path in split(listed.stdout, "\0") {
    if path == "" {
      continue
    }
    try {
      entries = entries
        + [{path: path, text: host.fs.read_text(path_join(repository_dir, path))}]
    } catch (_error) {
      // Binary and non-UTF-8 tracked files cannot carry the textual identifiers
      // this gate owns. Keep the scan filename-safe and continue.
    }
  }
  return entries
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const repository_dir = normalize(options.repository_dir)
  const denylist = normalize(options.denylist)
  if !is_absolute(repository_dir) || !is_absolute(denylist) {
    throw "repository and denylist paths must be absolute"
  }
  if denylist == repository_dir || starts_with(denylist, repository_dir + "/") {
    throw "the private denylist must live outside the public repository"
  }
  const tokens = private_metadata_tokens(harness.fs.read_text(denylist))
  const entries = tracked_text_entries({fs: harness.fs, process: harness.process}, repository_dir)
  const hits = public_metadata_hits(entries, tokens)
  for hit in hits {
    harness.stdio.println("${hit.path}:${to_string(hit.line)}: private identifier")
  }
  if len(hits) > 0 {
    harness.stdio.println(
      "public metadata check failed: ${to_string(len(hits))} location(s) across ${to_string(len(entries))} tracked text files",
    )
    return 1
  }
  harness.stdio.println(
    "public metadata check passed: 0 locations across ${to_string(len(entries))} tracked text files",
  )
  return 0
}
