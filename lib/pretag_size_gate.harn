import { fail, ok } from "./shell_util"
import {
  PreTagBinaryGateConfig,
  PreTagBinaryGateJob,
  PreTagBinaryGateRun,
  pre_tag_binary_gate_verdict,
} from "./workflow_runs"

pub type PreTagSizeGatePhase = "dispatch" | "inspect" | "complete"

pub type PreTagSizeGateResult = {
  success: bool,
  phase: PreTagSizeGatePhase,
  run_id?: int,
  completion_timeout_ms?: int,
  view_attempts?: int,
  transient_view_retries?: int,
  run_url: string,
  message: string,
}

pub type PreTagRunView = {run: PreTagBinaryGateRun, jobs: list<PreTagBinaryGateJob>}

fn gate_result(
  success: bool,
  phase: PreTagSizeGatePhase,
  message: string,
  run_id = nil,
  run_url = "",
  completion_timeout_ms = nil,
  view_attempts = nil,
  transient_view_retries = nil,
) -> PreTagSizeGateResult {
  const result: PreTagSizeGateResult = {
    success: success,
    phase: phase,
    run_id: run_id,
    completion_timeout_ms: completion_timeout_ms,
    view_attempts: view_attempts,
    transient_view_retries: transient_view_retries,
    run_url: run_url,
    message: message,
  }
  return result
}

pub fn pre_tag_size_gate_failure(message: string) -> PreTagSizeGateResult {
  return gate_result(false, "dispatch", message)
}

pub fn pre_tag_size_gate_command_result(result: PreTagSizeGateResult) {
  if result.success {
    return ok(result.message + "\n")
  }
  return fail(2, result.message)
}

pub fn pre_tag_size_gate_event(result: PreTagSizeGateResult) {
  return {
    success: result.success,
    phase: result.phase,
    run_id: result.run_id,
    completion_timeout_ms: result.completion_timeout_ms,
    view_attempts: result.view_attempts,
    transient_view_retries: result.transient_view_retries,
    run_url: result.run_url,
    message: result.message,
  }
}

/**
 * GitHub connector errors are normalized at this boundary. Only the
 * connector's explicit transport code can retry: malformed responses,
 * authorization, and terminal workflow evidence all remain fail-closed.
 */
fn is_transient_view_error(error) -> bool {
  return lowercase(trim(to_string(error?.code ?? ""))) == "network"
}

fn view_exact_run_with_transient_retry(config: PreTagBinaryGateConfig, adapter, run_id: int) {
  const max_attempts = if config.transient_view_retry_max_attempts > 0 {
    config.transient_view_retry_max_attempts
  } else {
    1
  }
  const base_delay_ms = if config.transient_view_retry_base_ms > 0 {
    config.transient_view_retry_base_ms
  } else {
    1
  }
  const cap_delay_ms = if config.transient_view_retry_cap_ms >= base_delay_ms {
    config.transient_view_retry_cap_ms
  } else {
    base_delay_ms
  }
  let attempts = 0
  let delay_ms = base_delay_ms
  let last_error = nil
  while attempts < max_attempts {
    const viewed = adapter.view_run(run_id)
    attempts = attempts + 1
    if !is_err(viewed) || !is_transient_view_error(unwrap_err(viewed)) {
      return {viewed: viewed, attempts: attempts, transient_retries: attempts - 1}
    }
    last_error = unwrap_err(viewed)
    if attempts < max_attempts {
      adapter.wait(delay_ms)
      delay_ms = min(delay_ms * 2, cap_delay_ms)
    }
  }
  return {viewed: Err(last_error), attempts: attempts, transient_retries: attempts - 1}
}

pub fn pre_tag_size_gate_started_event(config: PreTagBinaryGateConfig, dispatched) {
  return {
    workflow: config.workflow,
    event: config.event,
    ref: config.ref,
    expected_head_sha: config.expected_head_sha,
    target_job: config.target_job,
    required_step: config.required_step,
    benchmark_only: config.benchmark_only,
    runner_profile: config.runner_profile,
    targets: config.targets,
    completion_timeout_ms: config.completion_timeout_ms,
    completion_interval_ms: config.completion_interval_ms,
    transient_view_retry_max_attempts: config.transient_view_retry_max_attempts,
    transient_view_retry_base_ms: config.transient_view_retry_base_ms,
    transient_view_retry_cap_ms: config.transient_view_retry_cap_ms,
    run_id: dispatched.run_id,
    run_url: dispatched.url,
    observed_event: dispatched.event,
    observed_head_branch: dispatched.head_branch,
    observed_head_sha: dispatched.head_sha,
  }
}

/**
 * Execute the pre-tag gate against the exact workflow run identity returned by
 * dispatch. The adapter returns connector-owned typed records; no run-list
 * correlation, JSON parsing, or wall-clock discovery window is involved.
 */
pub fn run_pre_tag_size_gate(config: PreTagBinaryGateConfig, adapter, on_started = nil) -> PreTagSizeGateResult {
  const dispatched = adapter.dispatch(config)
  if is_err(dispatched) {
    return gate_result(false, "dispatch", to_string(unwrap_err(dispatched)))
  }
  if on_started != nil {
    on_started(pre_tag_size_gate_started_event(config, dispatched))
  }
  const run_id = dispatched.run_id
  const run_url = dispatched.url
  if dispatched.event != config.event || dispatched.head_branch != config.ref
    || lowercase(dispatched.head_sha) != lowercase(config.expected_head_sha) {
    return gate_result(
      false,
      "dispatch",
      "dispatch identity ${run_id} was ${dispatched.event} on ${dispatched.head_branch} at ${dispatched.head_sha}; expected ${config.event} on ${config.ref} at ${config.expected_head_sha}",
      run_id,
      run_url,
    )
  }
  let attempt = 0
  let view_attempts = 0
  let transient_view_retries = 0
  const max_attempts = config.completion_timeout_ms / config.completion_interval_ms
  while attempt < max_attempts {
    const view = view_exact_run_with_transient_retry(config, adapter, run_id)
    view_attempts = view_attempts + view.attempts
    transient_view_retries = transient_view_retries + view.transient_retries
    const viewed = view.viewed
    if is_err(viewed) {
      const retry_suffix = if transient_view_retries > 0 {
        " after ${transient_view_retries} transient status-read retries"
      } else {
        ""
      }
      return gate_result(
        false,
        "inspect",
        to_string(unwrap_err(viewed)) + retry_suffix,
        run_id,
        run_url,
        nil,
        view_attempts,
        transient_view_retries,
      )
    }
    const verdict = pre_tag_binary_gate_verdict(config, viewed.run, viewed.jobs)
    if verdict.action == "pass" || verdict.action == "fail" {
      const recovery_suffix = if transient_view_retries > 0 {
        " after ${transient_view_retries} transient status-read retries"
      } else {
        ""
      }
      return gate_result(
        verdict.action == "pass",
        "complete",
        verdict.message + recovery_suffix,
        run_id,
        viewed.run.url,
        nil,
        view_attempts,
        transient_view_retries,
      )
    }
    attempt = attempt + 1
    if attempt < max_attempts {
      adapter.wait(config.completion_interval_ms)
    }
  }
  return gate_result(
    false,
    "complete",
    "run ${run_id} did not complete within ${config.completion_timeout_ms}ms",
    run_id,
    run_url,
    config.completion_timeout_ms,
  )
}

/** Deterministic successful adapter used by release_harn's mock rehearsal. */
pub fn mock_pre_tag_size_gate_adapter(config: PreTagBinaryGateConfig) {
  const run_id = 701
  return {
    dispatch: fn(_config) { return {
      accepted: true,
      run_id: run_id,
      url: "https://github.test/run/${run_id}",
      event: config.event,
      head_branch: config.ref,
      head_sha: config.expected_head_sha,
    } },
    view_run: fn(_run_id) { return {
      run: {
        id: run_id,
        event: config.event,
        head_branch: config.ref,
        head_sha: config.expected_head_sha,
        status: "completed",
        conclusion: "success",
        url: "https://github.test/run/${run_id}",
      },
      jobs: [
        {
          name: config.target_job,
          status: "completed",
          conclusion: "success",
          steps: [{name: config.required_step, status: "completed", conclusion: "success"}],
        },
      ],
    } },
    wait: fn(_interval_ms) {
    },
  }
}
