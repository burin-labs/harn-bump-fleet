import { fail, ok } from "./shell_util"
import {
  PreTagBinaryGateConfig,
  PreTagBinaryGateJob,
  PreTagBinaryGateRun,
  pre_tag_binary_gate_verdict,
} from "./workflow_runs"

pub type PreTagSizeGatePhase = "dispatch" | "inspect" | "complete"

pub type PreTagSizeGateResult = {
  success: bool,
  phase: PreTagSizeGatePhase,
  run_id?: int,
  completion_timeout_ms?: int,
  run_url: string,
  message: string,
}

pub type PreTagRunView = {run: PreTagBinaryGateRun, jobs: list<PreTagBinaryGateJob>}

fn gate_result(
  success: bool,
  phase: PreTagSizeGatePhase,
  message: string,
  run_id = nil,
  run_url = "",
  completion_timeout_ms = nil,
) -> PreTagSizeGateResult {
  const result: PreTagSizeGateResult = {
    success: success,
    phase: phase,
    run_id: run_id,
    completion_timeout_ms: completion_timeout_ms,
    run_url: run_url,
    message: message,
  }
  return result
}

pub fn pre_tag_size_gate_failure(message: string) -> PreTagSizeGateResult {
  return gate_result(false, "dispatch", message)
}

pub fn pre_tag_size_gate_command_result(result: PreTagSizeGateResult) {
  if result.success {
    return ok(result.message + "\n")
  }
  return fail(2, result.message)
}

pub fn pre_tag_size_gate_event(result: PreTagSizeGateResult) {
  return {
    success: result.success,
    phase: result.phase,
    run_id: result.run_id,
    completion_timeout_ms: result.completion_timeout_ms,
    run_url: result.run_url,
    message: result.message,
  }
}

/**
 * Execute the pre-tag gate against the exact workflow run identity returned by
 * dispatch. The adapter returns connector-owned typed records; no run-list
 * correlation, JSON parsing, or wall-clock discovery window is involved.
 */
pub fn run_pre_tag_size_gate(config: PreTagBinaryGateConfig, adapter) -> PreTagSizeGateResult {
  const dispatched = adapter.dispatch(config)
  if is_err(dispatched) {
    return gate_result(false, "dispatch", to_string(unwrap_err(dispatched)))
  }
  const run_id = dispatched.run_id
  const run_url = dispatched.url
  if dispatched.event != config.event || dispatched.head_branch != config.ref
    || lowercase(dispatched.head_sha) != lowercase(config.expected_head_sha) {
    return gate_result(
      false,
      "dispatch",
      "dispatch identity ${run_id} was ${dispatched.event} on ${dispatched.head_branch} at ${dispatched.head_sha}; expected ${config.event} on ${config.ref} at ${config.expected_head_sha}",
      run_id,
      run_url,
    )
  }
  let attempt = 0
  const max_attempts = config.completion_timeout_ms / config.completion_interval_ms
  while attempt < max_attempts {
    const viewed = adapter.view_run(run_id)
    if is_err(viewed) {
      return gate_result(false, "inspect", to_string(unwrap_err(viewed)), run_id, run_url)
    }
    const verdict = pre_tag_binary_gate_verdict(config, viewed.run, viewed.jobs)
    if verdict.action == "pass" || verdict.action == "fail" {
      return gate_result(verdict.action == "pass", "complete", verdict.message, run_id, viewed.run.url)
    }
    attempt = attempt + 1
    if attempt < max_attempts {
      adapter.wait(config.completion_interval_ms)
    }
  }
  return gate_result(
    false,
    "complete",
    "run ${run_id} did not complete within ${config.completion_timeout_ms}ms",
    run_id,
    run_url,
    config.completion_timeout_ms,
  )
}

/** Deterministic successful adapter used by release_harn's mock rehearsal. */
pub fn mock_pre_tag_size_gate_adapter(config: PreTagBinaryGateConfig) {
  const run_id = 701
  return {
    dispatch: fn(_config) { return {
      accepted: true,
      run_id: run_id,
      url: "https://github.test/run/${run_id}",
      event: config.event,
      head_branch: config.ref,
      head_sha: config.expected_head_sha,
    } },
    view_run: fn(_run_id) { return {
      run: {
        id: run_id,
        event: config.event,
        head_branch: config.ref,
        head_sha: config.expected_head_sha,
        status: "completed",
        conclusion: "success",
        url: "https://github.test/run/${run_id}",
      },
      jobs: [
        {
          name: config.target_job,
          status: "completed",
          conclusion: "success",
          steps: [{name: config.required_step, status: "completed", conclusion: "success"}],
        },
      ],
    } },
    wait: fn(_interval_ms) {
    },
  }
}
