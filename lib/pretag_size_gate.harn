import { CommandResult, command_result_fail, command_result_ok } from "std/command"
import { github_is_rate_limited_read_error, github_is_transient_read_error } from "./github"
import {
  PreTagBinaryGateConfig,
  PreTagBinaryGateJob,
  PreTagBinaryGateRun,
  pre_tag_binary_gate_verdict,
} from "./workflow_runs"

pub type PreTagSizeGatePhase = "dispatch" | "inspect" | "complete"

pub type PreTagSizeGateResult = {
  success: bool,
  phase: PreTagSizeGatePhase,
  run_id?: int,
  completion_timeout_ms?: int,
  view_attempts?: int,
  transient_view_retries?: int,
  run_url: string,
  message: string,
}

pub type PreTagSizeGateEvent = {
  success: bool,
  phase: PreTagSizeGatePhase,
  run_id: int?,
  completion_timeout_ms: int?,
  view_attempts: int?,
  transient_view_retries: int?,
  run_url: string,
  message: string,
}

pub type PreTagRunView = {run: PreTagBinaryGateRun, jobs: list<PreTagBinaryGateJob>}

pub type PreTagSizeGateError = {code: string, message: string, ...rest}

pub type PreTagSizeGateDispatch = {
  accepted: bool,
  run_id: int,
  url: string,
  event: string,
  head_branch: string,
  head_sha: string,
  reused?: bool,
}

pub type PreTagSizeGateStartedEvent = {
  workflow: string,
  event: string,
  policy_ref: string,
  expected_policy_sha: string,
  source_ref: string,
  expected_source_sha: string,
  target_job: string,
  required_source_step: string,
  required_fuse_step: string,
  required_size_step: string,
  benchmark_only: bool,
  runner_profile: string,
  targets: list<string>,
  completion_timeout_ms: int,
  completion_interval_ms: int,
  transient_view_retry_max_attempts: int,
  transient_view_retry_base_ms: int,
  transient_view_retry_cap_ms: int,
  run_id: int,
  run_url: string,
  observed_event: string,
  observed_head_branch: string,
  observed_head_sha: string,
  reused: bool,
}

pub type PreTagSizeGateDispatchResult = PreTagSizeGateDispatch \
  | Result<PreTagSizeGateDispatch, PreTagSizeGateError>

pub type PreTagRunViewResult = PreTagRunView | Result<PreTagRunView, PreTagSizeGateError>

pub type PreTagExistingRunResult = PreTagBinaryGateRun \
  | nil \
  | Result<PreTagBinaryGateRun?, PreTagSizeGateError>

pub type PreTagSizeGateAdapter = {
  dispatch: fn(PreTagBinaryGateConfig) -> PreTagSizeGateDispatchResult,
  view_run: fn(int) -> PreTagRunViewResult,
  wait: fn(int) -> nil,
  // Optional. When present, it answers "has this exact source already been
  // measured?" before anything is dispatched. A lookup that cannot answer must
  // return Ok(nil) or an Err, never a fabricated absence: reading "no prior
  // run" out of a failed lookup would turn every provider hiccup into a
  // repeated forty-minute build, which is the cost this exists to avoid.
  find_existing?: fn(PreTagBinaryGateConfig) -> PreTagExistingRunResult,
}

pub type PreTagSizeGateStartedHandler = fn(PreTagSizeGateStartedEvent) -> nil

pub type PreTagSizeReuseAction = "reuse" | "dispatch" | "refuse"

pub type PreTagSizeReuseDecision = {
  action: PreTagSizeReuseAction,
  reason: string,
  run_id: int,
  run_url: string,
}

/**
 * Decide what to do about a run that already measured this exact source.
 *
 * The gate dispatches a ~40-minute Linux build. Twice on the v0.10.126 cut it
 * dispatched that build for a commit an earlier attempt had already measured,
 * and the second dispatch re-derived the same arithmetic from the same bytes
 * and refused again. Both halves of that are addressed here, and they are the
 * same question asked once:
 *
 * - A terminal-green run for this source under this exact policy is proof. Take
 *   it and skip the build.
 * - A terminal-failed run for this source under this exact policy is also
 *   proof, of the other verdict. Re-dispatching cannot change it, so refuse
 *   with the reason instead of spending the build to be told again.
 * - An in-flight run is neither yet; adopt it and wait rather than starting a
 *   second one beside it.
 * - Anything measured under a DIFFERENT policy SHA says nothing about this
 *   release. The policy binding is the point of the gate, so that is a
 *   dispatch, not a reuse.
 * - A cancelled, stale, or startup-failed run never judged the code at all.
 */
pub fn pre_tag_size_reuse_decision(
  config: PreTagBinaryGateConfig,
  existing: PreTagBinaryGateRun?,
) -> PreTagSizeReuseDecision {
  if existing == nil {
    return {
      action: "dispatch",
      reason: "no prior run measured ${config.expected_source_sha}",
      run_id: 0,
      run_url: "",
    }
  }
  const run_id = existing.id
  const run_url = existing.url
  if existing.event != config.event || existing.head_branch != config.policy_ref
    || lowercase(existing.head_sha)
      != lowercase(config.expected_policy_sha) {
    return {
      action: "dispatch",
      reason:
        "run ${run_id} measured ${config.expected_source_sha} under a different policy identity (${existing.event} on ${existing.head_branch} at ${existing.head_sha}); this release requires ${config.event} on ${config.policy_ref} at ${config.expected_policy_sha}",
      run_id: run_id,
      run_url: run_url,
    }
  }
  if existing.status != "completed" {
    return {
      action: "reuse",
      reason:
        "run ${run_id} is already ${existing.status} for ${config.expected_source_sha} under this exact policy; adopting it instead of starting a second build",
      run_id: run_id,
      run_url: run_url,
    }
  }
  const conclusion = lowercase(trim(existing.conclusion ?? ""))
  if conclusion == "success" {
    return {
      action: "reuse",
      reason:
        "run ${run_id} already measured ${config.expected_source_sha} under this exact policy and succeeded",
      run_id: run_id,
      run_url: run_url,
    }
  }
  // A run that never judged the code says nothing about it. Everything else
  // did judge it, and judged it the same way the next build would.
  if ["cancelled", "stale", "startup_failure"].contains(conclusion) {
    return {
      action: "dispatch",
      reason:
        "run ${run_id} for ${config.expected_source_sha} concluded ${conclusion} without judging the source",
      run_id: run_id,
      run_url: run_url,
    }
  }
  return {
    action: "refuse",
    reason:
      "run ${run_id} already measured ${config.expected_source_sha} under policy ${config.policy_ref} at ${config.expected_policy_sha} and concluded ${conclusion}. That verdict is deterministic in the source and the policy, both of which are unchanged, so a second build would spend roughly forty minutes reproducing it. Fix the cause or move the policy; do not retry. ${run_url}",
    run_id: run_id,
    run_url: run_url,
  }
}

fn gate_result(
  success: bool,
  phase: PreTagSizeGatePhase,
  message: string,
  run_id: any = nil,
  run_url: any = "",
  completion_timeout_ms: any = nil,
  view_attempts: any = nil,
  transient_view_retries: any = nil,
) -> PreTagSizeGateResult {
  const result: PreTagSizeGateResult = {
    success: success,
    phase: phase,
    run_id: run_id,
    completion_timeout_ms: completion_timeout_ms,
    view_attempts: view_attempts,
    transient_view_retries: transient_view_retries,
    run_url: run_url,
    message: message,
  }
  return result
}

pub fn pre_tag_size_gate_failure(message: string) -> PreTagSizeGateResult {
  return gate_result(false, "dispatch", message)
}

pub fn pre_tag_size_gate_command_result(result: PreTagSizeGateResult) -> CommandResult {
  if result.success {
    return command_result_ok(result.message + "\n")
  }
  return command_result_fail(2, result.message)
}

pub fn pre_tag_size_gate_event(result: PreTagSizeGateResult) -> PreTagSizeGateEvent {
  const event: PreTagSizeGateEvent = {
    success: result.success,
    phase: result.phase,
    run_id: result.run_id,
    completion_timeout_ms: result.completion_timeout_ms,
    view_attempts: result.view_attempts,
    transient_view_retries: result.transient_view_retries,
    run_url: result.run_url,
    message: result.message,
  }
  return event
}

/**
 * GitHub connector errors are normalized at this boundary. Only the
 * connector's explicit transport code can retry: malformed responses,
 * authorization, and terminal workflow evidence all remain fail-closed.
 */
fn view_exact_run_with_transient_retry(config: PreTagBinaryGateConfig, adapter: any, run_id: int) {
  const max_attempts = if config.transient_view_retry_max_attempts > 0 {
    config.transient_view_retry_max_attempts
  } else {
    1
  }
  const base_delay_ms = if config.transient_view_retry_base_ms > 0 {
    config.transient_view_retry_base_ms
  } else {
    1
  }
  const cap_delay_ms = if config.transient_view_retry_cap_ms >= base_delay_ms {
    config.transient_view_retry_cap_ms
  } else {
    base_delay_ms
  }
  let attempts = 0
  let delay_ms = base_delay_ms
  let last_error = nil
  while attempts < max_attempts {
    const viewed = adapter.view_run(run_id)
    attempts = attempts + 1
    if !is_err(viewed) || !github_is_transient_read_error(unwrap_err(viewed)) {
      return {viewed: viewed, attempts: attempts, transient_retries: attempts - 1}
    }
    last_error = unwrap_err(viewed)
    if attempts < max_attempts {
      adapter.wait(delay_ms)
      delay_ms = min(delay_ms * 2, cap_delay_ms)
    }
  }
  return {viewed: Err(last_error), attempts: attempts, transient_retries: attempts - 1}
}

fn pre_tag_size_gate_started_event(config: PreTagBinaryGateConfig, dispatched: any) {
  return {
    workflow: config.workflow,
    event: config.event,
    policy_ref: config.policy_ref,
    expected_policy_sha: config.expected_policy_sha,
    source_ref: config.source_ref,
    expected_source_sha: config.expected_source_sha,
    target_job: config.target_job,
    required_source_step: config.required_source_step,
    required_fuse_step: config.required_fuse_step,
    required_size_step: config.required_size_step,
    benchmark_only: config.benchmark_only,
    runner_profile: config.runner_profile,
    targets: config.targets,
    completion_timeout_ms: config.completion_timeout_ms,
    completion_interval_ms: config.completion_interval_ms,
    transient_view_retry_max_attempts: config.transient_view_retry_max_attempts,
    transient_view_retry_base_ms: config.transient_view_retry_base_ms,
    transient_view_retry_cap_ms: config.transient_view_retry_cap_ms,
    run_id: dispatched.run_id,
    run_url: dispatched.url,
    observed_event: dispatched.event,
    observed_head_branch: dispatched.head_branch,
    observed_head_sha: dispatched.head_sha,
    reused: dispatched.reused ?? false,
  }
}

/**
 * Acquire the run this gate will judge: an existing one when the source was
 * already measured under this exact policy, a refusal when that measurement
 * already failed, and otherwise a fresh dispatch.
 */
fn acquire_pre_tag_size_run(
  config: PreTagBinaryGateConfig,
  adapter: PreTagSizeGateAdapter,
) -> Result<PreTagSizeGateDispatch, PreTagSizeGateResult> {
  if adapter.find_existing != nil {
    const looked_up = adapter.find_existing(config)
    if is_err(looked_up) {
      return Err(
        gate_result(
          false,
          "dispatch",
          "could not determine whether ${config.expected_source_sha} was already measured: "
            + to_string(unwrap_err(looked_up)),
        ),
      )
    }
    const existing = if is_ok(looked_up) {
      unwrap(looked_up)
    } else {
      looked_up
    }
    const decision = pre_tag_size_reuse_decision(config, existing)
    if decision.action == "refuse" {
      return Err(gate_result(false, "dispatch", decision.reason, decision.run_id, decision.run_url))
    }
    if decision.action == "reuse" && existing != nil {
      return Ok(
        {
          accepted: true,
          run_id: existing.id,
          url: existing.url,
          event: existing.event,
          head_branch: existing.head_branch,
          head_sha: existing.head_sha,
          reused: true,
        },
      )
    }
  }
  const dispatched = adapter.dispatch(config)
  if is_err(dispatched) {
    return Err(gate_result(false, "dispatch", to_string(unwrap_err(dispatched))))
  }
  return Ok(
    if is_ok(dispatched) {
      unwrap(dispatched)
    } else {
      dispatched
    },
  )
}

/**
 * Execute the pre-tag gate against the exact workflow run identity returned by
 * dispatch. The adapter returns connector-owned typed records; no run-list
 * correlation, JSON parsing, or wall-clock discovery window is involved.
 */
pub fn run_pre_tag_size_gate(
  config: PreTagBinaryGateConfig,
  adapter: PreTagSizeGateAdapter,
  on_started: PreTagSizeGateStartedHandler? = nil,
) -> PreTagSizeGateResult {
  const acquired = acquire_pre_tag_size_run(config, adapter)
  if is_err(acquired) {
    return unwrap_err(acquired)
  }
  const dispatched = unwrap(acquired)
  if on_started != nil {
    on_started(pre_tag_size_gate_started_event(config, dispatched))
  }
  const run_id = dispatched.run_id
  const run_url = dispatched.url
  if dispatched.event != config.event || dispatched.head_branch != config.policy_ref
    || lowercase(dispatched.head_sha)
      != lowercase(config.expected_policy_sha) {
    return gate_result(
      false,
      "dispatch",
      "dispatch policy identity ${run_id} was ${dispatched.event} on ${dispatched.head_branch} at ${dispatched.head_sha}; expected ${config.event} on ${config.policy_ref} at ${config.expected_policy_sha}",
      run_id,
      run_url,
    )
  }
  let attempt = 0
  let view_attempts = 0
  let transient_view_retries = 0
  const max_attempts = config.completion_timeout_ms / config.completion_interval_ms
  while attempt < max_attempts {
    const view = view_exact_run_with_transient_retry(config, adapter, run_id)
    view_attempts = view_attempts + view.attempts
    transient_view_retries = transient_view_retries + view.transient_retries
    const viewed = view.viewed
    if is_err(viewed) {
      // The connector already waits for short GitHub rate-limit windows. A
      // longer reset must consume the gate's normal polling budget rather
      // than aborting an otherwise healthy, exactly identified workflow run.
      // Semantic and authorization errors still fail closed below.
      if github_is_rate_limited_read_error(unwrap_err(viewed)) {
        transient_view_retries = transient_view_retries + 1
        attempt = attempt + 1
        if attempt < max_attempts {
          adapter.wait(config.completion_interval_ms)
        }
        continue
      }
      const retry_suffix = if transient_view_retries > 0 {
        " after ${transient_view_retries} transient status-read retries"
      } else {
        ""
      }
      return gate_result(
        false,
        "inspect",
        to_string(unwrap_err(viewed)) + retry_suffix,
        run_id,
        run_url,
        nil,
        view_attempts,
        transient_view_retries,
      )
    }
    const verdict = pre_tag_binary_gate_verdict(config, viewed.run, viewed.jobs)
    if verdict.action == "pass" || verdict.action == "fail" {
      const recovery_suffix = if transient_view_retries > 0 {
        " after ${transient_view_retries} transient status-read retries"
      } else {
        ""
      }
      return gate_result(
        verdict.action == "pass",
        "complete",
        verdict.message + recovery_suffix,
        run_id,
        viewed.run.url,
        nil,
        view_attempts,
        transient_view_retries,
      )
    }
    attempt = attempt + 1
    if attempt < max_attempts {
      adapter.wait(config.completion_interval_ms)
    }
  }
  return gate_result(
    false,
    "complete",
    "run ${run_id} did not complete within ${config.completion_timeout_ms}ms",
    run_id,
    run_url,
    config.completion_timeout_ms,
    view_attempts,
    transient_view_retries,
  )
}

/** Deterministic successful adapter used by release_harn's mock rehearsal. */
pub fn mock_pre_tag_size_gate_adapter(config: PreTagBinaryGateConfig) -> PreTagSizeGateAdapter {
  const run_id = 701
  return {
    dispatch: fn(_config) { return {
      accepted: true,
      run_id: run_id,
      url: "https://github.test/run/${run_id}",
      event: config.event,
      head_branch: config.policy_ref,
      head_sha: config.expected_policy_sha,
    } },
    view_run: fn(_run_id) { return {
      run: {
        id: run_id,
        event: config.event,
        head_branch: config.policy_ref,
        head_sha: config.expected_policy_sha,
        status: "completed",
        conclusion: "success",
        url: "https://github.test/run/${run_id}",
      },
      jobs: [
        {
          name: config.target_job,
          status: "completed",
          conclusion: "success",
          steps: [
            {name: config.required_source_step, status: "completed", conclusion: "success"},
            {name: config.required_fuse_step, status: "completed", conclusion: "success"},
            {name: config.required_size_step, status: "completed", conclusion: "success"},
          ],
        },
      ],
    } },
    wait: fn(_interval_ms) {
    },
  }
}
