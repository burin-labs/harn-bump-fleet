import {
  schema_closed_object,
  schema_field,
  schema_int,
  schema_list,
  schema_nullable,
  schema_string,
  schema_validator,
} from "std/schema"
import { pre_tag_binary_gate_list_args, pre_tag_binary_gate_view_args } from "./release_execution"
import { command_output, fail, ok } from "./shell_util"
import {
  PreTagBinaryGateConfig,
  PreTagBinaryGateJob,
  PreTagBinaryGateRun,
  PreTagBinaryGateStep,
  pre_tag_binary_gate_initial_state,
  pre_tag_binary_gate_transition,
} from "./workflow_runs"

pub type PreTagSizeGatePhase = "snapshot" | "dispatch" | "discover" | "inspect" | "complete"

pub type PreTagSizeGateResult = {
  success: bool,
  phase: PreTagSizeGatePhase,
  run_id?: int,
  completion_timeout_ms?: int,
  run_url: string,
  message: string,
}

pub type PreTagRunView = {run: PreTagBinaryGateRun, jobs: list<PreTagBinaryGateJob>}

type PreTagRunListParse = {success: bool, value: list<PreTagBinaryGateRun>, error: string}

type PreTagRunViewParse = {success: bool, value?: PreTagRunView, error: string}

fn gate_result(
  success: bool,
  phase: PreTagSizeGatePhase,
  message: string,
  run_id = nil,
  run_url = "",
  completion_timeout_ms = nil,
) -> PreTagSizeGateResult {
  const result: PreTagSizeGateResult = {
    success: success,
    phase: phase,
    run_id: run_id,
    completion_timeout_ms: completion_timeout_ms,
    run_url: run_url,
    message: message,
  }
  return result
}

pub fn pre_tag_size_gate_failure(message: string) -> PreTagSizeGateResult {
  return gate_result(false, "snapshot", message)
}

pub fn pre_tag_size_gate_command_result(result: PreTagSizeGateResult) {
  if result.success {
    return ok(result.message + "\n")
  }
  return fail(2, result.message)
}

pub fn pre_tag_size_gate_event(result: PreTagSizeGateResult) {
  return {
    success: result.success,
    phase: result.phase,
    run_id: result.run_id,
    completion_timeout_ms: result.completion_timeout_ms,
    run_url: result.run_url,
    message: result.message,
  }
}

/** Build the process adapter while keeping command construction in owned helpers. */
pub fn command_pre_tag_size_gate_adapter(
  config: PreTagBinaryGateConfig,
  slug: string,
  runner,
  dispatcher,
  waiter,
) {
  const list_args = pre_tag_binary_gate_list_args(slug, config)
  return {
    list_runs: fn() { return runner(list_args) },
    dispatch: fn(gate) { return dispatcher(gate) },
    view_run: fn(run_id) { return runner(pre_tag_binary_gate_view_args(slug, run_id)) },
    wait: fn(interval_ms) { waiter(interval_ms) },
  }
}

fn optional_string() {
  return schema_field(schema_nullable(schema_string()), false)
}

fn run_fields() {
  return {
    databaseId: schema_int(),
    event: schema_string(),
    headBranch: schema_string(),
    headSha: schema_string(),
    status: schema_string(),
    conclusion: schema_nullable(schema_string()),
    url: schema_string(),
  }
}

fn step_schema() {
  return schema_closed_object(
    {
      name: schema_string(),
      status: schema_string(),
      conclusion: schema_nullable(schema_string()),
      number: schema_field(schema_int(), false),
      startedAt: optional_string(),
      completedAt: optional_string(),
    },
  )
}

fn job_schema() {
  return schema_closed_object(
    {
      name: schema_string(),
      status: schema_string(),
      conclusion: schema_nullable(schema_string()),
      steps: schema_list(step_schema()),
      databaseId: schema_field(schema_int(), false),
      startedAt: optional_string(),
      completedAt: optional_string(),
      url: optional_string(),
    },
  )
}

fn decode_json_result(result) {
  if !result.success {
    return {success: false, value: nil, error: trim(command_output(result))}
  }
  const value = try {
    json_parse(result.stdout)
  } catch (e) {
    return {success: false, value: nil, error: "invalid GitHub JSON: " + to_string(e)}
  }
  return {success: true, value: value, error: ""}
}

fn normalized_run(value) -> PreTagBinaryGateRun {
  return {
    databaseId: value.databaseId,
    event: value.event,
    headBranch: value.headBranch,
    headSha: lowercase(value.headSha),
    status: lowercase(value.status),
    conclusion: lowercase(value.conclusion ?? ""),
    url: value.url,
  }
}

fn parse_run_list(result) -> PreTagRunListParse {
  const decoded = decode_json_result(result)
  if !decoded.success {
    return {success: false, value: [], error: decoded.error}
  }
  const report = schema_validator(schema_list(schema_closed_object(run_fields()))).report(decoded.value)
  if !report.ok {
    return {success: false, value: [], error: "invalid workflow-run list: " + join(report.errors, "; ")}
  }
  return {success: true, value: report.value.map({ run -> normalized_run(run) }), error: ""}
}

fn parse_run_view(result) -> PreTagRunViewParse {
  const decoded = decode_json_result(result)
  if !decoded.success {
    return {success: false, value: nil, error: decoded.error}
  }
  const schema = schema_closed_object(run_fields() + {jobs: schema_list(job_schema())})
  const report = schema_validator(schema).report(decoded.value)
  if !report.ok {
    return {success: false, value: nil, error: "invalid workflow-run view: " + join(report.errors, "; ")}
  }
  const value = report.value
  const jobs: list<PreTagBinaryGateJob> = value.jobs
    .map(
    { job -> return {
      name: job.name,
      status: lowercase(job.status),
      conclusion: lowercase(job.conclusion ?? ""),
      steps: job.steps
        .map(
        { step ->
          const normalized: PreTagBinaryGateStep = {name: step.name, status: lowercase(step.status), conclusion: lowercase(step.conclusion ?? "")}
          return normalized
        },
      )
        .to_list(),
    } },
  )
    .to_list()
  const view: PreTagRunView = {run: normalized_run(value), jobs: jobs}
  return {success: true, value: view, error: ""}
}

/**
 * Execute the pre-tag gate through injected GitHub/process operations.
 * `list_runs` and `view_run` return command-style JSON results; `dispatch`
 * returns a command-style success result; `wait` advances the caller's clock
 * between bounded discovery and completion attempts.
 */
pub fn run_pre_tag_size_gate(config: PreTagBinaryGateConfig, adapter) -> PreTagSizeGateResult {
  const before = parse_run_list(adapter.list_runs())
  if !before.success {
    return gate_result(false, "snapshot", before.error)
  }
  let state = pre_tag_binary_gate_initial_state(before.value)
  const dispatched = adapter.dispatch(config)
  if !dispatched.success {
    return gate_result(false, "dispatch", trim(command_output(dispatched)))
  }
  let observed = nil
  let attempt = 0
  const max_attempts = config.discovery_timeout_ms / config.discovery_interval_ms
  while attempt < max_attempts && observed == nil {
    const snapshot = parse_run_list(adapter.list_runs())
    if !snapshot.success {
      return gate_result(false, "discover", snapshot.error)
    }
    const next = pre_tag_binary_gate_transition(config, state, {runs: snapshot.value})
    state = next.state
    if next.action == "discover" {
      attempt = attempt + 1
      if attempt < max_attempts {
        adapter.wait(config.discovery_interval_ms)
      }
    } else {
      observed = next
    }
  }
  if observed == nil {
    return gate_result(
      false,
      "discover",
      "no exact ${config.workflow} dispatch appeared for ${config.ref} at ${config.expected_head_sha}",
    )
  }
  if observed.action == "fail" {
    return gate_result(false, "discover", observed.message, observed.state.run_id)
  }
  const run_id = observed.state.run_id
  if run_id == nil {
    return gate_result(false, "discover", "workflow discovery returned no exact run ID")
  }
  let completion_state = observed.state
  let completion_attempt = 0
  let verdict = nil
  let run_url = ""
  const completion_max_attempts = config.completion_timeout_ms / config.completion_interval_ms
  while completion_attempt < completion_max_attempts && verdict == nil {
    const viewed = parse_run_view(adapter.view_run(run_id))
    if !viewed.success || viewed.value == nil {
      return gate_result(false, "inspect", viewed.error, run_id, run_url)
    }
    const view: PreTagRunView = viewed.value
    run_url = view.run.url
    const next = pre_tag_binary_gate_transition(config, completion_state, {runs: [view.run], jobs: view.jobs})
    completion_state = next.state
    if next.action == "wait" || next.action == "inspect" {
      completion_attempt = completion_attempt + 1
      if completion_attempt < completion_max_attempts {
        adapter.wait(config.completion_interval_ms)
      }
    } else {
      verdict = next
    }
  }
  if verdict == nil {
    return gate_result(
      false,
      "complete",
      "run ${run_id} did not complete within ${config.completion_timeout_ms}ms",
      run_id,
      run_url,
      config.completion_timeout_ms,
    )
  }
  return gate_result(verdict.action == "pass", "complete", verdict.message, run_id, run_url)
}

/** Deterministic successful adapter used by release_harn's mock rehearsal. */
pub fn mock_pre_tag_size_gate_adapter(config: PreTagBinaryGateConfig) {
  let list_count = 0
  return {
    list_runs: fn() {
      list_count = list_count + 1
      const runs = if list_count == 1 {
        [
          {
            databaseId: 700,
            event: config.event,
            headBranch: config.ref,
            headSha: config.expected_head_sha,
            status: "completed",
            conclusion: "success",
            url: "https://github.test/run/700",
          },
        ]
      } else {
        [
          {
            databaseId: 701,
            event: config.event,
            headBranch: config.ref,
            headSha: config.expected_head_sha,
            status: "queued",
            conclusion: "",
            url: "https://github.test/run/701",
          },
        ]
      }
      return ok(json_stringify(runs))
    },
    dispatch: fn(_config) { return ok("") },
    view_run: fn(_run_id) { return ok(
      json_stringify(
        {
          databaseId: 701,
          event: config.event,
          headBranch: config.ref,
          headSha: config.expected_head_sha,
          status: "completed",
          conclusion: "success",
          url: "https://github.test/run/701",
          jobs: [
            {
              name: config.target_job,
              status: "completed",
              conclusion: "success",
              steps: [{name: config.required_step, status: "completed", conclusion: "success"}],
            },
          ],
        },
      ),
    ) },
    wait: fn(_interval_ms) {
    },
  }
}
