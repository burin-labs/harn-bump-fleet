/**
 * Which checks only a release runs, computed from the workflow definitions.
 *
 * The release's certification is worth something exactly to the extent that it
 * tests things the default branch's own required checks do not. On
 * burin-labs/harn the required set is two contexts, `CI status` and `drift`,
 * and `ci.yml` runs on push and pull request, so everything it covers is
 * already proved for any commit that reached main. The hosted certification
 * lanes are different: `windows-nightly.yml` and `macos-nightly.yml` trigger
 * only on a schedule and on dispatch, so their workspace test runs never see an
 * ordinary pull request. Those are the checks a drifted commit has not passed,
 * and they are the reason drift cannot simply be waved through.
 *
 * The rule is mechanical rather than a maintained list: a certification
 * workflow whose triggers include push, pull request, or merge group is already
 * covered by the branch, and a workflow that has none of those is release-only.
 * Nobody has to remember to update a table when a lane moves.
 *
 * `bears_on_all_paths` is deliberately the fail-closed answer. The shared
 * workflow projection carries triggers and jobs, not the `paths` filters that
 * would narrow which files a lane depends on, so this reports that a
 * release-only lane bears on every path. A narrower answer has to come from a
 * `paths:` filter on the lane itself, which is a change in the repository that
 * owns the lane, not an inference made here.
 */
import { GithubWorkflowProjection, github_projection_has_trigger } from "./github_workflow"

/** Triggers that prove the default branch already runs a workflow itself. */
const BRANCH_COVERED_TRIGGERS = ["push", "pull_request", "merge_group"]

/**
 * Triggers that prove an ordinary commit on the default branch already ran a
 * workflow, and that its result is therefore folded into the branch's own
 * required checks rather than owed separately.
 *
 * `pull_request` is deliberately absent. A workflow that runs on pull requests
 * but not on push or merge group reports on a commit's own head and nowhere
 * else, which is exactly the lane a drifted commit can be held to.
 */
const MAIN_COMMIT_TRIGGERS = ["push", "merge_group"]

/** Report whether an ordinary commit on the default branch runs this workflow. */
pub fn release_workflow_runs_on_main_commits(workflow: GithubWorkflowProjection) -> bool {
  for trigger in MAIN_COMMIT_TRIGGERS {
    if github_projection_has_trigger(workflow, trigger) {
      return true
    }
  }
  return false
}

pub type ReleaseOnlyCheckSet = {
  checks: list<string>,
  source_workflows: list<string>,
  bears_on_all_paths: bool,
  bearing_paths: list<string>,
}

fn job_check_names(workflow: GithubWorkflowProjection) -> list<string> {
  let names: list<string> = []
  for key in workflow.jobs.keys() {
    const job = workflow.jobs.get(key)
    const name = trim(to_string(job?.name ?? key))
    if name != "" && !names.contains(name) {
      names = names + [name]
    }
  }
  return names
}

/** Report whether the default branch runs this workflow on its own commits. */
pub fn release_only_workflow_is_branch_covered(workflow: GithubWorkflowProjection) -> bool {
  for trigger in BRANCH_COVERED_TRIGGERS {
    if github_projection_has_trigger(workflow, trigger) {
      return true
    }
  }
  return false
}

/**
 * Certification lanes that an ordinary pull request runs.
 *
 * The mirror image of the release-only set, and the one the evidence reader
 * needs. A lane that runs on pull requests can report on a drifted commit's own
 * head, so the release can require it there. A lane that does not run on pull
 * requests can never report, so requiring it would make the release wait for a
 * result nobody is going to produce.
 *
 * This is deliberately not "not release-only". Being covered by the branch is
 * not the same as being proved: these lanes are not required checks, so a
 * commit can merge while its lane is red or still running. Coverage says the
 * question is answerable; the evidence reader still has to ask it.
 *
 * A workflow an ordinary main commit already runs is excluded, no matter how
 * many jobs it defines. Its results reach the branch through the required
 * aggregate that covers them, so listing its job names here would hold a
 * drifted commit to obligations the branch itself never required. That is what
 * refused the v0.10.129 cut: `ci.yml` carries a pull-request trigger and
 * twenty-nine job names, one of which is path-gated `Deploy docs`.
 *
 * Empty until the lanes actually gain a pull-request trigger, which is what
 * makes this safe to land in either order: before that, no commit owes a lane
 * and nothing waits.
 */
pub fn release_pull_request_lane_set(
  workflows: list<{path: string, workflow: GithubWorkflowProjection}>,
) -> ReleaseOnlyCheckSet {
  let checks: list<string> = []
  let sources: list<string> = []
  for entry in workflows {
    if !github_projection_has_trigger(entry.workflow, "pull_request") {
      continue
    }
    // A workflow an ordinary main commit already runs contributes nothing here.
    // Its jobs are folded into the branch's own required aggregate, so naming
    // them individually adds no proof and turns every path-gated job into an
    // obligation the commit was never going to report.
    if release_workflow_runs_on_main_commits(entry.workflow) {
      continue
    }
    if !sources.contains(entry.path) {
      sources = sources + [entry.path]
    }
    for name in job_check_names(entry.workflow) {
      if !checks.contains(name) {
        checks = checks + [name]
      }
    }
  }
  return {
    checks: checks.sort(),
    source_workflows: sources.sort(),
    bears_on_all_paths: len(checks) > 0,
    bearing_paths: [],
  }
}

/**
 * The checks a release runs that the default branch never does.
 *
 * An empty result is a real answer only when every certification workflow is
 * branch-covered. A caller that could not read the workflows must not call this
 * with an empty list and read the empty result as "nothing extra to run".
 */
pub fn release_only_check_set(
  workflows: list<{path: string, workflow: GithubWorkflowProjection}>,
) -> ReleaseOnlyCheckSet {
  let checks: list<string> = []
  let sources: list<string> = []
  for entry in workflows {
    if release_only_workflow_is_branch_covered(entry.workflow) {
      continue
    }
    if !sources.contains(entry.path) {
      sources = sources + [entry.path]
    }
    for name in job_check_names(entry.workflow) {
      if !checks.contains(name) {
        checks = checks + [name]
      }
    }
  }
  return {
    checks: checks.sort(),
    source_workflows: sources.sort(),
    bears_on_all_paths: len(checks) > 0,
    bearing_paths: [],
  }
}
