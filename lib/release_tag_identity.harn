/** Immutable release-tag identity shared by publication and recovery paths. */
pub type ReleaseTagIdentityVerification = {
  success: bool,
  object_oid: string,
  embedded_tag: string,
  object_type: string,
  direct_target_oid: string,
  peeled_target_oid: string,
  signature_verified: bool,
  reason: string,
}

fn tag_header_value(contents: string, name: string) -> string {
  const prefix = name + " "
  for line in contents.split("\n") {
    if line == "" {
      break
    }
    if line.starts_with(prefix) {
      return trim(line.slice(len(prefix)))
    }
  }
  return ""
}

/**
 * Verify every immutable identity carried by one annotated release tag.
 * Callers gather Git observations; this pure owner keeps create, reuse, and
 * crash-recovery policy identical.
 */
pub fn release_tag_identity_verification(
  expected_tag: string,
  expected_object_oid: string,
  expected_target_oid: string,
  observed_object_oid: string,
  observed_peeled_target_oid: string,
  tag_contents: string,
  signature_verified: bool,
) -> ReleaseTagIdentityVerification {
  const object_oid = lowercase(trim(observed_object_oid))
  const expected_object = lowercase(trim(expected_object_oid))
  const direct_target_oid = lowercase(tag_header_value(tag_contents, "object"))
  const object_type = tag_header_value(tag_contents, "type")
  const embedded_tag = tag_header_value(tag_contents, "tag")
  const peeled_target_oid = lowercase(trim(observed_peeled_target_oid))
  const expected_target = lowercase(trim(expected_target_oid))
  let reason = "verified signed tag ${expected_tag} object ${object_oid} targets ${expected_target}"
  if object_oid == "" || object_oid != expected_object {
    reason = "release tag object ${object_oid} does not match expected object ${expected_object}"
  } else if object_type != "commit" {
    reason = "release tag ${expected_tag} directly targets object type ${object_type}, not commit"
  } else if embedded_tag != expected_tag {
    reason = "release tag object ${object_oid} embeds tag ${embedded_tag}, not ${expected_tag}"
  } else if direct_target_oid != expected_target {
    reason = "release tag ${expected_tag} directly targets ${direct_target_oid}, not ${expected_target}"
  } else if peeled_target_oid != expected_target {
    reason = "release tag ${expected_tag} peels to ${peeled_target_oid}, not ${expected_target}"
  } else if !signature_verified {
    reason = "release tag ${expected_tag} object ${object_oid} failed signature verification"
  }
  const success = object_oid != ""
    && object_oid == expected_object
    && object_type == "commit"
    && embedded_tag == expected_tag
    && direct_target_oid == expected_target
    && peeled_target_oid == expected_target
    && signature_verified
  return {
    success: success,
    object_oid: object_oid,
    embedded_tag: embedded_tag,
    object_type: object_type,
    direct_target_oid: direct_target_oid,
    peeled_target_oid: peeled_target_oid,
    signature_verified: signature_verified,
    reason: reason,
  }
}
