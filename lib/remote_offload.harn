/**
 * Optional remote offload of the heavy release audit to a self-hosted builder
 * (tornadough). `release_gate.sh audit` is the ~548s long pole and duplicates
 * what merge-queue CI already proved; `release_ship.sh --prepare` exposes
 * `--skip-audit` precisely so a caller that has independent proof can skip it.
 *
 * The offload runs that audit on the remote box. It is purely an optimization:
 * the ONLY outcome that skips the local audit is a definitively green remote
 * run. Every other outcome — host unreachable, ssh/rsync transport failure,
 * setup failure, or a red remote audit — falls back to the full local audit,
 * which is the correctness backstop. That makes the path fail-open by
 * construction: a down builder degrades to today's behavior, never an outage.
 *
 * The decisions and command builders are pure so the fallback can be exercised
 * without a reachable host.
 */
import { require_shell_arg, shell_join } from "./shell_util"

let DEFAULT_OFFLOAD_HOST = "tornadough"

let DEFAULT_REMOTE_DIR = "~/harn-release-audit"

/** ssh reachability probe: short connect timeout, no prompts, no-op remote. */
pub fn offload_probe_command(host) {
  let h = trim(host ?? "")
  return shell_join(["ssh", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes", h, "true"])
}

/**
 * Remote audit prerequisite probe. SSH reachability alone is not enough: a
 * builder without the release-gate tools will spend minutes compiling before
 * failing open to the local audit anyway.
 */
pub fn remote_audit_prereq_command(host) {
  let h = trim(host ?? "")
  let script = "set -e; missing=\"\"; "
    + "for tool in bash git cargo make python3 npm rg; do "
    + "command -v \"$tool\" >/dev/null 2>&1 || missing=\"$missing $tool\"; "
    + "done; "
    + "if [ -n \"$missing\" ]; then "
    + "echo \"missing remote audit tool(s):$missing\"; exit 2; "
    + "fi"
  return shell_join(["ssh", "-o", "BatchMode=yes", h, script])
}

/**
 * Resolve the release harness's offload default before probing a remote host.
 *
 * Live prepare/ship-pr runs are the expensive path, so they auto-attempt the
 * fail-open remote audit unless the operator explicitly requests local audit or
 * sets HARN_RELEASE_OFFLOAD_AUDIT=0. Plain read-only audit mode remains local
 * by default.
 */
pub fn release_audit_offload_enabled(inputs) {
  if inputs.local_audit ?? false {
    return false
  }
  if inputs.explicit_offload ?? false {
    return true
  }
  let env_offload = inputs.env_offload ?? nil
  if env_offload != nil {
    return env_offload
  }
  let mode = trim(inputs.mode ?? "audit")
  return (inputs.yes_live_release ?? false) && mode != "audit"
}

/**
 * Decide whether to attempt the remote audit. Remote only when the offload is
 * enabled, a host is configured, and the reachability probe succeeded.
 * Returns `{target, reason}` with target "remote" or "local".
 */
pub fn audit_offload_decision(inputs) {
  let enabled = inputs.enabled ?? false
  let host = trim(inputs.host ?? "")
  let probe_ok = inputs.probe_ok ?? false
  if !enabled {
    return {target: "local", reason: "audit offload disabled; running the audit locally"}
  }
  if host == "" {
    return {target: "local", reason: "no offload host configured; running the audit locally"}
  }
  if !probe_ok {
    return {target: "local", reason: "${host} unreachable; running the audit locally"}
  }
  return {target: "remote", reason: "${host} reachable; offloading the audit"}
}

/**
 * Decide whether a remote audit attempt earned a local-audit skip. Skip ONLY
 * on a clean setup plus an exit-0 audit; any failure (transport, setup, or a
 * red audit) keeps the local audit so it stays the backstop. Returns
 * `{skip_local_audit, reason}`.
 */
pub fn remote_audit_skip_decision(inputs) {
  let setup_ok = inputs.setup_ok ?? false
  let audit_status = inputs.audit_status ?? -1
  let host = trim(inputs.host ?? "remote")
  if !setup_ok {
    return {
      skip_local_audit: false,
      reason: "${host} audit setup (clone/fetch/checkout) failed; running the full audit locally",
    }
  }
  if audit_status == 0 {
    return {skip_local_audit: true, reason: "${host} audit passed; skipping the duplicate local audit"}
  }
  if audit_status == 255 {
    return {
      skip_local_audit: false,
      reason: "${host} audit connection dropped (ssh 255); running the full audit locally",
    }
  }
  return {
    skip_local_audit: false,
    reason: "${host} audit reported failure (exit ${audit_status}); running the full audit locally to confirm",
  }
}

/**
 * Build the remote setup command: idempotently clone, then fetch + checkout the
 * pinned commit in a managed scratch dir so the audit runs against the exact
 * release pin with the box's warm cargo cache. Pure string builder.
 */
pub fn remote_audit_setup_command(inputs) {
  let host = trim(inputs.host ?? "")
  let remote_dir = trim(inputs.remote_dir ?? "")
  let repo_url = trim(inputs.repo_url ?? "")
  let pin_sha = trim(inputs.pin_sha ?? "")
  let dir = if remote_dir == "" {
    DEFAULT_REMOTE_DIR
  } else {
    remote_dir
  }
  let dir_arg = require_shell_arg(dir, "remote audit dir")
  let repo_arg = require_shell_arg(repo_url, "remote audit repo url")
  let pin_arg = require_shell_arg(pin_sha, "remote audit pin sha")
  let script = "set -e; mkdir -p ${dir_arg}; cd ${dir_arg}; "
    + "if [ ! -d .git ]; then git clone ${repo_arg} . ; fi; "
    + "git fetch --tags --prune origin; "
    + "git reset --hard; "
    + "git clean -ffdx -e target/; "
    + "git checkout -q ${pin_arg}; "
    + "git reset --hard ${pin_arg}; "
    + "git clean -ffdx -e target/"
  return shell_join(["ssh", "-o", "BatchMode=yes", host, script])
}

/** Remote-side log file used by the audit command. */
pub fn remote_audit_log_path(inputs) {
  let remote_dir = trim(inputs.remote_dir ?? "")
  let dir = if remote_dir == "" {
    DEFAULT_REMOTE_DIR
  } else {
    remote_dir
  }
  return "${dir}/release-audit.offload.log"
}

/**
 * Build the remote audit command: run release_gate.sh audit in the scratch dir.
 * The full output is kept on the remote host and a failure tail is streamed
 * back to the local release log so fail-open has useful diagnostics.
 */
pub fn remote_audit_run_command(inputs) {
  let host = trim(inputs.host ?? "")
  let remote_dir = trim(inputs.remote_dir ?? "")
  let dir = if remote_dir == "" {
    DEFAULT_REMOTE_DIR
  } else {
    remote_dir
  }
  let log = "release-audit.offload.log"
  let dir_arg = require_shell_arg(dir, "remote audit dir")
  let log_arg = require_shell_arg(log, "remote audit log")
  let script = "cd ${dir_arg} && "
    + "./scripts/release_gate.sh audit > ${log_arg} 2>&1; "
    + "__harn_status=$?; "
    + "printf \"remote audit log: %s/%s\\n\" \"$PWD\" ${log_arg}; "
    + "if [ $__harn_status -ne 0 ]; then tail -n 80 ${log_arg}; fi; "
    + "exit $__harn_status"
  return shell_join(["ssh", "-o", "BatchMode=yes", host, script])
}

/** Resolve the configured offload host, defaulting to tornadough. */
pub fn resolve_offload_host(configured) {
  let h = trim(configured ?? "")
  if h == "" {
    return DEFAULT_OFFLOAD_HOST
  }
  return h
}
