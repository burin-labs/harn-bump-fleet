/**
 * Optional remote offload of the heavy release audit to self-hosted builders.
 * `release_gate.sh audit` is the ~548s long pole and duplicates
 * what merge-queue CI already proved; `release_ship.sh --prepare` exposes
 * `--skip-audit` precisely so a caller that has independent proof can skip it.
 *
 * The offload runs that audit on the remote box. By default, it is an
 * optimization: the ONLY outcome that skips the local audit is a definitively
 * green remote run. Every other outcome — host unreachable, ssh/rsync transport
 * failure, setup failure, or a red remote audit — falls back to the full local
 * audit, which is the correctness backstop. Operators can opt into fail-closed
 * behavior for dedicated release lanes where preserving the local machine is
 * more important than automatic fallback.
 *
 * The decisions and command builders are pure so the fallback can be exercised
 * without a reachable host.
 */
import { shell_heredoc_command, shell_join } from "./shell_util"

let DEFAULT_OFFLOAD_HOSTS = ["tornadough", "cattrick"]

let DEFAULT_REMOTE_DIR = "harn-release-audit"

let DEFAULT_MIN_FREE_GB = 120

let DEFAULT_MIN_AVAILABLE_MEM_GB = 8

let DEFAULT_MAX_ACTIVE_CARGO_PROCS = 0

fn remote_tool_path_prelude() {
  return join(
    ["PATH=\"$HOME/.cargo/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"", "export PATH"],
    "\n",
  )
}

/** Resolve the remote audit free-space floor. Invalid input keeps the default. */
pub fn resolve_remote_audit_min_free_gb(configured) {
  let parsed = to_int(trim(configured ?? ""))
  if parsed == nil || parsed <= 0 {
    return DEFAULT_MIN_FREE_GB
  }
  return parsed
}

/** ssh reachability probe: short connect timeout, no prompts, no-op remote. */
pub fn offload_probe_command(host) {
  let h = trim(host ?? "")
  return shell_join(["ssh", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes", h, "true"])
}

/**
 * Remote audit prerequisite probe. SSH reachability alone is not enough: a
 * builder without the release-gate tools will spend minutes compiling before
 * failing open to the local audit anyway. Require `cargo-nextest` explicitly:
 * Harn's `make test` has a plain `cargo test --workspace` fallback, but the
 * release offload path is only useful when it can use the bounded nextest
 * profile instead of silently taking the slow fallback.
 */
pub fn remote_audit_prereq_command(host) {
  let h = trim(host ?? "")
  let script = join(
    [
      "set -e",
      "missing=\"\"",
      "for tool in bash git cargo cargo-nextest make python3 npm rg; do",
      "  command -v \"$tool\" >/dev/null 2>&1 || missing=\"$missing $tool\"",
      "done",
      "if [ -n \"$missing\" ]; then",
      "  echo \"missing remote audit tool(s):$missing\"",
      "  exit 2",
      "fi",
    ],
    "\n",
  )
  return ssh_bash_stdin_command(h, [], script)
}

/**
 * Remote disk preflight. The release audit can materialize a large Cargo target
 * tree, so check the filesystem that backs the scratch dir before spending
 * minutes in Rust builds that are doomed to ENOSPC.
 */
pub fn remote_audit_disk_command(inputs) {
  let host = trim(inputs.host ?? "")
  let remote_dir = trim(inputs.remote_dir ?? "")
  let min_free_gb = inputs.min_free_gb ?? DEFAULT_MIN_FREE_GB
  let dir = if remote_dir == "" {
    DEFAULT_REMOTE_DIR
  } else {
    remote_dir
  }
  let script = join(
    [
      "set -e",
      "dir=$1",
      "min_gib=$2",
      "if [ \"$dir\" = \"~\" ]; then",
      "  dir=\"$HOME\"",
      "fi",
      "case \"$dir\" in",
      "  \"~/\"*) dir=\"$HOME/$(printf '%s' \"$dir\" | sed 's#^~/##')\" ;;",
      "esac",
      "case \"$min_gib\" in ''|*[!0-9]*) min_gib=" + to_string(DEFAULT_MIN_FREE_GB) + " ;; esac",
      "mkdir -p \"$dir\"",
      "min_kib=$((min_gib * 1024 * 1024))",
      "read_disk() {",
      "  avail_kib=$(df -Pk \"$dir\" | awk 'NR==2 {print $4}')",
      "  if [ -z \"$avail_kib\" ]; then",
      "    echo \"remote audit disk preflight could not read df output for $dir\"",
      "    exit 3",
      "  fi",
      "  target_kib=0",
      "  if [ -d \"$dir/target\" ]; then",
      "    target_kib=$(du -sk \"$dir/target\" | awk '{print $1}')",
      "  fi",
      "  avail_gib=$((avail_kib / 1024 / 1024))",
      "  target_gib=$((target_kib / 1024 / 1024))",
      "}",
      "read_disk",
      "printf 'remote audit disk: dir=%s avail_gib=%s min_gib=%s target_gib=%s\\n' \"$dir\" \"$avail_gib\" \"$min_gib\" \"$target_gib\"",
      "if [ \"$avail_kib\" -lt \"$min_kib\" ] && [ -d \"$dir/target\" ]; then",
      "  echo \"remote audit disk below minimum free space; pruning managed target cache\"",
      "  rm -rf \"$dir/target\"",
      "  read_disk",
      "  printf 'remote audit disk after prune: dir=%s avail_gib=%s min_gib=%s target_gib=%s\\n' \"$dir\" \"$avail_gib\" \"$min_gib\" \"$target_gib\"",
      "fi",
      "if [ \"$avail_kib\" -lt \"$min_kib\" ]; then",
      "  echo \"remote audit disk below minimum free space\"",
      "  exit 3",
      "fi",
    ],
    "\n",
  )
  return ssh_bash_stdin_command(host, [dir, to_string(min_free_gb)], script)
}

/**
 * Remote resource preflight. Disk and tool availability are necessary but not
 * sufficient: a self-hosted builder that is already running Cargo/Rust work can
 * spend minutes compiling, then lose to memory pressure or a shared cache lock
 * and force the release back to the slow local audit. Fail this preflight when
 * the builder is visibly busy so the fallback happens before the expensive
 * offload attempt.
 */
pub fn remote_audit_resource_command(inputs) {
  let host = trim(inputs.host ?? "")
  let remote_dir = trim(inputs.remote_dir ?? "")
  let min_mem_gb = inputs.min_mem_gb ?? DEFAULT_MIN_AVAILABLE_MEM_GB
  let max_active_cargo = inputs.max_active_cargo_procs ?? DEFAULT_MAX_ACTIVE_CARGO_PROCS
  let dir = if remote_dir == "" {
    DEFAULT_REMOTE_DIR
  } else {
    remote_dir
  }
  let script = join(
    [
      "set -e",
      "dir=$1",
      "min_mem_gib=$2",
      "max_active_cargo=$3",
      "if [ \"$dir\" = \"~\" ]; then",
      "  dir=\"$HOME\"",
      "fi",
      "case \"$dir\" in",
      "  \"~/\"*) dir=\"$HOME/$(printf '%s' \"$dir\" | sed 's#^~/##')\" ;;",
      "esac",
      "case \"$min_mem_gib\" in ''|*[!0-9]*) min_mem_gib=" + to_string(DEFAULT_MIN_AVAILABLE_MEM_GB)
        + " ;; esac",
      "case \"$max_active_cargo\" in ''|*[!0-9]*) max_active_cargo="
        + to_string(DEFAULT_MAX_ACTIVE_CARGO_PROCS)
        + " ;; esac",
      "cpu_count=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)",
      "load_1m=$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo unknown)",
      "mem_available_kib=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)",
      "swap_total_mib=$(awk '/SwapTotal:/ {print int($2 / 1024)}' /proc/meminfo 2>/dev/null || echo 0)",
      "swap_free_mib=$(awk '/SwapFree:/ {print int($2 / 1024)}' /proc/meminfo 2>/dev/null || echo 0)",
      "mem_available_gib=$((mem_available_kib / 1024 / 1024))",
      "active_cargo=$(ps -eo pid=,comm=,args= | awk -v dir=\"$dir\" 'index($0, dir) > 0 {next} $2 ~ /^(cargo|cargo-nextest|cargo-clippy|rustc|rustdoc|cc1|cc|clang|clang\\+\\+)$/ {count++; next} /release_gate[.]sh audit/ {count++; next} END {print count + 0}')",
      "printf 'remote audit resources: cpu_count=%s load_1m=%s mem_available_gib=%s min_mem_gib=%s swap_free_mib=%s swap_total_mib=%s active_cargo_procs=%s max_active_cargo_procs=%s\\n' \"$cpu_count\" \"$load_1m\" \"$mem_available_gib\" \"$min_mem_gib\" \"$swap_free_mib\" \"$swap_total_mib\" \"$active_cargo\" \"$max_active_cargo\"",
      "if [ \"$mem_available_kib\" -gt 0 ] && [ \"$mem_available_gib\" -lt \"$min_mem_gib\" ]; then",
      "  echo \"remote audit memory below minimum available GiB\"",
      "  exit 4",
      "fi",
      "if [ \"$active_cargo\" -gt \"$max_active_cargo\" ]; then",
      "  echo \"remote audit builder already has active Cargo/Rust work\"",
      "  ps -eo pid=,comm=,args= | awk -v dir=\"$dir\" 'index($0, dir) > 0 {next} $2 ~ /^(cargo|cargo-nextest|cargo-clippy|rustc|rustdoc|cc1|cc|clang|clang\\+\\+)$/ {print; next} /release_gate[.]sh audit/ {print; next}' | head -10 || true",
      "  exit 4",
      "fi",
      "if [ \"$swap_total_mib\" -gt 0 ] && [ \"$swap_free_mib\" -lt 512 ]; then",
      "  echo \"remote audit swap free below 512 MiB (warning)\"",
      "fi",
    ],
    "\n",
  )
  return ssh_bash_stdin_command(host, [dir, to_string(min_mem_gb), to_string(max_active_cargo)], script)
}

/**
 * Resolve the release harness's offload default before probing a remote host.
 *
 * Live prepare/ship-pr runs are the expensive path, so they auto-attempt the
 * fail-open remote audit unless the operator explicitly requests local audit or
 * sets HARN_RELEASE_OFFLOAD_AUDIT=0. Plain read-only audit mode remains local
 * by default.
 */
pub fn release_audit_offload_enabled(inputs) {
  if inputs.local_audit ?? false {
    return false
  }
  if inputs.explicit_offload ?? false {
    return true
  }
  let env_offload = inputs.env_offload ?? nil
  if env_offload != nil {
    return env_offload
  }
  let mode = trim(inputs.mode ?? "audit")
  return (inputs.yes_live_release ?? false) && mode != "audit"
}

/**
 * Decide whether to attempt the remote audit. Remote only when the offload is
 * enabled, a host is configured, and the reachability probe succeeded.
 * Returns `{target, reason}` with target "remote" or "local".
 */
pub fn audit_offload_decision(inputs) {
  let enabled = inputs.enabled ?? false
  let host = trim(inputs.host ?? "")
  let probe_ok = inputs.probe_ok ?? false
  if !enabled {
    return {target: "local", reason: "audit offload disabled; running the audit locally"}
  }
  if host == "" {
    return {target: "local", reason: "no offload host configured; running the audit locally"}
  }
  if !probe_ok {
    return {target: "local", reason: "${host} unreachable; running the audit locally"}
  }
  return {target: "remote", reason: "${host} reachable; offloading the audit"}
}

/**
 * Decide whether a remote audit attempt earned a local-audit skip. Skip ONLY
 * on a clean setup plus an exit-0 audit. Transport/setup failures can fall
 * back to another host or the local audit, but a red audit after successful
 * setup is an authoritative release failure; rerunning the same gate locally
 * just hides deterministic reds behind timing and burns the release lock.
 * Returns `{skip_local_audit, abort_release, reason}`.
 */
pub fn remote_audit_skip_decision(inputs) {
  let setup_ok = inputs.setup_ok ?? false
  let audit_status = inputs.audit_status ?? -1
  let host = trim(inputs.host ?? "remote")
  let require_remote = inputs.require_remote ?? false
  let fallback_action = trim(
    inputs.fallback_action
      ?? if require_remote {
      "remote audit is required, aborting instead of running the local fallback"
    } else {
      "running the full audit locally"
    },
  )
  if !setup_ok {
    if require_remote {
      return {
        skip_local_audit: false,
        abort_release: true,
        reason: "${host} audit setup (clone/fetch/checkout) failed; ${fallback_action}",
      }
    }
    return {
      skip_local_audit: false,
      abort_release: false,
      reason: "${host} audit setup (clone/fetch/checkout) failed; ${fallback_action}",
    }
  }
  if audit_status == 0 {
    return {
      skip_local_audit: true,
      abort_release: false,
      reason: "${host} audit passed; skipping the duplicate local audit",
    }
  }
  if audit_status == 255 {
    if require_remote {
      return {
        skip_local_audit: false,
        abort_release: true,
        reason: "${host} audit connection dropped (ssh 255); ${fallback_action}",
      }
    }
    return {
      skip_local_audit: false,
      abort_release: false,
      reason: "${host} audit connection dropped (ssh 255); ${fallback_action}",
    }
  }
  return {
    skip_local_audit: false,
    abort_release: true,
    reason: "${host} audit reported failure (exit ${audit_status}); aborting instead of re-running the same audit locally",
  }
}

/**
 * Build the remote setup+run command. The checkout mutation and the gate run
 * are intentionally one SSH session guarded by an atomic remote lease: two
 * release runs aimed at the same builder/dir must never reset or clean the same
 * checkout under each other.
 *
 * `gate_command` selects which release_gate phase runs on the freshly-checked-
 * out pin (default `./scripts/release_gate.sh audit`). It is a fixed, trusted
 * command string — never user/argv data — so interpolating it into the static
 * script body is safe and keeps runtime data (dir/repo/pin) in argv as before.
 * `log_name` names the remote log file so distinct phases don't clobber each
 * other's output.
 *
 * NOTE on `burin-remote-run`: the fleet's generic `~/.local/bin/burin-remote-run`
 * helper adds a coordination hw-post, a machine-wide `~/.burin/locks/build.lock`
 * flock, and a contention preflight, but it does NOT do the release-specific
 * work this builder needs — git init/fetch, pin checkout+reset+clean, the
 * per-checkout `.release-audit.lock` lease (distinct from the machine build
 * lock), and the failure header/tail log capture. It therefore does not cleanly
 * subsume this inline ssh, so the inline transport stays and the coordination
 * hw-post is added separately via `coordination_hw_post_command`.
 */
pub fn remote_audit_setup_and_run_command(inputs) {
  let host = trim(inputs.host ?? "")
  let remote_dir = trim(inputs.remote_dir ?? "")
  let repo_url = trim(inputs.repo_url ?? "")
  let pin_sha = trim(inputs.pin_sha ?? "")
  let gate_command = trim(inputs.gate_command ?? "")
  let gate = if gate_command == "" {
    "./scripts/release_gate.sh audit"
  } else {
    gate_command
  }
  let log_name = trim(inputs.log_name ?? "")
  let log = if log_name == "" {
    "release-audit.offload.log"
  } else {
    log_name
  }
  let dir = if remote_dir == "" {
    DEFAULT_REMOTE_DIR
  } else {
    remote_dir
  }
  let script = join(
    [
      "set -e",
      "dir=$1",
      "repo=$2",
      "pin=$3",
      "log=" + log,
      "if [ \"$dir\" = \"~\" ]; then",
      "  dir=\"$HOME\"",
      "fi",
      "case \"$dir\" in",
      "  \"~/\"*) dir=\"$HOME/$(printf '%s' \"$dir\" | sed 's#^~/##')\" ;;",
      "esac",
      "mkdir -p \"$dir\"",
      "cd \"$dir\"",
      "lock=.release-audit.lock",
      "if ! mkdir \"$lock\" 2>/dev/null; then",
      "  echo \"remote audit lease held: $PWD/$lock\"",
      "  if [ -f \"$lock/owner\" ]; then",
      "    echo \"--- remote audit lease owner ---\"",
      "    sed -n '1,80p' \"$lock/owner\"",
      "  fi",
      "  exit 5",
      "fi",
      "cleanup_remote_audit_lease() {",
      "  rm -rf \"$lock\"",
      "}",
      "trap cleanup_remote_audit_lease EXIT HUP INT TERM",
      "cat > \"$lock/owner\" <<LEASE_OWNER",
      "host=$(hostname 2>/dev/null || echo unknown)",
      "pid=$$",
      "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)",
      "dir=$PWD",
      "pin=$pin",
      "LEASE_OWNER",
      "if [ ! -d .git ]; then git init ; fi",
      "if git remote get-url origin >/dev/null 2>&1; then",
      "  git remote set-url origin \"$repo\"",
      "else",
      "  git remote add origin \"$repo\"",
      "fi",
      "git fetch --tags --prune origin",
      "if git rev-parse --verify HEAD >/dev/null 2>&1; then",
      "  git reset --hard",
      "  git clean -ffdx -e target/ -e .release-audit.lock/",
      "fi",
      "git checkout -q \"$pin\"",
      "git reset --hard \"$pin\"",
      "git clean -ffdx -e target/ -e .release-audit.lock/",
      "printf \"remote audit log: %s/%s\\n\" \"$PWD\" \"$log\"",
      "set +e",
      gate + " > \"$log\" 2>&1",
      "__harn_status=$?",
      "set -e",
      "if [ $__harn_status -ne 0 ]; then",
      "  echo \"--- remote audit failure header ---\"",
      "  sed -n '1,220p' \"$log\"",
      "  echo \"--- remote audit final tail ---\"",
      "  tail -n 160 \"$log\"",
      "fi",
      "exit $__harn_status",
    ],
    "\n",
  )
  return ssh_bash_stdin_command(host, [dir, repo_url, pin_sha], script)
}

/** Remote-side publish dry-run log file. */
let DEFAULT_PUBLISH_DRYRUN_LOG = "release-publish-dryrun.offload.log"

/**
 * Offload the publish dry-run (`./scripts/release_gate.sh publish --dry-run`,
 * i.e. `cargo publish --dry-run`) to the same remote builder and checkout the
 * audit uses. Reuses the setup+lease+log-capture harness with a distinct gate
 * command and log file. Same fail-open-to-local semantics apply: a caller only
 * skips the local dry-run on a definitively green remote run.
 */
pub fn remote_publish_dryrun_command(inputs) {
  return remote_audit_setup_and_run_command(
    {
      ...inputs,
      gate_command: "./scripts/release_gate.sh publish --dry-run",
      log_name: DEFAULT_PUBLISH_DRYRUN_LOG,
    },
  )
}

/**
 * Whether the publish dry-run should be offloaded to a remote builder. Mirrors
 * `release_audit_offload_enabled` but is independently gated so operators can
 * offload the audit without the dry-run (and vice versa). Off by default; opt in
 * with `explicit_offload` (`--offload-publish-dryrun`) or
 * `env_offload` (HARN_RELEASE_OFFLOAD_PUBLISH_DRYRUN=1). `local_publish` forces
 * local.
 */
pub fn release_publish_dryrun_offload_enabled(inputs) {
  if inputs.local_publish ?? false {
    return false
  }
  if inputs.explicit_offload ?? false {
    return true
  }
  let env_offload = inputs.env_offload ?? nil
  if env_offload != nil {
    return env_offload
  }
  return false
}

/**
 * Local coordination hw-post command, mirroring what `burin-remote-run` posts
 * before a remote run. Best-effort: guarded with `command -v burin-coord-post`
 * so it is a no-op when the helper is absent and never fails the release. Keeps
 * remote-run coordination a single source of truth even though the release
 * offload keeps its own inline ssh transport.
 */
pub fn coordination_hw_post_command(inputs) {
  let host = trim(inputs.host ?? "")
  let purpose = trim(inputs.purpose ?? "harn release remote run")
  let topic = trim(inputs.topic ?? "remote-run")
  let workdir = trim(inputs.workdir ?? "")
  var args = [
    "burin-coord-post",
    "--type",
    "hw",
    "--machine",
    host,
    "--topic",
    topic,
    "--purpose",
    purpose,
    "--ref",
    "ssh:${host}",
  ]
  if workdir != "" {
    args = args + ["--ref", workdir]
  }
  return "command -v burin-coord-post >/dev/null 2>&1 && " + shell_join(args) + " || true"
}

/** Remote-side log file used by the audit command. */
pub fn remote_audit_log_path(inputs) {
  let dir = remote_audit_dir(inputs.remote_dir ?? "")
  return "${dir}/release-audit.offload.log"
}

/** Extract the absolute remote-side log path printed by `remote_audit_setup_and_run_command`. */
pub fn remote_audit_log_path_from_output(output) {
  let matches = regex_captures("(?m)^remote audit log: (.+)$", output ?? "")
  if len(matches) == 0 {
    return ""
  }
  return trim(matches[0].groups[0])
}

/**
 * Structured remote audit metadata for run events and recorded steps.
 * `remote_log_path` prefers the path the remote shell printed after resolving
 * `cd`, then falls back to the configured scratch-dir path.
 */
pub fn remote_audit_context(inputs) {
  let output = inputs.output ?? ""
  let from_output = remote_audit_log_path_from_output(output)
  let remote_dir = remote_audit_dir(inputs.remote_dir ?? "")
  return {
    remote_host: trim(inputs.host ?? ""),
    remote_dir: remote_dir,
    remote_log_path: if from_output != "" {
      from_output
    } else {
      remote_audit_log_path({remote_dir: remote_dir})
    },
    diagnostic_output: trim(output),
  }
}

/** Resolve configured offload hosts, defaulting to the maintained builder order. */
pub fn resolve_offload_hosts(configured) {
  let raw = trim(configured ?? "")
  if raw == "" {
    return DEFAULT_OFFLOAD_HOSTS
  }
  return split(regex_replace_all("[,\\s]+", "\n", raw), "\n")
    .map({ host -> trim(host) })
    .filter({ host -> host != "" })
}

/** Resolve the first configured offload host. Prefer `resolve_offload_hosts` for new code. */
pub fn resolve_offload_host(configured) {
  return resolve_offload_hosts(configured)[0] ?? ""
}

fn remote_audit_dir(remote_dir) {
  let dir = trim(remote_dir ?? "")
  if dir == "" {
    return DEFAULT_REMOTE_DIR
  }
  return dir
}

fn ssh_bash_stdin_command(host, args, script) {
  return shell_heredoc_command(
    ["ssh", "-o", "BatchMode=yes", trim(host ?? ""), "bash", "-s", "--"] + (args ?? []),
    remote_tool_path_prelude() + "\n" + script,
    "HARN_REMOTE_SCRIPT",
  )
}
