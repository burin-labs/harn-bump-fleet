/** Pure helpers for classifying GitHub Actions workflow-run rows. */
pub type PreTagBinaryGateConfig = {
  workflow: string,
  event: string,
  policy_ref: string,
  expected_policy_sha: string,
  source_ref: string,
  expected_source_sha: string,
  target_job: string,
  required_source_step: string,
  required_size_step: string,
  benchmark_only: bool,
  runner_profile: string,
  targets: string,
  completion_timeout_ms: int,
  completion_interval_ms: int,
  transient_view_retry_max_attempts: int,
  transient_view_retry_base_ms: int,
  transient_view_retry_cap_ms: int,
}

pub type PreTagBinaryGateRun = {
  id: int,
  event: string,
  head_branch: string,
  head_sha: string,
  status: string,
  conclusion: string?,
  url: string,
}

pub type PreTagBinaryGateStep = {name: string, status: string, conclusion: string}

pub type PreTagBinaryGateJob = {
  name: string,
  status: string,
  conclusion: string,
  steps: list<PreTagBinaryGateStep>,
}

pub type PreTagBinaryGateAction = "wait" | "inspect" | "pass" | "fail"

pub type PreTagBinaryGateTransition = {action: PreTagBinaryGateAction, message: string}

pub type CreatedWorkflowRun = {created_at?: string, ...rest}

/** Return the newest canonical connector run created at or after `after_iso`. */
pub fn newest_workflow_run_after(
  runs: list<CreatedWorkflowRun>,
  after_iso: string,
) -> CreatedWorkflowRun? {
  const after = trim(after_iso)
  let best = nil
  for run in runs {
    if run.created_at != nil && run.created_at >= after {
      if best == nil || run.created_at > best.created_at {
        best = run
      }
    }
  }
  return best
}

fn transition(action: PreTagBinaryGateAction, message: string) -> PreTagBinaryGateTransition {
  return {action: action, message: message}
}

fn named_job(jobs: list<PreTagBinaryGateJob>, name: string) -> PreTagBinaryGateJob? {
  for job in jobs {
    if job.name == name {
      return job
    }
  }
  return nil
}

fn named_step(steps: list<PreTagBinaryGateStep>, name: string) -> PreTagBinaryGateStep? {
  for step in steps {
    if step.name == name {
      return step
    }
  }
  return nil
}

/** Decide the SHA-matched pre-tag binary-size gate from one exact run identity. */
pub fn pre_tag_binary_gate_verdict(
  config: PreTagBinaryGateConfig,
  run: PreTagBinaryGateRun,
  jobs: list<PreTagBinaryGateJob>?,
) -> PreTagBinaryGateTransition {
  if run.event != config.event || run.head_branch != config.policy_ref {
    return transition(
      "fail",
      "run ${run.id} policy identity changed to ${run.event} on ${run.head_branch}; expected ${config.event} on ${config.policy_ref}",
    )
  }
  if run.head_sha != lowercase(config.expected_policy_sha) {
    return transition(
      "fail",
      "observed run ${run.id} changed policy SHA to ${run.head_sha}; expected ${config.expected_policy_sha}",
    )
  }
  if run.status != "completed" {
    return transition("wait", "run ${run.id} is ${run.status}")
  }
  if run.conclusion != "success" {
    return transition(
      "fail",
      "run ${run.id} completed with conclusion ${run.conclusion}; refusing to create the release tag",
    )
  }
  if jobs == nil {
    return transition("inspect", "run ${run.id} succeeded; inspect target job execution")
  }
  const job = named_job(jobs, config.target_job)
  if job == nil || job.status != "completed" || job.conclusion != "success" {
    return transition(
      "fail",
      "run ${run.id} succeeded but target job `${config.target_job}` did not execute successfully",
    )
  }
  const source_step = named_step(job.steps, config.required_source_step)
  if source_step == nil
    || source_step.status != "completed"
    || source_step.conclusion != "success" {
    return transition(
      "fail",
      "run ${run.id} target job did not verify the immutable source in `${config.required_source_step}`",
    )
  }
  const size_step = named_step(job.steps, config.required_size_step)
  if size_step == nil || size_step.status != "completed" || size_step.conclusion != "success" {
    return transition(
      "fail",
      "run ${run.id} target job did not execute the size-budget step `${config.required_size_step}` successfully",
    )
  }
  return transition(
    "pass",
    "run ${run.id} used policy ${config.policy_ref} at ${config.expected_policy_sha}, verified source ${config.source_ref} at ${config.expected_source_sha}, and completed `${config.required_size_step}` successfully",
  )
}
