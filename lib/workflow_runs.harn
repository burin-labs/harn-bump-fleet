/** Pure helpers for classifying GitHub Actions workflow-run rows. */
pub type PreTagBinaryGateConfig = {
  workflow: string,
  event: string,
  ref: string,
  expected_head_sha: string,
  target_job: string,
  required_step: string,
  benchmark_only: bool,
  targets: string,
  discovery_timeout_ms: int,
  discovery_interval_ms: int,
  completion_timeout_ms: int,
  completion_interval_ms: int,
}

pub type PreTagBinaryGateRun = {
  databaseId: int,
  event: string,
  headBranch: string,
  headSha: string,
  status: string,
  conclusion: string,
  url: string,
}

pub type PreTagBinaryGateStep = {name: string, status: string, conclusion: string}

pub type PreTagBinaryGateJob = {
  name: string,
  status: string,
  conclusion: string,
  steps: list<PreTagBinaryGateStep>,
}

pub type PreTagBinaryGateObservation = {
  runs: list<PreTagBinaryGateRun>,
  jobs?: list<PreTagBinaryGateJob>,
}

pub type PreTagBinaryGateState = {known_run_ids: list<int>, run_id?: int}

pub type PreTagBinaryGateAction = "discover" | "wait" | "inspect" | "pass" | "fail"

pub type PreTagBinaryGateTransition = {
  state: PreTagBinaryGateState,
  action: PreTagBinaryGateAction,
  message: string,
}

type PreTagBinaryGateRunSelection = {
  state: PreTagBinaryGateState,
  run?: PreTagBinaryGateRun,
  error: string,
}

fn normalized_created_at(run) {
  return trim(to_string(run?.createdAt ?? run?.created_at ?? ""))
}

fn normalized_run_status(run) {
  let status = trim(to_string(run?.status ?? ""))
  if status == "" {
    return "unknown"
  }
  return lowercase(status)
}

fn normalized_conclusion(run) {
  let conclusion = trim(to_string(run?.conclusion ?? ""))
  if conclusion == "" {
    return "unknown"
  }
  return lowercase(conclusion)
}

fn normalized_run(run) {
  return {
    id: run?.databaseId ?? run?.id,
    databaseId: run?.databaseId ?? run?.id,
    url: run?.url ?? run?.html_url ?? "",
    conclusion: normalized_conclusion(run),
    status: normalized_run_status(run),
    createdAt: normalized_created_at(run),
    event: lowercase(trim(to_string(run?.event ?? ""))),
    headBranch: trim(to_string(run?.headBranch ?? run?.head_branch ?? "")),
    headSha: lowercase(trim(to_string(run?.headSha ?? run?.head_sha ?? ""))),
  }
}

/** Return the newest normalized workflow run created at or after `after_iso`. */
pub fn newest_workflow_run_after(runs, after_iso) {
  let after = trim(to_string(after_iso ?? ""))
  let best = nil
  for run in runs ?? [] {
    let created_at = normalized_created_at(run)
    if created_at != "" && created_at >= after {
      if best == nil || created_at > best.createdAt {
        best = normalized_run(run)
      }
    }
  }
  return best
}

/** Return a fleet-poll result for the newest post-dispatch run, if one exists. */
pub fn workflow_run_poll_result(runs, after_iso) {
  let best = newest_workflow_run_after(runs, after_iso)
  if best == nil {
    return nil
  }
  return best
}

fn run_id_is_known(known_ids: list<int>, id) -> bool {
  if id == nil {
    return true
  }
  for known in known_ids {
    if known == id {
      return true
    }
  }
  return false
}

/** Snapshot run IDs immediately before dispatch so later discovery is race-safe. */
pub fn pre_tag_binary_gate_initial_state(runs: list<PreTagBinaryGateRun>) -> PreTagBinaryGateState {
  let ids: list<int> = []
  for run in runs {
    if !run_id_is_known(ids, run.databaseId) {
      ids = ids + [run.databaseId]
    }
  }
  return {known_run_ids: ids}
}

fn transition(state: PreTagBinaryGateState, action: PreTagBinaryGateAction, message: string) -> PreTagBinaryGateTransition {
  return {state: state, action: action, message: message}
}

fn selected_run(
  config: PreTagBinaryGateConfig,
  state: PreTagBinaryGateState,
  runs: list<PreTagBinaryGateRun>,
) -> PreTagBinaryGateRunSelection {
  if state.run_id != nil {
    for run in runs {
      if run.databaseId == state.run_id {
        return {state: state, run: run, error: ""}
      }
    }
    return {state: state, run: nil, error: ""}
  }
  let candidates: list<PreTagBinaryGateRun> = []
  for run in runs {
    if run_id_is_known(state.known_run_ids, run.databaseId) || run.event != config.event
      || run.headBranch != config.ref {
      continue
    }
    candidates = candidates + [run]
  }
  if len(candidates) > 1 {
    return {
      state: state,
      run: nil,
      error: "could not identify the exact dispatched run: ${len(candidates)} unseen ${config.workflow} runs target ${config.ref}",
    }
  }
  if len(candidates) == 0 {
    return {state: state, run: nil, error: ""}
  }
  const run = candidates[0]
  if run == nil {
    return {state: state, run: nil, error: "workflow run selection produced no candidate"}
  }
  const selected: PreTagBinaryGateState = {known_run_ids: state.known_run_ids, run_id: run.databaseId}
  if run.headSha != lowercase(config.expected_head_sha) {
    return {
      state: selected,
      run: nil,
      error: "dispatched ${config.workflow} run ${run.databaseId} has head SHA ${run.headSha}, expected ${config.expected_head_sha}",
    }
  }
  return {state: selected, run: run, error: ""}
}

fn named_job(jobs: list<PreTagBinaryGateJob>, name: string) -> PreTagBinaryGateJob? {
  for job in jobs {
    if job.name == name {
      return job
    }
  }
  return nil
}

fn named_step(steps: list<PreTagBinaryGateStep>, name: string) -> PreTagBinaryGateStep? {
  for step in steps {
    if step.name == name {
      return step
    }
  }
  return nil
}

/**
 * Advance the SHA-matched pre-tag binary-size gate from one immutable GitHub
 * snapshot. Once selected, the run ID remains pinned across later snapshots.
 */
pub fn pre_tag_binary_gate_transition(
  config: PreTagBinaryGateConfig,
  state: PreTagBinaryGateState,
  observation: PreTagBinaryGateObservation,
) -> PreTagBinaryGateTransition {
  const selected = selected_run(config, state, observation.runs)
  if selected.error != "" {
    return transition(selected.state, "fail", selected.error)
  }
  if selected.run == nil {
    return transition(selected.state, "discover", "waiting for the dispatched ${config.workflow} run")
  }
  const run = selected.run
  if run.headSha != lowercase(config.expected_head_sha) {
    return transition(
      selected.state,
      "fail",
      "observed run ${run.databaseId} changed head SHA to ${run.headSha}; expected ${config.expected_head_sha}",
    )
  }
  if run.status != "completed" {
    return transition(selected.state, "wait", "run ${run.databaseId} is ${run.status}")
  }
  if run.conclusion != "success" {
    return transition(
      selected.state,
      "fail",
      "run ${run.databaseId} completed with conclusion ${run.conclusion}; refusing to create the release tag",
    )
  }
  if observation.jobs == nil {
    return transition(
      selected.state,
      "inspect",
      "run ${run.databaseId} succeeded; inspect target job execution",
    )
  }
  const job = named_job(observation.jobs, config.target_job)
  if job == nil || job.status != "completed" || job.conclusion != "success" {
    return transition(
      selected.state,
      "fail",
      "run ${run.databaseId} succeeded but target job `${config.target_job}` did not execute successfully",
    )
  }
  const size_step = named_step(job.steps, config.required_step)
  if size_step == nil || size_step.status != "completed" || size_step.conclusion != "success" {
    return transition(
      selected.state,
      "fail",
      "run ${run.databaseId} target job did not execute the size-budget step `${config.required_step}` successfully",
    )
  }
  return transition(
    selected.state,
    "pass",
    "run ${run.databaseId} completed successfully at exact head SHA ${config.expected_head_sha}; `${config.target_job}` and `${config.required_step}` executed successfully",
  )
}
