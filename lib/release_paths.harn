const RUN_ROOT = ".harn-runs/release-harn"

/**
 * Resolve the checkout root that owns this release harness. `harn run
 * /abs/path/release_harn.harn` may be launched from another repo, so this must
 * not depend on the process cwd.
 */
pub fn release_harness_root(fs: HarnessFs) -> string {
  const root = fs.runtime_paths().asset_root
  const leaf = basename(root)
  if leaf == "lib" || leaf == "tests" {
    return dirname(root)
  }
  return root
}

pub fn release_run_root(fs: HarnessFs) -> string {
  return path_join(release_harness_root(fs), RUN_ROOT)
}

pub fn release_run_dir(fs: HarnessFs, run_id: string) -> string {
  return path_join(release_run_root(fs), run_id)
}

pub fn run_output_dir(fs: HarnessFs, run_id: string) -> string {
  return release_run_dir(fs, run_id)
}

pub fn prompt_asset(fs: HarnessFs, name: string) -> string {
  return path_join(release_harness_root(fs), "prompts", name)
}
