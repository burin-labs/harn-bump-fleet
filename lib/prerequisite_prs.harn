import { github_pr_view } from "./github"

pub type PrerequisitePrStatus = "satisfied" \
  | "missing_pull_request" \
  | "unexpected_head" \
  | "not_merged" \
  | "missing_merge_evidence" \
  | "github_error"

pub type PrerequisitePrDecision = {
  ok: bool,
  status: PrerequisitePrStatus,
  repo: string,
  number: int,
  url?: string,
  title?: string,
  head_oid?: string,
  expected_head_oid?: string,
  github_state?: string,
  merge_state?: string,
  merged_at?: string,
  merge_commit_oid?: string,
  detail: string,
}

pub type PrerequisitePr = {
  head?: {sha?: string, ...rest},
  head_oid?: string,
  github_state?: string,
  state?: string,
  merge_commit_oid?: string,
  merge_commit?: {oid?: string, ...rest},
  mergeCommit?: {oid?: string, ...rest},
  mergeable_state?: string,
  merge_state_status?: string,
  mergeStateStatus?: string,
  merged?: bool,
  merged_at?: string,
  mergedAt?: string,
  url?: string,
  title?: string,
  ...rest,
}

fn text_or_empty(value) -> string {
  if value == nil {
    return ""
  }
  return trim(to_string(value))
}

fn pr_head_oid(pr) -> string {
  return text_or_empty(pr?.head?.sha ?? pr?.head_oid)
}

fn pr_state(pr) -> string {
  return lowercase(text_or_empty(pr?.github_state ?? pr?.state ?? "unknown"))
}

fn pr_merge_commit_oid(pr) -> string {
  return text_or_empty(pr?.merge_commit_oid ?? pr?.merge_commit?.oid ?? pr?.mergeCommit?.oid)
}

fn pr_merge_state(pr) -> string {
  return text_or_empty(pr?.mergeable_state ?? pr?.merge_state_status ?? pr?.mergeStateStatus)
}

fn pr_is_merged(pr) -> bool {
  return (pr?.merged ?? false) || pr_state(pr) == "merged"
}

fn decision(
  repo: string,
  number: int,
  pr: PrerequisitePr?,
  ok: bool,
  status: PrerequisitePrStatus,
  detail: string,
  expected_head_oid: string = "",
) -> PrerequisitePrDecision {
  return {
    ok: ok,
    status: status,
    repo: repo,
    number: number,
    url: pr?.url,
    title: pr?.title,
    head_oid: pr_head_oid(pr),
    expected_head_oid: expected_head_oid,
    github_state: pr_state(pr),
    merge_state: pr_merge_state(pr),
    merged_at: text_or_empty(pr?.merged_at ?? pr?.mergedAt),
    merge_commit_oid: pr_merge_commit_oid(pr),
    detail: detail,
  }
}

/**
 * Classify a release prerequisite PR from the connector's normalized PR view.
 *
 * This is intentionally stricter than "GitHub says green": a release prerequisite is
 * satisfied only when the PR is merged and its merge timestamp/commit are present.
 * When the operator gave an expected head, a different PR head is blocking evidence.
 */
pub fn classify_prerequisite_pr(
  repo: string,
  number: int,
  pr: PrerequisitePr?,
  expected_head_oid: string = "",
) -> PrerequisitePrDecision {
  if pr == nil {
    return decision(
      repo,
      number,
      nil,
      false,
      "missing_pull_request",
      "GitHub returned no pull request",
      expected_head_oid,
    )
  }
  const head_oid = pr_head_oid(pr)
  const expected = text_or_empty(expected_head_oid)
  if expected != "" && head_oid != expected {
    return decision(
      repo,
      number,
      pr,
      false,
      "unexpected_head",
      "pull request head ${head_oid} does not match expected ${expected}",
      expected,
    )
  }
  if !pr_is_merged(pr) {
    return decision(
      repo,
      number,
      pr,
      false,
      "not_merged",
      "pull request is ${pr_state(pr)}, not merged",
      expected,
    )
  }
  const merged_at = text_or_empty(pr?.merged_at ?? pr?.mergedAt)
  const merge_commit = pr_merge_commit_oid(pr)
  if merged_at == "" || merge_commit == "" {
    return decision(
      repo,
      number,
      pr,
      false,
      "missing_merge_evidence",
      "merged pull request is missing merged_at or merge_commit_oid evidence",
      expected,
    )
  }
  return decision(
    repo,
    number,
    pr,
    true,
    "satisfied",
    "pull request is merged at ${merged_at} with merge commit ${merge_commit}",
    expected,
  )
}

/** Read and classify one prerequisite PR through the typed GitHub connector wrapper. */
pub fn load_prerequisite_pr(
  repo: string,
  number: int,
  expected_head_oid: string = "",
) -> PrerequisitePrDecision {
  const pr = github_pr_view(repo, number)
  if is_err(pr) {
    return {
      ok: false,
      status: "github_error",
      repo: repo,
      number: number,
      expected_head_oid: expected_head_oid,
      detail: "GitHub PR view failed: " + to_string(unwrap_err(pr)),
    }
  }
  return classify_prerequisite_pr(repo, number, pr, expected_head_oid)
}
