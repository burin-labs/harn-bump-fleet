import { parse_args } from "std/cli"
import { env_str } from "std/config"
import { cli_required_bool, cli_required_int, cli_required_string } from "./cli_options"
import { planner_defaults } from "./llm_defaults"

pub type SelfReviewToolFormat = "text" | "native"

pub type HarnessSelfReviewOptions = {
  facts_only: bool,
  help: bool,
  recent: int,
  model: string,
  provider: string,
  tool_format: SelfReviewToolFormat,
  with_tools: bool,
  projects_root: string,
  harn_repo: string,
}

const SELF_REVIEW_DEFAULT = planner_defaults("")

const DEFAULT_MODEL = env_str("HARN_SELF_REVIEW_MODEL")
  ?? env_str("HARN_RELEASE_MODEL")
  ?? SELF_REVIEW_DEFAULT.model

const DEFAULT_PROVIDER = env_str("HARN_SELF_REVIEW_PROVIDER")
  ?? env_str("HARN_RELEASE_PROVIDER")
  ?? SELF_REVIEW_DEFAULT.provider

const DEFAULT_TOOL_FORMAT = env_str("HARN_SELF_REVIEW_TOOL_FORMAT") ?? "text"

const DEFAULT_PROJECTS_ROOT = path_join(env_str("HOME") ?? "", "projects")

const DEFAULT_HARN_REPO = path_join(DEFAULT_PROJECTS_ROOT, "harn")

const SELF_REVIEW_ARG_SPEC = [
  {kind: "flag", name: "facts_only", flags: ["--facts-only"]},
  {kind: "flag", name: "help", flags: ["--help", "-h"]},
  {kind: "option", name: "recent", flags: ["--recent"], parse: "int", default: 6},
  {kind: "option", name: "model", flags: ["--model"], default: DEFAULT_MODEL},
  {kind: "option", name: "provider", flags: ["--provider"], default: DEFAULT_PROVIDER},
  {kind: "option", name: "tool_format", flags: ["--tool-format"], default: DEFAULT_TOOL_FORMAT},
  {kind: "flag", name: "with_tools", flags: ["--with-tools"]},
  {kind: "option", name: "projects_root", flags: ["--projects-root"], default: DEFAULT_PROJECTS_ROOT},
  {kind: "option", name: "harn_repo", flags: ["--harn-repo"], default: DEFAULT_HARN_REPO},
]

fn self_review_tool_format(value) -> SelfReviewToolFormat {
  const normalized = cli_required_string(value, "--tool-format")
  if normalized == "text" {
    return "text"
  }
  if normalized == "native" {
    return "native"
  }
  throw "--tool-format must be text or native"
}

/** Normalize generic std/cli output once into the self-review option contract. */
pub fn parse_self_review_args(args: list<string>) -> HarnessSelfReviewOptions {
  const parsed = parse_args(args, SELF_REVIEW_ARG_SPEC)
  if len(parsed._extras) > 0 {
    throw "unknown flag: " + parsed._extras[0]
  }
  if len(parsed._errors) > 0 {
    throw join(parsed._errors, "; ")
  }
  const recent = cli_required_int(parsed.recent, "--recent")
  if recent <= 0 {
    throw "--recent must be positive"
  }
  return {
    facts_only: cli_required_bool(parsed.facts_only, "--facts-only"),
    help: cli_required_bool(parsed.help, "--help"),
    recent: recent,
    model: cli_required_string(parsed.model, "--model"),
    provider: cli_required_string(parsed.provider, "--provider"),
    tool_format: self_review_tool_format(parsed.tool_format),
    with_tools: cli_required_bool(parsed.with_tools, "--with-tools"),
    projects_root: cli_required_string(parsed.projects_root, "--projects-root"),
    harn_repo: cli_required_string(parsed.harn_repo, "--harn-repo"),
  }
}
