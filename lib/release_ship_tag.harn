import { ReleaseAnalysis } from "./release_analysis"
import { run_release_candidate_certification } from "./release_candidate_certification"
import { execution_failed } from "./release_execution"
import { ReleasePublication } from "./release_publication"
import { ReleaseShipPrepareReady } from "./release_ship_prepare"
import { ensure_release_tag_pushed, pre_tag_cutoff_gate } from "./release_tag"

pub type ReleaseShipTagStopped = {proceed: bool, steps: list<dict>}

pub type ReleaseShipTagReady = {
  proceed: bool,
  steps: list<dict>,
  analysis: ReleaseAnalysis,
  version: string,
  publication: ReleasePublication,
}

pub type ReleaseShipTagResult = ReleaseShipTagStopped | ReleaseShipTagReady

pub fn release_ship_tag_phase(
  harness: Harness,
  cfg: dict,
  prepared: ReleaseShipPrepareReady,
  run_id: string,
) -> ReleaseShipTagResult {
  let steps = prepared.steps
  const version = prepared.version
  const publication = prepared.publication
  // The tag below fires publish-release.yml from the frozen cutoff. Prove that
  // cutoff remains in base ancestry; commits that landed later ship next time.
  const cutoff_gate = pre_tag_cutoff_gate(harness, cfg, version, steps, run_id)
  steps = cutoff_gate.steps
  if !cutoff_gate.proceed {
    return {proceed: false, steps: steps}
  }
  // The immutable publication is the single certification subject. Hosted
  // platform/local-source proof and the Linux release-size proof fan out from
  // this exact OID; only their residual generated-content audit follows the
  // join. A red or incomplete lane blocks signed tag creation.
  if !(cfg.skip_tag ?? false) {
    const certification = run_release_candidate_certification(
      harness,
      cfg,
      publication,
      steps,
      run_id,
    )
    steps = certification.steps
    if !certification.success {
      return {proceed: false, steps: steps}
    }
  }
  // Push vX.Y.Z to origin BEFORE creating the PR. publish-release.yml
  // fires on this tag push and ships crates.io + the GitHub release
  // from the pinned commit; the PR that follows is paperwork (lands the
  // Cargo.toml/CHANGELOG bump on main) and doesn't influence what was
  // shipped. If the tag push fails, abort early so we don't open a PR
  // for a release that hasn't been published.
  steps = ensure_release_tag_pushed(harness, cfg, version, publication, steps, run_id)
  if execution_failed(steps) {
    return {proceed: false, steps: steps}
  }
  return {
    proceed: true,
    steps: steps,
    analysis: prepared.analysis,
    version: version,
    publication: publication,
  }
}
