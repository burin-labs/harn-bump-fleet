// lib/chat_loop.harn — interactive postmortem + approval chat loop shared by
// release_harn and bump_fleet. Read-only audit + edit tools, with a TTY-aware
// kill switch so CI is unaffected.
//
// Public API:
//   chat_enabled(cfg) -> bool
//   pick_recent_run(harness_kind, limit) -> {dir, run_id, summary}?
//   pre_release_gate(cfg, classifier_inputs, ctx) -> {decision, reason}
//   run_chat_loop(chat_cfg) -> nil
//   chat_cfg_from_run_dir(base, kind, run_dir) -> dict
//   summarize_release_run(run_dir) / summarize_bump_run(run_dir) -> dict
//   classifier_payload(inputs) -> dict
import { agent_chat_loop, agent_chat_route_input } from "std/agent/chat"
import { command_run } from "std/command"
import { env_str } from "std/config"
import { is_tty, read_line } from "std/io"
import { default_llm_caller, with_retry } from "std/llm/handlers"
import { page, rule, select_from } from "std/tui"
import { truncate_text } from "./text_util"

let ANSI_RESET = "[0m"

let ANSI_DIM = "[2m"

let ANSI_BOLD = "[1m"

let ANSI_CYAN = "[36m"

let ANSI_MAGENTA = "[35m"

let ANSI_YELLOW = "[33m"

let ANSI_GREEN = "[32m"

let ANSI_RED = "[31m"

let DEFAULT_TIMEOUT_S = 60

let CAROUSEL_LIMIT = 12

/**
 * chat_enabled — combines the user's opt-out, an env kill switch, and TTY
 * detection. CI never enters chat because std/io::is_tty(0) reports false
 * when stdin is piped/redirected/captured.
 */
pub fn chat_enabled(cfg) -> bool {
  if cfg?.no_chat ?? false {
    return false
  }
  if env_str("HARN_CHAT") == "0" {
    return false
  }
  return is_tty(0)
}

fn prompt_line(label, timeout_s) -> any {
  let effective = timeout_s ?? DEFAULT_TIMEOUT_S
  let result = read_line({prompt: label ?? "", timeout_ms: effective * 1000, trim: true})
  if !(result?.ok ?? false) {
    return nil
  }
  return result?.value
}

// -------------------------------------------------------------------------------------------------
// Recent-runs carousel.
// -------------------------------------------------------------------------------------------------

/** Summarize a release-harn run dir for the carousel: timestamp, version, outcome. */
pub fn summarize_release_run(run_dir) {
  let audit_path = path_join(run_dir, "release-audit.json")
  if !file_exists(audit_path) {
    return {ok: false, when: "?", version: "?", outcome: "missing audit", headline: ""}
  }
  let raw = try {
    read_file(audit_path)
  } catch (_e) {
    ""
  }
  if raw == "" {
    return {ok: false, when: "?", version: "?", outcome: "unreadable", headline: ""}
  }
  let parsed = try {
    json_parse(raw)
  } catch (_e) {
    nil
  }
  if parsed == nil {
    return {ok: false, when: "?", version: "?", outcome: "malformed json", headline: ""}
  }
  let started = parsed?.started_iso ?? "?"
  let analysis = parsed?.analysis ?? {}
  let cur = analysis?.current_version ?? "?"
  let next = analysis?.next_version ?? "?"
  let exec = parsed?.execution
  let failed = if type_of(exec) == "list" {
    var any_fail = false
    for step in exec {
      if step?.status ?? 0 != 0 {
        any_fail = true
      }
    }
    any_fail
  } else {
    false
  }
  let mode = parsed?.config?.mode ?? "?"
  let outcome = if failed {
    "FAILED"
  } else {
    if mode == "audit" {
      "audit"
    } else {
      "ok"
    }
  }
  let headline = "${mode} • v${cur} → v${next}"
  return {ok: true, when: started, version: "v${next}", outcome: outcome, headline: headline, mode: mode}
}

/** Summarize a bump-fleet run dir for the carousel. */
pub fn summarize_bump_run(run_dir) {
  let audit_path = path_join(run_dir, "audit.json")
  if !file_exists(audit_path) {
    return {ok: false, when: "?", version: "?", outcome: "missing audit", headline: ""}
  }
  let raw = try {
    read_file(audit_path)
  } catch (_e) {
    ""
  }
  if raw == "" {
    return {ok: false, when: "?", version: "?", outcome: "unreadable", headline: ""}
  }
  let parsed = try {
    json_parse(raw)
  } catch (_e) {
    nil
  }
  if parsed == nil {
    return {ok: false, when: "?", version: "?", outcome: "malformed json", headline: ""}
  }
  let started = parsed?.started_iso ?? "?"
  let target = parsed?.target_version ?? "?"
  let mode = parsed?.mode ?? "?"
  let outcomes = parsed?.outcomes ?? []
  let dispatched = parsed?.repos_dispatched ?? 0
  let total = parsed?.repos_total ?? len(outcomes)
  let problems = if type_of(outcomes) == "list" {
    var n = 0
    for o in outcomes {
      let status = o?.status ?? ""
      if status == "error" || status == "failed" {
        n = n + 1
      }
    }
    n
  } else {
    0
  }
  let outcome = if problems > 0 {
    "FAILED (${problems})"
  } else {
    "ok"
  }
  return {
    ok: true,
    when: started,
    version: target,
    outcome: outcome,
    headline: "${mode} • ${dispatched}/${total} dispatched",
    mode: mode,
  }
}

fn list_recent_run_dirs(harness_kind, limit) {
  let root = path_join(cwd(), ".harn-runs", harness_kind)
  if !file_exists(root) {
    return []
  }
  let entries = try {
    list_dir(root)
  } catch (_e) {
    []
  }
  var with_mtime = []
  for name in entries {
    let full = path_join(root, name)
    let info = try {
      stat(full)
    } catch (_e) {
      nil
    }
    if info != nil && info?.is_dir {
      with_mtime = with_mtime + [{dir: full, name: name, mtime: info?.mtime_ms ?? 0}]
    }
  }
  // Sort newest first by mtime.
  let sorted = with_mtime
    .sort(
    { a, b ->
      if a.mtime > b.mtime {
        -1
      } else {
        1
      }
    },
  )
  let capped = if len(sorted) > limit {
    sorted[0:limit]
  } else {
    sorted
  }
  var out = []
  for entry in capped {
    out = out + [entry.dir]
  }
  return out
}

fn carousel_row(dir, harness_kind) {
  let summary = if harness_kind == "release-harn" {
    summarize_release_run(dir)
  } else {
    summarize_bump_run(dir)
  }
  let run_id = basename(dir)
  let when_short = if len(summary.when) >= 19 {
    summary.when[0:19].replace("T", " ")
  } else {
    summary.when
  }
  let mark = if summary.ok {
    if contains(summary.outcome, "FAIL") {
      "✗"
    } else {
      "✓"
    }
  } else {
    "?"
  }
  return {
    dir: dir,
    run_id: run_id,
    summary: summary,
    label: "${mark}  ${when_short}  ${summary.version}  ${summary.headline}",
  }
}

/**
 * pick_recent_run — render a numbered carousel and prompt for a choice.
 * Returns nil if the operator cancelled. Otherwise returns
 * {dir, run_id, summary}.
 */
pub fn pick_recent_run(harness_kind, limit) -> any {
  let effective_limit = limit ?? CAROUSEL_LIMIT
  let dirs = list_recent_run_dirs(harness_kind, effective_limit)
  if len(dirs) == 0 {
    println("(no recent ${harness_kind} runs found under .harn-runs/${harness_kind}/)")
    return nil
  }
  var rows = []
  for d in dirs {
    rows = rows + [carousel_row(d, harness_kind)]
  }
  let picked = select_from(
    rows,
    {
      prompt: "pick a run",
      header: "recent ${harness_kind} runs",
      display: { row -> row.label },
      preview: { row -> "${row.run_id}\n${row.summary.headline}\noutcome: ${row.summary.outcome}" },
    },
  )
  if !(picked.ok ?? false) {
    return nil
  }
  return picked.value
}

// -------------------------------------------------------------------------------------------------
// Triviality classifier (pre-release gate).
// -------------------------------------------------------------------------------------------------

/**
 * Deterministic metrics on a CHANGELOG + PR body draft used to seed the
 * triviality classifier prompt. Counts BREAKING mentions, section headers,
 * and bullets so the classifier sees both the prose and a cheap summary.
 * Exposed publicly so the test suite can exercise it without invoking an
 * LLM.
 */
pub fn classifier_payload(inputs) {
  let cl = inputs?.changelog ?? ""
  let pr = inputs?.pr_body ?? ""
  let findings = inputs?.findings ?? []
  let lines = (cl ?? "").split("\n")
  let breaking_hits = if type_of(cl) == "string" {
    var hits = 0
    for ln in lines {
      let lower = ln.to_lower()
      if contains(lower, "breaking") || contains(lower, "incompatible") {
        hits = hits + 1
      }
    }
    hits
  } else {
    0
  }
  let section_lines = if type_of(cl) == "string" {
    var n = 0
    for ln in lines {
      if starts_with(ln, "### ") {
        n = n + 1
      }
    }
    n
  } else {
    0
  }
  let bullet_lines = if type_of(cl) == "string" {
    var n = 0
    for ln in lines {
      if starts_with(ln, "- ") || starts_with(ln, "* ") {
        n = n + 1
      }
    }
    n
  } else {
    0
  }
  return {
    changelog: truncate_text(cl, 6000),
    pr_body: truncate_text(pr, 4000),
    findings: findings,
    metrics: {
      changelog_chars: len(cl),
      changelog_lines: len(lines),
      pr_body_chars: len(pr),
      breaking_hits: breaking_hits,
      section_lines: section_lines,
      bullet_lines: bullet_lines,
      finding_count: len(findings),
    },
  }
}

fn classify_triviality(cfg, inputs) {
  let payload = classifier_payload(inputs)
  let metrics = payload.metrics
  let cheap_non_trivial = metrics.breaking_hits > 0
    || metrics.section_lines >= 3
    || metrics.bullet_lines > 12
    || metrics.finding_count > 0
  if cheap_non_trivial {
    return {
      non_trivial: true,
      why: "deterministic: " + classifier_reason_text(metrics),
      source: "deterministic",
    }
  }
  if cfg?.mock ?? false {
    return {non_trivial: false, why: "mock release; classifier skipped", source: "mock"}
  }
  let system = render("@prompts/chat_triviality_classifier.harn.prompt", payload)
  let res = try {
    agent_loop(
      "Classify this CHANGELOG draft. Respond with one JSON object only.",
      system,
      {
        provider: cfg?.provider ?? "ollama",
        model: cfg?.model ?? "qwen3.6:35b-a3b-coding-nvfp4",
        tool_choice: "none",
        max_iterations: 1,
        iteration_budget: {mode: "fixed", initial: 1, max: 1, extend_by: 0},
        max_tokens: 200,
        temperature: 0.0,
        llm_caller: with_retry(default_llm_caller(), {max_attempts: 2}),
      },
    )
  } catch (e) {
    return {non_trivial: true, why: "classifier_error: ${e}", source: "fail_open"}
  }
  let text = trim(res?.visible_text ?? res?.text ?? res?.prose ?? "")
  let parsed = try {
    json_parse(extract_first_json_object(text))
  } catch (_e) {
    nil
  }
  if parsed == nil {
    return {
      non_trivial: true,
      why: "classifier output unparseable, defaulting to non-trivial",
      source: "fail_open",
      raw: truncate_text(text, 400),
    }
  }
  return {non_trivial: parsed?.non_trivial ?? true, why: parsed?.why ?? "", source: "llm"}
}

fn classifier_reason_text(metrics) {
  var bits = []
  if metrics.breaking_hits > 0 {
    bits = bits + ["${metrics.breaking_hits} BREAKING mention(s)"]
  }
  if metrics.section_lines >= 3 {
    bits = bits + ["${metrics.section_lines} sections"]
  }
  if metrics.bullet_lines > 12 {
    bits = bits + ["${metrics.bullet_lines} bullets"]
  }
  if metrics.finding_count > 0 {
    bits = bits + ["${metrics.finding_count} deterministic finding(s)"]
  }
  if len(bits) == 0 {
    return "none"
  }
  return join(bits, ", ")
}

fn extract_first_json_object(text) {
  let t = trim(text ?? "")
  if t == "" {
    return "{}"
  }
  let start = t.index_of("{")
  if start < 0 {
    return "{}"
  }
  let end = t.last_index_of("}")
  if end <= start {
    return "{}"
  }
  return t[start:end + 1]
}

// -------------------------------------------------------------------------------------------------
// Pre-release approval gate.
// -------------------------------------------------------------------------------------------------

/**
 * colorize_changelog — convert a markdown changelog section into a coloured
 * inline render so the gate's overview prints at-a-glance instead of needing
 * the operator to skim `less`. Headers and bullet markers gain ANSI weight,
 * "BREAKING" is highlighted, and continuation lines stay dim so the visual
 * weight matches the conceptual weight of each entry. Idempotent on plain
 * text; if the input already contains escape codes we leave it alone.
 *
 * Exposed publicly so tests can assert the colouring rules without driving
 * a full TTY-only `pre_release_gate` invocation.
 */
pub fn colorize_changelog(text) {
  if contains(text ?? "", "[0m") {
    return text
  }
  let lines = (text ?? "").split("\n")
  var out = []
  for raw in lines {
    let line = raw ?? ""
    if starts_with(line, "## ") {
      out = out + [ANSI_BOLD + ANSI_CYAN + line + ANSI_RESET]
    } else if starts_with(line, "### ") {
      out = out + [ANSI_BOLD + ANSI_YELLOW + line + ANSI_RESET]
    } else if starts_with(line, "#### ") {
      out = out + [ANSI_BOLD + line + ANSI_RESET]
    } else if starts_with(line, "- ") || starts_with(line, "* ") {
      let lower = line.to_lower()
      let coloured = if contains(lower, "breaking") || contains(lower, "incompatible") {
        ANSI_RED + ANSI_BOLD + line + ANSI_RESET
      } else {
        ANSI_GREEN + "+ " + ANSI_RESET + substring(line, 2, len(line))
      }
      out = out + [coloured]
    } else if starts_with(line, "  ") {
      out = out + [ANSI_DIM + line + ANSI_RESET]
    } else {
      out = out + [line]
    }
  }
  return join(out, "\n")
}

fn _commit_range(ctx) {
  let latest = trim(ctx?.latest_tag ?? "")
  let pin = trim(ctx?.pin_sha ?? "")
  if latest == "" || pin == "" {
    return ""
  }
  return "${latest}..${pin}"
}

/**
 * release_range_diffstat — return a coloured `git diff --stat` of the commit
 * range that is about to be released, so the operator sees the actual scope
 * of changes (which files / how many ± lines) at a glance instead of just
 * the LLM-authored changelog prose. Empty string on any error or when the
 * range is unknown; the gate falls back to changelog-only in that case.
 */
fn release_range_diffstat(ctx) {
  let repo = ctx?.repo ?? ""
  let range = _commit_range(ctx)
  if repo == "" || range == "" {
    return ""
  }
  let argv = ["git", "-C", repo, "-c", "color.ui=always", "diff", "--stat", "--stat-count=40", range]
  let res = try {
    command_run({argv: argv, timeout_ms: 8000})
  } catch (_e) {
    nil
  }
  if res == nil || !(res?.success ?? false) {
    return ""
  }
  return trim(res?.stdout ?? "")
}

/**
 * release_range_oneline_log — coloured `git log --oneline` of the commit
 * range. Pairs with the diffstat to answer "what's going in this release"
 * at a glance.
 */
fn release_range_oneline_log(ctx, limit) {
  let repo = ctx?.repo ?? ""
  let range = _commit_range(ctx)
  if repo == "" || range == "" {
    return ""
  }
  let cap = limit ?? 25
  let argv = [
    "git",
    "-C",
    repo,
    "-c",
    "color.ui=always",
    "log",
    "--oneline",
    "--no-merges",
    "--max-count=${cap}",
    range,
  ]
  let res = try {
    command_run({argv: argv, timeout_ms: 8000})
  } catch (_e) {
    nil
  }
  if res == nil || !(res?.success ?? false) {
    return ""
  }
  return trim(res?.stdout ?? "")
}

/**
 * release_range_full_diff — coloured full diff for the commit range. Used by
 * the optional `[d] diff` gate command; kept off the default render because
 * a substantial release can run several thousand lines and we want the
 * default landing zone to fit on one screen.
 */
fn release_range_full_diff(ctx) {
  let repo = ctx?.repo ?? ""
  let range = _commit_range(ctx)
  if repo == "" || range == "" {
    return ""
  }
  let argv = ["git", "-C", repo, "-c", "color.ui=always", "diff", "--patch", "--stat", range]
  let res = try {
    command_run({argv: argv, timeout_ms: 20000, capture: {max_inline_bytes: 4194304}})
  } catch (_e) {
    nil
  }
  if res == nil || !(res?.success ?? false) {
    return ""
  }
  return res?.stdout ?? ""
}

/**
 * pre_release_gate — only call when chat is enabled.
 *
 * inputs: {changelog: string, pr_body: string, findings: list<string>}
 * ctx:    {
 *   mode: string, next_version: string, current_version?: string,
 *   repo: string, run_id: string,
 *   base_branch?: string, latest_tag?: string, pin_sha?: string,
 * }
 *
 * Returns one of:
 *   {decision: "approve", reason: string}
 *   {decision: "abort",   reason: string}
 */
pub fn pre_release_gate(cfg, inputs, ctx) {
  let triviality = classify_triviality(cfg, inputs)
  if !triviality.non_trivial {
    println(
      ANSI_DIM + "   chat: classifier — trivial release (" + triviality.why + "); auto-approve"
        + ANSI_RESET,
    )
    return {decision: "approve", reason: "trivial:" + triviality.why}
  }
  println("")
  println(ANSI_BOLD + "== chat: pre-release approval gate" + ANSI_RESET)
  println(
    "   non-trivial release (${triviality.source}): " + ANSI_YELLOW + triviality.why + ANSI_RESET,
  )
  let range = _commit_range(ctx)
  if range != "" {
    let current = trim(ctx?.current_version ?? "")
    let next_v = trim(ctx?.next_version ?? "?")
    let version_line = if current == "" {
      "v${next_v}"
    } else {
      "v${current} → v${next_v}"
    }
    println(
      ANSI_DIM + "   commit range " + ANSI_RESET + ANSI_BOLD + range + ANSI_RESET
        + ANSI_DIM
        + " (releasing as ${version_line})"
        + ANSI_RESET,
    )
  }
  let oneline = release_range_oneline_log(ctx, 12)
  if oneline != "" {
    println("")
    println(ANSI_BOLD + "── commits in this release ──" + ANSI_RESET)
    println(oneline)
  }
  let diffstat = release_range_diffstat(ctx)
  if diffstat != "" {
    println("")
    println(ANSI_BOLD + "── files touched (git diff --stat) ──" + ANSI_RESET)
    println(diffstat)
  }
  println("")
  println(ANSI_BOLD + "── proposed CHANGELOG section ──" + ANSI_RESET)
  let coloured = colorize_changelog(inputs?.changelog ?? "(empty)")
  page({title: "v${ctx?.next_version ?? \"?\"} CHANGELOG delta", body: coloured, format: "text"})
  let pr_body = inputs?.pr_body ?? ""
  if trim(pr_body) != "" {
    page({title: "PR body", body: colorize_changelog(pr_body), format: "text"})
  }
  println("")
  println(
    ANSI_DIM
      + "   approve [a], abort [q], chat [c] to discuss, diff [d] to view the full coloured diff"
      + ANSI_RESET,
  )
  while true {
    let line = prompt_line(ANSI_CYAN + "gate> " + ANSI_RESET + "[a/q/c/d] ", 120)
    if line == nil {
      return {decision: "abort", reason: "no response within timeout"}
    }
    let answer = trim(line).to_lower()
    if answer == "a" || answer == "approve" || answer == "y" || answer == "yes" {
      return {decision: "approve", reason: "operator approved"}
    }
    if answer == "q" || answer == "abort" || answer == "n" || answer == "no" || answer == "/exit" {
      return {decision: "abort", reason: "operator aborted"}
    }
    if answer == "d" || answer == "diff" {
      let full = release_range_full_diff(ctx)
      if trim(full) == "" {
        println(
          ANSI_YELLOW
            + "   (no diff available — repo/range unset, or git diff returned empty)"
            + ANSI_RESET,
        )
      } else {
        page({title: "git diff ${range}", body: full, format: "text"})
      }
      continue
    }
    if answer == "c" || answer == "chat" {
      let outcome = run_gate_chat(cfg, inputs, ctx, triviality)
      if outcome?.decision != nil {
        return outcome
      }
      continue
    }
    println(ANSI_YELLOW + "   (didn't understand '${answer}'; type a, q, c, or d)" + ANSI_RESET)
  }
}

fn gate_chat_system_prompt(ctx, inputs, triviality) {
  let data = {
    next_version: ctx?.next_version ?? "?",
    mode: ctx?.mode ?? "?",
    why: triviality?.why ?? "",
    changelog: truncate_text(inputs?.changelog ?? "", 8000),
    pr_body: truncate_text(inputs?.pr_body ?? "", 4000),
    findings: inputs?.findings ?? [],
  }
  return render("@prompts/chat_pre_release_system.harn.prompt", data)
}

fn run_gate_chat(cfg, inputs, ctx, triviality) {
  let system = gate_chat_system_prompt(ctx, inputs, triviality)
  let session_id = "release-gate-" + ctx?.run_id ?? uuid_v7()
  let tools = cfg?.tools ?? tool_registry()
  let transcript_dir = path_join(cwd(), ".harn-runs/release-harn", ctx?.run_id ?? "ad-hoc", "chat-gate-llm")
  mkdir(transcript_dir, true)
  println("")
  println(
    ANSI_BOLD
      + "   ── pre-release chat ── /approve to ship, /abort to halt, /exit to back out to the gate prompt"
      + ANSI_RESET,
  )
  let gate_handlers = {
    "/approve": { _req -> {kind: "exit", reason: "approved_from_chat"} },
    "/abort": { _req -> {kind: "exit", reason: "aborted_from_chat"} },
  }
  let result = agent_chat_loop(
    {
      session_id: session_id,
      provider: cfg?.provider ?? "ollama",
      model: cfg?.model ?? "qwen3.6:35b-a3b-coding-nvfp4",
      tools: tools,
      system_prompt: system,
      max_iterations: 6,
      iteration_budget: {mode: "adaptive", initial: 3, max: 6, extend_by: 2},
      max_tokens: 4000,
      temperature: 0.2,
      llm_caller: with_retry(default_llm_caller(), {max_attempts: 2}),
      llm_transcript_dir: transcript_dir,
      slash_commands: gate_handlers,
      on_user_input: { state ->
        let label = ANSI_CYAN + "you> " + ANSI_RESET
        let line = prompt_line(label, cfg?.timeout_s ?? DEFAULT_TIMEOUT_S)
        if line == nil {
          return {kind: "exit", reason: "timeout"}
        }
        return agent_chat_route_input(line, state, gate_handlers)
      },
      on_model_turn: { turn, state ->
        print_assistant_turn(turn)
        return nil
      },
    },
  )
  if result.stop_reason == "approved_from_chat" {
    return {decision: "approve", reason: "approved from chat"}
  }
  if result.stop_reason == "aborted_from_chat" {
    return {decision: "abort", reason: "aborted from chat"}
  }
  println(ANSI_DIM + "   (returning to gate prompt)" + ANSI_RESET)
  return {}
}

// -------------------------------------------------------------------------------------------------
// Post-run chat loop.
// -------------------------------------------------------------------------------------------------

fn load_seed_context(chat_cfg) {
  var sections = []
  let audit_md_path = chat_cfg?.audit_md_path
  if audit_md_path != nil && file_exists(audit_md_path) {
    let body = truncate_text(read_file(audit_md_path), 14000)
    sections = sections
      + ["## Run audit (${basename(audit_md_path)})\n\n${body}"]
  }
  let audit_json_path = chat_cfg?.audit_json_path
  if audit_json_path != nil && file_exists(audit_json_path) {
    let body = truncate_text(read_file(audit_json_path), 10000)
    sections = sections + ["## Run audit JSON (truncated)\n\n```json\n${body}\n```"]
  }
  if len(sections) == 0 {
    return "(no audit artifacts available)"
  }
  return join(sections, "\n\n")
}

fn chat_system_prompt(chat_cfg, seed_context) {
  let data = {
    harness_kind: chat_cfg?.harness_kind ?? "?",
    run_id: chat_cfg?.run_id ?? "?",
    run_dir: chat_cfg?.run_dir ?? "?",
    outcome: chat_cfg?.outcome ?? "?",
    repo: chat_cfg?.repo ?? "",
    mode: chat_cfg?.mode_hint ?? "",
    seed_context: seed_context,
  }
  return render("@prompts/chat_post_run_system.harn.prompt", data)
}

fn chat_banner(chat_cfg) {
  let kind = chat_cfg?.harness_kind ?? "?"
  let outcome = chat_cfg?.outcome ?? "?"
  let outcome_colour = if contains(outcome, "FAIL") || contains(outcome, "error") {
    ANSI_RED
  } else {
    ANSI_GREEN
  }
  println("")
  println(
    ANSI_BOLD + "── chat (${kind}) ──" + ANSI_RESET + " run " + ANSI_DIM
      + chat_cfg?.run_id ?? "?"
      + ANSI_RESET
      + " · outcome "
      + outcome_colour
      + outcome
      + ANSI_RESET,
  )
  if chat_cfg?.audit_md_path ?? "" != "" {
    println(ANSI_DIM + "   report: ${chat_cfg.audit_md_path}" + ANSI_RESET)
  }
  println(
    ANSI_DIM
      + "   /help for commands · /exit to quit · ${chat_cfg?.timeout_s ?? DEFAULT_TIMEOUT_S}s start-typing timeout"
      + ANSI_RESET,
  )
  println(ANSI_DIM + rule("─") + ANSI_RESET)
}

fn print_chat_help() {
  println("")
  println(ANSI_BOLD + "   commands" + ANSI_RESET)
  println("     /exit, /quit       end the chat")
  println("     /help              this help text")
  println("     /cat <path>        page a file (under the run dir or repo)")
  println("     /diff <path?>      page `git diff` for a path (or whole tree)")
  println("     /runs              list recent runs of this harness")
  println("     anything else      forward to the agent")
  println("")
}

fn handle_cat(args, chat_cfg) {
  if len(args) == 0 {
    println(ANSI_YELLOW + "   /cat needs a path" + ANSI_RESET)
    return
  }
  let resolved = resolve_chat_path(args[0], chat_cfg)
  if !file_exists(resolved) {
    println(ANSI_YELLOW + "   no such file: ${resolved}" + ANSI_RESET)
    return
  }
  page({title: resolved, body: read_file(resolved)})
}

fn handle_diff(args, chat_cfg) {
  let path_arg = if len(args) > 0 {
    args[0]
  } else {
    ""
  }
  let repo = chat_cfg?.repo
  var argv = if repo != nil && repo != "" {
    ["git", "-C", repo, "diff"]
  } else {
    ["git", "diff"]
  }
  if path_arg != "" {
    argv = argv + ["--", path_arg]
  }
  let res = try {
    command_run({argv: argv, timeout_ms: 10000})
  } catch (e) {
    println(ANSI_RED + "   git diff error: ${e}" + ANSI_RESET)
    return
  }
  let out = res?.stdout ?? ""
  if trim(out) == "" {
    println(ANSI_DIM + "   (no diff)" + ANSI_RESET)
    return
  }
  page({title: "git diff " + path_arg, body: out})
}

fn handle_runs(chat_cfg) {
  let kind = chat_cfg?.harness_kind ?? "release-harn"
  let pick = pick_recent_run(kind, CAROUSEL_LIMIT)
  if pick == nil {
    return
  }
  println(
    ANSI_DIM
      + "   (selected ${pick.run_id} — re-invoke with --chat-run ${pick.run_id} to chat over it)"
      + ANSI_RESET,
  )
}

fn resolve_chat_path(raw, chat_cfg) {
  let p = raw ?? ""
  if starts_with(p, "/") {
    return p
  }
  let run_dir = chat_cfg?.run_dir ?? ""
  if run_dir != "" {
    let candidate = path_join(run_dir, p)
    if file_exists(candidate) {
      return candidate
    }
  }
  let repo = chat_cfg?.repo ?? ""
  if repo != "" {
    let candidate = path_join(repo, p)
    if file_exists(candidate) {
      return candidate
    }
  }
  return path_join(cwd(), p)
}

/**
 * chat_cfg_from_run_dir — rebuild a chat_cfg by inferring file paths from a
 * run directory.
 */
pub fn chat_cfg_from_run_dir(base, harness_kind, run_dir) {
  let run_id = basename(run_dir)
  let audit_md = if harness_kind == "release-harn" {
    path_join(run_dir, "release-audit.md")
  } else {
    path_join(run_dir, "audit.md")
  }
  let audit_json = if harness_kind == "release-harn" {
    path_join(run_dir, "release-audit.json")
  } else {
    path_join(run_dir, "audit.json")
  }
  let transcript_candidate = path_join(run_dir, "agent-llm/llm_transcript.jsonl")
  let transcript = if file_exists(transcript_candidate) {
    transcript_candidate
  } else {
    nil
  }
  let outcome = if harness_kind == "release-harn" {
    summarize_release_run(run_dir).outcome
  } else {
    summarize_bump_run(run_dir).outcome
  }
  return base ?? {}
    + {
    harness_kind: harness_kind,
    run_id: run_id,
    run_dir: run_dir,
    audit_md_path: audit_md,
    audit_json_path: audit_json,
    llm_transcript_path: transcript,
    outcome: outcome,
  }
}

/** run_chat_loop — main entry point for post-run chat. */
pub fn run_chat_loop(chat_cfg) {
  if chat_cfg == nil {
    return nil
  }
  let session_id = "chat-" + chat_cfg?.harness_kind ?? "?" + "-" + chat_cfg?.run_id ?? uuid_v7()
  let transcript_dir = path_join(chat_cfg?.run_dir ?? path_join(cwd(), ".harn-runs", "ad-hoc"), "chat-llm")
  mkdir(transcript_dir, true)
  // If the prior agent run wrote a JSONL sidecar, seed the new session from
  // it so the prefix cache stays warm and the model picks up where the
  // recovery loop left off. Falls back to a system-prompt-only session if
  // the transcript is absent or malformed.
  let prior_transcript = chat_cfg?.llm_transcript_path
  if prior_transcript != nil && file_exists(prior_transcript) {
    try {
      agent_session_seed_from_jsonl(
        prior_transcript,
        {rename_session: session_id, truncate_to_last: 24, drop_tool_calls: false, validate: false},
      )
    } catch (_e) {
      nil
    }
  }
  chat_banner(chat_cfg)
  let seed_context = load_seed_context(chat_cfg)
  let system = chat_system_prompt(chat_cfg, seed_context)
  let timeout_s = chat_cfg?.timeout_s ?? DEFAULT_TIMEOUT_S
  let slash_handlers = {
    "/cat": { req ->
      handle_cat(req.args, chat_cfg)
      return {kind: "handled"}
    },
    "/diff": { req ->
      handle_diff(req.args, chat_cfg)
      return {kind: "handled"}
    },
    "/pager": { req ->
      handle_cat(req.args, chat_cfg)
      return {kind: "handled"}
    },
    "/runs": { _req ->
      handle_runs(chat_cfg)
      return {kind: "handled"}
    },
  }
  let result = agent_chat_loop(
    {
      session_id: session_id,
      provider: chat_cfg?.provider ?? "ollama",
      model: chat_cfg?.model ?? "qwen3.6:35b-a3b-coding-nvfp4",
      tools: chat_cfg?.tools ?? tool_registry(),
      system_prompt: system,
      max_iterations: 8,
      iteration_budget: {mode: "adaptive", initial: 4, max: 8, extend_by: 2},
      max_tokens: 4000,
      temperature: 0.3,
      llm_caller: with_retry(default_llm_caller(), {max_attempts: 2}),
      llm_transcript_dir: transcript_dir,
      slash_commands: slash_handlers,
      on_user_input: { state ->
        let label = if state.turns ?? 0 == 0 {
          ANSI_CYAN + "you> " + ANSI_RESET + ANSI_DIM + "(/help to list commands) " + ANSI_RESET
        } else {
          ANSI_CYAN + "you> " + ANSI_RESET
        }
        let line = prompt_line(label, timeout_s)
        if line == nil {
          println(ANSI_DIM + "(no input within ${timeout_s}s — ending chat)" + ANSI_RESET)
          return {kind: "exit", reason: "timeout"}
        }
        if line == "/help" || line == "/?" {
          print_chat_help()
          return {kind: "handled"}
        }
        return agent_chat_route_input(line, state, slash_handlers)
      },
      on_model_turn: { turn, _state ->
        print_assistant_turn(turn)
        return nil
      },
    },
  )
  println(
    ANSI_DIM + "(chat closed — ${result.turns} turn(s), reason: ${result.stop_reason})"
      + ANSI_RESET,
  )
  return nil
}

fn print_assistant_turn(turn) {
  let body = trim(turn?.visible_text ?? turn?.text ?? turn?.prose ?? "")
  println("")
  if body == "" {
    let stop = trim(turn?.stop_reason ?? "")
    let tool_calls = turn?.tool_calls ?? []
    let tool_count = if type_of(tool_calls) == "list" {
      len(tool_calls)
    } else {
      0
    }
    var hint = "(no text from model"
    if stop != "" {
      hint = hint + " · stop_reason=${stop}"
    }
    if tool_count > 0 {
      hint = hint + " · ${tool_count} tool call(s)"
    }
    hint = hint + ")"
    println(ANSI_MAGENTA + "assistant>" + ANSI_RESET + " " + ANSI_YELLOW + hint + ANSI_RESET)
  } else {
    println(ANSI_MAGENTA + "assistant>" + ANSI_RESET + " " + body)
  }
  println("")
}
