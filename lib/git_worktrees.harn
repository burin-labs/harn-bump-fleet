/**
 * Shared parser for `git worktree list --porcelain` ownership records.
 * Return the path of the worktree that owns `branch`, or an empty string.
 */
pub fn git_worktree_path_for_branch(output: string, branch: string) -> string {
  let current_path = ""
  for line in output.split("\n") {
    const trimmed = trim(line)
    if starts_with(trimmed, "worktree ") {
      current_path = trim(trimmed.substring(len("worktree ")))
    } else if trimmed == "branch refs/heads/${branch}" {
      return current_path
    }
  }
  return ""
}
