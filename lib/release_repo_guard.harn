pub type ReleaseRepoPathState = {repo: string, exists: bool, git_marker_exists: bool}

pub type ReleaseRepoGuardConfig = {repo: string, mock: bool}

const RELEASE_REPO_GUARD_ACTION =
  "Rerun with --repo PATH pointing at an existing Harn checkout, or recreate the checkout."

fn release_repo_guard_when(phase: string) -> string {
  const p = trim(phase)
  if p == "" {
    return "before continuing"
  }
  return "before " + p
}

/** Return a clear release_harn --repo guard error, or nil when the path is usable. */
pub fn release_repo_path_error(state: ReleaseRepoPathState, phase: string = "") -> string? {
  const repo = trim(state.repo)
  const when = release_repo_guard_when(phase)
  if repo == "" {
    return "error: release_harn --repo is empty ${when}.\n${RELEASE_REPO_GUARD_ACTION}"
  }
  if !state.exists {
    return "error: release_harn configured --repo path is missing ${when}: ${repo}\nThe harness cannot safely continue because repo-scoped commands and agent tools would run without the target checkout. ${RELEASE_REPO_GUARD_ACTION}"
  }
  if !state.git_marker_exists {
    return "error: release_harn configured --repo path is not a git checkout ${when}: ${repo}\nExpected ${path_join(repo, ".git")} to exist. ${RELEASE_REPO_GUARD_ACTION}"
  }
  return nil
}

/** Snapshot just enough filesystem state to guard a configured release repo path. */
fn release_repo_path_state(harness: HarnessFs, repo: string) -> ReleaseRepoPathState {
  const path = trim(repo)
  const exists = path != "" && harness.exists(path)
  return {
    repo: path,
    exists: exists,
    git_marker_exists: exists && harness.exists(path_join(path, ".git")),
  }
}

/** Return a live-run guard error for cfg.repo, or nil when mock mode/path state is safe. */
pub fn release_repo_path_guard_error(
  harness: HarnessFs,
  cfg: ReleaseRepoGuardConfig,
  phase: string = "",
) -> string? {
  if cfg.mock {
    return nil
  }
  return release_repo_path_error(release_repo_path_state(harness, cfg.repo), phase)
}

/** Throw the guard error so callers fail before repo-scoped commands/tools run. */
pub fn require_release_repo_path(
  harness: HarnessFs,
  cfg: ReleaseRepoGuardConfig,
  phase: string = "",
) -> nil {
  const error = release_repo_path_guard_error(harness, cfg, phase)
  if error != nil {
    throw error
  }
  return nil
}
