import { command_run } from "std/command"
import { github_release_asset_names } from "./github"
import { strip_v } from "./semver"

pub type HarnReleaseArtifact = {target: string, archive: string, workflow_job: string}

/** One canonical catalog for release archives and the matrix jobs that produce them. */
pub fn harn_release_artifacts() -> list<HarnReleaseArtifact> {
  return [
    {
      target: "aarch64-apple-darwin",
      archive: "harn-aarch64-apple-darwin.tar.gz",
      workflow_job: "Build aarch64-apple-darwin",
    },
    {
      target: "aarch64-unknown-linux-gnu",
      archive: "harn-aarch64-unknown-linux-gnu.tar.gz",
      workflow_job: "Build aarch64-unknown-linux-gnu",
    },
    {
      target: "x86_64-apple-darwin",
      archive: "harn-x86_64-apple-darwin.tar.gz",
      workflow_job: "Build x86_64-apple-darwin",
    },
    {
      target: "x86_64-pc-windows-msvc",
      archive: "harn-x86_64-pc-windows-msvc.zip",
      workflow_job: "Build x86_64-pc-windows-msvc",
    },
    {
      target: "x86_64-unknown-linux-gnu",
      archive: "harn-x86_64-unknown-linux-gnu.tar.gz",
      workflow_job: "Build x86_64-unknown-linux-gnu",
    },
  ]
}

/** Return the exact matrix job names required to prove a complete cache warm. */
pub fn required_harn_release_build_jobs() -> list<string> {
  return harn_release_artifacts().map({ artifact -> artifact.workflow_job }).to_list()
}

/**
 * Return the release assets required before fleet workflows may dispatch.
 *
 * harn now uploads each architecture's archive to the release as that build
 * leg finishes (incremental per-arch publish), and writes SHA256SUMS + the
 * release-assets.json manifest only at the finalize step (which also flips the
 * release from prerelease to "latest"). So the five archives alone no longer
 * imply a complete release — they appear minutes before finalize. Requiring
 * SHA256SUMS + release-assets.json gates readiness on finalize, so dependents
 * are only bumped once the manifest every consumer verifies against exists.
 */
pub fn required_harn_release_assets() {
  return harn_release_artifacts().map({ artifact -> artifact.archive }).to_list()
    + ["SHA256SUMS", "release-assets.json"]
}

/** Return required release assets that are not present in the supplied asset list. */
pub fn missing_release_assets(asset_names, required_assets = nil) {
  const required = required_assets ?? required_harn_release_assets()
  return required.filter({ name -> !asset_names.any({ asset -> asset == name }) })
}

/** Render a concise operator-facing readiness summary. */
pub fn release_readiness_detail(snapshot) {
  const crate_detail = if snapshot.crate_published {
    "harn-cli ${snapshot.version_no_v} published"
  } else {
    "harn-cli ${snapshot.version_no_v} not visible on crates.io"
  }
  const asset_detail = if len(snapshot.missing_assets) == 0 {
    "required release assets present"
  } else {
    "missing release assets: " + join(snapshot.missing_assets, ", ")
  }
  return crate_detail + "; " + asset_detail
}

/** Return the crates.io API URL for one crate version. */
pub fn crates_io_version_url(crate_name, version_no_v) {
  return "https://crates.io/api/v1/crates/${crate_name}/${version_no_v}"
}

/** Return true when the target crate version is visible on crates.io. */
pub fn crate_version_published(crate_name, version_no_v) {
  return command_run(
    [
      "curl",
      "-fsSL",
      "-o",
      "/dev/null",
      "-A",
      "burin-labs/harn-bump-fleet release-readiness",
      "-H",
      "Accept: application/json",
      crates_io_version_url(crate_name, version_no_v),
    ],
  ).success
}

/** Return true when the target harn-cli crate is visible on crates.io. */
pub fn harn_crate_published(version_no_v) {
  return crate_version_published("harn-cli", version_no_v)
}

/** Snapshot crates.io and GitHub release-asset readiness for a Harn tag. */
pub fn harn_release_readiness(target) {
  const version_no_v = strip_v(target)
  const asset_names = try {
    github_release_asset_names("burin-labs/harn", target)
  } catch (e) {
    []
  }
  const missing_assets = missing_release_assets(asset_names)
  const crate_ready = harn_crate_published(version_no_v)
  return {
    target: target,
    version_no_v: version_no_v,
    crate_published: crate_ready,
    required_assets: required_harn_release_assets(),
    asset_names: asset_names,
    missing_assets: missing_assets,
    ready: crate_ready && len(missing_assets) == 0,
  }
}
