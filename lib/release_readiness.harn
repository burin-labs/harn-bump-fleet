import { gh_release_asset_names } from "./github_cli"
import { strip_v } from "./semver"

/** Return the release assets required before fleet workflows may dispatch. */
pub fn required_harn_release_assets() {
  return [
    "harn-aarch64-apple-darwin.tar.gz",
    "harn-aarch64-unknown-linux-gnu.tar.gz",
    "harn-x86_64-apple-darwin.tar.gz",
    "harn-x86_64-pc-windows-msvc.zip",
    "harn-x86_64-unknown-linux-gnu.tar.gz",
  ]
}

/** Return required release assets that are not present in the supplied asset list. */
pub fn missing_release_assets(asset_names, required_assets = nil) {
  let required = required_assets ?? required_harn_release_assets()
  return required.filter({ name -> !asset_names.any({ asset -> asset == name }) })
}

/** Render a concise operator-facing readiness summary. */
pub fn release_readiness_detail(snapshot) {
  let crate_detail = if snapshot.crate_published {
    "harn-cli ${snapshot.version_no_v} published"
  } else {
    "harn-cli ${snapshot.version_no_v} not visible on crates.io"
  }
  let asset_detail = if len(snapshot.missing_assets) == 0 {
    "required release assets present"
  } else {
    "missing release assets: " + join(snapshot.missing_assets, ", ")
  }
  return crate_detail + "; " + asset_detail
}

/** Return true when the target harn-cli crate is visible on crates.io. */
pub fn harn_crate_published(version_no_v) {
  return shell("cargo info harn-cli@${version_no_v} >/dev/null 2>&1").success
}

/** Snapshot crates.io and GitHub release-asset readiness for a Harn tag. */
pub fn harn_release_readiness(target) {
  let version_no_v = strip_v(target)
  let asset_names = try {
    gh_release_asset_names("burin-labs/harn", target)
  } catch (e) {
    []
  }
  let missing_assets = missing_release_assets(asset_names)
  let crate_ready = harn_crate_published(version_no_v)
  return {
    target: target,
    version_no_v: version_no_v,
    crate_published: crate_ready,
    required_assets: required_harn_release_assets(),
    asset_names: asset_names,
    missing_assets: missing_assets,
    ready: crate_ready && len(missing_assets) == 0,
  }
}
