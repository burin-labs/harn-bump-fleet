import { PlatformCertificationAdapter } from "./platform_certification"

/**
 * Operator-facing progress for the hosted certification wait.
 *
 * Split out of the certification module because that file sits at its source
 * length ceiling, and because this reporting is worth reading on its own: the
 * wait is the longest phase of a release, and it used to print nothing.
 */
// One poll is 10s, so this reports roughly every two minutes. A hosted Windows
// nextest lane runs 23-27 minutes and a macOS lane about 5, and before this the
// release printed nothing at all across that whole window: the operator saw a
// dead terminal for the longest phase of the run and could not tell waiting
// from hung.
pub const CERTIFICATION_HEARTBEAT_POLLS: int = 12

/** Emit one operator-facing progress line, when the adapter wired a sink. */
pub fn certification_log(adapter: PlatformCertificationAdapter, message: string) {
  const sink = adapter.log
  if sink != nil {
    sink(message)
  }
}

/** Render an elapsed millisecond span as `4m12s`, for progress lines. */
pub fn elapsed_label(elapsed_ms: int) -> string {
  const total_s = elapsed_ms / 1000
  const minutes = total_s / 60
  const seconds = total_s - minutes * 60
  if minutes == 0 {
    return "${seconds}s"
  }
  return "${minutes}m${seconds}s"
}

/** Where an operator can watch one certification lane run. */
pub fn certification_run_url(repo: string, run_id) -> string {
  return "https://github.com/${repo}/actions/runs/${to_string(run_id)}"
}
