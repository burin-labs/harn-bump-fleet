import {
  ProgressReporter,
  progress_finish,
  progress_start,
  progress_tick,
} from "std/lifecycle/progress"

/** Clock, optional log sink, and optional Harness for stdlib progress. */
pub type CertificationProgressSink = {now_ms: fn() -> int, log?: fn(string) -> nil, host?: Harness}

/**
 * Operator-facing progress for the hosted certification wait.
 *
 * Split out of the certification module because that file sits at its source
 * length ceiling. The wait is the longest phase of a release. Stdlib
 * `std/lifecycle/progress` owns throttling; this module names the stage and
 * the adapter log sink used by tests that do not hold a Harness.
 */
// 720 polls * 10s = 2h, the await_platform ceiling.
pub const CERTIFICATION_LANE_LIMIT_MS: int = 7200000

// Fallback when no Harness is wired: one poll is 10s, so 6 polls is ~60s,
// matching PROGRESS_DEFAULT_INTERVAL_MS.
pub const CERTIFICATION_HEARTBEAT_POLLS: int = 6

pub type CertificationWaitReporter = {reporter: ProgressReporter?, last_status: string}

/** Emit one operator-facing progress line, when the adapter wired a sink. */
pub fn certification_log(adapter: CertificationProgressSink, message: string) -> nil {
  const sink = adapter.log
  if sink != nil {
    sink(message)
  }
}

/** Render an elapsed millisecond span as `4m12s`, for progress lines. */
pub fn elapsed_label(elapsed_ms: int) -> string {
  const total_s = elapsed_ms / 1000
  const minutes = total_s / 60
  const seconds = total_s - minutes * 60
  if minutes == 0 {
    return "${seconds}s"
  }
  return "${minutes}m${seconds}s"
}

/** Where an operator can watch one certification lane run. */
pub fn certification_run_url(repo: string, run_id: int) -> string {
  return "https://github.com/${repo}/actions/runs/${to_string(run_id)}"
}

/** Open a certification-lane wait with a start line and a 2h ceiling. */
pub fn certification_wait_begin(
  adapter: CertificationProgressSink,
  spec: dict,
  repo: string,
  run_id: int,
) -> CertificationWaitReporter {
  const stage = "${spec.platform} certification"
  const host = adapter.host
  certification_log(
    adapter,
    "   → ${stage}: waiting on ${spec.required_job} · ${certification_run_url(repo, run_id)}",
  )
  if host == nil {
    return {reporter: nil, last_status: ""}
  }
  return {
    reporter: progress_start(host, stage, {limit_ms: CERTIFICATION_LANE_LIMIT_MS}),
    last_status: "",
  }
}

/** Heartbeat or state-change line for one poll. */
pub fn certification_wait_poll(
  adapter: CertificationProgressSink,
  wait: CertificationWaitReporter,
  spec: dict,
  status: string,
  started_at_ms: int,
  poll: int,
) -> CertificationWaitReporter {
  const elapsed = elapsed_label(adapter.now_ms() - started_at_ms)
  const state = "still ${status} after ${elapsed}"
  const host = adapter.host
  if host != nil && wait.reporter != nil {
    return {reporter: progress_tick(host, wait.reporter, state), last_status: status}
  }
  if poll % CERTIFICATION_HEARTBEAT_POLLS == 0 || status != wait.last_status {
    certification_log(adapter, "     ${spec.platform} certification ${state}")
  }
  return wait + {last_status: status}
}

/** Close the lane wait with exactly one terminal line. */
pub fn certification_wait_end(
  adapter: CertificationProgressSink,
  wait: CertificationWaitReporter,
  spec: dict,
  conclusion: string,
  started_at_ms: int,
) -> CertificationWaitReporter {
  const elapsed = elapsed_label(adapter.now_ms() - started_at_ms)
  const outcome = if conclusion == "success" {
    "ok"
  } else if conclusion == "cancelled" {
    "cancelled"
  } else {
    "failed"
  }
  certification_log(adapter, "   ✓ ${spec.platform} certification ${conclusion} after ${elapsed}")
  const host = adapter.host
  if host != nil && wait.reporter != nil {
    return {
      reporter: progress_finish(host, wait.reporter, outcome, conclusion),
      last_status: conclusion,
    }
  }
  return wait + {last_status: conclusion}
}
