import { GithubWorkflowJob, GithubWorkflowStep, decode_github_workflow } from "./github_workflow"

pub const CHECKOUT_ACTION = "actions/checkout"

pub type WorkflowCheckoutSource = {path: string, source: string}

pub type WorkflowCheckoutStep = {
  path: string,
  job: string,
  step: string,
  persist_credentials_declared: bool,
  persists_credentials: bool,
}

pub type WorkflowCheckoutCensus = {
  ok: bool,
  measured: list<WorkflowCheckoutStep>,
  violations: list<WorkflowCheckoutStep>,
  unreadable: list<string>,
}

fn checkout_step_label(step: GithubWorkflowStep, index: int) -> string {
  const named = trim(step.name ?? "")
  return if named == "" {
    "step ${index}"
  } else {
    named
  }
}

fn step_is_checkout(step: GithubWorkflowStep) -> bool {
  const uses = trim(step.uses ?? "")
  return uses == CHECKOUT_ACTION
    || starts_with(uses, "${CHECKOUT_ACTION}@")
    || starts_with(uses, "${CHECKOUT_ACTION}/")
}

fn job_checkout_steps(
  path: string,
  job: string,
  value: GithubWorkflowJob,
) -> list<WorkflowCheckoutStep> {
  let found: list<WorkflowCheckoutStep> = []
  let index = 0
  for step in value.steps ?? [] {
    index = index + 1
    if !step_is_checkout(step) {
      continue
    }
    const declared = step.with?.get("persist-credentials")
    found = found
      + [
        {
          path: path,
          job: job,
          step: checkout_step_label(step, index),
          persist_credentials_declared: declared != nil,
          persists_credentials: declared != false,
        },
      ]
  }
  return found
}

/** Every `actions/checkout` step one workflow declares, with its credential disposition. */
pub fn workflow_checkout_steps(path: string, source: string) -> list<WorkflowCheckoutStep> {
  const workflow = decode_github_workflow(source)
  let found: list<WorkflowCheckoutStep> = []
  for job in workflow.jobs {
    found = found + job_checkout_steps(path, job.key, job.value)
  }
  return found
}

/**
 * Judge every checkout in the repository's own workflows.
 *
 * A persisted credential writes an `include.path` into `.git/config` that
 * points at a `$RUNNER_TEMP` file. Git reads that include on every later
 * invocation and treats an unreadable one as fatal, so a step running from a
 * different temp root or under a sandbox dies on configuration rather than on
 * its own work.
 *
 * An empty census is never a pass. Measuring no checkouts and measuring no
 * violations are different answers, and a census that cannot tell them apart
 * would go green the day the decoder or the inventory silently stops
 * returning workflows. A workflow that cannot be decoded is a failure too,
 * not an absent one.
 */
pub fn workflow_checkout_census(sources: list<WorkflowCheckoutSource>) -> WorkflowCheckoutCensus {
  let measured: list<WorkflowCheckoutStep> = []
  let violations: list<WorkflowCheckoutStep> = []
  let unreadable: list<string> = []
  for entry in sources {
    const decoded = try {
      workflow_checkout_steps(entry.path, entry.source)
    }
    if is_err(decoded) {
      unreadable = unreadable + [entry.path]
      continue
    }
    for step in unwrap(decoded) {
      measured = measured + [step]
      if step.persists_credentials {
        violations = violations + [step]
      }
    }
  }
  return {
    ok: len(measured) > 0 && len(violations) == 0 && len(unreadable) == 0,
    measured: measured,
    violations: violations,
    unreadable: unreadable,
  }
}

/** One operator line per checkout that still persists a credential. */
pub fn workflow_checkout_violation_lines(census: WorkflowCheckoutCensus) -> list<string> {
  let lines: list<string> = []
  for path in census.unreadable {
    lines = lines + ["${path}: workflow could not be decoded, so its checkouts are unmeasured"]
  }
  for step in census.violations {
    const detail = if step.persist_credentials_declared {
      "sets persist-credentials true"
    } else {
      "does not set persist-credentials"
    }
    lines = lines
      + ["${step.path}: job ${step.job}, ${step.step} ${detail}; it must set it to false"]
  }
  if len(census.measured) == 0 {
    lines = lines + ["no checkout steps were measured at all, so this census proved nothing"]
  }
  return lines
}
