import { HarnReleaseContract, contract_next_development_version } from "./harn_release_contract"
import {
  PreflightPrecondition,
  preflight_fail,
  preflight_pass,
  preflight_unavailable,
} from "./release_launch_preflight"
import { is_release_changelog_fragment_name } from "./release_note_fold"
import { prior_release_fold_base_evidence, prior_release_fold_decision } from "./release_preflight"

/**
 * The one stop before anything is tagged, as four separable questions.
 *
 * Nine consecutive patch releases each hit at least one complication, and the
 * shape was always the same: a stage inferred the previous stage's success from
 * a workflow run's conclusion. A run conclusion says a job finished, not what
 * the system decided. These four assertions read the decision instead -- the
 * version the default branch actually carries, the fragments the tree actually
 * holds, the contract's own verdict on that evidence, and each consumer's pin
 * by value.
 *
 * Every one is pure. The evidence is gathered once by the caller and the
 * decisions are taken here, so the same checkpoint can be asked at launch about
 * the base and again at the tag about the commit being tagged, without two
 * implementations disagreeing about what "green" means.
 */
pub type ConsumerPinReading = {slug: string, pin: string?, evidence: string}

pub type ReleaseCheckpointEvidence = {
  /** The commit these tree facts were read at; "" when none was read. */
  commit: string,
  base_ref: string,
  latest_tag: string,
  cargo_toml: string,
  changelog: string,
  contract: HarnReleaseContract,
  /**
   * Names directly under `changelog.d/` at `commit`.
   *
   * `nil` distinguishes "not read" from "read and empty". A tree whose
   * `changelog.d/` is absent is an empty list, not nil.
   */
  fragment_entries: list<string>?,
  /** Why the fragment listing was not read, when it was not. */
  fragment_unread_reason: string,
  /** One row per consumer the manifest names; `nil` pin means unread. */
  consumer_pins: list<ConsumerPinReading>?,
  /** Why consumer pins were not read, when they were not. */
  consumer_pins_unread_reason: string,
}

/**
 * Does the default branch carry the exact next development version?
 *
 * Deliberately stricter than the release contract's own fold gate, which
 * accepts either the released version or its development form. Two releases
 * published while the post-release cutover job failed in the same run, and the
 * next cut then died on a precondition four hours later naming three causes,
 * none of them the real one. Only the development form proves the cutover
 * actually happened.
 */
pub fn checkpoint_development_version_precondition(
  evidence: ReleaseCheckpointEvidence,
) -> PreflightPrecondition {
  const latest = trim(evidence.latest_tag)
  if latest == "" {
    return preflight_pass(
      "checkpoint.development_version",
      "no prior release exists, so no cutover is owed",
    )
  }
  const latest_version = if starts_with(latest, "v") {
    latest[1:len(latest)]
  } else {
    latest
  }
  const expected = contract_next_development_version(evidence.contract, latest_version)
  const observed = trim(workspace_version_of(evidence))
  if observed == "" {
    return preflight_fail(
      "checkpoint.development_version",
      "${evidence.base_ref} carries no readable workspace version",
      "check that Cargo.toml still declares [workspace.package] version",
    )
  }
  if observed != expected {
    return preflight_fail(
      "checkpoint.development_version",
      "${evidence.base_ref} carries ${observed}, not the ${expected} the ${latest} cutover owes",
      "land the post-release development cutover before cutting again",
    )
  }
  return preflight_pass(
    "checkpoint.development_version",
    "${evidence.base_ref} carries ${expected}, the cutover ${latest} owes",
  )
}

fn workspace_version_of(evidence: ReleaseCheckpointEvidence) -> string {
  return prior_release_fold_base_evidence(
    evidence.base_ref,
    evidence.latest_tag,
    evidence.cargo_toml,
    evidence.changelog,
    evidence.contract,
  ).workspace_version
}

/** Every unfolded fragment name in a `changelog.d/` listing, in listing order. */
pub fn checkpoint_unfolded_fragments(entries: list<string>) -> list<string> {
  return entries.filter({ name -> return is_release_changelog_fragment_name(name) }).to_list()
}

/**
 * Does the tree that will be tagged hold zero unfolded fragments?
 *
 * Three of the last nine tags carried stray fragments, and an immutable tag
 * that keeps one is refused at publication with no cheap way back. The
 * infrastructure files that legitimately live in `changelog.d/` are not
 * fragments and are not counted; the naming convention decides, and it has one
 * owner.
 */
pub fn checkpoint_fragment_precondition(
  evidence: ReleaseCheckpointEvidence,
) -> PreflightPrecondition {
  if evidence.fragment_entries == nil {
    return preflight_unavailable(
      "checkpoint.changelog_fragments",
      "not asked: ${evidence.fragment_unread_reason}",
    )
  }
  const unfolded = checkpoint_unfolded_fragments(evidence.fragment_entries ?? [])
  const at = if trim(evidence.commit) == "" {
    evidence.base_ref
  } else {
    trim(evidence.commit)
  }
  if len(unfolded) > 0 {
    return preflight_fail(
      "checkpoint.changelog_fragments",
      "${at} still holds ${to_string(len(unfolded))} unfolded fragment(s): "
        + join(unfolded, ", "),
      "fold the fragments into the release notes before the tag; a tag is immutable and "
        + "publication refuses one that carries them",
    )
  }
  return preflight_pass(
    "checkpoint.changelog_fragments",
    "${at} holds no unfolded changelog fragment",
  )
}

/**
 * Is the release contract's own verdict green on this evidence?
 *
 * A release pull request merged while its dedicated contract check was
 * terminal red, because no ruleset required that check. Reading the contract's
 * decision rather than a check run's conclusion is what makes that
 * unrepeatable: a check can be renamed, unrequired, or never created, and each
 * of those reads as green to anything that looks for a conclusion.
 */
pub fn checkpoint_release_contract_precondition(
  evidence: ReleaseCheckpointEvidence,
) -> PreflightPrecondition {
  const decision = prior_release_fold_decision(
    prior_release_fold_base_evidence(
      evidence.base_ref,
      evidence.latest_tag,
      evidence.cargo_toml,
      evidence.changelog,
      evidence.contract,
    ),
  )
  if !decision.proceed {
    return preflight_fail(
      "checkpoint.release_contract",
      "${decision.reason}: ${decision.detail}",
      "make the release contract green on this commit before anything is tagged",
    )
  }
  return preflight_pass("checkpoint.release_contract", decision.reason)
}

/**
 * Is every consumer's current pin known by value?
 *
 * Convergence was proven per repository by orchestrator state and reason
 * strings, so a consumer could be reported converged with an unmoved pin, and
 * consumers went several releases unpinned with no alarm. A pin that could not
 * be read is reported by name here rather than dropped from the count, because
 * a repository nobody could read and a repository that is fine are the two
 * answers this precondition exists to keep apart.
 */
pub fn checkpoint_consumer_pin_precondition(
  evidence: ReleaseCheckpointEvidence,
) -> PreflightPrecondition {
  if evidence.consumer_pins == nil {
    return preflight_unavailable(
      "checkpoint.consumer_pins",
      "not asked: ${evidence.consumer_pins_unread_reason}",
    )
  }
  const readings = evidence.consumer_pins ?? []
  if len(readings) == 0 {
    // An empty consumer set satisfies "every pin is known" vacuously, and a
    // manifest that resolved to nothing is a defect rather than a clean read.
    return preflight_fail(
      "checkpoint.consumer_pins",
      "the manifest named no consumer to read a pin from",
      "check the fleet manifest; a release with no consumers to converge is not a release",
    )
  }
  let unread: list<string> = []
  for reading in readings {
    if trim(to_string(reading.pin ?? "")) == "" {
      unread = unread + ["${reading.slug} (${reading.evidence})"]
    }
  }
  if len(unread) > 0 {
    return preflight_fail(
      "checkpoint.consumer_pins",
      "${to_string(len(unread))} of ${to_string(len(readings))} consumer pins are unknown: "
        + join(unread, "; "),
      "make each consumer's pin readable before the tag; an unread pin cannot be proven to "
        + "have moved afterwards",
    )
  }
  return preflight_pass(
    "checkpoint.consumer_pins",
    "all ${to_string(len(readings))} consumer pins read by value",
  )
}

/** The whole checkpoint, in the order an operator reads it. */
pub fn release_checkpoint_preconditions(
  evidence: ReleaseCheckpointEvidence,
) -> list<PreflightPrecondition> {
  return [
    checkpoint_development_version_precondition(evidence),
    checkpoint_release_contract_precondition(evidence),
    checkpoint_fragment_precondition(evidence),
    checkpoint_consumer_pin_precondition(evidence),
  ]
}

/** The four checkpoint names, so a context that cannot ask still lists them. */
pub const RELEASE_CHECKPOINT_NAMES: list<string> = [
  "checkpoint.development_version",
  "checkpoint.release_contract",
  "checkpoint.changelog_fragments",
  "checkpoint.consumer_pins",
]

/**
 * The checkpoint, reported unasked.
 *
 * A context without the reads still has to name all four. Omitting them would
 * shorten the receipt into one that looks like it asked less and found nothing
 * wrong, which is the reading this whole receipt shape refuses.
 */
pub fn release_checkpoint_unavailable(reason: string) -> list<PreflightPrecondition> {
  let checks: list<PreflightPrecondition> = []
  for name in RELEASE_CHECKPOINT_NAMES {
    checks = checks + [preflight_unavailable(name, "not asked: ${reason}")]
  }
  return checks
}
