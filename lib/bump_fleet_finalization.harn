import { FleetRunContext } from "./bump_fleet_pre_dispatch"
import { ChatRunConfig } from "./chat_runs"
import { FleetAuditReceipt, FleetOutcomeReceipt } from "./run_receipts"

pub type FleetFinalizationOptions = {dry_run: bool, no_chat: bool, chat_timeout_s: int}

pub type FleetFinalizationResult = {exit_code: int, audit_json_path: string, audit_md_path: string}

pub type FleetFinalizationAdapter = {
  now_iso: fn() -> string,
  elapsed_ms: fn(dict) -> int,
  operator: fn() -> string,
  host: fn() -> string,
  dispatched: fn(string) -> bool,
  summarize: fn(dict, bool) -> any,
  cleanup: fn(bool) -> any,
  problem: fn(FleetOutcomeReceipt) -> bool,
  finish_run: fn(dict, dict) -> any,
  timing_artifacts: fn() -> any,
  write_audit: fn(string, FleetAuditReceipt) -> any,
  chat_enabled: fn(FleetFinalizationOptions) -> bool,
  run_dir: fn(string) -> string,
  repo_root: fn() -> string,
  chat_tools: fn() -> dict,
  run_chat: fn(ChatRunConfig) -> nil,
}

/** Own summary, cleanup, durable audit, exit selection, and optional operator chat. */
pub fn fleet_finalization_phase(
  harness: Harness,
  context: FleetRunContext,
  outcomes: list<FleetOutcomeReceipt>,
  options: FleetFinalizationOptions,
  summary_model: string,
  summary_provider: string,
  adapter: FleetFinalizationAdapter,
) -> FleetFinalizationResult {
  const core_payload = {
    schema_version: "harn_bump_fleet.audit.v1",
    run_id: context.run_id,
    started_iso: context.started_iso,
    finished_iso: adapter.now_iso(),
    duration_ms: adapter.elapsed_ms(context.run_timing),
    operator: adapter.operator(),
    host: adapter.host(),
    target_version: context.target,
    mode: context.mode,
    repos_total: len(context.repos),
    repos_dispatched: len(
      outcomes.filter(
        { outcome ->
          return if adapter.dispatched(outcome.status) {
            true
          } else {
            false
          }
        },
      ),
    ),
    summary_model: summary_model,
    summary_text: "",
    run_session_view: context.view_gate,
    public_surface_impact: context.public_surface_impact,
    outcomes: outcomes,
  }
  harness.stdio.println("\n== summarizing with ${summary_model} ...")
  const summary = adapter.summarize(core_payload, options.dry_run)
  const cleanup = adapter.cleanup(options.dry_run)
  if cleanup != nil {
    harness.stdio.println("\n== local checkout cleanup")
    harness.stdio.println("   ${cleanup.detail}")
  }
  const any_error = outcomes.any(
    { outcome ->
      return if adapter.problem(outcome) {
        true
      } else {
        false
      }
    },
  )
  const report = adapter.finish_run(
    context.run_timing,
    {
      status: if any_error {
        "error"
      } else {
        "ok"
      },
      outcome: if any_error {
        "failed"
      } else {
        "ok"
      },
    },
  )
  const timing = adapter.timing_artifacts()
  const payload = {
    ...core_payload,
    finished_iso: adapter.now_iso(),
    duration_ms: report.duration_ms,
    summary_text: summary.text,
    summary: summary,
    cleanup: cleanup,
    trace_spans: timing.trace_spans,
    timing_summary: timing.timing_summary,
  }
  const written = adapter.write_audit(context.run_id, payload)
  harness.stdio.println("\n== audit written")
  harness.stdio.println("   json: ${written.json_path}")
  harness.stdio.println("   md  : ${written.md_path}")
  harness.stdio.println("\n${summary.text}")
  if adapter.chat_enabled(options) {
    adapter.run_chat(
      {
        harness_kind: "bump-fleet",
        run_id: context.run_id,
        run_dir: adapter.run_dir(context.run_id),
        audit_md_path: written.md_path,
        audit_json_path: written.json_path,
        llm_transcript_path: nil,
        provider: summary_provider,
        model: summary_model,
        repo: adapter.repo_root(),
        mode_hint: context.mode,
        outcome: if any_error {
          "FAILED"
        } else {
          "ok"
        },
        tools: adapter.chat_tools(),
        timeout_s: options.chat_timeout_s,
        no_chat: options.no_chat,
      },
    )
  }
  return {
    exit_code: if any_error {
      1
    } else {
      0
    },
    audit_json_path: written.json_path,
    audit_md_path: written.md_path,
  }
}
