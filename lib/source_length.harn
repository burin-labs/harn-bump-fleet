pub type SourceLengthEntry = {path: string, lines: int}

const SOURCE_SUFFIXES = [".harn", ".sh", ".md", ".prompt", ".template", ".toml"]

/** Keep source-length policy scoped to tracked handwritten source. */
pub fn maintained_source_path(path: string) -> bool {
  if path == "" || path == "CLAUDE.md" || basename(path) == ".harn" {
    return false
  }
  if starts_with(path, ".harn/") || contains(path, "/.harn/") {
    return false
  }
  if starts_with(path, ".github/workflows/") {
    return ends_with(path, ".yml") || ends_with(path, ".yaml")
  }
  for suffix in SOURCE_SUFFIXES {
    if ends_with(path, suffix) {
      return true
    }
  }
  return false
}

/** Parse `git ls-files -z` output without corrupting valid newline-containing paths. */
pub fn tracked_source_paths(git_ls_files_output: string) -> list<string> {
  return split(git_ls_files_output, "\0").filter({ path -> return maintained_source_path(path) }).to_list()
    .sort()
}

pub fn source_line_count(text: string) -> int {
  if text == "" {
    return 0
  }
  const trailing = if ends_with(text, "\n") {
    1
  } else {
    0
  }
  return len(split(text, "\n")) - trailing
}

pub fn source_length_violations(
  entries: list<SourceLengthEntry>,
  limit: int = 1500,
) -> list<SourceLengthEntry> {
  return entries.filter({ entry -> return entry.lines > limit }).sort_by({ entry -> return entry.path })
}
