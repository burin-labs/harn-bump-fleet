pub type SourceLengthEntry = {path: string, lines: int}

pub fn source_line_count(text: string) -> int {
  if text == "" {
    return 0
  }
  const trailing = if ends_with(text, "\n") {
    1
  } else {
    0
  }
  return len(split(text, "\n")) - trailing
}

pub fn source_length_violations(entries: list<SourceLengthEntry>, limit: int = 1500) -> list<SourceLengthEntry> {
  return entries.filter({ entry -> return entry.lines > limit }).sort_by({ entry -> return entry.path })
}
