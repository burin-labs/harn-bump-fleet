import { HarnUpdateSpec } from "./fleet_manifest"
import { bump_adapter_admission } from "./fleet_policy"
import { github_file_text_at_ref_result } from "./github"

/** Compare one repository's live base-branch adapter with its resolved semantic contract. */
pub fn live_bump_adapter_admission(harness: Harness, update: HarnUpdateSpec) {
  return bump_adapter_admission(
    update.adapter,
    github_file_text_at_ref_result(
      harness,
      update.repository,
      update.workflow_path,
      update.base_branch,
    ),
  )
}
