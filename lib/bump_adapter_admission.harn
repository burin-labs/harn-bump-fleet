import { HarnUpdateSpec } from "./fleet_manifest"
import {
  BumpAdapterAdmission,
  bump_adapter_admission,
  bump_repository_capability_admission,
} from "./fleet_policy"
import { github_connector_options, github_file_text_at_ref_result } from "./github"
import { github_repository_auto_merge_enabled } from "./github_repository_settings"
import { GithubClientOptions } from "harn-github-connector/default"

/** Compare one repository's live base-branch adapter with its resolved semantic contract. */
pub fn live_bump_adapter_admission(
  harness: Harness,
  update: HarnUpdateSpec,
  options: GithubClientOptions = github_connector_options(),
) -> BumpAdapterAdmission {
  const adapter = bump_adapter_admission(
    update.adapter,
    github_file_text_at_ref_result(
      harness,
      update.repository,
      update.workflow_path,
      update.base_branch,
      options,
    ),
  )
  if !adapter.ok {
    return adapter
  }
  return bump_repository_capability_admission(
    update.adapter,
    { -> github_repository_auto_merge_enabled(harness, update.repository, options) },
  )
}
