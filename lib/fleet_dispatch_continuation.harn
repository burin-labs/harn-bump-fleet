import { read_json_typed_result, write_json } from "std/fs"
import { FleetRepo } from "./bump_fleet_pre_dispatch"
import {
  FleetDispatchScope,
  fleet_operation_scope,
  fleet_scope_members,
} from "./fleet_operation_scope"
import { FleetOutcomeReceipt } from "./run_receipts"

/** One accepted GitHub workflow run bound to its declared update lineage. */
pub type FleetDispatchContinuation = {
  repository: string,
  target: string,
  workflow: string,
  run_id: int,
  run_url: string,
  base_branch: string,
  branch: string,
}

/**
 * Immutable repository census owned by one controller chain.
 * Durable handoff from dispatch into exact-run convergence observation.
 */
pub type FleetDispatchContinuationReceipt = {
  schema_version: "harn_bump_fleet.dispatch_continuation.v3",
  target: string,
  chain_id: string,
  scope: FleetDispatchScope,
  update_round: int,
  controller_run_id: int,
  controller_run_attempt: int,
  dispatches: list<FleetDispatchContinuation>,
}

/** Exact hosted-controller lineage that owns one dispatch handoff. */
pub type FleetDispatchLineage = {
  target: string,
  chain_id: string,
  scope: FleetDispatchScope,
  update_round: int,
  controller_run_id: int,
  controller_run_attempt: int,
}

/** Normalize the optional repository selector once for persistence and comparison. */
pub fn fleet_dispatch_scope(
  only: string? = nil,
  repositories_json: string? = nil,
) -> FleetDispatchScope {
  if repositories_json != nil {
    return fleet_operation_scope(only, repositories_json)
  }
  const repository = trim(only ?? "")
  return if repository == "" {
    {kind: "fleet"}
  } else {
    {kind: "repository", repository: repository}
  }
}

/** Reject incomplete lineage before a hosted run can publish resumable state. */
pub fn fleet_dispatch_lineage(
  target: string,
  chain_id: string,
  scope: FleetDispatchScope,
  update_round: int,
  controller_run_id: int,
  controller_run_attempt: int,
) -> FleetDispatchLineage {
  if trim(target) == "" || trim(chain_id) == "" || update_round < 1 || controller_run_id < 1
    || controller_run_attempt
      < 1 {
    throw "dispatch continuation requires target, chain, scope, positive round, run ID, and run attempt"
  }
  if scope.kind == "repository" && trim(scope.repository) == "" {
    throw "repository dispatch continuation scope cannot be empty"
  }
  const members = fleet_scope_members(scope)
  if members != nil {
    fleet_operation_scope(nil, json_stringify(members))
  }
  return {
    target: target,
    chain_id: chain_id,
    scope: scope,
    update_round: update_round,
    controller_run_id: controller_run_id,
    controller_run_attempt: controller_run_attempt,
  }
}

/** Retain only outcomes that prove GitHub accepted a specific workflow run. */
pub fn fleet_dispatch_continuation_receipt(
  lineage: FleetDispatchLineage,
  repos: list<FleetRepo>,
  outcomes: list<FleetOutcomeReceipt>,
) -> FleetDispatchContinuationReceipt {
  let by_slug = {}
  for repo in repos {
    by_slug[repo.slug] = repo
  }
  let dispatches: list<FleetDispatchContinuation> = []
  for outcome in outcomes {
    const members = fleet_scope_members(lineage.scope)
    if members != nil && !contains(members, outcome.slug) {
      throw "dispatch outside operation scope"
    }
    const repo = by_slug[outcome.slug]
    if repo == nil || outcome.run_id == nil || trim(outcome.run_url ?? "") == "" {
      continue
    }
    dispatches = dispatches
      + [
        {
          repository: outcome.slug,
          target: lineage.target,
          workflow: repo.update.workflow_name,
          run_id: outcome.run_id ?? 0,
          run_url: outcome.run_url ?? "",
          base_branch: repo.update.base_branch,
          branch: repo.update.branch,
        },
      ]
  }
  return {
    schema_version: "harn_bump_fleet.dispatch_continuation.v3",
    target: lineage.target,
    chain_id: lineage.chain_id,
    scope: lineage.scope,
    update_round: lineage.update_round,
    controller_run_id: lineage.controller_run_id,
    controller_run_attempt: lineage.controller_run_attempt,
    dispatches: dispatches,
  }
}

/** Atomically persist accepted run identities before later workflow steps observe them. */
pub fn fleet_dispatch_continuation_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  path: string,
  receipt: FleetDispatchContinuationReceipt,
) -> string {
  harness.fs.mkdir(dirname(path), true)
  const temporary = path + ".tmp-" + harness.random.uuid_v7()
  write_json(harness.fs, temporary, receipt, {pretty: true})
  harness.fs.rename(temporary, path)
  return path
}

fn continuation_entry_dir(path: string) -> string {
  return path + ".d"
}

fn continuation_entry_path(path: string, repository: string) -> string {
  return path_join(continuation_entry_dir(path), sha3_256(repository)[0:24] + ".json")
}

/** Persist one accepted run immediately without contending with parallel repositories. */
pub fn fleet_dispatch_continuation_entry_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  path: string,
  lineage: FleetDispatchLineage,
  repo: FleetRepo,
  run_id: int,
  run_url: string,
) -> string {
  const members = fleet_scope_members(lineage.scope)
  if members != nil && !contains(members, repo.slug) {
    throw "dispatch outside operation scope"
  }
  const receipt: FleetDispatchContinuationReceipt = {
    schema_version: "harn_bump_fleet.dispatch_continuation.v3",
    target: lineage.target,
    chain_id: lineage.chain_id,
    scope: lineage.scope,
    update_round: lineage.update_round,
    controller_run_id: lineage.controller_run_id,
    controller_run_attempt: lineage.controller_run_attempt,
    dispatches: [
      {
        repository: repo.slug,
        target: lineage.target,
        workflow: repo.update.workflow_name,
        run_id: run_id,
        run_url: run_url,
        base_branch: repo.update.base_branch,
        branch: repo.update.branch,
      },
    ],
  }
  return fleet_dispatch_continuation_write(
    harness,
    continuation_entry_path(path, repo.slug),
    receipt,
  )
}

fn fleet_dispatch_continuation_read_one(
  fs: HarnessFs,
  path: string,
) -> FleetDispatchContinuationReceipt {
  const loaded = read_json_typed_result<FleetDispatchContinuationReceipt>(
    fs,
    path,
    schema_of(FleetDispatchContinuationReceipt),
  )
  if is_err(loaded) {
    throw "invalid fleet dispatch continuation receipt '${path}': " + to_string(unwrap_err(loaded))
  }
  const receipt = unwrap(loaded)
  const members = fleet_scope_members(receipt.scope)
  if members != nil {
    fleet_operation_scope(nil, json_stringify(members))
    for dispatch in receipt.dispatches {
      if !contains(members, dispatch.repository) {
        throw "continuation contains dispatch outside scope"
      }
    }
  }
  return receipt
}

/** Read one structurally valid continuation receipt; absence is an empty handoff. */
pub fn fleet_dispatch_continuation_read(
  fs: HarnessFs,
  path: string,
) -> FleetDispatchContinuationReceipt? {
  if trim(path) == "" || !fs.exists(path) {
    const entry_dir = continuation_entry_dir(path)
    if trim(path) == "" || !fs.exists(entry_dir) {
      return nil
    }
  }
  let target = ""
  let chain_id = ""
  let scope: FleetDispatchScope? = nil
  let update_round = 0
  let controller_run_id = 0
  let controller_run_attempt = 0
  let dispatches = {}
  if fs.exists(path) {
    const aggregate = fleet_dispatch_continuation_read_one(fs, path)
    target = aggregate.target
    chain_id = aggregate.chain_id
    scope = aggregate.scope
    update_round = aggregate.update_round
    controller_run_id = aggregate.controller_run_id
    controller_run_attempt = aggregate.controller_run_attempt
    for dispatch in aggregate.dispatches {
      if dispatches[dispatch.repository] != nil && dispatches[dispatch.repository] != dispatch {
        throw "conflicting duplicate dispatch continuation"
      }
      dispatches[dispatch.repository] = dispatch
    }
  }
  const entry_dir = continuation_entry_dir(path)
  if fs.exists(entry_dir) {
    for name in fs.list_dir(entry_dir).sort() {
      if !ends_with(name, ".json") {
        continue
      }
      const entry = fleet_dispatch_continuation_read_one(fs, path_join(entry_dir, name))
      if target != ""
        && [
          entry.target,
          entry.chain_id,
          entry.scope,
          entry.update_round,
          entry.controller_run_id,
          entry.controller_run_attempt,
        ]
          != [target, chain_id, scope, update_round, controller_run_id, controller_run_attempt] {
        throw "fleet dispatch continuation fragments disagree on controller lineage"
      }
      target = entry.target
      chain_id = entry.chain_id
      scope = entry.scope
      update_round = entry.update_round
      controller_run_id = entry.controller_run_id
      controller_run_attempt = entry.controller_run_attempt
      for dispatch in entry.dispatches {
        if dispatches[dispatch.repository] != nil && dispatches[dispatch.repository] != dispatch {
          throw "conflicting duplicate dispatch continuation"
        }
        dispatches[dispatch.repository] = dispatch
      }
    }
  }
  let merged: list<FleetDispatchContinuation> = []
  for entry in dispatches {
    merged = merged + [entry.value]
  }
  return {
    schema_version: "harn_bump_fleet.dispatch_continuation.v3",
    target: target,
    chain_id: chain_id,
    scope: scope ?? {kind: "fleet"},
    update_round: update_round,
    controller_run_id: controller_run_id,
    controller_run_attempt: controller_run_attempt,
    dispatches: merged,
  }
}

/** Admit only the exact predecessor run declared by the successor workflow. */
pub fn require_fleet_dispatch_continuation_predecessor(
  receipt: FleetDispatchContinuationReceipt?,
  expected: FleetDispatchLineage,
) -> FleetDispatchContinuationReceipt {
  if receipt == nil {
    throw "declared predecessor dispatch continuation is absent"
  }
  const observed = unwrap(receipt)
  if observed.target != expected.target {
    throw "predecessor dispatch continuation target mismatch"
  }
  if observed.chain_id != expected.chain_id {
    throw "predecessor dispatch continuation chain mismatch"
  }
  if observed.scope != expected.scope {
    throw "predecessor dispatch continuation scope mismatch"
  }
  if observed.update_round != expected.update_round {
    throw "predecessor dispatch continuation round mismatch"
  }
  if observed.controller_run_id != expected.controller_run_id {
    throw "predecessor dispatch continuation run mismatch"
  }
  if observed.controller_run_attempt != expected.controller_run_attempt {
    throw "predecessor dispatch continuation run attempt mismatch"
  }
  return observed
}

/** Carry the same accepted child runs forward under the current controller round. */
pub fn fleet_dispatch_continuation_rebind(
  harness: {fs: HarnessFs, random: HarnessRandom},
  path: string,
  receipt: FleetDispatchContinuationReceipt,
  lineage: FleetDispatchLineage,
) -> FleetDispatchContinuationReceipt {
  if lineage.target != receipt.target || lineage.chain_id != receipt.chain_id
    || lineage.scope
      != receipt.scope {
    throw "dispatch continuation cannot change target, chain, or scope while advancing"
  }
  const next_attempt = lineage.update_round == receipt.update_round
    && lineage.controller_run_id == receipt.controller_run_id
    && lineage.controller_run_attempt == receipt.controller_run_attempt + 1
  const next_round = lineage.update_round == receipt.update_round + 1
    && lineage.controller_run_id
      != receipt.controller_run_id
    && lineage.controller_run_attempt
      == 1
  if !next_attempt && !next_round {
    throw "dispatch continuation must advance by one run attempt or one controller round"
  }
  const rebound: FleetDispatchContinuationReceipt = {
    schema_version: "harn_bump_fleet.dispatch_continuation.v3",
    target: lineage.target,
    chain_id: lineage.chain_id,
    scope: lineage.scope,
    update_round: lineage.update_round,
    controller_run_id: lineage.controller_run_id,
    controller_run_attempt: lineage.controller_run_attempt,
    dispatches: receipt.dispatches,
  }
  const fragments = continuation_entry_dir(path)
  if harness.fs.exists(fragments) {
    harness.fs.delete(fragments)
  }
  fleet_dispatch_continuation_write(harness, path, rebound)
  return rebound
}
