import { GithubWorkflowJobs } from "harn-github-connector/default"

/**
 * Why a bump workflow concluded success while leaving every ref on a stale
 * pin.
 *
 * The pin probe already proves that a no-op happened. It cannot say why, and
 * "why" is the whole difference between a bug in the downstream workflow and a
 * bump the fleet asked for wrongly. Three consumers returned this shape on one
 * stable release and the receipt named only the pin, so the run read as an
 * unexplained red rather than as a repairable defect with an owner.
 *
 * `all_steps_skipped` is the case worth separating by name: a workflow whose
 * every step was skipped succeeded without running, which is a gating defect
 * upstream of anything the mutation logic did.
 */
pub type BumpNoOpCause = "all_steps_skipped" \
  | "steps_ran_and_wrote_nothing" \
  | "no_jobs_reported" \
  | "jobs_unreadable"

pub type BumpNoOpStep = {job: string, step: string, conclusion: string}

pub type BumpNoOpDiagnosis = {
  cause: BumpNoOpCause,
  job_count: int,
  step_count: int,
  skipped_step_count: int,
  executed_steps: list<BumpNoOpStep>,
  skipped_steps: list<BumpNoOpStep>,
  detail: string,
}

fn unreadable(detail: string) -> BumpNoOpDiagnosis {
  return {
    cause: "jobs_unreadable",
    job_count: 0,
    step_count: 0,
    skipped_step_count: 0,
    executed_steps: [],
    skipped_steps: [],
    detail: detail,
  }
}

/**
 * Summarize one accepted run's own step record.
 *
 * `jobs` is nilable rather than required, because a failed read must produce
 * `jobs_unreadable` and not a confident "no jobs reported". Those two look
 * identical in a count and mean opposite things: one is a workflow that gated
 * itself out, the other is the fleet failing to look.
 */
pub fn bump_no_op_diagnosis(
  jobs: GithubWorkflowJobs?,
  read_error: string? = nil,
) -> BumpNoOpDiagnosis {
  if jobs == nil {
    return unreadable(
      "the accepted run's jobs could not be read, so the fleet makes no claim about why it wrote"
        + " nothing: "
        + trim(read_error ?? "no error was reported"),
    )
  }
  const rows = (jobs ?? {jobs: []}).jobs
  if len(rows) == 0 {
    return {
      cause: "no_jobs_reported",
      job_count: 0,
      step_count: 0,
      skipped_step_count: 0,
      executed_steps: [],
      skipped_steps: [],
      detail: "the accepted run reported zero jobs, so nothing in it could have written a pin",
    }
  }
  let executed: list<BumpNoOpStep> = []
  let skipped: list<BumpNoOpStep> = []
  for job in rows {
    for step in job.steps {
      const row = {job: job.name, step: step.name, conclusion: trim(step.conclusion ?? "")}
      if row.conclusion == "skipped" {
        skipped = skipped + [row]
      } else {
        executed = executed + [row]
      }
    }
  }
  const total = len(executed) + len(skipped)
  if total == 0 {
    return {
      cause: "no_jobs_reported",
      job_count: len(rows),
      step_count: 0,
      skipped_step_count: 0,
      executed_steps: [],
      skipped_steps: [],
      detail: "the accepted run reported ${to_string(len(rows))} job(s) and no steps at all",
    }
  }
  if len(executed) == 0 {
    return {
      cause: "all_steps_skipped",
      job_count: len(rows),
      step_count: total,
      skipped_step_count: len(skipped),
      executed_steps: [],
      skipped_steps: skipped,
      detail: "every one of the run's ${to_string(total)} step(s) was skipped, so the workflow"
        + " concluded success without running: the defect is in what gated them, not in the"
        + " mutation itself",
    }
  }
  return {
    cause: "steps_ran_and_wrote_nothing",
    job_count: len(rows),
    step_count: total,
    skipped_step_count: len(skipped),
    executed_steps: executed,
    skipped_steps: skipped,
    detail: "${to_string(len(executed))} of the run's ${to_string(total)} step(s) executed and the"
      + " pin still did not move, so the mutation ran against the wrong target or wrote nothing",
  }
}
