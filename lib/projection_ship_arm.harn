import { github_branch_head, github_file_text_at_ref_result, github_pr_view } from "./github"
import { GithubClientOptions, api_call } from "harn-github-connector/default"

pub type ProjectionShipOutcome = {
  state: "armed" | "already_armed" | "held" | "refused",
  method?: string,
  error?: string,
}

type ShipEvents = {types?: list<string>?}

type ShipSchedule = {cron: string}

type ShipWorkflowRun = {workflows: list<string>, types: list<string>}

type ShipTriggers = {
  pull_request_target?: ShipEvents?,
  pull_request?: ShipEvents?,
  schedule?: list<ShipSchedule>?,
  workflow_run?: ShipWorkflowRun?,
}

type ShipCaller = {on: ShipTriggers, jobs: dict<string, dict>}

type ShipPull = {
  github_state: string,
  base: {ref: string},
  head: {ref: string, sha: string, repo: string},
}

type ShipLabel = {name: string}

type ShipLabels = list<ShipLabel>

/** The actual default-branch caller must wake the pinned organization shepherd. */
pub fn projection_ship_caller(source: string, self_hosted: bool = false) -> bool {
  const measured = try {
    const workflow = schema_expect(yaml_parse(source), schema_of(ShipCaller))
    const trigger = workflow.on.pull_request_target ?? workflow.on.pull_request
    require trigger != nil && trigger.types != nil && trigger.types.contains("labeled")
      && trigger.types.contains("synchronize"),
      "Ship events are incomplete"
    const schedule = workflow.on.schedule ?? []
    const completion = workflow.on.workflow_run
    require schedule.any({ entry -> entry.cron.trim() != "" })
      || (completion != nil && len(completion.workflows) > 0
        && completion.types.contains("completed")),
      "Ship has no later wake"
    const jobs = workflow.jobs
    require jobs.keys().any(
      { key ->
        (regex_match(
            "^burin-labs/\\.github/\\.github/workflows/smart-ship\\.yml@[0-9a-f]{40}$",
            to_string(jobs[key]?.uses ?? ""),
          )
            != nil
            || (self_hosted
              && jobs[key]?.uses == "burin-labs/.github/.github/workflows/smart-ship.yml@main"))
          && jobs[key]?.["if"] == nil
      },
    ),
      "the pinned organization shepherd is missing or conditional"
    true
  }
  return is_ok(measured) && unwrap(measured)
}

/** Grant Smart Ship the proposal after measuring the head and its caller. */
pub fn arm_projection_ship(
  harness: Harness,
  slug: string,
  default_branch: string,
  number: int,
  commit: string,
  options: GithubClientOptions,
) -> ProjectionShipOutcome {
  const attempted = try {
    require default_branch == "main" && number > 0 && regex_match("^[0-9a-f]{40}$", commit) != nil,
      "the projection's main branch, pull request or commit is unmeasured"
    const main = unwrap(github_branch_head(harness, slug, default_branch, options))
    const main_oid = to_string(main?.oid ?? "")
    require regex_match("^[0-9a-f]{40}$", main_oid) != nil, "the default branch is unmeasured"
    const self_hosted = slug == "burin-labs/.github"
    const caller_path =
      self_hosted ? ".github/workflows/ship.yml" : ".github/workflows/smart-ship.yml"
    const caller = unwrap(
      github_file_text_at_ref_result(harness, slug, caller_path, main_oid, options),
    )
    require caller != nil && projection_ship_caller(caller, self_hosted),
      "the default branch has no measured Smart Ship caller"
    const pull = schema_expect(
      unwrap(github_pr_view(harness, slug, number, options)),
      schema_of(ShipPull),
    )
    require pull.github_state == "open",
      "the projection pull request is not open: "
      + pull.github_state
    require pull.base.ref == default_branch, "the projection base branch changed"
    require pull.head.sha == commit, "the published projection head changed"
    require pull.head.repo == slug, "the projection head belongs to another repository"
    require pull.head.ref.starts_with("automation/fleet-projections"),
      "the projection branch does not belong to fleet convergence"
    const labeled = unwrap(
      api_call(
        harness,
        {
          path: "/repos/${slug}/issues/${to_string(number)}/labels",
          method: "POST",
          body: {labels: ["ship"]},
          options: options,
        },
      ),
    )
    const labels = schema_expect(labeled, schema_of(ShipLabels))
    require labels.any({ label -> label.name == "ship" }), "the ship label was not confirmed"
    {state: "armed", method: "SMART_SHIP"}
  }
  return is_ok(attempted) ? unwrap(attempted) : {
    state: "refused",
    error: "Smart Ship authorization failed: " + to_string(unwrap_err(attempted)),
  }
}
