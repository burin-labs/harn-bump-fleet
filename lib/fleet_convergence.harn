import { strip_v } from "std/semver"
import { harn_pin_decision } from "./bump_decision"
import { cargo_harn_pin_probe, harn_version_pin_probe } from "./bump_pins"
import { FleetRepository } from "./fleet_manifest"
import {
  github_branch_head,
  github_commit_reachable_from_branch,
  github_file_text_at_ref,
  github_pr_checks,
  github_pr_list,
} from "./github"
import { HarnUpdateProofFacts, HarnUpdatePullRequestProof, harn_update_proof } from "./harn_update"
import { operator_pr_patrol } from "./operator_pr_patrol"

const BUMP_BRANCH = "automation/bump-harn-runtime"

pub type FleetConvergenceRow = {
  repo: string,
  state: "proven" | "waiting" | "failed",
  reason: string,
  pin?: string,
  default_branch_pin?: string,
  pr_number?: int,
  pr_url?: string,
  check_state?: string,
  head_sha?: string,
  branch_pin?: string,
  branch_head_sha?: string,
  failing_checks?: list<dict>,
  merge_commit_sha?: string,
  update_proof?: dict,
}

pub type FleetConvergenceSnapshot = {
  target: string,
  complete: bool,
  terminal: bool,
  repositories: list<FleetConvergenceRow>,
}

fn remote_pin(harness: Harness, slug: string, ref: string = "main") -> string? {
  const version = github_file_text_at_ref(harness, slug, ".harn-version", ref)
  if version != nil && trim(version) != "" {
    return harn_version_pin_probe(version).pin
  }
  const cargo = github_file_text_at_ref(harness, slug, "Cargo.toml", ref)
  if cargo != nil && trim(cargo) != "" {
    return cargo_harn_pin_probe(cargo).pin
  }
  return nil
}

fn merged_update_proof(harness: Harness, slug: string, target: string, main_pin: string?) {
  const listed = github_pr_list(
    harness,
    slug,
    {head: BUMP_BRANCH, base: "main", state: "closed", limit: 20},
  )
  if is_err(listed) {
    return {ok: false, reason: "merged_update_pull_request_probe_failed"}
  }
  for pr in unwrap(listed) {
    if !(pr?.merged ?? false) || trim(pr?.merge_commit_oid ?? "") == "" {
      continue
    }
    const head_pin = remote_pin(harness, slug, pr?.head?.sha ?? "")
    if head_pin == nil {
      continue
    }
    const head_decision = harn_pin_decision(head_pin, strip_v(target))
    if !head_decision.ok || !head_decision.satisfies_target {
      continue
    }
    const checks = github_pr_checks(harness, slug, pr.number)
    if is_err(checks) {
      return {ok: false, reason: "merged_update_checks_probe_failed"}
    }
    const observed_checks = unwrap(checks)
    const reachability = github_commit_reachable_from_branch(
      harness,
      slug,
      pr.merge_commit_oid ?? "",
      "main",
    )
    if is_err(reachability) {
      return {ok: false, reason: "merged_update_reachability_probe_failed"}
    }
    const default_head_result = github_branch_head(harness, slug, "main")
    const default_head_sha = if is_err(default_head_result) {
      ""
    } else {
      unwrap(default_head_result).oid
    }
    const reachable: bool = if unwrap(reachability).reachable {
      true
    } else {
      false
    }
    const pull_request: HarnUpdatePullRequestProof = {
      number: to_int(pr.number) ?? 0,
      url: to_string(pr.url),
      state: if pr.merged {
        "merged"
      } else {
        to_string(pr.state)
      },
      head_sha: to_string(pr.head.sha),
      head_pin: head_pin,
      check_state: to_string(observed_checks?.rollup?.state ?? observed_checks?.state ?? "unknown"),
      checks_head_sha: to_string(observed_checks.head_sha ?? ""),
      merge_commit_sha: to_string(pr.merge_commit_oid ?? ""),
      merge_reachable_from_default_branch: reachable,
    }
    const facts: HarnUpdateProofFacts = {
      repository: slug,
      target: target,
      default_branch_pin: main_pin ?? "",
      default_branch_head_sha: default_head_sha,
      pull_request: pull_request,
    }
    return harn_update_proof(facts)
  }
  return {ok: false, reason: "missing_update_pull_request_lineage"}
}

/** Observe each consumer through connector-owned, typed GitHub surfaces. */
pub fn fleet_convergence_snapshot(
  harness: Harness,
  repositories: list<FleetRepository>,
  target: string,
) -> FleetConvergenceSnapshot {
  const wanted = strip_v(target)
  let rows = []
  for repo in repositories {
    const pin = remote_pin(harness, repo.slug)
    const main_decision = if pin == nil {
      nil
    } else {
      harn_pin_decision(pin, wanted)
    }
    if main_decision != nil && !main_decision.ok {
      rows = rows
        + [
        {
          repo: repo.slug,
          state: "failed",
          reason: "default_branch_pin_invalid: ${main_decision.detail}",
          pin: pin,
          default_branch_pin: pin,
        },
      ]
      continue
    }
    if main_decision?.satisfies_target ?? false {
      const proof = merged_update_proof(harness, repo.slug, target, pin)
      rows = rows
        + [
        {
          repo: repo.slug,
          state: if proof.ok ?? false {
            "proven"
          } else {
            "failed"
          },
          reason: if proof.ok ?? false {
            "exact_green_update_merged"
          } else {
            proof.reason ?? "update_proof_failed"
          },
          pin: pin,
          default_branch_pin: pin,
          pr_number: proof.pull_request_number,
          pr_url: proof.pull_request_url,
          head_sha: proof.checked_head_sha,
          merge_commit_sha: proof.merge_commit_sha,
          update_proof: proof,
        },
      ]
      continue
    }
    const listed = github_pr_list(
      harness,
      repo.slug,
      {head: BUMP_BRANCH, base: "main", state: "open", limit: 1},
    )
    if is_err(listed) {
      rows = rows
        + [
        {
          repo: repo.slug,
          state: "failed",
          reason: "pull_request_probe_failed: " + to_string(unwrap_err(listed)),
          pin: pin,
          default_branch_pin: pin,
        },
      ]
      continue
    }
    const prs = unwrap(listed)
    if len(prs) == 0 {
      // A reusable bump run can publish the exact target commit and then see
      // an eventually-consistent branch comparison as equal. Preserve that
      // signed branch as a recoverable exact-head lease instead of collapsing
      // it into the same state as a workflow that never produced a bump.
      const branch = github_branch_head(harness, repo.slug, BUMP_BRANCH)
      const branch_head = if is_err(branch) {
        nil
      } else {
        unwrap(branch)
      }
      const branch_pin = if branch_head == nil {
        nil
      } else {
        remote_pin(harness, repo.slug, branch_head?.oid ?? BUMP_BRANCH)
      }
      const branch_decision = if branch_pin == nil {
        nil
      } else {
        harn_pin_decision(branch_pin, wanted)
      }
      const recoverable = (branch_decision?.ok ?? false)
        && (branch_decision?.satisfies_target ?? false)
      rows = rows
        + [
        {
          repo: repo.slug,
          state: "failed",
          reason: if recoverable {
            "target_branch_missing_pull_request"
          } else {
            "missing_bump_pull_request"
          },
          pin: pin,
          default_branch_pin: pin,
          branch_pin: branch_pin,
          branch_head_sha: branch_head?.oid,
          head_sha: branch_head?.oid,
        },
      ]
      continue
    }
    const pr = prs[0]
    const pr_pin = remote_pin(harness, repo.slug, pr?.head?.ref ?? "")
    const pr_decision = if pr_pin == nil {
      nil
    } else {
      harn_pin_decision(pr_pin, wanted)
    }
    if pr_decision == nil || !pr_decision.ok || !pr_decision.satisfies_target {
      rows = rows
        + [
        {
          repo: repo.slug,
          state: "failed",
          reason: if pr_decision == nil {
            "open_pull_request_pin_unknown"
          } else if !pr_decision.ok {
            "open_pull_request_pin_invalid: ${pr_decision.detail}"
          } else {
            "open_pull_request_behind_target"
          },
          pin: pr_pin,
          default_branch_pin: pin,
          pr_number: pr?.number,
          pr_url: pr?.url,
          head_sha: pr?.head?.sha,
        },
      ]
      continue
    }
    const patrol = operator_pr_patrol(harness, repo.slug, pr?.number ?? 0)
    const failed = ["owner", "investigate"].contains(patrol.human_action)
    rows = rows
      + [
      {
        repo: repo.slug,
        state: if failed {
          "failed"
        } else {
          "waiting"
        },
        reason: patrol.reason,
        pin: pr_pin,
        default_branch_pin: pin,
        pr_number: patrol.pr_number,
        pr_url: patrol.url,
        check_state: patrol.check_state,
        head_sha: patrol.head_sha,
        failing_checks: patrol.failing_checks,
      },
    ]
  }
  const failures = rows.filter({ row -> row.state == "failed" }).to_list()
  const waiting = rows.filter({ row -> row.state == "waiting" }).to_list()
  return {
    target: target,
    complete: len(failures) == 0 && len(waiting) == 0,
    terminal: len(failures) > 0,
    repositories: rows,
  }
}
