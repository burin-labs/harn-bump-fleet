/**
 * How far back the pin file's history is read on the default branch.
 *
 * This is a page size, not a policy. A repository that changed its pin surface
 * more than this many times without ever leaving the target is reported as
 * unresolved rather than proven, so a page that ends before the transition
 * cannot be mistaken for the transition itself.
 */
const PIN_HISTORY_PAGE: int = 100

pub type FleetConvergenceRow = {
  repo: string,
  state: "proven" | "waiting" | "failed",
  reason: string,
  pin?: string,
  default_branch_pin?: string,
  default_branch_head_sha?: string,
  default_branch_check_proof?: dict,
  pr_number?: int,
  pr_url?: string,
  check_state?: string,
  head_sha?: string,
  branch_pin?: string,
  branch_head_sha?: string,
  failing_checks?: list<dict>,
  merge_commit_sha?: string,
  update_proof?: dict,
  workflow_run_id?: int,
  workflow_run_url?: string,
}

pub type FleetDispatchRunObservation = {
  repository: string,
  run_id: int,
  run_url: string,
  contract_matches: bool,
  probe_ok: bool,
  status: string,
  conclusion: string,
  detail: string,
}

pub fn convergence_snapshot_from_rows(
  target: string,
  rows: list<FleetConvergenceRow>,
) -> FleetConvergenceSnapshot {
  const failures = rows.filter({ row -> row.state == "failed" }).to_list()
  const waiting = rows.filter({ row -> row.state == "waiting" }).to_list()
  const unproven = rows.filter({ row -> row.state != "proven" }).to_list()
  const empty_scope = len(rows) == 0
  return {
    target: target,
    complete: !empty_scope && len(failures) == 0 && len(waiting) == 0,
    terminal: empty_scope || len(failures) > 0,
    scope_proven: !empty_scope,
    total_count: len(rows),
    pending_count: len(waiting),
    failing_count: len(failures),
    unproven_count: if empty_scope {
      1
    } else {
      len(unproven)
    },
    unproven_repositories: if empty_scope {
      ["<empty repository scope>"]
    } else {
      unproven.map({ row -> row.repo }).to_list()
    },
    repositories: rows,
  }
}

/** Observe ordinary convergence, then preserve accepted-run liveness for missing PR lineage. */
pub fn fleet_convergence_snapshot_with_continuation(
  harness: Harness,
  manifest: FleetManifest,
  repositories: list<FleetRepository>,
  target: string,
  receipt: FleetDispatchContinuationReceipt?,
) -> FleetConvergenceSnapshot {
  const snapshot = fleet_convergence_snapshot(harness, manifest, repositories, target)
  return continue_fleet_convergence(
    snapshot,
    dispatch_run_observations(harness, manifest, repositories, target, receipt, snapshot),
  )
}

/** Reclassify only a missing exact branch/PR through its accepted workflow run. */
pub fn continue_fleet_convergence(
  snapshot: FleetConvergenceSnapshot,
  observations: list<FleetDispatchRunObservation>,
) -> FleetConvergenceSnapshot {
  const rows = snapshot.repositories.map(
    { row ->
      if row.reason != "missing_bump_pull_request"
        && row.reason != "target_branch_missing_pull_request" {
        return row
      }
      const observed = observations.find({ value -> value.repository == row.repo })
      if observed == nil {
        return row
      }
      const lineage = {workflow_run_id: observed.run_id, workflow_run_url: observed.run_url}
      if !observed.contract_matches {
        return row
          + lineage
          + {state: "failed", reason: "accepted_bump_run_contract_mismatch: " + observed.detail}
      }
      if !observed.probe_ok {
        return row
          + lineage
          + {state: "failed", reason: "accepted_bump_run_probe_failed: " + observed.detail}
      }
      if observed.status != "completed" {
        return row
          + lineage
          + {state: "waiting", reason: "accepted_bump_run_in_progress: " + observed.status}
      }
      if observed.conclusion == "success" {
        return row
          + lineage
          + {state: "waiting", reason: "accepted_bump_run_completed_awaiting_exact_pr"}
      }
      return row
        + lineage
        + {state: "failed", reason: "accepted_bump_run_${observed.conclusion}: " + observed.detail}
    },
  )
    .to_list()
  return convergence_snapshot_from_rows(snapshot.target, rows)
}

/**
 * Observe accepted dispatch runs for repositories whose bump pull request is
 * missing.
 *
 * `repositories` is the caller's hydrated list, not `manifest.repositories`. A
 * consumer-owned repository carries its pin path and its refresh and validate
 * commands in its own `.harn/fleet-projections.toml`, so the raw fleet.toml row
 * has none of them and `resolve_harn_update_spec` refuses it by design. Reading
 * the manifest here turned that refusal into a thrown abort that took observe,
 * repair, and proof with it.
 */
pub fn dispatch_run_observations(
  harness: Harness,
  manifest: FleetManifest,
  repositories: list<FleetRepository>,
  target: string,
  receipt: FleetDispatchContinuationReceipt?,
  snapshot: FleetConvergenceSnapshot,
) -> list<FleetDispatchRunObservation> {
  if receipt == nil || receipt.target != target {
    return []
  }
  const missing = snapshot.repositories.filter(
    { row ->
      row.reason == "missing_bump_pull_request"
        || row.reason == "target_branch_missing_pull_request"
    },
  )
    .map({ row -> row.repo })
    .to_list()
  let observations: list<FleetDispatchRunObservation> = []
  for dispatch in receipt.dispatches {
    if !missing.contains(dispatch.repository) {
      continue
    }
    const repo = repositories.find({ value -> value.slug == dispatch.repository })
    const spec = if repo == nil {
      nil
    } else {
      resolve_harn_update_spec(manifest, repo, target)
    }
    const matches = spec != nil
      && dispatch.target == target
      && dispatch.workflow == spec.workflow_name
      && dispatch.base_branch == spec.base_branch
      && dispatch.branch == spec.branch
    if !matches {
      observations = observations
        + [
          {
            repository: dispatch.repository,
            run_id: dispatch.run_id,
            run_url: dispatch.run_url,
            contract_matches: false,
            probe_ok: true,
            status: "contract_mismatch",
            conclusion: "",
            detail: "receipt lineage disagrees with the current manifest",
          },
        ]
      continue
    }
    const run = github_actions_run(harness, dispatch.repository, dispatch.run_id)
    if is_err(run) {
      observations = observations
        + [
          {
            repository: dispatch.repository,
            run_id: dispatch.run_id,
            run_url: dispatch.run_url,
            contract_matches: true,
            probe_ok: false,
            status: "unknown",
            conclusion: "",
            detail: to_string(unwrap_err(run)),
          },
        ]
      continue
    }
    const observed = unwrap(run)
    observations = observations
      + [
        {
          repository: dispatch.repository,
          run_id: dispatch.run_id,
          run_url: dispatch.run_url,
          contract_matches: true,
          probe_ok: true,
          status: observed.status,
          conclusion: observed.conclusion ?? "",
          detail: "exact accepted workflow run concluded ${observed.conclusion ?? "unknown"}",
        },
      ]
  }
  return observations
}

pub type FleetConvergenceSnapshot = {
  target: string,
  complete: bool,
  terminal: bool,
  scope_proven?: bool,
  total_count: int,
  pending_count: int,
  failing_count: int,
  unproven_count?: int,
  unproven_repositories?: list<string>,
  repositories: list<FleetConvergenceRow>,
}

pub type HarnRefFileReader = fn(string, string) -> string?

/** Read one ref through the resolved pin contract; tests and GitHub use this same seam. */
pub fn pin_probe_at_ref(
  _fs: HarnessFs,
  spec: HarnUpdateSpec,
  ref: string,
  read_file: HarnRefFileReader,
) -> HarnPinProbe {
  if spec.pin.kind != "auto" {
    const declared_path = spec.pin.path ?? ""
    const declared = read_file(declared_path, ref)
    if declared == nil || trim(declared) == "" {
      return {
        pin: nil,
        evidence: "declared ${spec.pin.kind} pin '${declared_path}' is missing at ${ref}",
        path: declared_path,
      }
    }
    let probe = harn_pin_text_probe(declared, spec.pin)
    probe.path = declared_path
    return probe
  }
  const version = read_file(".harn-version", ref)
  if version != nil && trim(version) != "" {
    let probe = harn_pin_text_probe(version, {kind: "version_file", path: ".harn-version"})
    probe.path = ".harn-version"
    return probe
  }
  const cargo = read_file("Cargo.toml", ref)
  if cargo != nil && trim(cargo) != "" {
    let probe = harn_pin_text_probe(cargo, {kind: "cargo", path: "Cargo.toml"})
    probe.path = "Cargo.toml"
    return probe
  }
  return {pin: nil, evidence: "no .harn-version or Cargo.toml pin surface found at ${ref}"}
}

/**
 * The Harn version a repository pins on one of its refs, or `nil` when neither
 * probe location exists. `.harn-version` is authoritative where it exists; the
 * Cargo pin is the fallback for consumers that link the runtime in-process.
 */
pub fn remote_pin_probe(
  harness: Harness,
  spec: HarnUpdateSpec,
  ref: string? = nil,
  options: GithubClientOptions = github_connector_options(),
) -> HarnPinProbe {
  const at_ref = ref ?? spec.base_branch
  return pin_probe_at_ref(
    harness.fs,
    spec,
    at_ref,
    { path, requested_ref ->
      return github_file_text_at_ref(harness, spec.repository, path, requested_ref, options)
    },
  )
}

pub fn remote_pin(
  harness: Harness,
  spec: HarnUpdateSpec,
  ref: string? = nil,
  options: GithubClientOptions = github_connector_options(),
) -> string? {
  return remote_pin_probe(harness, spec, ref, options).pin
}

/** Read the pin the default branch carried at one exact commit. */
fn pin_at_commit(
  harness: Harness,
  spec: HarnUpdateSpec,
  commit_sha: string,
  options: GithubClientOptions,
) -> string? {
  return remote_pin(harness, spec, commit_sha, options)
}

/**
 * Prove the update by the record that made it, not by whatever landed most
 * recently.
 *
 * The lineage commit is found from the pin file's own history on the default
 * branch, so it is identified by having set the pin to the target. Every
 * predicate the earlier candidate loop applied still applies, on that one pull
 * request: it must be merged, its checks must be green at the exact head those
 * checks ran on, and its merge commit must be reachable from the default
 * branch. What changed is only which pull request is asked.
 */
fn merged_update_proof(
  harness: Harness,
  spec: HarnUpdateSpec,
  target: string,
  main_pin: string?,
  default_head_sha: string,
  options: GithubClientOptions,
) {
  const pin_probe = remote_pin_probe(harness, spec, default_head_sha, options)
  const pin_path = trim(pin_probe.path ?? "")
  if pin_path == "" {
    return {ok: false, reason: "pin_surface_unresolved_on_default_branch"}
  }
  const history = github_path_commits(
    harness,
    spec.repository,
    pin_path,
    spec.base_branch,
    PIN_HISTORY_PAGE,
    options,
  )
  if is_err(history) {
    return {ok: false, reason: "pin_history_probe_failed: " + to_string(unwrap_err(history))}
  }
  const commits = unwrap(history)
  let entries: list<HarnPinHistoryEntry> = []
  for commit in commits {
    const sha = trim(to_string(commit?.sha ?? ""))
    if sha == "" {
      continue
    }
    entries = entries + [{commit_sha: sha, pin: pin_at_commit(harness, spec, sha, options)}]
  }
  const lineage = harn_update_lineage_commit(
    entries,
    strip_v(target),
    len(commits) < PIN_HISTORY_PAGE,
  )
  if !lineage.found {
    return {ok: false, reason: lineage.reason}
  }
  const associated = github_commit_pull_requests(
    harness,
    spec.repository,
    lineage.commit_sha,
    options,
  )
  if is_err(associated) {
    return {
      ok: false,
      reason: "lineage_pull_request_probe_failed: " + to_string(unwrap_err(associated)),
    }
  }
  const selected = harn_update_lineage_pull_request(
    unwrap(associated),
    lineage.commit_sha,
    spec.base_branch,
  )
  if !selected.found {
    return {ok: false, reason: selected.reason}
  }
  const pulls = unwrap(associated)
  const pr = pulls.find({ value -> (to_int(value?.number ?? 0) ?? 0) == selected.number })
  if pr == nil {
    return {ok: false, reason: "lineage_pull_request_record_unavailable"}
  }
  const head_sha = trim(to_string(pr?.head?.sha ?? ""))
  if head_sha == "" {
    return {ok: false, reason: "lineage_pull_request_head_unavailable"}
  }
  const head_pin = remote_pin(harness, spec, head_sha, options)
  if head_pin == nil {
    return {ok: false, reason: "lineage_pull_request_head_pin_unreadable"}
  }
  const checks = github_pr_checks(harness, spec.repository, selected.number, head_sha, options)
  if is_err(checks) {
    return {
      ok: false,
      reason: "merged_update_checks_probe_failed: " + to_string(unwrap_err(checks)),
    }
  }
  const observed_checks = unwrap(checks)
  const merge_commit_sha = to_string(pr?.merge_commit_sha ?? "")
  const reachability = github_commit_reachable_from_branch(
    harness,
    spec.repository,
    merge_commit_sha,
    default_head_sha,
    options,
  )
  if is_err(reachability) {
    return {
      ok: false,
      reason: "merged_update_reachability_probe_failed: " + to_string(unwrap_err(reachability)),
    }
  }
  const reachable: bool = if unwrap(reachability).reachable {
    true
  } else {
    false
  }
  const pull_request: HarnUpdatePullRequestProof = {
    number: selected.number,
    url: to_string(pr?.html_url ?? ""),
    state: if trim(to_string(pr?.merged_at ?? "")) != "" {
      "merged"
    } else {
      to_string(pr?.state ?? "unknown")
    },
    head_sha: head_sha,
    head_pin: head_pin,
    check_state: to_string(observed_checks?.rollup?.state ?? observed_checks?.state ?? "unknown"),
    checks_head_sha: to_string(observed_checks.head_sha ?? ""),
    merge_commit_sha: merge_commit_sha,
    merge_reachable_from_default_branch: reachable,
  }
  const facts: HarnUpdateProofFacts = {
    repository: spec.repository,
    target: target,
    default_branch_pin: main_pin ?? "",
    default_branch_head_sha: default_head_sha,
    pull_request: pull_request,
  }
  return harn_update_proof(facts)
}

fn merged_convergence_row(
  harness: Harness,
  spec: HarnUpdateSpec,
  target: string,
  pin: string,
  head_sha: string,
  options: GithubClientOptions,
) -> FleetConvergenceRow {
  const proof = merged_update_proof(harness, spec, target, pin, head_sha, options)
  const main_proof = fleet_default_branch_proof(
    harness,
    spec.repository,
    spec.base_branch,
    head_sha,
    options,
  )
  const proven = (proof.ok ?? false) && main_proof.ok
  return {
    repo: spec.repository,
    state: if proven {
      "proven"
    } else if (proof.ok ?? false) && main_proof.state == "pending" {
      "waiting"
    } else {
      "failed"
    },
    reason: if proven {
      "exact_green_update_merged"
    } else if !main_proof.ok {
      "default_branch_checks_unproven: " + main_proof.unproven.join(", ")
    } else {
      proof.reason ?? "update_proof_failed"
    },
    pin: pin,
    default_branch_pin: pin,
    default_branch_head_sha: head_sha,
    default_branch_check_proof: main_proof,
    pr_number: proof.pull_request_number,
    pr_url: proof.pull_request_url,
    head_sha: proof.checked_head_sha,
    merge_commit_sha: proof.merge_commit_sha,
    update_proof: proof,
  }
}

/** Observe each consumer through connector-owned, typed GitHub surfaces. */
pub fn fleet_convergence_snapshot(
  harness: Harness,
  manifest: FleetManifest,
  repositories: list<FleetRepository>,
  target: string,
  options: GithubClientOptions = github_connector_options(),
) -> FleetConvergenceSnapshot {
  const wanted = strip_v(target)
  let rows = []
  for repo in repositories {
    const spec = resolve_harn_update_spec(manifest, repo, target)
    const head = github_branch_head(harness, spec.repository, spec.base_branch, options)
    if is_err(head) {
      rows = rows + [{repo: repo.slug, state: "waiting", reason: "default_branch_head_unobserved"}]
      continue
    }
    const head_sha = unwrap(head).oid
    const pin = remote_pin(harness, spec, head_sha, options)
    if pin == nil {
      rows = rows
        + [
          {
            repo: repo.slug,
            state: "waiting",
            reason: "exact_default_branch_pin_unobserved",
            default_branch_head_sha: head_sha,
          },
        ]
      continue
    }
    const main_decision = harn_pin_decision(pin, wanted)
    if !main_decision.ok {
      rows = rows
        + [
          {
            repo: repo.slug,
            state: "failed",
            reason: "default_branch_pin_invalid: ${main_decision.detail}",
            pin: pin,
            default_branch_pin: pin,
          },
        ]
      continue
    }
    if main_decision.satisfies_target {
      rows = rows + [merged_convergence_row(harness, spec, target, pin, head_sha, options)]
      continue
    }
    const listed = github_pr_list(
      harness,
      repo.slug,
      {head: spec.branch, base: spec.base_branch, state: "open", limit: 1},
      options,
    )
    if is_err(listed) {
      rows = rows
        + [
          {
            repo: repo.slug,
            state: "failed",
            reason: "pull_request_probe_failed: " + to_string(unwrap_err(listed)),
            pin: pin,
            default_branch_pin: pin,
          },
        ]
      continue
    }
    const prs = unwrap(listed)
    if len(prs) == 0 {
      // A reusable bump run can publish the exact target commit and then see
      // an eventually-consistent branch comparison as equal. Preserve that
      // signed branch as a recoverable exact-head lease instead of collapsing
      // it into the same state as a workflow that never produced a bump.
      const branch = github_branch_head(harness, repo.slug, spec.branch, options)
      const branch_head = if is_err(branch) {
        nil
      } else {
        unwrap(branch)
      }
      const branch_pin = if branch_head == nil {
        nil
      } else {
        remote_pin(harness, spec, branch_head?.oid ?? spec.branch, options)
      }
      const branch_decision = if branch_pin == nil {
        nil
      } else {
        harn_pin_decision(branch_pin, wanted)
      }
      const recoverable = (branch_decision?.ok ?? false)
        && (branch_decision?.satisfies_target ?? false)
      rows = rows
        + [
          {
            repo: repo.slug,
            state: "failed",
            reason: if recoverable {
              "target_branch_missing_pull_request"
            } else {
              "missing_bump_pull_request"
            },
            pin: pin,
            default_branch_pin: pin,
            branch_pin: branch_pin,
            branch_head_sha: branch_head?.oid,
            head_sha: branch_head?.oid,
          },
        ]
      continue
    }
    const pr = prs[0]
    const pr_pin = remote_pin(harness, spec, pr?.head?.sha ?? "", options)
    const pr_decision = if pr_pin == nil {
      nil
    } else {
      harn_pin_decision(pr_pin, wanted)
    }
    if pr_decision == nil || !pr_decision.ok || !pr_decision.satisfies_target {
      rows = rows
        + [
          {
            repo: repo.slug,
            state: "failed",
            reason: if pr_decision == nil {
              "open_pull_request_pin_unknown"
            } else if !pr_decision.ok {
              "open_pull_request_pin_invalid: ${pr_decision.detail}"
            } else {
              "open_pull_request_behind_target"
            },
            pin: pr_pin,
            default_branch_pin: pin,
            pr_number: pr?.number,
            pr_url: pr?.url,
            head_sha: pr?.head?.sha,
          },
        ]
      continue
    }
    const patrol = operator_pr_patrol(harness, repo.slug, pr?.number ?? 0)
    const failed = ["owner", "investigate"].contains(patrol.human_action)
    rows = rows
      + [
        {
          repo: repo.slug,
          state: if failed {
            "failed"
          } else {
            "waiting"
          },
          reason: patrol.reason,
          pin: pr_pin,
          default_branch_pin: pin,
          pr_number: patrol.pr_number,
          pr_url: patrol.url,
          check_state: patrol.check_state,
          head_sha: patrol.head_sha,
          failing_checks: patrol.failing_checks,
        },
      ]
  }
  return convergence_snapshot_from_rows(target, rows)
}
