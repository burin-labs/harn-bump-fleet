// Organization commit pins must name a commit on the pinned repository's
// default branch, or one a tag names.
//
// A feature-branch head that was later squash-merged is still a valid commit,
// so every check that resolves the SHA passes, until the branch is deleted and
// every caller goes red at once. Reachability from the default branch, or a
// tag, is the property that survives branch cleanup, so it is the one this
// census asserts.
/** One `uses:` reference to an organization repository at an exact commit. */
pub type OrgCommitPin = {
  /** Repository-relative file that carries the reference. */
  file: string,
  line: int,
  /** `owner/name` of the pinned repository. */
  slug: string,
  sha: string,
}

/** A pin that is not on its repository's default branch, or could not be checked. */
pub type PinAncestryViolation = {
  file: string,
  line: int,
  slug: string,
  sha: string,
  /** `off_default_branch` or `unverifiable`. */
  reason: string,
  detail: string,
}

fn is_full_sha(text: string) -> bool {
  if len(text) != 40 {
    return false
  }
  for ch in text.chars() {
    if !"0123456789abcdef".contains(ch) {
      return false
    }
  }
  return true
}

/**
 * Every `uses: <owner>/<repo>[/path]@<40-hex>` line whose owner is `owner`.
 *
 * Tag and branch refs are left to other policy: only an exact commit can be a
 * squash-merged feature-branch head.
 */
pub fn org_commit_pins(file: string, text: string, owner: string) -> list<OrgCommitPin> {
  let pins = []
  let line_number = 0
  for raw in split(text, "\n") {
    line_number = line_number + 1
    let body = trim(raw)
    if starts_with(body, "- ") {
      body = trim(body.substring(2))
    }
    if !starts_with(body, "uses:") {
      continue
    }
    let reference = trim(body.substring(5))
    const comment = reference.index_of(" #")
    if comment >= 0 {
      reference = trim(reference.substring(0, comment))
    }
    reference = replace(replace(reference, "\"", ""), "'", "")
    if !starts_with(reference, owner + "/") {
      continue
    }
    const at = reference.last_index_of("@")
    if at < 0 {
      continue
    }
    const sha = lowercase(reference.substring(at + 1))
    if !is_full_sha(sha) {
      continue
    }
    const segments = split(reference.substring(0, at), "/")
    if len(segments) < 2 || segments[1] == "" {
      continue
    }
    pins = pins.push({file: file, line: line_number, slug: owner + "/" + segments[1], sha: sha})
  }
  return pins
}

/** Distinct `slug@sha` keys, so each commit is asked about once however many files pin it. */
pub fn distinct_pin_keys(pins: list<OrgCommitPin>) -> list<string> {
  return pins.map({ pin -> pin.slug + "@" + pin.sha }).to_list().to_set().to_list().sort()
}

/**
 * Join per-commit reachability back onto every pin.
 *
 * `reachability` maps `slug@sha` to `{reachable: bool, status: string}` or to
 * `{error: string}`. A key with no entry is a violation, never a pass: a
 * lookup that silently did not happen must not read as a commit on main.
 */
pub fn pin_ancestry_violations(
  pins: list<OrgCommitPin>,
  reachability: dict,
) -> list<PinAncestryViolation> {
  let violations = []
  for pin in pins {
    const key = pin.slug + "@" + pin.sha
    const observed = reachability[key]
    if observed == nil {
      violations = violations
        + [
          {
            file: pin.file,
            line: pin.line,
            slug: pin.slug,
            sha: pin.sha,
            reason: "unverifiable",
            detail: "no reachability was recorded",
          },
        ]
      continue
    }
    if (observed?.error ?? "") != "" {
      violations = violations
        + [
          {
            file: pin.file,
            line: pin.line,
            slug: pin.slug,
            sha: pin.sha,
            reason: "unverifiable",
            detail: to_string(observed.error),
          },
        ]
      continue
    }
    if !(observed?.reachable ?? false) {
      violations = violations
        + [
          {
            file: pin.file,
            line: pin.line,
            slug: pin.slug,
            sha: pin.sha,
            reason: "off_default_branch",
            detail: "compare status " + to_string(observed?.status ?? "unknown"),
          },
        ]
    }
  }
  return violations
}

pub fn pin_ancestry_violation_line(violation: PinAncestryViolation) -> string {
  return "${violation.file}:${violation.line}: ${violation.slug}@${violation.sha} "
    + "${violation.reason} (${violation.detail})"
}
