// `github_branch_head` is the one connector symbol whose name the fleet also
// exports, so it stays behind a module alias. Harn has no `import ... as`.
import * as github_connector from "harn-github-connector/default"
import {
  GithubAutoMergeDisableReceipt,
  GithubAutoMergeReceipt,
  GithubBranchHead,
  GithubClientOptions,
  GithubConnectorResult,
  GithubFileLookupRequest,
  GithubMergeQueueEntries,
  GithubMergeability,
  GithubPullRequestChecks,
  GithubPullRequestCreateReceipt,
  GithubPullRequestEditReceipt,
  GithubPullRequestFiles,
  GithubPullRequestSummary,
  GithubPullRequestView,
  GithubReleaseEditReceipt,
  GithubReleaseLease,
  GithubReleaseLookup,
  GithubWorkflowCancelReceipt,
  GithubWorkflowDispatchReceipt,
  GithubWorkflowJobs,
  GithubWorkflowRerunReceipt,
  GithubWorkflowRun,
  GithubWorkflowRuns,
  call,
  call_typed,
  github_close_pr,
  github_file_at_ref,
  github_latest_release_lookup,
  github_release,
  github_release_edit_body,
  github_resolve_mergeable,
  pulls_disable_auto_merge,
  pulls_enable_auto_merge,
} from "harn-github-connector/default"
pub import { GithubConnectorError } from "harn-github-connector/default"

pub type GithubPullReference = int | string

pub type GithubPrCreateRequest = {
  slug: string,
  title: string,
  head: string,
  base: string,
  body: string,
}

pub type GithubAutoMergeHoldRequest = {
  slug: string,
  pull_number: int,
  expected_head_oid: string,
  base_branch: string,
  expected_base_oid: string,
  restore_merge_method: string,
}

type GithubPullRequestList = list<GithubPullRequestSummary>

fn github_call_typed<T>(
  harness: Harness,
  method: string,
  args: dict,
  schema: Schema<T>,
) -> GithubConnectorResult<T> {
  const options: dict = github_connector_options()
  return call_typed(harness, method, options + args, schema)
}

/**
 * Connector policy for long-lived fleet and release operations. GitHub's core
 * limit normally resets within an hour; wait through a bounded 15-minute tail
 * instead of abandoning an in-flight release or partially observed fleet run.
 */
pub fn github_connector_options() -> GithubClientOptions {
  return {allow_gh_auth_fallback: true, rate_limit_max_sleep_seconds: 900}
}

/** Read one branch's exact commit through the connector-owned contract. */
pub fn github_branch_head(
  harness: Harness,
  slug: string,
  branch: string,
) -> GithubConnectorResult<GithubBranchHead> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(branch) == "" {
    return Err(
      {
        code: "invalid_branch",
        category: "schema_drift",
        message: "branch-head lookup requires owner/name and a branch",
      },
    )
  }
  return github_connector.github_branch_head(
    harness,
    {owner: parts.owner, repo: parts.repo, branch: branch, options: github_connector_options()},
  )
}

fn github_slug_parts(slug) -> {owner: string, repo: string}? {
  const parts = split(to_string(slug), "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    return nil
  }
  return {owner: parts[0], repo: parts[1]}
}

/**
 * Read a repository file at an exact ref. Proven absence is nil; provider failures remain errors.
 */
pub fn github_file_text_at_ref(
  harness: Harness,
  slug: string,
  path: string,
  ref: string,
) -> string? {
  const parts = github_slug_parts(slug)
  if parts == nil {
    throw "invalid GitHub slug: " + slug
  }
  const request: GithubFileLookupRequest = {
    owner: parts.owner,
    repo: parts.repo,
    path: path,
    ref: ref,
    options: github_connector_options(),
  }
  const result = github_file_at_ref(harness, request)
  if is_err(result) {
    throw "GitHub file lookup failed for ${slug}:${path}@${ref}: " + to_string(unwrap_err(result))
  }
  const lookup = unwrap(result)
  return if lookup.state == "found" {
    lookup.file.text
  } else {
    nil
  }
}

/** Extract a pull request number from either `123` or a GitHub pull URL. */
pub fn github_pr_number(pr_ref: GithubPullReference) -> int? {
  const direct = to_int(to_string(pr_ref))
  if direct != nil {
    return direct
  }
  const matches = regex_captures("/pull/([0-9]+)", to_string(pr_ref))
  if len(matches) == 0 {
    return nil
  }
  return to_int(matches[0].groups[0])
}

/** Return typed pull requests matching connector-owned filters. */
pub fn github_pr_list(
  harness: Harness,
  slug: string,
  filters: dict = {},
) -> GithubConnectorResult<GithubPullRequestList> {
  return github_call_typed(
    harness,
    "github.pr.list",
    {repo: slug, filters: filters},
    GithubPullRequestList,
  )
}

/** Read one pull request, including branch-protection and queue evidence. */
pub fn github_pr_view(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
) -> GithubConnectorResult<GithubPullRequestView> {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request view requires a number or canonical pull URL",
      },
    )
  }
  return github_call_typed(
    harness,
    "github.pr.view",
    {repo: slug, number: number},
    GithubPullRequestView,
  )
}

/** List the files changed by one pull request. */
pub fn github_pr_files(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  page: int = 1,
  per_page: int = 100,
) -> GithubConnectorResult<GithubPullRequestFiles> {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request file lookup requires a number or canonical pull URL",
      },
    )
  }
  return github_call_typed(
    harness,
    "github.pr.files",
    {repo: slug, number: number, page: page, per_page: per_page},
    GithubPullRequestFiles,
  )
}

/** Read one pull request's check rollup through the connector's closed record. */
pub fn github_pr_checks(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
) -> GithubConnectorResult<GithubPullRequestChecks> {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request checks lookup requires a number or canonical pull URL",
      },
    )
  }
  return github_call_typed(
    harness,
    "github.pr.checks",
    {repo: slug, number: number},
    GithubPullRequestChecks,
  )
}

/** Resolve GitHub's mergeability state into an explicit conflict bit. */
pub fn github_pr_mergeability(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
) -> GithubConnectorResult<GithubMergeability> {
  const parts = github_slug_parts(slug)
  const number = github_pr_number(pr_ref)
  if parts == nil || number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "mergeability lookup requires owner/name and a pull request number",
      },
    )
  }
  return github_resolve_mergeable(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      pull_number: number,
      options: github_connector_options(),
    },
  )
}

/** Create a pull request and retain its observed head SHA. */
pub fn github_pr_create(
  harness: Harness,
  request: GithubPrCreateRequest,
) -> GithubConnectorResult<GithubPullRequestCreateReceipt> {
  return github_call_typed(
    harness,
    "github.pr.create",
    {
      repo: request.slug,
      title: request.title,
      head: request.head,
      base: request.base,
      body: request.body,
    },
    GithubPullRequestCreateReceipt,
  )
}

/** Edit a pull request through the connector-owned PATCH contract. */
pub fn github_pr_edit(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  edits: dict,
) -> GithubConnectorResult<GithubPullRequestEditReceipt> {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request edit requires a number or canonical pull URL",
      },
    )
  }
  return github_call_typed(
    harness,
    "github.pr.edit",
    edits + {repo: slug, number: number},
    GithubPullRequestEditReceipt,
  )
}

/** Read one exact release. A visible repository with no tag returns `found: false`. */
pub fn github_release_at_tag(
  harness: Harness,
  slug: string,
  tag: string,
) -> GithubConnectorResult<GithubReleaseLookup> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  return github_release(
    harness,
    {owner: parts.owner, repo: parts.repo, tag: tag, options: github_connector_options()},
  )
}

/** Replace a release body only while its observed release and tag identities remain current. */
pub fn github_release_body_edit(
  harness: Harness,
  slug: string,
  tag: string,
  body: string,
  lease: GithubReleaseLease,
) -> GithubConnectorResult<GithubReleaseEditReceipt> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  return github_release_edit_body(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      tag: tag,
      body: body,
      lease: lease,
      options: github_connector_options(),
    },
  )
}

/** Enable auto-merge only while the PR still has the observed head. */
pub fn github_enable_auto_merge(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  expected_head_oid: string,
  merge_method: string = "squash",
) -> GithubConnectorResult<GithubAutoMergeReceipt> {
  const parts = github_slug_parts(slug)
  const pr_number = github_pr_number(pr_ref)
  if parts == nil || pr_number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "auto-merge requires owner/name and a pull request number",
      },
    )
  }
  return pulls_enable_auto_merge(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      pull_number: pr_number,
      expected_head_oid: expected_head_oid,
      method: merge_method,
      options: github_connector_options(),
    },
  )
}

/** List one branch's merge queue through the connector-owned closed record. */
pub fn github_merge_queue_entries(
  harness: Harness,
  slug: string,
  branch: string,
  limit: int = 100,
) -> GithubConnectorResult<GithubMergeQueueEntries> {
  return github_call_typed(
    harness,
    "github.merge_queue.entries",
    {repo: slug, branch: branch, limit: limit},
    GithubMergeQueueEntries,
  )
}

/** Disable auto-merge only while the PR remains at the observed head and base. */
pub fn github_disable_auto_merge(
  harness: Harness,
  request: GithubAutoMergeHoldRequest,
) -> GithubConnectorResult<GithubAutoMergeDisableReceipt> {
  const parts = github_slug_parts(request.slug)
  const number = github_pr_number(request.pull_number)
  if parts == nil || number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "auto-merge hold requires a pull request number",
      },
    )
  }
  return pulls_disable_auto_merge(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      pull_number: number,
      expected_head_oid: request.expected_head_oid,
      base_branch: request.base_branch,
      expected_base_oid: request.expected_base_oid,
      restore_merge_method: request.restore_merge_method,
      options: github_connector_options(),
    },
  )
}

/** Close a PR with an operator-visible comment. */
pub fn github_pr_close(harness: Harness, slug: string, pr_number: int, comment: string) -> dict {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return {ok: false, error: {code: "invalid_repo", message: "repo must be owner/name"}}
  }
  return github_close_pr(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      pull_number: pr_number,
      comment: comment,
      options: github_connector_options(),
    },
  )
}

/** Add an operator-visible PR comment. */
pub fn github_pr_comment(
  harness: Harness,
  slug: string,
  pr_number: int,
  body: string,
) -> GithubConnectorResult<unknown> {
  return call(
    harness,
    "github.pr.comment",
    github_connector_options() + {repo: slug, number: pr_number, body: body},
  )
}

/** Dispatch a workflow at an exact ref and retain the resolved run identity. */
pub fn github_workflow_dispatch(
  harness: Harness,
  slug: string,
  workflow: string,
  fields: dict? = nil,
  ref: string = "main",
) -> GithubConnectorResult<GithubWorkflowDispatchReceipt> {
  return github_call_typed(
    harness,
    "github.actions.workflow_dispatch",
    {repo: slug, workflow_id: workflow, ref: ref, inputs: fields ?? {}},
    GithubWorkflowDispatchReceipt,
  )
}

/** Read one exact workflow run through the connector's closed record. */
pub fn github_actions_run(
  harness: Harness,
  slug: string,
  run_id: int,
) -> GithubConnectorResult<GithubWorkflowRun> {
  return github_call_typed(
    harness,
    "github.actions.run",
    {repo: slug, run_id: run_id},
    GithubWorkflowRun,
  )
}

/** Read jobs and steps for one exact workflow run, optionally scoped to its latest attempt. */
pub fn github_actions_run_jobs(
  harness: Harness,
  slug: string,
  run_id: int,
  filter: string = "all",
