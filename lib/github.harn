    harness,
    "github.actions.run_jobs",
    {repo: slug, run_id: run_id, filter: filter, per_page: 100},
    GithubWorkflowJobs,
  )
}

/** Request cancellation of one exact workflow run and retain its typed receipt. */
pub fn github_actions_run_cancel(
  harness: Harness,
  slug: string,
  run_id: int,
