/** Resolve GitHub's mergeability state into an explicit conflict bit. */
pub fn github_pr_mergeability(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubMergeability> {
  const parts = github_slug_parts(slug)
  const number = github_pr_number(pr_ref)
  if parts == nil || number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "mergeability lookup requires owner/name and a pull request number",
      },
    )
  }
  return github_resolve_mergeable(
    harness,
    {owner: parts.owner, repo: parts.repo, pull_number: number, options: options},
  )
}

/** Create a pull request and retain its observed head SHA. */
pub fn github_pr_create(
  harness: Harness,
  request: GithubPrCreateRequest,
) -> GithubConnectorResult<GithubPullRequestCreateReceipt> {
  return github_call_typed(
    harness,
    "github.pr.create",
    {
      repo: request.slug,
      title: request.title,
      head: request.head,
      base: request.base,
      body: request.body,
    },
    GithubPullRequestCreateReceipt,
  )
}

/** Edit a pull request through the connector-owned PATCH contract. */
pub fn github_pr_edit(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  edits: dict,
) -> GithubConnectorResult<GithubPullRequestEditReceipt> {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request edit requires a number or canonical pull URL",
      },
    )
  }
  return github_call_typed(
    harness,
    "github.pr.edit",
    edits + {repo: slug, number: number},
    GithubPullRequestEditReceipt,
  )
}

/** Read one exact release. A visible repository with no tag returns `found: false`. */
pub fn github_release_at_tag(
  harness: Harness,
  slug: string,
  tag: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubReleaseLookup> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  return github_release(harness, {owner: parts.owner, repo: parts.repo, tag: tag, options: options})
}

/** Replace a release body only while its observed release and tag identities remain current. */
pub fn github_release_body_edit(
  harness: Harness,
  slug: string,
  tag: string,
  body: string,
  lease: GithubReleaseLease,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubReleaseEditReceipt> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  return github_release_edit_body(
    harness,
    {owner: parts.owner, repo: parts.repo, tag: tag, body: body, lease: lease, options: options},
