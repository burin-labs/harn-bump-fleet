import {
  call,
  github_close_pr,
  github_latest_release,
  github_resolve_mergeable,
  pulls_enable_auto_merge,
} from "harn-github-connector/default"

pub type GithubPullReference = int | string

pub type GithubConnectorError = {
  code: string,
  category?: string,
  message: string,
  http_status?: int,
}

/** Normalized fallible record boundary over the connector's raw-success convention. */
pub type GithubRecordResult = Result<dict, GithubConnectorError>

/** Normalized fallible list boundary over the connector's raw-success convention. */
pub type GithubListResult = Result<list<dict>, GithubConnectorError>

fn github_record_result(value) -> GithubRecordResult {
  if is_err(value) {
    return Err(unwrap_err(value))
  }
  return Ok(value)
}

fn github_list_result(value) -> GithubListResult {
  if is_err(value) {
    return Err(unwrap_err(value))
  }
  return Ok(value)
}

fn github_connector_auth() {
  return {allow_gh_auth_fallback: true}
}

fn github_slug_parts(slug) {
  const parts = split(to_string(slug), "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    return nil
  }
  return {owner: parts[0], repo: parts[1]}
}

/**
 * Read a repository file at an exact ref. Proven absence is nil; provider failures remain errors.
 */
pub fn github_file_text_at_ref(slug: string, path: string, ref: string) -> string? {
  const result = call(
    "github.file.view",
    github_connector_auth() + {repo: slug, path: path, ref: ref},
  )
  if is_err(result) {
    throw "GitHub file lookup failed for ${slug}:${path}@${ref}: " + to_string(unwrap_err(result))
  }
  return if result.found {
    result.file.text
  } else {
    nil
  }
}

/** Extract a pull request number from either `123` or a GitHub pull URL. */
pub fn github_pr_number(pr_ref: GithubPullReference) -> int? {
  const direct = to_int(to_string(pr_ref))
  if direct != nil {
    return direct
  }
  const matches = regex_captures("/pull/([0-9]+)", to_string(pr_ref))
  if len(matches) == 0 {
    return nil
  }
  return to_int(matches[0].groups[0])
}

/** Return typed pull requests matching connector-owned filters. */
pub fn github_pr_list(slug: string, filters: dict = {}) -> GithubListResult {
  return github_list_result(
    call("github.pr.list", github_connector_auth() + {repo: slug, filters: filters}),
  )
}

/** Read one pull request, including branch-protection and queue evidence. */
pub fn github_pr_view(slug: string, pr_ref: GithubPullReference) -> GithubRecordResult {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request view requires a number or canonical pull URL",
      },
    )
  }
  return github_record_result(
    call("github.pr.view", github_connector_auth() + {repo: slug, number: number}),
  )
}

/** List the files changed by one pull request. */
pub fn github_pr_files(
  slug: string,
  pr_ref: GithubPullReference,
  page: int = 1,
  per_page: int = 100,
) -> GithubRecordResult {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request file lookup requires a number or canonical pull URL",
      },
    )
  }
  return github_record_result(
    call(
      "github.pr.files",
      github_connector_auth() + {repo: slug, number: number, page: page, per_page: per_page},
    ),
  )
}

/** Read one pull request's check rollup through the connector's closed record. */
pub fn github_pr_checks(slug: string, pr_ref: GithubPullReference) -> GithubRecordResult {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request checks lookup requires a number or canonical pull URL",
      },
    )
  }
  return github_record_result(
    call("github.pr.checks", github_connector_auth() + {repo: slug, number: number}),
  )
}

/** Resolve GitHub's mergeability state into an explicit conflict bit. */
pub fn github_pr_mergeability(slug: string, pr_ref: GithubPullReference) -> GithubRecordResult {
  const parts = github_slug_parts(slug)
  const number = github_pr_number(pr_ref)
  if parts == nil || number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "mergeability lookup requires owner/name and a pull request number",
      },
    )
  }
  return github_record_result(
    github_resolve_mergeable(parts.owner, parts.repo, number, github_connector_auth()),
  )
}

/** Create a pull request and retain its observed head SHA. */
pub fn github_pr_create(
  slug: string,
  title: string,
  head: string,
  base: string,
  body: string,
) -> GithubRecordResult {
  return github_record_result(
    call(
      "github.pr.create",
      github_connector_auth() + {repo: slug, title: title, head: head, base: base, body: body},
    ),
  )
}

/** Edit a pull request through the connector-owned PATCH contract. */
pub fn github_pr_edit(
  slug: string,
  pr_ref: GithubPullReference,
  edits: dict,
) -> GithubRecordResult {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request edit requires a number or canonical pull URL",
      },
    )
  }
  return github_record_result(
    call("github.pr.edit", github_connector_auth() + edits + {repo: slug, number: number}),
  )
}

/** Read one exact release. A visible repository with no tag returns `found: false`. */
pub fn github_release_at_tag(slug: string, tag: string) -> GithubRecordResult {
  return github_record_result(
    call("github.release.view", github_connector_auth() + {repo: slug, tag: tag}),
  )
}

/** Enable auto-merge only while the PR still has the observed head. */
pub fn github_enable_auto_merge(
  slug: string,
  pr_ref: GithubPullReference,
  expected_head_oid: string,
  merge_method: string = "squash",
) -> GithubRecordResult {
  const parts = github_slug_parts(slug)
  const pr_number = github_pr_number(pr_ref)
  if parts == nil || pr_number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "auto-merge requires owner/name and a pull request number",
      },
    )
  }
  return github_record_result(
    pulls_enable_auto_merge(
      parts.owner,
      parts.repo,
      pr_number,
      github_connector_auth() + {expected_head_oid: expected_head_oid, method: merge_method},
    ),
  )
}

/** Close a PR with an operator-visible comment. */
pub fn github_pr_close(slug: string, pr_number: int, comment: string) -> dict {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return {ok: false, error: {code: "invalid_repo", message: "repo must be owner/name"}}
  }
  return github_close_pr(parts.owner, parts.repo, pr_number, comment, github_connector_auth())
}

/** Add an operator-visible PR comment. */
pub fn github_pr_comment(slug: string, pr_number: int, body: string) -> GithubRecordResult {
  return github_record_result(
    call(
      "github.pr.comment",
      github_connector_auth() + {repo: slug, number: pr_number, body: body},
    ),
  )
}

/** Dispatch a workflow at an exact ref and retain the resolved run identity. */
pub fn github_workflow_dispatch(
  slug: string,
  workflow: string,
  fields: dict? = nil,
  ref: string = "main",
) -> GithubRecordResult {
  return github_record_result(
    call(
      "github.actions.workflow_dispatch",
      github_connector_auth() + {repo: slug, workflow_id: workflow, ref: ref, inputs: fields ?? {}},
    ),
  )
}

/** Read one exact workflow run through the connector's closed record. */
pub fn github_actions_run(slug: string, run_id: int) -> GithubRecordResult {
  return github_record_result(
    call("github.actions.run", github_connector_auth() + {repo: slug, run_id: run_id}),
  )
}

/** Read all jobs and steps for one exact workflow run. */
pub fn github_actions_run_jobs(slug: string, run_id: int) -> GithubRecordResult {
  return github_record_result(
    call(
      "github.actions.run_jobs",
      github_connector_auth() + {repo: slug, run_id: run_id, filter: "all", per_page: 100},
    ),
  )
}

/** List one canonical workflow-run page. Provider failures remain typed errors. */
pub fn github_workflow_runs(
  slug: string,
  workflow: string,
  filters: dict = {},
  limit: int = 10,
) -> GithubRecordResult {
  return github_record_result(
    call(
      "github.actions.runs",
      github_connector_auth() + filters + {repo: slug, workflow_id: workflow, per_page: limit},
    ),
  )
}

/** Resolve a repository's latest GitHub release tag. */
pub fn github_latest_release_tag(slug: string) -> string {
  const parts = github_slug_parts(slug)
  if parts == nil {
    throw "invalid GitHub slug: " + slug
  }
  const release = github_latest_release(parts.owner, parts.repo, github_connector_auth())
  if !release.ok {
    throw "could not resolve latest release for ${slug}: " + to_string(release.error)
  }
  return trim(release.tag_name)
}
