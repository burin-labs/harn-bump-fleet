/** List one canonical workflow-run page. Provider failures remain typed errors. */
pub fn github_workflow_runs(
  harness: Harness,
  slug: string,
  workflow: string,
  filters: dict = {},
  limit: int = 10,
) -> GithubConnectorResult<GithubWorkflowRuns> {
  return github_call_typed(
    harness,
    "github.actions.runs",
    filters + {repo: slug, workflow_id: workflow, per_page: limit},
    GithubWorkflowRuns,
  )
}

/** Resolve a repository's latest GitHub release tag. */
pub fn github_latest_release_tag(harness: Harness, slug: string) -> string {
  const parts = github_slug_parts(slug)
  if parts == nil {
    throw "invalid GitHub slug: " + slug
  }
  const lookup = github_latest_release_lookup(
    harness,
    {owner: parts.owner, repo: parts.repo, options: github_connector_options()},
  )
  if is_err(lookup) {
    throw "could not resolve latest release for ${slug}: " + to_string(unwrap_err(lookup))
  }
  const resolved = unwrap(lookup)
  if resolved.state == "absent" {
    throw "could not resolve latest release for ${slug}: repository has no releases"
  }
  return trim(resolved.release.tag_name)
}
