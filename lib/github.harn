/** Request another attempt of one exact workflow run and retain its typed receipt. */
pub fn github_actions_run_rerun(
  harness: Harness,
  slug: string,
  run_id: int,
) -> GithubConnectorResult<GithubWorkflowRerunReceipt> {
  return github_call_typed(
    harness,
    "github.actions.run_rerun",
