/** List one canonical workflow-run page. Provider failures remain typed errors. */
pub fn github_workflow_runs(
  harness: Harness,
  slug: string,
  workflow: string,
  filters: dict = {},
  limit: int = 10,
) -> GithubConnectorResult<GithubWorkflowRuns> {
  return github_call_typed(
    harness,
    "github.actions.runs",
    filters + {repo: slug, workflow_id: workflow, per_page: limit},
    GithubWorkflowRuns,
  )
}

/** Resolve a repository's latest GitHub release tag. */
pub fn github_latest_release_tag(
  harness: Harness,
  slug: string,
  options: GithubClientOptions = github_connector_options(),
) -> string {
  const parts = github_slug_parts(slug)
  if parts == nil {
    throw "invalid GitHub slug: " + slug
  }
  const lookup = github_latest_release_lookup(
    harness,
    {owner: parts.owner, repo: parts.repo, options: options},
  )
  if is_err(lookup) {
    throw "could not resolve latest release for ${slug}: " + to_string(unwrap_err(lookup))
  }
  const resolved = unwrap(lookup)
  if resolved.state == "absent" {
    throw "could not resolve latest release for ${slug}: repository has no releases"
  }
  return trim(resolved.release.tag_name)
}

/**
 * What a ref claim points at.
 *
 * A lock has nothing to point at yet, so it names a `payload` and the connector
 * mints a parentless commit from it — the message a loser reads to learn who
 * holds the ref. A claim that opens a branch already has its object and names
 * an `oid` instead. Exactly one, because a claim that named both would leave
 * the connector to pick, and a claim that named neither has nothing to say.
 */
pub type GithubRefClaimObject = {oid?: string, payload?: GithubRefClaimPayload}

/**
 * Claim one ref for this run, atomically across machines.
 *
 * Contention is an outcome rather than an error: a lost claim returns
 * `claimed: false` alongside the oid the ref actually holds and the holder's
 * headline, so a caller learns both that it lost and to whom. For a branch
 * claim, that oid is also the lease a follow-up commit needs, which is why
 * creating an automation branch and appending to an existing one take the same
 * path here.
 */
pub fn github_claim_ref(
  harness: Harness,
  slug: string,
  ref: string,
  object: GithubRefClaimObject,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubRefClaim> {
  const parts = github_slug_parts(slug)
  const names_oid = trim(object.oid ?? "") != ""
  const names_payload = trim(object.payload?.message ?? "") != ""
  if parts == nil || !starts_with(trim(ref), "refs/") || names_oid == names_payload {
    return Err(
      {
        code: "invalid_ref_claim",
        category: "schema_drift",
        message:
          "a ref claim requires owner/name, a `refs/...` ref, and exactly one of an oid or a payload message",
      },
    )
  }
  return github_connector.github_claim_ref(
    harness,
    {owner: parts.owner, repo: parts.repo, ref: ref, options: options} + object,
  )
}

/** Release one ref, and only while it still holds this run's exact object. */
pub fn github_release_ref(
  harness: Harness,
  slug: string,
  ref: string,
  expected_oid: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubRefRelease> {
  const parts = github_slug_parts(slug)
  if parts == nil || !starts_with(trim(ref), "refs/") || trim(expected_oid) == "" {
    return Err(
      {
        code: "invalid_ref_release",
        category: "schema_drift",
        message: "a ref release requires owner/name, a `refs/...` ref, and an expected oid",
      },
    )
  }
  return github_connector.github_release_ref(
    harness,
    {owner: parts.owner, repo: parts.repo, ref: ref, expected_oid: expected_oid, options: options},
  )
}

/**
 * Publish exact file text as one GitHub-signed commit under a branch-head lease.
 *
 * Text crosses this boundary as text and is encoded here, so no caller has to
 * hold a base64 payload to describe a file it already has. The lease is the
 * safety property: a branch that moved between observation and write fails
 * closed rather than silently rebasing the caller's intent onto someone else's.
 */
pub fn github_branch_commit(
  harness: Harness,
  request: GithubBranchCommitRequest,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubSignedCommitReceipt> {
  const parts = github_slug_parts(request.slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  const additions = request.files.map(
    { file -> {path: file.path, contents_base64: base64_encode(file.contents)} },
  )
    .to_list()
  return github_create_signed_commit(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      branch: request.branch,
      expected_head_oid: request.expected_head_oid,
      headline: request.headline,
      body: request.body,
      additions: additions,
      deletions: (request.deletions ?? []).map({ path -> {path: path} }).to_list(),
      options: options,
    },
  )
}

/** Create or refresh the single pull request a head branch may have open. */
pub fn github_pr_upsert(
  harness: Harness,
  request: GithubPrUpsertRequest,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubPullRequestUpsertReceipt> {
  const parts = github_slug_parts(request.slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  return github_upsert_pull_request(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      head: request.head,
      base: request.base,
      title: request.title,
      body: request.body,
      expected_head_oid: request.expected_head_oid,
      options: options,
    },
  )
}
