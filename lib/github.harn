// `github_branch_head`, `github_claim_ref`, and `github_release_ref` are the
// connector symbols whose names the fleet also exports, so they stay behind a
// module alias. Harn has no `import ... as`.
import * as github_connector from "harn-github-connector/default"
import {
  GithubAutoMergeDisableReceipt,
  GithubAutoMergeReceipt,
  GithubBranchHead,
  GithubClientOptions,
  GithubCommitSignature,
  GithubConnectorResult,
  GithubFileLookupRequest,
  GithubMergeQueueEntries,
  GithubMergeability,
  GithubPullRequestChecks,
  GithubPullRequestCommits,
  GithubPullRequestCreateReceipt,
  GithubPullRequestEditReceipt,
  GithubPullRequestFiles,
  GithubPullRequestSummary,
  GithubPullRequestUpsertReceipt,
  GithubPullRequestView,
  GithubRefClaim,
  GithubRefClaimPayload,
  GithubRefRelease,
  GithubReleaseEditReceipt,
  GithubReleaseLease,
  GithubReleaseLookup,
  GithubWorkflowCancelReceipt,
  GithubWorkflowDispatchReceipt,
  GithubWorkflowJobs,
  GithubWorkflowRerunReceipt,
  GithubWorkflowRun,
  GithubWorkflowRuns,
  GithubWorktreeCommitReceipt,
  api_call,
  call,
  call_typed,
  github_close_pr,
  github_create_signed_commit,
  github_file_at_ref,
  github_latest_release_lookup,
  github_release,
  github_release_edit_body,
  github_resolve_mergeable,
  github_upsert_pull_request,
  pulls_disable_auto_merge,
  pulls_enable_auto_merge,
} from "harn-github-connector/default"
pub import { GithubConnectorError } from "harn-github-connector/default"
// The worktree adapter is the connector's only module that shells out to local
// `git`, and it ships as a separate export from the pure API surface.
import { github_commit_worktree } from "harn-github-connector/worktree"

pub type GithubPullReference = int | string

pub type GithubIssueSummary = {number: int, title: string, body: string, state: string}

pub type GithubAuthenticatedUser = {login: string}

pub type GithubSshSigningKey = {id: int, key: string, title: string, created_at: string}

pub type GithubSshSigningKeys = list<GithubSshSigningKey>

pub type GithubPrCreateRequest = {
  slug: string,
  title: string,
  head: string,
  base: string,
  body: string,
}

pub type GithubAutoMergeHoldRequest = {
  slug: string,
  pull_number: int,
  expected_head_oid: string,
  base_branch: string,
  expected_base_oid: string,
  restore_merge_method: string,
}

pub type GithubCommitReachability = {
  reachable: bool,
  status: string,
  base_sha: string,
  branch: string,
}

/** One repository file to publish, addressed by path and carrying exact text. */
pub type GithubBranchCommitFile = {path: string, contents: string}

/** Leased request for one GitHub-signed commit that publishes exact file text. */
pub type GithubBranchCommitRequest = {
  slug: string,
  branch: string,
  expected_head_oid: string,
  headline: string,
  body: string,
  files: list<GithubBranchCommitFile>,
  deletions?: list<string>,
}

/** Idempotent request for the one automation pull request a head branch may have. */
pub type GithubPrUpsertRequest = {
  slug: string,
  head: string,
  base: string,
  title: string,
  body: string,
  expected_head_oid: string,
}

type GithubPullRequestList = list<GithubPullRequestSummary>

/**
 * `options` is a parameter rather than a constant so a caller can name the
 * endpoint. Defaulting it to fleet policy and resolving it here means a test
 * cannot reach these calls at all without ambient credentials: the connector
 * resolves a token before it builds a URL, so a mocked endpoint is never
 * consulted and the answer differs between a laptop and a runner.
 */
fn github_call_typed<T>(
  harness: Harness,
  method: string,
  args: dict,
  schema: Schema<T>,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<T> {
  const opts: dict = options
  return call_typed(harness, method, opts + args, schema)
}

/**
 * Connector policy for long-lived fleet and release operations. GitHub's core
 * limit normally resets within an hour; wait through a bounded 15-minute tail
 * instead of abandoning an in-flight release or partially observed fleet run.
 */
pub fn github_connector_options() -> GithubClientOptions {
  return {
    allow_gh_auth_fallback: true,
    rate_limit_max_sleep_seconds: 900,
    // The connector owns HTTP retry semantics: safe reads get bounded,
    // jittered exponential backoff and honor Retry-After. Unsafe methods are
    // still single-shot unless a caller supplies an idempotency contract and
    // explicitly enables retry_unsafe.
    retry: {max_attempts: 4, base_ms: 500, cap_ms: 5000, respect_retry_after: true},
  }
}

/** True only for the connector's explicit transient transport classification. */
pub fn github_is_transient_read_error(error: {code: string, ...rest}) -> bool {
  return lowercase(trim(to_string(error?.code ?? ""))) == "network"
}

/** True only when the connector reports an exhausted GitHub rate limit. */
pub fn github_is_rate_limited_read_error(error: {code: string, ...rest}) -> bool {
  return lowercase(trim(to_string(error?.code ?? ""))) == "rate_limited"
}

/** Resolve the human account represented by the active GitHub credential. */
pub fn github_authenticated_user(
  harness: Harness,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubAuthenticatedUser> {
  const result = api_call(harness, {path: "/user", options: options})
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const value = unwrap(result)
  if !schema_is(value, GithubAuthenticatedUser) {
    return Err(
      {
        code: "invalid_response",
        category: "schema_drift",
        message: "authenticated GitHub user response omitted login",
      },
    )
  }
  return Ok(value)
}

/** Read the public SSH signing keys GitHub can attribute to one account. */
pub fn github_user_ssh_signing_keys(
  harness: Harness,
  login: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubSshSigningKeys> {
  if trim(login) == "" {
    return Err(
      {
        code: "invalid_user",
        category: "schema_drift",
        message: "SSH signing-key lookup requires a GitHub login",
      },
    )
  }
  const result = api_call(
    harness,
    {path: "/users/" + url_encode(login) + "/ssh_signing_keys", options: options},
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const value = unwrap(result)
  if !schema_is(value, GithubSshSigningKeys) {
    return Err(
      {
        code: "invalid_response",
        category: "schema_drift",
        message: "GitHub SSH signing-key response did not match its public contract",
      },
    )
  }
  return Ok(value)
}

/** Read one branch's exact commit through the connector-owned contract. */
pub fn github_branch_head(
  harness: Harness,
  slug: string,
  branch: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubBranchHead> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(branch) == "" {
    return Err(
      {
        code: "invalid_branch",
        category: "schema_drift",
        message: "branch-head lookup requires owner/name and a branch",
      },
    )
  }
  return github_connector.github_branch_head(
    harness,
    {owner: parts.owner, repo: parts.repo, branch: branch, options: options},
  )
}

/** Prove that one exact commit is on a named branch using GitHub's compare graph. */
pub fn github_commit_reachable_from_branch(
  harness: Harness,
  slug: string,
  commit_sha: string,
  branch: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubCommitReachability> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(commit_sha) == "" || trim(branch) == "" {
    return Err(
      {
        code: "invalid_commit_reachability",
        category: "schema_drift",
        message: "commit reachability requires owner/name, an exact commit, and a branch",
      },
    )
  }
  const result = api_call(
    harness,
    {
      path: "/repos/${parts.owner}/${parts.repo}/compare/${commit_sha}...${url_encode(branch)}",
      options: options,
    },
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const observed = unwrap(result)
  const status = lowercase(trim(to_string(observed?.status ?? "")))
  if !["ahead", "identical", "behind", "diverged"].contains(status) {
    return Err(
      {
        code: "invalid_response",
        category: "schema_drift",
        message: "GitHub compare response omitted a recognized status",
      },
    )
  }
  return Ok(
    {
      reachable: status == "ahead" || status == "identical",
      status: status,
      base_sha: commit_sha,
      branch: branch,
    },
  )
}

fn github_slug_parts(slug) -> {owner: string, repo: string}? {
  const parts = split(to_string(slug), "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    return nil
  }
  return {owner: parts[0], repo: parts[1]}
}

/** Read a repository file at an exact ref without erasing connector failures. */
pub fn github_file_text_at_ref_result(
  harness: Harness,
  slug: string,
  path: string,
  ref: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<string?> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err(
      {
        code: "invalid_repository",
        category: "schema_drift",
        message: "invalid GitHub slug: " + slug,
      },
    )
  }
  const request: GithubFileLookupRequest = {
    owner: parts.owner,
    repo: parts.repo,
    path: path,
    ref: ref,
    options: options,
  }
  const result = github_file_at_ref(harness, request)
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const lookup = unwrap(result)
  return Ok(
    if lookup.state == "found" {
      lookup.file.text
    } else {
      nil
    },
  )
}

/**
 * Read a repository file at an exact ref. Proven absence is nil; provider failures remain errors.
 *
 * Existing callers keep the throwing facade. Retry-aware orchestration uses
 * `github_file_text_at_ref_result` so transport evidence remains typed.
 */
pub fn github_file_text_at_ref(
  harness: Harness,
  slug: string,
  path: string,
  ref: string,
  options: GithubClientOptions = github_connector_options(),
) -> string? {
  const result = github_file_text_at_ref_result(harness, slug, path, ref, options)
  if is_err(result) {
    throw "GitHub file lookup failed for ${slug}:${path}@${ref}: " + to_string(unwrap_err(result))
  }
  return unwrap(result)
}

/** Extract a pull request number from either `123` or a GitHub pull URL. */
pub fn github_pr_number(pr_ref: GithubPullReference) -> int? {
  const direct = to_int(to_string(pr_ref))
  if direct != nil {
    return direct
  }
  const matches = regex_captures("/pull/([0-9]+)", to_string(pr_ref))
  if len(matches) == 0 {
    return nil
  }
  return to_int(matches[0].groups[0])
}

/**
 * Return typed pull requests matching connector-owned filters.
 *
 * `options` is exposed for the same reason it is on the write helpers: a caller
 * that names its endpoint can be tested against it, and one that does not still
 * gets fleet policy.
 */
pub fn github_pr_list(
  harness: Harness,
  slug: string,
  filters: dict = {},
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubPullRequestList> {
  return github_call_typed(
    harness,
    "github.pr.list",
    {repo: slug, filters: filters},
    GithubPullRequestList,
    options,
  )
}

/** Read one pull request, including branch-protection and queue evidence. */
pub fn github_pr_view(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubPullRequestView> {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request view requires a number or canonical pull URL",
      },
    )
  }
  return github_call_typed(
    harness,
    "github.pr.view",
    {repo: slug, number: number},
    GithubPullRequestView,
    options,
  )
}

/** Read every commit on one stable pull-request head. */
pub fn github_pr_commits(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  expected_head_oid: string,
  per_page: int = 100,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubPullRequestCommits> {
  const parts = github_slug_parts(slug)
  const number = github_pr_number(pr_ref)
  if parts == nil || number == nil || trim(expected_head_oid) == "" {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request commits require owner/name, a number, and an exact head",
      },
    )
  }
  return github_connector.github_pr_commits(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      pull_number: number,
      expected_head_oid: expected_head_oid,
      per_page: per_page,
      options: options,
    },
  )
}

/** List the files changed by one pull request. */
pub fn github_pr_files(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  page: int = 1,
  per_page: int = 100,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubPullRequestFiles> {
  const number = github_pr_number(pr_ref)
  if number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "pull request file lookup requires a number or canonical pull URL",
      },
    )
  }
  return github_call_typed(
    harness,
    "github.pr.files",
    {repo: slug, number: number, page: page, per_page: per_page},
    GithubPullRequestFiles,
    options,
  )
}

/** Read one pull request's check rollup through the connector's closed record. */
pub fn github_pr_checks(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
