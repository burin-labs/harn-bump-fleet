/** Enable auto-merge only while the PR still has the observed head. */
pub fn github_enable_auto_merge(
  harness: Harness,
  slug: string,
  pr_ref: GithubPullReference,
  expected_head_oid: string,
  merge_method: string = "squash",
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubAutoMergeReceipt> {
  const parts = github_slug_parts(slug)
  const pr_number = github_pr_number(pr_ref)
  if parts == nil || pr_number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "auto-merge requires owner/name and a pull request number",
      },
    )
  }
  return pulls_enable_auto_merge(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      pull_number: pr_number,
      expected_head_oid: expected_head_oid,
      method: merge_method,
      options: options,
    },
  )
}

/** One exact local Git state published to a branch as a GitHub-signed commit. */
pub type GithubWorktreePublishRequest = {
  slug: string,
  branch: string,
  headline: string,
  repo_dir: string,
  source: string,
  base_oid?: string?,
  create_branch?: bool?,
  reset_branch?: bool?,
  expected_branch_oid?: string?,
}

/**
 * Publish one prepared worktree as a commit GitHub signs server-side.
 *
 * Slug-shaped like every other wrapper here, and defaulted to fleet connector
 * policy, so a caller names a repository rather than an owner and a name.
 */
pub fn github_worktree_commit(
  harness: Harness,
  request: GithubWorktreePublishRequest,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubWorktreeCommitReceipt> {
  const parts = github_slug_parts(request.slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  return github_commit_worktree(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      branch: request.branch,
      headline: request.headline,
      repo_dir: request.repo_dir,
      source: request.source,
      base_oid: request.base_oid,
      create_branch: request.create_branch,
      reset_branch: request.reset_branch,
      expected_branch_oid: request.expected_branch_oid,
      options: options,
    },
  )
}

/**
 * Ask GitHub whether it counts a commit as signed.
 *
 * This is the same question a `required_signatures` ruleset asks, and the only
 * one that matters for merge admission. `git verify-commit` answers a different
 * one -- whether *this machine* can check the signature -- and the two diverge
 * exactly where it counts: a commit GitHub signed server-side has no signer in
 * a local allowed-signers file, and a commit signed by a key GitHub cannot
 * attribute to the committer verifies locally and is refused by the ruleset.
 */
pub fn github_commit_signature(
  harness: Harness,
  slug: string,
  sha: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubCommitSignature> {
  return github_call_typed(
    harness,
    "github.commit.signature",
    {repo: slug, sha: sha},
    GithubCommitSignature,
    options,
  )
}

/** List one branch's merge queue through the connector-owned closed record. */
pub fn github_merge_queue_entries(
  harness: Harness,
  slug: string,
  branch: string,
  limit: int = 100,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubMergeQueueEntries> {
  return github_call_typed(
    harness,
    "github.merge_queue.entries",
    {repo: slug, branch: branch, limit: limit},
    GithubMergeQueueEntries,
    options,
  )
}

/** Disable auto-merge only while the PR remains at the observed head and base. */
pub fn github_disable_auto_merge(
  harness: Harness,
  request: GithubAutoMergeHoldRequest,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubAutoMergeDisableReceipt> {
  const parts = github_slug_parts(request.slug)
  const number = github_pr_number(request.pull_number)
  if parts == nil || number == nil {
    return Err(
      {
        code: "invalid_pull_request",
        category: "schema_drift",
        message: "auto-merge hold requires a pull request number",
      },
    )
  }
  return pulls_disable_auto_merge(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      pull_number: number,
      expected_head_oid: request.expected_head_oid,
      base_branch: request.base_branch,
      expected_base_oid: request.expected_base_oid,
      restore_merge_method: request.restore_merge_method,
      options: options,
    },
  )
}

/** Close a PR with an operator-visible comment. */
pub fn github_pr_close(
  harness: Harness,
  slug: string,
  pr_number: int,
  comment: string,
  options: GithubClientOptions = github_connector_options(),
) -> dict {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return {ok: false, error: {code: "invalid_repo", message: "repo must be owner/name"}}
  }
  return github_close_pr(
    harness,
    {
      owner: parts.owner,
      repo: parts.repo,
      pull_number: pr_number,
      comment: comment,
      options: options,
    },
  )
}

/** Add an operator-visible PR comment. */
pub fn github_pr_comment(
  harness: Harness,
  slug: string,
  pr_number: int,
  body: string,
) -> GithubConnectorResult<unknown> {
  return call(
    harness,
    "github.pr.comment",
    github_connector_options() + {repo: slug, number: pr_number, body: body},
  )
}

/**
 * How many releases one page reads.
 *
 * GitHub's release payload carries each full changelog body — roughly 18 KB per
 * release for Harn — and the connector refuses a response over 1 MB. A page of
 * 100 is about 1.8 MB and fails outright, so the depth is capped well under
 * that with room for bodies to grow.
 *
 * Callers measuring distance therefore saturate here. That is harmless for the
 * only question asked of it: anything this far behind is far past any
 * threshold, so an undercount cannot flip a verdict.
 */
const RELEASE_PAGE_DEPTH = 20

/**
 * Published release tags, newest first, up to [`RELEASE_PAGE_DEPTH`].
 *
 * Drafts and prereleases are excluded because they are not adoptable: counting
 * them would report every consumer as behind a release it must not pin.
 */
pub fn github_published_release_tags(
  harness: Harness,
  slug: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<list<string>> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  const result = api_call(
    harness,
    {
      path:
        "/repos/${parts.owner}/${parts.repo}/releases?per_page=${to_string(RELEASE_PAGE_DEPTH)}",
      options: options,
    },
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  let tags = []
  for row in unwrap(result) ?? [] {
    if (row?.draft ?? false) || (row?.prerelease ?? false) {
      continue
    }
    const tag = trim(to_string(row?.tag_name ?? ""))
    if tag != "" {
      tags = tags + [tag]
    }
  }
  return Ok(tags)
}

/**
 * The query that finds an alarm's existing issue.
 *
 * Factored out so a test can assert the exact shape offline: getting this
 * wrong does not fail loudly, it silently opens a duplicate issue every run
 * until the alarm is noise nobody reads.
 */
pub fn github_open_issues_query(label: string) -> dict {
  return {labels: label, state: "open", per_page: 100}
}

fn github_query_string(query: dict) -> string {
  let parts = []
  for key in query.keys().sort() {
    parts = parts + ["${key}=${url_encode(to_string(query[key]))}"]
  }
  return join(parts, "&")
}

/**
 * List open issues carrying a label.
 *
 * GitHub's issues endpoint returns pull requests too — every PR is an issue in
 * that API. Rows carrying `pull_request` are dropped here so a caller counting
 * "open alarms" cannot be fooled by an unrelated pull request that happens to
 * share the label.
 */
pub fn github_open_issues_with_label(
  harness: Harness,
  slug: string,
  label: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<list<GithubIssueSummary>> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  const query = github_query_string(github_open_issues_query(label))
  const result = api_call(
    harness,
    {path: "/repos/${parts.owner}/${parts.repo}/issues?${query}", options: options},
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  let issues = []
  for row in unwrap(result) ?? [] {
    if row?.pull_request != nil {
      continue
    }
    issues = issues
      + [
        {
          number: to_int(row?.number ?? 0),
          title: to_string(row?.title ?? ""),
          body: to_string(row?.body ?? ""),
          state: to_string(row?.state ?? ""),
        },
      ]
  }
  return Ok(issues)
}

/** Open one labelled issue. */
pub fn github_issue_create(
  harness: Harness,
  slug: string,
  title: string,
  body: string,
  labels: list<string>,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<unknown> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  const opts: dict = options
  return call(
    harness,
    "issues.create",
    opts
      + {owner: parts.owner, repo: parts.repo, title: title, body: body, labels: labels},
  )
}

/** Refresh an open issue's body, or close it, without touching anything else. */
pub fn github_issue_update(
  harness: Harness,
  slug: string,
  issue_number: int,
  fields: dict,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<unknown> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  const opts: dict = options
  return call(
    harness,
    "issues.update",
    opts + {owner: parts.owner, repo: parts.repo, issue_number: issue_number} + fields,
  )
}

/** Dispatch a workflow at an exact ref and retain the resolved run identity. */
pub fn github_workflow_dispatch(
  harness: Harness,
  slug: string,
  workflow: string,
  fields: dict? = nil,
  ref: string = "main",
) -> GithubConnectorResult<GithubWorkflowDispatchReceipt> {
  return github_call_typed(
    harness,
    "github.actions.workflow_dispatch",
    {repo: slug, workflow_id: workflow, ref: ref, inputs: fields ?? {}},
    GithubWorkflowDispatchReceipt,
  )
}

/** Read one exact workflow run through the connector's closed record. */
pub fn github_actions_run(
  harness: Harness,
  slug: string,
  run_id: int,
) -> GithubConnectorResult<GithubWorkflowRun> {
  return github_call_typed(
    harness,
    "github.actions.run",
    {repo: slug, run_id: run_id},
    GithubWorkflowRun,
  )
}

/** List workflow runs through the connector's closed page contract. */
pub fn github_actions_runs(
  harness: Harness,
  slug: string,
  workflow: string,
  branch: string = "main",
) -> GithubConnectorResult<GithubWorkflowRuns> {
  return github_call_typed(
    harness,
    "github.actions.runs",
    {repo: slug, workflow_id: workflow, branch: branch, event: "workflow_dispatch", per_page: 100},
    GithubWorkflowRuns,
  )
}

/** Read jobs and steps for one exact workflow run, optionally scoped to its latest attempt. */
pub fn github_actions_run_jobs(
  harness: Harness,
  slug: string,
  run_id: int,
  filter: string = "all",
