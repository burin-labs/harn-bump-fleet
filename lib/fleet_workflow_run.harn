import { github_actions_run } from "./github"

pub type FleetWorkflowReceipt = {
  schema_version: "harn_bump_fleet.hosted_dispatch.v1",
  target: string,
  run_id: int,
  run_url: string,
  status: string,
  conclusion: string,
  elapsed_ms: int,
}

/** Wait for one exact fleet run; never substitute a newer run on the branch. */
pub fn wait_fleet_workflow_run(
  harness: Harness,
  target: string,
  run_id: int,
  run_url: string,
  timeout_s: int,
  interval_s: int,
) -> FleetWorkflowReceipt {
  const started = harness.clock.now_ms()
  const stop_at = started + timeout_s * 1000
  let observed = github_actions_run(harness, "burin-labs/harn-bump-fleet", run_id)
  while !is_err(observed) && unwrap(observed).status != "completed"
    && harness.clock.now_ms()
    < stop_at {
    harness.clock.sleep_ms(interval_s * 1000)
    observed = github_actions_run(harness, "burin-labs/harn-bump-fleet", run_id)
  }
  if is_err(observed) {
    throw "fleet workflow observation failed: " + to_string(unwrap_err(observed))
  }
  const final = unwrap(observed)
  return {
    schema_version: "harn_bump_fleet.hosted_dispatch.v1",
    target: target,
    run_id: run_id,
    run_url: run_url,
    status: final.status,
    conclusion: final.conclusion,
    elapsed_ms: harness.clock.now_ms() - started,
  }
}
