import { command_run } from "std/command"
import { safe_parse } from "std/json"
import { strip_v } from "./semver"

let RUN_VIEW_SCHEMA = "harn.run_view.v1"

let SESSION_VIEW_SCHEMA = "harn.session_view.v1"

let RUN_VIEW_CHECK_TARGET = "check-run-view-fixtures"

let CONTRACT_PATH_MARKERS = [
  "crates/harn-vm/src/orchestration/records/view.rs",
  "crates/harn-vm/tests/run_view_fixtures.rs",
  "spec/run-view-fixtures/",
]

let NOTE_MARKERS = [
  "run/session view",
  "run view",
  "session view",
  "run-view",
  "session-view",
  "run_view",
  "session_view",
  "view schema",
  "schema_version",
  "run-view-fixtures",
  "compatibility fixture",
]

fn norm_path(path) {
  return replace(path ?? "", "\\", "/")
}

fn normalize_target_tag(target) {
  let normalized_target = to_string(target ?? "")
  return if starts_with(normalized_target, "v") {
    normalized_target
  } else {
    "v" + normalized_target
  }
}

fn rel_path(root, path) {
  let base = norm_path(root)
  let p = norm_path(path)
  let prefix = if ends_with(base, "/") {
    base
  } else {
    base + "/"
  }
  if starts_with(p, prefix) {
    return p.substring(len(prefix))
  }
  return p
}

fn absolute_path(path) {
  let p = to_string(path ?? "")
  return starts_with(p, "/") || starts_with(p, "\\\\") || len(regex_captures("^[A-Za-z]:[\\\\/]", p)) > 0
}

fn resolve_path(base, path) {
  let p = trim(to_string(path ?? ""))
  if p == "" || absolute_path(p) {
    return p
  }
  return path_join(base, p)
}

fn path_list_separator() {
  return if platform() == "windows" {
    ";"
  } else {
    ":"
  }
}

fn prepend_path_entries(existing, entries) {
  let sep = path_list_separator()
  let out = []
  for entry in entries {
    out = unique_push(out, entry)
  }
  for entry in to_string(existing ?? "").split(sep) {
    out = unique_push(out, trim(entry))
  }
  return join(out, sep)
}

fn schema_kind(schema) {
  if schema == RUN_VIEW_SCHEMA {
    return "run"
  }
  if schema == SESSION_VIEW_SCHEMA {
    return "session"
  }
  return "unknown"
}

fn fixture_expected_root(harn_repo) {
  return path_join(harn_repo, "spec/run-view-fixtures/cases")
}

fn list_json_files_recursive(harness: Harness, dir) {
  if !harness.fs.exists(dir) {
    return []
  }
  let out = []
  for name in harness.fs.list_dir(dir).sort() {
    let full = path_join(dir, name)
    let stat = harness.fs.stat(full)
    if stat.is_dir {
      out = out + list_json_files_recursive(harness, full)
    } else if stat.is_file && ends_with(name, ".json") {
      out = out + [full]
    }
  }
  return out.sort()
}

pub fn run_session_view_fixture_paths(harness: Harness, harn_repo) {
  let cases_root = fixture_expected_root(harn_repo)
  if !harness.fs.exists(cases_root) {
    return []
  }
  let out = []
  for case_name in harness.fs.list_dir(cases_root).sort() {
    let expected = path_join(cases_root, case_name, "expected")
    out = out + list_json_files_recursive(harness, expected)
  }
  return out.sort()
}

fn schema_record_from_value(path, value) {
  let schema = value?.schema ?? ""
  let version = value?.schema_version
  if schema == "" || version == nil {
    return nil
  }
  return {path: path, schema: schema, schema_version: version, kind: schema_kind(schema)}
}

fn add_schema_summary(by_key, record) {
  let key = record.schema + "@" + to_string(record.schema_version)
  let existing = by_key[key]
  if existing == nil {
    return by_key
      + {
      [key]: {
        schema: record.schema,
        schema_version: record.schema_version,
        kind: record.kind,
        snapshot_count: 1,
        paths: [record.path],
      },
    }
  }
  return by_key
    + {
    [key]: {...existing, snapshot_count: existing.snapshot_count + 1, paths: existing.paths + [record.path]},
  }
}

pub fn run_session_view_schema_summary_from_snapshots(snapshots) {
  let by_key = {}
  let parse_errors = []
  for snapshot in snapshots {
    let parsed = safe_parse(snapshot.text ?? "")
    if parsed == nil {
      parse_errors = parse_errors + [{path: snapshot.path, error: "invalid JSON"}]
      continue
    }
    let record = schema_record_from_value(snapshot.path, parsed)
    if record == nil {
      continue
    }
    by_key = add_schema_summary(by_key, record)
  }
  let keys = by_key.keys().sort()
  return {
    expected_json_count: len(snapshots),
    parse_errors: parse_errors,
    schemas: keys.map({ key -> by_key[key] }),
  }
}

pub fn run_session_view_schema_summary(harness: Harness, harn_repo) {
  let paths = run_session_view_fixture_paths(harness, harn_repo)
  let snapshots = paths
    .map({ path -> {path: rel_path(harn_repo, path), text: harness.fs.read_text(path)} })
  return run_session_view_schema_summary_from_snapshots(snapshots)
}

pub fn run_session_view_schema_summary_line(summary) {
  let schemas = summary?.schemas ?? []
  if len(schemas) == 0 {
    return "no run/session view schema snapshots found"
  }
  return join(
    schemas
      .map(
      { s -> return s.schema + "@" + to_string(s.schema_version) + " (" + to_string(s.snapshot_count)
        + " snapshot(s))" },
    ),
    ", ",
  )
}

fn has_schema(summary, schema) {
  for s in summary?.schemas ?? [] {
    if s.schema == schema {
      return true
    }
  }
  return false
}

pub fn run_session_view_metadata_ok(summary) {
  return len(summary?.parse_errors ?? []) == 0 && has_schema(summary, RUN_VIEW_SCHEMA)
    && has_schema(summary, SESSION_VIEW_SCHEMA)
}

fn default_fixture_runner(repo, command_env = nil) {
  return command_run(
    {argv: ["make", RUN_VIEW_CHECK_TARGET], cwd: repo, env: command_env},
    {capture: {max_inline_bytes: 20000}},
  )
}

pub fn run_session_view_check(harn_repo, runner = nil, command_env = nil) {
  let r = if runner == nil {
    default_fixture_runner(harn_repo, command_env)
  } else {
    runner({repo: harn_repo, argv: ["make", RUN_VIEW_CHECK_TARGET], env: command_env})
  }
  return {
    name: RUN_VIEW_CHECK_TARGET,
    command: "make " + RUN_VIEW_CHECK_TARGET,
    success: r.success,
    status: r.status,
    stdout: r.stdout ?? "",
    stderr: r.stderr ?? "",
  }
}

pub fn run_session_view_gate(harness: Harness, harn_repo, runner = nil, command_env = nil) {
  let summary = run_session_view_schema_summary(harness, harn_repo)
  let check = run_session_view_check(harn_repo, runner, command_env)
  let metadata_ok = run_session_view_metadata_ok(summary)
  return {
    ok: check.success && metadata_ok,
    check: check,
    cargo_target_dir: command_env?.CARGO_TARGET_DIR ?? "",
    metadata_ok: metadata_ok,
    expected_json_count: summary.expected_json_count,
    parse_errors: summary.parse_errors,
    schemas: summary.schemas,
    summary_line: run_session_view_schema_summary_line(summary),
  }
}

pub fn run_session_view_mock_gate() {
  let summary = run_session_view_schema_summary_from_snapshots(
    [
      {
        path: "spec/run-view-fixtures/cases/mock/expected/runs/run.run_view.json",
        text: json_stringify({schema: RUN_VIEW_SCHEMA, schema_version: 1}),
      },
      {
        path: "spec/run-view-fixtures/cases/mock/expected/session_view.json",
        text: json_stringify({schema: SESSION_VIEW_SCHEMA, schema_version: 1}),
      },
    ],
  )
  return {
    ok: true,
    check: {
      name: RUN_VIEW_CHECK_TARGET,
      command: "make " + RUN_VIEW_CHECK_TARGET,
      success: true,
      status: 0,
      stdout: "mocked run/session view fixture check\n",
      stderr: "",
    },
    metadata_ok: true,
    expected_json_count: summary.expected_json_count,
    parse_errors: summary.parse_errors,
    schemas: summary.schemas,
    summary_line: run_session_view_schema_summary_line(summary),
    mock: true,
  }
}

pub fn harn_repo_version(harness: Harness, harn_repo) {
  let cargo = path_join(harn_repo, "Cargo.toml")
  if !harness.fs.exists(cargo) {
    return ""
  }
  let matches = regex_captures("(?m)^version\\s*=\\s*\"([^\"]+)\"", harness.fs.read_text(cargo))
  if len(matches) == 0 {
    return ""
  }
  return matches[0].groups[0]
}

pub fn run_session_view_cargo_target_dir_from_config(harness: Harness, harn_repo) {
  let config = path_join(harn_repo, ".cargo/config.toml")
  if !harness.fs.exists(config) {
    return ""
  }
  let matches = regex_captures("(?m)^\\s*target-dir\\s*=\\s*\"([^\"]+)\"", harness.fs.read_text(config))
  if len(matches) == 0 {
    return ""
  }
  return resolve_path(harn_repo, matches[0].groups[0])
}

pub fn run_session_view_cargo_target_dir(harness: Harness, harn_repo) {
  let env_target = trim(harness.env.get_or("CARGO_TARGET_DIR", ""))
  if env_target != "" {
    return resolve_path(cwd(), env_target)
  }
  let configured = run_session_view_cargo_target_dir_from_config(harness, harn_repo)
  if configured != "" {
    return configured
  }
  return path_join(cwd(), ".harn-runs/run-session-view-cargo-target")
}

pub fn run_session_view_cargo_build_dir(cargo_target_dir) {
  let target = trim(cargo_target_dir ?? "")
  if target == "" {
    return ""
  }
  return path_join(target, "build")
}

fn run_session_view_base_command_env(harness: Harness) {
  let home = harness.env.get_or("HOME", harness.env.get_or("USERPROFILE", ""))
  let tool_paths = if home == "" {
    []
  } else {
    [
      path_join(home, ".cargo/bin"),
      path_join(home, ".local/share/mise/shims"),
      path_join(home, ".local/bin"),
    ]
  }
  let platform_paths = if platform() == "windows" {
    []
  } else {
    ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"]
  }
  return {
    CARGO_BUILD_RUSTC_WRAPPER: "",
    CARGO_INCREMENTAL: "0",
    PATH: prepend_path_entries(harness.env.get_or("PATH", ""), tool_paths + platform_paths),
    RUSTC_WRAPPER: "",
    SCCACHE_DISABLE: "1",
  }
}

pub fn run_session_view_command_env_for_target(harness: Harness, cargo_target_dir) {
  let target = trim(cargo_target_dir ?? "")
  return run_session_view_base_command_env(harness)
    + {CARGO_TARGET_DIR: target, CARGO_BUILD_BUILD_DIR: run_session_view_cargo_build_dir(target)}
}

pub fn run_session_view_command_env(harness: Harness, harn_repo) {
  return run_session_view_command_env_for_target(
    harness,
    run_session_view_cargo_target_dir(harness, harn_repo),
  )
}

pub fn run_session_view_fleet_command_env(harness: Harness, harn_checkout) {
  return run_session_view_command_env_for_target(
    harness,
    path_join(harn_checkout, ".target/run-session-view-gate"),
  )
}

pub fn run_session_view_release_command_env(
  harness: Harness,
  harn_checkout,
  release_cargo_target_dir,
) {
  let base = run_session_view_command_env(harness, harn_checkout)
  let target = trim(release_cargo_target_dir ?? "")
  if target == "" {
    return base
  }
  return run_session_view_command_env_for_target(harness, target)
}

fn unique_push(values, value) {
  if value == "" || contains(values, value) {
    return values
  }
  return values + [value]
}

pub fn run_session_view_contract_paths_from_text(text) {
  let paths = []
  let body = norm_path(text ?? "")
  for marker in CONTRACT_PATH_MARKERS {
    if contains(body, marker) {
      paths = unique_push(paths, marker)
    }
  }
  return paths.sort()
}

pub fn run_session_view_contract_change(analysis) {
  let evidence = join(
    [
      analysis?.diff_names ?? "",
      analysis?.commit_file_changes_since_latest_tag ?? "",
      analysis?.commit_stats_since_latest_tag ?? "",
    ],
    "\n",
  )
  let paths = run_session_view_contract_paths_from_text(evidence)
  return {changed: len(paths) > 0, paths: paths}
}

fn note_text_mentions_view_schema(text) {
  let lower = lowercase(text ?? "")
  for marker in NOTE_MARKERS {
    if contains(lower, marker) {
      return true
    }
  }
  return false
}

fn changelog_fragment_text(harness: Harness, harn_repo) {
  let dir = path_join(harn_repo, "changelog.d")
  if !harness.fs.exists(dir) {
    return ""
  }
  let parts = []
  for name in harness.fs.list_dir(dir).sort() {
    if !ends_with(name, ".md") {
      continue
    }
    let full = path_join(dir, name)
    if harness.fs.stat(full).is_file {
      parts = parts + [harness.fs.read_text(full)]
    }
  }
  return join(parts, "\n")
}

pub fn run_session_view_release_note_status(harness: Harness, harn_repo, analysis) {
  let change = run_session_view_contract_change(analysis)
  let note_text = join(
    [
      analysis?.changelog_section ?? "",
      analysis?.changelog_unreleased_section ?? "",
      changelog_fragment_text(harness, harn_repo),
    ],
    "\n",
  )
  let present = note_text_mentions_view_schema(note_text)
  return {
    changed: change.changed,
    paths: change.paths,
    required: change.changed,
    present: present,
    ok: !change.changed || present,
  }
}

pub fn run_session_view_target_change_probe(harn_repo, target, runner = nil) {
  let run = if runner == nil {
    { spec -> command_run(spec, {cwd: harn_repo, capture: {max_inline_bytes: 12000}}) }
  } else {
    runner
  }
  let target_tag = normalize_target_tag(target)
  let previous = run({argv: ["git", "describe", "--tags", "--abbrev=0", target_tag + "^"]})
  if !previous.success || trim(previous.stdout ?? "") == "" {
    return {
      known: false,
      changed: false,
      base_tag: "",
      target_tag: target_tag,
      paths: [],
      detail: trim(previous.stderr ?? "could not resolve previous release tag"),
    }
  }
  let base_tag = trim(previous.stdout)
  let diff = run({argv: ["git", "diff", "--name-only", base_tag + ".." + target_tag]})
  if !diff.success {
    return {
      known: false,
      changed: false,
      base_tag: base_tag,
      target_tag: target_tag,
      paths: [],
      detail: trim(diff.stderr ?? "could not diff release range"),
    }
  }
  let paths = run_session_view_contract_paths_from_text(diff.stdout ?? "")
  return {
    known: true,
    changed: len(paths) > 0,
    base_tag: base_tag,
    target_tag: target_tag,
    paths: paths,
    detail: if len(paths) == 0 {
      "no run/session view contract files changed from ${base_tag} to ${target_tag}"
    } else {
      "run/session view contract files changed from ${base_tag} to ${target_tag}: "
        + join(paths, ", ")
    },
  }
}

fn gate_failure_from_checkout(
  harness: Harness,
  harn_repo,
  target,
  stderr,
  target_change_detail = "",
) {
  let wanted = strip_v(target ?? "")
  let have = harn_repo_version(harness, harn_repo)
  let summary = run_session_view_schema_summary(harness, harn_repo)
  return {
    ok: false,
    check: {
      name: RUN_VIEW_CHECK_TARGET,
      command: "make " + RUN_VIEW_CHECK_TARGET,
      success: false,
      status: 2,
      stdout: "",
      stderr: stderr,
    },
    metadata_ok: run_session_view_metadata_ok(summary),
    expected_json_count: summary.expected_json_count,
    parse_errors: summary.parse_errors,
    schemas: summary.schemas,
    summary_line: run_session_view_schema_summary_line(summary),
    repo_version: have,
    target_version: wanted,
    target_change: {
      known: false,
      changed: false,
      paths: [],
      detail: if target_change_detail == "" {
        stderr
      } else {
        target_change_detail
      },
    },
  }
}

pub fn run_session_view_fleet_checkout_gate(
  harness: Harness,
  harn_repo,
  target,
  runner = nil,
  change_runner = nil,
  command_env = nil,
) {
  let wanted = strip_v(target ?? "")
  let have = harn_repo_version(harness, harn_repo)
  if have == "" {
    return gate_failure_from_checkout(
      harness,
      harn_repo,
      target,
      "could not read Harn version from ${harn_repo}/Cargo.toml",
      "version unavailable",
    )
  }
  if have != wanted {
    return gate_failure_from_checkout(
      harness,
      harn_repo,
      target,
      "Harn checkout at ${harn_repo} is version ${have}, but fleet target is ${wanted}; the gate must run against the exact release tag before bumping",
      "version mismatch",
    )
  }
  let gate = run_session_view_gate(harness, harn_repo, runner, command_env)
  let target_change = run_session_view_target_change_probe(harn_repo, target, change_runner)
  return {
    ...gate,
    ok: gate.ok && target_change.known,
    repo_version: have,
    target_version: wanted,
    target_change: target_change,
  }
}

fn git_in_repo(repo, argv) {
  return command_run({argv: argv, cwd: repo}, {capture: {max_inline_bytes: 20000}})
}

pub fn run_session_view_fleet_gate(
  harness: Harness,
  harn_repo,
  target,
  runner = nil,
  change_runner = nil,
) {
  if runner != nil || change_runner != nil {
    return run_session_view_fleet_checkout_gate(harness, harn_repo, target, runner, change_runner)
  }
  let target_tag = normalize_target_tag(target)
  let fetch = git_in_repo(harn_repo, ["git", "fetch", "--tags", "--quiet", "origin"])
  if !fetch.success {
    return gate_failure_from_checkout(
      harness,
      harn_repo,
      target,
      "could not fetch Harn tags before run/session view gate: " + trim(fetch.stderr ?? ""),
      "tag fetch failed",
    )
  }
  let worktree = path_join(harness.fs.temp_dir(), "harn-run-view-gate-" + uuid_v7())
  let add = git_in_repo(harn_repo, ["git", "worktree", "add", "--detach", worktree, target_tag])
  if !add.success {
    return gate_failure_from_checkout(
      harness,
      harn_repo,
      target,
      "could not create temporary Harn worktree for ${target_tag}: " + trim(add.stderr ?? ""),
      "target tag checkout failed",
    )
  }
  let command_env = run_session_view_fleet_command_env(harness, worktree)
  let gate = run_session_view_fleet_checkout_gate(harness, worktree, target, nil, nil, command_env)
  let cleanup = git_in_repo(harn_repo, ["git", "worktree", "remove", "--force", worktree])
  return {
    ...gate,
    source_repo: harn_repo,
    checked_repo: worktree,
    cleanup: {success: cleanup.success, status: cleanup.status, stderr: trim(cleanup.stderr ?? "")},
  }
}

pub fn run_session_view_downstream_markdown(target, gate) {
  let change = gate?.target_change ?? {known: false, changed: false, paths: [], detail: "not checked"}
  let change_line = if change.known {
    if change.changed {
      "yes — " + join(change.paths ?? [], ", ")
    } else {
      "no"
    }
  } else {
    "unknown — " + to_string(change.detail ?? "change probe did not complete")
  }
  return join(
    [
      "## Harn run/session view compatibility",
      "",
      "- Target Harn version: `${target}`.",
      "- Fixture gate: `make check-run-view-fixtures` "
        + if gate?.check?.success ?? false {
        "passed"
      } else {
        "failed"
      }
        + ".",
      "- Tested schemas: " + to_string(gate?.summary_line ?? "unknown") + ".",
      "- View-schema or fixture change in this bump: " + change_line + ".",
      "",
      "This metadata is generated by `harn-bump-fleet` before auto-merge so downstream repos can see whether adopting this Harn bump carries a run/session view contract change.",
    ],
    "\n",
  )
}
