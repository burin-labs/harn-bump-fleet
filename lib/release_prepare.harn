fn merge_group_audit_receipt_artifact_path(run_id) {
  return path_join(release_run_dir(run_id), "merge-group-audit-receipt.json")
}

fn merge_group_audit_receipt_workspace_path(cfg, run_id) {
  return path_join(cfg.repo, ".harn", "release-audit-receipts", "${run_id}.json")
}

fn write_merge_group_audit_receipt(harness: Harness, path: string, receipt) {
  harness.fs.mkdir(dirname(path), true)
  harness.fs.write_text(path, json_stringify(receipt) + "\n")
  return path
}

fn persist_merge_group_audit_receipt(harness: Harness, cfg, run_id, receipt) {
  const artifact_path = write_merge_group_audit_receipt(harness, merge_group_audit_receipt_artifact_path(run_id), receipt)
  const receipt_path = write_merge_group_audit_receipt(
    harness,
    merge_group_audit_receipt_workspace_path(cfg, run_id),
    receipt,
  )
  return {artifact_path: artifact_path, receipt_path: receipt_path}
}

fn mock_release_audit_required_jobs() {
  return ["Format check", "Rust lint", "Rust test", "Harn conformance + audit"]
}

fn exact_pin_harn_binary(harness: Harness, cfg) {
  const plain = path_join(cfg.release_cargo_target_dir, "debug", "harn")
  if cfg.mock || harness.fs.exists(plain) {
    return plain
  }
  const windows = plain + ".exe"
  if harness.fs.exists(windows) {
    return windows
  }
  return nil
}

/**
 * Resolve exact-pin merge-group evidence. Any unavailable, ambiguous, or
 * malformed evidence is a successful decision to retain the local audit.
 */
fn resolve_merge_group_audit_reuse(harness: Harness, cfg, steps, run_id) {
  const required_jobs = if cfg.mock {
    mock_release_audit_required_jobs()
  } else {
    release_audit_contract_required_jobs(path_join(cfg.repo, "scripts", "release_audit_contract.json"))
  }
  if required_jobs == nil {
    const reason = "Harn release-audit contract was missing or invalid; running the full audit locally"
    return {
      steps: steps
        + [recorded_step("merge-group-audit-reuse", "read Harn release-audit contract", ok(reason + "\n"))],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const config = merge_group_audit_config(cfg.pin_sha, required_jobs)
  const decision = if cfg.mock {
    resolve_merge_group_audit(config, mock_merge_group_audit_adapter())
  } else {
    resolve_merge_group_audit(config)
  }
  if !decision.reuse || decision.evidence == nil {
    const recorded = {
      ...recorded_step(
        "merge-group-audit-reuse",
        "inspect typed merge-group CI receipt for exact release pin",
        ok(decision.reason + "\n"),
      ),
      audit_source: "merge-group-ci",
      receipt_reused: false,
    }
    release_log_event(
      harness,
      run_id,
      "merge_group_audit_reuse",
      {reuse: false, reason: decision.reason},
    )
    return {steps: steps + [recorded], receipt_path: "", harn_bin: ""}
  }
  let resolved_steps = steps
  const warm_command = release_pin_cli_warm_command(
    cfg.repo,
    cfg.pin_sha,
    cfg.bootstrap_new_crates,
    cfg.release_cargo_target_dir,
  )
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: "warm-exact-pin-harn-cli", pin_sha: cfg.pin_sha},
  )
  const warmed = run_cmd(cfg, warm_command)
  if !warmed.success {
    const reason = "exact-pin Harn CLI warm failed; running the full audit locally"
    const fallback_step = {
      ...recorded_step("warm-exact-pin-harn-cli", warm_command, ok(reason + "\n")),
      warm_success: false,
      warm_status: warmed.status,
      diagnostic_output: truncate_text(command_output(warmed), 12000),
    }
    release_log_event(
      harness,
      run_id,
      "step_finished",
      {
        step: "warm-exact-pin-harn-cli",
        success: true,
        warm_success: false,
        warm_status: warmed.status,
        fallback: "local-audit",
      },
    )
    return {steps: resolved_steps + [fallback_step], receipt_path: "", harn_bin: ""}
  }
  const harn_bin = exact_pin_harn_binary(harness, cfg)
  if harn_bin == nil {
    const reason = "exact-pin Harn CLI binary was not produced; running the full audit locally"
    return {
      steps: resolved_steps
        + [recorded_step("warm-exact-pin-harn-cli", warm_command, ok(reason + "\n"))],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const binary_sha256 = if cfg.mock {
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  } else {
    harness.crypto.sha256(harness.fs.read_bytes(harn_bin))
  }
  const receipt = merge_group_audit_receipt(decision.evidence, binary_sha256)
  if receipt == nil {
    const reason = "exact-pin Harn CLI hash was invalid; running the full audit locally"
    return {
      steps: resolved_steps
        + [recorded_step("warm-exact-pin-harn-cli", warm_command, ok(reason + "\n"))],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const persisted = try {
    persist_merge_group_audit_receipt(harness, cfg, run_id, receipt)
  } catch (_e) {
    nil
  }
  if persisted == nil {
    const reason = "merge-group audit receipt could not be persisted; running the full audit locally"
    return {
      steps: resolved_steps
        + [recorded_step("merge-group-audit-reuse", "persist Harn release-audit receipt", ok(reason + "\n"))],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const receipt_path = persisted.receipt_path
  const warm_step = {
    ...recorded_step("warm-exact-pin-harn-cli", warm_command, warmed),
    pin_sha: cfg.pin_sha,
    cargo_target_dir: cfg.release_cargo_target_dir,
    binary_sha256: binary_sha256,
    harn_bin: harn_bin,
  }
  resolved_steps = resolved_steps + [warm_step]
  const receipt_step = {
    ...recorded_step(
      "merge-group-audit-reuse",
      "acquire exact merge-group CI evidence and close the Harn receipt",
      ok(decision.reason + "\nreceipt: ${receipt_path}\n"),
    ),
    audit_source: "merge-group-ci",
    receipt_reused: true,
    merge_group_audit_receipt_path: receipt_path,
    merge_group_audit_receipt_artifact_path: persisted.artifact_path,
    merge_group_audit_receipt: receipt,
  }
  resolved_steps = resolved_steps + [receipt_step]
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {
      step: "warm-exact-pin-harn-cli",
      success: true,
      pin_sha: cfg.pin_sha,
      cargo_target_dir: cfg.release_cargo_target_dir,
      binary_sha256: binary_sha256,
      harn_bin: harn_bin,
    },
  )
  release_log_event(
    harness,
    run_id,
    "merge_group_audit_reuse",
    {reuse: true, reason: decision.reason, receipt_path: receipt_path, receipt: receipt},
  )
  return {steps: resolved_steps, receipt_path: receipt_path, harn_bin: harn_bin}
}

fn resolve_prepare_audit_evidence(harness: Harness, cfg, steps, run_id) {
  if cfg.local_audit ?? false {
    return {steps: steps, receipt_path: "", harn_bin: ""}
  }
  return resolve_merge_group_audit_reuse(harness, cfg, steps, run_id)
}

/** Resolve reusable audit evidence and the exact prepare command from one typed plan. */
pub fn release_prepare_audit_plan(harness: Harness, cfg, steps = [], run_id = nil) {
  const id = run_id ?? uuid_v7()
  const evidence = resolve_prepare_audit_evidence(harness, cfg, steps, id)
  return {...evidence, command: prepare_command(cfg, evidence), run_id: id}
}

/**
 * Enumerate non-merge prepare commits in the immutable release attempt
 * — the commits we want to cherry-pick onto fresh `<base>` during a
 * fixup pass instead of re-running `./scripts/release_ship.sh --prepare`.
 *
 * Skips merges so the `Tie release/v$ver to shipped tag (ours)` merge
 * commit that a prior fixup may have laid down does not get replayed
 * (it has no tree delta and `execute_ship_pr` rebuilds it later if
 * needed). The source OID was validated against the attempt PR during fixup
 * discovery and remains stable after the local branch is reset to fresh base.
 */
fn fixup_prepare_commits(cfg) {
  const publication = cfg.fixup_publication
  if publication == nil || trim(publication.head_oid ?? "") == "" {
    return {success: false, commits: [], stderr: "fixup state is missing its immutable release publication"}
  }
  const r = run_git(
    cfg,
    ["log", "--reverse", "--no-merges", "--format=%H", "origin/${cfg.base}..${publication.head_oid}"],
  )
  if !r.success {
    return {success: false, commits: [], stderr: r.stderr ?? ""}
  }
  let commits = []
  for line in split(r.stdout ?? "", "\n") {
    const sha = trim(line)
    if sha != "" {
      commits = commits + [sha]
    }
  }
  return {success: true, commits: commits, stderr: ""}
}

fn fixup_cherry_pick_argv(commits) {
  return ["git", "cherry-pick", "--no-commit", "--strategy-option=ours"] + commits
}

/**
 * Reconcile the fresh base through Harn's canonical version-preparation owner
 * before replaying an older immutable release attempt.
 *
 * The old prepare commit cannot know about workspace crates or sibling
 * dependencies added after its pin. Letting `-X ours` resolve those hunks
 * without this pass can leave a mixed release where the workspace says the
 * shipped version but a new dependency still pins the previous one.
 */
pub fn release_fixup_reconcile_command(cfg, current_version, expected_version) {
  const current_version_line = shell_quote("version = \"${current_version}\"")
  const version_line = shell_quote("version = \"${expected_version}\"")
  return "grep -Fqx ${current_version_line} Cargo.toml && "
    + release_prepare_env(cfg.repo, cfg.bootstrap_new_crates, cfg.release_cargo_target_dir)
    + " ./scripts/release_gate.sh prepare --bump ${shell_quote(cfg.bump)} --allow-dirty"
    + " && grep -Fqx ${version_line} Cargo.toml"
    + " && git add -u"
}

/**
 * Replay the original release branch's prepare commits after the fresh-base
 * metadata reconciliation has been staged. `--strategy-option=ours` keeps
 * that current content for conflicting hunks (most commonly CHANGELOG.md,
 * where `<base>` drift collides with the old `## Unreleased` → `## v$ver`
 * rewrite). The follow-up `git checkout HEAD -- CHANGELOG.md` step in
 * `execute_prepare` neutralizes non-conflicting CHANGELOG hunks too, so the
 * smart-subtract writer remains authoritative. `--no-commit` lets the
 * downstream release commit capture the reconciled metadata and replayed
 * fragment deletions together.
 */
fn fixup_prepare_commits_failure_step(cfg, probe) {
  if !probe.success {
    return recorded_step(
      "fixup-list-prepare-commits",
      "git log --reverse --no-merges origin/${cfg.base}..${cfg.fixup_publication?.head_oid ?? "(missing)"}",
      fail(2, "could not enumerate prepare commits to cherry-pick:\n${trim(probe.stderr ?? "")}"),
    )
  }
  if len(probe.commits) == 0 {
    return recorded_step(
      "fixup-list-prepare-commits",
      "git log --reverse --no-merges origin/${cfg.base}..${cfg.fixup_publication.head_oid}",
      fail(
        2,
        "no non-merge commits in immutable release attempt ${cfg.fixup_publication.remote_ref} to cherry-pick",
      ),
    )
  }
  return nil
}

fn execute_fixup_cherry_pick_commits(harness: Harness, cfg, commits, steps, run_id) {
  const cherry_argv = fixup_cherry_pick_argv(commits)
  release_log_event(
    harness,
    run_id,
    "step_started",
    {
      step: "fixup-cherry-pick-prepare-commits",
      command: argv_label(cherry_argv),
      commit_count: len(commits),
    },
  )
  const result = append_command_step(harness, cfg, steps, "fixup-cherry-pick-prepare-commits", cherry_argv)
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {
      step: "fixup-cherry-pick-prepare-commits",
      success: result.success,
      status: result.status,
      commit_count: len(commits),
    },
  )
  if result.success {
    return result.steps
  }
  // Failure leaves CHERRY_PICK_HEAD set, which would block the next run.
  // Abort defensively; `|| true` keeps the cleanup itself from masking
  // the original failure when there is nothing to abort.
  const abort = append_command_step(
    harness,
    cfg,
    result.steps,
    "fixup-cherry-pick-abort",
    "git cherry-pick --abort 2>/dev/null || true",
  )
  return abort.steps
}

/** Reconcile fresh-base release metadata, then replay the immutable prepare commit. */
pub fn execute_fixup_reconciliation(harness: Harness, cfg, analysis, steps, run_id) {
  // Prove the immutable replay input before the canonical prepare mutates the
  // fresh checkout. A missing or empty attempt must leave the branch clean.
  const probe = fixup_prepare_commits(cfg)
  const failure = fixup_prepare_commits_failure_step(cfg, probe)
  if failure != nil {
    return steps + [failure]
  }
  const command = release_fixup_reconcile_command(cfg, analysis.current_version, analysis.next_version)
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: "fixup-reconcile-fresh-base-release-metadata", command: command},
  )
  const reconciled = append_command_step(harness, cfg, steps, "fixup-reconcile-fresh-base-release-metadata", command)
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {
      step: "fixup-reconcile-fresh-base-release-metadata",
      success: reconciled.success,
      status: reconciled.status,
    },
  )
  if !reconciled.success {
    return reconciled.steps
  }
  return execute_fixup_cherry_pick_commits(harness, cfg, probe.commits, reconciled.steps, run_id)
}

fn release_adds_workspace_crate(analysis) {
  const changes = analysis.commit_file_changes_since_latest_tag ?? ""
  return contains(changes, "A\tcrates/") && contains(changes, "/Cargo.toml")
}

pub fn with_derived_release_options(cfg, analysis) {
  if cfg.bootstrap_new_crates ?? false {
    return cfg
  }
  if release_adds_workspace_crate(analysis) {
    return {...cfg, bootstrap_new_crates: true}
  }
  return cfg
}
