// Extracted release-harness stage. See AGENTS.md for ownership.
import { argv_label } from "std/command"
import { command_result_fail, command_result_ok } from "std/command"
import { shell_quote } from "std/runtime"
import {
  PlatformCertificationConfig,
  mock_platform_certification_adapter,
  resolve_platform_certification,
} from "./platform_certification"
import { ReleaseAnalysis } from "./release_analysis"
import {
  release_cargo_cache_prune_command,
  release_pin_cli_warm_command,
  release_prepare_env,
} from "./release_commands"
import { recorded_step } from "./release_execution"
import { ReleasePublication } from "./release_publication"
import {
  ReleaseConfig,
  append_command_step,
  release_log_event,
  release_run_dir,
  run_cmd,
  run_git,
} from "release_runtime"

pub type ReleasePrepareAuditConfig = {
  mock: bool,
  local_audit: bool,
  pin_sha: string,
  /**
   * Raw `--at-sha` input, empty when the pin was captured from
   * `origin/<base>` HEAD at startup. Derived into the certification's
   * `explicit_pin` exactly the way `release_cutoff_gate` derives its own
   * short-circuit, so both read one source of truth.
   */
  pin_sha_input?: string,
  repo: string,
  base: string,
  release_cargo_target_dir: string,
  bootstrap_new_crates: bool,
  bump: "patch" | "minor" | "major",
  mock_pin_warm_fail?: bool,
}

pub type ReleasePrepareAuditEvidence = {steps: list<dict>, receipt_path: string, harn_bin: string}

pub type ReleasePrepareAuditPlan = {
  steps: list<dict>,
  receipt_path: string,
  harn_bin: string,
  command: string,
  run_id: string,
}

pub type ReleaseFixupConfig = {
  mock: bool,
  repo: string,
  base: string,
  bump: "patch" | "minor" | "major",
  bootstrap_new_crates: bool,
  release_cargo_target_dir: string,
  fixup_publication: ReleasePublication?,
  quiet?: bool,
}

pub type ReleaseVersionPair = {current_version: string, next_version: string}

pub type ReleaseFixupPrepareCommits = {success: bool, commits: list<string>, stderr: string}

fn prepare_command(
  cfg: ReleasePrepareAuditConfig,
  audit_evidence: ReleasePrepareAuditEvidence? = nil,
) -> string {
  // Keep the bootstrap Harn used to run this harness out of the target repo's
  // release gate. release_gate.sh intentionally exports HARN_BIN to its Harn
  // audit lanes, but it must resolve that binary from the release worktree.
  //
  // Also override any inherited CARGO_TARGET_DIR. Release sessions are often
  // launched from agent shells that carry repo-specific Cargo target dirs; using
  // one of those here can block Harn package/audit steps behind unrelated builds.
  //
  const receipt_path = trim(audit_evidence?.receipt_path ?? "")
  const harn_bin = trim(audit_evidence?.harn_bin ?? "")
  if receipt_path == "" != (harn_bin == "") {
    throw "release audit receipt and warmed HARN_BIN must be supplied together"
  }
  const reuse = receipt_path != ""
  if !reuse {
    return "echo 'error: hosted platform certification receipt is required before release preparation' >&2; exit 1"
  }
  const prefix = if reuse {
    ""
  } else {
    release_cargo_cache_prune_command(cfg.release_cargo_target_dir) + " && "
  }
  let env = release_prepare_env(cfg.repo, cfg.bootstrap_new_crates, cfg.release_cargo_target_dir)
  let args = " ./scripts/release_ship.sh --prepare --bump ${cfg.bump}"
  if reuse {
    env = env + " HARN_BIN=" + shell_quote(harn_bin)
    args = args + " --audit-receipt " + shell_quote(receipt_path)
  }
  return prefix + env + args
}

fn platform_certification_receipt_artifact_path(run_id: string) -> string {
  return path_join(release_run_dir(run_id), "platform-certification-receipt.json")
}

fn platform_certification_receipt_workspace_path(
  cfg: ReleasePrepareAuditConfig,
  run_id: string,
) -> string {
  return path_join(cfg.repo, ".harn", "release-audit-receipts", "${run_id}.json")
}

fn write_platform_certification_receipt(harness: Harness, path: string, receipt: dict) -> string {
  harness.fs.mkdir(dirname(path), true)
  harness.fs.write_text(path, json_stringify(receipt) + "\n")
  return path
}

fn persist_platform_certification_receipt(
  harness: Harness,
  cfg: ReleasePrepareAuditConfig,
  run_id: string,
  receipt: dict,
) -> {artifact_path: string, receipt_path: string} {
  const artifact_path = write_platform_certification_receipt(
    harness,
    platform_certification_receipt_artifact_path(run_id),
    receipt,
  )
  const receipt_path = write_platform_certification_receipt(
    harness,
    platform_certification_receipt_workspace_path(cfg, run_id),
    receipt,
  )
  return {artifact_path: artifact_path, receipt_path: receipt_path}
}

fn exact_pin_harn_binary(harness: Harness, cfg: ReleasePrepareAuditConfig) -> string? {
  const plain = path_join(cfg.release_cargo_target_dir, "debug", "harn")
  if cfg.mock || harness.fs.exists(plain) {
    return plain
  }
  const windows = plain + ".exe"
  if harness.fs.exists(windows) {
    return windows
  }
  return nil
}

/** Build and persist the mandatory exact-pin hosted platform certification. */
fn resolve_prepare_audit_evidence(
  harness: Harness,
  cfg: ReleasePrepareAuditConfig,
  steps: list<dict>,
  run_id: string,
) -> ReleasePrepareAuditEvidence {
  let resolved_steps = steps
  if cfg.local_audit {
    return {
      steps: steps
        + [
        recorded_step(
          "hosted-platform-certification",
          "reject local-only release preparation",
          command_result_fail(
            2,
            "hosted Windows and macOS certification is mandatory for release preparation",
          ),
        ),
      ],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const warm_command = release_pin_cli_warm_command(
    cfg.repo,
    cfg.pin_sha,
    cfg.bootstrap_new_crates,
    cfg.release_cargo_target_dir,
  )
  const warmed = run_cmd(cfg, warm_command)
  resolved_steps = resolved_steps
    + [
    {
      ...recorded_step("warm-exact-pin-harn-cli", warm_command, warmed),
      pin_sha: cfg.pin_sha,
      cargo_target_dir: cfg.release_cargo_target_dir,
    },
  ]
  if !warmed.success {
    return {steps: resolved_steps, receipt_path: "", harn_bin: ""}
  }
  const harn_bin = exact_pin_harn_binary(harness, cfg)
  if harn_bin == nil {
    return {
      steps: resolved_steps
        + [
        recorded_step(
          "hosted-platform-certification",
          "resolve exact-pin Harn CLI",
          command_result_fail(2, "exact-pin Harn CLI binary was not produced"),
        ),
      ],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const binary_sha256 = if cfg.mock {
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  } else {
    harness.crypto.sha256(harness.fs.read_bytes(harn_bin))
  }
  const certification_cfg: PlatformCertificationConfig = {
    repo: "burin-labs/harn",
    branch: cfg.base,
    pin_sha: cfg.pin_sha,
    workspace: cfg.repo,
    harn_bin: harn_bin,
    explicit_pin: trim(cfg.pin_sha_input ?? "") != "",
  }
  const decision = if cfg.mock {
    resolve_platform_certification(
      harness,
      certification_cfg,
      binary_sha256,
      mock_platform_certification_adapter(certification_cfg),
    )
  } else {
    resolve_platform_certification(harness, certification_cfg, binary_sha256)
  }
  if !decision.success || decision.receipt == nil {
    return {
      steps: resolved_steps
        + [
        {
          ...recorded_step(
            "hosted-platform-certification",
            "certify exact Windows, macOS, and local source lanes",
            command_result_fail(2, decision.reason),
          ),
          cancellations: decision.cancellations,
        },
      ],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const persisted = persist_platform_certification_receipt(harness, cfg, run_id, decision.receipt)
  const receipt_step = {
    ...recorded_step(
      "hosted-platform-certification",
      "certify exact Windows, macOS, and local source lanes",
      command_result_ok(decision.reason + "\nreceipt: ${persisted.receipt_path}\n"),
    ),
    audit_source: "hosted-platform",
    receipt_reused: true,
    platform_certification_receipt_path: persisted.receipt_path,
    platform_certification_receipt_artifact_path: persisted.artifact_path,
    platform_certification_receipt: decision.receipt,
  }
  release_log_event(
    harness,
    run_id,
    "hosted_platform_certification",
    {success: true, receipt_path: persisted.receipt_path, receipt: decision.receipt},
  )
  return {
    steps: resolved_steps + [receipt_step],
    receipt_path: persisted.receipt_path,
    harn_bin: harn_bin,
  }
}

/** Resolve reusable audit evidence and the exact prepare command from one typed plan. */
pub fn release_prepare_audit_plan(
  harness: Harness,
  cfg: ReleasePrepareAuditConfig,
  steps: list<dict> = [],
  run_id: string? = nil,
) -> ReleasePrepareAuditPlan {
  const id = run_id ?? uuid_v7()
  const evidence = resolve_prepare_audit_evidence(harness, cfg, steps, id)
  return {
    steps: evidence.steps,
    receipt_path: evidence.receipt_path,
    harn_bin: evidence.harn_bin,
    command: prepare_command(cfg, evidence),
    run_id: id,
  }
}

/**
 * Enumerate non-merge prepare commits in the immutable release attempt
 * — the commits we want to cherry-pick onto fresh `<base>` during a
 * fixup pass instead of re-running `./scripts/release_ship.sh --prepare`.
 *
 * Skips merges so the `Tie release/v$ver to shipped tag (ours)` merge
 * commit that a prior fixup may have laid down does not get replayed
 * (it has no tree delta and `release_ship_prepare` rebuilds it later if
 * needed). The source OID was validated against the attempt PR during fixup
 * discovery and remains stable after the local branch is reset to fresh base.
 */
fn fixup_prepare_commits(cfg: ReleaseFixupConfig) -> ReleaseFixupPrepareCommits {
  const publication = cfg.fixup_publication
  if publication == nil || trim(publication.head_oid ?? "") == "" {
    return {
      success: false,
      commits: [],
      stderr: "fixup state is missing its immutable release publication",
    }
  }
  const r = run_git(
    cfg,
    [
      "log",
      "--reverse",
      "--no-merges",
      "--format=%H",
      "origin/${cfg.base}..${publication.head_oid}",
    ],
  )
  if !r.success {
    return {success: false, commits: [], stderr: r.stderr ?? ""}
  }
  let commits = []
  for line in split(r.stdout ?? "", "\n") {
    const sha = trim(line)
    if sha != "" {
      commits = commits + [sha]
    }
  }
  return {success: true, commits: commits, stderr: ""}
}

fn fixup_cherry_pick_argv(commits: list<string>) -> list<string> {
  return ["git", "cherry-pick", "--no-commit", "--strategy-option=ours"] + commits
}

/**
 * Reconcile the fresh base through Harn's canonical version-preparation owner
 * before replaying an older immutable release attempt.
 *
 * The old prepare commit cannot know about workspace crates or sibling
 * dependencies added after its pin. Letting `-X ours` resolve those hunks
 * without this pass can leave a mixed release where the workspace says the
 * shipped version but a new dependency still pins the previous one.
 */
fn release_fixup_reconcile_command(
  cfg: ReleaseFixupConfig,
  current_version: string,
  expected_version: string,
) -> string {
  const current_version_line = shell_quote("version = \"${current_version}\"")
  const version_line = shell_quote("version = \"${expected_version}\"")
  return "grep -Fqx ${current_version_line} Cargo.toml && "
    + release_prepare_env(
    cfg.repo,
    cfg.bootstrap_new_crates,
    cfg.release_cargo_target_dir,
  )
    + " ./scripts/release_gate.sh prepare --bump ${shell_quote(cfg.bump)} --allow-dirty"
    + " && grep -Fqx ${version_line} Cargo.toml"
    + " && git add -u"
}

/**
 * Replay the original release branch's prepare commits after the fresh-base
 * metadata reconciliation has been staged. `--strategy-option=ours` keeps
 * that current content for conflicting hunks (most commonly CHANGELOG.md,
 * where `<base>` drift collides with the old `## Unreleased` → `## v$ver`
 * rewrite). The follow-up `git checkout HEAD -- CHANGELOG.md` step in
 * `execute_prepare` neutralizes non-conflicting CHANGELOG hunks too, so the
 * smart-subtract writer remains authoritative. `--no-commit` lets the
 * downstream release commit capture the reconciled metadata and replayed
 * fragment deletions together.
 */
fn fixup_prepare_commits_failure_step(cfg, probe) {
  if !probe.success {
    return recorded_step(
      "fixup-list-prepare-commits",
      "git log --reverse --no-merges origin/${cfg.base}..${cfg.fixup_publication?.head_oid ?? "(missing)"}",
      command_result_fail(
        2,
        "could not enumerate prepare commits to cherry-pick:\n${trim(probe.stderr ?? "")}",
      ),
    )
  }
  if len(probe.commits) == 0 {
    return recorded_step(
      "fixup-list-prepare-commits",
      "git log --reverse --no-merges origin/${cfg.base}..${cfg.fixup_publication.head_oid}",
      command_result_fail(
        2,
        "no non-merge commits in immutable release attempt ${cfg.fixup_publication.remote_ref} to cherry-pick",
      ),
    )
  }
  return nil
}

fn execute_fixup_cherry_pick_commits(
  harness: Harness,
  cfg: ReleaseFixupConfig,
  commits: list<string>,
  steps: list<dict>,
  run_id: string,
) -> list<dict> {
  const cherry_argv = fixup_cherry_pick_argv(commits)
  release_log_event(
    harness,
    run_id,
    "step_started",
    {
      step: "fixup-cherry-pick-prepare-commits",
      command: argv_label(cherry_argv),
      commit_count: len(commits),
    },
  )
  const result = append_command_step(
    harness,
    cfg,
    steps,
    "fixup-cherry-pick-prepare-commits",
    cherry_argv,
  )
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {
      step: "fixup-cherry-pick-prepare-commits",
      success: result.success,
      status: result.status,
      exit_code: result.exit_code,
      commit_count: len(commits),
    },
  )
  if result.success {
    return result.steps
  }
  // Failure leaves CHERRY_PICK_HEAD set, which would block the next run.
  // Abort defensively; `|| true` keeps the cleanup itself from masking
  // the original failure when there is nothing to abort.
  const abort = append_command_step(
    harness,
    cfg,
    result.steps,
    "fixup-cherry-pick-abort",
    "git cherry-pick --abort 2>/dev/null || true",
  )
  return abort.steps
}

/** Reconcile fresh-base release metadata, then replay the immutable prepare commit. */
pub fn execute_fixup_reconciliation(
  harness: Harness,
  cfg: ReleaseFixupConfig,
  analysis: ReleaseVersionPair,
  steps: list<dict>,
  run_id: string,
) -> list<dict> {
  // Prove the immutable replay input before the canonical prepare mutates the
  // fresh checkout. A missing or empty attempt must leave the branch clean.
  const probe = fixup_prepare_commits(cfg)
  const failure = fixup_prepare_commits_failure_step(cfg, probe)
  if failure != nil {
    return steps + [failure]
  }
  const command = release_fixup_reconcile_command(
    cfg,
    analysis.current_version,
    analysis.next_version,
  )
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: "fixup-reconcile-fresh-base-release-metadata", command: command},
  )
  const reconciled = append_command_step(
    harness,
    cfg,
    steps,
    "fixup-reconcile-fresh-base-release-metadata",
    command,
  )
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {
      step: "fixup-reconcile-fresh-base-release-metadata",
      success: reconciled.success,
      status: reconciled.status,
    },
  )
  if !reconciled.success {
    return reconciled.steps
  }
  return execute_fixup_cherry_pick_commits(harness, cfg, probe.commits, reconciled.steps, run_id)
}

fn release_adds_workspace_crate(analysis: ReleaseAnalysis) -> bool {
  const changes = analysis.commit_file_changes_since_latest_tag
  return contains(changes, "A\tcrates/") && contains(changes, "/Cargo.toml")
}

pub fn with_derived_release_options(
  cfg: ReleaseConfig,
  analysis: ReleaseAnalysis,
) -> ReleaseConfig {
  if cfg.bootstrap_new_crates {
    return cfg
  }
  if release_adds_workspace_crate(analysis) {
    let out = cfg
    out["bootstrap_new_crates"] = true
    return out
  }
  return cfg
}
