} from "release_runtime"

// Stand-in digest for mock runs, which never build a real binary to hash.
const MOCK_BINARY_SHA256 = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

pub type ReleasePrepareAuditConfig = {
  mock: bool,
  local_audit: bool,
  pin_sha: string,
  repo: string,
  base: string,
  release_cargo_target_dir: string,
  bootstrap_new_crates: bool,
  bump: BumpKind,
  preid?: string,
  mock_pin_warm_fail?: bool,
  // Identifies one release run to the exact-pin warm, so the build-script
  // OUT_DIR refresh happens on this run's first warm and not on every warm.
  // Empty keeps the unconditional refresh.
  warm_refresh_token?: string,
}

pub type ReleasePrepareAuditEvidence = {steps: list<dict>, receipt_path: string, harn_bin: string}

pub type ReleasePrepareWarmEvidence = {steps: list<dict>, harn_bin: string}

pub type ReleasePrepareAuditPlan = {
  steps: list<dict>,
  receipt_path: string,
  harn_bin: string,
  command: string,
  run_id: string,
}

pub type ReleaseFixupConfig = {
  mock: bool,
  pin_sha: string,
  repo: string,
  base: string,
  bump: BumpKind,
  preid?: string,
  bootstrap_new_crates: bool,
  release_cargo_target_dir: string,
  fixup_publication: ReleasePublication?,
  quiet?: bool,
}

pub type ReleaseVersionPair = {current_version: string, next_version: string}

pub type ReleaseFixupPrepareCommits = {success: bool, commits: list<string>, stderr: string}

pub type ReleaseFixupConflictAction = "not_needed" | "resolved" | "fail"

pub type ReleaseFixupConflictResolution = {
  success: bool,
  action: ReleaseFixupConflictAction,
  paths: list<string>,
  reason: string,
}

pub type ReleaseFixupBinaryRequest = {config: ReleasePrepareAuditConfig, steps: list<dict>}

/**
 * `Harness` is a positional parameter rather than a `ReleaseFixupBinaryRequest`
 * field. A capability carried inside a data record is invisible in the
 * resolver's type, and it is the shape `harn fix --capability-migrations-only`
 * rewrites — see burin-labs/harn#6138, where it rewrote the default resolver's
 * signature and left this alias behind, producing a tree that did not compile.
 */
pub type ReleaseFixupBinaryFn = fn(Harness, ReleaseFixupBinaryRequest) -> ReleasePrepareWarmEvidence

fn prepare_command(
  cfg: ReleasePrepareAuditConfig,
  audit_evidence: ReleasePrepareAuditEvidence? = nil,
) -> string {
  // Keep the bootstrap Harn used to run this harness out of the target repo's
  // release gate. release_gate.sh intentionally exports HARN_BIN to its Harn
  // audit lanes, but it must resolve that binary from the release worktree.
  //
  // Also override any inherited CARGO_TARGET_DIR. Release sessions are often
  // launched from agent shells that carry repo-specific Cargo target dirs; using
  // one of those here can block Harn package/audit steps behind unrelated builds.
  //
  const receipt_path = trim(audit_evidence?.receipt_path ?? "")
  const harn_bin = trim(audit_evidence?.harn_bin ?? "")
  if receipt_path == "" != (harn_bin == "") {
    throw "release audit receipt and warmed HARN_BIN must be supplied together"
  }
  if receipt_path == "" {
    return "echo 'error: hosted platform certification receipt is required before release preparation' >&2; exit 1"
  }
  // Past this guard a receipt is always present, so the pre-receipt cache-prune
  // prefix and the `if reuse` conditionals below were unreachable: `reuse` could
  // only ever be true here.
  const env = release_prepare_env(cfg.repo, cfg.bootstrap_new_crates, cfg.release_cargo_target_dir)
    + " HARN_BIN="
    + shell_quote(harn_bin)
  let args = " ./scripts/release_ship.sh --prepare --bump ${cfg.bump}"
  if trim(cfg.preid ?? "") != "" {
    args = args + " --preid " + shell_quote(cfg.preid ?? "")
  }
  args = args + " --audit-receipt " + shell_quote(receipt_path)
  return env + args
}

fn materialize_candidate_command(cfg: ReleasePrepareAuditConfig, harn_bin: string) -> string {
  const binary = trim(harn_bin)
  if binary == "" {
    return "echo 'error: exact-source Harn CLI is required before candidate materialization' >&2; exit 1"
  }
  return release_prepare_env(cfg.repo, cfg.bootstrap_new_crates, cfg.release_cargo_target_dir)
    + " HARN_BIN="
    + shell_quote(binary)
    + " ./scripts/release_ship.sh --prepare --materialize-candidate --bump "
    + shell_quote(cfg.bump)
    + if trim(cfg.preid ?? "") == "" {
      ""
    } else {
      " --preid " + shell_quote(cfg.preid ?? "")
    }
}

pub fn release_candidate_residual_audit_command(
  cfg: ReleasePrepareAuditConfig,
  evidence: ReleasePrepareAuditEvidence,
) -> string {
  const receipt_path = trim(evidence.receipt_path)
  const harn_bin = trim(evidence.harn_bin)
  if receipt_path == "" || harn_bin == "" {
    return "echo 'error: closed candidate certification evidence is required' >&2; exit 1"
  }
  return release_prepare_env(cfg.repo, cfg.bootstrap_new_crates, cfg.release_cargo_target_dir)
    + " HARN_BIN="
    + shell_quote(harn_bin)
    + " ./scripts/release_gate.sh audit --receipt "
    + shell_quote(receipt_path)
}

fn platform_certification_receipt_artifact_path(fs: HarnessFs, run_id: string) -> string {
  return path_join(release_run_dir(fs, run_id), "platform-certification-receipt.json")
}

fn platform_certification_receipt_workspace_path(
  cfg: ReleasePrepareAuditConfig,
  run_id: string,
) -> string {
  return path_join(cfg.repo, ".harn", "release-audit-receipts", "${run_id}.json")
}

fn write_platform_certification_receipt(fs: HarnessFs, path: string, receipt: dict) -> string {
  fs.mkdir(dirname(path), true)
  fs.write_text(path, json_stringify(receipt) + "\n")
  return path
}

fn persist_platform_certification_receipt(
  fs: HarnessFs,
  cfg: ReleasePrepareAuditConfig,
  run_id: string,
  receipt: dict,
) -> {artifact_path: string, receipt_path: string} {
  const artifact_path = write_platform_certification_receipt(
    fs,
    platform_certification_receipt_artifact_path(fs, run_id),
    receipt,
  )
  const receipt_path = write_platform_certification_receipt(
    fs,
    platform_certification_receipt_workspace_path(cfg, run_id),
    receipt,
  )
  return {artifact_path: artifact_path, receipt_path: receipt_path}
}

fn exact_pin_harn_binary(fs: HarnessFs, cfg: ReleasePrepareAuditConfig) -> string? {
  const plain = path_join(cfg.release_cargo_target_dir, "debug", "harn")
  if cfg.mock || fs.exists(plain) {
    return plain
  }
  const windows = plain + ".exe"
  if fs.exists(windows) {
    return windows
  }
  return nil
}

/**
 * Digest the exact-pin binary that hosted platform certification will verify.
 *
 * Named and exported so the live branch is reachable from a test. The digest
 * is only computed on a real prepare — a mock run returns a fixed stand-in —
 * so without a direct test this expression executes for the first time during
 * a live release, which is how an undeclared capability access on `Harness`
 * survived static verification and failed the v0.10.53 certification lane.
 */
pub fn exact_pin_binary_digest(fs: HarnessFs, mock: bool, harn_bin: string) -> string {
  if mock {
    return MOCK_BINARY_SHA256
  }
  return sha256(fs.read_bytes(harn_bin))
}

fn resolve_warmed_harn_evidence(
  harness: Harness,
  cfg: ReleasePrepareAuditConfig,
  steps: list<dict>,
) -> ReleasePrepareWarmEvidence {
  let resolved_steps = steps
  const warm_command = release_pin_cli_warm_command(
    cfg.repo,
    cfg.pin_sha,
    cfg.bootstrap_new_crates,
    cfg.release_cargo_target_dir,
    trim(cfg.warm_refresh_token ?? ""),
  )
  const warmed = append_command_step(
    harness,
    cfg,
    [],
    "warm-exact-pin-harn-cli",
    warm_command,
    {timeout_ms: RELEASE_PIN_CLI_WARM_TIMEOUT_MS},
  )
  resolved_steps = resolved_steps
    + [{...warmed.step, pin_sha: cfg.pin_sha, cargo_target_dir: cfg.release_cargo_target_dir}]
  if !warmed.success {
    return {steps: resolved_steps, harn_bin: ""}
  }
  const harn_bin = exact_pin_harn_binary(harness.fs, cfg)
  if harn_bin == nil {
    return {
      steps: resolved_steps
        + [
          recorded_step(
            "resolve-exact-pin-harn-cli",
            "resolve exact-pin Harn CLI",
            command_result_fail(2, "exact-pin Harn CLI binary was not produced"),
          ),
        ],
      harn_bin: "",
    }
  }
  if cfg.mock {
    return {steps: resolved_steps, harn_bin: harn_bin}
  }
  // Never hand out the path Cargo rewrites in place: a concurrent build there
  // AMFI-kills every process already executing it.
  const staged = release_shielded_harn_bin(cfg.release_cargo_target_dir, cfg.pin_sha)
  const shield_command = release_shield_harn_binary_command(harn_bin, staged)
  const shielded = run_cmd({env: harness.env, process: harness.process}, cfg, shield_command)
  resolved_steps = resolved_steps
    + [
      {
        ...recorded_step("shield-exact-pin-harn-cli", shield_command, shielded),
        pin_sha: cfg.pin_sha,
        shielded_harn_bin: staged,
      },
    ]
  if !shielded.success || !harness.fs.exists(staged) {
    return {steps: resolved_steps, harn_bin: ""}
  }
  return {steps: resolved_steps, harn_bin: staged}
}

fn resolve_fixup_harn_binary(
  harness: Harness,
  request: ReleaseFixupBinaryRequest,
) -> ReleasePrepareWarmEvidence {
  return resolve_warmed_harn_evidence(harness, request.config, request.steps)
}

/** Build and persist the mandatory exact-pin hosted platform certification. */
fn resolve_prepare_audit_evidence(
  harness: Harness,
  cfg: ReleasePrepareAuditConfig,
  steps: list<dict>,
  run_id: string,
  dispatch_registry: PlatformCertificationDispatchRegistry? = nil,
  outer_abort: LaneAbortProbe? = nil,
) -> ReleasePrepareAuditEvidence {
  let resolved_steps = steps
  if cfg.local_audit {
    return {
      steps: steps
        + [
          recorded_step(
            "hosted-platform-certification",
            "reject local-only release preparation",
            command_result_fail(
              2,
              "hosted Windows and macOS certification is mandatory for release preparation",
            ),
          ),
        ],
      receipt_path: "",
      harn_bin: "",
    }
  }
  // workflow_dispatch cannot target a bare SHA, and dispatching on cfg.base
  // races merges between pin capture and run creation. Publish a write-once
  // OID-qualified branch at the pin first. Hosted acquisition starts from that
  // immutable identity before the local exact-pin CLI warm, removing the warm
  // from the hosted critical path without weakening receipt closure.
  const ensured = ensure_platform_certification_branch(
    harness.process,
    cfg.repo,
    cfg.pin_sha,
    cfg.mock,
  )
  resolved_steps = resolved_steps
    + [
      {
        ...recorded_step(
          "ensure-platform-certification-branch",
          "publish write-once release-certify/<pin> for hosted dispatch",
          if ensured.success {
            command_result_ok(ensured.reason + "\n")
          } else {
            command_result_fail(2, ensured.reason)
          },
        ),
        certification_branch: ensured.branch,
        certification_branch_action: ensured.action,
        pin_sha: cfg.pin_sha,
      },
    ]
  if !ensured.success {
    return {steps: resolved_steps, receipt_path: "", harn_bin: ""}
  }
  const acquisition_cfg: PlatformCertificationConfig = {
    repo: "burin-labs/harn",
    branch: ensured.branch,
    pin_sha: cfg.pin_sha,
    workspace: cfg.repo,
    harn_bin: "",
  }
  const certification_adapter = if cfg.mock {
    mock_platform_certification_adapter(acquisition_cfg)
  } else {
    nil
  }
  const session = begin_platform_certification(
    harness,
    acquisition_cfg,
    certification_adapter,
    dispatch_registry,
  )
  resolved_steps = resolved_steps
    + [
      {
        ...recorded_step(
          "start-hosted-platform-certification",
          "acquire exact Windows and macOS runs before local warm",
          if session.success {
            command_result_ok(session.reason + "\n")
          } else {
            command_result_fail(2, session.reason)
          },
        ),
        platform_dispatches: session.dispatches,
        cancellations: session.cancellations,
        pin_sha: cfg.pin_sha,
      },
    ]
  if !session.success {
    return {steps: resolved_steps, receipt_path: "", harn_bin: ""}
  }
  const warm = resolve_warmed_harn_evidence(
    harness,
    cfg + {warm_refresh_token: run_id},
    resolved_steps,
  )
  resolved_steps = warm.steps
  const harn_bin = warm.harn_bin
  if harn_bin == "" {
    const cancellations = cancel_platform_certification_session(
      harness,
      acquisition_cfg,
      session,
      certification_adapter,
    )
    return {
      steps: resolved_steps
        + [
          {
            ...recorded_step(
              "cancel-hosted-platform-certification",
              "cancel hosted runs after exact-pin warm failure",
              command_result_ok("cancelled or attempted every acquired hosted run\n"),
            ),
            cancellations: cancellations,
          },
        ],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const binary_sha256 = exact_pin_binary_digest(harness.fs, cfg.mock, harn_bin)
  const certification_cfg: PlatformCertificationConfig = {
    repo: acquisition_cfg.repo,
    branch: acquisition_cfg.branch,
    pin_sha: acquisition_cfg.pin_sha,
    workspace: acquisition_cfg.workspace,
    harn_bin: harn_bin,
  }
  const decision = finish_platform_certification(
    harness,
    certification_cfg,
    binary_sha256,
    session,
    certification_adapter,
    dispatch_registry,
    outer_abort,
  )
  if !decision.success || decision.receipt == nil {
    return {
      steps: resolved_steps
        + [
          {
            ...recorded_step(
              "hosted-platform-certification",
              "certify exact Windows, macOS, and local source lanes",
              command_result_fail(2, decision.reason),
            ),
            cancellations: decision.cancellations,
          },
        ],
      receipt_path: "",
      harn_bin: "",
    }
  }
  const persisted = persist_platform_certification_receipt(
    harness.fs,
    cfg,
    run_id,
    decision.receipt,
  )
  const receipt_step = {
    ...recorded_step(
      "hosted-platform-certification",
      "certify exact Windows, macOS, and local source lanes",
      command_result_ok(decision.reason + "\nreceipt: ${persisted.receipt_path}\n"),
    ),
    audit_source: "hosted-platform",
    receipt_reused: true,
    platform_certification_receipt_path: persisted.receipt_path,
    platform_certification_receipt_artifact_path: persisted.artifact_path,
    platform_certification_receipt: decision.receipt,
  }
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "hosted_platform_certification",
    {success: true, receipt_path: persisted.receipt_path, receipt: decision.receipt},
  )
  return {
    steps: resolved_steps + [receipt_step],
    receipt_path: persisted.receipt_path,
    harn_bin: harn_bin,
  }
}

pub fn release_candidate_materialization_plan(
  harness: Harness,
  cfg: ReleasePrepareAuditConfig,
  steps: list<dict> = [],
  run_id: string? = nil,
) -> ReleasePrepareAuditPlan {
  const id = run_id ?? harness.random.uuid_v7()
  const warm = resolve_warmed_harn_evidence(harness, cfg + {warm_refresh_token: id}, steps)
  return {
    steps: warm.steps,
    receipt_path: "",
    harn_bin: warm.harn_bin,
    command: materialize_candidate_command(cfg, warm.harn_bin),
    run_id: id,
  }
}

pub fn release_candidate_audit_evidence(
  harness: Harness,
  cfg: ReleasePrepareAuditConfig,
  publication: ReleasePublication,
  run_id: string,
  dispatch_registry: PlatformCertificationDispatchRegistry? = nil,
  outer_abort: LaneAbortProbe? = nil,
) -> ReleasePrepareAuditEvidence {
  const candidate_cfg: ReleasePrepareAuditConfig = {
    mock: cfg.mock,
    local_audit: cfg.local_audit,
    pin_sha: publication.head_oid,
    repo: cfg.repo,
    base: cfg.base,
    release_cargo_target_dir: cfg.release_cargo_target_dir,
    bootstrap_new_crates: cfg.bootstrap_new_crates,
    bump: cfg.bump,
    preid: cfg.preid ?? "",
  }
  return resolve_prepare_audit_evidence(
    harness,
    candidate_cfg,
    [],
    run_id,
    dispatch_registry,
    outer_abort,
  )
}

/** Resolve reusable audit evidence and the exact prepare command from one typed plan. */
pub fn release_prepare_audit_plan(
  harness: Harness,
  cfg: ReleasePrepareAuditConfig,
  steps: list<dict> = [],
  run_id: string? = nil,
) -> ReleasePrepareAuditPlan {
  const id = run_id ?? harness.random.uuid_v7()
  const evidence = resolve_prepare_audit_evidence(harness, cfg, steps, id)
  return {
    steps: evidence.steps,
    receipt_path: evidence.receipt_path,
    harn_bin: evidence.harn_bin,
    command: prepare_command(cfg, evidence),
    run_id: id,
  }
}

/**
 * Enumerate non-merge prepare commits in the immutable release attempt
 * — the commits we want to cherry-pick onto fresh `<base>` during a
 * fixup pass instead of re-running `./scripts/release_ship.sh --prepare`.
 *
 * Skips merges so the `Tie release/v$ver to shipped tag (ours)` merge
 * commit that a prior fixup may have laid down does not get replayed
 * (it has no tree delta and `release_ship_prepare` rebuilds it later if
 * needed). The source OID was validated against the attempt PR during fixup
 * discovery and remains stable after the local branch is reset to fresh base.
 */
fn fixup_prepare_commits(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseFixupConfig,
) -> ReleaseFixupPrepareCommits {
  const publication = cfg.fixup_publication
  if publication == nil || trim(publication.head_oid ?? "") == "" {
    return {
      success: false,
      commits: [],
      stderr: "fixup state is missing its immutable release publication",
    }
  }
  const r = run_git(
    harness,
    cfg,
    [
      "log",
      "--reverse",
      "--no-merges",
      "--format=%H",
      "origin/${cfg.base}..${publication.head_oid}",
    ],
  )
  if !r.success {
    return {success: false, commits: [], stderr: r.stderr ?? ""}
  }
  let commits = []
  for line in split(r.stdout ?? "", "\n") {
    const sha = trim(line)
    if sha != "" {
      commits = commits + [sha]
    }
  }
  return {success: true, commits: commits, stderr: ""}
}

fn fixup_cherry_pick_argv(commits: list<string>) -> list<string> {
  return ["git", "cherry-pick", "--no-commit", "--strategy-option=ours"] + commits
}

fn safe_release_fragment_path(path: string) -> bool {
  if !starts_with(path, "changelog.d/") || contains(path, "\0") {
    return false
  }
  for component in split(path, "/") {
    if component == "" || component == "." || component == ".." {
      return false
    }
  }
  return true
}

/** True only for an ours-side modification and incoming deletion of a release fragment. */
pub fn release_fixup_fragment_delete_conflict_allowed(path: string, stages: list<string>) -> bool {
  return safe_release_fragment_path(path) && stages == ["1", "2"]
}

fn unmerged_release_fragment_paths(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseFixupConfig,
) -> ReleaseFixupConflictResolution {
  const unmerged = run_git(harness, cfg, ["diff", "--name-only", "--diff-filter=U", "-z"])
  if !unmerged.success {
    return {success: false, action: "fail", paths: [], reason: "could not inspect conflicts"}
  }
  const paths = split(unmerged.stdout ?? "", "\0").filter({ path -> path != "" }).to_list()
  if len(paths) == 0 {
    return {
      success: false,
      action: "fail",
      paths: [],
      reason: "cherry-pick failed without an unmerged path",
    }
  }
  for path in paths {
    if !safe_release_fragment_path(path) {
      return {
        success: false,
        action: "fail",
        paths: paths,
        reason: "refusing non-fragment or unsafe conflict path: ${path}",
      }
    }
    const entries = run_git(harness, cfg, ["ls-files", "-u", "-z", "--", path])
    if !entries.success {
      return {
        success: false,
        action: "fail",
        paths: paths,
        reason: "could not inspect conflict stages for ${path}",
      }
    }
    let stages: list<string> = []
    for entry in split(entries.stdout ?? "", "\0").filter({ row -> row != "" }) {
      const columns = split(entry, "\t")
      const metadata = split(columns[0] ?? "", " ")
      if len(columns) != 2 || columns[1] != path || len(metadata) != 3 {
        return {
          success: false,
          action: "fail",
          paths: paths,
          reason: "malformed conflict stage for ${path}",
        }
      }
      stages = stages + [metadata[2] ?? ""]
    }
    if !release_fixup_fragment_delete_conflict_allowed(path, stages) {
      return {
        success: false,
        action: "fail",
        paths: paths,
        reason: "${path} is not an exact incoming-deletion conflict (stages=${stages})",
      }
    }
  }
  return {
    success: true,
    action: "resolved",
    paths: paths,
    reason: "accepted immutable release deletions for ${len(paths)} shipped fragment conflict(s)",
  }
}

fn resolve_release_fragment_delete_conflicts(
  git_tools: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseFixupConfig,
) -> ReleaseFixupConflictResolution {
  const probe = unmerged_release_fragment_paths(git_tools, cfg)
  if !probe.success {
    return probe
  }
  for path in probe.paths {
    const removed = run_git(git_tools, cfg, ["rm", "--", path])
    if !removed.success {
      return {
        success: false,
        action: "fail",
        paths: probe.paths,
        reason: "could not stage deletion: ${path}",
      }
    }
  }
  const residual = run_git(git_tools, cfg, ["diff", "--name-only", "--diff-filter=U", "-z"])
  if !residual.success || trim(replace(residual.stdout ?? "", "\0", "")) != "" {
    return {success: false, action: "fail", paths: probe.paths, reason: "unmerged paths remain"}
  }
  const quit = run_git(git_tools, cfg, ["cherry-pick", "--quit"])
  if !quit.success {
    return {
      success: false,
      action: "fail",
      paths: probe.paths,
      reason: "could not finalize no-commit replay",
    }
  }
  return probe
}

/**
 * Reconcile the fresh base through Harn's canonical version-preparation owner
 * before replaying an older immutable release attempt.
 *
 * The old prepare commit cannot know about workspace crates or sibling
 * dependencies added after its pin. Letting `-X ours` resolve those hunks
 * without this pass can leave a mixed release where the workspace says the
 * shipped version but a new dependency still pins the previous one.
 */
fn release_fixup_reconcile_command(
  cfg: ReleaseFixupConfig,
  current_version: string,
  expected_version: string,
  harn_bin: string,
) -> string {
  const current_version_line = shell_quote("version = \"${current_version}\"")
  const version_line = shell_quote("version = \"${expected_version}\"")
  return "grep -Fqx ${current_version_line} Cargo.toml && "
    + release_prepare_env(cfg.repo, cfg.bootstrap_new_crates, cfg.release_cargo_target_dir)
    + " HARN_BIN="
    + shell_quote(harn_bin)
    + " HARN_RELEASE_METADATA_BIN="
    + shell_quote(harn_bin)
    + " ./scripts/release_gate.sh prepare --bump ${shell_quote(cfg.bump)} --allow-dirty"
    + if trim(cfg.preid ?? "")
      == "" {
      ""
    } else {
      " --preid " + shell_quote(cfg.preid ?? "")
    }
    + " && grep -Fqx ${version_line} Cargo.toml"
    + " && git add -u"
}

/**
 * Replay the original release branch's prepare commits after the fresh-base
 * metadata reconciliation has been staged. `--strategy-option=ours` keeps
 * that current content for conflicting hunks (most commonly CHANGELOG.md,
 * where `<base>` drift collides with the old `## Unreleased` → `## v$ver`
 * rewrite). The follow-up release-note reset in `execute_prepare` restores
 * the selected source: CHANGELOG.md alone for a frozen artifact, or both
 * CHANGELOG.md and changelog.d for a fresh candidate tree. `--no-commit` lets
 * the downstream release commit capture the reconciled metadata and the
 * policy-owned fragment state together.
 */
fn fixup_prepare_commits_failure_step(cfg: any, probe: dict) {
  if !probe.success {
    return recorded_step(
      "fixup-list-prepare-commits",
      "git log --reverse --no-merges origin/${cfg.base}..${cfg.fixup_publication?.head_oid ?? "(missing)"}",
      command_result_fail(
        2,
        "could not enumerate prepare commits to cherry-pick:\n${trim(probe.stderr ?? "")}",
      ),
    )
  }
  if len(probe.commits) == 0 {
    return recorded_step(
      "fixup-list-prepare-commits",
      "git log --reverse --no-merges origin/${cfg.base}..${cfg.fixup_publication.head_oid}",
      command_result_fail(
        2,
        "no non-merge commits in immutable release attempt ${cfg.fixup_publication.remote_ref} to cherry-pick",
      ),
    )
  }
  return nil
}

fn execute_fixup_cherry_pick_commits(
  harness: Harness,
  cfg: ReleaseFixupConfig,
  commits: list<string>,
  steps: list<dict>,
  run_id: string,
) -> list<dict> {
  const cherry_argv = fixup_cherry_pick_argv(commits)
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "step_started",
    {
      step: "fixup-cherry-pick-prepare-commits",
      command: argv_label(cherry_argv),
      commit_count: len(commits),
    },
  )
  const cherry = run_git({env: harness.env, process: harness.process}, cfg, cherry_argv)
  let reconciliation: ReleaseFixupConflictResolution = {
    success: true,
    action: "not_needed",
    paths: [],
    reason: "cherry-pick applied without conflicts",
  }
  if !cherry.success {
    reconciliation = resolve_release_fragment_delete_conflicts(
      {env: harness.env, process: harness.process},
      cfg,
    )
  }
  const final_result = if cherry.success || reconciliation.success {
    command_result_ok(reconciliation.reason)
  } else {
    command_result_fail(
      cherry.exit_code ?? 1,
      trim(cherry.stderr ?? "") + "\n" + reconciliation.reason,
    )
  }
  const result_steps = steps
    + [
      {
        ...recorded_step("fixup-cherry-pick-prepare-commits", cherry_argv, final_result),
        reconciliation: reconciliation,
      },
    ]
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "step_finished",
    {
      step: "fixup-cherry-pick-prepare-commits",
      success: final_result.success,
      status: final_result.status,
      exit_code: final_result.exit_code,
      commit_count: len(commits),
      reconciliation: reconciliation,
    },
  )
  if final_result.success {
    return result_steps
  }
  // Failure leaves CHERRY_PICK_HEAD set, which would block the next run.
  // Abort defensively; `|| true` keeps the cleanup itself from masking
  // the original failure when there is nothing to abort.
  const abort = append_command_step(
    harness,
    cfg,
    result_steps,
    "fixup-cherry-pick-abort",
    "git cherry-pick --abort 2>/dev/null || true",
  )
  return abort.steps
}

/** Reconcile fresh-base release metadata, then replay the immutable prepare commit. */
pub fn execute_fixup_reconciliation(
  harness: Harness,
  cfg: ReleaseFixupConfig,
  analysis: ReleaseVersionPair,
  steps: list<dict>,
  run_id: string,
  binary_resolver: ReleaseFixupBinaryFn = resolve_fixup_harn_binary,
) -> list<dict> {
  // Prove the immutable replay input before the canonical prepare mutates the
  // fresh checkout. A missing or empty attempt must leave the branch clean.
  const probe = fixup_prepare_commits({env: harness.env, process: harness.process}, cfg)
  const failure = fixup_prepare_commits_failure_step(cfg, probe)
  if failure != nil {
    return steps + [failure]
  }
  const warm_cfg: ReleasePrepareAuditConfig = {
    mock: cfg.mock,
    local_audit: true,
    pin_sha: cfg.pin_sha,
    repo: cfg.repo,
    base: cfg.base,
    release_cargo_target_dir: cfg.release_cargo_target_dir,
    bootstrap_new_crates: cfg.bootstrap_new_crates,
    bump: cfg.bump,
    preid: cfg.preid ?? "",
    warm_refresh_token: run_id,
  }
  const warm = binary_resolver(harness, {config: warm_cfg, steps: steps})
  if trim(warm.harn_bin) == "" {
    return warm.steps
  }
  const command = release_fixup_reconcile_command(
    cfg,
    analysis.current_version,
    analysis.next_version,
    warm.harn_bin,
  )
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "step_started",
    {step: "fixup-reconcile-fresh-base-release-metadata", command: command},
  )
  const reconciled = append_command_step(
    harness,
    cfg,
    warm.steps,
    "fixup-reconcile-fresh-base-release-metadata",
    command,
  )
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "step_finished",
    {
      step: "fixup-reconcile-fresh-base-release-metadata",
      success: reconciled.success,
      status: reconciled.status,
    },
  )
  if !reconciled.success {
    return reconciled.steps
  }
  return execute_fixup_cherry_pick_commits(harness, cfg, probe.commits, reconciled.steps, run_id)
}

fn release_adds_workspace_crate(analysis: ReleaseAnalysis) -> bool {
  const changes = analysis.commit_file_changes_since_latest_tag
  return contains(changes, "A\tcrates/") && contains(changes, "/Cargo.toml")
}

pub fn with_derived_release_options(
  cfg: ReleaseConfig,
  analysis: ReleaseAnalysis,
) -> ReleaseConfig {
  if cfg.bootstrap_new_crates {
    return cfg
  }
  if release_adds_workspace_crate(analysis) {
    let out = cfg
    out["bootstrap_new_crates"] = true
    return out
  }
  return cfg
}
