  run_git,
} from "release_runtime"

fn prepare_command(cfg, audit_evidence = nil) {
  // Keep the bootstrap Harn used to run this harness out of the target repo's
  // release gate. release_gate.sh intentionally exports HARN_BIN to its Harn
  // audit lanes, but it must resolve that binary from the release worktree.
  //
  // Also override any inherited CARGO_TARGET_DIR. Release sessions are often
  // launched from agent shells that carry repo-specific Cargo target dirs; using
  // one of those here can block Harn package/audit steps behind unrelated builds.
  //
  const receipt_path = trim(audit_evidence?.receipt_path ?? "")
  const harn_bin = trim(audit_evidence?.harn_bin ?? "")
  if receipt_path == "" != (harn_bin == "") {
    throw "release audit receipt and warmed HARN_BIN must be supplied together"
  }
  const reuse = receipt_path != ""
  const prefix = if reuse {
    ""
  } else {
    release_cargo_cache_prune_command(cfg.release_cargo_target_dir) + " && "
  }
  let env = release_prepare_env(cfg.repo, cfg.bootstrap_new_crates, cfg.release_cargo_target_dir)
  let args = " ./scripts/release_ship.sh --prepare --bump ${cfg.bump}"
  if reuse {
    env = env + " HARN_BIN=" + shell_quote(harn_bin)
    args = args + " --audit-receipt " + shell_quote(receipt_path)
  }
  return prefix + env + args
}

