import { GitRemoteRef } from "std/git"

/** Strip an optional leading `v` from a version string. */
pub fn strip_v(version) {
  if version != nil && starts_with(version, "v") {
    return version[1:len(version)]
  }
  return version
}

/** Return true for canonical release tags like `v1.2.3`. */
pub fn is_v_semver(value) {
  return regex_match("^v[0-9]+\\.[0-9]+\\.[0-9]+$", value ?? "") != nil
}

/**
 * Return the first canonical release tag from `git tag --sort=-v:refname`
 * output. The caller owns version sorting; this helper only rejects
 * non-release tags that match Git's broad glob.
 */
pub fn latest_semver_tag_from_git_tag_list(stdout) {
  for line in (stdout ?? "").split("\n") {
    let tag = trim(line)
    if is_v_semver(tag) {
      return tag
    }
  }
  return ""
}

fn semver_parts(tag) {
  let version = strip_v(tag)
  let parts = version.split(".")
  if len(parts) != 3 {
    return nil
  }
  return {major: to_int(parts[0]), minor: to_int(parts[1]), patch: to_int(parts[2])}
}

fn semver_gt(left, right) {
  if right == nil {
    return true
  }
  if left.major != right.major {
    return left.major > right.major
  }
  if left.minor != right.minor {
    return left.minor > right.minor
  }
  return left.patch > right.patch
}

fn tag_from_ref(ref) {
  let parts = split(trim(ref ?? ""), "/")
  if len(parts) == 0 {
    return ""
  }
  return trim(parts[len(parts) - 1])
}

/**
 * Return the highest canonical release tag from typed remote refs. Remote ref
 * order is not part of the release contract.
 */
pub fn latest_semver_tag_from_remote_refs(refs: list<GitRemoteRef>) -> string {
  let best_tag = ""
  let best_parts = nil
  for remote_ref in refs {
    let tag = tag_from_ref(remote_ref.name)
    if !is_v_semver(tag) {
      continue
    }
    let parts = semver_parts(tag)
    if semver_gt(parts, best_parts) {
      best_tag = tag
      best_parts = parts
    }
  }
  return best_tag
}

/** Return the next semver version for a major, minor, or patch bump. */
pub fn next_semver(current, bump) {
  let p = current.split(".")
  if len(p) != 3 {
    throw "current version is not semver: ${current}"
  }
  let major = to_int(p[0])
  let minor = to_int(p[1])
  let patch = to_int(p[2])
  if bump == "major" {
    major = major + 1
    minor = 0
    patch = 0
  } else if bump == "minor" {
    minor = minor + 1
    patch = 0
  } else if bump == "patch" {
    patch = patch + 1
  } else {
    throw "bump must be major, minor, or patch"
  }
  return "${major}.${minor}.${patch}"
}

/** Extract `X.Y.Z` from a release branch named `release/vX.Y.Z`, or empty string. */
pub fn version_from_release_branch(branch) {
  if starts_with(branch ?? "", "release/v") {
    return branch[9:len(branch)]
  }
  return ""
}

/** Extract `X.Y.Z` from tag `vX.Y.Z`; non-v tags pass through unchanged. */
pub fn version_from_tag(tag) {
  return strip_v(tag)
}
