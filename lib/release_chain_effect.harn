import { ReleaseChainCause, ReleaseChainEffectKind, ReleaseChainStage } from "./release_chain_state"

/**
 * Phase-one effect boundary. It is deliberately data-only: no function in
 * this module can dispatch, tag, publish, promote, or repin anything.
 */
pub type ReleaseChainPlannedEffect = {
  schema_version: "harn.release-chain.planned-effect.v1",
  kind: ReleaseChainEffectKind,
  stage: ReleaseChainStage,
  cause: ReleaseChainCause,
  subject: string,
  attempt: int,
  max_attempts: int,
  idempotency_key: string,
  target: string,
}

pub fn release_chain_effect_key(
  chain_id: string,
  revision: int,
  stage: ReleaseChainStage,
  subject: string,
  attempt: int,
) -> string {
  if trim(chain_id) == "" || trim(subject) == "" || attempt < 1 || revision < 0 {
    throw "release chain effect identity is incomplete"
  }
  return "release-chain:"
    + sha256_hex(join([chain_id, to_string(revision), stage, subject, to_string(attempt)], "\n"))
}

pub fn release_chain_planned_effect(
  chain_id: string,
  revision: int,
  stage: ReleaseChainStage,
  cause: ReleaseChainCause,
  subject: string,
  attempt: int,
  max_attempts: int,
  kind: ReleaseChainEffectKind,
  target: string,
) -> ReleaseChainPlannedEffect {
  if max_attempts < 1 || attempt > max_attempts {
    throw "release chain effect attempt exceeds its bounded policy"
  }
  if trim(target) == "" {
    throw "release chain effect target must be non-empty"
  }
  return {
    schema_version: "harn.release-chain.planned-effect.v1",
    kind: kind,
    stage: stage,
    cause: cause,
    subject: subject,
    attempt: attempt,
    max_attempts: max_attempts,
    idempotency_key: release_chain_effect_key(chain_id, revision, stage, subject, attempt),
    target: target,
  }
}
