import { strip_v } from "std/semver"

/** Return true when a model summary is compact markdown bullets only. */
pub fn bump_summary_format_ok(text) {
  const cleaned = trim(text)
  if cleaned == "" || starts_with(cleaned, "(local LLM summary unavailable:") {
    return false
  }
  const lines = cleaned.split("\n").filter({ line -> trim(line) != "" })
  if len(lines) == 0 || len(lines) > 6 {
    return false
  }
  for line in lines {
    if !starts_with(trim(line), "- ") {
      return false
    }
  }
  return true
}

/** Return true when an outcome should make the fleet command exit non-zero. */
pub fn bump_summary_problem_outcome(o) {
  const status = o.status ?? ""
  return status == "error" || status == "dispatch_failed" || starts_with(status, "run_failure")
    || starts_with(status, "stale_")
    || contains(status, "schema_metadata_failed")
    || status == "run_success_no_target_change"
    || starts_with(o.auto_merge ?? "", "failed")
}

fn status_counts(outcomes) {
  let statuses = []
  for outcome in outcomes ?? [] {
    const status = outcome.status ?? "unknown"
    if !statuses.contains(status) {
      statuses = statuses + [status]
    }
  }
  let counts = []
  for status in statuses {
    counts = counts
      + [
      {
        status: status,
        count: len((outcomes ?? []).filter({ outcome -> (outcome.status ?? "unknown") == status })),
      },
    ]
  }
  return counts
}

fn duration_outliers(outcomes) {
  let shortest = 0
  let saw_duration = false
  for outcome in outcomes ?? [] {
    const duration = outcome.duration_ms ?? 0
    if duration <= 0 {
      continue
    }
    if !saw_duration {
      shortest = duration
      saw_duration = true
    } else if duration < shortest {
      shortest = duration
    }
  }
  if !saw_duration {
    return []
  }
  const relative_threshold = shortest * 10
  const threshold = if relative_threshold > 30000 {
    relative_threshold
  } else {
    30000
  }
  return (outcomes ?? []).filter({ outcome -> (outcome.duration_ms ?? 0) >= threshold }).map(
    { outcome -> {slug: outcome.slug ?? "?", duration_ms: outcome.duration_ms ?? 0} },
  )
}

fn outcome_labels(outcomes, limit) {
  let labels = []
  for outcome in outcomes ?? [] {
    if len(labels) >= limit {
      break
    }
    const slug = outcome.slug ?? "?"
    const status = outcome.status ?? "unknown"
    labels = labels + ["${slug}: ${status}"]
  }
  return labels
}

fn local_pin_mismatches(outcomes) {
  return (outcomes ?? []).filter(
    { outcome ->
      const local_pin = outcome.local_pin
      const remote_pin = outcome.remote_pin
      local_pin != nil && remote_pin != nil && strip_v(local_pin) != strip_v(remote_pin)
    },
  )
}

fn local_pin_mismatch_labels(outcomes, limit) {
  let labels = []
  for outcome in outcomes ?? [] {
    if len(labels) >= limit {
      break
    }
    const slug = outcome.slug ?? "?"
    const local_pin = strip_v(outcome.local_pin ?? "?")
    const remote_pin = strip_v(outcome.remote_pin ?? "?")
    labels = labels
      + ["${slug}: local ${local_pin}, remote ${remote_pin}"]
  }
  return labels
}

fn duration_labels(outliers, limit) {
  let labels = []
  for outcome in outliers ?? [] {
    if len(labels) >= limit {
      break
    }
    labels = labels + ["${outcome.slug}: ${outcome.duration_ms / 1000}s"]
  }
  return labels
}

fn status_counts_text(counts) {
  if len(counts ?? []) == 0 {
    return "none"
  }
  return join((counts ?? []).map({ row -> "${row.status}=${row.count}" }), ", ")
}

/** Build deterministic summary facts from repo outcomes. */
pub fn bump_summary_deterministic_facts(payload) {
  const outcomes = payload.outcomes ?? []
  const problems = outcomes.filter({ outcome -> bump_summary_problem_outcome(outcome) })
  const auto_merge_failures = outcomes.filter({ outcome -> starts_with(outcome.auto_merge ?? "", "failed") })
  const outliers = duration_outliers(outcomes)
  const local_mismatches = local_pin_mismatches(outcomes)
  return {
    repos_total: payload.repos_total ?? len(outcomes),
    repos_dispatched: payload.repos_dispatched ?? 0,
    status_counts: status_counts(outcomes),
    failure_count: len(problems),
    failures: problems.map(
      { outcome -> {slug: outcome.slug ?? "?", status: outcome.status ?? "unknown", detail: outcome.detail ?? ""} },
    ),
    auto_merge_failure_count: len(auto_merge_failures),
    auto_merge_failures: auto_merge_failures.map(
      { outcome -> {
        slug: outcome.slug ?? "?",
        status: outcome.status ?? "unknown",
        auto_merge: outcome.auto_merge ?? "",
      } },
    ),
    local_checkout_mismatch_count: len(local_mismatches),
    local_checkout_mismatches: local_mismatches.map(
      { outcome -> {
        slug: outcome.slug ?? "?",
        local_pin: strip_v(outcome.local_pin ?? ""),
        remote_pin: strip_v(outcome.remote_pin ?? ""),
      } },
    ),
    duration_outliers: outliers,
  }
}

/** Render deterministic fallback bullets from repo outcomes. */
pub fn bump_summary_deterministic_bullets(payload) {
  const facts = bump_summary_deterministic_facts(payload)
  if facts.failure_count == 0 && facts.auto_merge_failure_count == 0
    && facts.local_checkout_mismatch_count == 0
    && len(facts.duration_outliers) == 0 {
    return ["- nothing anomalous"]
  }
  let bullets = [
    "- status counts: ${status_counts_text(facts.status_counts)}",
    "- dispatched workflows: ${facts.repos_dispatched} of ${facts.repos_total} repos",
  ]
  if facts.failure_count > 0 {
    const failure_labels = join(outcome_labels(facts.failures, 4), "; ")
    bullets = bullets
      + ["- failures: ${facts.failure_count} repo(s): ${failure_labels}"]
  }
  if facts.auto_merge_failure_count > 0 {
    const auto_merge_labels = join(outcome_labels(facts.auto_merge_failures, 4), "; ")
    bullets = bullets
      + ["- auto-merge failures: ${facts.auto_merge_failure_count} repo(s): ${auto_merge_labels}"]
  }
  if facts.local_checkout_mismatch_count > 0 {
    const mismatch_labels = join(local_pin_mismatch_labels(facts.local_checkout_mismatches, 4), "; ")
    bullets = bullets
      + ["- local checkout drift: ${facts.local_checkout_mismatch_count} repo(s): ${mismatch_labels}"]
  }
  if len(facts.duration_outliers) > 0 {
    const outlier_labels = join(duration_labels(facts.duration_outliers, 4), "; ")
    bullets = bullets
      + ["- duration outliers: ${outlier_labels}"]
  }
  return bullets
}

/** Render deterministic fallback bullets as markdown text. */
pub fn bump_summary_deterministic_text(payload) {
  return join(bump_summary_deterministic_bullets(payload), "\n")
}

/** Select model-authored bullets when valid, otherwise deterministic fallback. */
pub fn bump_summary_result(payload, model_attempt_texts) {
  const deterministic_bullets = bump_summary_deterministic_bullets(payload)
  const deterministic_text = join(deterministic_bullets, "\n")
  const facts = bump_summary_deterministic_facts(payload)
  let attempts = []
  for {index, value} in (model_attempt_texts ?? []).enumerate() {
    const cleaned = trim(value ?? "")
    const ok = bump_summary_format_ok(cleaned)
    attempts = attempts + [{attempt: index + 1, text: cleaned, format_ok: ok}]
    if ok {
      return {
        source: if index == 0 {
          "local_llm"
        } else {
          "local_llm_retry"
        },
        text: cleaned,
        deterministic_bullets: deterministic_bullets,
        deterministic_facts: facts,
        model_authored_text: cleaned,
        model_attempts: attempts,
        fallback_reason: nil,
      }
    }
  }
  return {
    source: "deterministic_fallback",
    text: deterministic_text,
    deterministic_bullets: deterministic_bullets,
    deterministic_facts: facts,
    model_authored_text: "",
    model_attempts: attempts,
    fallback_reason: "model returned non-bullet output",
  }
}

/** Build summary metadata when the model path is intentionally skipped. */
pub fn bump_summary_skipped(payload, reason) {
  const deterministic_bullets = bump_summary_deterministic_bullets(payload)
  return {
    source: "skipped",
    text: reason,
    deterministic_bullets: deterministic_bullets,
    deterministic_facts: bump_summary_deterministic_facts(payload),
    model_authored_text: "",
    model_attempts: [],
    fallback_reason: reason,
  }
}
