import { github_connector_options, github_slug_parts } from "./github"
import { GithubClientOptions, GithubConnectorResult, api_call } from "harn-github-connector/default"

// The commit-scoped GitHub reads: everything answered by naming one commit or
// one path's history rather than a pull request, a run, or a branch.
//
// These live apart from the rest of the connector surface because they are the
// reads that answer "what happened to this line of history", and because the
// connector module they came from sits at the repository's handwritten-source
// ceiling. Splitting on that boundary keeps each side under the limit without
// removing any of the reasoning either side carries.
/** Every check run reported against one exact commit. */
pub fn github_commit_check_runs(
  harness: Harness,
  slug: string,
  commit_sha: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<list> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(commit_sha) == "" {
    return Err(
      {
        code: "invalid_commit",
        category: "schema_drift",
        message: "check-run lookup requires owner/name and a commit",
      },
    )
  }
  const observed = api_call(
    harness,
    {
      path: "/repos/${parts.owner}/${parts.repo}/commits/${commit_sha}/check-runs?per_page=100",
      options: options,
    },
  )
  if is_err(observed) {
    return Err(unwrap_err(observed))
  }
  return Ok(unwrap(observed)?.check_runs ?? [])
}

/** One bounded page of commits on a branch, newest first. */
pub fn github_branch_commits(
  harness: Harness,
  slug: string,
  branch: string,
  limit: int = 20,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<list> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(branch) == "" || limit < 1 {
    return Err(
      {
        code: "invalid_branch_history",
        category: "schema_drift",
        message: "branch history requires owner/name, a branch, and a positive page size",
      },
    )
  }
  const observed = api_call(
    harness,
    {
      path: "/repos/${parts.owner}/${parts.repo}/commits"
        + "?sha=${url_encode(branch)}&per_page=${to_string(limit)}",
      options: options,
    },
  )
  if is_err(observed) {
    return Err(unwrap_err(observed))
  }
  return Ok(unwrap(observed) ?? [])
}

/**
 * The commits that changed one path on one branch, newest first.
 *
 * `limit` is a page size, not a filter on which commits count. Callers that
 * walk this list to find a transition must treat a full page as "the answer may
 * be older than this page" rather than as the end of the history.
 */
pub fn github_path_commits(
  harness: Harness,
  slug: string,
  path: string,
  branch: string,
  limit: int = 100,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<list> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(path) == "" || trim(branch) == "" || limit < 1 {
    return Err(
      {
        code: "invalid_path_history",
        category: "schema_drift",
        message: "path history requires owner/name, a path, a branch, and a positive page size",
      },
    )
  }
  const observed = api_call(
    harness,
    {
      path: "/repos/${parts.owner}/${parts.repo}/commits"
        + "?sha=${url_encode(branch)}&path=${url_encode(path)}&per_page=${to_string(limit)}",
      options: options,
    },
  )
  if is_err(observed) {
    return Err(unwrap_err(observed))
  }
  return Ok(unwrap(observed) ?? [])
}

/** The pull requests one commit reached the default branch through. */
pub fn github_commit_pull_requests(
  harness: Harness,
  slug: string,
  commit_sha: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<list> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(commit_sha) == "" {
    return Err(
      {
        code: "invalid_commit",
        category: "schema_drift",
        message: "pull-request lookup requires owner/name and a commit",
      },
    )
  }
  const observed = api_call(
    harness,
    {
      path: "/repos/${parts.owner}/${parts.repo}/commits/${commit_sha}/pulls?per_page=100",
      options: options,
    },
  )
  if is_err(observed) {
    return Err(unwrap_err(observed))
  }
  return Ok(unwrap(observed) ?? [])
}

/** One commit prefix resolved to the exact commit it names. */
pub type GithubResolvedCommit = {requested: string, sha: string, abbreviated: bool}

/** A commit reference this fleet will resolve: 7 to 40 lowercase hex digits. */
pub fn github_commit_prefix_is_well_formed(reference: string) -> bool {
  return len(regex_captures("^[0-9a-f]{7,40}$", lowercase(trim(reference)))) == 1
}

/**
 * Resolve an abbreviated commit to the full forty characters.
 *
 * Operators type a short SHA; every step after the dispatch requires the full
 * one, and a release refused on that mismatch thirty seconds into an attempt.
 * Resolving here is what lets both be true: the operator writes seven
 * characters and the durable receipt still records one exact commit.
 *
 * The reference is required to be hex before it is sent. GitHub's commit
 * endpoint resolves branches and tags too, so without that guard `--at-sha
 * main` would silently become "whatever main was at that instant", which is
 * the pin this fleet exists to remove. The returned commit is then required to
 * start with what was asked for, which is what turns GitHub's answer to an
 * ambiguous prefix into a refusal rather than a wrong commit.
 */
pub fn github_resolve_commit(
  harness: Harness,
  slug: string,
  reference: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubResolvedCommit> {
  const parts = github_slug_parts(slug)
  const requested = lowercase(trim(reference))
  if parts == nil || !github_commit_prefix_is_well_formed(requested) {
    return Err(
      {
        code: "invalid_commit_reference",
        category: "schema_drift",
        message: "commit resolution requires owner/name and 7 to 40 lowercase hex digits; "
          + "'${trim(reference)}' is not a commit prefix",
      },
    )
  }
  const observed = api_call(
    harness,
    {path: "/repos/${parts.owner}/${parts.repo}/commits/${requested}", options: options},
  )
  if is_err(observed) {
    const failure = unwrap_err(observed)
    return Err(
      {
        code: "unresolved_commit",
        category: to_string(failure.category ?? "not_found"),
        message: "${slug} has no commit ${requested}: " + to_string(failure.message ?? failure),
      },
    )
  }
  const sha = lowercase(trim(to_string(unwrap(observed)?.sha ?? "")))
  if len(regex_captures("^[0-9a-f]{40}$", sha)) == 0 {
    return Err(
      {
        code: "invalid_response",
        category: "schema_drift",
        message: "${slug} answered ${requested} without a full commit id",
      },
    )
  }
  if !starts_with(sha, requested) {
    // GitHub resolved the prefix to something that does not extend it. That is
    // either an ambiguous abbreviation or a non-commit object wearing a hex
    // name, and neither is a pin this release may adopt on the operator's
    // behalf.
    return Err(
      {
        code: "ambiguous_commit",
        category: "schema_drift",
        message: "${slug} resolved ${requested} to ${sha}, which does not extend it; "
          + "give more characters",
      },
    )
  }
  return Ok({requested: requested, sha: sha, abbreviated: len(requested) < 40})
}
