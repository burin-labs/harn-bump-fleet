/**
 * The step after which the release may already be published.
 *
 * The harness is what cuts and ships. Every step the workflow runs after it,
 * and every job that waits on that job, executes in a world where the version
 * may already exist, so re-dispatching those inputs would attempt a fresh cut
 * of something already released.
 */
pub const HOSTED_RELEASE_TAG_BOUNDARY_STEP = "Run release harness"

/** One workflow job as declared: its key, what it waits on, and its steps in order. */
pub type HostedReleaseWorkflowJob = {job: string, needs: list<string>, steps: list<string?>}

/** One step in workflow order, with the side of the tag boundary it falls on. */
pub type HostedReleaseOrderedStep = {job: string, step: string, post_tag: bool}

pub type HostedReleaseStepOrder = {
  steps: list<HostedReleaseOrderedStep>,
  boundary_job: string,
  refusals: list<string>,
}

fn job_waits_on(jobs: list<HostedReleaseWorkflowJob>, job: string, target: string) -> bool {
  if job == target {
    return true
  }
  for entry in jobs {
    if entry.job != job {
      continue
    }
    for need in entry.needs {
      if job_waits_on(jobs, need, target) {
        return true
      }
    }
  }
  return false
}

/**
 * Read every step's side of the tag boundary out of the workflow.
 *
 * This is derived rather than declared on purpose. The registry used to carry a
 * boolean per row saying whether a step ran after the tag, and four steps that
 * sit after the harness were recorded as running before it. Nothing could
 * notice, because the boolean and the file it described were never compared.
 *
 * A job that neither contains the boundary nor waits on the job that does has
 * no answer here, and an unanswerable step is a refusal rather than a guess in
 * either direction.
 */
pub fn hosted_release_step_order(jobs: list<HostedReleaseWorkflowJob>) -> HostedReleaseStepOrder {
  let refusals: list<string> = []
  let boundary_job = ""
  let boundary_index = -1
  let seen = 0
  for entry in jobs {
    let index = 0
    for name in entry.steps {
      if name != nil && trim(unwrap(name)) == HOSTED_RELEASE_TAG_BOUNDARY_STEP {
        seen = seen + 1
        boundary_job = entry.job
        boundary_index = index
      }
      index = index + 1
    }
  }
  if seen == 0 {
    refusals = refusals
      + [
        "no step is named `${HOSTED_RELEASE_TAG_BOUNDARY_STEP}`, so nothing marks where "
          + "the release becomes irreversible",
      ]
  }
  if seen > 1 {
    refusals = refusals
      + [
        "${seen} steps are named `${HOSTED_RELEASE_TAG_BOUNDARY_STEP}`, so the boundary "
          + "is ambiguous",
      ]
  }
  let ordered: list<HostedReleaseOrderedStep> = []
  if seen == 1 {
    for entry in jobs {
      const waits = job_waits_on(jobs, entry.job, boundary_job)
      if !waits && entry.job != boundary_job {
        refusals = refusals
          + [
            "job `${entry.job}` neither runs the release nor waits on `${boundary_job}`, "
              + "so its steps have no side of the tag boundary",
          ]
        continue
      }
      let index = 0
      for name in entry.steps {
        if name != nil {
          ordered = ordered
            + [
              {
                job: entry.job,
                step: trim(unwrap(name)),
                post_tag: if entry.job == boundary_job {
                  index > boundary_index
                } else {
                  true
                },
              },
            ]
        }
        index = index + 1
      }
    }
  }
  return {steps: ordered, boundary_job: boundary_job, refusals: refusals.sort()}
}

/** Whether this step runs in a world where the release may already exist. */
pub fn hosted_release_step_is_post_tag(
  order: HostedReleaseStepOrder,
  job: string,
  step: string,
) -> bool? {
  const key = hosted_release_registry_key(job, step)
  for entry in order.steps {
    if hosted_release_registry_key(entry.job, entry.step) == key {
      return entry.post_tag
    }
  }
  return nil
}

pub fn hosted_release_registry_key(job: string, step: string) -> string {
  return trim(job) + "\\u{1}" + trim(step)
}

/** The registry row for one step, or nil when the registry does not name it. */
pub fn hosted_release_failure_row(job: string, step: string) -> HostedReleaseFailureRow? {
  const key = hosted_release_registry_key(job, step)
  for row in HOSTED_RELEASE_FAILURE_REGISTRY {
    if hosted_release_registry_key(row.job, row.step) == key {
      return row
    }
  }
  return nil
}

/** Every step the run reported as failed, in the order the run ran them. */
pub fn hosted_release_failed_steps(
  steps: list<HostedReleaseRunStep>,
) -> list<HostedReleaseRunStep> {
  return steps.filter({ step -> return trim(step.conclusion) == "failure" }).to_list()
}

fn steps_without_a_row(steps: list<HostedReleaseRunStep>) -> list<string> {
  let unmapped: list<string> = []
  for step in steps {
    if hosted_release_failure_row(step.job, step.name) == nil {
      const label = "${step.job}: ${step.name}"
      if !contains(unmapped, label) {
        unmapped = unmapped + [label]
      }
    }
  }
  return unmapped.sort()
}

/**
 * The causes whose repair moves the default branch forward.
 *
 * Repairing any of these lands a commit on the release repository's default
 * branch: a convergence pull request, a development cutover, a fold. The
 * commit the failed run was dispatched at is then no longer an ancestor of
 * that branch, and the release refuses a re-dispatch carrying it with
 * `--at-sha ... is not an ancestor of refreshed origin/main`.
 *
 * That refusal is permanent, not transient. Re-sending the same inputs cannot
 * succeed however many times it is tried, and two dispatches were spent
 * discovering that.
 *
 * This set governs the advice, not the replay. Every one of these causes is
 * reported by the preflight step, whose row is not redispatchable and which
 * therefore escalates without building a replay at all. Dropping the commit
 * from a replay nothing constructs would be a safeguard with no caller: it
 * would read as protection while protecting nothing, and the first row that
 * became redispatchable would inherit the false assurance rather than the
 * protection. What a reader is handed is the repair text, so that is what this
 * set is asserted against.
 */
pub const RELEASE_REPAIRS_THAT_MOVE_MAIN: list<string> = [
  "consumers.contracts",
  "checkpoint.development_version",
  "checkpoint.release_contract",
  "checkpoint.changelog_fragments",
]

/** Whether any reported cause is repaired by moving the default branch. */
pub fn release_repair_moves_main(reported_causes: list<string>) -> bool {
  for reported in reported_causes {
    if contains(RELEASE_REPAIRS_THAT_MOVE_MAIN, trim(reported)) {
      return true
    }
  }
  return false
}

fn redispatch_for(
  run: HostedReleaseRunIdentity,
  inputs: HostedReleaseRecordedInputs,
) -> HostedReleaseRedispatch {
  // A step that runs only after the tag exists cannot be retried as a fresh
  // cut: the run's own follow-up bump is a prerequisite of its own rerun, so
  // the retry has to resume the tagged release instead.
  return {
    repo: run.repo,
    workflow: run.workflow,
    ref: run.ref,
    // Rebuilt field by field rather than spread, so nothing the recorded
    // document carries for its own sake can leak into a dispatch as an input
    // the workflow does not declare.
    inputs: {
      mode: inputs.mode,
      agent: inputs.agent ?? true,
      bump: inputs.bump,
      prerelease_identifier: inputs.prerelease_identifier,
      at_sha: inputs.at_sha,
      expected_prs: inputs.expected_prs,
      resume_tagged_release: inputs.resume_tagged_release,
      converge_fleet: inputs.converge_fleet,
      repositories_json: inputs.repositories_json,
      skip_consumers: inputs.skip_consumers,
      consumer_proof_runs_json: inputs.consumer_proof_runs_json,
    },
  }
}

/**
 * Decide one failed run from its steps and the inputs it recorded.
 *
 * The first failed step the run reports is the one that decides, because every
 * later step either did not run or ran only to upload evidence. A run with no
 * failed step at all is unreadable rather than clean: something reported a
 * failure, and a finalizer that answered "nothing failed" would turn every
 * unreadable run into a silent success.
 */
pub fn hosted_release_failure_receipt(
  run: HostedReleaseRunIdentity,
  order: HostedReleaseStepOrder,
  steps: list<HostedReleaseRunStep>,
  inputs: HostedReleaseRecordedInputs?,
  reported_causes: list<string> = [],
  landing: ReleaseLandingReceipt? = nil,
  landing_admission: ReleaseLandingAdmission? = nil,
) -> HostedReleaseFailureReceipt {
  const failed = hosted_release_failed_steps(steps)
  const base = {
    schema_version: "harn_bump_fleet.hosted_release_failure.v1",
    state: "unreadable",
    repo: run.repo,
    run_id: run.run_id,
    run_url: run.run_url,
    run_attempt: run.run_attempt,
    cause: "unclassified",
    failed_precondition: "",
    failed_steps: failed,
    unmapped_steps: steps_without_a_row(failed),
    landing: landing,
    landing_admission: landing_admission,
  }
  if len(steps) == 0 {
    return base
      + {
        failed_precondition: "the run reported no steps at all",
        escalation_reason: "the run's steps could not be read, so nothing names what failed",
      }
  }
  if len(failed) == 0 {
    return base
      + {
        failed_precondition: "the run failed but reports no failed step",
        escalation_reason: "the run concluded in failure while every step it reports "
          + "concluded otherwise, which is a failed reading rather than a repaired run",
      }
  }
  const deciding = failed[0]
  const row = hosted_release_failure_row(deciding.job, deciding.name)
  if row == nil {
    return base
      + {
        state: "escalated",
        failed_precondition: "an unregistered step: ${deciding.job} / ${deciding.name}",
        escalation_reason: "no registry row names this step, and an unrecognised failure "
          + "escalates rather than defaulting to a retry",
      }
  }
  const matched = unwrap(row)
  // Read the side of the tag boundary before anything else about the repair.
  // Once the release is out, no dispatch of this workflow is the answer: a
  // re-dispatch would attempt a fresh cut of a version that already exists.
  // An unanswerable position escalates too, because the safe reading and the
  // dangerous one are not the same and absence is not the safe one.
  const post_tag = hosted_release_step_is_post_tag(order, deciding.job, deciding.name)
  if post_tag == nil {
    return base
      + {
        state: "escalated",
        cause: matched.cause,
        failed_precondition: matched.precondition,
        escalation_reason: "the workflow does not place ${deciding.job} / ${deciding.name} "
          + "relative to `${HOSTED_RELEASE_TAG_BOUNDARY_STEP}`, so whether the release is "
          + "already out is unknown and no re-dispatch may be named",
      }
  }
  if unwrap(post_tag) {
    return base
      + {
        state: "escalated",
        cause: matched.cause,
        failed_precondition: matched.precondition,
        escalation_reason: "this step runs after the release harness, so the release may "
          + "already be published and re-dispatching would attempt a fresh cut of it; "
          + "recover with recover-release-publication.yml instead",
      }
  }
  if !matched.redispatchable {
    return base
      + {
        state: "escalated",
        cause: matched.cause,
        failed_precondition: matched.precondition,
        escalation_reason: "sending the same inputs again would repeat this failure; "
          + (hosted_release_repair_line(matched, reported_causes)
            ?? "it needs a change, not a retry"),
      }
  }
  if inputs == nil {
    return base
      + {
        state: "escalated",
        cause: matched.cause,
        failed_precondition: matched.precondition,
        escalation_reason: "the run did not record the inputs it was dispatched with, "
          + "so no exact re-dispatch can be named",
      }
  }
  return base
    + {
      state: "classified",
      cause: matched.cause,
      failed_precondition: matched.precondition,
      redispatch: redispatch_for(run, unwrap(inputs)),
    }
}

/** Render the receipt for a run summary, leading with what a person must decide. */
pub fn hosted_release_failure_summary(receipt: HostedReleaseFailureReceipt) -> string {
  let lines = [
    "## Hosted release run ${receipt.run_id} failed",
    "",
    "- State: `${receipt.state}` (cause `${receipt.cause}`)",
    "- What failed: ${receipt.failed_precondition}",
  ]
  for step in receipt.failed_steps {
    lines = lines + ["- Failed step: ${step.job} / ${step.name}"]
  }
  if receipt.landing_admission != nil {
    const admission = unwrap(receipt.landing_admission)
    lines = lines
      + ["- Release landing: `${to_string(admission.valid)}` (${admission.reason})"]
  }
  if receipt.escalation_reason != nil {
    lines = lines + ["- Escalated because ${unwrap(receipt.escalation_reason)}"]
  }
  for entry in receipt.unmapped_steps {
    lines = lines + ["- Unregistered step: ${entry}"]
  }
  if receipt.redispatch != nil {
    const plan = unwrap(receipt.redispatch)
    lines = lines
      + [
        "",
        "### Exact re-dispatch",
        "",
        "Workflow `${plan.workflow}` on `${plan.ref}` in `${plan.repo}` with:",
        "",
        "```json",
        json_stringify_pretty(plan.inputs),
        "```",
      ]
  }
  return join(lines, "\n") + "\n"
}

/** A registry row and a workflow step that do not correspond. */
pub type HostedReleaseRegistryFinding = {kind: string, job: string, step: string, detail: string}

/**
 * Prove the registry names exactly the workflow's steps, in both directions.
 *
 * A step added or renamed without a cause would otherwise surface as an
 * unclassified escalation during a release, hours after the change that caused
 * it. A row for a step the workflow no longer has is the same defect facing the
 * other way: it makes the registry look complete while naming nothing. An
 * unnamed step is refused outright, because the run reports a display name this
 * registry cannot predict.
 */
pub fn hosted_release_registry_findings(
  jobs: list<{job: string, steps: list<string?>}>,
) -> list<HostedReleaseRegistryFinding> {
  let findings: list<HostedReleaseRegistryFinding> = []
  let seen: list<string> = []
  for entry in jobs {
    let position = 0
    for name in entry.steps {
      position = position + 1
      if name == nil || trim(unwrap(name)) == "" {
        findings = findings
          + [
            {
              kind: "unnamed_step",
              job: entry.job,
              step: "step ${position}",
              detail:
                "give the step a name; the run reports a display name the registry cannot predict",
            },
          ]
        continue
      }
      const step = trim(unwrap(name))
      seen = seen + [hosted_release_registry_key(entry.job, step)]
      if hosted_release_failure_row(entry.job, step) == nil {
        findings = findings
          + [
            {
              kind: "unregistered_step",
              job: entry.job,
              step: step,
              detail: "a workflow step was added or renamed and no row names it; add its "
                + "row to ${HOSTED_RELEASE_REGISTRY_PATH}, or rename the row that covered "
                + "the step this one replaced",
            },
          ]
      }
    }
  }
  for row in HOSTED_RELEASE_FAILURE_REGISTRY {
    if !contains(seen, hosted_release_registry_key(row.job, row.step)) {
      findings = findings
        + [
          {
            kind: "stale_row",
            job: row.job,
            step: row.step,
            detail: "a workflow step was removed or renamed and this row still names it; "
              + "delete the row from ${HOSTED_RELEASE_REGISTRY_PATH}, or point it at the "
              + "step that replaced it",
          },
        ]
    }
  }
  findings = findings
    + hosted_release_repair_map_findings(
      HOSTED_RELEASE_FAILURE_REGISTRY,
      RELEASE_LAUNCH_PRECONDITION_NAMES,
    )
  return findings.sort_by({ finding -> return "${finding.kind} ${finding.job} ${finding.step}" })
}

/**
 * Name every repair map that answers nothing.
 *
 * A cause named twice answers only its first entry, so the second is dead text
 * that reads as coverage. A cause or repair that is blank makes the map look
 * populated while handing a release owner an empty line. A cause no producer
 * can emit is the same failure with no visible symptom at all: the lookup
 * always misses, the row-level fallback always answers, and the map reads as
 * seven repairs while delivering one generic line. Nothing about a release
 * looks wrong until someone is holding a half-published version.
 *
 * All three are caught here rather than at the release. `emitted` is the set of
 * names some producer can actually report, passed in rather than read, so the
 * check can be proven against a set that omits a name without one ever being
 * removed from the producer.
 */
pub fn hosted_release_repair_map_findings(
  rows: list<HostedReleaseFailureRow>,
  emitted: list<string>,
) -> list<HostedReleaseRegistryFinding> {
  let findings: list<HostedReleaseRegistryFinding> = []
  for row in rows {
    let causes: list<string> = []
    for entry in row.repairs ?? [] {
      if trim(entry.cause) == "" || trim(entry.repair) == "" {
        findings = findings
          + [
            {
              kind: "empty_cause_repair",
              job: row.job,
              step: row.step,
              detail: "a repair entry has an empty cause or an empty repair",
            },
          ]
        continue
      }
      if contains(causes, entry.cause) {
        findings = findings
          + [
            {
              kind: "duplicate_cause_repair",
              job: row.job,
              step: row.step,
              detail: "cause `${entry.cause}` is named twice, so only the first is ever read",
            },
          ]
      }
      if !contains(emitted, entry.cause) {
        findings = findings
          + [
            {
              kind: "unemitted_cause",
              job: row.job,
              step: row.step,
              detail: "cause `${entry.cause}` is one no producer reports, so this repair "
                + "can never be selected and the row-level repair answers in its place; "
                + "name a cause the step's receipt emits, or delete the entry",
            },
          ]
      }
      causes = causes + [entry.cause]
    }
  }
  return findings
}

/**
 * Refuse a census that measured nothing. A workflow read as zero jobs, or a job
 * read as zero steps, produces an empty finding list that is indistinguishable
 * from a registry in perfect agreement.
 */
pub fn hosted_release_registry_refusals(
  jobs: list<{job: string, steps: list<string?>}>,
) -> list<string> {
  let refusals: list<string> = []
  if len(jobs) == 0 {
    refusals = refusals + ["the workflow was read as having no jobs at all"]
  }
  for entry in jobs {
    if len(entry.steps) == 0 {
      refusals = refusals + ["job `${entry.job}` was read as having no steps"]
    }
  }
  if len(HOSTED_RELEASE_FAILURE_REGISTRY) == 0 {
    refusals = refusals + ["the failure registry is empty"]
  }
  return refusals
}

/**
 * Refuse a workflow whose tag boundary cannot be read.
 *
 * Without it, every step's side of the boundary is a guess, and the guess that
 * costs a released version is the one that reads "safe to re-dispatch".
 */
pub fn hosted_release_order_refusals(jobs: list<HostedReleaseWorkflowJob>) -> list<string> {
  return hosted_release_step_order(jobs).refusals
}

/** A job as the workflow declares it: its key and the name template it renders. */
pub type HostedReleaseJobTemplate = {key: string, name: string}

/**
 * Split a workflow job name template into the literal text around every
 * `${{ ... }}` expression. The expressions are the only part that varies per
 * run, so the literals are what a rendered name must still contain.
 */
pub fn job_name_literals(template: string) -> list<string> {
  const marker = "\${{"
  let literals: list<string> = []
  let rest = template
  while true {
    const open = index_of(rest, marker)
    if open < 0 {
      return literals + [rest]
    }
    literals = literals + [rest[0:open]]
    const tail = rest[open + 3:len(rest)]
    const shut = index_of(tail, "}}")
    if shut < 0 {
      return literals
    }
    rest = tail[shut + 2:len(tail)]
  }
}

fn literals_match(literals: list<string>, observed: string) -> bool {
  let cursor = 0
  let position = 0
  for literal in literals {
    position = position + 1
    if literal == "" {
      continue
    }
    const remainder = observed[cursor:len(observed)]
    const found = index_of(remainder, literal)
    if found < 0 {
      return false
    }
    // The first literal is anchored at the start and the last at the end, so a
    // template of pure wildcards cannot match every name it is shown.
    if position == 1 && found != 0 {
      return false
    }
    cursor = cursor + found + len(literal)
  }
  const tail = literals[len(literals) - 1] ?? ""
  if tail != "" && !ends_with(observed, tail) {
    return false
  }
  return true
}

/**
 * Resolve the job key behind a rendered job name.
 *
 * The registry keys on the job as the workflow declares it, while a run reports
 * the name the job rendered, which for the release job embeds its inputs.
 * Exactly one template must match; zero and more than one are both nil, because
 * an ambiguous match would attribute a failure to the wrong job's registry rows
 * and classify it as something it is not.
 */
pub fn hosted_release_job_key(
  templates: list<HostedReleaseJobTemplate>,
  observed: string,
) -> string? {
  let matched: list<string> = []
  for template in templates {
    if literals_match(job_name_literals(template.name), trim(observed)) {
      if !contains(matched, template.key) {
        matched = matched + [template.key]
      }
    }
  }
  return if len(matched) == 1 {
    matched[0]
  } else {
    nil
  }
}

/**
 * Reduce one run's jobs to the registry's step vocabulary.
 *
 * A job whose key cannot be resolved keeps its rendered name, so its steps
 * surface as unregistered rather than being dropped or attributed to a job that
 * did not run them.
 */
pub fn hosted_release_run_steps(
  templates: list<HostedReleaseJobTemplate>,
  jobs: list<{name: string, steps: list<{number: int, name: string, conclusion: string?}>}>,
) -> list<HostedReleaseRunStep> {
  let steps: list<HostedReleaseRunStep> = []
  for job in jobs {
    const key = hosted_release_job_key(templates, job.name) ?? trim(job.name)
    for step in job.steps {
      steps = steps
        + [
          {
            job: key,
            name: trim(step.name),
            conclusion: trim(step.conclusion ?? ""),
            number: step.number,
          },
        ]
    }
  }
  return steps
}
