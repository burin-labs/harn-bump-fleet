import {
  RELEASE_LAUNCH_PRECONDITION_NAMES,
  RELEASE_LAUNCH_RECEIPT_PATH,
} from "./release_launch_preflight"
import { ReleaseLandingAdmission, ReleaseLandingReceipt } from "./release_merge_lease"

//
// What a failed hosted release run leaves behind.
//
// A red release run today is a workflow conclusion and a log. Someone has to
// notice it, open the job page, read the failing step, decide whether the
// failure is mechanical, and reconstruct the dispatch by hand. The evidence
// needed for all four is already structured: the failing step is a named field
// on the job, and the dispatch inputs are a closed set the run recorded when it
// started.
//
// This module turns that evidence into one typed receipt naming the
// precondition that failed and the exact re-dispatch that would retry it. It
// dispatches on the step name, which is structured, never on the log text,
// which is prose and is frequently mislabeled. A step the registry does not
// name escalates; it never falls through to a retry.
/** Why the run failed, at the granularity a repair decision needs. */
pub type HostedReleaseFailureCause = "environment" \
  | "invalid_inputs" \
  | "credential" \
  | "consumer_contract_drift" \
  | "release_harness" \
  | "publication" \
  | "fleet_convergence" \
  | "bookkeeping" \
  | "unclassified"

/** One step of the run, as the API reports it. */
pub type HostedReleaseRunStep = {job: string, name: string, conclusion: string, number: int}

/**
 * One registry row: the exact step name, what its failure means, and what a
 * repair may do about it.
 *
 * `redispatchable` is the safety bit. A run that failed on its own inputs, or
 * on drift another repository owns, is not repaired by sending the same inputs
 * again; those escalate with the classification instead. Some of them do have a
 * mechanical repair, just not this one, so `repair` names it in the escalation
 * rather than leaving a reader with only "this needs a change".
 *
 * One step may fail several distinct preconditions, and they do not share a
 * repair: drift another repository owns wants a convergence dispatch, a missing
 * cutover wants a re-dispatch of the bump, and an unreadable pin wants a person
 * because nothing automatic makes a repository readable. `repairs` names the
 * repair per cause the step's own receipt reports. A receipt commonly names
 * several at once, so the repairs come back as a list in the order the receipt
 * named them, never as whichever happened to be first. `repair` stays as the
 * row-level fallback so a cause with no entry still says what to do rather than
 * only where to look.
 *
 * Whether a step runs before or after the release is tagged is deliberately not
 * a field here. It is read from the workflow, from the step's position relative
 * to the harness that does the tagging, because a hand-kept boolean drifts from
 * the file the moment a step moves and the drift is invisible.
 */
pub type HostedReleaseFailureRow = {
  job: string,
  step: string,
  cause: HostedReleaseFailureCause,
  redispatchable: bool,
  precondition: string,
  repair?: string,
  repairs?: list<HostedReleaseCauseRepair>,
}

/**
 * One cause a step's own receipt may report, and the repair that cause wants.
 *
 * The cause is the receipt's own key, not this module's coarse
 * `HostedReleaseFailureCause`: the coarse cause answers what class of thing
 * broke, and this answers which precondition inside the step broke.
 */
pub type HostedReleaseCauseRepair = {cause: string, repair: string}

/**
 * Every repair the row names for the causes the step's own receipt reported.
 *
 * It takes the causes as a list because a step that asks every precondition
 * commonly refuses on several at once. Taking one cause would mean someone
 * ranking them, and the ranking nothing tests is the one that quietly becomes
 * list order: an owner told to fix the cheapest thing while the expensive one
 * stays invisible. The repairs come back in the order the receipt named its
 * causes, deduplicated, because two causes wanting the same repair is one piece
 * of work rather than two.
 *
 * A reported cause with no entry falls back to the row-level repair rather than
 * to nothing, so an unmapped cause is still actionable. The fallback is
 * appended, never substituted, so a mapped repair is never dropped in favour of
 * the generic line. A run that reported no cause takes the row-level repair.
 */
pub fn hosted_release_repairs_for(
  row: HostedReleaseFailureRow,
  reported_causes: list<string>,
) -> list<string> {
  let repairs: list<string> = []
  let unmapped = false
  for reported in reported_causes {
    const wanted = trim(reported)
    if wanted == "" {
      continue
    }
    let matched: string? = nil
    for entry in row.repairs ?? [] {
      if entry.cause == wanted && matched == nil {
        matched = entry.repair
      }
    }
    if matched == nil {
      unmapped = true
      continue
    }
    // The receipt may name two causes that want the same repair. Saying it
    // twice would read as two pieces of work.
    if !contains(repairs, unwrap(matched)) {
      repairs = repairs + [unwrap(matched)]
    }
  }
  // The row-level repair covers a cause the map does not name, and a run that
  // reported no cause at all. It is appended rather than substituted, so a
  // mapped repair is never dropped in favour of the generic one.
  if (unmapped || len(repairs) == 0) && row.repair != nil {
    const fallback = unwrap(row.repair)
    if !contains(repairs, fallback) {
      repairs = repairs + [fallback]
    }
  }
  return repairs
}

/** The repair list as one line, in the order the receipt named its causes. */
pub fn hosted_release_repair_line(
  row: HostedReleaseFailureRow,
  reported_causes: list<string>,
) -> string? {
  const repairs = hosted_release_repairs_for(row, reported_causes)
  if len(repairs) == 0 {
    return nil
  }
  return join(repairs, "; then ")
}

/** The closed input set a run was dispatched with, recorded by the run itself. */
pub type HostedReleaseRecordedInputs = {
  mode: string,
  agent?: bool,
  bump: string,
  prerelease_identifier: string,
  at_sha: string,
  expected_prs: string,
  resume_tagged_release: bool,
  converge_fleet: bool,
  repositories_json: string,
  skip_consumers: string,
  consumer_proof_runs_json: string,
}

/** The run being judged, named once so no two identifiers can be swapped. */
pub type HostedReleaseRunIdentity = {
  repo: string,
  workflow: string,
  ref: string,
  run_id: int,
  run_url: string,
  run_attempt: int,
}

/** The exact dispatch that retries this run. */
pub type HostedReleaseRedispatch = {
  repo: string,
  workflow: string,
  ref: string,
  inputs: HostedReleaseRecordedInputs,
}

/**
 * Everything the finalizer read and everything it decided.
 *
 * `state` is the part that must not collapse. A run whose steps could not be
 * read reports `unreadable`, never a clean classification, because a failed
 * run with no failing step in hand is a failed instrument rather than a run
 * that repaired itself.
 */
pub type HostedReleaseFailureReceipt = {
  schema_version: "harn_bump_fleet.hosted_release_failure.v1",
  state: "classified" | "escalated" | "unreadable",
  repo: string,
  run_id: int,
  run_url: string,
  run_attempt: int,
  cause: HostedReleaseFailureCause,
  failed_precondition: string,
  failed_steps: list<HostedReleaseRunStep>,
  unmapped_steps: list<string>,
  landing?: ReleaseLandingReceipt?,
  landing_admission?: ReleaseLandingAdmission?,
  redispatch?: HostedReleaseRedispatch,
  escalation_reason?: string,
}

const RELEASE_JOB = "release"

const FLEET_JOB = "fleet"

/**
 * Every step of the hosted release workflow, with what its failure means.
 *
 * The registry is the policy. `check_hosted_release_failure_coverage.harn`
 * proves it names exactly the workflow's steps in both directions, so a step
 * added or renamed without a cause is a red gate on the pull request that
 * renames it rather than an unclassified escalation during a release.
 */
/**
 * Where the rows live, so a finding can say where to go.
 *
 * A finding that names only the offending step tells a reader what is wrong
 * and not what to do, and the two situations this check reports have opposite
 * repairs: a step gained without a row, and a row left behind by a step that
 * went away. A rename is both at once, which is why each message says so.
 */
pub const HOSTED_RELEASE_REGISTRY_PATH = "lib/hosted_release_failure.harn"

