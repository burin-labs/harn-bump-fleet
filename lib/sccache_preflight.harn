/**
 * Guard the build-heavy release steps against a poisoned `sccache` daemon.
 *
 * `sccache` runs as ONE machine-wide server daemon (per user, bound to a
 * fixed port); every `cargo build` on the machine — releases, harn
 * worktrees, sandboxed Claude Code shells — talks to that same daemon.
 * Whoever triggers the first sccache call spawns it. If that first caller
 * runs inside a sandbox (harn's `sandbox-exec`, a sandboxed agent shell,
 * etc.) the daemon inherits the confinement permanently — even after it
 * reparents to launchd. A confined daemon cannot write its cache dir under
 * `~/Library/Caches` nor read build inputs outside the sandbox root, so it
 * fails every later compile machine-wide with `Operation not permitted`
 * (surfacing as `sccache: Failed to open file for hashing` and
 * `error: error writing dependencies to … (os error 1)`), and the release
 * `prepare` warm-prebuild dies even though the run itself used
 * `--no-sandbox`.
 *
 * The release pipeline runs `--no-sandbox`, so any sccache server it spawns
 * is healthy. The hazard is purely a *pre-existing* poisoned daemon left by
 * an earlier sandboxed build. Restarting clears it: the next cargo call
 * spawns a fresh, unconfined server and the on-disk cache persists, so we
 * lose nothing but the (already broken) in-memory server.
 */
/**
 * Sum the cache-I/O error counters reported by `sccache --show-stats`.
 *
 * A healthy daemon reports 0 across "Cache write errors", "Cache read
 * errors", and "Cache errors". A confined daemon drives these into the
 * hundreds. Any positive sum is the poison signal. Pure so it is exercised
 * in unit tests.
 */
pub fn sccache_cache_error_count(stats_text) {
  let total = 0
  for line in (stats_text ?? "").lines() {
    // sccache labels every error counter "Cache <…> errors  <n>"; the count
    // is always the final whitespace-separated token on the line.
    if contains(line, "Cache") && contains(line, "error") {
      let parts = split(trim(line), " ").filter({ p -> p != "" })
      if len(parts) > 0 {
        let n = to_int(parts[len(parts) - 1])
        if n != nil {
          total = total + n
        }
      }
    }
  }
  return total
}

/**
 * Inspect the shared sccache daemon and restart it when poisoned.
 *
 * `run` is a shell runner closure (`command -> {stdout, success}`) so the
 * decision logic is unit-testable; the live caller passes one backed by the
 * `shell` builtin. Returns a result record describing the action taken.
 */
pub fn ensure_healthy_sccache(run) {
  let which = run("command -v sccache 2>/dev/null")
  if trim(which.stdout ?? "") == "" {
    return {checked: false, restarted: false, errors: 0, detail: "sccache not installed; nothing to check"}
  }
  // `--show-stats` auto-starts a server when none is running. In the
  // release's `--no-sandbox` context that fresh server is unconfined and
  // reports 0 errors, so a missing daemon is correctly treated as healthy.
  let stats = run("sccache --show-stats 2>/dev/null")
  if !(stats.success ?? false) {
    return {
      checked: false,
      restarted: false,
      errors: 0,
      detail: "sccache --show-stats failed; left daemon as-is",
    }
  }
  let errors = sccache_cache_error_count(stats.stdout ?? "")
  if errors <= 0 {
    return {checked: true, restarted: false, errors: 0, detail: "sccache daemon healthy"}
  }
  run("sccache --stop-server >/dev/null 2>&1 || true")
  return {
    checked: true,
    restarted: true,
    errors: errors,
    detail: "restarted poisoned sccache daemon (${errors} cache I/O error(s))",
  }
}
