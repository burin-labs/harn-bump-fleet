import { is_v_semver } from "std/semver"
import { FleetManifest, scoped_harn_bump_repositories } from "./fleet_manifest"
import {
  FleetDispatchScope,
  fleet_operation_scope,
  fleet_scope_inputs,
} from "./fleet_operation_scope"

/**
 * Closed dispatch scope retained in the hosted-run receipt.
 * One validated hosted fleet dispatch and its exact workflow inputs.
 */
pub type FleetDispatchPlan = {target: string, scope: FleetDispatchScope, workflow_inputs: dict}

/**
 * Validate a hosted convergence request before GitHub is reachable.
 *
 * The manifest owns repository admission. The same plan owns both the audit
 * scope and the workflow payload, so the two cannot silently diverge.
 */
pub fn plan_fleet_dispatch(
  manifest: FleetManifest,
  target: string,
  raw_only: string,
  chain_id: string = "",
  repositories_json: string? = nil,
) -> FleetDispatchPlan {
  if !is_v_semver(target) {
    throw "fleet dispatch target must be a stable vX.Y.Z release, got '${target}'"
  }
  const only = if trim(raw_only) == "" {
    nil
  } else {
    trim(raw_only)
  }
  const chain = trim(chain_id)
  if chain != "" && len(regex_captures("^[1-9][0-9]*$", chain)) == 0 {
    throw "fleet dispatch chain ID must be a positive decimal GitHub run ID"
  }
  const common_inputs = if chain == "" {
    {version: target}
  } else {
    {version: target, chain_id: chain}
  }
  const scope = fleet_operation_scope(only, repositories_json)
  const selected = scoped_harn_bump_repositories(manifest, only, repositories_json)
  if repositories_json != nil {
    return {
      target: target,
      scope: scope,
      workflow_inputs: common_inputs + fleet_scope_inputs(scope),
    }
  }
  if only == nil {
    return {target: target, scope: {kind: "full_fleet"}, workflow_inputs: common_inputs}
  }
  const repository = selected[0]?.slug
  if repository == nil {
    throw "fleet dispatch scope resolved no managed repository"
  }
  return {
    target: target,
    scope: {kind: "repository", repository: repository},
    workflow_inputs: common_inputs + {only: repository},
  }
}
