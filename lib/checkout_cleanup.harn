import { git_current_branch, git_pull_ff_only, git_run, git_switch } from "std/git"
import { recorded_step } from "./release_execution"
import { fail, ok } from "./shell_util"

/**
 * Display labels for the cleanup steps, in execution order.
 *
 * The labels are only used for `recorded_step` audit text and to key the
 * scripted runner in tests — production execution dispatches to std/git
 * directly via `cleanup_command_result` (no shell parsing involved), so
 * `base` flows in as a plain value without needing shell quoting.
 */
pub fn checkout_cleanup_commands(base) {
  return [
    {name: "cleanup-fetch-origin", command: "git fetch origin --prune --quiet"},
    {name: "cleanup-switch-base", command: "git switch " + base},
    {name: "cleanup-sync-base", command: "git pull --ff-only origin " + base + " --quiet"},
  ]
}

fn cleanup_command_result(run_command, repo, name, command, base) {
  if run_command != nil {
    return run_command(command)
  }
  if name == "cleanup-status" {
    return git_run(["status", "--porcelain", "--untracked-files=normal"], {repo: repo})
  }
  if name == "cleanup-fetch-origin" {
    return git_run(["fetch", "origin", "--prune", "--quiet"], {repo: repo})
  }
  if name == "cleanup-switch-base" {
    return git_switch(base, repo)
  }
  if name == "cleanup-sync-base" {
    return git_pull_ff_only(repo, "origin", base, {quiet: true})
  }
  if name == "cleanup-current-branch" {
    return git_current_branch(repo)
  }
  throw "unknown cleanup command step: " + name
}

/**
 * Pre-release sync: stash dirty work, switch to `base`, fast-forward to
 * `origin/<base>`.
 *
 * Unlike `checkout_cleanup` (which intentionally skips when the worktree is
 * dirty so the operator's evidence is preserved at the END of a run), this
 * is for the START of a run — so any local drift is set aside via
 * `git stash push --include-untracked -m <stash_message>` and the caller
 * surfaces the stash tag for manual recovery later. `stash_message` must
 * not contain whitespace (it flows into a runner-pattern command label).
 *
 * Returns `{success, dirty, stashed, stash_message, branch, detail, steps}`.
 * On success, `branch == base` and `stash_message` holds the tag we stashed
 * under (empty if the tree was already clean).
 */
pub fn sync_base_branch(
  run_command = nil,
  base = "main",
  stash_message = "release_harn-auto-stash",
  repo = ".",
) {
  let stash_tag = if did_stash_message_has_whitespace(stash_message) {
    throw "stash_message must not contain whitespace: " + stash_message
  } else {
    stash_message
  }
  var steps = []
  let status_command = "git status --porcelain --untracked-files=normal"
  let status = sync_command_result(run_command, repo, "sync-status", status_command, base, stash_tag)
  steps = steps + [recorded_step("sync-status", status_command, status)]
  if !status.success {
    return {
      success: false,
      dirty: false,
      stashed: false,
      stash_message: "",
      branch: "",
      detail: "could not inspect working tree before sync",
      steps: steps,
    }
  }
  let dirty = trim(status.stdout) != ""
  var stashed = false
  if dirty {
    let stash_cmd = "git stash push --include-untracked -m " + stash_tag
    let stash = sync_command_result(run_command, repo, "sync-stash", stash_cmd, base, stash_tag)
    steps = steps + [recorded_step("sync-stash", stash_cmd, stash)]
    if !stash.success {
      return {
        success: false,
        dirty: true,
        stashed: false,
        stash_message: "",
        branch: "",
        detail: "failed to stash dirty working tree",
        steps: steps,
      }
    }
    stashed = true
  }
  let branch_command = "git branch --show-current"
  let branch = sync_command_result(run_command, repo, "sync-current-branch", branch_command, base, stash_tag)
  steps = steps + [recorded_step("sync-current-branch", branch_command, branch)]
  if !branch.success {
    return {
      success: false,
      dirty: dirty,
      stashed: stashed,
      stash_message: stash_message_value(stashed, stash_tag),
      branch: "",
      detail: "could not read current branch before sync",
      steps: steps,
    }
  }
  let current = trim(branch.stdout)
  if current != base {
    let switch_command = "git switch " + base
    let switched = sync_command_result(run_command, repo, "sync-switch-base", switch_command, base, stash_tag)
    steps = steps + [recorded_step("sync-switch-base", switch_command, switched)]
    if !switched.success {
      return {
        success: false,
        dirty: dirty,
        stashed: stashed,
        stash_message: stash_message_value(stashed, stash_tag),
        branch: current,
        detail: "failed to switch from " + current + " to " + base,
        steps: steps,
      }
    }
  }
  let fetch_command = "git fetch origin --prune --quiet"
  let fetched = sync_command_result(run_command, repo, "sync-fetch-origin", fetch_command, base, stash_tag)
  steps = steps + [recorded_step("sync-fetch-origin", fetch_command, fetched)]
  if !fetched.success {
    return {
      success: false,
      dirty: dirty,
      stashed: stashed,
      stash_message: stash_message_value(stashed, stash_tag),
      branch: base,
      detail: "failed to fetch origin before sync",
      steps: steps,
    }
  }
  let pull_command = "git pull --ff-only origin " + base + " --quiet"
  let pulled = sync_command_result(run_command, repo, "sync-pull-ff", pull_command, base, stash_tag)
  steps = steps + [recorded_step("sync-pull-ff", pull_command, pulled)]
  if !pulled.success {
    return {
      success: false,
      dirty: dirty,
      stashed: stashed,
      stash_message: stash_message_value(stashed, stash_tag),
      branch: base,
      detail: "failed to fast-forward " + base + " from origin",
      steps: steps,
    }
  }
  return {
    success: true,
    dirty: dirty,
    stashed: stashed,
    stash_message: stash_message_value(stashed, stash_tag),
    branch: base,
    detail: if stashed {
      "stashed dirty tree (" + stash_tag + ") and fast-forwarded " + base
    } else {
      base + " fast-forwarded from origin"
    },
    steps: steps,
  }
}

fn did_stash_message_has_whitespace(msg) {
  let m = msg ?? ""
  return contains(m, " ") || contains(m, "\t") || contains(m, "\n")
}

fn stash_message_value(stashed, stash_tag) {
  return if stashed {
    stash_tag
  } else {
    ""
  }
}

fn sync_command_result(run_command, repo, name, command, base, stash_tag) {
  if run_command != nil {
    return run_command(command)
  }
  if name == "sync-status" {
    return git_run(["status", "--porcelain", "--untracked-files=normal"], {repo: repo})
  }
  if name == "sync-stash" {
    return git_run(["stash", "push", "--include-untracked", "-m", stash_tag], {repo: repo})
  }
  if name == "sync-current-branch" {
    return git_current_branch(repo)
  }
  if name == "sync-switch-base" {
    return git_switch(base, repo)
  }
  if name == "sync-fetch-origin" {
    return git_run(["fetch", "origin", "--prune", "--quiet"], {repo: repo})
  }
  if name == "sync-pull-ff" {
    return git_pull_ff_only(repo, "origin", base, {quiet: true})
  }
  throw "unknown sync command step: " + name
}

/** Restore a clean checkout to `base`, or skip safely when local changes are present. */
pub fn checkout_cleanup(run_command = nil, base = "main", repo = ".") {
  var steps = []
  let status_command = "git status --porcelain --untracked-files=normal"
  let status = cleanup_command_result(run_command, repo, "cleanup-status", status_command, base)
  steps = steps + [recorded_step("cleanup-status", status_command, status)]
  if !status.success {
    return {
      success: false,
      skipped: false,
      branch: "",
      detail: "could not inspect working tree before cleanup",
      warning: cleanup_warning("could not inspect working tree before cleanup"),
      fatal: false,
      steps: steps,
    }
  }
  if trim(status.stdout) != "" {
    steps = steps
      + [
      recorded_step(
        "cleanup-skipped-dirty",
        "skip cleanup checkout",
        ok("working tree has tracked or untracked changes; leaving checkout unchanged\n"),
      ),
    ]
    return {
      success: true,
      skipped: true,
      branch: "",
      detail: "working tree dirty; left checkout unchanged",
      warning: "",
      fatal: false,
      steps: steps,
    }
  }
  for spec in checkout_cleanup_commands(base) {
    let result = cleanup_command_result(run_command, repo, spec.name, spec.command, base)
    steps = steps + [recorded_step(spec.name, spec.command, result)]
    if !result.success {
      let detail = "failed during " + spec.name
      return {
        success: false,
        skipped: false,
        branch: "",
        detail: detail,
        warning: cleanup_warning(detail),
        fatal: false,
        steps: steps,
      }
    }
  }
  let branch_command = "git branch --show-current"
  let branch = cleanup_command_result(run_command, repo, "cleanup-current-branch", branch_command, base)
  steps = steps + [recorded_step("cleanup-current-branch", branch_command, branch)]
  if !branch.success {
    return {
      success: false,
      skipped: false,
      branch: "",
      detail: "could not verify cleanup branch",
      warning: cleanup_warning("could not verify cleanup branch"),
      fatal: false,
      steps: steps,
    }
  }
  let current = trim(branch.stdout)
  if current != base {
    steps = steps
      + [
      recorded_step(
        "cleanup-verify-base",
        "verify checkout is " + base,
        fail(1, "checkout is " + current + "; expected " + base),
      ),
    ]
    return {
      success: false,
      skipped: false,
      branch: current,
      detail: "checkout is " + current + "; expected " + base,
      warning: cleanup_warning("checkout is " + current + "; expected " + base),
      fatal: false,
      steps: steps,
    }
  }
  steps = steps
    + [
    recorded_step("cleanup-verify-base", "verify checkout is " + base, ok("checkout is " + base + "\n")),
  ]
  return {
    success: true,
    skipped: false,
    branch: current,
    detail: "checkout restored to " + base,
    warning: "",
    fatal: false,
    steps: steps,
  }
}

fn cleanup_warning(detail) {
  return "non-fatal checkout cleanup warning: " + detail
}
