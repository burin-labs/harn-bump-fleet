import { command_run } from "std/command"
import { FleetManifest, FleetRepository } from "./fleet_manifest"

const BEGIN_MARKER = "<!-- BEGIN HARN SHARED AGENT CONTRACT: managed by harn-bump-fleet -->"

const END_MARKER = "<!-- END HARN SHARED AGENT CONTRACT -->"

pub type AgentGuidanceRepo = FleetRepository

pub type AgentGuidanceManifest = FleetManifest

pub type GuidanceRender = {ok: bool, text: string, changed: bool, error?: string}

pub type GuidanceRepoResult = {
  slug: string,
  path: string,
  status: "clean" | "drift" | "applied" | "error",
  changes: list<string>,
  error?: string,
}

pub fn shared_agent_guidance_block() -> string {
  return join(
    [
      BEGIN_MARKER,
      "",
      "## Ecosystem working agreement",
      "",
      "- Pursue the ambitious product outcome; make the seams boring with small typed",
      "  interfaces, explicit invariants, and deterministic projections.",
      "- Give each behavior one semantic owner. Generate or parity-test other surfaces",
      "  instead of maintaining competing implementations.",
      "- Work autonomously inside approved scope. Pause for destructive, production,",
      "  high-spend, ambiguous, or authority-expanding actions—not routine reversible work.",
      "- Treat stop, wait, stand down, and pivot as control events for long-lived work.",
      "- Match evidence to the claim: exercise the canonical user path, state the",
      "  falsifier, verify liveness and recovery, and record residual blind spots.",
      "- \"Ship\" means landed on main with required deploy and post-merge checks complete.",
      "",
      END_MARKER,
    ],
    "\n",
  )
}

fn marker_count(text: string, marker: string) -> int {
  return len(split(text, marker)) - 1
}

/** Replace only the owned block, or append it when absent. */
pub fn render_agent_guidance(current: string) -> GuidanceRender {
  const begin_count = marker_count(current, BEGIN_MARKER)
  const end_count = marker_count(current, END_MARKER)
  if begin_count != end_count || begin_count > 1 {
    return {
      ok: false,
      text: current,
      changed: false,
      error: "managed guidance markers are incomplete or duplicated",
    }
  }
  const block = shared_agent_guidance_block()
  let next = current
  if begin_count == 0 {
    next = current.trim_end() + "\n\n" + block + "\n"
  } else {
    const start = current.index_of(BEGIN_MARKER)
    const end_start = current.index_of(END_MARKER)
    const end = end_start + len(END_MARKER)
    next = current[0:start] + block + current[end:len(current)]
  }
  return {ok: true, text: next, changed: next != current}
}

pub fn resolve_projects_root(configured: string, home: string) -> string {
  if configured == "~" {
    return home
  }
  if starts_with(configured, "~/") {
    return path_join(home, configured[2:len(configured)])
  }
  return configured
}

fn projection_state(harness: HarnessTools, repo_path: string) -> bool {
  const projection = path_join(repo_path, "CLAUDE.md")
  const probe = command_run(
    harness,
    {
      argv: [
        "sh",
        "-c",
        "test -L \"$1\" && test \"$(readlink \"$1\")\" = AGENTS.md",
        "sh",
        projection,
      ],
    },
  )
  return probe.success
}

fn apply_projection(harness: HarnessTools, repo_path: string) -> Result<nil, string> {
  const projection = path_join(repo_path, "CLAUDE.md")
  const linked = command_run(harness, {argv: ["ln", "-sfn", "AGENTS.md", projection]})
  if !linked.success {
    return Err(trim(linked.stderr + linked.stdout))
  }
  return Ok(nil)
}

pub fn sync_agent_guidance_repo(
  harness: {fs: HarnessFs, tools: HarnessTools},
  repo: AgentGuidanceRepo,
  projects_root: string,
  apply: bool,
) -> GuidanceRepoResult {
  const repo_path = path_join(projects_root, repo.directory)
  const agents_path = path_join(repo_path, "AGENTS.md")
  if !harness.fs.exists(path_join(repo_path, ".git")) {
    return {
      slug: repo.slug,
      path: repo_path,
      status: "error",
      changes: [],
      error: "not a Git checkout",
    }
  }
  const current = if harness.fs.exists(agents_path) {
    harness.fs.read_text(agents_path)
  } else {
    "# AGENTS.md\n"
  }
  const rendered = render_agent_guidance(current)
  if !rendered.ok {
    return {
      slug: repo.slug,
      path: repo_path,
      status: "error",
      changes: [],
      error: rendered.error ?? "unknown render error",
    }
  }
  const projection_clean = projection_state(harness.tools, repo_path)
  let changes: list<string> = []
  if rendered.changed {
    changes = changes + ["AGENTS.md shared block"]
  }
  if !projection_clean {
    changes = changes + ["CLAUDE.md projection"]
  }
  if len(changes) == 0 {
    return {slug: repo.slug, path: repo_path, status: "clean", changes: []}
  }
  if !apply {
    return {slug: repo.slug, path: repo_path, status: "drift", changes: changes}
  }
  if rendered.changed {
    harness.fs.write_text(agents_path, rendered.text)
  }
  if !projection_clean {
    const linked = apply_projection(harness.tools, repo_path)
    if is_err(linked) {
      return {
        slug: repo.slug,
        path: repo_path,
        status: "error",
        changes: changes,
        error: "could not project CLAUDE.md: ${unwrap_err(linked)}",
      }
    }
  }
  return {slug: repo.slug, path: repo_path, status: "applied", changes: changes}
}
