import { command_result_fail, command_result_ok } from "std/command"
import { github_commit_check_runs } from "./github"
import { ReleaseAnalysis } from "./release_analysis"
import { release_attempt_reuse_verdict } from "./release_attempt_reuse"
import { run_release_candidate_certification } from "./release_candidate_certification"
import { recorded_step } from "./release_execution"
import { release_main_release_only_checks } from "./release_main_tag"
import { ReleasePublication } from "./release_publication"
import { release_log_event, release_repo_slug } from "./release_runtime"
import { ReleaseShipPrepareReady } from "./release_ship_prepare"
import { pre_certification_cutoff_gate } from "./release_tag"

pub type ReleaseShipCertifyStopped = {proceed: bool, steps: list<dict>}

pub type ReleaseShipCertified = {
  proceed: bool,
  steps: list<dict>,
  analysis: ReleaseAnalysis,
  version: string,
  publication: ReleasePublication,
}

pub type ReleaseShipCertifyResult = ReleaseShipCertifyStopped | ReleaseShipCertified

pub fn release_ship_certify_phase(
  harness: Harness,
  cfg: dict,
  prepared: ReleaseShipPrepareReady,
  run_id: string,
) -> ReleaseShipCertifyResult {
  let steps = prepared.steps
  const version = prepared.version
  const publication = prepared.publication
  // Prove the frozen candidate still descends from main before spending on its
  // certification. The public tag is born only after this candidate's PR merges.
  const cutoff_gate = pre_certification_cutoff_gate(harness, cfg, version, steps, run_id)
  steps = cutoff_gate.steps
  if !cutoff_gate.proceed {
    return {proceed: false, steps: steps}
  }
  // The immutable publication is the single certification subject. Hosted
  // platform/local-source proof, the Linux release-size proof, and the
  // candidate-archive matrix fan out from this exact OID; only their residual
  // generated-content audit follows the join. A red or incomplete lane blocks
  // PR publication.
  if !(cfg.skip_tag ?? false) {
    // An adopted attempt may already carry the proof this phase would spend two
    // hours reproducing. Only an adopted one: a freshly built candidate has a
    // new OID and nothing recorded against it, so there is nothing to inherit.
    const reuse = attempt_reuse_gate(harness, cfg, publication, steps, run_id)
    steps = reuse.steps
    if !reuse.proceed {
      return {proceed: false, steps: steps}
    }
    if !reuse.reused {
      const certification = run_release_candidate_certification(
        harness,
        cfg,
        publication,
        steps,
        run_id,
      )
      steps = certification.steps
      if !certification.success {
        return {proceed: false, steps: steps}
      }
    }
  }
  return {
    proceed: true,
    steps: steps,
    analysis: prepared.analysis,
    version: version,
    publication: publication,
  }
}

type AttemptReuseGate = {proceed: bool, reused: bool, steps: list<dict>}

/**
 * Decide whether this run inherits an adopted attempt's certification.
 *
 * Three ways this refuses to inherit rather than inheriting quietly: the run
 * did not adopt an attempt at all, the attempt's lanes could not be read, or
 * the lanes are absent or unfinished. Only a settled failure stops the release;
 * everything else falls through to certifying, which is the answer that costs
 * time rather than truth.
 */
fn attempt_reuse_gate(
  harness: Harness,
  cfg: dict,
  publication: ReleasePublication,
  initial_steps: list<dict>,
  run_id: string,
) -> AttemptReuseGate {
  if !(cfg.pre_tag_resume ?? false) {
    return {proceed: true, reused: false, steps: initial_steps}
  }
  const lanes = release_main_release_only_checks(harness.fs, cfg)
  const slug = release_repo_slug({env: harness.env, process: harness.process}, cfg)
  const rows = github_commit_check_runs(harness, slug, publication.head_oid)
  if is_err(rows) {
    return {
      proceed: true,
      reused: false,
      steps: initial_steps
        + [
          recorded_step(
            "reuse-attempt-certification",
            "read certification recorded on ${publication.head_oid}",
            command_result_ok(
              "could not read the attempt's checks (" + to_string(unwrap_err(rows))
                + "); certifying rather than assuming\n",
            ),
          ),
        ],
    }
  }
  const verdict = release_attempt_reuse_verdict(publication.head_oid, lanes, unwrap(rows))
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "release_attempt_reuse_decided",
    verdict,
  )
  if verdict.decision == "refuse" {
    return {
      proceed: false,
      reused: false,
      steps: initial_steps
        + [
          recorded_step(
            "reuse-attempt-certification",
            "reuse certification recorded on ${publication.head_oid}",
            command_result_fail(2, verdict.reason),
          ),
        ],
    }
  }
  return {
    proceed: true,
    reused: verdict.decision == "reuse",
    steps: initial_steps
      + [
        recorded_step(
          "reuse-attempt-certification",
          "reuse certification recorded on ${publication.head_oid}",
          command_result_ok(verdict.reason + "\n"),
        ),
      ],
  }
}
