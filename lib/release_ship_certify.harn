import { ReleaseAnalysis } from "./release_analysis"
import { run_release_candidate_certification } from "./release_candidate_certification"
import { ReleasePublication } from "./release_publication"
import { ReleaseShipPrepareReady } from "./release_ship_prepare"
import { pre_certification_cutoff_gate } from "./release_tag"

pub type ReleaseShipCertifyStopped = {proceed: bool, steps: list<dict>}

pub type ReleaseShipCertified = {
  proceed: bool,
  steps: list<dict>,
  analysis: ReleaseAnalysis,
  version: string,
  publication: ReleasePublication,
}

pub type ReleaseShipCertifyResult = ReleaseShipCertifyStopped | ReleaseShipCertified

pub fn release_ship_certify_phase(
  harness: Harness,
  cfg: dict,
  prepared: ReleaseShipPrepareReady,
  run_id: string,
) -> ReleaseShipCertifyResult {
  let steps = prepared.steps
  const version = prepared.version
  const publication = prepared.publication
  // Prove the frozen candidate still descends from main before spending on its
  // certification. The public tag is born only after this candidate's PR merges.
  const cutoff_gate = pre_certification_cutoff_gate(harness, cfg, version, steps, run_id)
  steps = cutoff_gate.steps
  if !cutoff_gate.proceed {
    return {proceed: false, steps: steps}
  }
  // The immutable publication is the single certification subject. Hosted
  // platform/local-source proof, the Linux release-size proof, and the
  // candidate-archive matrix fan out from this exact OID; only their residual
  // generated-content audit follows the join. A red or incomplete lane blocks
  // PR publication.
  if !(cfg.skip_tag ?? false) {
    const certification = run_release_candidate_certification(
      harness,
      cfg,
      publication,
      steps,
      run_id,
    )
    steps = certification.steps
    if !certification.success {
      return {proceed: false, steps: steps}
    }
  }
  return {
    proceed: true,
    steps: steps,
    analysis: prepared.analysis,
    version: version,
    publication: publication,
  }
}
