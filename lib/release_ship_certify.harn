import {
  CandidateArchiveCertificationBindingResult,
  bind_certified_candidate_archive,
  candidate_archive_certification_step,
} from "./candidate_archive_certification"
import { ReleaseAnalysis } from "./release_analysis"
import {
  ReleaseCandidateCertificationResult,
  run_release_candidate_certification,
} from "./release_candidate_certification"
import { ReleasePublication } from "./release_publication"
import { ReleaseShipPrepareReady } from "./release_ship_prepare"
import { pre_certification_cutoff_gate } from "./release_tag"

pub type ReleaseShipCertifyStopped = {proceed: bool, steps: list<dict>}

pub type ReleaseShipCertified = {
  proceed: bool,
  steps: list<dict>,
  analysis: ReleaseAnalysis,
  version: string,
  publication: ReleasePublication,
}

pub type ReleaseShipCertifyResult = ReleaseShipCertifyStopped | ReleaseShipCertified

pub type Certifier = fn(ReleasePublication, list<dict>) -> ReleaseCandidateCertificationResult

pub type ReleaseShipCandidateCertificationGate = {steps: list<dict>, success: bool}

pub type CandidateArchiveCertificationBinder = fn() -> CandidateArchiveCertificationBindingResult

/** Enter the canonical candidate-certification owner, including on recovery. */
pub fn release_ship_candidate_certification_gate(
  cfg: dict,
  publication: ReleasePublication,
  steps: list<dict>,
  certify: Certifier,
) -> ReleaseShipCandidateCertificationGate {
  if cfg.skip_tag ?? false {
    return {steps: steps, success: true}
  }
  const result = certify(publication, steps)
  return {steps: result.steps, success: result.success}
}

/** A candidate is not certified until its exact archive run is durably bound. */
pub fn release_ship_candidate_archive_binding_gate(
  cfg: dict,
  steps: list<dict>,
  bind: CandidateArchiveCertificationBinder,
) -> ReleaseShipCandidateCertificationGate {
  if cfg.skip_tag ?? false {
    return {steps: steps, success: true}
  }
  const binding = bind()
  return {steps: steps + [candidate_archive_certification_step(binding)], success: binding.success}
}

pub fn release_ship_certify_phase(
  harness: Harness,
  cfg: dict,
  prepared: ReleaseShipPrepareReady,
  run_id: string,
) -> ReleaseShipCertifyResult {
  let steps = prepared.steps
  const version = prepared.version
  const publication = prepared.publication
  // Prove the frozen candidate still descends from main before spending on its
  // certification. The public tag selects this candidate independently of PR merge.
  const cutoff_gate = pre_certification_cutoff_gate(harness, cfg, version, steps, run_id)
  steps = cutoff_gate.steps
  if !cutoff_gate.proceed {
    return {proceed: false, steps: steps}
  }
  // The immutable publication is the single certification subject. Hosted
  // platform/local-source proof, the Linux release-size proof, and the
  // candidate-archive matrix fan out from this exact OID; only their residual
  // generated-content audit follows the join. A red or incomplete lane blocks
  // PR publication.
  // An adopted attempt re-enters the same certification owner as a new one.
  // Each child gate can reuse its own exact workflow/run receipt, but a list
  // of same-named commit checks cannot prove workflow identity, the archive
  // matrix, the local source lane, or the binary-size lane. Keeping reuse at
  // those owning gates avoids a second, weaker certification system here.
  const certification = release_ship_candidate_certification_gate(
    cfg,
    publication,
    steps,
    fn(subject, prior_steps) { return run_release_candidate_certification(
      harness,
      cfg,
      subject,
      prior_steps,
      run_id,
    ) },
  )
  steps = certification.steps
  if !certification.success {
    return {proceed: false, steps: steps}
  }
  // The archive lane proves one run, but only the three-lane join certifies the
  // candidate. Persist that exact run after the join so a fresh recovery never
  // guesses between byte-different rebuilds of the same source commit.
  const archive_binding = release_ship_candidate_archive_binding_gate(
    cfg,
    steps,
    fn() { return bind_certified_candidate_archive(harness, cfg, publication) },
  )
  steps = archive_binding.steps
  if !archive_binding.success {
    return {proceed: false, steps: steps}
  }
  return {
    proceed: true,
    steps: steps,
    analysis: prepared.analysis,
    version: version,
    publication: publication,
  }
}
