import { command_result_fail, command_result_ok } from "std/command"
import { interrupted } from "std/signal"
import { run_release_candidate_archive_gate } from "./candidate_archive_gate"
import {
  LaneAbortProbe,
  PlatformCertificationCancellationReceipt,
  cancel_recorded_platform_certification_runs,
  platform_certification_dispatch_registry,
} from "./platform_certification"
import { logged_live_shell_command_step } from "./release_agent"
import { execution_failed, recorded_step } from "./release_execution"
import {
  ReleasePrepareAuditConfig,
  ReleasePrepareAuditEvidence,
  release_candidate_audit_evidence,
  release_candidate_residual_audit_command,
} from "./release_prepare"
import { ReleasePublication } from "./release_publication"
import { release_log_event } from "./release_runtime"
import { run_pre_tag_binary_size_gate } from "./release_tag"

pub type CandidateCertificationTiming = {
  started_at_ms: int,
  completed_at_ms: int,
  duration_ms: int,
  critical_path: string,
}

pub type CandidateCertificationTimingLane = {
  name: CandidateCertificationLaneName,
  started_at_ms: int,
  completed_at_ms: int,
}

pub type ReleaseCandidateCertificationResult = {
  steps: list<dict>,
  success: bool,
  timing: CandidateCertificationTiming,
}

pub type CandidateCertificationLaneName = "platform" | "binary_size" | "archive"

pub type CandidateCertificationLaneStatus = "success" | "failed" | "cancelled" | "interrupted"

pub type CandidateCertificationCancellation = {
  kind: "sibling_failure" | "user_interruption",
  cause: string,
}

pub type CertificationCleanup = list<PlatformCertificationCancellationReceipt>

pub type CertificationCancelRequest = {lane: CandidateCertificationLaneName, cause: string}

pub type CandidateCertificationAbortReason = {
  kind: "lane_failed",
  lane: CandidateCertificationLaneName,
  cause: string,
} \
  | {kind: "user_interruption", cause: string}

pub type CandidateCertificationLaneResult = {
  success: bool,
  steps: list<dict>,
  evidence: ReleasePrepareAuditEvidence?,
  error: string?,
}

pub type CandidateCertificationLaneReceipt = {
  name: CandidateCertificationLaneName,
  success: bool,
  status: CandidateCertificationLaneStatus,
  steps: list<dict>,
  evidence: ReleasePrepareAuditEvidence?,
  started_at_ms: int,
  completed_at_ms: int,
  error: string?,
  cancellation: CandidateCertificationCancellation?,
  cleanup: CertificationCleanup,
}

pub type CandidateCertificationLaneRun = {
  lanes: list<CandidateCertificationLaneReceipt>,
  abort_reason: CandidateCertificationAbortReason?,
}

pub type CandidateCertificationLaneSummary = {
  name: CandidateCertificationLaneName,
  success: bool,
  status: CandidateCertificationLaneStatus,
  started_at_ms: int,
  completed_at_ms: int,
  error: string?,
  cancellation: CandidateCertificationCancellation?,
  cleanup: CertificationCleanup,
}

pub type CertificationCanceller = fn(CertificationCancelRequest) -> CertificationCleanup

pub type CandidateCertificationInterruptProbe = fn() -> bool

fn now_ms(harness: HarnessClock) -> int {
  return (to_int(date_parse(harness.date_iso())) ?? 0) * 1000
}

fn certification_critical_path(lanes: list<CandidateCertificationTimingLane>) -> string {
  let name = ""
  let longest = -1
  for lane in lanes {
    const duration = lane.completed_at_ms - lane.started_at_ms
    if duration > longest {
      longest = duration
      name = lane.name
    }
  }
  return name
}

const CANDIDATE_CERTIFICATION_LANES: list<CandidateCertificationLaneName> = [
  "platform",
  "binary_size",
  "archive",
]

fn publish_lane_failure(
  runtime: HarnessRuntime,
  abort: any,
  lane: CandidateCertificationLaneName,
  cause: string,
) -> nil {
  const snapshot = runtime.shared_snapshot(abort)
  if snapshot.value == nil {
    let _ = runtime.shared_cas(abort, snapshot, {kind: "lane_failed", lane: lane, cause: cause})
  }
  return nil
}

fn summarize_lane(lane: CandidateCertificationLaneReceipt) -> CandidateCertificationLaneSummary {
  return {
    name: lane.name,
    success: lane.success,
    status: lane.status,
    started_at_ms: lane.started_at_ms,
    completed_at_ms: lane.completed_at_ms,
    error: lane.error,
    cancellation: lane.cancellation,
    cleanup: lane.cleanup,
  }
}

/**
 * Run exact-candidate lanes fail-fast while retaining a receipt for every lane.
 *
 * A terminal result is written before its task throws. Structured `parallel`
 * cancellation then interrupts in-flight siblings; the parent join owns the
 * cancelled receipt and cleanup when an aborted child cannot run its epilogue.
 *
 * Cancellation only reaches a lane at a suspension point, so a lane that waits
 * on hosted work also receives this run's abort as its second argument. It is
 * a read-only probe: a lane checks it between polls to stop early, and only
 * this function decides what an abort reason says.
 */
pub fn run_candidate_certification_lanes(
  runtime: HarnessRuntime,
  random: HarnessRandom,
  runner: fn(CandidateCertificationLaneName, LaneAbortProbe) -> CandidateCertificationLaneResult,
  clock: fn() -> int,
  canceller: CertificationCanceller? = nil,
  interrupt_probe: CandidateCertificationInterruptProbe = interrupted,
) -> CandidateCertificationLaneRun {
  const invocation = random.uuid_v7()
  const run_started = clock()
  const receipts = runtime.shared_map(
    {scope: "task_group", key: "candidate_certification_receipts_${invocation}"},
  )
  const starts = runtime.shared_map(
    {scope: "task_group", key: "candidate_certification_starts_${invocation}"},
  )
  const abort = runtime.shared_cell(
    {scope: "task_group", key: "candidate_certification_abort_${invocation}", initial: nil},
  )
  try {
    let _ = parallel each CANDIDATE_CERTIFICATION_LANES with {
      max_concurrent: len(CANDIDATE_CERTIFICATION_LANES),
    } { name ->
      const started = clock()
      runtime.shared_map_set(starts, name, started)
      let terminal = false
      try {
        let raw: CandidateCertificationLaneResult = {
          success: false,
          steps: [],
          evidence: nil,
          error: "lane did not return a verdict",
        }
        try {
          raw = runner(name, {cell: abort})
        } catch (error) {
          const cause = to_string(error)
          if interrupt_probe() {
            const snapshot = runtime.shared_snapshot(abort)
            if snapshot.value == nil {
              let _ = runtime.shared_cas(
                abort,
                snapshot,
                {kind: "user_interruption", cause: "release certification interrupted by operator"},
              )
            }
            throw "candidate certification interrupted"
          }
          const failed: CandidateCertificationLaneReceipt = {
            name: name,
            success: false,
            status: "failed",
            steps: [],
            evidence: nil,
            started_at_ms: started,
            completed_at_ms: clock(),
            error: cause,
            cancellation: nil,
            cleanup: [],
          }
          runtime.shared_map_set(receipts, name, failed)
          terminal = true
          publish_lane_failure(runtime, abort, name, cause)
          throw "candidate certification lane failed"
        }
        const succeeded = raw.success
        const lane_status: CandidateCertificationLaneStatus = if succeeded {
          "success"
        } else {
          "failed"
        }
        const completed: CandidateCertificationLaneReceipt = {
          name: name,
          success: succeeded,
          status: lane_status,
          steps: raw.steps,
          evidence: raw.evidence,
          started_at_ms: started,
          completed_at_ms: clock(),
          error: if succeeded {
            nil
          } else {
            trim(raw.error ?? "lane returned a failing verdict")
          },
          cancellation: nil,
          cleanup: [],
        }
        runtime.shared_map_set(receipts, name, completed)
        terminal = true
        if !succeeded {
          publish_lane_failure(runtime, abort, name, completed.error ?? "lane failed")
          throw "candidate certification lane failed"
        }
      } finally {
        if !terminal {
          const reason = runtime.shared_get(abort)
          const user_interruption = reason?.kind == "user_interruption"
          const cause = trim(
            reason?.cause
              ?? if user_interruption {
                "release certification interrupted by operator"
              } else {
                "a sibling lane failed"
              },
          )
          const cancelled: CandidateCertificationLaneReceipt = {
            name: name,
            success: false,
            status: if user_interruption {
              "interrupted"
            } else {
              "cancelled"
            },
            steps: [],
            evidence: nil,
            started_at_ms: started,
            completed_at_ms: clock(),
            error: nil,
            cancellation: {
              kind: if user_interruption {
                "user_interruption"
              } else {
                "sibling_failure"
              },
              cause: cause,
            },
            cleanup: [],
          }
          runtime.shared_map_set(receipts, name, cancelled)
        }
      }
      return nil
    }
  } catch (error) {
    // The terminal lane receipt and the cancelled sibling receipts are the
    // durable error surface. The thrown sentinel exists only to trigger
    // structured cancellation.
    if runtime.shared_get(abort) == nil {
      throw error
    }
  }
  let lanes: list<CandidateCertificationLaneReceipt> = []
  for name in CANDIDATE_CERTIFICATION_LANES {
    let lane = runtime.shared_map_get(receipts, name, nil)
    if lane == nil {
      const reason = runtime.shared_get(abort)
      if reason == nil {
        throw "candidate certification lane '${name}' produced no terminal receipt"
      }
      const user_interruption = reason?.kind == "user_interruption"
      const cause = trim(
        reason?.cause
          ?? if user_interruption {
            "release certification interrupted by operator"
          } else {
            "a sibling lane failed"
          },
      )
      lane = {
        name: name,
        success: false,
        status: if user_interruption {
          "interrupted"
        } else {
          "cancelled"
        },
        steps: [],
        evidence: nil,
        started_at_ms: runtime.shared_map_get(starts, name, run_started),
        completed_at_ms: clock(),
        error: nil,
        cancellation: {
          kind: if user_interruption {
            "user_interruption"
          } else {
            "sibling_failure"
          },
          cause: cause,
        },
        cleanup: [],
      }
    }
    if (lane.status == "cancelled" || lane.status == "interrupted") && canceller != nil {
      lane = {
        ...lane,
        cleanup: canceller(
          {lane: name, cause: lane.cancellation?.cause ?? "a sibling lane failed"},
        ),
      }
    }
    runtime.shared_map_set(receipts, name, lane)
    lanes = lanes + [lane]
  }
  return {lanes: lanes, abort_reason: runtime.shared_get(abort)}
}

/** Join independent exact-candidate lanes by elapsed wall time, never by their sum. */
pub fn release_candidate_certification_join(
  lanes: list<CandidateCertificationTimingLane>,
) -> CandidateCertificationTiming {
  if len(lanes) == 0 {
    return {started_at_ms: 0, completed_at_ms: 0, duration_ms: 0, critical_path: ""}
  }
  const first = lanes[0]
  if first == nil {
    throw "non-empty certification lane list has no first receipt"
  }
  let started = first.started_at_ms
  let completed = first.completed_at_ms
  for lane in lanes {
    started = min(started, lane.started_at_ms)
    completed = max(completed, lane.completed_at_ms)
  }
  return {
    started_at_ms: started,
    completed_at_ms: completed,
    duration_ms: completed - started,
    critical_path: certification_critical_path(lanes),
  }
}

/**
 * Certify one immutable release candidate through independent hosted/local and
 * Linux-size lanes. Only the residual generated-content audit follows the join.
 */
pub fn run_release_candidate_certification(
  harness: Harness,
  cfg: dict,
  publication: ReleasePublication,
  steps: list<dict>,
  run_id: string,
) -> ReleaseCandidateCertificationResult {
  const audit_cfg: ReleasePrepareAuditConfig = {
    mock: cfg.mock,
    local_audit: cfg.local_audit,
    pin_sha: cfg.pin_sha,
    repo: cfg.repo,
    base: cfg.base,
    release_cargo_target_dir: cfg.release_cargo_target_dir,
    bootstrap_new_crates: cfg.bootstrap_new_crates,
    bump: cfg.bump,
    preid: cfg.preid ?? "",
  }
  const platform_dispatches = platform_certification_dispatch_registry(
    harness.runtime,
    "candidate_platform_dispatches_${run_id}",
  )
  const lane_run = run_candidate_certification_lanes(
    harness.runtime,
    harness.random,
    { kind, abort ->
      if kind == "platform" {
        const evidence = release_candidate_audit_evidence(
          harness,
          audit_cfg,
          publication,
          run_id,
          platform_dispatches,
          abort,
        )
        return {
          success: evidence.receipt_path != ""
            && evidence.harn_bin != ""
            && !execution_failed(evidence.steps),
          steps: evidence.steps,
          evidence: evidence,
          error: "platform certification failed",
        }
      }
      if kind == "archive" {
        const archive = run_release_candidate_archive_gate(harness, cfg, publication, [], run_id)
        return {
          success: archive.success,
          steps: archive.steps,
          evidence: nil,
          error: "candidate archive certification failed",
        }
      }
      const binary = run_pre_tag_binary_size_gate(harness, cfg, publication, [], run_id)
      return {
        success: binary.success,
        steps: binary.steps,
        evidence: nil,
        error: "pre-tag binary-size certification failed",
      }
    },
    fn() { return now_ms(harness.clock) },
    { request ->
      if request.lane != "platform" {
        return []
      }
      return cancel_recorded_platform_certification_runs(
        harness,
        "burin-labs/harn",
        platform_dispatches,
        cfg.mock,
      )
    },
  )
  let merged_steps = steps
  const lanes = lane_run.lanes
  let platform_evidence: ReleasePrepareAuditEvidence? = nil
  let success = true
  for lane in lanes {
    merged_steps = merged_steps + lane.steps
    if lane.status == "cancelled" || lane.status == "interrupted" {
      success = false
      merged_steps = merged_steps
        + [
          recorded_step(
            if lane.status == "interrupted" {
              "candidate-certification-lane-interrupted"
            } else {
              "candidate-certification-lane-cancelled"
            },
            if lane.status == "interrupted" {
              "stop ${lane.name} certification after operator interruption"
            } else {
              "cancel ${lane.name} certification after sibling failure"
            },
            command_result_fail(130, lane.cancellation?.cause ?? "sibling lane failed"),
          ),
        ]
      continue
    }
    if !lane.success {
      success = false
      if lane.error != nil && len(lane.steps) == 0 {
        merged_steps = merged_steps
          + [
            recorded_step(
              "candidate-certification-lane",
              "run ${lane.name} exact-candidate certification lane",
              command_result_fail(2, lane.error ?? "certification lane failed"),
            ),
          ]
      }
    }
    if lane.name == "platform" && lane.success {
      platform_evidence = lane.evidence
    }
  }
  const timing = release_candidate_certification_join(lanes)
  const lane_summaries = lanes.map({ lane -> summarize_lane(lane) }).to_list()
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "release_candidate_certification_joined",
    {success: success, publication: publication, lanes: lane_summaries, join: timing},
  )
  const join_result = if success {
    command_result_ok(
      "exact-candidate lanes joined on ${timing.critical_path} in ${timing.duration_ms}ms\n",
    )
  } else {
    command_result_fail(2, "one or more exact-candidate certification lanes failed")
  }
  merged_steps = merged_steps
    + [
      {
        ...recorded_step(
          "candidate-certification-join",
          "join exact-candidate certification lanes",
          join_result,
        ),
        candidate_certification_timing: timing,
        candidate_certification_lanes: lane_summaries,
        publication: publication,
      },
    ]
  if !success || platform_evidence == nil {
    return {steps: merged_steps, success: false, timing: timing}
  }
  const residual = logged_live_shell_command_step(
    harness,
    cfg,
    merged_steps,
    "candidate-residual-audit",
    release_candidate_residual_audit_command(audit_cfg, platform_evidence),
    run_id,
  )
  return {steps: residual.steps, success: !execution_failed(residual.steps), timing: timing}
}
