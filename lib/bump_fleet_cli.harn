import { ParserSpec } from "std/cli/argparse"
import { strip_v } from "std/semver"
import { cli_options } from "./cli_options"
import { RunSessionViewFleetGate } from "./run_session_view_gate"

pub type FleetOptions = {
  target?: string,
  dry_run: bool,
  only?: string,
  no_chat: bool,
  chat_only: bool,
  chat_run: string,
  chat_timeout_s: int,
  retry_failed: int,
  harn_repo: string,
  fleet_root?: string,
}

const ARG_SPEC: ParserSpec = {
  name: "bump-fleet",
  args: [
    {kind: "positional", name: "target", required: false},
    {kind: "switch", name: "dry_run", long: "--dry-run"},
    {kind: "flag", name: "only", long: "--only"},
    {kind: "switch", name: "no_chat", long: "--no-chat"},
    {kind: "switch", name: "chat_only", long: "--chat-only"},
    {kind: "flag", name: "chat_run", long: "--chat-run", default: ""},
    {kind: "flag", name: "chat_timeout_s", long: "--chat-timeout-s", parse: "int", default: 60},
    {kind: "flag", name: "retry_failed", long: "--retry-failed", parse: "int", default: 0},
    {kind: "flag", name: "harn_repo", long: "--harn-repo", default: ""},
    {kind: "flag", name: "fleet_root", long: "--fleet-root"},
  ],
}

pub fn parse_fleet_args(args: list<string>) -> FleetOptions {
  let parsed = cli_options<FleetOptions>(ARG_SPEC, args, schema_of(FleetOptions))
  if parsed.retry_failed < 0 {
    parsed.retry_failed = 0
  }
  return parsed
}

pub fn skipped_run_session_view_gate(target: string, reason: string) -> RunSessionViewFleetGate {
  return {
    ok: true,
    skipped: true,
    check: {
      name: "check-run-view-fixtures",
      command: "(skipped)",
      success: true,
      ok: true,
      status: "completed",
      exit_code: 0,
      stdout: "",
      stderr: "",
    },
    cargo_target_dir: "",
    metadata_ok: true,
    expected_json_count: 0,
    parse_errors: [],
    schemas: [],
    summary_line: reason,
    repo_version: "",
    target_version: strip_v(target ?? ""),
    target_change: {
      known: false,
      changed: false,
      base_tag: "",
      target_tag: target,
      paths: [],
      detail: reason,
    },
  }
}
