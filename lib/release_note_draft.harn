import { ReleaseAgentReviewResult } from "./release_agent"
import { ReleaseAnalysis } from "./release_analysis"
import { release_run_dir } from "./release_paths"

fn release_commit_title(line: any) {
  const cleaned = trim(line ?? "")
  if cleaned == "" {
    return ""
  }
  return trim(regex_replace("^[0-9a-f]+\\s+", "", cleaned))
}

fn deterministic_release_commit_notes(analysis: any) {
  let notes = []
  for line in split(analysis.commits_since_latest_tag ?? "", "\n") {
    const title = release_commit_title(line)
    if title == "" {
      continue
    }
    const normalized = regex_replace("^\\[codex\\]\\s+", "", title)
    notes = notes + ["- " + normalized + "."]
  }
  return notes
}

fn deterministic_release_notes(analysis: any) {
  const unreleased = trim(analysis.changelog_unreleased_section ?? "")
  const commit_notes = deterministic_release_commit_notes(analysis)
  let parts = ["## v${analysis.next_version}"]
  if unreleased != "" {
    parts = parts + [unreleased]
  }
  if len(commit_notes) > 0 {
    parts = parts + ["### Changed\n\n" + join(commit_notes, "\n")]
  }
  return join(parts, "\n\n")
}

fn write_deterministic_release_notes(fs: HarnessFs, run_id: any, analysis: any) {
  const out_dir = release_run_dir(fs, run_id)
  fs.mkdir(out_dir, true)
  const path = path_join(out_dir, "deterministic-draft-changelog.md")
  fs.write_text(path, deterministic_release_notes(analysis) + "\n")
  return path
}

/** Select the agent draft when present, otherwise write a deterministic fallback. */
pub fn release_notes_draft_path(
  fs: HarnessFs,
  run_id: string,
  analysis: ReleaseAnalysis,
  agent_review_result: ReleaseAgentReviewResult,
) -> string {
  const draft_path = agent_review_result.draft_changelog
  if draft_path != nil && draft_path != "" {
    return draft_path
  }
  return write_deterministic_release_notes(fs, run_id, analysis)
}
