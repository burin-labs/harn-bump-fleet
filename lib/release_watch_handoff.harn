import { read_json_result, write_json } from "std/fs"
import { is_v_release_semver } from "std/semver"
import {
  ReleaseArchiveProducer,
  decode_release_archive_manifest,
} from "./release_archive_observation"
import { release_redact_secrets } from "./release_step_output"
import {
  ReleaseWatchReceipt,
  release_watch_receipt_path,
  release_watch_receipt_read,
  release_watch_receipt_write,
} from "./release_watch_state"
import { GithubPullRequestSummary, GithubWorkflowDispatchReceipt, GithubWorkflowRun } from "harn-github-connector/default"

pub type HostedReleaseWatchDownload = {success: bool, message: string}

pub type HostedReleaseWatchAdapter = {download: fn(int, string) -> HostedReleaseWatchDownload}

/** The workflow owner prepares the PR; this receipt only remembers its handoff. */
pub type ReleaseWorkflowHandoff = {
  schema: "harn.release_workflow_handoff.v1",
  repository: "burin-labs/harn",
  opener_run_id: int,
  opener_run_attempt: int,
  opener_source: string,
  release_pr_number: int,
  release_tag: string,
  prepared_source: string,
  merged_source: string,
  producer_run_id: int,
  producer_run_attempt: int,
  producer: ReleaseArchiveProducer?,
}

fn exact_source(source: string) -> bool {
  return len(regex_captures("^[0-9a-f]{40}$", source)) == 1
}

fn validate_workflow_handoff(receipt: ReleaseWorkflowHandoff) -> ReleaseWorkflowHandoff {
  if receipt.opener_run_id <= 0 || receipt.opener_run_attempt <= 0
    || !exact_source(receipt.opener_source) {
    throw "release opener handoff has no exact workflow attempt"
  }
  if receipt.merged_source != "" && !exact_source(receipt.merged_source) {
    throw "release handoff merged source is not an exact commit"
  }
  if receipt.release_pr_number < 0 || receipt.producer_run_id < 0
    || receipt.producer_run_attempt < 0 {
    throw "release handoff identities must be positive when selected"
  }
  if receipt.release_pr_number == 0 {
    if receipt.release_tag != "" || receipt.prepared_source != "" || receipt.merged_source != "" {
      throw "release handoff source has no selected release pull request"
    }
  } else if !is_v_release_semver(receipt.release_tag) || !exact_source(receipt.prepared_source) {
    throw "release handoff pull request has no exact prepared source and release tag"
  }
  if (receipt.producer_run_id == 0) != (receipt.producer_run_attempt == 0)
    || (receipt.producer_run_id > 0 && receipt.merged_source == "") {
    throw "release handoff producer selection has no exact attempt and merged source"
  }
  validate_certified_producer(receipt)
  return receipt
}

fn validate_certified_producer(receipt: ReleaseWorkflowHandoff) -> nil {
  const producer = receipt.producer
  if producer != nil {
    if receipt.merged_source == "" || producer.repository != receipt.repository
      || producer.workflow != "build-release-binaries.yml"
      || producer.source != receipt.merged_source || producer.run_id <= 0
      || producer.run_attempt <= 0 || producer.status != "completed"
      || producer.conclusion != "success" || producer.run_id != receipt.producer_run_id
      || producer.run_attempt != receipt.producer_run_attempt {
      throw "release handoff producer is not successful certification of the merged source"
    }
  }
}

/** An accepted dispatch is pending work, never a completed release. */
pub fn release_workflow_handoff(dispatch: GithubWorkflowDispatchReceipt) -> ReleaseWorkflowHandoff {
  if !dispatch.accepted || dispatch.repo != "burin-labs/harn"
    || dispatch.workflow_path != ".github/workflows/bump-release.yml"
    || dispatch.ref != "main" || dispatch.head_branch != "main"
    || dispatch.event != "workflow_dispatch" {
    throw "release handoff requires the no-input Harn main workflow opener"
  }
  return validate_workflow_handoff(
    {
      schema: "harn.release_workflow_handoff.v1",
      repository: "burin-labs/harn",
      opener_run_id: dispatch.run_id,
      opener_run_attempt: dispatch.run_attempt ?? 0,
      opener_source: dispatch.head_sha,
      release_pr_number: 0,
      release_tag: "",
      prepared_source: "",
      merged_source: "",
      producer_run_id: 0,
      producer_run_attempt: 0,
      producer: nil,
    },
  )
}

/** Record an explicitly observed canonical release PR without running another version selector. */
pub fn release_workflow_handoff_bind_pr(
  receipt: ReleaseWorkflowHandoff,
  pr: GithubPullRequestSummary,
) -> ReleaseWorkflowHandoff {
  validate_workflow_handoff(receipt)
  const tag = pr.title.substring(len("Release "))
  if pr.repo != receipt.repository || pr.number <= 0 || pr.draft
    || !starts_with(pr.title, "Release ") || !is_v_release_semver(tag)
    || pr.base.ref != "main" || pr.head.ref != "release/${tag}"
    || pr.base.owner + "/" + pr.base.repo != receipt.repository
    || pr.head.owner + "/" + pr.head.repo != receipt.repository
    || !exact_source(pr.head.sha) || (!pr.merged && lowercase(pr.github_state) == "closed") {
    throw "release handoff requires the canonical Harn release pull request"
  }
  if receipt.release_pr_number != 0
    && (receipt.release_pr_number != pr.number || receipt.release_tag != tag
      || receipt.prepared_source != pr.head.sha) {
    throw "release handoff cannot replace its selected release pull request"
  }
  const merged = if pr.merged { pr.merge_commit_oid ?? "" } else { "" }
  if pr.merged && !exact_source(merged) {
    throw "merged release pull request has no exact merge commit"
  }
  if receipt.merged_source != "" && receipt.merged_source != merged {
    throw "release handoff cannot replace or unmerge its observed source"
  }
  return validate_workflow_handoff(
    receipt + {
      release_pr_number: pr.number,
      release_tag: tag,
      prepared_source: pr.head.sha,
      merged_source: merged,
    },
  )
}

/** Pin the actual run attempt before polling it, including when certification is pending or failed. */
pub fn release_workflow_handoff_select_producer(
  receipt: ReleaseWorkflowHandoff,
  run: GithubWorkflowRun,
) -> ReleaseWorkflowHandoff {
  validate_workflow_handoff(receipt)
  const attempt = run.run_attempt ?? 0
  if receipt.merged_source == "" || run.repo != receipt.repository || run.id <= 0
    || attempt <= 0 || run.workflow_path != ".github/workflows/build-release-binaries.yml"
    || run.head_sha != receipt.merged_source {
    throw "release producer run is not bound to the actual merged source"
  }
  if receipt.producer_run_id > 0
    && (receipt.producer_run_id != run.id || receipt.producer_run_attempt != attempt) {
    throw "release handoff cannot replace its selected producer attempt"
  }
  return validate_workflow_handoff(receipt + {producer_run_id: run.id, producer_run_attempt: attempt})
}

/** Bind the producer once, using its actual manifest, not a promoter's head. */
pub fn release_workflow_handoff_bind_producer(
  receipt: ReleaseWorkflowHandoff,
  merged_source: string,
  producer: ReleaseArchiveProducer,
  manifest_text: string,
) -> ReleaseWorkflowHandoff {
  validate_workflow_handoff(receipt)
  const decoded = decode_release_archive_manifest(manifest_text)
  if is_err(decoded) {
    throw unwrap_err(decoded)
  }
  const manifest = unwrap(decoded)
  if manifest.repository != receipt.repository || manifest.sourceCommit != merged_source
    || to_int(manifest.runId) != producer.run_id
    || to_int(manifest.runAttempt) != producer.run_attempt {
    throw "release handoff producer differs from the exact candidate manifest"
  }
  if receipt.producer_run_id != producer.run_id || receipt.producer_run_attempt != producer.run_attempt {
    throw "release certification differs from its selected producer attempt"
  }
  if receipt.merged_source != "" && receipt.merged_source != merged_source {
    throw "release handoff cannot replace its merged source"
  }
  if receipt.producer != nil && receipt.producer != producer {
    throw "release handoff cannot replace its bound producer attempt"
  }
  return validate_workflow_handoff(receipt + {merged_source: merged_source, producer: producer})
}

/** Malformed, missing, and legacy custody records refuse canonical observation. */
pub fn release_workflow_handoff_read(fs: HarnessFs, path: string) -> Result<ReleaseWorkflowHandoff, string> {
  const loaded = read_json_result(fs, path)
  if is_err(loaded) {
    return Err("release workflow handoff is missing or unreadable")
  }
  const checked = schema_check(unwrap(loaded), schema_of(ReleaseWorkflowHandoff))
  if is_err(checked) {
    return Err("release workflow handoff does not match its contract")
  }
  return try {
    Ok(validate_workflow_handoff(unwrap(checked)))
  } catch (error) {
    Err(to_string(error))
  }
}

/** Persist before observing; resumption cannot silently select another producer. */
pub fn release_workflow_handoff_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  path: string,
  receipt: ReleaseWorkflowHandoff,
) -> string {
  validate_workflow_handoff(receipt)
  if harness.fs.exists(path) {
    const existing = release_workflow_handoff_read(harness.fs, path)
    if is_err(existing) {
      throw unwrap_err(existing)
    }
    const prior = unwrap(existing)
    if prior.opener_run_id != receipt.opener_run_id
      || prior.opener_run_attempt != receipt.opener_run_attempt
      || prior.opener_source != receipt.opener_source
      || (prior.release_pr_number > 0 && prior.release_pr_number != receipt.release_pr_number)
      || (prior.release_tag != "" && prior.release_tag != receipt.release_tag)
      || (prior.prepared_source != "" && prior.prepared_source != receipt.prepared_source)
      || (prior.merged_source != "" && prior.merged_source != receipt.merged_source)
      || (prior.producer_run_id > 0 && prior.producer_run_id != receipt.producer_run_id)
      || (prior.producer_run_attempt > 0 && prior.producer_run_attempt != receipt.producer_run_attempt)
      || (prior.producer != nil && prior.producer != receipt.producer) {
      throw "release workflow handoff cannot overwrite its recorded identity"
    }
  }
  const temporary = path + ".tmp-" + harness.random.uuid_v7()
  write_json(harness.fs, temporary, receipt, {pretty: true})
  harness.fs.rename(temporary, path)
  return path
}

const HOSTED_RELEASE_WATCH_DOWNLOAD_ATTEMPTS = 3

fn safe_download_detail(message: string) -> string {
  const without_queries = regex_replace(
    "(https://[^ ?\\n]+)[?][^ \\n]+",
    "$1?[redacted-query]",
    message ?? "",
  )
  return release_redact_secrets(without_queries)
}

pub type HostedReleaseWatchImport = {
  repo_root: string,
  tag: string,
  run_id: int,
  destination: string,
}

fn production_adapter(process: HarnessProcess, cwd: string) -> HostedReleaseWatchAdapter {
  return {
    download: fn(run_id, destination) {
      const attempted = process.run(
        {
          program: path_join(cwd, "scripts", "download_github_artifact.sh"),
          args: [to_string(run_id), "release-run-${run_id}-attempt-*", destination],
          cwd: cwd,
        },
      )
      const result = if attempted.success {
        attempted
      } else {
        process.run(
          {
            program: path_join(cwd, "scripts", "download_github_artifact.sh"),
            args: [to_string(run_id), "release-run-${run_id}", destination],
            cwd: cwd,
          },
        )
      }
      const message = if trim(result.stderr) != "" {
        trim(result.stderr)
      } else {
        trim(result.stdout)
      }
      return {success: result.success, message: message}
    },
  }
}

fn hosted_receipt_roots(fs: HarnessFs, staging_root: string, run_id: int) -> list<string> {
  const prefix = "release-run-${run_id}-attempt-"
  const attempts = fs.list_dir(staging_root).filter({ name -> starts_with(name, prefix) }).sort_by(
    { name -> 0 - (to_int(name.substring(len(prefix))) ?? 0) },
  )
    .map({ name -> path_join(staging_root, name) })
    .to_list()
  return attempts + [staging_root]
}

/**
 * Import the typed watch receipt uploaded by one exact hosted release run.
 *
 * An existing valid receipt wins because the local watcher may have advanced
 * it beyond the immutable handoff captured by the hosted job.
 */
pub fn import_hosted_release_watch_receipt(
  harness: Harness,
  input: HostedReleaseWatchImport,
  adapter: HostedReleaseWatchAdapter? = nil,
) -> ReleaseWatchReceipt {
  if input.run_id < 1 {
    throw "--hosted-run must be a positive GitHub Actions run ID"
  }
  const existing = release_watch_receipt_read(harness.fs, input.destination)
  if existing != nil {
    if existing.tag != input.tag {
      throw "receipt tag ${existing.tag} does not match requested ${input.tag}"
    }
    return existing
  }
  if harness.fs.exists(input.destination) {
    throw "existing release watch receipt is invalid: " + input.destination
  }
  const downloader = adapter ?? production_adapter(harness.process, input.repo_root)
  let staging_root = ""
  let last_download_error = ""
  let download_attempt = 0
  while download_attempt < HOSTED_RELEASE_WATCH_DOWNLOAD_ATTEMPTS && staging_root == "" {
    download_attempt = download_attempt + 1
    const attempt_root = harness.fs.mkdtemp_in_workspace("hosted-release-watch-")
    const downloaded = downloader.download(input.run_id, attempt_root)
    if downloaded.success {
      staging_root = attempt_root
    } else {
      last_download_error = safe_download_detail(downloaded.message)
      harness.fs.delete(attempt_root)
    }
  }
  if staging_root == "" {
    throw "could not download release-run-${input.run_id} after ${download_attempt} attempts: "
      + last_download_error
  }
  return try {
    // `upload-artifact` stores the contents matched by `.harn-runs/**` at the
    // artifact root, while older fixtures and manually assembled archives may
    // preserve the `.harn-runs` directory itself. Resolve that packaging seam
    // once here; the persisted receipt has only one canonical local path.
    for root in hosted_receipt_roots(harness.fs, staging_root, input.run_id) {
      const sources = [
        release_watch_receipt_path(path_join(root, "release-harn"), input.tag),
        release_watch_receipt_path(path_join(root, ".harn-runs", "release-harn"), input.tag),
      ]
      const present = sources.filter({ source -> harness.fs.exists(source) }).to_list()
      if len(present) > 1 {
        const uploaded = release_watch_receipt_read(harness.fs, present[0])
        const nested = release_watch_receipt_read(harness.fs, present[1])
        if uploaded == nil || nested == nil || uploaded != nested {
          throw "hosted release run ${input.run_id} contained conflicting watch receipts for ${input.tag}"
        }
      }
      if len(present) > 0 {
        const receipt = release_watch_receipt_read(harness.fs, present[0])
        if receipt != nil {
          if receipt.tag != input.tag {
            throw "hosted release receipt tag ${receipt.tag} does not match requested ${input.tag}"
          }
          release_watch_receipt_write(pick(harness, ["fs", "random"]), input.destination, receipt)
          return receipt
        }
      }
    }
    throw "hosted release run ${input.run_id} did not contain a valid watch receipt for ${input.tag}"
  } finally {
    harness.fs.delete(staging_root)
  }
}
