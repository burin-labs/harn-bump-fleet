/**
 * Post-tag publish-health decisions. The fleet is tag-first: the harn-side
 * `publish-release.yml` and `build-release-binaries.yml` fire on the tag push,
 * so the heavy release-build checks only run AFTER the tag exists and cannot
 * gate it. This module classifies the tag-triggered workflow runs the fleet
 * polls after tagging, and renders the operator-facing yank path when a
 * published release lands red.
 *
 * Logic stays pure so the poll loop can be exercised with synthetic run rows.
 */
/** Conclusions that mean a workflow run finished in a non-recoverable bad state. */
fn is_failed_conclusion(conclusion) {
  let c = lowercase(trim(conclusion ?? ""))
  return c == "failure" || c == "cancelled" || c == "timed_out"
    || c == "startup_failure"
    || c == "stale"
    || c == "action_required"
}

fn is_success_conclusion(conclusion) {
  return lowercase(trim(conclusion ?? "")) == "success"
}

fn run_completed(run) {
  return lowercase(trim(run?.status ?? "")) == "completed"
}

/**
 * Classify publish health from observed tag-triggered workflow runs.
 *
 * `runs` is a list of normalized rows keyed by `workflow` plus the
 * `gh run list --json status,conclusion` fields. `required_workflows` is the
 * set of workflow identifiers that must each show a completed+success run for
 * the publish to count as healthy.
 *
 * Returns `{state, message}` with state:
 *   "failed"  — at least one observed run concluded in a bad state.
 *   "healthy" — every required workflow has a completed+success run.
 *   "pending" — required runs are still queued/in_progress (or unobserved).
 */
pub fn publish_watch_decision(inputs) {
  let runs = inputs.runs ?? []
  let required = inputs.required_workflows ?? []
  let tag = trim(inputs.tag ?? "v<unknown>")
  var failed_workflows = []
  for run in runs {
    if run_completed(run) && is_failed_conclusion(run?.conclusion) {
      failed_workflows = failed_workflows + [to_string(run?.workflow ?? "(unknown workflow)")]
    }
  }
  if len(failed_workflows) > 0 {
    let failed_list = failed_workflows.join(", ")
    return {state: "failed", message: "publish for ${tag} is red: ${failed_list} concluded in a failed state"}
  }
  var unsatisfied = []
  for workflow in required {
    var satisfied = false
    for run in runs {
      if to_string(run?.workflow ?? "") == to_string(workflow) && run_completed(run)
        && is_success_conclusion(run?.conclusion) {
        satisfied = true
      }
    }
    if !satisfied {
      unsatisfied = unsatisfied + [to_string(workflow)]
    }
  }
  if len(unsatisfied) == 0 && len(required) > 0 {
    return {state: "healthy", message: "publish for ${tag} is green: all required workflows succeeded"}
  }
  let waiting_list = unsatisfied.join(", ")
  return {
    state: "pending",
    message: "publish for ${tag} not yet confirmed green: still waiting on ${waiting_list}",
  }
}

/**
 * Operator-facing yank path for a red publish. The tag is already pushed and
 * the publish workflows ran from it, so recovery is a deliberate yank, not an
 * in-flight abort. Returned as lines so the caller can fold them into a step's
 * stderr without committing to a single rendering.
 */
pub fn publish_failure_yank_lines(tag, slug) {
  let repo = if trim(slug ?? "") == "" {
    "<owner/repo>"
  } else {
    trim(slug)
  }
  return [
    "release publish for ${tag} is RED — the published artifact may be broken or incomplete.",
    "1. inspect the failed runs:",
    "     gh run list --repo ${repo} --workflow=publish-release.yml --limit 5",
    "     gh run list --repo ${repo} --workflow=build-release-binaries.yml --limit 5",
    "2. if nothing usable shipped, yank the git tag before anyone repins to it:",
    "     git push origin --delete ${tag} && git tag -d ${tag}",
    "3. crates.io is immutable: if a crate already published, yank that version instead:",
    "     cargo yank --version <X.Y.Z> <crate>",
    "4. fix the cause on the base branch, then re-run release_harn to re-tag and re-publish.",
  ]
}
