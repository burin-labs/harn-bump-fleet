import { decode_github_workflow } from "./github_workflow"
import {
  release_certification_check_set,
  release_only_check_set,
  release_pull_request_lane_set,
} from "./release_only_checks"
import { run_git } from "./release_runtime"

const RELEASE_CERTIFICATION_WORKFLOWS = [
  ".github/workflows/windows-nightly.yml",
  ".github/workflows/macos-nightly.yml",
  ".github/workflows/ci.yml",
]

pub type ReleaseWorkflowInventoryEntry = {path: string, workflow: any}

pub type ReleaseWorkflowCheckSet = {
  checks: list<string>,
  source_workflows: list<string>,
  bears_on_all_paths: bool,
  bearing_paths: list<string>,
}

pub type ReleaseWorkflowInventory = {
  revision: string,
  entries: list<ReleaseWorkflowInventoryEntry>,
  all: ReleaseWorkflowCheckSet,
  release_only: ReleaseWorkflowCheckSet,
  pull_request: ReleaseWorkflowCheckSet,
}

pub type ReleaseWorkflowRevisionReader = fn(string, string) -> Result<string, string>

fn exact_revision(revision: string) -> string {
  const normalized = lowercase(trim(revision))
  if regex_match("^[0-9a-f]{40}$", normalized) == nil {
    throw "release workflow inventory requires an exact 40-character revision"
  }
  return normalized
}

/**
 * Decode the complete certification workflow inventory at one immutable revision.
 *
 * Every registered source must be readable and valid. A missing workflow is not
 * an empty successful inventory: it is an unproved release contract.
 */
pub fn release_workflow_inventory_with_reader(
  revision: string,
  reader: ReleaseWorkflowRevisionReader,
) -> ReleaseWorkflowInventory {
  const resolved = exact_revision(revision)
  let entries: list<ReleaseWorkflowInventoryEntry> = []
  for path in RELEASE_CERTIFICATION_WORKFLOWS {
    const source = reader(resolved, path)
    if is_err(source) {
      throw "could not read ${path} at ${resolved}: " + to_string(unwrap_err(source))
    }
    const decoded = try {
      decode_github_workflow(unwrap(source))
    }
    if is_err(decoded) {
      throw "could not decode ${path} at ${resolved}: " + to_string(unwrap_err(decoded))
    }
    entries = entries + [{path: path, workflow: unwrap(decoded)}]
  }
  if len(entries) != len(RELEASE_CERTIFICATION_WORKFLOWS) {
    throw "release workflow inventory did not measure every registered workflow at ${resolved}"
  }
  return {
    revision: resolved,
    entries: entries,
    all: release_certification_check_set(entries),
    release_only: release_only_check_set(entries),
    pull_request: release_pull_request_lane_set(entries),
  }
}

/** Read the certification workflow inventory from the exact git object being decided. */
pub fn release_workflow_inventory_at_revision(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  revision: string,
) -> ReleaseWorkflowInventory {
  return release_workflow_inventory_with_reader(
    revision,
    { resolved, path ->
      const shown = run_git(harness, cfg, ["show", "${resolved}:${path}"])
      if !shown.success {
        return Err(trim(shown.stderr ?? "git show failed"))
      }
      return Ok(shown.stdout ?? "")
    },
  )
}
