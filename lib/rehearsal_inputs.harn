import { github_connector_options } from "./github"
import { api_call } from "harn-github-connector/default"

pub type RehearsalInputIdentity = {revision: string, digest: string, entries: int}

type SourceTreeEntry = {path: string, mode: string, type: string, sha: string}

type SourceTree = {sha: string, truncated: bool, tree: list<SourceTreeEntry>}

fn full_oid(value: string) -> bool {
  return len(regex_captures("^[0-9a-f]{40}$", value)) == 1
}

fn valid_entry_mode(entry: SourceTreeEntry) -> bool {
  return (entry.type == "tree" && entry.mode == "040000")
    || (entry.type == "blob" && ["100644", "100755", "120000"].contains(entry.mode))
    || (entry.type == "commit" && entry.mode == "160000")
}

/**
 * Git tree objects bind names, modes, and every descendant's content. Include
 * all root entries by default, including unknown directories and build tools.
 * Only the published documentation tree and release notes are excluded. Skills
 * and other Markdown embedded in crates remain inputs through the crates tree.
 * This is compatibility identity, not binary identity: the tested revision is
 * retained separately, and exact-candidate release certification still runs.
 */
pub fn rehearsal_input_identity(
  revision: string,
  inventory: unknown,
) -> Result<RehearsalInputIdentity, string> {
  if !full_oid(revision) {
    return Err("rehearsal inputs require an exact runtime revision")
  }
  if !schema_is(inventory, SourceTree) {
    return Err("rehearsal source tree is missing required inventory fields")
  }
  if inventory.truncated || !full_oid(inventory.sha) || len(inventory.tree) == 0 {
    return Err("rehearsal source tree is incomplete")
  }
  let names: list<string> = []
  let rows: list<string> = []
  for entry in inventory.tree {
    if entry.path == "" || contains(entry.path, "/") || contains(entry.path, "\n")
      || contains(entry.path, "\t")
      || names.contains(entry.path)
      || !full_oid(entry.sha) {
      return Err("rehearsal source tree contains an invalid or duplicate entry")
    }
    if !valid_entry_mode(entry) {
      return Err("rehearsal source tree contains an unsupported entry mode")
    }
    names = names + [entry.path]
    if (entry.path == "docs" || entry.path == "changelog.d") && entry.type == "tree" {
      continue
    }
    if entry.path == "CHANGELOG.md" && entry.type == "blob" && entry.mode == "100644" {
      continue
    }
    rows = rows + ["${entry.mode}\t${entry.type}\t${entry.path}\t${entry.sha}"]
  }
  for required in ["Cargo.toml", "Cargo.lock", "crates", "rust-toolchain.toml"] {
    if !names.contains(required) {
      return Err("rehearsal source tree is missing required input ${required}")
    }
  }
  return Ok(
    {
      revision: revision,
      digest: sha256("consumer-rehearsal-inputs.v1\n" + join(rows.sorted(), "\n")),
      entries: len(rows),
    },
  )
}

/** One non-recursive tree read covers descendants without truncated recursion. */
pub fn read_rehearsal_inputs(
  harness: Harness,
  revision: string,
) -> Result<RehearsalInputIdentity, string> {
  if !full_oid(revision) {
    return Err("rehearsal inputs require an exact runtime revision")
  }
  const result = api_call(
    harness,
    {path: "/repos/burin-labs/harn/git/trees/${revision}", options: github_connector_options()},
  )
  if is_err(result) {
    return Err("could not read rehearsal source inputs: " + to_string(unwrap_err(result)))
  }
  return rehearsal_input_identity(revision, unwrap(result))
}
