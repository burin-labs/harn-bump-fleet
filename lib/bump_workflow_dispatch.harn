import { FleetRepo } from "./bump_fleet_pre_dispatch"
import { poll_bump_workflow_run } from "./bump_workflow_observation"
import {
  FleetDispatchLineage,
  fleet_dispatch_continuation_entry_write,
} from "./fleet_dispatch_continuation"
import { github_workflow_dispatch } from "./github"
import { FleetOutcomeReceipt } from "./run_receipts"

pub type BumpWorkflowDispatchRequest = {
  repo: FleetRepo,
  base: FleetOutcomeReceipt,
  target: string,
  continuation_receipt: string,
  continuation_lineage: FleetDispatchLineage?,
  poll_timeout_ms: int,
  poll_interval_ms: int,
}

/** Dispatch once, then either persist an exact continuation or observe the run locally. */
pub fn dispatch_bump_workflow(
  harness: Harness,
  request: BumpWorkflowDispatchRequest,
) -> FleetOutcomeReceipt {
  const dispatch = github_workflow_dispatch(
    harness,
    request.repo.slug,
    request.repo.update.workflow_name,
    {version: request.target},
  )
  if is_err(dispatch) {
    return request.base
      + {status: "dispatch_failed", detail: to_string(unwrap_err(dispatch))}
  }
  const accepted = unwrap(dispatch)
  if trim(request.continuation_receipt) != "" {
    if request.continuation_lineage == nil {
      throw "dispatch continuation lineage is required when a receipt is requested"
    }
    fleet_dispatch_continuation_entry_write(
      {fs: harness.fs, random: harness.random},
      request.continuation_receipt,
      unwrap(request.continuation_lineage),
      request.repo,
      accepted.run_id,
      accepted.url,
    )
    return {
      ...request.base,
      run_id: accepted.run_id,
      run_url: accepted.url,
      status: "run_in_progress",
      detail: "workflow dispatch accepted; exact run handed to convergence observation",
    }
  }
  const polled = poll_bump_workflow_run(
    harness,
    request.repo.slug,
    accepted.run_id,
    request.poll_timeout_ms,
    request.poll_interval_ms,
  )
  return if polled.status != "completed" {
    {
      ...request.base,
      run_id: accepted.run_id,
      run_url: accepted.url,
      status: "run_in_progress",
      detail: "workflow still ${polled.status} after ${request.poll_timeout_ms / 1000}s",
    }
  } else {
    {
      ...request.base,
      run_id: accepted.run_id,
      run_url: accepted.url,
      status: "run_${polled.conclusion}",
      detail: "workflow concluded ${polled.conclusion}",
    }
  }
}
