import { git_ls_remote } from "std/git"
import { git_push_ref_plumbing, remote_branch_oid } from "./git"

pub type PlatformCertificationBranchResult = {
  success: bool,
  branch: string,
  action: PlatformCertificationBranchAction,
  reason: string,
}

pub type PlatformCertificationBranchAction = "mock" \
  | "probe_failed" \
  | "resume" \
  | "conflict" \
  | "confirmation_failed" \
  | "published" \
  | "reconciled" \
  | "confirmation_missing" \
  | "push_failed" \
  | "confirmation_mismatch"

/** Exact-commit branch used only as the hosted certification dispatch ref. */
pub fn platform_certification_branch(pin_sha: string) -> string {
  const sha = lowercase(trim(pin_sha))
  if len(regex_captures("^[0-9a-f]{40}$", sha)) == 0 {
    throw "platform certification pin must be a full 40-hex OID, got: " + pin_sha
  }
  return "release-certify/${sha}"
}

/** Publish or resume the write-once certification branch at the exact pin. */
pub fn ensure_platform_certification_branch(
  process: HarnessProcess,
  workspace: string,
  pin_sha: string,
  mock: bool = false,
) -> PlatformCertificationBranchResult {
  const branch = platform_certification_branch(pin_sha)
  const sha = lowercase(trim(pin_sha))
  if mock {
    return {
      success: true,
      branch: branch,
      action: "mock",
      reason: "mock certification branch ${branch}",
    }
  }
  const ref = "refs/heads/${branch}"
  const initial = git_ls_remote(process, "origin", {repo: workspace, refs: [ref], heads: true})
  if !initial.success {
    return {
      success: false,
      branch: branch,
      action: "probe_failed",
      reason: "could not inspect certification branch ${branch}: " + initial.stderr.inline,
    }
  }
  const observed = remote_branch_oid(initial.data.refs, branch)
  if observed == sha {
    return {
      success: true,
      branch: branch,
      action: "resume",
      reason: "certification branch ${branch} already targets pin ${sha}",
    }
  }
  if observed != "" {
    return {
      success: false,
      branch: branch,
      action: "conflict",
      reason:
        "certification branch ${branch} targets ${observed}, not pin ${sha}; refusing to overwrite it",
    }
  }
  const pushed = git_push_ref_plumbing(process, "origin", "${sha}:${ref}", workspace)
  const confirmed = git_ls_remote(process, "origin", {repo: workspace, refs: [ref], heads: true})
  const push_detail = if pushed.success {
    ""
  } else {
    "; push transport also failed: " + pushed.stderr.inline
  }
  if !confirmed.success {
    return {
      success: false,
      branch: branch,
      action: "confirmation_failed",
      reason: "could not confirm certification branch ${branch} after push: "
        + confirmed.stderr.inline
        + push_detail,
    }
  }
  const confirmed_oid = remote_branch_oid(confirmed.data.refs, branch)
  if confirmed_oid == sha {
    return {
      success: true,
      branch: branch,
      action: if pushed.success {
        "published"
      } else {
        "reconciled"
      },
      reason: if pushed.success {
        "published certification branch ${branch} at ${sha}"
      } else {
        "origin accepted certification branch ${branch} at ${sha} despite push transport failure"
      },
    }
  }
  if confirmed_oid == "" {
    return {
      success: false,
      branch: branch,
      action: if pushed.success {
        "confirmation_missing"
      } else {
        "push_failed"
      },
      reason: "origin does not contain certification branch ${branch} after push attempt"
        + push_detail,
    }
  }
  return {
    success: false,
    branch: branch,
    action: "confirmation_mismatch",
    reason: "certification branch ${branch} resolved to ${confirmed_oid}, not pin ${sha}"
      + push_detail,
  }
}
