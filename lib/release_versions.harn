import { GitRemoteRef } from "std/git"
import { is_v_semver, parse } from "std/semver"

/** Return the first canonical release tag from version-sorted `git tag` output. */
pub fn latest_semver_tag_from_git_tag_list(stdout: string) -> string {
  for line in (stdout ?? "").split("\n") {
    const tag = trim(line)
    if is_v_semver(tag) {
      return tag
    }
  }
  return ""
}

fn tag_from_ref(ref) {
  const parts = split(trim(ref ?? ""), "/")
  if len(parts) == 0 {
    return ""
  }
  return trim(parts[len(parts) - 1])
}

/** Return the highest canonical release tag from unordered typed remote refs. */
pub fn latest_semver_tag_from_remote_refs(refs: list<GitRemoteRef>) -> string {
  let best_tag = ""
  let best = nil
  for remote_ref in refs {
    const tag = tag_from_ref(remote_ref.name)
    if !is_v_semver(tag) {
      continue
    }
    const candidate = parse(tag)
    if best == nil
      || candidate.major > best.major
      || (candidate.major == best.major && candidate.minor > best.minor)
      || (candidate.major
      == best.major
      && candidate.minor == best.minor
      && candidate.patch > best.patch) {
      best_tag = tag
      best = candidate
    }
  }
  return best_tag
}
