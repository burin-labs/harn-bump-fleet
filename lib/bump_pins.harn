import { strip_v } from "std/semver"

pub type HarnPinProbe = {pin: string?, evidence: string}

fn cargo_harn_pin_line(line) {
  let m = regex_captures(
    "^\\s*(harn-[A-Za-z0-9_-]+)\\s*=\\s*\"=?([0-9]+\\.[0-9]+\\.[0-9]+)\"",
    line,
  )
  if m == nil || len(m) == 0 {
    m = regex_captures(
      "^\\s*(harn-[A-Za-z0-9_-]+)\\s*=\\s*\\{[^}]*version\\s*=\\s*\"=?([0-9]+\\.[0-9]+\\.[0-9]+)\"",
      line,
    )
  }
  if m == nil || len(m) == 0 {
    return nil
  }
  const crate_name = m[0].groups[0]
  if starts_with(crate_name, "harn-cloud-") {
    return nil
  }
  return {name: crate_name, version: strip_v(m[0].groups[1])}
}

fn pin_pairs_text(pins) {
  return pins.map({ pin -> "${pin.name}=${pin.version}" }).join(", ")
}

/**
 * Extract exact Harn crate pins from Cargo.toml text.
 *
 * Path dependencies and harn-cloud-* workspace crates are intentionally
 * ignored; they are repo-local crates, not the released Harn runtime pin.
 */
pub fn cargo_harn_pin_probe(text: string?) -> HarnPinProbe {
  let pins = []
  for line in (text ?? "").split("\n") {
    const pin = cargo_harn_pin_line(line)
    if pin != nil {
      pins = pins + [pin]
    }
  }
  if len(pins) == 0 {
    return {pin: nil, evidence: "no exact Harn Cargo pins found"}
  }
  const version = pins[0].version
  let mixed = []
  for pin in pins {
    if pin.version != version {
      mixed = mixed + [pin]
    }
  }
  if len(mixed) > 0 {
    return {pin: nil, evidence: "Cargo Harn pins are mixed: " + pin_pairs_text(pins)}
  }
  return {
    pin: version,
    evidence: "Cargo Harn pins are all ${version}: " + pins.map({ pin -> pin.name }).join(", "),
  }
}

pub fn harn_version_pin_probe(text: string?) -> HarnPinProbe {
  const pin = strip_v(trim(text ?? ""))
  if pin == "" {
    return {pin: nil, evidence: ".harn-version is empty"}
  }
  return {pin: pin, evidence: ".harn-version pin is ${pin}"}
}

/**
 * The Harn version a Homebrew formula pins.
 *
 * The tap is a consumer like any other, but its pin is a Ruby `version` field
 * rather than a `.harn-version` file. Reading it here keeps a stale tap
 * visible to the same alarm as every other consumer — the tap is the one whose
 * lag strangers see, so it is the worst one to leave unwatched.
 *
 * Deliberately anchored to the `version` DSL line. A formula also carries
 * version-shaped text inside URLs and sha256 digests, and a looser pattern
 * would happily return one of those.
 */
pub fn formula_harn_pin_probe(text: string?) -> HarnPinProbe {
  const source = trim(text ?? "")
  if source == "" {
    return {pin: nil, evidence: "formula is empty"}
  }
  const matches = regex_captures("(?m)^\\s*version\\s+\"([0-9]+\\.[0-9]+\\.[0-9]+)\"", source)
  if len(matches) == 0 || len(matches[0].groups) == 0 {
    return {pin: nil, evidence: "formula declares no version \"X.Y.Z\" line"}
  }
  const pin = strip_v(trim(matches[0].groups[0]))
  return {pin: pin, evidence: "formula version pin is ${pin}"}
}
