import { GithubRefClaim } from "harn-github-connector/default"

const FULL_SHA_PATTERN = "^[0-9a-f]{40}$"

fn normalized_chain_id(chain_id: string) -> string {
  const normalized = trim(chain_id)
  if len(regex_captures("^[1-9][0-9]*$", normalized)) == 0 {
    throw "fleet update chain requires a positive numeric chain ID"
  }
  return normalized
}

/** Immutable branch name shared by the follow-up rounds in one hosted update chain. */
pub fn fleet_chain_branch(chain_id: string) -> string {
  return "harn-update-chain/" + normalized_chain_id(chain_id)
}

/** Fully qualified spelling used by the connector's atomic ref lease. */
pub fn fleet_chain_ref(chain_id: string) -> string {
  return "refs/heads/" + fleet_chain_branch(chain_id)
}

/** Disposable ref that proves the controller commit can be leased and released. */
pub fn fleet_chain_preflight_ref(chain_id: string) -> string {
  return "refs/heads/harn-update-preflight/" + normalized_chain_id(chain_id)
}

/** Require one ref lease to hold the exact controller revision requested. */
pub fn require_fleet_controller_claim(
  claim: GithubRefClaim,
  expected_ref: string,
  controller_revision: string,
) -> GithubRefClaim {
  const revision = lowercase(trim(controller_revision))
  if len(regex_captures(FULL_SHA_PATTERN, revision)) == 0 {
    throw "fleet update continuation requires a full lowercase controller revision"
  }
  if claim.ref != expected_ref || lowercase(trim(claim.oid)) != revision {
    throw "fleet update controller ref is held by another controller revision"
  }
  return claim
}

/**
 * Accept a newly-created or already-existing chain ref only when it holds the
 * exact controller that attempted the handoff.
 */
pub fn require_fleet_chain_claim(
  claim: GithubRefClaim,
  chain_id: string,
  controller_revision: string,
) -> GithubRefClaim {
  return require_fleet_controller_claim(claim, fleet_chain_ref(chain_id), controller_revision)
}
