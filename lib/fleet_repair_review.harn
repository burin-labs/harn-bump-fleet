// How a repair round treats the automated reviewer's open findings.
//
// A finding is a defect only the agent pass can fix, so a reviewed candidate
// never settles on validation alone. Whatever the round then does, every
// finding it saw ends the round with a fleet reply.
import { FleetRepairCandidate, FleetRepairPlan, FleetRepairPolicy } from "./fleet_repair_contract"
import { FleetRepairResult } from "./fleet_repair_terminal"
import {
  FleetReviewFinding,
  fleet_answer_review_findings,
  fleet_review_findings_prompt,
} from "./fleet_review_findings"
import { GithubClientOptions } from "harn-github-connector/default"

/** Whether the candidate carries open reviewer findings for this round. */
pub fn fleet_repair_reviewed(candidate: FleetRepairCandidate) -> bool {
  return len(candidate.review_findings ?? []) > 0
}

/**
 * The refusal for a reviewed candidate in a pass that cannot run the agent, or
 * nil when the round may go on to repair it.
 */
pub fn fleet_repair_review_refusal(
  candidate: FleetRepairCandidate,
  policy: FleetRepairPolicy,
) -> FleetRepairResult? {
  if !(policy.deterministic_only ?? false) {
    return nil
  }
  return {
    repo: candidate.repo,
    status: "failed",
    reason: "agent_repair_required",
    pr_number: candidate.pr_number,
    old_head_sha: candidate.head_sha,
    attempts: [],
    known_cost_usd: 0.0,
    cost_status: "exact",
  }
}

/** The reviewer's findings as the first thing the agent is told to fix, or "". */
pub fn fleet_repair_review_findings_text(candidate: FleetRepairCandidate) -> string {
  return if fleet_repair_reviewed(candidate) {
    "the repository's automated reviewer left these findings on the pull request:\n"
      + fleet_review_findings_prompt(candidate.review_findings ?? [])
  } else {
    ""
  }
}

/** Every open reviewer finding in the plan, keyed to the pull request it is on. */
fn plan_review_findings(
  plan: FleetRepairPlan,
) -> list<{repo: string, pr_number: int, head_sha: string, findings: list<FleetReviewFinding>}> {
  const from_candidates = plan.candidates.map(
    { candidate ->
      {
        repo: candidate.repo,
        pr_number: candidate.pr_number,
        head_sha: candidate.head_sha,
        findings: candidate.review_findings ?? [],
      }
    },
  )
    .to_list()
  const from_refusals = plan.refused.map(
    { row ->
      {
        repo: row.repo,
        pr_number: row.pr_number ?? 0,
        head_sha: row.head_sha ?? "",
        findings: row.review_findings ?? [],
      }
    },
  )
    .to_list()
  return (from_candidates + from_refusals).filter(
    { entry -> len(entry.findings) > 0 && entry.pr_number > 0 && trim(entry.head_sha) != "" },
  )
    .to_list()
}

/**
 * Answer every open reviewer finding the round saw, whatever the round did.
 *
 * A repaired pull request's threads name the head that addresses them; every
 * other outcome, including a refusal before any agent ran, names its typed
 * reason. This is the guarantee: no finding ends a round without a fleet reply.
 */
pub fn fleet_repair_answer_review_findings(
  harness: Harness,
  plan: FleetRepairPlan,
  results: list<FleetRepairResult>,
  options: GithubClientOptions,
) -> list<FleetRepairResult> {
  const owed = plan_review_findings(plan)
  return results.map(
    { result ->
      const entry = owed.find({ entry -> entry.repo == result.repo })
      if entry == nil {
        return result
      }
      const repaired = result.status == "repaired" && trim(result.new_head_sha ?? "") != ""
      const replies = fleet_answer_review_findings(
        harness,
        entry.repo,
        entry.pr_number,
        entry.findings,
        if repaired {
          {status: "repaired", head_sha: result.new_head_sha ?? "", reason: result.reason}
        } else {
          {status: "escalated", reason: result.reason}
        },
        entry.head_sha,
        options,
      )
      return result + {review_replies: replies}
    },
  )
    .to_list()
}

/** What the agent is first told to fix: reviewer findings, then formatter and validator output. */
pub fn fleet_repair_initial_findings_text(
  candidate: FleetRepairCandidate,
  formatted: dict,
  validation_ok: bool,
  validation_output: string,
) -> string {
  return join(
    [
      fleet_repair_review_findings_text(candidate),
      if (formatted?.ok ?? false) || trim(to_string(formatted?.output ?? "")) == "" {
        ""
      } else {
        "canonical formatter failed:\n" + to_string(formatted?.output ?? "")
      },
      if validation_ok {
        ""
      } else {
        validation_output
      },
    ]
      .filter({ finding -> trim(finding) != "" }),
    "\n\n",
  )
}
