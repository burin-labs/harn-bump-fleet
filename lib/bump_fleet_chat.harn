import { agent_host_tools } from "std/agent/host_tools"
import { BumpFleetOptions } from "./bump_fleet_options"
import {
  chat_cfg_from_run_dir,
  chat_enabled,
  pick_recent_run,
  resolve_chat_run_path,
} from "./chat_runs"
import { run_chat_loop } from "./post_run_chat"

pub type BumpFleetChatDefaults = {provider: string, model: string}

pub type BumpFleetRunChat = {
  run_id: string,
  audit_md_path: string,
  audit_json_path: string,
  mode: string,
  failed: bool,
}

const BUMP_CHAT_ARGV_PREFIXES = [
  ["git", "status"],
  ["git", "diff"],
  ["git", "log"],
  ["git", "show"],
  ["git", "branch"],
  ["git", "rev-parse"],
  ["gh", "pr", "list"],
  ["gh", "pr", "view"],
  ["gh", "pr", "checks"],
  ["gh", "run", "list"],
  ["gh", "run", "view"],
  ["gh", "workflow", "list"],
  ["gh", "workflow", "view"],
  ["gh", "release", "list"],
  ["gh", "release", "view"],
  ["rg"],
  ["grep"],
  ["head"],
  ["tail"],
  ["cat"],
  ["ls"],
  ["test"],
]

pub fn bump_chat_tools() {
  return agent_host_tools(
    nil,
    {
      root: cwd(),
      cwd: cwd(),
      max_inline_bytes: 12000,
      read_bytes: 12000,
      tail_bytes: 12000,
      search_max_matches: 120,
      exclude_globs: [".git/**", "target/**"],
      allow_argv_prefixes: BUMP_CHAT_ARGV_PREFIXES,
      names: {
        read_file: "fleet_read",
        read_file_tail: "fleet_read_tail",
        search_files: "fleet_search",
        git_inspect: "fleet_git",
        run_command: "fleet_run",
        read_command_output: "fleet_run_output",
        read_command_output_tail: "fleet_run_tail",
        edit_file: "fleet_edit_file",
        write_file: "fleet_write_file",
      },
      descriptions: {
        read_file: "Read a UTF-8 file under the harn-bump-fleet repo by repo-relative path. Prefer bounded reads with limit_bytes.",
        search_files: "Search harn-bump-fleet repo contents. Provide a pattern; use path/glob only to narrow the search.",
        git_inspect: "Inspect git status, diff, log, show, blame, branches, or remotes without mutating the repo.",
        run_command: "Run one bounded read-only inspection command from the harn-bump-fleet repo. Pass argv as an array of strings.",
        edit_file: "Apply an exact-text edit to a tracked file in harn-bump-fleet. The operator authorized chat-side edits.",
        write_file: "Overwrite a tracked file in harn-bump-fleet. Prefer edit_file for small edits.",
      },
      output_format: "json",
    },
  )
}

pub fn bump_chat_only(harness: Harness, options: BumpFleetOptions, defaults: BumpFleetChatDefaults) -> int {
  if !chat_enabled(options) {
    harness.stdio.eprintln("--chat-only requires an interactive terminal (and HARN_CHAT != 0)")
    return 2
  }
  const kind = "bump-fleet"
  const target_dir = if trim(options.chat_run) != "" {
    resolve_chat_run_path(harness, kind, options.chat_run)
  } else {
    const pick = pick_recent_run(harness, kind, 12)
    if pick == nil {
      nil
    } else {
      pick.dir
    }
  }
  if target_dir == nil {
    harness.stdio.println("(no run selected; exiting)")
    return 0
  }
  const chat_cfg = chat_cfg_from_run_dir(
    harness,
    {
      provider: defaults.provider,
      model: defaults.model,
      repo: cwd(),
      mock: false,
      timeout_s: options.chat_timeout_s,
      tools: bump_chat_tools(),
      no_chat: options.no_chat,
    },
    kind,
    target_dir,
  )
  run_chat_loop(harness, chat_cfg)
  return 0
}

pub fn run_bump_post_run_chat(
  harness: Harness,
  options: BumpFleetOptions,
  defaults: BumpFleetChatDefaults,
  run: BumpFleetRunChat,
) {
  if !chat_enabled(options) {
    return
  }
  const chat_cfg = {
    harness_kind: "bump-fleet",
    run_id: run.run_id,
    run_dir: path_join(cwd(), ".harn-runs/bump-fleet", run.run_id),
    audit_md_path: run.audit_md_path,
    audit_json_path: run.audit_json_path,
    llm_transcript_path: nil,
    provider: defaults.provider,
    model: defaults.model,
    repo: cwd(),
    mode_hint: run.mode,
    outcome: if run.failed {
      "FAILED"
    } else {
      "ok"
    },
    tools: bump_chat_tools(),
    timeout_s: options.chat_timeout_s,
    no_chat: options.no_chat,
  }
  run_chat_loop(harness, chat_cfg)
}
