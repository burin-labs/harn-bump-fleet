import { read_toml_typed } from "std/fs"

/** One repository and the Harn-owned fleet capabilities projected into it. */
pub type FleetRepository = {
  slug: string,
  directory: string,
  harn_package?: bool,
  package_ci_ownership?: "fleet" | "pin",
  package_validate_command?: string,
  harn_bump?: bool,
  bump_workflow_ownership?: "fleet",
  run_poll_tick?: bool,
  test_jobs?: int,
  bump_refresh_command?: string,
  bump_refresh_notes?: string,
  bump_validate_command?: string,
  bump_node_version?: string,
}

/** One byte-exact file projection whose semantic owner is the source. */
pub type FleetFileProjection = {
  source_slug: string,
  source_path: string,
  target_slug: string,
  target_path: string,
}

/** The typed authority for every repository-wide Harn projection. */
pub type FleetManifest = {
  schema_version: 1,
  fleet: {default_root: string, default_branch: string},
  policy: {package_workflow: string, bump_workflow: string, publish_validation_failures?: bool},
  file_projections: list<FleetFileProjection>,
  repositories: list<FleetRepository>,
}

/** Parsed owner/repository, workflow path, and immutable revision for one policy workflow. */
pub type FleetWorkflowPolicyReference = {slug: string, path: string, ref: string}

/** Decode one already-validated reusable-workflow reference for live policy checks. */
pub fn parse_workflow_policy_reference(value: string) -> FleetWorkflowPolicyReference {
  const matches = regex_captures(
    "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml)@([0-9a-f]{40})$",
    value,
  )
  if len(matches) != 1 || len(matches[0].groups) != 3 {
    throw "invalid fleet reusable-workflow policy reference: '${value}'"
  }
  return {slug: matches[0].groups[0], path: matches[0].groups[1], ref: matches[0].groups[2]}
}

/** Derive the co-versioned CI status action from the canonical package workflow pin. */
pub fn package_status_action_reference(package_workflow: string) -> string {
  const reference = parse_workflow_policy_reference(package_workflow)
  return reference.slug
    + "/.github/actions/require-successful-needs@"
    + reference.ref
}

fn validate_repository_slug(slug: string) {
  if len(regex_captures("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", slug)) == 0 {
    throw "invalid fleet repository slug '${slug}'"
  }
}

fn validate_repository_path(path: string) {
  if trim(path) != path || path == "" || starts_with(path, "/") || contains(path, "..") {
    throw "invalid fleet repository path '${path}'"
  }
}

fn validate_package_projection(repo: FleetRepository) {
  if (repo.run_poll_tick ?? false) && !(repo.harn_package ?? false) {
    throw "fleet repository '${repo.slug}' enables run_poll_tick without harn_package"
  }
  if repo.package_ci_ownership != nil && !(repo.harn_package ?? false) {
    throw "fleet repository '${repo.slug}' delegates package CI without harn_package"
  }
  if repo.package_validate_command != nil
    && (repo.package_ci_ownership != "fleet"
    || trim(
    repo.package_validate_command ?? "",
  )
    == "") {
    throw "fleet repository '${repo.slug}' has package validation without fleet-owned package CI"
  }
  if repo.test_jobs != nil && (!(repo.harn_package ?? false) || (repo.test_jobs ?? 0) <= 0) {
    throw "fleet repository '${repo.slug}' sets test_jobs without a positive harn_package worker count"
  }
}

fn validate_bump_projection(repo: FleetRepository) {
  if repo.bump_workflow_ownership == "fleet" && !(repo.harn_bump ?? false) {
    throw "fleet repository '${repo.slug}' delegates its bump workflow without harn_bump"
  }
  for command in [repo.bump_refresh_command, repo.bump_validate_command] {
    if command != nil && (!(repo.harn_bump ?? false) || trim(command ?? "") == "") {
      throw "fleet repository '${repo.slug}' has a bump command without harn_bump or content"
    }
  }
  if repo.bump_workflow_ownership == "fleet"
    && !(repo.harn_package ?? false)
    && repo.bump_validate_command
    == nil {
    throw "fleet repository '${repo.slug}' delegates a non-package bump without validation"
  }
  if repo.bump_node_version != nil {
    const node_version = trim(repo.bump_node_version ?? "")
    if !(repo.harn_bump ?? false)
      || node_version
      == ""
      || len(regex_captures("^[A-Za-z0-9._-]+$", node_version))
      == 0 {
      throw "fleet repository '${repo.slug}' has invalid bump_node_version"
    }
  }
}

/** Validate the fleet manifest's unique repository and mechanically owned projection contracts. */
pub fn validate_fleet_manifest(manifest: FleetManifest) -> FleetManifest {
  if trim(manifest.fleet.default_root) == "" {
    throw "fleet.default_root must not be empty"
  }
  const default_branch = manifest.fleet.default_branch
  if len(regex_captures("^[A-Za-z0-9._/-]+$", default_branch)) == 0
    || starts_with(
    default_branch,
    "/",
  )
    || ends_with(default_branch, "/")
    || contains(default_branch, "..") {
    throw "fleet.default_branch is not a safe Git ref name: '${default_branch}'"
  }
  for policy_ref in [manifest.policy.package_workflow, manifest.policy.bump_workflow] {
    if len(regex_captures("^[^@]+@[0-9a-f]{40}$", policy_ref)) == 0 {
      throw "fleet policy references must use an immutable full commit SHA: '${policy_ref}'"
    }
    parse_workflow_policy_reference(policy_ref)
  }
  let slugs = {}
  let directories = {}
  for repo in manifest.repositories {
    validate_repository_slug(repo.slug)
    if len(regex_captures("^[A-Za-z0-9_.-]+$", repo.directory)) == 0 {
      throw "invalid fleet repository directory '${repo.directory}'"
    }
    if slugs[repo.slug] ?? false {
      throw "duplicate fleet repository slug '${repo.slug}'"
    }
    if directories[repo.directory] ?? false {
      throw "duplicate fleet repository directory '${repo.directory}'"
    }
    validate_package_projection(repo)
    validate_bump_projection(repo)
    slugs[repo.slug] = true
    directories[repo.directory] = true
  }
  let projection_targets = {}
  for projection in manifest.file_projections {
    validate_repository_slug(projection.source_slug)
    validate_repository_slug(projection.target_slug)
    validate_repository_path(projection.source_path)
    validate_repository_path(projection.target_path)
    if !(slugs[projection.source_slug] ?? false) || !(slugs[projection.target_slug] ?? false) {
      throw "fleet file projection repositories must be declared in [[repositories]]"
    }
    const target_key = projection.target_slug + ":" + projection.target_path
    if projection_targets[target_key] ?? false {
      throw "duplicate fleet file projection target '${target_key}'"
    }
    if projection.source_slug == projection.target_slug
      && projection.source_path
      == projection
      .target_path {
      throw "fleet file projection source and target must differ"
    }
    projection_targets[target_key] = true
  }
  return manifest
}

/** Read and validate a typed fleet manifest from `path`. */
pub fn read_fleet_manifest(fs: HarnessFs, path: string = "fleet.toml") -> FleetManifest {
  return validate_fleet_manifest(read_toml_typed<FleetManifest>(fs, path, schema_of(FleetManifest)))
}

/** Return repositories admitted through the canonical Harn package workflow. */
pub fn harn_package_repositories(manifest: FleetManifest) -> list<FleetRepository> {
  return manifest.repositories.filter({ repo -> repo.harn_package ?? false }).to_list()
}

/** Return repositories managed by the reusable Harn runtime bump workflow. */
pub fn harn_bump_repositories(manifest: FleetManifest) -> list<FleetRepository> {
  return manifest.repositories.filter({ repo -> repo.harn_bump ?? false }).to_list()
}

/** Resolve the configured fleet root, expanding a leading home-directory marker. */
pub fn resolve_fleet_root(configured: string, home: string) -> string {
  if configured == "~" {
    return home
  }
  if starts_with(configured, "~/") {
    return path_join(home, configured[2:len(configured)])
  }
  return configured
}
