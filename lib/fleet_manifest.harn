import { read_toml_typed } from "std/fs"

/** One repository and the Harn-owned fleet capabilities projected into it. */
pub type FleetRepository = {
  slug: string,
  directory: string,
  harn_package?: bool,
  harn_bump?: bool,
  run_poll_tick?: bool,
}

/** The typed authority for every repository-wide Harn projection. */
pub type FleetManifest = {
  schema_version: 1,
  fleet: {default_root: string},
  repositories: list<FleetRepository>,
}

pub fn validate_fleet_manifest(manifest: FleetManifest) -> FleetManifest {
  if trim(manifest.fleet.default_root) == "" {
    throw "fleet.default_root must not be empty"
  }
  let slugs = {}
  let directories = {}
  for repo in manifest.repositories {
    if len(regex_captures("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", repo.slug)) == 0 {
      throw "invalid fleet repository slug '${repo.slug}'"
    }
    if len(regex_captures("^[A-Za-z0-9_.-]+$", repo.directory)) == 0 {
      throw "invalid fleet repository directory '${repo.directory}'"
    }
    if slugs[repo.slug] ?? false {
      throw "duplicate fleet repository slug '${repo.slug}'"
    }
    if directories[repo.directory] ?? false {
      throw "duplicate fleet repository directory '${repo.directory}'"
    }
    if (repo.run_poll_tick ?? false) && !(repo.harn_package ?? false) {
      throw "fleet repository '${repo.slug}' enables run_poll_tick without harn_package"
    }
    slugs[repo.slug] = true
    directories[repo.directory] = true
  }
  return manifest
}

pub fn read_fleet_manifest(path: string = "fleet.toml") -> FleetManifest {
  return validate_fleet_manifest(read_toml_typed<FleetManifest>(path, schema_of(FleetManifest)))
}

pub fn harn_package_repositories(manifest: FleetManifest) -> list<FleetRepository> {
  return manifest.repositories.filter({ repo -> repo.harn_package ?? false }).to_list()
}

pub fn harn_bump_repositories(manifest: FleetManifest) -> list<FleetRepository> {
  return manifest.repositories.filter({ repo -> repo.harn_bump ?? false }).to_list()
}

pub fn resolve_fleet_root(configured: string, home: string) -> string {
  if configured == "~" {
    return home
  }
  if starts_with(configured, "~/") {
    return path_join(home, configured[2:len(configured)])
  }
  return configured
}
