import { read_toml_typed } from "std/fs"

/** One repository and the Harn-owned fleet capabilities projected into it. */
pub type FleetRepository = {
  slug: string,
  directory: string,
  harn_package?: bool,
  package_ci_ownership?: "fleet" | "pin",
  package_validate_command?: string,
  harn_bump?: bool,
  harn_pin_kind?: "auto" | "version_file" | "cargo" | "formula",
  harn_pin_path?: string,
  bump_workflow_ownership?: "fleet" | "repository",
  bump_workflow_path?: string,
  bump_branch?: string,
  bump_branch_template?: string,
  bump_repair_enabled?: bool,
  bump_prerequisites?: list<string>,
  bump_max_releases_behind?: int,
  bump_require_signed_head?: bool,
  run_poll_tick?: bool,
  test_jobs?: int,
  bump_refresh_command?: string,
  bump_refresh_notes?: string,
  bump_validate_command?: string,
  bump_node_version?: string,
  bump_allowed_new_files?: list<string>,
  bump_apply_behavior_preserving_fixes?: bool,
  bump_enable_auto_merge?: bool,
}

/** One exact file shape used to read a consumer's Harn version. */
pub type HarnPinSpec = {kind: "auto" | "version_file" | "cargo" | "formula", path?: string}

/** One already-resolved dependency that must reach the target before dispatch. */
pub type HarnUpdatePrerequisite = {repository: string, base_branch: string, pin: HarnPinSpec}

/** Resolved semantic contract for one repository's thin bump adapter. */
pub type BumpAdapterContract = {
  workflow_reference: string,
  orchestration_sha: string,
  refresh_command: string,
  validation_command: string,
  node_version: string,
  publish_failure_for_repair: bool,
  apply_behavior_preserving_fixes: bool,
  enable_auto_merge: bool,
}

/**
 * The complete per-repository update contract consumed by dispatch, proof,
 * staleness, and repair. Callers do not interpret manifest defaults.
 */
pub type HarnUpdateSpec = {
  repository: string,
  base_branch: string,
  workflow_path: string,
  workflow_name: string,
  branch: string,
  pin: HarnPinSpec,
  repair_enabled: bool,
  auto_arm: bool,
  require_signed_head: bool,
  prerequisites: list<HarnUpdatePrerequisite>,
  max_releases_behind: int,
  adapter: BumpAdapterContract,
}

pub type HarnUpdateArmDecision = {
  action: "arm" | "already_armed" | "withhold" | "refuse",
  reason: string,
}

/** Decide arming from the resolved policy and exact signed-head evidence. */
pub fn harn_update_arm_decision(
  spec: HarnUpdateSpec,
  observed_head: string,
  auto_merge_armed: bool,
  signature_head: string? = nil,
  unsigned_count: int = 0,
) -> HarnUpdateArmDecision {
  if !spec.auto_arm {
    return if auto_merge_armed {
      {action: "refuse", reason: "auto-merge is armed against the resolved update contract"}
    } else {
      {action: "withhold", reason: "withheld_by_manifest"}
    }
  }
  if spec.require_signed_head {
    if trim(signature_head ?? "") == "" {
      return {action: "refuse", reason: "signed head evidence is missing"}
    }
    if lowercase(trim(signature_head ?? "")) != lowercase(trim(observed_head)) {
      return {action: "refuse", reason: "signed head evidence moved from the observed PR lease"}
    }
    if unsigned_count > 0 {
      return {
        action: "refuse",
        reason: "observed PR head contains ${unsigned_count} unsigned commit(s)",
      }
    }
  }
  return if auto_merge_armed {
    {action: "already_armed", reason: "already_enabled"}
  } else {
    {action: "arm", reason: "exact signed head is eligible"}
  }
}

/** One byte-exact file projection whose semantic owner is the source. */
pub type FleetFileProjection = {
  source_slug: string,
  source_path: string,
  target_slug: string,
  target_path: string,
}

/** The typed authority for every repository-wide Harn projection. */
pub type FleetManifest = {
  schema_version: 1,
  fleet: {default_root: string, default_branch: string},
  policy: {
    package_workflow: string,
    bump_workflow: string,
    publish_failures_for_repair?: bool,
    apply_behavior_preserving_fixes?: bool,
  },
  file_projections: list<FleetFileProjection>,
  repositories: list<FleetRepository>,
}

/** Resolve the one manifest-owned validator used by both bump and repair paths. */
pub fn bump_validation_command(repo: FleetRepository) -> string {
  if repo.bump_validate_command != nil {
    return trim(repo.bump_validate_command ?? "")
  }
  if repo.harn_package ?? false {
    return "harn package verify ."
  }
  return ""
}

/** Resolve every semantic input one repository's dispatch adapter must project. */
pub fn bump_adapter_contract(
  manifest: FleetManifest,
  repo: FleetRepository,
) -> BumpAdapterContract {
  return {
    workflow_reference: manifest.policy.bump_workflow,
    orchestration_sha: parse_workflow_policy_reference(manifest.policy.bump_workflow).ref,
    refresh_command: trim(repo.bump_refresh_command ?? ""),
    validation_command: bump_validation_command(repo),
    node_version: trim(repo.bump_node_version ?? ""),
    publish_failure_for_repair: manifest.policy.publish_failures_for_repair ?? false,
    apply_behavior_preserving_fixes: bump_applies_behavior_preserving_fixes(manifest, repo),
    enable_auto_merge: bump_arms_auto_merge(repo),
  }
}

/** Parsed owner/repository, workflow path, and immutable revision for one policy workflow. */
pub type FleetWorkflowPolicyReference = {slug: string, path: string, ref: string}

/** Decode one already-validated reusable-workflow reference for live policy checks. */
pub fn parse_workflow_policy_reference(value: string) -> FleetWorkflowPolicyReference {
  const matches = regex_captures(
    "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml)@([0-9a-f]{40})$",
    value,
  )
  if len(matches) != 1 || len(matches[0].groups) != 3 {
    throw "invalid fleet reusable-workflow policy reference: '${value}'"
  }
  return {slug: matches[0].groups[0], path: matches[0].groups[1], ref: matches[0].groups[2]}
}

/** Derive the co-versioned CI status action from the canonical package workflow pin. */
pub fn package_status_action_reference(package_workflow: string) -> string {
  const reference = parse_workflow_policy_reference(package_workflow)
  return reference.slug
    + "/.github/actions/require-successful-needs@"
    + reference.ref
}

fn validate_repository_slug(slug: string) {
  if len(regex_captures("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", slug)) == 0 {
    throw "invalid fleet repository slug '${slug}'"
  }
}

fn validate_repository_path(path: string) {
  if trim(path) != path || path == "" || starts_with(path, "/") || contains(path, "..") {
    throw "invalid fleet repository path '${path}'"
  }
}

fn safe_git_branch(branch: string) -> bool {
  return trim(branch) == branch
    && branch != ""
    && !starts_with(branch, "/")
    && !ends_with(branch, "/")
    && !contains(branch, "..")
    && len(regex_captures("^[A-Za-z0-9._/-]+$", branch)) > 0
}

fn expand_bump_branch_template(template: string, target: string) -> string {
  const parts = split(template, "{target}")
  if len(parts) != 2 {
    throw "bump branch template must contain exactly one '{target}' placeholder"
  }
  const branch = parts[0] + target + parts[1]
  if !safe_git_branch(branch) {
    throw "bump branch template resolves to unsafe Git branch '${branch}'"
  }
  return branch
}

fn validate_update_pin(repo: FleetRepository) {
  const kind = repo.harn_pin_kind ?? "auto"
  const path = trim(repo.harn_pin_path ?? "")
  if kind == "auto" && path != "" {
    throw "fleet repository '${repo.slug}' declares a pin path without an explicit pin kind"
  }
  if kind != "auto" && path == "" {
    throw "fleet repository '${repo.slug}' declares pin kind '${kind}' without a pin path"
  }
  if path != "" {
    validate_repository_path(path)
  }
  if kind == "formula" && !ends_with(path, ".rb") {
    throw "fleet repository '${repo.slug}' formula pin path must end in .rb"
  }
}

fn validate_package_projection(repo: FleetRepository) {
  if (repo.run_poll_tick ?? false) && !(repo.harn_package ?? false) {
    throw "fleet repository '${repo.slug}' enables run_poll_tick without harn_package"
  }
  if repo.package_ci_ownership != nil && !(repo.harn_package ?? false) {
    throw "fleet repository '${repo.slug}' delegates package CI without harn_package"
  }
  if repo.package_validate_command != nil
    && (repo.package_ci_ownership != "fleet"
      || trim(repo.package_validate_command ?? "")
        == "") {
    throw "fleet repository '${repo.slug}' has package validation without fleet-owned package CI"
  }
  if repo.test_jobs != nil && (!(repo.harn_package ?? false) || (repo.test_jobs ?? 0) <= 0) {
    throw "fleet repository '${repo.slug}' sets test_jobs without a positive harn_package worker count"
  }
  if (repo.harn_package ?? false) && repo.package_ci_ownership == nil {
    throw "fleet repository '${repo.slug}' is a Harn package without explicit package CI ownership"
  }
}

fn validate_update_routing(repo: FleetRepository) {
  if repo.bump_workflow_ownership != nil && !(repo.harn_bump ?? false) {
    throw "fleet repository '${repo.slug}' delegates its bump workflow without harn_bump"
  }
  for value in [repo.bump_workflow_path, repo.bump_branch, repo.bump_branch_template] {
    if value != nil && !(repo.harn_bump ?? false) {
      throw "fleet repository '${repo.slug}' customizes update routing without harn_bump"
    }
  }
  const workflow_path = repo.bump_workflow_path ?? ".github/workflows/bump-harn.yml"
  if !starts_with(workflow_path, ".github/workflows/")
    || len(regex_captures("^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$", workflow_path))
      == 0 {
    throw "fleet repository '${repo.slug}' has unsafe bump workflow path '${workflow_path}'"
  }
  const branch = repo.bump_branch ?? "automation/bump-harn-runtime"
  if !safe_git_branch(branch) {
    throw "fleet repository '${repo.slug}' has unsafe bump branch '${branch}'"
  }
  if repo.bump_branch != nil && repo.bump_branch_template != nil {
    throw "fleet repository '${repo.slug}' declares both a bump branch and branch template"
  }
  if repo.bump_branch_template != nil {
    expand_bump_branch_template(repo.bump_branch_template ?? "", "v0.0.0")
  }
  if repo.bump_repair_enabled != nil && !(repo.harn_bump ?? false) {
    throw "fleet repository '${repo.slug}' overrides repair without harn_bump"
  }
  if repo.bump_require_signed_head != nil && !(repo.harn_bump ?? false) {
    throw "fleet repository '${repo.slug}' overrides signing without harn_bump"
  }
  if repo.bump_max_releases_behind != nil && (repo.bump_max_releases_behind ?? -1) < 0 {
    throw "fleet repository '${repo.slug}' has a negative staleness budget"
  }
}

fn validate_update_execution(repo: FleetRepository) {
  for command in [repo.bump_refresh_command, repo.bump_validate_command] {
    if command != nil && (!(repo.harn_bump ?? false) || trim(command ?? "") == "") {
      throw "fleet repository '${repo.slug}' has a bump command without harn_bump or content"
    }
  }
  if repo.bump_workflow_ownership == "fleet"
    && !(repo.harn_package ?? false)
    && repo.bump_validate_command
      == nil {
    throw "fleet repository '${repo.slug}' delegates a non-package bump without validation"
  }
  if repo.bump_node_version != nil {
    const node_version = trim(repo.bump_node_version ?? "")
    if !(repo.harn_bump ?? false)
      || node_version
        == ""
      || len(regex_captures("^[A-Za-z0-9._-]+$", node_version))
        == 0 {
      throw "fleet repository '${repo.slug}' has invalid bump_node_version"
    }
  }
  if repo.bump_apply_behavior_preserving_fixes != nil && !(repo.harn_bump ?? false) {
    throw "fleet repository '${repo.slug}' overrides the behavior-preserving fix pass without harn_bump"
  }
  if repo.bump_enable_auto_merge != nil && !(repo.harn_bump ?? false) {
    throw "fleet repository '${repo.slug}' overrides bump auto-merge without harn_bump"
  }
  for path in repo.bump_allowed_new_files ?? [] {
    validate_repository_path(path)
  }
}

fn validate_bump_projection(repo: FleetRepository) {
  validate_update_pin(repo)
  validate_update_routing(repo)
  validate_update_execution(repo)
}

fn repository_by_slug(repositories: list<FleetRepository>, slug: string) -> FleetRepository? {
  for repo in repositories {
    if repo.slug == slug {
      return repo
    }
  }
  return nil
}

fn validate_update_prerequisites(repositories: list<FleetRepository>) {
  for repo in repositories {
    let seen = {}
    for prerequisite in repo.bump_prerequisites ?? [] {
      validate_repository_slug(prerequisite)
      if prerequisite == repo.slug {
        throw "fleet repository '${repo.slug}' cannot depend on its own update"
      }
      if seen[prerequisite] ?? false {
        throw "fleet repository '${repo.slug}' repeats update prerequisite '${prerequisite}'"
      }
      const required = repository_by_slug(repositories, prerequisite)
      if required == nil || !(required.harn_bump ?? false) {
        throw "fleet repository '${repo.slug}' has unmanaged update prerequisite '${prerequisite}'"
      }
      seen[prerequisite] = true
    }
  }
  let pending = repositories.filter({ repo -> repo.harn_bump ?? false }).to_list()
  while len(pending) > 0 {
    const pending_slugs = pending.map({ repo -> repo.slug }).to_list()
    const ready = pending.filter(
      { repo ->
        (repo.bump_prerequisites ?? []).all(
          { prerequisite -> !pending_slugs.contains(prerequisite) },
        )
      },
    )
      .to_list()
    if len(ready) == 0 {
      throw "fleet update prerequisites contain a cycle"
    }
    const ready_slugs = ready.map({ repo -> repo.slug }).to_list()
    pending = pending.filter({ repo -> !ready_slugs.contains(repo.slug) }).to_list()
  }
}

/** Validate the fleet manifest's unique repository and mechanically owned projection contracts. */
pub fn validate_fleet_manifest(manifest: FleetManifest) -> FleetManifest {
  if trim(manifest.fleet.default_root) == "" {
    throw "fleet.default_root must not be empty"
  }
  const default_branch = manifest.fleet.default_branch
  if len(regex_captures("^[A-Za-z0-9._/-]+$", default_branch)) == 0
    || starts_with(default_branch, "/")
    || ends_with(default_branch, "/")
    || contains(default_branch, "..") {
    throw "fleet.default_branch is not a safe Git ref name: '${default_branch}'"
  }
  for policy_ref in [manifest.policy.package_workflow, manifest.policy.bump_workflow] {
    if len(regex_captures("^[^@]+@[0-9a-f]{40}$", policy_ref)) == 0 {
      throw "fleet policy references must use an immutable full commit SHA: '${policy_ref}'"
    }
    parse_workflow_policy_reference(policy_ref)
  }
  let slugs = {}
  let directories = {}
  for repo in manifest.repositories {
    validate_repository_slug(repo.slug)
    if len(regex_captures("^[A-Za-z0-9_.-]+$", repo.directory)) == 0 {
      throw "invalid fleet repository directory '${repo.directory}'"
    }
    if slugs[repo.slug] ?? false {
      throw "duplicate fleet repository slug '${repo.slug}'"
    }
    if directories[repo.directory] ?? false {
      throw "duplicate fleet repository directory '${repo.directory}'"
    }
    validate_package_projection(repo)
    validate_bump_projection(repo)
    slugs[repo.slug] = true
    directories[repo.directory] = true
  }
  validate_update_prerequisites(manifest.repositories)
  let projection_targets = {}
  for projection in manifest.file_projections {
    validate_repository_slug(projection.source_slug)
    validate_repository_slug(projection.target_slug)
    validate_repository_path(projection.source_path)
    validate_repository_path(projection.target_path)
    if !(slugs[projection.source_slug] ?? false) || !(slugs[projection.target_slug] ?? false) {
      throw "fleet file projection repositories must be declared in [[repositories]]"
    }
    const target_key = projection.target_slug + ":" + projection.target_path
    if projection_targets[target_key] ?? false {
      throw "duplicate fleet file projection target '${target_key}'"
    }
    if projection.source_slug == projection.target_slug
      && projection.source_path
        == projection.target_path {
      throw "fleet file projection source and target must differ"
    }
    projection_targets[target_key] = true
  }
  return manifest
}

fn pin_spec(repo: FleetRepository) -> HarnPinSpec {
  const kind: "auto" | "version_file" | "cargo" | "formula" = repo.harn_pin_kind ?? "auto"
  if kind == "auto" {
    const automatic: HarnPinSpec = {kind: "auto"}
    return automatic
  }
  if kind == "formula" {
    return schema_expect({kind: "formula", path: to_string(repo.harn_pin_path ?? "")}, HarnPinSpec)
  }
  if kind == "cargo" {
    return schema_expect({kind: "cargo", path: to_string(repo.harn_pin_path ?? "")}, HarnPinSpec)
  }
  return schema_expect(
    {kind: "version_file", path: to_string(repo.harn_pin_path ?? "")},
    HarnPinSpec,
  )
}

/** Resolve every update decision once for one exact release target. */
pub fn resolve_harn_update_spec(
  manifest: FleetManifest,
  repo: FleetRepository,
  target: string,
) -> HarnUpdateSpec {
  const workflow_path = repo.bump_workflow_path ?? ".github/workflows/bump-harn.yml"
  const branch = if repo.bump_branch_template != nil {
    expand_bump_branch_template(repo.bump_branch_template ?? "", target)
  } else {
    const fixed = repo.bump_branch ?? "automation/bump-harn-runtime"
    if !safe_git_branch(fixed) {
      throw "fleet repository '${repo.slug}' has unsafe bump branch '${fixed}'"
    }
    fixed
  }
  let prerequisites: list<HarnUpdatePrerequisite> = []
  for slug in repo.bump_prerequisites ?? [] {
    const required = repository_by_slug(manifest.repositories, slug)
    if required == nil {
      throw "fleet repository '${repo.slug}' prerequisite '${slug}' disappeared after validation"
    }
    prerequisites = prerequisites
      + [{repository: slug, base_branch: manifest.fleet.default_branch, pin: pin_spec(required)}]
  }
  return {
    repository: repo.slug,
    base_branch: manifest.fleet.default_branch,
    workflow_path: workflow_path,
    workflow_name: basename(workflow_path),
    branch: branch,
    pin: pin_spec(repo),
    repair_enabled: repo.bump_repair_enabled ?? true,
    auto_arm: bump_arms_auto_merge(repo),
    require_signed_head: repo.bump_require_signed_head ?? true,
    prerequisites: prerequisites,
    max_releases_behind: repo.bump_max_releases_behind ?? 1,
    adapter: bump_adapter_contract(manifest, repo),
  }
}

/** Read and validate a typed fleet manifest from `path`. */
pub fn read_fleet_manifest(fs: HarnessFs, path: string = "fleet.toml") -> FleetManifest {
  return validate_fleet_manifest(read_toml_typed<FleetManifest>(fs, path, schema_of(FleetManifest)))
}

/** Return repositories admitted through the canonical Harn package workflow. */
pub fn harn_package_repositories(manifest: FleetManifest) -> list<FleetRepository> {
  return manifest.repositories.filter({ repo -> repo.harn_package ?? false }).to_list()
}

/**
 * Resolve whether one repository takes the unattended behavior-preserving fix
 * pass during a runtime bump.
 *
 * The fleet default is off. That pass applies behavior-CHANGING edits under a
 * behavior-preserving safety tier (harn#6837), and every managed repository
 * runs it unattended against source the fleet does not own. A repository that
 * has established the pass is safe for its own sources opts back in here; the
 * fleet-wide default returns to on only once the rule's soundness defect is
 * fixed and proven.
 *
 * Both projection and live policy evaluation read this one resolution, so a
 * generated adapter and the audit that checks it cannot disagree.
 */
pub fn bump_applies_behavior_preserving_fixes(
  manifest: FleetManifest,
  repo: FleetRepository,
) -> bool {
  return repo.bump_apply_behavior_preserving_fixes
    ?? (manifest.policy.apply_behavior_preserving_fixes
      ?? false)
}

/**
 * Resolve whether a repository's bump pull request arms auto-merge itself.
 *
 * Armed is the fleet default and stays that way: a routine runtime bump should
 * land on its own checks. A repository opts out when merging the bump would
 * decide something reserved for a person — a repin whose consequences someone
 * has to rule on — because an auto-merge overnight makes that decision by
 * automation instead. This withholds arming only; the pull request still opens
 * and still runs its checks.
 *
 * Unlike the behavior-preserving fix pass, this is NOT projected when armed.
 * If the reusable workflow ever changed its own default here the failure is
 * benign — bumps would wait for a human — whereas the same drift on the fix
 * pass would silently rewrite caller-owned source.
 */
pub fn bump_arms_auto_merge(repo: FleetRepository) -> bool {
  return repo.bump_enable_auto_merge ?? true
}

/** Return repositories managed by the reusable Harn runtime bump workflow. */
pub fn harn_bump_repositories(manifest: FleetManifest) -> list<FleetRepository> {
  return manifest.repositories.filter({ repo -> repo.harn_bump ?? false }).to_list()
}

/**
 * Every repository whose Harn pin is worth watching, which is a wider set than
 * the one the fleet can bump.
 *
 * A repository the fleet cannot dispatch a bump to still has a pin that can go
 * stale, and a stale pin nobody watches is the failure this distinction exists
 * to prevent. `harn_pin_path` names where to read a pin that does not live in
 * `.harn-version`, and declaring it opts a repository into the watch without
 * claiming the fleet can bump it.
 */
pub fn harn_pin_watch_repositories(manifest: FleetManifest) -> list<FleetRepository> {
  return manifest.repositories.filter(
    { repo -> (repo.harn_bump ?? false) || trim(repo.harn_pin_path ?? "") != "" },
  )
    .to_list()
}

/** Narrow the watch set to one repository, or keep all of it. */
pub fn scoped_harn_pin_watch_repositories(
  manifest: FleetManifest,
  only: string?,
) -> list<FleetRepository> {
  const repositories = harn_pin_watch_repositories(manifest)
  if only == nil {
    return repositories
  }
  const selected = repositories.filter({ repo -> repo.slug == only }).to_list()
  if len(selected) != 1 {
    throw "fleet scope '${only ?? ""}' is not a watched Harn pin repository"
  }
  return selected
}

/** Select the exact Harn bump scope, failing closed when a named target is not managed. */
pub fn scoped_harn_bump_repositories(
  manifest: FleetManifest,
  only: string?,
) -> list<FleetRepository> {
  const repositories = harn_bump_repositories(manifest)
  if only == nil {
    return repositories
  }
  const selected = repositories.filter({ repo -> repo.slug == only }).to_list()
  if len(selected) != 1 {
    throw "fleet scope '${only ?? ""}' is not a managed Harn bump repository"
  }
  return selected
}

/** Resolve the configured fleet root, expanding a leading home-directory marker. */
pub fn resolve_fleet_root(configured: string, home: string) -> string {
  if configured == "~" {
    return home
  }
  if starts_with(configured, "~/") {
    return path_join(home, configured[2:len(configured)])
  }
  return configured
}
