import { admission_verdict, latest_check_per_name, required_check_state } from "./pr_admission"

/**
 * Resolving the one commit a release cuts from.
 *
 * A cut used to bind to the default branch: dispatching without an explicit pin
 * meant "whatever the branch is at this instant", and every later step re-read
 * the branch. Two costs followed from that single binding. The cut inherited
 * every red commit it never needed, and a commit landing mid-run changed what
 * later steps saw.
 *
 * The replacement is a resolution, not a read. Given the required contexts and
 * a page of recent commits newest first, this returns the newest commit whose
 * required contexts are all green, and that OID is the only thing the run ever
 * refers to afterwards.
 *
 * It refuses rather than falling back to the branch head. A fallback would
 * restore exactly the binding being removed, and it would do so silently on the
 * one input that decides what ships.
 *
 * Three refusals are kept apart on purpose, because collapsing them would make
 * an unread rollup indistinguishable from a rollup that was read and was red:
 *
 *   * `required_contexts_not_observed` — the branch's protection could not be
 *     read. An empty required set and an unprotected branch look identical, and
 *     treating either as satisfied would admit a commit on the strength of a
 *     failed API call.
 *   * `no_commits_scanned` — the page itself was empty. Nothing was measured,
 *     so nothing passed.
 *   * `no_green_commit_in_page` — the page was read and no commit in it was
 *     green. This is the only one of the three that is evidence about commits
 *     rather than about the reader.
 */
pub type ReleaseCertifiedPinRefusal = "required_contexts_not_observed" \
  | "no_commits_scanned" \
  | "no_green_commit_in_page"

/**
 * One commit's admissibility, reduced to what the resolver decides on.
 *
 * `rollup_read` is the measured-nothing bit. It is false when every required
 * context resolved to `MISSING` on this commit, which means the rollup was
 * never read rather than read and failed. A reader needs those apart: the first
 * says try again, the second says this commit is not the one.
 */
pub type ReleaseCertifiedPinCandidate = {
  sha: string,
  green: bool,
  rollup_read: bool,
  blocking_check: string,
  failing_contexts: list<string>,
}

/** The resolution, carrying enough to explain itself without a second read. */
pub type ReleaseCertifiedPinResolution = {
  resolved: bool,
  sha: string,
  scanned: int,
  required_contexts: list<string>,
  /** Every commit rejected on the way to the answer, newest first. */
  rejected: list<ReleaseCertifiedPinCandidate>,
  refusal: ReleaseCertifiedPinRefusal?,
  reason: string,
}

fn oid(value: any) -> string {
  return lowercase(trim(to_string(value ?? "")))
}

/**
 * Judge one commit against the required contexts.
 *
 * `rows` is the admission rollup selected by the owning reader. GitHub reports
 * some required contexts only on the pull-request head, so the live reader uses
 * that head for a merged pull request and the default-branch commit for a direct
 * push.
 */
pub fn release_certified_pin_candidate(
  sha: string,
  required_contexts: list<string>,
  rows: list?,
) -> ReleaseCertifiedPinCandidate {
  const reduced = latest_check_per_name(rows)
  let blocking = ""
  let failing: list<string> = []
  let observed = 0
  for context in required_contexts {
    const state = required_check_state(reduced, context)
    if state != "MISSING" {
      observed = observed + 1
    }
    if admission_verdict(true, state) == "pass" {
      continue
    }
    failing = failing + [context]
    if blocking == "" {
      blocking = context
    }
  }
  return {
    sha: oid(sha),
    green: len(required_contexts) > 0 && blocking == "",
    rollup_read: observed > 0,
    blocking_check: blocking,
    failing_contexts: failing,
  }
}

fn refuse(
  refusal: ReleaseCertifiedPinRefusal,
  reason: string,
  scanned: int,
  required_contexts: list<string>,
  rejected: list<ReleaseCertifiedPinCandidate>,
) -> ReleaseCertifiedPinResolution {
  return {
    resolved: false,
    sha: "",
    scanned: scanned,
    required_contexts: required_contexts,
    rejected: rejected,
    refusal: refusal,
    reason: reason,
  }
}

fn rejected_summary(rejected: list<ReleaseCertifiedPinCandidate>) -> string {
  let parts: list<string> = []
  for row in rejected {
    const detail = if !row.rollup_read {
      "no required context reported"
    } else {
      row.failing_contexts.join(", ")
    }
    parts = parts + ["${row.sha} (${detail})"]
  }
  return parts.join("; ")
}

/**
 * The newest commit in the page whose required contexts are all green.
 *
 * `candidates` is ordered newest first, the order the commits API returns. The
 * walk stops at the first green commit, so a red tip above a green commit
 * selects the green one rather than the newest one. That is the whole point: a
 * red on main is a statement about commits the release never needed.
 */
pub fn release_certified_pin_resolution(
  required_contexts: list<string>,
  candidates: list<ReleaseCertifiedPinCandidate>,
) -> ReleaseCertifiedPinResolution {
  if len(required_contexts) == 0 {
    return refuse(
      "required_contexts_not_observed",
      "the default branch reported no required contexts; refusing to resolve a release pin"
        + " against protection that could not be read",
      len(candidates),
      required_contexts,
      [],
    )
  }
  if len(candidates) == 0 {
    return refuse(
      "no_commits_scanned",
      "no commits were scanned on the default branch; nothing was measured, so nothing passed",
      0,
      required_contexts,
      [],
    )
  }
  let rejected: list<ReleaseCertifiedPinCandidate> = []
  for candidate in candidates {
    if candidate.sha == "" {
      continue
    }
    if candidate.green {
      return {
        resolved: true,
        sha: candidate.sha,
        scanned: len(candidates),
        required_contexts: required_contexts,
        rejected: rejected,
        refusal: nil,
        reason: "resolved ${candidate.sha}, the newest of ${len(candidates)} scanned commit(s)"
          + " carrying green ${required_contexts.join(", ")}"
          + if len(rejected) == 0 {
            ""
          } else {
            "; skipped ${len(rejected)} newer commit(s): ${rejected_summary(rejected)}"
          },
      }
    }
    rejected = rejected + [candidate]
  }
  return refuse(
    "no_green_commit_in_page",
    "none of the ${len(candidates)} scanned commit(s) carry green"
      + " ${required_contexts.join(", ")}: ${rejected_summary(rejected)}",
    len(candidates),
    required_contexts,
    rejected,
  )
}
