import { github_slug_parts } from "./github"
import { GithubClientOptions, GithubConnectorResult, api_call } from "harn-github-connector/default"

type GithubRepositoryMergeSettings = {allow_auto_merge: bool}

/** Read the measured repository setting without defaulting an absent field. */
pub fn github_repository_auto_merge_enabled(
  harness: Harness,
  slug: string,
  options: GithubClientOptions,
) -> GithubConnectorResult<bool> {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return Err({code: "invalid_repo", category: "schema_drift", message: "repo must be owner/name"})
  }
  const result = api_call(harness, {path: "/repos/${parts.owner}/${parts.repo}", options: options})
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const value = unwrap(result)
  if !schema_is(value, GithubRepositoryMergeSettings) {
    return Err(
      {
        code: "invalid_response",
        category: "schema_drift",
        message: "repository response omitted boolean allow_auto_merge",
      },
    )
  }
  return Ok(value.allow_auto_merge)
}
