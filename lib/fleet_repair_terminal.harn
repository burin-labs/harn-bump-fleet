import { HarnUpdateUsage } from "./harn_update"

pub type FleetRepairAttempt = {
  attempt: int,
  validation_ok: bool,
  validation_output: string,
  agent_status: string,
  route: "value" | "strong",
  route_reason: string,
  provider: string,
  model: string,
  usage: HarnUpdateUsage,
}

pub type FleetRepairValidationEvidence = {
  attempt: int,
  command: string,
  ok: bool,
  diagnostic: string,
}

pub type FleetRepairSourceMutationEvidence = {
  before_head_sha: string,
  after_head_sha: string,
  commit_created: bool,
  pushed_head_observed: bool,
}

pub type FleetRepairControlPlaneEvidence = {
  pull_request_present_before: bool,
  pull_request_present_after: bool,
  auto_merge_before: bool,
  auto_merge_after: bool,
}

pub type FleetRepairResult = {
  repo: string,
  status: "repaired" | "refused" | "failed" | "no_change",
  reason: string,
  pr_number?: int,
  old_head_sha?: string,
  new_head_sha?: string,
  validation_evidence?: list<FleetRepairValidationEvidence>,
  source_mutation?: FleetRepairSourceMutationEvidence,
  control_plane_mutation?: FleetRepairControlPlaneEvidence,
  attempts: list<FleetRepairAttempt>,
  known_cost_usd: float,
  cost_status: "exact" | "lower_bound" | "unknown",
}

pub type FleetRepairTerminalOutcome = "mutated" | "already_repaired" | "declined" | "failed"

pub type FleetRepairMutationEvidence = {
  head_changed: bool,
  commit_created: bool,
  pushed_head_observed: bool,
  control_plane_changed: bool,
}

pub type FleetRepairTerminalResult = FleetRepairResult \
  & {
  terminal_outcome: FleetRepairTerminalOutcome,
  before_head_sha: string,
  after_head_sha: string,
  attempted_validations: list<FleetRepairValidationEvidence>,
  mutation: FleetRepairMutationEvidence,
}

fn observed_source_change(result: FleetRepairResult) -> bool {
  const evidence = result.source_mutation
  return evidence != nil && trim(evidence.before_head_sha) != ""
    && trim(evidence.after_head_sha)
      != ""
    && lowercase(evidence.before_head_sha)
      != lowercase(evidence.after_head_sha)
    && evidence.commit_created
    && evidence.pushed_head_observed
}

fn observed_control_plane_change(result: FleetRepairResult) -> bool {
  const evidence = result.control_plane_mutation
  return evidence != nil
    && (evidence.pull_request_present_before
      != evidence.pull_request_present_after
      || evidence.auto_merge_before
        != evidence.auto_merge_after)
}

fn observed_valid_noop(result: FleetRepairResult) -> bool {
  const evidence = result.validation_evidence ?? []
  if len(evidence) == 0 {
    return false
  }
  const last = evidence[len(evidence) - 1]
  return trim(last?.command ?? "") != "" && (last?.ok ?? false)
}

/** Reduce controller-internal states to the four evidence-backed operator outcomes. */
pub fn fleet_repair_terminal_outcome(result: FleetRepairResult) -> FleetRepairTerminalOutcome {
  if result.status == "repaired"
    && (observed_source_change(result) || observed_control_plane_change(result)) {
    return "mutated"
  }
  if result.status == "no_change" && result.reason == "leased_checkout_already_valid"
    && trim(result.old_head_sha ?? "")
      != ""
    && lowercase(trim(result.new_head_sha ?? result.old_head_sha ?? ""))
      == lowercase(trim(result.old_head_sha ?? ""))
    && !observed_source_change(result)
    && !observed_control_plane_change(result)
    && observed_valid_noop(result) {
    return "already_repaired"
  }
  if result.status == "refused" {
    return "declined"
  }
  return "failed"
}

/** Project exact raw observations into the durable per-repository receipt. */
pub fn project_fleet_repair_terminal_result(
  result: FleetRepairResult,
  fallback_before_head: string,
  validation_command: string,
) -> FleetRepairTerminalResult {
  const terminal_outcome = fleet_repair_terminal_outcome(result)
  const before_head_sha = result.source_mutation?.before_head_sha
    ?? result.old_head_sha
    ?? fallback_before_head
  const after_head_sha = result.source_mutation?.after_head_sha
    ?? result.new_head_sha
    ?? before_head_sha
  let attempted_validations: list<FleetRepairValidationEvidence> = result.validation_evidence ?? []
  for attempt in result.attempts {
    attempted_validations = attempted_validations
      + [
        {
          attempt: attempt.attempt,
          command: validation_command,
          ok: attempt.validation_ok,
          diagnostic: attempt.validation_output,
        },
      ]
  }
  const source = result.source_mutation
  const control = result.control_plane_mutation
  return result
    + {
      terminal_outcome: terminal_outcome,
      before_head_sha: before_head_sha,
      after_head_sha: after_head_sha,
      attempted_validations: attempted_validations,
      mutation: {
        head_changed: source != nil && trim(source.before_head_sha) != ""
          && trim(source.after_head_sha)
            != ""
          && lowercase(source.before_head_sha)
            != lowercase(source.after_head_sha),
        commit_created: source?.commit_created ?? false,
        pushed_head_observed: source?.pushed_head_observed ?? false,
        control_plane_changed: control != nil
          && (control.pull_request_present_before
            != control.pull_request_present_after
            || control.auto_merge_before
              != control.auto_merge_after),
      },
    }
}
