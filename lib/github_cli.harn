import { command_json, command_run, command_try } from "std/command"
import {
  schema_closed_object,
  schema_int,
  schema_list,
  schema_literal,
  schema_string,
  schema_validator,
} from "std/schema"
import {
  actions_workflow_dispatch,
  actions_workflow_run,
  actions_workflow_run_jobs,
  actions_workflow_runs,
  github_dispatch_workflow_and_resolve_run,
  pulls_enable_auto_merge,
  repos_get_text,
} from "harn-github-connector/default"

pub type GithubActionsWorkflowRun = {
  workflow_run_id: int,
  workflow_run_url: string,
  source_sha: string,
  event: string,
  head_branch: string,
  status: string,
  conclusion: string,
  created_at: string,
  started_at: string,
  completed_at: string,
}

pub type GithubActionsWorkflowJob = {name: string, status: string, conclusion: string}

pub type GithubActionsWorkflowRunProbe = {
  success: bool,
  value?: GithubActionsWorkflowRun,
  error: string,
}

pub type GithubActionsWorkflowJobsProbe = {
  success: bool,
  value: list<GithubActionsWorkflowJob>,
  error: string,
}

pub type GithubActionsWorkflowDispatchProbe = {
  accepted: bool,
  workflow_run_id: int,
  workflow_run_url: string,
  source_sha: string,
  message: string,
}

/** Run GitHub CLI with argv, avoiding shell quoting for structured calls. */
pub fn gh_argv(args) {
  return command_run(["gh", ...args])
}

fn gh_command_label(args) {
  return "gh " + join(args.map({ a -> to_string(a) }), " ")
}

fn gh_connector_auth() {
  return {allow_gh_auth_fallback: true}
}

fn github_slug_parts(slug) {
  let parts = split(to_string(slug), "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    return nil
  }
  return {owner: parts[0], repo: parts[1]}
}

fn connector_result(payload, source) {
  if payload == nil || is_err(payload) {
    return {
      ok: false,
      status: "miss",
      error: {category: "miss", source: source, message: source + " returned no usable payload"},
    }
  }
  return {ok: true, value: payload}
}

/** Build argv for reading a repository file at a ref through `gh api`. */
pub fn gh_contents_get_args(slug, path, ref) {
  return ["api", "--method", "GET", "repos/${slug}/contents/${path}", "-f", "ref=${ref}"]
}

fn __decode_contents(payload) {
  let encoded = (payload?.content ?? "").replace("\n", "")
  if encoded == "" {
    return nil
  }
  return try {
    base64_decode(encoded)
  } catch (e) {
    nil
  }
}

/** Read a repository file at a ref through `gh api`, returning decoded UTF-8 text or nil. */
pub fn gh_file_text_at_ref(slug, path, ref) {
  let parts = github_slug_parts(slug)
  let attempts = []
  if parts != nil {
    attempts = attempts
      + [
      {
        source: "connector",
        run: fn() { return connector_result(
          repos_get_text(parts.owner, parts.repo, path, ref, gh_connector_auth()),
          "connector",
        ) },
      },
    ]
  }
  attempts = attempts + [{source: "cli", spec: ["gh", ...gh_contents_get_args(slug, path, ref)]}]
  let result = command_try(
    attempts,
    {
      command_options: {allow_empty: true},
      normalize: { payload, source ->
        if source == "connector" {
          return payload.text
        }
        return __decode_contents(payload)
      },
    },
  )
  if result.ok {
    return result.value
  }
  return nil
}

/** Extract a pull request number from either `123` or a GitHub pull URL. */
pub fn gh_pr_number(pr_ref) {
  let direct = to_int(to_string(pr_ref))
  if direct != nil {
    return direct
  }
  let matches = regex_captures("/pull/([0-9]+)", to_string(pr_ref))
  if len(matches) == 0 {
    return nil
  }
  return to_int(matches[0].groups[0])
}

fn gh_pr_cli_target(pr_ref) {
  let parsed = gh_pr_number(pr_ref)
  if parsed != nil {
    return to_string(parsed)
  }
  return to_string(pr_ref)
}

/** Ordered CLI attempts for enabling PR auto-merge. */
pub fn gh_auto_merge_cli_attempts(slug, pr_ref, merge_method = "squash") {
  let base = ["pr", "merge", gh_pr_cli_target(pr_ref)]
  let repo = trim(slug ?? "")
  if repo != "" {
    base = [...base, "--repo", repo]
  }
  base = [...base, "--auto"]
  let method = trim(merge_method ?? "")
  if method == "" {
    return [base]
  }
  return [base, [...base, "--${method}"]]
}

/** Enable PR auto-merge across merge-queue and non-queue repositories. */
pub fn gh_enable_auto_merge(slug, pr_ref, merge_method = "squash") {
  let parts = github_slug_parts(slug)
  let pr_number = gh_pr_number(pr_ref)
  if parts != nil && pr_number != nil {
    let connector = try {
      pulls_enable_auto_merge(
        parts.owner,
        parts.repo,
        pr_number,
        gh_connector_auth() + {method: merge_method},
      )
    } catch (e) {
      nil
    }
    if connector != nil && !is_err(connector) {
      return {
        success: true,
        status: connector.state ?? "enabled",
        strategy: "connector",
        command: "harn-github-connector pulls_enable_auto_merge",
        stderr: "",
      }
    }
  }
  let attempts = gh_auto_merge_cli_attempts(slug, pr_ref, merge_method)
  let base = attempts[0]
  let no_strategy = gh_argv(base)
  if no_strategy.success {
    return {
      success: true,
      status: "enabled",
      strategy: "default",
      command: gh_command_label(base),
      stderr: trim(no_strategy.stderr),
    }
  }
  if len(attempts) < 2 {
    return {
      success: false,
      status: "failed",
      strategy: "",
      command: gh_command_label(base),
      stderr: trim(no_strategy.stderr),
    }
  }
  let fallback_args = attempts[1]
  let fallback = gh_argv(fallback_args)
  if fallback.success {
    return {
      success: true,
      status: "enabled",
      strategy: merge_method,
      command: gh_command_label(fallback_args),
      stderr: trim(fallback.stderr),
    }
  }
  return {
    success: false,
    status: "failed",
    strategy: "",
    command: gh_command_label(fallback_args),
    stderr: trim(no_strategy.stderr + "\n" + fallback.stderr),
  }
}

/** Close a PR with an operator-visible comment. */
pub fn gh_pr_close(slug, pr_number, comment) {
  return gh_argv(["pr", "close", to_string(pr_number), "--repo", slug, "--comment", comment])
}

/** Add an operator-visible PR comment. */
pub fn gh_pr_comment(slug, pr_number, body) {
  return gh_argv(["pr", "comment", to_string(pr_number), "--repo", slug, "--body", body])
}

/** Build CLI argv for a workflow dispatch at an explicit branch or tag ref. */
pub fn gh_workflow_run_args(slug: string, workflow: string, fields = nil, ref: string = "main") -> list<string> {
  let args = ["workflow", "run", workflow, "--repo", slug, "--ref", ref]
  for entry in (fields ?? {}).entries() {
    args = [...args, "-F", entry.key + "=" + to_string(entry.value)]
  }
  return args
}

/** Dispatch a workflow at `ref`, preferring the connector with CLI fallback. */
pub fn gh_workflow_run(slug, workflow, fields = nil, ref: string = "main") {
  let parts = github_slug_parts(slug)
  if parts != nil {
    let connector = try {
      actions_workflow_dispatch(parts.owner, parts.repo, workflow, ref, fields ?? {}, gh_connector_auth())
    } catch (e) {
      nil
    }
    if connector != nil && !is_err(connector) {
      return {success: true, status: 0, stdout: json_stringify(connector), stderr: "", strategy: "connector"}
    }
  }
  return gh_argv(gh_workflow_run_args(slug, workflow, fields, ref))
}

fn actions_workflow_run_schema() {
  return schema_closed_object(
    {
      workflow_run_id: schema_int() + {minimum: 1},
      workflow_run_url: schema_string()
        + {pattern: "^https://github[.]com/[^/]+/[^/]+/actions/runs/[0-9]+$"},
      source_sha: schema_string() + {pattern: "^[0-9a-f]{40}$"},
      event: schema_string(),
      head_branch: schema_string(),
      status: schema_string(),
      conclusion: schema_string(),
      created_at: schema_string(),
      started_at: schema_string(),
      completed_at: schema_string(),
    },
  )
}

fn actions_workflow_job_schema() {
  return schema_closed_object({name: schema_string(), status: schema_string(), conclusion: schema_string()})
}

fn normalize_actions_workflow_run(value) -> GithubActionsWorkflowRunProbe {
  const projected = {
    workflow_run_id: to_int(value?.id ?? value?.databaseId),
    workflow_run_url: trim(value?.html_url ?? value?.url ?? ""),
    source_sha: lowercase(trim(value?.head_sha ?? value?.headSha ?? "")),
    event: lowercase(trim(value?.event ?? "")),
    head_branch: trim(value?.head_branch ?? value?.headBranch ?? ""),
    status: lowercase(trim(value?.status ?? "")),
    conclusion: lowercase(trim(value?.conclusion ?? "")),
    created_at: trim(value?.created_at ?? value?.createdAt ?? ""),
    started_at: trim(value?.run_started_at ?? value?.started_at ?? value?.created_at ?? ""),
    completed_at: trim(value?.updated_at ?? value?.completed_at ?? ""),
  }
  const report = schema_validator(actions_workflow_run_schema()).report(projected)
  if !report.ok {
    return {success: false, error: "invalid connector workflow run: " + join(report.errors, "; ")}
  }
  const run: GithubActionsWorkflowRun = report.value
  return {success: true, value: run, error: ""}
}

fn normalize_actions_workflow_jobs(value) -> GithubActionsWorkflowJobsProbe {
  const projected = (value?.jobs ?? [])
    .map(
    { job -> return {
      name: trim(job?.name ?? ""),
      status: lowercase(trim(job?.status ?? "")),
      conclusion: lowercase(trim(job?.conclusion ?? "")),
    } },
  )
    .to_list()
  const report = schema_validator(schema_list(actions_workflow_job_schema())).report(projected)
  if !report.ok {
    return {success: false, value: [], error: "invalid connector workflow jobs: " + join(report.errors, "; ")}
  }
  const jobs: list<GithubActionsWorkflowJob> = report.value
  return {success: true, value: jobs, error: ""}
}

/** Read one exact Actions run through the connector; there is deliberately no CLI fallback. */
pub fn gh_actions_workflow_run(slug: string, run_id: int) -> GithubActionsWorkflowRunProbe {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return {success: false, error: "invalid GitHub slug: " + slug}
  }
  const value = actions_workflow_run(parts.owner, parts.repo, run_id, gh_connector_auth())
  if is_err(value) {
    return {success: false, error: "connector workflow-run lookup failed: " + to_string(unwrap_err(value))}
  }
  return normalize_actions_workflow_run(value)
}

/** Read jobs for one exact Actions run through the typed connector API only. */
pub fn gh_actions_workflow_run_jobs(slug: string, run_id: int) -> GithubActionsWorkflowJobsProbe {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return {success: false, value: [], error: "invalid GitHub slug: " + slug}
  }
  const value = actions_workflow_run_jobs(
    parts.owner,
    parts.repo,
    run_id,
    gh_connector_auth() + {filter: "latest", per_page: 100},
  )
  if is_err(value) {
    return {
      success: false,
      value: [],
      error: "connector workflow-job lookup failed: " + to_string(unwrap_err(value)),
    }
  }
  return normalize_actions_workflow_jobs(value)
}

fn actions_workflow_dispatch_identity_schema() {
  return schema_closed_object(
    {
      ok: schema_literal(true),
      status: schema_literal("dispatch_accepted"),
      run_id: schema_int() + {minimum: 1},
      run_url: schema_string()
        + {pattern: "^https://github[.]com/[^/]+/[^/]+/actions/runs/[0-9]+$"},
      head_sha: schema_string() + {pattern: "^[0-9a-f]{40}$"},
      head_branch: schema_literal("main"),
      event: schema_literal("workflow_dispatch"),
    },
  )
}

/** Dispatch a warm run and return once the connector resolves one exact run identity. */
pub fn gh_actions_warm_cache_dispatch(slug: string, workflow: string, fields: dict) -> GithubActionsWorkflowDispatchProbe {
  const parts = github_slug_parts(slug)
  if parts == nil {
    return {
      accepted: false,
      workflow_run_id: 0,
      workflow_run_url: "",
      source_sha: "",
      message: "invalid GitHub slug: " + slug,
    }
  }
  const identity = github_dispatch_workflow_and_resolve_run(
    parts.owner,
    parts.repo,
    workflow,
    "main",
    fields,
    gh_connector_auth(),
  )
  const report = schema_validator(actions_workflow_dispatch_identity_schema())
    .report(
    {
      ok: identity?.ok,
      status: identity?.status,
      run_id: identity?.run_id,
      run_url: identity?.run_url,
      head_sha: identity?.head_sha,
      head_branch: identity?.head_branch,
      event: identity?.event,
    },
  )
  if !report.ok {
    const status = trim(identity?.status ?? "dispatch_failed")
    const detail = trim(to_string(identity?.error ?? ""))
    const message = if detail == "" {
      "warm-cache dispatch identity failed (${status})"
    } else {
      "warm-cache dispatch identity failed (${status}): ${detail}"
    }
    return {accepted: false, workflow_run_id: 0, workflow_run_url: "", source_sha: "", message: message}
  }
  const accepted = report.value
  const run_id: int = accepted.run_id
  return {
    accepted: true,
    workflow_run_id: run_id,
    workflow_run_url: accepted.run_url,
    source_sha: accepted.head_sha,
    message: "warm-cache dispatch accepted as workflow run ${run_id} at ${accepted.head_sha}",
  }
}

/** Normalize GitHub REST and gh CLI workflow-run records into one shape. */
pub fn gh_normalize_workflow_run(run) {
  return {
    databaseId: run?.databaseId ?? run?.id,
    createdAt: run?.createdAt ?? run?.created_at,
    displayTitle: run?.displayTitle ?? run?.display_title ?? run?.name,
    event: run?.event ?? "",
    headBranch: run?.headBranch ?? run?.head_branch ?? "",
    headSha: run?.headSha ?? run?.head_sha ?? "",
    status: run?.status,
    conclusion: run?.conclusion,
    url: run?.url ?? run?.html_url,
  }
}

/** List workflow runs, preferring harn-github-connector with gh fallback. */
pub fn gh_workflow_runs(slug, workflow, event = nil, limit = 10) {
  let cli_args = ["run", "list", "--repo", slug, "--workflow=" + workflow]
  if event != nil {
    cli_args = [...cli_args, "--event=" + event]
  }
  cli_args = [
    ...cli_args,
    "--limit",
    to_string(limit),
    "--json",
    "databaseId,createdAt,displayTitle,event,headBranch,headSha,status,conclusion,url",
  ]
  let parts = github_slug_parts(slug)
  let attempts = []
  if parts != nil {
    attempts = attempts
      + [
      {
        source: "connector",
        run: fn() {
          let opts = gh_connector_auth() + {workflow_id: workflow, per_page: limit}
          if event != nil {
            opts["event"] = event
          }
          return connector_result(actions_workflow_runs(parts.owner, parts.repo, opts), "connector")
        },
      },
    ]
  }
  attempts = attempts + [{source: "cli", spec: ["gh", ...cli_args]}]
  let result = command_try(
    attempts,
    {
      normalize: { payload, source ->
        let raw = if source == "connector" {
          payload.workflow_runs ?? []
        } else {
          payload
        }
        return raw.map({ r -> gh_normalize_workflow_run(r) })
      },
    },
  )
  if result.ok {
    return result.value
  }
  return []
}

/** Resolve a repository's latest GitHub release tag. */
pub fn gh_latest_release_tag(slug) {
  let r = gh_argv(["api", "repos/${slug}/releases/latest", "--jq", ".tag_name"])
  if !r.success {
    throw "could not resolve latest release for ${slug}: ${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

/** Build argv for reading release assets through gh. */
pub fn gh_release_view_args(slug, tag) {
  return ["release", "view", tag, "--repo", slug, "--json", "assets"]
}

/** Return the asset names attached to a GitHub release tag. */
pub fn gh_release_asset_names(slug, tag) {
  let release = command_json(["gh", ...gh_release_view_args(slug, tag)])
  return (release?.assets ?? []).map({ a -> a.name })
}

/** Classify transient GitHub CLI failures worth retrying. */
pub fn gh_cli_transient_failure(output) {
  let out = lowercase(output ?? "")
  return contains(out, "http 502") || contains(out, "http 503")
    || contains(out, "http 504")
    || contains(out, "gateway timeout")
    || contains(out, "service unavailable")
    || contains(out, "temporarily unavailable")
    || contains(out, "connection reset")
    || contains(out, "i/o timeout")
    || contains(out, "context deadline exceeded")
}

/** Short deterministic retry schedule for GitHub CLI hiccups. */
pub fn gh_retry_delay_seconds(attempt) {
  if attempt <= 2 {
    return 3
  }
  return 8
}
