import { process_run } from "std/runtime"
import { pulls_enable_auto_merge, repos_get_text } from "harn-github-connector/default"

/** Run GitHub CLI with existing operator authentication. */
pub fn gh_run(args) {
  return shell("gh ${args}")
}

/** Run GitHub CLI with argv, avoiding shell quoting for structured calls. */
pub fn gh_argv(args) {
  return process_run(["gh", ...args])
}

fn gh_command_label(args) {
  return "gh " + join(args.map({ a -> to_string(a) }), " ")
}

fn gh_connector_auth() {
  return {allow_gh_auth_fallback: true}
}

fn github_slug_parts(slug) {
  let parts = split(to_string(slug), "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    return nil
  }
  return {owner: parts[0], repo: parts[1]}
}

/** Run GitHub CLI and parse a JSON response, returning nil for empty output. */
pub fn gh_json(args) {
  let r = gh_run(args)
  if !r.success {
    throw "gh ${args} failed (exit ${r.status}): ${trim(r.stderr)}"
  }
  let body = trim(r.stdout)
  if body == "" {
    return nil
  }
  return json_parse(body)
}

/** Run GitHub CLI with argv and parse a JSON response, returning nil for empty output. */
pub fn gh_json_argv(args) {
  let r = gh_argv(args)
  if !r.success {
    throw gh_command_label(args) + " failed (exit ${r.status}): ${trim(r.stderr)}"
  }
  let body = trim(r.stdout)
  if body == "" {
    return nil
  }
  return json_parse(body)
}

/** Read a repository file at a ref through `gh api`, returning decoded UTF-8 text or nil. */
pub fn gh_contents_get_args(slug, path, ref) {
  return ["api", "--method", "GET", "repos/${slug}/contents/${path}", "-f", "ref=${ref}"]
}

/** Read a repository file at a ref through `gh api`, returning decoded UTF-8 text or nil. */
pub fn gh_file_text_at_ref(slug, path, ref) {
  let parts = github_slug_parts(slug)
  if parts != nil {
    let connector_doc = try {
      repos_get_text(parts.owner, parts.repo, path, ref, gh_connector_auth())
    } catch (e) {
      nil
    }
    if connector_doc != nil && !is_err(connector_doc) {
      return connector_doc.text
    }
  }
  let doc = try {
    gh_json_argv(gh_contents_get_args(slug, path, ref))
  } catch (e) {
    return nil
  }
  let encoded = (doc?.content ?? "").replace("\n", "")
  if encoded == "" {
    return nil
  }
  return try {
    base64_decode(encoded)
  } catch (e) {
    nil
  }
}

/** Enable PR auto-merge across merge-queue and non-queue repositories. */
pub fn gh_enable_auto_merge(slug, pr_number, merge_method = "squash") {
  let parts = github_slug_parts(slug)
  if parts != nil {
    let connector = try {
      pulls_enable_auto_merge(
        parts.owner,
        parts.repo,
        pr_number,
        gh_connector_auth() + {method: merge_method},
      )
    } catch (e) {
      nil
    }
    if connector != nil && !is_err(connector) {
      return {
        success: true,
        status: connector.state ?? "enabled",
        strategy: "connector",
        command: "harn-github-connector pulls_enable_auto_merge",
        stderr: "",
      }
    }
  }
  let base = ["pr", "merge", to_string(pr_number), "--repo", slug, "--auto"]
  let no_strategy = gh_argv(base)
  if no_strategy.success {
    return {
      success: true,
      status: "enabled",
      strategy: "default",
      command: gh_command_label(base),
      stderr: trim(no_strategy.stderr),
    }
  }
  let fallback_args = [...base, "--${merge_method}"]
  let fallback = gh_argv(fallback_args)
  if fallback.success {
    return {
      success: true,
      status: "enabled",
      strategy: merge_method,
      command: gh_command_label(fallback_args),
      stderr: trim(fallback.stderr),
    }
  }
  return {
    success: false,
    status: "failed",
    strategy: "",
    command: gh_command_label(fallback_args),
    stderr: trim(no_strategy.stderr + "\n" + fallback.stderr),
  }
}

/** Close a PR with an operator-visible comment. */
pub fn gh_pr_close(slug, pr_number, comment) {
  return gh_argv(["pr", "close", to_string(pr_number), "--repo", slug, "--comment", comment])
}

/** Dispatch a workflow through `gh workflow run`. */
pub fn gh_workflow_run(slug, workflow, fields = nil) {
  var args = ["workflow", "run", workflow, "--repo", slug]
  for entry in (fields ?? {}).entries() {
    args = [...args, "-F", entry.key + "=" + to_string(entry.value)]
  }
  return gh_argv(args)
}

/** Resolve a repository's latest GitHub release tag. */
pub fn gh_latest_release_tag(slug) {
  let r = gh_argv(["api", "repos/${slug}/releases/latest", "--jq", ".tag_name"])
  if !r.success {
    throw "could not resolve latest release for ${slug}: ${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

/** Classify transient GitHub CLI failures worth retrying. */
pub fn gh_cli_transient_failure(output) {
  let out = lowercase(output ?? "")
  return contains(out, "http 502") || contains(out, "http 503")
    || contains(out, "http 504")
    || contains(out, "gateway timeout")
    || contains(out, "service unavailable")
    || contains(out, "temporarily unavailable")
    || contains(out, "connection reset")
    || contains(out, "i/o timeout")
    || contains(out, "context deadline exceeded")
}

/** Short deterministic retry schedule for GitHub CLI hiccups. */
pub fn gh_retry_delay_seconds(attempt) {
  if attempt <= 2 {
    return 3
  }
  return 8
}
