import { ReleaseShipPrResult } from "./release_ship_pr"
import { ReleaseShipPrepareResult } from "./release_ship_prepare"
import { ReleaseShipTagResult } from "./release_ship_tag"

pub type ReleaseShipPipelineResult = ReleaseShipPrResult

/** Compose the three durable ship phases and never cross a failed handoff. */
pub fn release_ship_pipeline(initial_steps: list<dict>, phases: dict) -> ReleaseShipPipelineResult {
  const prepared: ReleaseShipPrepareResult = phases.prepare(initial_steps)
  if !prepared.proceed {
    return {steps: prepared.steps, handed_off: false, pr_url: ""}
  }
  const tagged: ReleaseShipTagResult = phases.tag(prepared)
  if !tagged.proceed {
    return {steps: tagged.steps, handed_off: false, pr_url: ""}
  }
  return phases.pr(tagged)
}
