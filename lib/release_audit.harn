/**
 * Strip whole-line Markdown code fences (``` or ```lang) from audit text.
 *
 * Models reliably wrap the changelog draft (or the entire answer) in a code
 * fence even when explicitly told not to, and the validator both rejects any
 * ``` and needs the BEGIN/END markers on their own lines. Rather than fight
 * the model with ever-stricter prompts, we remove lines whose trimmed content
 * is a bare fence delimiter so the audit validates and the draft markers
 * parse. Inline single-backtick code and the content between fences are kept.
 */
fn strip_code_fence_lines(text) {
  var out = []
  for line in text.split("\n") {
    if starts_with(trim(line), "```") {
      continue
    }
    out = out + [line]
  }
  return trim(out.join("\n"))
}

/** Return the best visible final text from an agent_loop result. */
pub fn agent_result_text(result) {
  let visible = trim(result.visible_text ?? "")
  let text = trim(result.text ?? "")
  if visible != "" {
    return strip_code_fence_lines(visible)
  }
  if text != "" {
    return strip_code_fence_lines(text)
  }
  return "Agent review returned no visible text. Raw result:\n```json\n" + json_stringify(result)
    + "\n```"
}

/** Return the raw text between BEGIN_DRAFT_CHANGELOG and END_DRAFT_CHANGELOG. */
pub fn raw_agent_changelog_section(text) {
  let start_marker = "BEGIN_DRAFT_CHANGELOG"
  let end_marker = "END_DRAFT_CHANGELOG"
  var in_block = false
  var lines = []
  for line in text.split("\n") {
    if trim(line) == start_marker {
      in_block = true
      continue
    }
    if trim(line) == end_marker {
      break
    }
    if in_block {
      lines = lines + [line]
    }
  }
  return trim(lines.join("\n"))
}

/** Return any text after END_DRAFT_CHANGELOG. */
pub fn agent_changelog_trailing_text(text) {
  let end_marker = "END_DRAFT_CHANGELOG"
  let parts = text.split(end_marker)
  if len(parts) < 2 {
    return ""
  }
  return trim(parts[1:len(parts)].join(end_marker))
}

/** Return the normalized changelog section for next_version from an agent audit. */
pub fn agent_changelog_section(text, next_version) {
  let raw = raw_agent_changelog_section(text)
  if raw == "" {
    return ""
  }
  let expected_heading = "## v${next_version}"
  var seen_expected = false
  var skip_section = false
  var lines = []
  for line in raw.split("\n") {
    let t = trim(line)
    if !seen_expected {
      if t == expected_heading {
        seen_expected = true
        lines = lines + [line]
      }
      continue
    }
    if starts_with(t, "## v") {
      break
    }
    if starts_with(t, "### ") {
      skip_section = !(t == "### Added" || t == "### Changed" || t == "### Fixed"
        || t == "### Internal")
    }
    if skip_section {
      continue
    }
    if t == "..." {
      continue
    }
    lines = lines + [line]
  }
  if !seen_expected {
    return raw
  }
  return trim(lines.join("\n"))
}

/** Validate only machine-verifiable audit shape, not semantic release-note judgment. */
pub fn validate_release_agent_audit(next_version, result, text) {
  return validate_release_agent_audit_with_context(next_version, result, text, {})
}

fn changelog_draft_markdown_style_findings(draft) {
  var findings = []
  let lines = split(draft ?? "", "\n")
  for {index, value} in lines.enumerate() {
    let line_no = index + 1
    if len(value) > 120 {
      findings = findings
        + [
        "agent draft changelog line ${line_no} is ${len(value)} characters; wrap prose to 120 characters or fewer with two-space continuation indentation",
      ]
    }
    let trimmed = trim(value)
    if starts_with(trimmed, "## ") || starts_with(trimmed, "### ") {
      if index + 1 < len(lines) && trim(lines[index + 1]) != "" {
        findings = findings
          + [
          "agent draft changelog heading on line ${line_no} must be followed by a blank line to match CHANGELOG.md style",
        ]
      }
    }
  }
  return findings
}

/**
 * Validate fixup-mode audit shape. Looser than the standard audit because
 * the deterministic merge is authoritative; the agent only confirms the
 * fold and flags misclassified entries. Specifically: no draft changelog
 * is required (or expected) because re-authoring the release section is
 * forbidden in fixup mode.
 */
pub fn validate_release_fixup_audit_with_context(_next_version, result, text, _context) {
  var findings = []
  let status = result.status ?? ""
  if starts_with(text, "Agent review returned no visible text. Raw result:") {
    findings = findings
      + [
      "agent returned no visible final audit text; use a repair turn to produce the audit from gathered evidence",
    ]
    return findings
  }
  if status != "done" {
    findings = findings
      + ["agent_loop ended with status `${status}` instead of `done`; the audit text may be incomplete"]
  }
  if trim(text) == "" {
    findings = findings + ["agent audit returned empty text"]
    return findings
  }
  if !starts_with(trim(text), "Audit:") {
    findings = findings + ["agent audit must start with `Audit:` so the final answer is not process prose"]
  }
  if contains(text, "BEGIN_DRAFT_CHANGELOG") || contains(text, "END_DRAFT_CHANGELOG") {
    findings = findings
      + [
      "fixup-mode audit contains BEGIN_DRAFT_CHANGELOG markers; the shipped release notes are authoritative — do not author a new draft",
    ]
  }
  if contains(text, "<tool_call>") || contains(text, "<function=")
    || contains(text, "</function>") {
    findings = findings
      + ["agent audit contains unresolved tool-call protocol text instead of a final audit"]
  }
  if contains(text, "<assistant prose truncated by turn policy") {
    findings = findings
      + [
      "agent audit was truncated by turn policy; tighten the response or raise max_prose_chars before relying on it",
    ]
  }
  return findings
}

/**
 * True iff the draft has an `## Unreleased` ATX heading on its own line.
 * Substring matches inside CHANGELOG bullet prose (e.g. an entry describing
 * release_ship.sh's auto-rename behavior) are deliberately ignored.
 */
fn draft_has_unreleased_heading(raw_draft) -> bool {
  for line in raw_draft.split("\n") {
    let stripped = trim(line)
    if stripped == "## Unreleased" || starts_with(stripped, "## Unreleased ") {
      return true
    }
  }
  return false
}

fn audit_mentions_release_evidence(text, context) -> bool {
  let lower = lowercase(text ?? "")
  let pr_numbers = context.post_tag_pr_numbers ?? []
  for number in pr_numbers {
    let s = "${number}"
    if contains(text, "#${s}") || contains(lower, "pr ${s}") || contains(lower, "pr #${s}") {
      return true
    }
  }
  let pr_count = len(pr_numbers)
  if pr_count > 0
    && (contains(lower, "${pr_count} pr") || contains(lower, "${pr_count} post-tag")
    || contains(lower, "${pr_count} pull request")) {
    return true
  }
  return pr_count == 0
}

fn changelog_coverage_text(text) {
  var lines = []
  for line in split(text ?? "", "\n") {
    if contains(lowercase(line), "changelog coverage") {
      lines = lines + [line]
    }
  }
  if len(lines) == 0 {
    return text
  }
  return lines.join("\n")
}

fn changelog_coverage_mentions_concrete_evidence(text, context) {
  if audit_mentions_release_evidence(changelog_coverage_text(text), context) {
    return []
  }
  let pr_count = len(context.post_tag_pr_numbers ?? [])
  if pr_count == 0 {
    return []
  }
  return [
    "agent audit CHANGELOG coverage is too generic; mention one concrete post-tag PR (for example `#${context.post_tag_pr_numbers[0]}`) or the `${pr_count}` PR count before accepting the draft",
  ]
}

/** Validate machine-verifiable audit shape using deterministic release facts. */
pub fn validate_release_agent_audit_with_context(next_version, result, text, context) {
  var findings = []
  let status = result.status ?? ""
  if starts_with(text, "Agent review returned no visible text. Raw result:") {
    findings = findings
      + [
      "agent returned no visible final audit text; use a repair turn to produce the audit from gathered evidence",
    ]
  }
  if status != "done" {
    findings = findings
      + ["agent_loop ended with status `${status}` instead of `done`; the audit text may be incomplete"]
  }
  if trim(text) == "" {
    findings = findings + ["agent audit returned empty text"]
  }
  if starts_with(text, "Agent review returned no visible text. Raw result:") {
    return findings
  }
  if !starts_with(trim(text), "Audit:") {
    findings = findings + ["agent audit must start with `Audit:` so the final answer is not process prose"]
  }
  if contains(text, "```") {
    findings = findings
      + [
      "agent audit includes a Markdown code fence; write commands inline and keep BEGIN_DRAFT_CHANGELOG markers as plain marker lines",
    ]
  }
  if contains(text, "scripts/release_prepare.sh") {
    findings = findings
      + [
      "agent audit mentions nonexistent `scripts/release_prepare.sh`; release preparation is driven by release_harn.harn and scripts/release_ship.sh",
    ]
  }
  if contains(text, "--finalize") {
    findings = findings
      + [
      "agent audit mentions `--finalize`; ship-pr mode must shepherd the release PR rather than claim finalization",
    ]
  }
  if contains(text, "<tool_call>") || contains(text, "<function=")
    || contains(text, "</function>") {
    findings = findings
      + ["agent audit contains unresolved tool-call protocol text instead of a final audit"]
  }
  let raw_draft = raw_agent_changelog_section(text)
  if raw_draft == "" {
    findings = findings
      + [
      "agent audit does not include a strict BEGIN_DRAFT_CHANGELOG / END_DRAFT_CHANGELOG block with markers on their own lines",
    ]
  } else if !starts_with(raw_draft, "## v${next_version}") {
    findings = findings
      + ["agent draft changelog does not start with expected heading `## v${next_version}`"]
  }
  if draft_has_unreleased_heading(raw_draft) {
    findings = findings
      + [
      "agent draft changelog contains an `## Unreleased` heading; promote authored entries under `## v${next_version}`",
    ]
  }
  findings = findings + changelog_coverage_mentions_concrete_evidence(text, context)
  findings = findings + changelog_draft_markdown_style_findings(raw_draft)
  let first_commit = trim(context.first_post_tag_commit ?? "")
  if first_commit != "" && first_commit != "(none)" && !contains(text, first_commit) {
    findings = findings
      + [
      "agent audit does not mention the first post-tag commit `${first_commit}` from the deterministic release fact sheet",
    ]
  }
  if agent_changelog_trailing_text(text) != "" {
    findings = findings
      + [
      "agent audit includes trailing commentary after END_DRAFT_CHANGELOG; put operational handoff in Audit bullets before the draft block and stop at the end marker",
    ]
  }
  if contains(text, "<assistant prose truncated by turn policy") {
    findings = findings
      + [
      "agent audit was truncated by turn policy; increase max_prose_chars or make the draft more concise before applying it",
    ]
  }
  let draft = agent_changelog_section(text, next_version)
  if contains(draft, "<assistant prose truncated by turn policy") {
    findings = findings
      + ["agent draft changelog was truncated by turn policy and is unsafe to apply"]
  }
  if contains(draft, "(``)") || contains(draft, "(``,") || contains(draft, "``)") {
    findings = findings
      + [
      "agent draft changelog contains empty inline-code spans, likely from stripped tool-protocol tags; rephrase without literal protocol tags",
    ]
  }
  return findings
}
