import { FleetRepairAttempt } from "./fleet_repair_terminal"
import { harn_update_usage } from "./harn_update"

/** Settle one agent result before deciding whether source validation was reached. */
pub fn fleet_repair_agent_attempt(result: dict, validate: fn() -> dict) -> dict {
  const provider_failed = result.result?.status == "provider_error"
  const validation = if provider_failed && result.result?.provider_call_count == 0 {
    {ok: false, output: "provider unavailable: " + to_string(result.result?.error ?? "")}
  } else {
    validate()
  }
  const findings = if validation.ok || trim(validation.output) == "" || provider_failed {
    []
  } else {
    [validation.output]
  }
  return {
    result: result.result,
    verification: {
      ok: validation.ok,
      output: validation.output,
      findings: findings,
      agent_status: result.result?.status ?? "completed",
      route: result.route,
      planner: result.planner,
      usage: harn_update_usage(result.planner.provider, result.planner.model, result.result),
      provider_call_count: result.result?.provider_call_count,
    },
    findings: findings,
    // The agent runtime already exhausted its bounded transport retries.
    // Finish this workflow stage without retrying it as another source repair.
    branch: if provider_failed {
      "completed"
    } else if validation.ok {
      nil
    } else {
      "failed"
    },
    outcome: if provider_failed {
      "provider_unavailable"
    } else {
      "completed"
    },
  }
}

pub type FleetRepairAttemptSummary = {
  attempts: list<FleetRepairAttempt>,
  provider_failures: list<FleetRepairAttempt>,
  known_cost_usd: float,
  cost_status: "exact" | "lower_bound" | "unknown",
}

/** Preserve infrastructure evidence without charging a measured zero-call repair. */
pub fn fleet_repair_attempt_summary(values: list) -> FleetRepairAttemptSummary {
  let attempts: list<FleetRepairAttempt> = []
  let provider_failures: list<FleetRepairAttempt> = []
  let known_cost_usd = 0.0
  let cost_status = "exact"
  for value in values {
    const recorded: FleetRepairAttempt = {
      attempt: len(attempts) + 1,
      validation_ok: value?.verification?.ok ?? false,
      validation_output: value?.verification?.output ?? value?.error ?? "",
      agent_status: value?.verification?.agent_status ?? "unknown",
      route: value?.verification?.route?.tier ?? "value",
      route_reason: value?.verification?.route?.reason ?? "unknown",
      provider: value?.verification?.planner?.provider ?? "unknown",
      model: value?.verification?.planner?.model ?? "unknown",
      usage: value?.verification?.usage ?? harn_update_usage("unknown", "unknown", {}),
    }
    if recorded.agent_status == "provider_error" && value?.verification?.provider_call_count == 0 {
      provider_failures = provider_failures + [recorded]
    } else {
      attempts = attempts + [recorded]
    }
    known_cost_usd = known_cost_usd + recorded.usage.known_cost_usd
    if recorded.usage.cost_status == "unknown" {
      cost_status = "unknown"
    } else if recorded.usage.cost_status == "lower_bound" && cost_status == "exact" {
      cost_status = "lower_bound"
    }
  }
  return {
    attempts: attempts,
    provider_failures: provider_failures,
    known_cost_usd: known_cost_usd,
    cost_status: cost_status,
  }
}
