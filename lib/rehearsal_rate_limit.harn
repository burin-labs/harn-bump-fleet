// What a rehearsal does when the installation's API budget runs out.
//
// The consumer rehearsal is the only writer of the proof a release launch
// preflight reads. A consumer's own gate workflow, dispatched by hand, writes
// nothing the preflight can see. So a rehearsal that stops is not one tick
// lost; it is the release path blocked until the next scheduled tick an hour
// later.
//
// Measured on 2026-09-22: a scheduled rehearsal met HTTP 403, "API rate limit
// exceeded for installation", on its first API call, the default-branch head
// read at 10:46:46 UTC. It wrote no proof. The hosted release run that
// followed refused at `consumers.rehearsal` for want of one and waited out the
// hour. The job itself had eighty-nine of its ninety minutes left.
//
// A limit that resets inside the time the job still holds is a wait, not a
// failure. A limit that resets after it is a failure, and the only useful
// failure names when a retry can succeed and how much budget is left, so
// nobody re-dispatches straight back into the same wall.
import { fleet_observation_class } from "./fleet_observation_class"
import { github_connector_options } from "./github"
import { GithubClientOptions, api_call } from "harn-github-connector/default"

/**
 * One reading of the installation's core API budget.
 *
 * `observed` is the field that matters. A budget nobody could read and a
 * budget with nothing left are opposite situations, and the decision below
 * refuses rather than guessing which one it has. Every numeric field is
 * meaningless when `observed` is false.
 */
pub type RehearsalApiBudget = {
  observed: bool,
  limit: int,
  remaining: int,
  used: int,
  reset_epoch_s: int,
  reset_at: string,
  detail: string,
}

/** What the rehearsal should do about one failed call. */
pub type RehearsalRateLimitAction = "not_rate_limited" | "wait" | "fail"

/**
 * The decision, and the sentence a person reads in the receipt.
 *
 * `summary` is not decoration. The failure this replaces printed the
 * connector's error text and nothing else, so an operator learned that a limit
 * was hit and not when it lifts, and the cheapest next move looked like an
 * immediate re-dispatch into the same limit.
 */
pub type RehearsalRateLimitDecision = {
  action: RehearsalRateLimitAction,
  reason: string,
  summary: string,
  wait_seconds: int,
  job_budget_remaining_s: int,
  budget: RehearsalApiBudget,
}

/**
 * Slack left between the end of a wait and the end of the job.
 *
 * A wait that finishes exactly as the job dies proves nothing and costs the
 * whole window. The rehearsal needs real time after the reset to do the work
 * it waited for.
 */
pub const REHEARSAL_RATE_LIMIT_MARGIN_S: int = 120

const UNOBSERVED_BUDGET: RehearsalApiBudget = {
  observed: false,
  limit: 0,
  remaining: 0,
  used: 0,
  reset_epoch_s: 0,
  reset_at: "",
  detail: "",
}

/** Never report a negative remainder as a budget. */
pub fn clamp_zero(value: int) -> int {
  return if value < 0 {
    0
  } else {
    value
  }
}

/** Seconds since the epoch, from the harness clock's own ISO reading. */
pub fn rehearsal_now_epoch_s(clock: HarnessClock) -> int {
  return to_int(date_parse(clock.date_iso())) ?? 0
}

/**
 * Read the installation's core budget from GitHub's own accounting.
 *
 * `/rate_limit` is the right source rather than the failed response's headers
 * for two reasons. The connector's structured error carries the code and the
 * category this keys on but not the reset value, so the headers are already
 * gone by the time a caller can classify. And this endpoint does not itself
 * count against the limit, so asking costs nothing at exactly the moment there
 * is nothing left to spend.
 *
 * An unreadable budget returns `observed: false` with its reason, never a zero
 * that would read as an exhausted one.
 */
pub fn read_rehearsal_api_budget(
  harness: Harness,
  options: GithubClientOptions = github_connector_options(),
) -> RehearsalApiBudget {
  const response = api_call(harness, {path: "/rate_limit", options: options})
  if is_err(response) {
    return UNOBSERVED_BUDGET + {detail: to_string(unwrap_err(response)?.message ?? "")}
  }
  const core = unwrap(response)?.resources?.core
  const limit = to_int(core?.limit)
  const remaining = to_int(core?.remaining)
  const reset = to_int(core?.reset)
  if limit == nil || remaining == nil || reset == nil {
    return UNOBSERVED_BUDGET
      + {detail: "the rate limit response carried no complete core resource"}
  }
  return {
    observed: true,
    limit: unwrap(limit),
    remaining: unwrap(remaining),
    // Parenthesised deliberately. `??` binds tighter than `-`, so the
    // unparenthesised form reads as `(used ?? limit) - remaining` and reports
    // a figure that is wrong by exactly the remaining count whenever GitHub
    // does send `used`, which is always.
    used: to_int(core?.used) ?? (unwrap(limit) - unwrap(remaining)),
    reset_epoch_s: unwrap(reset),
    reset_at: date_format(unwrap(reset), "%Y-%m-%dT%H:%M:%SZ"),
    detail: "",
  }
}

/** One receipt line naming a budget reading, or naming that there was none. */
pub fn rehearsal_api_budget_line(label: string, budget: RehearsalApiBudget) -> string {
  if !budget.observed {
    return "${label}: the installation API budget could not be read"
      + if trim(budget.detail) == "" {
        ""
      } else {
        " (" + trim(budget.detail) + ")"
      }
  }
  return "${label}: ${to_string(budget.remaining)} of ${to_string(budget.limit)} core calls remaining, resets at ${budget.reset_at}"
}

/**
 * Decide from the failed call's own classification and the budget beside it.
 *
 * The classification comes from the connector's structured `code` and
 * `category` through the module that already owns that judgement, never from
 * matching the message text, which is written for people and changes without
 * notice.
 *
 * The order of the refusals is the point. Each one is a different fact about
 * why waiting would not help, and collapsing them into "rate limited, give up"
 * is what left an operator with nothing to act on.
 */
pub fn rehearsal_rate_limit_decision(
  error: any,
  budget: RehearsalApiBudget,
  now_epoch_s: int,
  job_budget_remaining_s: int,
  margin_s: int = REHEARSAL_RATE_LIMIT_MARGIN_S,
) -> RehearsalRateLimitDecision {
  const classified = fleet_observation_class(error)
  const base = {wait_seconds: 0, job_budget_remaining_s: job_budget_remaining_s, budget: budget}
  if classified.category != "rate_limit" {
    return base
      + {
        action: "not_rate_limited",
        reason: "not_a_rate_limit",
        summary:
          "this failure is ${classified.code} in category ${classified.category}, not a rate limit; waiting would change nothing",
      }
  }
  if !budget.observed {
    return base
      + {
        action: "fail",
        reason: "rate_limit_reset_unknown",
        summary:
          "the API budget is exhausted and its reset could not be read, so there is no time to wait for and no time to name; retry once the installation's hour has turned over",
      }
  }
  if budget.remaining > 0 {
    // A core budget with room left plus a rate-limit refusal is a secondary
    // limit, and the core reset is the wrong clock for it. Waiting for that
    // reset would burn the job's window on an unrelated deadline.
    return base
      + {
        action: "fail",
        reason: "rate_limit_without_exhausted_core_budget",
        summary:
          "refused as rate limited while ${to_string(budget.remaining)} of ${to_string(budget.limit)} core calls remain, so this is a secondary limit and the core reset at ${budget.reset_at} is not the clock that governs it",
      }
  }
  const wait_seconds = clamp_zero(budget.reset_epoch_s - now_epoch_s)
  if wait_seconds + margin_s > job_budget_remaining_s {
    return base
      + {
        action: "fail",
        reason: "rate_limit_reset_outside_job_budget",
        summary:
          "the API budget resets at ${budget.reset_at}, ${to_string(wait_seconds)}s away, and this job has ${to_string(job_budget_remaining_s)}s left, which does not cover the wait plus the ${to_string(margin_s)}s it needs afterwards; re-dispatch after ${budget.reset_at}",
      }
  }
  return base
    + {
      action: "wait",
      reason: "rate_limit_reset_within_job_budget",
      wait_seconds: wait_seconds,
      summary:
        "the API budget resets at ${budget.reset_at}, ${to_string(wait_seconds)}s away, and this job has ${to_string(job_budget_remaining_s)}s left; waiting rather than abandoning the only proof a release preflight can read",
    }
}

/**
 * What this run spent, in the two honest numbers rather than one wrong one.
 *
 * Neither is the run's exact total, and saying which is which is the whole
 * value. The direct count is every call this pipeline makes itself, so it is a
 * floor: the consumer certification underneath makes more. The installation
 * delta is every core call charged to the installation while the run was
 * open, so it is a ceiling: other actors share that budget, which is what
 * exhausted it in the first place.
 */
pub fn rehearsal_api_spend_line(
  direct_calls: int,
  opening: RehearsalApiBudget,
  closing: RehearsalApiBudget,
) -> string {
  const direct =
    "API calls this rehearsal made directly: ${to_string(direct_calls)} (a floor; the consumer certification makes more)"
  if !opening.observed || !closing.observed {
    return direct
      + "; installation core spend over the run is unknown because a budget reading was missing"
  }
  const spent = clamp_zero(closing.used - opening.used)
  return direct
    + "; installation core calls charged while this run was open: ${to_string(spent)} (a ceiling; the installation is shared)"
}

/**
 * One attempt at the revision read, with what it cost and what it decided.
 *
 * `decisions` is a list because a run that waited made two attempts and both
 * classifications belong in the receipt. A receipt that showed only the second
 * would make a run that waited eleven minutes indistinguishable from one that
 * succeeded immediately.
 */
pub type RehearsalRevisionOutcome = {
  revision: GithubConnectorResult<string>,
  waited_s: int,
  api_calls: int,
  decisions: list<RehearsalRateLimitDecision>,
}

/**
 * Read the Harn revision, treating an exhausted budget as a wait when the job
 * can afford one.
 *
 * This wraps the revision read specifically because that is the call the
 * failure landed on and the first the rehearsal makes: fail there and the run
 * writes no proof at all. The retry is single. A second refusal after the
 * reset is not a race, and a loop against a limit that did not lift would
 * spend the window this exists to protect.
 */
pub fn rehearsal_revision_within_budget(
  harness: Harness,
  read: fn() -> GithubConnectorResult<string>,
  job_budget_remaining_s: int,
  options: GithubClientOptions = github_connector_options(),
) -> RehearsalRevisionOutcome {
  const first = read()
  if !is_err(first) {
    return {revision: first, waited_s: 0, api_calls: 0, decisions: []}
  }
  const budget = read_rehearsal_api_budget(harness, options)
  const decision = rehearsal_rate_limit_decision(
    unwrap_err(first),
    budget,
    rehearsal_now_epoch_s(harness.clock),
    job_budget_remaining_s,
  )
  if decision.action != "wait" {
    return {revision: first, waited_s: 0, api_calls: 1, decisions: [decision]}
  }
  harness.clock.sleep_ms(decision.wait_seconds * 1000)
  return {revision: read(), waited_s: decision.wait_seconds, api_calls: 1, decisions: [decision]}
}
