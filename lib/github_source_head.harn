// What commit last touched one file on one branch.
//
// A projection reads one file, so the question a drift comparison asks is
// whether that file moved, not whether its repository did. Asking per path is
// what lets an unrelated change in the same source repository dispatch
// nothing.
//
// This lives beside `lib/github` rather than inside it because that module is
// at its maintained-source ceiling, and because the shaping half here is worth
// reading on its own: it is the part that decides what an empty history means.
import { github_connector_options, github_slug_parts } from "./github"
import { GithubClientOptions, GithubConnectorResult, api_call } from "harn-github-connector/default"

/** Exact current and previous revisions in one canonical file's history. */
pub type GithubPathRevisionPair = {current: string, previous: string}

/** Require two distinct, measured file revisions instead of defaulting to current. */
pub fn source_revision_pair_from_commits(
  rows: list<any>,
  slug: string,
  path: string,
  branch: string,
) -> GithubConnectorResult<GithubPathRevisionPair> {
  if len(rows) != 2 {
    return Err(
      {
        code: "path_history_incomplete",
        category: "schema_drift",
        message: "two canonical file revisions are required for ${path} in ${slug}",
      },
    )
  }
  const current = source_head_from_commits([rows[0]], slug, path, branch)
  const previous = source_head_from_commits([rows[1]], slug, path, branch)
  if is_err(current) {
    return Err(unwrap_err(current))
  }
  if is_err(previous) {
    return Err(unwrap_err(previous))
  }
  if unwrap(current) == unwrap(previous) {
    return Err(
      {
        code: "invalid_response",
        category: "schema_drift",
        message: "canonical file history repeated one revision",
      },
    )
  }
  return Ok({current: unwrap(current), previous: unwrap(previous)})
}

/** Read the newest two commits touching one canonical file on its owning branch. */
pub fn github_path_revision_pair(
  harness: Harness,
  slug: string,
  path: string,
  branch: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<GithubPathRevisionPair> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(path) == "" || trim(branch) == "" {
    return Err(
      {
        code: "invalid_path_head",
        category: "schema_drift",
        message: "file history requires owner/name, a path, and a branch",
      },
    )
  }
  const result = api_call(
    harness,
    {
      path:
        "/repos/${parts.owner}/${parts.repo}/commits?sha=${url_encode(trim(branch))}&path=${url_encode(trim(path))}&per_page=2",
      options: options,
    },
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const rows = unwrap(result)
  if type_of(rows) != "list" {
    return Err(
      {
        code: "invalid_response",
        category: "schema_drift",
        message: "canonical file history was not a commit list",
      },
    )
  }
  return source_revision_pair_from_commits(rows, slug, path, branch)
}

/**
 * The commit id in a path-filtered commit listing.
 *
 * Separated from the request so the shape decisions are testable without a
 * network. Two of them matter. An empty listing is a real answer and a
 * distinct one: the path does not exist on that branch, which is not the same
 * as being unable to look, and neither may be read as "unchanged". And a row
 * carrying no usable commit id is refused rather than returned as an empty
 * string, which would compare unequal to every record and re-converge its
 * consumers on every tick.
 */
pub fn source_head_from_commits(
  rows: list<any>,
  slug: string,
  path: string,
  branch: string,
) -> GithubConnectorResult<string> {
  if len(rows) == 0 {
    return Err(
      {
        code: "path_absent",
        category: "schema_drift",
        message: "no commit on ${branch} touches ${path} in ${slug}",
      },
    )
  }
  const sha = lowercase(trim(to_string(rows[0]?.sha ?? "")))
  if len(regex_captures("^[0-9a-f]{40}$", sha)) == 0 {
    return Err(
      {
        code: "invalid_response",
        category: "schema_drift",
        message: "GitHub returned no commit id for ${path} in ${slug}",
      },
    )
  }
  return Ok(sha)
}

/** The newest commit on one branch that touched one path. */
pub fn github_path_head(
  harness: Harness,
  slug: string,
  path: string,
  branch: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<string> {
  const parts = github_slug_parts(slug)
  if parts == nil || trim(path) == "" || trim(branch) == "" {
    return Err(
      {
        code: "invalid_path_head",
        category: "schema_drift",
        message: "a path head lookup requires owner/name, a path, and a branch",
      },
    )
  }
  const result = api_call(
    harness,
    {
      path: "/repos/${parts.owner}/${parts.repo}/commits"
        + "?sha=${url_encode(trim(branch))}&path=${url_encode(trim(path))}&per_page=1",
      options: options,
    },
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  return source_head_from_commits(unwrap(result) ?? [], slug, path, branch)
}
