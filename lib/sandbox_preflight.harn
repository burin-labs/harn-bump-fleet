/**
 * Build the stderr message for an unsupported sandbox profile, or nil when the
 * active profile is `unrestricted`. Pure so it is exercised in unit tests.
 *
 * The fleet operation pipelines shell out to `gh` and `git`, which read config
 * from `$HOME` paths outside the worktree-sandbox root. Without `--no-sandbox`
 * they fail with cryptic `operation not permitted` errors from the wrapped
 * tool. This helper turns that into a single actionable line.
 */
pub fn sandbox_preflight_message(profile, script) {
  if profile == "unrestricted" {
    return nil
  }
  return "error: ${script} needs --no-sandbox (active sandbox profile: ${profile}).\n"
    + "       gh/git read config from \$HOME, which the worktree sandbox blocks.\n"
    + "       Re-run with: harn run --no-sandbox ${script}"
}

/**
 * Verify the current `harn run` invocation has the sandbox disabled. Returns
 * `nil` on success or an exit code (`2`) after printing the guidance message.
 * Callers should `return` that code from `main` to abort the pipeline early.
 */
pub fn ensure_unrestricted_sandbox(harness: Harness, script) {
  let msg = sandbox_preflight_message(sandbox_active_profile(), script)
  if msg == nil {
    return nil
  }
  harness.stdio.eprintln(msg)
  return 2
}
