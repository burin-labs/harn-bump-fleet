/**
 * Build the stderr message for an unsupported sandbox profile, or nil when the
 * active profile is `unrestricted`. Pure so it is exercised in unit tests.
 *
 * The fleet operation pipelines inspect sibling repositories, run local Git,
 * and may launch read-only diagnostic agents that use authenticated GitHub
 * state. Those paths live outside the worktree-sandbox root. This helper turns
 * the resulting cryptic permission failure into a single actionable line.
 */
pub fn sandbox_preflight_message(profile: string, script: string) -> string? {
  if profile == "unrestricted" {
    return nil
  }
  return "error: ${script} needs --no-sandbox (active sandbox profile: ${profile}).\n"
    + "       sibling repositories and authenticated tool state are outside the worktree sandbox.\n"
    + "       Re-run with: harn run --no-sandbox ${script}"
}

/**
 * Verify the current `harn run` invocation has the sandbox disabled. Returns
 * `nil` on success or an exit code (`2`) after printing the guidance message.
 * Callers should `return` that code from `main` to abort the pipeline early.
 */
pub fn ensure_unrestricted_sandbox(
  harness: {stdio: HarnessStdio, system: HarnessSystem},
  script: string,
) -> int? {
  const msg = sandbox_preflight_message(harness.system.sandbox_active_profile(), script)
  if msg == nil {
    return nil
  }
  harness.stdio.eprintln(msg)
  return 2
}
