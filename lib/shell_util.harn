/** Construct a command-style success result used by local harness steps. */
pub fn ok(stdout) {
  return {success: true, status: 0, stdout: stdout, stderr: ""}
}

/** Construct a command-style failure result used by local harness steps. */
pub fn fail(status, stderr) {
  return {success: false, status: status, stdout: "", stderr: stderr}
}

/** Concatenate stdout/stderr for classifiers and diagnostics. */
pub fn command_output(r) {
  var parts = []
  let stdout = r?.stdout ?? ""
  let stderr = r?.stderr ?? ""
  if stdout != "" {
    parts = parts + [stdout]
  }
  if stderr != "" {
    parts = parts + [stderr]
  }
  return join(parts, "\n")
}

/** Quote a value for POSIX single-quoted shell interpolation, or nil if unsupported. */
pub fn safe_shell_arg(value) {
  let text = to_string(value ?? "")
  if contains(text, "\n") {
    return nil
  }
  return "'" + join(split(text, "'"), "'\\''") + "'"
}

/** Quote a shell arg or throw a label-specific error. */
pub fn require_shell_arg(value, label) {
  let arg = safe_shell_arg(value)
  if arg == nil {
    throw "${label} contains unsupported shell quoting characters"
  }
  return arg
}

/** Quote and join a full argv vector for shell-mode execution. */
pub fn shell_join(args) {
  var quoted = []
  var index = 0
  for arg in args ?? [] {
    quoted = quoted + [require_shell_arg(to_string(arg), "shell argument ${index}")]
    index = index + 1
  }
  return join(quoted, " ")
}

/**
 * Build a shell command that feeds a static script body to argv via stdin.
 *
 * This keeps runtime data in argv instead of interpolating it into script text.
 * The returned string is still intended for shell-mode execution, but the only
 * unquoted syntax we generate is the static heredoc envelope.
 */
pub fn shell_heredoc_command(args, body, marker = "HARN_STDIN") {
  let label = trim(marker ?? "")
  if regex_match("^[A-Z][A-Z0-9_]*$", label) == nil {
    throw "heredoc marker must be uppercase alphanumeric/underscore"
  }
  let script = to_string(body ?? "")
  if contains("\n" + script + "\n", "\n" + label + "\n") {
    throw "heredoc marker appears as a standalone line in script body"
  }
  return shell_join(args) + " <<'" + label + "'\n" + script + "\n" + label
}
