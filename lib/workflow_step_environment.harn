import { GithubWorkflowJob, GithubWorkflowStep } from "./github_workflow"

/**
 * Which environment variables a workflow job's shell steps read without ever
 * declaring them.
 *
 * A step that runs `set -u` and reads an undeclared variable aborts. Nothing
 * catches that before the run: the workflow parses, the expression syntax is
 * valid, and the variable simply is not there. One release-path edit dropped
 * `RELEASE_MODE` from a step's `env:` block while leaving two reads of it in
 * the body, and every hosted cut would have died about ten minutes in, past
 * the checkout, the mint, and the harness build.
 *
 * The rule is structural rather than a list of known names, so it holds for
 * variables nobody has added yet.
 */
pub type UndeclaredStepVariable = {step: string, variable: string}

/**
 * Names the runner provides to every step without anyone declaring them.
 *
 * `GITHUB_` and `RUNNER_` are handled by prefix; these are the rest that a
 * release step legitimately reads.
 */
pub const WORKFLOW_PROVIDED_VARIABLES: list<string> = [
  "CI",
  "HOME",
  "PATH",
  "SHELL",
  "TMPDIR",
  "USER",
]

fn is_provided_variable(name: string) -> bool {
  if starts_with(name, "GITHUB_") || starts_with(name, "RUNNER_") {
    return true
  }
  for provided in WORKFLOW_PROVIDED_VARIABLES {
    if provided == name {
      return true
    }
  }
  return false
}

/**
 * Every `UPPER_SNAKE` name a shell body reads, in either `$NAME` or `${NAME}` form.
 *
 * Case is the discriminator on purpose. Shell convention reserves upper case
 * for the environment and lower case for a variable the body assigns itself,
 * and following the convention keeps this rule from needing to parse
 * assignments, loops, and command substitution to know what is local.
 * A GitHub `\${{ ... }}` expression is not a shell read and does not match,
 * because `{` is not a name character.
 */
pub fn shell_environment_reads(body: string) -> list<string> {
  let names: list<string> = []
  for pattern in ["\\$\\{([A-Z][A-Z0-9_]*)[}:]", "\\$([A-Z][A-Z0-9_]*)"] {
    for found in regex_captures(pattern, body) {
      const name = to_string(found.groups[0] ?? "")
      if name != "" && !names.contains(name) {
        names = names + [name]
      }
    }
  }
  return names
}

/** Every name a shell body exports into the job through `$GITHUB_ENV`. */
pub fn shell_github_env_exports(body: string) -> list<string> {
  let names: list<string> = []
  for found in regex_captures("([A-Z][A-Z0-9_]*)=[^\\n]*>>\\s*\"?\\$\\{?GITHUB_ENV", body) {
    const name = to_string(found.groups[0] ?? "")
    if name != "" && !names.contains(name) {
      names = names + [name]
    }
  }
  return names
}

fn declared_keys(env: dict<any>?) -> list<string> {
  let names: list<string> = []
  for key in (env ?? {}).keys() {
    names = names + [to_string(key)]
  }
  return names
}

fn step_label(step: GithubWorkflowStep, index: int) -> string {
  const named = trim(to_string(step.name ?? ""))
  if named != "" {
    return named
  }
  return "step ${to_string(index)}"
}

/**
 * Every read in a job that no earlier declaration can satisfy.
 *
 * Steps are walked in order because `GITHUB_ENV` only reaches later ones: a
 * variable exported by a step that runs after the reader is not a
 * declaration, and treating it as one would let exactly the failure this
 * refuses slip through in reverse.
 */
pub fn undeclared_job_variables(job: GithubWorkflowJob) -> list<UndeclaredStepVariable> {
  let available = declared_keys(job.env)
  let findings: list<UndeclaredStepVariable> = []
  let index = 0
  for step in job.steps ?? [] {
    index = index + 1
    const body = to_string(step.run ?? "")
    const visible = available + declared_keys(step.env)
    if body != "" {
      for name in shell_environment_reads(body) {
        if !is_provided_variable(name) && !visible.contains(name) {
          findings = findings + [{step: step_label(step, index), variable: name}]
        }
      }
      available = available + shell_github_env_exports(body)
    }
  }
  return findings
}
