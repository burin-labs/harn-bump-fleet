/** Typed, pure integrity decisions for immutable release tags and cutoffs. */
import { GitRemoteRef } from "std/git"

/** Return the direct SHA from typed refs for one exact remote tag. */
pub fn remote_tag_sha(refs: list<GitRemoteRef>) -> string {
  for remote_ref in refs {
    if !remote_ref.peeled {
      return remote_ref.oid
    }
  }
  return ""
}

/**
 * Resolve the commit targeted by typed remote refs. Annotated tags include a
 * peeled row; lightweight tags include only the direct row.
 */
pub fn remote_tag_target_sha(refs: list<GitRemoteRef>) -> string {
  let first_sha = ""
  for remote_ref in refs {
    if first_sha == "" {
      first_sha = remote_ref.oid
    }
    if remote_ref.peeled {
      return remote_ref.oid
    }
  }
  return first_sha
}

/**
 * Decide whether a remote release tag observation is idempotent. An existing
 * remote tag that already targets the release commit is success; an existing
 * remote tag at any other commit is immutable-release drift and must not be
 * moved automatically.
 */
pub fn remote_release_tag_decision(inputs) {
  const tag = trim(inputs.tag ?? "v<unknown>")
  const head = trim(inputs.head_sha ?? "")
  const remote_target = trim(inputs.remote_target_sha ?? "")
  if remote_target == "" {
    return {action: "proceed", reason: ""}
  }
  if head != "" && remote_target == head {
    return {action: "reuse", reason: "origin/${tag} already targets release HEAD ${head}"}
  }
  return {
    action: "abort",
    reason:
      "remote tag ${tag} already targets ${remote_target}, but release HEAD is ${head}; refusing to move a published release tag automatically",
  }
}

/**
 * Reconcile a release-tag publication against one typed remote observation.
 * Transport success is insufficient: only the exact tag object and peeled
 * release commit together are confirmed publication.
 */
pub fn release_tag_push_reconciliation(inputs) {
  const tag = trim(inputs.tag ?? "v<unknown>")
  const tag_oid = lowercase(trim(inputs.tag_oid ?? ""))
  const head = lowercase(trim(inputs.head_sha ?? ""))
  if !(inputs.remote_probe_success ?? false) {
    return {
      action: "probe_failed",
      success: false,
      remote_tag_oid: "",
      remote_target_sha: "",
      reason:
        "tag push for ${tag} failed and the post-failure remote probe also failed: ${trim(inputs.remote_probe_error ?? "")}",
    }
  }
  const remote_tag_oid = lowercase(trim(remote_tag_sha(inputs.remote_refs ?? [])))
  const remote_target = lowercase(trim(remote_tag_target_sha(inputs.remote_refs ?? [])))
  if remote_tag_oid == tag_oid && remote_target == head {
    return {
      action: "recovered",
      success: true,
      remote_tag_oid: remote_tag_oid,
      remote_target_sha: remote_target,
      reason:
        "origin/${tag} contains exact signed tag object ${tag_oid} targeting release HEAD ${head}",
    }
  }
  if remote_tag_oid != "" || remote_target != "" {
    return {
      action: "conflicting_target",
      success: false,
      remote_tag_oid: remote_tag_oid,
      remote_target_sha: remote_target,
      reason:
        "origin/${tag} has tag object ${remote_tag_oid} targeting ${remote_target}; expected exact signed tag object ${tag_oid} targeting ${head}",
    }
  }
  return {
    action: "absent",
    success: false,
    remote_tag_oid: "",
    remote_target_sha: "",
    reason: "tag push for ${tag} failed and origin still has no ${tag}; release was not published",
  }
}

/**
 * Decide how to handle a local release tag after the remote tag probe has
 * proven origin has no such tag. Local-only stale tags are interrupted-run
 * residue, not published release state, so they can be refreshed without
 * force-moving anything on origin.
 */
pub fn local_release_tag_decision(inputs) {
  const tag = trim(inputs.tag ?? "v<unknown>")
  const head = trim(inputs.head_sha ?? "")
  const local_target = trim(inputs.local_target_sha ?? "")
  const remote_target = trim(inputs.remote_target_sha ?? "")
  const local_exists = inputs.local_exists ?? (local_target != "")
  if remote_target != "" {
    return {
      action: "abort",
      reason:
        "remote tag ${tag} exists at ${remote_target}; refusing to refresh a local tag while origin has release state",
    }
  }
  if !local_exists {
    return {action: "create", reason: "local tag ${tag} is absent"}
  }
  if head != "" && local_target == head {
    return {action: "reuse", reason: "local tag ${tag} already targets release HEAD ${head}"}
  }
  if local_target == "" {
    return {
      action: "abort",
      reason:
        "local tag ${tag} exists, but its target commit could not be resolved; refusing to refresh without a known old target",
    }
  }
  if head == "" {
    return {
      action: "abort",
      reason:
        "local tag ${tag} exists at ${local_target}, but release HEAD could not be resolved; refusing to refresh without a target",
    }
  }
  return {
    action: "refresh",
    reason:
      "local-only tag ${tag} targets ${local_target}, but release HEAD is ${head}; origin has no ${tag}, so refreshing the local tag is safe",
  }
}

/**
 * The selected SHA is the release cutoff. Commits that reach the base after
 * selection belong to the next release, provided the cutoff remains in the
 * base ancestry. A force-push or divergent base fails closed.
 *
 * Inputs (`base_head_sha` is `origin/<base>` HEAD re-probed immediately before
 * the tag push, not the startup value):
 *   pin_sha       — the frozen release pin (the release branch's parent).
 *   base_head_sha — fresh `origin/<base>` HEAD.
 *   pin_is_base_ancestor — result of `merge-base --is-ancestor` against that
 *                          fresh base head.
 *   base / tag    — names used only in the message.
 *   explicit_pin  — `--at-sha`: the operator pinned a specific commit on
 *                   purpose, so divergence from base HEAD is intended.
 *   allow_drift   — `--allow-base-drift`: conscious override to ship the
 *                   frozen pin even though base moved.
 *
 * Returns `{action, reason}`: action="proceed" is safe to tag; action="abort"
 * means surface `reason` and stop before the tag push. Fail-closed: an empty
 * probe SHA aborts rather than assuming the cutoff is reachable.
 */
pub fn release_cutoff_probe(git, inputs) {
  const base = trim(inputs.base ?? "main")
  const pin_sha = trim(inputs.pin_sha ?? "")
  const head = git(["rev-parse", "--verify", "origin/${base}^{commit}"])
  const base_head = if head.success {
    trim(head.stdout ?? "")
  } else {
    ""
  }
  const ancestry = if pin_sha != "" && base_head != "" {
    git(["merge-base", "--is-ancestor", pin_sha, base_head])
  } else {
    nil
  }
  return {base_head_sha: base_head, pin_is_base_ancestor: ancestry?.success ?? false}
}

pub fn release_cutoff_decision(inputs) {
  const pin_sha = trim(inputs.pin_sha ?? "")
  const base_head_sha = trim(inputs.base_head_sha ?? "")
  const base = trim(inputs.base ?? "<base>")
  const tag = trim(inputs.tag ?? "v<unknown>")
  if (inputs.explicit_pin ?? false) || (inputs.allow_drift ?? false) {
    return {action: "proceed", reason: ""}
  }
  if pin_sha == "" || base_head_sha == "" {
    return {
      action: "abort",
      reason:
        "release cutoff check could not resolve the selected pin and origin/${base} HEAD before tagging ${tag}; refusing to tag without ancestry proof",
    }
  }
  if !(inputs.pin_is_base_ancestor ?? false) {
    return {
      action: "abort",
      reason:
        "release cutoff ${pin_sha} is not an ancestor of origin/${base} HEAD ${base_head_sha}; refusing to tag ${tag} from a divergent or unprovable base. Reconcile the base, or use --allow-base-drift to ship the frozen cutoff on purpose.",
    }
  }
  return {action: "proceed", reason: ""}
}

/**
 * Pure release-publication invariant: the tree that gets published for a
 * version must be the tree pointed to by the release tag. A later main tree
 * may contain extra queued PRs, but it must not define the version's crates,
 * binaries, or notes.
 */
pub fn release_publish_tree_invariant(inputs) {
  const tag = trim(inputs.tag ?? "v<unknown>")
  const tag_tree = trim(inputs.tag_tree ?? "")
  const publish_tree = trim(inputs.publish_tree ?? "")
  const main_tree = trim(inputs.main_tree ?? "")
  if tag_tree == "" {
    return {success: false, message: "release ${tag} has no tag tree to publish from"}
  }
  if publish_tree == "" {
    return {success: false, message: "release ${tag} has no resolved publish tree"}
  }
  if publish_tree != tag_tree {
    const main_detail = if main_tree != "" && main_tree == publish_tree && main_tree != tag_tree {
      " Published tree matches main, but main has moved past ${tag}."
    } else {
      ""
    }
    return {
      success: false,
      message:
        "release ${tag} must publish tag tree ${tag_tree}, got ${publish_tree}.${main_detail}",
    }
  }
  return {success: true, message: "release ${tag} publishes tag tree ${tag_tree}"}
}
