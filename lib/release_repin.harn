/**
 * Decision logic for `--repin-latest`: advance a still-open release PR's
 * pin SHA to the current `<base>` HEAD so commits that landed during the
 * PR window fold into the same release, rather than splitting into a
 * future v$next+1.
 *
 * These functions stay pure so the TOCTTOU re-check window can be
 * exercised by unit tests with mocked probe results.
 */
import { GitRemoteRef } from "std/git"

/** Return the direct SHA from typed refs for one exact remote tag. */
pub fn remote_tag_sha(refs: list<GitRemoteRef>) -> string {
  for remote_ref in refs {
    if !remote_ref.peeled {
      return remote_ref.oid
    }
  }
  return ""
}

/**
 * Resolve the commit targeted by typed remote refs. Annotated tags include a
 * peeled row; lightweight tags include only the direct row.
 */
pub fn remote_tag_target_sha(refs: list<GitRemoteRef>) -> string {
  let first_sha = ""
  for remote_ref in refs {
    if first_sha == "" {
      first_sha = remote_ref.oid
    }
    if remote_ref.peeled {
      return remote_ref.oid
    }
  }
  return first_sha
}

/**
 * Decide whether a remote release tag observation is idempotent. An existing
 * remote tag that already targets the release commit is success; an existing
 * remote tag at any other commit is immutable-release drift and must not be
 * moved automatically.
 */
pub fn remote_release_tag_decision(inputs) {
  let tag = trim(inputs.tag ?? "v<unknown>")
  let head = trim(inputs.head_sha ?? "")
  let remote_target = trim(inputs.remote_target_sha ?? "")
  if remote_target == "" {
    return {action: "proceed", reason: ""}
  }
  if head != "" && remote_target == head {
    return {action: "reuse", reason: "origin/${tag} already targets release HEAD ${head}"}
  }
  return {
    action: "abort",
    reason: "remote tag ${tag} already targets ${remote_target}, but release HEAD is ${head}; refusing to move a published release tag automatically",
  }
}

/**
 * Decide how to handle a local release tag after the remote tag probe has
 * proven origin has no such tag. Local-only stale tags are interrupted-run
 * residue, not published release state, so they can be refreshed without
 * force-moving anything on origin.
 */
pub fn local_release_tag_decision(inputs) {
  let tag = trim(inputs.tag ?? "v<unknown>")
  let head = trim(inputs.head_sha ?? "")
  let local_target = trim(inputs.local_target_sha ?? "")
  let remote_target = trim(inputs.remote_target_sha ?? "")
  let local_exists = inputs.local_exists ?? (local_target != "")
  if remote_target != "" {
    return {
      action: "abort",
      reason: "remote tag ${tag} exists at ${remote_target}; refusing to refresh a local tag while origin has release state",
    }
  }
  if !local_exists {
    return {action: "create", reason: "local tag ${tag} is absent"}
  }
  if head != "" && local_target == head {
    return {action: "reuse", reason: "local tag ${tag} already targets release HEAD ${head}"}
  }
  if local_target == "" {
    return {
      action: "abort",
      reason: "local tag ${tag} exists, but its target commit could not be resolved; refusing to refresh without a known old target",
    }
  }
  if head == "" {
    return {
      action: "abort",
      reason: "local tag ${tag} exists at ${local_target}, but release HEAD could not be resolved; refusing to refresh without a target",
    }
  }
  return {
    action: "refresh",
    reason: "local-only tag ${tag} targets ${local_target}, but release HEAD is ${head}; origin has no ${tag}, so refreshing the local tag is safe",
  }
}

/**
 * Inputs gathered immediately before the destructive branch reset:
 *   release_exists           — crates.io or required binary assets prove
 *                              v$next already shipped.
 *   initial_remote_tag_sha   — SHA captured at startup (or "").
 *   current_remote_tag_sha   — SHA observed in the final typed remote-ref probe.
 *   new_pin_sha              — origin/<base>^{commit} resolved in the
 *                              final probe; the SHA we are about to reset
 *                              the release branch to.
 *
 * Returns `{action, reason, new_pin_sha}`:
 *   action="proceed"  — all gates pass; caller may reset to new_pin_sha.
 *   action="abort"    — caller must surface `reason` and stop.
 */
pub fn repin_tocttou_decision(inputs) {
  let release_exists = inputs.release_exists
  let initial_tag = trim(inputs.initial_remote_tag_sha ?? "")
  let current_tag = trim(inputs.current_remote_tag_sha ?? "")
  let new_pin = trim(inputs.new_pin_sha ?? "")
  let tag = trim(inputs.tag ?? "v<unknown>")
  if release_exists == nil {
    return {
      action: "abort",
      reason: "could not prove release state for ${tag} immediately before mutation",
      new_pin_sha: "",
    }
  }
  if release_exists {
    return {
      action: "abort",
      reason: "release ${tag} materialized between initial check and mutation step (crates.io is immutable; --repin-latest cannot advance a published release)",
      new_pin_sha: "",
    }
  }
  if current_tag != initial_tag {
    let before = if initial_tag == "" {
      "absent"
    } else {
      initial_tag
    }
    let after = if current_tag == "" {
      "absent"
    } else {
      current_tag
    }
    return {
      action: "abort",
      reason: "remote tag ${tag} moved from ${before} to ${after} between initial check and mutation step",
      new_pin_sha: "",
    }
  }
  if new_pin == "" {
    return {
      action: "abort",
      reason: "could not re-resolve origin/<base>^{commit} immediately before branch reset",
      new_pin_sha: "",
    }
  }
  return {action: "proceed", reason: "", new_pin_sha: new_pin}
}

/**
 * The selected SHA is the release cutoff. Commits that reach the base after
 * selection belong to the next release, provided the cutoff remains in the
 * base ancestry. A force-push or divergent base fails closed.
 *
 * Inputs (`base_head_sha` is `origin/<base>` HEAD re-probed immediately before
 * the tag push, not the startup value):
 *   pin_sha       — the frozen release pin (the release branch's parent).
 *   base_head_sha — fresh `origin/<base>` HEAD.
 *   pin_is_base_ancestor — result of `merge-base --is-ancestor` against that
 *                          fresh base head.
 *   base / tag    — names used only in the message.
 *   repin_latest  — `--repin-latest`: the pin was deliberately advanced to
 *                   fresh base and re-audited; its TOCTTOU gate owns drift.
 *   explicit_pin  — `--at-sha`: the operator pinned a specific commit on
 *                   purpose, so divergence from base HEAD is intended.
 *   allow_drift   — `--allow-base-drift`: conscious override to ship the
 *                   frozen pin even though base moved.
 *
 * Returns `{action, reason}`: action="proceed" is safe to tag; action="abort"
 * means surface `reason` and stop before the tag push. Fail-closed: an empty
 * probe SHA aborts rather than assuming the cutoff is reachable.
 */
pub fn release_cutoff_probe(git, inputs) {
  const base = trim(inputs.base ?? "main")
  const pin_sha = trim(inputs.pin_sha ?? "")
  const head = git(["rev-parse", "--verify", "origin/${base}^{commit}"])
  const base_head = if head.success {
    trim(head.stdout ?? "")
  } else {
    ""
  }
  const ancestry = if pin_sha != "" && base_head != "" {
    git(["merge-base", "--is-ancestor", pin_sha, base_head])
  } else {
    nil
  }
  return {base_head_sha: base_head, pin_is_base_ancestor: ancestry?.success ?? false}
}

pub fn release_cutoff_decision(inputs) {
  let pin_sha = trim(inputs.pin_sha ?? "")
  let base_head_sha = trim(inputs.base_head_sha ?? "")
  let base = trim(inputs.base ?? "<base>")
  let tag = trim(inputs.tag ?? "v<unknown>")
  if (inputs.repin_latest ?? false) || (inputs.explicit_pin ?? false)
    || (inputs.allow_drift ?? false) {
    return {action: "proceed", reason: ""}
  }
  if pin_sha == "" || base_head_sha == "" {
    return {
      action: "abort",
      reason: "release cutoff check could not resolve the selected pin and origin/${base} HEAD before tagging ${tag}; refusing to tag without ancestry proof",
    }
  }
  if !(inputs.pin_is_base_ancestor ?? false) {
    return {
      action: "abort",
      reason: "release cutoff ${pin_sha} is not an ancestor of origin/${base} HEAD ${base_head_sha}; refusing to tag ${tag} from a divergent or unprovable base. Re-run with --repin-latest after reconciling the base, or --allow-base-drift to ship the frozen cutoff on purpose.",
    }
  }
  return {action: "proceed", reason: ""}
}

/**
 * Pure release-publication invariant: the tree that gets published for a
 * version must be the tree pointed to by the release tag. A later main tree
 * may contain extra queued PRs, but it must not define the version's crates,
 * binaries, or notes.
 */
pub fn release_publish_tree_invariant(inputs) {
  let tag = trim(inputs.tag ?? "v<unknown>")
  let tag_tree = trim(inputs.tag_tree ?? "")
  let publish_tree = trim(inputs.publish_tree ?? "")
  let main_tree = trim(inputs.main_tree ?? "")
  if tag_tree == "" {
    return {success: false, message: "release ${tag} has no tag tree to publish from"}
  }
  if publish_tree == "" {
    return {success: false, message: "release ${tag} has no resolved publish tree"}
  }
  if publish_tree != tag_tree {
    let main_detail = if main_tree != "" && main_tree == publish_tree && main_tree != tag_tree {
      " Published tree matches main, but main has moved past ${tag}."
    } else {
      ""
    }
    return {
      success: false,
      message: "release ${tag} must publish tag tree ${tag_tree}, got ${publish_tree}.${main_detail}",
    }
  }
  return {success: true, message: "release ${tag} publishes tag tree ${tag_tree}"}
}
