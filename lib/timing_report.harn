fn timing_span_record(span) {
  const attrs = span.attributes ?? span.metadata ?? {}
  return {
    name: span.name ?? "unknown",
    kind: span.kind ?? "",
    duration_ms: span.duration_ms ?? 0,
    status: span.status ?? attrs.status ?? "",
    attributes: attrs,
    event_count: len(span.events ?? []),
  }
}

pub fn timing_duration_label(duration_ms: int?) -> string {
  const ms = to_int(duration_ms ?? 0) ?? 0
  if ms < 1000 {
    return "${ms}ms"
  }
  const total_seconds = (ms + 500) / 1000
  if total_seconds < 60 {
    return "${total_seconds}s"
  }
  const minutes = total_seconds / 60
  const seconds = total_seconds - minutes * 60
  if seconds < 10 {
    return "${minutes}:0${seconds}"
  }
  return "${minutes}:${seconds}"
}

/** Return completed Harn user-timing spans in a compact, report-friendly shape. */
pub fn user_timing_spans(
  harness: HarnessObs,
  spans: list<TimingSpan>? = nil,
) -> list<TimingSpanRecord> {
  const source = spans ?? harness.trace_spans()
  return (source ?? []).filter({ span -> (span.kind ?? "") == "user_timing" }).map(
    { span -> timing_span_record(span) },
  )
    .to_list()
}

/** Aggregate user-timing spans by stable span name for machine-readable reports. */
fn timing_summary(harness: HarnessObs, spans = nil) {
  const timings = user_timing_spans(harness, spans)
  let total_duration_ms = 0
  let by_name = {}
  for span in timings {
    const name = span.name ?? "unknown"
    const duration = span.duration_ms ?? 0
    const status = span.status ?? ""
    const prev = by_name[name]
      ?? {count: 0, duration_ms: 0, max_duration_ms: 0, error_count: 0}
    by_name[name] = {
      count: prev.count + 1,
      duration_ms: prev.duration_ms + duration,
      max_duration_ms: if duration > prev.max_duration_ms {
        duration
      } else {
        prev.max_duration_ms
      },
      error_count: prev.error_count
        + if status == "error" {
        1
      } else {
        0
      },
    }
    total_duration_ms = total_duration_ms + duration
  }
  return {span_count: len(timings), total_duration_ms: total_duration_ms, by_name: by_name}
}

pub fn slowest_timing_rows(
  summary: TimingSummaryInput,
  opts: TimingSummaryOptions = {},
) -> list<TimingSlowRow> {
  let limit = to_int(opts?.limit ?? 5) ?? 5
  if limit < 0 {
    limit = 0
  }
  let min_duration_ms = to_int(opts?.min_duration_ms ?? 1000) ?? 1000
  if min_duration_ms < 0 {
    min_duration_ms = 0
  }
  let rows = []
  const by_name = summary.by_name
  for name in by_name.keys().sort() {
    const row = by_name[name] ?? {}
    const duration_ms = to_int(row?.duration_ms ?? 0) ?? 0
    if duration_ms < min_duration_ms {
      continue
    }
    rows = rows
      + [
      {
        name: name,
        count: to_int(row?.count ?? 0) ?? 0,
        duration_ms: duration_ms,
        max_duration_ms: to_int(row?.max_duration_ms ?? 0) ?? 0,
        error_count: to_int(row?.error_count ?? 0) ?? 0,
      },
    ]
  }
  return rows.sort_by({ row -> 0 - row.duration_ms }).take(limit).to_list()
}

pub fn timing_summary_lines(
  summary: TimingSummaryInput,
  opts: TimingSummaryOptions = {},
) -> list<string> {
  return slowest_timing_rows(summary, opts).map(
    { row ->
      let line = "${row.name}: ${timing_duration_label(row.duration_ms)}"
      if row.count > 1 {
        line = line
          + " total across "
          + to_string(row.count)
          + " spans, max "
          + timing_duration_label(row.max_duration_ms)
      }
      if row.error_count > 0 {
        line = line + ", errors " + to_string(row.error_count)
      }
      return line
    },
  )
    .to_list()
}

/** Snapshot raw spans and the aggregate summary at the same point in the run. */
pub fn timing_artifacts(harness: HarnessObs) -> TimingArtifacts {
  const spans = harness.trace_spans()
  return {trace_spans: spans, timing_summary: timing_summary(harness, spans)}
}

pub type TimingSpan = {
  name?: string,
  kind?: string,
  duration_ms?: int,
  status?: string,
  attributes?: dict,
  metadata?: dict,
  events?: list<dict>,
  ...rest,
}

pub type TimingSpanRecord = {
  name: string,
  kind: string,
  duration_ms: int,
  status: string,
  attributes: dict,
  event_count: int,
}

pub type TimingAggregate = {count: int, duration_ms: int, max_duration_ms: int, error_count: int}

pub type TimingSummary = {span_count: int, total_duration_ms: int, by_name: dict}

pub type TimingSummaryInput = {by_name: dict, ...rest}

pub type TimingSummaryOptions = {limit?: int, min_duration_ms?: int, ...rest}

pub type TimingSlowRow = {name: string, ...TimingAggregate}

pub type TimingArtifacts = {trace_spans: list<TimingSpan>, timing_summary: TimingSummary}
