import { workflow_run_repair } from "std/workflow/repair"
import { agent_result_text } from "./release_audit"

pub type AgentReviewAttemptRecord = {
  name: string,
  text: string,
  validation_findings: list<string>,
  ...rest,
}

pub type AgentReviewExecuteConfig = {
  task: string,
  max_attempts: int,
  run_attempt: fn(dict) -> dict,
  validate: fn(any, string) -> list<string>,
  make_record: fn(string, string, list<string>, any) -> AgentReviewAttemptRecord,
}

pub type AgentReviewExecuteResult = {
  text: string,
  validation_findings: list<string>,
  attempts: list<AgentReviewAttemptRecord>,
  final_result: dict,
}

/**
 * Canonical name for the Nth release-review attempt. Attempt 1 is the initial
 * audit; every later attempt is a findings-driven repair pass. The names are a
 * crystallization contract: `agent_fixture_events` emits them as `agent_review_attempt`
 * event identifiers and `persist_agent_artifacts` serializes them into
 * `raw_result.json`, so they must stay `initial-review`,
 * `validation-repair-1`, `validation-repair-2`, ...
 */
pub fn agent_review_attempt_name(attempt: int) -> string {
  if attempt <= 1 {
    return "initial-review"
  }
  return "validation-repair-" + to_string(attempt - 1)
}

/** Return the canonical workflow attempt list, with a legacy run-view fallback. */
pub fn agent_review_attempt_values(out: dict) -> list<dict> {
  const attempts = out?.attempts ?? []
  if len(attempts) > 0 {
    return attempts
  }
  return out?.run?.stages[0]?.attempts ?? []
}

/**
 * Drive the release audit run -> validate -> repair-with-feedback loop on harn's
 * canonical `workflow_run_repair` primitive instead of a hand-rolled while loop.
 *
 * The whole attempt is owned by a caller-supplied inline executor (harn #4086):
 * for each attempt `workflow_run_repair` invokes our executor, which runs the
 * agent, validates the output, and returns a settled payload whose `branch` is
 * `"failed"` while findings remain — that is what drives the primitive's retry.
 * The retry context threads the prior attempt's findings/text back in
 * (`ctx.prior_findings` / `ctx.prior_text`), so `run_attempt` can rebuild the
 * repair prompt exactly as the old loop did. The primitive caps the loop at
 * `max_attempts`, stopping the moment an attempt validates clean.
 *
 * Because the primitive's own attempt records do not carry bump-fleet's richer
 * per-attempt shape (text / llm / tools / transcript_context / raw result), the
 * executor stashes the full `make_record(...)` record and the raw agent result
 * inside each attempt's `verification`, which survives on
 * `run.stages[i].attempts[i].verification`. We reconstruct the byte-identical
 * `attempts` list from there.
 *
 * Callbacks:
 * - `run_attempt(ctx) -> agent_loop_result` — runs one attempt. `ctx` is the
 *   retry context `{task, attempt, prior_findings, prior_verification,
 *   prior_text, artifacts}`; `attempt` is 1-based. The caller branches on
 *   `ctx.attempt` to pick the initial vs. repair system/prompt.
 * - `validate(result, text) -> list` — machine-checked findings for the attempt.
 *   Empty findings means the attempt passed.
 * - `make_record(name, text, findings, result) -> dict` — builds the per-attempt
 *   record surfaced downstream.
 *
 * Returns `{text, validation_findings, attempts, final_result}` where `text`,
 * `validation_findings`, and `final_result` are the last attempt's values.
 */
pub fn agent_review_execute(config: AgentReviewExecuteConfig) -> AgentReviewExecuteResult {
  const base_prompt = config.task
  const max_attempts = config.max_attempts
  const run_attempt = config.run_attempt
  const validate = config.validate
  const make_record = config.make_record
  const executor = { ctx ->
    const result = run_attempt(ctx)
    const text = agent_result_text(result)
    const findings = validate(result, text)
    const record = make_record(agent_review_attempt_name(ctx.attempt), text, findings, result)
    return {
      result: result,
      verification: {
        ok: len(findings) == 0,
        findings: findings,
        record: record,
        raw_result: result,
      },
      // A non-"failed" branch settles the attempt as a success and stops the
      // primitive's retry loop; "failed" keeps retrying (up to max_attempts)
      // and threads these findings into the next attempt's context.
      branch: if len(findings) == 0 {
        nil
      } else {
        "failed"
      },
      outcome: "completed",
    }
  }
  const out = workflow_run_repair(
    {task: base_prompt, executor: executor, max_attempts: max_attempts},
  )
  let records: list<AgentReviewAttemptRecord> = []
  let raw_results: list<dict> = []
  let attempt_errors: list<string> = []
  for {index: _index, value} in agent_review_attempt_values(out).enumerate() {
    const verification = value?.verification
    const record = verification?.record
    if record == nil {
      attempt_errors = attempt_errors + [value?.error ?? "attempt record omitted without an error"]
      continue
    }
    records = records + [record]
    raw_results = raw_results + [verification?.raw_result]
  }
  if len(records) == 0 {
    const stage = out.run?.stages[0]
    const detail = {
      workflow_status: out.status ?? "unknown",
      stage_status: stage?.status ?? "missing",
      stage_error: stage?.error ?? stage?.result?.error,
      findings: out.findings ?? [],
      attempt_errors: attempt_errors,
    }
    throw "release agent review produced no attempt records: " + json_stringify(detail)
  }
  const last = len(records) - 1
  const final_record = records[last]
  if final_record == nil {
    throw "release agent review final attempt record disappeared after validation"
  }
  return {
    text: final_record.text,
    validation_findings: final_record.validation_findings,
    attempts: records,
    final_result: raw_results[last] ?? {},
  }
}
