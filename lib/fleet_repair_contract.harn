/**
 * The typed contract every repair stage reads and writes.
 *
 * These shapes are the seam between planning, execution, and the receipt. They
 * live apart from the controller so a stage can name what it takes without
 * pulling in the agent loop, the GitHub client, and the model route with it.
 */
import { FleetRepairTerminalResult } from "./fleet_repair_terminal"
import { HarnUpdateBudgetPolicy, HarnUpdateRuntimeProvenance } from "./harn_update"

pub type FleetRepairPolicy = HarnUpdateBudgetPolicy \
  & {
  max_repositories: int,
  runtime_provenance: HarnUpdateRuntimeProvenance,
  provider_secret_reference?: string,
  route_override?: "value" | "strong",
  deterministic_only?: bool,
}

/**
 * Name only: the brokered secret may reach the repair agent, never this controller.
 * Rehearsals may choose a route; production uses value then strong.
 */
pub type FleetRepairCandidate = {
  repo: string,
  directory: string,
  pr_number: int,
  pr_url: string,
  head_sha: string,
  validation_command: string,
  failing_checks: list<dict>,
  allowed_new_files: list<string>,
  branch: string,
  auto_arm: bool,
  require_signed_head: bool,
}

pub type FleetRepairPlan = {
  target: string,
  recoveries: list<FleetRecoveryCandidate>,
  candidates: list<FleetRepairCandidate>,
  refused: list<{repo: string, reason: string}>,
}

pub type FleetRecoveryCandidate = {
  repo: string,
  head_sha: string,
  branch_pin: string,
  branch: string,
  base_branch: string,
  auto_arm: bool,
  require_signed_head: bool,
  /** The area this repository's title gate requires, or "" when it has none. */
  pr_title_area: string,
}

pub type FleetRepairReceipt = {
  schema_version: "harn_bump_fleet.harn_update_repair.v4",
  target: string,
  ok: bool,
  policy: FleetRepairPolicy,
  runtime_provenance: HarnUpdateRuntimeProvenance,
  authority: FleetRepairAuthorityAudit,
  results: list<FleetRepairTerminalResult>,
  known_cost_usd: float,
  cost_status: "exact" | "lower_bound" | "unknown",
  stopped_reason: string?,
}

/** Authority requested, granted, observed, and withheld for one repair receipt. */
pub type FleetRepairAuthorityAudit = {
  decider: string,
  requested: list<string>,
  granted: list<string>,
  used: list<string>,
  denied: list<string>,
  unused: list<string>,
  observation_note: string,
}
