import { ReleaseFoldRepairDecision } from "./release_fold_repair"

/**
 * What a cutover repair would do, said before anything does it.
 *
 * The dry run is a separate receipt rather than a pass through the effect door
 * because the door's read-back is what distinguishes an effect that happened
 * from one that did not. A dry run that borrowed that path would have to hand
 * the door either an observed read for a pull request nobody opened, which
 * reads as a repair, or a missing one, which reads as an attempt that failed.
 * Neither is what happened, and both would put a false line in the one record
 * a release owner reads.
 *
 * So the plan says `planned` and never `repaired`, and the live executor is the
 * only thing that can produce the latter.
 */
pub type ReleaseCutoverPlanOutcome = "planned" | "refused"

pub type ReleaseCutoverPlan = {
  schema_version: "harn_bump_fleet.release_cutover_plan.v1",
  outcome: ReleaseCutoverPlanOutcome,
  /** The repository the pull request would be opened on. */
  repository: string,
  /** The branch it would be opened from, empty when nothing would be opened. */
  head: string,
  /** Its title, empty when nothing would be opened. */
  title: string,
  /** The refusal code when nothing would be opened, empty when something would. */
  code: string,
  /** The pull request already doing this work, when that is why. */
  existing_pr: string,
  /** What the pull request would not fix, empty when it fixes everything owed. */
  unrepaired: string,
  reason: string,
}

/**
 * Project one repair decision as the plan a reader can act on.
 *
 * The decision type carries exactly one of a pull request or a refusal, so a
 * value carrying neither is a defect rather than a quiet nothing. This refuses
 * loudly on that shape instead of emitting an empty plan, because an empty plan
 * is indistinguishable from a release that owes nothing.
 */
pub fn release_cutover_plan(
  decision: ReleaseFoldRepairDecision,
  repository: string,
) -> ReleaseCutoverPlan {
  const planned = decision.pull_request
  const refusal = decision.refusal
  if planned != nil && refusal != nil {
    throw "a cutover decision carried both a pull request and a refusal"
  }
  if planned == nil && refusal == nil {
    throw "a cutover decision carried neither a pull request nor a refusal"
  }
  if planned != nil {
    const pr = unwrap(planned)
    return {
      schema_version: "harn_bump_fleet.release_cutover_plan.v1",
      outcome: "planned",
      repository: pr.repository,
      head: pr.head,
      title: pr.title,
      code: "",
      existing_pr: "",
      unrepaired: pr.unrepaired,
      reason: pr.reason,
    }
  }
  const stop = unwrap(refusal)
  return {
    schema_version: "harn_bump_fleet.release_cutover_plan.v1",
    outcome: "refused",
    repository: trim(repository),
    head: "",
    title: "",
    code: stop.code,
    existing_pr: stop.existing_pr,
    unrepaired: "",
    reason: stop.reason,
  }
}

/**
 * The plan as the one line a release owner reads first.
 *
 * It says "would open", never "opened". A dry run whose summary read like a
 * performed repair is the failure this whole shape exists to avoid, and the
 * summary is the part anyone actually reads.
 */
pub fn release_cutover_plan_summary(plan: ReleaseCutoverPlan) -> string {
  if plan.outcome == "refused" {
    return "no cutover pull request would be opened (${plan.code}): ${plan.reason}"
  }
  const carried = plan.unrepaired == "" ? "" : "; it would not fix ${plan.unrepaired}"
  return "would open ${plan.repository} ${plan.head} titled `${plan.title}`${carried}"
}
