pub type ReleaseMainTagAction = "wait" \
  | "merge" \
  | "certify_main" \
  | "unfold" \
  | "unfold_merge_race" \
  | "defer" \
  | "tag" \
  | "reuse" \
  | "abort" \
  | "certification_drift"

/** Whether the candidate is being admitted to main or the landed commit tagged. */
pub type ReleaseMainTagPhase = "main_tag_admission" | "tag"

pub type ReleaseMainTagDecision = {
  action: ReleaseMainTagAction,
  reason: string,
  merge_sha: string,
  drifted_paths: list<string>,
  observed_main: string,
  /**
   * Derived from `merge_sha`, never chosen per action: no merge SHA means the
   * question is still whether the candidate is admitted onto main; once one
   * exists, the only question left is the tag.
   */
  phase: ReleaseMainTagPhase,
  /** The exact observation that decided a terminal post-merge action. */
  main_delta: ReleaseMainDelta?,
}

/**
 * What the certified candidate and the merged main commit each point at.
 *
 * The public tag is minted on the release pull request's merge commit into
 * main, not on the frozen source the release certified. When main moves between
 * certification and that merge, the tag names a tree nobody certified, and
 * publication reads the tag tree, so the uncertified commits ship inside the
 * version. Observed on v0.10.126: the candidate froze at e125cffb, two pull
 * requests landed on main before the release merged, and the tag's tree
 * diverged from the candidate's across 68 files.
 *
 * `drifted_paths` exists so the refusal can name what moved instead of asking
 * an operator to go and diff two commits.
 */
pub type ReleaseCertificationTrees = {
  candidate_commit: string,
  candidate_tree: string,
  merged_commit: string,
  /** The merged commit's first parent: the exact main base GitHub merged onto. */
  merged_base_commit: string,
  merged_tree: string,
  drifted_paths: list<string>,
}

pub type ReleaseMainTagPullRequest = {
  number: int,
  merged: bool,
  merge_commit_oid: string?,
  github_state: string,
  auto_merge_armed: bool,
  in_merge_queue: bool?,
  base: {ref: string, ...rest},
  head: {ref: string, sha: string, ...rest},
  ...rest,
}

pub type ReleaseMainTagAdapter = {
  pull_request: fn(int) -> ReleaseMainTagPullRequest?,
  remote_tag_target: fn(int) -> string,
  /**
   * Resolve the certified candidate's tree and the merged main commit's tree.
   * Required, not optional: an absent prober would let the drift gate pass by
   * not running.
   */
  certification_trees: fn(string) -> ReleaseCertificationTrees?,
  /**
   * Observe where main is now, and what changed since the certified base.
   * Required for the same reason the tree prober is: an absent observation
   * would release the merge by not looking.
   */
  merge_gate: fn(ReleaseMainTagPullRequest) -> ReleaseMergeGateState?,
  /** Merge the release pull request under its exact observed head lease. */
  merge: fn(ReleaseMainTagPullRequest) -> bool,
  /**
   * Where the lanes only a release runs stand on the merged main commit.
   * Required, not optional, for the same reason the tree prober is: a gate that
   * can be reached by not looking is not a gate.
   */
  main_delta: fn(string, int) -> ReleaseMainDelta,
  /** Start or adopt only the lanes still missing on the merged main commit. */
  dispatch_main_delta: fn(ReleaseMainDelta) -> bool,
  /** Open the pull request that reverts a bump which merged but must not ship. */
  unfold: fn(string) -> ReleaseUnfoldDecision,
  /** Take the merge back if an earlier run left auto-merge armed. */
  disarm: fn(ReleaseMainTagPullRequest, string) -> bool,
  merged_main_ancestor: fn(string) -> bool,
  push_tag: fn(string) -> list<dict>,
  now: fn(int) -> string,
  wait: fn(int) -> nil,
}

pub type ReleaseMainTagResult = {
  status: int,
  reason: string,
  receipt: ReleaseWatchReceipt,
  steps: list<dict>,
  polls: int,
  phase: ReleaseMainTagPhase,
}

/**
 * The phase a decision belongs to, derived from the one fact that actually
 * distinguishes them: whether a merge commit exists yet.
 */
fn main_tag_phase(merge_sha: string) -> ReleaseMainTagPhase {
  return if trim(merge_sha) == "" {
    "main_tag_admission"
  } else {
    "tag"
  }
}

fn main_tag_decision(
  action: ReleaseMainTagAction,
  reason: string,
  merge_sha: string = "",
  drifted_paths: list<string> = [],
  observed_main: string = "",
  main_delta: ReleaseMainDelta? = nil,
) -> ReleaseMainTagDecision {
  return {
    action: action,
    reason: reason,
    merge_sha: merge_sha,
    drifted_paths: drifted_paths,
    observed_main: observed_main,
    phase: main_tag_phase(merge_sha),
    main_delta: main_delta,
  }
}

fn tree_oid(value: string?) -> string {
  return lowercase(trim(to_string(value ?? "")))
}

/**
 * Report whether the merged main commit carries the tree the release certified.
 *
 * Both tree OIDs must be present. An unresolved tree is not agreement: two
 * empty strings compare equal, which is exactly how a probe that answered
 * nothing would read as a clean release.
 */
pub fn release_certification_trees_agree(
  trees: ReleaseCertificationTrees,
  drift: ReleaseCertificationDrift,
) -> bool {
  const candidate = tree_oid(trees.candidate_tree)
  const merged = tree_oid(trees.merged_tree)
  if candidate == "" || merged == "" {
    return false
  }
  if candidate == merged {
    return true
  }
  // The changed paths below are meaningful only for the exact main snapshot
  // the merge gate observed. If main advances after that observation, a later
  // commit can touch the same path and path containment would otherwise
  // misidentify unobserved content as the content the receipt recorded.
  const merged_base = tree_oid(trees.merged_base_commit)
  const observed_main = tree_oid(drift.observed_main)
  if !exact_commit(merged_base) || !exact_commit(observed_main) || merged_base != observed_main {
    return false
  }
  // The trees differ, which is legitimate exactly when every file that differs
  // is one the recorded drift already accounts for. A record that was never
  // written, or one that describes another pair of heads, accounts for nothing.
  if drift.state != "recorded" || len(trees.drifted_paths) == 0 {
    return false
  }
  if tree_oid(drift.certified_base) == "" || tree_oid(drift.observed_main) == "" {
    return false
  }
  for path in trees.drifted_paths {
    if !drift.drifted_paths.contains(path) && len(release_certification_bearing_paths([path])) > 0 {
      return false
    }
  }
  return true
}

/** True only for a proved post-admission base race, not for a failed probe. */
fn release_merge_base_moved(
  trees: ReleaseCertificationTrees,
  drift: ReleaseCertificationDrift,
) -> bool {
  const candidate = tree_oid(trees.candidate_tree)
  const merged = tree_oid(trees.merged_tree)
  const merged_base = tree_oid(trees.merged_base_commit)
  const observed_main = tree_oid(drift.observed_main)
  return candidate != "" && merged != "" && candidate != merged
    && exact_commit(merged_base)
    && exact_commit(observed_main)
    && merged_base != observed_main
}

fn drift_reason(
  tag: string,
  trees: ReleaseCertificationTrees,
  drift: ReleaseCertificationDrift,
) -> string {
  const named = if len(trees.drifted_paths) == 0 {
    "no paths reported"
  } else {
    trees.drifted_paths.join(", ")
  }
  return "main moved between certification and the merge, so ${tag} would name a tree nobody"
    + " certified. The release certified ${tree_oid(trees.candidate_commit)}"
    + " (tree ${tree_oid(trees.candidate_tree)}) but the merged main commit"
    + " ${tree_oid(trees.merged_commit)} carries tree ${tree_oid(trees.merged_tree)}."
    + " Its main parent is ${tree_oid(trees.merged_base_commit)}, while the merge gate"
    + " observed ${tree_oid(drift.observed_main)}."
    + " Drifted paths: ${named}. "
    + release_stranded_recovery_advice(tag, trees.merged_commit)
}

fn merge_base_race_reason(
  tag: string,
  trees: ReleaseCertificationTrees,
  drift: ReleaseCertificationDrift,
) -> string {
  return "main advanced after the final merge admission, so ${tag} would name a tree nobody"
    + " certified. GitHub squashed the release onto ${tree_oid(trees.merged_base_commit)},"
    + " but the release admitted ${tree_oid(drift.observed_main)}. Refusing the tag and"
    + " unfolding merged main commit ${tree_oid(trees.merged_commit)}."
}

fn exact_commit(value: string?) {
  return regex_match("^[0-9a-f]{40}$", lowercase(trim(to_string(value ?? "")))) != nil
}

/**
 * Decide what to do with a release pull request that has not merged yet.
 *
 * The merge is the release's own act, not GitHub's. Arming auto-merge at
 * pull-request open let GitHub squash whenever the checks finished, at a base
 * nobody re-observed, which is how a certified candidate turned into an
 * uncertified tag. Arming is held here until main is still the commit this
 * release certified, and until GitHub reports it would merge now rather than
 * later.
 */
fn release_open_pr_merge_decision(
  pull_request: ReleaseMainTagPullRequest,
  merge_gate: fn(ReleaseMainTagPullRequest) -> ReleaseMergeGateState?,
) -> ReleaseMainTagDecision {
  if pull_request?.in_merge_queue ?? false {
    return main_tag_decision("wait", "release pull request is inside the merge queue")
  }
  return observed_release_merge_decision(merge_gate(pull_request))
}

/** Apply the one merge-admission policy to any observation, including refreshes. */
fn observed_release_merge_decision(gate: ReleaseMergeGateState?) -> ReleaseMainTagDecision {
  if gate == nil {
    return main_tag_decision(
      "defer",
      "could not observe origin/main against the certified base; refusing to release the merge without that proof",
    )
  }
  const gated = release_merge_gate_decision(gate)
  if gated.action == "merge" {
    return main_tag_decision("merge", gated.reason, "", gated.bearing_paths, gate.observed_main)
  }
  if gated.action == "defer" {
    return main_tag_decision("defer", gated.reason, "", gated.bearing_paths, gate.observed_main)
  }
  if gated.action == "abort" {
    // A malformed or absent gate observation is not evidence that an already
    // armed PR is harmless. Treat it as a deferral so the driver confirms that
    // stale auto-merge authority is gone before it returns.
    return main_tag_decision("defer", gated.reason, "", gated.bearing_paths, gate.observed_main)
  }
  return main_tag_decision("wait", gated.reason, "", [], gate.observed_main)
}

/**
 * Decide whether the immutable public tag may be born. The release PR and its
 * exact candidate head are the authority: an open PR can only be kept moving,
 * while a merged PR may tag its squash commit or reuse that exact remote tag.
 */
pub fn release_main_tag_decision(
  receipt: ReleaseWatchReceipt,
  pull_request: ReleaseMainTagPullRequest?,
  remote_tag_target_sha: string,
  certification_trees: fn(string) -> ReleaseCertificationTrees?,
  merge_gate: fn(ReleaseMainTagPullRequest) -> ReleaseMergeGateState?,
  main_delta: fn(string, int) -> ReleaseMainDelta,
  poll: int,
) -> ReleaseMainTagDecision {
  const remote_target = lowercase(trim(remote_tag_target_sha))
  if remote_target != "" && !exact_commit(remote_target) {
    return main_tag_decision("abort", "remote release tag target is not an exact commit SHA")
  }
  if pull_request == nil {
    if remote_target != "" {
      return main_tag_decision(
        "abort",
        "release tag exists but the owning pull request cannot be proved",
      )
    }
    return main_tag_decision("wait", "release pull request is not observable yet")
  }
  const expected_head = receipt.publication.head_oid
  const actual_head = lowercase(trim(to_string(pull_request?.head?.sha ?? "")))
  const expected_ref = receipt.publication.remote_ref
  const actual_ref = trim(to_string(pull_request?.head?.ref ?? ""))
  const base_ref = trim(to_string(pull_request?.base?.ref ?? ""))
  if actual_head != expected_head || actual_ref != expected_ref || base_ref != "main" {
    return main_tag_decision(
      "abort",
      "release pull request identity does not match ${expected_ref}@${expected_head} -> main",
    )
  }
  const merged = pull_request?.merged ?? false
  const github_state = lowercase(trim(to_string(pull_request?.github_state ?? "")))
  if !merged && github_state != "merged" {
    if remote_target != "" {
      return main_tag_decision("abort", "release tag became public before the release PR merged")
    }
    if github_state != "open" {
      return main_tag_decision(
        "abort",
        "release pull request is ${github_state}; only an open or merged PR can own the tag",
      )
    }
    return release_open_pr_merge_decision(pull_request, merge_gate)
  }
  const merge_sha = lowercase(trim(to_string(pull_request?.merge_commit_oid ?? "")))
  if !exact_commit(merge_sha) {
    return main_tag_decision("abort", "merged release pull request has no exact merge commit SHA")
  }
  if receipt.release_commit_oid != "" && receipt.release_commit_oid != merge_sha {
    return main_tag_decision(
      "abort",
      "release receipt is bound to ${receipt.release_commit_oid}, not merged main commit ${merge_sha}",
      merge_sha,
    )
  }
  // The tag is about to name a main commit, not the frozen source. Prove that
  // commit still carries the tree this release certified before minting an
  // immutable public tag over it. The probe is a parameter rather than a later
  // step so no caller can reach a "tag" verdict without having run it.
  const trees = certification_trees(merge_sha)
  if trees == nil {
    return main_tag_decision(
      "abort",
      "could not prove the merged main commit ${merge_sha} carries the certified tree; refusing to mint ${receipt.tag} without that proof",
      merge_sha,
    )
  }
  if release_merge_base_moved(trees, receipt.certification_drift) {
    return main_tag_decision(
      "unfold_merge_race",
      merge_base_race_reason(receipt.tag, trees, receipt.certification_drift),
      merge_sha,
      trees.drifted_paths,
    )
  }
  if !release_certification_trees_agree(trees, receipt.certification_drift) {
    return main_tag_decision(
      "certification_drift",
      drift_reason(receipt.tag, trees, receipt.certification_drift),
      merge_sha,
      trees.drifted_paths,
    )
  }
  if remote_target == "" {
    // The last gate in front of the publication act. The merge let green drift
    // in on main's own required checks; the lanes only a release runs have
    // still not seen this tree, and the tag is what makes it permanent.
    const delta = main_delta(merge_sha, poll)
    const verdict = release_main_delta_decision(delta, merge_sha, trees.drifted_paths)
    if verdict.action == "dispatch" {
      return main_tag_decision(
        "certify_main",
        verdict.reason,
        merge_sha,
        trees.drifted_paths,
        "",
        delta,
      )
    }
    if verdict.action == "wait" {
      return main_tag_decision("wait", verdict.reason, merge_sha, trees.drifted_paths, "", delta)
    }
    if verdict.action == "unfold" {
      return main_tag_decision("unfold", verdict.reason, merge_sha, trees.drifted_paths, "", delta)
    }
    if verdict.action == "abort" {
      return main_tag_decision("abort", verdict.reason, merge_sha, trees.drifted_paths, "", delta)
    }
    return main_tag_decision(
      "tag",
      "release PR merged; ${verdict.reason}; mint the tag on its main commit",
      merge_sha,
      [],
      "",
      delta,
    )
  }
  if remote_target == merge_sha {
    return main_tag_decision("reuse", "release tag already names the merged main commit", merge_sha)
  }
  return main_tag_decision(
    "abort",
    "release tag target ${remote_target} does not match merged main commit ${merge_sha}",
    merge_sha,
  )
}

/**
 * One exact observation of paths changed on main since the certified base.
 *
 * A completed comparison that measured no paths is structurally distinct from
 * a fetch or diff that answered nothing. The watcher can therefore report the
 * operation and failure Git returned instead of manufacturing a clean-looking
 * empty list.
 */
pub type ReleaseMainGitRunner = fn(list<string>) -> ReleaseCommandResult

fn unreadable_drift_paths(
  operation: "fetch" | "diff",
  result: ReleaseCommandResult,
  certified_base: string,
  observed_main: string,
) -> ReleaseDriftPathObservation {
  const error = release_output_tail(result.stderr)
  const reported = if error == "" {
    "Git returned no error text"
  } else {
    error
  }
  return {
    state: "unreadable",
    paths: [],
    failed_operation: operation,
    exit_code: result.exit_code,
    detail: "could not ${operation} while comparing ${lowercase(trim(certified_base))}"
      + "..${lowercase(trim(observed_main))} (exit ${to_string(result.exit_code ?? -1)}): ${reported}",
  }
}

pub fn release_main_git_drift_observation_with(
  git_runner: ReleaseMainGitRunner,
  certified_base: string,
  observed_main: string,
) -> ReleaseDriftPathObservation {
  const fetched = git_runner(["fetch", "origin", "--quiet", "main"])
  if !fetched.success {
    return unreadable_drift_paths("fetch", fetched, certified_base, observed_main)
  }
  const diffed = git_runner(["diff", "--name-only", certified_base, observed_main])
  if !diffed.success {
    return unreadable_drift_paths("diff", diffed, certified_base, observed_main)
  }
  const paths = split(trim(diffed.stdout), "\n").filter({ path -> trim(path) != "" }).to_list()
  return {
    state: "measured",
    paths: paths,
    failed_operation: "",
    exit_code: diffed.exit_code,
    detail: if len(paths) == 0 {
      "Git successfully compared ${lowercase(trim(certified_base))}"
        + "..${lowercase(trim(observed_main))} and measured zero changed paths"
    } else {
      "Git measured ${to_string(len(paths))} changed path(s)"
    },
  }
}

pub fn release_main_git_drift_observation(
  git: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  certified_base: string,
  observed_main: string,
) -> ReleaseDriftPathObservation {
  return release_main_git_drift_observation_with(
    { args -> return run_git(git, cfg, args) },
    certified_base,
    observed_main,
  )
}

/** Attach the exact Git observation to the merge gate it governs. */
pub fn release_main_merge_gate_observe_drift_with(
  gate: ReleaseMergeGateState,
  git_runner: ReleaseMainGitRunner,
) -> ReleaseMergeGateState {
  const observation = release_main_git_drift_observation_with(
    git_runner,
    gate.certified_base,
    gate.observed_main,
  )
  return gate + {drifted_paths: observation.paths, path_observation: observation}
}

/**
 * Lanes a drifted commit can be held to, because its own pull request runs them.
 *
 * Empty until those lanes gain a pull-request trigger. That is what lets this
 * reader land before or after the workflow change without a window in which
 * every code drift waits for a lane that was never going to report.
 */
fn release_main_pull_request_lanes(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  required: list<string>,
  revision: string,
) -> list<string> {
  return release_workflow_inventory_at_revision(harness, cfg, revision).pull_request.checks.filter(
    { lane -> !required.contains(lane) },
  )
    .to_list()
}

/**
 * Read every commit that landed since certification and resolve each one
 * against the branch's required checks.
 *
 * Nil, never a partial answer: a commit whose checks could not be read is not a
 * commit that passed them, and the gate must not see a shortened list.
 */
pub fn release_main_drift_evidence(
  harness: Harness,
  cfg: dict,
  slug: string,
  certified_base: string,
  observed_main: string,
) -> ReleaseDriftEvidence? {
  const rulesets = github_repository_rulesets(harness, slug)
  if is_err(rulesets) {
    return nil
  }
  const required = release_required_contexts_from_rulesets(unwrap(rulesets))
  // Lanes a drifted commit can be held to. Computed here, beside the required
  // set, because a lane the branch already requires is not an extra obligation.
  const pull_request_lanes = try {
    release_main_pull_request_lanes(
      {env: harness.env, process: harness.process},
      cfg,
      required,
      observed_main,
    )
  }
  if is_err(pull_request_lanes) {
    return nil
  }
  const git = {env: harness.env, process: harness.process}
  const listed = run_git(git, cfg, ["log", "--format=%H", "${certified_base}..${observed_main}"])
  if !listed.success {
    return nil
  }
  const shas = split(trim(listed.stdout), "\n").filter({ sha -> trim(sha) != "" }).to_list()
  let commits: list<ReleaseDriftCommit> = []
  for sha in shas {
    // Which lanes this commit owes an answer for depends on what it changed,
    // not on what the whole drift changed. A documentation commit alongside a
    // code one must not inherit the code one's obligation and wait for a lane
    // its own pull request never triggered.
    const changed = run_git(git, cfg, ["show", "--no-commit-id", "--name-only", "--format=", sha])
    if !changed.success {
      return nil
    }
    const changed_paths = split(trim(changed.stdout), "\n").filter({ path -> trim(path) != "" })
      .to_list()
    const lanes = release_drift_lane_contexts(
      unwrap(pull_request_lanes),
      changed_paths,
      release_certification_bearing_paths(changed_paths),
    )
    const commit_runs = github_commit_check_runs(harness, slug, sha)
    if is_err(commit_runs) {
      return nil
    }
    const pulls = github_commit_pull_requests(harness, slug, sha)
    if is_err(pulls) {
      return nil
    }
    const owning =
      unwrap(pulls).filter({ pr -> to_string(pr?.base?.ref ?? "") == "main" }).to_list()
    const head_sha = if len(owning) > 0 {
      lowercase(trim(to_string(owning[0]?.head?.sha ?? "")))
    } else {
      ""
    }
    const head_runs = if head_sha == "" {
      []
    } else {
      const observed = github_commit_check_runs(harness, slug, head_sha)
      if is_err(observed) {
        return nil
      }
      unwrap(observed)
    }
    commits = commits
      + [
        release_drift_commit_evidence(
          sha,
          if len(owning) > 0 {
            to_int(owning[0]?.number ?? 0)
          } else {
            0
          },
          required,
          unwrap(commit_runs),
          head_runs,
          lanes,
        ),
      ]
  }
  return release_drift_evidence(
    certified_base,
    observed_main,
    required,
    commits,
    harness.clock.date_iso(),
  )
}

/**
 * Where the release-only lanes stand on the merged main commit.
 *
 * Reads the commit's own check runs, because after the merge the tree in
 * question is a real commit on the default branch and its runs attach to it
 * directly. Rows reduce to the latest per name for the same reason they do in
 * the drift evidence: a rerun leaves a stale failure beside a fresh success.
 *
 * Every failure to read reports `not_observed`, which refuses the tag. The one
 * state this must never invent is a pass.
 */
pub fn release_main_delta_observation(
  harness: Harness,
  cfg: dict,
  receipt: ReleaseWatchReceipt,
  merge_sha: string,
) -> ReleaseMainDelta {
  const inventory = try {
    release_workflow_inventory_at_revision(
      {env: harness.env, process: harness.process},
      cfg,
      merge_sha,
    )
  }
  if is_err(inventory) {
    return release_main_delta_unobserved()
  }
  const final_inventory = unwrap(inventory)
  const lanes = final_inventory.release_only.checks
  // A complete inventory with no release-only jobs is a measured zero, not an
  // unread result. No job exists to dispatch, so this is terminal even when
  // the already-admitted tree carries bearing drift.
  if len(lanes) == 0 {
    return release_main_delta_no_release_only_lanes(merge_sha, harness.clock.date_iso())
  }
  const runs = github_commit_check_runs(harness, receipt.slug, merge_sha)
  if is_err(runs) {
    return release_main_delta_unobserved()
  }
  const latest = latest_check_per_name(unwrap(runs))
  let checks = []
  for lane in lanes {
    const state = required_check_state(latest, lane)
    checks = checks + [{name: lane, state: state, run_url: ""}]
  }
  const observed_at = harness.clock.date_iso()
  const summary = release_main_delta_check_summary(checks)
  return {
    state: summary.state,
    commit: lowercase(trim(merge_sha)),
    lanes: lanes,
    checks: checks,
    failing_check: summary.failing_check,
    observed_at: observed_at,
  }
}

/**
 * Open the pull request that reverts a bump which merged but must not ship.
 *
 * The revert is a plain `git revert` of the one-parent squash commit: one diff that
 * restores the development version and every folded changelog fragment,
 * because folding and bumping were the only things the release did.
 */
pub fn release_open_unfold_pull_request(
  harness: Harness,
  cfg: dict,
  receipt: ReleaseWatchReceipt,
  merge_sha: string,
) -> ReleaseUnfoldDecision {
  const version = trim(receipt.tag).substring(1)
  const development_version = version + "-dev"
  const existing = github_pr_list(harness, receipt.slug, {state: "open"})
  const open_number = if is_ok(existing) {
    unfold_pull_number(unwrap(existing), release_unfold_title(version))
  } else {
    0
  }
  const decision = release_unfold_decision(
    {
      tag: receipt.tag,
      version: version,
      merge_commit: lowercase(trim(merge_sha)),
      development_version: development_version,
      tag_published: false,
      open_pull_number: open_number,
    },
  )
  if decision.action != "open" {
    return decision
  }
  const git = {env: harness.env, process: harness.process}
  const prepared = run_git(git, cfg, ["fetch", "origin", "--quiet", "main"])
  if !prepared.success {
    return unfold_failed(decision, "could not fetch origin/main to build the revert")
  }
  const branched = run_git(
    git,
    cfg,
    ["checkout", "-B", decision.branch, lowercase(trim(merge_sha))],
  )
  if !branched.success {
    return unfold_failed(decision, "could not create ${decision.branch}")
  }
  const reverted = run_git(git, cfg, release_unfold_revert_args(merge_sha))
  if !reverted.success {
    return unfold_failed(decision, "could not revert ${lowercase(trim(merge_sha))}")
  }
  const pushed = run_git(git, cfg, ["push", "--force-with-lease", "origin", decision.branch])
  if !pushed.success {
    return unfold_failed(decision, "could not push ${decision.branch}")
  }
  const delta = release_main_delta_observation(harness, cfg, receipt, merge_sha)
  const created = github_pr_create(
    harness,
    {
      slug: receipt.slug,
      title: decision.title,
      head: decision.branch,
      base: "main",
      body: release_unfold_body(
        {
          tag: receipt.tag,
          version: version,
          development_version: development_version,
          merge_commit: lowercase(trim(merge_sha)),
          failing_check: delta.failing_check,
          drifted_commits: drifted_commit_names(receipt),
        },
      ),
    },
  )
  if is_err(created) {
    return unfold_failed(decision, "could not open the unfold pull request")
  }
  return decision
}

/** The already-open unfold for this version, or 0. */
fn unfold_pull_number(pulls: list?, title: string) -> int {
  for pull in pulls ?? [] {
    if trim(to_string(pull?.title ?? "")) == title {
      return to_int(pull?.number ?? 0)
    }
  }
  return 0
}

fn unfold_failed(decision: ReleaseUnfoldDecision, because: string) -> ReleaseUnfoldDecision {
  return decision
    + {
      action: "refuse",
      reason: "${because}; the bump is still on main and must be reverted by hand",
      terminal_reason: "unfold_could_not_be_opened",
    }
}

/** The drifted commits this release merged onto, named for the revert body. */
fn drifted_commit_names(receipt: ReleaseWatchReceipt) -> string {
  const commits = receipt.certification_drift.commits
  if len(commits) == 0 {
    return "none recorded"
  }
  return commits.map({ commit -> commit.sha }).join(", ")
}

fn default_release_main_tag_adapter(
  harness: Harness,
  cfg: dict,
  receipt: ReleaseWatchReceipt,
) -> ReleaseMainTagAdapter {
  return {
    pull_request: fn(_poll) {
      const viewed = github_pr_view(harness, receipt.slug, receipt.pr_url)
      if is_err(viewed) {
        throw "GitHub PR view failed: " + to_string(unwrap_err(viewed))
      }
      return unwrap(viewed)
    },
    remote_tag_target: fn(_poll) {
      const observed = release_git_remote_refs(
        harness.process,
        cfg,
        ["refs/tags/${receipt.tag}", "refs/tags/${receipt.tag}^{}"],
      )
      if !observed.success {
        throw "could not inspect immutable release tag ${receipt.tag}: ${observed.stderr}"
      }
      return remote_tag_target_sha(observed.refs)
    },
    merge: fn(pull_request) {
      const merged = github_pr_merge(
        harness,
        receipt.slug,
        pull_request.number,
        pull_request.head.sha,
        "squash",
      )
      if is_err(merged) {
        throw "could not merge the release pull request: " + to_string(unwrap_err(merged))
      }
      return unwrap(merged).merged
    },
    // Where the lanes only a release runs stand on the merged main commit.
    // Reads the commit's own check runs, reduced latest-per-name, because a
    // rerun leaves a stale failure beside a fresh success.
    main_delta: fn(merge_sha) { return release_main_delta_observation(
      harness,
      cfg,
      receipt,
      merge_sha,
    ) },
    dispatch_main_delta:
      fn(delta) { return release_main_delta_dispatch(harness, cfg, receipt, delta) },
    unfold:
      fn(merge_sha) { return release_open_unfold_pull_request(harness, cfg, receipt, merge_sha) },
    disarm: fn(pull_request, observed_main) {
      const held = github_disable_auto_merge(
        harness,
        {
          slug: receipt.slug,
          pull_number: pull_request.number,
          expected_head_oid: pull_request.head.sha,
          base_branch: "main",
          expected_base_oid: observed_main,
          restore_merge_method: "squash",
        },
      )
      return is_ok(held)
    },
    certification_trees: fn(merge_sha) {
      const candidate = lowercase(trim(receipt.publication.head_oid))
      const merged = lowercase(trim(merge_sha))
      if candidate == "" || merged == "" {
        return nil
      }
      const git = {env: harness.env, process: harness.process}
      const fetched = run_git(git, cfg, ["fetch", "origin", "--quiet", "main"])
      if !fetched.success {
        return nil
      }
      const candidate_tree = run_git(git, cfg, ["rev-parse", "--verify", "${candidate}^{tree}"])
      const merged_tree = run_git(git, cfg, ["rev-parse", "--verify", "${merged}^{tree}"])
      const merged_base = run_git(git, cfg, ["rev-parse", "--verify", "${merged}^1"])
      if !candidate_tree.success || !merged_tree.success || !merged_base.success {
        return nil
      }
      const diffed = run_git(git, cfg, ["diff", "--name-only", candidate, merged])
      if !diffed.success {
        return nil
      }
      const paths = split(trim(diffed.stdout), "\n").filter({ path -> trim(path) != "" }).to_list()
      return {
        candidate_commit: candidate,
        candidate_tree: trim(candidate_tree.stdout),
        merged_commit: merged,
        merged_base_commit: trim(merged_base.stdout),
        merged_tree: trim(merged_tree.stdout),
        drifted_paths: paths,
      }
    },
    // Where main is right now, read from the remote rather than a local
    // mirror, plus what changed since the commit this release certified and
    // whether each of those commits passed the branch's own required checks.
    merge_gate: fn(pull_request) {
      const certified_base = lowercase(trim(receipt.pin_sha))
      const observed = release_git_remote_refs(harness.process, cfg, ["refs/heads/main"])
      if !observed.success {
        return nil
      }
      const heads = observed.refs.filter({ ref -> ref.ref == "refs/heads/main" }).to_list()
      if len(heads) != 1 {
        return nil
      }
      const observed_main = lowercase(trim(heads[0].oid))
      const mergeability = github_pr_mergeability(harness, receipt.slug, pull_request.number)
      const resolved = is_ok(mergeability) && (unwrap(mergeability).resolved ?? false)
      const merge_state = if is_ok(mergeability) {
        lowercase(trim(to_string(unwrap(mergeability).mergeable_state)))
      } else {
        "unknown"
      }
      const stable = {
        certified_base: certified_base,
        observed_main: observed_main,
        mergeable_state: merge_state,
        mergeable_resolved: resolved,
        drifted_paths: [],
        path_observation: nil,
        evidence: nil,
        release_only_checks: [],
      }
      if observed_main == certified_base || certified_base == "" {
        return stable
      }
      const git = {env: harness.env, process: harness.process}
      const observed_gate = release_main_merge_gate_observe_drift_with(
        stable,
        { args -> return run_git(git, cfg, args) },
      )
      if observed_gate.path_observation?.state == "unreadable" {
        return observed_gate
      }
      const inventory = try {
        release_workflow_inventory_at_revision(
          {env: harness.env, process: harness.process},
          cfg,
          observed_main,
        )
      }
      if is_err(inventory) {
        return nil
      }
      const release_only = unwrap(inventory).release_only.checks
      const evidence = release_main_drift_evidence(
        harness,
        cfg,
        receipt.slug,
        certified_base,
        observed_main,
      )
      return observed_gate
        + {evidence: evidence, release_only_checks: release_only}
    },
    merged_main_ancestor: fn(merge_sha) {
      const fetched = run_git(
        {env: harness.env, process: harness.process},
        cfg,
        ["fetch", "origin", "--quiet", "main"],
      )
      if !fetched.success {
        return false
      }
      return run_git(
        {env: harness.env, process: harness.process},
        cfg,
        ["merge-base", "--is-ancestor", merge_sha, "origin/main"],
      ).success
    },
    push_tag: fn(merge_sha) { return ensure_release_tag_pushed_at(
      harness,
      cfg,
      receipt.tag.substring(1),
      merge_sha,
      [],
      "release-main-tag-${receipt.tag}",
      {candidate_oid: receipt.publication.head_oid},
    ) },
    now: fn(_poll) { return harness.clock.date_iso() },
    wait: fn(delay_ms) { return harness.clock.sleep_ms(delay_ms) },
  }
}

/**
 * The drift record a receipt carries, built from the observation that released
 * the merge. A gate that could not be read records nothing observed rather than
 * an empty clean-looking record.
 */
pub fn release_certification_drift_from_gate(
  gate: ReleaseMergeGateState?,
) -> ReleaseCertificationDrift {
  if gate == nil {
    return release_certification_drift_unobserved()
  }
  const evidence = gate.evidence
  if evidence == nil {
    return {
      state: "no_drift",
      certified_base: gate.certified_base,
      observed_main: gate.observed_main,
      required_contexts: [],
      commits: [],
      drifted_paths: [],
      release_only_checks: gate.release_only_checks,
      observed_at: "",
    }
  }
  return {
    state: "recorded",
    certified_base: evidence.certified_base,
    observed_main: evidence.observed_main,
    required_contexts: evidence.required_contexts,
    commits: evidence.commits.map(
      { commit ->
        {
          sha: commit.sha,
          pull_number: commit.pull_number,
          checks: commit.checks.map(
            { check ->
              {
                name: check.name,
                state: check.state,
                source: check.source,
                release_only: check.release_only,
              }
            },
          )
            .to_list(),
          green: commit.green,
          blocking_check: commit.blocking_check,
        }
      },
    )
      .to_list(),
    drifted_paths: gate.drifted_paths,
    release_only_checks: gate.release_only_checks,
    observed_at: evidence.observed_at,
  }
}

type RefreshedReleaseMergeAction = "merged" | "wait" | "refuse"

type RefreshedReleaseMergeResult = {
  action: RefreshedReleaseMergeAction,
  reason: string,
  receipt: ReleaseWatchReceipt,
  disarm_pending: bool,
}

/** Confirm stale auto-merge authority is gone before a safe refusal returns. */
fn release_auto_merge_disarmed(
  adapter: ReleaseMainTagAdapter,
  pull_request: ReleaseMainTagPullRequest?,
  observed_main: string,
) -> bool {
  if pull_request == nil || !(pull_request?.auto_merge_armed ?? false) {
    return true
  }
  return adapter.disarm(pull_request, observed_main)
}

/** Re-observe an unresolved disarm until GitHub reports no live merge authority. */
fn release_auto_merge_authority_still_held(
  adapter: ReleaseMainTagAdapter,
  pull_request: ReleaseMainTagPullRequest?,
) -> bool {
  if pull_request == nil {
    return true
  }
  if (pull_request?.merged ?? false)
    || lowercase(trim(pull_request?.github_state ?? "")) != "open"
    || !(pull_request?.auto_merge_armed ?? false) {
    return false
  }
  const gate = adapter.merge_gate(pull_request)
  const observed_main = trim(to_string(gate?.observed_main ?? ""))
  return !adapter.disarm(pull_request, observed_main)
}

fn release_disarm_monitoring_required(
  adapter: ReleaseMainTagAdapter,
  pending: bool,
  pull_request: ReleaseMainTagPullRequest?,
) -> bool {
  return pending && release_auto_merge_authority_still_held(adapter, pull_request)
}

fn next_release_poll(
  adapter: ReleaseMainTagAdapter,
  poll: int,
  options: {max_polls: int, interval_ms: int},
) -> int {
  const next = poll + 1
  if next < options.max_polls && options.interval_ms > 0 {
    adapter.wait(options.interval_ms)
  }
  return next
}

type ReleaseEarlyControlAction = "continue" | "monitor_disarm" | "stop"

type ReleaseEarlyControl = {action: ReleaseEarlyControlAction, reason: string}

/** Resolve pre-merge terminal decisions without letting stale auto-merge escape. */
fn release_early_control(
  adapter: ReleaseMainTagAdapter,
  pull_request: ReleaseMainTagPullRequest?,
  decision: ReleaseMainTagDecision,
) -> ReleaseEarlyControl {
  if decision.action == "defer" {
    const disarmed = release_auto_merge_disarmed(adapter, pull_request, decision.observed_main)
    return if disarmed {
      {action: "stop", reason: decision.reason}
    } else {
      {
        action: "monitor_disarm",
        reason: "merge admission failed, but auto-merge could not be confirmed disabled",
      }
    }
  }
  if decision.action == "abort" || decision.action == "certification_drift" {
    return {action: "stop", reason: decision.reason}
  }
  return {action: "continue", reason: ""}
}

/** Refresh, admit, record, and perform one release merge as one owned operation. */
fn run_refreshed_release_merge(
  harness: {fs: HarnessFs, random: HarnessRandom},
  adapter: ReleaseMainTagAdapter,
  receipt: ReleaseWatchReceipt,
  receipt_path: string,
  pull_request: ReleaseMainTagPullRequest?,
  poll: int,
) -> RefreshedReleaseMergeResult {
  if pull_request == nil {
    return {
      action: "refuse",
      reason: "release pull request disappeared before its merge observation",
      receipt: receipt,
      disarm_pending: false,
    }
  }
  const gate = adapter.merge_gate(pull_request)
  const refreshed = observed_release_merge_decision(gate)
  if refreshed.action != "merge" {
    const disarmed = release_auto_merge_disarmed(adapter, pull_request, refreshed.observed_main)
    return {
      action: if !disarmed {
        "wait"
      } else if refreshed.action == "defer" || refreshed.action == "abort" {
        "refuse"
      } else {
        "wait"
      },
      reason: if disarmed {
        refreshed.reason
      } else {
        "fresh merge admission failed, but auto-merge could not be confirmed disabled;"
          + " retaining the watcher until GitHub reports that merge authority gone"
      },
      receipt: receipt,
      disarm_pending: !disarmed,
    }
  }
  // Write only admitted evidence before the merge, so a merged release is
  // never one whose record says nobody looked or records a rejected head.
  const recorded = release_watch_receipt_record_certification_drift(
    receipt,
    release_certification_drift_from_gate(gate),
    adapter.now(poll),
  )
  release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, recorded)
  if !adapter.merge(pull_request) {
    return {
      action: "refuse",
      reason: "release pull request merge was refused at its observed head",
      receipt: recorded,
      disarm_pending: false,
    }
  }
  return {action: "merged", reason: refreshed.reason, receipt: recorded, disarm_pending: false}
}

/** Wait for the exact release PR to merge, then create or verify its immutable tag. */
pub fn run_release_main_tag(
  harness: Harness,
  cfg: dict,
  original_receipt: ReleaseWatchReceipt,
  receipt_path: string,
  options: {max_polls: int, interval_ms: int},
  injected_adapter: ReleaseMainTagAdapter? = nil,
) -> ReleaseMainTagResult {
  let receipt = original_receipt
  const adapter = injected_adapter ?? default_release_main_tag_adapter(harness, cfg, receipt)
  // What the last poll decided, so an exhausted loop reports the state main is
  // actually in. A release whose bump merged and whose post-merge lanes were
  // still running is not a release that "did not merge", and telling an
  // operator that sends them to cut again against a branch that refuses it.
  let last_action = ""
  let last_merge_sha = ""
  let disarm_pending = false
  let poll = 0
  while poll < options.max_polls {
    const pull_request = adapter.pull_request(poll)
    if release_disarm_monitoring_required(adapter, disarm_pending, pull_request) {
      last_action = "disarm_pending"
      poll = next_release_poll(adapter, poll, options)
      continue
    }
    disarm_pending = false
    const decision = release_main_tag_decision(
      receipt,
      pull_request,
      adapter.remote_tag_target(poll),
      adapter.certification_trees,
      adapter.merge_gate,
      adapter.main_delta,
      poll,
    )
    const early = release_early_control(adapter, pull_request, decision)
    if early.action == "stop" {
      return {
        status: 2,
        reason: early.reason,
        receipt: receipt,
        steps: [],
        polls: poll + 1,
        phase: decision.phase,
      }
    }
    if early.action == "monitor_disarm" {
      disarm_pending = true
      last_action = "disarm_pending"
      poll = next_release_poll(adapter, poll, options)
      continue
    }
    if decision.action == "unfold" {
      // The merged tree failed a lane only a release runs. No tag was minted,
      // so the whole of what shipped is a revertible commit on main, and the
      // recovery that a person wrote by hand the last time this happened is
      // opened here instead.
      const delta = decision.main_delta ?? release_main_delta_unobserved()
      const unfolded = adapter.unfold(decision.merge_sha)
      receipt = release_watch_receipt_record_main_delta(receipt, delta, adapter.now(poll))
      release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, receipt)
      return {
        status: 2,
        reason: release_main_delta_deferral_reason(
          receipt.tag,
          delta,
          drifted_commit_names(receipt),
        )
          + " ${unfolded.reason}.",
        receipt: receipt,
        steps: [],
        polls: poll + 1,
        phase: decision.phase,
      }
    }
    if decision.action == "unfold_merge_race" {
      const unfolded = adapter.unfold(decision.merge_sha)
      return {
        status: 2,
        reason: decision.reason + " ${unfolded.reason}.",
        receipt: receipt,
        steps: [],
        polls: poll + 1,
        phase: decision.phase,
      }
    }
    if decision.action == "certify_main" {
      // Start the lanes and keep polling. The tag stays unminted until they
      // report, and an unreadable report refuses rather than tags.
      if !adapter.dispatch_main_delta(decision.main_delta ?? release_main_delta_unobserved()) {
        return {
          status: 2,
          reason:
            "could not start the release-only lanes on the merged main commit ${decision.merge_sha}",
          receipt: receipt,
          steps: [],
          polls: poll + 1,
          phase: decision.phase,
        }
      }
    } else if decision.action == "merge" {
      // Refresh immediately before the irreversible act, then apply the same
      // admission policy as the first observation. Recording an unvalidated
      // refresh would let newly red same-path content become the parent lease
      // and pass the later path-containment check.
      const merged = run_refreshed_release_merge(
        {fs: harness.fs, random: harness.random},
        adapter,
        receipt,
        receipt_path,
        pull_request,
        poll,
      )
      receipt = merged.receipt
      disarm_pending = merged.disarm_pending
      if merged.action == "refuse" {
        return {
          status: 2,
          reason: merged.reason,
          receipt: receipt,
          steps: [],
          polls: poll + 1,
          phase: decision.phase,
        }
      }
    } else if decision.action == "tag" || decision.action == "reuse" {
      if !adapter.merged_main_ancestor(decision.merge_sha) {
        return {
          status: 2,
          reason: "merged release commit ${decision.merge_sha} is not reachable from origin/main",
          receipt: receipt,
          steps: [],
          polls: poll + 1,
          phase: decision.phase,
        }
      }
      const steps = if decision.action == "tag" {
        adapter.push_tag(decision.merge_sha)
      } else {
        []
      }
      if execution_failed(steps) {
        return {
          status: 2,
          reason: "release tag push failed",
          receipt: receipt,
          steps: steps,
          polls: poll + 1,
          phase: decision.phase,
        }
      }
      const terminal_receipt = if decision.action == "tag" && decision.main_delta != nil {
        release_watch_receipt_record_main_delta(receipt, decision.main_delta, adapter.now(poll))
      } else {
        receipt
      }
      const bound = release_watch_receipt_bind_main_commit(
        terminal_receipt,
        decision.merge_sha,
        adapter.now(poll),
      )
      release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, bound)
      return {
        status: 0,
        reason: decision.reason,
        receipt: bound,
        steps: steps,
        polls: poll + 1,
        phase: decision.phase,
      }
    }
    last_action = if disarm_pending {
      "disarm_pending"
    } else {
      decision.action
    }
    last_merge_sha = decision.merge_sha
    poll = poll + 1
    if poll < options.max_polls && options.interval_ms > 0 {
      adapter.wait(options.interval_ms)
    }
  }
  const exhausted = if last_action == "disarm_pending" {
    "auto-merge could not be confirmed disabled after fresh merge admission failed;"
      + " the release watcher exhausted its bounded polls while retaining that authority"
  } else if last_action == "certify_main" || last_action == "wait" {
    if trim(last_merge_sha) == "" {
      "release PR did not merge within ${to_string(options.max_polls)} polls"
    } else {
      "the release PR merged at ${last_merge_sha}, but the lanes only a release runs had not"
        + " reported within ${to_string(options.max_polls)} polls, so no tag was minted."
        + " Main carries the bumped version and this is not a fresh-cut state:"
        + " let those lanes finish and resume this receipt, or unfold the bump if they failed"
    }
  } else {
    "release PR did not merge within ${to_string(options.max_polls)} polls"
  }
  return {
    status: 3,
    reason: exhausted,
    receipt: receipt,
    steps: [],
    polls: options.max_polls,
    phase: main_tag_phase(last_merge_sha),
  }
}

/**
 * Open the unfold by hand, for a watch that died between the merge and the
 * post-merge verdict.
 *
 * The release opens this itself when the lanes fail. This entry point exists
 * because a process that is killed after the merge leaves main carrying a bump
 * that no fresh cut will follow, and the recovery must not depend on the same
 * process surviving to offer it.
 */
pub fn run_release_unfold(
  harness: Harness,
  cfg: dict,
  receipt: ReleaseWatchReceipt,
  merge_sha: string,
) -> {status: int, reason: string, steps: list<dict>} {
  const decision = release_open_unfold_pull_request(harness, cfg, receipt, merge_sha)
  const opened = decision.action == "open" || decision.action == "already_open"
  return {
    status: if opened {
      0
    } else {
      2
    },
    reason: decision.reason,
    steps: [{name: "open-release-unfold", success: opened, reason: decision.reason}],
  }
}
