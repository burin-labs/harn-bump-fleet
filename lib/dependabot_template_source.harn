import { DEPENDABOT_TEMPLATE_PATH, DEPENDABOT_TEMPLATE_SLUG } from "./fleet_projection_targets"
import { github_file_text_at_ref_result } from "./github"
import { github_path_revision_pair } from "./github_source_head"
import { GithubClientOptions, GithubConnectorResult } from "harn-github-connector/default"

/** Measured canonical templates used to preserve each consumer's suffix. */
pub type DependabotTemplateRevisions = {current: string, previous: string}

/** Resolve the prior canonical file revision, preserving an explicit recovery override. */
pub fn dependabot_template_revisions(
  harness: Harness,
  branch: string,
  previous_override: string,
  options: GithubClientOptions,
) -> GithubConnectorResult<DependabotTemplateRevisions> {
  let current_ref = branch
  let previous_ref = previous_override
  if previous_ref == "" {
    const history = github_path_revision_pair(
      harness,
      DEPENDABOT_TEMPLATE_SLUG,
      DEPENDABOT_TEMPLATE_PATH,
      branch,
      options,
    )
    if is_err(history) {
      return Err(unwrap_err(history))
    }
    current_ref = unwrap(history).current
    previous_ref = unwrap(history).previous
  }
  const current = github_file_text_at_ref_result(
    harness,
    DEPENDABOT_TEMPLATE_SLUG,
    DEPENDABOT_TEMPLATE_PATH,
    current_ref,
    options,
  )
  if is_err(current) {
    return Err(unwrap_err(current))
  }
  const previous = github_file_text_at_ref_result(
    harness,
    DEPENDABOT_TEMPLATE_SLUG,
    DEPENDABOT_TEMPLATE_PATH,
    previous_ref,
    options,
  )
  if is_err(previous) {
    return Err(unwrap_err(previous))
  }
  if trim(unwrap(current) ?? "") == "" || trim(unwrap(previous) ?? "") == "" {
    return Err(
      {
        code: "template_absent",
        category: "schema_drift",
        message: "both canonical Dependabot template revisions must be readable and nonempty",
      },
    )
  }
  return Ok({current: unwrap(current) ?? "", previous: unwrap(previous) ?? ""})
}
