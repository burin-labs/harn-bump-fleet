import { command_output_text, command_result_fail } from "std/command"
import { append_std_command_step } from "./release_commands"
import { release_harness_root } from "./release_runtime"

const REHEARSAL_ROOT = ".harn-runs/release-rehearsal"

pub type ReleaseRehearsalLeg = {id: string, description: string, env: dict, command: list<string>}

fn default_rehearsal_command(root: string) -> list<string> {
  return [
    path_join(root, ".harn", "bin", "harn"),
    "run",
    "--no-sandbox",
    path_join(root, "release_harn.harn"),
    "--",
    "--mock",
    "--agent",
    "--mode",
    "ship-pr",
    "--no-chat",
  ]
}

pub fn release_rehearsal_run_root() -> string {
  return path_join(release_harness_root(), REHEARSAL_ROOT)
}

pub fn release_rehearsal_matrix(options: dict = {}) -> list<ReleaseRehearsalLeg> {
  const root = to_string(options?.harness_root ?? release_harness_root())
  const command = options?.command ?? default_rehearsal_command(root)
  return [
    {id: "baseline", description: "clean mock release flow", env: {}, command: command},
    {
      id: "poisoned-ambient-env",
      description: "ambient HARN and egress variables that release commands must scrub",
      env: {
        HARN_BIN: "/tmp/harn-rehearsal-poison/harn",
        HARN_EGRESS_ALLOW: "file:///tmp/harn-rehearsal-poison",
        HARN_EGRESS_DENY: "*",
        HARN_RELEASE_REHEARSAL_LEG: "poisoned-ambient-env",
      },
      command: command,
    },
    {
      id: "tmpdir-pressure",
      description: "operator TMPDIR redirected to a rehearsal-owned scratch directory",
      env: {
        TMPDIR: path_join(release_rehearsal_run_root(), "tmpdir-pressure"),
        TMP: path_join(release_rehearsal_run_root(), "tmpdir-pressure"),
        TEMP: path_join(release_rehearsal_run_root(), "tmpdir-pressure"),
        HARN_RELEASE_REHEARSAL_LEG: "tmpdir-pressure",
      },
      command: command,
    },
    {
      id: "stale-manifest",
      description: "stale generated-manifest signal present before the release path runs",
      env: {
        HARN_RELEASE_REHEARSAL_STALE_MANIFEST: "1",
        HARN_RELEASE_REHEARSAL_LEG: "stale-manifest",
      },
      command: command,
    },
  ]
}

fn default_rehearsal_adapter(harness: Harness, _cfg: dict) {
  return {
    now: fn() { return date_now_iso() },
    run: fn(leg: ReleaseRehearsalLeg, _index: int, _run_dir: string) {
      const result = append_std_command_step(
        harness,
        {repo: release_harness_root(), mock: false, quiet: true},
        [],
        leg.id,
        {argv: leg.command, env: leg.env},
      )
      return result.step
    },
  }
}

fn leg_result(
  leg: ReleaseRehearsalLeg,
  step: dict,
  started_at: string,
  finished_at: string,
) -> dict {
  return {
    id: leg.id,
    description: leg.description,
    success: step.success ?? false,
    step_status: to_string(step.status ?? ""),
    exit_code: step.exit_code,
    command: leg.command,
    env_keys: keys(leg.env ?? {}).sort(),
    started_at: started_at,
    finished_at: finished_at,
    classification: step.classification ?? "",
    output: command_output_text(step),
  }
}

pub fn release_rehearsal_failures(report: dict) -> list<dict> {
  return (report?.legs ?? []).filter({ leg -> !(leg.success ?? false) }).to_list()
}

pub fn render_release_rehearsal_markdown(report: dict) -> string {
  const failures = release_rehearsal_failures(report)
  let lines = [
    "# Release rehearsal",
    "",
    "- Run: `" + to_string(report?.run_id ?? "") + "`",
    "- Generated: " + to_string(report?.generated_at ?? ""),
    "- Result: " + if len(failures) == 0 {
      "pass"
    } else {
      "fail"
    },
    "- Legs: " + to_string(len(report?.legs ?? [])),
    "- Failures: " + to_string(len(failures)),
    "",
    "## Legs",
  ]
  for leg in report?.legs ?? [] {
    const mark = if leg.success ?? false {
      "PASS"
    } else {
      "FAIL"
    }
    lines = lines
      + [
      "",
      "### " + to_string(leg.id ?? ""),
      "",
      "- Status: " + mark + " (exit " + to_string(leg.exit_code ?? 0) + ")",
      "- Env keys: " + join(leg.env_keys ?? [], ", "),
      "- Description: " + to_string(leg.description ?? ""),
    ]
    if !(leg.success ?? false) {
      lines = lines + ["- Output: " + trim(to_string(leg.output ?? ""))]
    }
  }
  return join(lines, "\n") + "\n"
}

pub fn run_release_rehearsal(harness: Harness, options: dict = {}, injected_adapter = nil) -> dict {
  const run_id = to_string(options?.run_id ?? uuid_v7())
  const run_root = to_string(options?.run_root ?? release_rehearsal_run_root())
  const run_dir = path_join(run_root, run_id)
  harness.fs.mkdir(run_dir, true)
  const matrix = options?.matrix ?? release_rehearsal_matrix(options)
  const adapter = injected_adapter ?? default_rehearsal_adapter(harness, options)
  let legs = []
  let index = 0
  for leg in matrix {
    const started = adapter.now()
    const step = try {
      adapter.run(leg, index, run_dir)
    } catch (e) {
      command_result_fail(1, to_string(e), {classification: "exception"})
    }
    const finished = adapter.now()
    legs = legs + [leg_result(leg, step, started, finished)]
    index = index + 1
  }
  const report = {
    schema: "harn-release-rehearsal/v1",
    run_id: run_id,
    generated_at: adapter.now(),
    fail_collect: true,
    run_dir: run_dir,
    legs: legs,
  }
  harness.fs.write_text(path_join(run_dir, "report.json"), json_stringify_pretty(report) + "\n")
  harness.fs.write_text(path_join(run_dir, "report.md"), render_release_rehearsal_markdown(report))
  return report
    + {
    status: if len(release_rehearsal_failures(report)) == 0 {
      0
    } else {
      2
    },
    report_json: path_join(run_dir, "report.json"),
    report_markdown: path_join(run_dir, "report.md"),
  }
}
