import { env_bool } from "std/config"
import {
  github_actions_run,
  github_actions_run_jobs,
  github_enable_auto_merge,
  github_pr_view,
  github_workflow_dispatch,
  github_workflow_runs,
} from "./github"
import { release_pr_watchdog_decision } from "./release_pr_watchdog"
import { harn_release_readiness } from "./release_readiness"
import {
  ReleaseWatchObservation,
  ReleaseWatchReceipt,
  ReleaseWatchWarmCacheJob,
  ReleaseWatchWarmCacheObservation,
  ReleaseWatchWarmCacheRun,
  release_watch_apply_warm_cache_transition,
  release_watch_receipt_write,
  release_watch_record_recovery_dispatch,
  release_watch_record_warm_cache_dispatch,
  release_watch_transition,
  release_watch_warm_cache_overlap,
  release_watch_warm_cache_transition,
} from "./release_watch_state"

const WARM_CACHE_WORKFLOW = "build-release-binaries.yml"

pub type ReleaseWatchRuntimeOptions = {
  max_polls?: int,
  interval_ms?: int,
  dispatch_recovery?: bool,
  dispatch_warm_cache?: bool,
}

type ReleaseWatchRuntimeWarmSnapshot = {
  run: ReleaseWatchWarmCacheRun?,
  jobs: list<ReleaseWatchWarmCacheJob>,
  jobs_observed: bool,
}

fn default_watch_adapter() {
  return {
    now: fn(_poll) { return date_now_iso() },
    workflow_runs: fn(slug, workflow, _poll) {
      const result = github_workflow_runs(slug, workflow, {}, 20)
      if is_err(result) {
        throw unwrap_err(result)
      }
      return result.runs
    },
    readiness: fn(tag, _poll) { return harn_release_readiness(tag) },
    dispatch: fn(slug, workflow, fields) { return github_workflow_dispatch(slug, workflow, fields) },
    warm_dispatch: fn(slug, workflow, fields, _poll) { return github_workflow_dispatch(slug, workflow, fields) },
    warm_run: fn(slug, run_id, _poll) { return github_actions_run(slug, run_id) },
    warm_jobs: fn(slug, run_id, _poll) { return github_actions_run_jobs(slug, run_id) },
    pr_probe: fn(slug, pr_url) { return github_pr_view(slug, pr_url) },
    enable_auto_merge: fn(slug, pr) { return github_enable_auto_merge(slug, pr.number, pr.head.sha, "squash") },
  }
}

fn collect_runs(adapter, receipt: ReleaseWatchReceipt, poll: int) -> list<dict> {
  let runs: list<dict> = []
  for workflow in receipt.required_workflows {
    for run in adapter.workflow_runs(receipt.slug, workflow, poll) {
      runs = runs + [{...run, workflow: workflow}]
    }
  }
  return runs
}

fn keep_release_pr_armed(adapter, receipt: ReleaseWatchReceipt) {
  if receipt.pr_url == "" {
    return {action: "skip", reason: "missing_pull_request"}
  }
  const probe = adapter.pr_probe(receipt.slug, receipt.pr_url)
  if is_err(probe) {
    return {action: "skip", reason: "pull_request_probe_failed", error: unwrap_err(probe)}
  }
  const decision = release_pr_watchdog_decision(probe)
  if decision.action != "rearm" {
    return decision
  }
  const armed = adapter.enable_auto_merge(receipt.slug, probe)
  if is_err(armed) {
    return {action: "failed", reason: "auto_merge_rearm_failed", error: unwrap_err(armed)}
  }
  return {action: "rearmed", reason: "auto_merge_rearmed"}
}

fn readiness_observation(readiness, runs, observed_at) -> ReleaseWatchObservation {
  return {
    runs: runs,
    assets_ready: readiness.ready ?? false,
    missing_assets: readiness.missing_assets ?? [],
    observed_at: observed_at,
  }
}

fn warm_cache_run(run) -> ReleaseWatchWarmCacheRun {
  return {
    workflow_run_id: run.id,
    workflow_run_url: run.url,
    source_sha: run.head_sha,
    event: run.event,
    head_branch: run.head_branch,
    status: run.status,
    conclusion: run.conclusion,
    started_at: run.run_started_at ?? run.created_at ?? "",
    completed_at: run.updated_at ?? "",
  }
}

fn observe_warm_cache(adapter, receipt: ReleaseWatchReceipt, poll: int) -> ReleaseWatchRuntimeWarmSnapshot {
  if receipt.warm_cache.state != "dispatch_accepted" && receipt.warm_cache.state != "running" {
    return {run: nil, jobs: [], jobs_observed: false}
  }
  const run_probe = adapter.warm_run(receipt.slug, receipt.warm_cache.workflow_run_id, poll)
  if is_err(run_probe) {
    return {run: nil, jobs: [], jobs_observed: false}
  }
  if run_probe.status != "completed" {
    return {run: warm_cache_run(run_probe), jobs: [], jobs_observed: false}
  }
  const jobs_probe = adapter.warm_jobs(receipt.slug, receipt.warm_cache.workflow_run_id, poll)
  if is_err(jobs_probe) {
    return {run: warm_cache_run(run_probe), jobs: [], jobs_observed: false}
  }
  const jobs: list<ReleaseWatchWarmCacheJob> = jobs_probe.jobs
    .map({ job -> return {name: job.name, status: job.status, conclusion: job.conclusion ?? ""} })
    .to_list()
  return {run: warm_cache_run(run_probe), jobs: jobs, jobs_observed: true}
}

fn terminal_result(
  receipt: ReleaseWatchReceipt,
  receipt_path: string,
  polls: int,
  watchdog,
  status: int,
) {
  return {
    status: status,
    state: receipt.state,
    receipt: receipt,
    receipt_path: receipt_path,
    polls: polls,
    watchdog: watchdog,
    warm_cache: receipt.warm_cache,
    reason: receipt.warm_cache.message,
  }
}

/**
 * Monitor release publication and continue autonomously through terminal warming.
 * Tests inject immutable snapshots and virtual timestamps; only the production
 * adapter reads the clock, GitHub, process state, or sleeps between polls.
 */
pub fn run_release_watch(
  harness: Harness,
  initial_receipt: ReleaseWatchReceipt,
  receipt_path: string,
  options: ReleaseWatchRuntimeOptions = {},
  injected_adapter = nil,
) {
  const opts = options ?? {}
  const max_polls = opts.max_polls ?? 240
  const interval_ms = opts.interval_ms ?? 30000
  const dispatch_recovery = opts.dispatch_recovery ?? true
  const dispatch_warm = opts.dispatch_warm_cache
    ?? !env_bool("HARN_RELEASE_DISABLE_POST_PUBLISH_WARM_CACHE", false)
  const adapter = injected_adapter ?? default_watch_adapter()
  let receipt = initial_receipt
  let poll = 0
  let last_watchdog: dict = {action: "skip", reason: "not_polled"}
  while poll < max_polls {
    const observed_at = adapter.now(poll)
    last_watchdog = keep_release_pr_armed(adapter, receipt)
    const runs = collect_runs(adapter, receipt, poll)
    if receipt.state != "healthy" {
      const readiness = adapter.readiness(receipt.tag, poll)
      const transition = release_watch_transition(receipt, readiness_observation(readiness, runs, observed_at))
      receipt = transition.receipt
      release_watch_receipt_write(receipt_path, receipt)
      if transition.action == "fail" {
        return {
          status: 2,
          state: receipt.state,
          receipt: receipt,
          receipt_path: receipt_path,
          polls: poll + 1,
          watchdog: last_watchdog,
          reason: receipt.message,
        }
      }
      if transition.action == "dispatch_binary_recovery" {
        if !dispatch_recovery {
          return {
            status: 2,
            state: "failed",
            receipt: receipt,
            receipt_path: receipt_path,
            polls: poll + 1,
            watchdog: last_watchdog,
            reason: "binary recovery required but dispatch is disabled",
          }
        }
        const dispatched = adapter
          .dispatch(
          receipt.slug,
          transition.recovery_workflow,
          transition.recovery_fields ?? {tag: receipt.tag},
        )
        const dispatch_ok = !is_err(dispatched)
        receipt = release_watch_record_recovery_dispatch(receipt, observed_at, dispatch_ok)
        release_watch_receipt_write(receipt_path, receipt)
        if !dispatch_ok {
          return {
            status: 2,
            state: receipt.state,
            receipt: receipt,
            receipt_path: receipt_path,
            polls: poll + 1,
            watchdog: last_watchdog,
            reason: to_string(unwrap_err(dispatched)),
          }
        }
      }
    }
    if receipt.state == "healthy" {
      const snapshot = observe_warm_cache(adapter, receipt, poll)
      const warm_observation: ReleaseWatchWarmCacheObservation = {
        observed_at: observed_at,
        release_pr_merged: last_watchdog.action == "done",
        overlap_active: release_watch_warm_cache_overlap(receipt, runs),
        run: snapshot.run,
        jobs: snapshot.jobs,
        jobs_observed: snapshot.jobs_observed,
      }
      const warm_transition = release_watch_warm_cache_transition(receipt.warm_cache, dispatch_warm, warm_observation)
      receipt = release_watch_apply_warm_cache_transition(receipt, warm_transition)
      release_watch_receipt_write(receipt_path, receipt)
      if warm_transition.action == "dispatch" {
        const dispatch = adapter
          .warm_dispatch(receipt.slug, WARM_CACHE_WORKFLOW, {warm_cache_only: true}, poll)
        const accepted = !is_err(dispatch)
        receipt = release_watch_record_warm_cache_dispatch(
          receipt,
          {
            accepted: accepted,
            observed_at: observed_at,
            workflow_run_id: if accepted {
              dispatch.run_id
            } else {
              0
            },
            workflow_run_url: if accepted {
              dispatch.url
            } else {
              ""
            },
            source_sha: if accepted {
              dispatch.head_sha
            } else {
              ""
            },
            message: if accepted {
              "warm-cache dispatch accepted as workflow run ${dispatch.run_id} at ${dispatch.head_sha}"
            } else {
              to_string(unwrap_err(dispatch))
            },
          },
        )
        release_watch_receipt_write(receipt_path, receipt)
        if !accepted {
          return terminal_result(receipt, receipt_path, poll + 1, last_watchdog, 2)
        }
      } else if warm_transition.action == "complete" {
        return terminal_result(receipt, receipt_path, poll + 1, last_watchdog, 0)
      } else if warm_transition.action == "fail" {
        return terminal_result(receipt, receipt_path, poll + 1, last_watchdog, 2)
      } else if warm_transition.action == "disabled" {
        return terminal_result(receipt, receipt_path, poll + 1, last_watchdog, 0)
      }
    }
    poll = poll + 1
    if poll < max_polls && interval_ms > 0 {
      harness.clock.sleep_ms(interval_ms)
    }
  }
  const reason = if receipt.state == "healthy" {
    "release is healthy but warm-cache state remains ${receipt.warm_cache.state} after ${poll} polls"
  } else {
    "release remains incomplete after ${poll} polls"
  }
  return {
    status: 3,
    state: receipt.state,
    receipt: receipt,
    receipt_path: receipt_path,
    polls: poll,
    warm_cache: receipt.warm_cache,
    reason: reason,
  }
}

/**
 * Deterministic command rehearsal: publish succeeds, dispatch persists, then five matrix jobs pass.
 */
pub fn mock_release_watch_adapter(receipt: ReleaseWatchReceipt) {
  const run_id = 9001
  const run_url = "https://github.com/burin-labs/harn/actions/runs/${run_id}"
  const warm_source_sha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const times = ["2026-07-13T00:00:00Z", "2026-07-13T00:01:00Z", "2026-07-13T00:02:00Z"]
  return {
    now: fn(poll) { return times[min(poll, len(times) - 1)] },
    workflow_runs: fn(_slug, workflow, _poll) { return [
      {
        id: if workflow == "publish-release.yml" {
          8001
        } else {
          8002
        },
        created_at: "2026-07-12T23:00:00Z",
        event: "push",
        head_branch: receipt.tag,
        head_sha: receipt.pin_sha,
        status: "completed",
        conclusion: "success",
        url: "https://github.com/burin-labs/harn/actions/runs/8001",
      },
    ] },
    readiness: fn(_tag, _poll) { return {ready: true, missing_assets: []} },
    dispatch: fn(_slug, _workflow, _fields) { return {
      accepted: true,
      run_id: 9001,
      url: "https://github.test/run/9001",
      event: "workflow_dispatch",
      head_branch: "main",
      head_sha: receipt.pin_sha,
    } },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) { return {
      accepted: true,
      run_id: run_id,
      url: run_url,
      head_sha: warm_source_sha,
      event: "workflow_dispatch",
      head_branch: "main",
    } },
    warm_run: fn(_slug, _run_id, poll) { return {
      id: run_id,
      url: run_url,
      head_sha: warm_source_sha,
      event: "workflow_dispatch",
      head_branch: "main",
      status: if poll < 2 {
        "in_progress"
      } else {
        "completed"
      },
      conclusion: if poll < 2 {
        ""
      } else {
        "success"
      },
      created_at: "2026-07-13T00:00:00Z",
      run_started_at: "2026-07-13T00:01:00Z",
      updated_at: if poll < 2 {
        ""
      } else {
        "2026-07-13T00:02:00Z"
      },
    } },
    warm_jobs: fn(_slug, _run_id, _poll) { return {
      jobs: [
        {name: "Build aarch64-apple-darwin", status: "completed", conclusion: "success"},
        {name: "Build aarch64-unknown-linux-gnu", status: "completed", conclusion: "success"},
        {name: "Build x86_64-apple-darwin", status: "completed", conclusion: "success"},
        {name: "Build x86_64-pc-windows-msvc", status: "completed", conclusion: "success"},
        {name: "Build x86_64-unknown-linux-gnu", status: "completed", conclusion: "success"},
      ],
    } },
    pr_probe: fn(_slug, _pr_url) { return {
      number: 1,
      merged: true,
      github_state: "merged",
      merged_at: "2026-07-12T23:59:00Z",
      merge_commit_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      in_merge_queue: false,
      auto_merge_armed: false,
      mergeable_state: "unknown",
      head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    } },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
}
