import { env_bool } from "std/config"
import {
  GithubConnectorError,
  github_actions_run,
  github_actions_run_jobs,
  github_enable_auto_merge,
  github_pr_list,
  github_pr_view,
  github_workflow_dispatch,
  github_workflow_runs,
} from "./github"
import { release_pr_watchdog_decision } from "./release_pr_watchdog"
import { harn_release_readiness, required_harn_release_assets } from "./release_readiness"
import {
  ReleaseWatchRuntimeProgress,
  ReleaseWatchRuntimeReadiness,
  release_watch_progress_for_receipt,
  release_watch_progress_with_warm_cache,
} from "./release_watch_progress"
import {
  ReleaseWatchObservation,
  ReleaseWatchReceipt,
  ReleaseWatchState,
  ReleaseWatchWarmCache,
  ReleaseWatchWarmCacheJob,
  ReleaseWatchWarmCacheObservation,
  ReleaseWatchWarmCacheRun,
  release_watch_apply_warm_cache_transition,
  release_watch_receipt_retarget_pr,
  release_watch_receipt_write,
  release_watch_record_recovery_dispatch,
  release_watch_record_warm_cache_dispatch,
  release_watch_transition,
  release_watch_warm_cache_matrix_identity,
  release_watch_warm_cache_overlap,
  release_watch_warm_cache_transition,
} from "./release_watch_state"

const WARM_CACHE_WORKFLOW = "build-release-binaries.yml"

pub type ReleaseWatchProgressSink = fn(ReleaseWatchRuntimeProgress, string, int) -> nil

pub type ReleaseWatchRuntimeOptions = {
  max_polls?: int,
  interval_ms?: int,
  dispatch_recovery?: bool,
  dispatch_warm_cache?: bool,
  keep_pr_armed?: bool,
  on_progress?: ReleaseWatchProgressSink,
}

pub type ReleaseWatchConnectorResult = dict | Result<dict, GithubConnectorError>

pub type ReleaseWatchRuntimeAdapter = {
  now: fn(int) -> string,
  workflow_runs: fn(string, string, int) -> list<dict>,
  readiness: fn(string, int) -> ReleaseWatchRuntimeReadiness,
  dispatch: fn(string, string, dict) -> ReleaseWatchConnectorResult,
  warm_dispatch: fn(string, string, dict, int) -> ReleaseWatchConnectorResult,
  warm_run: fn(string, int, int) -> ReleaseWatchConnectorResult,
  warm_jobs: fn(string, int, int) -> ReleaseWatchConnectorResult,
  pr_probe: fn(string, string) -> ReleaseWatchConnectorResult,
  replacement_prs?: fn(string, string, int) -> ReleaseWatchConnectorResult,
  enable_auto_merge: fn(string, dict) -> ReleaseWatchConnectorResult,
}

pub type ReleaseWatchRuntimeResult = {
  status: int,
  state: ReleaseWatchState,
  receipt: ReleaseWatchReceipt,
  receipt_path: string,
  polls: int,
  watchdog: dict,
  warm_cache?: ReleaseWatchWarmCache,
  reason: string,
  progress: ReleaseWatchRuntimeProgress,
}

type ReleaseWatchRuntimeWarmSnapshot = {
  run: ReleaseWatchWarmCacheRun?,
  jobs: list<ReleaseWatchWarmCacheJob>,
  jobs_observed: bool,
}

fn github_adapter_result(result) {
  return if is_err(result) {
    result
  } else {
    unwrap(result)
  }
}

fn default_watch_adapter(harness: Harness) -> ReleaseWatchRuntimeAdapter {
  return {
    now: fn(_poll) { return harness.clock.date_iso() },
    workflow_runs: fn(slug, workflow, _poll) {
      const result = github_workflow_runs(harness, slug, workflow, {}, 20)
      if is_err(result) {
        throw unwrap_err(result)
      }
      return unwrap(result).runs
    },
    readiness: fn(tag, _poll) { return harn_release_readiness(harness, tag) },
    dispatch: fn(slug, workflow, fields) { return github_adapter_result(
      github_workflow_dispatch(harness, slug, workflow, fields),
    ) },
    warm_dispatch: fn(slug, workflow, fields, _poll) { return github_adapter_result(
      github_workflow_dispatch(harness, slug, workflow, fields),
    ) },
    warm_run: fn(slug, run_id, _poll) { return github_adapter_result(
      github_actions_run(harness, slug, run_id),
    ) },
    warm_jobs: fn(slug, run_id, _poll) { return github_adapter_result(
      github_actions_run_jobs(harness, slug, run_id, "latest"),
    ) },
    pr_probe:
      fn(slug, pr_url) { return github_adapter_result(github_pr_view(harness, slug, pr_url)) },
    replacement_prs: fn(slug, _tag, _poll) {
      // Superseding a frozen release creates a new immutable attempt ref, so
      // it necessarily has a different head from the receipt. GitHub also
      // cannot head-filter a deleted source ref reliably after merge. Scan a
      // bounded active/merged history in small pages: the REST list response
      // includes PR bodies, so one 100-entry request can exceed Harn's network
      // response ceiling even though only typed identity fields are retained.
      let pull_requests: list<dict> = []
      for state in ["open", "merged"] {
        let page = 1
        while page <= 10 {
          const listed = github_pr_list(
            harness,
            slug,
            {base: "main", state: state, limit: 10, page: page},
          )
          if is_err(listed) {
            return Err(unwrap_err(listed))
          }
          const current = unwrap(listed)
          pull_requests = pull_requests + current
          if len(current) < 10 {
            break
          }
          page = page + 1
        }
      }
      return {pull_requests: pull_requests}
    },
    enable_auto_merge: fn(slug, pr) { return github_adapter_result(
      github_enable_auto_merge(harness, slug, pr.number, pr.head.sha, "squash"),
    ) },
  }
}

fn collect_runs(adapter, receipt: ReleaseWatchReceipt, poll: int) -> list<dict> {
  let runs: list<dict> = []
  for workflow in receipt.required_workflows {
    for run in adapter.workflow_runs(receipt.slug, workflow, poll) {
      runs = runs + [{...run, workflow: workflow, conclusion: run.conclusion ?? ""}]
    }
  }
  return runs
}

fn keep_release_pr_armed(adapter, receipt: ReleaseWatchReceipt) {
  if receipt.pr_url == "" {
    return {action: "skip", reason: "missing_pull_request"}
  }
  const probe = adapter.pr_probe(receipt.slug, receipt.pr_url)
  if is_err(probe) {
    return {action: "skip", reason: "pull_request_probe_failed", error: unwrap_err(probe)}
  }
  const decision = release_pr_watchdog_decision(probe)
  if decision.action != "rearm" {
    return decision
  }
  const armed = adapter.enable_auto_merge(receipt.slug, probe)
  if is_err(armed) {
    return {action: "failed", reason: "auto_merge_rearm_failed", error: unwrap_err(armed)}
  }
  return {action: "rearmed", reason: "auto_merge_rearmed"}
}

/** Select one exact-version immutable replacement without trusting connector-side filtering. */
pub fn release_watch_replacement_pr(
  receipt: ReleaseWatchReceipt,
  pull_requests: list<dict>,
) -> dict {
  const prefix = "https://github.com/${receipt.slug}/pull/"
  const expected_title = "Release ${receipt.tag}"
  const attempt_prefix = "release-attempt/${receipt.tag}/"
  let candidates: list<dict> = []
  for pull_request in pull_requests {
    const url = trim(to_string(pull_request?.url ?? ""))
    const head_ref = trim(to_string(pull_request?.head?.ref ?? ""))
    const head_sha = trim(to_string(pull_request?.head?.sha ?? ""))
    const active = (pull_request?.merged ?? false)
      || lowercase(
      trim(to_string(pull_request?.github_state ?? "")),
    )
      == "open"
    // The pre-tag certifier and the post-tag immutable attempt are two
    // write-once refs for the same candidate OID. A release-specific merge
    // override can land the certifier PR before the watcher observes the
    // attempt PR. GitHub then auto-closes the zero-diff attempt PR. Accept the
    // merged certifier only when its head is the receipt's exact candidate;
    // open or superseding replacements must retain the canonical attempt ref.
    const exact_merged_candidate = (pull_request?.merged ?? false)
      && head_sha
      == receipt.publication.head_oid
      && head_ref
      == "release-certify/${head_sha}"
    const canonical_attempt = head_ref == attempt_prefix + head_sha
    if url != receipt.pr_url
      && url.starts_with(prefix)
      && trim(to_string(pull_request?.base?.ref ?? "")) == "main"
      && trim(
      to_string(pull_request?.title ?? ""),
    )
      == expected_title
      && (canonical_attempt || exact_merged_candidate)
      && active {
      candidates = candidates + [pull_request]
    }
  }
  if len(candidates) == 0 {
    return {action: "wait", reason: "replacement_release_pr_not_found"}
  }
  if len(candidates) > 1 {
    return {
      action: "fail",
      reason: "multiple replacement release PRs match ${receipt.tag}",
      urls: candidates.map({ candidate -> candidate.url }).to_list().sorted(),
    }
  }
  return {action: "retarget", reason: "replacement_release_pr_found", pull_request: candidates[0]}
}

fn reconcile_replacement_release_pr(
  harness: {fs: HarnessFs, random: HarnessRandom},
  adapter: ReleaseWatchRuntimeAdapter,
  receipt: ReleaseWatchReceipt,
  receipt_path: string,
  watchdog: dict,
  observed_at: string,
  poll: int,
  enabled: bool,
) -> dict {
  if !enabled
    || watchdog.action != "skip"
    || watchdog.reason != "release_pr_not_open"
    || adapter.replacement_prs == nil {
    return {receipt: receipt, watchdog: watchdog}
  }
  const replacements = adapter.replacement_prs(receipt.slug, receipt.tag, poll)
  if is_err(replacements) {
    return {
      receipt: receipt,
      watchdog: {
        action: "skip",
        reason: "replacement_release_pr_probe_failed",
        error: unwrap_err(replacements),
      },
    }
  }
  const replacement = release_watch_replacement_pr(receipt, replacements?.pull_requests ?? [])
  if replacement.action == "fail" {
    throw replacement.reason
  }
  if replacement.action != "retarget" {
    return {receipt: receipt, watchdog: watchdog}
  }
  const retargeted = release_watch_receipt_retarget_pr(
    receipt,
    replacement.pull_request.url,
    observed_at,
  )
  release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, retargeted)
  return {receipt: retargeted, watchdog: keep_release_pr_armed(adapter, retargeted)}
}

fn readiness_observation(readiness, runs, observed_at) -> ReleaseWatchObservation {
  return {
    runs: runs,
    assets_ready: readiness.ready ?? false,
    missing_assets: readiness.missing_assets ?? [],
    observed_at: observed_at,
  }
}

fn progress_runs(receipt: ReleaseWatchReceipt, runs: list<dict>) -> list<dict> {
  const relevant = runs.filter(
    { run ->
      const run_id = to_int(run?.id ?? 0) ?? 0
      return trim(to_string(run?.head_branch ?? "")) == receipt.tag
        || receipt.observed_run_ids.any(
        { observed -> observed == run_id },
      )
    },
  )
    .to_list()
  if len(relevant) > 0 {
    return relevant
  }
  return runs
}

fn warm_cache_run(run) -> ReleaseWatchWarmCacheRun {
  return {
    workflow_run_id: run.id,
    workflow_run_url: run.url,
    source_sha: run.head_sha,
    event: run.event,
    head_branch: run.head_branch,
    status: run.status,
    conclusion: run.conclusion ?? "",
    started_at: run.run_started_at ?? run.created_at ?? "",
    completed_at: run.updated_at ?? "",
  }
}

type WarmCacheAdoption = {kind: "adopt", run: dict} | {kind: "wait"} | {kind: "dispatch"}

fn adoptable_warm_cache_run(
  adapter: ReleaseWatchRuntimeAdapter,
  slug: string,
  runs: list<dict>,
  poll: int,
) -> WarmCacheAdoption {
  let main_run_id = 0
  let main_sha = ""
  for run in runs {
    const run_id = to_int(run?.id ?? 0) ?? 0
    if run?.workflow == WARM_CACHE_WORKFLOW
      && lowercase(trim(to_string(run?.event ?? ""))) == "push"
      && trim(
      to_string(run?.head_branch ?? ""),
    )
      == "main"
      && run_id > main_run_id {
      main_run_id = run_id
      main_sha = lowercase(trim(to_string(run?.head_sha ?? "")))
    }
  }
  if main_sha == "" {
    return {kind: "dispatch"}
  }
  let candidate: dict? = nil
  let candidate_id = 0
  let pending = false
  for run in runs {
    const run_id = to_int(run?.id ?? 0) ?? 0
    const status = lowercase(trim(to_string(run?.status ?? "")))
    if run?.workflow != WARM_CACHE_WORKFLOW
      || trim(to_string(run?.head_branch ?? ""))
      != "main"
      || (status != "queued" && status != "in_progress") {
      continue
    }
    const same_current_source = lowercase(trim(to_string(run?.head_sha ?? ""))) == main_sha
    const dispatched = lowercase(trim(to_string(run?.event ?? ""))) == "workflow_dispatch"
    if same_current_source && dispatched {
      const jobs = adapter.warm_jobs(slug, run_id, poll)
      if is_err(jobs) {
        pending = true
        continue
      }
      const identity = release_watch_warm_cache_matrix_identity(jobs.jobs)
      if identity == "pending" {
        pending = true
      } else if identity == "exact" && run_id > candidate_id {
        candidate = run
        candidate_id = run_id
      } else {
        // The hosted workflow suppresses a warm-only matrix while *any* main
        // release-binary run is active. Mirror that policy here instead of
        // dispatching no-op workflows until the other run finishes.
        pending = true
      }
    } else {
      pending = true
    }
  }
  if candidate != nil {
    return {kind: "adopt", run: candidate}
  }
  if pending {
    return {kind: "wait"}
  }
  return {kind: "dispatch"}
}

fn observe_warm_cache(
  adapter,
  receipt: ReleaseWatchReceipt,
  poll: int,
) -> ReleaseWatchRuntimeWarmSnapshot {
  if receipt.warm_cache.state != "dispatch_accepted"
    && receipt.warm_cache.state
    != "running"
    && receipt.warm_cache.state
    != "failed" {
    return {run: nil, jobs: [], jobs_observed: false}
  }
  const run_probe = adapter.warm_run(receipt.slug, receipt.warm_cache.workflow_run_id, poll)
  if is_err(run_probe) {
    return {run: nil, jobs: [], jobs_observed: false}
  }
  const jobs_probe = adapter.warm_jobs(receipt.slug, receipt.warm_cache.workflow_run_id, poll)
  if is_err(jobs_probe) {
    return {run: warm_cache_run(run_probe), jobs: [], jobs_observed: false}
  }
  const jobs: list<ReleaseWatchWarmCacheJob> = jobs_probe.jobs.map(
    { job ->
      const active_step = job.steps?.find({ step -> step.status == "in_progress" })
      return {
        name: job.name,
        status: job.status,
        conclusion: job.conclusion ?? "",
        active_step: active_step?.name ?? "",
        started_at: job.started_at ?? "",
        completed_at: job.completed_at ?? "",
      }
    },
  )
    .to_list()
  return {run: warm_cache_run(run_probe), jobs: jobs, jobs_observed: true}
}

fn terminal_result(
  receipt: ReleaseWatchReceipt,
  receipt_path: string,
  polls: int,
  watchdog,
  status: int,
  progress: ReleaseWatchRuntimeProgress,
) -> ReleaseWatchRuntimeResult {
  return {
    status: status,
    state: receipt.state,
    receipt: receipt,
    receipt_path: receipt_path,
    polls: polls,
    watchdog: watchdog,
    warm_cache: receipt.warm_cache,
    reason: receipt.warm_cache.message,
    progress: progress,
  }
}

fn emit_progress(
  sink: ReleaseWatchProgressSink?,
  progress: ReleaseWatchRuntimeProgress,
  receipt_path: string,
  poll: int,
) {
  if sink != nil {
    sink(progress, receipt_path, poll)
  }
}

/**
 * Monitor release publication and continue autonomously through terminal warming.
 * Tests inject immutable snapshots and virtual timestamps; only the production
 * adapter reads the clock, GitHub, process state, or sleeps between polls.
 */
pub fn run_release_watch(
  harness: Harness,
  initial_receipt: ReleaseWatchReceipt,
  receipt_path: string,
  options: ReleaseWatchRuntimeOptions = {},
  injected_adapter: ReleaseWatchRuntimeAdapter? = nil,
) -> ReleaseWatchRuntimeResult {
  const opts = options ?? {}
  const max_polls = opts.max_polls ?? 240
  const interval_ms = opts.interval_ms ?? 30000
  const dispatch_recovery = opts.dispatch_recovery ?? true
  const dispatch_warm = opts.dispatch_warm_cache
    ?? !env_bool(
    harness.env,
    "HARN_EXT_RELEASE_DISABLE_POST_PUBLISH_WARM_CACHE",
    false,
  )
  const keep_pr_armed = opts.keep_pr_armed ?? true
  const on_progress = opts.on_progress
  const adapter = injected_adapter ?? default_watch_adapter(harness)
  let receipt = initial_receipt
  let poll = 0
  let last_watchdog: dict = {action: "skip", reason: "not_polled"}
  let last_progress = release_watch_progress_for_receipt(
    receipt,
    {ready: receipt.state == "healthy", asset_names: [], missing_assets: []},
    [],
    receipt.updated_at,
  )
  while poll < max_polls {
    const observed_at = adapter.now(poll)
    last_watchdog = if keep_pr_armed {
      keep_release_pr_armed(adapter, receipt)
    } else {
      {action: "skip", reason: "pull_request_watchdog_disabled"}
    }
    const reconciliation = reconcile_replacement_release_pr(
      {fs: harness.fs, random: harness.random},
      adapter,
      receipt,
      receipt_path,
      last_watchdog,
      observed_at,
      poll,
      keep_pr_armed,
    )
    receipt = reconciliation.receipt
    last_watchdog = reconciliation.watchdog
    const runs = collect_runs(adapter, receipt, poll)
    last_progress = release_watch_progress_for_receipt(
      receipt,
      {
        ready: receipt.state == "healthy",
        asset_names: last_progress.observed_assets,
        missing_assets: last_progress.missing_assets,
      },
      progress_runs(receipt, runs),
      observed_at,
    )
    if receipt.state != "healthy" {
      const readiness = adapter.readiness(receipt.tag, poll)
      const transition = release_watch_transition(
        receipt,
        readiness_observation(readiness, runs, observed_at),
      )
      receipt = transition.receipt
      last_progress = release_watch_progress_for_receipt(
        receipt,
        readiness,
        progress_runs(receipt, runs),
        observed_at,
      )
      release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, receipt)
      if transition.action == "fail" {
        return {
          status: 2,
          state: receipt.state,
          receipt: receipt,
          receipt_path: receipt_path,
          polls: poll + 1,
          watchdog: last_watchdog,
          reason: receipt.message,
          progress: last_progress,
        }
      }
      if transition.action == "dispatch_binary_recovery" {
        if !dispatch_recovery {
          return {
            status: 2,
            state: "failed",
            receipt: receipt,
            receipt_path: receipt_path,
            polls: poll + 1,
            watchdog: last_watchdog,
            reason: "binary recovery required but dispatch is disabled",
            progress: last_progress,
          }
        }
        const dispatched = adapter.dispatch(
          receipt.slug,
          transition.recovery_workflow,
          transition.recovery_fields ?? {tag: receipt.tag},
        )
        const dispatch_ok = !is_err(dispatched)
        receipt = release_watch_record_recovery_dispatch(receipt, observed_at, dispatch_ok)
        release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, receipt)
        if !dispatch_ok {
          return {
            status: 2,
            state: receipt.state,
            receipt: receipt,
            receipt_path: receipt_path,
            polls: poll + 1,
            watchdog: last_watchdog,
            reason: to_string(unwrap_err(dispatched)),
            progress: last_progress,
          }
        }
      }
    }
    if receipt.state == "healthy" {
      const snapshot = observe_warm_cache(adapter, receipt, poll)
      const warm_observation: ReleaseWatchWarmCacheObservation = {
        observed_at: observed_at,
        release_pr_merged: last_watchdog.action == "done",
        overlap_active: release_watch_warm_cache_overlap(receipt, runs),
        run: snapshot.run,
        jobs: snapshot.jobs,
        jobs_observed: snapshot.jobs_observed,
      }
      const warm_transition = release_watch_warm_cache_transition(
        receipt.warm_cache,
        dispatch_warm,
        warm_observation,
      )
      receipt = release_watch_apply_warm_cache_transition(receipt, warm_transition)
      last_progress = release_watch_progress_with_warm_cache(
        last_progress,
        receipt.warm_cache,
        snapshot.run,
        snapshot.jobs,
      )
      release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, receipt)
      if warm_transition.action == "dispatch" {
        const adoption = adoptable_warm_cache_run(adapter, receipt.slug, runs, poll)
        if adoption.kind != "wait" {
          const adopted = adoption.kind == "adopt"
          const existing = adoption.run
          const dispatch = if adopted {
            {
              run_id: to_int(existing?.id ?? 0) ?? 0,
              url: to_string(existing?.url ?? ""),
              head_sha: lowercase(trim(to_string(existing?.head_sha ?? ""))),
            }
          } else {
            adapter.warm_dispatch(receipt.slug, WARM_CACHE_WORKFLOW, {warm_cache_only: true}, poll)
          }
          const accepted = !is_err(dispatch)
          receipt = release_watch_record_warm_cache_dispatch(
            receipt,
            {
              accepted: accepted,
              observed_at: observed_at,
              workflow_run_id: if accepted {
                dispatch.run_id
              } else {
                0
              },
              workflow_run_url: if accepted {
                dispatch.url
              } else {
                ""
              },
              source_sha: if accepted {
                dispatch.head_sha
              } else {
                ""
              },
              message: if accepted {
                if adopted {
                  "adopted active warm-cache workflow run ${dispatch.run_id} at ${dispatch.head_sha}"
                } else {
                  "warm-cache dispatch accepted as workflow run ${dispatch.run_id} at ${dispatch.head_sha}"
                }
              } else {
                to_string(unwrap_err(dispatch))
              },
            },
          )
          last_progress = release_watch_progress_with_warm_cache(
            last_progress,
            receipt.warm_cache,
            snapshot.run,
            snapshot.jobs,
          )
          release_watch_receipt_write(
            {fs: harness.fs, random: harness.random},
            receipt_path,
            receipt,
          )
          if !accepted {
            emit_progress(on_progress, last_progress, receipt_path, poll + 1)
            return terminal_result(receipt, receipt_path, poll + 1, last_watchdog, 2, last_progress)
          }
        }
      } else if warm_transition.action == "complete" {
        emit_progress(on_progress, last_progress, receipt_path, poll + 1)
        return terminal_result(receipt, receipt_path, poll + 1, last_watchdog, 0, last_progress)
      } else if warm_transition.action == "fail" {
        emit_progress(on_progress, last_progress, receipt_path, poll + 1)
        return terminal_result(receipt, receipt_path, poll + 1, last_watchdog, 2, last_progress)
      } else if warm_transition.action == "disabled" {
        emit_progress(on_progress, last_progress, receipt_path, poll + 1)
        return terminal_result(receipt, receipt_path, poll + 1, last_watchdog, 0, last_progress)
      }
    }
    poll = poll + 1
    emit_progress(on_progress, last_progress, receipt_path, poll)
    if poll < max_polls && interval_ms > 0 {
      harness.clock.sleep_ms(interval_ms)
    }
  }
  const reason = if receipt.state == "healthy" {
    "release is healthy but warm-cache state remains ${receipt.warm_cache.state} after ${poll} polls"
  } else {
    "release remains incomplete after ${poll} polls"
  }
  return {
    status: 3,
    state: receipt.state,
    receipt: receipt,
    receipt_path: receipt_path,
    polls: poll,
    warm_cache: receipt.warm_cache,
    reason: reason,
    watchdog: last_watchdog,
    progress: last_progress,
  }
}

/**
 * Deterministic command rehearsal: publish succeeds, dispatch persists, then five matrix jobs pass.
 */
pub fn mock_release_watch_adapter(receipt: ReleaseWatchReceipt) -> ReleaseWatchRuntimeAdapter {
  const run_id = 9001
  const run_url = "https://github.com/burin-labs/harn/actions/runs/${run_id}"
  const warm_source_sha = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const times = ["2026-07-13T00:00:00Z", "2026-07-13T00:01:00Z", "2026-07-13T00:02:00Z"]
  return {
    now: fn(poll) { return times[min(poll, len(times) - 1)] ?? "" },
    workflow_runs: fn(_slug, workflow, _poll) { return [
      {
        id: if workflow == "publish-release.yml" {
          8001
        } else {
          8002
        },
        created_at: "2026-07-12T23:00:00Z",
        event: "push",
        head_branch: receipt.tag,
        head_sha: receipt.pin_sha,
        status: "completed",
        conclusion: "success",
        url: "https://github.com/burin-labs/harn/actions/runs/8001",
      },
    ] },
    readiness: fn(_tag, _poll) {
      const assets = required_harn_release_assets()
      return {ready: true, asset_names: assets, missing_assets: []}
    },
    dispatch: fn(_slug, _workflow, _fields) { return {
      accepted: true,
      run_id: 9001,
      url: "https://github.test/run/9001",
      event: "workflow_dispatch",
      head_branch: "main",
      head_sha: receipt.pin_sha,
    } },
    warm_dispatch: fn(_slug, _workflow, _fields, _poll) { return {
      accepted: true,
      run_id: run_id,
      url: run_url,
      head_sha: warm_source_sha,
      event: "workflow_dispatch",
      head_branch: "main",
    } },
    warm_run: fn(_slug, _run_id, poll) { return {
      id: run_id,
      url: run_url,
      head_sha: warm_source_sha,
      event: "workflow_dispatch",
      head_branch: "main",
      status: if poll < 2 {
        "in_progress"
      } else {
        "completed"
      },
      conclusion: if poll < 2 {
        ""
      } else {
        "success"
      },
      created_at: "2026-07-13T00:00:00Z",
      run_started_at: "2026-07-13T00:01:00Z",
      updated_at: if poll < 2 {
        ""
      } else {
        "2026-07-13T00:02:00Z"
      },
    } },
    warm_jobs: fn(_slug, _run_id, _poll) { return {
      jobs: [
        {name: "Build aarch64-apple-darwin", status: "completed", conclusion: "success"},
        {name: "Build aarch64-unknown-linux-gnu", status: "completed", conclusion: "success"},
        {name: "Build x86_64-apple-darwin", status: "completed", conclusion: "success"},
        {name: "Build x86_64-pc-windows-msvc", status: "completed", conclusion: "success"},
        {name: "Build x86_64-unknown-linux-gnu", status: "completed", conclusion: "success"},
      ],
    } },
    pr_probe: fn(_slug, _pr_url) { return {
      number: 1,
      merged: true,
      github_state: "merged",
      merged_at: "2026-07-12T23:59:00Z",
      merge_commit_oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      in_merge_queue: false,
      auto_merge_armed: false,
      mergeable_state: "unknown",
      head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    } },
    enable_auto_merge: fn(_slug, _pr) { return {state: "enabled"} },
  }
}
