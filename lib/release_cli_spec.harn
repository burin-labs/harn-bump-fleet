import { ParserSpec } from "std/cli/argparse"
import { BumpKind } from "std/semver"
import { cli_options } from "./cli_options"

/**
 * The release harness command line, as one table.
 *
 * It lives apart from the runtime because it is a flat declaration that grows
 * with every option and has no behavior, and the runtime module it grew inside
 * has a 1,500-line ceiling that the table alone would keep pushing it past.
 * `parse_release_args` in `release_runtime` remains the only reader.
 */
const RELEASE_DEFAULT_REPO = ""

const RELEASE_DEFAULT_BASE = ""

pub type ReleaseCliOptions = {
  repo: string,
  base: string,
  bump: BumpKind,
  preid: string,
  mode: "audit" | "prepare" | "ship-pr",
  agent: bool,
  model: string,
  provider: string,
  mock: bool,
  help: bool,
  bootstrap_new_crates: bool,
  release_focus: string,
  yes_live_release: bool,
  pin_sha_input: string,
  allow_base_drift: bool,
  github_signed_commit: bool,
  expect_pr: list<string>,
  reject_pr: list<string>,
  queue_critical_pr: list<string>,
  queue_live_pr: list<string>,
  queue_noncritical_live_pr: list<string>,
  local_audit: bool,
  resume_tagged_release: bool,
  self_update: bool,
  wait_build_lock: bool,
  no_chat: bool,
  chat_only: bool,
  chat_run: string,
  chat_timeout_s: int,
  consumer_proof_runs_json: string,
}

pub const RELEASE_ARG_SPEC: ParserSpec = {
  name: "release-harn",
  args: [
    {kind: "flag", name: "repo", long: "--repo", default: RELEASE_DEFAULT_REPO},
    {kind: "flag", name: "base", long: "--base", default: RELEASE_DEFAULT_BASE},
    {kind: "flag", name: "bump", long: "--bump", default: "patch"},
    {kind: "flag", name: "preid", long: "--preid", default: ""},
    {kind: "flag", name: "mode", long: "--mode", default: "audit"},
    {kind: "switch", name: "agent", long: "--agent"},
    {kind: "flag", name: "model", long: "--model", default: ""},
    {kind: "flag", name: "provider", long: "--provider", default: ""},
    {kind: "switch", name: "mock", long: "--mock"},
    {kind: "switch", name: "help", short: "-h", long: "--help"},
    {kind: "switch", name: "bootstrap_new_crates", long: "--bootstrap-new-crates"},
    {kind: "flag", name: "release_focus", long: "--focus", default: ""},
    {kind: "switch", name: "yes_live_release", long: "--yes-live-release"},
    {kind: "flag", name: "pin_sha_input", long: "--at-sha", default: ""},
    {kind: "switch", name: "allow_base_drift", long: "--allow-base-drift"},
    {kind: "switch", name: "github_signed_commit", long: "--github-signed-commit"},
    {kind: "flag", name: "expect_pr", long: "--expect-pr", multi: true, default: []},
    {kind: "flag", name: "reject_pr", long: "--reject-pr", multi: true, default: []},
    {
      kind: "flag",
      name: "queue_critical_pr",
      long: "--queue-critical-pr",
      multi: true,
      default: [],
    },
    {kind: "flag", name: "queue_live_pr", long: "--queue-live-pr", multi: true, default: []},
    {
      kind: "flag",
      name: "queue_noncritical_live_pr",
      long: "--queue-noncritical-live-pr",
      multi: true,
      default: [],
    },
    {kind: "switch", name: "local_audit", long: "--local-audit"},
    {kind: "switch", name: "resume_tagged_release", long: "--resume-tagged-release"},
    {kind: "switch", name: "self_update", long: "--self-update"},
    {kind: "switch", name: "wait_build_lock", long: "--wait"},
    {kind: "switch", name: "no_chat", long: "--no-chat"},
    {kind: "switch", name: "chat_only", long: "--chat-only"},
    {kind: "flag", name: "chat_run", long: "--chat-run", default: ""},
    {kind: "flag", name: "chat_timeout_s", long: "--chat-timeout-s", parse: "int", default: 60},
    {
      kind: "flag",
      name: "consumer_proof_runs_json",
      long: "--consumer-proof-runs-json",
      default: "",
    },
  ],
}

/**
 * Decode argv against the table above.
 *
 * `schema_of` resolves the type at run time, not at check time, so it has to
 * be called in the module that declares `ReleaseCliOptions`. Calling it on the
 * imported name passes `harn check` and then dies on the first real parse with
 * an undefined variable.
 */
pub fn parse_release_cli_options(args: list<string>) -> ReleaseCliOptions {
  return cli_options<ReleaseCliOptions>(RELEASE_ARG_SPEC, args, schema_of(ReleaseCliOptions))
}
