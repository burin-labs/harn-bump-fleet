import { timing_duration_label, user_timing_spans } from "./timing_report"

/**
 * The release timeline, as one registry rather than as whatever happened to
 * emit a span.
 *
 * A "slowest N" view cannot answer whether a stage ran. A stage that emitted
 * nothing, a stage that finished under the display threshold, and a stage that
 * never started all look the same in it: absent. This registry enumerates the
 * stages the release actually has, so a stage with no number is reported as
 * unmeasured instead of quietly leaving the table.
 *
 * The sibling rehearsal is deliberately absent. It is a workflow job the
 * harness never waits on, so the harness has no honest duration for it, and a
 * row that can never be measured would keep this report permanently incomplete
 * and train a reader to ignore the pending count. Its elapsed time lives in the
 * workflow run's own timestamps until the harness waits on it.
 *
 * Every row resolves from one named span. Matching a shell step by the `step`
 * attribute of the shared `release.command` span was tried and does not work:
 * that attribute does not survive to the observation surface, so a stage keyed
 * on it reads unmeasured forever. Each stage therefore opens its own span.
 */
pub type ReleaseTimelineStage = {stage: string, label: string, key: string}

pub const RELEASE_TIMELINE_STAGES: list<ReleaseTimelineStage> = [
  {stage: "pre_release_gate", label: "pre-release gate", key: "release.pre_release_gate"},
  {
    stage: "consumer_pretag_gate",
    label: "consumer pre-tag gates",
    key: "release.consumer_pretag_gate",
  },
  {
    stage: "candidate_archive_gate",
    label: "candidate archive gate",
    key: "release.candidate_archive_gate",
  },
  {stage: "resume_precheck", label: "resume precheck", key: "release.resume_precheck"},
  {stage: "pin_tree", label: "warm the exact-pin CLI", key: "release.pin_tree"},
  {
    stage: "harn_linked_suite",
    label: "hosted platform certification",
    key: "release.harn_linked_suite",
  },
]

pub type ReleaseStageTiming = {
  stage: string,
  label: string,
  key: string,
  measured: bool,
  duration_ms: int,
  count: int,
  error_count: int,
}

pub type ReleaseStageTimingReport = {
  schema_version: "release_harn.stage_timings.v1",
  rows: list<ReleaseStageTiming>,
  unmeasured: list<string>,
  complete: bool,
  measured_count: int,
  declared_count: int,
  total_duration_ms: int,
}

fn accumulate(row: ReleaseStageTiming, duration_ms: int, status: string) -> ReleaseStageTiming {
  return {
    stage: row.stage,
    label: row.label,
    key: row.key,
    measured: true,
    duration_ms: row.duration_ms + duration_ms,
    count: row.count + 1,
    error_count: row.error_count
      + if status == "error" {
        1
      } else {
        0
      },
  }
}

/**
 * One row per declared stage, measured or not.
 *
 * `spans` is the run's completed user-timing spans. Passing an empty list is a
 * legitimate answer only for a run that reached no stage at all, and the report
 * says so rather than reporting a complete timeline of zero rows.
 */
pub fn release_stage_timing_report(spans: list<TimingSpanRecord>) -> ReleaseStageTimingReport {
  let rows: list<ReleaseStageTiming> = []
  let unmeasured: list<string> = []
  let measured_count = 0
  let total_duration_ms = 0
  for stage in RELEASE_TIMELINE_STAGES {
    let row: ReleaseStageTiming = {
      stage: stage.stage,
      label: stage.label,
      key: stage.key,
      measured: false,
      duration_ms: 0,
      count: 0,
      error_count: 0,
    }
    for span in spans {
      if (span.name ?? "") == stage.key {
        row = accumulate(row, to_int(span.duration_ms ?? 0) ?? 0, to_string(span.status ?? ""))
      }
    }
    if row.measured {
      measured_count = measured_count + 1
      total_duration_ms = total_duration_ms + row.duration_ms
    } else {
      unmeasured = unmeasured + [stage.stage]
    }
    rows = rows + [row]
  }
  return {
    schema_version: "release_harn.stage_timings.v1",
    rows: rows,
    unmeasured: unmeasured,
    complete: len(unmeasured) == 0,
    measured_count: measured_count,
    declared_count: len(RELEASE_TIMELINE_STAGES),
    total_duration_ms: total_duration_ms,
  }
}

/** Read the stage timings straight off the harness observation surface. */
pub fn release_stage_timings(obs: HarnessObs) -> ReleaseStageTimingReport {
  return release_stage_timing_report(user_timing_spans(obs))
}

/** Operator lines: every stage, and the pending count, never a filtered top N. */
pub fn release_stage_timing_lines(report: ReleaseStageTimingReport) -> list<string> {
  let lines: list<string> = []
  for row in report.rows {
    if !row.measured {
      lines = lines + ["${row.label}: unmeasured"]
      continue
    }
    let line = "${row.label}: ${timing_duration_label(row.duration_ms)}"
    if row.count > 1 {
      line = line + " across ${to_string(row.count)} spans"
    }
    if row.error_count > 0 {
      line = line + ", errors ${to_string(row.error_count)}"
    }
    lines = lines + [line]
  }
  if !report.complete {
    lines = lines
      + [
        "${to_string(len(report.unmeasured))} of ${to_string(report.declared_count)} stages emitted no duration: "
          + join(report.unmeasured, ", "),
      ]
  }
  return lines
}

/** The same table for the written report, so the receipt and the console agree. */
pub fn release_stage_timing_markdown(report: ReleaseStageTimingReport) -> list<string> {
  let lines = [
    "## Stage timings",
    "",
    "| stage | elapsed | spans | errors |",
    "| --- | --- | --- | --- |",
  ]
  for row in report.rows {
    const elapsed = if row.measured {
      timing_duration_label(row.duration_ms)
    } else {
      "unmeasured"
    }
    lines = lines
      + ["| ${row.label} | ${elapsed} | ${to_string(row.count)} | ${to_string(row.error_count)} |"]
  }
  lines = lines + [""]
  lines = lines
    + [
      if report.complete {
        "All ${to_string(report.declared_count)} declared stages reported a duration."
      } else {
        "${to_string(len(report.unmeasured))} of ${to_string(report.declared_count)} declared stages reported no duration: "
          + join(report.unmeasured, ", ")
          + "."
      },
    ]
  return lines + [""]
}
