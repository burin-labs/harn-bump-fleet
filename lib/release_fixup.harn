import { GitRemoteRef, git_merge_base } from "std/git"
import {
  ReleasePublication,
  ReleasePullRequestIdentity,
  release_attempt_for_version,
  release_publications_from_remote_refs,
} from "./release_publication"
import { RegistryVersionProbe } from "./release_readiness"
import { ReleaseAnalysis } from "release_analysis"
import { ReleaseConfig, ReleaseNotesScope, ReleaseRepoConfig, run_git } from "release_runtime"

pub type ReleaseFixupState = {
  publication: ReleasePublication,
  tag: string,
  pr_url: string,
  original_pin: string,
  pin_unreleased: string,
  release_body_source: string,
  tag_exists: bool,
  release_exists: bool,
  missing_assets: list<string>,
  conflicting: bool,
  pre_tag_resume: bool,
  pre_tag_supersede?: bool,
  tooling_drift?: ReleaseCheckpointToolingDrift,
  tooling_integrity?: ReleaseCheckpointToolingIntegrity,
  tagged_fixup_pr?: ReleasePullRequestIdentity?,
}

pub type ReleaseRecoveryPinDecision = {compatible: bool, effective_pin: string}

pub type ReleaseRecoveryCheckpointRoute = "repair" | "resume_pre_tag" | "supersede_pre_tag"

pub type ReleaseRecoveryCandidate = {publication: ReleasePublication, pin_oid: string}

pub type ReleaseRecoveryPreference = {
  attempt_oid: string,
  pin_oid: string,
  mode: "explicit_pin" | "newest_base_ancestor",
  reason: string,
}

pub type ReleaseRecoveryAncestry = fn(string, string) -> bool

pub type RegistryImmutabilityAction = "allow" | "refuse" | "recover_published"

/** Fail-closed gate once crates.io already owns the release version. */
pub type RegistryImmutabilityDecision = {
  action: RegistryImmutabilityAction,
  message: string,
  source_oid: string,
}

/**
 * Decide whether a live run may mint a fresh/superseded candidate or must
 * recover the registry-published source. GitHub tag/PR/asset absence never
 * authorizes a re-cut once the registry has accepted the version.
 */
pub fn registry_immutability_decision(
  probe: RegistryVersionProbe,
  pin_sha_input: string,
  pin_sha: string,
  recovered_head_oid: string,
  would_supersede: bool,
) -> RegistryImmutabilityDecision {
  if probe.identity_state == "unpublished" {
    return {action: "allow", message: "", source_oid: ""}
  }
  if probe.identity_state == "unknown" {
    return {
      action: "refuse",
      message:
        "refusing to prepare v${probe.version}: crates.io visibility for the release version is unknown; retry when the registry probe succeeds",
      source_oid: "",
    }
  }
  if probe.identity_state == "missing_vcs" {
    return {
      action: "refuse",
      message:
        "refusing to prepare v${probe.version}: crates.io already has this version, but the packaged `.cargo_vcs_info.json` source identity could not be recovered; restore the published tag/attempt from registry evidence rather than rebuilding",
      source_oid: "",
    }
  }
  if probe.identity_state == "conflict" {
    return {
      action: "refuse",
      message: "refusing to prepare v${probe.version}: crates.io crate archives disagree on the packaged git SHA ("
        + join(probe.crates, ", ")
        + "); refuse to choose a source",
      source_oid: "",
    }
  }
  const source_oid = lowercase(trim(probe.source_oid))
  const recovered = lowercase(trim(recovered_head_oid))
  const requested = lowercase(trim(pin_sha))
  if recovered == "" {
    // Fresh-cut path: an explicit pin that is not the packaged source is the
    // recut hazard from #723. Matching the packaged OID still cannot authorize
    // a rebuild — GitHub refs must be restored to that OID first.
    if trim(pin_sha_input) != "" && requested != source_oid {
      return {
        action: "refuse",
        message:
          "refusing to prepare v${probe.version}: crates.io already published this version from ${source_oid}, which disagrees with requested --at-sha ${requested}; recover the original immutable source, never rebuild",
        source_oid: source_oid,
      }
    }
    return {
      action: "refuse",
      message: "refusing to prepare a fresh v${probe.version} candidate: crates.io already has this version from ${source_oid} ("
        + join(probe.crates, ", ")
        + "); the version is immutable and must be recovered (restore tag/attempt to that OID), never rebuilt",
      source_oid: source_oid,
    }
  }
  if recovered != source_oid {
    return {
      action: "refuse",
      message:
        "refusing to recover v${probe.version} from ${recovered}: crates.io packaged ${source_oid}; restore the tag/attempt to the registry source before continuing",
      source_oid: source_oid,
    }
  }
  if would_supersede {
    return {
      action: "refuse",
      message:
        "refusing to supersede v${probe.version}: crates.io already published this version from ${source_oid}; recover that immutable source instead of minting a new candidate",
      source_oid: source_oid,
    }
  }
  return {
    action: "recover_published",
    message:
      "crates.io already published v${probe.version} from ${source_oid}; routing to post-publish recovery of that immutable source",
    source_oid: source_oid,
  }
}

/** Prefer the registry-packaged attempt OID when crates.io already owns the version. */
pub fn registry_preferred_attempt_oid(
  probe: RegistryVersionProbe,
  recovery_preference_oid: string,
) -> string {
  if probe.identity_state == "matched" && trim(probe.source_oid) != "" {
    return probe.source_oid
  }
  return trim(recovery_preference_oid)
}

/** Throw when the registry forbids the planned route; otherwise return the decision. */
pub fn require_registry_immutability_gate(
  probe: RegistryVersionProbe,
  pin_sha_input: string,
  pin_sha: string,
  recovered_head_oid: string,
  would_supersede: bool,
) -> RegistryImmutabilityDecision {
  const decision = registry_immutability_decision(
    probe,
    pin_sha_input,
    pin_sha,
    recovered_head_oid,
    would_supersede,
  )
  if decision.action == "refuse" {
    throw decision.message
  }
  return decision
}

/**
 * Registry publication demotes a pre-tag resume into post-publish paperwork so
 * the run cannot certify and re-tag a version crates.io already accepted.
 */
pub fn registry_adjusted_checkpoint_flags(
  checkpoint_route: ReleaseRecoveryCheckpointRoute,
  registry_gate: RegistryImmutabilityDecision,
) -> {pre_tag_resume: bool, pre_tag_supersede: bool} {
  return {
    pre_tag_resume: checkpoint_route == "resume_pre_tag"
      && registry_gate.action != "recover_published",
    pre_tag_supersede: checkpoint_route == "supersede_pre_tag",
  }
}

/** Select which source tree owns the recovered release notes. */
pub fn release_recovery_notes_scope(tag_exists: bool) -> ReleaseNotesScope {
  return tag_exists ? "frozen_artifact" : "candidate_tree"
}

pub fn release_recovery_is_pre_tag_resume(tag_exists: bool, pr_url: string) -> bool {
  return !tag_exists && trim(pr_url) == ""
}

pub fn release_target_version_with_fixup(
  analyzed_next_version: string,
  fixup: ReleaseFixupState?,
) -> string {
  if fixup != nil && fixup.pre_tag_resume {
    return fixup.publication.version
  }
  return analyzed_next_version
}

/**
 * An operator-supplied pin remains authoritative during recovery. Automatic
 * releases may resume the checkpoint's frozen source; an explicit release
 * may resume only when that source is the requested commit.
 */
pub fn release_recovery_pin_decision(
  pin_sha_input: string,
  pin_sha: string,
  recovered_pin: string,
) -> ReleaseRecoveryPinDecision {
  if trim(pin_sha_input) != "" {
    return {
      compatible: lowercase(trim(pin_sha)) == lowercase(trim(recovered_pin)),
      effective_pin: pin_sha,
    }
  }
  return {compatible: true, effective_pin: recovered_pin}
}

/**
 * Paths whose content decides whether a candidate passes the release gate.
 * A resumed checkpoint validates with the copy frozen in its own tree, so a
 * fix that lands on `base` under one of these paths cannot reach it — the
 * checkpoint must be superseded onto a newer pin instead of resumed.
 */
pub const RELEASE_GATE_TOOLING_PATHS: list<string> = [
  "scripts/release_gate.sh",
  "scripts/release_audit_contract.harn",
  "scripts/release_ship.sh",
]

pub type ReleaseCheckpointToolingDrift = {stale: bool, paths: list<string>, supersede_pin: string}

/**
 * Compare a checkpoint's frozen tooling against `base`. `changed_paths` are
 * the repo-relative paths that differ between the recovered pin and
 * `base` HEAD; `base_head` is the commit an operator would supersede onto.
 */
pub fn release_checkpoint_tooling_drift(
  changed_paths: list<string>,
  base_head: string,
) -> ReleaseCheckpointToolingDrift {
  let stale_paths: list<string> = []
  for path in RELEASE_GATE_TOOLING_PATHS {
    if changed_paths.any({ changed -> trim(changed) == path }) {
      stale_paths = stale_paths + [path]
    }
  }
  return {stale: len(stale_paths) > 0, paths: stale_paths, supersede_pin: trim(base_head)}
}

/**
 * The operator-facing escape. Returns nil when the checkpoint's tooling still
 * matches `base`, so a healthy resume prints nothing extra.
 *
 * The advisory states what superseding costs, because taking the advised route
 * is what invalidates the advice. Superseding mints a second immutable attempt;
 * if that run then fails for any unrelated reason, the version holds two
 * attempts and the same command form fails with `selected 0 immutable
 * attempts`. Both messages are correct for their own state, and the second one
 * surfaces at the *next* recovery, so the connection to the first is not
 * obvious. Naming the cost here is the only place it can be cheap.
 */
pub fn release_checkpoint_supersede_advisory(drift: ReleaseCheckpointToolingDrift) -> string? {
  if !drift.stale || drift.supersede_pin == "" {
    return nil
  }
  return "this checkpoint validates with its own frozen copy of "
    + join(drift.paths, ", ")
    + ", which ${drift.supersede_pin} has since changed — resuming re-runs the same gate code and will fail the same way; supersede onto the newer pin with --at-sha ${drift.supersede_pin} (the immutable attempt ref is preserved, not deleted)"
    + "; superseding mints a second immutable attempt, so if the superseding run also fails the version then holds two and needs abandon_release_attempts.harn before another fresh cut"
}

/**
 * Whether the tooling the resume will actually execute is byte-identical to
 * the tooling this candidate was certified against.
 *
 * `verified` names the paths proven identical, `tampered` the paths whose
 * bytes moved between the frozen pin and the attempt the resume checks out,
 * and `unproven` the paths neither side could be read for. `unproven` exists
 * so an unreadable tree cannot be mistaken for a clean one: an empty read of
 * both sides yields every declared path pending, never `intact`.
 */
pub type ReleaseCheckpointToolingIntegrity = {
  intact: bool,
  pin: string,
  attempt: string,
  verified: list<string>,
  tampered: list<string>,
  unproven: list<string>,
}

/**
 * Decide integrity from two blob censuses over `RELEASE_GATE_TOOLING_PATHS`.
 *
 * `frozen` maps a declared path to its blob OID at the certified pin;
 * `attempt` maps the same path to its blob OID in the immutable attempt the
 * resume will run. A path missing from either census is pending, not clean.
 */
pub fn release_checkpoint_tooling_integrity(
  frozen: dict<string, string>,
  attempt: dict<string, string>,
  pin: string,
  attempt_oid: string,
) -> ReleaseCheckpointToolingIntegrity {
  let verified: list<string> = []
  let tampered: list<string> = []
  let unproven: list<string> = []
  for path in RELEASE_GATE_TOOLING_PATHS {
    const frozen_oid = lowercase(trim(to_string(frozen[path] ?? "")))
    const attempt_blob = lowercase(trim(to_string(attempt[path] ?? "")))
    if frozen_oid == "" || attempt_blob == "" {
      unproven = unproven + [path]
    } else if frozen_oid != attempt_blob {
      tampered = tampered + [path]
    } else {
      verified = verified + [path]
    }
  }
  return {
    intact: len(tampered) == 0 && len(unproven) == 0,
    pin: trim(pin),
    attempt: trim(attempt_oid),
    verified: verified,
    tampered: tampered,
    unproven: unproven,
  }
}

/**
 * Refuse a resume whose frozen gate tooling is not the tooling that was
 * certified.
 *
 * This is the only tooling condition that refuses a tag. A change landing on
 * `base` under one of these paths is reported by
 * `release_checkpoint_supersede_advisory` and left to the operator: the
 * checkpoint executes its own frozen copy, so what `base` now holds cannot
 * change this run's outcome either way. Refusing on that comparison cost the
 * v0.10.131 release its tag over a function rename and two log strings in
 * `scripts/release_ship.sh` that the frozen gate never reaches.
 *
 * The refusal names the failing paths and the pending count, so an unreadable
 * tree reads as unproven rather than as agreement.
 */
pub fn release_checkpoint_resume_block(integrity: ReleaseCheckpointToolingIntegrity) -> string? {
  if integrity.intact {
    return nil
  }
  let reasons: list<string> = []
  if len(integrity.tampered) > 0 {
    reasons = reasons
      + ["${len(integrity.tampered)} changed since the pin (${join(integrity.tampered, ", ")})"]
  }
  if len(integrity.unproven) > 0 {
    reasons = reasons
      + ["${len(integrity.unproven)} unreadable (${join(integrity.unproven, ", ")})"]
  }
  return "refusing to resume a pre-tag checkpoint whose frozen gate tooling is not the certified tooling: "
    + join(reasons, "; ")
    + "; verified ${len(integrity.verified)} of ${len(RELEASE_GATE_TOOLING_PATHS)} declared paths"
    + " between pin ${integrity.pin} and attempt ${integrity.attempt}"
    + "; the attempt ref is preserved — cut fresh with abandon_release_attempts.harn rather than resuming tooling nobody certified"
}

/**
 * A resumed checkpoint runs the release gate from its own frozen tree, so a
 * gate fix landing on `base` after this pin can never reach it — resuming
 * re-runs the broken copy forever. Report that drift so the supersede escape
 * is printed instead of left to source archaeology. Only a still-resumable
 * checkpoint can be diverted; anything else reports no drift.
 */
pub fn recovered_checkpoint_tooling_drift(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseConfig,
  original_pin: string,
  resumable: bool,
) -> ReleaseCheckpointToolingDrift {
  const none = release_checkpoint_tooling_drift([], "")
  if !resumable {
    return none
  }
  const base_head = run_git(harness, cfg, ["rev-parse", "origin/" + cfg.base])
  const changed = run_git(harness, cfg, ["diff", "--name-only", original_pin, "origin/" + cfg.base])
  if !base_head.success || !changed.success {
    return none
  }
  return release_checkpoint_tooling_drift(
    split(trim(changed.stdout ?? ""), "\n"),
    trim(base_head.stdout ?? ""),
  )
}

fn gate_tooling_blob_census(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseRepoConfig,
  commit: string,
) -> dict<string, string> {
  let census: dict<string, string> = {}
  if trim(commit) == "" {
    return census
  }
  for path in RELEASE_GATE_TOOLING_PATHS {
    const shown = run_git(harness, cfg, ["rev-parse", "${trim(commit)}:${path}"])
    if shown.success {
      const oid = lowercase(trim(shown.stdout ?? ""))
      if len(regex_captures("^[0-9a-f]{40}$", oid)) == 1 {
        census[path] = oid
      }
    }
  }
  return census
}

/**
 * Prove the resume will execute the tooling this candidate was certified with.
 *
 * The frozen side is the recovered pin; the executed side is the immutable
 * attempt the resume checks out. Both are read as git blob OIDs, so the answer
 * does not depend on a working tree that may not be checked out yet. A
 * non-resumable checkpoint reports every path unproven rather than intact,
 * because nothing was measured.
 */
pub fn recovered_checkpoint_tooling_integrity(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseRepoConfig,
  original_pin: string,
  attempt_oid: string,
  resumable: bool,
) -> ReleaseCheckpointToolingIntegrity {
  if !resumable {
    return release_checkpoint_tooling_integrity({}, {}, original_pin, attempt_oid)
  }
  return release_checkpoint_tooling_integrity(
    gate_tooling_blob_census(harness, cfg, original_pin),
    gate_tooling_blob_census(harness, cfg, attempt_oid),
    original_pin,
    attempt_oid,
  )
}

/** Route one recovered publication without deleting its immutable audit ref. */
pub fn release_recovery_checkpoint_route(
  pre_tag_checkpoint: bool,
  pin_decision: ReleaseRecoveryPinDecision,
) -> ReleaseRecoveryCheckpointRoute {
  if !pre_tag_checkpoint {
    return "repair"
  }
  if pin_decision.compatible {
    return "resume_pre_tag"
  }
  return "supersede_pre_tag"
}

fn recovery_candidate_help(version: string, candidates: list<ReleaseRecoveryCandidate>) -> string {
  let lines: list<string> = []
  let commands: list<string> = []
  for candidate in candidates {
    lines = lines
      + [
        "  - ${candidate.publication.remote_ref} (candidate ${candidate.publication.head_oid}, source pin ${candidate.pin_oid})",
      ]
    if !commands.any({ command -> contains(command, candidate.pin_oid) }) {
      commands = commands + ["    --at-sha ${candidate.pin_oid}"]
    }
  }
  // `--at-sha` selects which existing attempt to recover; it matches a
  // candidate's frozen source pin, so a pin that is not already listed here
  // selects nothing. An operator who wants a fresh cut at current main has to
  // free the version first, which is what the abandon harness is for.
  const escape = "\n\nnote: --at-sha names one of the source pins above, not a new pin to cut at."
    + "\nevery listed candidate resumes its frozen tree, so a fix that landed after it froze"
    + "\ncannot reach a gate. to cut fresh at current main, free the version first:\n"
    + "    harn run --no-sandbox abandon_release_attempts.harn -- --version ${version}"
  return "recovery candidates for v${version}:\n"
    + join(lines, "\n")
    + "\nretry with one of these source pins if automatic ancestry cannot select uniquely:\n"
    + join(commands, "\n")
    + escape
}

/** Select one immutable attempt from its frozen source ancestry. */
pub fn release_recovery_candidate_preference(
  version: string,
  candidates: list<ReleaseRecoveryCandidate>,
  requested_pin: string,
  is_ancestor: ReleaseRecoveryAncestry,
) -> ReleaseRecoveryPreference {
  const requested = lowercase(trim(requested_pin))
  if requested != "" {
    const matching = candidates.filter({ candidate -> candidate.pin_oid == requested }).to_list()
    if len(matching) != 1 {
      throw "--at-sha ${requested} selected ${len(matching)} immutable attempts; expected exactly one.\n"
        + recovery_candidate_help(version, candidates)
    }
    const selected = matching[0]
    return {
      attempt_oid: selected.publication.head_oid,
      pin_oid: selected.pin_oid,
      mode: "explicit_pin",
      reason: "its recovered source pin matches explicit --at-sha ${requested}",
    }
  }
  let newest: list<ReleaseRecoveryCandidate> = []
  for candidate in candidates {
    let descends_from_every_other_pin = true
    for other in candidates {
      if other.publication.head_oid == candidate.publication.head_oid {
        continue
      }
      if other.pin_oid == candidate.pin_oid || !is_ancestor(other.pin_oid, candidate.pin_oid) {
        descends_from_every_other_pin = false
      }
    }
    if descends_from_every_other_pin {
      newest = newest + [candidate]
    }
  }
  if len(newest) != 1 {
    throw "multiple unclaimed immutable release attempts exist for v${version}, and no unique newest source pin can be proven.\n"
      + recovery_candidate_help(version, candidates)
  }
  const selected = newest[0]
  return {
    attempt_oid: selected.publication.head_oid,
    pin_oid: selected.pin_oid,
    mode: "newest_base_ancestor",
    reason:
      "its source pin is the sole descendant of every other candidate pin on the base history",
  }
}

/** Resolve and verify the recovery candidates before applying the pure selection policy. */
pub fn release_recovery_preference(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseConfig,
  version: string,
  pull_requests: list<ReleasePullRequestIdentity>,
  attempt_refs: list<GitRemoteRef>,
  tag_target: string,
) -> ReleaseRecoveryPreference? {
  if tag_target != "" {
    return nil
  }
  if release_attempt_for_version(version, pull_requests) != nil {
    return nil
  }
  const publications = release_publications_from_remote_refs(version, attempt_refs)
  if len(publications) <= 1 {
    return nil
  }
  let candidates: list<ReleaseRecoveryCandidate> = []
  for candidate in publications {
    const immutable_ref = "refs/heads/${candidate.remote_ref}"
    const fetched = run_git(harness, cfg, ["fetch", "--quiet", "origin", immutable_ref])
    const fetched_head = run_git(harness, cfg, ["rev-parse", "FETCH_HEAD^{}"])
    const observed_head = lowercase(trim(fetched_head.stdout ?? ""))
    if !fetched.success || !fetched_head.success || observed_head != candidate.head_oid {
      throw "could not fetch release recovery source ${immutable_ref} at ${candidate.head_oid}"
    }
    const candidate_pin = git_merge_base(
      harness.process,
      candidate.head_oid,
      "origin/" + cfg.base,
      cfg.repo,
    )
    if !candidate_pin.success || trim(candidate_pin.data.oid) == "" {
      throw "could not recover source pin for ${candidate.remote_ref}: ${candidate_pin.stderr.inline}"
    }
    candidates = candidates
      + [{publication: candidate, pin_oid: lowercase(trim(candidate_pin.data.oid))}]
  }
  return release_recovery_candidate_preference(
    version,
    candidates,
    if trim(cfg.pin_sha_input) == "" {
      ""
    } else {
      cfg.pin_sha
    },
    fn(older_pin, newer_pin) { return run_git(
      harness,
      cfg,
      ["merge-base", "--is-ancestor", older_pin, newer_pin],
    ).success },
  )
}

pub fn with_fixup_state(cfg: ReleaseConfig, fixup: ReleaseFixupState?) -> ReleaseConfig {
  if fixup == nil {
    return cfg
  }
  let out = cfg
  if fixup.pre_tag_resume {
    out["pin_sha"] = release_recovery_pin_decision(
      cfg.pin_sha_input,
      cfg.pin_sha,
      fixup.original_pin,
    ).effective_pin
    out["pre_tag_resume"] = true
    out["pre_tag_supersede"] = false
    out["fixup_publication"] = fixup.publication
    out["release_notes_scope"] = "immutable_checkpoint"
    return out
  }
  out["fixup_mode"] = true
  // Registry publication proves the artifact already shipped even when the
  // GitHub tag or release-asset set was deleted; never re-tag that version.
  out["skip_tag"] = fixup.tag_exists || fixup.release_exists
  out["fixup_tag"] = fixup.tag
  out["fixup_pr_url"] = fixup.pr_url
  out["fixup_publication"] = fixup.publication
  out["fixup_pin_unreleased"] = fixup.pin_unreleased
  out["fixup_release_body_source"] = fixup.release_body_source ?? ""
  out["release_notes_scope"] = release_recovery_notes_scope(
    fixup.tag_exists || fixup.release_exists,
  )
  out["pre_tag_supersede"] = fixup.pre_tag_supersede ?? false
  return out
}

pub fn analysis_with_fixup_state(
  raw: ReleaseAnalysis,
  fixup: ReleaseFixupState?,
) -> ReleaseAnalysis {
  if fixup == nil {
    return raw
  }
  let out = raw
  if fixup.pre_tag_resume {
    out["pin_sha"] = release_recovery_pin_decision(
      raw.pin_sha_input,
      raw.pin_sha,
      fixup.original_pin,
    ).effective_pin
    out["pre_tag_resume"] = true
    out["pre_tag_supersede"] = false
    out["fixup_publication"] = fixup.publication
    out["release_notes_scope"] = "immutable_checkpoint"
    // The recovered workspace is already the versioned immutable candidate.
    // Re-analysis therefore reports the candidate as `current_version` and
    // computes the following patch as `next_version`; keep the checkpoint's
    // target or a retry would silently skip a version.
    out["next_version"] = release_target_version_with_fixup(raw.next_version, fixup)
    return out
  }
  out["fixup_mode"] = true
  out["fixup_tag"] = fixup.tag
  out["fixup_pr_url"] = fixup.pr_url
  out["fixup_publication"] = fixup.publication
  out["fixup_release_exists"] = fixup.release_exists
  out["release_notes_scope"] = release_recovery_notes_scope(
    fixup.tag_exists || fixup.release_exists,
  )
  out["fixup_missing_assets"] = fixup.missing_assets ?? []
  out["pre_tag_supersede"] = fixup.pre_tag_supersede ?? false
  return out
}
