import { ReleasePublication } from "./release_publication"
import { ReleaseAnalysis } from "release_analysis"
import { ReleaseConfig } from "release_runtime"

pub type ReleaseFixupState = {
  publication: ReleasePublication,
  tag: string,
  pr_url: string,
  original_pin: string,
  pin_unreleased: string,
  release_body_source: string,
  tag_exists: bool,
  release_exists: bool,
  missing_assets: list<string>,
  conflicting: bool,
  pre_tag_resume: bool,
}

pub type ReleaseRecoveryPinDecision = {compatible: bool, effective_pin: string}

pub fn release_recovery_is_pre_tag_resume(tag_exists: bool, pr_url: string) -> bool {
  return !tag_exists && trim(pr_url) == ""
}

/**
 * An operator-supplied pin remains authoritative during recovery. Automatic
 * releases may resume the checkpoint's frozen source; an explicit release
 * may resume only when that source is the requested commit.
 */
pub fn release_recovery_pin_decision(
  pin_sha_input: string,
  pin_sha: string,
  recovered_pin: string,
) -> ReleaseRecoveryPinDecision {
  if trim(pin_sha_input) != "" {
    return {
      compatible: lowercase(trim(pin_sha)) == lowercase(trim(recovered_pin)),
      effective_pin: pin_sha,
    }
  }
  return {compatible: true, effective_pin: recovered_pin}
}

pub fn with_fixup_state(cfg: ReleaseConfig, fixup: ReleaseFixupState?) -> ReleaseConfig {
  if fixup == nil {
    return cfg
  }
  let out = cfg
  if fixup.pre_tag_resume {
    out["pin_sha"] = release_recovery_pin_decision(
      cfg.pin_sha_input,
      cfg.pin_sha,
      fixup.original_pin,
    ).effective_pin
    out["pre_tag_resume"] = true
    out["fixup_publication"] = fixup.publication
    return out
  }
  out["fixup_mode"] = true
  out["skip_tag"] = fixup.tag_exists
  out["fixup_tag"] = fixup.tag
  out["fixup_pr_url"] = fixup.pr_url
  out["fixup_publication"] = fixup.publication
  out["fixup_pin_unreleased"] = fixup.pin_unreleased
  out["fixup_release_body_source"] = fixup.release_body_source ?? ""
  return out
}

pub fn analysis_with_fixup_state(
  raw: ReleaseAnalysis,
  fixup: ReleaseFixupState?,
) -> ReleaseAnalysis {
  if fixup == nil {
    return raw
  }
  let out = raw
  if fixup.pre_tag_resume {
    out["pin_sha"] = release_recovery_pin_decision(
      raw.pin_sha_input,
      raw.pin_sha,
      fixup.original_pin,
    ).effective_pin
    out["pre_tag_resume"] = true
    out["fixup_publication"] = fixup.publication
    return out
  }
  out["fixup_mode"] = true
  out["fixup_tag"] = fixup.tag
  out["fixup_pr_url"] = fixup.pr_url
  out["fixup_publication"] = fixup.publication
  out["fixup_release_exists"] = fixup.release_exists
  out["fixup_missing_assets"] = fixup.missing_assets ?? []
  return out
}
