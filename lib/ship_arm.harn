import { github_branch_head, github_file_text_at_ref_result, github_pr_view } from "./github"
import { observe_release_merge_lease, release_merge_lease_admission } from "./release_merge_lease"
import { GithubClientOptions, api_call } from "harn-github-connector/default"

pub type ProjectionShipOutcome = {
  state: "armed" | "already_armed" | "held" | "refused",
  method?: string,
  error?: string,
}

type ShipPull = {
  github_state: string,
  auto_merge_armed: bool,
  base: {ref: string},
  head: {ref: string, sha: string, repo: string},
}

type ShipLabel = {name: string}

type ShipLabels = list<ShipLabel>

/** Grant Smart Ship an exact pull request after measuring its caller and release lease. */
pub fn arm_ship(
  harness: Harness,
  slug: string,
  default_branch: string,
  number: int,
  commit: string,
  options: GithubClientOptions,
  branch_prefix: string? = nil,
  exact_branch: bool = false,
) -> ProjectionShipOutcome {
  const attempted = try {
    require default_branch == "main" && number > 0 && regex_match("^[0-9a-f]{40}$", commit) != nil,
      "the projection's main branch, pull request or commit is unmeasured"
    const main = unwrap(github_branch_head(harness, slug, default_branch, options))
    const main_oid = to_string(main?.oid ?? "")
    require regex_match("^[0-9a-f]{40}$", main_oid) != nil, "the default branch is unmeasured"
    const self_hosted = slug == "burin-labs/.github"
    const caller_path =
      self_hosted ? ".github/workflows/ship.yml" : ".github/workflows/smart-ship.yml"
    const caller = unwrap(
      github_file_text_at_ref_result(harness, slug, caller_path, main_oid, options),
    )
    require caller != nil && caller.trim() != "",
      "the default branch has no measured Smart Ship caller"
    const pull = schema_expect(
      unwrap(github_pr_view(harness, slug, number, options)),
      schema_of(ShipPull),
    )
    require pull.github_state == "open",
      "the projection pull request is not open: "
      + pull.github_state
    require !pull.auto_merge_armed, "raw auto-merge is armed on this pull request"
    require pull.base.ref == default_branch, "the projection base branch changed"
    require pull.head.sha == commit, "the published projection head changed"
    require pull.head.repo == slug, "the projection head belongs to another repository"
    if branch_prefix != nil {
      require exact_branch ? pull.head.ref == branch_prefix : pull.head.ref.starts_with(
        branch_prefix,
      ),
        "the pull request branch changed"
    }
    const lease = observe_release_merge_lease(harness, slug, default_branch, options)
    const admission = release_merge_lease_admission(
      lease,
      {repo: slug, base_branch: default_branch, pr: number, head: commit},
    )
    require admission.allowed, admission.reason
    require lease.state != "active" || lease.lease?.merge_method == "squash",
      "the release merge lease requires a different merge method"
    const labeled = unwrap(
      api_call(
        harness,
        {
          path: "/repos/${slug}/issues/${to_string(number)}/labels",
          method: "POST",
          body: {labels: ["ship"]},
          options: options,
        },
      ),
    )
    const labels = schema_expect(labeled, schema_of(ShipLabels))
    require labels.any({ label -> label.name == "ship" }), "the ship label was not confirmed"
    {state: "armed", method: "SMART_SHIP"}
  }
  return is_ok(attempted) ? unwrap(attempted) : {
    state: "refused",
    error: "Smart Ship authorization failed: " + to_string(unwrap_err(attempted)),
  }
}
