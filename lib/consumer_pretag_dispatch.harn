import {
  ConsumerPretagAttestationReceipt,
  ConsumerPretagGateReceipt,
  ConsumerPretagGateTarget,
} from "./consumer_pretag_gate"

pub type ConsumerPretagJobRow = {
  id: int,
  run_id: int,
  name: string,
  status: string,
  conclusion: string,
  head_sha: string,
  steps: list<{name: string, status: string, conclusion: string}>,
}

pub type ConsumerPretagJobsPage = {
  repo: string,
  run_id: int,
  total_count: int,
  jobs: list<ConsumerPretagJobRow>,
}

/** Workflow identity and the fields needed to judge its result. */
pub type ConsumerPretagRunRow = {
  id: int,
  status: string,
  conclusion: string,
  html_url: string,
  display_title: string,
  head_sha: string,
  workflow_path?: string,
  event?: string,
  head_branch?: string,
}

/** One bounded exception backed by a successful candidate job and red main baseline. */
pub type ConsumerPretagFailureAttestation = {
  run_id: int,
  proof_job_id: int,
  proof_step: string,
  excluded_job_ids: list<int>,
  excluded_checks: list<string>,
  baseline_run_id: int,
  baseline_job_id: int,
  baseline_workflow_path: string,
}

pub type ConsumerPretagProofSelection = int | ConsumerPretagFailureAttestation

/** Operator-selected exact consumer proof runs, keyed by repository slug. */
pub type ConsumerPretagProofRuns = dict<string, ConsumerPretagProofSelection>

fn positive_id(value: any, field: string, slug: string) -> int {
  if type_of(value) != "int" || value <= 0 {
    throw "consumer proof ${field} for ${slug} must be a positive integer GitHub Actions ID"
  }
  return value
}

fn normalize_failure_attestation(value: any, slug: string) -> ConsumerPretagFailureAttestation {
  const expected = [
    "baseline_job_id",
    "baseline_run_id",
    "baseline_workflow_path",
    "excluded_checks",
    "excluded_job_ids",
    "proof_job_id",
    "proof_step",
    "run_id",
  ]
  if type_of(value) != "dict" || value.keys().sorted().to_list() != expected {
    throw "consumer proof attestation for ${slug} must contain exactly: " + expected.join(", ")
  }
  const workflow = trim(to_string(value.baseline_workflow_path ?? ""))
  if len(regex_captures("^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$", workflow)) == 0 {
    throw "consumer proof baseline_workflow_path for ${slug} must name one workflow path"
  }
  const checks = value.excluded_checks
  if type_of(checks) != "list" || len(checks) == 0 {
    throw "consumer proof excluded_checks for ${slug} must be a nonempty list"
  }
  let normalized_checks: list<string> = []
  for check in checks {
    const name = trim(to_string(check))
    if name == "" || contains(name, "\n") || normalized_checks.contains(name) {
      throw "consumer proof excluded_checks for ${slug} must be unique nonempty one-line names"
    }
    normalized_checks = normalized_checks + [name]
  }
  const excluded_job_ids = value.excluded_job_ids
  if type_of(excluded_job_ids) != "list" || len(excluded_job_ids) == 0 {
    throw "consumer proof excluded_job_ids for ${slug} must be a nonempty list"
  }
  let normalized_job_ids: list<int> = []
  for id in excluded_job_ids {
    const normalized_id = positive_id(id, "excluded_job_ids", slug)
    if normalized_job_ids.contains(normalized_id) {
      throw "consumer proof excluded_job_ids for ${slug} must be unique"
    }
    normalized_job_ids = normalized_job_ids + [normalized_id]
  }
  const proof_step = trim(to_string(value.proof_step ?? ""))
  if proof_step == "" || contains(proof_step, "\n") {
    throw "consumer proof proof_step for ${slug} must be one nonempty line"
  }
  const normalized: ConsumerPretagFailureAttestation = {
    run_id: positive_id(value.run_id, "run_id", slug),
    proof_job_id: positive_id(value.proof_job_id, "proof_job_id", slug),
    proof_step: proof_step,
    excluded_job_ids: normalized_job_ids.sorted(),
    excluded_checks: normalized_checks.sorted(),
    baseline_run_id: positive_id(value.baseline_run_id, "baseline_run_id", slug),
    baseline_job_id: positive_id(value.baseline_job_id, "baseline_job_id", slug),
    baseline_workflow_path: workflow,
  }
  if normalized.excluded_job_ids.contains(normalized.proof_job_id) {
    throw "consumer proof and excluded job IDs for ${slug} must differ"
  }
  return normalized
}

/** Parse and canonicalize the explicit recovery input before any dispatch. */
pub fn parse_consumer_pretag_proof_runs_json(text: string) -> ConsumerPretagProofRuns {
  if trim(text) == "" {
    return {}
  }
  const parsed = try {
    json_parse(text)
  } catch (error) {
    throw "consumer proof runs must be a JSON object mapping repository slugs to positive run IDs: "
      + to_string(error)
  }
  if type_of(parsed) != "dict" {
    throw "consumer proof runs must be a JSON object mapping repository slugs to positive run IDs"
  }
  let normalized: ConsumerPretagProofRuns = {}
  for slug in parsed.keys().sorted() {
    const selection = parsed[slug]
    if len(regex_captures("^[^/[:space:]]+/[^/[:space:]]+$", slug)) == 0 {
      throw "consumer proof run key '${slug}' must be a repository slug like owner/repository"
    }
    normalized[slug] = if type_of(selection) == "int" {
      positive_id(selection, "run", slug)
    } else {
      normalize_failure_attestation(selection, slug)
    }
  }
  return normalized
}

/**
 * Everything the pre-tag gate does to the outside world, in one injected shape.
 *
 * `runs` lists this workflow's dispatched runs; the gate keeps only the ones
 * whose name carries the exact candidate version and commit and whose source
 * commit matches the captured consumer revision. That lookup is
 * recovery-only: a fresh dispatch returns its authoritative run id directly.
 * An existing unique match is the durable checkpoint for a resumed release,
 * and ambiguity is always refused rather than resolved by picking the newest.
 */
pub type ConsumerPretagDispatchReceipt = {run_id: int, head_sha: string}

pub type ConsumerPretagGateAdapter = {
  consumer_revision: fn(ConsumerPretagGateTarget) -> Result<string, dict>,
  dispatch: fn(ConsumerPretagGateTarget) -> Result<ConsumerPretagDispatchReceipt, dict>,
  runs: fn(ConsumerPretagGateTarget) -> Result<list<ConsumerPretagRunRow>, dict>,
  run: fn(ConsumerPretagGateTarget, int) -> Result<ConsumerPretagRunRow, dict>,
  jobs?: fn(ConsumerPretagGateTarget, int) -> Result<ConsumerPretagJobsPage, dict>,
  wait: fn(int) -> nil,
  now_ms: fn() -> int,
}

/**
 * Told the run id of a gate as soon as the gate is bound to one.
 *
 * A dispatched consumer run outlives the lane that started it. If the
 * certification is cancelled while a gate is polling, the only thing that can
 * still reach that run is a record made before the cancellation, so the id is
 * published the moment it is known rather than when the gate settles.
 */
pub type ConsumerPretagRunRecorder = fn(string, int) -> nil

pub type ConsumerPretagGatePolicy = {
  poll_interval_ms: int,
  deadline_ms: int,
  recovery_visibility_ms?: int,
}

pub const CONSUMER_PRETAG_GATE_POLICY: ConsumerPretagGatePolicy = {
  poll_interval_ms: 30000,
  // A consumer may queue behind scarce self-hosted capacity before its own
  // workflow starts doing useful work. Keep this below the hosted release
  // owner's five-hour bound while allowing one hour of queueing plus the
  // consumer's long integration proof.
  deadline_ms: 180 * 60 * 1000,
}

type PendingGate = {target: ConsumerPretagGateTarget, run_id: int, visibility_error?: string}

type CandidateResolution = {
  receipts: list<ConsumerPretagGateReceipt>,
  pending: list<PendingGate>,
  unseen: list<PendingGate>,
}

/** Fresh cuts mutate immediately; only a resumed checkpoint reconciles visibility first. */
pub fn consumer_pretag_gate_policy(pre_tag_resume: bool) -> ConsumerPretagGatePolicy {
  return CONSUMER_PRETAG_GATE_POLICY
    + {
      recovery_visibility_ms: if pre_tag_resume {
        60000
      } else {
        0
      },
    }
}

fn unreadable(target: ConsumerPretagGateTarget, detail: string) -> ConsumerPretagGateReceipt {
  return {
    slug: target.slug,
    workflow: target.workflow,
    status: "unreadable",
    run_url: "",
    detail: detail,
  }
}

fn candidate_runs(
  target: ConsumerPretagGateTarget,
  rows: list<ConsumerPretagRunRow>,
) -> list<ConsumerPretagRunRow> {
  const title = "Harn candidate ${target.version} @ ${target.revision}"
  return rows.filter(
    { row ->
      trim(row.display_title) == title
        && row.head_sha == target.consumer_revision
    },
  )
    .to_list()
}

fn settle(
  target: ConsumerPretagGateTarget,
  row: ConsumerPretagRunRow,
  expected_run_id: int,
  adapter: ConsumerPretagGateAdapter,
) -> ConsumerPretagGateReceipt? {
  if row.id != expected_run_id
    || trim(row.display_title) != "Harn candidate ${target.version} @ ${target.revision}" {
    return unreadable(target, "run lookup returned a different run or candidate identity")
  }
  if row.head_sha != target.consumer_revision {
    return unreadable(target, "run ${row.id} does not name the captured consumer revision")
  }
  if target.proof_job != nil {
    return settle_declared_job(target, row, adapter)
  }
  if row.status != "completed" {
    return nil
  }
  const passed = row.conclusion == "success"
  // `cancelled`, `stale` and `startup_failure` never judged the candidate, so
  // they are unreadable rather than a verdict either way.
  const settled = passed || row.conclusion == "failure" || row.conclusion == "timed_out"
  return {
    slug: target.slug,
    workflow: target.workflow,
    status: if passed {
      "passed"
    } else if settled {
      "failed"
    } else {
      "unreadable"
    },
    run_url: row.html_url,
    detail: if settled {
      "run ${to_string(row.id)} concluded '${row.conclusion}'"
    } else {
      "run ${to_string(row.id)} concluded '${row.conclusion}' without judging the candidate"
    },
  }
}

fn exact_jobs(
  page: ConsumerPretagJobsPage,
  target: ConsumerPretagGateTarget,
  run_id: int,
) -> Result<list<ConsumerPretagJobRow>, dict> {
  if page.repo != target.slug || page.run_id != run_id || page.total_count != len(page.jobs) {
    return Err({message: "workflow jobs page did not completely describe the selected run"})
  }
  for job in page.jobs {
    if job.run_id != run_id || job.head_sha != target.consumer_revision {
      return Err({message: "workflow job identity did not match the selected run and source"})
    }
  }
  return Ok(page.jobs)
}

fn settle_declared_job(
  target: ConsumerPretagGateTarget,
  row: ConsumerPretagRunRow,
  adapter: ConsumerPretagGateAdapter,
) -> ConsumerPretagGateReceipt? {
  if adapter.jobs == nil {
    return unreadable(target, "consumer proof adapter cannot inspect the declared workflow job")
  }
  const read_jobs = adapter.jobs
    ?? fn(_target, _run_id) { return Err({message: "workflow jobs reader unavailable"}) }
  const page = read_jobs(target, row.id)
  if is_err(page) {
    return nil
  }
  const exact = exact_jobs(unwrap(page), target, row.id)
  if is_err(exact) {
    return unreadable(target, to_string(unwrap_err(exact)))
  }
  const jobs = unwrap(exact)
  const selector = target.proof_job ?? {name: "", step: ""}
  const selected = jobs.filter({ job -> job.name == selector.name }).to_list()
  if len(selected) == 0 {
    return if row.status == "completed" {
      unreadable(target, "completed run did not contain the declared candidate proof job")
    } else {
      nil
    }
  }
  if len(selected) != 1 {
    return unreadable(target, "run contained the declared candidate proof job more than once")
  }
  const job = selected[0]
    ?? {
      id: 0,
      run_id: row.id,
      name: "",
      status: "",
      conclusion: "",
      head_sha: row.head_sha,
      steps: [],
    }
  if job.status != "completed" {
    return nil
  }
  const selected_steps = job.steps.filter({ step -> step.name == selector.step }).to_list()
  if len(selected_steps) != 1 {
    return unreadable(
      target,
      if len(selected_steps) == 0 {
        "candidate proof job did not contain the declared proof step"
      } else {
        "candidate proof job contained the declared proof step more than once"
      },
    )
  }
  const step = selected_steps[0] ?? {name: "", status: "", conclusion: ""}
  if step.status != "completed" {
    return nil
  }
  const passed = job.conclusion == "success" && step.conclusion == "success"
  const failed = [job.conclusion, step.conclusion].any(
    { conclusion -> conclusion == "failure" || conclusion == "timed_out" },
  )
  const advisory = jobs.filter({ candidate -> candidate.id != job.id }).map(
    { candidate ->
      {
        id: candidate.id,
        name: candidate.name,
        status: candidate.status,
        conclusion: candidate.conclusion,
      }
    },
  )
    .to_list()
  return {
    slug: target.slug,
    workflow: target.workflow,
    status: if passed {
      "passed"
    } else if failed {
      "failed"
    } else {
      "unreadable"
    },
    run_url: row.html_url,
    detail: if passed {
      "declared candidate proof job and step passed"
    } else if failed {
      "declared candidate proof job or step failed"
    } else {
      "declared candidate proof job or step did not report a judging conclusion"
    },
    job_proof: {
      run_id: row.id,
      job: {id: job.id, name: job.name, step: selector.step},
      advisory_jobs: advisory,
    },
  }
}

fn one_job(
  jobs: list<ConsumerPretagJobRow>,
  id: int,
  purpose: string,
) -> Result<ConsumerPretagJobRow, dict> {
  const found = jobs.filter({ job -> job.id == id }).to_list()
  if len(found) != 1 {
    return Err({message: "${purpose} job ${id} was not present exactly once"})
  }
  return Ok(found[0])
}

fn verify_attestation_baseline(
  target: ConsumerPretagGateTarget,
  attestation: ConsumerPretagFailureAttestation,
  adapter: ConsumerPretagGateAdapter,
  read_jobs: fn(ConsumerPretagGateTarget, int) -> Result<ConsumerPretagJobsPage, dict>,
) -> Result<{run: ConsumerPretagRunRow, job: ConsumerPretagJobRow}, string> {
  const baseline = adapter.run(target, attestation.baseline_run_id)
  if is_err(baseline) {
    return Err("could not read attestation baseline run: " + to_string(unwrap_err(baseline)))
  }
  const run = unwrap(baseline)
  if run.id != attestation.baseline_run_id
    || run.workflow_path != attestation.baseline_workflow_path
    || run.event != "push"
    || run.head_branch != "main"
    || run.status != "completed"
    || run.conclusion != "failure"
    || len(regex_captures("^[0-9a-f]{40}$", run.head_sha)) == 0 {
    return Err("attestation baseline was not a completed failing main push")
  }
  const baseline_target = target + {consumer_revision: run.head_sha}
  const page = read_jobs(baseline_target, attestation.baseline_run_id)
  if is_err(page) {
    return Err("could not read attestation baseline jobs: " + to_string(unwrap_err(page)))
  }
  const jobs = exact_jobs(unwrap(page), baseline_target, attestation.baseline_run_id)
  if is_err(jobs) {
    return Err(to_string(unwrap_err(jobs)))
  }
  const job = one_job(unwrap(jobs), attestation.baseline_job_id, "baseline failure")
  if is_err(job) || unwrap(job).status != "completed" || unwrap(job).conclusion != "failure" {
    return Err("attestation baseline job was not a completed failure")
  }
  return Ok({run: run, job: unwrap(job)})
}

fn attested_failure_receipt(
  target: ConsumerPretagGateTarget,
  candidate: ConsumerPretagRunRow,
  attestation: ConsumerPretagFailureAttestation,
  adapter: ConsumerPretagGateAdapter,
) -> ConsumerPretagGateReceipt {
  if candidate.status != "completed" || candidate.conclusion != "failure" {
    return unreadable(target, "attested candidate run must be a completed failure")
  }
  if adapter.jobs == nil {
    return unreadable(target, "consumer proof adapter cannot inspect exact workflow jobs")
  }
  const read_jobs = adapter.jobs
    ?? fn(_target, _run_id) { return Err({message: "workflow jobs reader unavailable"}) }
  const candidate_page = read_jobs(target, attestation.run_id)
  if is_err(candidate_page) {
    return unreadable(
      target,
      "could not read attested candidate jobs: " + to_string(unwrap_err(candidate_page)),
    )
  }
  const candidate_jobs = exact_jobs(unwrap(candidate_page), target, attestation.run_id)
  if is_err(candidate_jobs) {
    return unreadable(target, to_string(unwrap_err(candidate_jobs)))
  }
  const jobs = unwrap(candidate_jobs)
  if jobs.any({ job -> job.status != "completed" }) {
    return unreadable(target, "attested candidate run still has pending jobs")
  }
  const proof = one_job(jobs, attestation.proof_job_id, "candidate proof")
  if is_err(proof) {
    return unreadable(target, to_string(unwrap_err(proof)))
  }
  const proof_job = unwrap(proof)
  const proof_steps = proof_job.steps.filter(
    { step -> step.name == attestation.proof_step && step.status == "completed" },
  )
    .to_list()
  if proof_job.conclusion != "success" || len(proof_steps) != 1
    || proof_steps[0]?.conclusion != "success" {
    return unreadable(target, "attested candidate proof job and step did not report success")
  }
  const failed = jobs.filter({ job -> job.conclusion != "success" }).to_list()
  const unexpected = failed.filter({ job -> !attestation.excluded_job_ids.contains(job.id) })
    .to_list()
  const missing = attestation.excluded_job_ids.filter(
    { id -> !failed.any({ job -> job.id == id && job.conclusion == "failure" }) },
  )
    .to_list()
  if len(unexpected) > 0 || len(missing) > 0 {
    return unreadable(
      target,
      "attested candidate run has unaccounted or missing failed jobs: "
        + unexpected.map({ job -> "${job.name}:${job.conclusion}" }).to_list().join(", "),
    )
  }
  const baseline = verify_attestation_baseline(target, attestation, adapter, read_jobs)
  if is_err(baseline) {
    return unreadable(target, unwrap_err(baseline))
  }
  const baseline_run = unwrap(baseline).run
  const baseline_job = unwrap(baseline).job
  const evidence: ConsumerPretagAttestationReceipt = {
    candidate_run_id: candidate.id,
    candidate_revision: target.revision,
    consumer_revision: candidate.head_sha,
    proof_job: {id: proof_job.id, name: proof_job.name, step: attestation.proof_step},
    excluded_jobs: failed.map({ job -> {id: job.id, name: job.name} }).to_list(),
    excluded_checks: attestation.excluded_checks,
    baseline_run: {
      id: baseline_run.id,
      workflow_path: baseline_run.workflow_path ?? "",
      head_sha: baseline_run.head_sha,
    },
    baseline_job: {id: baseline_job.id, name: baseline_job.name},
  }
  return {
    slug: target.slug,
    workflow: target.workflow,
    status: "passed",
    run_url: candidate.html_url,
    detail: "operator attestation accepted one baseline-backed consumer-main failure",
    attestation: evidence,
  }
}

/** Bind an explicit run to its own source revision without reading current main. */
fn resolve_explicit_run(
  declared_target: ConsumerPretagGateTarget,
  selection: ConsumerPretagProofSelection,
  adapter: ConsumerPretagGateAdapter,
  recorder: ConsumerPretagRunRecorder?,
) -> CandidateResolution {
  const run_id = to_int(
    if type_of(selection) == "int" {
      selection
    } else {
      selection.run_id
    },
  )
    ?? 0
  const read = adapter.run(declared_target, run_id)
  if is_err(read) {
    return {
      receipts: [
        unreadable(
          declared_target,
          "explicit run ${run_id} could not be read: " + to_string(unwrap_err(read)),
        ),
      ],
      pending: [],
      unseen: [],
    }
  }
  const row = unwrap(read)
  const expected_title = "Harn candidate ${declared_target.version} @ ${declared_target.revision}"
  const expected_workflow = ".github/workflows/${declared_target.workflow}"
  let identity_error = ""
  if row.id != run_id {
    identity_error = "explicit run lookup returned another run ID"
  } else if trim(row.workflow_path ?? "") != expected_workflow {
    identity_error = "explicit run ${run_id} does not name declared workflow ${expected_workflow}"
  } else if trim(row.event ?? "") != "workflow_dispatch" {
    identity_error = "explicit run ${run_id} was not started by workflow_dispatch"
  } else if trim(row.display_title) != expected_title {
    identity_error = "explicit run ${run_id} does not name candidate ${declared_target.version} @ ${declared_target.revision}"
  } else if len(regex_captures("^[0-9a-f]{40}$", row.head_sha)) == 0 {
    identity_error = "explicit run ${run_id} has no valid consumer source revision"
  }
  if identity_error != "" {
    return {receipts: [unreadable(declared_target, identity_error)], pending: [], unseen: []}
  }
  const target = declared_target + {consumer_revision: row.head_sha}
  if recorder != nil {
    (recorder ?? fn(_slug, _id) { return nil })(target.slug, run_id)
  }
  if type_of(selection) == "dict" && row.status != "completed" {
    return {
      receipts: [unreadable(target, "attested consumer proof run is not terminal")],
      pending: [],
      unseen: [],
    }
  }
  const receipt = if type_of(selection) == "dict" {
    const attestation = schema_expect(selection, ConsumerPretagFailureAttestation)
    attested_failure_receipt(target, row, attestation, adapter)
  } else {
    settle(target, row, run_id, adapter)
  }
  return if receipt == nil {
    {receipts: [], pending: [{target: target, run_id: run_id}], unseen: []}
  } else {
    {
      receipts: [receipt ?? unreadable(target, "explicit run produced no terminal receipt")],
      pending: [],
      unseen: [],
    }
  }
}

fn resolve_candidate_rows(
  target: ConsumerPretagGateTarget,
  rows: list<ConsumerPretagRunRow>,
  adapter: ConsumerPretagGateAdapter,
  recorder: ConsumerPretagRunRecorder?,
  ambiguity_context: string,
) -> CandidateResolution {
  const title = "Harn candidate ${target.version} @ ${target.revision}"
  if rows.any(
    { row ->
      trim(row.display_title) == title
        && len(regex_captures("^[0-9a-f]{40}$", row.head_sha)) == 0
    },
  ) {
    return {
      receipts: [unreadable(target, "candidate run has no valid consumer source revision")],
      pending: [],
      unseen: [],
    }
  }
  const found = candidate_runs(target, rows)
  if len(found) == 0 {
    return {receipts: [], pending: [], unseen: [{target: target, run_id: 0, visibility_error: nil}]}
  }
  if len(found) > 1 {
    return {
      receipts: [
        unreadable(
          target,
          "${to_string(len(found))} ${ambiguity_context} runs name this candidate and consumer revision; refusing to "
            + "guess which one judged it",
        ),
      ],
      pending: [],
      unseen: [],
    }
  }
  const row = found[0]
    ?? {
      id: 0,
      status: "completed",
      conclusion: "startup_failure",
      html_url: "",
      display_title: "",
      head_sha: "",
    }
  const receipt = settle(target, row, row.id, adapter)
  if receipt != nil {
    return {
      receipts: [receipt ?? unreadable(target, "candidate run produced no terminal receipt")],
      pending: [],
      unseen: [],
    }
  }
  if recorder != nil {
    let _ = (recorder ?? fn(_slug, _id) { return nil })(target.slug, row.id)
  }
  return {receipts: [], pending: [{target: target, run_id: row.id}], unseen: []}
}

fn dispatch_unseen_candidates(
  gates: list<PendingGate>,
  adapter: ConsumerPretagGateAdapter,
  recovery_visibility_ms: int,
  recorder: ConsumerPretagRunRecorder?,
) -> CandidateResolution {
  let receipts: list<ConsumerPretagGateReceipt> = []
  let pending: list<PendingGate> = []
  for gate in gates {
    const target = gate.target
    if recovery_visibility_ms > 0 && gate.visibility_error != nil {
      receipts = receipts
        + [
          unreadable(
            target,
            "could not reconcile a previously accepted recovery dispatch before mutation: "
              + to_string(gate.visibility_error),
          ),
        ]
      continue
    }
    const dispatched = adapter.dispatch(target)
    if is_err(dispatched) {
      receipts = receipts
        + [unreadable(target, "dispatch failed: " + to_string(unwrap_err(dispatched)))]
      continue
    }
    const run_id = unwrap(dispatched).run_id
    if run_id <= 0 {
      receipts = receipts + [unreadable(target, "dispatch returned no valid run identity")]
      continue
    }
    // Publish the accepted run before any suspension point. A sibling can fail
    // immediately after dispatch, and cancellation must already be able to
    // reach the hosted work without waiting for list visibility.
    if recorder != nil {
      (recorder ?? fn(_slug, _id) { return nil })(target.slug, run_id)
    }
    if unwrap(dispatched).head_sha != target.consumer_revision {
      receipts = receipts
        + [
          unreadable(
            target,
            "consumer main moved during dispatch; run ${run_id} does not prove the captured revision",
          ),
        ]
      continue
    }
    pending = pending + [gate + {run_id: run_id}]
  }
  return {receipts: receipts, pending: pending, unseen: []}
}

fn capture_consumer_revision(
  target: ConsumerPretagGateTarget,
  adapter: ConsumerPretagGateAdapter,
) -> Result<ConsumerPretagGateTarget, string> {
  const revision = adapter.consumer_revision(target)
  if is_err(revision) {
    return Err("could not resolve consumer revision: " + to_string(unwrap_err(revision)))
  }
  if len(regex_captures("^[0-9a-f]{40}$", unwrap(revision))) == 0 {
    return Err("consumer revision must be a 40-character commit SHA")
  }
  return Ok(target + {consumer_revision: unwrap(revision)})
}

fn unknown_explicit_run_receipts(
  targets: list<ConsumerPretagGateTarget>,
  explicit_runs: ConsumerPretagProofRuns,
) -> list<ConsumerPretagGateReceipt> {
  let receipts: list<ConsumerPretagGateReceipt> = []
  for slug in explicit_runs.keys() {
    if !targets.any({ target -> target.slug == slug }) {
      receipts = receipts
        + [
          {
            slug: slug,
            workflow: "",
            status: "unreadable",
            run_url: "",
            detail: "explicit consumer proof run names a repository with no declared pre-tag gate",
          },
        ]
    }
  }
  return receipts
}

fn pending_gate_detail(gate: PendingGate) -> string {
  if gate.run_id == 0 {
    return "no run naming this candidate appeared before the gate deadline"
  }
  if gate.target.proof_job != nil {
    return "run ${to_string(gate.run_id)} did not produce terminal declared-job proof before the gate deadline"
  }
  return "run ${to_string(gate.run_id)} was still running at the gate deadline"
}

/**
 * Resume or dispatch every consumer gate, then wait for all of them together.
 *
 * A unique run naming the candidate and captured consumer revision is adopted
 * before mutation. A fresh dispatch binds its authoritative run id before any
 * wait and must report the captured consumer revision. Resolving every target
 * before polling keeps the wall clock at the slowest consumer.
 *
 * A gate still running at the deadline is pending and leaves the release
 * unproven; the consumer has not yet answered.
 */
fn run_consumer_pretag_gates_validated(
  targets: list<ConsumerPretagGateTarget>,
  adapter: ConsumerPretagGateAdapter,
  policy: ConsumerPretagGatePolicy = CONSUMER_PRETAG_GATE_POLICY,
  recorder: ConsumerPretagRunRecorder? = nil,
  explicit_runs: ConsumerPretagProofRuns = {},
) -> list<ConsumerPretagGateReceipt> {
  let receipts: list<ConsumerPretagGateReceipt> = []
  // Recovery reconciliation and consumer polling share this one bound. The
  // grace period must not silently extend the release's advertised deadline.
  const stop_at_ms = adapter.now_ms() + policy.deadline_ms
  let pending: list<PendingGate> = []
  let awaiting_dispatch: list<PendingGate> = []
  for declared_target in targets {
    const explicit_run_id = explicit_runs[declared_target.slug]
    if explicit_run_id != nil {
      const resolved = resolve_explicit_run(declared_target, explicit_run_id, adapter, recorder)
      receipts = receipts + resolved.receipts
      pending = pending + resolved.pending
      continue
    }
    const captured = capture_consumer_revision(declared_target, adapter)
    if is_err(captured) {
      receipts = receipts + [unreadable(declared_target, unwrap_err(captured))]
      continue
    }
    const target = unwrap(captured)
    const before = adapter.runs(target)
    if is_err(before) {
      receipts = receipts
        + [
          unreadable(
            target,
            "could not inventory existing runs before dispatch: "
              + to_string(unwrap_err(before)),
          ),
        ]
      continue
    }
    const resolved = resolve_candidate_rows(target, unwrap(before), adapter, recorder, "existing")
    receipts = receipts + resolved.receipts
    pending = pending + resolved.pending
    awaiting_dispatch = awaiting_dispatch + resolved.unseen
  }
  const visibility_ms = policy.recovery_visibility_ms ?? 0
  const requested_visibility_stop_ms = adapter.now_ms() + visibility_ms
  const visibility_stop_ms = if requested_visibility_stop_ms < stop_at_ms {
    requested_visibility_stop_ms
  } else {
    stop_at_ms
  }
  while len(awaiting_dispatch) > 0
    && visibility_ms > 0
    && adapter.now_ms() < visibility_stop_ms {
    const remaining_ms = visibility_stop_ms - adapter.now_ms()
    adapter.wait(
      if policy.poll_interval_ms < remaining_ms {
        policy.poll_interval_ms
      } else {
        remaining_ms
      },
    )
    let still_unseen: list<PendingGate> = []
    for gate in awaiting_dispatch {
      const observed = adapter.runs(gate.target)
      if is_err(observed) {
        still_unseen = still_unseen
          + [gate + {visibility_error: to_string(unwrap_err(observed))}]
        continue
      }
      const rows = unwrap(observed)
      const resolved = resolve_candidate_rows(
        gate.target,
        rows,
        adapter,
        recorder,
        "recovery-visible",
      )
      receipts = receipts + resolved.receipts
      pending = pending + resolved.pending
      still_unseen = still_unseen + resolved.unseen
    }
    awaiting_dispatch = still_unseen
  }
  if len(awaiting_dispatch) > 0 && adapter.now_ms() < stop_at_ms {
    const dispatched = dispatch_unseen_candidates(
      awaiting_dispatch,
      adapter,
      visibility_ms,
      recorder,
    )
    receipts = receipts + dispatched.receipts
    pending = pending + dispatched.pending
  } else {
    pending = pending + awaiting_dispatch
  }
  while len(pending) > 0 && adapter.now_ms() < stop_at_ms {
    let still_pending: list<PendingGate> = []
    for gate in pending {
      if gate.run_id == 0 {
        still_pending = still_pending + [gate]
        continue
      }
      const row = adapter.run(gate.target, gate.run_id)
      if is_err(row) {
        still_pending = still_pending + [gate]
        continue
      }
      const settled = settle(gate.target, unwrap(row), gate.run_id, adapter)
      if settled == nil {
        still_pending = still_pending + [gate]
        continue
      }
      receipts = receipts + [settled ?? unreadable(gate.target, "unreachable")]
    }
    pending = still_pending
    if len(pending) > 0 {
      const remaining_ms = stop_at_ms - adapter.now_ms()
      if remaining_ms > 0 {
        adapter.wait(
          if policy.poll_interval_ms < remaining_ms {
            policy.poll_interval_ms
          } else {
            remaining_ms
          },
        )
      }
    }
  }
  for gate in pending {
    receipts = receipts
      + [
        {
          slug: gate.target.slug,
          workflow: gate.target.workflow,
          status: "pending",
          run_url: "",
          detail: pending_gate_detail(gate),
        },
      ]
  }
  return receipts
}

/** Validate the complete explicit-run map before the gate performs any I/O. */
pub fn run_consumer_pretag_gates(
  targets: list<ConsumerPretagGateTarget>,
  adapter: ConsumerPretagGateAdapter,
  policy: ConsumerPretagGatePolicy = CONSUMER_PRETAG_GATE_POLICY,
  recorder: ConsumerPretagRunRecorder? = nil,
  explicit_runs: ConsumerPretagProofRuns = {},
) -> list<ConsumerPretagGateReceipt> {
  const invalid = unknown_explicit_run_receipts(targets, explicit_runs)
  if len(invalid) > 0 {
    return invalid
  }
  return run_consumer_pretag_gates_validated(targets, adapter, policy, recorder, explicit_runs)
}
