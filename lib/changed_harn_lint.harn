import { command_run } from "std/command"

pub type ChangedHarnLineRange = {path: string, start: int, end: int}

pub type ChangedHarnLintFinding = {path: string, line: int, code: string, message: string}

pub type ChangedHarnLintGate = {
  ok: bool,
  kind: string,
  paths: list<string>,
  status: int,
  detail: string,
  stdout: string,
  stderr: string,
}

/**
 * Convert Git's normal line-delimited name stream to source paths to lint.
 * Git emits paths in tree order; preserve that stable order and do not trim
 * filenames, because spaces are valid in a Git path.
 */
pub fn changed_harn_paths(diff_output: string) -> list<string> {
  let paths: list<string> = []
  for path in split(diff_output, "\n") {
    if path != "" && ends_with(path, ".harn") && !paths.contains(path) {
      paths = paths.push(path)
    }
  }
  return paths
}

/**
 * Git C-quotes paths containing a newline, quote, tab, or other unusual byte
 * in its non-NUL output. Harn command stdout is text and cannot transport the
 * NUL-delimited form without truncation, so reject those paths rather than
 * accidentally linting a decoded spelling that does not exist on disk.
 */
pub fn quoted_git_paths(diff_output: string) -> list<string> {
  let paths: list<string> = []
  for path in split(diff_output, "\n") {
    if starts_with(path, "\"") && !paths.contains(path) {
      paths = paths.push(path)
    }
  }
  return paths
}

pub fn changed_harn_diff_argv(base: string, head: string) -> list<string> {
  return ["git", "diff", "--name-only", "--diff-filter=ACMR", base + "..." + head, "--", "*.harn"]
}

pub fn changed_harn_patch_argv(base: string, head: string, paths: list<string>) -> list<string> {
  return ["git", "diff", "--no-color", "--unified=0", base + "..." + head, "--"] + paths
}

pub fn strict_harn_lint_argv(harn_bin: string, paths: list<string>) -> list<string> {
  return [harn_bin, "lint", "--strict", "--json", "--"] + paths
}

fn patch_path(line: string) -> string {
  if starts_with(line, "+++ b/") {
    return line[6:]
  }
  return ""
}

fn hunk_added_range(path: string, line: string) -> list<ChangedHarnLineRange> {
  const matches = regex_captures("^@@ -[0-9]+(?:,[0-9]+)? \\+([0-9]+)(?:,([0-9]+))? @@", line)
  if matches == nil || len(matches) == 0 || path == "" {
    return []
  }
  const start = to_int(matches[0].groups[0]) ?? 0
  const count = to_int(matches[0].groups[1] ?? "1") ?? 0
  if start <= 0 || count <= 0 {
    return []
  }
  return [{path: path, start: start, end: start + count - 1}]
}

/** Parse added line ranges from a zero-context Git patch. */
pub fn changed_harn_line_ranges(patch_output: string) -> list<ChangedHarnLineRange> {
  let path = ""
  let ranges: list<ChangedHarnLineRange> = []
  for line in split(patch_output, "\n") {
    if starts_with(line, "+++ ") {
      path = patch_path(line)
      continue
    }
    ranges = ranges + hunk_added_range(path, line)
  }
  return ranges
}

fn utf8_byte_length(text: string) -> int {
  return len(bytes_from_string(text))
}

/** Return the one-based source line containing a UTF-8 byte offset. */
pub fn source_line_at_byte(source: string, byte_offset: int) -> int {
  if byte_offset < 0 {
    return 0
  }
  let line = 1
  let offset = 0
  for text_line in split(source, "\n") {
    if byte_offset <= offset + utf8_byte_length(text_line) {
      return line
    }
    offset = offset + utf8_byte_length(text_line) + 1
    line = line + 1
  }
  return line
}

/** Decode the stable `harn lint --json` diagnostic contract. */
pub fn lint_json_diagnostics(raw: string) {
  const envelope = try {
    json_parse(raw)
  } catch (_e) {
    nil
  }
  if envelope == nil || envelope.data == nil || envelope.data.files == nil {
    return {ok: false, error: "harn lint did not return a valid JSON diagnostic envelope", diagnostics: []}
  }
  let diagnostics: list<dict> = []
  for file in envelope.data.files {
    for diagnostic in file?.diagnostics ?? [] {
      diagnostics = diagnostics
        + [
        {
          path: file?.path ?? "",
          severity: diagnostic?.severity ?? "error",
          code: diagnostic?.code ?? "HARN-LINT-UNKNOWN",
          message: diagnostic?.message ?? "lint diagnostic without message",
          start: to_int(diagnostic?.span?.start) ?? -1,
          has_span: diagnostic?.span != nil,
        },
      ]
    }
  }
  return {ok: true, error: "", diagnostics: diagnostics}
}

fn path_ranges(path: string, ranges: list<ChangedHarnLineRange>) -> list<ChangedHarnLineRange> {
  return ranges.filter({ range -> range.path == path }).to_list()
}

/**
 * Select strict diagnostics whose source spans intersect added lines. Any
 * warning/error lacking a span fails closed because it cannot be proven to
 * predate the candidate change. Informational diagnostics do not affect
 * `harn lint --strict` and are intentionally omitted.
 */
fn changed_lint_finding_for(diagnostic, ranges, source_reader) -> list<ChangedHarnLintFinding> {
  if diagnostic?.severity == "info" {
    return []
  }
  const path = diagnostic?.path ?? ""
  const relevant_ranges = path_ranges(path, ranges)
  if len(relevant_ranges) == 0 {
    return []
  }
  if !(diagnostic?.has_span ?? false) {
    return [
      {
        path: path,
        line: 0,
        code: diagnostic?.code ?? "HARN-LINT-UNKNOWN",
        message: diagnostic?.message ?? "lint diagnostic without source span",
      },
    ]
  }
  const source = source_reader(path)
  if source == nil {
    return [
      {
        path: path,
        line: 0,
        code: "HARN-LINT-SOURCE-READ",
        message: "could not read changed source while locating lint diagnostic",
      },
    ]
  }
  const line = source_line_at_byte(source, to_int(diagnostic?.start) ?? -1)
  for range in relevant_ranges {
    if line >= range.start && line <= range.end {
      return [
        {
          path: path,
          line: line,
          code: diagnostic?.code ?? "HARN-LINT-UNKNOWN",
          message: diagnostic?.message ?? "lint diagnostic without message",
        },
      ]
    }
  }
  return []
}

pub fn changed_lint_findings(diagnostics, ranges, source_reader) -> list<ChangedHarnLintFinding> {
  let findings: list<ChangedHarnLintFinding> = []
  for diagnostic in diagnostics ?? [] {
    findings = findings + changed_lint_finding_for(diagnostic, ranges, source_reader)
  }
  return findings
}

fn command_text(result) -> string {
  const stdout = result?.stdout ?? ""
  const stderr = result?.stderr ?? ""
  if trim(stderr) != "" {
    return trim(stderr)
  }
  return trim(stdout)
}

fn run_command(repo: string, argv: list<string>, runner = nil) {
  if runner != nil {
    return runner({repo: repo, argv: argv})
  }
  return command_run({argv: argv, cwd: repo, capture: {max_inline_bytes: 33554432}}, {timeout_ms: 30000})
}

fn read_changed_source(harness: Harness, repo: string, path: string, source_reader = nil) {
  if source_reader != nil {
    return source_reader({repo: repo, path: path})
  }
  return try {
    harness.fs.read_text(path_join(repo, path))
  } catch (_e) {
    nil
  }
}

fn finding_text(findings: list<ChangedHarnLintFinding>) -> string {
  return join(
    findings
      .map(
      { finding -> "${finding.path}:${to_string(finding.line)}: ${finding.code}: ${finding.message}" },
    ),
    "\n",
  )
}

/**
 * Enforce strict lint for newly added Harn source lines between explicit Git
 * refs. Existing diagnostics in a touched legacy file are retained in the
 * machine-readable lint report but do not block unrelated safe maintenance.
 * A malformed diff, report, source read, or span-less warning/error fails the
 * gate rather than weakening it silently.
 */
pub fn changed_harn_lint_gate(
  harness: Harness,
  repo: string,
  base: string,
  head: string,
  harn_bin: string,
  runner = nil,
  source_reader = nil,
) -> ChangedHarnLintGate {
  const normalized_base = trim(base)
  const normalized_head = trim(head)
  if normalized_base == "" || normalized_head == "" {
    return {
      ok: false,
      kind: "invalid_range",
      paths: [],
      status: 2,
      detail: "strict Harn lint requires non-empty --base and --head refs",
      stdout: "",
      stderr: "",
    }
  }
  const diff = run_command(repo, changed_harn_diff_argv(normalized_base, normalized_head), runner)
  if !(diff.success ?? false) {
    return {
      ok: false,
      kind: "diff_failed",
      paths: [],
      status: to_int(diff.status) ?? 1,
      detail: "could not list changed Harn files for ${normalized_base}...${normalized_head}: "
        + command_text(diff),
      stdout: diff.stdout ?? "",
      stderr: diff.stderr ?? "",
    }
  }
  const quoted_paths = quoted_git_paths(diff.stdout ?? "")
  if len(quoted_paths) > 0 {
    return {
      ok: false,
      kind: "quoted_git_path",
      paths: [],
      status: 2,
      detail: "strict Harn lint cannot safely decode Git-quoted changed path(s): "
        + join(quoted_paths, ", ")
        + "; rename them or add binary command-output support before bypassing this gate",
      stdout: diff.stdout ?? "",
      stderr: diff.stderr ?? "",
    }
  }
  const paths = changed_harn_paths(diff.stdout ?? "")
  if len(paths) == 0 {
    return {
      ok: true,
      kind: "no_changed_harn",
      paths: [],
      status: 0,
      detail: "no added, copied, renamed, or modified Harn files in ${normalized_base}...${normalized_head}",
      stdout: "",
      stderr: "",
    }
  }
  const patch = run_command(repo, changed_harn_patch_argv(normalized_base, normalized_head, paths), runner)
  if !(patch.success ?? false) {
    return {
      ok: false,
      kind: "patch_failed",
      paths: paths,
      status: to_int(patch.status) ?? 1,
      detail: "could not read changed Harn line ranges: " + command_text(patch),
      stdout: patch.stdout ?? "",
      stderr: patch.stderr ?? "",
    }
  }
  const lint = run_command(repo, strict_harn_lint_argv(harn_bin, paths), runner)
  const decoded = lint_json_diagnostics(lint.stdout ?? "")
  if !decoded.ok {
    return {
      ok: false,
      kind: "lint_json_invalid",
      paths: paths,
      status: to_int(lint.status) ?? 1,
      detail: decoded.error,
      stdout: lint.stdout ?? "",
      stderr: lint.stderr ?? "",
    }
  }
  const ranges = changed_harn_line_ranges(patch.stdout ?? "")
  if len(ranges) == 0 {
    return {
      ok: true,
      kind: "no_added_harn_lines",
      paths: paths,
      status: 0,
      detail: "no added Harn source lines in ${normalized_base}...${normalized_head}",
      stdout: lint.stdout ?? "",
      stderr: lint.stderr ?? "",
    }
  }
  const findings = changed_lint_findings(
    decoded.diagnostics,
    ranges,
    { path -> read_changed_source(harness, repo, path, source_reader) },
  )
  if len(findings) > 0 {
    return {
      ok: false,
      kind: "changed_strict_lint_failed",
      paths: paths,
      status: 1,
      detail: "strict Harn lint found diagnostics on added source lines:\n" + finding_text(findings),
      stdout: lint.stdout ?? "",
      stderr: lint.stderr ?? "",
    }
  }
  return {
    ok: true,
    kind: "changed_strict_lint_passed",
    paths: paths,
    status: 0,
    detail: "strict Harn lint passed for added source lines in " + join(paths, ", "),
    stdout: lint.stdout ?? "",
    stderr: lint.stderr ?? "",
  }
}
