import { command_run } from "std/command"

pub type ChangedHarnLineRange = {path: string, start: int, end: int}

pub type ChangedHarnLintSpan = {start: int, end: int}

pub type ChangedHarnLintSeverity = "info" | "warning" | "error"

pub type ChangedHarnLintDiagnostic = {
  path: string,
  severity: ChangedHarnLintSeverity,
  code: string?,
  message: string,
  span: ChangedHarnLintSpan?,
}

pub type ChangedHarnLintDecode = {
  ok: bool,
  lint_ok: bool,
  error: string,
  diagnostics: list<ChangedHarnLintDiagnostic>,
}

pub type ChangedHarnLintFinding = {path: string, line: int, code: string, message: string}

pub type ChangedHarnLintSelection = {
  ok: bool,
  error: string,
  findings: list<ChangedHarnLintFinding>,
}

type ChangedHarnSourceLineInterval = {start: int, end: int}

pub type ChangedHarnLintGate = {
  ok: bool,
  kind: string,
  paths: list<string>,
  status: int,
  detail: string,
  stdout: string,
  stderr: string,
}

/**
 * Convert Git's normal line-delimited name stream to source paths to lint.
 * Git emits paths in tree order; preserve that stable order and do not trim
 * filenames, because spaces are valid in a Git path.
 */
pub fn changed_harn_paths(diff_output: string) -> list<string> {
  let paths: list<string> = []
  for path in split(diff_output, "\n") {
    if path != "" && ends_with(path, ".harn") && !paths.contains(path) {
      paths = paths.push(path)
    }
  }
  return paths
}

/**
 * Git C-quotes paths containing a newline, quote, tab, or other unusual byte
 * in its non-NUL output. Harn command stdout is text and cannot transport the
 * NUL-delimited form without truncation, so reject those paths rather than
 * accidentally linting a decoded spelling that does not exist on disk.
 */
pub fn quoted_git_paths(diff_output: string) -> list<string> {
  let paths: list<string> = []
  for path in split(diff_output, "\n") {
    if starts_with(path, "\"") && !paths.contains(path) {
      paths = paths.push(path)
    }
  }
  return paths
}

pub fn changed_harn_diff_argv(base: string, head: string) -> list<string> {
  return ["git", "diff", "--name-only", "--diff-filter=ACMR", base + "..." + head, "--", "*.harn"]
}

pub fn changed_harn_patch_argv(base: string, head: string, paths: list<string>) -> list<string> {
  return ["git", "diff", "--no-color", "--unified=0", base + "..." + head, "--"] + paths
}

pub fn strict_harn_lint_argv(harn_bin: string, paths: list<string>) -> list<string> {
  return [harn_bin, "lint", "--strict", "--json", "--"] + paths
}

fn patch_path(line: string) -> string {
  if starts_with(line, "+++ b/") {
    return line[6:]
  }
  return ""
}

fn hunk_added_range(path: string, line: string) -> list<ChangedHarnLineRange> {
  const matches = regex_captures("^@@ -[0-9]+(?:,[0-9]+)? \\+([0-9]+)(?:,([0-9]+))? @@", line)
  if matches == nil || len(matches) == 0 || path == "" {
    return []
  }
  const start = to_int(matches[0].groups[0]) ?? 0
  const count = to_int(matches[0].groups[1] ?? "1") ?? 0
  if start <= 0 || count <= 0 {
    return []
  }
  return [{path: path, start: start, end: start + count - 1}]
}

/** Parse added line ranges from a zero-context Git patch. */
pub fn changed_harn_line_ranges(patch_output: string) -> list<ChangedHarnLineRange> {
  let path = ""
  let ranges: list<ChangedHarnLineRange> = []
  for line in split(patch_output, "\n") {
    if starts_with(line, "+++ ") {
      path = patch_path(line)
      continue
    }
    ranges = ranges + hunk_added_range(path, line)
  }
  return ranges
}

fn utf8_byte_length(text: string) -> int {
  return len(bytes_from_string(text))
}

/**
 * Return the one-based source line at a UTF-8 byte position. A position on a
 * newline belongs to the preceding line; the position after that newline
 * belongs to the following line. The EOF position is valid.
 */
pub fn source_line_at_byte(source: string, byte_offset: int) -> int {
  if byte_offset < 0 || byte_offset > utf8_byte_length(source) {
    return 0
  }
  let line = 1
  let offset = 0
  for text_line in split(source, "\n") {
    if byte_offset <= offset + utf8_byte_length(text_line) {
      return line
    }
    offset = offset + utf8_byte_length(text_line) + 1
    line = line + 1
  }
  return 0
}

fn invalid_lint_json(detail: string) -> ChangedHarnLintDecode {
  return {ok: false, lint_ok: false, error: "invalid harn lint JSON: " + detail, diagnostics: []}
}

fn is_nonnegative_int(value) -> bool {
  return type_of(value) == "int" && value >= 0
}

fn is_nonempty_string(value) -> bool {
  return type_of(value) == "string" && value != ""
}

fn valid_lint_summary(summary) -> bool {
  if type_of(summary) != "dict" {
    return false
  }
  return is_nonnegative_int(summary?.ok)
    && is_nonnegative_int(summary?.warnings)
    && is_nonnegative_int(summary?.errors)
    && is_nonnegative_int(summary?.diagnostics)
    && is_nonnegative_int(summary?.fixable)
    && is_nonnegative_int(summary?.fixed)
}

fn valid_envelope_error(error) -> bool {
  return type_of(error) == "dict"
    && is_nonempty_string(error?.code)
    && is_nonempty_string(error?.message)
    && error.has("details")
}

fn valid_envelope_warnings(warnings) -> bool {
  if type_of(warnings) != "list" {
    return false
  }
  for warning in warnings {
    if type_of(warning) != "dict"
      || !is_nonempty_string(warning?.code)
      || !is_nonempty_string(warning?.message) {
      return false
    }
  }
  return true
}

fn decode_lint_diagnostic(path: string, diagnostic, location: string) -> ChangedHarnLintDecode {
  if type_of(diagnostic) != "dict" {
    return invalid_lint_json(location + " must be an object")
  }
  if !is_nonempty_string(diagnostic?.source) {
    return invalid_lint_json(location + ".source must be a non-empty string")
  }
  if type_of(diagnostic?.severity) != "string"
    || !(diagnostic.severity == "info"
    || diagnostic.severity == "warning"
    || diagnostic.severity == "error") {
    return invalid_lint_json(location + ".severity must be info, warning, or error")
  }
  if diagnostic.has("code") && !is_nonempty_string(diagnostic.code) {
    return invalid_lint_json(location + ".code must be a non-empty string when present")
  }
  if !is_nonempty_string(diagnostic?.message) {
    return invalid_lint_json(location + ".message must be a non-empty string")
  }
  let span: ChangedHarnLintSpan? = nil
  if diagnostic.has("span") {
    if type_of(diagnostic.span) != "dict" {
      return invalid_lint_json(location + ".span must be an object when present")
    }
    if !is_nonnegative_int(diagnostic.span?.start) || !is_nonnegative_int(diagnostic.span?.end) {
      return invalid_lint_json(location + ".span.start and .span.end must be non-negative integers")
    }
    if diagnostic.span.end < diagnostic.span.start {
      return invalid_lint_json(location + ".span.end must be greater than or equal to .span.start")
    }
    span = {start: diagnostic.span.start, end: diagnostic.span.end}
  }
  const decoded: ChangedHarnLintDiagnostic = {
    path: path,
    severity: diagnostic.severity,
    code: diagnostic?.code,
    message: diagnostic.message,
    span: span,
  }
  return {ok: true, lint_ok: true, error: "", diagnostics: [decoded]}
}

fn lint_file_expected_status(diagnostics: list<ChangedHarnLintDiagnostic>) -> string {
  if diagnostics.any({ diagnostic -> diagnostic.severity == "error" }) {
    return "error"
  }
  if diagnostics.any({ diagnostic -> diagnostic.severity == "warning" }) {
    return "warning"
  }
  return "ok"
}

/** Decode and validate the stable schema-v1 `harn lint --json` contract. */
@complexity(allow)
pub fn lint_json_diagnostics(raw: string, expected_paths: list<string>) -> ChangedHarnLintDecode {
  const envelope = try {
    json_parse(raw)
  } catch (_e) {
    nil
  }
  if type_of(envelope) != "dict" {
    return invalid_lint_json("envelope must be an object")
  }
  if type_of(envelope?.schemaVersion) != "int" || envelope.schemaVersion != 1 {
    return invalid_lint_json("schemaVersion must be integer 1")
  }
  if type_of(envelope?.ok) != "bool" {
    return invalid_lint_json("ok must be a boolean")
  }
  if type_of(envelope?.data) != "dict" {
    return invalid_lint_json("data must be an object")
  }
  if !envelope.has("error") {
    return invalid_lint_json("error must be present")
  }
  if envelope.ok && envelope.error != nil {
    return invalid_lint_json("error must be null when ok is true")
  }
  if !envelope.ok && !valid_envelope_error(envelope?.error) {
    return invalid_lint_json("error must be a typed error object when ok is false")
  }
  if !valid_envelope_warnings(envelope?.warnings) {
    return invalid_lint_json("warnings must be a list of typed warning objects")
  }
  if type_of(envelope.data?.files) != "list" {
    return invalid_lint_json("data.files must be a list")
  }
  if !valid_lint_summary(envelope.data?.summary) {
    return invalid_lint_json("data.summary must contain non-negative integer counters")
  }
  let diagnostics: list<ChangedHarnLintDiagnostic> = []
  let seen_paths: list<string> = []
  let summary_ok = 0
  let summary_warnings = 0
  let summary_errors = 0
  let summary_diagnostics = 0
  let summary_fixable = 0
  let summary_fixed = 0
  let file_index = 0
  for file in envelope.data.files {
    const file_location = "data.files[${to_string(file_index)}]"
    if type_of(file) != "dict" {
      return invalid_lint_json(file_location + " must be an object")
    }
    if !is_nonempty_string(file?.path) || !expected_paths.contains(file.path) {
      return invalid_lint_json(file_location + ".path must match a requested Harn path")
    }
    if seen_paths.contains(file.path) {
      return invalid_lint_json(file_location + ".path must not be duplicated")
    }
    if type_of(file?.status) != "string"
      || !(file.status == "ok" || file.status == "warning" || file.status == "error") {
      return invalid_lint_json(file_location + ".status must be ok, warning, or error")
    }
    if type_of(file?.diagnostics) != "list" {
      return invalid_lint_json(file_location + ".diagnostics must be a list")
    }
    if !is_nonnegative_int(file?.fixable) || !is_nonnegative_int(file?.fixed) {
      return invalid_lint_json(file_location + ".fixable and .fixed must be non-negative integers")
    }
    seen_paths = seen_paths.push(file.path)
    let file_diagnostics: list<ChangedHarnLintDiagnostic> = []
    let diagnostic_index = 0
    for diagnostic in file.diagnostics {
      const decoded = decode_lint_diagnostic(
        file.path,
        diagnostic,
        file_location + ".diagnostics[${to_string(diagnostic_index)}]",
      )
      if !decoded.ok {
        return decoded
      }
      diagnostics = diagnostics + decoded.diagnostics
      file_diagnostics = file_diagnostics + decoded.diagnostics
      diagnostic_index = diagnostic_index + 1
    }
    const expected_status = lint_file_expected_status(file_diagnostics)
    if file.status != expected_status {
      return invalid_lint_json(file_location + ".status is inconsistent with diagnostic severities")
    }
    if file.status == "ok" {
      summary_ok = summary_ok + 1
    } else if file.status == "warning" {
      summary_warnings = summary_warnings + 1
    } else {
      summary_errors = summary_errors + 1
    }
    summary_diagnostics = summary_diagnostics + len(file_diagnostics)
    summary_fixable = summary_fixable + file.fixable
    summary_fixed = summary_fixed + file.fixed
    file_index = file_index + 1
  }
  for path in expected_paths {
    if !seen_paths.contains(path) {
      return invalid_lint_json("data.files is missing requested path " + path)
    }
  }
  const summary = envelope.data.summary
  if summary.ok != summary_ok
    || summary.warnings != summary_warnings
    || summary.errors != summary_errors
    || summary.diagnostics != summary_diagnostics
    || summary.fixable != summary_fixable
    || summary.fixed != summary_fixed {
    return invalid_lint_json("data.summary counters are inconsistent with data.files")
  }
  const lint_ok = summary_warnings == 0 && summary_errors == 0
  if envelope.ok != lint_ok {
    return invalid_lint_json("ok is inconsistent with strict lint file statuses")
  }
  if !lint_ok && envelope.error.code != "lint_failed" {
    return invalid_lint_json("error.code must be lint_failed when strict lint fails")
  }
  return {ok: true, lint_ok: lint_ok, error: "", diagnostics: diagnostics}
}

fn path_ranges(path: string, ranges: list<ChangedHarnLineRange>) -> list<ChangedHarnLineRange> {
  return ranges.filter({ range -> range.path == path }).to_list()
}

/**
 * Harn source spans are half-open UTF-8 byte intervals: start is inclusive and
 * end is exclusive. A zero-width span is anchored at its start position. Map
 * non-empty spans through end - 1 so a diagnostic ending at the start of the
 * next line does not claim that line.
 */
fn source_line_interval_for_span(source: string, span: ChangedHarnLintSpan) -> ChangedHarnSourceLineInterval? {
  const source_bytes = utf8_byte_length(source)
  if span.start < 0 || span.end < span.start || span.end > source_bytes {
    return nil
  }
  const final_position = if span.start == span.end {
    span.start
  } else {
    span.end - 1
  }
  const start_line = source_line_at_byte(source, span.start)
  const end_line = source_line_at_byte(source, final_position)
  if start_line == 0 || end_line == 0 {
    return nil
  }
  return {start: start_line, end: end_line}
}

fn changed_lint_finding_for(
  diagnostic: ChangedHarnLintDiagnostic,
  ranges: list<ChangedHarnLineRange>,
  source_reader,
) -> ChangedHarnLintSelection {
  if diagnostic.severity == "info" {
    return {ok: true, error: "", findings: []}
  }
  const relevant_ranges = path_ranges(diagnostic.path, ranges)
  if len(relevant_ranges) == 0 {
    return {ok: true, error: "", findings: []}
  }
  const source = source_reader(diagnostic.path)
  if type_of(source) != "string" {
    return {ok: false, error: "could not read changed source " + diagnostic.path, findings: []}
  }
  if diagnostic.span == nil {
    return {ok: false, error: "lint diagnostic has no source span for " + diagnostic.path, findings: []}
  }
  const interval = source_line_interval_for_span(source, diagnostic.span)
  if interval == nil {
    return {
      ok: false,
      error: "lint diagnostic span is outside the UTF-8 source byte range for " + diagnostic.path,
      findings: [],
    }
  }
  for range in relevant_ranges {
    if interval.start <= range.end && interval.end >= range.start {
      return {
        ok: true,
        error: "",
        findings: [
          {
            path: diagnostic.path,
            line: if interval.start >= range.start {
              interval.start
            } else {
              range.start
            },
            code: diagnostic.code ?? "HARN-LINT-UNKNOWN",
            message: diagnostic.message,
          },
        ],
      }
    }
  }
  return {ok: true, error: "", findings: []}
}

pub fn changed_lint_findings(
  diagnostics: list<ChangedHarnLintDiagnostic>,
  ranges: list<ChangedHarnLineRange>,
  source_reader,
) -> ChangedHarnLintSelection {
  let findings: list<ChangedHarnLintFinding> = []
  for diagnostic in diagnostics {
    const selected = changed_lint_finding_for(diagnostic, ranges, source_reader)
    if !selected.ok {
      return selected
    }
    findings = findings + selected.findings
  }
  return {ok: true, error: "", findings: findings}
}

fn command_text(result) -> string {
  const stdout = result?.stdout ?? ""
  const stderr = result?.stderr ?? ""
  if trim(stderr) != "" {
    return trim(stderr)
  }
  return trim(stdout)
}

fn command_exit_code(result) -> int {
  const exit_code = to_int(result?.exit_code)
  if exit_code != nil {
    return exit_code
  }
  const legacy_status = to_int(result?.status)
  if legacy_status != nil {
    return legacy_status
  }
  return if result?.success ?? false {
    0
  } else {
    1
  }
}

fn run_command(repo: string, argv: list<string>, runner = nil) {
  if runner != nil {
    return runner({repo: repo, argv: argv})
  }
  return command_run({argv: argv, cwd: repo, capture: {max_inline_bytes: 33554432}}, {timeout_ms: 30000})
}

fn read_changed_source(harness: Harness, repo: string, path: string, source_reader = nil) {
  if source_reader != nil {
    return source_reader({repo: repo, path: path})
  }
  return try {
    harness.fs.read_text(path_join(repo, path))
  } catch (_e) {
    nil
  }
}

fn finding_text(findings: list<ChangedHarnLintFinding>) -> string {
  return join(
    findings
      .map(
      { finding -> "${finding.path}:${to_string(finding.line)}: ${finding.code}: ${finding.message}" },
    ),
    "\n",
  )
}

/**
 * Enforce strict lint for newly added Harn source lines between explicit Git
 * refs. Existing diagnostics in a touched legacy file are retained in the
 * machine-readable lint report but do not block unrelated safe maintenance.
 * A malformed diff, report, source read, or span-less warning/error fails the
 * gate rather than weakening it silently.
 */
pub fn changed_harn_lint_gate(
  harness: Harness,
  repo: string,
  base: string,
  head: string,
  harn_bin: string,
  runner = nil,
  source_reader = nil,
) -> ChangedHarnLintGate {
  const normalized_base = trim(base)
  const normalized_head = trim(head)
  if normalized_base == "" || normalized_head == "" {
    return {
      ok: false,
      kind: "invalid_range",
      paths: [],
      status: 2,
      detail: "strict Harn lint requires non-empty --base and --head refs",
      stdout: "",
      stderr: "",
    }
  }
  const diff = run_command(repo, changed_harn_diff_argv(normalized_base, normalized_head), runner)
  if !(diff.success ?? false) {
    return {
      ok: false,
      kind: "diff_failed",
      paths: [],
      status: command_exit_code(diff),
      detail: "could not list changed Harn files for ${normalized_base}...${normalized_head}: "
        + command_text(diff),
      stdout: diff.stdout ?? "",
      stderr: diff.stderr ?? "",
    }
  }
  const quoted_paths = quoted_git_paths(diff.stdout ?? "")
  if len(quoted_paths) > 0 {
    return {
      ok: false,
      kind: "quoted_git_path",
      paths: [],
      status: 2,
      detail: "strict Harn lint cannot safely decode Git-quoted changed path(s): "
        + join(quoted_paths, ", ")
        + "; rename them or add binary command-output support before bypassing this gate",
      stdout: diff.stdout ?? "",
      stderr: diff.stderr ?? "",
    }
  }
  const paths = changed_harn_paths(diff.stdout ?? "")
  if len(paths) == 0 {
    return {
      ok: true,
      kind: "no_changed_harn",
      paths: [],
      status: 0,
      detail: "no added, copied, renamed, or modified Harn files in ${normalized_base}...${normalized_head}",
      stdout: "",
      stderr: "",
    }
  }
  const patch = run_command(repo, changed_harn_patch_argv(normalized_base, normalized_head, paths), runner)
  if !(patch.success ?? false) {
    return {
      ok: false,
      kind: "patch_failed",
      paths: paths,
      status: command_exit_code(patch),
      detail: "could not read changed Harn line ranges: " + command_text(patch),
      stdout: patch.stdout ?? "",
      stderr: patch.stderr ?? "",
    }
  }
  const lint = run_command(repo, strict_harn_lint_argv(harn_bin, paths), runner)
  const decoded = lint_json_diagnostics(lint.stdout ?? "", paths)
  if !decoded.ok {
    return {
      ok: false,
      kind: "lint_json_invalid",
      paths: paths,
      status: command_exit_code(lint),
      detail: decoded.error,
      stdout: lint.stdout ?? "",
      stderr: lint.stderr ?? "",
    }
  }
  const lint_status = command_exit_code(lint)
  const expected_lint_status = if decoded.lint_ok {
    0
  } else {
    1
  }
  if lint_status != expected_lint_status {
    return {
      ok: false,
      kind: "lint_status_invalid",
      paths: paths,
      status: lint_status,
      detail: "harn lint exit status ${to_string(lint_status)} disagrees with its JSON envelope",
      stdout: lint.stdout ?? "",
      stderr: lint.stderr ?? "",
    }
  }
  const ranges = changed_harn_line_ranges(patch.stdout ?? "")
  if len(ranges) == 0 {
    return {
      ok: true,
      kind: "no_added_harn_lines",
      paths: paths,
      status: 0,
      detail: "no added Harn source lines in ${normalized_base}...${normalized_head}",
      stdout: lint.stdout ?? "",
      stderr: lint.stderr ?? "",
    }
  }
  const findings = changed_lint_findings(
    decoded.diagnostics,
    ranges,
    { path -> read_changed_source(harness, repo, path, source_reader) },
  )
  if !findings.ok {
    return {
      ok: false,
      kind: "lint_span_invalid",
      paths: paths,
      status: 1,
      detail: findings.error,
      stdout: lint.stdout ?? "",
      stderr: lint.stderr ?? "",
    }
  }
  if len(findings.findings) > 0 {
    return {
      ok: false,
      kind: "changed_strict_lint_failed",
      paths: paths,
      status: 1,
      detail: "strict Harn lint found diagnostics on added source lines:\n"
        + finding_text(findings.findings),
      stdout: lint.stdout ?? "",
      stderr: lint.stderr ?? "",
    }
  }
  return {
    ok: true,
    kind: "changed_strict_lint_passed",
    paths: paths,
    status: 0,
    detail: "strict Harn lint passed for added source lines in " + join(paths, ", "),
    stdout: lint.stdout ?? "",
    stderr: lint.stderr ?? "",
  }
}
