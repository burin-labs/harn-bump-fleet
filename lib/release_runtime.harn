  name: "release-harn",
  args: [
    {kind: "flag", name: "repo", long: "--repo", default: DEFAULT_REPO},
    {kind: "flag", name: "base", long: "--base", default: DEFAULT_BASE},
    {kind: "flag", name: "bump", long: "--bump", default: "patch"},
    {kind: "flag", name: "mode", long: "--mode", default: "audit"},
    {kind: "switch", name: "agent", long: "--agent"},
    {kind: "flag", name: "model", long: "--model", default: DEFAULT_MODEL},
    {kind: "flag", name: "provider", long: "--provider", default: DEFAULT_PROVIDER},
    {kind: "switch", name: "mock", long: "--mock"},
    {kind: "switch", name: "rehearsal", long: "--rehearsal"},
    {kind: "switch", name: "help", short: "-h", long: "--help"},
    {kind: "switch", name: "bootstrap_new_crates", long: "--bootstrap-new-crates"},
    {kind: "flag", name: "release_focus", long: "--focus", default: ""},
    {kind: "switch", name: "yes_live_release", long: "--yes-live-release"},
    {kind: "flag", name: "pin_sha_input", long: "--at-sha", default: ""},
    {kind: "switch", name: "allow_base_drift", long: "--allow-base-drift"},
    {kind: "flag", name: "expect_pr", long: "--expect-pr", multi: true, default: []},
    {kind: "flag", name: "reject_pr", long: "--reject-pr", multi: true, default: []},
    {kind: "switch", name: "local_audit", long: "--local-audit"},
    {kind: "switch", name: "self_update", long: "--self-update"},
    {kind: "switch", name: "wait_build_lock", long: "--wait"},
    {kind: "switch", name: "no_chat", long: "--no-chat"},
    {kind: "switch", name: "chat_only", long: "--chat-only"},
    {kind: "flag", name: "chat_run", long: "--chat-run", default: ""},
    {kind: "flag", name: "chat_timeout_s", long: "--chat-timeout-s", parse: "int", default: 60},
  ],
}

pub fn parse_release_scope_pr_numbers(values: list<string>) -> list<int> {
  let out = []
  let seen = {}
  for value in values {
    for part in split(to_string(value ?? ""), ",") {
      const trimmed = trim(part)
      if trimmed == "" {
        continue
      }
      const normalized = if starts_with(trimmed, "#") {
        trimmed[1:len(trimmed)]
      } else {
        trimmed
      }
      const number = to_int(normalized)
      if number == nil || number <= 0 || to_string(number) != normalized {
        throw "invalid release scope PR number: " + trimmed
      }
      const key = to_string(number)
      if !(seen[key] ?? false) {
        seen[key] = true
        out = out + [number]
      }
    }
  }
  return out
}

pub fn parse_release_args(harness: Harness, args: list<string>) -> ReleaseConfig {
  const parsed = cli_options<ReleaseCliOptions>(
    RELEASE_ARG_SPEC,
    args,
    schema_of(ReleaseCliOptions),
  )
  const bootstrap = parsed.bootstrap_new_crates
    || env_bool("HARN_RELEASE_BOOTSTRAP_NEW_CRATES", false)
  const release_focus = if parsed.release_focus != "" {
    parsed.release_focus
  } else {
    env_str("HARN_RELEASE_FOCUS") ?? ""
  }
  const pin_sha_input = if parsed.pin_sha_input != "" {
    parsed.pin_sha_input
  } else {
    env_str("HARN_RELEASE_PIN_SHA") ?? ""
  }
  const expected_prs = parse_release_scope_pr_numbers(
    (parsed.expect_pr ?? []) + [env_str("HARN_RELEASE_EXPECT_PRS") ?? ""],
  )
  const rejected_prs = parse_release_scope_pr_numbers(
    (parsed.reject_pr ?? []) + [env_str("HARN_RELEASE_REJECT_PRS") ?? ""],
  )
  const release_cargo_target_dir = resolve_release_cargo_target_dir(
    env_str("HARN_RELEASE_CARGO_TARGET_DIR") ?? "",
    env_str("HOME") ?? "",
    env_str("XDG_CACHE_HOME") ?? "",
  )
  const cfg: ReleaseConfig = {
    repo: expand_home(harness, parsed.repo),
    source_repo: expand_home(harness, parsed.repo),
    release_workspace: "",
    release_workspace_managed: false,
    base: parsed.base,
    bump: parsed.bump,
    mode: parsed.mode,
    agent: parsed.agent,
    model: parsed.model,
    provider: parsed.provider,
    mock: parsed.mock,
    rehearsal: parsed.rehearsal,
    help: parsed.help,
    bootstrap_new_crates: bootstrap,
    release_cargo_target_dir: release_cargo_target_dir,
    release_focus: release_focus,
    yes_live_release: parsed.yes_live_release,
    pin_sha_input: pin_sha_input,
    pin_sha: "",
    planner_source: DEFAULT_PLANNER.source,
    planner_preflight: nil,
    fixup_mode: false,
    skip_tag: false,
    fixup_tag: "",
    fixup_pr_url: "",
    fixup_publication: nil,
    fixup_pin_unreleased: "",
    fixup_release_body_source: "",
    pre_tag_resume: false,
    pre_tag_supersede: false,
    allow_base_drift: parsed.allow_base_drift,
    expected_prs: expected_prs,
    rejected_prs: rejected_prs,
    local_audit: parsed.local_audit || env_bool("HARN_RELEASE_LOCAL_AUDIT", false),
    no_chat: parsed.no_chat,
    chat_only: parsed.chat_only,
    chat_run: parsed.chat_run,
    chat_timeout_s: parsed.chat_timeout_s,
    self_update: parsed.self_update || env_bool("FLEET_SELF_UPDATE", false),
    wait_build_lock: parsed.wait_build_lock || env_bool("HARN_RELEASE_WAIT_BUILD_LOCK", false),
  }
  if cfg.help {
    return cfg
  }
  return cfg
}

pub fn expand_home(harness: Harness, path: string) -> string {
  if path == "~" {
    return harness.env.get_or("HOME", "")
  }
  if starts_with(path, "~/") {
    return harness.env.get_or("HOME", "") + path[1:len(path)]
  }
  return path
}

/**
 * Resolve `cfg.pin_sha_input` (or `origin/<base>` when no input is given)
 * to a concrete 40-char commit SHA. Frozen here so every downstream step
 * — branch creation, audit ranges, PR body, tag push — uses the same
 * commit even if `origin/<base>` advances mid-run.
 */
pub fn resolve_pin_sha(cfg: ReleasePinConfig) -> string {
  if cfg.mock {
    if cfg.pin_sha_input != "" {
      return cfg.pin_sha_input
    }
    return MOCK_PIN_SHA
  }
  const refresh_base = cfg.mode != "audit" || cfg.yes_live_release
  // Read-only explicit-pin audits retain their local-only contract. Every
  // mutating release, including an explicit pin, refreshes and proves the
  // requested base before any release work starts.
  const base_head = if cfg.pin_sha_input != "" && !refresh_base {
    ""
  } else {
    release_base_head(cfg, refresh_base)
  }
  if cfg.pin_sha_input != "" {
    const raw = trim(cfg.pin_sha_input)
    const r = git_run(["rev-parse", "--verify", raw + "^{commit}"], {repo: cfg.repo})
    if !r.success {
      throw "--at-sha did not resolve to a commit: ${raw}\n${trim(r.stderr)}"
    }
    const pin_sha = trim(r.stdout)
    if refresh_base && !(cfg.allow_base_drift ?? false) {
      const ancestry = git_run(
        ["merge-base", "--is-ancestor", pin_sha, base_head],
        {repo: cfg.repo},
      )
      if !ancestry.success {
        throw "--at-sha ${pin_sha} is not an ancestor of refreshed origin/${cfg.base}; use --allow-base-drift only for an intentional divergent release"
      }
    }
    return pin_sha
  }
  return base_head
}

/**
 * Resolve the release base after optionally refreshing only its exact
 * remote-tracking ref. Never inherit a recovery checkout's remote refspec:
 * it can name a deleted release branch unrelated to the requested base.
 */
fn release_base_head(cfg, refresh) {
  if refresh {
    const fetch_args = base_ref_fetch_args(cfg.base)
    const fetched = git_run(fetch_args, {repo: cfg.repo})
    if !fetched.success {
      throw "failed to fetch required origin/${cfg.base} with explicit refspec ${base_ref_fetch_command(cfg.base)}; checkout remote.origin.fetch was not used:\n${trim(fetched.stderr)}"
    }
  }
  const r = git_run(["rev-parse", "--verify", "origin/${cfg.base}^{commit}"], {repo: cfg.repo})
  if !r.success {
    throw "failed to resolve origin/${cfg.base} after release base-ref preflight:\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

fn release_command_result(result) -> ReleaseCommandResult {
  return {
    success: result.success,
    ok: result.ok ?? result.success,
    status: result.status
      ?? if result.success {
      "completed"
    } else {
      "failed"
    },
    exit_code: result.exit_code,
    stdout: result.stdout ?? "",
    stderr: result.stderr ?? "",
  }
}

pub fn run_cmd(cfg: dict, command: string) -> ReleaseCommandResult {
  if cfg.mock {
    return release_command_result(fake_command(command, cfg))
  }
  return release_command_result(shell_at(cfg.repo, command))
}

/**
 * Run a local git command in argv form, scoped to `cfg.repo`.
 *
 * Routes through `fake_command` in mock mode so the legacy substring-keyed
 * mock fixtures continue to match; otherwise dispatches to `std/git`
 * `git_run`, which executes argv without shell quoting and strips ambient
 * GIT_* env.
 */
pub fn run_git(
  cfg: dict,
  args: list<string>,
  options: ReleaseGitRunOptions = {},
) -> ReleaseCommandResult {
  if cfg.mock {
    return release_command_result(fake_command(argv_label(["git"] + args), cfg, options.env))
  }
  return release_command_result(git_run(args, options + {repo: cfg.repo}))
}

pub fn release_git_remote_refs(
  cfg: dict,
  refs: list<string>,
  tags: bool = false,
) -> ReleaseGitRemoteObservation {
  if cfg.mock {
    let mock_refs: list<GitRemoteRef> = []
    if refs.contains("refs/tags/v*") {
      mock_refs = [
        {
          oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          ref: "refs/tags/v0.7.51",
          name: "refs/tags/v0.7.51",
          peeled: false,
        },
        {
          oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          ref: "refs/tags/v0.7.52",
          name: "refs/tags/v0.7.52",
          peeled: false,
        },
      ]
    }
    return {success: true, exit_code: 0, refs: mock_refs, receipt: nil, stderr: ""}
  }
  const observed = git_ls_remote("origin", {repo: cfg.repo, refs: refs, tags: tags})
  return {
    success: observed.success,
    exit_code: observed.exit_code,
    refs: observed.data.refs,
    receipt: observed,
    stderr: observed.stderr.inline,
  }
}

pub fn recorded_remote_refs_step(
  name: string,
  label: string,
  observed: ReleaseGitRemoteObservation,
) -> ReleaseRemoteRefsStep {
  const result = if observed.success {
    command_result_ok("")
  } else {
    command_result_fail(observed.exit_code, observed.stderr)
  }
  const step = recorded_step(name, label, result)
  return {
    name: step.name,
    command: step.command,
    success: step.success,
    status: step.status,
    exit_code: step.exit_code,
    stdout: step.stdout,
    stderr: step.stderr,
    classification: step.classification,
    recovery_hint: step.recovery_hint,
    git_receipt: observed.receipt,
    remote_refs: observed.refs,
  }
}

/** Run a local git command, throwing on failure and returning trimmed stdout. */
pub fn checked_git(cfg: dict, args: list<string>, options: ReleaseGitRunOptions = {}) -> string {
  const r = run_git(cfg, args, options)
  if !r.success {
    throw "git command failed (${r.exit_code}): " + argv_label(["git"] + args)
      + "\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

/** Boolean probe over a local git command. */
pub fn probe_git_ok(cfg: dict, args: list<string>, options: ReleaseGitRunOptions = {}) -> bool {
  return run_git(cfg, args, options).success
}

fn github_slug_from_remote_url(url) {
  const cleaned = regex_replace("[.]git$", "", trim(url ?? ""))
  const matches = regex_captures("github[.]com[:/]([^/]+/[^/]+)$", cleaned)
  if len(matches) == 0 {
    return ""
  }
  return matches[0].groups[0]
}

fn mock_release_pr(number = 999, branch = "release/v0.7.53") {
  const immutable = regex_captures(
    "^release-attempt/v[0-9]+[.][0-9]+[.][0-9]+/([0-9a-f]{40})$",
    branch,
  )
  const head_oid = if len(immutable) == 1 {
    immutable[0].groups[0]
  } else {
    MOCK_PIN_SHA
  }
  return {
    repo: "burin-labs/harn",
    number: number,
    title: "Release v0.7.53",
    body: "Mock PR body describing the one-PR release handoff.",
    url: "https://github.com/burin-labs/harn/pull/${number}",
    state: "open",
    github_state: "open",
    draft: false,
    merged: false,
    mergeable: true,
    mergeable_state: "clean",
    base: {ref: "main", sha: MOCK_PIN_SHA, repo: "burin-labs/harn", owner: "burin-labs"},
    head: {ref: branch, sha: head_oid, repo: "burin-labs/harn", owner: "burin-labs"},
    labels: [],
    auto_merge_armed: false,
    in_merge_queue: false,
  }
}

fn release_github_pull_request(value) -> ReleaseGithubPullRequest {
  return {
    repo: value.repo,
    number: value.number,
    title: value.title,
    url: value.url,
    state: value.state,
    github_state: value.github_state,
    draft: value.draft,
    merged: value.merged,
    merged_at: value.merged_at,
    merge_commit_oid: value.merge_commit_oid,
    mergeable: value.mergeable,
    mergeable_state: value.mergeable_state,
    base: value.base,
    head: value.head,
    labels: value.labels,
    auto_merge_armed: value.auto_merge_armed,
    in_merge_queue: value.in_merge_queue,
    body: value.body,
    user: value.user,
    created_at: value.created_at,
    updated_at: value.updated_at,
    closed_at: value.closed_at,
    branch_protection: value.branch_protection,
    queue_membership: value.queue_membership,
    created: value.created,
    updated: value.updated,
    ok: value.ok,
  }
}

pub fn release_github_pr_list(
  cfg: dict,
  filters: ReleaseGithubPrFilters,
) -> list<ReleaseGithubPullRequest> {
  if cfg.mock {
    const pulls = if filters.state == "merged" {
      [
        mock_release_pr(998)
          + {
          state: "merged",
          github_state: "closed",
          merged: true,
          merged_at: "2026-05-03T00:00:00Z",
          merge_commit_oid: MOCK_PIN_SHA,
        },
      ]
    } else {
      []
    }
    return pulls.map({ pull -> release_github_pull_request(pull) }).to_list()
  }
  const result = github_pr_list(release_repo_slug(cfg), filters)
  if is_err(result) {
    throw "GitHub PR list failed: " + to_string(unwrap_err(result))
  }
  return unwrap(result).map({ pull -> release_github_pull_request(pull) }).to_list()
}

pub fn release_github_open_pr(cfg: dict, branch: string) -> ReleaseGithubPullRequest? {
  const prs = release_github_pr_list(cfg, {base: cfg.base, head: branch, state: "open", limit: 1})
  return if len(prs) == 0 {
    nil
  } else {
    prs[0]
  }
}

pub fn release_github_pr_view(
  cfg: dict,
  pr_ref: int | string,
  expected_head: string = "",
) -> ReleaseGithubPullRequest {
  if cfg.mock {
    const branch = if trim(expected_head) == "" {
      "release/v0.7.53"
    } else {
      expected_head
    }
    return release_github_pull_request(mock_release_pr(to_int(pr_ref) ?? 999, branch))
  }
  const result = github_pr_view(release_repo_slug(cfg), pr_ref)
  if is_err(result) {
    throw "GitHub PR view failed: " + to_string(unwrap_err(result))
  }
  return release_github_pull_request(unwrap(result))
}

pub fn release_github_pr_files(cfg: dict, pr_ref: int | string) -> dict {
  if cfg.mock {
    return {
      pull_number: to_int(pr_ref) ?? 999,
      files: [{filename: "CHANGELOG.md"}, {filename: "scripts/release_ship.sh"}],
    }
  }
  const result = github_pr_files(release_repo_slug(cfg), pr_ref)
  if is_err(result) {
    throw "GitHub PR files failed: " + to_string(unwrap_err(result))
  }
  return unwrap(result)
}

fn release_github_result(result) {
  return if is_err(result) {
    result
  } else {
    unwrap(result)
  }
}

pub fn release_github_pr_create(
  cfg: dict,
  title: string,
  head: string,
  base: string,
  body: string,
) -> dict {
  if cfg.mock {
    return mock_release_pr(999, head) + {title: title, body: body, created: true}
  }
  return release_github_result(github_pr_create(release_repo_slug(cfg), title, head, base, body))
}

pub fn release_github_pr_edit(
  cfg: dict,
  pr_ref: int | string,
  edits: ReleaseGithubPrEdits,
) -> dict {
  if cfg.mock {
    return mock_release_pr(to_int(pr_ref) ?? 999) + edits + {ok: true, updated: true}
  }
  return release_github_result(github_pr_edit(release_repo_slug(cfg), pr_ref, edits))
}

/** Close an obsolete immutable-attempt PR after its replacement is durable. */
pub fn release_github_pr_close(cfg: dict, pr_ref: int, comment: string) -> dict {
  if cfg.mock {
    return mock_release_pr(to_int(pr_ref) ?? 998)
      + {
      state: "closed",
      github_state: "closed",
      closed: true,
      comment: comment,
    }
  }
  return github_pr_close(release_repo_slug(cfg), pr_ref, comment)
}

pub fn release_github_release(cfg: dict, tag: string) -> dict {
  if cfg.mock {
    return {repo: "burin-labs/harn", tag: tag, state: "absent", found: false, release: nil}
  }
  return release_github_result(github_release_at_tag(release_repo_slug(cfg), tag))
}

pub fn release_github_release_body_edit(
  cfg: dict,
  tag: string,
  body: string,
  lease: ReleaseGithubReleaseLease,
) -> dict {
  if cfg.mock {
    return {
      repo: "burin-labs/harn",
      tag: tag,
      state: "edited",
      release_id: lease.release_id,
      tag_ref_oid: lease.tag_ref_oid,
      tag_target_oid: lease.tag_target_oid,
      body: body,
    }
  }
  return release_github_result(github_release_body_edit(release_repo_slug(cfg), tag, body, lease))
}

pub fn release_github_mergeability(cfg: dict, pr_ref: int | string) -> dict {
  if cfg.mock {
    return {mergeable: true, mergeable_state: "clean", is_conflict: false}
  }
  return release_github_result(github_pr_mergeability(release_repo_slug(cfg), pr_ref))
}

pub fn release_github_enable_auto_merge(cfg: dict, pr: ReleaseGithubPullRequest) -> dict {
  if cfg.mock {
    return {state: "enabled", expected_head_oid: pr.head.sha, observed_head_oid: pr.head.sha}
  }
  return release_github_result(
    github_enable_auto_merge(release_repo_slug(cfg), pr.number, pr.head.sha, "squash"),
  )
}

pub fn read_repo_file(harness: Harness, cfg: ReleaseRepoConfig, path: string) -> string {
  if cfg.mock {
    return fake_file(path)
  }
  require_release_repo_path(harness, cfg, "reading repo file " + path)
  const full = path_join(cfg.repo, path)
  if !harness.fs.exists(full) {
    return ""
  }
  return harness.fs.read_text(full)
}

fn fake_file(path) {
  if path == "CHANGELOG.md" {
    return """
# Changelog

## v0.7.53

- Added merge-queue-safe release orchestration that ships from one release PR.
- Tightened release metadata verification and changelog drift checks.
- Documented the harn-release-bot workflow cascade.

## v0.7.52

- Previous release baseline.
"""
  }
  if path == "Cargo.toml" {
    return """
[workspace.package]
version = "0.7.52"
"""
  }
  if path == "README.md" {
    return "# Harn\n\nAgent harness language.\n"
  }
  return ""
}

@complexity(allow)
fn fake_command(command, cfg, env = nil) {
  const mock_stale_local_tag = env_str("HARN_RELEASE_MOCK_STALE_LOCAL_TAG") == "1"
  // Lets the mock ship path prove signature failure halts before tag publication.
  const mock_tag_verify_fail = env_str("HARN_RELEASE_MOCK_TAG_VERIFY_FAIL") == "1"
  const tag_command = mock_release_tag_command(command, mock_tag_verify_fail)
  if tag_command != nil {
    return tag_command
  }
  if contains(command, "git branch --show-current") {
    return command_result_ok("release/v0.7.53\n")
  }
  if contains(command, "git status --porcelain") {
    return command_result_ok("")
  }
  if contains(command, "git diff") && contains(command, "--stat") {
    return command_result_ok(
      " CHANGELOG.md             | 12 ++++++++++++\n README.md                |  4 ++++\n scripts/release_ship.sh  |  8 ++++++++\n 3 files changed, 24 insertions(+)\n",
    )
  }
  if contains(command, "git diff") && contains(command, "--name-only") {
    return command_result_ok("CHANGELOG.md\nREADME.md\nscripts/release_ship.sh\n")
  }
  if contains(command, "git tag --list") && contains(command, "--sort=-v:refname") {
    return command_result_ok("v0.7.52\n")
  }
  if contains(command, "git describe --tags") {
    return command_result_ok("v0.7.51\n")
  }
  if contains(command, "git log --name-status") {
    return command_result_ok(
      "commit abc1234 release: consolidate harn release PR flow\nM\tCHANGELOG.md\nM\tscripts/release_ship.sh\n\ncommit bcd2345 ci: publish release from tag drift\nM\t.github/workflows/publish-release.yml\n\ncommit cde3456 docs: clarify local developer loop\nM\tREADME.md\n",
    )
  }
  if contains(command, "git log --stat") {
    return command_result_ok(
      "abc1234 release: consolidate harn release PR flow\n CHANGELOG.md            | 12 ++++++++++++\n scripts/release_ship.sh |  8 ++++++++\n\nbcd2345 ci: publish release from tag drift\n .github/workflows/publish-release.yml | 5 +++++\n\ncde3456 docs: clarify local developer loop\n README.md | 4 ++++\n",
    )
  }
  if contains(command, "git log --oneline") {
    return command_result_ok(
      "abc1234 release: consolidate harn release PR flow\nbcd2345 ci: publish release from tag drift\ncde3456 docs: clarify local developer loop\n",
    )
  }
  if contains(command, "git verify-commit --raw") {
    return command_result_ok(
      "Good git signature for release commit with ED25519 key mock-release-key\n",
    )
  }
  if contains(command, "test -x scripts/release_ship.sh") {
    return command_result_ok("release_ship=ok\n")
  }
  if contains(command, "test -x scripts/release_gate.sh") {
    return command_result_ok("release_gate=ok\n")
  }
  if contains(command, "test -f .github/workflows/publish-release.yml") {
    return command_result_ok("publish_workflow=ok\n")
  }
  if contains(command, "test -f .github/workflows/build-release-binaries.yml") {
    return command_result_ok("binary_workflow=ok\n")
  }
  if contains(command, "cargo build -p harn-cli --bin harn --locked") {
    if (cfg.mock_pin_warm_fail ?? false) || env_bool("HARN_RELEASE_MOCK_PIN_WARM_FAIL", false) {
      return command_result_fail(1, "mock exact-pin Harn CLI warm failure\n")
    }
    return command_result_ok("exact-pin Harn CLI warm complete\n")
  }
  if contains(command, "./scripts/release_gate.sh audit --receipt") {
    return command_result_ok("=== Residual release audit ===\nAudit complete\n")
  }
  if contains(command, "./scripts/release_ship.sh --prepare --materialize-candidate") {
    return command_result_ok(
      "=== Stage release content ===\nUncertified release candidate staged on release/v0.7.53:\n  Previous version: 0.7.52\n  Next version:     0.7.53\n",
    )
  }
  if contains(command, "./scripts/release_ship.sh --prepare") {
    return command_result_ok(
      "=== Release audit ===\n=== Publish dry run ===\n=== Stage release content ===\nRelease content staged on release/v0.7.53:\n  Previous version: 0.7.52\n  Next version:     0.7.53\n",
    )
  }
  if contains(command, "git commit -m") {
    return command_result_ok("[release/v0.7.53 9999999] Release v0.7.53\n")
  }
  if contains(command, "git add -u") {
    return command_result_ok("")
  }
  if contains(command, "git fetch origin") || contains(command, "git rebase") {
    return command_result_ok("Current branch release/v0.7.53 is up to date.\n")
  }
  if contains(command, "git rev-parse HEAD") {
    return command_result_ok("9999999999999999999999999999999999999999\n")
  }
  if contains(command, "git rev-parse --verify") && contains(command, "origin/") {
    return command_result_ok(MOCK_PIN_SHA + "\n")
  }
  if contains(command, "git rev-parse -q --verify refs/tags/") {
    if mock_stale_local_tag {
      return command_result_ok("eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n")
    }
    return command_result_fail(1, "")
  }
  if contains(command, "git rev-parse refs/tags/") {
    return command_result_ok("8888888888888888888888888888888888888888\n")
  }
  if contains(command, "git rev-parse 8888888888888888888888888888888888888888^{}") {
    return command_result_ok("9999999999999999999999999999999999999999\n")
  }
  if contains(command, "git cat-file tag 8888888888888888888888888888888888888888") {
    return command_result_ok(
      "object 9999999999999999999999999999999999999999\ntype commit\ntag v0.7.53\ntagger Mock <mock@example.com> 1 +0000\n\nRelease v0.7.53\n",
    )
  }
  if contains(command, "git rev-parse --verify") {
    return command_result_ok(MOCK_PIN_SHA + "\n")
  }
  if contains(command, "git rev-list --parents -n 1 HEAD") {
    return command_result_ok("9999999999999999999999999999999999999999 ${MOCK_PIN_SHA}\n")
  }
  if contains(command, "git rev-list -n 1") {
    if mock_stale_local_tag {
      return command_result_ok("eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n")
    }
    return command_result_ok("9999999999999999999999999999999999999999\n")
  }
  if contains(command, "git tag -d") {
    return command_result_ok("Deleted tag 'v0.7.53' (was eeeeeee)\n")
  }
  if contains(command, ":refs/tags/v") {
    return command_result_ok(
      "To github.com:burin-labs/harn.git\n * [new tag]         v0.7.53 -> v0.7.53\n",
    )
  }
  if contains(command, "git reset --hard") {
    return command_result_ok("HEAD is now at abc1234 main\n")
  }
  if contains(command, "make -s lint-md") || contains(command, "make lint-md")
    || contains(
    command,
    "npx markdownlint-cli2",
  ) {
    return command_result_ok("markdownlint-cli2 v0.22.1\nSummary: 0 error(s)\n")
  }
  if contains(command, "make check-cli-aot") {
    return command_result_ok("CLI AOT artifacts are current.\n")
  }
  if contains(command, "git push -u origin") && (env?.HARN_HOOKS_NO_LOCAL_BUILD ?? "") == "1" {
    return command_result_ok("branch 'release/v0.7.53' set up to track 'origin/release/v0.7.53'.\n")
  }
  if contains(command, "git push -u origin") {
    return command_result_fail(
      1,
      "pre-push hook: make test passed (3187/3187) but exceeded 120s wall-clock budget\n",
    )
  }
  if contains(command, "rg ") {
    return command_result_ok(
      "CHANGELOG.md:3:## v0.7.53\nscripts/release_ship.sh:82:Release vX.Y.Z\n",
    )
  }
  return command_result_fail(127, "mock has no response for command: ${command}")
}

pub fn require_live_confirmation(cfg: ReleaseLiveConfirmationConfig) -> nil {
  if !cfg.mock && !cfg.yes_live_release {
    throw "live ${cfg.mode} mode requires --yes-live-release"
  }
}

fn run_events_path(run_id) {
  return path_join(release_run_dir(run_id), "run-events.jsonl")
}

fn live_logs_dir(run_id) {
  return path_join(release_run_dir(run_id), "live-logs")
}

pub fn command_live_log_path(run_id: string, name: string) -> string {
  const safe_name = regex_replace_all("[^A-Za-z0-9_.-]+", "-", name)
  return path_join(live_logs_dir(run_id), safe_name + ".log")
}

pub fn release_log_event(
  harness: Harness,
  run_id: string,
  event_type: string,
  data: dict,
) -> string {
  const path = run_events_path(run_id)
  harness.fs.mkdir(dirname(path), true)
  harness.fs.append(
    path,
    json_stringify(
      {
        schema_version: "release_harn.run_event.v1",
        timestamp: date_now_iso(),
        event_type: event_type,
        data: data,
      },
    )
      + "\n",
  )
  return path
}

pub fn release_timed_phase<T>(
  harness: Harness,
  run_id: string,
  phase: string,
  timing_name: string,
  attrs: dict,
  callback: fn() -> T,
) -> T {
  release_log_event(
    harness,
    run_id,
    "phase_started",
    {phase: phase, timing: timing_name} + (attrs ?? {}),
  )
  try {
    const outcome = timed(timing_name, attrs, callback)
    release_log_event(
      harness,
      run_id,
      "phase_finished",
      {phase: phase, timing: timing_name, status: "ok"},
    )
    return outcome.result
  } catch (e) {
    release_log_event(
      harness,
      run_id,
      "phase_finished",
      {phase: phase, timing: timing_name, status: "error", error: to_string(e)},
    )
    throw e
  }
}

fn command_label(command) {
  if command?.argv != nil {
    return argv_label(command.argv)
  }
  if command?.command != nil {
    return command.command
  }
  if type_of(command) == "list" {
    return argv_label(command)
  }
  return command
}

pub fn log_step_started<T>(
  harness: Harness,
  run_id: string,
  name: string,
  command: T,
  extra: dict? = nil,
) -> string {
  const extra_fields = extra ?? {}
  return release_log_event(
    harness,
    run_id,
    "step_started",
    {step: name, command: command_label(command)} + extra_fields,
  )
}

pub fn log_step_finished(
  harness: Harness,
  run_id: string,
  name: string,
  result: ReleaseStepStatus,
  extra: dict?,
) -> string {
  const base = {
    step: name,
    success: result.success,
    status: result.status,
    exit_code: result.exit_code,
  }
  const extra_fields = extra ?? {}
  return release_log_event(harness, run_id, "step_finished", base + extra_fields)
}

fn release_command_runner(cfg) {
  if !cfg.mock {
    return nil
  }
  return { spec, _options ->
    const label = if spec?.argv != nil {
      join(spec.argv.map({ a -> to_string(a) }), " ")
    } else {
      spec?.command ?? ""
    }
    fake_command(label, cfg, spec?.env)
  }
}

pub fn append_command_step<T>(
  harness: Harness,
  cfg: dict,
  steps: list<dict>,
  name: string,
  command: T,
  extra: dict? = nil,
) -> ReleaseCommandStepResult {
  return append_std_command_step(
    harness,
    cfg,
    steps,
    name,
    command,
    release_command_runner(cfg),
    extra,
  )
}

pub fn release_open_pr_count(cfg: dict, branch: string) -> int {
  const result = try {
    release_github_pr_list(cfg, {head: branch, state: "open"})
  } catch (_e) {
    nil
  }
  if result == nil {
    // Unknown PR state is not known-safe: report a nonzero count so the
    // remediation refuses to delete the branch.
    return 1
  }
  return len(result)
}

pub fn release_repo_slug(cfg: dict) -> string {
  const remote = run_git(cfg, ["remote", "get-url", "origin"])
  if !remote.success {
    return ""
  }
  return github_slug_from_remote_url(remote.stdout)
}

pub fn probe_ok(cfg: dict, command: string) -> bool {
  return run_cmd(cfg, command).success
}

pub fn latest_release_tag(cfg: dict) -> string {
  const remote = release_git_remote_refs(cfg, ["refs/tags/v*"], true)
  if !remote.success {
    throw "could not list origin release tags; refusing to derive release history from local-only tags:\n"
      + trim(
      remote.stderr,
    )
  }
  return latest_semver_tag_from_remote_refs(remote.refs)
}

pub fn run_output_dir(run_id: string) -> string {
  return release_run_dir(run_id)
}
/**
 * F6a: resolve the advisory local build-lock path. A fixed machine-wide path so
 * concurrent releases/builds serialize on the shared Cargo build dir.
 */
