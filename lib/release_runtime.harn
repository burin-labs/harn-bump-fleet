pub fn release_github_mergeability(harness: Harness, cfg: dict, pr_ref: int | string) -> dict {
  if cfg.mock {
    return {mergeable: true, mergeable_state: "clean", is_conflict: false}
  }
  return release_github_result(
    github_pr_mergeability(
      harness,
      release_repo_slug({env: harness.env, process: harness.process}, cfg),
