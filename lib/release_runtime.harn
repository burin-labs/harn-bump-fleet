pub fn release_github_enable_auto_merge(
  harness: Harness,
  cfg: dict,
  pr: ReleaseGithubPullRequest,
) -> dict {
  if cfg.mock {
    return {state: "enabled", expected_head_oid: pr.head.sha, observed_head_oid: pr.head.sha}
  }
  return release_github_result(
    github_enable_auto_merge(
      harness,
      release_repo_slug({env: harness.env, process: harness.process}, cfg),
      pr.number,
      pr.head.sha,
      "squash",
