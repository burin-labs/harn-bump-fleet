pub type ReleaseStepsCallback = fn() -> list<dict>

/**
 * Resolve the checkout root that owns this release harness. `harn run
 * /abs/path/release_harn.harn` may be launched from another repo, so this must
 * not depend on the process cwd.
 */
pub fn release_harness_root() -> string {
  const root = runtime_paths().asset_root
  const leaf = basename(root)
  if leaf == "lib" || leaf == "tests" {
    return dirname(root)
  }
  return root
}

pub fn release_run_root() -> string {
  return path_join(release_harness_root(), RUN_ROOT)
}

pub fn release_run_dir(run_id: string) -> string {
  return path_join(release_run_root(), run_id)
}

pub fn prompt_asset(name: string) -> string {
  return path_join(release_harness_root(), "prompts", name)
}

fn timing_status(success) {
  return if success {
    "ok"
  } else {
    "error"
  }
}

pub fn finish_release_run_timing(handle: dict, outcome: string, success: bool) -> dict {
  return end_timing(handle, {status: timing_status(success), outcome: outcome})
}

pub fn timed_release_steps(
  name: string,
  attrs: dict,
  callback: ReleaseStepsCallback,
) -> list<dict> {
  const handle = start_timing(name, attrs)
  try {
    const steps = callback()
    const failed = execution_failed(steps)
    end_timing(
      handle,
      {
        status: timing_status(!failed),
        outcome: if failed {
          "failed"
        } else {
          "ok"
        },
        step_count: len(steps ?? []),
      },
    )
    return steps
  } catch (e) {
    end_timing(handle, {status: "error", outcome: "exception", error: to_string(e)})
    throw e
  }
}

// Mock-mode placeholder for the pinned base SHA. 40 hex chars so it
// looks like a real commit SHA in audit reports, fixtures, and tests.
const MOCK_PIN_SHA = "abcdef1234567890abcdef1234567890abcdef12"

