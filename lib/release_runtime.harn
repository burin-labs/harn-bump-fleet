pub fn parse_release_args(env: HarnessEnv, args: list<string>) -> ReleaseConfig {
  let parsed = cli_options<ReleaseCliOptions>(RELEASE_ARG_SPEC, args, schema_of(ReleaseCliOptions))
  const prerelease_bump = is_prerelease_bump(parsed.bump)
  const preid = trim(parsed.preid)
  if prerelease_bump && preid == "" {
    throw "--preid is required for --bump ${parsed.bump}"
  }
  if !prerelease_bump && preid != "" {
    throw "--preid is only valid with premajor, preminor, prepatch, or prerelease"
  }
  if preid != "" {
    if !is_prerelease_identifier(preid) {
      throw "invalid prerelease identifier `${preid}`"
    }
  }
  if trim(parsed.repo) == "" {
    parsed.repo = path_join(env_str(env, "HOME") ?? "", "projects/harn")
  }
  if trim(parsed.base) == "" {
    parsed.base = env_str(env, "HARN_EXT_RELEASE_BASE") ?? "main"
  }
  const planner = planner_defaults(env, "HARN_RELEASE")
  if trim(parsed.model) == "" {
    parsed.model = planner.model
  }
  if trim(parsed.provider) == "" {
    parsed.provider = planner.provider
  }
  const bootstrap = parsed.bootstrap_new_crates
    || env_bool(env, "HARN_EXT_RELEASE_BOOTSTRAP_NEW_CRATES", false)
  const release_focus = if parsed.release_focus != "" {
    parsed.release_focus
  } else {
    env_str(env, "HARN_EXT_RELEASE_FOCUS") ?? ""
  }
  const pin_sha_input = if parsed.pin_sha_input != "" {
    parsed.pin_sha_input
  } else {
    env_str(env, "HARN_EXT_RELEASE_PIN_SHA") ?? ""
  }
  const expected_prs = parse_pull_request_numbers(
    (parsed.expect_pr ?? []) + [env_str(env, "HARN_EXT_RELEASE_EXPECT_PRS") ?? ""],
  )
  const rejected_prs = parse_pull_request_numbers(
    (parsed.reject_pr ?? []) + [env_str(env, "HARN_EXT_RELEASE_REJECT_PRS") ?? ""],
  )
  const queue_critical_prs = parse_pull_request_numbers(parsed.queue_critical_pr ?? [])
  const queue_live_prs = parse_pull_request_numbers(parsed.queue_live_pr ?? [])
  const queue_noncritical_live_prs = parse_pull_request_numbers(
    parsed.queue_noncritical_live_pr ?? [],
  )
  const release_cargo_target_dir = resolve_release_cargo_target_dir(
    env_str(env, "HARN_EXT_RELEASE_CARGO_TARGET_DIR") ?? "",
    env_str(env, "HOME") ?? "",
    env_str(env, "XDG_CACHE_HOME") ?? "",
  )
  const cfg: ReleaseConfig = {
    repo: expand_home(env, parsed.repo),
    source_repo: expand_home(env, parsed.repo),
    release_workspace: "",
    release_workspace_managed: false,
    release_workspace_shared: false,
    base: parsed.base,
    bump: parsed.bump,
    preid: preid,
    mode: parsed.mode,
    agent: parsed.agent,
    model: parsed.model,
    provider: parsed.provider,
    mock: parsed.mock,
    rehearsal: parsed.rehearsal,
    help: parsed.help,
    bootstrap_new_crates: bootstrap,
    release_cargo_target_dir: release_cargo_target_dir,
    release_focus: release_focus,
    yes_live_release: parsed.yes_live_release,
    pin_sha_input: pin_sha_input,
    pin_sha: "",
    analysis_snapshot: {
      kind: if parsed.mock {
        "mock"
      } else {
        "unresolved"
      },
      requested_sha: pin_sha_input,
      resolved_sha: "",
      analysis_head: "",
      analysis_root: expand_home(env, parsed.repo),
      source_repo: expand_home(env, parsed.repo),
    },
    planner_source: DEFAULT_PLANNER.source,
    planner_preflight: nil,
    fixup_mode: false,
    skip_tag: false,
    fixup_tag: "",
    fixup_pr_url: "",
    fixup_publication: nil,
    fixup_pin_unreleased: "",
    fixup_release_body_source: "",
    release_notes_scope: "candidate_tree",
    pre_tag_resume: false,
    pre_tag_supersede: false,
    allow_base_drift: parsed.allow_base_drift,
    github_signed_commit: parsed.github_signed_commit,
    expected_prs: expected_prs,
    rejected_prs: rejected_prs,
    queue_critical_prs: queue_critical_prs,
    queue_live_prs: queue_live_prs,
    queue_noncritical_live_prs: queue_noncritical_live_prs,
    local_audit: parsed.local_audit || env_bool(env, "HARN_EXT_RELEASE_LOCAL_AUDIT", false),
    no_chat: parsed.no_chat,
    chat_only: parsed.chat_only,
    chat_run: parsed.chat_run,
    chat_timeout_s: parsed.chat_timeout_s,
    self_update: parsed.self_update || env_bool(env, "FLEET_SELF_UPDATE", false),
    wait_build_lock: parsed.wait_build_lock
      || env_bool(env, "HARN_EXT_RELEASE_WAIT_BUILD_LOCK", false),
  }
  if cfg.help {
    return cfg
  }
  return cfg
}

pub fn expand_home(env: HarnessEnv, path: string) -> string {
  if path == "~" {
    return env.get_or("HOME", "")
  }
  if starts_with(path, "~/") {
    return env.get_or("HOME", "") + path[1:len(path)]
  }
  return path
}

/**
 * Resolve `cfg.pin_sha_input` (or `origin/<base>` when no input is given)
 * to a concrete 40-char commit SHA. Frozen here so every downstream step
 * — branch creation, audit ranges, PR body, tag push — uses the same
 * commit even if `origin/<base>` advances mid-run.
 */
pub fn resolve_pin_sha(process: HarnessProcess, cfg: ReleasePinConfig) -> string {
  if cfg.mock {
    if cfg.pin_sha_input != "" {
      return cfg.pin_sha_input
    }
    return MOCK_PIN_SHA
  }
  const refresh_base = cfg.mode != "audit" || cfg.yes_live_release
  // Read-only explicit-pin audits retain their local-only contract. Every
  // mutating release, including an explicit pin, refreshes and proves the
  // requested base before any release work starts.
  const base_head = if cfg.pin_sha_input != "" && !refresh_base {
    ""
  } else {
    release_base_head(process, cfg, refresh_base)
  }
  if cfg.pin_sha_input != "" {
    const raw = trim(cfg.pin_sha_input)
    const r = git_run(process, ["rev-parse", "--verify", raw + "^{commit}"], {repo: cfg.repo})
    if !r.success {
      throw "--at-sha did not resolve to a commit: ${raw}\n${trim(r.stderr)}"
    }
    const pin_sha = trim(r.stdout)
    if refresh_base && !(cfg.allow_base_drift ?? false) {
      const ancestry = git_run(
        process,
        ["merge-base", "--is-ancestor", pin_sha, base_head],
        {repo: cfg.repo},
      )
      if !ancestry.success {
        throw "--at-sha ${pin_sha} is not an ancestor of refreshed origin/${cfg.base}; use --allow-base-drift only for an intentional divergent release"
      }
    }
    return pin_sha
  }
  return base_head
}

/**
 * Resolve the release base after optionally refreshing only its exact
 * remote-tracking ref. Never inherit a recovery checkout's remote refspec:
 * it can name a deleted release branch unrelated to the requested base.
 */
fn release_base_head(process: HarnessProcess, cfg, refresh) {
  if refresh {
    const fetch_args = base_ref_fetch_args(cfg.base)
    const fetched = git_run(process, fetch_args, {repo: cfg.repo})
    if !fetched.success {
      throw "failed to fetch required origin/${cfg.base} with explicit refspec ${base_ref_fetch_command(cfg.base)}; checkout remote.origin.fetch was not used:\n${trim(fetched.stderr)}"
    }
  }
  const r = git_run(
    process,
    ["rev-parse", "--verify", "origin/${cfg.base}^{commit}"],
    {repo: cfg.repo},
  )
  if !r.success {
    throw "failed to resolve origin/${cfg.base} after release base-ref preflight:\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

fn release_command_result(result) -> ReleaseCommandResult {
  return {
    success: result.success,
    ok: result.ok ?? result.success,
    status: result.status
      ?? if result.success {
        "completed"
      } else {
        "failed"
      },
    exit_code: result.exit_code,
    cwd: result.cwd ?? "",
    stdout: result.stdout ?? "",
    stderr: result.stderr ?? "",
  }
}

pub fn run_cmd(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  command: string,
) -> ReleaseCommandResult {
  if cfg.mock {
    return release_command_result(fake_command(harness.env, command, cfg))
  }
  return release_command_result(harness.process.shell_at(cfg.repo, command))
}

/**
 * Run a local git command in argv form, scoped to `cfg.repo`.
 *
 * Routes through `fake_command` in mock mode so the legacy substring-keyed
 * mock fixtures continue to match; otherwise dispatches to `std/git`
 * `git_run`, which executes argv without shell quoting and strips ambient
 * GIT_* env.
 */
pub fn run_git(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  args: list<string>,
  options: ReleaseGitRunOptions = {},
) -> ReleaseCommandResult {
  if cfg.mock {
    return release_command_result(fake_command(harness.env, argv_label(["git"] + args), cfg))
  }
  return release_command_result(git_run(harness.process, args, options + {repo: cfg.repo}))
}

pub fn release_git_remote_refs(
  process: HarnessProcess,
  cfg: dict,
  refs: list<string>,
  tags: bool = false,
) -> ReleaseGitRemoteObservation {
  if cfg.mock {
    let mock_refs: list<GitRemoteRef> = []
    if refs.contains("refs/tags/v*") {
      mock_refs = [
        {
          oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          ref: "refs/tags/v0.7.51",
          name: "refs/tags/v0.7.51",
          peeled: false,
        },
        {
          oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          ref: "refs/tags/v0.7.52",
          name: "refs/tags/v0.7.52",
          peeled: false,
        },
      ]
    }
    return {success: true, exit_code: 0, refs: mock_refs, receipt: nil, stderr: ""}
  }
  const observed = git_ls_remote(process, "origin", {repo: cfg.repo, refs: refs, tags: tags})
  return {
    success: observed.success,
    exit_code: observed.exit_code,
    refs: observed.data.refs,
    receipt: observed,
    stderr: observed.stderr.inline,
  }
}

pub fn recorded_remote_refs_step(
  name: string,
  label: string,
  observed: ReleaseGitRemoteObservation,
) -> ReleaseRemoteRefsStep {
  const result = if observed.success {
    command_result_ok("")
  } else {
    command_result_fail(observed.exit_code, observed.stderr)
  }
  const step = recorded_step(name, label, result)
  return {
    name: step.name,
    command: step.command,
    success: step.success,
    status: step.status,
    exit_code: step.exit_code,
    stdout: step.stdout,
    stderr: step.stderr,
    classification: step.classification,
    recovery_hint: step.recovery_hint,
    git_receipt: observed.receipt,
    remote_refs: observed.refs,
  }
}

/** Run a local git command, throwing on failure and returning trimmed stdout. */
pub fn checked_git(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  args: list<string>,
  options: ReleaseGitRunOptions = {},
) -> string {
  const r = run_git(harness, cfg, args, options)
  if !r.success {
    throw "git command failed (${r.exit_code}): " + argv_label(["git"] + args)
      + "\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

/** Boolean probe over a local git command. */
pub fn probe_git_ok(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  args: list<string>,
  options: ReleaseGitRunOptions = {},
) -> bool {
  return run_git(harness, cfg, args, options).success
}

fn github_slug_from_remote_url(url) {
  const cleaned = regex_replace("[.]git$", "", trim(url ?? ""))
  const matches = regex_captures("github[.]com[:/]([^/]+/[^/]+)$", cleaned)
  if len(matches) == 0 {
    return ""
  }
  return matches[0].groups[0]
}

fn mock_release_pr(number = 999, branch = "release/v0.7.53") {
  const immutable = regex_captures(
    "^release-attempt/v[0-9]+[.][0-9]+[.][0-9]+/([0-9a-f]{40})$",
    branch,
  )
  const head_oid = if len(immutable) == 1 {
    immutable[0].groups[0]
  } else {
    MOCK_PIN_SHA
  }
  return {
    repo: "burin-labs/harn",
    number: number,
    title: "Release v0.7.53",
    body: "Mock PR body describing the one-PR release handoff.",
    url: "https://github.com/burin-labs/harn/pull/${number}",
    state: "open",
    github_state: "open",
    draft: false,
    merged: false,
    mergeable: true,
    mergeable_state: "clean",
    base: {ref: "main", sha: MOCK_PIN_SHA, repo: "burin-labs/harn", owner: "burin-labs"},
    head: {ref: branch, sha: head_oid, repo: "burin-labs/harn", owner: "burin-labs"},
    labels: [],
    auto_merge_armed: false,
    in_merge_queue: false,
  }
}

fn release_github_pull_request(value) -> ReleaseGithubPullRequest {
  return {
    repo: value.repo,
    number: value.number,
    title: value.title,
    url: value.url,
    state: value.state,
    github_state: value.github_state,
    draft: value.draft,
    merged: value.merged,
    merged_at: value.merged_at,
    merge_commit_oid: value.merge_commit_oid,
    mergeable: value.mergeable,
    mergeable_state: value.mergeable_state,
    base: value.base,
    head: value.head,
    labels: value.labels,
    auto_merge_armed: value.auto_merge_armed,
    in_merge_queue: value.in_merge_queue,
    body: value.body,
    user: value.user,
    created_at: value.created_at,
    updated_at: value.updated_at,
    closed_at: value.closed_at,
    branch_protection: value.branch_protection,
    queue_membership: value.queue_membership,
    created: value.created,
    updated: value.updated,
    ok: value.ok,
  }
}

pub fn release_github_pr_list(
  harness: Harness,
  cfg: dict,
  filters: ReleaseGithubPrFilters,
) -> list<ReleaseGithubPullRequest> {
  if cfg.mock {
    const pulls = if filters.state == "merged" {
      [
        mock_release_pr(998)
          + {
            state: "merged",
            github_state: "closed",
            merged: true,
            merged_at: "2026-05-03T00:00:00Z",
            merge_commit_oid: MOCK_PIN_SHA,
          },
      ]
    } else {
      []
    }
    return pulls.map({ pull -> release_github_pull_request(pull) }).to_list()
  }
  const result = github_pr_list(
    harness,
    release_repo_slug({env: harness.env, process: harness.process}, cfg),
    filters,
  )
  if is_err(result) {
    throw "GitHub PR list failed: " + to_string(unwrap_err(result))
  }
  return unwrap(result).map({ pull -> release_github_pull_request(pull) }).to_list()
}

pub fn release_github_open_pr(
  harness: Harness,
  cfg: dict,
  branch: string,
) -> ReleaseGithubPullRequest? {
  const prs = release_github_pr_list(
    harness,
    cfg,
    {base: cfg.base, head: branch, state: "open", limit: 1},
  )
  return if len(prs) == 0 {
    nil
  } else {
    prs[0]
  }
}

pub fn release_github_pr_view(
  harness: Harness,
  cfg: dict,
  pr_ref: int | string,
  expected_head: string = "",
) -> ReleaseGithubPullRequest {
  if cfg.mock {
    const branch = if trim(expected_head) == "" {
      "release/v0.7.53"
    } else {
      expected_head
    }
    return release_github_pull_request(mock_release_pr(to_int(pr_ref) ?? 999, branch))
  }
  const result = github_pr_view(
    harness,
    release_repo_slug({env: harness.env, process: harness.process}, cfg),
    pr_ref,
  )
  if is_err(result) {
    throw "GitHub PR view failed: " + to_string(unwrap_err(result))
  }
  return release_github_pull_request(unwrap(result))
}

pub fn release_github_pr_files(harness: Harness, cfg: dict, pr_ref: int | string) -> dict {
  if cfg.mock {
    return {
      pull_number: to_int(pr_ref) ?? 999,
      files: [{filename: "CHANGELOG.md"}, {filename: "scripts/release_ship.sh"}],
    }
  }
  const result = github_pr_files(
    harness,
    release_repo_slug({env: harness.env, process: harness.process}, cfg),
    pr_ref,
  )
  if is_err(result) {
    throw "GitHub PR files failed: " + to_string(unwrap_err(result))
  }
  return unwrap(result)
}

fn release_github_result(result) {
  return if is_err(result) {
    result
  } else {
    unwrap(result)
  }
}

/** Public GitHub trust material for the credential driving a local release. */
pub fn release_github_ssh_signing_keys(harness: Harness, cfg: dict) -> dict {
  if cfg.mock {
    const key = if cfg.mock_unknown_github_signing_key ?? false {
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB60zaJI1YRp31GcmMTPiJ7fQxrE9kUf5M2KWWo7kIj"
    } else {
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIALiGUi5b6TVIbzfFNniz7bfPbXJcbzWjLguThg5EpKw"
    }
    return {
      success: true,
      login: "mock-release-operator",
      keys: [{id: 1, key: key, title: "release", created_at: "2026-01-01T00:00:00Z"}],
    }
  }
  const user = github_authenticated_user(harness)
  if is_err(user) {
    return {success: false, error: unwrap_err(user), login: "", keys: []}
  }
  const login = trim(unwrap(user).login)
  const keys = github_user_ssh_signing_keys(harness, login)
  if is_err(keys) {
    return {success: false, error: unwrap_err(keys), login: login, keys: []}
  }
  return {success: true, login: login, keys: unwrap(keys)}
}

pub fn release_github_pr_create(
  harness: Harness,
  cfg: dict,
  title: string,
  head: string,
  base: string,
  body: string,
) -> dict {
  if cfg.mock {
    return mock_release_pr(999, head) + {title: title, body: body, created: true}
  }
  return release_github_result(
    github_pr_create(
      harness,
      {
        slug: release_repo_slug({env: harness.env, process: harness.process}, cfg),
        title: title,
        head: head,
        base: base,
        body: body,
      },
    ),
  )
}

pub fn release_github_pr_edit(
  harness: Harness,
  cfg: dict,
  pr_ref: int | string,
  edits: ReleaseGithubPrEdits,
) -> dict {
  if cfg.mock {
    return mock_release_pr(to_int(pr_ref) ?? 999) + edits + {ok: true, updated: true}
  }
  return release_github_result(
    github_pr_edit(
      harness,
      release_repo_slug({env: harness.env, process: harness.process}, cfg),
      pr_ref,
      edits,
    ),
  )
}

/** Close an obsolete immutable-attempt PR after its replacement is durable. */
pub fn release_github_pr_close(harness: Harness, cfg: dict, pr_ref: int, comment: string) -> dict {
  if cfg.mock {
    return mock_release_pr(to_int(pr_ref) ?? 998)
      + {state: "closed", github_state: "closed", closed: true, comment: comment}
  }
  return github_pr_close(
    harness,
    release_repo_slug({env: harness.env, process: harness.process}, cfg),
    pr_ref,
    comment,
  )
}

pub fn release_github_release(harness: Harness, cfg: dict, tag: string) -> dict {
  if cfg.mock {
    return {repo: "burin-labs/harn", tag: tag, state: "absent", found: false, release: nil}
  }
  return release_github_result(
    github_release_at_tag(
      harness,
      release_repo_slug({env: harness.env, process: harness.process}, cfg),
      tag,
