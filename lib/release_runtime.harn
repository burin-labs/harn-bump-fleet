pub type ReleaseStepsCallback = fn() -> list<dict>

fn timing_status(success) {
  return if success {
    "ok"
  } else {
    "error"
  }
}

pub fn finish_release_run_timing(
  clock: HarnessClock,
  handle: dict,
  outcome: string,
  success: bool,
) -> dict {
  return end_timing(clock, handle, {status: timing_status(success), outcome: outcome})
}

pub fn timed_release_steps(
  clock: HarnessClock,
  name: string,
  attrs: dict,
  callback: ReleaseStepsCallback,
) -> list<dict> {
  const handle = start_timing(clock, name, attrs)
  try {
    const steps = callback()
    const failed = execution_failed(steps)
    end_timing(
      clock,
      handle,
      {
        status: timing_status(!failed),
        outcome: if failed {
          "failed"
        } else {
          "ok"
        },
        step_count: len(steps ?? []),
      },
    )
    return steps
  } catch (e) {
    end_timing(clock, handle, {status: "error", outcome: "exception", error: to_string(e)})
    throw e
  }
}

// Mock-mode placeholder for the pinned base SHA. 40 hex chars so it
// looks like a real commit SHA in audit reports, fixtures, and tests.
const MOCK_PIN_SHA = "abcdef1234567890abcdef1234567890abcdef12"

