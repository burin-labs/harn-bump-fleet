/**
 * The connector owns the release mutation lease: it is the party that reads
 * the release and returns one. A second local declaration only had the power to
 * drop a field the value already carried, which is how `tag_target_type` went
 * missing from a head-sensitive mutation without anything noticing.
 */
pub type ReleaseGithubReleaseLease = GithubReleaseLease

pub type ReleaseGithubPullRequestRef = {ref: string, sha: string, repo: string, owner: string}

