/**
 * What one bounded page of a consumer's workflow runs proves.
 *
 * The pre-tag gate reads a consumer's run history through a single paged
 * listing, and every question it asks of that page is really a question about
 * absence: this candidate has no run here, so what follows? The answer is not
 * one rule, because it depends on which read is asking and on the listing
 * being ordered the way it is documented to be. Both of those live here, away
 * from the polling machinery, so the reasoning is stated once and can be
 * falsified on its own.
 */
import { GITHUB_ACTIONS_RUNS_PAGE } from "./github"

/** Workflow identity and the fields needed to judge its result. */
pub type ConsumerPretagRunRow = {
  id: int,
  status: string,
  conclusion: string,
  html_url: string,
  display_title: string,
  head_sha: string,
  workflow_path?: string,
  event?: string,
  head_branch?: string,
  created_at?: string,
}

/** The runs in this page that name this candidate and consumer revision. */
pub fn candidate_runs_in_page(
  title: string,
  consumer_revision: string?,
  rows: list<ConsumerPretagRunRow>,
) -> list<ConsumerPretagRunRow> {
  return rows.filter(
    { row -> trim(row.display_title) == title && row.head_sha == consumer_revision },
  )
    .to_list()
}

/**
 * The inversion, if any, in a listing that is supposed to be newest first.
 *
 * Reading "this candidate has no run" out of one bounded page rests entirely
 * on that ordering: if the newest runs are not the ones listed, an existing
 * run can sit outside a page that is not even full, and the gate dispatches a
 * duplicate without ever saying so. The premise is checked on every read
 * rather than trusted, by creation time where the listing carries it and by
 * the run number, which is issued in creation order, where it does not.
 */
pub fn inventory_order_break(rows: list<ConsumerPretagRunRow>) -> string? {
  let previous: ConsumerPretagRunRow? = nil
  let breakage: string? = nil
  for row in rows {
    const earlier = previous
    if earlier != nil && breakage == nil {
      const newer = earlier ?? row
      const newer_at = trim(newer.created_at ?? "")
      const older_at = trim(row.created_at ?? "")
      if newer_at != "" && older_at != "" {
        if newer_at < older_at {
          breakage = "run ${to_string(row.id)} created ${older_at} is listed after run "
            + "${to_string(newer.id)} created ${newer_at}"
        }
      } else if newer.id < row.id {
        breakage = "run ${to_string(row.id)} is listed after the lower-numbered run "
          + "${to_string(newer.id)} and the listing carries no creation timestamps"
      }
    }
    previous = row
  }
  return breakage
}

/**
 * Why this page cannot be read as "the candidate has no run", or nil when it
 * can be.
 *
 * WHAT AN EMPTY ANSWER PROVES DEPENDS ON WHICH READ IS ASKING.
 *
 * The first read decides whether to dispatch at all. A run of this candidate
 * could only have been created after every run the page displaced, so a
 * newest-first page answers that question however full it is, and refusing a
 * full page here would stop the gate permanently on any busy consumer: on
 * 2026-09-20 a blanket full-page refusal did exactly that to a consumer with
 * 67 prior runs. The whole answer rests on the ordering, so the ordering is
 * asserted.
 *
 * The recovery read is a poll for a run an interrupted earlier attempt may
 * have started, and its only outcomes are wait longer or give up. A full page
 * supports neither, so it is refused by name and the operator sees the bound
 * instead of a silent verdict.
 */
pub fn candidate_absence_refusal(
  rows: list<ConsumerPretagRunRow>,
  ambiguity_context: string,
  refuse_on_full_page: bool,
) -> string? {
  if refuse_on_full_page {
    if len(rows) >= GITHUB_ACTIONS_RUNS_PAGE {
      return "the ${ambiguity_context} run inventory filled its page of "
        + "${to_string(GITHUB_ACTIONS_RUNS_PAGE)}, so this candidate having no run there is not "
        + "evidence it has none; refusing rather than dispatching a possible duplicate"
    }
    return nil
  }
  const order_break = inventory_order_break(rows)
  if order_break == nil {
    return nil
  }
  return "the ${ambiguity_context} run inventory is not in descending creation order ("
    + to_string(order_break ?? "")
    + "), so this candidate having no run in the newest "
    + "${to_string(GITHUB_ACTIONS_RUNS_PAGE)} is not evidence it has none; refusing rather than "
    + "dispatching a possible duplicate"
}
