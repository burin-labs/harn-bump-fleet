import { command_result_fail, command_result_ok } from "std/command"
import {
  ReleaseAgentReviewResult,
  logged_command_step,
  logged_github_operation_step,
  maybe_recovery_advice_step,
  retry_commands_after_agent_repair,
  run_release_generated_content_checks,
  run_retry_commands_after_agent_repair,
} from "./release_agent"
import { ReleaseAnalysis, analyze_release } from "./release_analysis"
import { execution_failed, recorded_step, release_commit_verify_args } from "./release_execution"
import { prepared_release_analysis } from "./release_notes"
import {
  ReleasePublication,
  publish_release_publication,
  release_attempt_for_version,
  release_publication,
} from "./release_publication"
import {
  ReleaseConfig,
  append_command_step,
  release_git_remote_refs,
  release_github_open_pr,
  release_log_event,
} from "./release_runtime"
import { pre_prepare_cutoff_gate } from "./release_tag"

pub type ReleaseShipPrepareStopped = {proceed: bool, steps: list<dict>}

pub type ReleaseShipPrepareReady = {
  proceed: bool,
  steps: list<dict>,
  analysis: ReleaseAnalysis,
  version: string,
  publication: ReleasePublication,
}

pub type ReleaseShipPrepareResult = ReleaseShipPrepareStopped | ReleaseShipPrepareReady

pub type ReleaseCommitPlan = {already_complete: bool, commands: list<dict>}

type AgentReview = ReleaseAgentReviewResult

pub type PrepareFn = fn(Harness, ReleaseConfig, ReleaseAnalysis, AgentReview, string) -> list<dict>

/** Build the deterministic commit/fetch sequence before any side effects run. */
pub fn release_commit_plan(cfg: dict, analysis: dict, version: string) -> ReleaseCommitPlan {
  const local_branch = "release/v${version}"
  const already_complete = trim(analysis.status ?? "") == ""
    && trim(analysis.diff_names ?? "")
    != ""
    && analysis.branch == local_branch
  let commands = []
  if !already_complete {
    commands = commands + [{name: "stage-tracked-release-content", argv: ["git", "add", "-u"]}]
    commands = commands + [{name: "commit", argv: ["git", "commit", "-m", "Release v${version}"]}]
  }
  // Fetch tags without rebasing: the release branch must remain parented at
  // cfg.pin_sha so later base-branch commits cannot enter the tagged artifact.
  commands = commands + [{name: "fetch-base", argv: ["git", "fetch", "origin", "--tags", cfg.base]}]
  // A shipped fixup uses the tag only as ancestry evidence. The ours merge
  // preserves the canonical tree prepared on fresh main.
  if (cfg.fixup_mode ?? false) && (cfg.skip_tag ?? false) && trim(cfg.fixup_tag ?? "") != "" {
    commands = commands
      + [
      {
        name: "merge-shipped-tag-ours",
        argv: [
          "git",
          "merge",
          "-S",
          "--no-ff",
          "-s",
          "ours",
          cfg.fixup_tag,
          "-m",
          "Tie release/v${version} to shipped tag ${cfg.fixup_tag} (ours)",
        ],
      },
    ]
  }
  return {already_complete: already_complete, commands: commands}
}

/** Prove the prepared release commit has exactly the frozen source as its sole parent. */
pub fn release_commit_parent_matches(row: string, frozen_source_sha: string) -> bool {
  const fields = split(trim(row), " ").filter({ field -> field != "" }).to_list()
  return len(fields) == 2 && lowercase(fields[1]) == lowercase(trim(frozen_source_sha))
}

pub fn release_fixup_commit_parents_match(
  merge_row: string,
  release_row: string,
  frozen_source_sha: string,
  shipped_tag_target_sha: string,
) -> bool {
  const merge_fields = split(trim(merge_row), " ").filter({ field -> field != "" }).to_list()
  const release_fields = split(trim(release_row), " ").filter({ field -> field != "" }).to_list()
  if len(merge_fields) != 3 || len(release_fields) != 2 {
    return false
  }
  return lowercase(merge_fields[1] ?? "") == lowercase(release_fields[0] ?? "")
    && lowercase(
    merge_fields[2] ?? "",
  )
    == lowercase(trim(shipped_tag_target_sha))
    && release_commit_parent_matches(
    release_row,
    frozen_source_sha,
  )
}

pub fn release_ship_prepare_route(cfg: dict) -> "prepare" | "resume_pre_tag" {
  if cfg.pre_tag_resume ?? false {
    return "resume_pre_tag"
  }
  return "prepare"
}

fn resume_pre_tag_publication(
  harness: Harness,
  cfg: ReleaseConfig,
  analysis: ReleaseAnalysis,
  run_id: string,
  initial_steps: list<dict>,
) -> ReleaseShipPrepareResult {
  let steps = initial_steps
  const publication = cfg.fixup_publication
  if publication == nil || publication.version != analysis.next_version {
    steps = steps
      + [
      recorded_step(
        "resume-immutable-release-attempt",
        "validate pre-tag recovery publication",
        command_result_fail(2, "pre-tag recovery is missing its exact immutable publication"),
      ),
    ]
    return {proceed: false, steps: steps}
  }
  const remote = release_git_remote_refs(
    harness.process,
    cfg,
    ["refs/heads/${publication.remote_ref}"],
  )
  const remote_oid = if remote.success && len(remote.refs) == 1 {
    lowercase(remote.refs[0]?.oid ?? "")
  } else {
    ""
  }
  const remote_result = if remote_oid == publication.head_oid {
    command_result_ok("origin/${publication.remote_ref} still targets ${publication.head_oid}\n")
  } else {
    command_result_fail(
      2,
      "origin/${publication.remote_ref} no longer targets ${publication.head_oid}",
    )
  }
  steps = steps
    + [
    recorded_step(
      "resume-immutable-release-attempt",
      "verify origin/${publication.remote_ref} at ${publication.head_oid}",
      remote_result,
    ),
  ]
  if !remote_result.success {
    return {proceed: false, steps: steps}
  }
  const verified = logged_command_step(
    harness,
    cfg,
    steps,
    "verify-resumed-release-commit-signature",
    release_commit_verify_args(publication.head_oid),
    run_id,
  )
  steps = verified.steps
  if !verified.success {
    return {proceed: false, steps: steps}
  }
  const parent = append_command_step(
    harness,
    cfg,
    steps,
    "verify-resumed-frozen-source-parent",
    ["git", "rev-list", "--parents", "-n", "1", publication.head_oid],
  )
  steps = parent.steps
  if !parent.success || !release_commit_parent_matches(parent.stdout ?? "", cfg.pin_sha) {
    steps = steps
      + [
      recorded_step(
        "reject-resumed-release-parent",
        "require resumed release commit sole parent ${cfg.pin_sha}",
        command_result_fail(
          2,
          "resumed release commit was not parented solely at frozen source ${cfg.pin_sha}",
        ),
      ),
    ]
    return {proceed: false, steps: steps}
  }
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "pre_tag_checkpoint_resumed",
    {remote_ref: publication.remote_ref, head_oid: publication.head_oid, pin_sha: cfg.pin_sha},
  )
  return {
    proceed: true,
    steps: steps,
    analysis: analysis,
    version: publication.version,
    publication: publication,
  }
}

@complexity(allow)
pub fn release_ship_prepare_phase(
  harness: Harness,
  cfg: ReleaseConfig,
  analysis: ReleaseAnalysis,
  agent_review_result: ReleaseAgentReviewResult,
  run_id: string,
  initial_steps: list<dict>,
  prepare: PrepareFn,
) -> ReleaseShipPrepareResult {
  let steps = initial_steps
  const pre_prepare_gate = pre_prepare_cutoff_gate(harness, cfg, analysis, steps, run_id)
  steps = pre_prepare_gate.steps
  if !pre_prepare_gate.proceed {
    return {proceed: false, steps: steps}
  }
  if release_ship_prepare_route(cfg) == "resume_pre_tag" {
    return resume_pre_tag_publication(harness, cfg, analysis, run_id, steps)
  }
  steps = steps + prepare(harness, cfg, analysis, agent_review_result, run_id)
  if execution_failed(steps) {
    return {proceed: false, steps: steps}
  }
  const validation_analysis = prepared_release_analysis(analyze_release(harness, cfg), analysis)
  const validation = run_release_generated_content_checks(
    harness,
    cfg,
    validation_analysis,
    steps,
    run_id,
  )
  steps = validation.steps
  if !validation.success {
    return {proceed: false, steps: steps}
  }
  const post_prepare_analysis = prepared_release_analysis(analyze_release(harness, cfg), analysis)
  const version = post_prepare_analysis.next_version
  const local_branch = "release/v${version}"
  const commit_plan = release_commit_plan(cfg, post_prepare_analysis, version)
  if commit_plan.already_complete {
    steps = steps
      + [
      recorded_step(
        "commit-already-complete",
        "release branch already has v${version} commit content",
        command_result_ok(
          "skipped commit because the working tree is clean and ${local_branch} already differs from pin ${cfg.pin_sha}",
        ),
      ),
    ]
  }
  for step in commit_plan.commands {
    const result = logged_command_step(harness, cfg, steps, step.name, step.argv, run_id)
    steps = result.steps
    if !result.success {
      const failed_step = steps[len(steps) - 1] ?? {}
      steps = maybe_recovery_advice_step(
        harness,
        cfg,
        post_prepare_analysis,
        steps,
        failed_step,
        run_id,
      )
      const retry_commands = retry_commands_after_agent_repair(step)
      if len(retry_commands) > 0 {
        const repair_retry = run_retry_commands_after_agent_repair(
          harness,
          cfg,
          steps,
          retry_commands,
          run_id,
        )
        steps = repair_retry.steps
        if repair_retry.success {
          continue
        }
      }
      return {proceed: false, steps: steps}
    }
  }
  const parent = append_command_step(
    harness,
    cfg,
    steps,
    "verify-frozen-source-parent",
    ["git", "rev-list", "--parents", "-n", "1", "HEAD"],
  )
  steps = parent.steps
  if !parent.success {
    return {proceed: false, steps: steps}
  }
  let parent_matches = release_commit_parent_matches(parent.stdout ?? "", cfg.pin_sha)
  if (cfg.fixup_mode ?? false) && (cfg.skip_tag ?? false) {
    const release_parent = append_command_step(
      harness,
      cfg,
      steps,
      "verify-fixup-release-parent",
      ["git", "rev-list", "--parents", "-n", "1", "HEAD^1"],
    )
    steps = release_parent.steps
    if !release_parent.success {
      return {proceed: false, steps: steps}
    }
    parent_matches = release_fixup_commit_parents_match(
      parent.stdout ?? "",
      release_parent.stdout ?? "",
      cfg.pin_sha,
      cfg.fixup_publication?.head_oid ?? "",
    )
  }
  if !parent_matches {
    const requirement = if (cfg.fixup_mode ?? false) && (cfg.skip_tag ?? false) {
      "require fixup merge first parent at frozen source ${cfg.pin_sha} and second parent at shipped tag ${cfg.fixup_publication?.head_oid ?? ""}"
    } else {
      "require release commit sole parent ${cfg.pin_sha}"
    }
    const failure = if (cfg.fixup_mode ?? false) && (cfg.skip_tag ?? false) {
      "release fixup merge ancestry did not match the frozen source and immutable tag contract"
    } else {
      "release commit was not parented solely at frozen source ${cfg.pin_sha}"
    }
    steps = steps
      + [
      recorded_step("reject-release-parent", requirement, command_result_fail(2, failure)),
    ]
    return {proceed: false, steps: steps}
  }
  const head = append_command_step(
    harness,
    cfg,
    steps,
    "resolve-release-publication-head",
    ["git", "rev-parse", "HEAD"],
  )
  steps = head.steps
  if !head.success {
    return {proceed: false, steps: steps}
  }
  const publication = release_publication(version, trim(head.stdout ?? ""))
  const verified_publication = logged_command_step(
    harness,
    cfg,
    steps,
    "verify-release-commit-signature",
    release_commit_verify_args(publication.head_oid),
    run_id,
  )
  steps = verified_publication.steps
  if !verified_publication.success {
    return {proceed: false, steps: steps}
  }
  const legacy_pr = logged_github_operation_step(
    {clock: harness.clock, fs: harness.fs},
    steps,
    "reject-legacy-release-pr",
    "prove no open mutable release/v${version} PR remains",
    run_id,
    fn() {
      const pull_request = release_github_open_pr(harness, cfg, "release/v${version}")
      if pull_request != nil {
        release_attempt_for_version(version, [pull_request])
      }
      return {found: false}
    },
  )
  steps = legacy_pr.steps
  if !legacy_pr.success {
    return {proceed: false, steps: steps}
  }
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "immutable_publication_started",
    {remote_ref: publication.remote_ref, head_oid: publication.head_oid},
  )
  const published = publish_release_publication(
    harness.process,
    {repo: cfg.repo, mock: cfg.mock},
    publication,
  )
  const publish_result = if published.success {
    command_result_ok(published.reason + "\n")
  } else {
    command_result_fail(2, published.reason)
  }
  steps = steps
    + [
    recorded_step(
      "publish-immutable-release-attempt",
      "std/git push origin ${publication.head_oid}:refs/heads/${publication.remote_ref}",
      publish_result,
    )
      + {
      publication: publication,
      push_git_receipt: published.push_git_receipt,
      remote_git_receipt: published.remote_git_receipt,
    },
  ]
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "immutable_publication_finished",
    {
      remote_ref: publication.remote_ref,
      head_oid: publication.head_oid,
      success: published.success,
      action: published.action,
    },
  )
  if !published.success {
    return {proceed: false, steps: steps}
  }
  return {
    proceed: true,
    steps: steps,
    analysis: post_prepare_analysis,
    version: version,
    publication: publication,
  }
}
