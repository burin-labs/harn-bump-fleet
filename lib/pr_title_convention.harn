/**
 * One owner for the titles of every pull request this repository opens.
 *
 * `burin-labs/harn` runs a required `PR title and description` gate that
 * refuses a title without a leading `[Area]` drawn from harn's own area list.
 * A bot pull request is not exempt: harn#7932 was opened as
 * `Start 0.10.129-dev development`, failed that gate, and had to be retitled
 * by hand before it could merge.
 *
 * Titles therefore live here rather than at the call site, and
 * `check_pr_title_convention.harn` refuses any pull-request call site this
 * module does not name.
 */
/** Where a pull request this repository opens is going to land. */
pub type PrTitleTarget = "harn" | "consumer"

/** One pull request this repository knows how to open. */
pub type PrTitleSite = {
  path: string,
  symbol: string,
  target: PrTitleTarget,
  sample: string,
  exempt_reason: string,
}

/** A title that its target's gate would refuse. */
pub type PrTitleViolation = {path: string, symbol: string, sample: string, reason: string}

/**
 * The areas `burin-labs/harn` declares to the shared title action, copied from
 * the `areas:` input of its `.github/workflows/pr-gates.yml`. A title bound for
 * harn must lead with one of these in square brackets.
 */
pub const HARN_PR_AREAS = [
  "Parser",
  "VM",
  "LLM",
  "Models",
  "Stdlib",
  "Agent",
  "CLI",
  "Modules",
  "Orchestrator",
  "ACP",
  "Evals",
  "Docs",
  "CI",
  "Release",
]

/**
 * The one title harn's gate exempts by name. `publish-release.yml` matches this
 * subject verbatim before it tags, so bracketing it would break publication.
 */
pub const RELEASE_PR_TITLE_PREFIX = "Release v"

/** Title of the pull request that refreshes the release binary-size baseline. */
pub fn pr_title_size_baseline(version: string) -> string {
  const label = trim(version)
  if label == "" {
    return "[Release] Refresh the release binary-size baseline"
  }
  return "[Release] Refresh the release binary-size baseline at ${label}"
}

/** Title of the pull request that repairs the changelog after post-merge drift. */
pub fn pr_title_changelog_paperwork(tag: string) -> string {
  const label = trim(tag)
  if label == "" {
    return "[Release] Restore the changelog after post-merge drift"
  }
  return "[Release] Restore the ${label} changelog after post-merge drift"
}

/**
 * A consumer-bound title carrying that repository's declared area.
 *
 * The area comes from the consumer's own manifest row rather than from a
 * literal here, because each repository declares its own area list and one
 * literal cannot be right for all of them. An empty area yields the bare
 * subject, which is correct for a repository that runs no title gate.
 */
pub fn pr_title_for_consumer(area: string, subject: string) -> string {
  const label = trim(area)
  const text = trim(subject)
  if label == "" {
    return text
  }
  return "[${label}] ${text}"
}

/** The area a title declares, or "" when it declares none. */
pub fn pr_title_area(title: string) -> string {
  const text = trim(title)
  if !starts_with(text, "[") {
    return ""
  }
  const close = text.index_of("]")
  if close < 2 {
    return ""
  }
  return text.substring(1, close)
}

/** True when a title would satisfy a gate declaring `areas`. */
pub fn pr_title_is_conventional(title: string, areas: list<string>) -> bool {
  const text = trim(title)
  if starts_with(text, RELEASE_PR_TITLE_PREFIX) {
    return true
  }
  const area = pr_title_area(text)
  if area == "" || !areas.contains(area) {
    return false
  }
  const rest = trim(text.substring(len(area) + 2))
  return len(rest) > 0
}

/**
 * Every harn-bound title that harn's gate would refuse.
 *
 * A consumer-bound title is reported only when it carries no area at all and
 * claims no exemption: each consumer repository declares its own area list, so
 * this repository cannot decide which area is right for one of them.
 */
pub fn pr_title_violations(sites: list<PrTitleSite>) -> list<PrTitleViolation> {
  let found: list<PrTitleViolation> = []
  for site in sites {
    if site.target == "harn" {
      if !pr_title_is_conventional(site.sample, HARN_PR_AREAS) {
        found = found.push(
          {
            path: site.path,
            symbol: site.symbol,
            sample: site.sample,
            reason: "burin-labs/harn requires a leading area from "
              + join(HARN_PR_AREAS, "|"),
          },
        )
      }
    } else if trim(site.exempt_reason) == "" && pr_title_area(site.sample) == "" {
      found = found.push(
        {
          path: site.path,
          symbol: site.symbol,
          sample: site.sample,
          reason: "a consumer-bound title carries no area and records no reason",
        },
      )
    }
  }
  return found
}

/** Where harn declares the areas its required title gate accepts. */
pub const HARN_PR_GATES_WORKFLOW_PATH = ".github/workflows/pr-gates.yml"

/**
 * The areas declared by the `areas:` input of harn's title-gate workflow.
 *
 * Returns nil when the file carries no such input, which is a refusal rather
 * than an empty list: an unreadable declaration must not read as "harn accepts
 * nothing", and it must not read as agreement with the pinned copy either.
 */
pub fn harn_declared_pr_areas(workflow_text: string) -> list<string>? {
  for line in split(workflow_text, "\n") {
    const text = trim(line)
    if !starts_with(text, "areas:") {
      continue
    }
    const value = trim(text.substring(len("areas:")))
    const unquoted = if starts_with(value, "\"") && ends_with(value, "\"") && len(value) >= 2 {
      value.substring(1, len(value) - 1)
    } else {
      value
    }
    if trim(unquoted) == "" {
      return nil
    }
    return split(unquoted, "|").map({ area -> trim(area) }).filter({ area -> area != "" }).to_list()
  }
  return nil
}

/**
 * How the pinned area list differs from what harn declares, as one sentence
 * per difference. An empty list means the two agree.
 */
pub fn harn_pr_area_drift(declared: list<string>) -> list<string> {
  let drift: list<string> = []
  for area in declared {
    if !HARN_PR_AREAS.contains(area) {
      drift = drift.push("harn declares area '${area}' that this repository does not carry")
    }
  }
  for area in HARN_PR_AREAS {
    if !declared.contains(area) {
      drift = drift.push("this repository carries area '${area}' that harn no longer declares")
    }
  }
  return drift
}

/** The call expressions that open a pull request from this repository. */
pub const PR_OPEN_CALLS = ["github_pr_create(", "github_pr_upsert(", "release_github_pr_create("]

/**
 * Files this module deliberately does not treat as call sites: the two shared
 * clients every opener routes through, which carry no title of their own, and
 * this module's own gate.
 */
pub const PR_OPEN_CALL_EXEMPT_PATHS = [
  "lib/github.harn",
  "lib/release_runtime.harn",
  "lib/pr_title_convention.harn",
  "check_pr_title_convention.harn",
]

/** True when a source file calls a pull-request opener rather than only importing one. */
pub fn pr_title_file_opens_pull_request(contents: string) -> bool {
  for line in split(contents, "\n") {
    const text = trim(line)
    if starts_with(text, "//") || starts_with(text, "*") {
      continue
    }
    for call in PR_OPEN_CALLS {
      if text.index_of(call) >= 0 {
        return true
      }
    }
  }
  return false
}

/** Call-site paths this module names, so a census can prove it missed none. */
pub fn pr_title_registered_paths(sites: list<PrTitleSite>) -> list<string> {
  let paths: list<string> = []
  for site in sites {
    if !paths.contains(site.path) {
      paths = paths.push(site.path)
    }
  }
  return paths
}

/** Observed openers this module does not name. Each one is an unowned title. */
pub fn pr_title_unregistered_paths(
  observed: list<string>,
  sites: list<PrTitleSite>,
) -> list<string> {
  const registered = pr_title_registered_paths(sites)
  let missing: list<string> = []
  for path in observed {
    if PR_OPEN_CALL_EXEMPT_PATHS.contains(path) {
      continue
    }
    if !registered.contains(path) && !missing.contains(path) {
      missing = missing.push(path)
    }
  }
  return missing
}

/**
 * Every pull request this repository opens, with the title it would carry.
 *
 * `sample` is the rendered title, so the gate check runs against the same
 * string GitHub would receive rather than a template that only looks right.
 */
pub const PR_TITLE_SITES: list<PrTitleSite> = [
  {
    path: "refresh_release_binary_size_baseline.harn",
    symbol: "pr_title_size_baseline",
    target: "harn",
    sample: "[Release] Refresh the release binary-size baseline at 0.10.129",
    exempt_reason: "",
  },
  {
    path: "lib/release_notes.harn",
    symbol: "pr_title_changelog_paperwork",
    target: "harn",
    sample: "[Release] Restore the v0.10.128 changelog after post-merge drift",
    exempt_reason: "",
  },
  {
    path: "lib/release_ship_pr.harn",
    symbol: "release_ship_pr_title",
    target: "harn",
    sample: "Release v0.10.129",
    exempt_reason: "publish-release.yml matches this subject verbatim before it tags",
  },
  {
    path: "lib/release_main_tag.harn",
    symbol: "release_unfold_title",
    target: "harn",
    sample: "[Release] Unfold the v0.10.129 bump after its post-merge certification failed",
    exempt_reason: "",
  },
  {
    path: "lib/fleet_repair.harn",
    symbol: "recover_target_branch",
    target: "consumer",
    sample: "Bump Harn runtime",
    exempt_reason:
      "the area comes from the consumer's own pr_title_area manifest row, not from a literal here",
  },
  {
    path: "lib/remote_projection.harn",
    symbol: "PROJECTION_HEADLINE",
    target: "consumer",
    sample: "chore: restore fleet-owned projections",
