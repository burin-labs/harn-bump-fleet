import { github_connector_options, github_pr_list } from "./github"
import { GithubClientOptions, GithubPullRequestSummary } from "harn-github-connector/default"

pub type ProjectionPullCensus = {pulls: list<GithubPullRequestSummary>, pages: int}

// Full REST pull records must stay below the connector's response ceiling.
const PAGE_SIZE = 10

const PAGE_LIMIT = 250

/** Read the complete proposal inventory before authorizing any retirement. */
pub fn projection_pull_census(
  harness: Harness,
  slug: string,
  base: string,
  options: GithubClientOptions = github_connector_options(),
) -> Result<ProjectionPullCensus, string> {
  let pulls: list<GithubPullRequestSummary> = []
  let numbers: list<int> = []
  let page = 1
  while page <= PAGE_LIMIT {
    const listed = github_pr_list(
      harness,
      slug,
      {state: "open", base: base, per_page: PAGE_SIZE, page: page},
      options,
    )
    const context = "proposal census page ${page} after ${len(pulls)} pull requests"
    if is_err(listed) {
      return Err(context + ": " + to_string(unwrap_err(listed)))
    }
    const batch = unwrap(listed)
    if len(batch) > PAGE_SIZE {
      return Err(context + ": response exceeded requested page size")
    }
    for pull in batch {
      if contains(numbers, pull.number) {
        return Err(context + ": duplicate pull request ${pull.number}; inventory changed")
      }
      numbers = numbers + [pull.number]
      pulls = pulls + [pull]
    }
    if len(batch) < PAGE_SIZE {
      return Ok({pulls: pulls, pages: page})
    }
    page = page + 1
  }
  return Err("proposal census exhausted ${PAGE_LIMIT} pages after ${len(pulls)} pull requests")
}
