import "std/schema"
import { next, parse_release, version_from_tag } from "std/semver"

pub type HarnReleaseVersionContract = {
  development_prerelease: string,
  workspace_after_release: "next_patch_development",
  prior_fold_workspace_shapes: list<"released_version" | "next_patch_development">,
}

pub type HarnReleaseTagContract = {
  anchor: "merged_main_commit" | "certified_candidate_commit",
  release_subject_template: string,
  candidate_trailer: string,
}

pub type HarnReleaseWorkflowContract = {
  path: string,
  name: string,
  dispatch_inputs: list<string>,
  jobs: list<string>,
  observed_steps: list<string>,
}

pub type HarnReleaseContract = {
  schema_version: "harn.release_contract.v1",
  versions: HarnReleaseVersionContract,
  changelog: {published_heading: "top_version_heading", candidate_fragments: "must_be_folded"},
  tag: HarnReleaseTagContract,
  workflows: {publish: HarnReleaseWorkflowContract, binaries: HarnReleaseWorkflowContract},
}

fn harn_release_workflow_contract_schema() {
  return schema_closed_object(
    {
      path: schema_string() + {min_len: 1},
      name: schema_string() + {min_len: 1},
      dispatch_inputs: schema_list(schema_string() + {min_len: 1}),
      jobs: schema_list(schema_string() + {min_len: 1}),
      observed_steps: schema_list(schema_string() + {min_len: 1}),
    },
  )
}

fn harn_release_contract_schema() {
  const workflow = harn_release_workflow_contract_schema()
  return schema_closed_object(
    {
      schema_version: schema_literal("harn.release_contract.v1"),
      versions: schema_closed_object(
        {
          development_prerelease: schema_string() + {min_len: 1},
          workspace_after_release: schema_literal("next_patch_development"),
          prior_fold_workspace_shapes: schema_list(
            schema_enum(["released_version", "next_patch_development"]),
          ),
        },
      ),
      changelog: schema_closed_object(
        {
          published_heading: schema_literal("top_version_heading"),
          candidate_fragments: schema_literal("must_be_folded"),
        },
      ),
      tag: schema_closed_object(
        {
          anchor: schema_enum(["merged_main_commit", "certified_candidate_commit"]),
          release_subject_template: schema_string() + {min_len: 1},
          candidate_trailer: schema_string() + {min_len: 1},
        },
      ),
      workflows: schema_closed_object({publish: workflow, binaries: workflow}),
    },
  )
}

pub fn harn_release_contract_parse(value: unknown) -> HarnReleaseContract? {
  const report = schema_validator(harn_release_contract_schema()).report(value)
  if !report.ok {
    return nil
  }
  const contract = report.value
  if contract.versions.development_prerelease == ""
    || !contract.versions.prior_fold_workspace_shapes.contains("released_version")
    || !contract.versions.prior_fold_workspace_shapes.contains("next_patch_development")
    || contract.workflows.publish.path == ""
    || contract.workflows.binaries.path == ""
    || contract.workflows.binaries.observed_steps.count == 0 {
    return nil
  }
  return contract
}

pub fn harn_release_contract_from_text(text: string) -> HarnReleaseContract? {
  const value = try {
    json_parse(text)
  } catch (_error) {
    return nil
  }
  return harn_release_contract_parse(value)
}

/** Stable version named by the contract's development workspace form. */
pub fn contract_development_release_target(
  contract: HarnReleaseContract,
  workspace_version: string,
) -> string? {
  const parsed = parse_release(trim(workspace_version))
  if parsed == nil || parsed.prerelease != contract.versions.development_prerelease {
    return nil
  }
  return to_string(parsed.major) + "." + to_string(parsed.minor) + "." + to_string(parsed.patch)
}

/** Development workspace form following one published stable release. */
pub fn contract_next_development_version(
  contract: HarnReleaseContract,
  published_version: string,
) -> string {
  return next(trim(published_version), "patch", "")
    + "-"
    + contract.versions.development_prerelease
}

/** Whether the workspace and changelog can prove the prior release fold. */
pub fn contract_workspace_proves_release_fold(
  contract: HarnReleaseContract,
  workspace_version: string,
  latest_version: string,
) -> bool {
  const workspace = trim(workspace_version)
  const latest = trim(latest_version)
  let accepted: list<string> = []
  for shape in contract.versions.prior_fold_workspace_shapes {
    accepted = accepted
      + [
        if shape == "released_version" {
          latest
        } else {
          contract_next_development_version(contract, latest)
        },
      ]
  }
  return accepted.contains(workspace)
}

/** Resolve the release target using Harn's declared workspace convention. */
pub fn contract_next_release_version(
  contract: HarnReleaseContract,
  workspace_version: string,
  latest_tag: string,
) -> string {
  const development_target = contract_development_release_target(contract, workspace_version)
  if development_target != nil {
    const expected = contract_next_development_version(contract, version_from_tag(latest_tag))
    if trim(workspace_version) != expected {
      throw "workspace development version ${workspace_version} does not match contract; expected ${expected}"
    }
    return development_target
  }
  return next(trim(workspace_version), "patch", "")
}

/** Release already published behind the current workspace form. */
pub fn contract_last_published_release_version(
  contract: HarnReleaseContract,
  workspace_version: string,
  latest_tag: string,
) -> string {
  if contract_development_release_target(contract, workspace_version) == nil
    || trim(latest_tag) == "" {
    return workspace_version
  }
  return version_from_tag(latest_tag)
}
