import { command_output_text } from "std/command"
import { read_json_result } from "std/fs"
import { GitRemoteRef, git_ls_remote, git_push } from "std/git"
import { shell_quote } from "std/runtime"
import { map_settled } from "std/settled"
import {
  github_actions_run,
  github_actions_run_cancel,
  github_actions_run_jobs,
  github_workflow_dispatch,
} from "./github"
import { run_cmd, run_git } from "./release_runtime"

pub type PlatformCertificationConfig = {
  repo: string,
  /**
   * Remote branch used for `workflow_dispatch`. Must already resolve to
   * `pin_sha` — callers publish the OID-qualified `release-certify/<pin>`
   * ref first so a busy `main` cannot race the exact-identity check.
   */
  branch: string,
  pin_sha: string,
  workspace: string,
  harn_bin: string,
}

pub type PlatformCertificationBranchResult = {
  success: bool,
  branch: string,
  action: string,
  reason: string,
}

pub type PlatformCertificationSpec = {
  platform: "windows" | "macos",
  workflow_path: string,
  required_job: string,
}

pub type PlatformCertificationDecision = {
  success: bool,
  reason: string,
  receipt?: dict,
  cancellations: list<dict>,
}

pub type PlatformCertificationAdapter = {
  dispatch: fn(PlatformCertificationSpec) -> Result<dict, dict>,
  run: fn(int) -> Result<dict, dict>,
  jobs: fn(int) -> Result<dict, dict>,
  cancel: fn(int) -> Result<dict, dict>,
  local_source: fn() -> Result<dict, dict>,
  source_lanes: fn() -> Result<list<string>, dict>,
  remote_sha: fn() -> Result<string, dict>,
  now_ms: fn() -> int,
  wait: fn(int) -> nil,
}

const PLATFORM_SPECS: list<PlatformCertificationSpec> = [
  {
    platform: "windows",
    workflow_path: ".github/workflows/windows-nightly.yml",
    required_job: "Workspace nextest (windows-latest)",
  },
  {
    platform: "macos",
    workflow_path: ".github/workflows/macos-nightly.yml",
    required_job: "Workspace nextest (macos-latest)",
  },
]

/**
 * OID-qualified remote branch used only as the hosted certification
 * `workflow_dispatch` ref. The pin is in the name so a write-once push keeps
 * `head_sha == pin_sha` by construction while `main` keeps merging.
 */
pub fn platform_certification_branch(pin_sha: string) -> string {
  const sha = lowercase(trim(pin_sha))
  if len(regex_captures("^[0-9a-f]{40}$", sha)) == 0 {
    throw "platform certification pin must be a full 40-hex OID, got: " + pin_sha
  }
  return "release-certify/${sha}"
}

fn certification_remote_ref_oid(refs: list<GitRemoteRef>, branch: string) -> string {
  const expected = "refs/heads/${branch}"
  for ref in refs {
    if !ref.peeled && ref.ref == expected {
      return lowercase(trim(ref.oid))
    }
  }
  return ""
}

/**
 * Publish or resume the write-once certification branch at `pin_sha`.
 *
 * GitHub `workflow_dispatch` cannot target a bare SHA, and dispatching on
 * `main` races merges between pin capture and run creation. This branch is the
 * stable ref those dispatches need; it is never the release PR head.
 */
pub fn ensure_platform_certification_branch(
  workspace: string,
  pin_sha: string,
  mock: bool = false,
) -> PlatformCertificationBranchResult {
  const branch = platform_certification_branch(pin_sha)
  const sha = lowercase(trim(pin_sha))
  if mock {
    return {
      success: true,
      branch: branch,
      action: "mock",
      reason: "mock certification branch ${branch}",
    }
  }
  const ref = "refs/heads/${branch}"
  const initial = git_ls_remote("origin", {repo: workspace, refs: [ref], heads: true})
  if !initial.success {
    return {
      success: false,
      branch: branch,
      action: "probe_failed",
      reason: "could not inspect certification branch ${branch}: " + initial.stderr.inline,
    }
  }
  const observed = certification_remote_ref_oid(initial.data.refs, branch)
  if observed == sha {
    return {
      success: true,
      branch: branch,
      action: "resume",
      reason: "certification branch ${branch} already targets pin ${sha}",
    }
  }
  if observed != "" {
    return {
      success: false,
      branch: branch,
      action: "conflict",
      reason:
        "certification branch ${branch} targets ${observed}, not pin ${sha}; refusing to overwrite it",
    }
  }
  const pushed = git_push("origin", "${sha}:${ref}", workspace)
  const confirmed = git_ls_remote("origin", {repo: workspace, refs: [ref], heads: true})
  const push_detail = if pushed.success {
    ""
  } else {
    "; push transport also failed: " + pushed.stderr.inline
  }
  if !confirmed.success {
    return {
      success: false,
      branch: branch,
      action: "confirmation_failed",
      reason: "could not confirm certification branch ${branch} after push: "
        + confirmed.stderr
        .inline
        + push_detail,
    }
  }
  const confirmed_oid = certification_remote_ref_oid(confirmed.data.refs, branch)
  if confirmed_oid == sha {
    return {
      success: true,
      branch: branch,
      action: if pushed.success {
        "published"
      } else {
        "reconciled"
      },
      reason: if pushed.success {
        "published certification branch ${branch} at ${sha}"
      } else {
        "origin accepted certification branch ${branch} at ${sha} despite push transport failure"
      },
    }
  }
  if confirmed_oid == "" {
    return {
      success: false,
      branch: branch,
      action: if pushed.success {
        "confirmation_missing"
      } else {
        "push_failed"
      },
      reason: "origin does not contain certification branch ${branch} after push attempt"
        + push_detail,
    }
  }
  return {
    success: false,
    branch: branch,
    action: "confirmation_mismatch",
    reason: "certification branch ${branch} resolved to ${confirmed_oid}, not pin ${sha}"
      + push_detail,
  }
}

fn connector_result(value) {
  return if is_err(value) {
    value
  } else {
    Ok(unwrap(value))
  }
}

/** Exact cancellation boundary; callers retain the returned provider receipt. */
pub fn github_actions_run_cancel_exact(slug: string, run_id: int) -> Result<dict, dict> {
  return connector_result(github_actions_run_cancel(slug, run_id))
}

fn production_adapter(
  harness: Harness,
  cfg: PlatformCertificationConfig,
) -> PlatformCertificationAdapter {
  return {
    dispatch: fn(spec) { return connector_result(
      github_workflow_dispatch(cfg.repo, spec.workflow_path, {}, cfg.branch),
    ) },
    run: fn(run_id) { return connector_result(github_actions_run(cfg.repo, run_id)) },
    jobs:
      fn(run_id) { return connector_result(github_actions_run_jobs(cfg.repo, run_id, "latest")) },
    cancel: fn(run_id) { return github_actions_run_cancel_exact(cfg.repo, run_id) },
    local_source: fn() {
      const command = "cd "
        + shell_quote(cfg.workspace)
        + " && HARN_BIN="
        + shell_quote(cfg.harn_bin)
        + " ./scripts/release_gate.sh audit --source-only"
      const result = run_cmd({repo: cfg.workspace, mock: false}, command)
      if !result.success {
        return Err({code: "local_source_failed", message: command_output_text(result)})
      }
      return Ok({status: "success"})
    },
    source_lanes: fn() {
      const lanes = contract_source_lanes(
        path_join(cfg.workspace, "scripts", "release_audit_contract.json"),
      )
      if lanes == nil {
        return Err(
          {
            code: "source_lanes_invalid",
            message: "Harn release-audit contract omitted exact local source lanes",
          },
        )
      }
      return Ok(lanes)
    },
    remote_sha: fn() {
      const result = run_git(
        {repo: cfg.workspace, mock: false},
        ["ls-remote", "origin", "refs/heads/${cfg.branch}"],
      )
      if !result.success {
        return Err({code: "remote_sha_failed", message: command_output_text(result)})
      }
      const rows =
        trim(result.stdout ?? "").split("\n").filter({ row -> trim(row) != "" }).to_list()
      if len(rows) != 1 {
        return Err({code: "remote_sha_ambiguous", message: "expected one remote branch row"})
      }
      const columns = split(rows[0], "\t")
      const sha = lowercase(trim(columns[0] ?? ""))
      if len(regex_captures("^[0-9a-f]{40}$", sha)) == 0 {
        return Err({code: "remote_sha_invalid", message: "remote branch omitted a commit SHA"})
      }
      return Ok(sha)
    },
    // `date_parse` returns Unix seconds. Keep the adapter contract and receipt
    // fields honest by converting once at the production clock boundary.
    now_ms: fn() { return (to_int(date_parse(date_now_iso())) ?? 0) * 1000 },
    wait: fn(ms) { harness.clock.sleep_ms(ms) },
  }
}

fn unique_ints(values: list<int>) -> bool {
  let seen: list<int> = []
  for value in values {
    if seen.contains(value) {
      return false
    }
    seen = seen + [value]
  }
  return true
}

fn unique_strings(values: list<string>) -> bool {
  let seen: list<string> = []
  for value in values {
    if seen.contains(value) {
      return false
    }
    seen = seen + [value]
  }
  return true
}

fn platform_error(spec: PlatformCertificationSpec, reason: string) {
  return Err({code: "platform_proof_failed", message: "${spec.platform}: ${reason}"})
}

/**
 * The lane gave up early because a sibling had already failed certification.
 *
 * Distinct from `platform_proof_failed` so a receipt reader can tell a lane
 * that proved something about its platform from one that was abandoned while
 * still healthy. The join reports a real failure in preference to this.
 */
fn platform_abandoned(spec: PlatformCertificationSpec, cause: string) {
  return Err(
    {
      code: "lane_abandoned",
      message: "${spec.platform}: abandoned after sibling lane failed (${cause})",
    },
  )
}

/**
 * Run the local audit lane, publishing its failure so the hosted lanes stop.
 *
 * This lane is a single blocking call, so it can trip the abort but cannot
 * observe one -- by the time it could check, it is already done.
 */
fn local_source_lane(started_at_ms: int, adapter: PlatformCertificationAdapter, abort) {
  const result = adapter.local_source()
  const completed = adapter.now_ms()
  if is_err(result) {
    const failure = unwrap_err(result)
    shared_set(abort, "local source lane: " + to_string(failure))
    return Err(failure)
  }
  return Ok(
    {
      kind: "local_source",
      started_at_ms: started_at_ms,
      completed_at_ms: completed,
      duration_ms: completed - started_at_ms,
    },
  )
}

/** Run one hosted platform lane, publishing a real verdict as the abort cause. */
fn platform_lane(
  cfg: PlatformCertificationConfig,
  task,
  dispatches,
  starts,
  adapter: PlatformCertificationAdapter,
  abort,
) {
  const spec = PLATFORM_SPECS[task.index]
  const dispatch = dispatches[task.index]
  const started = starts[task.index]
  if spec == nil || dispatch == nil || started == nil {
    return Err({code: "lane_identity_missing", message: "platform lane index was invalid"})
  }
  const proof = await_platform(cfg, spec, dispatch, started, adapter, abort)
  // Only a lane that reached its own verdict may doom the run. Republishing an
  // abandonment would let the first abandoned lane abort the lane that is still
  // the only one able to report a real cause.
  if is_err(proof) && !is_abandoned(proof) {
    shared_set(abort, to_string(unwrap_err(proof)))
  }
  return proof
}

/** True when this failure is a lane that stopped waiting, not one with a verdict. */
fn is_abandoned(result) -> bool {
  return to_string(unwrap_err(result)?.code ?? "") == "lane_abandoned"
}

/**
 * The failure worth reporting: a lane that reached its own verdict, in
 * preference to one that merely stopped waiting for it.
 *
 * Taking `failures[0]` alone would let an abandoned lane become the headline
 * reason and hide the cause that doomed the run, because `results` is ordered
 * by task index rather than by who failed first.
 */
fn decisive_failure(failures) {
  const decided = failures.filter({ result -> !is_abandoned(result) }).to_list()
  if len(decided) > 0 {
    return decided[0]
  }
  return failures[0]
}

@complexity(allow)
fn exact_platform_proof(
  cfg: PlatformCertificationConfig,
  spec: PlatformCertificationSpec,
  dispatch,
  run,
  jobs,
  started_at_ms: int,
  completed_at_ms: int,
) {
  if dispatch.run_id != run.id {
    return platform_error(spec, "returned run id changed")
  }
  if dispatch.workflow_path != spec.workflow_path || run.workflow_path != spec.workflow_path {
    return platform_error(spec, "workflow path changed")
  }
  if dispatch.head_sha != cfg.pin_sha || run.head_sha != cfg.pin_sha {
    return platform_error(spec, "source SHA changed")
  }
  if dispatch.head_branch != cfg.branch || run.head_branch != cfg.branch {
    return platform_error(spec, "source branch changed")
  }
  if dispatch.event != "workflow_dispatch" || run.event != "workflow_dispatch" {
    return platform_error(spec, "unexpected event")
  }
  if run.status != "completed" || run.conclusion != "success" {
    return platform_error(spec, "run was ${run.status}/${run.conclusion ?? ""}")
  }
  if run.run_attempt == nil || run.run_attempt < 1 || trim(run.url ?? "") == "" {
    return platform_error(spec, "run identity was incomplete")
  }
  const observed_jobs = jobs.jobs ?? []
  if jobs.run_id != run.id || jobs.total_count != len(observed_jobs) || len(observed_jobs) == 0 {
    return platform_error(spec, "jobs page was incomplete")
  }
  const ids = observed_jobs.map({ job -> to_int(job.id) ?? 0 }).to_list()
  const names = observed_jobs.map({ job -> to_string(job.name) }).to_list()
  if !unique_ints(ids) || !unique_strings(names) {
    return platform_error(spec, "jobs page contained duplicate identities")
  }
  for job in observed_jobs {
    if job.run_id != run.id || job.status != "completed" || job.conclusion != "success"
      || trim(
      job.url ?? "",
    )
      == "" {
      return platform_error(spec, "job `${job.name ?? ""}` was not an exact successful job")
    }
  }
  const required = observed_jobs.filter({ job -> job.name == spec.required_job }).to_list()
  if len(required) != 1 {
    return platform_error(spec, "required job was missing or ambiguous")
  }
  const projected_jobs = observed_jobs.map(
    { job ->
      return {
        id: job.id,
        run_id: job.run_id,
        name: job.name,
        status: "completed",
        conclusion: "success",
        url: job.url,
      }
    },
  )
    .to_list()
  return Ok(
    {
      platform: spec.platform,
      workflow_path: spec.workflow_path,
      required_job: spec.required_job,
      run: {
        repo: cfg.repo,
        id: run.id,
        workflow_path: run.workflow_path,
        run_attempt: run.run_attempt,
        event: "workflow_dispatch",
        status: "completed",
        conclusion: "success",
        head_sha: run.head_sha,
        url: run.url,
      },
      jobs: {
        repo: cfg.repo,
        run_id: run.id,
        total_count: jobs.total_count,
        jobs: projected_jobs,
        page: 1,
        per_page: jobs.per_page ?? 100,
      },
      started_at_ms: started_at_ms,
      completed_at_ms: completed_at_ms,
      duration_ms: completed_at_ms - started_at_ms,
    },
  )
}

fn await_platform(
  cfg: PlatformCertificationConfig,
  spec: PlatformCertificationSpec,
  dispatch,
  started_at_ms: int,
  adapter: PlatformCertificationAdapter,
  abort,
) {
  let poll = 0
  let transient_run_errors = 0
  while poll < 720 {
    const queried = adapter.run(dispatch.run_id)
    if is_err(queried) {
      const error = unwrap_err(queried)
      if lowercase(trim(to_string(error?.code ?? ""))) == "network"
        && transient_run_errors
        < 2 {
        transient_run_errors = transient_run_errors + 1
        adapter.wait(1000 * transient_run_errors)
        continue
      }
      return platform_error(spec, to_string(unwrap_err(queried)))
    }
    transient_run_errors = 0
    const run = unwrap(queried)
    if run.id != dispatch.run_id {
      return platform_error(spec, "exact run query returned another id")
    }
    if run.status == "completed" {
      let job_attempt = 0
      while job_attempt < 3 {
        const queried_jobs = adapter.jobs(dispatch.run_id)
        job_attempt = job_attempt + 1
        if !is_err(queried_jobs) {
          return exact_platform_proof(
            cfg,
            spec,
            dispatch,
            run,
            unwrap(queried_jobs),
            started_at_ms,
            adapter.now_ms(),
          )
        }
        const error = unwrap_err(queried_jobs)
        if lowercase(trim(to_string(error?.code ?? ""))) != "network" || job_attempt >= 3 {
          return platform_error(spec, to_string(error))
        }
        adapter.wait(1000 * job_attempt)
      }
    }
    if run.status != "queued" && run.status != "in_progress" && run.status != "waiting"
      && run.status
      != "pending" {
      return platform_error(spec, "run entered unknown state `${run.status}`")
    }
    poll = poll + 1
    if poll < 720 {
      // Cooperative abort. `parallel settle` never cancels a sibling, which is
      // what we want for the receipt -- every lane's outcome is recorded -- but
      // it also means a lane keeps polling for up to 720 * 10s after another
      // lane has already doomed the run. Checking the shared cell here bounds
      // the waste at one poll interval without giving up the settled results.
      const failure = shared_get(abort)
      if failure != nil {
        return platform_abandoned(spec, to_string(failure))
      }
      adapter.wait(10000)
    }
  }
  return platform_error(spec, "run did not become terminal within 720 polls")
}

fn contract_source_lanes(path: string) -> list<string>? {
  const loaded = read_json_result(path)
  if !is_ok(loaded) {
    return nil
  }
  const lanes = unwrap(loaded)?.lanes ?? []
  const names = lanes.filter({ lane -> lane?.proof == "merge_group" }).map(
    { lane -> trim(lane?.name ?? "") },
  )
    .to_list()
  if len(names) == 0 || names.any({ name -> name == "" }) || !unique_strings(names) {
    return nil
  }
  return names
}

fn cleanup_runs(adapter: PlatformCertificationAdapter, dispatches: list<dict>) -> list<dict> {
  let receipts: list<dict> = []
  for dispatch in dispatches {
    const cancelled = adapter.cancel(dispatch.run_id)
    receipts = receipts
      + [
      if is_err(cancelled) {
        {run_id: dispatch.run_id, accepted: false, error: unwrap_err(cancelled)}
      } else {
        unwrap(cancelled)
      },
    ]
  }
  return receipts
}

fn critical_path(platforms: list<dict>, local_source: dict) -> string {
  let name = ""
  let longest = -1
  for proof in platforms {
    if proof.duration_ms > longest {
      longest = proof.duration_ms
      name = proof.platform
    }
  }
  if local_source.duration_ms > longest {
    name = "local_source"
  }
  return name
}

/** Compute join wall time from injected lane timings; the critical path is a max, not a sum. */
pub fn platform_certification_join(platforms: list<dict>, local_source: dict) -> dict {
  const started_at_ms = min(
    platforms[0]?.started_at_ms ?? local_source.started_at_ms,
    min(platforms[1]?.started_at_ms ?? local_source.started_at_ms, local_source.started_at_ms),
  )
  const completed_at_ms = max(
    platforms[0]?.completed_at_ms ?? local_source.completed_at_ms,
    max(
      platforms[1]?.completed_at_ms ?? local_source.completed_at_ms,
      local_source.completed_at_ms,
    ),
  )
  return {
    started_at_ms: started_at_ms,
    completed_at_ms: completed_at_ms,
    duration_ms: completed_at_ms - started_at_ms,
    critical_path: critical_path(platforms, local_source),
  }
}

/**
 * Return a receipt timing in milliseconds.
 *
 * Early v2 receipts stored Unix seconds in fields documented as milliseconds.
 * Their epoch timestamps make them unambiguous, so reports can remain readable
 * without rejecting durable certification evidence.
 */
pub fn platform_certification_duration_ms(timing: dict) -> int {
  const duration = to_int(timing.duration_ms ?? 0) ?? 0
  const started = to_int(timing.started_at_ms ?? 0) ?? 0
  if started > 0 && started < 100000000000 {
    return duration * 1000
  }
  return duration
}

/**
 * Dispatch exact hosted runs, overlap both waits with the local source audit,
 * then close a receipt only after `cfg.branch` is re-read unchanged.
 *
 * Callers must publish `platform_certification_branch(pin_sha)` first and pass
 * that immutable ref as `cfg.branch`. Dispatching on a moving base branch races
 * merges into the exact-identity check.
 */
pub fn resolve_platform_certification(
  harness: Harness,
  cfg: PlatformCertificationConfig,
  binary_sha256: string,
  query_adapter: PlatformCertificationAdapter? = nil,
) -> PlatformCertificationDecision {
  const adapter = query_adapter ?? production_adapter(harness, cfg)
  const binary_sha = lowercase(trim(binary_sha256))
  if len(regex_captures("^[0-9a-f]{64}$", binary_sha)) == 0 {
    return {success: false, reason: "exact-pin Harn CLI hash was invalid", cancellations: []}
  }
  let dispatches: list<dict> = []
  let starts: list<int> = []
  for spec in PLATFORM_SPECS {
    const started = adapter.now_ms()
    const result = adapter.dispatch(spec)
    if is_err(result) {
      const cancellations = cleanup_runs(adapter, dispatches)
      return {
        success: false,
        reason: "dispatch failed for ${spec.platform}: " + to_string(unwrap_err(result)),
        cancellations: cancellations,
      }
    }
    const dispatch = unwrap(result)
    if dispatch.run_id == nil || dispatch.run_id < 1
      || dispatch.workflow_path != spec.workflow_path
      || dispatch.head_sha
      != cfg.pin_sha
      || dispatch.head_branch != cfg.branch
      || dispatch.event != "workflow_dispatch"
      || dispatch.run_attempt == nil
      || dispatch.run_attempt < 1
      || trim(dispatch.url ?? "") == ""
      || dispatches.any({ prior -> prior.run_id == dispatch.run_id }) {
      const cancellations = cleanup_runs(adapter, dispatches + [dispatch])
      return {
        success: false,
        reason: "dispatch returned malformed exact identity for ${spec.platform}",
        cancellations: cancellations,
      }
    }
    dispatches = dispatches + [dispatch]
    starts = starts + [started]
  }
  const local_started = adapter.now_ms()
  const tasks = [
    {kind: "platform", index: 0},
    {kind: "platform", index: 1},
    {kind: "local_source", index: 2},
  ]
  // The first lane to fail publishes its reason here; the hosted lanes read it
  // between polls and stop early. A cell is the mechanism because `parallel
  // settle` bodies run in isolated interpreters -- plain values are copied in,
  // so only an explicit shared handle crosses the boundary.
  const abort = shared_cell({scope: "task_group", key: "platform_certification_abort"})
  const settled = parallel settle tasks with { max_concurrent: 3 } { task ->
    if task.kind == "local_source" {
      return local_source_lane(local_started, adapter, abort)
    }
    return platform_lane(cfg, task, dispatches, starts, adapter, abort)
  }
  const results = map_settled(
    settled.results,
    { value, _index -> value },
    { message, _index -> Err({code: "lane_panicked", message: message}) },
  )
  const failures = results.filter({ result -> is_err(result) }).to_list()
  if len(failures) > 0 {
    return {
      success: false,
      reason: "certification lane failed: " + to_string(unwrap_err(decisive_failure(failures))),
      cancellations: cleanup_runs(adapter, dispatches),
    }
  }
  const platforms = [unwrap(results[0]), unwrap(results[1])]
  const local_timing = unwrap(results[2])
  const queried_lanes = adapter.source_lanes()
  if is_err(queried_lanes) {
    return {
      success: false,
      reason: "Harn release-audit contract omitted exact local source lanes",
      cancellations: cleanup_runs(adapter, dispatches),
    }
  }
  const lane_names = unwrap(queried_lanes)
  const remote = adapter.remote_sha()
  if is_err(remote) {
    return {
      success: false,
      reason: "could not re-read origin/${cfg.branch} after certification",
      cancellations: cleanup_runs(adapter, dispatches),
    }
  }
  // Callers dispatch on the write-once `release-certify/<pin>` branch, so this
  // re-read should still equal the pin. Movement means that write-once ref was
  // force-updated while lanes ran — fail closed for every pin mode. This is not
  // natural `main` drift; `release_cutoff_gate`'s `--at-sha` exemption still
  // observes `origin/<base>` and does not apply here.
  if unwrap(remote) != cfg.pin_sha {
    return {
      success: false,
      reason: "source branch moved while certification was running",
      cancellations: cleanup_runs(adapter, dispatches),
    }
  }
  const join = platform_certification_join(platforms, local_timing)
  const receipt = {
    schema_version: "harn.release_audit_receipt.v2",
    proof_kind: "hosted_platform",
    source: {
      repo: cfg.repo,
      branch: cfg.branch,
      sha: cfg.pin_sha,
      remote_sha_after: unwrap(remote),
    },
    platforms: platforms,
    local_source: {
      head_sha: cfg.pin_sha,
      status: "success",
      lane_names: lane_names,
      started_at_ms: local_timing.started_at_ms,
      completed_at_ms: local_timing.completed_at_ms,
      duration_ms: local_timing.duration_ms,
    },
    join: join,
    warm: {
      head_sha: cfg.pin_sha,
      command: "cargo build -p harn-cli --bin harn --locked",
      binary_sha256: binary_sha,
      status: "success",
    },
  }
  return {
    success: true,
    reason: "certified exact Windows, macOS, and local source evidence for ${cfg.pin_sha}",
    receipt: receipt,
    cancellations: [],
  }
}

/** Deterministic adapter used by release-pipeline fixtures. */
pub fn mock_platform_certification_adapter(
  cfg: PlatformCertificationConfig,
) -> PlatformCertificationAdapter {
  let clock = 100
  return {
    dispatch: fn(spec) {
      const id = if spec.platform == "windows" {
        6001
      } else {
        6002
      }
      return Ok(
        {
          run_id: id,
          workflow_path: spec.workflow_path,
          run_attempt: 1,
          head_sha: cfg.pin_sha,
          head_branch: cfg.branch,
          event: "workflow_dispatch",
          url: "https://github.com/burin-labs/harn/actions/runs/${id}",
        },
      )
    },
    run: fn(id) {
      const spec = if id == 6001 {
        PLATFORM_SPECS[0]
      } else {
        PLATFORM_SPECS[1]
      }
      return Ok(
        {
          id: id,
          workflow_path: spec.workflow_path,
          run_attempt: 1,
          head_sha: cfg.pin_sha,
          head_branch: cfg.branch,
          event: "workflow_dispatch",
          status: "completed",
          conclusion: "success",
          url: "https://github.com/burin-labs/harn/actions/runs/${id}",
        },
      )
    },
    jobs: fn(id) {
      const spec = if id == 6001 {
        PLATFORM_SPECS[0]
      } else {
        PLATFORM_SPECS[1]
      }
      return Ok(
        {
          run_id: id,
          total_count: 1,
          per_page: 100,
          jobs: [
            {
              id: id + 100,
              run_id: id,
              name: spec.required_job,
              status: "completed",
              conclusion: "success",
              url: "https://github.com/burin-labs/harn/actions/runs/${id}/job/${id + 100}",
            },
          ],
        },
      )
    },
    cancel: fn(id) { return Ok({run_id: id, accepted: true, state: "cancel_requested"}) },
    local_source: fn() { return Ok({status: "success"}) },
    source_lanes: fn() { return Ok(["rust-audit", "harn-audit", "package-audit"]) },
    remote_sha: fn() { return Ok(cfg.pin_sha) },
    now_ms: fn() {
      clock = clock + 100
      return clock
    },
    wait: fn(_ms) {
    },
  }
}
