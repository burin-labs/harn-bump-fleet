pub type FleetSelfUpdateAction = "skip" | "proceed" | "warn" | "fail" | "autoff" | "restart"

pub type FleetSelfUpdateInputs = {
  mode?: string,
  fetch_ok?: bool,
  equal?: bool,
  behind?: bool,
  ahead?: bool,
  dirty?: bool,
  opt_in?: bool,
  fleet_root?: string,
  remote_ref?: string,
}

pub type FleetSelfUpdateDecision = {
  action: FleetSelfUpdateAction,
  reason: string,
  remediation?: string,
}

pub type FleetSelfCheckConfig = {
  mode?: string,
  opt_in?: bool,
  default_branch?: string,
  marker_file?: string,
}

pub type FleetSelfCheckFastForward = {success: bool, stdout: string, stderr: string}

pub type FleetSelfCheckResult = {
  action: FleetSelfUpdateAction,
  reason: string,
  remediation: string?,
  fleet_root: string,
  remote_ref: string,
  local_sha: string?,
  remote_sha: string?,
  ff: FleetSelfCheckFastForward?,
}

/**
 * Command adapters do not yet share a covariant result contract, so normalize
 * every injected result before it enters the typed decision state below.
 */
pub type FleetSelfCheckGitRunner = fn(list<string>) -> any

/**
 * Guard the bump-fleet checkout against running its own stale release code.
 *
 * `release_harn.harn` carefully pins and freshness-checks the TARGET repo it
 * releases (`~/projects/harn`), but nothing checks whether the bump-fleet
 * checkout that release_harn.harn itself lives in is up to date with its own
 * origin. A stale bump-fleet runs old release logic and can crash mid-cut.
 *
 * The decision is a pure function of the local/remote HEAD relationship so the
 * behind/ahead/diverged/dirty matrix is unit-testable without git or the
 * network. The effect wrapper resolves the fleet root, fetches, compares, and
 * fast-forwards in place when the checkout is behind and fast-forwardable — the
 * common, non-destructive case — then requires the outer launcher to start a
 * fresh Harn process before any release work continues. It fails loud only when
 * a fast-forward would be unsafe: a diverged history, or a dirty tree without an
 * explicit `--self-update` / `FLEET_SELF_UPDATE=1` override. It never silently
 * proceeds while behind or claims newly pulled source changed loaded bytecode.
 */
/**
 * Decide what to do about bump-fleet self-staleness. Inputs:
 *   - mode: release mode; only mutating modes (prepare/ship-pr) gate.
 *   - fetch_ok: whether `git fetch origin` succeeded.
 *   - equal: local HEAD equals the remote default-branch tip.
 *   - behind: remote has commits the local checkout lacks.
 *   - ahead: local checkout has commits the remote lacks.
 *   - dirty: the fleet working tree has uncommitted changes.
 *   - opt_in: operator forced a fast-forward over a dirty tree (`--self-update`).
 *   - fleet_root / remote_ref: for actionable message text.
 * Returns `{action, reason, remediation?}` with action one of
 * "skip" | "proceed" | "warn" | "fail" | "autoff". `restart` is an
 * effect-wrapper outcome after an `autoff` decision succeeds.
 */
pub fn fleet_self_update_decision(inputs: FleetSelfUpdateInputs) -> FleetSelfUpdateDecision {
  const mode = trim(inputs.mode ?? "")
  const fleet_root = trim(inputs.fleet_root ?? "<fleet>")
  const remote_ref = trim(inputs.remote_ref ?? "origin/main")
  // Pure audit is read-only; there is no stale-code hazard worth gating on.
  if mode == "" || mode == "audit" {
    return {action: "skip", reason: "mode `${mode}` is read-only; skipping bump-fleet self-check"}
  }
  if !(inputs.fetch_ok ?? false) {
    return {
      action: "warn",
      reason: "could not fetch bump-fleet ${remote_ref}; proceeding without a freshness guarantee",
    }
  }
  if inputs.equal ?? false {
    return {action: "proceed", reason: "bump-fleet checkout is up to date with ${remote_ref}"}
  }
  const behind = inputs.behind ?? false
  const ahead = inputs.ahead ?? false
  const remediation = "git -C ${fleet_root} pull --ff-only"
  if behind && ahead {
    return {
      action: "fail",
      reason:
        "bump-fleet checkout has diverged from ${remote_ref} (local commits AND missing remote commits); a stale release harness can run old code",
      remediation: "git -C ${fleet_root} pull --rebase   # resolve the divergence, then rerun",
    }
  }
  if behind {
    // A behind-but-fast-forwardable checkout is the common case (someone landed
    // a harness fix since this checkout last pulled). Fast-forwarding is safe
    // and non-destructive, so do it by default rather than failing the launch.
    // A dirty tree is the one unsafe case: fail with a stash+pull remediation
    // unless the operator explicitly opts in with --self-update.
    if inputs.dirty ?? false {
      if inputs.opt_in ?? false {
        return {
          action: "autoff",
          reason:
            "bump-fleet checkout is behind ${remote_ref} with a dirty tree; fast-forwarding anyway (--self-update)",
          remediation: remediation,
        }
      }
      return {
        action: "fail",
        reason:
          "bump-fleet checkout is behind ${remote_ref} but the working tree is dirty; commit or stash, or pass --self-update",
        remediation: "git -C ${fleet_root} stash && ${remediation}",
      }
    }
    return {
      action: "autoff",
      reason:
        "bump-fleet checkout is behind ${remote_ref}; fast-forwarding to avoid running stale release code",
      remediation: remediation,
    }
  }
  if ahead {
    return {
      action: "proceed",
      reason:
        "bump-fleet checkout is ahead of ${remote_ref} (local unpushed commits); proceeding on newer code",
    }
  }
  // HEADs differ but neither ahead nor behind: unexpected (e.g. detached or
  // reflog rewrite). Don't block the release; surface it.
  return {
    action: "warn",
    reason:
      "bump-fleet HEAD differs from ${remote_ref} but is neither ahead nor behind; proceeding",
  }
}

fn rev_count(result: any) -> int? {
  if !(result.success ?? false) {
    return nil
  }
  return to_int(trim(result.stdout ?? ""))
}

fn fleet_tree_dirty(git: FleetSelfCheckGitRunner) -> bool {
  const status = git(["status", "--porcelain", "--untracked-files=normal"])
  return trim(status.stdout ?? "") != ""
}

fn fleet_self_check_result(
  decision: FleetSelfUpdateDecision,
  fleet_root: string,
  remote_ref: string,
  local_sha: string? = nil,
  remote_sha: string? = nil,
  ff: FleetSelfCheckFastForward? = nil,
) -> FleetSelfCheckResult {
  return {
    action: decision.action,
    reason: decision.reason,
    remediation: decision.remediation,
    fleet_root: fleet_root,
    remote_ref: remote_ref,
    local_sha: local_sha,
    remote_sha: remote_sha,
    ff: ff,
  }
}

/**
 * Effect wrapper around `fleet_self_update_decision`. `git` is a runner closure
 * `argv -> {success, stdout, stderr, status}` scoped to the bump-fleet checkout
 * (process cwd); `exists` is `path -> bool`. Config:
 *   - mode: release mode.
 *   - opt_in: `--self-update` / `FLEET_SELF_UPDATE=1`; forces a fast-forward
 *     over a dirty tree (a clean behind checkout fast-forwards without it).
 *   - default_branch: fleet default branch (usually "main").
 *   - marker_file: file that must exist at the resolved root to confirm it is
 *     the bump-fleet checkout (defaults to "release_harn.harn").
 *
 * Returns the decision record plus `{fleet_root, remote_ref, local_sha,
 * remote_sha, ff?}`. Fast-forwards in place only when the decision is "autoff",
 * then returns `restart` on success or `fail` on failure. Never mutates for any
 * other action.
 */
pub fn fleet_self_check(
  git: FleetSelfCheckGitRunner,
  exists: fn(string) -> bool,
  config: FleetSelfCheckConfig,
) -> FleetSelfCheckResult {
  const mode = trim(config.mode ?? "")
  const opt_in = config.opt_in ?? false
  const default_branch = trim(config.default_branch ?? "main")
  const marker_file = trim(config.marker_file ?? "release_harn.harn")
  if mode == "" || mode == "audit" {
    return fleet_self_check_result(
      {action: "skip", reason: "mode `${mode}` is read-only; skipping bump-fleet self-check"},
      "",
      "origin/${default_branch}",
    )
  }
  const top = git(["rev-parse", "--show-toplevel"])
  if !(top.success ?? false) {
    return fleet_self_check_result(
      {action: "warn", reason: "could not resolve bump-fleet checkout root; skipping self-check"},
      "",
      "origin/${default_branch}",
    )
  }
  const fleet_root = trim(top.stdout ?? "")
  const remote_ref = "origin/${default_branch}"
  if fleet_root == "" || !exists(path_join(fleet_root, marker_file)) {
    return fleet_self_check_result(
      {
        action: "warn",
        reason:
          "resolved root `${fleet_root}` is not a bump-fleet checkout (no ${marker_file}); skipping self-check",
      },
      fleet_root,
      remote_ref,
    )
  }
  const fetch = git(["fetch", "origin", "--quiet"])
  const fetch_ok = fetch.success ?? false
  const local = git(["rev-parse", "HEAD"])
  const remote = git(["rev-parse", remote_ref])
  const local_sha = trim(local.stdout ?? "")
  const remote_sha = trim(remote.stdout ?? "")
  if !fetch_ok || !(local.success ?? false) || !(remote.success ?? false) {
    const decision = fleet_self_update_decision(
      {mode: mode, fetch_ok: false, fleet_root: fleet_root, remote_ref: remote_ref},
    )
    return fleet_self_check_result(decision, fleet_root, remote_ref, local_sha, remote_sha)
  }
  const equal = local_sha != "" && local_sha == remote_sha
  const behind_count = rev_count(git(["rev-list", "--count", "HEAD..${remote_ref}"]))
  const ahead_count = rev_count(git(["rev-list", "--count", "${remote_ref}..HEAD"]))
  const behind = (behind_count ?? 0) > 0
  const ahead = (ahead_count ?? 0) > 0
  // Only the fast-forwardable case cares about a dirty tree, so probe git status
  // only there and leave the equal/ahead/diverged paths a single fetch+compare.
  const dirty = if behind && !ahead {
    fleet_tree_dirty(git)
  } else {
    false
  }
  const decision = fleet_self_update_decision(
    {
      mode: mode,
      fetch_ok: true,
      opt_in: opt_in,
      equal: equal,
      behind: behind,
      ahead: ahead,
      dirty: dirty,
      fleet_root: fleet_root,
      remote_ref: remote_ref,
    },
  )
  if decision.action == "autoff" {
    const ff = git(["merge", "--ff-only", remote_ref])
    const ff_ok = ff.success ?? false
    let outcome = decision
    if ff_ok {
      outcome["action"] = "restart"
      outcome["reason"] = decision.reason
        + "; restarting so the updated source is parsed before release work"
    } else {
      outcome["action"] = "fail"
      outcome["reason"] = "bump-fleet self-update fast-forward failed: " + trim(ff.stderr ?? "")
    }
    return fleet_self_check_result(
      outcome,
      fleet_root,
      remote_ref,
      local_sha,
      remote_sha,
      {success: ff_ok, stdout: trim(ff.stdout ?? ""), stderr: trim(ff.stderr ?? "")},
    )
  }
  return fleet_self_check_result(decision, fleet_root, remote_ref, local_sha, remote_sha)
}
