import { command_output } from "./shell_util"

/** Return true when a push failure is only a green-test pre-push wall-clock budget timeout. */
pub fn push_hook_budget_exceeded(command, r) {
  if r.success || !starts_with(command, "git push ") {
    return false
  }
  let out = lowercase(command_output(r))
  let hook_like = contains(out, "pre-push") || contains(out, "pre push")
    || contains(out, "hook")
  let budget_like = contains(out, "budget") || contains(out, "timed out")
    || contains(out, "timeout")
    || contains(out, "exceeded")
  let green_like = contains(out, "passed") || contains(out, "test result: ok")
    || contains(out, "0 failed")
    || contains(out, "/3187")
    || contains(out, "3187/3187")
  return hook_like && budget_like && green_like
}

/** Classify a side-effecting release command result for audit and recovery handling. */
pub fn step_classification(command, r) {
  if r.success {
    return "ok"
  }
  if push_hook_budget_exceeded(command, r) {
    return "push_hook_budget_exceeded_after_green_tests"
  }
  if contains(command, "lint-md") || contains(command, "markdownlint-cli2") {
    return "generated_markdown_lint_failed"
  }
  if starts_with(command, "git push ") {
    return "push_failed"
  }
  return "command_failed"
}

/** Return operator-facing recovery advice for known release command failure classes. */
pub fn step_recovery_hint(command, r) {
  if push_hook_budget_exceeded(command, r) {
    return "Tests reported green before the pre-push hook exceeded its wall-clock budget. release_harn retries this exact class with `git push --no-verify` and records both attempts."
  }
  if !r.success && starts_with(command, "git push ") {
    return "Push failed for a reason that was not classified as a green-test hook budget timeout. Keep the release branch and commit, inspect stdout/stderr in the run artifacts, then rerun or push manually after fixing the hook failure."
  }
  if !r.success && (contains(command, "lint-md") || contains(command, "markdownlint-cli2")) {
    return "Generated markdown failed the repository markdown lint. Let the recovery agent edit the generated release diff, then retry the same lint command before committing."
  }
  return ""
}

/** Convert a command result into the normalized release execution step shape. */
pub fn recorded_step(name, command, r) {
  return {
    name: name,
    command: command,
    success: r.success,
    status: r.status,
    stdout: r.stdout,
    stderr: r.stderr,
    classification: step_classification(command, r),
    recovery_hint: step_recovery_hint(command, r),
  }
}

/** Return the compact failure context passed to recovery agents and reports. */
pub fn recovery_step_ref(step) {
  if step == nil {
    return nil
  }
  return {
    name: step.name,
    command: step.command,
    success: step.success,
    status: step.status,
    classification: step.classification ?? "",
    recovery_hint: step.recovery_hint ?? "",
    command_id: step.command_id ?? "",
    output_path: step.output_path ?? "",
    live_log: step.live_log ?? "",
    tail: step.tail ?? "",
    stdout: if step.live_log ?? "" == "" {
      step.stdout
    } else {
      "(full output is in live_log)"
    },
    stderr: if step.live_log ?? "" == "" {
      step.stderr
    } else {
      "(full output is in live_log)"
    },
  }
}

/** Return compact failure contexts for all recorded execution steps. */
pub fn recovery_step_refs(steps) {
  var out = []
  for step in steps ?? [] {
    out = out + [recovery_step_ref(step)]
  }
  return out
}

/** Return true if execution contains an unrecovered failed step. */
pub fn execution_failed(execution) {
  if execution == nil {
    return false
  }
  var recovered_budget_push = false
  var recovered_after_agent_repair = []
  for step in execution {
    if step.name == "push-no-verify-after-green-hook-budget" && step.success {
      recovered_budget_push = true
    }
    if ends_with(step.name, "-after-agent-repair") && step.success {
      recovered_after_agent_repair = recovered_after_agent_repair
        + [step.name[0:len(step.name) - len("-after-agent-repair")]]
    }
  }
  for step in execution {
    if !step.success {
      if step.classification == "push_hook_budget_exceeded_after_green_tests" && recovered_budget_push {
        continue
      }
      if recovered_after_agent_repair.contains(step.name) {
        continue
      }
      return true
    }
  }
  return false
}

/** Return the last failed execution step, or nil when all steps succeeded. */
pub fn last_failed_step(execution) {
  var failed = nil
  if execution == nil {
    return nil
  }
  for step in execution {
    if !step.success {
      failed = step
    }
  }
  return failed
}
