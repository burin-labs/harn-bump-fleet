/** The YAML parser owns document shape; source spans preserve consumer comments. */
type DependabotDocument = {version: int, updates: list<dict>}

type IgnoreEntries = list<dict>

type IgnoreSpan = {start: int, header: int?, end: int}

fn document(source: string) -> DependabotDocument {
  return schema_expect(yaml_parse(source), schema_of(DependabotDocument))
}

fn actions(document: DependabotDocument) -> dict {
  const entries = document.updates.filter(
    { entry -> entry["package-ecosystem"] == "github-actions" },
  )
    .to_list()
  if len(entries) != 1 || document.updates[0] != entries[0] {
    throw "Dependabot prefix requires exactly one leading GitHub Actions entry"
  }
  return entries[0] ?? {}
}

fn ignores(entry: dict) -> IgnoreEntries {
  return schema_expect(entry["ignore"] ?? [], schema_of(IgnoreEntries))
}

fn comment_or_blank(line: string) -> bool {
  return trim(line) == "" || starts_with(trim(line), "#")
}

fn owned_ignore_is_last(template: string) -> bool {
  const fields = split(template, "\n").filter(
    { line -> len(regex_captures(r"^    [A-Za-z_][A-Za-z0-9_-]*:", line)) > 0 },
  )
    .to_list()
  return len(fields) > 0 && fields[len(fields) - 1] == "    ignore:"
}

/** Locate an actual parsed Actions field, never a comment or quoted value. */
fn local_ignore_span(lines: list<string>, prior_tail: bool) -> IgnoreSpan {
  let header: int? = nil
  let first_item: int? = nil
  for index in range(0, len(lines)) {
    const line = lines[index] ?? ""
    if !comment_or_blank(line) && !starts_with(line, "    ") {
      break
    }
    if line == "    ignore:" {
      if header != nil {
        throw "consumer Actions ignore field occurs more than once"
      }
      header = index
      break
    }
    if prior_tail && !comment_or_blank(line) {
      if !starts_with(line, "      - ") {
        break
      }
      first_item = index
      break
    }
  }
  const item_start = header ?? first_item
  if item_start == nil {
    throw "consumer Actions ignore source shape cannot be composed safely"
  }
  let start = item_start ?? 0
  while start > 0 {
    const before = lines[start - 1] ?? ""
    if trim(before) != "" && !starts_with(before, "    #") {
      break
    }
    start = start - 1
  }
  let end = (item_start ?? 0) + 1
  const content_start = if header == nil {
    item_start ?? 0
  } else {
    (header ?? 0) + 1
  }
  for index in range(content_start, len(lines)) {
    const line = lines[index] ?? ""
    if comment_or_blank(line) {
      continue
    }
    if !starts_with(line, "      ") {
      break
    }
    end = index + 1
  }
  if header != nil && end <= (header ?? 0) + 1 {
    throw "consumer Actions ignore source has no measured entries"
  }
  return {start: start, header: header, end: end}
}

fn consumer_fields(entry: dict, owner: dict) -> dict {
  let extra = entry.removing("ignore")
  for key in owner.keys() {
    extra = extra.removing(key)
  }
  return extra
}

/** Replace a verified historical prefix, preserving one composed ignore list. */
pub fn compose_dependabot_projection(
  body: string,
  historical_prefixes: list<string>,
  template: string,
) -> string {
  const current = document(body)
  const current_actions = actions(current)
  const canonical = document(template)
  const canonical_actions = actions(canonical)
  if len(canonical.updates) != 1 {
    throw "canonical Dependabot prefix must own only the Actions entry"
  }
  if starts_with(body, template) {
    return body
  }
  const previous = historical_prefixes.sort_by({ prefix -> -len(prefix) }).find(
    { prefix -> trim(prefix) != "" && starts_with(body, prefix) },
  )
  if previous == nil {
    throw "current config has no verified canonical template prefix"
  }
  const old_prefix = previous ?? ""
  const prior_actions = actions(document(old_prefix))
  const prior_ignores = ignores(prior_actions)
  const local_ignores = ignores(current_actions).filter({ entry -> !prior_ignores.contains(entry) })
    .to_list()
  const suffix = body.substring(len(old_prefix))
  let rendered = template + suffix
  if len(local_ignores) > 0 {
    if !owned_ignore_is_last(template) {
      throw "canonical Actions ignore list must be the final owned field before composing consumer entries"
    }
    const lines = split(suffix, "\n")
    const span = local_ignore_span(lines, owned_ignore_is_last(old_prefix))
    let moved: list<string> = []
    let retained: list<string> = []
    for index in range(0, len(lines)) {
      const line = lines[index] ?? ""
      if index >= span.start && index < span.end {
        if index != span.header {
          moved = moved + [line]
        }
      } else {
        retained = retained + [line]
      }
    }
    rendered = template + join(moved, "\n") + "\n" + join(retained, "\n")
  }
  // The canonical parser rejects duplicate keys, and structural equality
  // guards every local field and all other ecosystem blocks after the splice.
  const projected = document(rendered)
  const projected_actions = actions(projected)
  if ignores(projected_actions) != ignores(canonical_actions) + local_ignores
    || consumer_fields(projected_actions, canonical_actions)
      != consumer_fields(current_actions, prior_actions)
    || projected.updates.skip(1).to_list() != current.updates.skip(1).to_list()
    || !starts_with(rendered, template) {
    throw "Dependabot composition did not preserve measured consumer policy"
  }
  return rendered
}
