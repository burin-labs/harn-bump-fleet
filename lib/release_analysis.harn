import { changelog_find_section, changelog_parse_sections } from "std/changelog"
import { next, parse, strip_v, version_from_release_branch, version_from_tag } from "std/semver"
import { truncate_text } from "std/text"
// Extracted release-harness stage. See AGENTS.md for ownership.
import { release_log_range_args } from "./git"
import { ReleasePublication } from "./release_publication"
import {
  ReleaseConfig,
  checked_git,
  latest_release_tag,
  probe_ok,
  prompt_asset,
  read_repo_file,
  release_github_pr_files,
  release_github_pr_list,
  release_github_pr_view,
} from "release_runtime"

pub type ReleaseAnalysis = {
  repo: string,
  mode: string,
  bump: string,
  model: string,
  provider: string,
  mock: bool,
  operator_focus: string,
  branch: string,
  expected_branch: string,
  base_branch: string,
  pin_sha: string,
  pin_sha_input: string,
  fixup_mode: bool,
  fixup_tag: string,
  fixup_pr_url: string,
  fixup_publication: ReleasePublication?,
  fixup_release_exists?: bool,
  fixup_missing_assets?: list<string>,
  current_version: string,
  next_version: string,
  prepared_release: bool,
  latest_tag: string,
  changelog_top: string,
  dirty_files: int,
  status: string,
  diff_stat: string,
  diff_names: string,
  commits_since_latest_tag: string,
  commit_file_changes_since_latest_tag: string,
  commit_stats_since_latest_tag: string,
  post_tag_pr_numbers: list<int>,
  post_tag_pr_details: string,
  recent_merged_prs: string,
  changelog_section: string,
  changelog_unreleased_section: string,
  release_scripts: {release_ship: bool, release_gate: bool},
  workflows: {publish_release: bool, build_release_binaries: bool},
  release_scope_findings: list<string>,
  deterministic_findings: list<string>,
  run_session_view?: dict,
}

pub type ReleaseScope = {expected_prs: list<int>, rejected_prs: list<int>}

pub type CompactReleaseAnalysis = {
  repo: string,
  mode: string,
  bump: string,
  branch: string,
  expected_branch: string,
  base_branch: string,
  pin_sha: string,
  current_version: string,
  next_version: string,
  operator_focus: string,
  latest_tag: string,
  changelog_top: string,
  dirty_files: int,
  diff_names: string,
  post_tag_commit_count: int,
  latest_post_tag_commit: string,
  commits_since_latest_tag: string,
  commit_stats_since_latest_tag: string,
  commit_file_changes_since_latest_tag: string,
  post_tag_pr_numbers: list<int>,
  post_tag_pr_details: string,
  changelog_section: string,
  changelog_unreleased_section: string,
  release_scripts: {release_ship: bool, release_gate: bool},
  workflows: {publish_release: bool, build_release_binaries: bool},
  deterministic_findings: list<string>,
  recent_merged_prs: string,
  suggested_read_only_inspections: list<string>,
}

pub fn current_version(harness: Harness, cfg: ReleaseConfig) -> string {
  const text = read_repo_file(harness, cfg, "Cargo.toml")
  const matches = regex_captures("(?m)^version\\s*=\\s*\"([^\"]+)\"", text)
  if len(matches) == 0 {
    return ""
  }
  return matches[0].groups[0]
}

pub fn changelog_top(harness: Harness, cfg: ReleaseConfig) -> string {
  const sections = changelog_parse_sections(read_repo_file(harness, cfg, "CHANGELOG.md"))
  if is_err(sections) {
    throw unwrap_err(sections).message
  }
  for section in unwrap(sections) {
    const version = strip_v(substring(section.heading, 3, len(section.heading)))
    if starts_with(section.heading, "## v") && parse(version) != nil {
      return version
    }
  }
  return ""
}

fn changelog_section(harness: Harness, cfg: ReleaseConfig) -> string {
  const text = read_repo_file(harness, cfg, "CHANGELOG.md")
  const top = changelog_top(harness, cfg)
  if top == "" {
    return ""
  }
  const section = changelog_find_section(text, "v${top}")
  return is_ok(section) ? unwrap(section).body : ""
}

fn changelog_unreleased_section(harness: Harness, cfg: ReleaseConfig) -> string {
  const section = changelog_find_section(read_repo_file(harness, cfg, "CHANGELOG.md"), "Unreleased")
  return is_ok(section) ? unwrap(section).body : ""
}

fn diff_names(cfg: ReleaseConfig) -> string {
  return checked_git(cfg, ["diff", "HEAD", "--name-only"])
}

fn release_file_changes(cfg: ReleaseConfig, latest_tag: string) -> string {
  return checked_git(
    cfg,
    ["log", "--name-status", "--pretty=format:commit %h %s", "--no-merges"]
      + release_log_range_args(
      latest_tag,
      cfg.pin_sha,
    ),
  )
}

fn release_commit_stats(cfg: ReleaseConfig, latest_tag: string) -> string {
  return checked_git(
    cfg,
    ["log", "--stat", "--oneline", "--no-renames", "--no-merges"]
      + release_log_range_args(
      latest_tag,
      cfg.pin_sha,
    ),
  )
}

fn count_lines(text: string) -> int {
  const t = trim(text)
  if t == "" {
    return 0
  }
  return len(t.split("\n"))
}

fn changelog_section_for_agent(analysis: ReleaseAnalysis) -> string {
  if analysis.changelog_top == analysis.next_version {
    return truncate_text(analysis.changelog_section, 8000)
  }
  const unreleased = trim(analysis.changelog_unreleased_section ?? "")
  if unreleased != "" {
    return "No `v${analysis.next_version}` section exists yet. CHANGELOG.md has this non-empty `## Unreleased` section that will be promoted or replaced during prepare; preserve these existing entries and fold in only the missing post-tag release notes:\n\n"
      + truncate_text(
      unreleased,
      10000,
    )
  }
  return "No `v${analysis.next_version}` section exists yet. CHANGELOG.md currently starts at `v${analysis.changelog_top}`; draft the next section from the post-tag commit/file evidence instead of summarizing the old release."
}

pub fn first_post_tag_commit(analysis: ReleaseAnalysis) -> string {
  const commits = trim(analysis.commits_since_latest_tag)
  if commits == "" {
    return "(none)"
  }
  return trim(commits.split("\n")[0])
}

fn post_tag_commit_count(analysis: ReleaseAnalysis) -> int {
  const commits = trim(analysis.commits_since_latest_tag)
  if commits == "" {
    return 0
  }
  return len(commits.split("\n").filter({ line -> trim(line) != "" }))
}

pub fn pr_numbers_from_commits(commits: string) -> list<int> {
  let seen = {}
  let out = []
  for line in split(commits, "\n") {
    for m in regex_captures("\\(#([0-9]+)\\)", line) {
      const number = to_int(m.groups[0])
      if number == nil {
        continue
      }
      if seen[number] ?? false {
        continue
      }
      seen[number] = true
      out = out + [number]
    }
  }
  return out
}

fn has_number(values: list<int>, number: int) -> bool {
  for value in values {
    if value == number {
      return true
    }
  }
  return false
}

pub fn release_scope_findings(cfg: ReleaseScope, observed_pr_numbers: list<int>) -> list<string> {
  let findings = []
  for number in cfg.expected_prs {
    if !has_number(observed_pr_numbers, number) {
      findings = findings
        + ["release scope expected PR #${number} is absent from the selected range"]
    }
  }
  for number in cfg.rejected_prs {
    if has_number(observed_pr_numbers, number) {
      findings = findings
        + ["release scope rejected PR #${number} is present in the selected range"]
    }
  }
  return findings
}

fn release_pr_details(cfg: ReleaseConfig, commits: string) -> string {
  const numbers = pr_numbers_from_commits(commits)
  if len(numbers) == 0 {
    return ""
  }
  if cfg.mock {
    return "PR #998\n{\"number\":998,\"title\":\"release: consolidate harn release PR flow\",\"body\":\"Mock PR body describing the one-PR release handoff, auto-merge enablement, and release workflow consolidation.\",\"files\":[\"CHANGELOG.md\",\"scripts/release_ship.sh\"]}"
  }
  let blocks = []
  for number in numbers {
    if len(blocks) >= 20 {
      break
    }
    const details = try {
      const pr = release_github_pr_view(cfg, number)
      const files = release_github_pr_files(cfg, number)
      json_stringify(
        {
          number: pr.number,
          title: pr.title,
          url: pr.url,
          body: pr.body,
          files: files.files.map({ file -> file.filename }),
        },
      )
    } catch (e) {
      nil
    }
    if details != nil {
      blocks = blocks + ["PR #${number}\n" + truncate_text(details, 5000)]
    } else {
      blocks = blocks
        + ["PR #${number}\nmetadata unavailable from the GitHub connector"]
    }
  }
  return truncate_text(blocks.join("\n\n---\n\n"), 24000)
}

pub fn compact_agent_analysis(analysis: ReleaseAnalysis) -> CompactReleaseAnalysis {
  return {
    repo: analysis.repo,
    mode: analysis.mode,
    bump: analysis.bump,
    branch: analysis.branch,
    expected_branch: analysis.expected_branch,
    base_branch: analysis.base_branch,
    pin_sha: analysis.pin_sha,
    current_version: analysis.current_version,
    next_version: analysis.next_version,
    operator_focus: analysis.operator_focus,
    latest_tag: analysis.latest_tag,
    changelog_top: analysis.changelog_top,
    dirty_files: analysis.dirty_files,
    diff_names: truncate_text(analysis.diff_names, 1000),
    post_tag_commit_count: post_tag_commit_count(analysis),
    latest_post_tag_commit: first_post_tag_commit(analysis),
    commits_since_latest_tag: truncate_text(analysis.commits_since_latest_tag, 8000),
    commit_stats_since_latest_tag: truncate_text(analysis.commit_stats_since_latest_tag, 12000),
    commit_file_changes_since_latest_tag: truncate_text(
      analysis.commit_file_changes_since_latest_tag,
      12000,
    ),
    post_tag_pr_numbers: analysis.post_tag_pr_numbers,
    post_tag_pr_details: truncate_text(analysis.post_tag_pr_details, 12000),
    changelog_section: changelog_section_for_agent(analysis),
    changelog_unreleased_section: truncate_text(analysis.changelog_unreleased_section, 10000),
    release_scripts: analysis.release_scripts,
    workflows: analysis.workflows,
    deterministic_findings: analysis.deterministic_findings,
    recent_merged_prs: truncate_text(analysis.recent_merged_prs, 5000),
    suggested_read_only_inspections: [
      "git log --oneline --no-merges --max-count=80 ${analysis.latest_tag}..${analysis.pin_sha}",
      "git diff --stat --stat-count=80 ${analysis.latest_tag}..${analysis.pin_sha}",
      "git show --stat --oneline --no-renames --max-count=20 ${analysis.latest_tag}..${analysis.pin_sha}",
      "sed -n '1,120p' CHANGELOG.md",
      "sed -n '1,180p' scripts/release_ship.sh",
      "sed -n '1,180p' .github/workflows/publish-release.yml",
    ],
  }
}

/**
 * Concrete post-tag PR evidence the audit's `CHANGELOG coverage:` line must
 * cite — the deterministic validator (`lib/release_audit`) rejects a generic
 * coverage line that names neither a `#`-prefixed PR nor the PR count.
 */
pub fn pr_evidence_count(analysis: ReleaseAnalysis) -> int {
  return len(analysis.post_tag_pr_numbers)
}

pub fn pr_evidence_sample(analysis: ReleaseAnalysis) -> string {
  const prs = analysis.post_tag_pr_numbers
  if len(prs) > 0 {
    return "#${prs[0]}"
  }
  return ""
}

pub fn release_finalization_prompt(analysis: ReleaseAnalysis) -> string {
  if analysis.fixup_mode ?? false {
    return render(
      prompt_asset("release_fixup_finalization.harn.prompt"),
      {
        target_version: analysis.next_version,
        fixup_tag: analysis.fixup_tag ?? "",
        base_branch: analysis.base_branch,
        release_fact_sheet: release_fact_sheet(analysis),
      },
    )
  }
  return render(
    prompt_asset("release_finalization.harn.prompt"),
    {
      target_version: "v${analysis.next_version}",
      tag_range: "${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}",
      first_post_tag_commit: first_post_tag_commit(analysis),
      post_tag_pr_count: pr_evidence_count(analysis),
      sample_pr: pr_evidence_sample(analysis),
      release_fact_sheet: release_fact_sheet(analysis),
      changelog_draft_instructions: release_changelog_draft_prompt(analysis),
    },
  )
}

pub fn release_changelog_draft_prompt(analysis: ReleaseAnalysis) -> string {
  return render(
    prompt_asset("release_changelog_draft.harn.prompt"),
    {
      target_version: "v${analysis.next_version}",
      tag_range: "${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}",
      first_post_tag_commit: first_post_tag_commit(analysis),
    },
  )
}

pub fn release_fact_sheet(analysis: ReleaseAnalysis) -> string {
  return """
- Repo: `${analysis.repo}`.
- Mode: `${analysis.mode}`.
- Version: `${analysis.current_version}` -> `${analysis.next_version}` (${analysis.bump}).
- Pinned base SHA: `${analysis.pin_sha ?? "(unset)"}` — release branch is anchored here; commits that landed on `${analysis.base_branch}` after this run started are excluded from the release.
- Latest tag/range: `${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}`.
- Post-tag commit count: ${post_tag_commit_count(analysis)}.
- First post-tag commit: `${first_post_tag_commit(analysis)}`.
- Release-note source rule: use only commits in `${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}`
  plus authored `## Unreleased` content. Recent merged PRs are historical
  context only when they are not in that post-tag range.
- Operator focus: ${if trim(analysis.operator_focus ?? "") == "" {
    "none"
  } else {
    analysis.operator_focus
  }}.
- Current CHANGELOG top: `${analysis.changelog_top}`.
- Deterministic findings: ${if len(analysis.deterministic_findings ?? []) == 0 {
    "none"
  } else {
    join(analysis.deterministic_findings, "; ")
  }}.

Authored CHANGELOG content to preserve or update:
${changelog_section_for_agent(analysis)}

Recent post-tag commits:
${truncate_text(analysis.commits_since_latest_tag, 8000)}

Post-tag PR descriptions and touched files:
${if trim(analysis.post_tag_pr_details ?? "") == "" {
    "(none)"
  } else {
    truncate_text(analysis.post_tag_pr_details, 12000)
  }}

Representative per-commit stats:
${truncate_text(analysis.commit_stats_since_latest_tag, 12000)}

Representative per-commit file changes:
${truncate_text(analysis.commit_file_changes_since_latest_tag, 12000)}
"""
}

pub fn analyze_release(harness: Harness, cfg: ReleaseConfig) -> ReleaseAnalysis {
  const branch = checked_git(cfg, ["branch", "--show-current"])
  const current = current_version(harness, cfg)
  const status = checked_git(cfg, ["status", "--porcelain", "--untracked-files=normal"])
  const latest_tag = latest_release_tag(cfg)
  const top = changelog_top(harness, cfg)
  const branch_version = version_from_release_branch(branch)
  const prepared_release = branch_version != "" && branch_version == current && top == current
    && version_from_tag(
    latest_tag,
  )
    != current
  const next = if prepared_release {
    current
  } else {
    next(current, cfg.bump)
  }
  const baseline = if prepared_release {
    version_from_tag(latest_tag)
  } else {
    current
  }
  const expected_branch = "release/v${next}"
  const committed_release_content = prepared_release && trim(status) == ""
    && branch == expected_branch
  const diff_stat = if committed_release_content {
    checked_git(cfg, ["diff", "--stat", "${cfg.pin_sha}..HEAD"])
  } else {
    checked_git(cfg, ["diff", "HEAD", "--stat"])
  }
  const diff_name_list = if committed_release_content {
    checked_git(cfg, ["diff", "--name-only", "${cfg.pin_sha}..HEAD"])
  } else {
    diff_names(cfg)
  }
  const commits = checked_git(
    cfg,
    ["log", "--oneline", "--no-merges"] + release_log_range_args(latest_tag, cfg.pin_sha),
  )
  const post_tag_pr_numbers = pr_numbers_from_commits(commits)
  const commit_file_changes = release_file_changes(cfg, latest_tag)
  const commit_stats = release_commit_stats(cfg, latest_tag)
  const post_tag_pr_details = release_pr_details(cfg, commits)
  const section = changelog_section(harness, cfg)
  const unreleased_section = changelog_unreleased_section(harness, cfg)
  const recent_merged_prs = json_stringify(
    release_github_pr_list(cfg, {state: "merged", base: cfg.base, limit: 30}).map(
      { pr ->
        return {
          number: pr.number,
          title: pr.title,
          merged_at: pr.merged_at,
          url: pr.url,
          head_ref: pr.head.ref,
          merge_commit_oid: pr.merge_commit_oid,
        }
      },
    ),
  )
  const scripts = {
    release_ship: probe_ok(cfg, "test -x scripts/release_ship.sh && echo release_ship=ok"),
    release_gate: probe_ok(cfg, "test -x scripts/release_gate.sh && echo release_gate=ok"),
  }
  const workflows = {
    publish_release: probe_ok(
      cfg,
      "test -f .github/workflows/publish-release.yml && echo publish_workflow=ok",
    ),
    build_release_binaries: probe_ok(
      cfg,
      "test -f .github/workflows/build-release-binaries.yml && echo binary_workflow=ok",
    ),
  }
  let findings = []
  if trim(status) == "" && trim(diff_name_list) == "" {
    findings = findings + ["working tree has no candidate release content"]
  }
  if top != next {
    findings = findings
      + [
      "CHANGELOG.md top entry is v${top}; expected v${next} for --bump ${cfg.bump}",
    ]
  }
  if cfg.mode != "audit" && branch == cfg.base {
    findings = findings
      + [
      "release branch setup will move from ${cfg.base} to ${expected_branch} before preparing",
    ]
  }
  if cfg.mode != "audit" && branch != expected_branch {
    findings = findings
      + ["current branch is ${branch}; branch setup will target ${expected_branch}"]
  }
  if !scripts.release_ship || !scripts.release_gate {
    findings = findings + ["release scripts are missing or not executable"]
  }
  if !workflows.publish_release || !workflows.build_release_binaries {
    findings = findings + ["release cascade workflows are missing"]
  }
  const scope_findings = release_scope_findings(cfg, post_tag_pr_numbers)
  findings = findings + scope_findings
  return {
    repo: if cfg.mock {
      "(mock harn repo)"
    } else {
      cfg.repo
    },
    mode: cfg.mode,
    bump: cfg.bump,
    model: cfg.model,
    provider: cfg.provider,
    mock: cfg.mock,
    operator_focus: cfg.release_focus,
    branch: branch,
    expected_branch: expected_branch,
    base_branch: cfg.base,
    pin_sha: cfg.pin_sha,
    pin_sha_input: cfg.pin_sha_input ?? "",
    fixup_mode: cfg.fixup_mode ?? false,
    fixup_tag: cfg.fixup_tag ?? "",
    fixup_pr_url: cfg.fixup_pr_url ?? "",
    fixup_publication: cfg.fixup_publication,
    current_version: baseline,
    next_version: next,
    prepared_release: prepared_release,
    latest_tag: latest_tag,
    changelog_top: top,
    dirty_files: count_lines(status),
    status: status,
    diff_stat: diff_stat,
    diff_names: diff_name_list,
    commits_since_latest_tag: commits,
    commit_file_changes_since_latest_tag: commit_file_changes,
    commit_stats_since_latest_tag: commit_stats,
    post_tag_pr_numbers: post_tag_pr_numbers,
    post_tag_pr_details: post_tag_pr_details,
    recent_merged_prs: recent_merged_prs,
    changelog_section: section,
    changelog_unreleased_section: unreleased_section,
    release_scripts: scripts,
    workflows: workflows,
    release_scope_findings: scope_findings,
    deterministic_findings: findings,
  }
}
