import { ReleaseGitRemoteObservation } from "./release_runtime"

pub type ReleaseGitRemoteRetryPolicy = {max_attempts?: int, base_delay_ms?: int, cap_delay_ms?: int}

/**
 * Classify only transport failures for which repeating the same read is safe.
 * Authentication, authorization, repository identity, and ref syntax failures
 * stay terminal even though git reports every one of them with exit code 128.
 */
pub fn release_git_remote_observation_is_transient(observed: ReleaseGitRemoteObservation) -> bool {
  if observed.success {
    return false
  }
  const error = lowercase(trim(observed.stderr))
  const category = lowercase(trim(to_string(observed.receipt?.exit_category ?? "")))
  if contains(["network", "transient_network", "timeout"], category) {
    return true
  }
  return [
    "could not resolve host",
    "temporary failure in name resolution",
    "failed to connect",
    "connection timed out",
    "connection reset",
    "network is unreachable",
    "operation timed out",
    "tls connection was non-properly terminated",
    "ssl_error_syscall",
    "empty reply from server",
    "remote end hung up unexpectedly",
    "recv failure",
    "send failure",
  ]
    .any({ marker -> contains(error, marker) })
}

fn release_git_remote_retry_delay_ms(
  retry_index: int,
  base_delay_ms: int,
  cap_delay_ms: int,
) -> int {
  let delay = base_delay_ms
  for _ in range(0, retry_index) {
    delay = min(delay * 2, cap_delay_ms)
  }
  return min(delay, cap_delay_ms)
}

fn release_git_remote_retry_result(
  observed: ReleaseGitRemoteObservation,
  attempts: int,
) -> ReleaseGitRemoteObservation {
  return {
    success: observed.success,
    exit_code: observed.exit_code,
    refs: observed.refs,
    receipt: observed.receipt,
    stderr: observed.stderr,
    attempts: attempts,
    transient_retries: max(0, attempts - 1),
  }
}

/**
 * Retry one idempotent remote-ref observation with bounded exponential backoff.
 * Four total attempts and a 5s/10s/20s default tail keep a transient GitHub or
 * DNS outage from overturning a completed release without hiding persistent or
 * deterministic git failures.
 */
pub fn retry_release_git_remote_observation(
  clock: HarnessClock,
  observe: fn() -> ReleaseGitRemoteObservation,
  policy: ReleaseGitRemoteRetryPolicy = {},
) -> ReleaseGitRemoteObservation {
  const max_attempts = max(1, policy.max_attempts ?? 4)
  const base_delay_ms = max(0, policy.base_delay_ms ?? 5000)
  const cap_delay_ms = max(base_delay_ms, policy.cap_delay_ms ?? 20000)
  let attempt = 0
  let last: ReleaseGitRemoteObservation = {
    success: false,
    exit_code: 1,
    refs: [],
    receipt: nil,
    stderr: "remote-ref observation did not run",
  }
  while attempt < max_attempts {
    attempt = attempt + 1
    last = observe()
    if last.success || !release_git_remote_observation_is_transient(last)
      || attempt >= max_attempts {
      return release_git_remote_retry_result(last, attempt)
    }
    const delay_ms = release_git_remote_retry_delay_ms(attempt - 1, base_delay_ms, cap_delay_ms)
    if delay_ms > 0 {
      clock.sleep_ms(delay_ms)
    }
  }
  return release_git_remote_retry_result(last, attempt)
}
