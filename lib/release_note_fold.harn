import {
  ChangelogCategory,
  ChangelogFragment,
  changelog_assemble_fragments,
  changelog_merge_unreleased,
  changelog_parse_fragment,
} from "std/changelog"
import { command_result_fail, command_result_ok } from "std/command"
import { changelog_release_section_update, changelog_release_section_valid } from "./changelog"
import { ReleaseCommandResult, read_repo_file } from "./release_runtime"

pub type CandidateTreeFoldConfig = {repo: string, mock: bool}

pub type CandidateReleaseNoteTextFold = {
  success: bool,
  message: string,
  text: string,
  changed: bool,
}

pub type CandidateTreeReleaseNoteFold = {
  success: bool,
  message: string,
  text: string,
  changed: bool,
  fragments: list<ChangelogFragment>,
  fragment_paths: list<string>,
  fragment_section: string,
  agent_notes: string,
  valid: bool,
  findings: list<string>,
}

const RELEASE_CHANGELOG_CATEGORIES: list<ChangelogCategory> = [
  {slug: "breaking", heading: "Breaking"},
  {slug: "added", heading: "Added"},
  {slug: "changed", heading: "Changed"},
  {slug: "deprecated", heading: "Deprecated"},
  {slug: "removed", heading: "Removed"},
  {slug: "fixed", heading: "Fixed"},
  {slug: "security", heading: "Security"},
]

pub fn assemble_fragment_records(fragments: list<ChangelogFragment>) -> string {
  const assembled = changelog_assemble_fragments(fragments, RELEASE_CHANGELOG_CATEGORIES)
  if is_err(assembled) {
    throw unwrap_err(assembled).message
  }
  return unwrap(assembled)
}

fn assemble_repo_fragments(
  harness: {fs: HarnessFs, process: HarnessProcess},
  cfg: CandidateTreeFoldConfig,
) {
  if cfg.mock {
    return {section: "", paths: [], fragments: []}
  }
  const dir = path_join(cfg.repo, "changelog.d")
  if !harness.fs.exists(dir) {
    return {section: "", paths: [], fragments: []}
  }
  const listing = harness.process.shell_at(cfg.repo, "ls changelog.d/ 2>/dev/null")
  if !listing.success {
    return {section: "", paths: [], fragments: []}
  }
  let fragments: list<ChangelogFragment> = []
  let paths: list<string> = []
  for name in listing.stdout.split("\n") {
    const trimmed = trim(name)
    if trimmed == "" {
      continue
    }
    const full = path_join(dir, trimmed)
    if !harness.fs.exists(full) {
      continue
    }
    const parsed = changelog_parse_fragment(
      trimmed,
      trim(harness.fs.read_text(full)),
      RELEASE_CHANGELOG_CATEGORIES,
    )
    if is_ok(parsed) {
      fragments = fragments.push(unwrap(parsed))
      paths = paths.push(full)
    }
  }
  return {section: assemble_fragment_records(fragments), paths: paths, fragments: fragments}
}

/** Read only the fragment projection needed by preflight note liveness checks. */
pub fn candidate_tree_fragment_section(
  harness: {fs: HarnessFs, process: HarnessProcess},
  cfg: CandidateTreeFoldConfig,
) -> string {
  return assemble_repo_fragments({fs: harness.fs, process: harness.process}, cfg).section
}

fn read_agent_notes(fs: HarnessFs, notes_path: string?) -> string {
  if notes_path == nil || notes_path == "" || !fs.exists(notes_path) {
    return ""
  }
  return trim(fs.read_text(notes_path))
}

pub fn fold_candidate_release_note_text(
  original: string,
  fragments_section: string,
  next_version: string,
  agent_notes: string,
) -> CandidateReleaseNoteTextFold {
  const merged = if trim(fragments_section) == "" {
    {success: true, changed: false, text: original, message: "no changelog.d fragments"}
  } else {
    const result = changelog_merge_unreleased(
      original,
      fragments_section,
      RELEASE_CHANGELOG_CATEGORIES,
    )
    if is_ok(result) {
      const value = unwrap(result)
      {
        success: true,
        changed: value.changed,
        text: value.text,
        message: "merged changelog.d fragments into ## Unreleased",
      }
    } else {
      {success: false, changed: false, text: original, message: unwrap_err(result).message}
    }
  }
  if !merged.success {
    return {success: false, message: merged.message, text: original, changed: false}
  }
  const update = changelog_release_section_update(merged.text, next_version, agent_notes)
  if !update.success {
    return {success: false, message: update.message, text: merged.text, changed: false}
  }
  return {
    success: true,
    message: update.message,
    text: update.text,
    changed: update.changed || merged.changed,
  }
}

pub fn candidate_tree_release_note_fold(
  harness: {fs: HarnessFs, process: HarnessProcess},
  cfg: CandidateTreeFoldConfig,
  next_version: string,
  notes_path: string?,
) -> CandidateTreeReleaseNoteFold {
  const changelog_path = path_join(cfg.repo, "CHANGELOG.md")
  if !cfg.mock && !harness.fs.exists(changelog_path) {
    return {
      success: false,
      message: "missing CHANGELOG.md",
      text: "",
      changed: false,
      fragments: [],
      fragment_paths: [],
      fragment_section: "",
      agent_notes: "",
      valid: false,
      findings: ["missing CHANGELOG.md"],
    }
  }
  const original = read_repo_file(harness.fs, cfg, "CHANGELOG.md")
  const fragments = assemble_repo_fragments({fs: harness.fs, process: harness.process}, cfg)
  const agent_notes = read_agent_notes(harness.fs, notes_path)
  const folded = fold_candidate_release_note_text(
    original,
    fragments.section,
    next_version,
    agent_notes,
  )
  const gate = if folded.success {
    changelog_release_section_valid(folded.text, next_version, fragments.fragments)
  } else {
    {valid: false, findings: [folded.message]}
  }
  return {
    success: folded.success,
    message: folded.message,
    text: folded.text,
    changed: folded.changed,
    fragments: fragments.fragments,
    fragment_paths: fragments.paths,
    fragment_section: fragments.section,
    agent_notes: agent_notes,
    valid: gate.valid,
    findings: gate.findings,
  }
}

fn persist_candidate_tree_release_note_fold(
  fs: HarnessFs,
  cfg: CandidateTreeFoldConfig,
  fold: CandidateTreeReleaseNoteFold,
) -> nil {
  if cfg.mock {
    return
  }
  fs.write_text(path_join(cfg.repo, "CHANGELOG.md"), fold.text)
  for fragment_path in fold.fragment_paths {
    fs.delete(fragment_path)
  }
}

/** Persist one accepted fold and render the canonical command receipt. */
pub fn persist_candidate_tree_release_note_result(
  fs: HarnessFs,
  cfg: CandidateTreeFoldConfig,
  fold: CandidateTreeReleaseNoteFold,
  recovery_note: string = "",
) -> ReleaseCommandResult {
  if !fold.success {
    return command_result_fail(1, fold.message)
  }
  if !fold.valid {
    return command_result_fail(1, fold.findings.join("\n"))
  }
  persist_candidate_tree_release_note_fold(fs, cfg, fold)
  const fragment_note = if len(fold.fragment_paths) == 0 {
    ""
  } else {
    "; folded ${len(fold.fragment_paths)} changelog.d fragment(s)"
  }
  return command_result_ok("ok: " + fold.message + fragment_note + recovery_note + "\n")
}

/** Total deterministic seam used by recovery integration tests and tooling. */
pub fn apply_deterministic_candidate_tree_release_notes(
  harness: {fs: HarnessFs, process: HarnessProcess},
  cfg: CandidateTreeFoldConfig,
  next_version: string,
  notes_path: string?,
) -> ReleaseCommandResult {
  const fold = candidate_tree_release_note_fold(
    {fs: harness.fs, process: harness.process},
    cfg,
    next_version,
    notes_path,
  )
  return persist_candidate_tree_release_note_result(harness.fs, cfg, fold)
}
