/**
 * One source of truth for the self-review facts schema and its canonical
 * `facts.json` artifact binding, shared by the writer and the readers/tests.
 */
pub fn self_review_facts_descriptor() -> ArtifactDescriptor<SelfReviewFactsReceipt> {
  return artifact_descriptor("facts.json", schema_contract(schema_of(SelfReviewFactsReceipt), []))
}

fn artifact_text(fs: HarnessFs, path) {
  if path == "" || !fs.exists(path) {
    return ""
  }
  return fs.read_text(path)
}

fn add_count(counts, key) {
  if key == "" {
    return counts
  }
  let out = counts
  out[key] = (out[key] ?? 0) + 1
  return out
}

pub fn self_review_artifact_basename(path: string) -> string {
  const parts = path.split("/").filter({ part -> part != "" })
  if len(parts) == 0 {
    return path
  }
  return parts[len(parts) - 1]
}

fn count_occurrences(text, needle) {
  if needle == "" {
    return 0
  }
  return len(text.split(needle)) - 1
}

fn find_files(harness: {fs: HarnessFs, process: HarnessProcess}, root, glob_name) {
  if !harness.fs.exists(root) {
    return []
  }
  const result = harness.process.shell(
    "find " + shell_quote(root) + " -type f -name " + shell_quote(glob_name) + " | sort",
  )
  if !result.success {
    return []
  }
  return result.stdout.split("\n").map({ path -> trim(path) }).filter({ path -> path != "" })
}

fn transcript_summary(fs: HarnessFs, path: string) -> SelfReviewTranscriptSummary {
  const events = read_jsonl(fs, path)
  const raw = artifact_text(fs, path)
  const projection_events = transcript_projection_events(events)
  const compaction_events = transcript_compaction_events(events)
  let provider_requests = 0
  let provider_responses = 0
  let tool_schema_count = 0
  let native_tool_counts = []
  let tool_choice_counts = {}
  let response_tool_counts = {}
  let response_tool_sequence = []
  let response_protocol_leaks = 0
  let response_code_fence_mentions = 0
  let final_request = nil
  let final_no_tools_request_seen = false
  for event in events {
    const typ = event?.type ?? ""
    if typ == "tool_schemas" {
      tool_schema_count = len(event?.schemas ?? [])
    } else if typ == "provider_call_request" {
      provider_requests = provider_requests + 1
      const native_count = event?.native_tool_count ?? 0
      const choice = event?.tool_choice ?? "(null)"
      native_tool_counts = native_tool_counts + [native_count]
      tool_choice_counts = add_count(tool_choice_counts, choice)
      final_request = {
        native_tool_count: native_count,
        tool_choice: choice,
        tool_format: event?.tool_format ?? "",
        model: event?.model ?? "",
        provider: event?.provider ?? "",
        message_count: event?.message_count,
      }
      if native_count == 0 && choice == "none" {
        final_no_tools_request_seen = true
      }
    } else if typ == "provider_call_response" {
      provider_responses = provider_responses + 1
      const text = event?.text ?? ""
      if contains(text, "<tool_call>") || contains(text, "<function=")
        || contains(text, "</function>") {
        response_protocol_leaks = response_protocol_leaks + 1
      }
      if contains(text, "```") {
        response_code_fence_mentions = response_code_fence_mentions + 1
      }
      for call in event?.tool_calls ?? [] {
        const name = call?.name ?? ""
        response_tool_counts = add_count(response_tool_counts, name)
        response_tool_sequence = response_tool_sequence + [name]
      }
    }
  }
  let adjacent_repeats = []
  let previous = ""
  for name in response_tool_sequence {
    if name != "" && name == previous {
      adjacent_repeats = adjacent_repeats + [name]
    }
    previous = name
  }
  return {
    path: path,
    exists: fs.exists(path),
    bytes: if fs.exists(path) {
      fs.stat(path).size
    } else {
      0
    },
    event_count: len(events),
    provider_requests: provider_requests,
    provider_responses: provider_responses,
    tool_schema_count: tool_schema_count,
    native_tool_counts: native_tool_counts,
    tool_choice_counts: tool_choice_counts,
    final_request: final_request,
    final_no_tools_request_seen: final_no_tools_request_seen,
    projection_event_count: len(projection_events),
    projection_events: projection_events,
    projection_policies: projection_events.map({ event -> event.policy }),
    compaction_event_count: len(compaction_events),
    compaction_events: compaction_events,
    response_tool_counts: response_tool_counts,
    adjacent_repeated_tool_names: adjacent_repeats,
    response_protocol_leak_count: response_protocol_leaks,
    response_code_fence_count: response_code_fence_mentions,
    required_tool_missing_mentions: count_occurrences(raw, "required tools missing"),
    done_judge_mentions: count_occurrences(raw, "done_judge")
      + count_occurrences(raw, "done-judge"),
    done_prompt_mentions: count_occurrences(raw, "done_prompt")
      + count_occurrences(raw, "done-prompt"),
    think_tag_mentions: count_occurrences(raw, "<think>"),
  }
}

fn agent_result_summary(fs: HarnessFs, path: string) -> SelfReviewAgentResultSummary {
  const raw = artifact_text(fs, path)
  const parsed = read_json(fs, path)
  if parsed == nil {
    return {path: path, exists: fs.exists(path), parseable: false}
  }
  const final_result = parsed?.final_result ?? parsed
  const attempts = parsed?.attempts ?? []
  return {
    path: path,
    exists: true,
    parseable: true,
    status: final_result?.status ?? "",
    attempt_count: len(attempts),
    attempt_statuses: attempts.map(
      { attempt -> {name: attempt?.name ?? "", status: attempt?.status ?? ""} },
    ),
    tool_mode: final_result?.tools?.mode ?? "",
    successful_tools: final_result?.tools?.successful ?? [],
    rejected_tools: final_result?.tools?.rejected ?? [],
    required_tool_missing_mentions: count_occurrences(raw, "required tools missing"),
    max_iterations_mentions: count_occurrences(raw, "max iterations"),
  }
}

fn execution_step_refs(steps: list<CommandStepReceipt>) -> list<SelfReviewExecutionStep> {
  return steps.map(
    { step ->
      return {
        name: step.name,
        success: step.success,
        status: step.status,
        classification: step.classification ?? "",
        command: step.command ?? "",
        recovery_hint: step.recovery_hint ?? "",
      }
    },
  )
    .to_list()
}

pub fn self_review_release_run_summary(
  harness: {fs: HarnessFs, process: HarnessProcess},
  dir: string,
) -> SelfReviewReleaseRunSummary {
  const run = run_artifacts_from_dir("release-harn", dir)
  const audit_path = run_artifact_path(run, "release-audit.json")
  const events_path = run_artifact_path(run, "run-events.jsonl")
  const decoded = run_artifact_read_json_result(harness.fs, run, RELEASE_AUDIT_DESCRIPTOR)
  if is_err(decoded) {
    return {
      ok: false,
      kind: "release-harn",
      run_id: run.run_id,
      dir: run.dir,
      error: unwrap_err(decoded),
    }
  }
  const audit = unwrap(decoded)
  const events = read_jsonl(harness.fs, events_path)
  const primary_transcript = run_artifact_transcript_path(run)
  const transcripts = find_files(
    {fs: harness.fs, process: harness.process},
    dir,
    "llm_transcript.jsonl",
  )
  return {
    ok: true,
    kind: "release-harn",
    run_id: run.run_id,
    dir: run.dir,
    audit_path: if harness.fs.exists(audit_path) {
      audit_path
    } else {
      nil
    },
    events_path: if harness.fs.exists(events_path) {
      events_path
    } else {
      nil
    },
    agent_result: agent_result_summary(harness.fs, run.paths.agent_result),
    transcript_paths: transcripts,
    primary_transcript: if harness.fs.exists(primary_transcript) {
      transcript_summary(harness.fs, primary_transcript)
    } else {
      nil
    },
    recovery_transcripts: transcripts.filter({ path -> path != primary_transcript }).map(
      { path -> transcript_summary(harness.fs, path) },
    ),
    event_count: len(events),
    event_types: events.map({ event -> event?.event_type ?? event?.type ?? "" }),
    mode: audit.config.mode,
    started_iso: audit.started_iso,
    finished_iso: audit.finished_iso,
    current_version: audit.analysis.current_version,
    next_version: audit.analysis.next_version,
    branch: audit.analysis.branch,
    changelog_top: audit.analysis.changelog_top,
    deterministic_findings: audit.analysis.deterministic_findings,
    agent_validation_findings: audit.agent_review_detail.validation_findings,
    execution_steps: execution_step_refs(audit.execution),
    cleanup: audit.cleanup,
  }
}

fn status_counts(outcomes: list<FleetOutcomeReceipt>) {
  let counts = {}
  for outcome in outcomes {
    counts = add_count(counts, outcome.status)
  }
  return counts
}

pub fn self_review_bump_run_summary(fs: HarnessFs, dir: string) -> SelfReviewBumpRunSummary {
  const run = run_artifacts_from_dir("bump-fleet", dir)
  const audit_path = run.paths.audit
  const md_path = run_artifact_path(run, "audit.md")
  const decoded = run_artifact_read_json_result(fs, run, FLEET_AUDIT_DESCRIPTOR)
  if is_err(decoded) {
    return {
      ok: false,
      kind: "bump-fleet",
      run_id: run.run_id,
      dir: run.dir,
      error: unwrap_err(decoded),
    }
  }
  const audit = unwrap(decoded)
  return {
    ok: true,
    kind: "bump-fleet",
    run_id: run.run_id,
    dir: run.dir,
    audit_path: if fs.exists(audit_path) {
      audit_path
    } else {
      nil
    },
    md_path: if fs.exists(md_path) {
      md_path
    } else {
      nil
    },
    started_iso: audit.started_iso,
    finished_iso: audit.finished_iso,
    mode: audit.mode,
    target_version: audit.target_version,
    repos_total: audit.repos_total,
    repos_dispatched: audit.repos_dispatched,
    status_counts: status_counts(audit.outcomes),
    summary_model: audit.summary_model,
    summary_text: audit.summary_text,
    cleanup: audit.cleanup,
    outcome_refs: audit.outcomes.map(
      { outcome ->
        {
          slug: outcome.slug,
          status: outcome.status,
          detail: truncate_text(outcome.detail, 400),
          pr_url: outcome.pr_url,
          run_url: outcome.run_url,
        }
      },
    ),
  }
}

pub fn self_review_validation_ladder_summary(
  harness: {fs: HarnessFs, process: HarnessProcess},
  run_root: string,
) -> SelfReviewValidationLadder {
  const root = path_join(run_root, "validation-ladder")
  if !harness.fs.exists(root) {
    return {exists: false}
  }
  const transcripts = find_files(
    {fs: harness.fs, process: harness.process},
    root,
    "llm_transcript.jsonl",
  )
  return {
    exists: true,
    root: root,
    audit_json_paths: find_files({fs: harness.fs, process: harness.process}, root, "*audit.json"),
    transcript_paths: transcripts,
    transcripts: transcripts.map({ path -> transcript_summary(harness.fs, path) }),
  }
}

pub fn self_review_prior_run_summary(fs: HarnessFs, dir: string) -> SelfReviewPriorRun {
  const run = run_artifacts_from_dir("harness-self-review", dir)
  const transcript_path = run_artifact_transcript_path(run)
  const synthesis_transcript_path = run_artifact_transcript_path(run, "synthesis-llm")
  const agent_context_path = run_artifact_path(run, "agent-transcript-context.json")
  const synthesis_context_path = run_artifact_path(run, "synthesis-transcript-context.json")
  return {
    kind: "harness-self-review",
    run_id: run.run_id,
    dir: run.dir,
    agent_result: agent_result_summary(fs, run.paths.agent_result),
    agent_transcript: if fs.exists(transcript_path) {
      transcript_summary(fs, transcript_path)
    } else {
      nil
    },
    synthesis_transcript: if fs.exists(synthesis_transcript_path) {
      transcript_summary(fs, synthesis_transcript_path)
    } else {
      nil
    },
    agent_transcript_context: if fs.exists(agent_context_path) {
      read_json(fs, agent_context_path)
    } else {
      nil
    },
    synthesis_transcript_context: if fs.exists(synthesis_context_path) {
      read_json(fs, synthesis_context_path)
    } else {
      nil
    },
    report_excerpt: truncate_text(artifact_text(fs, run.paths.review), 1200),
  }
}

fn latest_dirs(fs: HarnessFs, kind: string, run_root: string, limit: int) -> list<string> {
  return run_artifacts_list(fs, kind, {root: run_root, limit: limit}).map({ run -> run.dir })
    .to_list()
}

fn maybe_run_dir(fs: HarnessFs, kind: string, run_root: string, run_id: string) -> list<string> {
  const run = run_artifacts_from_dir(kind, path_join(run_root, kind, run_id))
  if fs.exists(run.dir) {
    return [run.dir]
  }
  return []
}

fn unique_paths(paths: list<string>) -> list<string> {
  let seen = {}
  let out = []
  for path in paths {
    if path == "" || (seen[path] ?? false) {
      continue
    }
    seen[path] = true
    out = out + [path]
  }
  return out
}

pub fn self_review_selected_run_dirs(
  fs: HarnessFs,
  kind: string,
  run_root: string,
  important_run_ids: list<string>,
  recent: int,
) -> list<string> {
  let out = []
  for run_id in important_run_ids {
    out = out + maybe_run_dir(fs, kind, run_root, run_id)
  }
  out = out + latest_dirs(fs, kind, run_root, recent)
  return unique_paths(out)
}
