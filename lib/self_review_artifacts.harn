  dir: string,
  agent_result: SelfReviewAgentResultSummary,
  agent_transcript: SelfReviewTranscriptSummary?,
  synthesis_transcript: SelfReviewTranscriptSummary?,
  agent_transcript_context: unknown?,
  synthesis_transcript_context: unknown?,
  report_excerpt: string,
}

