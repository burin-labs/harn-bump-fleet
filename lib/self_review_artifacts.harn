  dir: string,
  error: TypedReadFailure,
}

pub type SelfReviewReleaseRunSummary = SelfReviewReleaseRun | SelfReviewInvalidRun

pub type SelfReviewBumpRunSummary = SelfReviewBumpRun | SelfReviewInvalidRun

