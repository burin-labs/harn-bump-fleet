pub type SelfReviewTranscriptSummary = {
  path: string,
  exists: bool,
  bytes: int,
  event_count: int,
  provider_requests: int,
  provider_responses: int,
  tool_schema_count: int,
  native_tool_counts: list<int>,
  tool_choice_counts: dict,
  final_request: dict?,
  final_no_tools_request_seen: bool,
  projection_event_count: int,
  projection_events: list<dict>,
  projection_policies: list<string>,
  compaction_event_count: int,
  compaction_events: list<dict>,
  response_tool_counts: dict,
  adjacent_repeated_tool_names: list<string>,
  response_protocol_leak_count: int,
  response_code_fence_count: int,
  required_tool_missing_mentions: int,
  done_judge_mentions: int,
  done_prompt_mentions: int,
  think_tag_mentions: int,
}

