// Decide whether a failed observation is worth waiting on.
//
// A convergence round polls. Polling is the right answer for a condition that
// a later attempt can find satisfied: a check still running, a branch head that
// moved, a rate limit that expires. It is the wrong answer for a condition that
// is identical on every attempt, and treating the second kind as the first is
// expensive in a way that hides itself.
//
// Measured, on one target, in one day: eight chains and twenty-six rounds, none
// of which proved, because a census refused with a permission error and the
// refusal was rendered as "pending". Each round then polled its full window for
// an answer that could not change, and the worst single round spent fifty
// minutes doing it. The answer was available in under a second, in the first
// response, and it named a specific action a person could take.
//
// So the class is decided from the connector's own structured error record,
// never from its message text. Message text is written for people, changes
// without notice, and a substring match on it is a guess wearing a predicate's
// clothes.
/** What a caller should do about one failed observation. */
pub type FleetObservationDisposition = "retry" | "refuse"

/**
 * One classified observation failure: whether to keep waiting, and when not,
 * the action that ends it.
 */
pub type FleetObservationClass = {
  disposition: FleetObservationDisposition,
  code: string,
  category: string,
  action: string,
}

/**
 * Categories and codes that a later attempt can find satisfied.
 *
 * These are the transport and pacing failures. Everything here is expected to
 * resolve on its own, so a round that meets one should keep its window.
 */
const RETRYABLE_CODES: list<string> = [
  "network",
  "rate_limited",
  "timeout",
  "transient_network",
  "server_error",
]

const RETRYABLE_CATEGORIES: list<string> = ["network", "rate_limit", "transient", "lease"]

/**
 * Codes that are identical on every attempt until a person changes something.
 *
 * Each maps to the action that ends it. The action is the point: the receipt
 * that names a refusal without naming its remedy still leaves someone to work
 * out what to do, and that gap is what turned a three-minute fix into a
 * four-and-a-half-hour wait.
 */
const REFUSAL_ACTIONS: dict<string, string> = {
  missing_scopes:
    "grant the acting credential's installation the permission this read needs, then re-dispatch",
  forbidden: "grant the acting credential access to this repository, then re-dispatch",
  unauthorized: "the acting credential is not accepted at all; renew it, then re-dispatch",
  not_found:
    "the repository, branch, or object this read names does not exist; correct the manifest entry",
  schema_drift: "the response no longer matches the contract this read asserts; update the reader",
}

fn text(value: any) -> string {
  return lowercase(trim(to_string(value ?? "")))
}

/**
 * Classify one connector error record.
 *
 * The default is `refuse`, deliberately. An unrecognized failure that repeats
 * every attempt costs a full polling window per round and produces nothing; an
 * unrecognized failure that would have cleared costs one re-dispatch. Refusing
 * by default also makes every new failure shape visible the first time it
 * happens, instead of hiding inside a wait that looks like ordinary patience.
 */
pub fn fleet_observation_class(error: any) -> FleetObservationClass {
  const code = text(error?.code)
  const category = text(error?.category)
  if RETRYABLE_CODES.contains(code) || RETRYABLE_CATEGORIES.contains(category) {
    return {disposition: "retry", code: code, category: category, action: ""}
  }
  const named = REFUSAL_ACTIONS[code] ?? REFUSAL_ACTIONS[category] ?? ""
  const action = if named != "" {
    named
  } else if category == "permission" {
    REFUSAL_ACTIONS["missing_scopes"] ?? ""
  } else {
    "read this failure and decide; no round of this chain can clear it on its own"
  }
  return {disposition: "refuse", code: code, category: category, action: action}
}

/**
 * Classify a whole set of failed observations.
 *
 * One refusal is enough to end the wait. A round whose remaining failures are
 * all retryable keeps its window, because those can still resolve.
 */
pub fn fleet_observation_set_class(errors: list) -> FleetObservationClass {
  let first_retry: FleetObservationClass? = nil
  for error in errors {
    const classified = fleet_observation_class(error)
    if classified.disposition == "refuse" {
      return classified
    }
    if first_retry == nil {
      first_retry = classified
    }
  }
  return first_retry ?? {disposition: "retry", code: "", category: "", action: ""}
}
