import { ReleaseChainPlannedEffect, release_chain_planned_effect } from "./release_chain_effect"
import { ReleaseChainCause, ReleaseChainStage } from "./release_chain_state"

pub type ReleaseChainRepairAction = "plan_effect" | "wait" | "escalate"

pub type ReleaseChainRepairDecision = {
  action: ReleaseChainRepairAction,
  cause: ReleaseChainCause,
  reason: string,
  effect?: ReleaseChainPlannedEffect,
}

fn escalation(cause: ReleaseChainCause, reason: string) -> ReleaseChainRepairDecision {
  return {action: "escalate", cause: cause, reason: reason}
}

/** Closed, bounded cause-to-action policy. No diagnostic prose is parsed. */
pub fn release_chain_repair_decision(
  chain_id: string,
  revision: int,
  stage: ReleaseChainStage,
  cause: ReleaseChainCause,
  subject: string,
  attempt: int,
  target: string,
) -> ReleaseChainRepairDecision {
  if cause == "development_version_missing" {
    return {
      action: "plan_effect",
      cause: cause,
      reason: "canonical development cutover may be dispatched once",
      effect: release_chain_planned_effect(
        chain_id,
        revision,
        stage,
        cause,
        subject,
        attempt,
        1,
        "dispatch_development_cutover",
        target,
      ),
    }
  }
  if cause == "unfolded_fragments" {
    return {
      action: "plan_effect",
      cause: cause,
      reason: "one identity-leased fragment fold pull request may be opened",
      effect: release_chain_planned_effect(
        chain_id,
        revision,
        stage,
        cause,
        subject,
        attempt,
        1,
        "open_fragment_fold_pr",
        target,
      ),
    }
  }
  if cause == "assets_missing" {
    return {
      action: "plan_effect",
      cause: cause,
      reason: "exact binary asset recovery is bounded by its existing retry budget",
      effect: release_chain_planned_effect(
        chain_id,
        revision,
        stage,
        cause,
        subject,
        attempt,
        3,
        "recover_binary_assets",
        target,
      ),
    }
  }
  if cause == "anchor_stale" {
    return {
      action: "plan_effect",
      cause: cause,
      reason: "the existing anchor projection owner may be invoked once",
      effect: release_chain_planned_effect(
        chain_id,
        revision,
        stage,
        cause,
        subject,
        attempt,
        1,
        "promote_anchor",
        target,
      ),
    }
  }
  if cause == "consumer_pin_stale" || cause == "consumer_update_failed" {
    return {
      action: "plan_effect",
      cause: cause,
      reason: "the existing consumer bump adapter may be invoked once per repository",
      effect: release_chain_planned_effect(
        chain_id,
        revision,
        stage,
        cause,
        subject,
        attempt,
        1,
        "dispatch_consumer_repin",
        target,
      ),
    }
  }
  if cause == "convergence_proof_missing" {
    return {
      action: "plan_effect",
      cause: cause,
      reason: "one proof dispatch may recover a missed pin-change trigger",
      effect: release_chain_planned_effect(
        chain_id,
        revision,
        stage,
        cause,
        subject,
        attempt,
        1,
        "dispatch_convergence_proof",
        target,
      ),
    }
  }
  if cause == "publication_dispatch_missing" || cause == "release_pr_missing" {
    return {
      action: "wait",
      cause: cause,
      reason: "phase one observes the current owner; it does not create a parallel dispatch path",
    }
  }
  return escalation(cause, "no automatic repair is authorized for this typed cause")
}
