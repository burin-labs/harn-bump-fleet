import { github_connector_options, github_repository_rulesets } from "./github"
import {
  github_branch_commits,
  github_commit_check_runs,
  github_commit_pull_requests,
} from "./github_commits"
import {
  ReleaseCertifiedPinResolution,
  release_certified_pin_candidate,
  release_certified_pin_resolution,
} from "./release_certified_pin"
import { release_required_contexts_from_rulesets } from "./release_drift_evidence"
import { GithubClientOptions } from "harn-github-connector/default"

const DEFAULT_COMMIT_PAGE = 20

fn owning_pull_head(pulls: list, branch: string, merge_sha: string) -> Result<string?, string> {
  const owning = pulls.filter(
    { pull ->
      lowercase(trim(to_string(pull?.base?.ref ?? ""))) == lowercase(trim(branch))
        && lowercase(trim(to_string(pull?.merge_commit_sha ?? ""))) == merge_sha
    },
  )
    .to_list()
  if len(owning) == 0 {
    return Ok(nil)
  }
  if len(owning) > 1 {
    return Err("multiple pull requests claim the same default-branch merge commit")
  }
  const head = lowercase(trim(to_string(owning[0]?.head?.sha ?? "")))
  if head == "" {
    return Err("the owning pull request did not report its head commit")
  }
  return Ok(head)
}

fn unreadable(
  reason: string,
  refusal: "required_contexts_not_observed" | "no_commits_scanned",
) -> ReleaseCertifiedPinResolution {
  return {
    resolved: false,
    sha: "",
    scanned: 0,
    required_contexts: [],
    rejected: [],
    refusal: refusal,
    reason: reason,
  }
}

/** Resolve the newest commit on one branch that passed every enforced context. */
pub fn release_certified_pin_from_github(
  harness: Harness,
  repo: string,
  branch: string,
  page_size: int = DEFAULT_COMMIT_PAGE,
  options: GithubClientOptions = github_connector_options(),
) -> ReleaseCertifiedPinResolution {
  const rulesets = github_repository_rulesets(harness, repo, options)
  if is_err(rulesets) {
    return unreadable(
      "required context policy could not be read: " + to_string(unwrap_err(rulesets)),
      "required_contexts_not_observed",
    )
  }
  const required = release_required_contexts_from_rulesets(unwrap(rulesets))
  if len(required) == 0 {
    return release_certified_pin_resolution(required, [])
  }
  const commits = github_branch_commits(harness, repo, branch, page_size, options)
  if is_err(commits) {
    return unreadable(
      "default branch commit page could not be read: " + to_string(unwrap_err(commits)),
      "no_commits_scanned",
    )
  }
  let candidates = []
  for commit in unwrap(commits) {
    const sha = lowercase(trim(to_string(commit?.sha ?? "")))
    if sha == "" {
      continue
    }
    const pulls = github_commit_pull_requests(harness, repo, sha, options)
    // Required contexts govern admission of the pull-request head. A squash
    // commit on the default branch normally reruns CI, but it cannot recreate
    // PR-only contexts such as `drift`. Direct pushes have no owning pull and
    // are judged on their own rollup instead.
    const pull_head = if is_err(pulls) {
      Err("associated pull requests could not be read: " + to_string(unwrap_err(pulls)))
    } else {
      owning_pull_head(unwrap(pulls), branch, sha)
    }
    const checks = if is_err(pull_head) {
      Err(unwrap_err(pull_head))
    } else {
      github_commit_check_runs(harness, repo, unwrap(pull_head) ?? sha, options)
    }
    candidates = candidates
      + [
        release_certified_pin_candidate(
          sha,
          required,
          if is_err(checks) {
            nil
          } else {
            unwrap(checks)
          },
        ),
      ]
  }
  return release_certified_pin_resolution(required, candidates)
}
