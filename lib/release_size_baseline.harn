// Refresh harn's release binary-size baseline from the release that just
// shipped.
//
// The baseline in `.github/release-binary-size-policy.json` records the bytes a
// release was accepted at. Nothing refreshed it automatically, so it sat at
// 0.10.118 while seven releases shipped past it, and the v0.10.126 cut spent
// two full Linux builds being refused by the accumulated difference. The
// refresh is not a judgement call — the numbers come from the release's own
// build — so it belongs in the tail rather than in a person's memory.
//
// Everything here is a pure value transform. The harness that owns the network
// fetches the report and publishes the pull request; this decides what the file
// should say.
import { ReleaseBuildIdentity } from "./release_size_report"

/**
 * The headroom band harn's own policy contract requires between the accepted
 * baseline and the distribution fuse.
 *
 * harn owns these numbers (`MIN_FUSE_HEADROOM_PERCENT` /
 * `MAX_FUSE_HEADROOM_PERCENT` in `scripts/release_binary_size_policy.harn`) and
 * this repository cannot import them. They are restated rather than derived, so
 * the enforcing authority is the pull request's own CI in harn: a band that has
 * drifted fails that run visibly instead of writing a file nobody validates.
 */
pub const FUSE_MIN_HEADROOM_PERCENT: int = 10

pub const FUSE_MAX_HEADROOM_PERCENT: int = 15

/**
 * Where a recomputed fuse lands: the middle of the band, so an ordinary
 * release's growth does not walk the ceiling back out of contract next time.
 */
pub const FUSE_TARGET_HEADROOM_PERCENT_HUNDREDTHS: int = 1250

pub type BinarySizeBaseline = {
  version: string,
  source_sha: string,
  bytes: int,
  observed_at: string,
  build_identity: ReleaseBuildIdentity,
}

pub type BinarySizeGrowthPolicy = {warn_bytes: int, warn_percent_hundredths: int}

pub type BinarySizeAcceptedGrowth = {against_baseline_sha: string, bytes: int, reason: string}

pub type BinarySizeTargetPolicy = {
  target: string,
  distribution_fuse_bytes: int,
  growth: BinarySizeGrowthPolicy,
  baseline: BinarySizeBaseline,
  accepted_growth: list<BinarySizeAcceptedGrowth>,
}

pub type BinarySizePolicy = {
  schema_version: int,
  default_target: string,
  targets: list<BinarySizeTargetPolicy>,
}

/** What one refresh changed, so the pull request can say it without recomputing. */
pub type BaselineRefreshSummary = {
  target: string,
  version: string,
  source_sha: string,
  previous_version: string,
  previous_bytes: int,
  bytes: int,
  delta_bytes: int,
  previous_fuse_bytes: int,
  fuse_bytes: int,
  fuse_moved: bool,
  accepted_growth_dropped: int,
  headroom_percent_hundredths: int,
}

pub type BaselineRefresh = {text: string, summary: BaselineRefreshSummary, changed: bool}

fn headroom_percent_hundredths(baseline_bytes: int, fuse_bytes: int) -> int {
  if baseline_bytes <= 0 {
    return 0
  }
  return (fuse_bytes - baseline_bytes) * 10000 / baseline_bytes
}

/**
 * The fuse for a refreshed baseline.
 *
 * A fuse that still sits inside the required band is left exactly where it is:
 * it was chosen deliberately, and moving a ceiling nobody asked to move is not
 * this step's decision to make. One that would fall outside the band is
 * recomputed to the middle of it, because a refreshed baseline that leaves the
 * file failing its own contract is worse than a moved ceiling.
 */
pub fn refreshed_fuse_bytes(current_fuse_bytes: int, baseline_bytes: int) -> int {
  const headroom = headroom_percent_hundredths(baseline_bytes, current_fuse_bytes)
  if headroom >= FUSE_MIN_HEADROOM_PERCENT * 100 && headroom <= FUSE_MAX_HEADROOM_PERCENT * 100 {
    return current_fuse_bytes
  }
  return baseline_bytes + baseline_bytes * FUSE_TARGET_HEADROOM_PERCENT_HUNDREDTHS / 10000
}

/**
 * The policy file is read by people diffing a release. It is rendered
 * explicitly, two-space indented, rather than round-tripped through a generic
 * serializer, so a refresh produces a one-hunk diff instead of reformatting the
 * whole document.
 */
fn json_string(value: string) -> string {
  let escaped = ""
  for character in value.chars() {
    if character == "\\" {
      escaped = escaped + "\\\\"
    } else if character == "\"" {
      escaped = escaped + "\\\""
    } else if character == "\n" {
      escaped = escaped + "\\n"
    } else if character == "\t" {
      escaped = escaped + "\\t"
    } else if character == "\r" {
      escaped = escaped + "\\r"
    } else {
      escaped = escaped + character
    }
  }
  return "\"" + escaped + "\""
}

fn render_build_identity(identity: ReleaseBuildIdentity, indent: string) -> list<string> {
  return [
    "${indent}\"build_identity\": {",
    "${indent}  \"profile\": ${json_string(identity.profile)},",
    "${indent}  \"codegen_units\": ${identity.codegen_units},",
    "${indent}  \"lto\": ${json_string(identity.lto)},",
    "${indent}  \"strip\": ${json_string(identity.strip)},",
    "${indent}  \"rustc\": ${json_string(identity.rustc)},",
    "${indent}  \"aot_embedded\": ${if identity.aot_embedded { "true" } else { "false" }}",
    "${indent}}",
  ]
}

fn render_accepted_growth(entries: list<BinarySizeAcceptedGrowth>, indent: string) -> list<string> {
  if entries.count == 0 {
    return ["${indent}\"accepted_growth\": []"]
  }
  let lines = ["${indent}\"accepted_growth\": ["]
  let index = 0
  for entry in entries {
    const comma = if index == entries.count - 1 {
      ""
    } else {
      ","
    }
    lines = lines
      + [
        "${indent}  {",
        "${indent}    \"against_baseline_sha\": ${json_string(entry.against_baseline_sha)},",
        "${indent}    \"bytes\": ${entry.bytes},",
        "${indent}    \"reason\": ${json_string(entry.reason)}",
        "${indent}  }${comma}",
      ]
    index = index + 1
  }
  return lines + ["${indent}]"]
}

fn render_target(entry: BinarySizeTargetPolicy, comma: string) -> list<string> {
  return [
    "    {",
    "      \"target\": ${json_string(entry.target)},",
    "      \"distribution_fuse_bytes\": ${entry.distribution_fuse_bytes},",
    "      \"growth\": {",
    "        \"warn_bytes\": ${entry.growth.warn_bytes},",
    "        \"warn_percent_hundredths\": ${entry.growth.warn_percent_hundredths}",
    "      },",
    "      \"baseline\": {",
    "        \"version\": ${json_string(entry.baseline.version)},",
    "        \"source_sha\": ${json_string(entry.baseline.source_sha)},",
    "        \"bytes\": ${entry.baseline.bytes},",
    "        \"observed_at\": ${json_string(entry.baseline.observed_at)},",
  ]
    + render_build_identity(entry.baseline.build_identity, "        ")
    + ["      },"]
    + render_accepted_growth(entry.accepted_growth, "      ")
    + ["    }${comma}"]
}

/** Render a whole policy document. Trailing newline included, as the file has one. */
pub fn render_binary_size_policy(policy: BinarySizePolicy) -> string {
  let lines = [
    "{",
    "  \"schema_version\": ${policy.schema_version},",
    "  \"default_target\": ${json_string(policy.default_target)},",
    "  \"targets\": [",
  ]
  let index = 0
  for entry in policy.targets {
    const comma = if index == policy.targets.count - 1 {
      ""
    } else {
      ","
    }
    lines = lines + render_target(entry, comma)
    index = index + 1
  }
  return (lines + ["  ]", "}"]).join("\n") + "\n"
}

/** The measurement one refresh writes into the baseline. */
pub type BaselineRefreshInput = {
  version: string,
  source_sha: string,
  bytes: int,
  observed_at: string,
  target: string,
  build_identity: ReleaseBuildIdentity,
}

/**
 * Rewrite one target's baseline from a shipped release, and drop every
 * acceptance written against the baseline being replaced.
 *
 * The acceptances go unconditionally rather than by matching
 * `against_baseline_sha`. An acceptance exists to excuse growth relative to a
 * baseline; once that baseline moves, the growth it excused is in the new
 * baseline's bytes. Keeping one would double-count it, and harn's own
 * validation rejects an acceptance whose `against_baseline_sha` is not the
 * current baseline anyway.
 */
pub fn refresh_binary_size_baseline(
  policy: BinarySizePolicy,
  input: BaselineRefreshInput,
) -> Result<BaselineRefresh, string> {
  let matched = false
  let summary: BaselineRefreshSummary? = nil
  let targets: list<BinarySizeTargetPolicy> = []
  for entry in policy.targets {
    if entry.target != input.target {
      targets = targets + [entry]
      continue
    }
    matched = true
    const fuse_bytes = refreshed_fuse_bytes(entry.distribution_fuse_bytes, input.bytes)
    const refreshed: BinarySizeTargetPolicy = {
      target: entry.target,
      distribution_fuse_bytes: fuse_bytes,
      growth: entry.growth,
      baseline: {
        version: input.version,
        source_sha: input.source_sha,
        bytes: input.bytes,
        observed_at: input.observed_at,
        build_identity: input.build_identity,
      },
      accepted_growth: [],
    }
    summary = {
      target: entry.target,
      version: input.version,
      source_sha: input.source_sha,
      previous_version: entry.baseline.version,
      previous_bytes: entry.baseline.bytes,
      bytes: input.bytes,
      delta_bytes: input.bytes - entry.baseline.bytes,
      previous_fuse_bytes: entry.distribution_fuse_bytes,
      fuse_bytes: fuse_bytes,
      fuse_moved: fuse_bytes != entry.distribution_fuse_bytes,
      accepted_growth_dropped: entry.accepted_growth.count,
      headroom_percent_hundredths: headroom_percent_hundredths(input.bytes, fuse_bytes),
    }
    targets = targets + [refreshed]
  }
  if !matched || summary == nil {
    return Err("policy has no entry for target ${input.target}")
  }
  const refreshed_policy: BinarySizePolicy = policy + {targets: targets}
  const text = render_binary_size_policy(refreshed_policy)
  return Ok(
    {
      text: text,
      summary: summary,
      changed: summary.bytes != summary.previous_bytes
        || summary.fuse_moved
        || summary.accepted_growth_dropped > 0
        || summary.version != summary.previous_version,
    },
  )
}

/** The pull-request body, so the refresh explains itself where it lands. */
pub fn baseline_refresh_pull_request_body(
  summary: BaselineRefreshSummary,
  run_url: string,
) -> string {
  let lines = [
    "Refresh the release binary-size baseline from the shipped `${summary.version}` build.",
    "",
    "| Field | Before | After |",
    "| --- | --- | --- |",
    "| Baseline version | `${summary.previous_version}` | `${summary.version}` |",
    "| Baseline bytes | ${summary.previous_bytes} | ${summary.bytes} |",
    "| Distribution fuse | ${summary.previous_fuse_bytes} | ${summary.fuse_bytes} |",
    "",
    "Measured source: `${summary.source_sha}` on `${summary.target}`.",
    "Change against the previous baseline: ${summary.delta_bytes} bytes.",
    "Headroom under the fuse: ${summary.headroom_percent_hundredths / 100}%.",
  ]
  if summary.accepted_growth_dropped > 0 {
    lines = lines
      + [
        "",
        "Dropped ${summary.accepted_growth_dropped} `accepted_growth` entr${if summary.accepted_growth_dropped == 1 { "y" } else { "ies" }}. An acceptance excuses growth relative to the baseline it was written against; that growth now sits inside the baseline itself.",
      ]
  }
  if summary.fuse_moved {
    lines = lines
      + [
        "",
        "The distribution fuse moved because the refreshed baseline would have left it outside the ${FUSE_MIN_HEADROOM_PERCENT}–${FUSE_MAX_HEADROOM_PERCENT}% headroom band the policy contract requires. It is recomputed to the middle of that band.",
      ]
  }
  if run_url != "" {
    lines = lines + ["", "Measured by ${run_url}."]
  }
  lines = lines
    + [
      "",
      "Opened automatically by the release tail in `harn-bump-fleet`. The numbers come from the release's own build; nothing here is estimated.",
    ]
  return lines.join("\n") + "\n"
}
