import { map_settled } from "std/settled"
import { FleetRepo, FleetRunContext } from "./bump_fleet_pre_dispatch"
import { FleetOutcomeReceipt } from "./run_receipts"
import { RunSessionViewFleetGate } from "./run_session_view_gate"

const RETRYABLE_STATUSES = ["dispatch_failed", "run_failure", "preflight_error", "run_in_progress"]

pub type FleetExecutionResult = {outcomes: list<FleetOutcomeReceipt>}

pub type FleetExecutionAdapter = {
  dry_run: bool,
  run_repo: fn(FleetRepo, string, bool, RunSessionViewFleetGate, dict, bool) -> FleetOutcomeReceipt,
  error_outcome: fn(FleetRepo, string) -> FleetOutcomeReceipt,
  timed_dispatch: fn(dict, fn() -> list<FleetOutcomeReceipt>) -> list<FleetOutcomeReceipt>,
  timed_retries: fn(dict, fn() -> list<FleetOutcomeReceipt>) -> list<FleetOutcomeReceipt>,
}

fn run_repos(
  context: FleetRunContext,
  repos: list<FleetRepo>,
  max_concurrent: int,
  is_retry: bool,
  adapter: FleetExecutionAdapter,
) -> list<FleetOutcomeReceipt> {
  const settled = parallel settle repos with { max_concurrent: max_concurrent } { repo ->
    adapter.run_repo(
      repo,
      context.target,
      adapter.dry_run,
      context.view_gate,
      context.public_surface_impact,
      is_retry,
    )
  }
  return map_settled(
    settled.results,
    { value, _index -> value },
    { message, index -> adapter.error_outcome(repos[index], message) },
  )
}

fn retry_outcomes(
  stdio: HarnessStdio,
  context: FleetRunContext,
  initial: list<FleetOutcomeReceipt>,
  max_concurrent: int,
  max_retries: int,
  adapter: FleetExecutionAdapter,
) -> list<FleetOutcomeReceipt> {
  let outcomes = initial
  if max_retries <= 0 || adapter.dry_run {
    return outcomes
  }
  const repos_by_slug = {}
  let repo_index = repos_by_slug
  for repo in context.repos {
    repo_index = repo_index + {[repo.slug]: repo}
  }
  let attempt = 1
  while attempt <= max_retries {
    const retry_slugs = outcomes.filter({ outcome -> contains(RETRYABLE_STATUSES, outcome.status) })
      .map({ outcome -> outcome.slug })
    if len(retry_slugs) == 0 {
      break
    }
    stdio.println(
      "\n== retry pass ${attempt}/${max_retries} (re-dispatching ${len(retry_slugs)} repo(s) in retryable state) ...",
    )
    const retry_repos = retry_slugs.map({ slug -> repo_index[slug] })
    const retried = run_repos(context, retry_repos, max_concurrent, true, adapter)
    const retried_by_slug = {}
    let retry_index = retried_by_slug
    for outcome in retried {
      retry_index = retry_index + {[outcome.slug]: outcome}
      stdio.println("   ${outcome.slug}: ${outcome.status}")
    }
    outcomes = outcomes.map({ outcome -> retry_index[outcome.slug] ?? outcome })
    attempt = attempt + 1
  }
  return outcomes
}

/** Own bounded dispatch and ordered retry passes for one prepared fleet run. */
pub fn fleet_execution_phase(
  stdio: HarnessStdio,
  context: FleetRunContext,
  max_concurrent: int,
  max_retries: int,
  adapter: FleetExecutionAdapter,
) -> FleetExecutionResult {
  stdio.println("\n== dispatching (max_concurrent=${max_concurrent}) ...")
  let outcomes = adapter.timed_dispatch(
    {repo_count: len(context.repos), max_concurrent: max_concurrent},
    { -> return run_repos(context, context.repos, max_concurrent, false, adapter) },
  )
  for outcome in outcomes {
    stdio.println("   ${outcome.slug}: ${outcome.status}")
  }
  outcomes = adapter.timed_retries(
    {max_retries: max_retries, dry_run: adapter.dry_run},
    { -> return retry_outcomes(stdio, context, outcomes, max_concurrent, max_retries, adapter) },
  )
  return {outcomes: outcomes}
}
