import { read_json_result, write_json } from "std/fs"
import {
  schema_bool,
  schema_closed_object,
  schema_enum,
  schema_int,
  schema_list,
  schema_literal,
  schema_nullable,
  schema_string,
  schema_union,
  schema_validator,
} from "std/schema"
import { is_v_release_semver } from "std/semver"
import { ReleaseLandingReceipt, ReleaseMergeMethod } from "./release_merge_lease"
import { ReleasePublication, release_publication } from "./release_publication"

pub type ReleaseDispatchStatus = "not_requested" | "succeeded" | "failed"

pub type ReleaseWatchState = "pending" | "recovering" | "healthy" | "failed"

pub type ReleaseWatchWarmCacheState = "not_requested" \
  | "dispatch_accepted" \
  | "running" \
  | "suppressed" \
  | "completed" \
  | "failed"

pub type ReleaseWatchRecovery = {
  dispatched: bool,
  dispatched_at: string,
  dispatch_status: ReleaseDispatchStatus,
  workflow_run_id: int,
  workflow_run_url: string,
  workflow_path: string,
  source_ref: string,
  source_sha: string,
  event: string,
  head_branch: string,
}

pub type ReleaseWatchWarmCache = {
  state: ReleaseWatchWarmCacheState,
  source_sha: string,
  workflow_run_id: int,
  workflow_run_url: string,
  attempt_count: int,
  dispatched_at: string,
  started_at: string,
  finished_at: string,
  updated_at: string,
  message: string,
}

/**
 * What the release shipped on top of the tree it certified.
 *
 * The contract is not tree identity. Main merges every twenty-one minutes at
 * the median, so a two-hour certification almost never sees a still branch, and
 * demanding identity would mean demanding a freeze. The shipped tree is the
 * certified tree plus commits that passed main's own required checks, and this
 * record is where that claim is checkable afterwards rather than asserted: the
 * exact commits, the exact contexts, and where each conclusion was read.
 *
 * `state` keeps the three cases apart. `not_observed` is a release that has not
 * reached its merge decision, `no_drift` is one that merged at the base it
 * certified, and `recorded` carries the evidence. An empty record must never be
 * readable as a clean release.
 */
pub type ReleaseCertificationDriftState = "not_observed" | "no_drift" | "recorded"

pub type ReleaseCertificationDriftCheck = {
  name: string,
  state: string,
  source: string,
  /** A lane only a release runs, recorded so the tag gate can see it was proved. */
  release_only: bool,
}

pub type ReleaseCertificationDriftCommit = {
  sha: string,
  pull_number: int,
  checks: list<ReleaseCertificationDriftCheck>,
  green: bool,
  blocking_check: string,
}

pub type ReleaseCertificationDrift = {
  state: ReleaseCertificationDriftState,
  certified_base: string,
  observed_main: string,
  required_contexts: list<string>,
  commits: list<ReleaseCertificationDriftCommit>,
  drifted_paths: list<string>,
  release_only_checks: list<string>,
  observed_at: string,
}

/**
 * Where the lanes only a release runs stand on the merged main commit.
 *
 * Required and typed rather than prose, because this is the field a reader
 * checks months later to answer "was the tree this tag names ever proved?".
 * `not_observed` is the default and never reads as a pass.
 */
pub type ReleaseMainDeltaCheckRecord = {name: string, state: string, run_url: string}

pub type ReleaseMainDeltaRecord = {
  state: string,
  commit: string,
  lanes: list<string>,
  checks: list<ReleaseMainDeltaCheckRecord>,
  failing_check: string,
  observed_at: string,
}

pub type ReleaseWatchReceipt = {
  schema_version: "release_harn.publish_watch.v10",
  initial_merge_request: "not_authorized" | "authorized" | "attempted" | "observed",
  tag: string,
  slug: string,
  pin_sha: string,
  publication: ReleasePublication,
  release_commit_oid: string,
  pr_url: string,
  merge_lease_candidate_pr: int,
  merge_lease_generation: string,
  merge_lease_method: ReleaseMergeMethod | "",
  landing: ReleaseLandingReceipt?,
  required_workflows: list<string>,
  observed_run_ids: list<int>,
  state: ReleaseWatchState,
  message: string,
  recovery: ReleaseWatchRecovery,
  warm_cache: ReleaseWatchWarmCache,
  certification_drift: ReleaseCertificationDrift,
  main_delta: ReleaseMainDeltaRecord,
  created_at: string,
  updated_at: string,
}

pub type ReleaseWatchReceiptInputs = {
  authorize_initial_merge?: bool,
  tag: string,
  slug: string,
  pin_sha: string,
  publication?: {version: string, local_branch: string, remote_ref: string, head_oid: string},
  pr_url: string,
  merge_lease_generation?: string,
  merge_lease_method?: ReleaseMergeMethod,
  required_workflows?: list<string>,
  created_at: string,
}

fn release_watch_recovery_schema() {
  const legacy = schema_closed_object(
    {
      dispatched: schema_bool(),
      dispatched_at: schema_string(),
      dispatch_status: schema_enum(["not_requested", "succeeded", "failed"]),
    },
  )
  const identity = {
    workflow_run_id: schema_int() + {minimum: 1},
    workflow_run_url: schema_string()
      + {pattern: "^https://github[.]com/[^/]+/[^/]+/actions/runs/[0-9]+$"},
    workflow_path: schema_literal(".github/workflows/build-release-binaries.yml"),
    source_ref: schema_literal("main"),
    source_sha: schema_string() + {pattern: "^[0-9a-f]{40}$"},
    event: schema_literal("workflow_dispatch"),
    head_branch: schema_literal("main"),
  }
  const absent = {
    workflow_run_id: schema_literal(0),
    workflow_run_url: schema_literal(""),
    workflow_path: schema_literal(""),
    source_ref: schema_literal(""),
    source_sha: schema_literal(""),
    event: schema_literal(""),
    head_branch: schema_literal(""),
  }
  return schema_union(
    [
      legacy,
      schema_closed_object(
        {
          dispatched: schema_bool(),
          dispatched_at: schema_string(),
          dispatch_status: schema_enum(["not_requested", "succeeded", "failed"]),
        }
          + absent,
      ),
      schema_closed_object(
        {
          dispatched: schema_literal(true),
          dispatched_at: schema_string(),
          dispatch_status: schema_literal("succeeded"),
        }
          + identity,
      ),
    ],
  )
}

fn warm_cache_fields(state_schema: any, identity: bool, attempted: bool) {
  return {
    state: state_schema,
    source_sha: if identity {
      schema_string() + {pattern: "^[0-9a-f]{40}$"}
    } else {
      schema_literal("")
    },
    workflow_run_id: if identity {
      schema_int() + {minimum: 1}
    } else {
      schema_literal(0)
    },
    workflow_run_url: if identity {
      schema_string() + {pattern: "^https://github[.]com/[^/]+/[^/]+/actions/runs/[0-9]+$"}
    } else {
      schema_literal("")
    },
    attempt_count: if attempted {
      schema_int() + {minimum: 1}
    } else {
      schema_literal(0)
    },
    dispatched_at: schema_string(),
    started_at: schema_string(),
    finished_at: schema_string(),
    updated_at: schema_string(),
    message: schema_string(),
  }
}

fn release_watch_warm_cache_schema() {
  const no_attempt = schema_closed_object(
    warm_cache_fields(schema_literal("not_requested"), false, false),
  )
  const accepted = schema_closed_object(
    warm_cache_fields(
      schema_enum(["dispatch_accepted", "running", "suppressed", "completed"]),
      true,
      true,
    ),
  )
  const failed_dispatch = schema_closed_object(
    warm_cache_fields(schema_literal("failed"), false, true),
  )
  const failed_run = schema_closed_object(warm_cache_fields(schema_literal("failed"), true, true))
  return schema_union([no_attempt, accepted, failed_dispatch, failed_run])
}

fn release_publication_schema() {
  return schema_closed_object(
    {
      version: schema_string()
        + {pattern: "^[0-9]+[.][0-9]+[.][0-9]+(?:-[0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?$"},
      local_branch: schema_string()
        + {pattern: "^release/v[0-9]+[.][0-9]+[.][0-9]+(?:-[0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?$"},
      remote_ref: schema_string()
        + {
          pattern:
            "^release-attempt/v[0-9]+[.][0-9]+[.][0-9]+(?:-[0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?/[0-9a-f]{40}$",
        },
      head_oid: schema_string() + {pattern: "^[0-9a-f]{40}$"},
    },
  )
}

fn release_certification_drift_schema() {
  return schema_closed_object(
    {
      state: schema_enum(["not_observed", "no_drift", "recorded"]),
      certified_base: schema_string(),
      observed_main: schema_string(),
      required_contexts: schema_list(schema_string()),
      commits: schema_list(
        schema_closed_object(
          {
            sha: schema_string(),
            pull_number: schema_int(),
            checks: schema_list(
              schema_closed_object(
                {
                  name: schema_string(),
                  state: schema_string(),
                  source: schema_string(),
                  release_only: schema_bool(),
                },
              ),
            ),
            green: schema_bool(),
            blocking_check: schema_string(),
          },
        ),
      ),
      drifted_paths: schema_list(schema_string()),
      release_only_checks: schema_list(schema_string()),
      observed_at: schema_string(),
    },
  )
}

fn release_main_delta_schema() {
  return schema_closed_object(
    {
      state: schema_enum(
        [
          "not_observed",
          "skipped_tree_already_certified",
          "skipped_no_release_only_lanes",
          "not_started",
          "incomplete",
          "running",
          "passed",
          "failed",
        ],
      ),
      commit: schema_string(),
      lanes: schema_list(schema_string()),
      checks: schema_list(
        schema_closed_object(
          {name: schema_string(), state: schema_string(), run_url: schema_string()},
        ),
      ),
      failing_check: schema_string(),
      observed_at: schema_string(),
    },
  )
}

/** A receipt that has not reached its tag decision carries no delta claim. */
pub fn release_main_delta_record_unobserved() -> ReleaseMainDeltaRecord {
  return {
    state: "not_observed",
    commit: "",
    lanes: [],
    checks: [],
    failing_check: "",
    observed_at: "",
  }
}

/** A receipt that has not reached its merge decision carries no drift claim. */
pub fn release_certification_drift_unobserved() -> ReleaseCertificationDrift {
  return {
    state: "not_observed",
    certified_base: "",
    observed_main: "",
    required_contexts: [],
    commits: [],
    drifted_paths: [],
    release_only_checks: [],
    observed_at: "",
  }
}

fn release_watch_receipt_schema() {
  return schema_closed_object(
    {
      schema_version: schema_literal("release_harn.publish_watch.v10"),
      initial_merge_request: schema_enum(["not_authorized", "authorized", "attempted", "observed"]),
      tag: schema_string()
        + {pattern: "^v[0-9]+[.][0-9]+[.][0-9]+(?:-[0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?$"},
      slug: schema_string() + {pattern: "^[^/]+/[^/]+$"},
      pin_sha: schema_string() + {pattern: "^[0-9a-f]{40}$"},
      publication: release_publication_schema(),
      release_commit_oid: schema_union(
        [schema_literal(""), schema_string() + {pattern: "^[0-9a-f]{40}$"}],
      ),
      pr_url: schema_string() + {pattern: "^https://github[.]com/[^/]+/[^/]+/pull/[0-9]+$"},
      merge_lease_candidate_pr: schema_int() + {minimum: 0},
      merge_lease_generation: schema_string() + {pattern: "^(?:|[A-Za-z0-9._:/-]+)$"},
      merge_lease_method: schema_enum(["", "merge", "rebase", "squash"]),
      landing: schema_nullable(schema_of(ReleaseLandingReceipt)),
      required_workflows: schema_list(schema_string()),
      observed_run_ids: schema_list(schema_int()),
      state: schema_enum(["pending", "recovering", "healthy", "failed"]),
      message: schema_string(),
      recovery: release_watch_recovery_schema(),
      warm_cache: release_watch_warm_cache_schema(),
      certification_drift: release_certification_drift_schema(),
      main_delta: release_main_delta_schema(),
      created_at: schema_string(),
      updated_at: schema_string(),
    },
  )
}

/** Re-derive immutable identity so valid-looking JSON cannot retarget a receipt. */
fn receipt_publication_from_validated(value: dict) -> ReleasePublication? {
  const publication = try {
    release_publication(value.version, value.head_oid)
  } catch (_error) {
    nil
  }
  if publication == nil {
    return nil
  }
  if value.local_branch != publication.local_branch || value.remote_ref != publication.remote_ref {
    return nil
  }
  return publication
}

fn receipt_from_validated(value: dict, publication: ReleasePublication) -> ReleaseWatchReceipt {
  return {
    schema_version: "release_harn.publish_watch.v10",
    initial_merge_request: value.initial_merge_request,
    tag: value.tag,
    slug: value.slug,
    pin_sha: value.pin_sha,
    publication: publication,
    release_commit_oid: value.release_commit_oid,
    pr_url: value.pr_url,
    merge_lease_candidate_pr: value.merge_lease_candidate_pr,
    merge_lease_generation: value.merge_lease_generation,
    merge_lease_method: value.merge_lease_method,
    landing: value.landing,
    required_workflows: value.required_workflows,
    observed_run_ids: value.observed_run_ids,
    state: value.state,
    message: value.message,
    recovery: {
      dispatched: value.recovery.dispatched,
      dispatched_at: value.recovery.dispatched_at,
      dispatch_status: value.recovery.dispatch_status,
      workflow_run_id: value.recovery.workflow_run_id ?? 0,
      workflow_run_url: value.recovery.workflow_run_url ?? "",
      workflow_path: value.recovery.workflow_path ?? "",
      source_ref: value.recovery.source_ref ?? "",
      source_sha: value.recovery.source_sha ?? "",
      event: value.recovery.event ?? "",
      head_branch: value.recovery.head_branch ?? "",
    },
    warm_cache: {
      state: value.warm_cache.state,
      source_sha: value.warm_cache.source_sha,
      workflow_run_id: value.warm_cache.workflow_run_id,
      workflow_run_url: value.warm_cache.workflow_run_url,
      attempt_count: value.warm_cache.attempt_count,
      dispatched_at: value.warm_cache.dispatched_at,
      started_at: value.warm_cache.started_at,
      finished_at: value.warm_cache.finished_at,
      updated_at: value.warm_cache.updated_at,
      message: value.warm_cache.message,
    },
    certification_drift: value.certification_drift,
    main_delta: value.main_delta,
    created_at: value.created_at,
    updated_at: value.updated_at,
  }
}

/** Validate an untyped JSON value once at the persistence boundary. */
pub fn release_watch_receipt_parse(value: dict) -> ReleaseWatchReceipt? {
  const legacy_has_lease = trim(to_string(value?.merge_lease_generation ?? "")) != ""
  const legacy = if value?.schema_version == "release_harn.publish_watch.v8" {
    value
      + {
        schema_version: "release_harn.publish_watch.v9",
        merge_lease_method: if legacy_has_lease {
          "squash"
        } else {
          ""
        },
        landing: nil,
      }
  } else {
    value
  }
  const migrated = if legacy?.schema_version == "release_harn.publish_watch.v9" {
    legacy
      + {schema_version: "release_harn.publish_watch.v10", initial_merge_request: "not_authorized"}
  } else {
    legacy
  }
  const report = schema_validator(release_watch_receipt_schema()).report(migrated)
  if !report.ok {
    return nil
  }
  const publication = receipt_publication_from_validated(report.value.publication)
  if publication == nil || report.value.tag != "v${publication.version}" {
    return nil
  }
  const lease_generation = trim(report.value.merge_lease_generation)
  if lease_generation == "" != (report.value.merge_lease_candidate_pr == 0) {
    return nil
  }
  if lease_generation == "" != (report.value.merge_lease_method == "") {
    return nil
  }
  if report.value.initial_merge_request != "not_authorized" && lease_generation == "" {
    return nil
  }
  const landing = report.value.landing
  if landing != nil
    && (lease_generation == ""
      || landing.tag_oid != publication.head_oid
      || landing.release_pr != report.value.merge_lease_candidate_pr
      || landing.merge_method != report.value.merge_lease_method) {
    return nil
  }
  return receipt_from_validated(report.value, publication)
}

/** Read and validate a durable watch receipt. */
pub fn release_watch_receipt_read(fs: HarnessFs, path: string) -> ReleaseWatchReceipt? {
  const loaded = read_json_result(fs, path)
  if !is_ok(loaded) {
    return nil
  }
  return release_watch_receipt_parse(unwrap(loaded))
}

/** Write a receipt through rename-into-place so interruption cannot truncate it. */
pub fn release_watch_receipt_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  path: string,
  receipt: ReleaseWatchReceipt,
) -> string {
  const temp_path = path + ".tmp-" + harness.random.uuid_v7()
  write_json(harness.fs, temp_path, receipt, {pretty: true})
  harness.fs.rename(temp_path, path)
  return path
}

/** Resolve one canonical receipt path, rejecting traversal through the tag. */
pub fn release_watch_receipt_path(root: string, tag: string) -> string {
  const clean_tag = trim(tag)
  if !is_v_release_semver(clean_tag) {
    throw "release watch tag must be a canonical v-prefixed release version, got: " + clean_tag
  }
  return path_join(root, "watches", clean_tag + ".json")
}

/** Bind the write-once published commit before or after an idempotent tag push. */
pub fn release_watch_receipt_bind_main_commit(
  receipt: ReleaseWatchReceipt,
  release_commit_oid: string,
  observed_at: string,
) -> ReleaseWatchReceipt {
  const oid = lowercase(trim(release_commit_oid))
  if regex_match("^[0-9a-f]{40}$", oid) == nil {
    throw "release main commit must be an exact 40-hex OID"
  }
  if receipt.release_commit_oid != "" && receipt.release_commit_oid != oid {
    throw "release receipt is already bound to ${receipt.release_commit_oid}, not ${oid}"
  }
  return {
    schema_version: "release_harn.publish_watch.v10",
    initial_merge_request: receipt.initial_merge_request,
    tag: receipt.tag,
    slug: receipt.slug,
    pin_sha: receipt.pin_sha,
    publication: receipt.publication,
    release_commit_oid: oid,
    pr_url: receipt.pr_url,
    merge_lease_candidate_pr: receipt.merge_lease_candidate_pr,
    merge_lease_generation: receipt.merge_lease_generation,
    merge_lease_method: receipt.merge_lease_method,
    landing: receipt.landing,
    required_workflows: receipt.required_workflows,
    observed_run_ids: receipt.observed_run_ids,
    state: receipt.state,
    message: receipt.message,
    recovery: receipt.recovery,
    warm_cache: receipt.warm_cache,
    certification_drift: receipt.certification_drift,
    main_delta: receipt.main_delta,
    created_at: receipt.created_at,
    updated_at: observed_at,
  }
}

fn observed_run_ids(runs: list<dict>, tag: string, accepted_run_ids: list<int> = []) -> list<int> {
  let ids: list<int> = []
  for run in runs {
    const run_id = to_int(run?.id ?? 0) ?? 0
    if run.head_branch != tag
      && !accepted_run_ids.any({ accepted -> accepted == run_id }) {
      continue
    }
    if run_id > 0 && !ids.any({ existing -> existing == run_id }) {
      ids = ids + [run_id]
    }
  }
  return ids
}

/** Create the durable state written immediately after tag/branch/PR creation. */
pub fn release_watch_receipt(inputs: ReleaseWatchReceiptInputs) -> ReleaseWatchReceipt {
  const created_at = trim(inputs.created_at)
  const publication = release_publication(
    trim(inputs.publication?.version ?? ""),
    trim(inputs.publication?.head_oid ?? ""),
  )
  const tag = trim(inputs.tag)
  if tag != "v${publication.version}" {
    throw "release watch tag ${tag} must match immutable publication version ${publication.version}"
  }
  const pr_prefix = "https://github.com/${trim(inputs.slug)}/pull/"
  const candidate_pr = if trim(inputs.pr_url).starts_with(pr_prefix) {
    to_int(trim(inputs.pr_url).substring(len(pr_prefix))) ?? 0
  } else {
    0
  }
  const merge_lease_generation = trim(inputs.merge_lease_generation ?? "")
  const merge_lease_method: ReleaseMergeMethod | "" = if merge_lease_generation == "" {
    ""
  } else {
    inputs.merge_lease_method ?? "squash"
  }
  if merge_lease_generation != "" && candidate_pr <= 0 {
    throw "release merge lease generation requires an exact candidate pull request"
  }
  if (inputs.authorize_initial_merge ?? false) && merge_lease_generation == "" {
    throw "initial release merge request requires an exact release merge lease"
  }
  return {
    schema_version: "release_harn.publish_watch.v10",
    initial_merge_request: if inputs.authorize_initial_merge ?? false {
      "authorized"
    } else {
      "not_authorized"
    },
    tag: tag,
    slug: trim(inputs.slug),
    pin_sha: trim(inputs.pin_sha),
    publication: publication,
    release_commit_oid: "",
    pr_url: trim(inputs.pr_url),
    merge_lease_candidate_pr: if merge_lease_generation == "" {
      0
    } else {
      candidate_pr
    },
    merge_lease_generation: merge_lease_generation,
    merge_lease_method: merge_lease_method,
    landing: nil,
    required_workflows: inputs.required_workflows
      ?? ["publish-release.yml", "build-release-binaries.yml"],
    observed_run_ids: [],
    state: "pending",
    message: "release publish has not been observed yet",
    recovery: {
      dispatched: false,
      dispatched_at: "",
      dispatch_status: "not_requested",
      workflow_run_id: 0,
      workflow_run_url: "",
      workflow_path: "",
      source_ref: "",
      source_sha: "",
      event: "",
      head_branch: "",
    },
    warm_cache: {
      state: "not_requested",
      source_sha: "",
      workflow_run_id: 0,
      workflow_run_url: "",
      attempt_count: 0,
      dispatched_at: "",
      started_at: "",
      finished_at: "",
      updated_at: created_at,
      message: "warm-cache dispatch has not been requested",
    },
    certification_drift: release_certification_drift_unobserved(),
    main_delta: release_main_delta_record_unobserved(),
    created_at: created_at,
    updated_at: created_at,
  }
}
