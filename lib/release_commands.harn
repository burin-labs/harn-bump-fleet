import { command_step } from "std/command"
import { end_timing, start_timing } from "std/timing"
import { gh_cli_transient_failure, gh_retry_delay_seconds } from "./github_cli"
import { step_classification, step_recovery_hint } from "./release_execution"
import { command_output, require_shell_arg } from "./shell_util"

pub fn release_prepare_env(repo, bootstrap_new_crates = false) {
  let target_dir = require_shell_arg(path_join(repo, "target/release-harn"), "release cargo target dir")
  var release_env = "env -u HARN_BIN CARGO_TARGET_DIR=${target_dir} HARN_RELEASE_HARNESS=1"
  if bootstrap_new_crates ?? false {
    release_env = release_env + " HARN_BOOTSTRAP_NEW_CRATES=1"
  }
  return release_env
}

/**
 * Resolve a `command` argument into a `std/command` spec and a human-readable
 * label suitable for step display / classification.
 *
 * Strings build a shell-mode spec (with the SH bourne shell pinned) for
 * commands that intentionally rely on shell features like `&&`, `||`, or
 * `2>/dev/null`. Lists build an argv-mode spec, which is the preferred path
 * for `git`/`gh` invocations since argv bypasses shell quoting entirely.
 */
fn release_command_spec(cfg, command) {
  if type_of(command) == "list" {
    let label = join(command.map({ a -> to_string(a) }), " ")
    // Carry the shell-equivalent label on the spec so `step.command` is
    // populated for downstream consumers (audit logs, recovery checks, the
    // step_classification closure) — `std/command` lifts `spec.command` onto
    // the step record unchanged.
    return {spec: {mode: "argv", argv: command, command: label, cwd: cfg.repo}, label: label}
  }
  return {spec: {mode: "shell", command: command, shell: {id: "sh"}, cwd: cfg.repo}, label: command}
}

fn release_command_options(label, runner, extra = nil) {
  var opts = {
    capture: {max_inline_bytes: 12000},
    tail_bytes: 12000,
    classify: { step -> step_classification(label, step) },
    recovery_hint: { step -> step_recovery_hint(label, step) },
  }
  if runner != nil {
    opts = opts + {runner: runner}
  }
  let extra_opts = extra ?? {}
  return opts + extra_opts
}

fn live_logged_shell_command(command, log_path) {
  let log_arg = require_shell_arg(log_path, "live log path")
  return "{ " + command + "; } > " + log_arg
    + " 2>&1; __harn_status=$?; printf 'full output: %s\\n' "
    + log_arg
    + "; exit $__harn_status"
}

fn live_log_path_for(command, extra) {
  if type_of(command) == "list" {
    return ""
  }
  return extra?.live_log_path ?? ""
}

fn release_command_category(command) {
  if type_of(command) == "list" {
    if len(command) == 0 {
      return "argv"
    }
    return basename(to_string(command[0]))
  }
  let parts = trim(to_string(command)).split(" ").filter({ part -> part != "" })
  if len(parts) == 0 {
    return "shell"
  }
  return basename(parts[0])
}

fn release_step_span_status(step) {
  return if step.success {
    "ok"
  } else {
    "error"
  }
}

/**
 * Format a step duration (ms) for inline progress output.
 *
 * Sub-100ms steps render as `<n>ms`; 100ms+ steps round to the nearest
 * tenth of a second so the user has a feel for cost on each command
 * without the noise of millisecond-level precision.
 */
fn format_step_duration_ms(elapsed_ms) {
  let ms = elapsed_ms ?? 0
  if ms < 100 {
    return "${ms}ms"
  }
  let tenths = (ms + 50) / 100
  let whole = tenths / 10
  let frac = tenths - whole * 10
  return "${whole}.${frac}s"
}

/**
 * Run one release command through std/command and append its normalized step.
 *
 * `command` accepts either a string (shell-mode) or a list (argv-mode) — see
 * `release_command_spec` for the rationale.
 */
pub fn append_std_command_step(
  harness: Harness,
  cfg,
  steps,
  name,
  command,
  runner = nil,
  extra = nil,
) {
  let print_progress = !(cfg.mock ?? false) && !(cfg.quiet ?? false)
  if print_progress {
    harness.stdio.println("   → ${name}")
  }
  let live_log_path = live_log_path_for(command, extra)
  let command_to_run = if live_log_path == "" {
    command
  } else {
    live_logged_shell_command(command, live_log_path)
  }
  let resolved = release_command_spec(cfg, command_to_run)
  let label = release_command_label(command)
  let timing = start_timing(
    "release.command",
    {step: name, category: release_command_category(command), mode: resolved.spec.mode ?? ""},
  )
  var step = try {
    command_step(name, resolved.spec, release_command_options(label, runner, extra))
  } catch (e) {
    end_timing(timing, {status: "error", outcome: "exception", error: to_string(e)})
    throw e
  }
  if live_log_path != "" {
    step = step + {command: label, live_log: live_log_path}
  }
  let timing_report = end_timing(
    timing,
    {
      status: release_step_span_status(step),
      outcome: step.classification ?? "",
      exit_code: step.status ?? 0,
    },
  )
  if print_progress {
    let mark = if step.success {
      "✓"
    } else {
      "✗"
    }
    let elapsed = format_step_duration_ms(timing_report.duration_ms)
    let suffix = if step.success {
      ""
    } else {
      " (status ${step.status})"
    }
    harness.stdio.println("   ${mark} ${name} (${elapsed})${suffix}")
  }
  let current_steps = steps ?? []
  return {
    steps: current_steps + [step],
    step: step,
    success: step.success,
    status: step.status,
    stdout: step.stdout,
    stderr: step.stderr,
  }
}

fn retryable_gh_cli_failure(command, step) {
  if step.success || !starts_with(command, "gh ") {
    return false
  }
  return gh_cli_transient_failure(command_output(step))
}

fn release_command_label(command) {
  if type_of(command) == "list" {
    return join(command.map({ a -> to_string(a) }), " ")
  }
  return command
}

/** Run a GitHub CLI release command with std/command retry policy. */
pub fn append_std_github_command_step(harness: Harness, cfg, steps, name, command, runner = nil) {
  let label = release_command_label(command)
  return append_std_command_step(
    harness,
    cfg,
    steps,
    name,
    command,
    runner,
    {
      retry: {
        max_attempts: 3,
        should_retry: { step, _attempt -> retryable_gh_cli_failure(label, step) },
        before_retry: { _step, attempt -> harness.clock.sleep_ms(gh_retry_delay_seconds(attempt + 1) * 1000) },
      },
    },
  )
}

// -------------------------------------------------------------------------------------------------
// Interactive flag resolution helpers (pure; the terminal read lives in release_harn).
// -------------------------------------------------------------------------------------------------

/** True when `flag` (e.g. `"--mode"`) was passed explicitly on the command line. */
pub fn release_flag_passed(argv, flag) {
  for a in argv ?? [] {
    let s = to_string(a)
    if s == flag || starts_with(s, flag + "=") {
      return true
    }
  }
  return false
}

/**
 * Resolve a prompted flag answer against the allowed choices. Pure, so the
 * validation is testable apart from the terminal read. `ok` is the
 * `std/io::read_line` success flag; on timeout/EOF (`ok == false`), a blank
 * answer, or an answer outside `choices`, fall back to `default_val`. Returns
 * `{value, note}` where `note` is a one-line explanation to echo (empty when
 * the typed answer was accepted verbatim).
 */
pub fn coerce_flag_choice(raw_value, ok, choices, default_val) {
  if !ok {
    return {value: default_val, note: "no input within timeout; using ${default_val}"}
  }
  let v = lowercase(trim(raw_value ?? ""))
  if v == "" {
    return {value: default_val, note: "using ${default_val}"}
  }
  for c in choices {
    if v == c {
      return {value: c, note: ""}
    }
  }
  return {value: default_val, note: "'${raw_value}' is not ${join(choices, "/")}; using ${default_val}"}
}
