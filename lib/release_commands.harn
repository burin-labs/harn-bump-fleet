import { command_step } from "std/command"
import { gh_cli_transient_failure, gh_retry_delay_seconds } from "./github_cli"
import { step_classification, step_recovery_hint } from "./release_execution"
import { command_output } from "./shell_util"

fn release_command_spec(cfg, command) {
  return {mode: "shell", command: command, shell: {id: "sh"}, cwd: cfg.repo}
}

fn release_command_options(command, runner, extra = nil) {
  var opts = {
    capture: {max_inline_bytes: 12000},
    tail_bytes: 12000,
    classify: { step -> step_classification(command, step) },
    recovery_hint: { step -> step_recovery_hint(command, step) },
  }
  if runner != nil {
    opts = opts + {runner: runner}
  }
  let extra_opts = extra ?? {}
  return opts + extra_opts
}

/** Run one release command through std/command and append its normalized step. */
pub fn append_std_command_step(cfg, steps, name, command, runner = nil, extra = nil) {
  let step = command_step(
    name,
    release_command_spec(cfg, command),
    release_command_options(command, runner, extra),
  )
  let current_steps = steps ?? []
  return {
    steps: current_steps + [step],
    step: step,
    success: step.success,
    status: step.status,
    stdout: step.stdout,
    stderr: step.stderr,
  }
}

fn retryable_gh_cli_failure(command, step) {
  if step.success || !starts_with(command, "gh ") {
    return false
  }
  return gh_cli_transient_failure(command_output(step))
}

/** Run a GitHub CLI release command with std/command retry policy. */
pub fn append_std_github_command_step(cfg, steps, name, command, runner = nil) {
  return append_std_command_step(
    cfg,
    steps,
    name,
    command,
    runner,
    {
      retry: {
        max_attempts: 3,
        should_retry: { step, _attempt -> retryable_gh_cli_failure(command, step) },
        before_retry: { _step, attempt -> sleep_ms(gh_retry_delay_seconds(attempt + 1) * 1000) },
      },
    },
  )
}
