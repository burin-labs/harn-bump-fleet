/**
 * Whether an already-certified release attempt may be reused instead of
 * certified again.
 *
 * A cut certifies one frozen candidate for about two hours. When it defers
 * before merging anything, that certification is still true of that exact
 * commit: the attempt branch `release-attempt/vX.Y.Z/<oid>` still exists, its
 * pull request is still open, and the hosted lanes that passed on it are still
 * recorded against it. The harness can already adopt such an attempt through
 * `pre_tag_resume`; what it could not do was decide whether adopting one lets
 * it skip certification.
 *
 * That decision is this module, and it has three answers rather than two,
 * because the interesting case is the one in the middle.
 *
 * - Green evidence for every required lane means reuse.
 * - A settled failure on any lane means refuse. A red attempt must not be
 *   quietly re-certified into a green one; someone decided to ship a commit
 *   whose proof failed, and that deserves a stop.
 * - Absent or unfinished evidence means certify. This is the case that makes
 *   the module worth having: an attempt with no recorded lanes looks exactly
 *   like an attempt whose lanes all passed if the only question asked is "is
 *   anything red". Nothing here treats silence as proof.
 *
 * The base guard lives elsewhere on purpose. `pre_certification_cutoff_gate`
 * already proves the frozen candidate still descends from the default branch,
 * so this module does not re-answer an ancestry question that has an owner.
 */
import { admission_state_is_passing, latest_check_per_name } from "./pr_admission"

/** Why a reuse decision came out the way it did, in the caller's vocabulary. */
pub type ReleaseAttemptReuseDecision = "reuse" | "certify" | "refuse"

pub type ReleaseAttemptReuseVerdict = {
  decision: ReleaseAttemptReuseDecision,
  reason: string,
  /** Lanes proved green on the attempt, sorted. */
  proved: list<string>,
  /** Required lanes with no settled result, sorted. Never a reuse. */
  unproved: list<string>,
  /** Required lanes with a settled failure, sorted. Never a reuse. */
  failed: list<string>,
}

fn check_state(row: any) -> string {
  const conclusion = uppercase(trim(to_string(row?.conclusion ?? "")))
  if conclusion != "" {
    return conclusion
  }
  const status = uppercase(trim(to_string(row?.status ?? "")))
  if status != "" {
    return status
  }
  return "MISSING"
}

fn settled(state: string) -> bool {
  const value = uppercase(trim(state))
  return value != "MISSING" && value != "PENDING" && value != "QUEUED" && value != "IN_PROGRESS"
    && value != "WAITING"
}

/**
 * Decide whether the attempt at `attempt_oid` may be reused.
 *
 * `required_lanes` are the checks whose green result the release is claiming
 * to inherit. An empty list is refused rather than treated as satisfied: a
 * caller that could not read which lanes matter would otherwise inherit
 * nothing and call it proof.
 *
 * `rows` are the raw check rows recorded against the attempt commit. They are
 * reduced to the latest per name first, because a rerun does not replace its
 * predecessor's row and a stale failure sitting beside a fresh success must
 * not decide a release.
 */
pub fn release_attempt_reuse_verdict(
  attempt_oid: string,
  required_lanes: list<string>,
  rows: list?,
) -> ReleaseAttemptReuseVerdict {
  const oid = lowercase(trim(attempt_oid))
  const empty = {proved: [], unproved: [], failed: []}
  if len(regex_captures("^[0-9a-f]{40}$", oid)) == 0 {
    return empty
      + {
        decision: "refuse",
        reason: "release attempt reuse needs a full 40-hex attempt OID, got '${attempt_oid}'",
      }
  }
  if len(required_lanes) == 0 {
    return empty
      + {
        decision: "refuse",
        reason:
          "the certification lanes this attempt would inherit could not be read, so no attempt can be proved green",
      }
  }
  const reduced = latest_check_per_name(rows)
  let proved: list<string> = []
  let unproved: list<string> = []
  let failed: list<string> = []
  for lane in required_lanes {
    let state = "MISSING"
    for row in reduced {
      if trim(to_string(row?.name ?? "")) == lane {
        state = check_state(row)
      }
    }
    if !settled(state) {
      unproved = unproved + [lane]
    } else if admission_state_is_passing(state) {
      proved = proved + [lane]
    } else {
      failed = failed + [lane]
    }
  }
  const sorted = {proved: proved.sort(), unproved: unproved.sort(), failed: failed.sort()}
  if len(failed) > 0 {
    return sorted
      + {
        decision: "refuse",
        reason:
          "attempt ${oid} failed ${join(failed.sort(), ", ")}; a failed certification must not be reused or silently repeated",
      }
  }
  if len(unproved) > 0 {
    return sorted
      + {
        decision: "certify",
        reason:
          "attempt ${oid} has no settled result for ${join(unproved.sort(), ", ")}; absent evidence is not green evidence",
      }
  }
  return sorted
    + {decision: "reuse", reason: "attempt ${oid} already proved ${join(proved.sort(), ", ")}"}
}
