import { read_line } from "std/io"
import { version_from_tag } from "std/semver"
import {
  chat_cfg_from_run_dir,
  chat_enabled,
  pick_recent_run,
  resolve_chat_run_path,
} from "./chat_runs"
import {
  HarnReleaseContract,
  contract_next_development_version,
  contract_workspace_proves_release_fold,
} from "./harn_release_contract"
import { run_chat_loop } from "./post_run_chat"
import { release_repair_tools } from "./release_agent_tools"
import {
  RetiredReleaseChain,
  changelog_retired_release_chain,
  changelog_top_from_text,
  workspace_version_from_manifest,
} from "./release_analysis"
import { coerce_flag_choice, release_flag_passed } from "./release_commands"
import { ReleaseConfig, expand_home } from "./release_runtime"

pub type PriorReleaseFoldEvidence = {
  contract: HarnReleaseContract,
  base_ref: string,
  latest_tag: string,
  workspace_version: string,
  changelog_version: string,
  retirement: RetiredReleaseChain,
  recovery_ref: string,
  recovery_pr_number: int?,
  recovery_pr_url: string,
}

pub type PriorReleaseFoldDecision = {proceed: bool, reason: string, detail: string}

pub fn release_chat_only(harness: Harness, raw_cfg: ReleaseConfig) -> int {
  if !chat_enabled(pick(harness, ["term", "env"]), raw_cfg) {
    harness.stdio.eprintln("--chat-only requires an interactive terminal (and HARN_EXT_CHAT != 0)")
    return 2
  }
  const kind = "release-harn"
  const target_dir = if trim(raw_cfg.chat_run ?? "") != "" {
    resolve_chat_run_path(harness.fs, kind, raw_cfg.chat_run)
  } else {
    const pick = pick_recent_run(harness, pick(harness, ["stdio", "fs"]), kind, 12)
    if pick == nil {
      nil
    } else {
      pick.dir
    }
  }
  if target_dir == nil {
    harness.stdio.println("(no run selected; exiting)")
    return 0
  }
  const chat_cfg = chat_cfg_from_run_dir(
    harness.fs,
    {
      provider: raw_cfg.provider,
      model: raw_cfg.model,
      repo: expand_home(harness.env, raw_cfg.repo),
      mock: raw_cfg.mock,
      timeout_s: raw_cfg.chat_timeout_s,
      tools: release_repair_tools(
        harness,
        {...raw_cfg, repo: expand_home(harness.env, raw_cfg.repo)},
        basename(target_dir),
      ),
      no_chat: raw_cfg.no_chat,
    },
    kind,
    target_dir,
  )
  run_chat_loop(harness, chat_cfg)
  return 0
}

fn release_prompt_flag(stdio: HarnessStdio, label: any, choices: any, default_val: any) {
  const result = read_line(stdio, {prompt: label, timeout_ms: 60000, trim: true})
  const resolved = coerce_flag_choice(result.value ?? "", result.ok ?? false, choices, default_val)
  if resolved.note != "" {
    stdio.println("   ↳ ${resolved.note}")
  }
  return resolved.value
}

/** Resolve interactive choices before dispatching to the owning mode. */
pub fn resolve_release_flags_interactively(
  harness: Harness,
  cfg: ReleaseConfig,
  argv: list<string>,
) -> ReleaseConfig {
  if !chat_enabled(pick(harness, ["term", "env"]), cfg) {
    return cfg
  }
  let out = cfg
  if !release_flag_passed(argv, "--mode") {
    out["mode"] = release_prompt_flag(
      harness.stdio,
      "Release mode: audit / ship-pr [audit]: ",
      ["audit", "ship-pr"],
      "audit",
    )
  }
  if !release_flag_passed(argv, "--bump") {
    out["bump"] = release_prompt_flag(
      harness.stdio,
      "Version bump for audit: patch / minor / major [patch]: ",
      ["patch", "minor", "major"],
      "patch",
    )
  }
  if out.mode != "audit" && !out.yes_live_release {
    harness.stdio.println("   live ship-pr requires --yes-live-release")
  }
  return out
}

pub fn prior_release_fold_base_evidence(
  base_ref: string,
  latest_tag: string,
  cargo_toml: string,
  changelog: string,
  contract: HarnReleaseContract,
  source_tags: list<string>? = nil,
) -> PriorReleaseFoldEvidence {
  const workspace_version = workspace_version_from_manifest(cargo_toml)
  return {
    contract: contract,
    base_ref: trim(base_ref),
    latest_tag: trim(latest_tag),
    workspace_version: workspace_version,
    changelog_version: changelog_top_from_text(changelog),
    retirement: changelog_retired_release_chain(
      changelog,
      version_from_tag(trim(latest_tag)),
      workspace_version,
      source_tags,
    ),
    recovery_ref: "",
    recovery_pr_number: nil,
    recovery_pr_url: "",
  }
}

pub fn prior_release_fold_decision(evidence: PriorReleaseFoldEvidence) -> PriorReleaseFoldDecision {
  const latest_version = version_from_tag(trim(evidence.latest_tag))
  if latest_version == "" {
    return {proceed: true, reason: "no prior release tag exists", detail: ""}
  }
  if !evidence.retirement.valid && trim(evidence.changelog_version) == latest_version {
    return {
      proceed: false,
      reason: evidence.retirement.detail,
      detail: "release retirement evidence is incomplete: ${evidence.retirement.detail}",
    }
  }
  const workspace_version = trim(evidence.workspace_version)
  const prior = evidence.retirement.prior_version
  const development_form = contract_next_development_version(evidence.contract, prior)
  const workspace_matches = if len(evidence.retirement.retired_versions) > 0 {
    workspace_version == development_form
  } else {
    contract_workspace_proves_release_fold(evidence.contract, workspace_version, latest_version)
  }
  const changelog_matches = trim(evidence.changelog_version) == latest_version
  if workspace_matches && changelog_matches {
    return {
      proceed: true,
      reason: "${evidence.base_ref} contains the ${evidence.latest_tag} release fold"
        + if len(evidence.retirement.retired_versions) > 0 {
          " and ${len(evidence.retirement.retired_versions)} recorded retirement(s)"
        } else {
          ""
        },
      detail: "",
    }
  }
  let mismatches = []
  if !workspace_matches {
    mismatches = mismatches
      + [
        "workspace version is ${evidence.workspace_version} "
          + if len(evidence.retirement.retired_versions) > 0 {
            "(expected ${development_form} after recorded retirement)"
          } else {
            "(expected ${latest_version} or ${development_form})"
          },
      ]
  }
  if !changelog_matches {
    mismatches = mismatches
      + ["CHANGELOG top is v${evidence.changelog_version} (expected v${latest_version})"]
  }
  const ref = trim(evidence.recovery_ref)
  const pr_url = trim(evidence.recovery_pr_url)
  const recovery = if pr_url != "" && evidence.recovery_pr_number != nil {
    "orphaned fold: PR #${evidence.recovery_pr_number} ${pr_url}"
      + if ref == "" {
        ""
      } else {
        " (head `${ref}`)"
      }
  } else if ref != "" {
    "orphaned fold branch: `${ref}`"
  } else {
    "no matching fold PR or branch was found"
  }
  return {
    proceed: false,
    reason: join(mismatches, "; "),
    detail: "latest published tag ${evidence.latest_tag} is not folded into ${evidence.base_ref}: "
      + join(mismatches, "; ")
      + ". ${recovery}. Recreate the fold from ${evidence.latest_tag} on fresh origin base, merge it, then rerun the release.",
  }
}
