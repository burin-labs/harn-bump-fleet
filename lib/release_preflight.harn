pub type PriorReleaseFoldEvidence = {
  base_ref: string,
  latest_tag: string,
  workspace_version: string,
  changelog_version: string,
  recovery_ref: string,
  recovery_pr_number: int?,
  recovery_pr_url: string,
}

pub type PriorReleaseFoldDecision = {proceed: bool, reason: string, detail: string}

pub type PriorReleaseFoldConfig = {
  repo: string,
  base: string,
  bump?: "patch" | "minor" | "major",
  mode: "audit" | "prepare" | "ship-pr",
  mock: bool,
  yes_live_release: bool,
}

pub fn release_chat_only(harness: Harness, raw_cfg: ReleaseConfig) -> int {
  if !chat_enabled({term: harness.term, env: harness.env}, raw_cfg) {
    harness.stdio.eprintln("--chat-only requires an interactive terminal (and HARN_EXT_CHAT != 0)")
    return 2
  }
  const kind = "release-harn"
  const target_dir = if trim(raw_cfg.chat_run ?? "") != "" {
    resolve_chat_run_path(harness.fs, kind, raw_cfg.chat_run)
  } else {
    const pick = pick_recent_run(harness, {stdio: harness.stdio, fs: harness.fs}, kind, 12)
    if pick == nil {
      nil
    } else {
      pick.dir
    }
  }
  if target_dir == nil {
    harness.stdio.println("(no run selected; exiting)")
    return 0
  }
  const chat_cfg = chat_cfg_from_run_dir(
    harness.fs,
    {
      provider: raw_cfg.provider,
      model: raw_cfg.model,
      repo: expand_home(harness.env, raw_cfg.repo),
      mock: raw_cfg.mock,
      timeout_s: raw_cfg.chat_timeout_s,
      tools: release_repair_tools(
        harness,
        {...raw_cfg, repo: expand_home(harness.env, raw_cfg.repo)},
        basename(target_dir),
      ),
      no_chat: raw_cfg.no_chat,
    },
    kind,
    target_dir,
  )
  run_chat_loop(harness, chat_cfg)
  return 0
}

/** Prompt once for a single release-shaping flag and echo any fallback note. */
fn release_prompt_flag(harness: HarnessStdio, label, choices, default_val) {
  const r = read_line(harness, {prompt: label, timeout_ms: 60000, trim: true})
  const resolved = coerce_flag_choice(r.value ?? "", r.ok ?? false, choices, default_val)
  if resolved.note != "" {
    harness.println("   ↳ ${resolved.note}")
  }
  return resolved.value
}

/**
 * On an interactive terminal, fill in the release-shaping flags the operator
 * didn't pass (`--mode`, `--bump`) with a short prompt. Gated by
 * `chat_enabled`, so CI, piped/redirected stdin, `--no-chat`, and
 * `HARN_EXT_CHAT=0` all keep today's silent-default behavior untouched. Returns
 * `cfg` with the resolved values.
 */
pub fn resolve_release_flags_interactively(
  harness: Harness,
  cfg: ReleaseConfig,
  argv: list<string>,
) -> ReleaseConfig {
  if !chat_enabled({term: harness.term, env: harness.env}, cfg) {
    return cfg
  }
  let out = cfg
  if !release_flag_passed(argv, "--mode") {
    out["mode"] = release_prompt_flag(
      harness.stdio,
      "ℹ No --mode given. Release mode — audit / prepare / ship-pr [audit]: ",
      ["audit", "prepare", "ship-pr"],
      "audit",
    )
  }
  if !release_flag_passed(argv, "--bump") {
    out["bump"] = release_prompt_flag(
      harness.stdio,
      "ℹ No --bump given. Version bump — patch / minor / major [patch]: ",
      ["patch", "minor", "major"],
      "patch",
    )
  }
  // A non-audit mode picked interactively still needs the explicit live flag —
  // surface that so the operator isn't surprised by a read-only "live" run.
  if out.mode != "audit" && !(out.yes_live_release ?? false)
    && !release_flag_passed(
    argv,
    "--yes-live-release",
  ) {
    harness.stdio.println(
      "   ↳ note: live ${out.mode} side effects still require --yes-live-release; without it this run stays read-only",
    )
  }
  return out
}

/**
 * Clear a poisoned `sccache` daemon before the build-heavy `prepare` step.
 *
 * Only relevant for modes that compile (`prepare`/`ship-pr`) and never for
 * mock runs. A daemon left confined by an earlier sandboxed build (harn's
 * sandbox, a sandboxed agent shell, …) breaks every cargo build machine-wide
 * with `Operation not permitted` — which is exactly how the v0.8.82 release's
 * warm-prebuild died despite running `--no-sandbox`. See lib/sccache_preflight.
 */
pub fn release_sccache_preflight(
  harness: {stdio: HarnessStdio, process: HarnessProcess},
  cfg: dict,
) -> nil {
  if cfg.mock ?? false {
    return
  }
  if !(cfg.mode == "prepare" || cfg.mode == "ship-pr") {
    return
  }
  const result = ensure_healthy_sccache({ cmd -> harness.process.shell(cmd) })
  if result.restarted {
    harness.stdio.println(
      "   ⚠ ${result.detail} — stale sandbox confinement cleared; the prepare build will spawn a fresh server",
    )
  } else if result.checked {
    harness.stdio.println("   ✓ sccache daemon healthy")
  }
}

/**
 * The bump-fleet checkout's own default branch. This is the repo
 * release_harn.harn lives in, NOT the target release repo (`cfg.repo`/`cfg.base`).
 */
fn fleet_default_branch(harness: HarnessEnv) {
  return env_str(harness, "HARN_EXT_FLEET_DEFAULT_BRANCH") ?? "main"
}

/**
 * F4: guard against the bump-fleet checkout running its own stale release code.
 *
 * release_harn checks the TARGET repo's freshness but never its own; a stale
 * bump-fleet runs old logic and can crash mid-cut (the v0.9.21 failure). Only
 * mutating modes gate; pure audit is read-only. A behind, fast-forwardable
 * checkout fast-forwards in place by default rather than failing the launch;
 * it fails loud only on a diverged history or a dirty tree (the latter
 * overridable with `--self-update` / `FLEET_SELF_UPDATE=1`). Never silently stale.
 */
pub fn release_fleet_self_check(harness: Harness, cfg: ReleaseConfig, run_id: string) -> nil {
  if cfg.mock ?? false {
    return
  }
  if cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return
  }
  const result = fleet_self_check(
    { args -> git_run(harness.process, args) },
    { p -> harness.fs.exists(p) },
    {
      mode: cfg.mode,
      opt_in: cfg.self_update ?? false,
      default_branch: fleet_default_branch(harness.env),
    },
  )
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "fleet_self_check",
    {
      action: result.action,
      reason: result.reason,
      fleet_root: result.fleet_root ?? "",
      remote_ref: result.remote_ref ?? "",
      local_sha: result.local_sha ?? "",
      remote_sha: result.remote_sha ?? "",
    },
  )
  if result.action == "fail" {
    harness.stdio.println("   ✗ bump-fleet self-check: ${result.reason}")
    throw "bump-fleet checkout is stale: ${result.reason}\nremediation: ${result.remediation ?? "git pull --ff-only"}"
  }
  if result.action == "autoff" {
    const ff_ok = (result.ff ?? {}).success ?? false
    if !ff_ok {
      throw "bump-fleet self-update fast-forward failed: ${(result.ff ?? {}).stderr ?? ""}\nremediation: ${result.remediation ?? "git pull --ff-only"}"
    }
    harness.stdio.println("   ↻ bump-fleet self-update: ${result.reason}")
  } else if result.action == "warn" {
    harness.stdio.println("   ⚠ bump-fleet self-check: ${result.reason}")
  } else if result.action == "proceed" {
    harness.stdio.println("   ✓ bump-fleet self-check: ${result.reason}")
  }
}

pub fn prior_release_fold_base_evidence(
  base_ref: string,
  latest_tag: string,
  cargo_toml: string,
  changelog: string,
) -> PriorReleaseFoldEvidence {
  return {
    base_ref: trim(base_ref),
    latest_tag: trim(latest_tag),
    workspace_version: workspace_version_from_manifest(cargo_toml),
    changelog_version: changelog_top_from_text(changelog),
    recovery_ref: "",
    recovery_pr_number: nil,
    recovery_pr_url: "",
  }
}

pub fn prior_release_fold_decision(evidence: PriorReleaseFoldEvidence) -> PriorReleaseFoldDecision {
  const latest_version = version_from_tag(trim(evidence.latest_tag))
  if latest_version == "" {
    return {proceed: true, reason: "no prior release tag exists", detail: ""}
  }
  const workspace_matches = trim(evidence.workspace_version) == latest_version
  const changelog_matches = trim(evidence.changelog_version) == latest_version
  if workspace_matches && changelog_matches {
    return {
      proceed: true,
      reason: "${evidence.base_ref} contains the ${evidence.latest_tag} release fold",
      detail: "",
    }
  }
  let mismatches = []
  if !workspace_matches {
    mismatches = mismatches
      + [
      "workspace version is ${evidence.workspace_version} (expected ${latest_version})",
    ]
  }
  if !changelog_matches {
    mismatches = mismatches
      + [
      "CHANGELOG top is v${evidence.changelog_version} (expected v${latest_version})",
    ]
  }
  const ref = trim(evidence.recovery_ref)
  const pr_url = trim(evidence.recovery_pr_url)
  const recovery = if pr_url != "" && evidence.recovery_pr_number != nil {
    "orphaned fold: PR #${evidence.recovery_pr_number} ${pr_url}"
      + if ref == "" {
      ""
    } else {
      " (head `${ref}`)"
    }
  } else if ref != "" {
    "orphaned fold branch: `${ref}`"
  } else {
    "no matching fold PR or branch was found"
  }
  return {
    proceed: false,
    reason: join(mismatches, "; "),
    detail: "latest published tag ${evidence.latest_tag} is not folded into ${evidence.base_ref}: "
      + join(
      mismatches,
      "; ",
    )
      + ". ${recovery}. Recreate the fold from ${evidence.latest_tag} on fresh origin base, merge it, then rerun the release.",
  }
}

pub fn prior_release_fold_recovery_allowed(
  evidence: PriorReleaseFoldEvidence,
  bump: "patch" | "minor" | "major",
  mode: "audit" | "prepare" | "ship-pr" = "ship-pr",
) -> bool {
  if mode != "ship-pr" || trim(evidence.recovery_ref) == "" {
    return false
  }
  const current = trim(evidence.workspace_version)
  if !regex_match("^[0-9]+\\.[0-9]+\\.[0-9]+$", current) {
    return false
  }
  return next(current, bump) == version_from_tag(evidence.latest_tag)
}

fn release_fold_pr(
  pull_requests: list<ReleaseGithubPullRequest>,
  tag: string,
) -> ReleaseGithubPullRequest? {
  const release_title = "Release ${tag}"
  for prefer_open in [true, false] {
    for pr in pull_requests {
      const head = pr.head.ref
      const matches = pr.title == release_title || head == "release/${tag}"
        || starts_with(
        head,
        "release-attempt/${tag}/",
      )
        || starts_with(head, "release-fold/${tag}")
      if matches && pr.github_state == "open" == prefer_open {
        return pr
      }
    }
  }
  return nil
}

fn release_fold_remote_refs(
  harness: HarnessProcess,
  cfg: PriorReleaseFoldConfig,
  tag: string,
) -> list<string> {
  const refs = release_git_remote_refs(
    harness,
    cfg,
    [
      "refs/heads/release/${tag}",
      "refs/heads/release-attempt/${tag}/*",
      "refs/heads/release-fold/${tag}*",
    ],
  )
  if !refs.success {
    throw "could not inspect remote release-fold branches: ${trim(refs.stderr)}"
  }
  return refs.refs.map({ ref -> regex_replace("^refs/heads/", "", ref.name) }).to_list()
}

pub fn release_fold_pr_probe_filters(
  base: string,
  remote_refs: list<string>,
) -> list<ReleaseGithubPrFilters> {
  let filters: list<ReleaseGithubPrFilters> = []
  for ref in remote_refs {
    filters = filters + [{base: base, head: ref, state: "open", limit: 1}]
  }
  for ref in remote_refs {
    filters = filters + [{base: base, head: ref, state: "all", limit: 1}]
  }
  return filters
}

pub fn release_prior_fold_preflight(
  harness: Harness,
  cfg: PriorReleaseFoldConfig,
  run_id: string,
) -> nil {
  if cfg.mock || cfg.mode == "audit" || !cfg.yes_live_release {
    return
  }
  const fetched = run_git(
    {env: harness.env, process: harness.process},
    cfg,
    base_ref_fetch_args(cfg.base),
  )
  if !fetched.success {
    throw "failed to refresh origin/${cfg.base} for prior-release fold preflight: ${trim(fetched.stderr)}"
  }
  const latest_tag = latest_release_tag(harness.process, cfg)
  const cargo = run_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["show", "origin/${cfg.base}:Cargo.toml"],
  )
  const changelog = run_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["show", "origin/${cfg.base}:CHANGELOG.md"],
  )
  if !cargo.success || !changelog.success {
    throw "could not read Cargo.toml and CHANGELOG.md from refreshed origin/${cfg.base}; refusing to start a release"
  }
  const base_ref = "origin/${cfg.base}"
  const base = prior_release_fold_base_evidence(
    base_ref,
    latest_tag,
    cargo.stdout,
    changelog.stdout,
  )
  const preliminary = prior_release_fold_decision(base)
  let recovery_ref = ""
  let recovery_pr_number: int? = nil
  let recovery_pr_url = ""
  if !preliminary.proceed {
    const remote_refs = release_fold_remote_refs(harness.process, cfg, latest_tag)
    let pr: ReleaseGithubPullRequest? = nil
    for filters in release_fold_pr_probe_filters(cfg.base, remote_refs) {
      if pr == nil {
        pr = release_fold_pr(release_github_pr_list(harness, cfg, filters), latest_tag)
      }
    }
    recovery_ref = if pr != nil {
      pr.head.ref
    } else if len(remote_refs) > 0 {
      remote_refs[0] ?? ""
    } else {
      ""
    }
    recovery_pr_number = pr?.number
    recovery_pr_url = pr?.url ?? ""
  }
  const evidence: PriorReleaseFoldEvidence = {
    base_ref: base.base_ref,
    latest_tag: base.latest_tag,
    workspace_version: base.workspace_version,
    changelog_version: base.changelog_version,
    recovery_ref: recovery_ref,
    recovery_pr_number: recovery_pr_number,
    recovery_pr_url: recovery_pr_url,
  }
  const decision = prior_release_fold_decision(evidence)
  const recovery_allowed = prior_release_fold_recovery_allowed(
    evidence,
    cfg.bump ?? "patch",
    cfg.mode,
  )
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "prior_release_fold_preflight",
    {
      proceed: decision.proceed || recovery_allowed,
      recovery_allowed: recovery_allowed,
      latest_tag: evidence.latest_tag,
      workspace_version: evidence.workspace_version,
      changelog_version: evidence.changelog_version,
      recovery_ref: evidence.recovery_ref,
      recovery_pr_url: evidence.recovery_pr_url,
      reason: decision.reason,
    },
  )
  if !decision.proceed && !recovery_allowed {
    throw decision.detail
  }
  if recovery_allowed {
    harness.stdio.println(
      "   ↻ prior release fold: recovering ${evidence.latest_tag} from `${evidence.recovery_ref}` before any newer release",
    )
  } else {
    harness.stdio.println(
      "   ✓ prior release fold: ${evidence.latest_tag} is recorded on origin/${cfg.base}",
    )
  }
}

/**
 * F2/F3: heal the known-safe preflight blockers deterministically before a live
 * mutating run — a stale `release/vX.Y.Z` local branch with no open PR and no
 * unique un-pushed commits, and a base branch behind origin with a clean tree.
 * Anything not known-safe (open PR, unique work, dirty tree) fails loud instead
 * of destroying anything. Fixup and pre-tag resume own their own branch
 * handling.
 */
pub fn release_preflight_autoremediate(
  harness: Harness,
  cfg: dict,
  analysis: dict,
  run_id: string,
  crashed_reclaim: bool = false,
) -> nil {
  if cfg.mock ?? false {
    return
  }
  if cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return
  }
  if cfg.fixup_mode ?? false {
    return
  }
  if cfg.pre_tag_resume ?? false {
    return
  }
  const git = { args -> run_git({env: harness.env, process: harness.process}, cfg, args) }
  const base_result = preflight_remediate_base_behind(
    git,
    {base: cfg.base, preserve_checkout: trim(cfg.pin_sha_input ?? "") != ""},
  )
  release_preflight_report(harness, run_id, "base-behind", base_result)
  const version = trim(analysis.next_version ?? "")
  if version != "" {
    const open_pr_count = { branch -> release_open_pr_count(harness, cfg, branch) }
    const branch_result = preflight_remediate_stale_release_branch(
      git,
      open_pr_count,
      {
        version: "v${version}",
        base: cfg.base,
        crashed_reclaim: crashed_reclaim,
        resume_current_dirty: true,
      },
      { workspace, branch ->
        return failed_release_workspace_authorization(harness.fs, workspace, branch)
      },
    )
    release_preflight_report(harness, run_id, "stale-release-branch", branch_result)
  }
}

fn release_preflight_report(harness: Harness, run_id, label, result) {
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "preflight_autoremediate",
    {
      case: label,
      action: result.action,
      safe: result.safe ?? false,
      reason: result.reason,
      remediated: result.remediated ?? false,
      discarded: result.discarded,
    },
  )
  if result.action == "fail" {
    harness.stdio.println("   ✗ preflight (${label}): ${result.reason}")
    throw "preflight remediation refused (${label}): ${result.reason}"
  }
  const discarded = result.discarded
  if discarded?.preserved_workspace != nil {
    harness.stdio.println(
      "   ↻ preflight (${label}): detached ${discarded.branch} from failed run ${discarded.recovery_run_id}; preserved ${to_string(discarded.dirty_file_count)} dirty file(s) byte-for-byte at ${discarded.preserved_workspace}",
    )
  } else if discarded != nil {
    harness.stdio.println(
      "   ↻ preflight (${label}): preserved crashed branch ${discarded.branch} at ${discarded.head_sha} (${to_string(discarded.dirty_file_count)} dirty file(s)) in recovery stash ${discarded.recovery_stash ?? "refs/stash"}",
    )
  } else if result.remediated ?? false {
    harness.stdio.println("   ↻ preflight (${label}): ${result.reason}")
  }
}

pub fn release_build_lease_options(cfg: dict, run_id: string) -> HostLeaseOptions {
  return {
    owner: "release-harn.${run_id}",
    resource_class: "rust-heavy",
    domain: trim(cfg.build_lease_domain ?? "release-build"),
    priority_class: "interactive",
    wait_timeout_ms: if cfg.wait_build_lock ?? false {
      20 * 60 * 1000
    } else {
      0
    },
    reason: "serialize release build work",
    metadata: {mode: cfg.mode ?? ""},
  }
}

/** Run the build-heavy release phase under one cancellation-safe host lease. */
pub fn release_with_build_lease<T>(
  harness: Harness,
  cfg: dict,
  run_id: string,
  body: fn() -> T,
) -> T {
  if (cfg.mock ?? false)
    || !(cfg.mode == "prepare" || cfg.mode == "ship-pr")
    || !(cfg.yes_live_release ?? false) {
    return body()
  }
  const result = with_host_lease(
    harness.host_lease,
    harness.clock,
    release_build_lease_options(cfg, run_id),
    { handle ->
      release_log_event(
        {clock: harness.clock, fs: harness.fs},
        run_id,
        "build_lease_acquired",
        {lease_id: handle.lease_id, domain: handle.domain, recovered: false},
      )
      harness.stdio.println("   ✓ build lease: ${handle.domain}")
      return {value: body()}
    },
  )
  if result.status == "deferred" {
    const active = result.acquire.defer?.active
    const owner = active?.owner ?? "another process"
    throw "release build lease is held by ${owner}; rerun with --wait to queue behind it"
  }
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "build_lease_released",
    {
      lease_id: result.acquire.handle?.lease_id ?? "",
      domain: result.acquire.handle?.domain ?? "release-build",
    },
  )
  const completed = result.value
  if completed == nil {
    throw "release build lease completed without a callback receipt"
  }
  return completed.value
}

fn release_planner_preflight_required(cfg) {
  return cfg.agent && cfg.mode != "audit" && (cfg.yes_live_release ?? false) && !(cfg.mock ?? false)
}

/**
 * Actionable remediation for a planner that has no usable provider. Harn reads
 * provider keys from the environment and does not auto-load `.env`, so the most
 * common cause is an unsourced credential; point at the documented seam
 * (`scripts/with_env.sh`) and its discovery order rather than leaving the
 * operator to rediscover it after a failed launch.
 */
pub fn planner_credential_remediation() -> string {
  return "Provider credentials are read from the environment (Harn does not auto-load .env).\n"
    + "Source them with scripts/with_env.sh, e.g.:\n"
    + "  scripts/with_env.sh harn run --no-sandbox release_harn.harn -- --mode ship-pr --agent --yes-live-release\n"
    + "Discovery order (later overrides earlier): $HARN_EXT_BUMP_FLEET_ENV_FILE "
    + "(default ~/projects/burin-code/.env), $HARN_EXT_BUMP_FLEET_ENV_FILES, ./.env, ./.env.local."
}

fn release_planner_preflight_error(decision) {
  let lines = ["release planner preflight found no healthy provider before mutation"]
  for attempt in decision?.attempts ?? [] {
    const detail = trim(attempt.message ?? "")
    const suffix = if detail == "" {
      ""
    } else {
      ": " + detail
    }
    lines = lines
      + [
      "- ${attempt.provider}/${attempt.model}: ${attempt.classification} (${attempt.health_status})${suffix}",
    ]
  }
  lines = lines + ["", planner_credential_remediation()]
  return lines.join("\n")
}

pub fn preflight_release_planner(
  harness: Harness,
  cfg: ReleaseConfig,
  run_id: string,
) -> ReleaseConfig {
  if !release_planner_preflight_required(cfg) {
    return cfg
  }
  harness.stdio.println("== planner preflight ...")
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "planner_preflight_started",
    {provider: cfg.provider, model: cfg.model, source: cfg.planner_source ?? ""},
  )
  const decision = run_planner_preflight(
    harness,
    {provider: cfg.provider, model: cfg.model, source: cfg.planner_source ?? "requested"},
  )
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "planner_preflight_finished",
    decision,
  )
  harness.stdio.println("   ${planner_preflight_audit_line(decision)}")
  for attempt in decision.attempts ?? [] {
    if attempt.valid {
      harness.stdio.println("   ✓ ${attempt.provider}/${attempt.model}")
    } else {
      harness.stdio.println(
        "   ✗ ${attempt.provider}/${attempt.model}: ${attempt.classification} (${attempt.health_status})",
      )
    }
  }
  if !(decision.healthy ?? false) {
    throw release_planner_preflight_error(decision)
  }
  if decision.disable_binder ?? false {
    harness.stdio.println("   ↳ binder disabled: its provider failed planner preflight")
  }
  const selected = decision.selected
  let out = cfg
  out["provider"] = selected.provider
  out["model"] = selected.model
  out["planner_preflight"] = decision
  return out
}
