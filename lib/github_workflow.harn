import "std/schema"

pub type GithubWorkflowScalar = string | bool | int | float | nil

pub type GithubWorkflowStep = {
  name: string?,
  uses: string?,
  run: string?,
  with: dict<GithubWorkflowScalar>?,
  env: dict<GithubWorkflowScalar>?,
}

pub type GithubWorkflowJob = {
  name: string?,
  if: string?,
  uses: string?,
  with: dict<GithubWorkflowScalar>?,
  secrets: string | dict<string> | nil,
  needs?: string | list<string>,
  steps: list<GithubWorkflowStep>?,
}

pub type GithubWorkflowDispatchInput = {
  description: string?,
  required: bool?,
  default: GithubWorkflowScalar?,
  type: string?,
}

pub type GithubWorkflowDispatch = {inputs: dict<GithubWorkflowDispatchInput>?}

pub type GithubWorkflowProjection = {
  triggers: list<string>,
  workflow_dispatch: GithubWorkflowDispatch?,
  jobs: dict<GithubWorkflowJob>,
}

pub type GithubWorkflowDecodeFailure = {code: "invalid_workflow_projection", detail: string}

pub type NamedGithubWorkflowJob = {key: string, value: GithubWorkflowJob}

fn workflow_dispatch_schema() {
  const scalar = schema_union(
    [schema_string(), schema_bool(), schema_int(), schema_float(), schema_literal(nil)],
  )
  const input = schema_object(
    {
      description: schema_field(schema_string(), false),
      required: schema_field(schema_bool(), false),
      default: schema_field(scalar, false),
      type: schema_field(schema_string(), false),
    },
    {additional_properties: true},
  )
  return schema_object(
    {inputs: schema_field(schema_dict(input), false)},
    {additional_properties: true},
  )
}

fn github_workflow_schema() {
  const scalar = schema_union(
    [schema_string(), schema_bool(), schema_int(), schema_float(), schema_literal(nil)],
  )
  const step = schema_object(
    {
      name: schema_field(schema_string(), false),
      with: schema_field(schema_dict(scalar), false),
      env: schema_field(schema_dict(scalar), false),
      uses: schema_field(schema_string(), false),
      run: schema_field(schema_string(), false),
    },
    {additional_properties: true},
  )
  const job = schema_object(
    {
      name: schema_field(schema_string(), false),
      if: schema_field(schema_string(), false),
      uses: schema_field(schema_string(), false),
      with: schema_field(schema_dict(scalar), false),
      secrets: schema_field(schema_union([schema_string(), schema_dict(schema_string())]), false),
      needs: schema_field(schema_union([schema_string(), schema_list(schema_string())]), false),
      steps: schema_field(schema_list(step), false),
    },
    {additional_properties: true},
  )
  const triggers = schema_union(
    [schema_string(), schema_list(schema_string()), schema_dict(schema_nullable(schema_any()))],
  )
  return schema_object(
    {on: schema_field(triggers), jobs: schema_field(schema_dict(job))},
    {additional_properties: true},
  )
}

fn normalize_triggers(raw) -> list<string> {
  if type_of(raw) == "string" {
    return [raw]
  }
  if type_of(raw) == "list" {
    return raw
  }
  return raw.keys()
}

fn decode_workflow_dispatch(raw_on, triggers: list<string>) -> GithubWorkflowDispatch? {
  if !contains(triggers, "workflow_dispatch") {
    return nil
  }
  if type_of(raw_on) != "dict" || raw_on.get("workflow_dispatch") == nil {
    const empty: GithubWorkflowDispatch = {inputs: nil}
    return empty
  }
  return unwrap(schema_check(raw_on.get("workflow_dispatch"), workflow_dispatch_schema()))
}

fn decode_github_workflow_unchecked(source: string) -> GithubWorkflowProjection {
  const document = unwrap(schema_check(yaml_parse(source), github_workflow_schema()))
  const raw_on = document.get("on")
  const triggers = normalize_triggers(raw_on)
  return {
    triggers: triggers,
    workflow_dispatch: decode_workflow_dispatch(raw_on, triggers),
    jobs: document.jobs,
  }
}

/** Decode and normalize the GitHub workflow fields owned by fleet orchestration. */
pub fn decode_github_workflow(source: string) -> GithubWorkflowProjection {
  try {
    return decode_github_workflow_unchecked(source)
  } catch (error) {
    const failure: GithubWorkflowDecodeFailure = {
      code: "invalid_workflow_projection",
      detail: to_string(error),
    }
    throw failure
  }
}

pub fn github_projection_has_trigger(workflow: GithubWorkflowProjection, trigger: string) -> bool {
  return contains(workflow.triggers, trigger)
}

pub fn github_workflow_dispatch_input(
  workflow: GithubWorkflowProjection,
  input: string,
) -> GithubWorkflowDispatchInput? {
  return workflow.workflow_dispatch?.inputs?.get(input)
}

/** GitHub defaults an omitted workflow-dispatch input type to string. */
pub fn github_workflow_dispatch_input_is_string(
  workflow: GithubWorkflowProjection,
  input: string,
) -> bool {
  const declared = github_workflow_dispatch_input(workflow, input)
  return declared != nil && (declared.type ?? "string") == "string"
}

pub fn github_reusable_jobs(
  workflow: GithubWorkflowProjection,
  expected: string,
) -> list<NamedGithubWorkflowJob> {
  let matches: list<NamedGithubWorkflowJob> = []
  for job in workflow.jobs {
    if job.value.uses == expected {
      matches = matches + [{key: job.key, value: job.value}]
    }
  }
  return matches
}

/** The `owner/repo/path` half of a `uses:` reference, without its `@ref`. */
pub fn github_reusable_path(reference: string) -> string {
  const parts = split(trim(reference), "@")
  return trim(parts[0] ?? "")
}

/**
 * Jobs naming the same reusable workflow as `expected`, whatever ref they pin.
 *
 * `github_reusable_jobs` answers whether a repository is already at the
 * canonical pin. This answers which job carries the pin, which is what a
 * projection has to know before it can move one.
 */
pub fn github_reusable_jobs_at_any_ref(
  workflow: GithubWorkflowProjection,
  expected: string,
) -> list<NamedGithubWorkflowJob> {
  const path = github_reusable_path(expected)
  let matches: list<NamedGithubWorkflowJob> = []
  for job in workflow.jobs {
    if github_reusable_path(job.value.uses ?? "") == path {
      matches = matches + [{key: job.key, value: job.value}]
    }
  }
  return matches
}
