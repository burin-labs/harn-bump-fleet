import { render_bump_workflow } from "./bump_workflow_projection"
import {
  FleetManifest,
  FleetRepository,
  parse_workflow_policy_reference,
  validate_fleet_manifest,
} from "./fleet_manifest"
import { BUMP_ADAPTER_PATH, FleetProjectionTarget } from "./fleet_projection_targets"

pub const HARN_BUMP_WORKFLOW_SLUG: string = "burin-labs/harn"

pub const HARN_BUMP_WORKFLOW_PATH: string = ".github/workflows/bump-harn.yml"

/** Validate the released Harn commit and return its immutable workflow reference. */
pub fn released_bump_workflow_reference(commit_oid: string) -> string {
  if regex_match("^[0-9a-f]{40}$", commit_oid) == nil {
    throw "released Harn workflow commit must be an immutable 40-character lowercase SHA"
  }
  return HARN_BUMP_WORKFLOW_SLUG + "/" + HARN_BUMP_WORKFLOW_PATH + "@" + commit_oid
}

/** Promote only the typed bump-workflow policy field in a decoded manifest. */
pub fn promote_bump_workflow_manifest(
  manifest: FleetManifest,
  commit_oid: string,
) -> FleetManifest {
  const current = parse_workflow_policy_reference(manifest.policy.bump_workflow)
  if current.slug != HARN_BUMP_WORKFLOW_SLUG || current.path != HARN_BUMP_WORKFLOW_PATH {
    throw "fleet bump workflow is not owned by ${HARN_BUMP_WORKFLOW_SLUG}/${HARN_BUMP_WORKFLOW_PATH}"
  }
  const promoted: FleetManifest = {
    schema_version: 1,
    fleet: manifest.fleet,
    policy: {
      package_workflow: manifest.policy.package_workflow,
      bump_workflow: released_bump_workflow_reference(commit_oid),
    },
    file_projections: manifest.file_projections,
    repositories: manifest.repositories,
  }
  return validate_fleet_manifest(promoted)
}

/** Rewrite the manifest source while proving there is exactly one owned field. */
pub fn promote_bump_workflow_manifest_text(
  source: string,
  manifest: FleetManifest,
  commit_oid: string,
) -> string {
  const before = "bump_workflow = \"${manifest.policy.bump_workflow}\""
  const parts = split(source, before)
  if len(parts) != 2 {
    throw "fleet.toml must contain exactly one canonical bump_workflow policy assignment"
  }
  const after = "bump_workflow = \"${released_bump_workflow_reference(commit_oid)}\""
  return parts[0] + after + parts[1]
}

fn fleet_repository(manifest: FleetManifest) -> FleetRepository {
  const matches = manifest.repositories.filter(
    { repo -> repo.slug == "burin-labs/harn-bump-fleet" },
  )
    .to_list()
  if len(matches) != 1 {
    throw "fleet manifest must declare exactly one burin-labs/harn-bump-fleet repository"
  }
  return matches[0]
}

/** The two files that must land before any consumer is dispatched. */
pub fn bump_workflow_promotion_targets(
  manifest: FleetManifest,
  manifest_text: string,
) -> list<FleetProjectionTarget> {
  const repo = fleet_repository(manifest)
  return [
    {
      slug: repo.slug,
      path: "fleet.toml",
      expected: manifest_text,
      origin: "released Harn commit promotion",
    },
    {
      slug: repo.slug,
      path: BUMP_ADAPTER_PATH,
      expected: render_bump_workflow(manifest, repo),
      origin: "promoted fleet.toml bump adapter projection",
    },
  ]
}
