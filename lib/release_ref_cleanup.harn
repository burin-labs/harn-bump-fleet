import { read_json_result, write_json } from "std/fs"
import { GitRemoteRef } from "std/git"
import { git_push_ref_plumbing } from "./git"
import { github_file_text_at_ref } from "./github"
import { retry_release_git_remote_observation } from "./release_git_remote_retry"
import { release_git_remote_refs } from "./release_runtime"
import { release_failure_evidence } from "./release_step_output"
import { ReleaseWatchReceipt } from "./release_watch_state"

pub type ReleaseRefCleanupState = "pending" | "deleted" | "absent" | "mismatch" | "failed"

pub type ReleaseRefCleanupEntry = {
  ref: string,
  expected_oid: string,
  observed_oid: string,
  state: ReleaseRefCleanupState,
  message: string,
  error_category?: string,
}

pub type ReleaseRefCleanupReceipt = {
  schema_version: "release_harn.ref_cleanup.v1",
  tag: string,
  watch_receipt_path: string,
  terminal_proof_at: string,
  state: "pending" | "completed" | "blocked",
  message: string,
  refs: list<ReleaseRefCleanupEntry>,
  updated_at: string,
  error_category?: string,
}

pub type ReleaseRefCleanupAdapter = {
  now: fn() -> string,
  remote_refs: fn(string, list<string>) -> list<GitRemoteRef>,
  version_at_ref: fn(string, string) -> string?,
  delete_ref: fn(string, string, string) -> dict,
}

pub type ReleaseRefDeletionEvidence = {
  expected_oid: string,
  observed_oid: string,
  tag_target_oid: string,
  signed_tag: bool,
  hosted_terminal: bool,
  /**
   * A registered withdrawal binding this exact tag commit. Terminal in its own
   * right: a release withdrawn on purpose never becomes hosted-terminal, so
   * without this its transient refs are pinned forever and every later
   * withdrawal adds more (#701).
   */
  withdrawn: bool,
}

pub type ReleaseRefDeletionDecision = {delete: bool, reason_code: string, message: string}

pub type ReleaseCurrentRefCleanupEvidence = {
  expected_oid: string,
  observed_oid: string,
  release_commit_oid: string,
  hosted_terminal: bool,
}

/** One policy owner for exact release-ref deletion across local and historical cleanup. */
pub fn release_ref_deletion_decision(
  evidence: ReleaseRefDeletionEvidence,
) -> ReleaseRefDeletionDecision {
  const expected = lowercase(trim(evidence.expected_oid))
  const observed = lowercase(trim(evidence.observed_oid))
  const tag_target = lowercase(trim(evidence.tag_target_oid))
  if len(regex_captures("^[0-9a-f]{40}$", expected)) != 1 {
    return {
      delete: false,
      reason_code: "invalid_identity",
      message: "release ref does not carry a full content-addressed OID",
    }
  }
  if observed != expected {
    return {
      delete: false,
      reason_code: "moved_ref",
      message: "ref target ${observed} does not match content-addressed OID ${expected}",
    }
  }
  if !evidence.signed_tag {
    return {
      delete: false,
      reason_code: "signed_tag_unproven",
      message: "no verified signed release tag recovers exact OID ${expected}",
    }
  }
  if tag_target != expected {
    return {
      delete: false,
      reason_code: "tag_target_mismatch",
      message: "verified release tag targets ${tag_target}, not exact ref OID ${expected}",
    }
  }
  // An in-flight release and a withdrawn one are different states, and both are
  // distinct from a completed one. Refusing to delete refs for something that
  // might still finish is exactly what this gate is for, so a withdrawal is
  // admitted as its own terminal proof rather than by relaxing hosted_terminal.
  if !evidence.hosted_terminal && !evidence.withdrawn {
    return {
      delete: false,
      reason_code: "hosted_release_nonterminal",
      message: "hosted release proof is not terminal for exact OID ${expected}",
    }
  }
  // Reported separately from a completed release so a receipt never claims a
  // withdrawn release finished. The exactness above still holds: the signed tag
  // must target this OID, and the registry binds the withdrawal to that commit.
  if !evidence.hosted_terminal {
    return {
      delete: true,
      reason_code: "withdrawn_release_terminal",
      message: "exact ref OID is recoverable from a signed tag and a registered release withdrawal",
    }
  }
  return {
    delete: true,
    reason_code: "tag_backed_terminal_release",
    message: "exact ref OID is recoverable from a signed tag and terminal hosted release",
  }
}

/**
 * Decide whether the current release may discard one exact transient ref.
 *
 * This is deliberately a different authority from the historical sweep
 * above. A lockless release certifies candidate C, merges proved main drift,
 * and publishes merged commit R. Its signed tag recovers R, not C, so tag
 * recovery can never honestly authorize deleting C. The durable watch receipt
 * does: once it is terminal and bound to exact merged commit R, the candidate
 * and certification refs are no longer needed for recovery. The ref name and
 * remote observation still lease the exact transient OID being deleted.
 */
pub fn release_current_ref_cleanup_decision(
  evidence: ReleaseCurrentRefCleanupEvidence,
) -> ReleaseRefDeletionDecision {
  const expected = lowercase(trim(evidence.expected_oid))
  const observed = lowercase(trim(evidence.observed_oid))
  const release_commit = lowercase(trim(evidence.release_commit_oid))
  if len(regex_captures("^[0-9a-f]{40}$", expected)) != 1 {
    return {
      delete: false,
      reason_code: "invalid_identity",
      message: "release ref does not carry a full content-addressed OID",
    }
  }
  if observed != expected {
    return {
      delete: false,
      reason_code: "moved_ref",
      message: "ref target ${observed} does not match content-addressed OID ${expected}",
    }
  }
  if len(regex_captures("^[0-9a-f]{40}$", release_commit)) != 1 {
    return {
      delete: false,
      reason_code: "release_commit_unbound",
      message: "terminal watch receipt is not bound to an exact merged-main release commit",
    }
  }
  if !evidence.hosted_terminal {
    return {
      delete: false,
      reason_code: "hosted_release_nonterminal",
      message: "hosted release proof is not terminal for merged commit ${release_commit}",
    }
  }
  return {
    delete: true,
    reason_code: "terminal_release_receipt",
    message:
      "exact transient ref is disposable under the terminal release receipt bound to merged commit ${release_commit}",
  }
}

/** Delete one exact remote ref through Harn's structured lease enforcement. */
pub fn delete_remote_ref_with_lease(
  process: HarnessProcess,
  repo: string,
  ref: string,
  expected_oid: string,
) -> dict {
  // A deletion is the one plumbing shape a pre-push hook can recognize unaided
  // — git marks it `(delete)` on the hook's stdin — but recognizing it is not
  // the same as being able to judge it, and the hook still fails the push for
  // the checkout's own branch state. Both halves travel as of Harn v0.10.55.
  const deleted = git_push_ref_plumbing(
    process,
    "origin",
    ":${ref}",
    repo,
    {ref: ref, expected_oid: expected_oid},
  )
  const output = if deleted.success || trim(deleted.stderr.inline) == "" {
    deleted.stdout.inline
  } else {
    deleted.stderr.inline
  }
  return {
    success: deleted.success,
    status: deleted.status,
    observed_oid: lowercase(
      trim(
        deleted.data?.actual_oid
          ?? if deleted.success {
            expected_oid
          } else {
            ""
          },
      ),
    ),
    message: trim(output),
  }
}

fn cleanup_receipt_path(watch_receipt_path: string) -> string {
  return watch_receipt_path + ".ref-cleanup.json"
}

fn workspace_version(cargo_toml: string) -> string? {
  const captures = regex_captures(
    "(?s)\\[workspace[.]package\\].*?version[[:space:]]*=[[:space:]]*\"([0-9]+[.][0-9]+[.][0-9]+)\"",
    cargo_toml,
  )
  if len(captures) == 0 {
    return nil
  }
  return captures[0].groups[0]
}

fn default_adapter(harness: Harness) -> ReleaseRefCleanupAdapter {
  return {
    now: fn() { return harness.clock.date_iso() },
    remote_refs: fn(repo, refs) {
      const observed = retry_release_git_remote_observation(
        harness.clock,
        fn() { return release_git_remote_refs(harness.process, {repo: repo, mock: false}, refs) },
      )
      if !observed.success {
        throw {
          category: if (observed.transient_retries ?? 0) > 0 {
            "transient_network_exhausted"
          } else {
            "git_remote_observation"
          },
          message: "could not inspect transient release refs after ${observed.attempts ?? 1} attempt(s): "
            + trim(observed.stderr),
        }
      }
      return observed.refs
    },
    version_at_ref: fn(slug, ref) {
      const cargo_toml = github_file_text_at_ref(harness, slug, "Cargo.toml", ref)
      if cargo_toml == nil {
        return nil
      }
      return workspace_version(cargo_toml)
    },
    delete_ref: fn(repo, ref, expected_oid) { return delete_remote_ref_with_lease(
      harness.process,
      repo,
      ref,
      expected_oid,
    ) },
  }
}

fn entry(
  ref: string,
  expected_oid: string,
  observed_oid: string,
  release_commit_oid: string,
  hosted_terminal: bool,
) -> ReleaseRefCleanupEntry {
  const decision = release_current_ref_cleanup_decision(
    {
      expected_oid: expected_oid,
      observed_oid: observed_oid,
      release_commit_oid: release_commit_oid,
      hosted_terminal: hosted_terminal,
    },
  )
  return {
    ref: ref,
    expected_oid: expected_oid,
    observed_oid: observed_oid,
    state: if decision.delete {
      "pending"
    } else {
      "mismatch"
    },
    message: if decision.delete {
      "exact transient ref is pending cleanup"
    } else {
      decision.message
    },
  }
}

fn expected_oid_from_ref(ref: string, prefix: string) -> string? {
  if !starts_with(ref, prefix) {
    return nil
  }
  const oid = lowercase(trim(ref.substring(len(prefix))))
  if len(regex_captures("^[0-9a-f]{40}$", oid)) == 0 {
    return nil
  }
  return oid
}

/** Discover only content-addressed refs proven to belong to the released version. */
pub fn release_ref_cleanup_candidates(
  receipt: ReleaseWatchReceipt,
  refs: list<GitRemoteRef>,
  version_at_ref: fn(string, string) -> string?,
) -> list<ReleaseRefCleanupEntry> {
  const version = receipt.publication.version
  const attempt_prefix = "refs/heads/release-attempt/v${version}/"
  const certify_prefix = "refs/heads/release-certify/"
  let candidates: list<ReleaseRefCleanupEntry> = []
  for remote in refs {
    const ref = trim(remote.ref)
    const observed_oid = lowercase(trim(remote.oid))
    const attempt_oid = expected_oid_from_ref(ref, attempt_prefix)
    if attempt_oid != nil {
      candidates = candidates
        + [
          entry(
            ref,
            attempt_oid,
            observed_oid,
            receipt.release_commit_oid,
            receipt.state == "healthy",
          ),
        ]
      continue
    }
    const certify_oid = expected_oid_from_ref(ref, certify_prefix)
    if certify_oid == nil {
      continue
    }
    const short_ref = ref.substring(len("refs/heads/"))
    if version_at_ref(receipt.slug, short_ref) == version {
      candidates = candidates
        + [
          entry(
            ref,
            certify_oid,
            observed_oid,
            receipt.release_commit_oid,
            receipt.state == "healthy",
          ),
        ]
    }
  }
  return candidates.sort_by({ candidate -> candidate.ref })
}

fn parse_prior_receipt(fs: HarnessFs, path: string, tag: string) -> ReleaseRefCleanupReceipt? {
  const loaded = read_json_result(fs, path)
  if !is_ok(loaded) {
    return nil
  }
  const value = unwrap(loaded)
  if value?.schema_version != "release_harn.ref_cleanup.v1" || value?.tag != tag {
    throw "invalid release ref cleanup receipt: " + path
  }
  return value
}

fn merge_prior_targets(
  discovered: list<ReleaseRefCleanupEntry>,
  prior: ReleaseRefCleanupReceipt?,
) -> list<ReleaseRefCleanupEntry> {
  let merged = discovered
  for old in prior?.refs ?? [] {
    if !merged.any({ current -> current.ref == old.ref }) {
      merged = merged
        + [
          {
            ref: old.ref,
            expected_oid: old.expected_oid,
            observed_oid: "",
            state: "absent",
            message: "exact transient ref is already absent",
          },
        ]
    }
  }
  return merged.sort_by({ candidate -> candidate.ref })
}

fn cleanup_state(refs: list<ReleaseRefCleanupEntry>) -> "pending" | "completed" | "blocked" {
  if refs.any({ ref -> ref.state == "mismatch" || ref.state == "failed" }) {
    return "blocked"
  }
  if refs.any({ ref -> ref.state == "pending" }) {
    return "pending"
  }
  return "completed"
}

fn cleanup_message(state: "pending" | "completed" | "blocked") -> string {
  if state == "completed" {
    return "exact transient release refs are absent"
  }
  if state == "blocked" {
    return "one or more transient release refs could not be deleted safely"
  }
  return "exact transient release refs are pending cleanup"
}

fn write_cleanup_receipt(
  harness: {fs: HarnessFs, random: HarnessRandom},
  path: string,
  receipt: ReleaseRefCleanupReceipt,
) {
  const temporary = path + ".tmp-" + harness.random.uuid_v7()
  write_json(harness.fs, temporary, receipt, {pretty: true})
  harness.fs.rename(temporary, path)
}

fn cleanup_receipt_with_refs(
  receipt: ReleaseRefCleanupReceipt,
  refs: list<ReleaseRefCleanupEntry>,
  updated_at: string,
) -> ReleaseRefCleanupReceipt {
  const state = cleanup_state(refs)
  return {
    schema_version: "release_harn.ref_cleanup.v1",
    tag: receipt.tag,
    watch_receipt_path: receipt.watch_receipt_path,
    terminal_proof_at: receipt.terminal_proof_at,
    state: state,
    message: cleanup_message(state),
    refs: refs,
    updated_at: updated_at,
  }
}

/** Delete exact transient refs only after the watch receipt carries terminal hosted proof. */
fn run_release_ref_cleanup_inner(
  harness: Harness,
  receipt: ReleaseWatchReceipt,
  watch_receipt_path: string,
  repo: string,
  injected_adapter: ReleaseRefCleanupAdapter? = nil,
) -> ReleaseRefCleanupReceipt {
  const adapter = injected_adapter ?? default_adapter(harness)
  const path = cleanup_receipt_path(watch_receipt_path)
  const warm_terminal = receipt.warm_cache.state == "not_requested"
    || receipt.warm_cache.state
      == "completed"
  const release_commit_bound = len(
    regex_captures("^[0-9a-f]{40}$", lowercase(trim(receipt.release_commit_oid))),
  )
    == 1
  if receipt.state != "healthy" || !warm_terminal || !release_commit_bound {
    const blocked: ReleaseRefCleanupReceipt = {
      schema_version: "release_harn.ref_cleanup.v1",
      tag: receipt.tag,
      watch_receipt_path: watch_receipt_path,
      terminal_proof_at: "",
      state: "blocked",
      message: if !release_commit_bound {
        "transient release refs remain protected until the terminal watch receipt is bound to an exact merged-main release commit"
      } else {
        "transient release refs remain protected until hosted release proof is terminal"
      },
      refs: [],
      updated_at: adapter.now(),
    }
    write_cleanup_receipt({fs: harness.fs, random: harness.random}, path, blocked)
    return blocked
  }
  const prior = parse_prior_receipt(harness.fs, path, receipt.tag)
  const remote_refs = adapter.remote_refs(
    repo,
    ["refs/heads/release-attempt/${receipt.tag}/*", "refs/heads/release-certify/*"],
  )
  let refs = merge_prior_targets(
    release_ref_cleanup_candidates(receipt, remote_refs, adapter.version_at_ref),
    prior,
  )
  const now = adapter.now()
  const initial_state = cleanup_state(refs)
  let cleanup: ReleaseRefCleanupReceipt = {
    schema_version: "release_harn.ref_cleanup.v1",
    tag: receipt.tag,
    watch_receipt_path: watch_receipt_path,
    terminal_proof_at: if receipt.warm_cache.state == "completed" {
      receipt.warm_cache.finished_at
    } else {
      receipt.updated_at
    },
    state: initial_state,
    message: cleanup_message(initial_state),
    refs: refs,
    updated_at: now,
  }
  write_cleanup_receipt({fs: harness.fs, random: harness.random}, path, cleanup)
  for index in range(0, len(refs)) {
    const target = refs[index]
    if target.state != "pending" {
      continue
    }
    const deleted = try {
      adapter.delete_ref(repo, target.ref, target.expected_oid)
    } catch (error) {
      {
        success: false,
        status: "error",
        error_category: trim(to_string(error?.category ?? "cleanup_error")),
        message: to_string(error),
      }
    }
    refs[index] = {
      ...target,
      state: if deleted.success {
        "deleted"
      } else {
        "failed"
      },
      message: if trim(deleted.message ?? "") != "" {
        trim(deleted.message)
      } else if deleted.success {
        "deleted exact transient ref"
      } else {
        "exact transient ref deletion failed"
      },
      error_category: if deleted.success {
        nil
      } else {
        trim(to_string(deleted.error_category ?? deleted.status ?? "cleanup_error"))
      },
    }
    cleanup = cleanup_receipt_with_refs(cleanup, refs, adapter.now())
    write_cleanup_receipt({fs: harness.fs, random: harness.random}, path, cleanup)
  }
  return cleanup
}

/** Preserve terminal release authority when post-terminal cleanup cannot be observed safely. */
fn release_ref_cleanup_failure_receipt(
  harness: Harness,
  receipt: ReleaseWatchReceipt,
  watch_receipt_path: string,
  error: unknown,
) -> ReleaseRefCleanupReceipt {
  const path = cleanup_receipt_path(watch_receipt_path)
  const prior = try {
    parse_prior_receipt(harness.fs, path, receipt.tag)
  } catch (_error) {
    nil
  }
  const evidence = release_failure_evidence(error, "housekeeping_error")
  const blocked: ReleaseRefCleanupReceipt = {
    schema_version: "release_harn.ref_cleanup.v1",
    tag: receipt.tag,
    watch_receipt_path: watch_receipt_path,
    terminal_proof_at: if receipt.warm_cache.state == "completed" {
      receipt.warm_cache.finished_at
    } else {
      receipt.updated_at
    },
    state: "blocked",
    message: "terminal release proof remains authoritative; ref cleanup could not complete: "
      + evidence.detail,
    refs: prior?.refs ?? [],
    updated_at: harness.clock.date_iso(),
    error_category: evidence.category,
  }
  write_cleanup_receipt({fs: harness.fs, random: harness.random}, path, blocked)
  return blocked
}

/**
 * Delete exact transient refs after terminal proof. Cleanup failures are typed
 * blocked housekeeping, never a replacement verdict for the shipped release.
 */
pub fn run_release_ref_cleanup(
  harness: Harness,
  receipt: ReleaseWatchReceipt,
  watch_receipt_path: string,
  repo: string,
  injected_adapter: ReleaseRefCleanupAdapter? = nil,
) -> ReleaseRefCleanupReceipt {
  return try {
    run_release_ref_cleanup_inner(harness, receipt, watch_receipt_path, repo, injected_adapter)
  } catch (error) {
    release_ref_cleanup_failure_receipt(harness, receipt, watch_receipt_path, error)
  }
}

pub fn release_ref_cleanup_receipt_path(watch_receipt_path: string) -> string {
  return cleanup_receipt_path(watch_receipt_path)
}

/** Deterministic terminal-cleanup rehearsal for the watcher CLI. */
pub fn mock_release_ref_cleanup_adapter(receipt: ReleaseWatchReceipt) -> ReleaseRefCleanupAdapter {
  let refs = [
    {
      oid: receipt.publication.head_oid,
      ref: "refs/heads/${receipt.publication.remote_ref}",
      name: "refs/heads/${receipt.publication.remote_ref}",
      peeled: false,
    },
    {
      oid: receipt.publication.head_oid,
      ref: "refs/heads/release-certify/${receipt.publication.head_oid}",
      name: "refs/heads/release-certify/${receipt.publication.head_oid}",
      peeled: false,
    },
  ]
  return {
    now: fn() { return "2026-07-13T00:04:00Z" },
    remote_refs: fn(_repo, _patterns) { return refs },
    version_at_ref: fn(_slug, _ref) { return receipt.publication.version },
    delete_ref: fn(_repo, ref, _expected_oid) {
      refs = refs.filter({ candidate -> candidate.ref != ref }).to_list()
      return {success: true, message: "deleted mock exact transient ref"}
    },
  }
}
