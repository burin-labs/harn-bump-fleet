/**
 * Whether one release is genuinely published, read from the release's own
 * observable state — and what the post-publication tail may therefore do.
 *
 * The tail that follows a publication (promoting the shared orchestration
 * anchor, then dispatching downstream convergence) used to run only when the
 * publication *prover step* concluded green. That inverts the arm rule. A
 * prover that fails has not observed a missing release; it has failed to
 * confirm a release that may well be complete. When it failed, every tail step
 * was silently skipped while the release itself was fully published, and the
 * anchor has exactly one writer — so consumers stayed pinned to the previous
 * cycle's orchestration with nothing anywhere reporting that the write never
 * happened.
 *
 * This module owns the replacement question. Publication is proven by the
 * release's own state: the tag exists and carries a verified signature, the
 * release is finalized with the expected prerelease flag, every expected asset
 * is attached, and the released packages are visible. Never by a run's or a
 * step's conclusion. The tail keys on that proof, and a tail that does not run
 * says so loudly at the moment it is skipped rather than leaving a grey square
 * that is indistinguishable from an anchor which is merely trailing.
 *
 * Logic stays pure so both the gate before the tail and the verdict after it
 * can be exercised without a hosted run.
 */
pub const RELEASE_PUBLICATION_PROOF_SCHEMA = "harn.release-publication-proof.v1"

/** Everything observed about one release, independent of any run's conclusion. */
pub type ReleasePublicationEvidence = {
  tag: string,
  tag_present: bool,
  tag_signature_verified: bool,
  release_found: bool,
  release_draft: bool,
  release_prerelease: bool,
  expected_prerelease: bool,
  required_assets: list<string>,
  missing_assets: list<string>,
  packages_published: bool,
}

pub type ReleasePublicationProof = {
  schema_version: string,
  tag: string,
  published: bool,
  reasons: list<string>,
  detail: string,
}

/** What the post-publication tail is permitted to do, and whether to alarm. */
pub type PostPublicationAction = "promote" | "halt"

pub type PostPublicationFollowThrough = {
  action: PostPublicationAction,
  alarm: bool,
  reason: string,
  message: string,
}

/** Terminal verdict on whether the tail actually ran. */
pub type PostPublicationOutcome = {status: int, alarm: bool, headline: string, lines: list<string>}

fn normalized_outcome(value: string?) -> string {
  const outcome = lowercase(trim(value ?? ""))
  return if outcome == "" {
    "unknown"
  } else {
    outcome
  }
}

/**
 * Prove publication from the release's own observable state.
 *
 * Every unmet condition is named, because "not published" is an operator-facing
 * claim that has to say which part of the release is missing. A missing tag
 * suppresses the signature complaint: an absent tag cannot also be unsigned,
 * and reporting both would read as two independent defects.
 */
pub fn release_publication_proof(evidence: ReleasePublicationEvidence) -> ReleasePublicationProof {
  const tag = trim(evidence.tag ?? "")
  const named = if tag == "" {
    "the release"
  } else {
    tag
  }
  let reasons: list<string> = []
  if !(evidence.tag_present ?? false) {
    reasons = reasons + ["the release tag ${named} does not exist"]
  } else if !(evidence.tag_signature_verified ?? false) {
    reasons = reasons + ["the release tag ${named} does not carry a verified signature"]
  }
  if !(evidence.release_found ?? false) {
    reasons = reasons + ["no published release exists at ${named}"]
  } else {
    if evidence.release_draft ?? false {
      reasons = reasons + ["the release at ${named} is still a draft"]
    }
    const prerelease = evidence.release_prerelease ?? false
    const expected = evidence.expected_prerelease ?? false
    if prerelease != expected {
      reasons = reasons
        + [
          "the release at ${named} has prerelease "
            + to_string(prerelease)
            + " where the version expects "
            + to_string(expected),
        ]
    }
  }
  const missing = evidence.missing_assets ?? []
  if len(missing) > 0 {
    reasons = reasons
      + ["the release at ${named} is missing expected assets: " + join(missing, ", ")]
  }
  if !(evidence.packages_published ?? false) {
    reasons = reasons + ["the packages released at ${named} are not visible in the registry"]
  }
  const published = len(reasons) == 0
  const attached = len(evidence.required_assets ?? []) - len(missing)
  return {
    schema_version: RELEASE_PUBLICATION_PROOF_SCHEMA,
    tag: tag,
    published: published,
    reasons: reasons,
    detail: if published {
      "${named} is published: signed tag, finalized release, "
        + to_string(attached)
        + " expected asset(s) attached, packages visible in the registry"
    } else {
      "${named} is not proven published: " + join(reasons, "; ")
    },
  }
}

/**
 * Decide whether the post-publication tail runs.
 *
 * The prover's conclusion is reported but never decides. A proven release runs
 * its tail even when the prover went red, and alarms so the divergence stays
 * visible; an unproven release halts the tail and alarms, because a tail that
 * does not run is the state this whole module exists to make loud. A missing
 * proof is treated as unproven rather than as permission: a prover that crashed
 * and a proof that could not be produced are the same evidential nothing.
 */
pub fn post_publication_follow_through(
  proof: ReleasePublicationProof?,
  prover_outcome: string,
) -> PostPublicationFollowThrough {
  const prover = normalized_outcome(prover_outcome)
  if proof == nil {
    return {
      action: "halt",
      alarm: true,
      reason: "publication_unproven",
      message:
        "the release's published state could not be established (publication prover: ${prover}); the post-publication tail is halted and nothing was promoted",
    }
  }
  const tag = trim(proof.tag ?? "")
  const named = if tag == "" {
    "the release"
  } else {
    tag
  }
  if !(proof.published ?? false) {
    return {
      action: "halt",
      alarm: true,
      reason: "publication_not_proven",
      message: "${named} is not proven published, so the post-publication tail is halted: "
        + join(proof.reasons ?? [], "; "),
    }
  }
  if prover != "success" {
    return {
      action: "promote",
      alarm: true,
      reason: "publication_proven_prover_unconfirmed",
      message: "the publication prover concluded ${prover}, but ${named} is verified published from its own state, so the post-publication tail proceeds: "
        + (proof.detail ?? ""),
    }
  }
  return {
    action: "promote",
    alarm: false,
    reason: "publication_proven",
    message: "${named} is verified published; the post-publication tail proceeds",
  }
}

/**
 * Render the terminal verdict on the tail.
 *
 * A non-zero status is the point: a promotion that did not run has to fail
 * something at the moment it is skipped. The alternative discovery path is a
 * staleness reading two cycles later, where an anchor that was never written
 * and an anchor that is merely trailing look identical.
 */
pub fn post_publication_outcome(
  follow_through: PostPublicationFollowThrough,
  promotion_outcome: string,
) -> PostPublicationOutcome {
  const promotion = normalized_outcome(promotion_outcome)
  const promoted = promotion == "success"
  let lines: list<string> = [
    "follow-through decision: ${follow_through.action} (${follow_through.reason})",
    follow_through.message,
    "orchestration anchor promotion: ${promotion}",
  ]
  if !promoted {
    lines = lines
      + [
        "The orchestration anchor has exactly one writer. Until this promotion runs, every consumer stays pinned to the previous cycle's orchestration, and an anchor that was never written is indistinguishable from one that is merely trailing.",
      ]
  }
  return {
    status: if promoted {
      0
    } else {
      2
    },
    alarm: follow_through.alarm || !promoted,
    headline: if promoted {
      "post-publication follow-through completed"
    } else {
      "post-publication follow-through did NOT run (promotion ${promotion})"
    },
    lines: lines,
  }
}
