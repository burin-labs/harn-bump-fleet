import { FleetManifest, FleetRepository, package_status_action_reference } from "./fleet_manifest"
import {
  decode_github_workflow,
  github_reusable_jobs_at_any_ref,
  github_reusable_path,
} from "./github_workflow"
import {
  WorkflowProjectionSyncResult,
  append_workflow_string_input,
  sync_workflow_projection,
} from "./workflow_projection"

/** Render the exact thin CI adapter owned by the fleet manifest. */
pub fn render_package_ci(manifest: FleetManifest, repo: FleetRepository) -> string {
  if repo.package_ci_ownership != "fleet" {
    throw "repository '${repo.slug}' does not delegate package CI ownership to the fleet"
  }
  const expression = "$"
  let package_job = ["  harn:", "    uses: ${manifest.policy.package_workflow}"]
  if (repo.run_poll_tick ?? false)
    || (repo.test_jobs ?? 0)
      > 0
    || repo.package_validate_command
      != nil {
    package_job = package_job + ["    with:"]
    if repo.run_poll_tick ?? false {
      package_job = package_job + ["      run-poll-tick: true"]
    }
    if (repo.test_jobs ?? 0) > 0 {
      package_job = package_job + ["      test-jobs: ${repo.test_jobs ?? 0}"]
    }
    package_job = append_workflow_string_input(
      package_job,
      "validate-command",
      repo.package_validate_command ?? "",
    )
  }
  return join(
    [
      "name: CI",
      "",
      "on:",
      "  pull_request:",
      "  push:",
      "    branches: [main]",
      "  merge_group:",
      "  workflow_dispatch:",
      "",
      "permissions:",
      "  contents: read",
      "",
      "jobs:",
    ]
      + package_job
      + [
        "",
        "  ci-status:",
        "    name: CI status",
        "    if: ${expression}{{ always() }}",
        "    needs: [harn]",
        "    runs-on: ubuntu-latest",
        "    steps:",
        "      - name: Enforce required jobs",
        "        uses: ${package_status_action_reference(manifest.policy.package_workflow)}",
        "        with:",
        "          results-json: ${expression}{{ toJSON(needs.*.result) }}",
        "",
      ],
    "\n",
  )
}

/**
 * Move only the canonical package job's pin, leaving the rest of a repository's
 * CI alone.
 *
 * Some Harn packages run the canonical package job alongside jobs that belong
 * to them — an extension bundle, a generated-fixture check, a repository policy
 * gate. Fleet policy still requires them to sit at the canonical pin, so
 * without this they can only be pinned by hand, and they drift again at the
 * next canonical bump. Rewriting the whole file is not the alternative: that
 * deletes the jobs the repository exists to run.
 *
 * The edit is one line, but it is chosen structurally. The decoded workflow has
 * to contain exactly one job naming the canonical reusable workflow, and the
 * reference it names has to appear exactly once in the source bytes, or this
 * refuses rather than guessing which occurrence to move.
 */
pub fn render_package_ci_pin(
  manifest: FleetManifest,
  repo: FleetRepository,
  current: string,
) -> string {
  if repo.package_ci_ownership != "pin" {
    throw "repository '${repo.slug}' does not delegate package CI pinning to the fleet"
  }
  const expected = manifest.policy.package_workflow
  const workflow = decode_github_workflow(current)
  const jobs = github_reusable_jobs_at_any_ref(workflow, expected)
  if len(jobs) != 1 {
    throw "package CI for '${repo.slug}' must name ${github_reusable_path(expected)} in exactly one job, found ${len(jobs)}"
  }
  const observed = trim((jobs[0] ?? {key: "", value: {}}).value.uses ?? "")
  if observed == expected {
    return current
  }
  const occurrences = len(split(current, observed)) - 1
  if occurrences != 1 {
    throw "package CI for '${repo.slug}' names ${observed} ${occurrences} times; refusing an ambiguous pin rewrite"
  }
  return repin_status_action(manifest, repo, replace(current, observed, expected))
}

/**
 * Move the CI status action to the revision the package workflow is pinned at.
 *
 * The two are co-versioned by policy: `harn-package.yml` checks its policy
 * actions out at `job.workflow_sha`, and the shared policy refuses a workflow
 * whose status roll-up names a different revision than the package job. A pin
 * rewrite that moved only the package job left the pair split, and the split
 * only surfaced as a red policy check in every `pin` repository at once.
 *
 * Byte-exact and single-occurrence, like the pin rewrite above: this owns one
 * line of a workflow the repository otherwise owns, and anything ambiguous is
 * refused rather than guessed at.
 */
fn repin_status_action(manifest: FleetManifest, repo: FleetRepository, current: string) -> string {
  const expected = package_status_action_reference(manifest.policy.package_workflow)
  const action_path = split(expected, "@")[0] ?? ""
  let observed = ""
  for line in split(current, "\n") {
    const found = regex_captures("uses:[[:space:]]*(" + action_path + "@[0-9a-f]{40})", line)
    if len(found) == 1 {
      observed = found[0].groups[0]
    }
  }
  if observed == "" || observed == expected {
    return current
  }
  const occurrences = len(split(current, observed)) - 1
  if occurrences != 1 {
    throw "package CI for '${repo.slug}' names ${observed} ${occurrences} times; refusing an ambiguous status-action rewrite"
  }
  return replace(current, observed, expected)
}

/** Check or write one manifest-owned package CI projection in a local checkout. */
pub fn sync_package_ci_repo(
  fs: HarnessFs,
  manifest: FleetManifest,
  repo: FleetRepository,
  projects_root: string,
  apply: bool,
) -> WorkflowProjectionSyncResult {
  const repo_path = path_join(projects_root, repo.directory)
  const workflow_path = path_join(repo_path, ".github/workflows/ci.yml")
  const expected = if repo.package_ci_ownership == "pin" {
    if !fs.exists(workflow_path) {
      return {
        slug: repo.slug,
        path: workflow_path,
        status: "error",
        error: "pin-only package CI requires an existing ci.yml",
      }
    }
    render_package_ci_pin(manifest, repo, fs.read_text(workflow_path))
  } else {
    render_package_ci(manifest, repo)
  }
  return sync_workflow_projection(
    fs,
    {
      slug: repo.slug,
      repo_path: repo_path,
      relative_path: ".github/workflows/ci.yml",
      expected: expected,
    },
    apply,
  )
}
