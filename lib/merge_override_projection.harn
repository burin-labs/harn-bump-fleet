import "std/schema"
import { FleetRepository } from "./fleet_manifest"
import { FleetProjectionTarget, projection_source_key } from "./fleet_projection_targets"
import { decode_github_workflow, github_reusable_jobs_at_any_ref } from "./github_workflow"

/** Existing dispatchers delegate this one privilege boundary to the organization. */
pub const OVERRIDE_SOURCE_SLUG: string = "burin-labs/.github"

pub const OVERRIDE_IMPLEMENTATION_PATH: string = ".github/workflows/merge-override.yml"

pub const OVERRIDE_TEMPLATE_PATH: string = "templates/merge-override-dispatch.yml"

pub const OVERRIDE_DISPATCHER_PATH: string = ".github/workflows/merge-override-dispatch.yml"

pub type MergeOverrideResolution = {
  targets: list<FleetProjectionTarget>,
  errors: list<string>,
  failed_by: list<string>,
  absent_by: list<string>,
}

fn caller_document(source: string) -> dict {
  return schema_expect<dict>(
    yaml_parse(source),
    schema_object(
      {
        name: schema_field(schema_string(), false),
        on: schema_field(schema_dict(schema_any())),
        permissions: schema_field(schema_dict(schema_string())),
        jobs: schema_field(schema_dict(schema_dict(schema_any()))),
      },
    ),
  )
}

/** Move only a verified implementation reference in a canonical existing caller. */
pub fn render_merge_override_pin(current: string, template: string, revision: string) -> string {
  if len(regex_captures("^[0-9a-f]{40}$", revision)) == 0 {
    throw "merge override implementation requires a verified full commit revision"
  }
  const placeholder = OVERRIDE_SOURCE_SLUG + "/" + OVERRIDE_IMPLEMENTATION_PATH
    + "@<full-commit-sha>"
  if len(split(template, placeholder)) != 2 {
    throw "canonical merge override template must contain exactly one revision placeholder"
  }
  const reference = OVERRIDE_SOURCE_SLUG + "/" + OVERRIDE_IMPLEMENTATION_PATH + "@" + revision
  const canonical = replace(template, placeholder, reference)
  const jobs = github_reusable_jobs_at_any_ref(decode_github_workflow(current), reference)
  if len(jobs) != 1 || jobs[0]?.key != "override" {
    throw "existing merge override dispatcher has no unique canonical override job"
  }
  const observed = jobs[0]?.value?.uses ?? ""
  const old_revision = split(observed, "@")[1] ?? ""
  if len(regex_captures("^[0-9a-f]{40}$", old_revision)) == 0
    || len(split(current, observed)) != 2 {
    throw "existing merge override reference is not one unambiguous immutable pin"
  }
  const document = caller_document(current)
  const canonical_document = caller_document(canonical)
  const normalized = document
    + {jobs: document.jobs + {override: document.jobs.override + {uses: reference}}}
  // The caller's display name is presentation; its event, grant, and job
  // contracts must still equal the canonical template after the pin moves.
  if normalized.removing("name") != canonical_document.removing("name") {
    throw "existing merge override caller differs from the canonical event, permission, or job contract"
  }
  const rendered = replace(current, observed, reference)
  if yaml_parse(rendered) != normalized {
    throw "merge override reference replacement changed the measured caller contract"
  }
  return rendered
}

/** Proven absence is named; unreadable and unknown callers never authorize a target. */
pub fn resolve_merge_override_targets(
  repositories: list<FleetRepository>,
  configs: dict<string, string?>,
  template: string,
  revision: string,
) -> MergeOverrideResolution {
  let targets: list<FleetProjectionTarget> = []
  let errors: list<string> = []
  let failed_by: list<string> = []
  let absent_by: list<string> = []
  for repo in repositories {
    const key = projection_source_key(repo.slug, OVERRIDE_DISPATCHER_PATH)
    if !configs.has(key) {
      errors = errors + [repo.slug + ": merge override caller was not measured"]
      failed_by = failed_by + [repo.slug]
      continue
    }
    const current = configs[key]
    if current == nil {
      absent_by = absent_by + [repo.slug]
      continue
    }
    try {
      const expected = render_merge_override_pin(current, template, revision)
      targets = targets
        + [
          {
            slug: repo.slug,
            path: OVERRIDE_DISPATCHER_PATH,
            expected: expected,
            origin: "verified organization merge override implementation reference",
            derived_from_sha256: sha256(current),
          },
        ]
    } catch (error) {
      errors = errors + [repo.slug + ": " + to_string(error)]
      failed_by = failed_by + [repo.slug]
    }
  }
  return {targets: targets, errors: errors, failed_by: failed_by, absent_by: absent_by}
}
