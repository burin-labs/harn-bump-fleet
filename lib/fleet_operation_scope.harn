/** One immutable operation scope; `fleet` is the legacy continuation spelling. */
pub type FleetDispatchScope = {kind: "full_fleet"} \
  | {kind: "fleet"} \
  | {kind: "repository", repository: string} \
  | {kind: "repositories", repositories: list<string>}

type RepositoryNames = list<string>

/** Normalize selectors without converting an explicit empty selection into the fleet. */
pub fn fleet_operation_scope(
  only: string? = nil,
  repositories_json: string? = nil,
) -> FleetDispatchScope {
  if repositories_json != nil {
    if trim(only ?? "") != "" {
      throw "repository selectors --only and --repositories-json are mutually exclusive"
    }
    const repositories: RepositoryNames = schema_expect(
      json_parse(repositories_json),
      schema_of(RepositoryNames),
    )
    if len(repositories) == 0 {
      throw "explicit repository scope cannot be empty"
    }
    let normalized: list<string> = []
    for repository in repositories {
      const slug = trim(repository)
      if slug == "" || contains(normalized, slug) {
        throw "repository scope contains an empty or duplicate selector"
      }
      normalized = normalized + [slug]
    }
    return {kind: "repositories", repositories: normalized.sort()}
  }
  const repository = trim(only ?? "")
  return if repository == "" {
    {kind: "full_fleet"}
  } else {
    {kind: "repository", repository: repository}
  }
}

/** The exact requested members, or nil only for a genuinely omitted scope. */
pub fn fleet_scope_members(scope: FleetDispatchScope) -> list<string>? {
  if scope.kind == "repositories" {
    return scope.repositories
  }
  if scope.kind == "repository" {
    return [scope.repository]
  }
  return nil
}

/** Test one target without granting missing members implicit fleet authority. */
pub fn fleet_scope_allows(scope: FleetDispatchScope, repository: string) -> bool {
  const members = fleet_scope_members(scope)
  return members == nil || contains(members, repository)
}

/** A release tail must update its controller policy before dispatching consumers. */
pub fn require_release_controller_scope(scope: FleetDispatchScope) -> bool {
  if !fleet_scope_allows(scope, "burin-labs/harn-bump-fleet") {
    throw "release scope must include the required harn-bump-fleet controller policy projection"
  }
  return true
}

/** Canonical inputs shared by initial and successor workflow dispatches. */
pub fn fleet_scope_inputs(scope: FleetDispatchScope) -> dict {
  if scope.kind == "repositories" {
    return {
      repositories_json: json_stringify(scope.repositories),
      scope_digest: fleet_scope_digest(scope),
    }
  }
  if scope.kind == "repository" {
    return {only: scope.repository, scope_digest: fleet_scope_digest(scope)}
  }
  return {}
}

/** Compact projection of the exact normalized members, not a second scope authority. */
pub fn fleet_scope_digest(scope: FleetDispatchScope) -> string {
  const members = fleet_scope_members(scope)
  return if members == nil {
    ""
  } else {
    sha256(json_stringify(unwrap(members).sort()))
  }
}

/** Refuse a workflow title identity that does not bind its actual repository selection. */
pub fn require_fleet_scope_digest(scope: FleetDispatchScope, digest: string) -> bool {
  if digest != fleet_scope_digest(scope) {
    throw "scope_digest must equal the canonical repository scope digest"
  }
  return true
}

/** Stable explicit-scope correlation; omitted scopes retain existing run titles. */
pub fn fleet_scope_title_suffix(scope: FleetDispatchScope) -> string {
  const digest = fleet_scope_digest(scope)
  return if digest == "" {
    ""
  } else {
    " / scope " + digest
  }
}

/** Refuse missing, duplicate, or additional proof subjects, even at equal counts. */
pub fn require_fleet_scope_census(expected: list<string>, observed: list<string>) -> bool {
  if len(expected) == 0 || expected.sort() != observed.sort() {
    throw "fleet proof repository census differs from the operation scope"
  }
  return true
}
