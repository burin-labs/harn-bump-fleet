import { FleetManifest, FleetRepository } from "./fleet_manifest"
import {
  WorkflowProjectionSyncResult,
  append_workflow_string_input,
  sync_workflow_projection,
} from "./workflow_projection"

fn bump_validation_command(repo: FleetRepository) -> string {
  if repo.bump_validate_command != nil {
    return trim(repo.bump_validate_command ?? "")
  }
  if repo.harn_package ?? false {
    return "harn package verify ."
  }
  return ""
}

/**
 * Render manifest-owned rationale as YAML comments above `refresh-command`.
 *
 * A generated adapter otherwise has nowhere to say *why* a step looks the way
 * it does, so the explanation ends up hand-edited into the projected file —
 * where the next `--apply` silently deletes it, and where it stops being the
 * owner's answer. Keeping it in the manifest means the reason ships with the
 * command it explains.
 */
fn bump_refresh_note_lines(notes: string) -> list<string> {
  const body = trim(notes)
  if body == "" {
    return []
  }
  let out: list<string> = []
  for line in split(body, "\n") {
    out = out
      + [
      if trim(line) == "" {
        "      #"
      } else {
        "      # ${line}"
      },
    ]
  }
  return out
}

/** Render the exact thin runtime-bump adapter owned by the fleet manifest. */
pub fn render_bump_workflow(manifest: FleetManifest, repo: FleetRepository) -> string {
  if repo.bump_workflow_ownership != "fleet" {
    throw "repository '${repo.slug}' does not delegate bump workflow ownership to the fleet"
  }
  const expression = "$"
  let inputs = ["      version: ${expression}{{ inputs.version }}"]
  inputs = inputs + bump_refresh_note_lines(repo.bump_refresh_notes ?? "")
  inputs = append_workflow_string_input(inputs, "refresh-command", repo.bump_refresh_command ?? "")
  inputs = append_workflow_string_input(inputs, "validate-command", bump_validation_command(repo))
  if manifest.policy.publish_failures_for_repair ?? false {
    inputs = inputs + ["      publish-failure-for-repair: true"]
  }
  if repo.bump_node_version != nil {
    inputs = inputs + ["      node-version: \"${repo.bump_node_version ?? ""}\""]
  }
  return join(
    [
      "name: Bump Harn Runtime",
      "",
      "# fleet.toml in harn-bump-fleet owns this generated dispatch adapter.",
      "on:",
      "  workflow_dispatch:",
      "    inputs:",
      "      version:",
      "        description: \"Optional exact Harn tag (vX.Y.Z). Defaults to latest.\"",
      "        required: false",
      "        type: string",
      "",
      "permissions:",
      "  contents: read",
      "",
      "jobs:",
      "  bump:",
      "    uses: ${manifest.policy.bump_workflow}",
      "    with:",
    ]
      + inputs
      + [
      "    secrets:",
      "      app-client-id: ${expression}{{ secrets.RELEASE_APP_CLIENT_ID }}",
      "      app-private-key: ${expression}{{ secrets.RELEASE_APP_PRIVATE_KEY }}",
      "",
    ],
    "\n",
  )
}

/** Check or write one manifest-owned runtime-bump adapter in a local checkout. */
pub fn sync_bump_workflow_repo(
  fs: HarnessFs,
  manifest: FleetManifest,
  repo: FleetRepository,
  projects_root: string,
  apply: bool,
) -> WorkflowProjectionSyncResult {
  const repo_path = path_join(projects_root, repo.directory)
  return sync_workflow_projection(
    fs,
    {
      slug: repo.slug,
      repo_path: repo_path,
      relative_path: ".github/workflows/bump-harn.yml",
      expected: render_bump_workflow(manifest, repo),
    },
    apply,
  )
}
