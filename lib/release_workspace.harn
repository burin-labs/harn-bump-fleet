import { command_result_fail, command_result_ok } from "std/command"
import { recorded_step } from "./release_execution"
import {
  ReleaseAnalysisSnapshot,
  ReleaseConfig,
  checked_git,
  release_log_event,
  run_git,
} from "./release_runtime"

pub type ReleaseSourceSnapshot = {
  branch: string,
  head: string,
  status: string,
  index_diff: string,
  worktree_diff: string,
}

pub type ReleaseWorkspaceCleanup = {
  success: bool,
  skipped: bool,
  branch: string,
  detail: string,
  warning: string,
  fatal: bool,
  steps: list<dict>,
  path: string,
  preserved: bool,
}

/**
 * Keep post-run repo tools on a checkout that still exists after cleanup.
 *
 * The audit receipt retains the execution config and cleanup record. Only the
 * config passed to post-run tools is projected onto the durable source repo
 * after this harness has proven that it removed the managed worktree.
 */
pub fn release_post_cleanup_config(
  cfg: ReleaseConfig,
  cleanup: ReleaseWorkspaceCleanup?,
) -> ReleaseConfig {
  if !(cfg.release_workspace_managed ?? false)
    || cleanup == nil
    || !cleanup.success
    || cleanup.preserved {
    return cfg
  }
  if cleanup.path != cfg.release_workspace {
    throw "successful release cleanup path does not match the managed workspace"
  }
  if trim(cfg.source_repo) == "" {
    throw "successful managed release cleanup is missing a durable source repo"
  }
  let out = cfg
  out["repo"] = cfg.source_repo
  return out
}

pub fn release_workspace_required(cfg: dict) -> bool {
  return !(cfg.mock ?? false)
}

/**
 * Return the closed identity consumed by release analysis.
 *
 * Non-mock analysis is invalid until the exact resolved commit has been
 * materialized in a detached managed worktree. This runtime assertion keeps a
 * future caller from silently feeding analysis the operator's mutable checkout.
 */
pub fn release_analysis_snapshot(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseConfig,
) -> ReleaseAnalysisSnapshot {
  let snapshot = cfg.analysis_snapshot
  if cfg.mock {
    if snapshot.kind != "mock"
      || snapshot.resolved_sha
      != cfg.pin_sha
      || snapshot.analysis_root
      != cfg.repo {
      throw "mock release analysis is missing its resolved snapshot identity"
    }
    snapshot["analysis_head"] = cfg.pin_sha
    return snapshot
  }
  if snapshot.kind != "detached_worktree"
    || !(cfg.release_workspace_managed ?? false)
    || snapshot.analysis_root
    != cfg.repo
    || snapshot.analysis_root
    != cfg.release_workspace
    || snapshot.source_repo
    != cfg.source_repo {
    throw "release analysis requires one detached worktree at the resolved pin"
  }
  const expected_head = if cfg.pre_tag_resume ?? false {
    trim(cfg.fixup_publication?.head_oid ?? "")
  } else {
    cfg.pin_sha
  }
  const analysis_head = checked_git(harness, cfg, ["rev-parse", "HEAD"])
  if expected_head == ""
    || lowercase(analysis_head)
    != lowercase(expected_head)
    || (!(cfg.pre_tag_resume ?? false)
    && lowercase(snapshot.resolved_sha)
    != lowercase(
    cfg.pin_sha,
  )) {
    throw "release analysis worktree does not match its immutable snapshot identity"
  }
  snapshot["analysis_head"] = analysis_head
  return snapshot
}

fn source_cfg(cfg: dict, repo: string) -> dict {
  return cfg + {repo: repo, mock: false}
}

fn source_snapshot(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  repo: string,
) -> ReleaseSourceSnapshot {
  const scoped = source_cfg(cfg, repo)
  return {
    branch: checked_git(harness, scoped, ["branch", "--show-current"]),
    head: checked_git(harness, scoped, ["rev-parse", "HEAD"]),
    status: checked_git(harness, scoped, ["status", "--porcelain", "--untracked-files=normal"]),
    index_diff: checked_git(harness, scoped, ["diff", "--cached", "--binary", "--no-ext-diff"]),
    worktree_diff: checked_git(harness, scoped, ["diff", "--binary", "--no-ext-diff"]),
  }
}

fn assert_source_unchanged(
  before: ReleaseSourceSnapshot,
  after: ReleaseSourceSnapshot,
  workspace: string,
) -> nil {
  if before.branch != after.branch
    || before.head
    != after.head
    || before.status
    != after.status
    || before.index_diff
    != after.index_diff
    || before.worktree_diff
    != after.worktree_diff {
    throw "release workspace creation observed a concurrent change in the source checkout; refusing to continue\n"
      + "source: branch ${before.branch} -> ${after.branch}, HEAD ${before.head} -> ${after.head}; local diff content omitted\n"
      + "isolated workspace preserved at ${workspace}"
  }
}

fn release_workspace_path(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: dict,
  source_repo: string,
  run_id: string,
) -> string {
  if len(regex_captures("^[A-Za-z0-9][A-Za-z0-9._-]*$", run_id)) == 0 {
    throw "invalid release run id for workspace path: " + run_id
  }
  const common_dir = checked_git(
    harness,
    source_cfg(cfg, source_repo),
    ["rev-parse", "--path-format=absolute", "--git-common-dir"],
  )
  if basename(common_dir) != ".git" {
    throw "release source does not resolve to a non-bare Git checkout: " + source_repo
  }
  const primary_checkout = dirname(common_dir)
  return path_join(
    dirname(primary_checkout),
    basename(primary_checkout) + "-worktrees",
    "release-" + run_id,
  )
}

/**
 * Materialize a live release at its frozen pin without changing the checkout
 * supplied by the operator. Every downstream release adapter receives the
 * returned config, whose `repo` is the disposable worktree.
 */
pub fn materialize_release_workspace(
  harness: Harness,
  cfg: ReleaseConfig,
  run_id: string,
) -> ReleaseConfig {
  if cfg.mock {
    let mock_cfg = cfg
    mock_cfg["analysis_snapshot"] = {
      kind: "mock",
      requested_sha: cfg.pin_sha_input,
      resolved_sha: cfg.pin_sha,
      analysis_head: cfg.pin_sha,
      analysis_root: cfg.repo,
      source_repo: cfg.repo,
    }
    return mock_cfg
  }
  if cfg.release_workspace_managed ?? false {
    release_analysis_snapshot({env: harness.env, process: harness.process}, cfg)
    return cfg
  }
  const source_repo = checked_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["rev-parse", "--show-toplevel"],
  )
  const before = source_snapshot({env: harness.env, process: harness.process}, cfg, source_repo)
  const workspace = release_workspace_path(
    {env: harness.env, process: harness.process},
    cfg,
    source_repo,
    run_id,
  )
  if harness.fs.exists(workspace) {
    throw "release workspace already exists: " + workspace
  }
  harness.fs.mkdir(dirname(workspace), true)
  const added = run_git(
    {env: harness.env, process: harness.process},
    source_cfg(cfg, source_repo),
    ["worktree", "add", "--detach", workspace, cfg.pin_sha],
  )
  if !added.success {
    throw "failed to create isolated release workspace at ${workspace}:\n${trim(added.stderr)}"
  }
  try {
    const after = source_snapshot({env: harness.env, process: harness.process}, cfg, source_repo)
    assert_source_unchanged(before, after, workspace)
    const workspace_cfg = source_cfg(cfg, workspace)
    const workspace_head = checked_git(
      {env: harness.env, process: harness.process},
      workspace_cfg,
      ["rev-parse", "HEAD"],
    )
    const workspace_branch = checked_git(
      {env: harness.env, process: harness.process},
      workspace_cfg,
      ["branch", "--show-current"],
    )
    if lowercase(workspace_head) != lowercase(cfg.pin_sha) || workspace_branch != "" {
      throw "isolated release workspace did not materialize detached at frozen pin ${cfg.pin_sha}: ${workspace}"
    }
    let out = cfg
    out["source_repo"] = source_repo
    out["repo"] = workspace
    out["release_workspace"] = workspace
    out["release_workspace_managed"] = true
    out["analysis_snapshot"] = {
      kind: "detached_worktree",
      requested_sha: cfg.pin_sha_input,
      resolved_sha: cfg.pin_sha,
      analysis_head: cfg.pin_sha,
      analysis_root: workspace,
      source_repo: source_repo,
    }
    release_log_event(
      {clock: harness.clock, fs: harness.fs},
      run_id,
      "release_workspace_created",
      {
        source_repo: source_repo,
        workspace: workspace,
        pin_sha: cfg.pin_sha,
        source_branch: before.branch,
        source_head: before.head,
        source_dirty: trim(before.status) != "",
        cargo_target_dir: cfg.release_cargo_target_dir,
      },
    )
    return out
  } catch (e) {
    const removed = run_git(
      {env: harness.env, process: harness.process},
      source_cfg(cfg, source_repo),
      ["worktree", "remove", "--force", workspace],
    )
    if !removed.success || harness.fs.exists(workspace) {
      throw to_string(e)
        + "\nfailed to remove partially materialized release workspace ${workspace}: "
        + trim(
        removed.stderr,
      )
    }
    throw e
  }
}

/** Candidate certification warms and audits the immutable attempt at HEAD. */
pub fn align_pre_tag_release_workspace(
  harness: Harness,
  cfg: ReleaseConfig,
  run_id: string,
) -> nil {
  if !(cfg.pre_tag_resume ?? false) || !(cfg.release_workspace_managed ?? false) {
    return
  }
  const candidate = trim(cfg.fixup_publication?.head_oid ?? "")
  if len(regex_captures("^[0-9a-fA-F]{40}$", candidate)) == 0 {
    throw "pre-tag resume is missing a concrete immutable candidate OID"
  }
  const status = checked_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["status", "--porcelain", "--untracked-files=normal"],
  )
  if trim(status) != "" {
    throw "refusing to align a dirty release workspace to immutable candidate ${candidate}: ${cfg.repo}"
  }
  const switched = run_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["switch", "--detach", candidate],
  )
  if !switched.success {
    throw "failed to align pre-tag release workspace to ${candidate}:\n${trim(switched.stderr)}"
  }
  const head = checked_git({env: harness.env, process: harness.process}, cfg, ["rev-parse", "HEAD"])
  if lowercase(head) != lowercase(candidate) {
    throw "pre-tag release workspace resolved to ${head}, expected ${candidate}"
  }
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    "release_workspace_aligned_to_candidate",
    {workspace: cfg.repo, candidate_oid: candidate, pin_sha: cfg.pin_sha},
  )
}

fn preservation_cleanup(
  cfg: ReleaseConfig,
  branch: string,
  detail: string,
  step: dict,
) -> ReleaseWorkspaceCleanup {
  return {
    success: true,
    skipped: true,
    branch: branch,
    detail: detail,
    warning: "",
    fatal: false,
    steps: [step],
    path: cfg.release_workspace,
    preserved: true,
  }
}

fn assert_release_workspace_target(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseConfig,
  run_id: string,
) -> nil {
  const workspace = cfg.release_workspace
  if trim(cfg.source_repo) == "" || cfg.repo != workspace {
    throw "managed release workspace identity is incomplete"
  }
  const expected = release_workspace_path(harness, cfg, cfg.source_repo, run_id)
  if workspace != expected {
    throw "refusing to remove a release workspace not owned by run ${run_id}: ${workspace}"
  }
  return nil
}

fn removal_cleanup(
  harness: Harness,
  cfg: ReleaseConfig,
  run_id: string,
  branch: string,
  force: bool,
) -> ReleaseWorkspaceCleanup {
  assert_release_workspace_target({env: harness.env, process: harness.process}, cfg, run_id)
  const workspace = cfg.release_workspace
  if !harness.fs.exists(workspace) {
    const detail = "isolated release workspace already removed: ${workspace}"
    const cleanup: ReleaseWorkspaceCleanup = {
      success: true,
      skipped: true,
      branch: branch,
      detail: detail,
      warning: "",
      fatal: false,
      steps: [
        recorded_step(
          "release-workspace-already-removed",
          "verify absent " + workspace,
          command_result_ok(detail),
        ),
      ],
      path: workspace,
      preserved: false,
    }
    release_log_event(
      {clock: harness.clock, fs: harness.fs},
      run_id,
      "release_workspace_already_removed",
      cleanup,
    )
    return cleanup
  }
  const remove_args = ["worktree", "remove"]
    + if force {
    ["--force"]
  } else {
    []
  }
    + [workspace]
  const removed = run_git(
    {env: harness.env, process: harness.process},
    source_cfg(cfg, cfg.source_repo),
    remove_args,
  )
  const removed_cleanly = removed.success && !harness.fs.exists(workspace)
  const detail = if removed_cleanly {
    "removed isolated release workspace ${workspace}"
  } else {
    "failed to remove isolated release workspace; preserved for recovery: ${workspace}"
  }
  const cleanup: ReleaseWorkspaceCleanup = {
    success: removed_cleanly,
    skipped: !removed_cleanly,
    branch: branch,
    detail: detail,
    warning: if removed_cleanly {
      ""
    } else {
      "non-fatal release workspace cleanup warning: " + detail
    },
    fatal: false,
    steps: [
      recorded_step(
        "remove-release-workspace",
        "git worktree remove " + workspace,
        if removed_cleanly {
          command_result_ok(detail)
        } else {
          command_result_fail(removed.exit_code ?? 1, removed.stderr)
        },
      ),
    ],
    path: workspace,
    preserved: !removed_cleanly,
  }
  release_log_event(
    {clock: harness.clock, fs: harness.fs},
    run_id,
    if removed_cleanly {
      "release_workspace_removed"
    } else {
      "release_workspace_preserved"
    },
    cleanup,
  )
  return cleanup
}

/**
 * Remove audit snapshots on every terminal path. Preserve live workspaces when
 * they contain recovery state; remove only a clean, successfully shipped one.
 */
pub fn finish_release_workspace(
  harness: Harness,
  cfg: ReleaseConfig,
  ship_succeeded: bool,
  run_id: string,
) -> ReleaseWorkspaceCleanup? {
  if !(cfg.release_workspace_managed ?? false) {
    return nil
  }
  const workspace = cfg.release_workspace
  assert_release_workspace_target({env: harness.env, process: harness.process}, cfg, run_id)
  const branch = if harness.fs.exists(workspace) {
    trim(
      run_git({env: harness.env, process: harness.process}, cfg, ["branch", "--show-current"])
        .stdout
        ?? "",
    )
  } else {
    ""
  }
  if cfg.mode == "audit" {
    return removal_cleanup(harness, cfg, run_id, branch, true)
  }
  if !ship_succeeded || cfg.mode != "ship-pr" {
    const reason = if cfg.mode == "prepare" && ship_succeeded {
      "prepared release workspace preserved for inspection and continuation: ${workspace}"
    } else {
      "release did not ship successfully; workspace preserved for recovery: ${workspace}"
    }
    const cleanup = preservation_cleanup(
      cfg,
      branch,
      reason,
      recorded_step(
        "preserve-release-workspace",
        "preserve " + workspace,
        command_result_ok(reason),
      ),
    )
    release_log_event(
      {clock: harness.clock, fs: harness.fs},
      run_id,
      "release_workspace_preserved",
      cleanup,
    )
    return cleanup
  }
  const status = run_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["status", "--porcelain", "--untracked-files=normal"],
  )
  if !status.success || trim(status.stdout ?? "") != "" {
    const detail = if status.success {
      "shipped release workspace is dirty; preserved for recovery: ${workspace}"
    } else {
      "could not verify shipped release workspace cleanliness; preserved for recovery: ${workspace}"
    }
    const cleanup: ReleaseWorkspaceCleanup = {
      success: false,
      skipped: true,
      branch: branch,
      detail: detail,
      warning: "non-fatal release workspace cleanup warning: " + detail,
      fatal: false,
      steps: [
        recorded_step(
          "verify-release-workspace-clean",
          "git status --porcelain --untracked-files=normal",
          if status.success {
            command_result_fail(1, status.stdout)
          } else {
            command_result_fail(status.exit_code ?? 1, status.stderr)
          },
        ),
      ],
      path: workspace,
      preserved: true,
    }
    release_log_event(
      {clock: harness.clock, fs: harness.fs},
      run_id,
      "release_workspace_preserved",
      cleanup,
    )
    return cleanup
  }
  return removal_cleanup(harness, cfg, run_id, branch, false)
}
