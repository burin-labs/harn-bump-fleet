pub type PublicMetadataEntry = {path: string, text: string}

pub type PublicMetadataHit = {path: string, line: int}

/** Parse a private newline-delimited denylist without ever rendering its values. */
pub fn private_metadata_tokens(text: string) -> list<string> {
  return split(text, "\n").map({ line -> trim(line) }).filter(
    { line -> line != "" && !starts_with(line, "#") },
  )
    .to_list()
}

/** Find private identifiers while returning only safe public file coordinates. */
pub fn public_metadata_hits(
  entries: list<PublicMetadataEntry>,
  private_tokens: list<string>,
) -> list<PublicMetadataHit> {
  if len(private_tokens) == 0 {
    throw "private metadata denylist must contain at least one token"
  }
  let hits = []
  for entry in entries {
    let line_number = 0
    for line in split(entry.text, "\n") {
      line_number = line_number + 1
      if private_tokens.any({ token -> contains(line, token) }) {
        hits = hits + [{path: entry.path, line: line_number}]
      }
    }
  }
  return hits
}
