import { ParserSpec, parse_typed } from "std/cli/argparse"

/** Validate argv once and return the schema-backed option contract. */
pub fn cli_options<T>(spec: ParserSpec, args: list<string>, schema: Schema<T>) -> T {
  const result = parse_typed<T>(spec, args, schema)
  if is_err(result) {
    throw unwrap_err(result).message
  }
  return unwrap(result).options
}

/** Parse one named field of repeated or comma-separated pull request numbers. */
pub fn parse_pull_request_numbers(field: string, values: list<string>) -> list<int> {
  let out: list<int> = []
  for value in values {
    for part in split(value, ",") {
      const trimmed = trim(part)
      if trimmed == "" {
        continue
      }
      const normalized = if starts_with(trimmed, "#") {
        trimmed[1:len(trimmed)]
      } else {
        trimmed
      }
      const number = to_int(normalized)
      if number == nil || number <= 0 || to_string(number) != normalized {
        throw "invalid ${field} value: ${trimmed}; expected blank or comma-separated positive "
          + "pull request numbers, each optionally prefixed with #; for example 7922,#8146"
      }
      if !contains(out, number) {
        out = out + [number]
      }
    }
  }
  return out
}

/**
 * Accept only an exact Harn release tag from a caller-supplied target.
 *
 * Both fleet-wide dispatchers take a target tag from argv or from the newest
 * published release, and both refuse anything that is not one exact tag. The
 * shape lived twice inside `main`, where no test could reach it; it lives here
 * so a test can run it against the real matcher.
 */
pub fn is_exact_harn_release_tag(target: string) -> bool {
  return len(regex_captures("^v[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$", target)) == 1
}
