import { parse_typed } from "std/cli/argparse"

/** Validate argv once and return the schema-backed option contract. */
pub fn cli_options<T>(spec, args: list<string>, schema: Schema<T>) -> T {
  const result = parse_typed<T>(spec, args, schema)
  if is_err(result) {
    throw unwrap_err(result).message
  }
  return unwrap(result).options
}
