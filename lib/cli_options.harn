/** Normalize generic std/cli values once at each harness-owned option boundary. */
pub fn cli_optional_string(value, name: string) -> string? {
  if value == nil {
    return nil
  }
  if type_of(value) != "string" {
    throw "${name} must be a string"
  }
  return value
}

pub fn cli_required_string(value, name: string) -> string {
  const normalized = cli_optional_string(value, name)
  if normalized == nil {
    throw "${name} must be a string"
  }
  return normalized
}

pub fn cli_required_bool(value, name: string) -> bool {
  if type_of(value) != "bool" {
    throw "${name} must be a boolean"
  }
  return value
}

pub fn cli_required_int(value, name: string) -> int {
  if type_of(value) != "int" {
    throw "${name} must be an integer"
  }
  return value
}
