import { github_workflow_dispatch } from "./github"
import { ReleaseConfig, release_run_root } from "./release_runtime"
import {
  ReleaseWorkflowHandoff,
  release_workflow_handoff,
  release_workflow_handoff_write,
} from "./release_watch_handoff"
import { GithubConnectorError, GithubWorkflowDispatchReceipt } from "harn-github-connector/default"

type OpenerResult = Result<GithubWorkflowDispatchReceipt, GithubConnectorError>

pub type ReleaseWorkflowOpener = fn(string, string, dict, string) -> OpenerResult

pub type ReleaseWorkflowOpenResult = {
  state: "pending",
  receipt: ReleaseWorkflowHandoff,
  receipt_path: string,
  pending_names: list<string>,
}

fn retired_workflow_overrides(cfg: ReleaseConfig) -> list<string> {
  const overrides = [
    {name: "base", active: cfg.base != "main"},
    {name: "version selection", active: cfg.bump != "patch" || cfg.preid != ""},
    {name: "source pin", active: cfg.pin_sha_input != ""},
    {name: "crate bootstrap", active: cfg.bootstrap_new_crates},
    {name: "local fixup", active: cfg.fixup_mode || cfg.skip_tag},
    {name: "tagged resume", active: cfg.resume_tagged_release},
    {name: "pre-tag resume", active: cfg.pre_tag_resume || cfg.pre_tag_supersede},
    {name: "base drift", active: cfg.allow_base_drift},
    {name: "local release notes", active: cfg.release_focus != ""},
    {name: "local certification", active: cfg.local_audit},
    {name: "chat only", active: cfg.chat_only},
    {name: "local planner", active: cfg.agent},
    {name: "self update", active: cfg.self_update},
    {name: "local build wait", active: cfg.wait_build_lock},
    {name: "expected PRs", active: len(cfg.expected_prs) > 0},
    {name: "rejected PRs", active: len(cfg.rejected_prs) > 0},
    {name: "critical queue PRs", active: len(cfg.queue_critical_prs) > 0},
    {name: "live queue PRs", active: len(cfg.queue_live_prs) > 0},
    {name: "noncritical queue PRs", active: len(cfg.queue_noncritical_live_prs) > 0},
  ]
  return overrides.filter({ entry -> entry.active }).map({ entry -> entry.name }).to_list()
}

/** Delegate preparation to Harn's sole release owner without selecting a version locally. */
pub fn release_workflow_open(
  harness: Harness,
  cfg: ReleaseConfig,
  injected_opener: ReleaseWorkflowOpener? = nil,
) -> ReleaseWorkflowOpenResult {
  if cfg.mock || cfg.mode != "ship-pr" || !cfg.yes_live_release {
    throw "live workflow handoff requires ship-pr and --yes-live-release"
  }
  const overrides = retired_workflow_overrides(cfg)
  if len(overrides) > 0 {
    throw "Harn's workflow opener owns these retired local overrides: " + join(overrides, ", ")
  }
  const opener = injected_opener
    ?? fn(repository, workflow, inputs, ref) { return github_workflow_dispatch(
      harness,
      repository,
      workflow,
      inputs,
      ref,
    ) }
  const dispatched = opener("burin-labs/harn", "bump-release.yml", {}, "main")
  if is_err(dispatched) {
    throw "canonical release opener dispatch failed; no legacy release fallback was attempted"
  }
  const receipt = release_workflow_handoff(unwrap(dispatched))
  const path = path_join(
    release_run_root(harness.fs),
    "workflow-handoffs",
    "${receipt.opener_run_id}.json",
  )
  release_workflow_handoff_write(pick(harness, ["fs", "random"]), path, receipt)
  return {
    state: "pending",
    receipt: receipt,
    receipt_path: path,
    pending_names: [
      "opener_result",
      "release_pull_request",
      "merged_source",
      "archive_producer",
      "publication",
    ],
  }
}
