import { env_str } from "std/config"
import { write_jsonl } from "std/jsonl"
import { release_log_range_arg } from "./git"
import { prompt_asset, run_output_dir } from "./release_runtime"
import { ReleaseAuditReceipt, ReleaseReportPaths } from "./run_receipts"

pub type CrystallizationFixturePaths = {
  out_dir: string,
  manifest_json: string,
  release_run_json: string,
  deterministic_events_jsonl: string,
  agent_events_jsonl: string,
  tool_observations_jsonl: string,
  readme_md: string,
}

pub type CrystallizationFixtureEvent = {
  schema_version: string,
  event_type: string,
  source: string,
  timestamp: string,
  data: dict,
}

fn crystallization_fixture_paths(fs: HarnessFs, run_id: string) -> CrystallizationFixturePaths {
  const out_dir = path_join(run_output_dir(fs, run_id), "crystallization-input")
  return {
    out_dir: out_dir,
    manifest_json: path_join(out_dir, "manifest.json"),
    release_run_json: path_join(out_dir, "release-run.json"),
    deterministic_events_jsonl: path_join(out_dir, "deterministic-events.jsonl"),
    agent_events_jsonl: path_join(out_dir, "agent-events.jsonl"),
    tool_observations_jsonl: path_join(out_dir, "tool-observations.jsonl"),
    readme_md: path_join(out_dir, "README.md"),
  }
}

fn artifact_text(fs: HarnessFs, path: string) -> string {
  if path == "" || !fs.exists(path) {
    return ""
  }
  return fs.read_text(path)
}

const FIXTURE_SCHEMA_VERSION = "release_harn.crystallization_input.v3"

type ReleaseStepSideEffectEvidence = {known: bool, side_effects: list<dict>}

fn release_step_side_effect_evidence(name: string) -> ReleaseStepSideEffectEvidence {
  if name == "publish-immutable-release-attempt"
    || name == "push"
    || name == "push-no-verify-after-green-hook-budget"
    || name == "push-release-tag" {
    return {
      known: true,
      side_effects: [
        {
          kind: "remote_git_write",
          target: "origin",
          capability: "git.push",
          mutation: name,
          metadata: {},
        },
      ],
    }
  }
  if name == "create-release-tag" {
    return {
      known: true,
      side_effects: [
        {
          kind: "local_git_ref_write",
          target: "release_tag",
          capability: "git.tag",
          mutation: name,
          metadata: {},
        },
      ],
    }
  }
  if name == "create-pr" || name == "refresh-existing-pr-body" || name == "auto-merge" {
    return {
      known: true,
      side_effects: [
        {
          kind: "github_write",
          target: "release_pull_request",
          capability: "github.pull_request.write",
          mutation: name,
          metadata: {},
        },
      ],
    }
  }
  if name == "auto-merge-already-enabled" || name == "auto-merge-skipped" {
    return {known: true, side_effects: []}
  }
  return {known: false, side_effects: []}
}

type AgentReviewAttemptFixtureRecord = {
  name?: string,
  status?: string,
  text?: string,
  validation_findings?: list<string>,
  llm?: dict,
  tools?: dict,
}

const AGENT_REVIEW_ATTEMPT_FIXTURE_RECORD_SCHEMA = {
  type: "dict",
  properties: {
    name: {type: "string"},
    status: {type: "string"},
    text: {type: "string"},
    validation_findings: {type: "list", items: {type: "string"}},
    llm: {type: "dict"},
    tools: {type: "dict"},
  },
}

fn fixture_event(
  event_type: string,
  source: string,
  timestamp: string,
  data: dict,
) -> CrystallizationFixtureEvent {
  return {
    schema_version: FIXTURE_SCHEMA_VERSION,
    event_type: event_type,
    source: source,
    timestamp: timestamp,
    data: data,
  }
}

fn tool_event(timestamp: string, source: string, data: dict) -> CrystallizationFixtureEvent {
  return fixture_event("tool_observation", source, timestamp, data)
}

fn shell_tool_event(
  timestamp: string,
  command: string,
  stdout: string?,
) -> CrystallizationFixtureEvent {
  return tool_event(
    timestamp,
    "deterministic",
    {
      tool: "shell",
      command: command,
      success: true,
      status: "completed",
      exit_code: 0,
      stdout: stdout ?? "",
      stderr: "",
    },
  )
}

fn read_file_tool_event(
  timestamp: string,
  path: string,
  stdout: string,
) -> CrystallizationFixtureEvent {
  return tool_event(
    timestamp,
    "deterministic",
    {
      tool: "read_file",
      path: path,
      success: true,
      status: "completed",
      exit_code: 0,
      stdout: stdout,
      stderr: "",
    },
  )
}

fn artifact_snapshot(fs: HarnessFs, artifacts: dict, optional_keys: list<string>) -> dict {
  let snap: dict = {
    raw_result_json_path: artifacts.raw_result_json ?? "",
    raw_result_json: artifact_text(fs, artifacts.raw_result_json ?? ""),
    trace_json_path: artifacts.trace_json ?? "",
    trace_json: artifact_text(fs, artifacts.trace_json ?? ""),
    llm_transcript_jsonl_path: artifacts.llm_transcript_jsonl ?? "",
    llm_transcript_jsonl: artifact_text(fs, artifacts.llm_transcript_jsonl ?? ""),
  }
  for key in optional_keys {
    snap = snap
      + {[key + "_path"]: artifacts[key] ?? "", [key]: artifact_text(fs, artifacts[key] ?? "")}
  }
  return snap
}

pub fn deterministic_fixture_events(payload: dict) -> list<CrystallizationFixtureEvent> {
  const a = payload.analysis
  let events = [
    fixture_event(
      "release_analysis",
      "deterministic",
      payload.started_iso,
      {
        repo: a.repo,
        mode: a.mode,
        mock: a.mock,
        bump: a.bump,
        starting_branch: a.branch,
        target_release_branch: a.expected_branch,
        base_branch: a.base_branch,
        current_version: a.current_version,
        next_version: a.next_version,
        latest_tag: a.latest_tag,
        git_log_range: release_log_range_arg(a.latest_tag, a.pin_sha ?? ""),
        dirty_files: a.dirty_files,
        status: a.status,
      },
    ),
    fixture_event(
      "changelog_audit_inputs",
      "deterministic",
      payload.started_iso,
      {
        expected_version: a.next_version,
        changelog_top: a.changelog_top,
        changelog_section: a.changelog_section,
        changelog_unreleased_section: a.changelog_unreleased_section ?? "",
        commits_since_latest_tag: a.commits_since_latest_tag,
        commit_stats_since_latest_tag: a.commit_stats_since_latest_tag,
        commit_file_changes_since_latest_tag: a.commit_file_changes_since_latest_tag,
        post_tag_pr_numbers: a.post_tag_pr_numbers ?? [],
        post_tag_pr_details: a.post_tag_pr_details ?? "",
      },
    ),
  ]
  for finding in a.deterministic_findings {
    events = events
      + [
        fixture_event(
          "deterministic_finding",
          "deterministic",
          payload.finished_iso,
          {finding: finding},
        ),
      ]
  }
  for step in payload.execution ?? [] {
    const effect_evidence = release_step_side_effect_evidence(step.name)
    events = events
      + [
        fixture_event(
          "release_step_recorded",
          "deterministic",
          payload.finished_iso,
          {
            name: step.name,
            command: step.command,
            success: step.success,
            status: step.status,
            exit_code: step.exit_code,
            classification: step.classification ?? "",
            recovery_hint: step.recovery_hint ?? "",
            side_effects_known: effect_evidence.known,
            side_effects: effect_evidence.side_effects,
          },
        ),
      ]
  }
  return events
}

fn agent_artifact_snapshot(fs: HarnessFs, agent_detail: dict) -> dict {
  return artifact_snapshot(fs, agent_detail.artifacts ?? {}, ["draft_changelog_md"])
}

fn recovery_artifact_snapshot(fs: HarnessFs, step: dict) -> dict {
  return artifact_snapshot(fs, step.artifacts ?? {}, ["advice_md"])
}

fn agent_attempt_fixture_name(index: int, attempt: AgentReviewAttemptFixtureRecord) -> string {
  const name = attempt.name ?? ""
  if name != "" {
    return name
  }
  return "attempt-" + to_string(index + 1)
}

fn agent_attempt_fixture_event(
  index: int,
  attempt: AgentReviewAttemptFixtureRecord,
  ts: string,
) -> CrystallizationFixtureEvent {
  return fixture_event(
    "agent_review_attempt",
    "agent",
    ts,
    {
      index: index,
      name: agent_attempt_fixture_name(index, attempt),
      status: attempt.status ?? "",
      text: attempt.text ?? "",
      validation_findings: attempt.validation_findings ?? [],
      llm: attempt.llm ?? {},
      tools: attempt.tools ?? {},
    },
  )
}

fn invalid_agent_attempt_fixture_event(
  index: int,
  attempt: any,
  ts: string,
) -> CrystallizationFixtureEvent {
  const report = schema_report(attempt, AGENT_REVIEW_ATTEMPT_FIXTURE_RECORD_SCHEMA, false)
  return fixture_event(
    "agent_review_attempt_invalid",
    "agent",
    ts,
    {
      index: index,
      observed_type: type_of(attempt),
      reason: report.message ?? "agent review attempt record was missing or malformed",
      issues: report.issues ?? [],
    },
  )
}

pub fn agent_fixture_events(fs: HarnessFs, payload: dict) -> list<CrystallizationFixtureEvent> {
  const detail = payload.agent_review_detail ?? {}
  const attempts = detail.attempts ?? []
  const ts = payload.finished_iso
  let events = []
  if len(attempts) == 0 {
    events = events
      + [fixture_event("agent_review_skipped", "agent", ts, {reason: payload.agent_review})]
  }
  for {index, value} in attempts.enumerate() {
    const attempt = value
    if schema_is(attempt, AGENT_REVIEW_ATTEMPT_FIXTURE_RECORD_SCHEMA) {
      events = events + [agent_attempt_fixture_event(index, attempt, ts)]
    } else {
      events = events + [invalid_agent_attempt_fixture_event(index, attempt, ts)]
    }
  }
  if len(attempts) > 0 {
    events = events
      + [fixture_event("agent_review_artifacts", "agent", ts, agent_artifact_snapshot(fs, detail))]
  }
  for step in payload.execution ?? [] {
    if starts_with(step.name, "agent-recovery-advice-") {
      events = events
        + [
          fixture_event(
            "agent_recovery_advice",
            "agent",
            ts,
            {
              step_name: step.name,
              status: step.agent_status ?? "",
              text: step.stdout,
              llm: step.llm ?? {},
              tools: step.tools ?? {},
              artifacts: recovery_artifact_snapshot(fs, step),
            },
          ),
        ]
    }
  }
  return events
}

pub fn tool_observation_events(payload: dict) -> list<CrystallizationFixtureEvent> {
  const a = payload.analysis
  const ts = payload.started_iso
  const log_range = release_log_range_arg(a.latest_tag, a.pin_sha ?? "")
  let events = [
    shell_tool_event(ts, "git status --porcelain --untracked-files=normal", a.status),
    shell_tool_event(ts, "git diff HEAD --stat", a.diff_stat),
    shell_tool_event(ts, "git log --oneline --no-merges " + log_range, a.commits_since_latest_tag),
    shell_tool_event(
      ts,
      "git log --name-status --pretty=format:'commit %h %s' --no-merges " + log_range,
      a.commit_file_changes_since_latest_tag,
    ),
    read_file_tool_event(ts, "CHANGELOG.md", a.changelog_section),
    read_file_tool_event(ts, "CHANGELOG.md#Unreleased", a.changelog_unreleased_section ?? ""),
  ]
  for step in payload.execution ?? [] {
    const is_recovery = starts_with(step.name, "agent-recovery-advice-")
    const effect_evidence = release_step_side_effect_evidence(step.name)
    events = events
      + [
        tool_event(
          payload.finished_iso,
          if is_recovery {
            "agent"
          } else {
            "deterministic"
          },
          {
            tool: if is_recovery {
              "agent_loop"
            } else {
              "shell"
            },
            step_name: step.name,
            command: step.command,
            success: step.success,
            status: step.status,
            exit_code: step.exit_code,
            classification: step.classification ?? "",
            recovery_hint: step.recovery_hint ?? "",
            side_effects_known: effect_evidence.known,
            side_effects: effect_evidence.side_effects,
            stdout: step.stdout,
            stderr: step.stderr,
          },
        ),
      ]
  }
  return events
}

fn fixture_manifest(
  harness: {clock: HarnessClock, env: HarnessEnv},
  run_id: string,
  payload: ReleaseAuditReceipt,
  report_paths: ReleaseReportPaths,
  paths: CrystallizationFixturePaths,
) -> dict {
  return {
    schema_version: FIXTURE_SCHEMA_VERSION,
    kind: "release_harn_crystallization_input",
    generated_by: "release_harn.harn",
    generated_at: harness.clock.date_iso(),
    run_id: run_id,
    source_issue: env_str(harness.env, "HARN_EXT_RELEASE_SOURCE_ISSUE") ?? "",
    consumer_issue: env_str(harness.env, "HARN_EXT_RELEASE_CONSUMER_ISSUE") ?? "",
    source_artifacts: {
      release_audit_json: report_paths.json_path,
      release_audit_md: report_paths.md_path,
    },
    release: {
      repo: payload.analysis.repo,
      mode: payload.analysis.mode,
      mock: payload.analysis.mock,
      current_version: payload.analysis.current_version,
      next_version: payload.analysis.next_version,
      starting_branch: payload.analysis.branch,
      target_release_branch: payload.analysis.expected_branch,
      base_branch: payload.analysis.base_branch,
      latest_tag: payload.analysis.latest_tag,
    },
    files: {
      manifest_json: paths.manifest_json,
      release_run_json: paths.release_run_json,
      deterministic_events_jsonl: paths.deterministic_events_jsonl,
      agent_events_jsonl: paths.agent_events_jsonl,
      tool_observations_jsonl: paths.tool_observations_jsonl,
      readme_md: paths.readme_md,
    },
    semantics: {
      deterministic_events: "Facts and harness decisions emitted by release_harn.harn.",
      agent_events:
        "Model-authored audit, changelog synthesis, and recovery advice. Not deterministic truth.",
      tool_observations:
        "Shell/read/tool observations with stdout/stderr preserved for replay and audit.",
    },
  }
}

fn fixture_readme(fs: HarnessFs, payload: ReleaseAuditReceipt) -> string {
  const a = payload.analysis
  return fs.render_prompt(
    prompt_asset(fs, "release_fixture_readme.harn.prompt"),
    {
      repo: a.repo,
      mode: a.mode,
      mock: a.mock,
      current_version: a.current_version,
      next_version: a.next_version,
      branch: a.branch,
      expected_branch: a.expected_branch,
      latest_tag: a.latest_tag,
    },
  )
}

pub fn write_crystallization_fixture(
  harness: Harness,
  run_id: string,
  payload: ReleaseAuditReceipt,
  report_paths: ReleaseReportPaths,
) -> CrystallizationFixturePaths {
  const paths = crystallization_fixture_paths(harness.fs, run_id)
  harness.fs.mkdir(paths.out_dir, true)
  harness.fs.write_text(
    paths.release_run_json,
    json_stringify(
      {schema_version: FIXTURE_SCHEMA_VERSION, kind: "release_harn_run", payload: payload},
    )
      + "\n",
  )
  write_jsonl(harness.fs, paths.deterministic_events_jsonl, deterministic_fixture_events(payload))
  write_jsonl(harness.fs, paths.agent_events_jsonl, agent_fixture_events(harness.fs, payload))
  write_jsonl(harness.fs, paths.tool_observations_jsonl, tool_observation_events(payload))
  harness.fs.write_text(paths.readme_md, fixture_readme(harness.fs, payload))
  harness.fs.write_text(
    paths.manifest_json,
    json_stringify(
      fixture_manifest(
        {clock: harness.clock, env: harness.env},
        run_id,
        payload,
        report_paths,
        paths,
      ),
    )
      + "\n",
  )
  return {
    out_dir: paths.out_dir,
    manifest_json: paths.manifest_json,
    release_run_json: paths.release_run_json,
    deterministic_events_jsonl: paths.deterministic_events_jsonl,
    agent_events_jsonl: paths.agent_events_jsonl,
    tool_observations_jsonl: paths.tool_observations_jsonl,
    readme_md: paths.readme_md,
  }
}
