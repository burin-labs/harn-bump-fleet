import { read_json_typed_result, write_json } from "std/fs"

/** Workflow inputs bound by the pre-tag candidate archive gate. */
pub type CandidateArchiveGateConfig = {
  workflow: string,
  event: string,
  policy_ref: string,
  expected_policy_sha: string,
  source_ref: string,
  expected_source_sha: string,
  candidate_only: bool,
  runner_profile: string,
  targets: string,
  completion_timeout_ms: int,
  completion_interval_ms: int,
  transient_view_retry_max_attempts: int,
  transient_view_retry_base_ms: int,
  transient_view_retry_cap_ms: int,
}

pub type CandidateArchiveGateStartedEvent = {
  workflow: string,
  event: string,
  policy_ref: string,
  expected_policy_sha: string,
  source_ref: string,
  expected_source_sha: string,
  candidate_only: bool,
  runner_profile: string,
  targets: string,
  completion_timeout_ms: int,
  completion_interval_ms: int,
  transient_view_retry_max_attempts: int,
  transient_view_retry_base_ms: int,
  transient_view_retry_cap_ms: int,
  run_id: int,
  run_url: string,
  observed_event: string,
  observed_head_branch: string,
  observed_head_sha: string,
  reused: bool,
  archive_digests?: dict,
}

/** Durable exact-run identity for the pre-tag candidate archive gate. */
pub type CandidateArchiveReceipt = {
  schema_version: "release_harn.candidate_archive.v1",
  slug: string,
  workflow: string,
  event: string,
  policy_ref: string,
  expected_policy_sha: string,
  source_ref: string,
  expected_source_sha: string,
  run_id: int,
  run_url: string,
  observed_event: string,
  observed_head_branch: string,
  observed_head_sha: string,
  archive_digests?: dict,
  created_at: string,
}

pub fn candidate_archive_receipt_path(root: string, source_sha: string) -> string {
  const sha = lowercase(trim(source_sha))
  if len(regex_captures("^[0-9a-f]{40}$", sha)) == 0 {
    throw "candidate archive receipt source SHA must be a full Git commit"
  }
  return path_join(root, "candidate-archive", sha + ".json")
}

pub fn candidate_archive_receipt_read(fs: HarnessFs, path: string) -> CandidateArchiveReceipt? {
  const result = read_json_typed_result<CandidateArchiveReceipt>(
    fs,
    path,
    schema_of(CandidateArchiveReceipt),
  )
  return if is_ok(result) {
    unwrap(result)
  } else {
    nil
  }
}

pub fn candidate_archive_receipt_matches(
  receipt: CandidateArchiveReceipt,
  slug: string,
  config: CandidateArchiveGateConfig,
) -> bool {
  return receipt.slug == slug
    && receipt.workflow == config.workflow
    && receipt.event == config.event
    && receipt.policy_ref == config.policy_ref
    && receipt.expected_policy_sha
    == lowercase(
    config.expected_policy_sha,
  )
    && receipt.source_ref == config.source_ref
    && receipt.expected_source_sha
    == lowercase(
    config.expected_source_sha,
  )
    && receipt.observed_event == config.event
    && receipt.observed_head_branch == config.policy_ref
    && receipt.observed_head_sha
    == lowercase(
    config.expected_policy_sha,
  )
}

/** Successful receipts are write-once; callers must refuse to replace them. */
pub fn candidate_archive_receipt_overwrite_allowed(prior: CandidateArchiveReceipt?) -> bool {
  return prior == nil
}

/** Atomically persist the run identity before any long polling begins. */
pub fn candidate_archive_receipt_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  path: string,
  slug: string,
  started: CandidateArchiveGateStartedEvent,
  created_at: string,
) -> CandidateArchiveReceipt {
  let receipt: CandidateArchiveReceipt = {
    schema_version: "release_harn.candidate_archive.v1",
    slug: slug,
    workflow: started.workflow,
    event: started.event,
    policy_ref: started.policy_ref,
    expected_policy_sha: lowercase(started.expected_policy_sha),
    source_ref: started.source_ref,
    expected_source_sha: lowercase(started.expected_source_sha),
    run_id: started.run_id,
    run_url: started.run_url,
    observed_event: started.observed_event,
    observed_head_branch: started.observed_head_branch,
    observed_head_sha: lowercase(started.observed_head_sha),
    created_at: created_at,
  }
  if started.archive_digests != nil {
    receipt = receipt + {archive_digests: started.archive_digests}
  }
  harness.fs.mkdir(dirname(path), true)
  const temporary = path + ".tmp-" + harness.random.uuid_v7()
  write_json(harness.fs, temporary, receipt, {pretty: true})
  harness.fs.rename(temporary, path)
  return receipt
}
