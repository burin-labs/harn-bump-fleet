pub type ReleaseWatchPullRequest = {
  number: int,
  merged: bool,
  merged_at: string?,
  merge_commit_oid: string?,
  github_state: string,
  mergeable_state: string,
  in_merge_queue: bool,
  auto_merge_armed: bool,
  queue_membership?: {entry: {position?: int, state?: string, ...rest}?, ...rest},
  ...rest,
}

/** Classify a canonical typed PR view during publish watch. Only `rearm` writes. */
pub fn release_pr_watchdog_decision(pr: ReleaseWatchPullRequest?) -> dict {
  if pr == nil {
    return {action: "skip", reason: "missing_pull_request"}
  }
  if pr.merged || pr.github_state == "merged" {
    return {
      action: "done",
      reason: "release_pr_merged",
      number: pr.number,
      merge_sha: pr.merge_commit_oid,
      merged_at: pr.merged_at,
    }
  }
  if pr.github_state != "open" {
    return {
      action: "skip",
      reason: "release_pr_not_open",
      state: pr.github_state,
      number: pr.number,
    }
  }
  if pr.in_merge_queue {
    return {
      action: "ok",
      reason: "release_pr_in_merge_queue",
      number: pr.number,
      merge_state: pr.mergeable_state,
      queue_state: pr.queue_membership?.entry?.state ?? "",
      queue_position: pr.queue_membership?.entry?.position,
    }
  }
  if pr.auto_merge_armed {
    return {
      action: "ok",
      reason: "release_pr_auto_merge_armed",
      number: pr.number,
      merge_state: pr.mergeable_state,
    }
  }
  return {
    action: "rearm",
    reason: "release_pr_open_without_queue_or_auto_merge",
    number: pr.number,
    merge_state: pr.mergeable_state,
  }
}
