import { gh_pr_number } from "./github_cli"

const RELEASE_PR_WATCHDOG_QUERY: string = "query($owner:String!, $repo:String!, $number:Int!){ repository(owner:$owner, name:$repo){ pullRequest(number:$number){ number state mergeStateStatus isInMergeQueue mergeQueueEntry{ position state estimatedTimeToMerge } mergedAt mergeCommit{ oid } autoMergeRequest{ enabledAt mergeMethod } } } }"

fn github_slug_parts(slug: string) -> dict? {
  const parts = split(to_string(slug), "/")
  if len(parts) != 2 || trim(parts[0] ?? "") == "" || trim(parts[1] ?? "") == "" {
    return nil
  }
  return {owner: parts[0], repo: parts[1]}
}

/** Build a `gh api graphql` argv that reads release-PR queue/auto-merge state. */
pub fn release_pr_watchdog_query_args(slug: string, pr_ref) -> list? {
  const parts = github_slug_parts(slug)
  const number = gh_pr_number(pr_ref)
  if parts == nil || number == nil {
    return nil
  }
  return [
    "api",
    "graphql",
    "-f",
    "owner=${parts.owner}",
    "-f",
    "repo=${parts.repo}",
    "-F",
    "number=${number}",
    "-f",
    "query=${RELEASE_PR_WATCHDOG_QUERY}",
  ]
}

fn release_pr_from_watchdog_payload(payload: dict) -> dict? {
  if payload?.data?.repository?.pullRequest != nil {
    return payload.data.repository.pullRequest
  }
  if payload?.repository?.pullRequest != nil {
    return payload.repository.pullRequest
  }
  if payload?.pullRequest != nil {
    return payload.pullRequest
  }
  if payload?.number != nil || payload?.state != nil {
    return payload
  }
  return nil
}

/** Classify release-PR state during publish watch. Only `rearm` performs a GitHub write. */
pub fn release_pr_watchdog_decision(payload: dict) -> dict {
  const pr = release_pr_from_watchdog_payload(payload)
  if pr == nil {
    return {action: "skip", reason: "missing_pull_request"}
  }
  const state = to_string(pr.state ?? "")
  if state == "MERGED" {
    const merge_sha = lowercase(trim(pr?.mergeCommit?.oid ?? ""))
    if len(regex_captures("^[0-9a-f]{40}$", merge_sha)) == 0 {
      return {action: "skip", reason: "release_pr_merge_commit_missing", number: pr.number}
    }
    return {
      action: "done",
      reason: "release_pr_merged",
      number: pr.number,
      merge_sha: merge_sha,
      merged_at: trim(pr?.mergedAt ?? ""),
    }
  }
  if state != "OPEN" {
    return {action: "skip", reason: "release_pr_not_open", state: state, number: pr.number}
  }
  const queued = (pr.isInMergeQueue ?? false) || pr.mergeQueueEntry != nil
  if queued {
    return {
      action: "ok",
      reason: "release_pr_in_merge_queue",
      number: pr.number,
      merge_state: pr.mergeStateStatus ?? "",
      queue_state: pr.mergeQueueEntry?.state ?? "",
      queue_position: pr.mergeQueueEntry?.position,
    }
  }
  if pr.autoMergeRequest != nil {
    return {
      action: "ok",
      reason: "release_pr_auto_merge_armed",
      number: pr.number,
      merge_state: pr.mergeStateStatus ?? "",
    }
  }
  return {
    action: "rearm",
    reason: "release_pr_open_without_queue_or_auto_merge",
    number: pr.number,
    merge_state: pr.mergeStateStatus ?? "",
  }
}
