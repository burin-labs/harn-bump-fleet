import { GitPushReceipt, GitRemoteRef, git_push } from "std/git"

/**
 * The exact OID a ref-plumbing push is allowed to replace.
 *
 * `std/git::git_push` takes this shape untyped. Naming it here keeps the
 * fleet's own signatures closed; the type belongs in `std/git` once that
 * parameter is typed upstream.
 */
pub type GitRefLease = {ref: string, expected_oid: string}

/**
 * Push a refspec whose payload the remote can already reach, or a deletion.
 *
 * Ref plumbing names an OID directly: archive an attempt under a new name,
 * point a certification branch at a published candidate, delete a transient
 * ref. No local work travels, so there is nothing for a pre-push hook to
 * validate — and a hook has no way to know that. It answers "what am I
 * pushing" with the checkout's own branch and tracking state, which for these
 * operations is unrelated: it resolves `@{upstream}`, walks `HEAD` back to a
 * base branch, and gates the push on that range's format, lint, and
 * signatures. An operator's work-in-progress branch then decides whether an
 * unrelated ref can be renamed.
 *
 * The hook is right to run for a push that delivers new commits. Those keep
 * `git_push`.
 *
 * `lease` names the exact OID the push may replace. It travels with the hook
 * skip as of Harn v0.10.55: burin-labs/harn#6199 gave the reviewed-dispatch
 * argv shape one structural owner, where two checks had previously matched it
 * by position and stopped recognizing it once `--no-verify` shifted the lease
 * one token (burin-labs/harn#6189). Skipping the hook does not widen what
 * reaches the remote — the lease still pins the OID, and a pre-push hook is
 * the checkout's policy about its own commits, not the remote's about its refs.
 */
pub fn git_push_ref_plumbing(
  process: HarnessProcess,
  remote: string,
  refspec: string,
  repo: string,
  lease: GitRefLease? = nil,
) -> GitPushReceipt {
  return git_push(process, remote, refspec, repo, lease, {no_verify: true})
}

/** Resolve one unpeeled remote branch exactly; ambiguity fails closed. */
pub fn remote_branch_oid(refs: list<GitRemoteRef>, branch: string) -> string {
  const expected = "refs/heads/${trim(branch)}"
  let matches = []
  for remote_ref in refs {
    if !remote_ref.peeled && remote_ref.ref == expected {
      matches = matches + [lowercase(trim(remote_ref.oid))]
    }
  }
  return if len(matches) == 1 {
    matches[0]
  } else {
    ""
  }
}

/** Parse GitHub remotes in SSH or HTTPS form into `owner/repo`. */
pub fn remote_url_to_slug(raw: string?) -> string? {
  const ssh = regex_captures("^git@github\\.com:([^/]+)/([^/]+?)(?:\\.git)?$", raw ?? "")
  if ssh != nil && len(ssh) > 0 {
    const g = ssh[0].groups
    return "${g[0]}/${g[1]}"
  }
  const https = regex_captures("^https?://github\\.com/([^/]+)/([^/]+?)(?:\\.git)?/?$", raw ?? "")
  if https != nil && len(https) > 0 {
    const g = https[0].groups
    return "${g[0]}/${g[1]}"
  }
  return nil
}

/** A measured checkout-origin identity, compared with a requested GitHub repository. */
pub type GitRemoteSlugCheck = {
  ok: bool,
  expected_slug: string,
  observed_slug: string,
  remote_url: string,
  detail: string,
}

/**
 * Compare a positively read origin URL with the repository a mutation would target.
 *
 * Callers must supply `readable = false` when the origin read failed. An unreadable
 * or unparseable remote is unknown, never permission to mutate either repository.
 */
pub fn remote_slug_check(
  expected_slug: string,
  remote_url: string?,
  readable: bool = true,
) -> GitRemoteSlugCheck {
  const expected = trim(expected_slug)
  const url = trim(remote_url ?? "")
  const observed = if readable {
    remote_url_to_slug(url) ?? ""
  } else {
    ""
  }
  if !readable {
    return {
      ok: false,
      expected_slug: expected,
      observed_slug: "",
      remote_url: url,
      detail: "could not read checkout origin; expected ${expected}",
    }
  }
  if observed == "" {
    return {
      ok: false,
      expected_slug: expected,
      observed_slug: "",
      remote_url: url,
      detail: "checkout origin is not an unambiguous GitHub repository; expected ${expected}",
    }
  }
  if observed != expected {
    return {
      ok: false,
      expected_slug: expected,
      observed_slug: observed,
      remote_url: url,
      detail: "checkout origin is ${observed}, expected ${expected}",
    }
  }
  return {
    ok: true,
    expected_slug: expected,
    observed_slug: observed,
    remote_url: url,
    detail: "checkout origin matches ${expected}",
  }
}

/** Inputs measured from the local remote that a cross-repository mutation will use. */
pub type GitRemoteMutationIdentityInput = {
  expected_slug: string,
  fetch_url: string?,
  fetch_readable: bool,
  push_urls: list<string>,
  push_readable: bool,
}

/**
 * Prove that reads and writes through `origin` address one requested repository.
 *
 * Git may fan a push out to every configured push URL, so more than one push URL
 * is refused even when each happens to parse to the same slug.
 */
pub fn remote_mutation_slug_check(input: GitRemoteMutationIdentityInput) -> GitRemoteSlugCheck {
  const fetch = remote_slug_check(input.expected_slug, input.fetch_url, input.fetch_readable)
  if !fetch.ok {
    return fetch
  }
  if !input.push_readable {
    return remote_slug_check(input.expected_slug, "", false)
  }
  const pushes = input.push_urls.map({ value -> return trim(value) }).filter(
    { value -> return value != "" },
  )
    .to_list()
  if len(pushes) != 1 {
    return {
      ok: false,
      expected_slug: trim(input.expected_slug),
      observed_slug: "",
      remote_url: join(pushes, "\n"),
      detail:
        "checkout origin has ${len(pushes)} push URLs; expected exactly one for ${trim(input.expected_slug)}",
    }
  }
  const push = remote_slug_check(input.expected_slug, pushes[0], true)
  if !push.ok {
    return {
      ok: false,
      expected_slug: push.expected_slug,
      observed_slug: push.observed_slug,
      remote_url: push.remote_url,
      detail: "checkout origin push URL does not match: ${push.detail}",
    }
  }
  return fetch
}

/**
 * Build a `git log` range as argv parts, capped at a specific upper ref.
 *
 * Used by the release harness so the changelog draft / commit evidence
 * walk only sees commits up to a frozen pin SHA — commits that land on
 * the base branch after the pin was captured are excluded.
 *
 * - `latest_tag` empty  → no lower bound; just walk back from `upper_ref`.
 * - `upper_ref`  empty  → defaults to `HEAD` for legacy callers.
 */
pub fn release_log_range_args(latest_tag: string, upper_ref: string?) -> list<string> {
  const upper = if trim(upper_ref ?? "") == "" {
    "HEAD"
  } else {
    upper_ref ?? "HEAD"
  }
  if latest_tag == "" {
    return [upper, "--max-count=50"]
  }
  return ["${latest_tag}..${upper}", "--max-count=80"]
}

/** Shell-string form of `release_log_range_args` for display/audit text. */
pub fn release_log_range_arg(latest_tag: string, upper_ref: string?) -> string {
  return join(release_log_range_args(latest_tag, upper_ref), " ")
}
