/** Parse GitHub remotes in SSH or HTTPS form into `owner/repo`. */
pub fn remote_url_to_slug(raw: string?) -> string? {
  const ssh = regex_captures("^git@github\\.com:([^/]+)/([^/]+?)(?:\\.git)?$", raw ?? "")
  if ssh != nil && len(ssh) > 0 {
    const g = ssh[0].groups
    return "${g[0]}/${g[1]}"
  }
  const https = regex_captures("^https?://github\\.com/([^/]+)/([^/]+?)(?:\\.git)?/?$", raw ?? "")
  if https != nil && len(https) > 0 {
    const g = https[0].groups
    return "${g[0]}/${g[1]}"
  }
  return nil
}

/**
 * Build a `git log` range as argv parts, capped at a specific upper ref.
 *
 * Used by the release harness so the changelog draft / commit evidence
 * walk only sees commits up to a frozen pin SHA — commits that land on
 * the base branch after the pin was captured are excluded.
 *
 * - `latest_tag` empty  → no lower bound; just walk back from `upper_ref`.
 * - `upper_ref`  empty  → defaults to `HEAD` for legacy callers.
 */
pub fn release_log_range_args(latest_tag: string, upper_ref: string?) -> list<string> {
  const upper = if trim(upper_ref ?? "") == "" {
    "HEAD"
  } else {
    upper_ref ?? "HEAD"
  }
  if latest_tag == "" {
    return [upper, "--max-count=50"]
  }
  return ["${latest_tag}..${upper}", "--max-count=80"]
}

/** Shell-string form of `release_log_range_args` for display/audit text. */
pub fn release_log_range_arg(latest_tag: string, upper_ref: string?) -> string {
  return join(release_log_range_args(latest_tag, upper_ref), " ")
}
