import { FleetRepository } from "./fleet_manifest"

pub type FleetCheckoutResult = {
  slug: string,
  directory: string,
  status: "cloned" | "present" | "failed",
  detail: string,
}

pub type FleetCheckoutAdapter = {
  clone: fn(string, string, string) -> {success: bool, stdout?: string, stderr?: string},
}

fn production_adapter(process: HarnessProcess) -> FleetCheckoutAdapter {
  return {
    clone: fn(slug, branch, destination) { return process.run(
      {
        program: "git",
        args: [
          "clone",
          "--quiet",
          "--filter=blob:none",
          "--branch",
          branch,
          "https://github.com/${slug}.git",
          destination,
        ],
      },
    ) },
  }
}

/**
 * Materialize the manifest-owned fleet into one explicit root.
 *
 * Repository slugs and directories have already crossed the typed manifest
 * boundary, and git receives them as argv rather than shell source. Existing
 * directories are never mutated: the canonical bump controller validates
 * their remotes and workflow contracts before it uses them.
 */
pub fn materialize_fleet_checkouts(
  harness: {fs: HarnessFs, process: HarnessProcess},
  repositories: list<FleetRepository>,
  branch: string,
  root: string,
  adapter: FleetCheckoutAdapter? = nil,
) -> list<FleetCheckoutResult> {
  if trim(root) == "" || !starts_with(root, "/") {
    throw "fleet checkout root must be an absolute path"
  }
  harness.fs.mkdir(root, true)
  const git = adapter ?? production_adapter(harness.process)
  let results = []
  for repo in repositories {
    const destination = path_join(root, repo.directory)
    if harness.fs.exists(destination) {
      results = results
        + [
        {slug: repo.slug, directory: destination, status: "present", detail: "already exists"},
      ]
      continue
    }
    const cloned = git.clone(repo.slug, branch, destination)
    const detail = trim(cloned.stderr ?? cloned.stdout ?? "")
    results = results
      + [
      {
        slug: repo.slug,
        directory: destination,
        status: if cloned.success {
          "cloned"
        } else {
          "failed"
        },
        detail: detail,
      },
    ]
    if !cloned.success {
      break
    }
  }
  return results
}
