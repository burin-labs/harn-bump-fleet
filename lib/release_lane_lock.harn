import {
  github_actions_run,
  github_claim_ref,
  github_connector_options,
  github_release_ref,
} from "./github"
import {
  GithubClientOptions,
  GithubRefClaim,
  GithubRefRelease,
} from "harn-github-connector/default"

/**
 * The release lane, asked one scope wider than the machine.
 *
 * `release_owner_guard` serializes releases on one host, which is all a
 * `std/host_lease` can do: a hosted runner and a laptop each acquire it
 * happily. Every other guard in the release path detects a collision only
 * after a candidate exists — the immutable attempt ref, the write-once
 * certification branch, the tag — so each detection costs a full build first.
 * v0.10.53 spent a 63-minute hosted run building a candidate a local session
 * had already superseded, and neither run could have known.
 *
 * `POST /git/refs` is the primitive GitHub serializes across machines. One ref
 * per version, carrying a payload commit that says who holds it, turns "you
 * will collide" into something knowable at minute one.
 *
 * The claim is now a hard preflight gate. The advisory phase observed two real
 * cross-host collisions (v0.10.53 and v0.10.66); the latter allowed a hosted
 * recovery to spend 19 minutes before another host moved its PR head. A live
 * release that does not own this lane cannot safely publish mutable handoff
 * state, even when its immutable artifact ref remains sound.
 */
pub type ReleaseLaneHolder = {
  run_id: string,
  host: string,
  mode: string,
  started_at: string,
  /** Exact hosted workflow identity, absent for operator-driven releases. */
  workflow_run_id?: int?,
  workflow_run_attempt?: int?,
}

pub type ReleaseLaneState = "acquired" | "held" | "abandoned" | "stale" | "unreadable"

/**
 * One lane claim, named rather than positional.
 *
 * `now` is a parameter and not a clock read because every state this function
 * reports is a statement about elapsed time, and a caller that cannot choose
 * "now" cannot test the ones that matter.
 */
pub type ReleaseLaneRequest = {
  slug: string,
  base_branch: string,
  version: string,
  holder: ReleaseLaneHolder,
  now: string,
  // Endpoint identity, defaulted from the fleet's connector options. Named here
  // so a test can answer these requests itself: the reclaim is four round trips
  // deep, and none of them is reachable from the pure state function.
  options?: GithubClientOptions,
}

pub type ReleaseLaneClaim = {
  state: ReleaseLaneState,
  version: string,
  ref: string,
  oid: string,
  holder: ReleaseLaneHolder?,
  held_for_minutes: int,
  message: string,
  // Acquired by taking back a lane this host had abandoned, rather than by
  // finding it free. Worth a line: it is how an operator learns that a previous
  // run of this version died without getting to say so.
  reclaimed?: bool,
}

pub type ReleaseLaneFinishReason = "released" \
  | "already_absent" \
  | "held_by_another" \
  | "not_owned" \
  | "unreadable"

/** Durable, operator-readable outcome of attempting to finish one owned lane. */
pub type ReleaseLaneFinish = {
  attempted: bool,
  released: bool,
  reason: ReleaseLaneFinishReason,
  version: string,
  ref: string,
  oid: string,
}

pub type ReleaseLaneFinishPolicy = {max_attempts?: int, base_delay_ms?: int, cap_delay_ms?: int}

/**
 * How long a lane may be held before the claim reports it as stale.
 *
 * Sized against the work, not the clock: a full hosted release is roughly an
 * hour, and the macOS certification lane alone has waited 78 minutes for a
 * runner. Three hours is past anything a live release explains.
 */
const STALE_AFTER_MINUTES = 180

/**
 * Hosted prepare/ship claims bind `GITHUB_RUN_ID` from this repository's
 * hosted-release workflow. A later claimant on another hostname can prove
 * that holder is gone only by reading that exact run.
 */
const HOSTED_RELEASE_LANE_WORKFLOW_REPO = "burin-labs/harn-bump-fleet"

/**
 * Not `refs/heads/`. A lock under `refs/heads/` is a branch: it shows up in
 * branch pickers and stale-branch reports, and it inherits whatever ruleset
 * governs branch names in the repository. A ref outside the branch namespace
 * is still atomic to create and still visible to `ls-remote`, and it is
 * unmistakably not somewhere to merge.
 */
pub fn release_lane_ref(version: string) -> string {
  return "refs/release-lane/v" + trim(version)
}

/**
 * The payload's first line, which is the only part a contended caller reads.
 *
 * `holder_headline` is exactly one line, so everything a loser needs to name
 * the winner has to fit on it. Keyed fields rather than prose because this is
 * parsed back by the next caller, not only read by a person.
 */
pub fn release_lane_headline(version: string, holder: ReleaseLaneHolder) -> string {
  const base = "release-lane v${trim(version)} run=${trim(holder.run_id)} host=${trim(holder.host)}"
    + " mode=${trim(holder.mode)} started=${trim(holder.started_at)}"
  const workflow_run_id = holder.workflow_run_id ?? 0
  const workflow_run_attempt = holder.workflow_run_attempt ?? 0
  if workflow_run_id <= 0 && workflow_run_attempt <= 0 {
    return base
  }
  if workflow_run_id <= 0 || workflow_run_attempt <= 0 {
    throw "hosted release lane holder requires both workflow run ID and attempt"
  }
  return base
    + " workflow_run=${to_string(workflow_run_id)}"
    + " workflow_attempt=${to_string(workflow_run_attempt)}"
}

/** Recover a holder from a headline this module wrote, or nil for anything else. */
pub fn parse_release_lane_headline(headline: string) -> ReleaseLaneHolder? {
  const hosted = regex_captures(
    "^release-lane v[^ ]+ run=([^ ]*) host=([^ ]*) mode=([^ ]*) started=([^ ]*) workflow_run=([1-9][0-9]*) workflow_attempt=([1-9][0-9]*)$",
    trim(headline),
  )
  if len(hosted) == 1 {
    const groups = hosted[0].groups
    return {
      run_id: groups[0],
      host: groups[1],
      mode: groups[2],
      started_at: groups[3],
      workflow_run_id: to_int(groups[4]),
      workflow_run_attempt: to_int(groups[5]),
    }
  }
  const captured = regex_captures(
    "^release-lane v[^ ]+ run=([^ ]*) host=([^ ]*) mode=([^ ]*) started=([^ ]*)$",
    trim(headline),
  )
  if len(captured) != 1 {
    return nil
  }
  const groups = captured[0].groups
  return {run_id: groups[0], host: groups[1], mode: groups[2], started_at: groups[3]}
}

/**
 * Age in whole minutes, or zero when either end is unreadable.
 *
 * `date_parse` throws on anything it does not recognize, and the earlier end of
 * this span comes out of a commit message in another repository — written by a
 * run this one has never met, or by something else entirely. An advisory is not
 * worth crashing a release for, so an unreadable timestamp reports no age
 * rather than a wrong one.
 */
fn minutes_between(earlier: string, later: string) -> int {
  const started = try {
    to_int(date_parse(trim(earlier)))
  } catch (_e) {
    nil
  }
  const now = try {
    to_int(date_parse(trim(later)))
  } catch (_e) {
    nil
  }
  if started == nil || now == nil || now < started {
    return 0
  }
  return (now - started) / 60
}

fn held_message(
  version: string,
  holder: ReleaseLaneHolder?,
  minutes: int,
  state: ReleaseLaneState,
) -> string {
  if holder == nil {
    return "another release of v${version} holds the lane, with no readable payload"
  }
  if state == "abandoned" {
    return "the lane for v${version} is still held by this host's run ${holder.run_id}"
      + " (${holder.mode}), started ${minutes}m ago"
  }
  const age = if state == "stale" {
    "started ${minutes}m ago, past the ${STALE_AFTER_MINUTES}m mark"
  } else {
    "started ${minutes}m ago"
  }
  return "another release of v${version} holds the lane: run ${holder.run_id} on ${holder.host}"
    + " (${holder.mode}), ${age}"
}

/**
 * Read one claim outcome as a lane state.
 *
 * Pure, and separate from the request, because the interesting cases are the
 * ones a live GitHub will not produce on demand: a holder whose payload was
 * collected, a headline written by something else, a lane held long enough to
 * be abandoned.
 *
 * `abandoned` is the case a timeout alone would take three hours to reach. The
 * caller holds this host's release lease, so no other release process is
 * running here; a lane still claimed by this host therefore belongs to a run
 * that is already gone. That is knowable immediately, and it is the state a
 * retry after a failed release lands in — which is why `claim_release_lane`
 * takes it back rather than reporting it. Reaching an operator with this state
 * means the reclaim itself could not finish.
 */
pub fn release_lane_claim_state(
  claim: GithubRefClaim,
  version: string,
  now: string,
  this_host: string = "",
) -> ReleaseLaneClaim {
  if claim.claimed {
    return {
      state: "acquired",
      version: version,
      ref: claim.ref,
      oid: claim.oid,
      holder: nil,
      held_for_minutes: 0,
      message: "holds the release lane for v${version}",
    }
  }
  const holder = parse_release_lane_headline(claim.holder_headline)
  const minutes = if holder == nil {
    0
  } else {
    minutes_between(holder.started_at, now)
  }
  const state: ReleaseLaneState = if holder == nil {
    "held"
  } else if trim(this_host) != ""
    && holder.host == trim(this_host) {
    "abandoned"
  } else if minutes >= STALE_AFTER_MINUTES {
    "stale"
  } else {
    "held"
  }
  return {
    state: state,
    version: version,
    ref: claim.ref,
    oid: claim.oid,
    holder: holder,
    held_for_minutes: minutes,
    message: held_message(version, holder, minutes, state),
  }
}

/**
 * Claim the lane for one version, reporting whoever already holds it.
 *
 * A claim that cannot be made at all is `unreadable`, never `acquired`: an
 * advisory that goes quiet when GitHub is unreachable reads exactly like an
 * uncontended lane, which is the one thing it must not do.
 *
 * An `abandoned` lane is taken back rather than reported. A hosted holder
 * whose exact workflow run has completed is the same fact on another
 * hostname: that runner is gone, and waiting out `STALE_AFTER_MINUTES` only
 * papers over a leaked terminal cleanup. The exact-OID delete still refuses
 * if the lane changed hands.
 */
pub fn claim_release_lane(harness: Harness, request: ReleaseLaneRequest) -> ReleaseLaneClaim {
  const first = claim_release_lane_once(harness, request)
  const hosted_gone = first.state == "held" && hosted_workflow_run_is_gone(harness, first, request)
  if first.state != "abandoned" && !hosted_gone {
    return first
  }
  const freed = release_release_lane(
    harness,
    request.slug,
    request.version,
    first.oid,
    request.options ?? github_connector_options(),
  )
  // `held_by_another` means the lane changed hands between the read and the
  // delete, so the reclaim is off and whatever the first claim reported stands.
  if freed == nil || !(freed.released || freed.reason == "already_absent") {
    return first
  }
  const second = claim_release_lane_once(harness, request)
  if second.state != "acquired" {
    return second
  }
  const prior = first.holder?.run_id ?? "(unnamed)"
  const source = if hosted_gone {
    "terminated hosted run ${prior}"
  } else {
    "this host's abandoned run ${prior}"
  }
  return {
    state: "acquired",
    version: second.version,
    ref: second.ref,
    oid: second.oid,
    holder: nil,
    held_for_minutes: 0,
    message: "reclaimed the release lane for v${second.version} from ${source}",
    reclaimed: true,
  }
}

fn claim_release_lane_once(harness: Harness, request: ReleaseLaneRequest) -> ReleaseLaneClaim {
  const version = request.version
  const ref = release_lane_ref(version)
  const claimed = github_claim_ref(
    harness,
    request.slug,
    ref,
    {
      payload: {
        message: release_lane_headline(version, request.holder),
        base_ref: "refs/heads/" + trim(request.base_branch),
      },
    },
    request.options ?? github_connector_options(),
  )
  if is_err(claimed) {
    return {
      state: "unreadable",
      version: version,
      ref: ref,
      oid: "",
      holder: nil,
      held_for_minutes: 0,
      message: "could not read the release lane for v${version}: "
        + to_string(unwrap_err(claimed)?.message ?? unwrap_err(claimed)),
    }
  }
  return release_lane_claim_state(unwrap(claimed), version, request.now, request.holder.host)
}

/** Let go of a lane this run still holds. A lane held by anyone else is left alone. */
pub fn release_release_lane(
  harness: Harness,
  slug: string,
  version: string,
  oid: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubRefRelease? {
  if trim(oid) == "" {
    return nil
  }
  const released = github_release_ref(harness, slug, release_lane_ref(version), oid, options)
  if is_err(released) {
    return nil
  }
  return unwrap(released)
}

/**
 * Finish only a lane represented by this run's acquired claim.
 *
 * This is the single normalization boundary for terminal cleanup. It preserves
 * the connector's exact-OID lease, treats an already absent ref as successfully
 * finished, and turns connector failure into data so cleanup cannot hide the
 * release's primary verdict.
 */
pub fn finish_release_lane(
  harness: Harness,
  slug: string,
  claim: ReleaseLaneClaim?,
  options: GithubClientOptions = github_connector_options(),
) -> ReleaseLaneFinish {
  if claim == nil || claim.state != "acquired" || trim(claim.oid) == "" {
    return {
      attempted: false,
      released: false,
      reason: "not_owned",
      version: claim?.version ?? "",
      ref: claim?.ref ?? "",
      oid: claim?.oid ?? "",
    }
  }
  const result = try {
    release_release_lane(harness, slug, claim.version, claim.oid, options)
  } catch (_e) {
    nil
  }
  if result == nil {
    return {
      attempted: true,
      released: false,
      reason: "unreadable",
      version: claim.version,
      ref: claim.ref,
      oid: claim.oid,
    }
  }
  return {
    attempted: true,
    released: result.released || result.reason == "already_absent",
    reason: result.reason,
    version: claim.version,
    ref: claim.ref,
    oid: claim.oid,
  }
}

/**
 * Terminal cleanup with bounded retry of transient `unreadable` outcomes.
 *
 * A successful release that fails one GitHub read at the defer is how a
 * version gets wedged for the full staleness window. Repeating the exact-OID
 * finish is cheap and cannot delete a replacement holder.
 */
pub fn finish_release_lane_durable(
  harness: Harness,
  slug: string,
  claim: ReleaseLaneClaim?,
  options: GithubClientOptions = github_connector_options(),
  policy: ReleaseLaneFinishPolicy = {},
) -> ReleaseLaneFinish {
  const max_attempts = max(1, policy.max_attempts ?? 4)
  const base_delay_ms = max(0, policy.base_delay_ms ?? 500)
  const cap_delay_ms = max(base_delay_ms, policy.cap_delay_ms ?? 4000)
  let attempt = 0
  let last = finish_release_lane(harness, slug, claim, options)
  while last.reason == "unreadable" && attempt + 1 < max_attempts {
    attempt = attempt + 1
    let delay_ms = base_delay_ms
    for _ in range(0, attempt - 1) {
      delay_ms = min(delay_ms * 2, cap_delay_ms)
    }
    if delay_ms > 0 {
      harness.clock.sleep_ms(delay_ms)
    }
    last = finish_release_lane(harness, slug, claim, options)
  }
  return last
}

fn days_in_month(year: int, month: int) -> int {
  if month == 2 {
    const leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
    return if leap {
      29
    } else {
      28
    }
  }
  if month == 4 || month == 6 || month == 9 || month == 11 {
    return 30
  }
  return 31
}

fn two_digits(value: int) -> string {
  return if value < 10 {
    "0" + to_string(value)
  } else {
    to_string(value)
  }
}

/** Add whole minutes to a UTC `YYYY-MM-DDTHH:MM:SSZ` instant, or nil. */
pub fn release_lane_reclaimable_at(started_at: string) -> string? {
  const captured = regex_captures(
    "^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})Z$",
    trim(started_at),
  )
  if len(captured) != 1 {
    return nil
  }
  const groups = captured[0].groups
  let year = to_int(groups[0]) ?? 0
  let month = to_int(groups[1]) ?? 0
  let day = to_int(groups[2]) ?? 0
  let hour = to_int(groups[3]) ?? 0
  let minute = to_int(groups[4]) ?? 0
  const second = groups[5]
  if year < 1970 || month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 || minute > 59 {
    return nil
  }
  minute = minute + STALE_AFTER_MINUTES
  hour = hour + minute / 60
  minute = minute % 60
  day = day + hour / 24
  hour = hour % 24
  while day > days_in_month(year, month) {
    day = day - days_in_month(year, month)
    month = month + 1
    if month > 12 {
      month = 1
      year = year + 1
    }
  }
  return "${to_string(year)}-${two_digits(month)}-${two_digits(day)}T${two_digits(hour)}:${two_digits(minute)}:${second}Z"
}

/**
 * Operator text when terminal cleanup could not free an owned lane.
 *
 * Names the abandon command and the exact staleness instant so a leaked lock
 * is not mistaken for a live cross-host release.
 */
pub fn release_lane_cleanup_warning(result: ReleaseLaneFinish, started_at: string = "") -> string {
  let warning = "   ⚠ release lane cleanup did not finish (${result.reason}): ${result.ref}"
  if trim(result.version) != "" {
    warning = warning
      + "; recover with: harn run --no-sandbox abandon_release_attempts.harn -- --version "
      + trim(result.version)
      + " --apply --yes-live-release"
  }
  const when = release_lane_reclaimable_at(started_at)
  if when != nil {
    return warning
      + "; if a foreign host still holds it, the lane becomes reclaimable at ${when}"
  }
  return warning
    + "; a later claimant reclaims a completed hosted holder immediately; otherwise wait "
    + to_string(STALE_AFTER_MINUTES)
    + "m after the holder started"
}

fn hosted_release_holder_is_terminated(status: string) -> bool {
  return lowercase(trim(status)) == "completed"
}

fn hosted_workflow_run_is_gone(
  harness: Harness,
  claim: ReleaseLaneClaim,
  request: ReleaseLaneRequest,
) -> bool {
  const run_id = claim.holder?.workflow_run_id ?? 0
  const attempt = claim.holder?.workflow_run_attempt ?? 0
  if run_id <= 0 || attempt <= 0 {
    return false
  }
  const fetched = github_actions_run(
    harness,
    HOSTED_RELEASE_LANE_WORKFLOW_REPO,
    run_id,
    request.options ?? github_connector_options(),
  )
  if is_err(fetched) {
    return false
  }
  const run = unwrap(fetched)
  if run.id != run_id {
    return false
  }
  if (run.run_attempt ?? 0) != attempt && lowercase(trim(run.status)) != "completed" {
    return false
  }
  return hosted_release_holder_is_terminated(run.status)
}

/**
 * The operator-facing lines for one claim.
 *
 * Empty when the lane was free, because a release that is alone should not
 * spend a line saying so. Everything else is worth interrupting for.
 */
pub fn release_lane_report(claim: ReleaseLaneClaim) -> list<string> {
  if claim.state == "acquired" {
    if claim.reclaimed ?? false {
      return ["   -- release lane: ${claim.message}"]
    }
    return []
  }
  if claim.state == "unreadable" {
    return ["   !! release lane: ${claim.message}"]
  }
  if claim.state == "stale" || claim.state == "abandoned" {
    return [
      "   !! release lane: ${claim.message}",
      "      free it with:",
      "         harn run --no-sandbox abandon_release_attempts.harn -- --version ${claim.version} --apply --yes-live-release",
    ]
  }
  return [
    "   !! release lane: ${claim.message}",
    "      wait for the holder to finish; do not dispatch a duplicate release",
  ]
}

/** A typed hard-gate reason, or nil only when this run owns the lane. */
pub fn release_lane_blocking_reason(claim: ReleaseLaneClaim) -> string? {
  if claim.state == "acquired" {
    return nil
  }
  return "release lane unavailable for v${claim.version}: ${claim.message}"
}
