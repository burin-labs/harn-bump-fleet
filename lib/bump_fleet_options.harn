import { parse_args } from "std/cli"
import { env_str } from "std/config"

pub type BumpFleetOptions = {
  target: string?,
  dry_run: bool,
  only: string?,
  no_chat: bool,
  chat_only: bool,
  chat_run: string,
  chat_timeout_s: int,
  retry_failed: int,
  harn_repo: string,
}

const DEFAULT_HARN_REPO_PATH = path_join(env_str("HOME") ?? "", "projects/harn")

const BUMP_FLEET_ARG_SPEC = [
  {kind: "positional", name: "target", required: false},
  {kind: "flag", name: "dry_run", flags: ["--dry-run"]},
  {kind: "option", name: "only", flags: ["--only"]},
  {kind: "flag", name: "no_chat", flags: ["--no-chat"]},
  {kind: "flag", name: "chat_only", flags: ["--chat-only"]},
  {kind: "option", name: "chat_run", flags: ["--chat-run"], default: ""},
  {kind: "option", name: "chat_timeout_s", flags: ["--chat-timeout-s"], default: "60"},
  {kind: "option", name: "retry_failed", flags: ["--retry-failed"], default: "0"},
  {kind: "option", name: "harn_repo", flags: ["--harn-repo"], default: DEFAULT_HARN_REPO_PATH},
]

fn optional_string(value, name: string) -> string? {
  if value == nil {
    return nil
  }
  if type_of(value) != "string" {
    throw "${name} must be a string"
  }
  return value
}

fn required_string(value, name: string) -> string {
  const normalized = optional_string(value, name)
  if normalized == nil {
    throw "${name} must be a string"
  }
  return normalized
}

fn required_bool(value, name: string) -> bool {
  if type_of(value) != "bool" {
    throw "${name} must be a boolean"
  }
  return value
}

fn int_or_default(value, fallback: int) -> int {
  return to_int(value) ?? fallback
}

/** Normalize generic std/cli output once into the fleet's typed option contract. */
pub fn parse_bump_fleet_args(args: list<string>) -> BumpFleetOptions {
  const parsed = parse_args(args, BUMP_FLEET_ARG_SPEC)
  const errors = parsed._errors ?? []
  if len(parsed._extras) > 0 {
    throw "unknown flag: " + parsed._extras[0]
  }
  if len(errors) > 0 {
    throw join(errors, "; ")
  }
  const retry_raw = int_or_default(parsed.retry_failed, 0)
  return {
    target: optional_string(parsed.target, "target"),
    dry_run: required_bool(parsed.dry_run, "--dry-run"),
    only: optional_string(parsed.only, "--only"),
    no_chat: required_bool(parsed.no_chat, "--no-chat"),
    chat_only: required_bool(parsed.chat_only, "--chat-only"),
    chat_run: required_string(parsed.chat_run, "--chat-run"),
    chat_timeout_s: int_or_default(parsed.chat_timeout_s, 60),
    retry_failed: if retry_raw < 0 {
      0
    } else {
      retry_raw
    },
    harn_repo: required_string(parsed.harn_repo, "--harn-repo"),
  }
}
