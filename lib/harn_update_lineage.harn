import { harn_pin_decision } from "./bump_decision"

// Identify the update that moved a repository to a target by what it IS -- the
// default-branch commit whose tree first carries the target pin -- rather than
// by how recently it landed.
//
// The predicate this replaces selected candidates from a fixed window of the
// most recent closed pull requests against the default branch. That window is
// wrong in both directions and the two failures are the same defect:
//
//   - In a busy repository the pull request that actually set the pin falls out
//     of the window within a day. After that the proof reports missing lineage
//     forever, and no later round can repair it, because the pin already reads
//     the target so no new update is ever opened.
//   - Every unrelated pull request branched after that update reads the target
//     pin at its own head, so any one of them satisfies the head-pin predicate.
//     The proof then passes on a pull request that changed nothing about the
//     pin.
//
// Walking the pin file's own history answers the question directly: exactly one
// commit on the default branch turned the pin from something else into the
// target, and the pull request that carries that commit is the lineage record.
/** One default-branch commit that changed the pin file, and the pin it left. */
pub type HarnPinHistoryEntry = {commit_sha: string, pin: string?}

/** The default-branch commit that set the pin to the target, or why not. */
pub type HarnUpdateLineageCommit = {found: bool, reason: string, commit_sha: string}

/** The pull request that carried the lineage commit, or why there is none. */
pub type HarnUpdateLineagePullRequest = {found: bool, reason: string, number: int}

fn absent_lineage_commit(reason: string) -> HarnUpdateLineageCommit {
  return {found: false, reason: reason, commit_sha: ""}
}

fn absent_lineage_pull_request(reason: string) -> HarnUpdateLineagePullRequest {
  return {found: false, reason: reason, number: 0}
}

fn entry_satisfies_target(entry: HarnPinHistoryEntry, target: string) -> bool {
  const pin = trim(entry.pin ?? "")
  if pin == "" {
    return false
  }
  const decision = harn_pin_decision(pin, target)
  return decision.ok && decision.satisfies_target
}

/**
 * Select the commit that set the pin to `target`.
 *
 * `entries` are the default-branch commits that changed the pin file, newest
 * first, each carrying the pin its own tree holds. The answer is the OLDEST
 * commit in the unbroken leading run that satisfies the target: the run's newer
 * members re-touched the file without moving the pin off the target, and the
 * commit below the run is the last one that did not satisfy it.
 *
 * `window_complete` says whether `entries` reached the start of the file's
 * history. When the whole window satisfies the target and the window is not
 * complete, the transition is out of view. That is reported as unresolved
 * rather than answered with the oldest entry seen, because a truncated window
 * cannot tell "the pin was set here" from "the pin was already the target
 * before anything this window can see".
 */
pub fn harn_update_lineage_commit(
  entries: list<HarnPinHistoryEntry>,
  target: string,
  window_complete: bool = false,
) -> HarnUpdateLineageCommit {
  if len(entries) == 0 {
    return absent_lineage_commit("pin_history_unavailable")
  }
  let selected = ""
  let saw_a_commit_below_the_target = false
  for entry in entries {
    if !entry_satisfies_target(entry, target) {
      saw_a_commit_below_the_target = true
      break
    }
    selected = entry.commit_sha
  }
  if selected == "" {
    return absent_lineage_commit("default_branch_pin_not_at_target")
  }
  if !saw_a_commit_below_the_target && !window_complete {
    return absent_lineage_commit("pin_history_window_exhausted")
  }
  return {found: true, reason: "pin_set_to_target", commit_sha: selected}
}

/**
 * Select the merged pull request that carried the lineage commit.
 *
 * `pulls` is what GitHub associates with that exact commit. A squash or rebase
 * merge makes the lineage commit the pull request's own merge commit; an
 * ordinary merge leaves the lineage commit inside the branch with the merge
 * commit above it. Both are accepted, and both still face every predicate the
 * proof already applied: merged, green checks at the exact head, and a merge
 * commit reachable from the default branch.
 *
 * A pin set by a direct push to the default branch has no associated pull
 * request. That is reported by name, so it reads as an unusual landing that a
 * person should look at rather than as a missing record.
 */
pub fn harn_update_lineage_pull_request(
  pulls: list,
  commit_sha: string,
  base_branch: string,
) -> HarnUpdateLineagePullRequest {
  if len(pulls) == 0 {
    return absent_lineage_pull_request("pin_set_by_direct_push_without_pull_request")
  }
  let unmerged = 0
  let off_base = 0
  let fallback = 0
  for pull in pulls {
    const number = to_int(pull?.number ?? 0) ?? 0
    if number <= 0 {
      continue
    }
    if trim(to_string(pull?.merged_at ?? "")) == "" {
      unmerged = unmerged + 1
      continue
    }
    if lowercase(trim(to_string(pull?.base?.ref ?? ""))) != lowercase(trim(base_branch)) {
      off_base = off_base + 1
      continue
    }
    const merge_sha = lowercase(trim(to_string(pull?.merge_commit_sha ?? "")))
    if merge_sha != "" && merge_sha == lowercase(trim(commit_sha)) {
      return {found: true, reason: "lineage_pull_request_merge_commit", number: number}
    }
    if fallback == 0 {
      fallback = number
    }
  }
  if fallback > 0 {
    return {found: true, reason: "lineage_pull_request_contains_commit", number: fallback}
  }
  if off_base > 0 {
    return absent_lineage_pull_request("lineage_pull_request_merged_to_another_branch")
  }
  if unmerged > 0 {
    return absent_lineage_pull_request("lineage_pull_request_not_merged")
  }
  return absent_lineage_pull_request("pin_set_by_direct_push_without_pull_request")
}
