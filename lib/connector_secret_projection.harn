import { ConnectorRequiredSecret, ConnectorSecretSchema, FleetRepository } from "./fleet_manifest"
import { WorkflowProjectionSyncResult, sync_workflow_projection } from "./workflow_projection"

/** Render only the setup field owned by the fleet's typed connector registry. */
pub fn render_required_secrets(
  secrets: list<ConnectorRequiredSecret>,
  schema: ConnectorSecretSchema,
) -> list<string> {
  if schema == "legacy" {
    return [
      "required_secrets = ["
        + secrets.map({ secret -> "\"${secret.id}\"" }).join(", ")
        + "]",
    ]
  }
  return ["required_secrets = ["]
    + secrets.map({ secret -> "  { id = \"${secret.id}\", direction = \"${secret.direction}\" }," })
      .to_list()
    + ["]"]
}

fn required_secrets_span(lines: list<string>) -> {start: int, end: int} {
  let in_setup = false
  let start = -1
  let end = -1
  for index in range(0, len(lines)) {
    const line = trim(lines[index] ?? "")
    if line == "[providers.setup]" {
      if in_setup {
        throw "harn.toml repeats [providers.setup]"
      }
      in_setup = true
      continue
    }
    if in_setup && starts_with(line, "[") {
      break
    }
    if in_setup && starts_with(line, "required_secrets") {
      if start >= 0 {
        throw "[providers.setup] repeats required_secrets"
      }
      if !starts_with(line, "required_secrets = [") {
        throw "[providers.setup].required_secrets is not an array projection"
      }
      start = index
      if ends_with(line, "]") {
        end = index
      } else {
        for close_index in range(index + 1, len(lines)) {
          if trim(lines[close_index] ?? "") == "]" {
            end = close_index
            break
          }
        }
      }
    }
  }
  if start < 0 {
    throw "[providers.setup].required_secrets is missing"
  }
  if end < start {
    throw "[providers.setup].required_secrets has no closing bracket"
  }
  return {start: start, end: end}
}

/** Project one registry entry into an existing connector manifest without owning other bytes. */
pub fn project_connector_required_secrets(
  current: string,
  repo: FleetRepository,
  schema: ConnectorSecretSchema,
) -> string {
  const secrets = repo.connector_required_secrets
  if secrets == nil {
    throw "repository '${repo.slug}' has no connector secret projection"
  }
  const lines = split(current, "\n")
  const span = required_secrets_span(lines)
  return (lines.slice(0, span.start)
    + render_required_secrets(secrets ?? [], schema)
    + lines.slice(span.end + 1))
    .join("\n")
}

/** Check or write the one manifest field owned by the fleet registry. */
pub fn sync_connector_secret_repo(
  fs: HarnessFs,
  repo: FleetRepository,
  projects_root: string,
  schema: ConnectorSecretSchema,
  apply: bool,
) -> WorkflowProjectionSyncResult {
  const repo_path = path_join(projects_root, repo.directory)
  const relative_path = "harn.toml"
  const manifest_path = path_join(repo_path, relative_path)
  if !fs.exists(manifest_path) {
    return {slug: repo.slug, path: manifest_path, status: "error", error: "harn.toml is missing"}
  }
  const expected = try {
    project_connector_required_secrets(fs.read_text(manifest_path), repo, schema)
  } catch (e) {
    return {slug: repo.slug, path: manifest_path, status: "error", error: to_string(e)}
  }
  return sync_workflow_projection(
    fs,
    {slug: repo.slug, repo_path: repo_path, relative_path: relative_path, expected: expected},
    apply,
  )
}
