import { github_workflow_runs } from "./github"
import {
  GithubClientOptions,
  GithubConnectorError,
  GithubConnectorResult,
  GithubWorkflowRun,
} from "harn-github-connector/default"

const PAGE_SIZE = 10

const MAX_PAGES = 100

fn inventory_error(message: string) -> GithubConnectorError {
  return {code: "incomplete_run_inventory", category: "schema_drift", message: message}
}

/** A complete run census; partial or changing pages cannot prove absence. */
pub fn github_workflow_run_inventory(
  harness: Harness,
  slug: string,
  workflow: string,
  filters: dict,
  client: GithubClientOptions,
) -> GithubConnectorResult<list<GithubWorkflowRun>> {
  let runs: list<GithubWorkflowRun> = []
  let ids: list<int> = []
  let expected_count: int? = nil
  for page_number in range(1, MAX_PAGES + 1) {
    const page_filters = if page_number == 1 {
      filters
    } else {
      filters + {page: page_number}
    }
    const result = github_workflow_runs(harness, slug, workflow, page_filters, PAGE_SIZE, client)
    if is_err(result) {
      return Err(unwrap_err(result))
    }
    const page = unwrap(result)
    if expected_count == nil {
      expected_count = page.total_count
    }
    if page.total_count != expected_count || page.page != page_number
      || page.per_page != PAGE_SIZE
      || len(page.runs) > PAGE_SIZE {
      return Err(inventory_error("workflow run inventory changed while paging"))
    }
    for run in page.runs {
      if ids.contains(run.id) {
        return Err(inventory_error("workflow run inventory repeated a run across pages"))
      }
      ids = ids + [run.id]
      runs = runs + [run]
    }
    if len(runs) == expected_count {
      return Ok(runs)
    }
    if len(page.runs) != PAGE_SIZE || len(runs) > (expected_count ?? 0) {
      return Err(inventory_error("workflow run inventory ended before its declared total"))
    }
  }
  return Err(
    inventory_error("workflow run inventory exceeded its ${to_string(MAX_PAGES)}-page budget"),
  )
}
