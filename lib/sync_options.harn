import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "./cli_options"

pub type SyncOptions = {apply: bool, manifest: string, root: string?, only: string?}

type SyncCliOptions = {
  apply: bool,
  check: bool,
  dry_run: bool,
  manifest: string,
  root: string,
  only: string,
}

/**
 * The control plane every projection sync shares.
 *
 * Held as its own value so a sync that needs one more switch extends this list
 * rather than restating six arguments that must not drift apart. `argparse`
 * rejects an unknown flag, so a spec is the whole surface a script accepts.
 */
pub const SYNC_ARGS = [
  {kind: "switch", name: "apply", long: "--apply"},
  {kind: "switch", name: "check", long: "--check"},
  {kind: "switch", name: "dry_run", long: "--dry-run"},
  {kind: "flag", name: "manifest", long: "--manifest", default: "fleet.toml"},
  {kind: "flag", name: "root", long: "--root", default: ""},
  {kind: "flag", name: "only", long: "--only", default: ""},
]

const SYNC_ARG_SPEC: ParserSpec = {name: "fleet-sync", args: SYNC_ARGS}

/** Parse the shared dry-run-first control plane for fleet projection syncs. */
pub fn parse_sync_options(args: list<string>) -> SyncOptions {
  const parsed = cli_options<SyncCliOptions>(SYNC_ARG_SPEC, args, schema_of(SyncCliOptions))
  if parsed.apply && (parsed.check || parsed.dry_run) {
    throw "--apply cannot be combined with --check or --dry-run"
  }
  return {
    apply: parsed.apply,
    manifest: parsed.manifest,
    root: if trim(parsed.root) == "" {
      nil
    } else {
      parsed.root
    },
    only: if trim(parsed.only) == "" {
      nil
    } else {
      parsed.only
    },
  }
}

pub fn sync_target_matches(slug: string, directory: string, only: string?) -> bool {
  return only == nil || slug == only || directory == only
}

/**
 * The remote convergence control plane: the shared sync flags plus one hold.
 *
 * Only the remote sync can arm anything, because only it opens pull requests,
 * so the switch lives here instead of in `SyncOptions` where two local syncs
 * would carry a field they can never honor.
 */
pub type ConvergenceOptions = {sync: SyncOptions, arm_auto_merge: bool}

type ConvergenceCliOptions = {
  apply: bool,
  check: bool,
  dry_run: bool,
  manifest: string,
  root: string,
  only: string,
  no_auto_merge: bool,
}

const CONVERGENCE_ARG_SPEC: ParserSpec = {
  name: "fleet-convergence",
  args: SYNC_ARGS + [{kind: "switch", name: "no_auto_merge", long: "--no-auto-merge"}],
}

/**
 * Parse the remote convergence flags, including the arming hold.
 *
 * Arming is the default because the loop's whole purpose is to close the drift
 * window without a human in it, and a proposal nobody merges is the state that
 * grounded the fleet for three days. `--no-auto-merge` is the operator's brake:
 * it still proposes every repair, it just leaves each one for a human.
 */
pub fn parse_convergence_options(args: list<string>) -> ConvergenceOptions {
  const parsed = cli_options<ConvergenceCliOptions>(
    CONVERGENCE_ARG_SPEC,
    args,
    schema_of(ConvergenceCliOptions),
  )
  if parsed.apply && (parsed.check || parsed.dry_run) {
    throw "--apply cannot be combined with --check or --dry-run"
  }
  return {
    sync: {
      apply: parsed.apply,
      manifest: parsed.manifest,
      root: if trim(parsed.root) == "" {
        nil
      } else {
        parsed.root
      },
      only: if trim(parsed.only) == "" {
        nil
      } else {
        parsed.only
      },
    },
    arm_auto_merge: !parsed.no_auto_merge,
  }
}
