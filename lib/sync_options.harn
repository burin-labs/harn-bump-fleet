import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "./cli_options"

pub type SyncOptions = {apply: bool, manifest: string, root: string?, only: string?}

type SyncCliOptions = {
  apply: bool,
  check: bool,
  dry_run: bool,
  manifest: string,
  root: string,
  only: string,
}

const SYNC_ARG_SPEC: ParserSpec = {
  name: "fleet-sync",
  args: [
    {kind: "switch", name: "apply", long: "--apply"},
    {kind: "switch", name: "check", long: "--check"},
    {kind: "switch", name: "dry_run", long: "--dry-run"},
    {kind: "flag", name: "manifest", long: "--manifest", default: "fleet.toml"},
    {kind: "flag", name: "root", long: "--root", default: ""},
    {kind: "flag", name: "only", long: "--only", default: ""},
  ],
}

/** Parse the shared dry-run-first control plane for fleet projection syncs. */
pub fn parse_sync_options(args: list<string>) -> SyncOptions {
  const parsed = cli_options<SyncCliOptions>(SYNC_ARG_SPEC, args, schema_of(SyncCliOptions))
  if parsed.apply && (parsed.check || parsed.dry_run) {
    throw "--apply cannot be combined with --check or --dry-run"
  }
  return {
    apply: parsed.apply,
    manifest: parsed.manifest,
    root: if trim(parsed.root) == "" {
      nil
    } else {
      parsed.root
    },
    only: if trim(parsed.only) == "" {
      nil
    } else {
      parsed.only
    },
  }
}

pub fn sync_target_matches(slug: string, directory: string, only: string?) -> bool {
  return only == nil || slug == only || directory == only
}
