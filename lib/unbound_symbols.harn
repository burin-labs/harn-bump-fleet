/**
 * Static sweep for orphaned module-level constant references.
 *
 * `harn check` flags an undefined *call* target (HARN-NAM-002) but not a bare
 * undefined *value* reference, so a top-level `const NAME` that is deleted or
 * moved while a reference to it remains type-checks clean and only fails at
 * runtime with `Undefined variable: NAME`. The stage-module split that dropped
 * `RELEASE_RUN_ARGV_PREFIXES` is exactly this class. This gate closes it
 * statically until the upstream resolver fix (harn#4708) lands.
 *
 * The sweep is deliberately scoped to screaming-snake-case identifiers
 * (`FOO_BAR`), which are module constants or imports by convention here — never
 * locals, params, or loop variables. It works from a lexer token stream so
 * strings and comments are already separated out, and it treats a name as bound
 * if it appears in a binding position *anywhere* in the file (a whole-file union
 * rather than precise scoping). That union can miss a genuinely cross-scope
 * orphan, but it never reports a false positive on a legitimately bound name,
 * which is the property that keeps a static gate trustworthy.
 */
/** True for a screaming-snake-case identifier: `[A-Z][A-Z0-9_]*` with at least one underscore. */
pub fn is_screaming_snake(name: string) -> bool {
  if len(name) < 2 {
    return false
  }
  const upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  const digit = "0123456789"
  let has_underscore = false
  let i = 0
  while i < len(name) {
    const ch = name[i:i + 1]
    const is_upper = contains(upper, ch)
    const is_digit = contains(digit, ch)
    const is_underscore = ch == "_"
    if !(is_upper || is_digit || is_underscore) {
      return false
    }
    if i == 0 && !is_upper {
      return false
    }
    if is_underscore {
      has_underscore = true
    }
    i = i + 1
  }
  return has_underscore
}

fn token_kind(token) -> string {
  return trim(token?.kind ?? "")
}

fn token_lexeme(token) -> string {
  return token?.lexeme ?? ""
}

/**
 * Classify a lexer token stream (each entry `{kind, lexeme, line}`) into the
 * screaming-snake references that resolve to no binding in the same file.
 * Returns a list of `{name, line}` findings, one per unresolved reference site.
 */
pub fn unbound_symbol_findings(tokens) {
  let defined: list<string> = []
  let refs = []
  let in_import = false
  const n = len(tokens)
  let i = 0
  while i < n {
    const token = tokens[i]
    const kind = token_kind(token)
    // Everything between `import` and `from` names bound (imported/aliased)
    // symbols, so record any screaming-snake identifier there as defined.
    if kind == "Import" {
      in_import = true
      i = i + 1
      continue
    }
    if in_import {
      if kind == "From" {
        in_import = false
      } else if kind == "Identifier" && is_screaming_snake(token_lexeme(token)) {
        defined = defined.push(token_lexeme(token))
      }
      i = i + 1
      continue
    }
    if kind != "Identifier" {
      i = i + 1
      continue
    }
    const name = token_lexeme(token)
    if !is_screaming_snake(name) {
      i = i + 1
      continue
    }
    const prev_kind = if i > 0 {
      token_kind(tokens[i - 1])
    } else {
      ""
    }
    const next_kind = if i + 1 < n {
      token_kind(tokens[i + 1])
    } else {
      ""
    }
    // Binding positions: `const NAME`, `let NAME`, `for NAME in`, and a lambda
    // param `{ NAME -> ... }`. Record and move on.
    if prev_kind == "Const" || prev_kind == "Let" || prev_kind == "For" || next_kind == "Arrow" {
      defined = defined.push(name)
      i = i + 1
      continue
    }
    // Not a reference we can resolve here: field access (`x.NAME` or `x?.NAME`),
    // an object key or label (`NAME:`), or a call target (`NAME(...)`, which
    // `harn check` already validates). Skip.
    if prev_kind == "Dot"
      || prev_kind == "QuestionDot"
      || next_kind == "Colon"
      || next_kind == "LParen" {
      i = i + 1
      continue
    }
    refs = refs.push({name: name, line: token?.line ?? 0})
    i = i + 1
  }
  return refs.filter({ ref -> return !defined.contains(ref.name) })
}
