fn local_branch_exists(cfg, branch) {
  return probe_git_ok(cfg, ["show-ref", "--verify", "--quiet", "refs/heads/${branch}"])
}

fn remote_branch_exists(cfg, branch) {
  return probe_git_ok(cfg, ["show-ref", "--verify", "--quiet", "refs/remotes/origin/${branch}"])
}

fn version_from_cargo_toml(text) {
  const matches = regex_captures("(?m)^version\\s*=\\s*\"([^\"]+)\"", text ?? "")
  if len(matches) == 0 {
    return ""
  }
  return matches[0].groups[0]
}

pub fn release_branch_resume_decision(inputs) {
  const expected_head = trim(inputs.expected_head ?? "")
  const remote_head = trim(inputs.remote_head ?? "")
  if !(inputs.remote_exists ?? false) {
    if expected_head != "" {
      return {action: "fail", reason: "--resume-head-sha was provided, but no remote release branch exists"}
    }
    return {action: "normal", reason: "no remote release branch exists"}
  }
  if expected_head != "" && remote_head != expected_head {
    return {
      action: "fail",
      reason: "remote release branch head ${remote_head} does not match --resume-head-sha ${expected_head}",
    }
  }
  if !(inputs.contains_pin ?? false) {
    if expected_head != "" {
      return {
        action: "fail",
        reason: "remote release branch ${remote_head} does not contain the requested release pin",
      }
    }
    return {action: "normal", reason: "remote release branch does not contain the requested release pin"}
  }
  if (to_int(inputs.commit_count ?? 0) ?? 0) <= 0 {
    if expected_head != "" {
      return {
        action: "fail",
        reason: "remote release branch ${remote_head} has no commits beyond the requested release pin",
      }
    }
    return {action: "normal", reason: "remote release branch has no commits beyond the requested release pin"}
  }
  const next = trim(inputs.next_version ?? "")
  if trim(inputs.current_version ?? "") != next || trim(inputs.changelog_top ?? "") != next {
    if expected_head != "" {
      return {
        action: "fail",
        reason: "remote release branch ${remote_head} is not already prepared for v${next}",
      }
    }
    return {action: "normal", reason: "remote release branch is not already prepared for v${next}"}
  }
  if expected_head == "" {
    return {
      action: "fail",
      reason: "remote release branch is prepared for v${next}, but --resume-head-sha was not provided",
    }
  }
  return {
    action: "resume",
    reason: "remote release branch already contains prepared v${next} content derived from the requested pin",
  }
}

fn remote_release_branch_resume_state(cfg, analysis, branch) {
  const remote_ref = "origin/${branch}"
  if !remote_branch_exists(cfg, branch) {
    return release_branch_resume_decision({remote_exists: false})
  }
  const cargo = run_git(cfg, ["show", "${remote_ref}:Cargo.toml"])
  const changelog = run_git(cfg, ["show", "${remote_ref}:CHANGELOG.md"])
  const remote_head = trim(run_git(cfg, ["rev-parse", remote_ref]).stdout ?? "")
  const contains_pin = run_git(cfg, ["merge-base", "--is-ancestor", cfg.pin_sha, remote_ref]).success
  const commit_count = if contains_pin {
    to_int(trim(run_git(cfg, ["rev-list", "--count", "${cfg.pin_sha}..${remote_ref}"]).stdout ?? ""))
      ?? 0
  } else {
    0
  }
  const current = if cargo.success {
    version_from_cargo_toml(cargo.stdout)
  } else {
    ""
  }
  const top = if changelog.success {
    changelog_top_from_text(changelog.stdout)
  } else {
    ""
  }
  return release_branch_resume_decision(
    {
      remote_exists: true,
      contains_pin: contains_pin,
      commit_count: commit_count,
      current_version: current,
      changelog_top: top,
      next_version: analysis.next_version,
      expected_head: cfg.resume_head_sha ?? "",
      remote_head: remote_head,
    },
  )
}

pub fn target_release_checkout_state(harness: Harness, cfg, analysis) {
  const branch = checked_git(cfg, ["branch", "--show-current"])
  const current = current_version(harness, cfg)
  const top = changelog_top(harness, cfg)
  return {
    branch: branch,
    current_version: current,
    changelog_top: top,
    matches: branch == analysis.expected_branch && current == analysis.next_version
      && top == analysis.next_version,
  }
}

/**
 * A normal branch push is safe only when the caller supplied the exact remote
 * head it intends to resume. A fixup deliberately recreates the branch, even
 * when its published tag must be left untouched, so it needs a lease.
 */
pub fn release_branch_push_preserves_remote_head(cfg) {
  return trim(cfg.resume_head_sha ?? "") != ""
}

pub fn release_branch_push_argv(cfg, branch) {
  return release_branch_push_args(
    branch,
    remote_branch_exists(cfg, branch),
    release_branch_push_preserves_remote_head(cfg),
  )
}

/**
 * Tag the release commit at HEAD as `vX.Y.Z` and push the tag.
 *
 * The tag is the source of truth for what gets published — the harn-side
 * publish-release.yml fires on tag push and ships from the tag, so the
 * release survives the merge queue rebasing the Release PR onto a moved
 * main. Idempotent: if the tag already exists locally and points at the
 * release HEAD, the create step no-ops; if it points elsewhere, fail
 * with an actionable message rather than overwriting silently.
 *
 * In post-publish fixup mode (`cfg.skip_tag`), the tag was pushed during
 * the original publish and the artifact already shipped from it. The
 * fixup PR exists to land the Cargo.toml/CHANGELOG bump on `<base>` and
 * does not influence the published release. Re-pushing the tag would
 * either re-fire publish-release.yml (queueing behind itself) or — if
 * advanced to a different commit — diverge crates.io from the git
 * artifact. Short-circuit with an idempotent step so the fixup flow can
 * proceed straight to the PR body refresh.
 */
/**
 * Prove the frozen release cutoff remains in `origin/<base>` ancestry before
 * the irreversible tag push. Normal descendant commits belong to the next
 * release; divergence or an unprovable cutoff fails closed. Returns
 * `{steps, proceed}`; `proceed=false` means the caller must stop before
 * `ensure_release_tag_pushed`.
 *
 * The pure `release_cutoff_decision` owns the policy; this only gathers the fresh
 * probe. Repin mode, explicit `--at-sha`, and `--allow-base-drift` short-circuit
 * (their drift is intended or already gated); mock skips the live probe.
 */
fn release_cutoff_gate(harness: Harness, cfg, tag: string, phase: string, steps, run_id) {
  const explicit_pin = trim(cfg.pin_sha_input ?? "") != ""
  if cfg.mock || (cfg.repin_mode ?? false) || explicit_pin || (cfg.allow_base_drift ?? false) {
    return {steps: steps, proceed: true}
  }
  const step = "pre-${phase}-cutoff-check"
  const action = if phase == "tag" {
    "tagging"
  } else {
    "preparing"
  }
  release_log_event(harness, run_id, "step_started", {step: step})
  const fetch = run_git(cfg, ["fetch", "origin", "--quiet", cfg.base])
  if !fetch.success {
    const fetch_stderr = trim(fetch.stderr ?? "")
    const recorded = recorded_step(
      step,
      "git fetch origin ${cfg.base}",
      fail(2, "${step} could not fetch origin/${cfg.base} before ${action} ${tag}: ${fetch_stderr}"),
    )
    release_log_event(harness, run_id, "step_finished", {step: step, success: false})
    return {steps: steps + [recorded], proceed: false}
  }
  const cutoff = release_cutoff_probe({ args -> run_git(cfg, args) }, cfg)
  const decision = release_cutoff_decision(
    {
      pin_sha: cfg.pin_sha,
      base_head_sha: cutoff.base_head_sha,
      pin_is_base_ancestor: cutoff.pin_is_base_ancestor,
      base: cfg.base,
      tag: tag,
      repin_latest: false,
      explicit_pin: false,
      allow_drift: false,
    },
  )
  if decision.action == "abort" {
    const recorded = recorded_step(
      step,
      "prove release cutoff is in origin/${cfg.base} ancestry",
      fail(2, decision.reason),
    )
    release_log_event(
      harness,
      run_id,
      "step_finished",
      {step: step, success: false, reason: decision.reason},
    )
    return {steps: steps + [recorded], proceed: false}
  }
  const recorded = recorded_step(
    step,
    "prove release cutoff is in origin/${cfg.base} ancestry",
    ok(
      "cutoff ${cfg.pin_sha} remains in origin/${cfg.base} ancestry at ${cutoff.base_head_sha}; later base commits belong to the next release; safe to ${phase} ${tag}\n",
    ),
  )
  release_log_event(harness, run_id, "step_finished", {step: step, success: true})
  return {steps: steps + [recorded], proceed: true}
}

pub fn pre_tag_cutoff_gate(harness: Harness, cfg, version, steps, run_id) {
  return release_cutoff_gate(harness, cfg, "v${version}", "tag", steps, run_id)
}

/**
 * Prove the frozen cutoff is still in base ancestry before branch mutation.
 * Normal base advancement does not invalidate prepared evidence; divergence
 * fails before the expensive prepare phase and branch push.
 */
pub fn pre_prepare_cutoff_gate(harness: Harness, cfg, analysis, steps, run_id) {
  const version = trim(analysis.next_version ?? "")
  const tag = if version == "" {
    "v<unknown>"
  } else {
    "v${version}"
  }
  return release_cutoff_gate(harness, cfg, tag, "prepare", steps, run_id)
}

/** Persist the handoff that lets post-tag monitoring resume in another process. */
pub fn persist_release_watch_receipt(harness: Harness, cfg, version, steps, run_id, pr_url) {
  if cfg.mock {
    return steps
  }
  const tag = "v${version}"
  const slug = release_repo_slug(cfg)
  const path = release_watch_receipt_path(release_run_root(), tag)
  const receipt = release_watch_receipt(
    {tag: tag, slug: slug, pin_sha: cfg.pin_sha, pr_url: pr_url, created_at: date_now_iso()},
  )
  const written = try {
    release_watch_receipt_write(path, receipt)
  }
  const result = if is_ok(written) {
    ok("durable release watch receipt: " + unwrap(written) + "\n")
  } else {
    fail(2, "could not persist release watch receipt: " + to_string(unwrap_err(written)))
  }
  release_log_event(
    harness,
    run_id,
    "release_watch_receipt_written",
    {tag: tag, path: path, success: result.success, pr_url: pr_url},
  )
  return steps
    + [recorded_step("persist-release-watch", "persist resumable post-tag watch receipt", result)]
}

pub fn run_pre_tag_binary_size_gate(harness: Harness, cfg, branch, steps, run_id) {
  const head_probe = run_git(cfg, ["rev-parse", "HEAD"])
  const slug = if cfg.mock {
    "burin-labs/harn"
  } else {
    release_repo_slug(cfg)
  }
  const result = if !head_probe.success {
    pre_tag_size_gate_failure(
      "could not resolve the intended release commit: " + trim(command_output(head_probe)),
    )
  } else if slug == "" {
    pre_tag_size_gate_failure("could not resolve the GitHub repository slug")
  } else {
    const config = pre_tag_binary_size_gate_config(branch, trim(head_probe.stdout))
    const adapter = if cfg.mock {
      mock_pre_tag_size_gate_adapter(config)
    } else {
      {
        dispatch: fn(gate) { return github_workflow_dispatch(
          slug,
          gate.workflow,
          {benchmark_only: gate.benchmark_only, runner_profile: gate.runner_profile, targets: gate.targets},
          gate.ref,
        ) },
        view_run: fn(action_run_id) {
          const run = github_actions_run(slug, action_run_id)
          if is_err(run) {
            return run
          }
          const jobs = github_actions_run_jobs(slug, action_run_id)
          if is_err(jobs) {
            return jobs
          }
          return {
            run: run,
            jobs: jobs.jobs
              .map(
              { job -> return {
                name: job.name,
                status: job.status,
                conclusion: job.conclusion ?? "",
                steps: job.steps
                  .map(
                  { step -> return {name: step.name, status: step.status, conclusion: step.conclusion ?? ""} },
                )
                  .to_list(),
              } },
            )
              .to_list(),
          }
        },
        wait: fn(ms) { harness.clock.sleep_ms(ms) },
      }
    }
    run_pre_tag_size_gate(
      config,
      adapter,
      { started -> release_log_event(harness, run_id, "pre_tag_binary_size_gate_started", started) },
    )
  }
  release_log_event(harness, run_id, "pre_tag_binary_size_gate", pre_tag_size_gate_event(result))
  return {
    steps: steps
      + [
      recorded_step(
        "pre-tag-linux-binary-size-gate",
        "require SHA-matched Linux size workflow",
        pre_tag_size_gate_command_result(result),
      ),
    ],
    success: result.success,
  }
}

pub fn ensure_release_tag_pushed(harness: Harness, cfg, version, steps, run_id) {
  const tag = "v${version}"
  if cfg.skip_tag ?? false {
    release_log_event(
      harness,
      run_id,
      "step_started",
      {step: "ensure-release-tag-pushed-skipped", reason: "fixup_mode"},
    )
    const skip_step = recorded_step(
      "ensure-release-tag-pushed-skipped",
      "fixup mode: tag ${tag} was pushed during the original publish",
      ok(
        "idempotent skip: ${tag} was pushed during the original publish-release.yml run; this rerun is post-publish paperwork and must not re-tag\n",
      ),
    )
    release_log_event(
      harness,
      run_id,
      "step_finished",
      {step: "ensure-release-tag-pushed-skipped", success: true, status: 0},
    )
    return steps + [skip_step]
  }
  const head_probe = run_git(cfg, ["rev-parse", "HEAD"])
  if !head_probe.success {
    return steps + [recorded_step("create-release-tag", "git rev-parse HEAD", head_probe)]
  }
  const head = trim(head_probe.stdout)
  let pre_steps = steps
  const remote_tag_probe = release_git_remote_refs(cfg, ["refs/tags/" + tag, "refs/tags/" + tag + "^{}"])
  if !remote_tag_probe.success {
    return pre_steps
      + [
      recorded_remote_refs_step(
        "probe-release-tag",
        "std/git::git_ls_remote refs/tags/" + tag,
        remote_tag_probe,
      ),
    ]
  }
  const remote_target = remote_tag_target_sha(remote_tag_probe.refs)
  const remote_decision = remote_release_tag_decision({tag: tag, head_sha: head, remote_target_sha: remote_target})
  if remote_decision.action == "reuse" {
    return pre_steps
      + [
      recorded_step(
        "push-release-tag",
        "remote tag ${tag} already targets release HEAD",
        ok("idempotent remote tag reuse: ${remote_decision.reason}; skipping tag push\n"),
      ),
    ]
  }
  if remote_decision.action == "abort" {
    return pre_steps
      + [
      recorded_step(
        "push-release-tag",
        "std/git::git_ls_remote refs/tags/" + tag,
        fail(2, remote_decision.reason),
      ),
    ]
  }
  const local_tag_probe = run_git(cfg, ["rev-parse", "-q", "--verify", "refs/tags/" + tag])
  const local_exists = local_tag_probe.success
  let local_target = ""
  if local_tag_probe.success {
    const tag_commit_probe = run_git(cfg, ["rev-list", "-n", "1", tag])
    local_target = if tag_commit_probe.success {
      trim(tag_commit_probe.stdout)
    } else {
      ""
    }
  }
  const local_decision = local_release_tag_decision(
    {
      tag: tag,
      head_sha: head,
      local_exists: local_exists,
      local_target_sha: local_target,
      remote_target_sha: remote_target,
    },
  )
  if local_decision.action == "abort" {
    return pre_steps
      + [recorded_step("create-release-tag", "git rev-list -n 1 " + tag, fail(2, local_decision.reason))]
  }
  if local_decision.action == "refresh" {
    const delete = logged_command_step(
      harness,
      cfg,
      pre_steps,
      "refresh-local-release-tag",
      ["git", "tag", "-d", tag],
      run_id,
    )
    pre_steps = delete.steps
    if !delete.success {
      return pre_steps
    }
  }
  if local_decision.action == "reuse" {
    pre_steps = pre_steps
      + [
      recorded_step(
        "create-release-tag",
        "tag ${tag} already pinned at HEAD",
        ok("idempotent reuse: ${local_decision.reason}\n"),
      ),
    ]
  } else {
    const create_argv = release_tag_create_args(tag, version)
    const create = logged_command_step(harness, cfg, pre_steps, "create-release-tag", create_argv, run_id)
    pre_steps = create.steps
    if !create.success {
      return pre_steps
    }
  }
  // Never publish a tag that Git cannot verify with the configured signing trust.
  const verify_tag = logged_command_step(
    harness,
    cfg,
    pre_steps,
    "verify-release-tag-signature",
    release_tag_verify_args(tag),
    run_id,
  )
  pre_steps = verify_tag.steps
  if !verify_tag.success {
    return pre_steps
  }
  return reconciled_release_tag_push(harness, cfg, pre_steps, tag, head, run_id)
}

fn reconciled_release_tag_push(harness: Harness, cfg, steps, tag, head, run_id) {
  const command = release_tag_push_args(tag)
  log_step_started(harness, run_id, "push-release-tag", command)
  const pushed = run_git(cfg, command[1:len(command)], {env: hook_light_env()})
  const push_result = if pushed.success {
    ok(pushed.stdout)
  } else {
    fail(pushed.exit_code ?? 1, pushed.stderr)
  }
  if pushed.success {
    log_step_finished(
      harness,
      run_id,
      "push-release-tag",
      push_result,
      {reconciliation_action: "not_needed", push_git_receipt: pushed},
    )
    return steps
      + [
      {
        ...recorded_step("push-release-tag", command, push_result),
        reconciliation_action: "not_needed",
        push_git_receipt: pushed,
      },
    ]
  }
  const remote = release_git_remote_refs(cfg, ["refs/tags/" + tag, "refs/tags/" + tag + "^{}"])
  const decision = release_tag_push_reconciliation(
    {
      tag: tag,
      head_sha: head,
      remote_probe_success: remote.success,
      remote_probe_error: remote.stderr,
      remote_refs: remote.refs,
    },
  )
  const original_failure = command_output(pushed)
  const result = if decision.success {
    ok(decision.reason + "\n\noriginal git push output:\n" + original_failure + "\n")
  } else {
    fail(
      pushed.exit_code ?? 1,
      decision.reason + "\n\noriginal git push output:\n" + original_failure + "\n",
    )
  }
  const evidence = {
    reconciliation_action: decision.action,
    remote_target_sha: decision.remote_target_sha,
    push_git_receipt: pushed,
    remote_git_receipt: remote.receipt,
    remote_refs: remote.refs,
  }
  log_step_finished(harness, run_id, "push-release-tag", result, evidence)
  return steps + [{...recorded_step("push-release-tag", command, result), ...evidence}]
}

/**
 * Pre-resolve sync: ensure local `<base>` matches `origin/<base>` before we
 * freeze the pin SHA. Stashes any dirty tracked/untracked changes under a
 * run-tagged label so the operator can recover them with `git stash list`.
 *
 * Gated to live-mutating runs only — read-only audit and `--at-sha`-pinned
 * runs keep their lighter footprint (no stash, no branch switch). Mid-release
 * runs already sitting on a `release/v*` branch are deferred to
 * `normalize_release_analysis_checkout`, which knows how to tell a
 * fresh-prepare from a stale one.
 */
pub fn pre_release_sync_local_base(harness: Harness, cfg, run_id) {
  if cfg.mock {
    return nil
  }
  if trim(cfg.pin_sha_input ?? "") != "" {
    release_log_event(harness, run_id, "base_sync_skipped_pinned", {pin_sha_input: cfg.pin_sha_input})
    return nil
  }
  if cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return nil
  }
  const current_branch_r = git_current_branch(cfg.repo)
  if !current_branch_r.success {
    throw "failed to read current branch before pin-SHA sync:\n${trim(current_branch_r.stderr)}"
  }
  const current_branch = current_branch_r.branch
  if version_from_release_branch(current_branch) != "" {
    release_log_event(
      harness,
      run_id,
      "base_sync_skipped_release_branch",
      {branch: current_branch, base: cfg.base},
    )
    harness.stdio
      .println("   ↳ on release branch ${current_branch}; deferring base sync to normalize step")
    return nil
  }
  release_log_event(
    harness,
    run_id,
    "base_sync_started",
    {from_branch: current_branch, base: cfg.base},
  )
  const stash_tag = "release_harn-auto-stash-${run_id}"
  const result = sync_base_branch(nil, cfg.base, stash_tag, cfg.repo)
  release_log_event(
    harness,
    run_id,
    "base_sync_finished",
    {
      from_branch: current_branch,
      base: cfg.base,
      success: result.success,
      dirty: result.dirty,
      stashed: result.stashed,
      stash_message: result.stash_message,
      branch: result.branch,
      detail: result.detail,
    },
  )
  if !result.success {
    const recovery_hint = if result.stashed {
      " (your changes are saved under `git stash list` → ${result.stash_message}; `git stash pop` to recover)"
    } else {
      ""
    }
    throw "failed to sync ${cfg.base} from origin before pin-SHA resolution: ${result.detail}${recovery_hint}"
  }
  if result.stashed {
    harness.stdio
      .println(
      "   ↳ stashed dirty working tree (`git stash pop` to recover; tag: ${result.stash_message})",
    )
  }
  if current_branch != "" && current_branch != cfg.base {
    harness.stdio.println("   ↳ switched from ${current_branch} to ${cfg.base}")
  }
  harness.stdio.println("   ↳ ${result.detail}")
  return result
}

pub fn release_analysis_checkout_plan(inputs) {
  const current_branch = trim(inputs.current_branch ?? "")
  const status = trim(inputs.status ?? "")
  const pin_sha_input = trim(inputs.pin_sha_input ?? "")
  const release_version = version_from_release_branch(current_branch)
  if pin_sha_input != "" {
    if status != "" {
      return {action: "abort_dirty_pinned_checkout", from_branch: current_branch}
    }
    return {action: "detach_pin", from_branch: current_branch}
  }
  if release_version == "" {
    return {action: "none", from_branch: current_branch}
  }
  if status != "" {
    return {action: "preserve_dirty_release_branch", from_branch: current_branch}
  }
  const current = trim(inputs.current_version ?? "")
  const top = trim(inputs.changelog_top ?? "")
  const latest_tag = trim(inputs.latest_tag ?? "")
  if release_version == current && top == current && version_from_tag(latest_tag) != current {
    return {action: "skip_prepared_release_branch", from_branch: current_branch}
  }
  return {action: "switch_base", from_branch: current_branch}
}

pub fn normalize_release_analysis_checkout(harness: Harness, cfg, run_id) {
  if cfg.mock || cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return
  }
  const current_branch = checked_git(cfg, ["branch", "--show-current"])
  const release_version = version_from_release_branch(current_branch)
  const status = checked_git(cfg, ["status", "--porcelain", "--untracked-files=normal"])
  let plan_inputs = {current_branch: current_branch, pin_sha_input: cfg.pin_sha_input ?? "", status: status}
  if release_version != "" && trim(cfg.pin_sha_input ?? "") == "" {
    plan_inputs = plan_inputs
      + {
      current_version: current_version(harness, cfg),
      changelog_top: changelog_top(harness, cfg),
      latest_tag: latest_release_tag(cfg),
    }
  }
  const plan = release_analysis_checkout_plan(plan_inputs)
  if plan.action == "none" {
    return
  }
  if plan.action == "abort_dirty_pinned_checkout" {
    release_log_event(
      harness,
      run_id,
      "checkout_normalization_preserved_dirty_pinned_checkout",
      {from_branch: current_branch, status: status, pin_sha: cfg.pin_sha},
    )
    throw "refusing to switch a dirty checkout to pinned release SHA ${cfg.pin_sha} before release analysis; commit or move the changes, then re-run"
  }
  if plan.action == "detach_pin" {
    release_log_event(
      harness,
      run_id,
      "checkout_normalization_started",
      {from_branch: current_branch, target: "pin", pin_sha: cfg.pin_sha},
    )
    const switched = run_git(cfg, ["switch", "--detach", cfg.pin_sha])
    if !switched.success {
      throw "failed to switch from ${current_branch} to pinned release SHA ${cfg.pin_sha} before release analysis:\n${trim(switched.stderr)}"
    }
    release_log_event(
      harness,
      run_id,
      "checkout_normalization_finished",
      {from_branch: current_branch, target: "pin", pin_sha: cfg.pin_sha},
    )
    return
  }
  if plan.action == "preserve_dirty_release_branch" {
    release_log_event(
      harness,
      run_id,
      "checkout_normalization_preserved_dirty_release_branch",
      {from_branch: current_branch, status: status},
    )
    return
  }
  if plan.action == "skip_prepared_release_branch" {
    release_log_event(
      harness,
      run_id,
      "checkout_normalization_skipped_prepared_release_branch",
      {branch: current_branch, version: plan_inputs.current_version, latest_tag: plan_inputs.latest_tag},
    )
    return
  }
  release_log_event(
    harness,
    run_id,
    "checkout_normalization_started",
    {from_branch: current_branch, base: cfg.base},
  )
  const fetch = run_git(cfg, ["fetch", "origin", "--prune", "--quiet"])
  if !fetch.success {
    throw "failed to fetch before release rerun checkout normalization:\n${trim(fetch.stderr)}"
  }
  const switched = run_git(cfg, ["switch", cfg.base])
  if !switched.success {
    throw "failed to switch from ${current_branch} to ${cfg.base} before release analysis:\n${trim(switched.stderr)}"
  }
  const pulled = run_git(cfg, ["pull", "--ff-only", "origin", cfg.base, "--quiet"])
  if !pulled.success {
    throw "failed to fast-forward ${cfg.base} before release analysis:\n${trim(pulled.stderr)}"
  }
  release_log_event(
    harness,
    run_id,
    "checkout_normalization_finished",
    {from_branch: current_branch, base: cfg.base, release_version: release_version},
  )
}

/**
 * Repin mode: clean up stale `v$next` tags before re-tagging at the new
 * pin. `fetch-base --tags` rehydrates the local tag from origin (when
 * present), and `ensure_release_tag_pushed` refuses to overwrite a stale
 * local tag pointing somewhere other than the release HEAD. Always
 * delete locally; delete on origin only when the TOCTTOU re-check
 * confirmed the remote tag was present at `repin_initial_remote_tag_sha`.
 */
pub fn maybe_delete_stale_repin_tag(harness: Harness, cfg, version, steps, run_id) {
  if !(cfg.repin_mode ?? false) {
    return {steps: steps, success: true}
  }
  const tag = "v${version}"
  // `git tag -d` returns non-zero when the tag is absent; treat that as a
  // no-op rather than a failure (this step runs as part of repin tear-down
  // and the local tag may already have been pruned).
  const local_del_argv = ["git", "tag", "-d", tag]
  const local_del_label = argv_label(local_del_argv)
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: "repin-delete-local-tag", command: local_del_label},
  )
  const local_del = run_git(cfg, local_del_argv[1:len(local_del_argv)])
  let out = steps
    + [recorded_step("repin-delete-local-tag", local_del_label, ok("ok: ${trim(local_del.stdout)}\n"))]
  release_log_event(harness, run_id, "step_finished", {step: "repin-delete-local-tag", success: true})
  if trim(cfg.repin_initial_remote_tag_sha ?? "") == "" {
    return {steps: out, success: true}
  }
  const remote_del_argv = ["git", "push", "origin", "--delete", tag]
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: "repin-delete-remote-tag", command: argv_label(remote_del_argv)},
  )
  const remote_del = append_command_step(harness, cfg, out, "repin-delete-remote-tag", remote_del_argv)
  out = remote_del.steps
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {step: "repin-delete-remote-tag", success: remote_del.success, status: remote_del.status},
  )
  return {steps: out, success: remote_del.success}
}

pub fn release_asset_snapshot(cfg, tag) {
  const lookup = release_github_release(cfg, tag)
  if is_err(lookup) {
    return {
      assets: [],
      missing_assets: missing_release_assets([]),
      ready: false,
      found: false,
      error: unwrap_err(lookup),
    }
  }
  const assets = if lookup.found {
    lookup.release.assets.map({ asset -> asset.name })
  } else {
    []
  }
  const missing = missing_release_assets(assets)
  return {
    assets: assets,
    missing_assets: missing,
    ready: lookup.found && len(missing) == 0,
    found: lookup.found,
    error: nil,
  }
}

/**
 * TOCTTOU re-check executed immediately before the repin branch reset.
 *
 * `detect_repin_state` ran at startup and captured `initial_remote_tag_sha`.
 * Between then and now the operator's environment continued to drift — other
 * sessions may have published the release, moved the tag, or landed more
 * commits on `<base>`. Re-fetch origin, re-probe every gate, and only then
 * return the freshly-locked pin SHA the caller may safely reset to.
 *
 * Returns `{success, message, new_pin_sha}`. On `success=false` the caller
 * must surface `message` and abort the mutation.
 */
pub fn run_repin_tocttou_recheck(cfg, analysis) {
  const tag = "v${analysis.next_version}"
  const fetch = run_git(cfg, ["fetch", "origin", "--tags", "--prune", "--quiet"])
  if !fetch.success {
    return {
      success: false,
      message: "repin: failed to re-fetch origin before TOCTTOU recheck: ${trim(fetch.stderr)}",
      new_pin_sha: "",
    }
  }
  const release_assets = release_asset_snapshot(cfg, tag)
  const release_exists = release_assets.ready || harn_crate_published(analysis.next_version)
  const ls = release_git_remote_refs(cfg, ["refs/tags/" + tag])
  if !ls.success {
    return {
      success: false,
      message: "repin: failed to re-list remote tag ${tag}: ${trim(ls.stderr)}",
      new_pin_sha: "",
    }
  }
  const pin_probe = run_git(cfg, ["rev-parse", "--verify", "origin/${cfg.base}^{commit}"])
  if !pin_probe.success {
    return {
      success: false,
      message: "repin: failed to re-resolve origin/${cfg.base}: ${trim(pin_probe.stderr)}",
      new_pin_sha: "",
    }
  }
  const decision = repin_tocttou_decision(
    {
      release_exists: release_exists,
      initial_remote_tag_sha: cfg.repin_initial_remote_tag_sha ?? "",
      current_remote_tag_sha: remote_tag_sha(ls.refs),
      new_pin_sha: trim(pin_probe.stdout),
      tag: tag,
    },
  )
  if decision.action == "abort" {
    return {success: false, message: "repin: aborting — ${decision.reason}", new_pin_sha: ""}
  }
  return {success: true, message: "", new_pin_sha: decision.new_pin_sha}
}

pub fn setup_release_branch(harness: Harness, cfg, analysis) {
  let steps = []
  const current_branch = checked_git(cfg, ["branch", "--show-current"])
  const target_branch = analysis.expected_branch
  const status = checked_git(cfg, ["status", "--porcelain", "--untracked-files=normal"])
  if current_branch == target_branch {
    return [
      recorded_step(
        "use-current-release-branch",
        "git branch --show-current && git status --porcelain --untracked-files=normal",
        ok("using existing ${target_branch} checkout for prepare\n${status}"),
      ),
    ]
  }
  let stashed = false
  if trim(status) != "" {
    if current_branch == cfg.base {
      steps = steps
        + [
        recorded_step(
          "dirty-base-branch",
          "git status --porcelain --untracked-files=normal",
          fail(
            2,
            "refusing to create ${target_branch} from dirty base branch ${cfg.base}; clean, commit, or move unrelated work before running live release",
          ),
        ),
      ]
      return steps
    }
    const stash_message = "release_harn branch setup ${analysis.next_version} ${uuid_v7()}"
    const stash = append_command_step(
      harness,
      cfg,
      steps,
      "stash-before-branch-setup",
      ["git", "stash", "push", "-u", "-m", stash_message],
    )
    steps = stash.steps
    if !stash.success {
      return steps
    }
    stashed = true
  }
  const fetch = append_command_step(
    harness,
    cfg,
    steps,
    "fetch-origin",
    ["git", "fetch", "origin", "--prune", "--quiet"],
  )
  steps = fetch.steps
  if !fetch.success {
    if stashed {
      const restore = append_command_step(
        harness,
        cfg,
        steps,
        "restore-stash-after-fetch-failure",
        ["git", "stash", "pop", "--index"],
      )
      steps = restore.steps
    }
    return steps
  }
  if current_branch == cfg.base {
    const pull = append_command_step(
      harness,
      cfg,
      steps,
      "sync-base",
      ["git", "pull", "--ff-only", "origin", cfg.base, "--quiet"],
    )
    steps = pull.steps
    if !pull.success {
      if stashed {
        const restore = append_command_step(
          harness,
          cfg,
          steps,
          "restore-stash-after-sync-failure",
          ["git", "stash", "pop", "--index"],
        )
        steps = restore.steps
      }
      return steps
    }
  }
  const remote_resume = remote_release_branch_resume_state(cfg, analysis, target_branch)
  if remote_resume.action == "fail" {
    return steps
      + [
      recorded_step(
        "resume-pushed-release-branch-lease",
        "verify origin/${target_branch} against --resume-head-sha",
        fail(2, remote_resume.reason),
      ),
    ]
  }
  if remote_resume.action == "resume" {
    const resume = append_command_step(
      harness,
      cfg,
      steps,
      "resume-pushed-release-branch",
      ["git", "switch", "-C", target_branch, "origin/${target_branch}"],
    )
    return resume.steps
  }
  let switch_step = "create-release-branch-from-pin"
  let switch_argv = ["git", "switch", "-c", target_branch, cfg.pin_sha]
  if current_branch == target_branch {
    switch_step = "reset-release-branch-to-pin"
    switch_argv = ["git", "reset", "--hard", cfg.pin_sha]
  } else if local_branch_exists(cfg, target_branch) || remote_branch_exists(cfg, target_branch) {
    switch_step = "reset-release-branch-to-pin"
    switch_argv = ["git", "switch", "-C", target_branch, cfg.pin_sha]
  }
  const switched = append_command_step(harness, cfg, steps, switch_step, switch_argv)
  steps = switched.steps
  if !switched.success {
    if stashed {
      const restore = append_command_step(
        harness,
        cfg,
        steps,
        "restore-stash-after-switch-failure",
        ["git", "stash", "pop", "--index"],
      )
      steps = restore.steps
    }
    return steps
  }
  if stashed {
    const applied = append_command_step(
      harness,
      cfg,
      steps,
      "restore-stashed-release-content",
      ["git", "stash", "pop", "--index"],
    )
    steps = applied.steps
    if !applied.success {
      const status_after = git_status(cfg.repo)
      const status_result = if status_after.success {
        ok(json_stringify(status_after.data.entries) + "\n")
      } else {
        fail(status_after.exit_code, status_after.stderr.inline)
      }
      steps = steps
        + [
        {
          ...recorded_step("status-after-stash-conflict", "typed git status", status_result),
          git_receipt: status_after,
          status_entries: status_after.data.entries,
        },
      ]
      return steps
    }
  }
  return steps
}
