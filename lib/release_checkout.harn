import { command_result_fail, command_result_ok } from "std/command"
// Extracted release-harness stage. See AGENTS.md for ownership.
import { git_status } from "std/git"
import { git_worktree_path_for_branch } from "./git_worktrees"
import { recorded_step } from "./release_execution"
import { ReleaseAnalysis, changelog_top, current_version } from "release_analysis"
import {
  ReleaseCommandResult,
  ReleaseConfig,
  append_command_step,
  checked_git,
  probe_git_ok,
  run_git,
} from "release_runtime"

pub type ReleaseCheckoutGitRunner = fn(list<string>) -> ReleaseCommandResult

pub type ReleaseWorktreeOwnerAction = "noop" | "detached" | "fail"

pub type ReleaseWorktreeOwnerResult = {
  success: bool,
  action: ReleaseWorktreeOwnerAction,
  reason: string,
  owner_path: string,
  observed_oid: string,
}

/**
 * Free the local convenience branch while recovering a proven immutable
 * candidate. The old worktree and commit remain intact, detached at the exact
 * OID. Every unreadable, dirty, moved, or unproven case fails closed.
 */
pub fn reconcile_release_worktree_owner(
  git: ReleaseCheckoutGitRunner,
  branch: string,
  expected_oid: string,
  recover_immutable_candidate: bool,
) -> ReleaseWorktreeOwnerResult {
  if !recover_immutable_candidate {
    return {
      success: true,
      action: "noop",
      reason: "release is not recovering an immutable candidate",
      owner_path: "",
      observed_oid: "",
    }
  }
  const listed = git(["worktree", "list", "--porcelain"])
  if !(listed.success ?? false) {
    return {
      success: false,
      action: "fail",
      reason: "could not inspect worktrees before recovering ${branch}",
      owner_path: "",
      observed_oid: "",
    }
  }
  const owner = git_worktree_path_for_branch(listed.stdout ?? "", branch)
  if owner == "" {
    return {
      success: true,
      action: "noop",
      reason: "no other worktree owns ${branch}",
      owner_path: "",
      observed_oid: "",
    }
  }
  const clean_expected = lowercase(trim(expected_oid))
  if len(regex_captures("^[0-9a-f]{40}$", clean_expected)) != 1 {
    return {
      success: false,
      action: "fail",
      reason: "immutable publication OID is missing or malformed for ${branch}",
      owner_path: owner,
      observed_oid: "",
    }
  }
  const status = git(["-C", owner, "status", "--porcelain", "--untracked-files=normal"])
  if !(status.success ?? false) || trim(status.stdout ?? "") != "" {
    return {
      success: false,
      action: "fail",
      reason: "${branch} is owned by an unreadable or dirty worktree at ${owner}",
      owner_path: owner,
      observed_oid: "",
    }
  }
  const head = git(["-C", owner, "rev-parse", "HEAD"])
  const observed = lowercase(trim(head.stdout ?? ""))
  if !(head.success ?? false) || observed != clean_expected {
    return {
      success: false,
      action: "fail",
      reason:
        "${branch} owner ${owner} is at ${observed}, not proven immutable candidate ${clean_expected}",
      owner_path: owner,
      observed_oid: observed,
    }
  }
  const detached = git(["-C", owner, "switch", "--detach", clean_expected])
  if !(detached.success ?? false) {
    return {
      success: false,
      action: "fail",
      reason: "failed to detach proven ${branch} owner ${owner}: ${trim(detached.stderr ?? "")}",
      owner_path: owner,
      observed_oid: observed,
    }
  }
  const verified = git(["worktree", "list", "--porcelain"])
  if !(verified.success ?? false)
    || git_worktree_path_for_branch(verified.stdout ?? "", branch)
    != "" {
    return {
      success: false,
      action: "fail",
      reason: "${branch} still has a worktree owner after detaching ${owner}",
      owner_path: owner,
      observed_oid: observed,
    }
  }
  return {
    success: true,
    action: "detached",
    reason: "preserved immutable candidate ${clean_expected} in detached worktree ${owner}",
    owner_path: owner,
    observed_oid: observed,
  }
}

pub type ReleaseCheckoutRecoveryMode = {
  fixup_mode: bool,
  pre_tag_resume: bool,
  pre_tag_supersede: bool,
}

/** True when checkout setup has an exact immutable OID that authorizes clean-owner detachment. */
pub fn release_checkout_reclaims_immutable_owner(mode: ReleaseCheckoutRecoveryMode) -> bool {
  return mode.fixup_mode || mode.pre_tag_resume || mode.pre_tag_supersede
}

pub type ReleaseCheckoutTargetState = {
  branch: string,
  current_version: string,
  changelog_top: string,
  matches: bool,
}

fn local_branch_exists(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseConfig,
  branch: string,
) -> bool {
  return probe_git_ok(harness, cfg, ["show-ref", "--verify", "--quiet", "refs/heads/${branch}"])
}

pub fn target_release_checkout_state(
  harness: Harness,
  cfg: ReleaseConfig,
  analysis: ReleaseAnalysis,
) -> ReleaseCheckoutTargetState {
  const branch = checked_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["branch", "--show-current"],
  )
  const current = current_version(harness.fs, cfg)
  const top = changelog_top(harness.fs, cfg)
  return {
    branch: branch,
    current_version: current,
    changelog_top: top,
    matches: branch == analysis.expected_branch && current == analysis.next_version
      && top
      == analysis
      .next_version,
  }
}

pub fn setup_release_branch(
  harness: Harness,
  cfg: ReleaseConfig,
  analysis: ReleaseAnalysis,
) -> list<dict> {
  let steps = []
  const current_branch = checked_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["branch", "--show-current"],
  )
  const target_branch = analysis.expected_branch
  const status = checked_git(
    {env: harness.env, process: harness.process},
    cfg,
    ["status", "--porcelain", "--untracked-files=normal"],
  )
  if current_branch == target_branch {
    return [
      recorded_step(
        "use-current-release-branch",
        "git branch --show-current && git status --porcelain --untracked-files=normal",
        command_result_ok("using existing ${target_branch} checkout for prepare\n${status}"),
      ),
    ]
  }
  let stashed = false
  if trim(status) != "" {
    if current_branch == cfg.base {
      steps = steps
        + [
        recorded_step(
          "dirty-base-branch",
          "git status --porcelain --untracked-files=normal",
          command_result_fail(
            2,
            "refusing to create ${target_branch} from dirty base branch ${cfg.base}; clean, commit, or move unrelated work before running live release",
          ),
        ),
      ]
      return steps
    }
    const stash_message =
      "release_harn branch setup ${analysis.next_version} ${harness.random.uuid_v7()}"
    const stash = append_command_step(
      harness,
      cfg,
      steps,
      "stash-before-branch-setup",
      ["git", "stash", "push", "-u", "-m", stash_message],
    )
    steps = stash.steps
    if !stash.success {
      return steps
    }
    stashed = true
  }
  const fetch = append_command_step(
    harness,
    cfg,
    steps,
    "fetch-origin",
    ["git", "fetch", "origin", "--prune", "--quiet"],
  )
  steps = fetch.steps
  if !fetch.success {
    if stashed {
      const restore = append_command_step(
        harness,
        cfg,
        steps,
        "restore-stash-after-fetch-failure",
        ["git", "stash", "pop", "--index"],
      )
      steps = restore.steps
    }
    return steps
  }
  if current_branch == cfg.base {
    const pull = append_command_step(
      harness,
      cfg,
      steps,
      "sync-base",
      ["git", "pull", "--ff-only", "origin", cfg.base, "--quiet"],
    )
    steps = pull.steps
    if !pull.success {
      if stashed {
        const restore = append_command_step(
          harness,
          cfg,
          steps,
          "restore-stash-after-sync-failure",
          ["git", "stash", "pop", "--index"],
        )
        steps = restore.steps
      }
      return steps
    }
  }
  const branch_exists = local_branch_exists(
    {env: harness.env, process: harness.process},
    cfg,
    target_branch,
  )
  if branch_exists {
    const expected_oid = cfg.fixup_publication?.head_oid ?? ""
    const reclaim_owner = release_checkout_reclaims_immutable_owner(
      {
        fixup_mode: cfg.fixup_mode ?? false,
        pre_tag_resume: cfg.pre_tag_resume ?? false,
        pre_tag_supersede: cfg.pre_tag_supersede ?? false,
      },
    )
    const reconciled = reconcile_release_worktree_owner(
      { args -> run_git({env: harness.env, process: harness.process}, cfg, args) },
      target_branch,
      expected_oid,
      reclaim_owner,
    )
    if reconciled.action != "noop" || reclaim_owner {
      const result = if reconciled.success {
        command_result_ok(reconciled.reason + "\n")
      } else {
        command_result_fail(2, reconciled.reason)
      }
      steps = steps
        + [
        {
          ...recorded_step(
            "reconcile-release-worktree-owner",
            "typed git worktree ownership reconciliation for ${target_branch}",
            result,
          ),
          reconciliation: reconciled,
        },
      ]
      if !reconciled.success {
        return steps
      }
    }
  }
  let switch_step = "create-release-branch-from-pin"
  let switch_argv = ["git", "switch", "-c", target_branch, cfg.pin_sha]
  if branch_exists {
    switch_step = "reset-release-branch-to-pin"
    switch_argv = ["git", "switch", "-C", target_branch, cfg.pin_sha]
  }
  const switched = append_command_step(harness, cfg, steps, switch_step, switch_argv)
  steps = switched.steps
  if !switched.success {
    if stashed {
      const restore = append_command_step(
        harness,
        cfg,
        steps,
        "restore-stash-after-switch-failure",
        ["git", "stash", "pop", "--index"],
      )
      steps = restore.steps
    }
    return steps
  }
  if stashed {
    const applied = append_command_step(
      harness,
      cfg,
      steps,
      "restore-stashed-release-content",
      ["git", "stash", "pop", "--index"],
    )
    steps = applied.steps
    if !applied.success {
      const status_after = git_status(harness.process, cfg.repo)
      const status_result = if status_after.success {
        command_result_ok(json_stringify(status_after.data.entries) + "\n")
      } else {
        command_result_fail(status_after.exit_code, status_after.stderr.inline)
      }
      steps = steps
        + [
        {
          ...recorded_step("status-after-stash-conflict", "typed git status", status_result),
          git_receipt: status_after,
          status_entries: status_after.data.entries,
        },
      ]
      return steps
    }
  }
  return steps
}
