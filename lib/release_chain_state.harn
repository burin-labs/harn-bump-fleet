import { read_json_typed_result, write_json } from "std/fs"

pub type ReleaseChainStage = "preflight" \
  | "prepare" \
  | "cut" \
  | "pre_tag_checkpoint" \
  | "tag" \
  | "publish" \
  | "prove" \
  | "baseline" \
  | "promote" \
  | "repin" \
  | "converge"

pub type ReleaseChainStatus = "active" | "stopped" | "complete" | "escalated"

pub type ReleaseChainStageStatus = "pending" | "effect_applied" | "proven" | "failed" | "stopped"

pub type ReleaseChainCause = "development_version_missing" \
  | "release_contract_unproven" \
  | "unfolded_fragments" \
  | "source_identity_changed" \
  | "certification_failed" \
  | "attempt_ref_missing" \
  | "attempt_ref_moved" \
  | "release_pr_conflicting" \
  | "release_pr_missing" \
  | "release_merge_identity_changed" \
  | "tag_missing" \
  | "tag_unsigned" \
  | "tag_moved" \
  | "assets_missing" \
  | "packages_missing" \
  | "publication_dispatch_missing" \
  | "anchor_stale" \
  | "consumer_pin_unreadable" \
  | "consumer_pin_stale" \
  | "consumer_update_failed" \
  | "convergence_proof_missing" \
  | "baseline_unproven" \
  | "target_superseded" \
  | "stopped" \
  | "credential_unavailable" \
  | "lease_unavailable" \
  | "unknown"

pub type ReleaseChainEvidenceStatus = "observed" | "missing" | "broken"

pub type ReleaseChainEvidenceRead = {
  subject: string,
  kind: string,
  status: ReleaseChainEvidenceStatus,
  expected: string,
  observed: string,
  source: string,
  ref: string,
  identity: string,
  observed_at: string,
}

pub type ReleaseChainUnprovenSubject = {
  subject: string,
  cause: ReleaseChainCause,
  retryable: bool,
  detail: string,
}

pub type ReleaseChainEffectKind = "dispatch_development_cutover" \
  | "open_fragment_fold_pr" \
  | "recover_binary_assets" \
  | "refresh_size_baseline" \
  | "promote_anchor" \
  | "dispatch_consumer_repin" \
  | "dispatch_convergence_proof"

pub type ReleaseChainEffectReceipt = {
  kind: ReleaseChainEffectKind,
  idempotency_key: string,
  target: string,
  accepted_identity: string,
  read_back: list<ReleaseChainEvidenceRead>,
  accepted_at: string,
}

pub type ReleaseChainStageReceipt = {
  stage: ReleaseChainStage,
  attempt: int,
  status: ReleaseChainStageStatus,
  predicate: string,
  subject_count: int,
  proven_count: int,
  unproven_count: int,
  evidence: list<ReleaseChainEvidenceRead>,
  unproven: list<ReleaseChainUnprovenSubject>,
  effect?: ReleaseChainEffectReceipt,
  cause?: ReleaseChainCause,
  input_receipt_hash: string,
  started_at: string,
  finished_at: string,
}

pub type ReleaseChainTarget = {
  version: string,
  tag: string,
  source_repo: string,
  base_ref: string,
  initial_pin_sha: string,
}

pub type ReleaseChainReceipt = {
  schema_version: "harn.release-chain.v1",
  chain_id: string,
  revision: int,
  target: ReleaseChainTarget,
  status: ReleaseChainStatus,
  current_stage: ReleaseChainStage,
  control_cursor: int,
  stages: list<ReleaseChainStageReceipt>,
  created_at: string,
  updated_at: string,
  published_start?: {release_commit_oid: string, watch_identity: string},
}

const PUBLISHED_STAGES: list<ReleaseChainStage> = [
  "prove",
  "baseline",
  "promote",
  "repin",
  "converge",
]

pub fn release_chain_latest_stage(
  receipt: ReleaseChainReceipt,
  stage: ReleaseChainStage,
) -> ReleaseChainStageReceipt? {
  let latest: ReleaseChainStageReceipt? = nil
  for row in receipt.stages {
    if row.stage == stage {
      latest = row
    }
  }
  return latest
}

pub fn release_chain_has_proven(receipt: ReleaseChainReceipt, stage: ReleaseChainStage) -> bool {
  const latest = release_chain_latest_stage(receipt, stage)
  return latest != nil && latest.status == "proven" && release_chain_stage_proven(latest)
}

fn published_pending_stage(receipt: ReleaseChainReceipt) -> ReleaseChainStage? {
  for stage in PUBLISHED_STAGES {
    if !release_chain_has_proven(receipt, stage) {
      return stage
    }
  }
  return nil
}

fn validate_published_history(receipt: ReleaseChainReceipt) -> ReleaseChainReceipt {
  const start = receipt.published_start
  if start == nil || !exact_sha(start.release_commit_oid)
    || !regex_match("^[0-9a-f]{64}$", start.watch_identity) {
    throw "published release chain requires exact release and watch identities"
  }
  let prior = receipt + {stages: []}
  for stage in receipt.stages {
    release_chain_validate_stage(stage)
    if !contains(PUBLISHED_STAGES, stage.stage) {
      throw "published release tail cannot prepare, certify, or tag"
    }
    const latest = release_chain_latest_stage(prior, stage.stage)
    if stage.attempt != (latest?.attempt ?? 0) + 1 {
      throw "published release stage attempts must be contiguous"
    }
    if stage.stage != "prove" && !release_chain_has_proven(prior, "prove") {
      throw "published release effects require publication proof"
    }
    if (stage.stage == "repin" || stage.stage == "converge")
      && !release_chain_has_proven(prior, "promote") {
      throw "published release convergence requires promotion proof"
    }
    if stage.stage == "converge" && !release_chain_has_proven(prior, "repin") {
      throw "published release convergence requires an exact accepted dispatch"
    }
    prior = prior + {stages: prior.stages + [stage]}
  }
  const pending = published_pending_stage(receipt)
  if receipt.current_stage != (pending ?? "converge") {
    throw "published release current stage must name its first unproven stage"
  }
  if receipt.status == "complete" && pending != nil {
    throw "published release cannot complete with unproven stages"
  }
  return receipt
}

pub type ReleaseChainControlKind = "stop" | "steer"

pub type ReleaseChainControlReceipt = {
  schema_version: "harn.release-chain.control.v1",
  chain_id: string,
  revision: int,
  sequence: int,
  kind: ReleaseChainControlKind,
  actor: string,
  reason: string,
  field: string,
  value: string,
  identity_bearing: bool,
  created_at: string,
}

pub type ReleaseChainHead = {
  schema_version: "harn.release-chain.head.v1",
  chain_id: string,
  latest_revision: int,
  receipt_hash: string,
}

pub type ReleaseChainControlHead = {
  schema_version: "harn.release-chain.control-head.v1",
  chain_id: string,
  latest_sequence: int,
}

const STAGES: list<ReleaseChainStage> = [
  "preflight",
  "prepare",
  "cut",
  "pre_tag_checkpoint",
  "tag",
  "publish",
  "prove",
  "promote",
  "repin",
  "converge",
]

pub fn release_chain_stages() -> list<ReleaseChainStage> {
  return STAGES
}

pub fn release_chain_next_stage(stage: ReleaseChainStage) -> ReleaseChainStage? {
  const index = STAGES.index_of(stage)
  if index == nil || index + 1 >= len(STAGES) {
    return nil
  }
  return STAGES[index + 1]
}

fn exact_sha(value: string) -> bool {
  return regex_match("^[0-9a-f]{40}$", lowercase(trim(value))) != nil
}

fn require_nonempty(value: string, name: string) -> nil {
  if trim(value) == "" {
    throw "release chain ${name} must be non-empty"
  }
  return nil
}

pub fn release_chain_stage_proven(stage: ReleaseChainStageReceipt) -> bool {
  return stage.subject_count > 0
    && stage.unproven_count == 0
    && stage.proven_count == stage.subject_count
}

pub fn release_chain_validate_stage(stage: ReleaseChainStageReceipt) -> ReleaseChainStageReceipt {
  require_nonempty(stage.predicate, "stage predicate")
  if stage.attempt < 1 {
    throw "release chain stage attempt must be positive"
  }
  if stage.subject_count != stage.proven_count + stage.unproven_count {
    throw "release chain stage counts do not partition the subject scope"
  }
  if stage.subject_count != len(stage.evidence) {
    throw "release chain stage evidence count does not match subject_count"
  }
  if stage.unproven_count != len(stage.unproven) {
    throw "release chain stage must name every unproven subject"
  }
  if stage.status == "proven" && !release_chain_stage_proven(stage) {
    throw "release chain stage cannot persist proven over an empty or unproven scope"
  }
  if stage.status == "failed" && stage.unproven_count == 0 && stage.subject_count > 0 {
    throw "release chain failed non-empty stage must name every unproven subject"
  }
  if stage.status == "failed" && stage.cause == nil {
    throw "release chain failed stage must carry a typed cause"
  }
  if stage.status != "failed" && stage.cause != nil && stage.cause != "stopped" {
    throw "release chain non-failure stage cannot carry a failure cause"
  }
  if stage.status == "effect_applied" && stage.effect == nil {
    throw "release chain effect_applied stage must carry its effect receipt"
  }
  if stage.effect != nil {
    require_nonempty(stage.effect.idempotency_key, "effect idempotency key")
    require_nonempty(stage.effect.target, "effect target")
    require_nonempty(stage.effect.accepted_identity, "effect accepted identity")
    if len(stage.effect.read_back) == 0 {
      throw "release chain effect receipt must carry read-back evidence"
    }
  }
  if stage.input_receipt_hash != "" && !regex_match("^[0-9a-f]{64}$", stage.input_receipt_hash) {
    throw "release chain stage input receipt hash must be SHA-256"
  }
  for evidence in stage.evidence {
    require_nonempty(evidence.subject, "evidence subject")
    require_nonempty(evidence.kind, "evidence kind")
    require_nonempty(evidence.source, "evidence source")
  }
  for unproven in stage.unproven {
    require_nonempty(unproven.subject, "unproven subject")
    require_nonempty(unproven.detail, "unproven detail")
  }
  return stage
}

pub fn release_chain_validate_receipt(receipt: ReleaseChainReceipt) -> ReleaseChainReceipt {
  require_nonempty(receipt.chain_id, "chain_id")
  require_nonempty(receipt.target.version, "target version")
  require_nonempty(receipt.target.source_repo, "source repository")
  require_nonempty(receipt.target.base_ref, "base ref")
  if receipt.target.tag != "v" + receipt.target.version {
    throw "release chain target tag must be derived from its version"
  }
  if !exact_sha(receipt.target.initial_pin_sha) {
    throw "release chain initial pin must be an exact commit SHA"
  }
  if receipt.revision < 0 || receipt.control_cursor < 0 {
    throw "release chain revision and control cursor must be non-negative"
  }
  if receipt.revision != len(receipt.stages) {
    throw "release chain revision must equal the append-only stage count"
  }
  if receipt.published_start != nil {
    return validate_published_history(receipt)
  }
  let expected: ReleaseChainStage = "preflight"
  let expected_attempt = 1
  for stage in receipt.stages {
    release_chain_validate_stage(stage)
    if stage.stage != expected {
      throw "release chain stages must be appended in canonical order"
    }
    if stage.attempt != expected_attempt {
      throw "release chain stage attempts must be contiguous"
    }
    if stage.status == "proven" {
      const next = release_chain_next_stage(expected)
      if next != nil {
        expected = next
        expected_attempt = 1
      }
    } else {
      expected_attempt = expected_attempt + 1
    }
  }
  if len(receipt.stages) == 0 && receipt.current_stage != "preflight" {
    throw "new release chain must begin at preflight"
  }
  if len(receipt.stages) > 0 {
    const last = receipt.stages[len(receipt.stages) - 1]
    if last.status == "proven" {
      const next = release_chain_next_stage(last.stage)
      const expected_current = next ?? last.stage
      if receipt.current_stage != expected_current {
        throw "release chain current stage does not follow its last proven receipt"
      }
    } else if receipt.current_stage != last.stage {
      throw "release chain current stage must remain on an unproven stage"
    }
  }
  return receipt
}

pub fn release_chain_receipt_hash(receipt: ReleaseChainReceipt) -> string {
  return sha256_hex(json_stringify(release_chain_validate_receipt(receipt)))
}

pub fn release_chain_new(
  chain_id: string,
  target: ReleaseChainTarget,
  created_at: string,
) -> ReleaseChainReceipt {
  return release_chain_validate_receipt(
    {
      schema_version: "harn.release-chain.v1",
      chain_id: chain_id,
      revision: 0,
      target: target,
      status: "active",
      current_stage: "preflight",
      control_cursor: 0,
      stages: [],
      created_at: created_at,
      updated_at: created_at,
    },
  )
}

/** Start at publication proof without inventing receipts for a fresh cut. */
pub fn release_chain_from_published(
  chain_id: string,
  target: ReleaseChainTarget,
  origin: {release_commit_oid: string, watch_identity: string},
  created_at: string,
) -> ReleaseChainReceipt {
  const receipt = release_chain_new(chain_id, target, created_at)
  return release_chain_validate_receipt(receipt + {current_stage: "prove", published_start: origin})
}

pub fn release_chain_append_stage(
  receipt: ReleaseChainReceipt,
  stage: ReleaseChainStageReceipt,
  updated_at: string,
) -> ReleaseChainReceipt {
  release_chain_validate_receipt(receipt)
  release_chain_validate_stage(stage)
  if receipt.status != "active" {
    throw "release chain cannot append a stage after ${receipt.status}"
  }
  if receipt.published_start == nil && stage.stage != receipt.current_stage {
    throw "release chain cannot append ${stage.stage} while current stage is ${receipt.current_stage}"
  }
  const expected_hash = release_chain_receipt_hash(receipt)
  if stage.input_receipt_hash != expected_hash {
    throw "release chain stage does not bind the prior receipt hash"
  }
  if receipt.published_start != nil {
    const appended = receipt + {stages: receipt.stages + [stage]}
    const pending = published_pending_stage(appended)
    const status: ReleaseChainStatus = if stage.status == "stopped" {
      "stopped"
    } else if stage.cause == "target_superseded"
      || stage.cause == "unknown" {
      "escalated"
    } else if pending == nil {
      "complete"
    } else {
      "active"
    }
    return release_chain_validate_receipt(
      appended
        + {
          revision: receipt.revision + 1,
          current_stage: pending ?? "converge",
          status: status,
          updated_at: updated_at,
        },
    )
  }
  const next = release_chain_next_stage(stage.stage)
  const status: ReleaseChainStatus = if stage.status == "stopped" {
    "stopped"
  } else if stage.status == "failed"
    && stage.cause == "unknown" {
    "escalated"
  } else if stage.status == "proven" && next == nil {
    "complete"
  } else {
    "active"
  }
  const current_stage = if stage.status == "proven" {
    next ?? stage.stage
  } else {
    stage.stage
  }
  return release_chain_validate_receipt(
    receipt
      + {
        revision: receipt.revision + 1,
        status: status,
        current_stage: current_stage,
        stages: receipt.stages + [stage],
        updated_at: updated_at,
      },
  )
}

pub fn release_chain_with_control_cursor(
  receipt: ReleaseChainReceipt,
  cursor: int,
  updated_at: string,
) -> ReleaseChainReceipt {
  if cursor < receipt.control_cursor {
    throw "release chain control cursor cannot move backward"
  }
  return release_chain_validate_receipt(receipt + {control_cursor: cursor, updated_at: updated_at})
}

fn chain_root(root: string, chain_id: string) -> string {
  return path_join(root, "release-chain", sha3_256(trim(chain_id)))
}

pub fn release_chain_receipt_path(root: string, chain_id: string, revision: int) -> string {
  if revision < 0 {
    throw "release chain receipt revision must be non-negative"
  }
  return path_join(chain_root(root, chain_id), "receipts", to_string(revision) + ".json")
}

pub fn release_chain_head_path(root: string, chain_id: string) -> string {
  return path_join(chain_root(root, chain_id), "head.json")
}

pub fn release_chain_control_path(root: string, chain_id: string, sequence: int) -> string {
  if sequence < 1 {
    throw "release chain control sequence must be positive"
  }
  return path_join(chain_root(root, chain_id), "controls", to_string(sequence) + ".json")
}

pub fn release_chain_control_head_path(root: string, chain_id: string) -> string {
  return path_join(chain_root(root, chain_id), "controls", "head.json")
}

fn atomic_write(harness: {fs: HarnessFs, random: HarnessRandom}, path: string, value: any) -> nil {
  harness.fs.mkdir(dirname(path), true)
  const temporary = path + ".tmp-" + harness.random.uuid_v7()
  write_json(harness.fs, temporary, value, {pretty: true})
  harness.fs.rename(temporary, path)
  return nil
}

pub fn release_chain_receipt_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  root: string,
  receipt: ReleaseChainReceipt,
) -> string {
  release_chain_validate_receipt(receipt)
  const path = release_chain_receipt_path(root, receipt.chain_id, receipt.revision)
  if harness.fs.exists(path) {
    throw "release chain receipt revision ${receipt.revision} is append-only"
  }
  atomic_write(harness, path, receipt)
  const head: ReleaseChainHead = {
    schema_version: "harn.release-chain.head.v1",
    chain_id: receipt.chain_id,
    latest_revision: receipt.revision,
    receipt_hash: release_chain_receipt_hash(receipt),
  }
  atomic_write(harness, release_chain_head_path(root, receipt.chain_id), head)
  return path
}

fn typed_read<T>(fs: HarnessFs, path: string, schema: any, label: string) -> T? {
  const result = read_json_typed_result<T>(fs, path, schema)
  if is_ok(result) {
    return unwrap(result)
  }
  const failure = unwrap_err(result)
  if failure.kind == "absent" {
    return nil
  }
  throw "invalid ${label} at ${path}: ${failure.kind}: ${failure.detail}"
}

pub fn release_chain_receipt_read(
  fs: HarnessFs,
  root: string,
  chain_id: string,
  revision: int,
) -> ReleaseChainReceipt? {
  const receipt = typed_read<ReleaseChainReceipt>(
    fs,
    release_chain_receipt_path(root, chain_id, revision),
    schema_of(ReleaseChainReceipt),
    "release chain receipt",
  )
  if receipt == nil {
    return nil
  }
  if receipt.chain_id != chain_id || receipt.revision != revision {
    throw "release chain receipt identity does not match its path"
  }
  return release_chain_validate_receipt(receipt)
}

pub fn release_chain_replay(
  fs: HarnessFs,
  root: string,
  chain_id: string,
) -> list<ReleaseChainReceipt> {
  const head = typed_read<ReleaseChainHead>(
    fs,
    release_chain_head_path(root, chain_id),
    schema_of(ReleaseChainHead),
    "release chain head",
  )
  if head == nil {
    return []
  }
  if head.chain_id != chain_id {
    throw "release chain head identity does not match its path"
  }
  let history: list<ReleaseChainReceipt> = []
  let revision = 0
  while revision <= head.latest_revision {
    const receipt = release_chain_receipt_read(fs, root, chain_id, revision)
    if receipt == nil {
      throw "release chain history is missing revision ${revision}"
    }
    if revision > 0 {
      const prior = history.find({ row -> row.revision == revision - 1 })
      if prior == nil {
        throw "release chain history lost revision ${revision - 1} during replay"
      }
      const appended = receipt.stages[revision - 1]
      if appended.input_receipt_hash != release_chain_receipt_hash(prior) {
        throw "release chain history breaks its prior-receipt hash at revision ${revision}"
      }
    }
    history = history + [receipt]
    revision = revision + 1
  }
  const latest = history.find({ row -> row.revision == head.latest_revision })
  if latest == nil {
    throw "release chain history has no latest receipt"
  }
  if release_chain_receipt_hash(latest) != head.receipt_hash {
    throw "release chain head hash does not match its latest receipt"
  }
  return history
}

pub fn release_chain_control_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  root: string,
  control: ReleaseChainControlReceipt,
) -> string {
  require_nonempty(control.chain_id, "control chain_id")
  require_nonempty(control.actor, "control actor")
  require_nonempty(control.reason, "control reason")
  if control.sequence < 1 || control.revision < 0 {
    throw "release chain control sequence/revision is invalid"
  }
  if control.kind == "steer" && trim(control.field) == "" {
    throw "release chain steer must name a field"
  }
  const head_path = release_chain_control_head_path(root, control.chain_id)
  const prior = typed_read<ReleaseChainControlHead>(
    harness.fs,
    head_path,
    schema_of(ReleaseChainControlHead),
    "release chain control head",
  )
  const expected = if prior == nil {
    1
  } else {
    prior.latest_sequence + 1
  }
  if control.sequence != expected {
    throw "release chain control sequence must append at ${expected}"
  }
  const path = release_chain_control_path(root, control.chain_id, control.sequence)
  if harness.fs.exists(path) {
    throw "release chain control sequence ${control.sequence} is append-only"
  }
  atomic_write(harness, path, control)
  const next_head: ReleaseChainControlHead = {
    schema_version: "harn.release-chain.control-head.v1",
    chain_id: control.chain_id,
    latest_sequence: control.sequence,
  }
  atomic_write(harness, head_path, next_head)
  return path
}

pub fn release_chain_controls_since(
  fs: HarnessFs,
  root: string,
  chain_id: string,
  cursor: int,
  through: int,
) -> list<ReleaseChainControlReceipt> {
  if through < cursor {
    throw "release chain control range cannot move backward"
  }
  let controls: list<ReleaseChainControlReceipt> = []
  let sequence = cursor + 1
  while sequence <= through {
    const control = typed_read<ReleaseChainControlReceipt>(
      fs,
      release_chain_control_path(root, chain_id, sequence),
      schema_of(ReleaseChainControlReceipt),
      "release chain control",
    )
    if control == nil {
      throw "release chain control history is missing sequence ${sequence}"
    }
    if control.chain_id != chain_id || control.sequence != sequence {
      throw "release chain control identity does not match its path"
    }
    controls = controls + [control]
    sequence = sequence + 1
  }
  return controls
}

/** Discover every durable control event not yet consumed by this receipt. */
pub fn release_chain_pending_controls(
  fs: HarnessFs,
  root: string,
  receipt: ReleaseChainReceipt,
) -> list<ReleaseChainControlReceipt> {
  const head = typed_read<ReleaseChainControlHead>(
    fs,
    release_chain_control_head_path(root, receipt.chain_id),
    schema_of(ReleaseChainControlHead),
    "release chain control head",
  )
  if head == nil {
    return []
  }
  if head.chain_id != receipt.chain_id || head.latest_sequence < receipt.control_cursor {
    throw "release chain control head does not match the receipt cursor"
  }
  return release_chain_controls_since(
    fs,
    root,
    receipt.chain_id,
    receipt.control_cursor,
    head.latest_sequence,
  )
}
