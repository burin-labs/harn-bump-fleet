import { command_result_fail, command_result_ok } from "std/command"
import {
  ConsumerPretagGateAdapter,
  ConsumerPretagRunRow,
  run_consumer_pretag_gates,
} from "./consumer_pretag_dispatch"
import {
  ConsumerPretagCandidate,
  ConsumerPretagGateTarget,
  consumer_pretag_gate_targets,
  consumer_pretag_gate_verdict,
} from "./consumer_pretag_gate"
import { hydrate_remote_consumer_repositories } from "./consumer_projection_manifest"
import { read_fleet_manifest } from "./fleet_manifest"
import { github_actions_run, github_actions_runs, github_workflow_dispatch } from "./github"
import { recorded_step } from "./release_execution"

pub type ConsumerPretagCertification = {success: bool, steps: list<dict>}

fn run_row(run: any) -> ConsumerPretagRunRow {
  return {
    id: run.id,
    status: to_string(run.status),
    conclusion: to_string(run.conclusion ?? ""),
    html_url: to_string(run.url ?? ""),
    display_title: to_string(run.display_title ?? ""),
  }
}

/** The live GitHub adapter for consumer pre-tag gates. */
pub fn consumer_pretag_gate_adapter(harness: Harness) -> ConsumerPretagGateAdapter {
  return {
    dispatch: fn(target) {
      const sent = github_workflow_dispatch(
        harness,
        target.slug,
        target.workflow,
        target.inputs,
        "main",
      )
      if is_err(sent) {
        return Err({message: to_string(unwrap_err(sent))})
      }
      return Ok(nil)
    },
    runs: fn(target) {
      const listed = github_actions_runs(harness, target.slug, target.workflow, "main")
      if is_err(listed) {
        return Err({message: to_string(unwrap_err(listed))})
      }
      return Ok(unwrap(listed).runs.map({ run -> run_row(run) }).to_list())
    },
    run: fn(target, run_id) {
      const read = github_actions_run(harness, target.slug, run_id)
      if is_err(read) {
        return Err({message: to_string(unwrap_err(read))})
      }
      return Ok(run_row(unwrap(read)))
    },
    wait: fn(ms) { harness.clock.sleep_ms(ms) },
    now_ms: fn() { return (to_int(date_parse(harness.clock.date_iso())) ?? 0) * 1000 },
  }
}

/** Every consumer gate this candidate must clear, read from the consumers' own manifests. */
pub fn consumer_pretag_targets_for_candidate(
  harness: Harness,
  candidate: ConsumerPretagCandidate,
) -> list<ConsumerPretagGateTarget> {
  const fleet = read_fleet_manifest(harness.fs)
  const hydrated = hydrate_remote_consumer_repositories(harness, fleet, fleet.repositories, "main")
  return consumer_pretag_gate_targets(hydrated, candidate)
}

/**
 * Judge this candidate through every consumer that declares a pre-tag gate.
 *
 * The verdict's `declared` count is reported in the step text on purpose: a
 * release whose consumers all silently stopped declaring gates would otherwise
 * read exactly like a release whose consumers all passed.
 */
pub fn run_consumer_pretag_certification(
  harness: Harness,
  cfg: dict,
  candidate: ConsumerPretagCandidate,
  targets: list<ConsumerPretagGateTarget>? = nil,
  adapter: ConsumerPretagGateAdapter? = nil,
) -> ConsumerPretagCertification {
  if cfg.mock ?? false {
    return {
      success: true,
      steps: [
        recorded_step(
          "consumer-pretag-gate",
          "dispatch consumer pre-tag gates",
          command_result_ok("mock release: consumer pre-tag gates were not dispatched\n"),
        ),
      ],
    }
  }
  const resolved = targets ?? consumer_pretag_targets_for_candidate(harness, candidate)
  const receipts = run_consumer_pretag_gates(
    resolved,
    adapter ?? consumer_pretag_gate_adapter(harness),
  )
  const verdict = consumer_pretag_gate_verdict(resolved, receipts)
  return {
    success: verdict.proven,
    steps: [
      {
        ...recorded_step(
          "consumer-pretag-gate",
          "prove ${to_string(verdict.declared)} consumer pre-tag gate(s) on this candidate",
          if verdict.proven {
            command_result_ok(verdict.summary + "\n")
          } else {
            command_result_fail(2, verdict.summary)
          },
        ),
        consumer_pretag_verdict: verdict,
        consumer_pretag_receipts: receipts,
      },
    ],
  }
}
