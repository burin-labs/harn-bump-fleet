import { command_result_fail, command_result_ok } from "std/command"
import {
  ConsumerPretagGateAdapter,
  ConsumerPretagJobRow,
  ConsumerPretagJobsPage,
  ConsumerPretagProofRuns,
  ConsumerPretagRunRecorder,
  ConsumerPretagRunRow,
  consumer_pretag_gate_policy,
  run_consumer_pretag_gates,
} from "./consumer_pretag_dispatch"
import {
  ConsumerPretagCandidate,
  ConsumerPretagGateTarget,
  consumer_pretag_gate_targets,
  consumer_pretag_gate_verdict,
} from "./consumer_pretag_gate"
import { hydrate_remote_consumer_repositories } from "./consumer_projection_manifest"
import { read_fleet_manifest } from "./fleet_manifest"
import {
  github_actions_run,
  github_actions_run_jobs,
  github_actions_runs,
  github_branch_head,
  github_workflow_dispatch,
} from "./github"
import { github_actions_run_cancel_exact } from "./platform_certification"
import { recorded_step } from "./release_execution"

pub type ConsumerPretagCertification = {success: bool, steps: list<dict>}

/** One cancelled consumer gate run, in the shape the certification cleanup carries. */
pub type ConsumerPretagCancellationReceipt = {
  slug: string,
  run_id: int,
  success: bool,
  provider: "github" | "mock",
  error: string?,
}

/** Where dispatched consumer run ids are published so a canceller can reach them. */
pub type ConsumerPretagDispatchRegistry = {handle: any}

pub fn consumer_pretag_dispatch_registry(
  runtime: HarnessRuntime,
  key: string,
) -> ConsumerPretagDispatchRegistry {
  return {handle: runtime.shared_map({scope: "task_group", key: key})}
}

pub fn record_consumer_pretag_dispatch(
  runtime: HarnessRuntime,
  registry: ConsumerPretagDispatchRegistry,
  slug: string,
  run_id: int,
) -> nil {
  runtime.shared_map_set(registry.handle, slug, {run_id: run_id})
  return nil
}

/**
 * Cancel the consumer runs recorded before this lane was interrupted.
 *
 * A consumer gate is a full runtime build on that consumer's largest runner
 * class, so a run left behind by a cancelled certification holds a scarce lane
 * for tens of minutes after the release already decided to stop. The targets
 * are passed in rather than read back out of the registry because a target that
 * never reached a run id has nothing to cancel and must not look like one that
 * did.
 */
pub fn cancel_recorded_consumer_pretag_runs(
  harness: Harness,
  targets: list<ConsumerPretagGateTarget>,
  registry: ConsumerPretagDispatchRegistry,
  mock: bool = false,
) -> list<ConsumerPretagCancellationReceipt> {
  let receipts: list<ConsumerPretagCancellationReceipt> = []
  for target in targets {
    const dispatch = harness.runtime.shared_map_get(registry.handle, target.slug, nil)
    if dispatch == nil {
      continue
    }
    if mock {
      receipts = receipts
        + [
          {slug: target.slug, run_id: dispatch.run_id, success: true, provider: "mock", error: nil},
        ]
      continue
    }
    const result = github_actions_run_cancel_exact(harness, target.slug, dispatch.run_id)
    receipts = receipts
      + [
        {
          slug: target.slug,
          run_id: dispatch.run_id,
          success: is_ok(result),
          provider: "github",
          error: if is_err(result) {
            to_string(unwrap_err(result))
          } else {
            nil
          },
        },
      ]
  }
  return receipts
}

fn run_row(run: any) -> ConsumerPretagRunRow {
  return {
    id: run.id,
    status: to_string(run.status),
    conclusion: to_string(run.conclusion ?? ""),
    html_url: to_string(run.url ?? ""),
    display_title: to_string(run.display_title ?? ""),
    head_sha: to_string(run.head_sha ?? ""),
    workflow_path: to_string(run.workflow_path ?? ""),
    event: to_string(run.event ?? ""),
    head_branch: to_string(run.head_branch ?? ""),
  }
}

fn job_row(job: any) -> ConsumerPretagJobRow {
  return {
    id: job.id,
    run_id: job.run_id,
    name: to_string(job.name),
    status: to_string(job.status),
    conclusion: to_string(job.conclusion ?? ""),
    head_sha: to_string(job.head_sha),
    steps: job.steps.map(
      { step ->
        {
          name: to_string(step.name),
          status: to_string(step.status),
          conclusion: to_string(step.conclusion ?? ""),
        }
      },
    )
      .to_list(),
  }
}

fn jobs_page(page: any) -> ConsumerPretagJobsPage {
  return {
    repo: to_string(page.repo),
    run_id: page.run_id,
    total_count: page.total_count,
    jobs: page.jobs.map({ job -> job_row(job) }).to_list(),
  }
}

/** The live GitHub adapter for consumer pre-tag gates. */
pub fn consumer_pretag_gate_adapter(harness: Harness) -> ConsumerPretagGateAdapter {
  return {
    consumer_revision: fn(target) {
      const head = github_branch_head(harness, target.slug, "main")
      if is_err(head) {
        return Err({message: to_string(unwrap_err(head))})
      }
      return Ok(unwrap(head).oid)
    },
    dispatch: fn(target) {
      const sent = github_workflow_dispatch(
        harness,
        target.slug,
        target.workflow,
        target.inputs,
        "main",
      )
      if is_err(sent) {
        return Err({message: to_string(unwrap_err(sent))})
      }
      return Ok({run_id: unwrap(sent).run_id, head_sha: unwrap(sent).head_sha})
    },
    runs: fn(target) {
      const listed = github_actions_runs(harness, target.slug, target.workflow, "main")
      if is_err(listed) {
        return Err({message: to_string(unwrap_err(listed))})
      }
      return Ok(unwrap(listed).runs.map({ run -> run_row(run) }).to_list())
    },
    run: fn(target, run_id) {
      const read = github_actions_run(harness, target.slug, run_id)
      if is_err(read) {
        return Err({message: to_string(unwrap_err(read))})
      }
      return Ok(run_row(unwrap(read)))
    },
    jobs: fn(target, run_id) {
      const read = github_actions_run_jobs(harness, target.slug, run_id, "latest")
      if is_err(read) {
        return Err({message: to_string(unwrap_err(read))})
      }
      return Ok(jobs_page(unwrap(read)))
    },
    wait: fn(ms) { harness.clock.sleep_ms(ms) },
    now_ms: fn() { return (to_int(date_parse(harness.clock.date_iso())) ?? 0) * 1000 },
  }
}

/** Every consumer gate this candidate must clear, read from the consumers' own manifests. */
pub fn consumer_pretag_targets_for_candidate(
  harness: Harness,
  candidate: ConsumerPretagCandidate,
) -> list<ConsumerPretagGateTarget> {
  const fleet = read_fleet_manifest(harness.fs)
  const hydrated = hydrate_remote_consumer_repositories(harness, fleet, fleet.repositories, "main")
  return consumer_pretag_gate_targets(hydrated, candidate)
}

/**
 * Judge this candidate through every consumer that declares a pre-tag gate.
 *
 * The verdict's `declared` count is reported in the step text on purpose: a
 * release whose consumers all silently stopped declaring gates would otherwise
 * read exactly like a release whose consumers all passed.
 */
pub fn run_consumer_pretag_certification(
  harness: Harness,
  cfg: dict,
  candidate: ConsumerPretagCandidate,
  targets: list<ConsumerPretagGateTarget>? = nil,
  adapter: ConsumerPretagGateAdapter? = nil,
  recorder: ConsumerPretagRunRecorder? = nil,
  explicit_runs: ConsumerPretagProofRuns = {},
) -> ConsumerPretagCertification {
  if cfg.mock ?? false {
    return {
      success: true,
      steps: [
        recorded_step(
          "consumer-pretag-gate",
          "dispatch consumer pre-tag gates",
          command_result_ok("mock release: consumer pre-tag gates were not dispatched\n"),
        ),
      ],
    }
  }
  const resolved = targets ?? consumer_pretag_targets_for_candidate(harness, candidate)
  const receipts = run_consumer_pretag_gates(
    resolved,
    adapter ?? consumer_pretag_gate_adapter(harness),
    consumer_pretag_gate_policy(cfg.pre_tag_resume ?? false),
    recorder,
    explicit_runs,
  )
  const verdict = consumer_pretag_gate_verdict(resolved, receipts)
  return {
    success: verdict.proven,
    steps: [
      {
        ...recorded_step(
          "consumer-pretag-gate",
          "prove ${to_string(verdict.declared)} consumer pre-tag gate(s) on this candidate",
          if verdict.proven {
            command_result_ok(verdict.summary + "\n")
          } else {
            command_result_fail(2, verdict.summary)
          },
        ),
        consumer_pretag_verdict: verdict,
        consumer_pretag_receipts: receipts,
      },
    ],
  }
}

/**
 * The consumer gates this candidate must clear, resolved once before the lanes
 * start so the canceller in the parent knows who to reach.
 *
 * A resolution failure is carried rather than thrown, because throwing here
 * would fail the whole certification for a reason the consumer lane owns, and
 * returning an empty list would make "could not read the consumers" and "no
 * consumer declared a gate" the same answer.
 */
pub type ConsumerPretagPlan = {targets: list<ConsumerPretagGateTarget>, error: string?}

pub fn resolve_consumer_pretag_plan(
  harness: Harness,
  cfg: dict,
  candidate: ConsumerPretagCandidate,
) -> ConsumerPretagPlan {
  if cfg.mock ?? false {
    return {targets: [], error: nil}
  }
  return try {
    const targets = consumer_pretag_targets_for_candidate(harness, candidate)
    const explicit_runs: ConsumerPretagProofRuns = cfg.consumer_proof_runs ?? {}
    const unknown = explicit_runs.keys().filter(
      { slug -> !targets.any({ target -> target.slug == slug }) },
    )
      .to_list()
      .sorted()
    if len(unknown) > 0 {
      throw "explicit consumer proof runs name repositories without declared pre-tag gates: "
        + unknown.join(", ")
    }
    {targets: targets, error: nil}
  } catch (error) {
    {targets: [], error: to_string(error)}
  }
}

/** Judge this candidate through an already-resolved plan. */
pub fn run_consumer_pretag_certification_plan(
  harness: Harness,
  cfg: dict,
  candidate: ConsumerPretagCandidate,
  plan: ConsumerPretagPlan,
  adapter: ConsumerPretagGateAdapter? = nil,
  recorder: ConsumerPretagRunRecorder? = nil,
  explicit_runs: ConsumerPretagProofRuns = {},
) -> ConsumerPretagCertification {
  if plan.error != nil {
    return {
      success: false,
      steps: [
        recorded_step(
          "consumer-pretag-gate",
          "read the consumers' pre-tag contracts",
          command_result_fail(
            2,
            "could not resolve consumer pre-tag gates, so this candidate was judged by none of "
              + "them: "
              + to_string(plan.error),
          ),
        ),
      ],
    }
  }
  return run_consumer_pretag_certification(
    harness,
    cfg,
    candidate,
    plan.targets,
    adapter,
    recorder,
    explicit_runs,
  )
}
