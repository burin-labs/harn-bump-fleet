/** Result of checking or applying one fleet-owned workflow projection. */
pub type WorkflowProjectionSyncResult = {
  slug: string,
  path: string,
  status: "clean" | "drift" | "applied" | "error",
  error?: string,
}

/** Named byte projection passed to the shared filesystem boundary. */
pub type WorkflowProjection = {
  slug: string,
  repo_path: string,
  relative_path: string,
  expected: string,
}

/** Append one scalar or literal-block input to a reusable-workflow `with` mapping. */
pub fn append_workflow_string_input(
  lines: list<string>,
  name: string,
  raw: string,
) -> list<string> {
  const value = trim(raw)
  if value == "" {
    return lines
  }
  if !contains(value, "\n") {
    return lines + ["      ${name}: ${value}"]
  }
  let out = lines + ["      ${name}: |-"]
  for line in split(value, "\n") {
    out = out + ["        ${line}"]
  }
  return out
}

/** Check or write one exact workflow without duplicating filesystem policy. */
pub fn sync_workflow_projection(
  fs: HarnessFs,
  projection: WorkflowProjection,
  apply: bool,
) -> WorkflowProjectionSyncResult {
  const workflow_path = path_join(projection.repo_path, projection.relative_path)
  if !fs.exists(path_join(projection.repo_path, ".git")) {
    return {
      slug: projection.slug,
      path: workflow_path,
      status: "error",
      error: "not a Git checkout",
    }
  }
  const current = if fs.exists(workflow_path) {
    fs.read_text(workflow_path)
  } else {
    ""
  }
  if current == projection.expected {
    return {slug: projection.slug, path: workflow_path, status: "clean"}
  }
  if !apply {
    return {slug: projection.slug, path: workflow_path, status: "drift"}
  }
  fs.mkdir(dirname(workflow_path), true)
  fs.write_text(workflow_path, projection.expected)
  return {slug: projection.slug, path: workflow_path, status: "applied"}
}
