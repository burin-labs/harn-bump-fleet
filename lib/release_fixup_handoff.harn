import { changelog_find_section } from "std/changelog"
import { ReleasePublication, ReleasePullRequestIdentity } from "./release_publication"
import { workspace_version_from_manifest } from "release_analysis"
import { ReleaseRepoConfig, release_git_remote_refs, run_git } from "release_runtime"

pub type ReleaseTaggedFixupVerification = {
  head_oid: string,
  remote_ref: string,
  version: string,
  release_body_preserved: bool,
}

fn changelog_section_body(text: string, heading: string) -> string {
  const section = changelog_find_section(text, heading)
  return is_ok(section) ? unwrap(section).body : ""
}

/** Prove an open post-publish fixup PR is signed and preserves shipped content. */
pub fn verify_tagged_fixup_handoff(
  harness: {env: HarnessEnv, process: HarnessProcess},
  cfg: ReleaseRepoConfig,
  publication: ReleasePublication,
  pull_request: ReleasePullRequestIdentity,
) -> ReleaseTaggedFixupVerification {
  const head_oid = lowercase(trim(pull_request.head.sha))
  const remote_ref = "refs/heads/${trim(pull_request.head.ref)}"
  const remote = release_git_remote_refs(harness.process, cfg, [remote_ref])
  if !remote.success
    || len(remote.refs) != 1
    || lowercase(remote.refs[0]?.oid ?? "")
      != head_oid {
    throw "tagged release fixup PR ${pull_request.url} no longer matches ${remote_ref} at ${head_oid}"
  }
  const fetched = run_git(harness, cfg, ["fetch", "--quiet", "origin", remote_ref])
  const fetched_head = run_git(harness, cfg, ["rev-parse", "FETCH_HEAD^{}"])
  if !fetched.success || !fetched_head.success
    || lowercase(trim(fetched_head.stdout ?? ""))
      != head_oid {
    throw "could not fetch exact tagged release fixup PR head ${head_oid} from ${remote_ref}"
  }
  const signed = run_git(harness, cfg, ["verify-commit", "--raw", head_oid])
  if !signed.success {
    throw "tagged release fixup PR ${pull_request.url} head ${head_oid} is not a valid signed commit"
  }
  const fixup_manifest = run_git(harness, cfg, ["show", "${head_oid}:Cargo.toml"])
  const fixup_changelog = run_git(harness, cfg, ["show", "${head_oid}:CHANGELOG.md"])
  const shipped_changelog = run_git(harness, cfg, ["show", "${publication.head_oid}:CHANGELOG.md"])
  const fixup_version = if fixup_manifest.success {
    workspace_version_from_manifest(fixup_manifest.stdout ?? "")
  } else {
    ""
  }
  const fixup_release_body = if fixup_changelog.success {
    changelog_section_body(fixup_changelog.stdout ?? "", "v${publication.version}")
  } else {
    ""
  }
  const shipped_release_body = if shipped_changelog.success {
    changelog_section_body(shipped_changelog.stdout ?? "", "v${publication.version}")
  } else {
    ""
  }
  const release_body_preserved = trim(shipped_release_body) != ""
    && trim(fixup_release_body)
      == trim(shipped_release_body)
  if fixup_version != publication.version || !release_body_preserved {
    throw "tagged release fixup PR ${pull_request.url} does not preserve workspace version v${publication.version} and its shipped release body"
  }
  return {
    head_oid: head_oid,
    remote_ref: remote_ref,
    version: fixup_version,
    release_body_preserved: release_body_preserved,
  }
}
