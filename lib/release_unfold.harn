/**
 * Undoing a version bump that merged but must not be published.
 *
 * This is the recovery a person wrote by hand the night the tree gate refused
 * a tag: main was carrying version 0.10.128 with no tag, the release preflight
 * refuses to cut again while main is not a development version, and resuming
 * the original receipt re-enters the same refusal. The way out was a revert
 * pull request, and it was written by hand because nothing in the harness
 * offered to write it.
 *
 * The revert is a plain `git revert` of the one-parent squash commit, which is
 * exactly right and needs no cleverness: reverting that one commit restores the
 * development version and brings back every changelog fragment the release
 * folded, in one diff, because folding and bumping were the only things it did.
 * Reconstructing those two edits separately would be a second implementation of
 * the fold, drifting from the first.
 *
 * The pull request is opened, never merged here. Reverting the branch is a
 * change to main that a person should see and admit, and the release has just
 * demonstrated that it was wrong about something. What the harness owes is that
 * the recovery exists, is correct, and explains itself.
 */
pub type ReleaseUnfoldAction = "open" | "already_open" | "refuse"

pub type ReleaseUnfoldState = {
  tag: string,
  version: string,
  /** The release merge commit on main, the one to revert. */
  merge_commit: string,
  /** The development version main should carry once the revert lands. */
  development_version: string,
  /** True when a tag already names this release, which makes reverting wrong. */
  tag_published: bool,
  /** Number of an unfold pull request already open, or 0. */
  open_pull_number: int,
}

pub type ReleaseUnfoldDecision = {
  action: ReleaseUnfoldAction,
  reason: string,
  terminal_reason: string,
  branch: string,
  title: string,
}

fn oid(value: string?) -> string {
  return lowercase(trim(to_string(value ?? "")))
}

fn exact_commit(value: string?) -> bool {
  return regex_match("^[0-9a-f]{40}$", oid(value)) != nil
}

/** The branch one unfold owns. Named for the version so a retry finds its own. */
pub fn release_unfold_branch(version: string) -> string {
  return "release-unfold/v" + trim(version)
}

pub fn release_unfold_title(version: string) -> string {
  return "[Release] Unfold the v${trim(version)} bump after its post-merge certification failed"
}

/** Revert the one-parent squash commit GitHub creates for the release PR. */
pub fn release_unfold_revert_args(merge_commit: string) -> list<string> {
  return ["revert", "--no-edit", oid(merge_commit)]
}

fn unfold_decision(
  action: ReleaseUnfoldAction,
  reason: string,
  terminal_reason: string = "",
  version: string = "",
) -> ReleaseUnfoldDecision {
  return {
    action: action,
    reason: reason,
    terminal_reason: terminal_reason,
    branch: if trim(version) == "" {
      ""
    } else {
      release_unfold_branch(version)
    },
    title: if trim(version) == "" {
      ""
    } else {
      release_unfold_title(version)
    },
  }
}

/**
 * Decide whether the bump may be unfolded.
 *
 * A published tag is the one hard refusal. Once consumers can pin a version,
 * reverting the commit it names does not unpublish it, it only makes main
 * disagree with something immutable. That case is a different problem and this
 * is not its tool.
 */
pub fn release_unfold_decision(state: ReleaseUnfoldState) -> ReleaseUnfoldDecision {
  if !exact_commit(state.merge_commit) {
    return unfold_decision(
      "refuse",
      "unfolding needs the exact release merge commit to revert",
      "unfold_merge_commit_not_observed",
    )
  }
  if trim(state.version) == "" || trim(state.development_version) == "" {
    return unfold_decision(
      "refuse",
      "unfolding needs both the released version and the development version to restore",
      "unfold_versions_not_observed",
    )
  }
  if state.tag_published {
    return unfold_decision(
      "refuse",
      "${state.tag} is already published, so reverting ${oid(state.merge_commit)} would leave"
        + " main disagreeing with an immutable tag rather than undoing anything",
      "unfold_tag_already_published",
    )
  }
  if state.open_pull_number > 0 {
    return unfold_decision(
      "already_open",
      "pull request #${to_string(state.open_pull_number)} already unfolds v${trim(state.version)}",
      "",
      state.version,
    )
  }
  return unfold_decision(
    "open",
    "revert ${oid(state.merge_commit)} so main returns to ${trim(state.development_version)}"
      + " and the changelog fragments come back",
    "",
    state.version,
  )
}

/**
 * The body of the unfold pull request.
 *
 * Written for whoever finds this open on a morning they were not expecting it.
 * It says what happened, what the revert does, and what to do next, because a
 * revert with no explanation reads like something went wrong with the revert.
 */
pub type ReleaseUnfoldNarrative = {
  tag: string,
  version: string,
  development_version: string,
  merge_commit: string,
  failing_check: string,
  drifted_commits: string,
}

pub fn release_unfold_body(narrative: ReleaseUnfoldNarrative) -> string {
  const version = narrative.version
  const development_version = narrative.development_version
  const merge_commit = narrative.merge_commit
  const failing_check = narrative.failing_check
  const drifted_commits = narrative.drifted_commits
  return "Reverts the ${trim(version)} version bump, which merged but must not be published.\n\n"
    + "The release certified one tree. While it was certifying, commits landed on main that"
    + " passed main's own required checks, and the release merged onto them as designed, because"
    + " requiring a still branch for two hours is a freeze. The merged commit"
    + " ${oid(merge_commit)} then failed ${failing_check}, which only a release runs, so the"
    + " certification does not carry over to the tree that would have been tagged.\n\n"
    + "Commits that drifted in during certification: ${drifted_commits}.\n\n"
    + "No tag was minted, so nothing published needs withdrawing. Reverting the bump returns main"
    + " to ${trim(development_version)} and restores the changelog fragments this release folded,"
    + " which is what makes the next cut admissible: the release preflight refuses to start while"
    + " main is not a development version.\n\n"
    + "Merging this is the recovery. Fix ${failing_check} on main first if it is still red, then"
    + " cut ${trim(version)} again."
}
