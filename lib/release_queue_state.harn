import { read_json_typed_result, write_json } from "std/fs"
import { ReleaseQueueCheckpoint, ReleaseQueueReservationReceipt } from "./release_queue_reservation"

pub type ReleaseQueueActivePointer = {
  schema_version: "harn.release_queue.active.v1",
  reservation_id: string,
  state: "active" | "restoring" | "terminal",
  receipt_path: string,
}

fn reservation_key(reservation_id: string) -> string {
  const value = trim(reservation_id)
  if value == "" {
    throw "release queue reservation ID is required"
  }
  return sha3_256(value)
}

/** Return one stable path for an audit, reserve, or restore receipt. */
pub fn release_queue_receipt_path(
  root: string,
  reservation_id: string,
  phase: "audit" | "reserve" | "restore",
) -> string {
  return path_join(root, "queue-reservations", reservation_key(reservation_id), phase + ".json")
}

pub fn release_queue_active_pointer_path(root: string) -> string {
  return path_join(root, "queue-reservations", "active.json")
}

fn atomic_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  path: string,
  value: any,
) -> string {
  harness.fs.mkdir(dirname(path), true)
  const temporary = path + ".tmp-" + harness.random.uuid_v7()
  write_json(harness.fs, temporary, value, {pretty: true})
  harness.fs.rename(temporary, path)
  return path
}

/** Read one receipt through its closed schema. */
pub fn release_queue_receipt_read(fs: HarnessFs, path: string) -> ReleaseQueueReservationReceipt? {
  const result = read_json_typed_result<ReleaseQueueReservationReceipt>(
    fs,
    path,
    schema_of(ReleaseQueueReservationReceipt),
  )
  if is_ok(result) {
    return unwrap(result)
  }
  const failure = unwrap_err(result)
  if failure.kind == "absent" {
    return nil
  }
  throw "invalid release queue receipt ${path}: ${failure.kind}: ${failure.detail}"
}

fn active_pointer_read(fs: HarnessFs, root: string) -> ReleaseQueueActivePointer? {
  const result = read_json_typed_result<ReleaseQueueActivePointer>(
    fs,
    release_queue_active_pointer_path(root),
    schema_of(ReleaseQueueActivePointer),
  )
  if is_ok(result) {
    return unwrap(result)
  }
  const failure = unwrap_err(result)
  if failure.kind == "absent" {
    return nil
  }
  throw "invalid release queue active pointer: ${failure.kind}: ${failure.detail}"
}

fn pointer_for(root: any, receipt: any, receipt_path: any) -> ReleaseQueueActivePointer? {
  if receipt.phase == "reserve" && (receipt.status == "partial" || receipt.status == "reserved") {
    return {
      schema_version: "harn.release_queue.active.v1",
      reservation_id: receipt.reservation_id,
      state: "active",
      receipt_path: receipt_path,
    }
  }
  if receipt.phase == "restore" && receipt.status == "partial" {
    return {
      schema_version: "harn.release_queue.active.v1",
      reservation_id: receipt.reservation_id,
      state: "restoring",
      receipt_path: receipt_path,
    }
  }
  if receipt.phase == "restore" && receipt.status == "restored" {
    return {
      schema_version: "harn.release_queue.active.v1",
      reservation_id: receipt.reservation_id,
      state: "terminal",
      receipt_path: receipt_path,
    }
  }
  return nil
}

/** Atomically persist one mutation checkpoint and its concurrency pointer. */
pub fn release_queue_receipt_write(
  harness: {fs: HarnessFs, random: HarnessRandom},
  root: string,
  receipt: ReleaseQueueReservationReceipt,
) -> string {
  const path = release_queue_receipt_path(root, receipt.reservation_id, receipt.phase)
  atomic_write(harness, path, receipt)
  const pointer = pointer_for(root, receipt, path)
  if pointer != nil {
    atomic_write(harness, release_queue_active_pointer_path(root), pointer)
  }
  return path
}

/** Build the checkpoint callback used by reserve and restore operations. */
pub fn release_queue_checkpoint(
  harness: {fs: HarnessFs, random: HarnessRandom},
  root: string,
) -> ReleaseQueueCheckpoint {
  return fn(receipt) {
    release_queue_receipt_write(harness, root, receipt)
    return nil
  }
}

/** Return the reservation that still owns the queue, if any. */
pub fn release_queue_active_reservation_id(fs: HarnessFs, root: string) -> string? {
  const pointer = active_pointer_read(fs, root)
  if pointer == nil || pointer.state == "terminal" {
    return nil
  }
  const receipt = release_queue_receipt_read(fs, pointer.receipt_path)
  if receipt == nil || receipt.reservation_id != pointer.reservation_id {
    throw "active release queue pointer does not resolve to its typed receipt"
  }
  return pointer.reservation_id
}
