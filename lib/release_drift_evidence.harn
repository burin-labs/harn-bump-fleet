/**
 * What landed on the default branch while a release was certifying, and whether
 * each of those commits passed the branch's own required checks.
 *
 * The release certifies one exact tree, and main moves at a median of one merge
 * every twenty-one minutes, so a two-hour certification almost never sees a
 * still branch. Demanding that the merged tree equal the certified tree exactly
 * therefore means demanding a freeze. The contract instead is that the shipped
 * tree is the certified tree plus commits that passed main's own required
 * checks, and this module is what makes that claim checkable rather than
 * assumed: every drifted commit is named, every required context is resolved to
 * a conclusion, and the whole record goes in the release receipt.
 *
 * Three observed shapes drive the rules here, all measured on burin-labs/harn:
 *
 * - A required context can be absent from a main commit. `drift` appears on 2
 *   of the 20 most recent main commits and on 20 of 20 pull-request heads, so
 *   reading only the main commit would report a green branch as unproved.
 *   Evidence therefore falls back to the commit's own pull request head.
 * - A main commit carries stale failures beside fresh successes. Two of those
 *   20 show a failed workspace test next to a passing aggregate, because a
 *   rerun does not replace its predecessor's row. Rows reduce to the latest per
 *   name before anything is judged.
 * - A required context that never reported is absent, not passing. It resolves
 *   to `MISSING`, which is not green.
 */
import { admission_verdict, latest_check_per_name, required_check_state } from "./pr_admission"

pub type ReleaseDriftCheckSource = "main_commit" | "pull_request_head" | "missing"

pub type ReleaseDriftCheck = {
  name: string,
  state: string,
  source: ReleaseDriftCheckSource,
  /**
   * True for a lane only a release runs. Such a lane is not required by the
   * branch, so a commit can reach main before it reports. That makes an absent
   * result "not yet" rather than "never", which waits instead of refusing.
   */
  release_only: bool,
}

pub type ReleaseDriftCommit = {
  sha: string,
  /** 0 when no pull request could be associated with the commit. */
  pull_number: int,
  checks: list<ReleaseDriftCheck>,
  green: bool,
  blocking_check: string,
  /**
   * A release-only lane on this commit that has not reported yet. Distinct
   * from `blocking_check`: this one resolves itself by waiting, that one never
   * does.
   */
  pending_check: string,
  /**
   * Release-only lanes this commit failed. Recorded, never refused: the branch
   * does not require them, so they are evidence about the commit rather than a
   * verdict on it.
   */
  failed_lanes: list<string>,
}

pub type ReleaseDriftEvidence = {
  certified_base: string,
  observed_main: string,
  required_contexts: list<string>,
  commits: list<ReleaseDriftCommit>,
  green: bool,
  blocking_sha: string,
  blocking_check: string,
  /** True when nothing has failed but a release-only lane has not finished. */
  pending: bool,
  pending_sha: string,
  pending_check: string,
  reason: string,
  observed_at: string,
}

/** No lane is waiting, which every terminal verdict must say explicitly. */
const NOT_PENDING = {pending: false, pending_sha: "", pending_check: ""}

fn oid(value: any) -> string {
  return lowercase(trim(to_string(value ?? "")))
}

/**
 * Resolve one required context against a commit, then against its pull request.
 *
 * `required_check_state` already reduces to the latest row per name and returns
 * `MISSING` for a context that never reported, which is the difference between
 * "this check passed" and "nobody ran this check".
 */
fn resolve_context(
  context: string,
  commit_rows: list?,
  head_rows: list?,
  release_only: bool = false,
) -> ReleaseDriftCheck {
  const on_commit = required_check_state(latest_check_per_name(commit_rows), context)
  if on_commit != "MISSING" {
    return {name: context, state: on_commit, source: "main_commit", release_only: release_only}
  }
  const on_head = required_check_state(latest_check_per_name(head_rows), context)
  if on_head != "MISSING" {
    return {name: context, state: on_head, source: "pull_request_head", release_only: release_only}
  }
  return {name: context, state: "MISSING", source: "missing", release_only: release_only}
}

/**
 * The release-only lanes this commit owes an answer for.
 *
 * A lane only a release runs is required of a drifted commit exactly when that
 * commit touched a path the lane bears on. Without this condition a
 * documentation commit would owe a workspace test run that its own pull request
 * never triggered, and the release would wait forever for a result nobody is
 * going to produce.
 */
pub fn release_drift_lane_contexts(
  release_only_checks: list<string>,
  changed_paths: list<string>,
  bearing_paths: list<string>,
) -> list<string> {
  if len(release_only_checks) == 0 || len(changed_paths) == 0 || len(bearing_paths) == 0 {
    return []
  }
  return release_only_checks
}

/** Resolve every required context for one drifted commit. */
pub fn release_drift_commit_evidence(
  sha: string,
  pull_number: int,
  required_contexts: list<string>,
  commit_rows: list?,
  head_rows: list?,
  lane_contexts: list<string> = [],
) -> ReleaseDriftCommit {
  let checks: list<ReleaseDriftCheck> = []
  let blocking = ""
  let pending = ""
  let failed: list<string> = []
  // Both arms ask the same question of the same owner, so a required context
  // and a release-only lane can never drift apart on what admission means. The
  // only difference between them is which one the branch requires.
  for context in required_contexts {
    const resolved = resolve_context(context, commit_rows, head_rows)
    checks = checks + [resolved]
    const verdict = admission_verdict(true, resolved.state)
    if verdict == "refuse" && blocking == "" {
      blocking = resolved.name
    }
  }
  for lane in lane_contexts {
    if required_contexts.contains(lane) {
      continue
    }
    const resolved = resolve_context(lane, commit_rows, head_rows, true)
    checks = checks + [resolved]
    const verdict = admission_verdict(false, resolved.state)
    if verdict == "wait" && pending == "" {
      pending = resolved.name
    }
    if verdict == "note" {
      failed = failed + [resolved.name]
    }
  }
  return {
    sha: oid(sha),
    pull_number: pull_number,
    checks: checks,
    green: len(required_contexts) > 0 && blocking == "" && pending == "",
    blocking_check: blocking,
    pending_check: pending,
    failed_lanes: failed,
  }
}

/**
 * Judge the whole drift.
 *
 * An empty required set is refused rather than treated as satisfied. A branch
 * whose protection could not be read is indistinguishable from one with nothing
 * to satisfy, and the second reading would let every drifted commit through on
 * the strength of a failed API call.
 */
pub fn release_drift_evidence(
  certified_base: string,
  observed_main: string,
  required_contexts: list<string>,
  commits: list<ReleaseDriftCommit>,
  observed_at: string,
) -> ReleaseDriftEvidence {
  const base = {
    certified_base: oid(certified_base),
    observed_main: oid(observed_main),
    required_contexts: required_contexts,
    commits: commits,
    observed_at: observed_at,
  }
  const unproved = {green: false, blocking_sha: "", blocking_check: ""} + NOT_PENDING
  if len(required_contexts) == 0 {
    return base
      + unproved
      + {
        reason:
          "the branch's required checks could not be read, so no drifted commit can be proved green",
      }
  }
  if len(commits) == 0 {
    return base
      + unproved
      + {
        reason:
          "main moved but no drifted commit was reported; refusing to act on an unproved comparison",
      }
  }
  // A settled failure outranks an unfinished lane. A commit that failed a check
  // does not become admissible because another commit is still running one.
  for commit in commits {
    if commit.blocking_check != "" {
      return base
        + NOT_PENDING
        + {
          green: false,
          blocking_sha: commit.sha,
          blocking_check: commit.blocking_check,
          reason: "commit ${commit.sha} landed on main without passing ${commit.blocking_check}",
        }
    }
  }
  for commit in commits {
    if commit.pending_check != "" {
      return base
        + {
          green: false,
          blocking_sha: "",
          blocking_check: "",
          pending: true,
          pending_sha: commit.sha,
          pending_check: commit.pending_check,
          reason: "commit ${commit.sha} is still waiting on ${commit.pending_check}, which the branch"
            + " does not require and which runs on its pull request",
        }
    }
  }
  for commit in commits {
    if !commit.green {
      return base
        + NOT_PENDING
        + {
          green: false,
          blocking_sha: commit.sha,
          blocking_check: "",
          reason: "commit ${commit.sha} landed on main without an unresolved required check",
        }
    }
  }
  return base
    + NOT_PENDING
    + {
      green: true,
      blocking_sha: "",
      blocking_check: "",
      reason: "every one of the ${to_string(len(commits))} commits that landed since"
        + " certification passed ${required_contexts.join(", ")}${noted_lanes(commits)}",
    }
}

/**
 * Release-only lanes a drifted commit failed, named in the green reason.
 *
 * The release proceeds over these, so the receipt has to say which ones it
 * proceeded over. A verdict that swallowed them would read the same whether the
 * lanes were green or red, and the reader could not tell the difference.
 */
fn noted_lanes(commits: list<ReleaseDriftCommit>) -> string {
  let noted: list<string> = []
  for commit in commits {
    for lane in commit.failed_lanes {
      if !noted.contains(lane) {
        noted = noted + [lane]
      }
    }
  }
  if len(noted) == 0 {
    return ""
  }
  return ", over failing lanes the branch does not require (${noted.join(", ")})"
}

/**
 * Every drifted commit named, so a refusal points at commits rather than a count.
 *
 * A terminal reason that says "three commits" sends a reader back to the API to
 * find out which. The shas cost nothing to carry and are what a person needs.
 */
pub fn release_drift_commit_shas(evidence: ReleaseDriftEvidence) -> string {
  if len(evidence.commits) == 0 {
    return "none reported"
  }
  return evidence.commits.map({ commit -> commit.sha }).join(", ")
}

/**
 * The contexts a branch requires, read from its rulesets.
 *
 * Classic branch protection answers 404 on this repository's default branch, so
 * the rulesets endpoint is the authority. Only active rulesets count: a
 * disabled one describes a rule nobody is enforcing.
 */
pub fn release_required_contexts_from_rulesets(rulesets: list?) -> list<string> {
  let contexts: list<string> = []
  for ruleset in rulesets ?? [] {
    if lowercase(trim(to_string(ruleset?.enforcement ?? ""))) != "active" {
      continue
    }
    for rule in ruleset?.rules ?? [] {
      if to_string(rule?.type ?? "") != "required_status_checks" {
        continue
      }
      for check in rule?.parameters?.required_status_checks ?? [] {
        const context = trim(to_string(check?.context ?? ""))
        if context != "" && !contexts.contains(context) {
          contexts = contexts + [context]
        }
      }
    }
  }
  return contexts.sort()
}
