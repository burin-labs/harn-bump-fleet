import { git_run } from "std/git"

/** Stable name for the rule that keeps authenticated assistant sessions private. */
pub const AUTHENTICATED_SESSION_URL_POLICY = "authenticated-session-url"

/** One public metadata source that violated a named privacy rule. */
pub type PublicMetadataViolation = {source: string, policy: string, safe_evidence: string}

/** A commit whose complete subject and body were read from an exact PR range. */
pub type PublicMetadataCommit = {oid: string, message: string}

fn full_oid(value: string) -> bool {
  return regex_match("^[0-9a-f]{40}$", lowercase(trim(value))) != nil
}

/**
 * Read every commit in the merge-base..head PR range.
 *
 * The base branch may advance after the feature branch diverges, so the event's
 * base tip is an endpoint used to recover the merge base, not an ancestry
 * requirement. An absent endpoint, empty range, or unreadable message is
 * unmeasured and therefore an error rather than a clean result.
 */
pub fn public_metadata_commits(
  process: HarnessProcess,
  repo: string,
  base_sha: string,
  head_sha: string,
) -> Result<list<PublicMetadataCommit>, string> {
  const base = lowercase(trim(base_sha))
  const head = lowercase(trim(head_sha))
  if !full_oid(base) || !full_oid(head) {
    return Err("commit range endpoints must be full 40-character OIDs")
  }
  const merged = git_run(process, ["merge-base", base, head], {repo: repo})
  const merge_base = lowercase(trim(merged.stdout ?? ""))
  if !merged.ok || !full_oid(merge_base) {
    return Err("commit range merge base could not be measured")
  }
  const listed = git_run(process, ["rev-list", "--reverse", "${merge_base}..${head}"], {repo: repo})
  if !listed.ok {
    return Err("commit range could not be enumerated")
  }
  let commits: list<PublicMetadataCommit> = []
  for line in split(listed.stdout ?? "", "\n") {
    const oid = lowercase(trim(line))
    if oid == "" {
      continue
    }
    if !full_oid(oid) {
      return Err("commit enumeration returned an invalid identifier")
    }
    const shown = git_run(process, ["show", "-s", "--format=%B", oid], {repo: repo})
    if !shown.ok {
      return Err("an enumerated commit message could not be read")
    }
    commits = commits + [{oid: oid, message: shown.stdout ?? ""}]
  }
  if len(commits) == 0 {
    return Err("commit range contained no commits")
  }
  return Ok(commits)
}

/**
 * Apply public URL policy without returning the matched session identifier.
 *
 * A Claude Code session URL opens private authenticated conversation state. It
 * is not a credential, but a public commit, pull-request body, or title must not
 * publish it. The rule is structural so it rejects every session identifier;
 * ordinary public documentation URLs remain outside the match.
 */
pub fn public_metadata_violations(source: string, text: string) -> list<PublicMetadataViolation> {
  let violations: list<PublicMetadataViolation> = []
  for captured in regex_captures(
    "(?i)https://claude[.]ai/code/session_[A-Za-z0-9_-]+([?][^[:space:]<>]*)?",
    text,
  )
    ?? [] {
    const matched = to_string(captured?.match ?? "")
    const evidence = if contains(matched, "?") {
      "https://claude.ai/code/[redacted-session]?[redacted-query]"
    } else {
      "https://claude.ai/code/[redacted-session]"
    }
    violations = violations
      + [{source: source, policy: AUTHENTICATED_SESSION_URL_POLICY, safe_evidence: evidence}]
  }
  return violations
}

/** Render one diagnostic that is safe to publish in CI logs. */
pub fn public_metadata_violation_line(violation: PublicMetadataViolation) -> string {
  return "${violation.source}: policy=${violation.policy} url=${violation.safe_evidence}"
}
