import { compare_release, strip_v } from "std/semver"
import { HarnPinRelation, harn_pin_decision } from "./bump_decision"

/**
 * How a single consumer's pin compares with the newest published release.
 *
 * `unknown` is deliberately distinct from `current`. A pin the fleet could not
 * read is the exact shape of the failure this module exists to catch, so it
 * alarms rather than passing quietly — a repository that has fallen out of the
 * fleet's reach looks identical to a healthy one until someone asks.
 */
pub type PinStalenessState = "current" | "behind" | "ahead" | "unknown"

pub type PinStalenessVerdict = {
  state: PinStalenessState,
  stale: bool,
  releases_behind: int,
  relation: HarnPinRelation?,
  detail: string,
}

pub type PinStalenessRow = PinStalenessVerdict \
  & {
  slug: string,
  pin?: string,
  max_releases_behind?: int,
  update_workflow?: string,
  update_branch?: string,
}

pub type FleetStalenessSnapshot = {
  schema_version: string,
  target: string,
  max_releases_behind: int,
  stale_count: int,
  development_cutover?: dict,
  repositories: list<PinStalenessRow>,
}

/**
 * How many published releases sit strictly between this pin and the newest.
 *
 * Counted against the real release list rather than by subtracting version
 * numbers, because the release series skips: v0.10.112 was never published, so
 * arithmetic on the patch component would report a consumer as further behind
 * than any release it could actually have adopted.
 *
 * An unreadable or incomparable pin returns the whole list length. That is the
 * honest answer to "how far behind is a repository we cannot see" — it must
 * not round down to zero and read as healthy.
 */
pub fn releases_behind(pin: string?, release_tags: list<string>) -> int {
  if pin == nil || trim(to_string(pin)) == "" {
    return len(release_tags)
  }
  const current = strip_v(trim(to_string(pin)))
  let newer = 0
  for tag in release_tags {
    const compared = try {
      compare_release(current, strip_v(trim(tag)))
    }
    if is_err(compared) {
      continue
    }
    if unwrap(compared) < 0 {
      newer = newer + 1
    }
  }
  return newer
}

/**
 * Decide whether one consumer's pin is stale enough to alarm about.
 *
 * The threshold exists so this does not cry wolf every release morning: a
 * consumer is expected to be one release behind between publication and the
 * daily fleet bump landing. Two is not a cadence gap, it is a pipeline that
 * failed at least once without anyone noticing, which is the whole reason this
 * check exists.
 */
pub fn pin_staleness_verdict(
  pin: string?,
  target: string,
  behind_count: int,
  max_releases_behind: int,
) -> PinStalenessVerdict {
  if pin == nil || trim(to_string(pin)) == "" {
    return {
      state: "unknown",
      stale: true,
      releases_behind: behind_count,
      relation: nil,
      detail: "no Harn pin could be read from the default branch",
    }
  }
  const decision = harn_pin_decision(to_string(pin), target)
  if !decision.ok {
    return {
      state: "unknown",
      stale: true,
      releases_behind: behind_count,
      relation: nil,
      detail: "pin '${pin}' is not comparable with '${target}': ${decision.detail}",
    }
  }
  if decision.relation != "behind" {
    return {
      state: if decision.relation == "ahead" {
        "ahead"
      } else {
        "current"
      },
      stale: false,
      releases_behind: 0,
      relation: decision.relation,
      detail: decision.detail,
    }
  }
  return {
    state: "behind",
    stale: behind_count > max_releases_behind,
    releases_behind: behind_count,
    relation: decision.relation,
    detail: "pinned ${pin} while ${target} is published; ${to_string(behind_count)} release(s) "
      + "behind (alarm above ${to_string(max_releases_behind)})",
  }
}

/** The rows an operator has to act on. */
pub fn stale_rows(rows: list<PinStalenessRow>) -> list<PinStalenessRow> {
  return rows.filter({ row -> row.stale }).to_list()
}

/**
 * The hidden marker that makes this alarm an upsert rather than a new issue
 * every morning. An alarm that duplicates itself daily is one people learn to
 * filter out, which would rebuild the silence this check exists to break.
 */
pub fn staleness_issue_marker(slug: string) -> string {
  return "<!-- harn-bump-fleet:pin-staleness:${slug} -->"
}

pub fn staleness_issue_title(slug: string, target: string) -> string {
  return "Harn runtime pin is stale: ${slug} is behind ${target}"
}

pub fn staleness_issue_body(row: PinStalenessRow, target: string, run_url: string?) -> string {
  const observed = row.pin ?? "unreadable"
  const trailer = if run_url == nil {
    ""
  } else {
    "\n\nDetected by ${to_string(run_url)}."
  }
  return staleness_issue_marker(row.slug)
    + "\n\n`${row.slug}` pins Harn `${observed}` while the newest published release is"
    + " `${target}` — ${to_string(row.releases_behind)} release(s) behind."
    + "\n\nState: **${row.state}**\n\n${row.detail}"
    + "\n\nThis issue is opened, refreshed, and closed by the fleet pin-staleness check."
    + " It closes itself once the pin catches up, so it staying open means the bump"
    + " pipeline is still not landing. Check `"
    + (row.update_workflow ?? ".github/workflows/bump-harn.yml")
    + "` runs and any open `"
    + (row.update_branch ?? "automation/bump-harn-runtime")
    + "` pull request."
    + trailer
}

/** One unwatched repository and what its default branch says about a pin. */
pub type UnwatchedPinProbe = {slug: string, pin_text: string?}

pub type UndeclaredPinRow = {slug: string, pin: string, detail: string}

/**
 * Unwatched repositories that nevertheless pin a runtime.
 *
 * The watch is opt-in, so leaving both flags off removes a repository from
 * every census rather than declaring that it has nothing to track. That is the
 * one shape the staleness alarm cannot see, and it is how two repositories went
 * 77 releases behind while every census read clean. A pin file found here is a
 * manifest defect: either the repository tracks the runtime and must say so, or
 * it does not and the file should not be there.
 *
 * An unreadable probe returns no row on purpose. This reports a pin that was
 * read, never the absence of an answer, so a throttled or failed read cannot
 * manufacture a finding.
 */
pub fn undeclared_pin_rows(probes: list<UnwatchedPinProbe>) -> list<UndeclaredPinRow> {
  let rows = []
  for probe in probes {
    const pin = trim(probe.pin_text ?? "")
    if pin == "" {
      continue
    }
    rows = rows
      + [
        {
          slug: probe.slug,
          pin: pin,
          detail: "${probe.slug} pins Harn ${pin} but declares neither harn_bump nor"
            + " harn_pin_path, so no census watches it. Declare the flag it needs, or"
            + " remove the pin file if it does not track the runtime.",
        },
      ]
  }
  return rows
}
