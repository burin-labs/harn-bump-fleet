import { CommandStepReceipt } from "std/command"
import {
  ArtifactDescriptor,
  artifact_descriptor,
  run_artifact_path,
  run_artifact_write_json,
  run_artifacts_from_dir,
} from "std/run_artifacts"
import { SchemaContract, schema_contract } from "std/schema"

pub type ReleaseAuditConfigReceipt = {mode: string, ...rest}

pub type ReleaseAuditAnalysisReceipt = {
  current_version: string,
  next_version: string,
  branch: string,
  changelog_top: string,
  deterministic_findings: list<string>,
  ...rest,
}

pub type ReleaseAgentReviewReceipt = {validation_findings: list<string>, ...rest}

pub type ReleaseAuditReceipt = {
  schema_version: "release_harn.audit.v1",
  run_id: string,
  started_iso: string,
  finished_iso: string,
  duration_ms: int,
  operator: string,
  host: string,
  config: ReleaseAuditConfigReceipt,
  analysis: ReleaseAuditAnalysisReceipt,
  agent_review: string,
  agent_review_detail: ReleaseAgentReviewReceipt,
  execution: list<CommandStepReceipt>,
  cleanup: dict?,
  trace_spans: list<dict>,
  timing_summary: dict,
}

pub type FleetOutcomeReceipt = {
  slug: string,
  status: string,
  detail: string,
  dir?: string,
  run_id?: int?,
  pr_url?: string?,
  pr_number?: int?,
  run_url?: string?,
  pre_pin?: string?,
  local_pin?: string?,
  remote_pin?: string?,
  auto_merge?: string?,
  duration_ms?: int,
}

pub type FleetAuditReceipt = {
  schema_version: "harn_bump_fleet.audit.v1",
  run_id: string,
  started_iso: string,
  finished_iso: string,
  duration_ms: int,
  operator: string,
  host: string,
  target_version: string,
  mode: string,
  repos_total: int,
  repos_dispatched: int,
  summary_model: string,
  summary_text: string,
  summary: dict,
  outcomes: list<FleetOutcomeReceipt>,
  run_session_view: dict,
  public_surface_impact: dict,
  cleanup?: dict?,
  trace_spans: list<dict>,
  timing_summary: dict,
}

pub type RunReceiptWrite = {body: string, json_path: string}

pub type ReleaseReportPaths = {json_path: string, md_path: string}

// One source of truth for each receipt's structural schema and validation
// rules. Descriptors bind the canonical artifact name to the contract; readers
// that use a non-canonical name can still reuse the contract directly.
pub const RELEASE_AUDIT_CONTRACT: SchemaContract<ReleaseAuditReceipt> = schema_contract(
  schema_of(ReleaseAuditReceipt),
  [],
)

pub const FLEET_AUDIT_CONTRACT: SchemaContract<FleetAuditReceipt> = schema_contract(
  schema_of(FleetAuditReceipt),
  [],
)

pub const RELEASE_AUDIT_DESCRIPTOR: ArtifactDescriptor<ReleaseAuditReceipt> = artifact_descriptor(
  "release-audit.json",
  RELEASE_AUDIT_CONTRACT,
)

pub const FLEET_AUDIT_DESCRIPTOR: ArtifactDescriptor<FleetAuditReceipt> = artifact_descriptor(
  "audit.json",
  FLEET_AUDIT_CONTRACT,
)

pub fn release_audit_receipt_write(
  harness: HarnessFs,
  dir: string,
  payload: ReleaseAuditReceipt,
) -> RunReceiptWrite {
  const run = run_artifacts_from_dir("release-harn", dir)
  run_artifact_write_json(harness, run, RELEASE_AUDIT_DESCRIPTOR, payload)
  return {body: json_stringify(payload), json_path: run_artifact_path(run, "release-audit.json")}
}

pub fn fleet_audit_receipt_write(
  harness: HarnessFs,
  dir: string,
  payload: FleetAuditReceipt,
) -> RunReceiptWrite {
  const run = run_artifacts_from_dir("bump-fleet", dir)
  run_artifact_write_json(harness, run, FLEET_AUDIT_DESCRIPTOR, payload)
  return {body: json_stringify(payload), json_path: run.paths.audit}
}
