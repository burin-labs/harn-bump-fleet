import { TypedReadResult, read_json_typed_result } from "std/fs"

pub type CommandStepReceipt = {
  name: string,
  success: bool,
  status: string,
  command?: string | list<string>,
  classification?: string,
  recovery_hint?: string,
}

pub type ReleaseAuditConfigReceipt = {mode: string, ...rest}

pub type ReleaseAuditAnalysisReceipt = {current_version: string, next_version: string, branch: string, changelog_top: string, deterministic_findings: list<string>, ...rest}

pub type ReleaseAgentReviewReceipt = {validation_findings: list<string>, ...rest}

pub type ReleaseAuditReceipt = {
  schema_version: "release_harn.audit.v1",
  run_id: string,
  started_iso: string,
  finished_iso: string,
  duration_ms: int,
  operator: string,
  host: string,
  config: ReleaseAuditConfigReceipt,
  analysis: ReleaseAuditAnalysisReceipt,
  agent_review: string,
  agent_review_detail: ReleaseAgentReviewReceipt,
  execution: list<CommandStepReceipt>,
  cleanup: dict?,
  trace_spans: list<dict>,
  timing_summary: dict,
}

pub type FleetOutcomeReceipt = {
  slug: string,
  status: string,
  detail: string,
  pr_url?: string?,
  run_url?: string?,
}

pub type FleetAuditReceipt = {
  schema_version: "harn_bump_fleet.audit.v1",
  run_id: string,
  started_iso: string,
  finished_iso: string,
  duration_ms: int,
  operator: string,
  host: string,
  target_version: string,
  mode: string,
  repos_total: int,
  repos_dispatched: int,
  summary_model: string,
  summary_text: string,
  summary: dict,
  outcomes: list<FleetOutcomeReceipt>,
  run_session_view: dict,
  public_surface_impact: dict,
  cleanup?: dict?,
  trace_spans: list<dict>,
  timing_summary: dict,
}

pub fn release_audit_receipt_read(path: string) -> TypedReadResult<ReleaseAuditReceipt> {
  return read_json_typed_result<ReleaseAuditReceipt>(path, schema_of(ReleaseAuditReceipt))
}

pub fn fleet_audit_receipt_read(path: string) -> TypedReadResult<FleetAuditReceipt> {
  return read_json_typed_result<FleetAuditReceipt>(path, schema_of(FleetAuditReceipt))
}
