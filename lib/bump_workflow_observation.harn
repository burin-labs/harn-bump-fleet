import { poll_until } from "std/poll"
import { github_actions_run } from "./github"

/**
 * Preserve the interactive controller's legacy exact-run wait when no durable handoff is requested.
 */
pub fn poll_bump_workflow_run(
  harness: Harness,
  slug: string,
  run_id: int,
  timeout_ms: int,
  interval_ms: int,
) {
  const completed = poll_until(
    harness.clock,
    fn() {
      const run = github_actions_run(harness, slug, run_id)
      if is_err(run) {
        throw to_string(unwrap_err(run))
      }
      const observed = unwrap(run)
      return if observed.status == "completed" {
        observed
      } else {
        nil
      }
    },
    {timeout_ms: timeout_ms, interval_ms: interval_ms},
  )
  if completed != nil {
    return completed
  }
  const final = github_actions_run(harness, slug, run_id)
  if is_err(final) {
    throw to_string(unwrap_err(final))
  }
  return unwrap(final)
}
