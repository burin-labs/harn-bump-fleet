/** Return the semver from a `## vX.Y.Z` changelog heading, or nil. */
pub fn changelog_version_heading(line) {
  let matches = regex_captures("^## v([0-9]+[.][0-9]+[.][0-9]+)\\s*$", trim(line))
  if len(matches) == 0 {
    return nil
  }
  return matches[0].groups[0]
}

fn changelog_is_heading(line) {
  return regex_match("^##\\s+", trim(line)) != nil
}

/** Return the first released semver heading in a changelog body, without the leading `v`. */
pub fn changelog_top_from_text(text) {
  for line in split(text ?? "", "\n") {
    let version = changelog_version_heading(line)
    if version != nil {
      return version
    }
  }
  return ""
}

/** Return the body under an exact `## ...` heading until the next second-level heading. */
pub fn changelog_named_section_from_text(text, target_heading) {
  var capture = false
  var out = []
  for line in split(text ?? "", "\n") {
    if changelog_is_heading(line) {
      if capture {
        break
      }
      if trim(line) == target_heading {
        capture = true
        continue
      }
    }
    if capture {
      out = out.push(line)
    }
  }
  return trim(out.join("\n"))
}

/** Return the body under the first released semver heading. */
pub fn changelog_latest_version_section_from_text(text) {
  var capture = false
  var out = []
  for line in split(text ?? "", "\n") {
    if changelog_version_heading(line) != nil {
      if capture {
        break
      }
      capture = true
      continue
    }
    if capture {
      out = out.push(line)
    }
  }
  return trim(out.join("\n"))
}

fn changelog_heading_offsets(text) {
  var headings = []
  var offset = 0
  for line in split(text ?? "", "\n") {
    let version = changelog_version_heading(line)
    let heading = trim(line)
    if version != nil || heading == "## Unreleased" {
      headings = headings
        .push({heading: heading, version: version, start: offset, end: offset + len(line)})
    }
    offset = offset + len(line) + 1
  }
  return headings
}

fn first_version_heading(headings) {
  for heading in headings {
    if heading.version != nil {
      return heading
    }
  }
  return nil
}

fn first_unreleased_heading(headings) {
  for heading in headings {
    if heading.heading == "## Unreleased" {
      return heading
    }
  }
  return nil
}

fn next_heading_start(headings, after_start) {
  for heading in headings {
    if heading.start > after_start {
      return heading.start
    }
  }
  return nil
}

fn changelog_body_for(text, heading, section_end) {
  if heading == nil {
    return ""
  }
  return trim(text[heading.end:section_end])
}

fn changelog_subsections(body) {
  var sections = []
  var current_heading = ""
  var current_lines = []
  for line in split(trim(body ?? ""), "\n") {
    if starts_with(trim(line), "### ") {
      sections = sections.push({heading: current_heading, body: trim(current_lines.join("\n"))})
      current_heading = trim(line)
      current_lines = []
    } else {
      current_lines = current_lines.push(line)
    }
  }
  sections = sections.push({heading: current_heading, body: trim(current_lines.join("\n"))})
  return sections.filter({ section -> section.heading != "" || section.body != "" })
}

fn changelog_render_subsections(sections) {
  var parts = []
  for section in sections {
    let body = trim(section.body)
    if body == "" {
      continue
    }
    if section.heading == "" {
      parts = parts.push(body)
    } else {
      parts = parts.push(section.heading + "\n\n" + body)
    }
  }
  return parts.join("\n\n")
}

fn changelog_merge_release_bodies(unreleased_body, release_body) {
  let pending = changelog_subsections(unreleased_body)
  var release_sections = changelog_subsections(release_body)
  var prepend = []
  for pending_section in pending {
    var merged = false
    var next_sections = []
    for release_section in release_sections {
      if !merged && pending_section.heading != "" && pending_section.heading == release_section.heading {
        let merged_body = trim(pending_section.body) + "\n\n" + trim(release_section.body)
        next_sections = next_sections.push({heading: release_section.heading, body: merged_body})
        merged = true
      } else {
        next_sections = next_sections.push(release_section)
      }
    }
    if merged {
      release_sections = next_sections
    } else {
      prepend = prepend.push(pending_section)
    }
  }
  return changelog_render_subsections(prepend + release_sections)
}

/**
 * Return the body under `## v${version}` (without the heading itself), or
 * empty when `text` does not contain that version.
 */
pub fn changelog_release_section_body(text, version) {
  let headings = changelog_heading_offsets(text)
  for heading in headings {
    if heading.version == version {
      let next_start = next_heading_start(headings, heading.start) ?? len(text)
      return changelog_body_for(text, heading, next_start)
    }
  }
  return ""
}

/**
 * Fold the `## Unreleased` body into an existing `## v${next_version}` body
 * by subsection (e.g. `### Changed`) without invoking model output.
 *
 * This is the deterministic merge used by post-publish fixup: the release
 * artifact already shipped, so the original v${next_version} release notes
 * are authoritative. Anything that landed in `## Unreleased` after the
 * tag was pushed (because other PRs merged on top of `<base>`) is folded
 * into the v${next_version} section in place. Subsections present in both
 * are concatenated (`Unreleased` first, then existing); subsections only
 * in Unreleased are prepended; the rest of the changelog is untouched.
 */
pub fn changelog_fold_unreleased_into_existing_release(text, next_version, existing_body) {
  let baseline = trim(existing_body ?? "")
  if baseline == "" {
    return {success: false, message: "fixup merge requires a non-empty existing release body"}
  }
  let headings = changelog_heading_offsets(text)
  let first = first_version_heading(headings)
  if first != nil && first.version == next_version {
    return changelog_release_section_update(text, next_version, nil)
  }
  let insert_at = if first != nil {
    first.start
  } else {
    len(text)
  }
  let prepared = text[0:insert_at]
    + "## v${next_version}\n\n"
    + baseline
    + "\n\n"
    + text[insert_at:len(text)]
  let update = changelog_release_section_update(prepared, next_version, nil)
  if !update.success {
    return update
  }
  return {
    success: true,
    changed: trim(update.text) != trim(text),
    text: update.text,
    message: "fixup merge: " + update.message,
  }
}

/**
 * Return an updated changelog body with draft notes inserted, promoted, or refreshed for next_version.
 */
pub fn changelog_release_section_update(text, next_version, draft_notes = nil) {
  let headings = changelog_heading_offsets(text)
  let first = first_version_heading(headings)
  let unreleased = first_unreleased_heading(headings)
  let unreleased_before_first = unreleased != nil && (first == nil || unreleased.start < first.start)
  if first != nil && first.version == next_version && !unreleased_before_first {
    return {
      success: true,
      changed: false,
      text: text,
      message: "CHANGELOG.md already starts with v${next_version}",
    }
  }
  if first != nil && first.version == next_version && unreleased_before_first {
    let first_end = next_heading_start(headings, first.start) ?? len(text)
    let merged_body = changelog_merge_release_bodies(
      changelog_body_for(text, unreleased, first.start),
      changelog_body_for(text, first, first_end),
    )
    let release_text = "## v${next_version}\n\n" + merged_body + "\n\n"
    return {
      success: true,
      changed: true,
      text: text[0:unreleased.start] + release_text + text[first_end:len(text)],
      message: "merged Unreleased notes into existing v${next_version} section",
    }
  }
  let agent_notes = trim(draft_notes ?? "")
  if contains(agent_notes, "<assistant prose truncated by turn policy") {
    return {success: false, message: "agent draft changelog was truncated by turn policy; refusing to apply"}
  }
  if agent_notes == "" {
    return {
      success: false,
      message: "missing validated agent draft changelog; rerun with --agent or add CHANGELOG.md section ## v${next_version} manually before prepare",
    }
  }
  if changelog_top_from_text(agent_notes) != next_version {
    return {success: false, message: "agent draft changelog does not start with ## v${next_version}"}
  }
  let draft_text = agent_notes + "\n\n"
  if unreleased_before_first {
    let replace_end = if first == nil {
      len(text)
    } else {
      first.start
    }
    return {
      success: true,
      changed: true,
      text: text[0:unreleased.start] + draft_text + text[replace_end:len(text)],
      message: "promoted agent-authored CHANGELOG.md section for v${next_version}",
    }
  }
  let insert_at = if first == nil {
    len(text)
  } else {
    first.start
  }
  return {
    success: true,
    changed: true,
    text: text[0:insert_at] + draft_text + text[insert_at:len(text)],
    message: "inserted agent-authored CHANGELOG.md section for v${next_version}",
  }
}
