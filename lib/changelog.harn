/** Return the semver from a `## vX.Y.Z` changelog heading, or nil. */
pub fn changelog_version_heading(line) {
  let matches = regex_captures("^## v([0-9]+[.][0-9]+[.][0-9]+)\\s*$", trim(line))
  if len(matches) == 0 {
    return nil
  }
  return matches[0].groups[0]
}

fn changelog_is_heading(line) {
  return regex_match("^##\\s+", trim(line)) != nil
}

/** Return the first released semver heading in a changelog body, without the leading `v`. */
pub fn changelog_top_from_text(text) {
  for line in split(text ?? "", "\n") {
    let version = changelog_version_heading(line)
    if version != nil {
      return version
    }
  }
  return ""
}

/** Return the body under an exact `## ...` heading until the next second-level heading. */
pub fn changelog_named_section_from_text(text, target_heading) {
  var capture = false
  var out = []
  for line in split(text ?? "", "\n") {
    if changelog_is_heading(line) {
      if capture {
        break
      }
      if trim(line) == target_heading {
        capture = true
        continue
      }
    }
    if capture {
      out = out.push(line)
    }
  }
  return trim(out.join("\n"))
}

/** Return the body under the first released semver heading. */
pub fn changelog_latest_version_section_from_text(text) {
  var capture = false
  var out = []
  for line in split(text ?? "", "\n") {
    if changelog_version_heading(line) != nil {
      if capture {
        break
      }
      capture = true
      continue
    }
    if capture {
      out = out.push(line)
    }
  }
  return trim(out.join("\n"))
}

fn changelog_heading_offsets(text) {
  var headings = []
  var offset = 0
  for line in split(text ?? "", "\n") {
    let version = changelog_version_heading(line)
    let heading = trim(line)
    if version != nil || heading == "## Unreleased" {
      headings = headings
        .push({heading: heading, version: version, start: offset, end: offset + len(line)})
    }
    offset = offset + len(line) + 1
  }
  return headings
}

fn first_version_heading(headings) {
  for heading in headings {
    if heading.version != nil {
      return heading
    }
  }
  return nil
}

fn first_unreleased_heading(headings) {
  for heading in headings {
    if heading.heading == "## Unreleased" {
      return heading
    }
  }
  return nil
}

fn next_heading_start(headings, after_start) {
  for heading in headings {
    if heading.start > after_start {
      return heading.start
    }
  }
  return nil
}

/**
 * Return an updated changelog body with draft notes inserted, promoted, or refreshed for next_version.
 */
pub fn changelog_release_section_update(text, next_version, draft_notes = nil) {
  let headings = changelog_heading_offsets(text)
  let first = first_version_heading(headings)
  let unreleased = first_unreleased_heading(headings)
  let unreleased_before_first = unreleased != nil && (first == nil || unreleased.start < first.start)
  if first != nil && first.version == next_version && !unreleased_before_first && draft_notes == nil {
    return {
      success: true,
      changed: false,
      text: text,
      message: "CHANGELOG.md already starts with v${next_version}",
    }
  }
  let agent_notes = trim(draft_notes ?? "")
  if contains(agent_notes, "<assistant prose truncated by turn policy") {
    return {success: false, message: "agent draft changelog was truncated by turn policy; refusing to apply"}
  }
  if agent_notes == "" {
    return {
      success: false,
      message: "missing validated agent draft changelog; rerun with --agent or add CHANGELOG.md section ## v${next_version} manually before prepare",
    }
  }
  if changelog_top_from_text(agent_notes) != next_version {
    return {success: false, message: "agent draft changelog does not start with ## v${next_version}"}
  }
  let draft_text = agent_notes + "\n\n"
  if first != nil && first.version == next_version && !unreleased_before_first {
    let replace_end = next_heading_start(headings, first.start) ?? len(text)
    return {
      success: true,
      changed: true,
      text: text[0:first.start] + draft_text + text[replace_end:len(text)],
      message: "refreshed agent-authored CHANGELOG.md section for v${next_version}",
    }
  }
  if unreleased_before_first {
    let replace_end = if first == nil {
      len(text)
    } else {
      first.start
    }
    return {
      success: true,
      changed: true,
      text: text[0:unreleased.start] + draft_text + text[replace_end:len(text)],
      message: "promoted agent-authored CHANGELOG.md section for v${next_version}",
    }
  }
  let insert_at = if first == nil {
    len(text)
  } else {
    first.start
  }
  return {
    success: true,
    changed: true,
    text: text[0:insert_at] + draft_text + text[insert_at:len(text)],
    message: "inserted agent-authored CHANGELOG.md section for v${next_version}",
  }
}
