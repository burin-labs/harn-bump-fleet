// Extracted release-harness stage. See AGENTS.md for ownership.
/**
 * Durable failure evidence for one release step.
 *
 * A release step that fails records only an exit code by default, and `make`
 * returns 2 for every recipe failure. That made a transient release failure
 * unreproducible once its workspace moved on. This module owns the bounded,
 * credential-redacted excerpt that every failed step carries instead.
 */
pub type ReleaseStepOutcome = {success?: bool, stdout?: string, stderr?: string, ...rest}

pub type ReleaseFailureEvidence = {category: string, detail: string}

/** Longest failure excerpt any single run event may carry. */
pub const RELEASE_FAILURE_TAIL_LIMIT = 4000

/**
 * Strip credential shapes that a failing command can echo back. Release steps
 * run git, gh, and cargo, so a token can reach stderr through a remote URL or
 * an authorization header. Run events are durable, so redact before recording.
 */
pub fn release_redact_secrets(text: string) -> string {
  let out = text ?? ""
  // Concrete token shapes first: a later, looser rule would otherwise redact
  // them again and hide which kind of credential appeared.
  out = regex_replace("(gh[pousr]_|github_pat_)[A-Za-z0-9_]+", "[redacted-token]", out)
  out = regex_replace("(sk|csk|xox[abposr])-[A-Za-z0-9_./+=:-]+", "[redacted-token]", out)
  // An Authorization header carries its scheme, so drop the rest of the line.
  out = regex_replace("(?i)authorization[:=][^\n]*", "authorization: [redacted]", out)
  out = regex_replace("(?i)bearer[ ]+[^ \"'\n]+", "bearer [redacted]", out)
  out = regex_replace(
    "(?i)(api[_-]?key|password|token|secret)([:=][ ]*)[^ \"'\n]+",
    "\\1\\2[redacted]",
    out,
  )
  out = regex_replace("://[^/@ :]+:[^/@ ]+@", "://[redacted]@", out)
  return out
}

/**
 * Last `RELEASE_FAILURE_TAIL_LIMIT` characters of `text`, redacted, with a
 * marker when the head was dropped. The tail is what a build failure needs:
 * compiler and make errors land at the end of the stream.
 */
pub fn release_output_tail(text: string) -> string {
  const redacted = release_redact_secrets(trim(text ?? ""))
  if len(redacted) <= RELEASE_FAILURE_TAIL_LIMIT {
    return redacted
  }
  return "...[truncated]...\n" + substring(redacted, len(redacted) - RELEASE_FAILURE_TAIL_LIMIT)
}

/** Normalize an arbitrary thrown value before it enters a durable release receipt. */
pub fn release_failure_evidence(
  error: unknown,
  default_category: string,
) -> ReleaseFailureEvidence {
  let category = default_category
  let detail = to_string(error)
  if type_of(error) == "dict" {
    category = trim(to_string(error?.category ?? default_category))
    detail = to_string(error?.message ?? error)
  }
  return {category: category, detail: release_output_tail(detail)}
}

/**
 * Diagnostic fields for a finished step. A successful step stays quiet, but a
 * failure records why it failed: an exit code alone makes a transient release
 * failure unreproducible once the workspace moves on.
 */
pub fn release_step_failure_detail(result: ReleaseStepOutcome) -> dict {
  if result.success ?? false {
    return {}
  }
  let detail = {}
  const stderr_tail = release_output_tail(to_string(result.stderr ?? ""))
  if stderr_tail != "" {
    detail = detail + {stderr_tail: stderr_tail}
  }
  const stdout_tail = release_output_tail(to_string(result.stdout ?? ""))
  if stdout_tail != "" {
    detail = detail + {stdout_tail: stdout_tail}
  }
  return detail
}
