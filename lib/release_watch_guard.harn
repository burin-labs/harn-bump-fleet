import {
  HostLeaseAcquireReceipt,
  HostLeaseHandle,
  HostLeaseOptions,
  host_lease_acquire,
  host_lease_release,
} from "std/host_lease"

const RELEASE_WATCH_DOMAIN = "release-watch"

pub type ReleaseWatchGuardOptions = {
  tag: string,
  receipt_path: string,
  mock?: bool,
  domain?: string,
}

pub type ReleaseWatchGuard = {state: "disabled"} \
  | {state: "owned", acquire: HostLeaseAcquireReceipt, handle: HostLeaseHandle}

pub type ReleaseWatchGuardFinish = {
  released: bool,
  tag: string,
  lease_id: string,
  domain: string,
  error?: string,
}

/**
 * Serialize the process that owns the durable release-watch receipt.
 *
 * The receipt is atomic on disk, but read-transition-write is not a transaction.
 * Two local watchers can therefore observe the same pre-dispatch state and both
 * start a warm-cache workflow. One global host lease also keeps exact ref cleanup
 * and release-queue restoration single-writer across adjacent release tags.
 */
pub fn release_watch_guard_options(options: ReleaseWatchGuardOptions) -> HostLeaseOptions {
  const tag = trim(options.tag)
  if tag == "" {
    throw "release watch guard requires a tag"
  }
  return {
    owner: "watch-harn-release.${tag}",
    resource_class: "whole-machine",
    domain: trim(options.domain ?? RELEASE_WATCH_DOMAIN),
    priority_class: "interactive",
    wait_timeout_ms: 0,
    reason: "serialize release watch receipt transitions and recovery side effects",
    metadata: {tag: tag, receipt_path: trim(options.receipt_path)},
  }
}

pub fn release_watch_guard_acquire(
  host_lease: HarnessHostLease,
  options: ReleaseWatchGuardOptions,
) -> ReleaseWatchGuard {
  if options.mock ?? false {
    return {state: "disabled"}
  }
  const acquire = host_lease_acquire(host_lease, release_watch_guard_options(options))
  if acquire.status == "deferred" {
    const active = acquire.defer?.active
    const active_tag = trim(active?.metadata?.tag ?? "")
    throw "error: another release watcher owns ${active?.domain ?? RELEASE_WATCH_DOMAIN}: "
      + "${active?.owner ?? "another process"}"
      + if active_tag == "" {
        ""
      } else {
        " (tag ${active_tag})"
      }
  }
  const handle = acquire.handle
  if handle == nil || acquire.guard == nil {
    throw "release watch lease acquired without authority"
  }
  return {state: "owned", acquire: acquire, handle: handle}
}

pub fn release_watch_guard_finish(
  host_lease: HarnessHostLease,
  lease: ReleaseWatchGuard,
) -> ReleaseWatchGuardFinish? {
  if lease.state == "disabled" {
    return nil
  }
  // A live watch can run for hours and its release result is already durable in
  // the watch receipt. If the host-lease store becomes unavailable during that
  // interval, do not let best-effort lock cleanup overwrite the terminal release
  // verdict. The lease is process-owned, so owner exit still makes it stale and
  // recoverable by the next acquisition.
  const finish = try {
    {receipt: host_lease_release(host_lease, lease.acquire), error: nil}
  } catch (error) {
    {receipt: nil, error: to_string(error)}
  }
  return {
    released: finish.receipt?.released ?? false,
    tag: lease.handle.metadata?.tag ?? "",
    lease_id: lease.handle.lease_id,
    domain: lease.handle.domain,
    error: finish.error,
  }
}
