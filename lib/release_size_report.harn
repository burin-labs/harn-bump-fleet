// The release binary-size report harn publishes, read as a closed record.
//
// harn's `scripts/check_binary_size.harn` writes `binary-size.json` beside the
// human-readable `binary-size.txt`. This repository consumes the structured one
// on purpose: the fields it writes back into the baseline are exact numbers,
// and grepping them out of prose is how a reader ends up confidently wrong.
//
// The schema string is a cross-repo contract. A report that does not carry it
// is not a report this code understands, and it is refused rather than
// interpreted optimistically.
import { read_json_typed_result } from "std/fs"

/** The build a measurement was taken with. Divergence makes bytes incomparable. */
pub type ReleaseBuildIdentity = {
  profile: string,
  codegen_units: int,
  lto: string,
  strip: string,
  rustc: string,
  aot_embedded: bool,
}

pub type ReleaseSizeReport = {
  schema: string,
  target: string,
  source_sha: string,
  bytes: int,
  fuse_bytes: int,
  fuse: string,
  comparability: string,
  baseline_version: string,
  baseline_source_sha: string,
  baseline_bytes: int,
  delta_bytes: int,
  delta_percent_hundredths: int,
  growth: string,
  accepted_reason: string,
  blocking: bool,
  failures: list<string>,
  warnings: list<string>,
  build_identity: ReleaseBuildIdentity,
}

pub const RELEASE_SIZE_REPORT_SCHEMA: string = "harn.release_binary_size_report.v1"

/**
 * Read one report as a closed typed record.
 *
 * `schema_of` derives the contract from the type above rather than repeating it
 * as a second hand-written schema, so the two cannot drift apart.
 */
pub fn read_release_size_report(fs: HarnessFs, path: string) -> TypedReadResult<ReleaseSizeReport> {
  return read_json_typed_result<ReleaseSizeReport>(fs, path, schema_of(ReleaseSizeReport))
}

/**
 * Why this report may not be used to refresh a baseline, or nil when it may.
 *
 * Every rejection here is a case where writing the bytes anyway would record a
 * number that does not mean what the baseline claims it means. The two that
 * matter most:
 *
 * - A report for a different commit than the one that shipped. A baseline is a
 *   claim about a released artifact; measuring a neighbouring commit and
 *   labelling it with the release version is a quiet lie that survives until
 *   the next investigation.
 * - A breached fuse. That release should not have shipped, and accepting its
 *   bytes as the new normal would raise the ceiling to fit the accident.
 */
pub fn release_size_report_rejection(
  report: ReleaseSizeReport,
  expected_target: string,
  expected_source_sha: string,
) -> string? {
  if report.schema != RELEASE_SIZE_REPORT_SCHEMA {
    return "report schema is `${report.schema}`; expected `${RELEASE_SIZE_REPORT_SCHEMA}`"
  }
  if report.target != expected_target {
    return "report measured target `${report.target}`; expected `${expected_target}`"
  }
  if lowercase(trim(report.source_sha)) != lowercase(trim(expected_source_sha)) {
    return "report measured source `${report.source_sha}`; the released commit is `${expected_source_sha}`"
  }
  if report.bytes <= 0 {
    return "report records ${report.bytes} bytes, which cannot be a measured binary"
  }
  if report.fuse != "ok" {
    return "report records the distribution fuse as `${report.fuse}`; a release that breached the fuse cannot set the accepted baseline"
  }
  if report.build_identity.profile != "release" {
    return "report measured a `${report.build_identity.profile}` build; the baseline records release-profile bytes"
  }
  return nil
}
