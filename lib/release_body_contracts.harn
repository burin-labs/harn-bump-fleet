import { ReleaseGithubReleaseLease } from "./release_runtime"

pub type ReleasePublishedBodySource = {
  tag: string,
  version: string,
  original_pin: string,
  body: string,
  tag_ref_oid: string,
  tag_target_oid: string,
}

pub type ReleaseBodyIntegrityStatus = "not_applicable" \
  | "source_unavailable" \
  | "clean" \
  | "drifted" \
  | "already_corrected" \
  | "repaired" \
  | "withdrawn" \
  | "stale_lease" \
  | "connector_failure"

pub type ReleaseBodyConnectorError = {code: string, message: string, ...rest}

pub type ReleaseBodyResult = dict | Result<dict, ReleaseBodyConnectorError>

pub type ReleaseBodyEditFn = fn(string, string, ReleaseGithubReleaseLease) -> ReleaseBodyResult

pub type ReleaseBodyIntegrityPlan = {
  schema_version: string,
  tag: string,
  status: ReleaseBodyIntegrityStatus,
  reason: string,
  expected_body: string,
  observed_body: string,
  desired_body: string,
  before_sha256: string,
  after_sha256: string,
  lease: ReleaseGithubReleaseLease?,
  error: ReleaseBodyConnectorError?,
}

pub type ReleaseBodyIntegrityGateResult = {
  proceed: bool,
  receipt: ReleaseBodyIntegrityPlan,
  artifact_path: string,
}
