import { CandidateArchiveGateConfig } from "./candidate_archive_receipt"
import { GithubActionsArtifact } from "./github"

/**
 * Adopting an already-certified candidate archive instead of rebuilding it.
 *
 * A `workflow_dispatch` run's `head_sha` is the policy ref it ran under, never
 * the revision it built, so the run list cannot answer "has this exact commit
 * already been archived?". The archive workflow answers it directly: every
 * successful candidate run uploads one artifact named
 * `candidate-archive-manifest-<source commit>`. That name is the immutable,
 * source-qualified attestation, and it is the only key this module reuses on.
 *
 * The v0.10.131 resume rebuilt five platforms for a commit that already had a
 * complete, unexpired archive because nothing in the harness ever read that
 * name.
 */
pub type CandidateArchiveReuseAction = "reuse" | "dispatch_new" | "reject_ambiguous"

pub type CandidateArchiveReuseDecision = {
  action: CandidateArchiveReuseAction,
  run_id: int,
  run_head_sha: string,
  reason: string,
  considered: int,
  usable: int,
}

/** The artifact name the archive workflow publishes for one exact source commit. */
pub fn candidate_archive_manifest_artifact_name(source_sha: string) -> string {
  const sha = lowercase(trim(source_sha))
  if len(regex_captures("^[0-9a-f]{40}$", sha)) == 0 {
    throw "candidate archive manifest lookup requires a full 40-character source commit"
  }
  return "candidate-archive-manifest-" + sha
}

fn reuse_decision(
  action: CandidateArchiveReuseAction,
  reason: string,
  considered: int,
  usable: int,
  run_id: int = 0,
  run_head_sha: string = "",
) -> CandidateArchiveReuseDecision {
  return {
    action: action,
    run_id: run_id,
    run_head_sha: run_head_sha,
    reason: reason,
    considered: considered,
    usable: usable,
  }
}

/**
 * Choose between adopting a prior archive run and dispatching a new one.
 *
 * `rows` is the artifact census for this candidate's manifest name.
 * `policy_matches` answers, for one prior run's head, whether the archive
 * policy that run executed is byte-identical to the policy this release would
 * dispatch under. Identity is by content, not by commit: the v0.10.131 rebuild
 * happened because two policy commits carried the same archive workflow,
 * runner policy, and matrix script, and the harness compared the commits.
 *
 * Reuse requires exactly one usable run. Several distinct runs are refused
 * rather than resolved by picking the newest: an archive nobody can name is
 * not evidence. An expired artifact is not evidence either — its binaries are
 * gone — so it drops out and the build proceeds.
 */
pub fn candidate_archive_reuse_decision(
  rows: list<GithubActionsArtifact>,
  config: CandidateArchiveGateConfig,
  policy_matches: fn(string) -> bool,
) -> CandidateArchiveReuseDecision {
  const expected_name = candidate_archive_manifest_artifact_name(config.expected_source_sha)
  let usable_runs: list<int> = []
  let heads: dict<string, string> = {}
  for row in rows {
    if trim(row.name) != expected_name || row.expired {
      continue
    }
    if trim(row.run_head_sha) == "" || !policy_matches(row.run_head_sha) {
      continue
    }
    if !usable_runs.contains(row.run_id) {
      usable_runs = usable_runs + [row.run_id]
      heads[to_string(row.run_id)] = row.run_head_sha
    }
  }
  if len(usable_runs) > 1 {
    return reuse_decision(
      "reject_ambiguous",
      "${len(usable_runs)} distinct unexpired ${expected_name} archives (runs "
        + join(usable_runs.map({ id -> return to_string(id) }).to_list(), ", ")
        + "); refusing to choose one",
      len(rows),
      len(usable_runs),
    )
  }
  if len(usable_runs) == 0 {
    return reuse_decision(
      "dispatch_new",
      "no unexpired ${expected_name} archive built under matching archive policy; building",
      len(rows),
      0,
    )
  }
  const run_id = usable_runs[0] ?? 0
  return reuse_decision(
    "reuse",
    "adopting certified archive run ${run_id} for ${expected_name}",
    len(rows),
    1,
    run_id,
    heads[to_string(run_id)] ?? "",
  )
}

/**
 * Paths whose bytes decide how the candidate archive is built.
 *
 * The reuse key is the content of these three, read at the prior run's head
 * and at the policy ref this release would dispatch under. Keying on the
 * policy commit instead rebuilds five platforms whenever main moves for any
 * reason, which is what the v0.10.131 resume did: all three blobs were
 * identical across the two commits.
 */
pub const CANDIDATE_ARCHIVE_POLICY_PATHS: list<string> = [
  ".github/release-runner-policy.json",
  ".github/workflows/build-release-binaries.yml",
  "scripts/release_runner_matrix.sh",
]

/**
 * Whether two archive-policy blob censuses describe the same build.
 *
 * A path missing from either census makes the answer false. Comparing two
 * empty censuses would otherwise report agreement, and reuse on an unread
 * policy is the one mistake here that ships unbuilt binaries.
 */
pub fn candidate_archive_policy_matches(
  expected: dict<string, string>,
  observed: dict<string, string>,
) -> bool {
  for path in CANDIDATE_ARCHIVE_POLICY_PATHS {
    const want = lowercase(trim(to_string(expected[path] ?? "")))
    const got = lowercase(trim(to_string(observed[path] ?? "")))
    if want == "" || got == "" || want != got {
      return false
    }
  }
  return true
}
