import { CandidateArchiveGateConfig, CandidateArchiveReceipt } from "./candidate_archive_receipt"
import { github_connector_options } from "./github"
import { GithubClientOptions, GithubConnectorResult, api_call } from "harn-github-connector/default"

/**
 * Adopting an already-certified candidate archive instead of rebuilding it.
 *
 * A `workflow_dispatch` run's `head_sha` is the policy ref it ran under, never
 * the revision it built, so the run list cannot answer "has this exact commit
 * already been archived?". The archive workflow answers it directly: every
 * successful candidate run uploads one artifact named
 * `candidate-archive-manifest-<source commit>`. That name is the immutable,
 * source-qualified attestation, and it is the only key this module reuses on.
 *
 * The v0.10.131 resume rebuilt five platforms for a commit that already had a
 * complete, unexpired archive because nothing in the harness ever read that
 * name.
 */
pub type CandidateArchiveReuseAction = "reuse" | "dispatch_new" | "reject_ambiguous"

pub type CandidateArchiveReuseDecision = {
  action: CandidateArchiveReuseAction,
  run_id: int,
  run_head_sha: string,
  reason: string,
  considered: int,
  usable: int,
}

/** The artifact name the archive workflow publishes for one exact source commit. */
pub fn candidate_archive_manifest_artifact_name(source_sha: string) -> string {
  const sha = lowercase(trim(source_sha))
  if len(regex_captures("^[0-9a-f]{40}$", sha)) == 0 {
    throw "candidate archive manifest lookup requires a full 40-character source commit"
  }
  return "candidate-archive-manifest-" + sha
}

/**
 * Which archive run the certification recorded for one candidate.
 *
 * The durable record is the `release_harn.candidate_archive.v1` receipt the
 * release harness writes when it dispatches or adopts the archive. Candidate
 * certification embeds it unchanged in a signed write-once tag, so a fresh
 * run can authenticate the same receipt after the certifying run's receipt
 * artifact expires. It is the only thing that distinguishes two archives of
 * one candidate, because the archives themselves are not reproducible: the
 * two runs that built ab5e42aa under identical policy produced five differing
 * binaries.
 *
 * The receipt must bind this exact candidate. A receipt for another commit,
 * repository or workflow answers a different question and is refused rather
 * than read for its run id.
 */
pub fn candidate_archive_certified_run(
  receipt: CandidateArchiveReceipt,
  slug: string,
  config: CandidateArchiveGateConfig,
) -> Result<int, string> {
  if lowercase(trim(receipt.expected_source_sha)) != lowercase(trim(config.expected_source_sha)) {
    return Err(
      "candidate archive receipt binds source ${receipt.expected_source_sha}, not candidate ${config.expected_source_sha}",
    )
  }
  if trim(receipt.slug) != trim(slug) || trim(receipt.workflow) != trim(config.workflow) {
    return Err(
      "candidate archive receipt names ${receipt.slug} ${receipt.workflow}, not ${slug} ${config.workflow}",
    )
  }
  if receipt.run_id <= 0 {
    return Err("candidate archive receipt names no archive run")
  }
  return Ok(receipt.run_id)
}

fn reuse_decision(
  action: CandidateArchiveReuseAction,
  reason: string,
  considered: int,
  usable: int,
  run_id: int = 0,
  run_head_sha: string = "",
) -> CandidateArchiveReuseDecision {
  return {
    action: action,
    run_id: run_id,
    run_head_sha: run_head_sha,
    reason: reason,
    considered: considered,
    usable: usable,
  }
}

/**
 * Choose between adopting a prior archive run and dispatching a new one.
 *
 * `rows` is the artifact census for this candidate's manifest name.
 * `policy_matches` answers, for one prior run's head, whether the archive
 * policy that run executed is byte-identical to the policy this release would
 * dispatch under. Identity is by content, not by commit: the v0.10.131 rebuild
 * happened because two policy commits carried the same archive workflow,
 * runner policy, and matrix script, and the harness compared the commits.
 *
 * Reuse requires exactly one usable run. Several distinct runs are refused
 * rather than resolved by picking the newest: an archive nobody can name is
 * not evidence. An expired artifact is not evidence either — its binaries are
 * gone — so it drops out and the build proceeds.
 */
pub fn candidate_archive_reuse_decision(
  rows: list<GithubActionsArtifact>,
  config: CandidateArchiveGateConfig,
  policy_matches: fn(string) -> bool,
  certified_run_id: int = 0,
) -> CandidateArchiveReuseDecision {
  const expected_name = candidate_archive_manifest_artifact_name(config.expected_source_sha)
  let usable_runs: list<int> = []
  let heads: dict<string, string> = {}
  for row in rows {
    if trim(row.name) != expected_name || row.expired {
      continue
    }
    if trim(row.run_head_sha) == "" || !policy_matches(row.run_head_sha) {
      continue
    }
    if !usable_runs.contains(row.run_id) {
      usable_runs = usable_runs + [row.run_id]
      heads[to_string(row.run_id)] = row.run_head_sha
    }
  }
  if certified_run_id > 0 {
    // The authenticated candidate record settles which bytes ship. The named
    // run must still be present, unexpired, and built under matching policy.
    if !usable_runs.contains(certified_run_id) {
      return reuse_decision(
        "reject_ambiguous",
        "candidate record's archive run ${certified_run_id} is not an unexpired ${expected_name} archive built under matching archive policy"
          + if len(usable_runs) == 0 {
            "; none were found"
          } else {
            "; found "
              + join(usable_runs.map({ id -> return to_string(id) }).to_list(), ", ")
          },
        len(rows),
        len(usable_runs),
      )
    }
    return reuse_decision(
      "reuse",
      "adopting candidate-record archive run ${certified_run_id} for ${expected_name}, selected from ${len(usable_runs)} unexpired archive(s)",
      len(rows),
      len(usable_runs),
      certified_run_id,
      heads[to_string(certified_run_id)] ?? "",
    )
  }
  if len(usable_runs) > 1 {
    return reuse_decision(
      "reject_ambiguous",
      "${len(usable_runs)} distinct unexpired ${expected_name} archives (runs "
        + join(usable_runs.map({ id -> return to_string(id) }).to_list(), ", ")
        + "); refusing to choose one because these archives are not interchangeable and no authenticated candidate record selected one",
      len(rows),
      len(usable_runs),
    )
  }
  if len(usable_runs) == 0 {
    return reuse_decision(
      "dispatch_new",
      "no unexpired ${expected_name} archive built under matching archive policy; building",
      len(rows),
      0,
    )
  }
  const run_id = usable_runs[0] ?? 0
  return reuse_decision(
    "reuse",
    "adopting certified archive run ${run_id} for ${expected_name}",
    len(rows),
    1,
    run_id,
    heads[to_string(run_id)] ?? "",
  )
}

/**
 * Paths whose bytes decide how the candidate archive is built.
 *
 * The reuse key is the content of these three, read at the prior run's head
 * and at the policy ref this release would dispatch under. Keying on the
 * policy commit instead rebuilds five platforms whenever main moves for any
 * reason, which is what the v0.10.131 resume did: all three blobs were
 * identical across the two commits.
 */
pub const CANDIDATE_ARCHIVE_POLICY_PATHS: list<string> = [
  ".github/release-runner-policy.json",
  ".github/workflows/build-release-binaries.yml",
  "scripts/release_runner_matrix.sh",
]

/**
 * Whether two archive-policy blob censuses describe the same build.
 *
 * A path missing from either census makes the answer false. Comparing two
 * empty censuses would otherwise report agreement, and reuse on an unread
 * policy is the one mistake here that ships unbuilt binaries.
 */
pub fn candidate_archive_policy_matches(
  expected: dict<string, string>,
  observed: dict<string, string>,
) -> bool {
  for path in CANDIDATE_ARCHIVE_POLICY_PATHS {
    const want = lowercase(trim(to_string(expected[path] ?? "")))
    const got = lowercase(trim(to_string(observed[path] ?? "")))
    if want == "" || got == "" || want != got {
      return false
    }
  }
  return true
}

/** One Actions artifact row, reduced to the fields an exact-run lookup needs. */
pub type GithubActionsArtifact = {
  id: int,
  name: string,
  expired: bool,
  run_id: int,
  run_head_sha: string,
}

/**
 * Every artifact in one repository carrying one exact name.
 *
 * GitHub filters this server-side, so a source-qualified artifact name is a
 * single-call answer to "has this exact commit already been built?". A
 * workflow_dispatch run's own `head_sha` is the policy ref it ran under, never
 * the revision it built, so run metadata alone cannot answer that question.
 *
 * An empty list means the name was searched and not found. A read failure is
 * an `Err`, never an empty list: absence and unreadability must not collapse
 * into the same answer, because one of them is evidence and the other is not.
 */
pub fn candidate_archive_artifacts_named(
  harness: Harness,
  slug: string,
  name: string,
  options: GithubClientOptions = github_connector_options(),
) -> GithubConnectorResult<list<GithubActionsArtifact>> {
  // `regex_captures` returns one match object per match, each carrying its own
  // `groups` list. It is not a flat list whose first element is the whole
  // match, so a two-group pattern yields one element with two groups, never
  // three elements. Reading it as a flat list refuses every well-formed slug.
  const matched = regex_captures("^([^/[:space:]]+)/([^/[:space:]]+)$", trim(slug))
  const owner_and_repo = if len(matched) == 1 {
    matched[0]?.groups ?? []
  } else {
    []
  }
  if len(owner_and_repo) != 2 || trim(name) == "" {
    return Err(
      {
        code: "invalid_artifact_query",
        category: "schema_drift",
        message: "artifact lookup requires owner/name and an exact artifact name",
      },
    )
  }
  const observed = api_call(
    harness,
    {
      path:
        "/repos/${owner_and_repo[0]}/${owner_and_repo[1]}/actions/artifacts?per_page=100&name=${url_encode(trim(name))}",
      options: options,
    },
  )
  if is_err(observed) {
    return Err(unwrap_err(observed))
  }
  let rows: list<GithubActionsArtifact> = []
  for row in unwrap(observed)?.artifacts ?? [] {
    const run_id = row?.workflow_run?.id ?? 0
    if type_of(run_id) != "int" || run_id <= 0 {
      continue
    }
    rows = rows
      + [
        {
          id: to_int(row?.id ?? 0),
          name: trim(to_string(row?.name ?? "")),
          expired: row?.expired ?? true,
          run_id: run_id,
          run_head_sha: lowercase(trim(to_string(row?.workflow_run?.head_sha ?? ""))),
        },
      ]
  }
  return Ok(rows)
}
