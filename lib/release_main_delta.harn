/**
 * The lanes only a release runs, run once on the merged main commit, before
 * the tag.
 *
 * The merge gate lets green drift merge whatever it touched, because the lanes
 * that could speak for the rest take about thirty-four minutes at the median
 * against a branch that moves every nineteen. Gating the merge on them means
 * chasing a target that moves faster than the proof. So the release merges
 * first and proves second, and the proof lands before the act that cannot be
 * taken back.
 *
 * That ordering is only safe because of what the two acts cost to undo. A bump
 * merged onto main is a commit, and a commit is revertible: the version returns
 * to `X.Y.Z-dev`, the changelog fragments come back, and the next cut is
 * admissible again. A published tag is not. Consumers pin it, the fleet repins
 * against it, and it names a tree forever. The tag is therefore the publication
 * act, and this is the last gate in front of it.
 *
 * The delta is skipped, explicitly and by a named state rather than by falling
 * through, when the merged tree is the certified tree or differs from it only
 * in release paperwork. Re-running a thirty-four minute proof over a tree that
 * already carries that exact proof buys nothing and costs it on every quiet
 * cut. `skipped_tree_already_certified` is a verdict, not an absence.
 *
 * When the delta is red the release does not simply stop. Stopping here is what
 * left main carrying version 0.10.128 with no tag and no executable way back,
 * and a person had to write the revert by hand. The harness opens that revert
 * itself and says why.
 */
/**
 * Where the post-merge delta stands.
 *
 * `not_observed` is the fail-closed default and is never a pass. A caller that
 * could not read the lanes reports `not_observed`, which refuses the tag, and
 * is distinct from `failed`, which reverts.
 */
pub type ReleaseMainDeltaState = "not_observed" \
  | "skipped_tree_already_certified" \
  | "not_started" \
  | "running" \
  | "passed" \
  | "failed"

pub type ReleaseMainDeltaCheck = {name: string, state: string, run_url: string}

pub type ReleaseMainDelta = {
  state: ReleaseMainDeltaState,
  /** The merged main commit the lanes ran on. */
  commit: string,
  /** Lane names, computed from workflow triggers rather than a maintained list. */
  lanes: list<string>,
  checks: list<ReleaseMainDeltaCheck>,
  /** Empty unless `state` is `failed`. */
  failing_check: string,
  observed_at: string,
}

pub type ReleaseMainDeltaAction = "skip" | "dispatch" | "wait" | "tag" | "unfold" | "abort"

pub type ReleaseMainDeltaDecision = {
  action: ReleaseMainDeltaAction,
  reason: string,
  terminal_reason: string,
}

/**
 * Whether the recorded drift already proves the release-only lanes.
 *
 * Once those lanes run on ordinary pull requests, every drifted commit that
 * touched a path they bear on carries their result on its own head. When every
 * one is positively green in the merge receipt, re-running them on the merged
 * commit would spend thirty-four minutes re-proving what the receipt records.
 *
 * Fails closed in both directions that matter: an unrecorded drift proves
 * nothing, and a commit that owed a lane an answer but has no recorded row for
 * it proves nothing either. Only a record that positively shows a green
 * lane row for every commit that owed one counts. A partial row set does not:
 * the inventory can gain a job while a release is running, and the older
 * evidence must not prove the newly added job by omission.
 */
pub fn release_main_delta_proved_by_drift(
  drift_state: string,
  commits: list<{
    green: bool,
    checks: list<{name: string, state: string, release_only: bool, ...rest}>,
    ...rest,
  }>,
  lanes: list<string>,
) -> bool {
  if trim(drift_state) != "recorded" || len(lanes) == 0 || len(commits) == 0 {
    return false
  }
  let saw_lane = false
  for commit in commits {
    if !commit.green {
      return false
    }
    const observed = commit.checks.filter({ check -> check.release_only }).map(
      { check -> check.name },
    )
      .to_list()
    if len(observed) == 0 {
      continue
    }
    for lane in lanes {
      if !observed.contains(lane) {
        return false
      }
    }
    for check in commit.checks {
      if !check.release_only {
        continue
      }
      if uppercase(trim(check.state)) != "SUCCESS" {
        return false
      }
      saw_lane = true
    }
  }
  return saw_lane
}

fn oid(value: string?) -> string {
  return lowercase(trim(to_string(value ?? "")))
}

pub fn release_main_delta_unobserved() -> ReleaseMainDelta {
  return {
    state: "not_observed",
    commit: "",
    lanes: [],
    checks: [],
    failing_check: "",
    observed_at: "",
  }
}

fn delta_decision(
  action: ReleaseMainDeltaAction,
  reason: string,
  terminal_reason: string = "",
) -> ReleaseMainDeltaDecision {
  return {action: action, reason: reason, terminal_reason: terminal_reason}
}

/**
 * Decide whether the tag may be minted over the merged main commit.
 *
 * Every path out of here is explicit. There is no fallthrough that reads an
 * unrecognised state as permission, because the whole point of this gate is
 * that the state nobody looked at must not tag.
 */
pub fn release_main_delta_decision(
  delta: ReleaseMainDelta,
  merge_sha: string,
  bearing_paths: list<string>,
) -> ReleaseMainDeltaDecision {
  const merged = oid(merge_sha)
  if delta.state != "not_observed" && oid(delta.commit) != merged {
    return delta_decision(
      "abort",
      "the release-only lanes were observed on ${oid(delta.commit)}, not the merged main commit"
        + " ${merged}; refusing to tag on a proof of another tree",
      "main_delta_is_stale",
    )
  }
  if delta.state == "skipped_tree_already_certified" {
    return delta_decision(
      "tag",
      "the merged main commit carries the tree this release already certified,"
        + " so the release-only lanes have nothing new to prove",
    )
  }
  if delta.state == "passed" {
    return delta_decision(
      "tag",
      "the release-only lanes (${delta.lanes.join(", ")}) passed on the merged main commit"
        + " ${merged}",
    )
  }
  if delta.state == "failed" {
    return delta_decision(
      "unfold",
      "${delta.failing_check} failed on the merged main commit ${merged}."
        + " The tag is not minted and the bump is reverted",
      "main_delta_failed",
    )
  }
  if delta.state == "not_started" {
    if len(bearing_paths) == 0 {
      return delta_decision(
        "skip",
        "nothing the merged tree carries beyond the certified one is a path the release-only"
          + " lanes bear on",
      )
    }
    return delta_decision(
      "dispatch",
      "the merged main commit ${merged} carries drift on ${bearing_paths.join(", ")},"
        + " which only ${delta.lanes.join(", ")} can speak for; run them before the tag",
    )
  }
  if delta.state == "running" {
    return delta_decision(
      "wait",
      "the release-only lanes are still running on the merged main commit ${merged}",
    )
  }
  return delta_decision(
    "abort",
    "the release-only lanes were never observed on the merged main commit ${merged};"
      + " refusing to mint a tag without that proof",
    "main_delta_not_observed",
  )
}

/**
 * Why the release was deferred, in the words an operator needs.
 *
 * Names both halves: the commits that drifted in, which is what changed the
 * tree, and the check that refused it, which is what stopped the release. One
 * without the other sends a reader back to the API.
 */
pub fn release_main_delta_deferral_reason(
  tag: string,
  delta: ReleaseMainDelta,
  drifted: string,
) -> string {
  return "RELEASE DEFERRED: ${tag} was not published. ${delta.failing_check} failed on the merged"
    + " main commit ${oid(delta.commit)}, which carries this release's bump plus commits that"
    + " landed on main during certification (${drifted})."
    + " Those commits passed main's own required checks but not ${delta.lanes.join(", ")},"
    + " which only a release runs. The bump is being reverted so main returns to its development"
    + " version and the changelog fragments come back, which makes the next cut admissible."
    + " No tag was minted, so nothing published needs withdrawing."
}
