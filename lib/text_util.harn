/** Collapse whitespace for one-line report fields, or return a fallback. */
pub fn single_line_or(value, fallback) {
  const t = trim(value ?? "")
  if t == "" {
    return fallback
  }
  return regex_replace_all("\\s+", ", ", t)
}

/** Convert escaped newlines in rendered markdown blocks back into real newlines. */
pub fn markdown_multiline(value) {
  return trim(regex_replace_all("\\\\n", "\n", value ?? ""))
}
