import { command_run } from "std/command"
import { remote_url_to_slug } from "./git"
import { GithubConnectorError, github_enable_auto_merge } from "./github"
import { call, github_pr_commits } from "harn-github-connector/default"

const DEFAULT_BASE = "main"

const DEFAULT_TRAILER = "Co-Authored-By: Codex <codex@openai.com>"

pub type SignedBotCommit = {
  oid: string,
  message: string,
  signature_verified: bool,
  signature_reason: string,
}

pub type SignedBotPullRequest = {
  slug: string,
  number: int,
  title: string,
  url: string,
  state: string,
  base_ref_name: string,
  head_ref_name: string,
  head_oid: string,
  head_repo: string,
  head_owner: string,
  author_login: string,
  author_type: string,
  merge_state_status: string,
  auto_merge_enabled: bool,
  cross_repository: bool,
  commits: list<SignedBotCommit>,
}

pub type SignedBotDecisionAction = "refuse" | "already_signed" | "rewrite"

pub type SignedBotDecision = {
  eligible: bool,
  action: SignedBotDecisionAction,
  errors: list<string>,
  unsigned_count: int,
  detail: string,
}

pub type SignedBotRewriteOptions = {
  allow_fork?: bool,
  allow_non_bot?: bool,
  base?: string,
  home?: string,
  checkout?: string,
  temp_root?: string,
  temp_path?: string,
  trailer?: string,
}

pub type SignedBotRewriteCommand = {name: string, argv: list<string>}

pub type SignedBotRewritePlan = {
  checkout: string,
  temp_path: string,
  branch: string,
  old_head: string,
  commands: list<SignedBotRewriteCommand>,
}

pub type SignedBotCommandResult = {success: bool, stdout: string, stderr: string, ...rest}

pub type SignedBotCommandRunner = fn(list<string>) -> SignedBotCommandResult

pub type SignedBotCheckoutOriginCheck = {ok: bool, detail: string}

pub type SignedBotRewriteStep = {name: string, command: string, result: SignedBotCommandResult}

pub type SignedBotRewriteResult = {
  success: bool,
  failed_step: string,
  steps: list<SignedBotRewriteStep>,
}

pub type SignedBotAutoMergeState = {state: string}

pub type SignedBotAutoMergeResult = Result<SignedBotAutoMergeState, GithubConnectorError>

fn slug_parts(slug) {
  const parts = split(to_string(slug ?? ""), "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    return nil
  }
  return {owner: parts[0], repo: parts[1]}
}

fn compact_slug(slug) {
  return replace(replace(to_string(slug), "/", "-"), ".", "-")
}

fn first_line(text) {
  return split(trim(to_string(text ?? "")), "\n")[0] ?? ""
}

fn bool_option(options, name) {
  return (options ?? {})[name] ?? false
}

fn text_option(options, name, fallback) {
  const value = (options ?? {})[name]
  if value == nil || trim(to_string(value)) == "" {
    return fallback
  }
  return to_string(value)
}

/** Parse a comma-separated PR list, rejecting empty or non-positive entries. */
pub fn parse_pr_numbers(raw: string) -> list<int> {
  let out = []
  for part in split(to_string(raw ?? ""), ",") {
    const trimmed = trim(part)
    if trimmed == "" {
      continue
    }
    const n = to_int(trimmed)
    if n == nil || n <= 0 {
      throw "invalid pull request number: " + trimmed
    }
    out = out + [n]
  }
  return out
}

pub fn load_pr_signature_metadata(slug: string, pr_number: int) -> SignedBotPullRequest {
  const auth = {allow_gh_auth_fallback: true}
  const parts = slug_parts(slug)
  if parts == nil {
    throw "repo must be owner/name, got: " + to_string(slug)
  }
  const pr = call("github.pr.view", auth + {repo: slug, number: pr_number})
  if is_err(pr) {
    throw "GitHub PR view failed: " + to_string(unwrap_err(pr))
  }
  const evidence = github_pr_commits(
    parts.owner,
    parts.repo,
    pr.number,
    auth + {expected_head_oid: pr.head.sha},
  )
  if is_err(evidence) {
    throw "GitHub PR commit evidence failed: " + to_string(unwrap_err(evidence))
  }
  return {
    slug: slug,
    number: pr.number,
    title: pr.title,
    url: pr.url,
    state: pr.github_state,
    base_ref_name: pr.base.ref,
    head_ref_name: pr.head.ref,
    head_oid: pr.head.sha,
    head_repo: pr.head.repo,
    head_owner: pr.head.owner,
    author_login: pr.user?.login ?? "",
    author_type: pr.user?.type ?? "",
    merge_state_status: pr.mergeable_state,
    auto_merge_enabled: pr.auto_merge_armed,
    cross_repository: pr.head.repo != slug,
    commits: evidence.commits.map(
      { commit ->
        return {
          oid: commit.sha,
          message: commit.message,
          signature_verified: commit.signature.verified,
          signature_reason: commit.signature.reason,
        }
      },
    )
      .to_list(),
  }
}

pub fn load_queued_pr_numbers(slug: string, base: string = DEFAULT_BASE) -> list<int> {
  const queue = call(
    "github.merge_queue.entries",
    {allow_gh_auth_fallback: true, repo: slug, branch: base, limit: 100},
  )
  if is_err(queue) {
    throw "GitHub merge queue lookup failed: " + to_string(unwrap_err(queue))
  }
  return queue.entries.map({ entry -> entry.pull_number }).to_list()
}

pub fn is_bot_pr_author(pr: SignedBotPullRequest?) -> bool {
  const login = lowercase(pr?.author_login ?? "")
  const typ = pr?.author_type ?? ""
  return typ == "Bot"
    || contains(login, "[bot]")
    || login == "dependabot"
    || login == "github-actions"
    || login == "renovate"
}

pub fn unsigned_commits(pr: SignedBotPullRequest?) -> list<SignedBotCommit> {
  return (pr?.commits ?? []).filter({ commit -> !commit.signature_verified }).to_list()
}

pub fn signed_bot_pr_decision(
  pr: SignedBotPullRequest?,
  queued_numbers: list<int> = [],
  options: SignedBotRewriteOptions = {},
) -> SignedBotDecision {
  if pr == nil {
    return {
      eligible: false,
      action: "refuse",
      errors: ["pull request metadata was not found"],
      unsigned_count: 0,
      detail: "pull request metadata was not found",
    }
  }
  let errors = []
  if trim(pr.head_ref_name ?? "") == "" {
    errors = errors + ["missing head branch"]
  }
  if trim(pr.head_oid ?? "") == "" {
    errors = errors + ["missing head oid"]
  }
  if pr.cross_repository && !bool_option(options, "allow_fork") {
    errors = errors + ["cross-repository or fork PR"]
  }
  if contains(queued_numbers, pr.number) {
    errors = errors + ["PR is already in the merge queue"]
  }
  if !is_bot_pr_author(pr) && !bool_option(options, "allow_non_bot") {
    errors = errors + ["author is not recognized as a bot: " + (pr.author_login ?? "")]
  }
  const unsigned = unsigned_commits(pr)
  if len(unsigned) == 0 {
    return {
      eligible: false,
      action: "already_signed",
      errors: [],
      unsigned_count: 0,
      detail: "all commits already have VALID signatures; no rewrite needed",
    }
  }
  if len(errors) > 0 {
    return {
      eligible: false,
      action: "refuse",
      errors: errors,
      unsigned_count: len(unsigned),
      detail: join(errors, "; "),
    }
  }
  return {
    eligible: true,
    action: "rewrite",
    errors: [],
    unsigned_count: len(unsigned),
    detail: "rewrite " + to_string(len(unsigned)) + " unsigned commit(s) as one signed commit",
  }
}

fn default_checkout_path(slug, home) {
  const parts = slug_parts(slug)
  if parts == nil {
    return ""
  }
  return path_join(home, "projects/" + parts.repo)
}

/** Keep concurrent rewrites isolated while retaining the PR and observed head in recovery paths. */
pub fn default_temp_path(
  slug: string,
  pr_number: int,
  head_oid: string,
  temp_root: string = "/tmp/harn-signed-bot-prs",
) -> string {
  const suffix = if trim(head_oid ?? "") == "" {
    to_string(pr_number)
  } else {
    substring(head_oid, 0, 12)
  }
  return path_join(
    temp_root,
    compact_slug(slug) + "-pr-" + to_string(pr_number) + "-" + suffix + "-" + uuid_v7(),
  )
}

pub fn rewrite_command_plan(
  slug: string,
  pr: SignedBotPullRequest,
  options: SignedBotRewriteOptions = {},
) -> SignedBotRewritePlan {
  const base = text_option(options, "base", pr.base_ref_name)
  const home = text_option(options, "home", "")
  const checkout = text_option(options, "checkout", default_checkout_path(slug, home))
  const temp_root = text_option(options, "temp_root", "/tmp/harn-signed-bot-prs")
  const temp_path = text_option(
    options,
    "temp_path",
    default_temp_path(slug, pr.number, pr.head_oid, temp_root),
  )
  const trailer = text_option(options, "trailer", DEFAULT_TRAILER)
  const title = first_line(pr.title)
  const branch = pr.head_ref_name
  const old_head = pr.head_oid
  return {
    checkout: checkout,
    temp_path: temp_path,
    branch: branch,
    old_head: old_head,
    commands: [
      {
        name: "fetch-pr-head",
        argv: [
          "git",
          "-c",
          "core.fsmonitor=false",
          "-c",
          "core.untrackedCache=false",
          "-C",
          checkout,
          "fetch",
          "origin",
          base,
          branch,
          "--prune",
        ],
      },
      {name: "mkdir-temp-root", argv: ["mkdir", "-p", temp_root]},
      {
        name: "add-temp-worktree",
        argv: ["git", "-C", checkout, "worktree", "add", "--detach", temp_path, old_head],
      },
      {
        name: "disable-temp-fsmonitor",
        argv: ["git", "-C", temp_path, "config", "core.fsmonitor", "false"],
      },
      {
        name: "soft-reset-to-base",
        argv: [
          "git",
          "-c",
          "core.fsmonitor=false",
          "-c",
          "core.untrackedCache=false",
          "-C",
          temp_path,
          "reset",
          "--soft",
          "origin/" + base,
        ],
      },
      {
        name: "create-signed-commit",
        argv: ["git", "-C", temp_path, "commit", "-S", "-m", title, "-m", trailer],
      },
      {
        name: "push-signed-head",
        argv: [
          "git",
          "-C",
          temp_path,
          "push",
          "origin",
          "HEAD:" + branch,
          "--force-with-lease=refs/heads/" + branch + ":" + old_head,
        ],
      },
      {
        name: "remove-temp-worktree",
        argv: ["git", "-C", checkout, "worktree", "remove", "--force", temp_path],
      },
    ],
  }
}

pub fn checkout_origin_check(
  checkout: string,
  expected_slug: string,
  runner: SignedBotCommandRunner,
) -> SignedBotCheckoutOriginCheck {
  const result = runner(["git", "-C", checkout, "remote", "get-url", "origin"])
  if !(result.success ?? false) {
    return {ok: false, detail: "could not read checkout origin: " + trim(result.stderr ?? "")}
  }
  const actual = remote_url_to_slug(trim(result.stdout ?? ""))
  if actual != expected_slug {
    return {
      ok: false,
      detail: "checkout origin is ${actual ?? "unknown"}, expected ${expected_slug}",
    }
  }
  return {ok: true, detail: "checkout origin matches ${expected_slug}"}
}

fn live_command_runner(argv: list<string>) -> SignedBotCommandResult {
  return command_run(argv)
}

pub fn live_checkout_origin_check(
  checkout: string,
  expected_slug: string,
) -> SignedBotCheckoutOriginCheck {
  return checkout_origin_check(checkout, expected_slug, live_command_runner)
}

fn command_label(argv) {
  return join(argv.map({ a -> to_string(a) }), " ")
}

pub fn run_rewrite_commands(plan: SignedBotRewritePlan) -> SignedBotRewriteResult {
  let steps = []
  for command in plan.commands {
    const result = command_run(command.argv)
    steps = steps + [{name: command.name, command: command_label(command.argv), result: result}]
    if !result.success {
      if command.name != "remove-temp-worktree" {
        command_run(["git", "-C", plan.checkout, "worktree", "remove", "--force", plan.temp_path])
      }
      return {success: false, failed_step: command.name, steps: steps}
    }
  }
  return {success: true, failed_step: "", steps: steps}
}

pub fn maybe_enable_auto_merge(
  slug: string,
  pr_number: int,
  expected_head_oid: string,
  enabled: bool = true,
) -> SignedBotAutoMergeResult {
  if !enabled {
    return Ok({state: "skipped"})
  }
  const result = github_enable_auto_merge(slug, pr_number, expected_head_oid, "squash")
  return if is_err(result) {
    Err(unwrap_err(result))
  } else {
    Ok({state: to_string(unwrap(result).state)})
  }
}
