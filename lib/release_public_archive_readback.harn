import {
  ReleaseArchiveReadback,
  decode_release_archive_manifest,
  release_manifest_public_files,
} from "./release_archive_observation"
import { GithubReleaseLookup } from "harn-github-connector/default"

/** Cache only certified bytes bound to the freshly observed public asset identity. */
pub fn read_public_release_archives(
  fs: HarnessFs,
  root: string,
  lookup: GithubReleaseLookup,
  manifest_text: string,
  download: fn(string, string) -> bool,
) -> Result<list<ReleaseArchiveReadback>, string> {
  const decoded = decode_release_archive_manifest(manifest_text)
  if is_err(decoded) {
    return Err(unwrap_err(decoded))
  }
  if lookup.state != "found" {
    return Err("public_release_missing")
  }
  const manifest = unwrap(decoded)
  let measured: list<ReleaseArchiveReadback> = []
  for artifact in release_manifest_public_files(manifest, "public_assets") {
    const assets = lookup.release.assets.filter({ asset -> asset.name == artifact.file }).to_list()
    if len(assets) != 1 || assets[0]!.id <= 0 || assets[0]!.state != "uploaded" {
      return Err("public_archive_identity:${artifact.file}")
    }
    const asset = assets[0]!
    const identity = sha256(
      json_stringify(
        {
          release: lookup.release.id,
          asset: asset.id,
          updated: asset.updated_at,
          size: asset.size,
          expected: artifact.sha256,
        },
      ),
    )
    const directory = path_join(root, manifest.sourceCommit, identity)
    fs.mkdir(directory, true)
    const path = path_join(directory, artifact.file)
    const cached = try {
      fs.read_bytes(path)
    }
    if trim(asset.updated_at ?? "") != ""
      && is_ok(cached)
      && sha256(unwrap(cached)) == artifact.sha256 {
      measured = measured + [pick(artifact, ["file", "sha256"])]
      continue
    }
    if fs.exists(path) {
      fs.delete(path)
    }
    const staging = fs.mkdtemp_in_workspace("public-archive-")
    const temporary = path_join(staging, artifact.file)
    const downloaded = try {
      download(
        "https://github.com/burin-labs/harn/releases/download/${lookup.tag}/${artifact.file}",
        temporary,
      )
    }
    if is_err(downloaded) || !unwrap(downloaded) {
      fs.delete(staging)
      return Err("public_archive_download:${artifact.file}")
    }
    const bytes = try {
      fs.read_bytes(temporary)
    }
    if is_err(bytes) {
      fs.delete(staging)
      return Err("public_archive_read:${artifact.file}")
    }
    const digest = sha256(unwrap(bytes))
    if digest == artifact.sha256 {
      fs.rename(temporary, path)
    }
    fs.delete(staging)
    measured = measured + [{file: artifact.file, sha256: digest}]
  }
  return Ok(measured)
}
