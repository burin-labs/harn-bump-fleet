import { compare_release, strip_v } from "std/semver"

pub type BumpDecisionBase = {local_pin?: string, ...rest}

pub type BumpDecisionPr = {number: int, url: string, auto_merge_armed: bool, ...rest}

pub type BumpDecisionProbe = {matches: bool, evidence: string, ...rest}

pub type BumpDecisionOutcome = BumpDecisionBase \
  & {status: string, detail: string, pr_number?: int, pr_url?: string, auto_merge?: string, ...rest}

pub type HarnPinRelation = "behind" | "equal" | "ahead"

pub type HarnPinDecision = {
  ok: bool,
  satisfies_target: bool,
  relation: HarnPinRelation?,
  detail: string,
}

/** Compare an observed consumer pin with a requested release. */
pub fn harn_pin_decision(current: string, target: string) -> HarnPinDecision {
  const current_version = strip_v(trim(current))
  const target_version = strip_v(trim(target))
  const compared = try {
    compare_release(current_version, target_version)
  }
  if is_err(compared) {
    return {
      ok: false,
      satisfies_target: false,
      relation: nil,
      detail: to_string(unwrap_err(compared)),
    }
  }
  const order = unwrap(compared)
  const relation: HarnPinRelation = if order < 0 {
    "behind"
  } else if order > 0 {
    "ahead"
  } else {
    "equal"
  }
  return {
    ok: true,
    satisfies_target: relation != "behind",
    relation: relation,
    detail: if relation == "ahead" {
      "remote main pin is ${current_version}; newer than target ${target_version}"
    } else if relation == "equal" {
      "remote main pin is ${current_version}; matches target"
    } else {
      "remote main pin is ${current_version}; behind target ${target_version}"
    },
  }
}

/** Describe local checkout drift without letting it drive dispatch decisions. */
pub fn local_pin_drift_detail(base: BumpDecisionBase, remote_pin: string?) -> string {
  const local_pin = base.local_pin
  if local_pin == nil || remote_pin == nil {
    return ""
  }
  const local_no_v = strip_v(local_pin)
  if local_no_v == remote_pin {
    return ""
  }
  return "; local checkout pin is ${local_no_v}, which differs from remote main"
}

fn pr_number(pr) {
  return if pr == nil {
    nil
  } else {
    pr.number
  }
}

fn pr_url(pr) {
  return if pr == nil {
    nil
  } else {
    pr.url
  }
}

/** Return the dry-run outcome for the same pre-dispatch facts live mode uses. */
pub fn dry_run_predispatch_outcome(
  base: BumpDecisionBase,
  target: string,
  target_no_v: string,
  remote_pin: string?,
  existing_pr: BumpDecisionPr? = nil,
  existing_probe: BumpDecisionProbe? = nil,
) -> BumpDecisionOutcome {
  const remote_decision = if remote_pin == nil {
    nil
  } else {
    harn_pin_decision(remote_pin, target_no_v)
  }
  if remote_decision != nil && !remote_decision.ok {
    return base
      + {
      status: "remote_pin_invalid",
      detail: "cannot compare remote main pin with ${target}: ${remote_decision.detail}",
      pr_number: pr_number(existing_pr),
      pr_url: pr_url(existing_pr),
    }
  }
  if remote_decision?.satisfies_target ?? false {
    const stale = if existing_pr == nil {
      ""
    } else {
      "; would close redundant bump PR #${existing_pr.number}"
    }
    return base
      + {
      status: "already_current",
      detail: (remote_decision?.detail ?? "remote main satisfies target")
        + local_pin_drift_detail(
        base,
        remote_pin,
      )
        + stale,
      pr_number: pr_number(existing_pr),
      pr_url: pr_url(existing_pr),
    }
  }
  if existing_pr != nil && existing_probe != nil && existing_probe.matches {
    const am = if existing_pr.auto_merge_armed {
      "already_enabled"
    } else {
      "would_enable"
    }
    return base
      + {
      status: "dry_run_pr_open_for_target",
      detail: "PR #${existing_pr.number} already targets ${target}; auto-merge: ${am}",
      pr_number: existing_pr.number,
      pr_url: existing_pr.url,
      auto_merge: am,
    }
  }
  if existing_pr != nil {
    const evidence = if existing_probe == nil {
      "target probe unavailable"
    } else {
      existing_probe.evidence
    }
    return base
      + {
      status: "dry_run_stale_pr",
      detail:
        "would close stale PR #${existing_pr.number}, then dispatch bump-harn.yml with version=${target}; ${evidence}",
      pr_number: existing_pr.number,
      pr_url: existing_pr.url,
    }
  }
  return base + {status: "dry_run", detail: "would dispatch bump-harn.yml with version=${target}"}
}
