import {
  CandidateArchiveGateConfig,
  CandidateArchiveReceipt,
  candidate_archive_receipt_matches,
} from "./candidate_archive_receipt"
import { FleetConvergenceRow, convergence_snapshot_from_rows } from "./fleet_convergence"
import {
  ReleaseChainCause,
  ReleaseChainEvidenceRead,
  ReleaseChainEvidenceStatus,
  ReleaseChainStage,
} from "./release_chain_state"
import { ReleaseChainObservation, ReleaseChainObservedSubject } from "./release_chain_transition"
import {
  ReleaseCertificationTrees,
  ReleaseMainTagPullRequest,
  release_main_tag_decision,
} from "./release_main_tag"
import { ReleaseMergeGateState } from "./release_merge_gate"
import { ReleasePublicationEvidence, release_publication_proof } from "./release_publication_proof"
import { ReleasePublishTreeInputs, release_publish_tree_invariant } from "./release_repin"
import { ReleaseTagIdentityVerification } from "./release_tag_identity"
import { ReleaseWatchReceipt } from "./release_watch_state"

pub type ReleaseChainPreTagInputs = {
  publish_tree: ReleasePublishTreeInputs,
  fragment_names: list<string>,
  release_contract_green: bool,
  changelog_folded: bool,
  observed_at: string,
}

pub type ReleaseChainExactValueRead = {
  subject: string,
  kind: string,
  expected: string,
  observed: string,
  source: string,
  ref: string,
  identity: string,
  readable: bool,
  observed_at: string,
}

pub type ReleaseChainFleetProofFreshness = {
  pin_changed_at: string,
  deadline_at: string,
  observed_at: string,
  proof_started_at: string,
  proof_run_id: int,
}

fn evidence(
  read: ReleaseChainExactValueRead,
  status: ReleaseChainEvidenceStatus,
) -> ReleaseChainEvidenceRead {
  return {
    subject: read.subject,
    kind: read.kind,
    status: status,
    expected: read.expected,
    observed: read.observed,
    source: read.source,
    ref: read.ref,
    identity: read.identity,
    observed_at: read.observed_at,
  }
}

pub fn release_chain_observed_value(
  read: ReleaseChainExactValueRead,
  cause: ReleaseChainCause,
  retryable: bool,
) -> ReleaseChainObservedSubject {
  const matches = read.readable && read.observed == read.expected
  const status: ReleaseChainEvidenceStatus = if !read.readable {
    "missing"
  } else if !matches {
    "broken"
  } else {
    "observed"
  }
  let subject: ReleaseChainObservedSubject = {
    evidence: evidence(read, status),
    proven: matches,
    retryable: retryable,
    detail: if matches {
      ""
    } else if !read.readable {
      "${read.subject} was not readable from ${read.source}"
    } else {
      "${read.subject} expected '${read.expected}', observed '${read.observed}'"
    },
  }
  if !matches {
    subject = subject + {cause: cause}
  }
  return subject
}

/** Project already-read owner artifacts for stages whose owner returns exact values. */
pub fn release_chain_observe_values(
  stage: ReleaseChainStage,
  predicate: string,
  reads: list<ReleaseChainExactValueRead>,
  cause: ReleaseChainCause,
  retryable: bool,
  observed_at: string,
) -> ReleaseChainObservation {
  return observation(
    stage,
    predicate,
    reads.map({ read -> release_chain_observed_value(read, cause, retryable) }).to_list(),
    observed_at,
  )
}

fn observation(
  stage: ReleaseChainStage,
  predicate: string,
  subjects: list<ReleaseChainObservedSubject>,
  observed_at: string,
) -> ReleaseChainObservation {
  return {
    schema_version: "harn.release-chain.observation.v1",
    stage: stage,
    predicate: predicate,
    subjects: subjects,
    observed_at: observed_at,
  }
}

/** Read-only candidate projection over the current archive-certification owner. */
pub fn release_chain_observe_prepare(
  receipt: CandidateArchiveReceipt?,
  slug: string,
  config: CandidateArchiveGateConfig,
  observed_at: string,
) -> ReleaseChainObservation {
  const matched = receipt != nil && candidate_archive_receipt_matches(receipt, slug, config)
  return observation(
    "prepare",
    "certified candidate archive receipt binds the selected source and policy identities",
    [
      release_chain_observed_value(
        {
          subject: "candidate archive certification",
          kind: "candidate_archive_receipt",
          expected: config.expected_source_sha,
          observed: if receipt == nil {
            ""
          } else {
            receipt.expected_source_sha
          },
          source: "candidate_archive_receipt",
          ref: config.source_ref,
          identity: if receipt == nil {
            ""
          } else {
            to_string(receipt.run_id)
          },
          readable: matched,
          observed_at: observed_at,
        },
        if receipt == nil {
          "certification_failed"
        } else {
          "source_identity_changed"
        },
        true,
      ),
    ],
    observed_at,
  )
}

/** Project the exact merged-main identity through release_main_tag's decision. */
pub fn release_chain_observe_cut(
  watch: ReleaseWatchReceipt,
  pull_request: ReleaseMainTagPullRequest?,
  remote_tag_target: string,
  observed_at: string,
  certification_trees: fn(string) -> ReleaseCertificationTrees?,
  merge_gate: fn(ReleaseMainTagPullRequest) -> ReleaseMergeGateState?,
) -> ReleaseChainObservation {
  const owner = release_main_tag_decision(
    watch,
    pull_request,
    remote_tag_target,
    certification_trees,
    merge_gate,
  )
  const proven = owner.action == "tag" || owner.action == "reuse"
  return observation(
    "cut",
    "the leased release pull request merged to one exact commit reachable from main",
    [
      release_chain_observed_value(
        {
          subject: "release pull request merge identity",
          kind: "release_main_tag_decision",
          expected: if proven {
            owner.action
          } else {
            "tag|reuse"
          },
          observed: owner.action,
          source: "release_main_tag",
          ref: watch.pr_url,
          identity: owner.merge_sha,
          readable: proven,
          observed_at: observed_at,
        },
        if owner.action == "abort" {
          "release_merge_identity_changed"
        } else {
          "release_pr_missing"
        },
        owner.action == "wait" || owner.action == "rearm",
      ),
    ],
    observed_at,
  )
}

/** Exact merge-tree checkpoint. Workflow conclusions are intentionally absent. */
pub fn release_chain_observe_pre_tag(inputs: ReleaseChainPreTagInputs) -> ReleaseChainObservation {
  const tree = release_publish_tree_invariant(inputs.publish_tree)
  const tag = inputs.publish_tree.tag
  const fragment_subjects: list<ReleaseChainObservedSubject> = if len(inputs.fragment_names) == 0 {
    [
      release_chain_observed_value(
        {
          subject: "changelog fragment scope",
          kind: "tree_fragment_census",
          expected: "empty",
          observed: "empty",
          source: "exact_merge_tree",
          ref: tag,
          identity: inputs.publish_tree.tag_tree,
          readable: true,
          observed_at: inputs.observed_at,
        },
        "unfolded_fragments",
        true,
      ),
    ]
  } else {
    inputs.fragment_names.map(
      { name ->
        release_chain_observed_value(
          {
            subject: name,
            kind: "tree_fragment_census",
            expected: "absent",
            observed: "present",
            source: "exact_merge_tree",
            ref: tag,
            identity: inputs.publish_tree.tag_tree,
            readable: true,
            observed_at: inputs.observed_at,
          },
          "unfolded_fragments",
          true,
        )
      },
    )
      .to_list()
  }
  return observation(
    "pre_tag_checkpoint",
    "the exact merge tree is the release tree, has no fragments, has folded notes, and passes its contract",
    [
      release_chain_observed_value(
        {
          subject: "exact release tree",
          kind: "release_publish_tree_invariant",
          expected: inputs.publish_tree.tag_tree,
          observed: inputs.publish_tree.publish_tree,
          source: "release_repin",
          ref: tag,
          identity: inputs.publish_tree.tag_tree,
          readable: tree.success,
          observed_at: inputs.observed_at,
        },
        "source_identity_changed",
        false,
      ),
    ]
      + fragment_subjects
      + [
        release_chain_observed_value(
          {
            subject: "folded release notes",
            kind: "changelog_release_section",
            expected: "true",
            observed: to_string(inputs.changelog_folded),
            source: "exact_merge_tree",
            ref: tag,
            identity: inputs.publish_tree.tag_tree,
            readable: true,
            observed_at: inputs.observed_at,
          },
          "unfolded_fragments",
          true,
        ),
        release_chain_observed_value(
          {
            subject: "release tree contract",
            kind: "release_contract",
            expected: "true",
            observed: to_string(inputs.release_contract_green),
            source: "check_release_contract",
            ref: tag,
            identity: inputs.publish_tree.tag_tree,
            readable: true,
            observed_at: inputs.observed_at,
          },
          "release_contract_unproven",
          false,
        ),
      ],
    inputs.observed_at,
  )
}

/** Project immutable signed-tag identity through the current tag identity owner. */
pub fn release_chain_observe_tag(
  watch: ReleaseWatchReceipt,
  identity: ReleaseTagIdentityVerification,
  observed_at: string,
) -> ReleaseChainObservation {
  return observation(
    "tag",
    "the signed immutable tag exists at the exact merged-main commit",
    [
      release_chain_observed_value(
        {
          subject: watch.tag,
          kind: "release_tag_target",
          expected: watch.release_commit_oid,
          observed: identity.peeled_target_oid,
          source: "release_tag_identity",
          ref: watch.tag,
          identity: identity.object_oid,
          readable: identity.object_oid != "",
          observed_at: observed_at,
        },
        if identity.object_oid == "" {
          "tag_missing"
        } else {
          "tag_moved"
        },
        false,
      ),
      release_chain_observed_value(
        {
          subject: watch.tag + " signature",
          kind: "release_tag_signature",
          expected: "true",
          observed: to_string(identity.signature_verified),
          source: "release_tag_identity",
          ref: watch.tag,
          identity: identity.object_oid,
          readable: identity.object_oid != "",
          observed_at: observed_at,
        },
        if identity.object_oid == "" {
          "tag_missing"
        } else {
          "tag_unsigned"
        },
        false,
      ),
      release_chain_observed_value(
        {
          subject: watch.tag + " annotated identity",
          kind: "release_tag_identity_verification",
          expected: "true",
          observed: to_string(identity.success),
          source: "release_tag_identity",
          ref: watch.tag,
          identity: identity.object_oid,
          readable: identity.object_oid != "",
          observed_at: observed_at,
        },
        if identity.object_oid == "" {
          "tag_missing"
        } else {
          "tag_moved"
        },
        false,
      ),
    ],
    observed_at,
  )
}

/** Project publication proof from release state, never from a workflow outcome. */
pub fn release_chain_observe_prove(
  release: ReleasePublicationEvidence,
  observed_at: string,
) -> ReleaseChainObservation {
  const owner = release_publication_proof(release)
  let subjects: list<ReleaseChainObservedSubject> = [
    release_chain_observed_value(
      {
        subject: release.tag + " tag",
        kind: "release_tag_presence",
        expected: "true",
        observed: to_string(release.tag_present),
        source: "release_publication_proof",
        ref: release.tag,
        identity: release.tag,
        readable: true,
        observed_at: observed_at,
      },
      "tag_missing",
      false,
    ),
    release_chain_observed_value(
      {
        subject: release.tag + " signature",
        kind: "release_tag_signature",
        expected: "true",
        observed: to_string(release.tag_signature_verified),
        source: "release_publication_proof",
        ref: release.tag,
        identity: release.tag,
        readable: release.tag_present,
        observed_at: observed_at,
      },
      if release.tag_present {
        "tag_unsigned"
      } else {
        "tag_missing"
      },
      false,
    ),
    release_chain_observed_value(
      {
        subject: release.tag + " finalized release",
        kind: "release_finalization",
        expected: "found=true,draft=false,prerelease=" + to_string(release.expected_prerelease),
        observed: "found=" + to_string(release.release_found)
          + ",draft="
          + to_string(release.release_draft)
          + ",prerelease="
          + to_string(release.release_prerelease),
        source: "release_publication_proof",
        ref: release.tag,
        identity: release.tag,
        readable: true,
        observed_at: observed_at,
      },
      "publication_dispatch_missing",
      true,
    ),
    release_chain_observed_value(
      {
        subject: release.tag + " packages",
        kind: "package_registry_visibility",
        expected: "true",
        observed: to_string(release.packages_published),
        source: "release_publication_proof",
        ref: release.tag,
        identity: release.tag,
        readable: true,
        observed_at: observed_at,
      },
      "packages_missing",
      false,
    ),
  ]
  for asset in release.required_assets {
    subjects = subjects
      + [
        release_chain_observed_value(
          {
            subject: asset,
            kind: "release_asset",
            expected: "present",
            observed: if release.missing_assets.contains(asset) {
              "missing"
            } else {
              "present"
            },
            source: "release_publication_proof",
            ref: release.tag,
            identity: release.tag,
            readable: true,
            observed_at: observed_at,
          },
          "assets_missing",
          true,
        ),
      ]
  }
  const projected_published = len(subjects) > 0 && subjects.all({ subject -> subject.proven })
  if projected_published != owner.published {
    throw "release chain publication projection disagrees with release_publication_proof"
  }
  return observation(
    "prove",
    "signed tag, finalized release, named assets, and registry packages are all observable",
    subjects,
    observed_at,
  )
}

/** Project fleet proof through the current convergence owner. */
pub fn release_chain_observe_converge(
  target: string,
  rows: list<FleetConvergenceRow>,
  observed_at: string,
  freshness: ReleaseChainFleetProofFreshness? = nil,
) -> ReleaseChainObservation {
  const owner = convergence_snapshot_from_rows(target, rows)
  let subjects: list<ReleaseChainObservedSubject> = []
  if !owner.scope_proven {
    subjects = [
      release_chain_observed_value(
        {
          subject: "<empty repository scope>",
          kind: "fleet_convergence",
          expected: target,
          observed: "",
          source: "fleet_convergence",
          ref: "default branches",
          identity: "",
          readable: false,
          observed_at: observed_at,
        },
        "consumer_pin_unreadable",
        false,
      ),
    ]
  } else {
    subjects = rows.map(
      { row ->
        const pin = row.default_branch_pin ?? row.pin
        release_chain_observed_value(
          {
            subject: row.repo,
            kind: "default_branch_pin",
            expected: target,
            observed: if row.state == "proven" {
              pin ?? ""
            } else {
              (pin ?? "") + " [state=" + row.state + "]"
            },
            source: "fleet_convergence",
            ref: "default branch",
            identity: row.merge_commit_sha ?? row.branch_head_sha ?? "",
            readable: pin != nil,
            observed_at: observed_at,
          },
          if pin == nil {
            "consumer_pin_unreadable"
          } else if pin == target {
            "consumer_update_failed"
          } else {
            "consumer_pin_stale"
          },
          true,
        )
      },
    )
      .to_list()
  }
  if freshness != nil {
    const proof_follows_pin = freshness.proof_started_at != ""
      && freshness.proof_started_at
        >= freshness.pin_changed_at
      && freshness.proof_started_at <= freshness.deadline_at
      && freshness.proof_run_id > 0
    const overdue = freshness.observed_at >= freshness.deadline_at
    let proof_subject: ReleaseChainObservedSubject = {
      evidence: {
        subject: "fleet convergence proof freshness",
        kind: "fleet_proof_run",
        status: if proof_follows_pin {
          "observed"
        } else if overdue {
          "broken"
        } else {
          "missing"
        },
        expected: "proof starts after ${freshness.pin_changed_at} by ${freshness.deadline_at}",
        observed: if proof_follows_pin {
          "run ${freshness.proof_run_id} at ${freshness.proof_started_at}"
        } else {
          "no proof run"
        },
        source: "fleet_convergence",
        ref: "default-branch pin change",
        identity: if freshness.proof_run_id > 0 {
          to_string(freshness.proof_run_id)
        } else {
          ""
        },
        observed_at: freshness.observed_at,
      },
      proven: proof_follows_pin,
      retryable: true,
      detail: if proof_follows_pin {
        ""
      } else if overdue {
        "no convergence proof started within the bounded freshness window"
      } else {
        "convergence proof is pending inside the bounded freshness window"
      },
    }
    if !proof_follows_pin {
      proof_subject = proof_subject + {cause: "convergence_proof_missing"}
    }
    subjects = subjects + [proof_subject]
  }
  if freshness == nil {
    const projected_complete = len(subjects) > 0 && subjects.all({ subject -> subject.proven })
    if projected_complete != owner.complete {
      throw "release chain convergence projection disagrees with fleet_convergence"
    }
  }
  return observation(
    "converge",
    "every named consumer default-branch pin equals the release target",
    subjects,
    observed_at,
  )
}
