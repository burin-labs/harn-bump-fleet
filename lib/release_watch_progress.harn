import { ReleaseWatchReceipt, ReleaseWatchState } from "./release_watch_state"

pub type ReleaseWatchRuntimeRunProgress = {
  workflow: string,
  id: int,
  status: string,
  conclusion: string,
  head_branch: string,
  head_sha: string,
  url: string,
}

pub type ReleaseWatchRuntimeReadiness = {ready?: bool, asset_names?: list<string>, missing_assets?: list<string>, ...rest}

pub type ReleaseWatchRuntimeProgress = {
  observed_at: string,
  state: ReleaseWatchState,
  message: string,
  assets_ready: bool,
  observed_assets: list<string>,
  missing_assets: list<string>,
  runs: list<ReleaseWatchRuntimeRunProgress>,
}

pub fn release_watch_run_progress(run: dict) -> ReleaseWatchRuntimeRunProgress {
  return {
    workflow: to_string(run?.workflow ?? ""),
    id: to_int(run?.id ?? 0) ?? 0,
    status: to_string(run?.status ?? ""),
    conclusion: to_string(run?.conclusion ?? ""),
    head_branch: to_string(run?.head_branch ?? ""),
    head_sha: to_string(run?.head_sha ?? ""),
    url: to_string(run?.url ?? ""),
  }
}

pub fn release_watch_progress(
  state: ReleaseWatchState,
  message: string,
  readiness: ReleaseWatchRuntimeReadiness,
  runs: list<dict>,
  observed_at: string,
) -> ReleaseWatchRuntimeProgress {
  return {
    observed_at: observed_at,
    state: state,
    message: message,
    assets_ready: readiness?.ready ?? false,
    observed_assets: readiness?.asset_names ?? [],
    missing_assets: readiness?.missing_assets ?? [],
    runs: runs.map({ run -> release_watch_run_progress(run) }).to_list(),
  }
}

pub fn release_watch_progress_for_receipt(
  receipt: ReleaseWatchReceipt,
  readiness: ReleaseWatchRuntimeReadiness,
  runs: list<dict>,
  observed_at: string,
) -> ReleaseWatchRuntimeProgress {
  return release_watch_progress(receipt.state, receipt.message, readiness, runs, observed_at)
}

fn release_watch_progress_run_label(run: ReleaseWatchRuntimeRunProgress) -> string {
  const conclusion = trim(run.conclusion)
  const suffix = if conclusion != "" {
    "/" + conclusion
  } else {
    ""
  }
  const id = if run.id > 0 {
    "#" + to_string(run.id)
  } else {
    ""
  }
  return "${run.workflow}${id}:${run.status}${suffix}"
}

pub fn release_watch_progress_lines(progress: ReleaseWatchRuntimeProgress) -> list<string> {
  let lines = ["assets  : ${len(progress.observed_assets)} observed, ${len(progress.missing_assets)} missing"]
  if len(progress.missing_assets) > 0 {
    lines = lines + ["missing : " + join(progress.missing_assets, ", ")]
  }
  if len(progress.runs) > 0 {
    lines = lines
      + [
      "runs    : "
        + join(progress.runs.map({ run -> release_watch_progress_run_label(run) }).to_list(), "; "),
    ]
  }
  return lines
}
