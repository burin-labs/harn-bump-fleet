import {
  ProgressReporter,
  progress_finish,
  progress_start,
  progress_tick,
} from "std/lifecycle/progress"
import {
  ReleaseWatchReceipt,
  ReleaseWatchState,
  ReleaseWatchWarmCache,
  ReleaseWatchWarmCacheJob,
  ReleaseWatchWarmCacheRun,
} from "./release_watch_state"

pub type ReleaseWatchRuntimeRunProgress = {
  workflow: string,
  id: int,
  status: string,
  conclusion: string,
  head_branch: string,
  head_sha: string,
  url: string,
  updated_at: string,
}

pub type ReleaseWatchRuntimeWarmProgress = {
  state: string,
  workflow_run_id: int,
  workflow_run_url: string,
  status: string,
  conclusion: string,
  updated_at: string,
  jobs: list<ReleaseWatchWarmCacheJob>,
}

pub type ReleaseWatchRuntimeReadiness = {
  ready?: bool,
  asset_names?: list<string>,
  missing_assets?: list<string>,
  ...rest,
}

pub type ReleaseWatchRuntimeProgress = {
  observed_at: string,
  state: ReleaseWatchState,
  message: string,
  assets_ready: bool,
  observed_assets: list<string>,
  missing_assets: list<string>,
  runs: list<ReleaseWatchRuntimeRunProgress>,
  warm_cache: ReleaseWatchRuntimeWarmProgress,
}

pub fn release_watch_run_progress(run: dict) -> ReleaseWatchRuntimeRunProgress {
  return {
    workflow: to_string(run?.workflow ?? ""),
    id: to_int(run?.id ?? 0) ?? 0,
    status: to_string(run?.status ?? ""),
    conclusion: to_string(run?.conclusion ?? ""),
    head_branch: to_string(run?.head_branch ?? ""),
    head_sha: to_string(run?.head_sha ?? ""),
    url: to_string(run?.url ?? ""),
    updated_at: to_string(run?.updated_at ?? ""),
  }
}

pub fn release_watch_progress(
  state: ReleaseWatchState,
  message: string,
  readiness: ReleaseWatchRuntimeReadiness,
  runs: list<dict>,
  observed_at: string,
) -> ReleaseWatchRuntimeProgress {
  return {
    observed_at: observed_at,
    state: state,
    message: message,
    assets_ready: readiness?.ready ?? false,
    observed_assets: readiness?.asset_names ?? [],
    missing_assets: readiness?.missing_assets ?? [],
    runs: runs.map({ run -> release_watch_run_progress(run) }).to_list(),
    warm_cache: {
      state: "not_observed",
      workflow_run_id: 0,
      workflow_run_url: "",
      status: "",
      conclusion: "",
      updated_at: "",
      jobs: [],
    },
  }
}

pub fn release_watch_progress_with_warm_cache(
  progress: ReleaseWatchRuntimeProgress,
  warm_cache: ReleaseWatchWarmCache,
  run: ReleaseWatchWarmCacheRun?,
  jobs: list<ReleaseWatchWarmCacheJob>,
) -> ReleaseWatchRuntimeProgress {
  return {
    observed_at: progress.observed_at,
    state: progress.state,
    message: progress.message,
    assets_ready: progress.assets_ready,
    observed_assets: progress.observed_assets,
    missing_assets: progress.missing_assets,
    runs: progress.runs,
    warm_cache: {
      state: warm_cache.state,
      workflow_run_id: warm_cache.workflow_run_id,
      workflow_run_url: warm_cache.workflow_run_url,
      status: run?.status ?? "",
      conclusion: run?.conclusion ?? "",
      updated_at: if trim(run?.completed_at ?? "") != "" {
        run?.completed_at ?? ""
      } else {
        warm_cache.updated_at
      },
      jobs: jobs,
    },
  }
}

pub fn release_watch_progress_for_receipt(
  receipt: ReleaseWatchReceipt,
  readiness: ReleaseWatchRuntimeReadiness,
  runs: list<dict>,
  observed_at: string,
) -> ReleaseWatchRuntimeProgress {
  return release_watch_progress(receipt.state, receipt.message, readiness, runs, observed_at)
}

fn release_watch_progress_run_label(run: ReleaseWatchRuntimeRunProgress) -> string {
  const conclusion = trim(run.conclusion)
  const suffix = if conclusion != "" {
    "/" + conclusion
  } else {
    ""
  }
  const id = if run.id > 0 {
    "#" + to_string(run.id)
  } else {
    ""
  }
  return "${run.workflow}${id}:${run.status}${suffix}"
}

pub fn release_watch_progress_lines(progress: ReleaseWatchRuntimeProgress) -> list<string> {
  let lines = [
    "assets  : ${len(progress.observed_assets)} observed, ${len(progress.missing_assets)} missing",
  ]
  if len(progress.missing_assets) > 0 {
    lines = lines + ["missing : " + join(progress.missing_assets, ", ")]
  }
  if len(progress.runs) > 0 {
    lines = lines
      + [
        "runs    : "
          + join(
            progress.runs.map({ run -> release_watch_progress_run_label(run) }).to_list(),
            "; ",
          ),
      ]
  }
  if progress.warm_cache.state != "not_observed" {
    const run_status = if trim(progress.warm_cache.status) != "" {
      ":" + progress.warm_cache.status
        + if trim(progress.warm_cache.conclusion) != "" {
          "/" + progress.warm_cache.conclusion
        } else {
          ""
        }
    } else {
      ""
    }
    lines = lines
      + [
        "warm    : ${progress.warm_cache.state} #${progress.warm_cache.workflow_run_id}${run_status} updated ${progress.warm_cache.updated_at}",
      ]
    for job in progress.warm_cache.jobs {
      if job.status == "completed" && job.conclusion == "success" {
        continue
      }
      const active = if trim(job.active_step ?? "") != "" {
        " step=" + (job.active_step ?? "")
      } else {
        ""
      }
      lines = lines
        + [
          "job     : ${job.name} ${job.status}"
            + if trim(job.conclusion) != "" {
              "/" + job.conclusion
            } else {
              ""
            }
            + active,
        ]
    }
  }
  return lines
}

/** Semantic fingerprint: timestamps alone do not turn every poll into log spam. */
pub fn release_watch_progress_key(progress: ReleaseWatchRuntimeProgress) -> string {
  return json_stringify(
    {
      state: progress.state,
      message: progress.message,
      assets_ready: progress.assets_ready,
      observed_assets: progress.observed_assets,
      missing_assets: progress.missing_assets,
      runs: progress.runs.map(
        { run ->
          return {
            workflow: run.workflow,
            id: run.id,
            status: run.status,
            conclusion: run.conclusion,
          }
        },
      )
        .to_list(),
      warm_cache: {
        state: progress.warm_cache.state,
        workflow_run_id: progress.warm_cache.workflow_run_id,
        status: progress.warm_cache.status,
        conclusion: progress.warm_cache.conclusion,
        jobs: progress.warm_cache.jobs.map(
          { job ->
            return {
              name: job.name,
              status: job.status,
              conclusion: job.conclusion,
              active_step: job.active_step ?? "",
            }
          },
        )
          .to_list(),
      },
    },
  )
}

pub fn release_watch_progress_should_emit(
  previous_key: string,
  progress: ReleaseWatchRuntimeProgress,
  poll: int,
  previous_emit_poll: int,
  heartbeat_polls: int = 10,
) -> bool {
  return previous_key == ""
    || release_watch_progress_key(progress) != previous_key
    || poll - previous_emit_poll
      >= heartbeat_polls
}

/** Default watch ceiling: 240 polls at 30s. */
pub const RELEASE_WATCH_DEFAULT_LIMIT_MS: int = 7200000

/** Start the watch observation stage through the stdlib progress primitive. */
pub fn release_watch_stage_start(harness: Harness, tag: string, limit_ms: int) -> ProgressReporter {
  return progress_start(harness, "watching ${tag}", {limit_ms: limit_ms})
}

/** Tick the watch stage with the typed progress snapshot as observable state. */
pub fn release_watch_stage_tick(
  harness: Harness,
  reporter: ProgressReporter,
  progress: ReleaseWatchRuntimeProgress,
  poll: int,
) -> ProgressReporter {
  return progress_tick(
    harness,
    reporter,
    "poll ${poll}; " + join(release_watch_progress_lines(progress), "; "),
  )
}

/** Close the watch stage with exactly one terminal line. */
pub fn release_watch_stage_finish(
  harness: Harness,
  reporter: ProgressReporter,
  outcome: string,
  detail: string?,
) -> ProgressReporter {
  return progress_finish(harness, reporter, outcome, detail)
}
