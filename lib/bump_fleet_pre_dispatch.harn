import { is_v_semver } from "std/semver"
import { FleetAuditReceipt } from "./run_receipts"
import { RunSessionViewFleetGate } from "./run_session_view_gate"

pub type FleetRepo = {slug: string, dir: string, ...rest}

pub type FleetPreDispatchOptions = {
  target?: string,
  dry_run: bool,
  only?: string,
  harn_repo: string,
}

pub type FleetRunContext = {
  target: string,
  run_id: string,
  started_iso: string,
  mode: string,
  run_timing: dict,
  repos: list<FleetRepo>,
  view_gate: RunSessionViewFleetGate,
  public_surface_impact: dict,
}

pub type FleetPreDispatchStopped = {ready: bool, exit_code: int}

pub type FleetPreDispatchReady = {ready: bool, exit_code: 0, context: FleetRunContext}

pub type FleetPreDispatchResult = FleetPreDispatchStopped | FleetPreDispatchReady

/**
 * Return whether a bump workflow exposes the manual trigger the fleet calls.
 *
 * Harn's source repository publishes a same-named `workflow_call` template for
 * consumers, but that reusable workflow is not itself dispatchable.
 */
pub fn bump_workflow_has_manual_dispatch(source: string) -> bool {
  return contains("\n${source}\n", "\n  workflow_dispatch:")
}

pub type FleetPreDispatchAdapter = {
  resolve_target: fn() -> string,
  start_run: fn(string, string) -> any,
  install_cost_budget: fn() -> string,
  discover_repos: fn() -> list<FleetRepo>,
  wait_for_readiness: fn(string) -> any,
  readiness_detail: fn(any) -> string,
  skipped_view_gate: fn(string, string) -> RunSessionViewFleetGate,
  run_view_gate: fn(string, string) -> RunSessionViewFleetGate,
  skipped_public_surface_impact: fn(string, string) -> any,
  scan_public_surface: fn(string, list<FleetRepo>, string) -> any,
  finish_run: fn(any, dict) -> any,
  timing_artifacts: fn() -> any,
  now_iso: fn() -> string,
  operator: fn() -> string,
  host: fn() -> string,
  write_audit: fn(string, FleetAuditReceipt) -> any,
}

fn unique_fleet_repos(repos: list<FleetRepo>) -> list<FleetRepo> {
  let seen = {}
  let unique: list<FleetRepo> = []
  for repo in repos {
    if seen[repo.slug] ?? false {
      continue
    }
    seen[repo.slug] = true
    unique = unique + [repo]
  }
  return unique
}

/** Own every decision that can stop a fleet run before repository dispatch. */
pub fn fleet_pre_dispatch_phase(
  harness: Harness,
  options: FleetPreDispatchOptions,
  summary_model: string,
  adapter: FleetPreDispatchAdapter,
) -> FleetPreDispatchResult {
  const target = options.target ?? adapter.resolve_target()
  if !is_v_semver(target) {
    harness.stdio.eprintln("error: target must look like vX.Y.Z, got '${target}'")
    return {ready: false, exit_code: 2}
  }
  const run = adapter.start_run(
    target,
    if options.dry_run {
      "dry-run"
    } else {
      "live"
    },
  )
  harness.stdio.println("== harn-bump-fleet run ${run.run_id}")
  harness.stdio.println("   target version : ${target}")
  harness.stdio.println("   mode           : ${run.mode}")
  harness.stdio.println("   ${adapter.install_cost_budget()}")
  const all_repos = unique_fleet_repos(adapter.discover_repos())
  const repos: list<FleetRepo> = if options.only != nil {
    all_repos.filter({ repo -> repo.slug == options.only })
  } else {
    all_repos
  }
  harness.stdio.println("   repos discovered: ${len(all_repos)} (running on ${len(repos)})")
  for repo in repos {
    harness.stdio.println("     - ${repo.slug}  (${repo.dir})")
  }
  if len(repos) == 0 {
    harness.stdio.eprintln("no candidate repos matched (only=${options.only ?? ""})")
    adapter.finish_run(run.run_timing, {status: "error", outcome: "no_matching_repos"})
    return {ready: false, exit_code: 1}
  }
  if !options.dry_run {
    harness.stdio.println("\n== waiting for target release readiness ...")
    const readiness = adapter.wait_for_readiness(target)
    if !readiness.ready {
      harness.stdio.eprintln(
        "error: target release ${target} was not ready after ${readiness.attempts} checks: "
          + adapter
          .readiness_detail(readiness),
      )
      adapter.finish_run(run.run_timing, {status: "error", outcome: "release_not_ready"})
      return {ready: false, exit_code: 1}
    }
    harness.stdio.println("   ready: ${adapter.readiness_detail(readiness)}")
  }
  const view_gate = if options.dry_run {
    const reason = "skipped on dry-run; live bumps run make check-run-view-fixtures before dispatch"
    harness.stdio.println("\n== run/session view compatibility gate skipped on dry-run")
    harness.stdio.println("   ${reason}")
    adapter.skipped_view_gate(target, reason)
  } else {
    harness.stdio.println("\n== run/session view compatibility gate ...")
    const gate = adapter.run_view_gate(options.harn_repo, target)
    harness.stdio.println("   schemas: ${gate.summary_line}")
    harness.stdio.println("   check  : ${gate.check.command} -> ${gate.check.status}")
    harness.stdio.println("   change : ${gate.target_change.detail}")
    gate
  }
  if !view_gate.ok {
    const public_surface_impact = adapter.skipped_public_surface_impact(
      target,
      "run/session view compatibility gate failed before dispatch",
    )
    harness.stdio.eprintln(
      "error: run/session view compatibility gate failed: " + trim(view_gate.check.stderr ?? ""),
    )
    const report = adapter.finish_run(
      run.run_timing,
      {status: "error", outcome: "run_session_view_gate_failed"},
    )
    const timing = adapter.timing_artifacts()
    const payload = {
      schema_version: "harn_bump_fleet.audit.v1",
      run_id: run.run_id,
      started_iso: run.started_iso,
      finished_iso: adapter.now_iso(),
      duration_ms: report.duration_ms,
      operator: adapter.operator(),
      host: adapter.host(),
      target_version: target,
      mode: run.mode,
      repos_total: len(repos),
      repos_dispatched: 0,
      summary_model: summary_model,
      summary_text: "- run/session view compatibility gate failed before dispatch",
      summary: {
        source: "deterministic_gate",
        text: "- run/session view compatibility gate failed before dispatch",
      },
      outcomes: [],
      run_session_view: view_gate,
      public_surface_impact: public_surface_impact,
      trace_spans: timing.trace_spans,
      timing_summary: timing.timing_summary,
    }
    const written = adapter.write_audit(run.run_id, payload)
    harness.stdio.println("   audit : ${written.md_path}")
    return {ready: false, exit_code: 1}
  }
  harness.stdio.println("\n== public surface impact scan ...")
  const public_surface_impact = adapter.scan_public_surface(target, repos, options.harn_repo)
  harness.stdio.println(
    "   source: ${public_surface_impact.source_status}; surfaces: ${public_surface_impact.surface_count}; affected repos: ${public_surface_impact.affected_repo_count}",
  )
  return {
    ready: true,
    exit_code: 0,
    context: {
      target: target,
      run_id: run.run_id,
      started_iso: run.started_iso,
      mode: run.mode,
      run_timing: run.run_timing,
      repos: repos,
      view_gate: view_gate,
      public_surface_impact: public_surface_impact,
    },
  }
}
