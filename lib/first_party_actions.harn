import "std/schema"
import { decode_github_workflow } from "./github_workflow"

/** Reviewed Action sources and their transitive bootstrap scripts move together. */
pub const FIRST_PARTY_ACTIONS: {prefix: string, revision: string, actions: list<string>} = {
  prefix: "burin-labs/harn/.github/actions/",
  revision: "667a6bb60582e6fcb08abc74621c5fc89fb77703",
  actions: ["setup-harn", "git-push-credentials"],
}

pub fn first_party_action_reference(action: string) -> string {
  if !FIRST_PARTY_ACTIONS.actions.contains(action) {
    throw "unreviewed first-party Action '${action}'"
  }
  return FIRST_PARTY_ACTIONS.prefix + action + "@" + FIRST_PARTY_ACTIONS.revision
}

pub type FirstPartyActionProjection = {source: string, references: int, actions: list<string>}

pub type FirstPartyActionCensus = {workflows: int, references: int, actions: list<string>}

/** Absence and a partial inventory cannot satisfy a projection check. */
pub fn validate_first_party_action_census(census: FirstPartyActionCensus) -> nil {
  if census.workflows < 5 || census.references < 8 {
    throw "incomplete workflow census: ${census.workflows} workflows, ${census.references} first-party Action references"
  }
  for action in FIRST_PARTY_ACTIONS.actions {
    if !census.actions.contains(action) {
      throw "missing first-party Action '${action}' from workflow census"
    }
  }
}

/** Project only structurally discovered Action steps, preserving the rest of the workflow. */
pub fn render_first_party_action_pins(source: string) -> FirstPartyActionProjection {
  const workflow = decode_github_workflow(source)
  const document = schema_expect<dict>(yaml_parse(source), schema_dict(schema_any()))
  let normalized_jobs: dict = document.jobs
  let rendered = source
  let references = 0
  let actions: list<string> = []
  let observed_counts = schema_expect<dict<int>>({}, schema_dict(schema_int()))
  for job in workflow.jobs {
    if job.value.steps == nil {
      continue
    }
    let normalized_steps: list<dict> = []
    for step in document.jobs[job.key].steps {
      const observed = step.uses ?? ""
      if !starts_with(observed, FIRST_PARTY_ACTIONS.prefix) {
        normalized_steps = normalized_steps + [step]
        continue
      }
      const parts = split(observed, "@")
      if len(parts) != 2 || len(regex_captures("^[0-9a-f]{40}$", parts[1] ?? "")) == 0 {
        throw "first-party Action requires an immutable full commit: ${observed}"
      }
      const action = replace(parts[0], FIRST_PARTY_ACTIONS.prefix, "")
      const reference = first_party_action_reference(action)
      observed_counts = observed_counts + {[observed]: (observed_counts.get(observed) ?? 0) + 1}
      normalized_steps = normalized_steps + [step + {uses: reference}]
      references = references + 1
      actions = actions + [action]
    }
    normalized_jobs = normalized_jobs
      + {[job.key]: document.jobs[job.key] + {steps: normalized_steps}}
  }
  for observed in observed_counts {
    const action = replace(split(observed.key, "@")[0], FIRST_PARTY_ACTIONS.prefix, "")
    const reference = first_party_action_reference(action)
    if reference == observed.key {
      continue
    }
    if len(split(source, observed.key)) - 1 != observed.value {
      throw "Action reference also occurs outside discovered step uses fields"
    }
    rendered = replace(rendered, observed.key, reference)
  }
  if yaml_parse(rendered) != document + {jobs: normalized_jobs} {
    throw "Action pin replacement changed the measured workflow contract outside step uses fields"
  }
  return {source: rendered, references: references, actions: actions}
}
