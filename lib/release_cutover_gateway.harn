import { ReleaseChainPlannedEffect } from "./release_chain_effect"
import { ReleaseChainDoorEntry, ReleaseChainEffectGateway } from "./release_chain_effect_door"
import { ReleaseChainEvidenceRead } from "./release_chain_state"
import { release_cutover_branch, release_cutover_title } from "./release_fold_repair"

/**
 * What the gateway may do when it finds no cutover open.
 *
 * The two modes share every read. A dry run that took a different path to the
 * repository would prove the path it took, not the one the live run takes.
 */
pub type ReleaseCutoverGatewayMode = "dry_run" | "live"

/**
 * What one read of the release repository found.
 *
 * `read_failed` is a separate field rather than an empty `open_pr`, because "I
 * looked and found no cutover" and "I could not look" select opposite actions.
 * The first opens one; the second must stop. Collapsing them is how a repair
 * opens a second pull request beside one it could not see.
 */
pub type ReleaseCutoverState = {
  /** The cutover already open, as `owner/repo#number`, or "" when there is none. */
  open_pr: string,
  /** Who opened it, for the read-back's identity. Empty when nothing is open. */
  opened_by: string,
  /** Why the read could not be trusted, or "" when it could. */
  read_failed: string,
}

/** The version a planned cutover effect advances the default branch to. */
pub fn release_cutover_effect_version(planned: ReleaseChainPlannedEffect) -> string {
  return trim(planned.subject)
}

/**
 * A gateway that can find the cutover, and in a dry run will not open one.
 *
 * `read_state` is the only way out to the repository here, and it is a field so
 * a test can pass one that throws on contact. A gateway proven only against a
 * recording double proves that something was recorded; one proven against a
 * tripwire proves it did not reach the outside world when it was not meant to.
 *
 * The dry run refuses rather than reporting a read-back. The door's read-back is
 * precisely what separates an effect that happened from one that did not, so a
 * dry run that handed it an observed read would record a repair nobody
 * performed, and a missing one would record an attempt nobody made. Refusing
 * puts the truth in the receipt: the cutover it would open, and that it did not.
 */
pub fn release_cutover_gateway(
  mode: ReleaseCutoverGatewayMode,
  repository: string,
  read_state: fn(string, string) -> ReleaseCutoverState,
  now: fn() -> string,
) -> ReleaseChainEffectGateway {
  return {
    now: now,
    perform: fn(planned: ReleaseChainPlannedEffect, entry: ReleaseChainDoorEntry) {
      // This gateway owns one effect. Another kind reaching it is a routing
      // defect, and performing the cutover anyway would repair something
      // nobody asked to repair.
      if planned.kind != "open_development_cutover_pr" || entry.mechanism != "pull_request" {
        throw "the cutover gateway was handed `${planned.kind}` by `${entry.mechanism}`, "
          + "which it does not perform"
      }
      const version = release_cutover_effect_version(planned)
      if version == "" {
        throw "the planned cutover names no development version, so no branch can be built"
      }
      const branch = release_cutover_branch(version)
      const state = read_state(repository, branch)
      if trim(state.read_failed) != "" {
        throw "could not read whether a cutover is already open on ${repository} ${branch}, "
          + "so opening one cannot be ruled safe: ${trim(state.read_failed)}"
      }
      if trim(state.open_pr) != "" {
        // The goal is that a cutover exists, not that this run opened it. One
        // already open satisfies the effect, and saying so is what stops a
        // second branch claiming the same version.
        const reads: list<ReleaseChainEvidenceRead> = [
          {
            subject: trim(state.open_pr),
            kind: "pull_request",
            status: "observed",
            expected: release_cutover_title(version),
            observed: "already open on ${branch}",
            source: repository,
            ref: branch,
            identity: trim(state.opened_by),
            observed_at: now(),
          },
        ]
        return reads
      }
      if mode == "dry_run" {
        throw "dry run: would open ${repository} ${branch} titled "
          + "`${release_cutover_title(version)}`; nothing was opened"
      }
      throw "the live cutover opener is not wired yet, so nothing was opened"
    },
  }
}
