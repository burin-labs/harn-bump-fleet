// Shared terminal rendering and input for the release-gate and post-run chats.
import { read_line } from "std/io"

pub type ChatAnsi = {
  reset: string,
  dim: string,
  bold: string,
  cyan: string,
  magenta: string,
  yellow: string,
  green: string,
  red: string,
}

pub fn chat_ansi() -> ChatAnsi {
  return {
    reset: "[0m",
    dim: "[2m",
    bold: "[1m",
    cyan: "[36m",
    magenta: "[35m",
    yellow: "[33m",
    green: "[32m",
    red: "[31m",
  }
}

pub fn chat_prompt_line(label, timeout_s) -> any {
  const effective_timeout_s = timeout_s ?? 60
  const result = read_line(
    {prompt: label ?? "", timeout_ms: effective_timeout_s * 1000, trim: true},
  )
  if !result.ok {
    return nil
  }
  return result.value
}

pub fn print_chat_assistant_turn(harness: Harness, turn) {
  const ansi = chat_ansi()
  const body = trim(turn?.visible_text ?? turn?.text ?? turn?.prose ?? "")
  harness.stdio.println("")
  if body == "" {
    const stop = trim(turn?.stop_reason ?? "")
    const tool_calls = turn?.tool_calls ?? []
    const tool_count = if type_of(tool_calls) == "list" {
      len(tool_calls)
    } else {
      0
    }
    let hint = "(no text from model"
    if stop != "" {
      hint = hint + " · stop_reason=${stop}"
    }
    if tool_count > 0 {
      hint = hint + " · ${tool_count} tool call(s)"
    }
    hint = hint + ")"
    harness.stdio.println(
      ansi.magenta + "assistant>" + ansi.reset + " " + ansi.yellow + hint + ansi.reset,
    )
  } else {
    harness.stdio.println(ansi.magenta + "assistant>" + ansi.reset + " " + body)
  }
  harness.stdio.println("")
}
