import {
  FleetRepairAuthorityAudit,
  FleetRepairPlan,
  FleetRepairPolicy,
} from "./fleet_repair_contract"
import { FleetRepairResult } from "./fleet_repair_terminal"

fn validator_authority_state(result: FleetRepairResult?) -> string {
  if result == nil || result.status == "refused" {
    return "missing"
  }
  const validations = result.validation_evidence ?? []
  if len(validations) == 0 {
    return "missing"
  }
  const launch_refusals = validations.filter(
    { validation ->
      starts_with(
        trim(validation.diagnostic),
        "validator could not start under prepared process authority:",
      )
    },
  )
    .to_list()
  if len(launch_refusals) == 0 {
    return if result.reason == "validator_environment_unavailable" {
      "malformed"
    } else {
      "started"
    }
  }
  return if len(launch_refusals) == len(validations)
    && result.reason == "validator_environment_unavailable" {
    "denied"
  } else {
    "malformed"
  }
}

/** Build a non-secret authority ledger without guessing at opaque tool calls. */
pub fn fleet_repair_authority_audit(
  plan: FleetRepairPlan,
  results: list<FleetRepairResult>,
  policy: FleetRepairPolicy,
) -> FleetRepairAuthorityAudit {
  let requested = [
    "tool:repair_read",
    "tool:repair_inspect",
    "tool:repair_edit",
    "network:api.github.com:443",
    "network:api.cerebras.ai:443",
  ]
  for candidate in plan.candidates {
    requested = requested
      + [
        "filesystem:checkout-root=" + candidate.directory,
        "process:canonical-formatter=" + candidate.repo,
        "process:validator=" + candidate.repo,
        "agent:repair=" + candidate.repo,
        "github:publish=" + candidate.repo,
      ]
    if len(candidate.allowed_new_files) > 0 {
      requested = requested + ["tool:repair_write=" + candidate.repo]
    }
  }
  for recovery in plan.recoveries {
    requested = requested + ["github:pull-request-recovery=" + recovery.repo]
  }
  const secret_reference = trim(policy.provider_secret_reference ?? "")
  if secret_reference != "" {
    requested = requested + ["secret:" + secret_reference + "->repair-agent"]
  }
  // Build grants from observed boundary evidence, never from the request. A
  // missing result therefore cannot make a requested capability look granted.
  let granted: list<string> = []
  let denied = [
    "tool:delete",
    "tool:mkdir",
    "tool:general_write",
    "filesystem:outside-checkout-root",
    "network:in-process-unmatched-destination",
    "secret:undeclared-consumer",
  ]
  let used: list<string> = []
  let unused: list<string> = []
  for candidate in plan.candidates {
    const result = results.find({ value -> value.repo == candidate.repo })
    const validator = "process:validator=" + candidate.repo
    const validator_state = validator_authority_state(result)
    if validator_state == "denied" {
      denied = denied + [validator]
      unused = unused
        + ["process:canonical-formatter=" + candidate.repo, "agent:repair=" + candidate.repo]
      continue
    }
    if validator_state == "malformed" {
      denied = denied + ["authority:malformed-validator-evidence=" + candidate.repo]
      unused = unused
        + ["process:canonical-formatter=" + candidate.repo, "agent:repair=" + candidate.repo]
      continue
    }
    if result == nil || result.status == "refused" {
      unused = unused
        + [
          "process:canonical-formatter=" + candidate.repo,
          validator,
          "agent:repair=" + candidate.repo,
        ]
      continue
    }
    granted = granted
      + [
        "filesystem:checkout-root=" + candidate.directory,
        "process:canonical-formatter=" + candidate.repo,
        validator,
      ]
    used = used + [validator]
    if result.reason == "leased_checkout_already_valid" {
      unused = unused + ["process:canonical-formatter=" + candidate.repo]
    } else {
      used = used + ["process:canonical-formatter=" + candidate.repo]
    }
    if len(result.attempts) == 0 {
      unused = unused + ["agent:repair=" + candidate.repo]
      if len(candidate.allowed_new_files) > 0 {
        unused = unused + ["tool:repair_write=" + candidate.repo]
      }
      if result.status == "repaired" {
        granted = granted + ["github:publish=" + candidate.repo]
        used = used + ["github:publish=" + candidate.repo]
      }
      continue
    }
    granted = granted
      + [
        "tool:repair_read",
        "tool:repair_inspect",
        "tool:repair_edit",
        "agent:repair=" + candidate.repo,
      ]
    if len(candidate.allowed_new_files) > 0 {
      granted = granted + ["tool:repair_write=" + candidate.repo]
    }
    if secret_reference != "" {
      granted = granted + ["secret:" + secret_reference + "->repair-agent"]
    }
    used = used + ["agent:repair=" + candidate.repo]
    for attempt in result.attempts {
      if attempt.provider != "unknown" && attempt.model != "unknown" {
        const provider_network = if attempt.provider == "cerebras" {
          "network:api.cerebras.ai:443"
        } else {
          ""
        }
        if provider_network != "" {
          granted = granted + [provider_network]
        }
        used = used + ["provider:" + attempt.provider + "/" + attempt.model]
      }
    }
    if result.status == "repaired" {
      granted = granted + ["network:api.github.com:443", "github:publish=" + candidate.repo]
      used = used + ["github:publish=" + candidate.repo]
    }
  }
  for recovery in plan.recoveries {
    const result = results.find({ value -> value.repo == recovery.repo })
    if result?.status == "repaired" {
      granted = granted
        + ["network:api.github.com:443", "github:pull-request-recovery=" + recovery.repo]
      used = used + ["github:pull-request-recovery=" + recovery.repo]
    } else {
      unused = unused + ["github:pull-request-recovery=" + recovery.repo]
    }
  }
  return {
    decider: "Harn FleetRepairPolicy with manifest leases and runtime readiness",
    requested: requested.unique(),
    granted: granted.unique(),
    used: used.unique(),
    denied: denied.unique(),
    unused: unused.unique(),
    observation_note:
      "Validator grants are reported only when launch evidence returned through the prepared process boundary; used entries are controller-proven effects, while detailed agent tool use stays in its transcript.",
  }
}
