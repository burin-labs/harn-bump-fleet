import { HarnReleaseContract, contract_next_development_version } from "./harn_release_contract"

/**
 * What fold a published release is still owed, decided from the tree itself.
 *
 * A release publishes, and two things must then land on the default branch:
 * the released notes folded to the top of the changelog, and the workspace
 * moved to the next development version. When the step that does that fails,
 * nothing notices until the next cut dies on a precondition hours later,
 * naming causes that are not the reason. That has now happened twice in the
 * nine-release window this work came from, and once more the night this was
 * written.
 *
 * The decision is pure and takes the same three facts the preflight already
 * reads, so the answer here and the answer in the receipt cannot disagree.
 * Whoever performs the repair -- a dispatch, a pull request, or a person --
 * asks this what is owed.
 */
pub type ReleaseFoldOwed = {
  /** The published tag, as tagged, including its leading `v`. */
  tag: string,
  /** The published version, without the leading `v`. */
  version: string,
  /** The workspace version the branch must end up carrying. */
  development_version: string,
  /** Whether the changelog still needs the published version's section. */
  changelog_owed: bool,
  /** Whether the workspace version still needs advancing. */
  workspace_owed: bool,
  /** True when either half is outstanding. */
  owed: bool,
  /** Why, in one line, for a receipt or a pull request body. */
  reason: string,
}

fn version_of_tag(tag: string) -> string {
  const trimmed = trim(tag)
  if starts_with(trimmed, "v") {
    return trimmed[1:len(trimmed)]
  }
  return trimmed
}

/**
 * Decide what the latest published release still owes the default branch.
 *
 * Both halves are asked separately because they fail separately: a run can
 * write the changelog and die before the version bump, and the reverse. A
 * repair that treated them as one thing would either redo work that landed or
 * skip work that did not.
 */
pub fn release_fold_owed(
  contract: HarnReleaseContract,
  latest_tag: string,
  workspace_version: string,
  changelog_top_version: string,
) -> ReleaseFoldOwed {
  const tag = trim(latest_tag)
  const version = version_of_tag(tag)
  const workspace = trim(workspace_version)
  const changelog_top = trim(changelog_top_version)
  if version == "" {
    // Asked before the next version is computed, because the version helper
    // refuses an empty one and a repository with no release is a real state,
    // not an error.
    return {
      tag: tag,
      version: version,
      development_version: "",
      changelog_owed: false,
      workspace_owed: false,
      owed: false,
      reason: "no release has been published, so no fold is owed",
    }
  }
  const development = contract_next_development_version(contract, version)
  const changelog_owed = changelog_top != version
  const workspace_owed = workspace != development && workspace != version
  if !changelog_owed && !workspace_owed {
    return {
      tag: tag,
      version: version,
      development_version: development,
      changelog_owed: false,
      workspace_owed: false,
      owed: false,
      reason: "${tag} is folded: the changelog tops at v${version} and the workspace carries "
        + workspace,
    }
  }
  let missing: list<string> = []
  if changelog_owed {
    missing = missing
      + ["the changelog tops at v${changelog_top} rather than v${version}"]
  }
  if workspace_owed {
    missing = missing + ["the workspace carries ${workspace} rather than ${development}"]
  }
  return {
    tag: tag,
    version: version,
    development_version: development,
    changelog_owed: changelog_owed,
    workspace_owed: workspace_owed,
    owed: true,
    reason: "${tag} published but is not folded: " + join(missing, ", "),
  }
}

/** The branch one fold repair owns, named for the version so a retry finds its own. */
pub fn release_fold_branch(version: string) -> string {
  return "release-fold/v" + trim(version)
}

/** The title the fold repair opens under, in this repository's convention. */
pub fn release_fold_title(version: string) -> string {
  return "[Release] Fold the v${trim(version)} release notes and open the next development cycle"
}

/**
 * Whether an existing pull request is the fold this repair would open.
 *
 * Matched on the branch rather than the title, because the branch is what the
 * repair itself chose and a title can be edited by anyone who touches the pull
 * request. Opening a second fold for a release that already has one is the
 * failure this exists to avoid: two branches both claiming to advance the same
 * version, and a person deciding which.
 */
pub fn release_fold_pr_is_ours(head_ref: string, version: string) -> bool {
  return trim(head_ref) == release_fold_branch(version)
}

/**
 * The dispatch a fold repair would perform, named before anything performs it.
 *
 * The repair does not open the pull request itself. The release repository
 * already owns a workflow that produces the fold, and reproducing that here
 * would be a second implementation of the same thing, drifting from the first
 * the moment either changed. So the effect is a dispatch of that workflow, and
 * this is the whole of what a dispatch would say.
 */
pub type ReleaseFoldDispatchPlan = {
  repository: string,
  workflow: string,
  ref: string,
  inputs: dict<string, string>,
  /** The fold this dispatch is meant to produce. */
  owed: ReleaseFoldOwed,
  reason: string,
}

/** Where the fold workflow lives, as one named shape rather than three strings. */
pub type ReleaseFoldDispatchTarget = {repository: string, workflow: string, ref: string}

/** Why a fold repair is not dispatching, when it is not. */
pub type ReleaseFoldRefusal = {
  /** `nothing_owed`, `already_open`, or `no_release`. */
  code: string,
  reason: string,
  /** The pull request already doing this work, when that is the reason. */
  existing_pr: string,
}

pub type ReleaseFoldRepairDecision = {
  schema_version: "harn_bump_fleet.release_fold_repair.v1",
  dispatch: ReleaseFoldDispatchPlan?,
  refusal: ReleaseFoldRefusal?,
}

/**
 * Decide whether to dispatch, and say why when not.
 *
 * `existing_fold_pr` is the pull request already doing this work, or "" when
 * the caller looked and found none. Looking is the caller's job because it is
 * a read; deciding is this function's, so the find-before-open rule has one
 * owner rather than being re-implemented by each caller who remembers it.
 *
 * A refusal is a value here, not an absence. A caller that receives neither a
 * dispatch nor a refusal has found a defect, not a quiet success.
 */
pub fn release_fold_repair_decision(
  owed: ReleaseFoldOwed,
  target: ReleaseFoldDispatchTarget,
  existing_fold_pr: string,
) -> ReleaseFoldRepairDecision {
  const repository = target.repository
  const workflow = target.workflow
  const ref = target.ref
  if trim(owed.version) == "" {
    return {
      schema_version: "harn_bump_fleet.release_fold_repair.v1",
      dispatch: nil,
      refusal: {code: "no_release", reason: owed.reason, existing_pr: ""},
    }
  }
  if !owed.owed {
    return {
      schema_version: "harn_bump_fleet.release_fold_repair.v1",
      dispatch: nil,
      refusal: {code: "nothing_owed", reason: owed.reason, existing_pr: ""},
    }
  }
  if trim(existing_fold_pr) != "" {
    return {
      schema_version: "harn_bump_fleet.release_fold_repair.v1",
      dispatch: nil,
      refusal: {
        code: "already_open",
        reason: "${owed.tag} is already being folded by ${trim(existing_fold_pr)}; a second "
          + "dispatch would open a second branch claiming the same version",
        existing_pr: trim(existing_fold_pr),
      },
    }
  }
  return {
    schema_version: "harn_bump_fleet.release_fold_repair.v1",
    dispatch: {
      repository: trim(repository),
      workflow: trim(workflow),
      ref: trim(ref),
      inputs: {},
      owed: owed,
      reason: owed.reason,
    },
    refusal: nil,
  }
}
