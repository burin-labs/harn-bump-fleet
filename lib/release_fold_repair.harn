import { HarnReleaseContract, contract_next_development_version } from "./harn_release_contract"

/**
 * What fold a published release is still owed, decided from the tree itself.
 *
 * A release publishes, and two things must be true of the default branch: the
 * released notes sit at the top of the changelog, and the workspace carries the
 * next development version. Two different steps put them there, so they fail
 * separately and are asked separately. When either fails, nothing notices until
 * the next cut dies on a precondition hours later, naming causes that are not
 * the reason. That has now happened twice in the nine-release window this work
 * came from, and once more the night this was written.
 *
 * The decision is pure and takes the same three facts the preflight already
 * reads, so the answer here and the answer in the receipt cannot disagree.
 * Whoever performs the repair -- a dispatch, a pull request, or a person --
 * asks this what is owed.
 */
pub type ReleaseFoldOwed = {
  /** The published tag, as tagged, including its leading `v`. */
  tag: string,
  /** The published version, without the leading `v`. */
  version: string,
  /** The workspace version the branch must end up carrying. */
  development_version: string,
  /** Whether the changelog still needs the published version's section. */
  changelog_owed: bool,
  /** Whether the workspace version still needs advancing. */
  workspace_owed: bool,
  /** True when either half is outstanding. */
  owed: bool,
  /** Why, in one line, for a receipt or a pull request body. */
  reason: string,
}

fn version_of_tag(tag: string) -> string {
  const trimmed = trim(tag)
  if starts_with(trimmed, "v") {
    return trimmed[1:len(trimmed)]
  }
  return trimmed
}

/**
 * Decide what the latest published release still owes the default branch.
 *
 * Both halves are asked separately because they fail separately: a run can
 * write the changelog and die before the version bump, and the reverse. A
 * repair that treated them as one thing would either redo work that landed or
 * skip work that did not.
 */
pub fn release_fold_owed(
  contract: HarnReleaseContract,
  latest_tag: string,
  workspace_version: string,
  changelog_top_version: string,
) -> ReleaseFoldOwed {
  const tag = trim(latest_tag)
  const version = version_of_tag(tag)
  const workspace = trim(workspace_version)
  const changelog_top = trim(changelog_top_version)
  if version == "" {
    // Asked before the next version is computed, because the version helper
    // refuses an empty one and a repository with no release is a real state,
    // not an error.
    return {
      tag: tag,
      version: version,
      development_version: "",
      changelog_owed: false,
      workspace_owed: false,
      owed: false,
      reason: "no release has been published, so no fold is owed",
    }
  }
  const development = contract_next_development_version(contract, version)
  const changelog_owed = changelog_top != version
  const workspace_owed = workspace != development && workspace != version
  if !changelog_owed && !workspace_owed {
    return {
      tag: tag,
      version: version,
      development_version: development,
      changelog_owed: false,
      workspace_owed: false,
      owed: false,
      reason: "${tag} is folded: the changelog tops at v${version} and the workspace carries "
        + workspace,
    }
  }
  let missing: list<string> = []
  if changelog_owed {
    missing = missing
      + ["the changelog tops at v${changelog_top} rather than v${version}"]
  }
  if workspace_owed {
    missing = missing + ["the workspace carries ${workspace} rather than ${development}"]
  }
  return {
    tag: tag,
    version: version,
    development_version: development,
    changelog_owed: changelog_owed,
    workspace_owed: workspace_owed,
    owed: true,
    reason: "${tag} published but is not folded: " + join(missing, ", "),
  }
}

/**
 * The branch the post-publication cutover pull request uses.
 *
 * Not a name this repair invented. The release repository's own cutover script
 * opens its pull request on exactly this branch and refuses when one is already
 * open on it. A repair that chose a different name would be invisible to that
 * check and it to this one, so a release whose cutover was merely slow would
 * end up with two branches both claiming to advance the same version.
 *
 * Keyed on the development version, which is what the branch advances to, not
 * on the published version. `automation/development-0.10.134-dev` follows the
 * v0.10.133 release.
 */
pub fn release_cutover_branch(development_version: string) -> string {
  return "automation/development-" + trim(development_version)
}

/**
 * The title the post-publication cutover pull request carries.
 *
 * Copied from the release repository's cutover script for the same reason as
 * the branch: two openers of the same pull request must be recognisable to a
 * person reading the list as one thing, not two.
 */
pub fn release_cutover_title(development_version: string) -> string {
  return "[Release] Start ${trim(development_version)} development"
}

/**
 * Whether an existing pull request is the cutover this repair would open.
 *
 * Matched on the branch rather than the title, because the branch is what both
 * openers key on and a title can be edited by anyone who touches the pull
 * request.
 */
pub fn release_cutover_pr_is_ours(head_ref: string, development_version: string) -> bool {
  return trim(head_ref) == release_cutover_branch(development_version)
}

/**
 * The pull request a cutover repair would open, named before anything opens it.
 *
 * This repair opens the pull request rather than dispatching the job that
 * normally opens it. That is not the cheaper choice, it is the only available
 * one: the job lives inside the release-binary workflow, whose dispatch inputs
 * rebuild and re-publish a release. Dispatching it to obtain a version bump
 * would perform an effect far larger than the one being repaired.
 */
pub type ReleaseCutoverPullRequest = {
  repository: string,
  base: string,
  head: string,
  title: string,
  /** The state this pull request is meant to produce. */
  owed: ReleaseFoldOwed,
  /**
   * What this pull request does not fix, or "" when it fixes everything owed.
   *
   * The cutover advances the workspace version and nothing else. When the
   * changelog is also owed, that half is folded by the release pull request
   * before the tag and cannot be recovered here. Saying so is the point: a
   * repair that reported success while half the cause survived would send the
   * next reader looking in the wrong repository.
   */
  unrepaired: string,
  reason: string,
}

/** Where the cutover pull request is opened, as one shape rather than two strings. */
pub type ReleaseCutoverTarget = {repository: string, base: string}

/** Why a cutover repair is not opening a pull request, when it is not. */
pub type ReleaseFoldRefusal = {
  /** `no_release`, `nothing_owed`, `already_open`, or `not_repairable_here`. */
  code: string,
  reason: string,
  /** The pull request already doing this work, when that is the reason. */
  existing_pr: string,
}

pub type ReleaseFoldRepairDecision = {
  schema_version: "harn_bump_fleet.release_fold_repair.v1",
  pull_request: ReleaseCutoverPullRequest?,
  refusal: ReleaseFoldRefusal?,
}

/**
 * Decide whether to open the cutover pull request, and say why when not.
 *
 * `existing_cutover_pr` is the pull request already doing this work, or "" when
 * the caller looked and found none. Looking is the caller's job because it is a
 * read; deciding is this function's, so the find-before-open rule has one owner
 * rather than being re-implemented by each caller who remembers it.
 *
 * A refusal is a value here, not an absence. A caller that receives neither a
 * pull request nor a refusal has found a defect, not a quiet success.
 */
pub fn release_fold_repair_decision(
  owed: ReleaseFoldOwed,
  target: ReleaseCutoverTarget,
  existing_cutover_pr: string,
) -> ReleaseFoldRepairDecision {
  if trim(owed.version) == "" {
    return {
      schema_version: "harn_bump_fleet.release_fold_repair.v1",
      pull_request: nil,
      refusal: {code: "no_release", reason: owed.reason, existing_pr: ""},
    }
  }
  if !owed.owed {
    return {
      schema_version: "harn_bump_fleet.release_fold_repair.v1",
      pull_request: nil,
      refusal: {code: "nothing_owed", reason: owed.reason, existing_pr: ""},
    }
  }
  if !owed.workspace_owed {
    // The changelog is owed and the workspace is not. The cutover pull request
    // touches only the workspace version, so opening one here would produce an
    // empty change and leave the real cause standing.
    return {
      schema_version: "harn_bump_fleet.release_fold_repair.v1",
      pull_request: nil,
      refusal: {
        code: "not_repairable_here",
        reason: "${owed.tag} is owed only its changelog section, which the release pull "
          + "request folds before the tag; the post-publication cutover does not write it",
        existing_pr: "",
      },
    }
  }
  if trim(existing_cutover_pr) != "" {
    return {
      schema_version: "harn_bump_fleet.release_fold_repair.v1",
      pull_request: nil,
      refusal: {
        code: "already_open",
        reason: "${owed.tag} is already being cut over by ${trim(existing_cutover_pr)}; a "
          + "second pull request would open a second branch claiming the same version",
        existing_pr: trim(existing_cutover_pr),
      },
    }
  }
  const unrepaired =
    owed.changelog_owed ? "the changelog still tops below v${owed.version}; that half is folded by the release "
    + "pull request before the tag and is not this repair's to write" : ""
  return {
    schema_version: "harn_bump_fleet.release_fold_repair.v1",
    pull_request: {
      repository: trim(target.repository),
      base: trim(target.base),
      head: release_cutover_branch(owed.development_version),
      title: release_cutover_title(owed.development_version),
      owed: owed,
      unrepaired: unrepaired,
      reason: owed.reason,
    },
    refusal: nil,
  }
}
