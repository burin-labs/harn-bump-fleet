import { release_run_dir } from "./release_paths"

pub type ReleaseRunEvent = {
  schema_version: string,
  event_type: string,
  data: dict,
  timestamp?: string,
}

pub type FailedReleaseWorkspaceAuthorization = {
  authorized: bool,
  reason: string,
  run_id: string,
  workspace: string,
  branch: string,
  pin_sha: string,
}

fn denied(
  workspace: string,
  branch: string,
  reason: string,
) -> FailedReleaseWorkspaceAuthorization {
  return {
    authorized: false,
    reason: reason,
    run_id: "",
    workspace: workspace,
    branch: branch,
    pin_sha: "",
  }
}

fn release_workspace_run_id(workspace: string) -> string {
  const leaf = basename(trim(workspace))
  const prefix = "release-"
  if !starts_with(leaf, prefix) {
    return ""
  }
  const run_id = leaf.substring(len(prefix))
  if len(regex_captures("^[A-Za-z0-9][A-Za-z0-9._-]*$", run_id)) == 0 {
    return ""
  }
  return run_id
}

fn parse_release_run_events(fs: HarnessFs, path: string) -> list<ReleaseRunEvent> {
  let events: list<ReleaseRunEvent> = []
  for line in split(fs.read_text(path), "\n") {
    if trim(line) == "" {
      continue
    }
    const event: ReleaseRunEvent = json_parse(line)
    if event.schema_version != "release_harn.run_event.v1" {
      throw "unsupported release run event schema '${event.schema_version}'"
    }
    events = events + [event]
  }
  return events
}

/**
 * Authorize detaching one dirty failed-release workspace from its local branch.
 *
 * The durable run stream must name the exact workspace at creation and terminal
 * preservation, end unsuccessfully, and contain no immutable publication. Git
 * probes separately enforce no open PR and no unique local commit.
 */
pub fn failed_release_workspace_authorization(
  fs: HarnessFs,
  workspace: string,
  branch: string,
) -> FailedReleaseWorkspaceAuthorization {
  const normalized_workspace = trim(workspace)
  const normalized_branch = trim(branch)
  const run_id = release_workspace_run_id(normalized_workspace)
  if run_id == "" {
    return denied(normalized_workspace, normalized_branch, "workspace is not harness-owned")
  }
  const events_path = path_join(release_run_dir(fs, run_id), "run-events.jsonl")
  if !fs.exists(events_path) {
    return denied(normalized_workspace, normalized_branch, "durable release run events are missing")
  }
  let events: list<ReleaseRunEvent> = []
  try {
    events = parse_release_run_events(fs, events_path)
  } catch (error) {
    return denied(
      normalized_workspace,
      normalized_branch,
      "durable release run events are invalid: ${to_string(error)}",
    )
  }
  let created = false
  let preserved = false
  let failed = false
  let publication_started = false
  let pin_sha = ""
  for event in events {
    if event.event_type == "release_workspace_created"
      && trim(to_string(event.data.workspace ?? ""))
        == normalized_workspace {
      created = true
      pin_sha = lowercase(trim(to_string(event.data.pin_sha ?? "")))
    }
    if event.event_type == "release_workspace_preserved"
      && trim(to_string(event.data.path ?? ""))
        == normalized_workspace
      && trim(to_string(event.data.branch ?? ""))
        == normalized_branch
      && (event.data.preserved ?? false) {
      preserved = true
    }
    if event.event_type == "run_finished" && !(event.data.success ?? true) {
      failed = true
    }
    if event.event_type == "immutable_publication_started"
      || event.event_type
        == "pre_tag_checkpoint_resumed"
      || event.event_type
        == "tagged_fixup_pr_adopted"
      || event.event_type
        == "release_watch_receipt_written" {
      publication_started = true
    }
  }
  if !created || len(regex_captures("^[0-9a-f]{40}$", pin_sha)) == 0 {
    return denied(normalized_workspace, normalized_branch, "workspace creation receipt is missing")
  }
  if !preserved {
    return denied(
      normalized_workspace,
      normalized_branch,
      "workspace preservation receipt is missing",
    )
  }
  if !failed {
    return denied(normalized_workspace, normalized_branch, "release run did not fail terminally")
  }
  if publication_started {
    return denied(normalized_workspace, normalized_branch, "release publication already started")
  }
  return {
    authorized: true,
    reason: "failed pre-publication release workspace is durably owned and preserved",
    run_id: run_id,
    workspace: normalized_workspace,
    branch: normalized_branch,
    pin_sha: pin_sha,
  }
}
