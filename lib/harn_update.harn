import { harn_pin_decision } from "./bump_decision"

pub type HarnUpdateRuntimeProvenance = {
  harn_version: string,
  controller_revision: string,
  repair_contract_revision: string,
}

/** The only host facts preparation needs to bind an updater to its runtime. */
pub type HarnUpdateRuntimeCapabilities = {runtime: HarnessRuntime, controller_revision: string}

pub type HarnUpdateRuntimeReadiness = {
  ready: bool,
  reason: string,
  provenance: HarnUpdateRuntimeProvenance,
}

pub type HarnUpdateBudgetPolicy = {
  max_rounds: int,
  max_attempts_per_repository: int,
  max_tokens_per_attempt: int,
  max_cost_per_attempt_usd: float,
  max_cost_per_repository_usd: float,
  max_cost_per_run_usd: float,
}

pub type HarnUpdatePullRequestProof = {
  number: int,
  url: string,
  state: string,
  head_sha: string,
  head_pin: string,
  check_state: string,
  checks_head_sha: string,
  merge_commit_sha: string,
  merge_reachable_from_default_branch: bool,
}

pub type HarnUpdateProofFacts = {
  repository: string,
  target: string,
  default_branch_pin?: string,
  default_branch_head_sha?: string,
  pull_request?: HarnUpdatePullRequestProof,
}

pub type HarnUpdateProof = {
  ok: bool,
  reason: string,
  repository: string,
  target: string,
  default_branch_pin?: string,
  default_branch_head_sha?: string,
  pull_request_number?: int,
  pull_request_url?: string,
  checked_head_sha?: string,
  merge_commit_sha?: string,
}

pub type HarnUpdateBudgetDecision = {allowed: bool, reason: string, attempt_limit_usd: float}

pub type HarnUpdateRoute = {tier: "value" | "strong", config_prefix: string, reason: string}

/** A bounded handoff into a fresh credential period when CI still needs time. */
pub type HarnUpdateContinuation = {continue: bool, reason: string, next_round?: int}

pub type HarnUpdateUsage = {
  provider: string,
  model: string,
  tokens_used: int,
  cost_status: "exact" | "lower_bound" | "unknown",
  cost_usd?: float?,
  known_cost_usd: float,
  unpriced_calls: int,
  usage_unknown_calls: int,
}

/** Record the executable and controller identity that prepared this update run. */
pub fn harn_update_runtime_provenance(
  capabilities: HarnUpdateRuntimeCapabilities,
  repair_contract_revision: string,
) -> HarnUpdateRuntimeProvenance {
  const snapshot = capabilities.runtime.introspection()
  const controller_revision = trim(capabilities.controller_revision)
  return {
    harn_version: trim(to_string(snapshot?.harn_version ?? "")),
    controller_revision: if controller_revision == "" {
      "local"
    } else {
      controller_revision
    },
    repair_contract_revision: trim(repair_contract_revision),
  }
}

/** Refuse a fleet repair before any model call when its Harn runtime is stale. */
pub fn harn_update_runtime_readiness(
  target: string,
  provenance: HarnUpdateRuntimeProvenance,
) -> HarnUpdateRuntimeReadiness {
  if provenance.harn_version == "" {
    return {ready: false, reason: "runtime_version_missing", provenance: provenance}
  }
  if provenance.repair_contract_revision == "" {
    return {ready: false, reason: "repair_contract_revision_missing", provenance: provenance}
  }
  const version = harn_pin_decision(provenance.harn_version, target)
  if !version.ok || version.relation != "equal" {
    return {ready: false, reason: "runtime_version_does_not_match_target", provenance: provenance}
  }
  return {ready: true, reason: "runtime_contract_ready", provenance: provenance}
}

fn failed_proof(facts: HarnUpdateProofFacts, reason: string) -> HarnUpdateProof {
  let proof: HarnUpdateProof = {
    ok: false,
    reason: reason,
    repository: facts.repository,
    target: facts.target,
  }
  if facts.default_branch_pin != nil {
    proof.default_branch_pin = facts.default_branch_pin ?? ""
  }
  if facts.default_branch_head_sha != nil {
    proof.default_branch_head_sha = facts.default_branch_head_sha ?? ""
  }
  if facts.pull_request != nil {
    proof.pull_request_number = facts.pull_request.number
    proof.pull_request_url = facts.pull_request.url
    proof.checked_head_sha = facts.pull_request.checks_head_sha
    proof.merge_commit_sha = facts.pull_request.merge_commit_sha
  }
  return proof
}

/** Require pin, exact green PR head, merge identity, and default-branch reachability together. */
pub fn harn_update_proof(facts: HarnUpdateProofFacts) -> HarnUpdateProof {
  const main = if trim(facts.default_branch_pin ?? "") == "" {
    nil
  } else {
    harn_pin_decision(facts.default_branch_pin ?? "", facts.target)
  }
  if main == nil || !main.ok || !main.satisfies_target {
    return failed_proof(facts, "default_branch_not_updated")
  }
  const pr = facts.pull_request
  if pr == nil {
    return failed_proof(facts, "missing_update_pull_request_lineage")
  }
  const head = harn_pin_decision(pr.head_pin, facts.target)
  if !head.ok || !head.satisfies_target {
    return failed_proof(facts, "update_pull_request_does_not_contain_target")
  }
  if lowercase(pr.state) != "merged" {
    return failed_proof(facts, "update_pull_request_not_merged")
  }
  if lowercase(pr.check_state) != "green" {
    return failed_proof(facts, "update_pull_request_checks_not_green")
  }
  if trim(pr.head_sha) == "" || lowercase(pr.head_sha) != lowercase(pr.checks_head_sha) {
    return failed_proof(facts, "checks_do_not_match_update_head")
  }
  if trim(pr.merge_commit_sha) == "" {
    return failed_proof(facts, "missing_merge_commit")
  }
  if !pr.merge_reachable_from_default_branch {
    return failed_proof(facts, "merge_not_on_default_branch")
  }
  let proof = failed_proof(facts, "proven")
  proof.ok = true
  proof.reason = "exact_green_update_merged_to_default_branch"
  return proof
}

/** Decide whether one more attempt fits both the repository and outer run envelopes. */
pub fn harn_update_budget_decision(
  policy: HarnUpdateBudgetPolicy,
  attempts_used: int,
  repository_cost_usd: float,
  run_cost_usd: float,
) -> HarnUpdateBudgetDecision {
  if attempts_used >= policy.max_attempts_per_repository {
    return {allowed: false, reason: "repository_attempt_limit_reached", attempt_limit_usd: 0.0}
  }
  const repository_remaining = policy.max_cost_per_repository_usd - repository_cost_usd
  if repository_remaining <= 0.0 {
    return {allowed: false, reason: "repository_cost_limit_reached", attempt_limit_usd: 0.0}
  }
  const run_remaining = policy.max_cost_per_run_usd - run_cost_usd
  if run_remaining <= 0.0 {
    return {allowed: false, reason: "run_cost_limit_reached", attempt_limit_usd: 0.0}
  }
  return {
    allowed: true,
    reason: "within_budget",
    attempt_limit_usd: min(
      policy.max_cost_per_attempt_usd,
      min(repository_remaining, run_remaining),
    ),
  }
}

/** Keep the value route until repeated evidence shows no progress. */
pub fn harn_update_route(attempt: int, evidence: string, no_progress: bool) -> HarnUpdateRoute {
  if attempt > 1 && no_progress && evidence == "same_validation_failure" {
    return {
      tier: "strong",
      config_prefix: "HARN_UPDATE_STRONG",
      reason: "same_failure_after_value_attempt",
    }
  }
  return {tier: "value", config_prefix: "HARN_UPDATE_VALUE", reason: "lowest_sufficient_route"}
}

/** Decide whether a failed proof receives one fresh, bounded hosted round. */
pub fn harn_update_continuation(
  current_round: int,
  max_rounds: int,
  proof_ok: bool,
  repair_enabled: bool,
) -> HarnUpdateContinuation {
  if proof_ok {
    return {continue: false, reason: "update_proven"}
  }
  if !repair_enabled {
    return {continue: false, reason: "repair_disabled"}
  }
  if current_round < 1 || max_rounds < 1 || current_round >= max_rounds {
    return {continue: false, reason: "repair_round_limit_reached"}
  }
  return {continue: true, reason: "fresh_hosted_round_required", next_round: current_round + 1}
}

/** Read the single completion fact from an externally persisted proof receipt. */
pub fn harn_update_proof_receipt_complete(receipt: dict) -> bool {
  return receipt.get("complete") ?? false
}

/**
 * Read the completion fact from a receipt file, treating an unreadable one as
 * proving nothing.
 *
 * An absent, empty, or malformed receipt is the state this decision exists to
 * handle: the proof step aborted, so no repository was proven and a successor
 * round is owed. Refusing to read it took the successor down with the proof and
 * stopped a whole convergence chain. The reason is named on stderr so an
 * unreadable receipt is never mistaken for a clean incomplete round.
 */
pub fn harn_update_proof_receipt_complete_at(
  io: {fs: HarnessFs, stdio: HarnessStdio},
  path: string,
) -> bool {
  const decoded = try {
    unwrap(json_parse(io.fs.read_text(path)))
  } catch (error) {
    io.stdio.eprintln(
      "update proof receipt '${path}' is absent or unreadable, so this round proved nothing: "
        + to_string(error),
    )
    return false
  }
  return harn_update_proof_receipt_complete(decoded)
}

/** Project the runtime-owned accounting fields without turning unknown cost into zero. */
pub fn harn_update_usage(provider: string, model: string, result: dict) -> HarnUpdateUsage {
  const exact = result?.cost_usd
  const unpriced = to_int(result?.unpriced_calls ?? 0) ?? 0
  const unknown = to_int(result?.usage_unknown_calls ?? 0) ?? 0
  const provider_error = lowercase(trim(to_string(result?.status ?? ""))) == "provider_error"
  return {
    provider: provider,
    model: model,
    tokens_used: to_int(result?.tokens_used ?? 0) ?? 0,
    cost_status: if exact != nil && unpriced == 0 && unknown == 0 && !provider_error {
      "exact"
    } else if (to_float(result?.known_cost_usd ?? 0.0) ?? 0.0) > 0.0 {
      "lower_bound"
    } else {
      "unknown"
    },
    cost_usd: to_float(exact),
    known_cost_usd: to_float(result?.known_cost_usd ?? 0.0) ?? 0.0,
    unpriced_calls: unpriced,
    usage_unknown_calls: unknown,
  }
}
