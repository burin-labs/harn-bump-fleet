// One fleet update chain per Harn version, and a way to tell a live holder
// from an abandoned one.
//
// The existing lease is `harn-update-chain/<chain id>`, claimed by a round
// that dispatches a successor and released by a round that does not. It keeps
// one chain's rounds in order. It cannot keep two chains apart, because two
// chains have two different chain ids and therefore two different refs, and
// nothing in the name says which Harn version either one is updating.
//
// Measured on 2026-09-22: chains 35712201495 and 35585351929 both targeted
// v0.10.140 and ran rounds 2, 3 and 4 within minutes of each other, at
// 10:14/10:18, 10:46/10:45 and 11:12/11:02 UTC. Each round reads and writes
// across every fleet repository with the release app's token, so the second
// chain doubled the spend on a budget that was already the binding constraint,
// and the two chains' proof reads raced each other's writes.
//
// So the lease is keyed by what actually must not be done twice: the version.
// The chain id rides in the ref name rather than in its object, because the
// refusal has to be able to say who is holding it, and a caller that has to
// resolve an opaque object id to learn that has already lost the thread.
import { ChainRefRun } from "./chain_ref_reap"

/** Where a version's holder is recorded. */
pub const VERSION_LEASE_PREFIX = "refs/heads/harn-update-version"

const VERSION_PATTERN = "^v[0-9]+\\.[0-9]+\\.[0-9]+$"

const VERSION_LEASE_PATTERN =
  "^refs/heads/harn-update-version/(v[0-9]+\\.[0-9]+\\.[0-9]+)/([1-9][0-9]*)$"

fn normalized_version(version: string) -> string {
  const normalized = lowercase(trim(version))
  if len(regex_captures(VERSION_PATTERN, normalized)) == 0 {
    throw "fleet version lease requires an exact vX.Y.Z Harn tag"
  }
  return normalized
}

fn normalized_chain_id(chain_id: string) -> string {
  const normalized = trim(chain_id)
  if len(regex_captures("^[1-9][0-9]*$", normalized)) == 0 {
    throw "fleet version lease requires a positive numeric chain ID"
  }
  return normalized
}

/** The ref one chain claims to hold one version. */
pub fn fleet_version_lease_ref(version: string, chain_id: string) -> string {
  return VERSION_LEASE_PREFIX + "/" + normalized_version(version) + "/"
    + normalized_chain_id(chain_id)
}

/** Everything under one version, for the inventory read. */
pub fn fleet_version_lease_glob(version: string) -> string {
  return VERSION_LEASE_PREFIX + "/" + normalized_version(version) + "/*"
}

/** The version and chain a lease ref names, or nothing when it names neither. */
pub fn fleet_version_lease_identity(ref: string) -> {version: string, chain_id: string}? {
  const matched = regex_captures(VERSION_LEASE_PATTERN, trim(ref))
  if len(matched) != 1 {
    return nil
  }
  return {version: matched[0].groups[0], chain_id: matched[0].groups[1]}
}

/**
 * One chain that may be holding the version, and what could be read about it.
 *
 * `runs_readable` is separate from `runs_examined` deliberately. A chain whose
 * runs could not be read and a chain with no runs left in retention are
 * different facts, and only one of them is safe to treat as finished. A read
 * that failed must never free a lease.
 */
pub type FleetVersionLeaseHolder = {
  chain_id: string,
  ref: string,
  oid: string,
  runs_readable: bool,
  runs_examined: int,
  runs_unfinished: int,
  read_error?: string,
}

/** What this round should do about the version it was asked to update. */
pub type FleetVersionLeaseAction = "proceed" | "refuse" | "reclaim_then_proceed"

/**
 * The decision, with the sentence the run summary and the refusal both use.
 *
 * `holder_chain_id` is the single most useful field in a refusal: it turns
 * "something else is running" into a run someone can open.
 */
pub type FleetVersionLeaseDecision = {
  action: FleetVersionLeaseAction,
  reason: string,
  summary: string,
  holder_chain_id: string,
  blocking: list<string>,
  reclaimable: list<string>,
}

/** A chain's run is finished only when it says so; queued and running are not. */
pub fn fleet_version_lease_run_unfinished(run: ChainRefRun) -> bool {
  const status = lowercase(trim(run.status))
  if status == "completed" {
    return false
  }
  // An unknown status is not a finished one. A status this does not recognize
  // is a reason to keep the lease, never to take it.
  return true
}

/** Count what was read about one chain into the shape the decision consumes. */
pub fn fleet_version_lease_holder(
  named: {chain_id: string, ref: string, oid: string},
  runs: list<ChainRefRun>,
) -> FleetVersionLeaseHolder {
  let unfinished = 0
  for run in runs {
    if fleet_version_lease_run_unfinished(run) {
      unfinished = unfinished + 1
    }
  }
  return {
    chain_id: named.chain_id,
    ref: named.ref,
    oid: named.oid,
    runs_readable: true,
    runs_examined: len(runs),
    runs_unfinished: unfinished,
  }
}

/** A chain whose runs could not be read at all, which is not a free lease. */
pub fn fleet_version_lease_unreadable_holder(
  named: {chain_id: string, ref: string, oid: string},
  read_error: string,
) -> FleetVersionLeaseHolder {
  return {
    chain_id: named.chain_id,
    ref: named.ref,
    oid: named.oid,
    runs_readable: false,
    runs_examined: 0,
    runs_unfinished: 0,
    read_error: read_error,
  }
}

fn names(holders: list<FleetVersionLeaseHolder>) -> list<string> {
  return holders.map({ holder -> holder.chain_id }).to_list()
}

/**
 * Decide whether this round may update this version.
 *
 * A round after the first is never blocked. It belongs to a chain that already
 * holds the lease, and a later round that refused on its own predecessor's
 * lease would stop every chain at round two, which is the failure mode of a
 * lock that does not know who is asking.
 *
 * A holder that cannot be proved finished blocks. A holder that is proved
 * finished, or whose runs have aged out of retention entirely, is stale and is
 * reclaimed by name; the reclaim is reported because a lease that disappears
 * silently is indistinguishable from one that was never taken, and the next
 * person to debug a doubled chain needs to know which happened.
 */
pub fn fleet_version_lease_decision(
  chain_id: string,
  update_round: int,
  holders: list<FleetVersionLeaseHolder>,
) -> FleetVersionLeaseDecision {
  const mine = normalized_chain_id(chain_id)
  if update_round > 1 {
    return {
      action: "proceed",
      reason: "successor_round_of_an_existing_chain",
      summary:
        "round ${to_string(update_round)} belongs to chain ${mine}, which already holds this version",
      holder_chain_id: mine,
      blocking: [],
      reclaimable: [],
    }
  }
  let unreadable: list<FleetVersionLeaseHolder> = []
  let live: list<FleetVersionLeaseHolder> = []
  let stale: list<FleetVersionLeaseHolder> = []
  for holder in holders {
    if holder.chain_id == mine {
      continue
    }
    if !holder.runs_readable {
      unreadable = unreadable + [holder]
    } else if holder.runs_unfinished > 0 {
      live = live + [holder]
    } else {
      stale = stale + [holder]
    }
  }
  if len(unreadable) > 0 {
    return {
      action: "refuse",
      reason: "holder_liveness_unreadable",
      summary:
        "this version is held by chain ${unreadable[0]?.chain_id ?? ""} and its runs could not be read, so whether it is still going is unknown; refusing rather than starting a second chain on a failed read",
      holder_chain_id: unreadable[0]?.chain_id ?? "",
      blocking: names(unreadable),
      reclaimable: [],
    }
  }
  if len(live) > 0 {
    return {
      action: "refuse",
      reason: "version_held_by_a_live_chain",
      summary:
        "this version is already being updated by chain ${live[0]?.chain_id ?? ""}, which still has ${to_string(live[0]?.runs_unfinished ?? 0)} unfinished round(s); this round schedules nothing",
      holder_chain_id: live[0]?.chain_id ?? "",
      blocking: names(live),
      reclaimable: [],
    }
  }
  if len(stale) > 0 {
    return {
      action: "reclaim_then_proceed",
      reason: "stale_holder_reclaimed",
      summary:
        "reclaiming this version from chain(s) ${names(stale).join(", ")}, whose runs are all finished or no longer exist; chain ${mine} takes the lease",
      holder_chain_id: mine,
      blocking: [],
      reclaimable: names(stale),
    }
  }
  return {
    action: "proceed",
    reason: "version_unheld",
    summary: "no other chain holds this version; chain ${mine} takes the lease",
    holder_chain_id: mine,
    blocking: [],
    reclaimable: [],
  }
}

/** Remote inventory, per-chain run reads, the exact-OID delete, and the claim. */
pub type FleetVersionLeaseAdapter = {
  refs: fn(string) -> list<{ref: string, oid: string}>,
  runs: fn(string) -> list<ChainRefRun>,
  clear: fn(string, string) -> nil,
  claim: fn(string, string) -> nil,
}

/** What the round did about the lease, for the receipt and the run summary. */
pub type FleetVersionLeaseReceipt = {
  schema_version: "harn_bump_fleet.fleet_version_lease.v1",
  version: string,
  chain_id: string,
  update_round: int,
  decision: FleetVersionLeaseDecision,
  holders: list<FleetVersionLeaseHolder>,
  cleared: list<string>,
  claimed: bool,
  inventory: "read" | "unreadable",
  inventory_failure?: string,
}

/**
 * Read the version's holders, decide, and take the lease when it is free.
 *
 * An inventory that could not be read refuses. A lease whose holders are
 * unknown is not a lease that is free, and the whole cost of being wrong here
 * is a second chain spending a shared API budget the first one is already
 * spending.
 */
pub fn claim_fleet_version_lease_with_adapter(
  version: string,
  chain_id: string,
  update_round: int,
  adapter: FleetVersionLeaseAdapter,
) -> FleetVersionLeaseReceipt {
  const base = {
    schema_version: "harn_bump_fleet.fleet_version_lease.v1",
    version: normalized_version(version),
    chain_id: normalized_chain_id(chain_id),
    update_round: update_round,
  }
  if update_round > 1 {
    return base
      + {
        decision: fleet_version_lease_decision(chain_id, update_round, []),
        holders: [],
        cleared: [],
        claimed: false,
        inventory: "read",
      }
  }
  const listed = try {
    adapter.refs(fleet_version_lease_glob(version))
  } catch (error) {
    return base
      + {
        decision: {
          action: "refuse",
          reason: "version_lease_inventory_unreadable",
          summary:
            "the version lease inventory could not be read, so whether another chain holds this version is unknown; refusing rather than starting a second chain on a failed read",
          holder_chain_id: "",
          blocking: [],
          reclaimable: [],
        },
        holders: [],
        cleared: [],
        claimed: false,
        inventory: "unreadable",
        inventory_failure: to_string(error),
      }
  }
  let holders: list<FleetVersionLeaseHolder> = []
  for row in listed {
    const identity = fleet_version_lease_identity(row.ref)
    if identity == nil {
      continue
    }
    const named = {
      chain_id: unwrap(identity).chain_id,
      ref: trim(row.ref),
      oid: lowercase(trim(row.oid)),
    }
    const runs = try {
      adapter.runs(named.chain_id)
    } catch (error) {
      holders = holders + [fleet_version_lease_unreadable_holder(named, to_string(error))]
      continue
    }
    holders = holders + [fleet_version_lease_holder(named, runs)]
  }
  const decision = fleet_version_lease_decision(chain_id, update_round, holders)
  if decision.action == "refuse" {
    return base
      + {decision: decision, holders: holders, cleared: [], claimed: false, inventory: "read"}
  }
  let cleared: list<string> = []
  for holder in holders {
    if !decision.reclaimable.contains(holder.chain_id) {
      continue
    }
    adapter.clear(holder.ref, holder.oid)
    cleared = cleared + [holder.chain_id]
  }
  adapter.claim(fleet_version_lease_ref(version, chain_id), chain_id)
  return base
    + {decision: decision, holders: holders, cleared: cleared, claimed: true, inventory: "read"}
}
