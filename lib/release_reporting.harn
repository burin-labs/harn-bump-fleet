pub type ReleasePrAutoMergeResult = {steps: list<dict>, success: bool, pr_url: string}

pub type ReleaseRecoveryNoteReportInput = {
  scope: ReleaseNotesScope,
  version: string,
  base: string,
  artifact_bullet_count: int,
  artifact_source: string,
  current_unreleased_bullet_count: int,
}

pub type ReleaseRecoveryNoteReport = {artifact_line: string?, notes_line: string, plan: string}

/** Render recovery-note facts from the same typed policy that mutates them. */
pub fn release_recovery_note_report(
  input: ReleaseRecoveryNoteReportInput,
) -> ReleaseRecoveryNoteReport {
  if input.scope == "immutable_checkpoint" {
    return {
      artifact_line:
        "v${input.version}: ${input.artifact_bullet_count} checkpoint release-note entries from ${input.artifact_source}",
      notes_line:
        "the immutable pre-tag candidate is reused byte-for-byte; current notes and fragments are not folded",
      plan:
        "re-verify the signed commit, immutable ref, certified parent, exact-SHA size gate, and cutoff; then publish the tag and create the PR without rebuilding the release commit.",
    }
  }
  if input.scope == "candidate_tree" {
    return {
      artifact_line: nil,
      notes_line:
        "${input.current_unreleased_bullet_count} current ## Unreleased entries on ${input.base}; current ## Unreleased entries and tracked changelog.d fragments are folded into the fresh candidate",
      plan:
        "recreate the local release workspace on fresh ${input.base}, fold its current notes into v${input.version}, version bump, publish a new immutable attempt, and refresh the PR handoff.",
    }
  }
  return {
    artifact_line:
      "v${input.version}: ${input.artifact_bullet_count} recovered release-note entries from ${input.artifact_source}",
    notes_line:
      "${input.current_unreleased_bullet_count} current ## Unreleased entries on ${input.base}; post-pin bullets stay in ## Unreleased for the next release",
    plan:
      "recreate the local release workspace on fresh ${input.base}, preserve the frozen artifact notes in v${input.version}, version bump, and refresh the PR handoff without moving the tag.",
  }
}

fn execution_status_summary(execution: list<dict>) -> string {
  let ok = 0
  let failed = 0
  for step in execution {
    if step.success {
      ok = ok + 1
    } else {
      failed = failed + 1
    }
  }
  if failed == 0 {
    return "all ok"
  }
  return "${ok} ok, ${failed} failed"
}

fn fixup_changelog_block(analysis: ReleaseAnalysis) -> string {
  const promoted = trim(markdown_multiline(analysis.changelog_section))
  const unreleased = trim(markdown_multiline(analysis.changelog_unreleased_section))
  let parts = [
    "**v${analysis.next_version}** (promoted from pin-time `## Unreleased`):",
    "",
    "```markdown",
    "## v${analysis.next_version}",
    "",
    promoted,
    "```",
  ]
  if unreleased != "" {
    parts = parts
      + [
      "",
      "**Held in `## Unreleased`** (post-pin drift on `${analysis.base_branch}` — describes work landing AFTER this release):",
      "",
      "```markdown",
      "## Unreleased",
      "",
      unreleased,
      "```",
    ]
  } else {
    parts = parts + ["", "_No `## Unreleased` drift since the original pin._"]
  }
  return parts.join("\n")
}

fn standard_changelog_block(analysis: ReleaseAnalysis) -> string {
  const body = trim(markdown_multiline(analysis.changelog_section))
  return "```markdown\n## v${analysis.next_version}\n\n${body}\n```"
}

fn platform_certification_pr_block(execution: list<dict>) -> string {
  const candidate = execution.find({ step -> step.candidate_certification_timing != nil })
  for step in execution {
    if step.platform_certification_receipt != nil {
      const receipt = step.platform_certification_receipt
      const join_duration = timing_duration_label(platform_certification_duration_ms(receipt.join))
      let lines = [
        "## Hosted platform certification",
        "",
        "- **Source:** `${receipt.source.repo}@${receipt.source.sha}`",
        "- **Branch freeze:** `${receipt.source.branch}` remained `${receipt.source.remote_sha_after}`",
        "- **Local source lanes:** `${receipt.local_source.lane_names.join(", ")}`",
        "- **Critical path:** `${receipt.join.critical_path}` (${join_duration})",
        "- **Warm proof:** `${receipt.warm.command}` -> `${receipt.warm.binary_sha256}`",
        "- **Receipt:** `${step.platform_certification_receipt_path}`",
      ]
      if candidate != nil {
        const timing = candidate.candidate_certification_timing
        const duration = timing_duration_label(timing.duration_ms)
        lines = lines
          + [
          "- **Candidate fan-out:** `${timing.critical_path}` (${duration}); hosted/local and Linux size lanes overlapped",
        ]
      }
      lines = lines
        + [
        "",
        "| Platform | Workflow | Run | Required job | Duration |",
        "|----------|----------|-----|--------------|----------|",
      ]
      for proof in receipt.platforms {
        const required = proof.jobs.jobs.find({ job -> job.name == proof.required_job })
        const duration = timing_duration_label(platform_certification_duration_ms(proof))
        lines = lines
          + [
          "| `${proof.platform}` | `${proof.workflow_path}` | [${proof.run.id}](${proof.run.url}) | [${proof.required_job}](${required?.url ?? proof.run.url}) | ${duration} |",
        ]
      }
      return lines.join("\n")
    }
  }
  return ""
}

fn pr_body_text_with_changelog_block(
  analysis: ReleaseAnalysis,
  agent_review_result: ReleaseAgentReviewResult,
  execution: list<dict>,
  run_id: string,
  changelog_block: string,
  publication: ReleasePublication? = nil,
) -> string {
  const agent_artifacts = agent_review_result.artifacts
  const draft_path = agent_review_result.draft_changelog ?? ""
  const validation = agent_review_result.validation_findings
  const execution_summary = execution_table(execution)
  const pin_sha_note = if trim(analysis.pin_sha_input) == "" {
    "(`origin/${analysis.base_branch}` at run start)"
  } else {
    "(`--at-sha ${analysis.pin_sha_input}`)"
  }
  const publication_ref = trim(publication?.remote_ref ?? "")
  const local_branch = trim(publication?.local_branch ?? "")
  const branch = if publication_ref == "" {
    analysis.branch
  } else {
    publication_ref
  }
  const recovery_source = if analysis.pre_tag_supersede ?? false {
    "a superseded bare immutable pre-tag checkpoint"
  } else if trim(analysis.fixup_pr_url ?? "") == "" {
    "the published tag left by a crash before PR creation"
  } else {
    "existing release PR `${analysis.fixup_pr_url}`"
  }
  const fixup_note = if analysis.fixup_mode ?? false {
    if analysis.release_notes_scope == "candidate_tree" {
      "\n\n> **Fresh-candidate recovery from ${recovery_source}.** Proved the immutable checkpoint OID, recreated the branch on fresh `${analysis.base_branch}`, and folded that tree's complete current notes into v${analysis.next_version}. Prior remote attempts remain immutable; auto-merge is left disabled for operator review."
    } else {
      "\n\n> **Frozen-artifact repair from ${recovery_source}.** Proved the immutable publication OID, recovered the original pin via `git merge-base`, and restored v${analysis.next_version} from the artifact's release notes. Later bullets remain in `## Unreleased`; the tag stays immutable and auto-merge is left disabled for operator review."
    }
  } else {
    ""
  }
  const tag_publish_note = if analysis.fixup_mode ?? false {
    "tag handling depends on origin state: skipped if `v${analysis.next_version}` already exists on origin (artifact shipped); otherwise pushed pre-PR like a normal first-time release."
  } else {
    "pushed pre-PR; `publish-release.yml` ships from the tag so post-PR drift on `${analysis.base_branch}` cannot leak into the artifact."
  }
  const run_session_view = analysis.run_session_view ?? {}
  const view_check = run_session_view.check ?? {}
  const view_note = run_session_view.release_note ?? {}
  const view_summary = run_session_view.summary_line ?? "unknown"
  const view_fixture_status = if view_check.success ?? false {
    "passed"
  } else {
    "failed"
  }
  const view_release_note = if view_note.required ?? false {
    if view_note.present ?? false {
      "contract files changed; release note present"
    } else {
      "contract files changed; release note missing"
    }
  } else {
    "no contract-file change detected"
  }
  return render(
    prompt_asset("release_pr_body.harn.prompt"),
    {
      next_version: analysis.next_version,
      run_id: run_id,
      fixup_note: fixup_note,
      tag_publish_note: tag_publish_note,
      current_version: analysis.current_version,
      branch: branch,
      local_branch: local_branch,
      base_branch: analysis.base_branch,
      pin_sha: analysis.pin_sha,
      pin_sha_note: pin_sha_note,
      latest_tag: analysis.latest_tag,
      changelog_block: changelog_block,
      run_session_view_summary: view_summary,
      run_session_view_fixture_status: view_fixture_status,
      run_session_view_release_note: view_release_note,
      platform_certification_block: platform_certification_pr_block(execution),
      commits_since_latest_tag: analysis.commits_since_latest_tag,
      execution_summary: execution_summary,
      execution_step_count: len(execution),
      execution_status_summary: execution_status_summary(execution),
      audit_transcript: agent_artifacts.llm_transcript_jsonl ?? "not generated",
      draft_changelog: draft_path,
      validation_findings: if len(validation) == 0 {
        "none"
      } else {
        validation.join("; ")
      },
    },
  )
}

/** Render the durable PR body from prepared release facts. */
pub fn pr_body_text(
  analysis: ReleaseAnalysis,
  agent_review_result: ReleaseAgentReviewResult,
  execution: list<dict>,
  run_id: string,
  publication: ReleasePublication? = nil,
) -> string {
  const changelog_block = if (analysis.fixup_mode ?? false)
    && analysis.release_notes_scope
    == "frozen_artifact" {
    fixup_changelog_block(analysis)
  } else {
    standard_changelog_block(analysis)
  }
  return pr_body_text_with_changelog_block(
    analysis,
    agent_review_result,
    execution,
    run_id,
    changelog_block,
    publication,
  )
}

/**
 * Render the approval-gate projection without presenting the previous release
 * as the proposed next release. Prepare owns deterministic fragment folding,
 * so an absent next-version section cannot be previewed faithfully yet.
 */
pub fn pre_release_pr_body_text(
  analysis: ReleaseAnalysis,
  agent_review_result: ReleaseAgentReviewResult,
  run_id: string,
) -> string {
  const has_prepared_section = analysis.changelog_top == analysis.next_version
  const changelog_block = if has_prepared_section
    || ((analysis.fixup_mode ?? false)
    && analysis
    .release_notes_scope
    == "frozen_artifact") {
    if (analysis.fixup_mode ?? false) && analysis.release_notes_scope == "frozen_artifact" {
      fixup_changelog_block(analysis)
    } else {
      standard_changelog_block(analysis)
    }
  } else {
    "> **Changelog pending prepare.** This preview intentionally omits the release\n"
      + "> section until deterministic fragment folding and generated-content validation\n"
      + "> complete. The proposed draft is shown separately; the final PR body is\n"
      + "> regenerated from the prepared v${analysis.next_version} changelog."
  }
  return pr_body_text_with_changelog_block(
    analysis,
    agent_review_result,
    [],
    run_id,
    changelog_block,
  )
}

fn execution_table(execution: list<dict>) -> string {
  let lines = ["| Step | Status | Classification |", "|------|--------|----------------|"]
  for step in execution {
    const status = if step.success {
      "ok"
    } else {
      "failed (exit ${step.exit_code})"
    }
    lines = lines + ["| `${step.name}` | ${status} | `${step.classification ?? ""}` |"]
  }
  return lines.join("\n")
}

pub fn write_pr_body(
  harness: Harness,
  run_id: string,
  analysis: ReleaseAnalysis,
  agent_review_result: ReleaseAgentReviewResult,
  execution: list<dict>,
  publication: ReleasePublication,
) -> string {
  const body_path = path_join(release_run_dir(run_id), "pr-body.md")
  harness.fs.mkdir(dirname(body_path), true)
  harness.fs.write_text(
    body_path,
    pr_body_text(analysis, agent_review_result, execution, run_id, publication),
  )
  return body_path
}

pub fn append_pr_auto_merge_steps(
  harness: Harness,
  cfg: ReleaseConfig,
  steps: list<dict>,
  pr_url: string,
  run_id: string,
  publication: ReleasePublication,
) -> ReleasePrAutoMergeResult {
  if pr_url == "" {
    return {
      steps: steps
        + [
        recorded_step(
          "auto-merge",
          "enable release PR auto-merge",
          command_result_fail(2, "could not determine PR URL for release PR"),
        ),
      ],
      success: false,
      pr_url: "",
    }
  }
  const probe = logged_github_operation_step(
    harness,
    steps,
    "inspect-auto-merge",
    "inspect release PR auto-merge state",
    run_id,
    fn() { return release_github_pr_view(cfg, pr_url, publication.remote_ref) },
  )
  let out = probe.steps
  if !probe.success {
    return {steps: out, success: false, pr_url: pr_url}
  }
  const pr = probe.value
  const publication_decision = release_publication_pr_decision(publication, pr)
  out = out
    + [
    recorded_step(
      "verify-release-pr-publication",
      "verify release PR still targets ${publication.remote_ref} at ${publication.head_oid}",
      if publication_decision.action == "accept" {
        command_result_ok(publication_decision.reason + "\n")
      } else {
        command_result_fail(2, publication_decision.reason)
      },
    ),
  ]
  if publication_decision.action != "accept" {
    return {steps: out, success: false, pr_url: pr_url}
  }
  if pr.auto_merge_armed {
    out = out
      + [
      recorded_step(
        "auto-merge-already-enabled",
        "typed auto-merge state is armed on " + pr_url,
        command_result_ok("release PR already has auto-merge enabled\n"),
      ),
    ]
    return {steps: out, success: true, pr_url: pr_url}
  }
  // Recovery PRs always require operator review, whether the durable source
  // was an earlier PR or a tag published before PR creation.
  if cfg.fixup_mode {
    out = out
      + [
      recorded_step(
        "auto-merge-skipped",
        "fixup mode: leaving auto-merge disabled so the operator can review the repaired diff",
        command_result_ok("auto-merge state preserved (fixup mode)\n"),
      ),
    ]
    return {steps: out, success: true, pr_url: pr_url}
  }
  const auto_merge = logged_github_operation_step(
    harness,
    out,
    "auto-merge",
    "enable squash auto-merge at expected head " + pr.head.sha,
    run_id,
    fn() { return release_github_enable_auto_merge(cfg, pr) },
  )
  return {steps: auto_merge.steps, success: auto_merge.success, pr_url: pr_url}
}
