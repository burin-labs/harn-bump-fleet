import { github_pr_checks, github_pr_number, github_pr_view } from "./github"

pub type OperatorPrPatrolRow = {
  repo: string,
  pr_number: int?,
  title: string,
  url: string,
  head_sha: string,
  draft: bool,
  github_state: string,
  merge_state: string,
  auto_merge_armed: bool,
  queue_state: string,
  check_state: string,
  failing_checks: list<dict>,
  pending_checks: list<dict>,
  human_action: string,
  reason: string,
}

fn check_names(checks) {
  let names = []
  for check in checks ?? [] {
    names = names + [check?.name ?? ""]
  }
  return names
}

fn checks_from_connector(repo, pr) {
  const result = github_pr_checks(repo, pr.number)
  if is_err(result) {
    return {ok: false, state: "unknown", failing_checks: [], pending_checks: [], error: unwrap_err(result)}
  }
  return {
    ok: true,
    state: result?.rollup?.state ?? result?.state ?? "unknown",
    failing_checks: result?.failing_checks
      ?? result?.checks
      ?.filter(
      { check -> return lowercase(to_string(check?.status ?? "")) == "completed"
        && !["success", "neutral", "skipped", ""].contains(lowercase(to_string(check?.conclusion ?? ""))) },
    ).to_list()
      ?? [],
    pending_checks: result?.pending_checks
      ?? result?.checks
      ?.filter({ check -> return lowercase(to_string(check?.status ?? "")) != "completed" }).to_list()
      ?? [],
    error: nil,
  }
}

fn hidden_required_check(pr, merge_state, check_state, failing, pending, queued) {
  if queued || !(pr?.auto_merge_armed ?? false) {
    return false
  }
  return merge_state == "blocked" && check_state == "green" && len(failing) == 0 && len(pending) == 0
}

fn branch_protection_pending_check(pr) {
  return {
    name: "GitHub branch protection",
    status: "pending",
    conclusion: "",
    details_url: pr?.url ?? "",
    source: "blocked_auto_merge",
  }
}

pub fn operator_pr_patrol_classify(repo: string, pr, checks) -> OperatorPrPatrolRow {
  const queue = pr?.queue_membership
  const queued = (pr?.in_merge_queue ?? false) || (queue?.queued ?? false)
  const queue_state = if queued {
    to_string(queue?.entry?.state ?? "queued")
  } else if queue?.available == false {
    "unknown"
  } else {
    "none"
  }
  const github_state = lowercase(to_string(pr?.github_state ?? pr?.state ?? ""))
  const merge_state = lowercase(to_string(pr?.mergeable_state ?? pr?.state ?? "unknown"))
  let check_state = lowercase(to_string(checks?.state ?? "unknown"))
  const failing = checks?.failing_checks ?? []
  let pending = checks?.pending_checks ?? []
  if hidden_required_check(pr, merge_state, check_state, failing, pending, queued) {
    check_state = "pending"
    pending = pending + [branch_protection_pending_check(pr)]
  }
  let human_action = "none"
  let reason = "ready_or_waiting"
  if pr == nil {
    human_action = "investigate"
    reason = "missing_pull_request"
  } else if (pr?.merged ?? false) || github_state == "merged" {
    human_action = "none"
    reason = "merged"
  } else if github_state != "open" {
    human_action = "investigate"
    reason = "pull_request_not_open"
  } else if pr?.draft ?? false {
    human_action = "owner"
    reason = "draft_pull_request"
  } else if check_state == "failing" || len(failing) > 0 {
    human_action = "owner"
    reason = "checks_failing"
  } else if check_state == "pending" || len(pending) > 0 {
    human_action = "wait"
    reason = "checks_pending"
  } else if merge_state == "dirty" || merge_state == "blocked" {
    human_action = "owner"
    reason = "merge_state_" + merge_state
  } else if !(pr?.auto_merge_armed ?? false) && !queued {
    human_action = "control"
    reason = "green_unarmed"
  }
  return {
    repo: repo,
    pr_number: pr?.number,
    title: pr?.title ?? "",
    url: pr?.url ?? "",
    head_sha: pr?.head?.sha ?? "",
    draft: pr?.draft ?? false,
    github_state: github_state,
    merge_state: merge_state,
    auto_merge_armed: pr?.auto_merge_armed ?? false,
    queue_state: queue_state,
    check_state: check_state,
    failing_checks: failing,
    pending_checks: pending,
    human_action: human_action,
    reason: reason,
  }
}

pub fn operator_pr_patrol(repo: string, pr_ref) -> OperatorPrPatrolRow {
  const pr = github_pr_view(repo, pr_ref)
  if is_err(pr) {
    const number = github_pr_number(pr_ref)
    return operator_pr_patrol_classify(
      repo,
      {number: number, github_state: "", state: "", title: "", url: "", head: {sha: ""}},
      {state: "unknown", failing_checks: [], pending_checks: []},
    )
      + {human_action: "investigate", reason: "pull_request_probe_failed", error: unwrap_err(pr)}
  }
  const checks = checks_from_connector(repo, pr)
  const row = operator_pr_patrol_classify(repo, pr, checks)
  if checks.ok {
    return row
  }
  return row
    + {check_error: checks.error, check_names: check_names(checks.failing_checks + checks.pending_checks)}
}
