import { render_bump_workflow } from "./bump_workflow_projection"
import { FleetManifest } from "./fleet_manifest"
import { render_package_ci } from "./package_ci_projection"

/**
 * One repository file whose exact bytes the fleet manifest owns.
 *
 * `origin` names the authority those bytes came from, so a proposal can say why
 * a file is being rewritten without the reader consulting `fleet.toml`.
 */
pub type FleetProjectionTarget = {slug: string, path: string, expected: string, origin: string}

pub const BUMP_ADAPTER_PATH: string = ".github/workflows/bump-harn.yml"

pub const PACKAGE_CI_PATH: string = ".github/workflows/ci.yml"

/** Address one projection source as the `slug:path` key its bytes are keyed by. */
pub fn projection_source_key(slug: string, path: string) -> string {
  return slug + ":" + path
}

/**
 * Every source whose bytes a caller must read before targets can be enumerated.
 *
 * Rendered projections need nothing; a copied one is only defined once its
 * canonical source is in hand. Splitting the read out keeps enumeration pure,
 * which is what lets the whole projection set be asserted without a network.
 */
pub fn fleet_projection_sources(manifest: FleetManifest) -> list<{slug: string, path: string}> {
  let sources = []
  let seen = {}
  for projection in manifest.file_projections {
    const key = projection_source_key(projection.source_slug, projection.source_path)
    if seen[key] ?? false {
      continue
    }
    seen[key] = true
    sources = sources + [{slug: projection.source_slug, path: projection.source_path}]
  }
  return sources
}

/**
 * Every file the fleet manifest defines byte-for-byte, given its resolved sources.
 *
 * This is exactly the repairable subset of what `check_fleet_policy` reports:
 * the three violations that say bytes *drift from* a projection, and no other.
 * A typed violation — a missing dispatch input, a schedule that should not be
 * there, a status job that covers too little — describes a workflow the fleet
 * does not render, so nothing here can or should rewrite it.
 *
 * `sources` maps `projection_source_key(...)` to the canonical bytes. A copied
 * projection whose source is absent is omitted rather than guessed at: there is
 * no correct content to propose, and proposing the target's own current bytes
 * would silently ratify the drift.
 */
pub fn fleet_projection_targets(
  manifest: FleetManifest,
  sources: dict,
) -> list<FleetProjectionTarget> {
  let targets = []
  for repo in manifest.repositories {
    if repo.bump_workflow_ownership == "fleet" {
      targets = targets
        + [
        {
          slug: repo.slug,
          path: BUMP_ADAPTER_PATH,
          expected: render_bump_workflow(manifest, repo),
          origin: "fleet.toml bump adapter projection",
        },
      ]
    }
    if repo.package_ci_ownership == "fleet" {
      targets = targets
        + [
        {
          slug: repo.slug,
          path: PACKAGE_CI_PATH,
          expected: render_package_ci(manifest, repo),
          origin: "fleet.toml package CI projection",
        },
      ]
    }
  }
  for projection in manifest.file_projections {
    const key = projection_source_key(projection.source_slug, projection.source_path)
    const source = sources[key]
    if source == nil {
      continue
    }
    targets = targets
      + [
      {
        slug: projection.target_slug,
        path: projection.target_path,
        expected: to_string(source),
        origin: key,
      },
    ]
  }
  return targets
}

/** Group targets by repository, preserving enumeration order within each one. */
pub fn group_projection_targets_by_repository(
  targets: list<FleetProjectionTarget>,
) -> list<{slug: string, targets: list<FleetProjectionTarget>}> {
  let order = []
  let grouped = {}
  for target in targets {
    if grouped[target.slug] == nil {
      order = order + [target.slug]
    }
    grouped[target.slug] = (grouped[target.slug] ?? []) + [target]
  }
  return order.map({ slug -> {slug: slug, targets: grouped[slug] ?? []} }).to_list()
}
