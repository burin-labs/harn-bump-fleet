pub type ReleaseQueueCritical = {pull_number: int, expected_head_oid: string}

pub type ReleaseQueueEntryState = "QUEUED" \
  | "AWAITING_CHECKS" \
  | "MERGEABLE" \
  | "UNMERGEABLE" \
  | "LOCKED"

pub type ReleaseQueueEntry = {
  entry_id: string,
  pull_number: int,
  head_oid: string,
  position: int,
  state: ReleaseQueueEntryState,
}

pub type ReleaseQueuePull = {
  pull_number: int,
  head_oid: string,
  auto_merge_armed: bool,
  merge_method: string,
  source_check_state: string,
  source_checks: list<ReleaseQueueSourceCheck>,
}

pub type ReleaseQueueSourceCheck = {
  name: string,
  status: string,
  conclusion: string,
  details_url: string,
}

pub type ReleaseQueuePlanOptions = {
  live_pull_numbers: list<int>,
  noncritical_live_overrides: list<int>,
  active_reservation_id?: string,
}

pub type ReleaseQueueHold = {
  entry_id: string,
  pull_number: int,
  expected_head_oid: string,
  position: int,
  state: string,
  restore_merge_method: string,
  source_check_state: string,
  source_checks: list<ReleaseQueueSourceCheck>,
}

pub type ReleaseQueuePreserved = {
  entry_id: string,
  pull_number: int,
  expected_head_oid: string,
  position: int,
  reason: "critical" | "live_merge_group",
}

pub type ReleaseQueueRefusal = {pull_number: int, code: string, message: string}

pub type ReleaseQueueReservationPlan = {
  schema_version: "harn.release_queue.plan.v1",
  reservation_id: string,
  repo: string,
  base_branch: string,
  base_oid: string,
  critical: list<ReleaseQueueCritical>,
  options: ReleaseQueuePlanOptions,
  observed_entries: list<ReleaseQueueEntry>,
  holds: list<ReleaseQueueHold>,
  preserved: list<ReleaseQueuePreserved>,
  refusals: list<ReleaseQueueRefusal>,
  safe: bool,
}

pub type ReleaseQueueMutation = {
  action: "hold" | "restore",
  pull_number: int,
  expected_head_oid: string,
  status: "applied" | "reused" | "failed",
  detail: string,
  before_position: int,
  after_position: int?,
}

pub type ReleaseQueueReservationReceipt = {
  schema_version: "harn.release_queue.receipt.v1",
  reservation_id: string,
  phase: "audit" | "reserve" | "restore",
  status: "planned" | "refused" | "reserved" | "restored" | "partial",
  plan: ReleaseQueueReservationPlan,
  mutations: list<ReleaseQueueMutation>,
}

pub type ReleaseQueueMutationAdapter = {
  hold: fn(ReleaseQueueHold) -> ReleaseQueueMutationResult,
  restore: fn(ReleaseQueueHold) -> ReleaseQueueMutationResult,
}

pub type ReleaseQueueMutationResult = {ok: bool, detail: string, after_position?: int}

pub type ReleaseQueueCheckpoint = fn(ReleaseQueueReservationReceipt) -> nil

fn contains_int(values: any, target: any) {
  for value in values {
    if value == target {
      return true
    }
  }
  return false
}

fn critical_for(critical: any, pull_number: any) {
  for item in critical {
    if item.pull_number == pull_number {
      return item
    }
  }
  return nil
}

fn pull_for(pulls: any, pull_number: any) {
  for pull in pulls {
    if pull.pull_number == pull_number {
      return pull
    }
  }
  return nil
}

fn refusal(pull_number: any, code: any, message: any) -> ReleaseQueueRefusal {
  return {pull_number: pull_number, code: code, message: message}
}

fn reservation_id(repo: any, base_branch: any, base_oid: any, critical: any) {
  const critical_part = critical.map(
    fn(item) { return "${item.pull_number}@${item.expected_head_oid}" },
  )
  return repo + ":" + base_branch + "@" + base_oid + ":" + join(critical_part, ",")
}

fn entry_is_live(entry: ReleaseQueueEntry) -> bool {
  return entry.position == 1 || entry.state != "QUEUED"
}

/** Build a read-only, exact-head plan for one release queue reservation. */
@complexity(allow)
pub fn release_queue_reservation_plan(
  repo: string,
  base_branch: string,
  base_oid: string,
  critical: list<ReleaseQueueCritical>,
  entries: list<ReleaseQueueEntry>,
  pulls: list<ReleaseQueuePull>,
  options: ReleaseQueuePlanOptions,
) -> ReleaseQueueReservationPlan {
  let holds: list<ReleaseQueueHold> = []
  let preserved: list<ReleaseQueuePreserved> = []
  let refusals: list<ReleaseQueueRefusal> = []
  if trim(repo) == "" || trim(base_branch) == "" || trim(base_oid) == "" {
    refusals = refusals
      + [refusal(0, "invalid_release_base", "repository, base branch, and base OID are required")]
  }
  if len(critical) == 0 {
    refusals = refusals
      + [
        refusal(
          0,
          "missing_critical_chain",
          "at least one release-critical pull request is required",
        ),
      ]
  }
  const candidate_reservation_id = reservation_id(repo, base_branch, base_oid, critical)
  const active_reservation_id = trim(options.active_reservation_id ?? "")
  if active_reservation_id != "" && active_reservation_id != candidate_reservation_id {
    refusals = refusals
      + [
        refusal(
          0,
          "concurrent_release",
          "another release queue reservation is active: " + active_reservation_id,
        ),
      ]
  }
  for item in critical {
    if trim(item.expected_head_oid) == "" {
      refusals = refusals
        + [
          refusal(
            item.pull_number,
            "missing_critical_head",
            "release-critical pull request #${item.pull_number} has no expected head OID",
          ),
        ]
    }
  }
  for entry in entries {
    const pull = pull_for(pulls, entry.pull_number)
    const critical_item = critical_for(critical, entry.pull_number)
    if pull == nil {
      refusals = refusals
        + [
          refusal(
            entry.pull_number,
            "unknown_queue_entry",
            "queue entry ${entry.entry_id} has no leased pull-request observation",
          ),
        ]
      continue
    }
    if trim(entry.head_oid) == "" || entry.head_oid != pull.head_oid {
      refusals = refusals
        + [
          refusal(
            entry.pull_number,
            "changed_head",
            "pull request #${entry.pull_number} changed head between queue and pull observations",
          ),
        ]
      continue
    }
    if critical_item != nil && critical_item.expected_head_oid != entry.head_oid {
      refusals = refusals
        + [
          refusal(
            entry.pull_number,
            "critical_head_changed",
            "release-critical pull request #${entry.pull_number} is not at its expected head",
          ),
        ]
      continue
    }
    const explicitly_noncritical = contains_int(
      options.noncritical_live_overrides,
      entry.pull_number,
    )
    const live = entry_is_live(entry)
      || contains_int(options.live_pull_numbers, entry.pull_number)
    if critical_item != nil {
      preserved = preserved
        + [
          {
            entry_id: entry.entry_id,
            pull_number: entry.pull_number,
            expected_head_oid: entry.head_oid,
            position: entry.position,
            reason: "critical",
          },
        ]
      continue
    }
    if live && !explicitly_noncritical {
      preserved = preserved
        + [
          {
            entry_id: entry.entry_id,
            pull_number: entry.pull_number,
            expected_head_oid: entry.head_oid,
            position: entry.position,
            reason: "live_merge_group",
          },
        ]
      continue
    }
    if !pull.auto_merge_armed || trim(pull.merge_method) == "" {
      refusals = refusals
        + [
          refusal(
            entry.pull_number,
            "missing_restore_intent",
            "pull request #${entry.pull_number} lacks exact auto-merge restoration intent",
          ),
        ]
      continue
    }
    holds = holds
      + [
        {
          entry_id: entry.entry_id,
          pull_number: entry.pull_number,
          expected_head_oid: entry.head_oid,
          position: entry.position,
          state: entry.state,
          restore_merge_method: uppercase(pull.merge_method),
          source_check_state: pull.source_check_state,
          source_checks: pull.source_checks,
        },
      ]
  }
  return {
    schema_version: "harn.release_queue.plan.v1",
    reservation_id: candidate_reservation_id,
    repo: repo,
    base_branch: base_branch,
    base_oid: base_oid,
    critical: critical,
    options: options,
    observed_entries: entries,
    holds: holds,
    preserved: preserved,
    refusals: refusals,
    safe: len(refusals) == 0,
  }
}

/** Return the read-only audit receipt for a plan. */
pub fn release_queue_audit_receipt(
  plan: ReleaseQueueReservationPlan,
) -> ReleaseQueueReservationReceipt {
  return {
    schema_version: "harn.release_queue.receipt.v1",
    reservation_id: plan.reservation_id,
    phase: "audit",
    status: if plan.safe {
      "planned"
    } else {
      "refused"
    },
    plan: plan,
    mutations: [],
  }
}

fn completed_mutation(receipt: any, expected_reservation_id: any, action: any, hold: any) {
  if receipt == nil || receipt.reservation_id != expected_reservation_id {
    return nil
  }
  for mutation in receipt.mutations {
    if mutation.action == action && mutation.pull_number == hold.pull_number
      && mutation.expected_head_oid
        == hold.expected_head_oid
      && (mutation.status == "applied" || mutation.status == "reused") {
      return mutation
    }
  }
  return nil
}

fn mutation_from_result(
  action: "hold" | "restore",
  hold: ReleaseQueueHold,
  result: ReleaseQueueMutationResult,
) -> ReleaseQueueMutation {
  const ok = result.ok
  return {
    action: action,
    pull_number: hold.pull_number,
    expected_head_oid: hold.expected_head_oid,
    status: if ok {
      "applied"
    } else {
      "failed"
    },
    detail: result.detail,
    before_position: hold.position,
    after_position: result.after_position,
  }
}

fn persist_receipt(persist: any, receipt: any) {
  persist(receipt)
  return receipt
}

/** Apply every planned hold, checkpointing after each exact-head mutation. */
pub fn release_queue_reserve(
  plan: ReleaseQueueReservationPlan,
  prior: ReleaseQueueReservationReceipt?,
  adapter: ReleaseQueueMutationAdapter,
  persist: ReleaseQueueCheckpoint,
  force_hold_pull_numbers: list<int> = [],
) -> ReleaseQueueReservationReceipt {
  const prior_mutations = if prior != nil && prior.reservation_id == plan.reservation_id {
    prior.mutations
  } else {
    []
  }
  let receipt: ReleaseQueueReservationReceipt = {
    schema_version: "harn.release_queue.receipt.v1",
    reservation_id: plan.reservation_id,
    phase: "reserve",
    status: if plan.safe {
      "partial"
    } else {
      "refused"
    },
    plan: plan,
    mutations: prior_mutations,
  }
  if !plan.safe {
    return persist_receipt(persist, receipt)
  }
  for hold in plan.holds {
    const completed = completed_mutation(prior, plan.reservation_id, "hold", hold)
    if completed != nil && !contains_int(force_hold_pull_numbers, hold.pull_number) {
      continue
    }
    const mutation = mutation_from_result("hold", hold, adapter.hold(hold))
    receipt = receipt + {mutations: receipt.mutations + [mutation]}
    if mutation.status == "failed" {
      receipt = receipt + {status: "partial"}
      persist(receipt)
      return receipt
    }
    persist(receipt)
  }
  receipt = receipt + {status: "reserved"}
  return persist_receipt(persist, receipt)
}

/** Restore every held pull request under the original exact-head lease. */
pub fn release_queue_restore(
  reserved: ReleaseQueueReservationReceipt,
  prior_restore: ReleaseQueueReservationReceipt?,
  adapter: ReleaseQueueMutationAdapter,
  persist: ReleaseQueueCheckpoint,
) -> ReleaseQueueReservationReceipt {
  const prior_mutations = if prior_restore != nil
    && prior_restore.reservation_id
      == reserved.reservation_id {
    prior_restore.mutations
  } else {
    []
  }
  let receipt: ReleaseQueueReservationReceipt = {
    schema_version: "harn.release_queue.receipt.v1",
    reservation_id: reserved.reservation_id,
    phase: "restore",
    status: "partial",
    plan: reserved.plan,
    mutations: prior_mutations,
  }
  if reserved.status != "reserved" && reserved.status != "partial" {
    receipt = receipt + {status: "refused"}
    return persist_receipt(persist, receipt)
  }
  for hold in reserved.plan.holds {
    const held = completed_mutation(reserved, reserved.reservation_id, "hold", hold)
    if held == nil {
      continue
    }
    const completed = completed_mutation(prior_restore, reserved.reservation_id, "restore", hold)
    if completed != nil {
      continue
    }
    const mutation = mutation_from_result("restore", hold, adapter.restore(hold))
    receipt = receipt + {mutations: receipt.mutations + [mutation]}
    if mutation.status == "failed" {
      receipt = receipt + {status: "partial"}
      persist(receipt)
      return receipt
    }
    persist(receipt)
  }
  receipt = receipt + {status: "restored"}
  return persist_receipt(persist, receipt)
}
