import {
  github_commit_reachable_from_branch,
  github_connector_options,
  github_pr_list,
} from "./github"
import { GithubClientOptions, api_call } from "harn-github-connector/default"

const PAGE_SIZE = 100

const MAX_PAGES = 10

// A pull-request row carries its whole body and two repository objects, about
// 20 KB each, so 100 of them overran the connector's 1 MiB response ceiling on
// a repository with long descriptions. Thirty rows keep a page near 650 KB.
const PULL_REQUEST_PAGE_SIZE = 30

const PULL_REQUEST_MAX_PAGES = 34

const ISSUE_PREVIEW_LIMIT = 100

// GitHub lists at most 300 changed files in one compare response, with no
// field saying it stopped. A list that reaches the cap may be truncated.
const COMPARE_FILE_LIMIT = 300

// Blob lookups per GraphQL request. Each path costs two aliased `object` reads,
// and the answer is an OID or null, so a batch stays a few kilobytes.
const BLOB_LOOKUP_BATCH = 50

/**
 * The prefix GitHub reserves for merge-queue branches.
 *
 * GitHub creates `gh-readonly-queue/<base>/pr-<N>-<sha>` for each queue entry
 * and removes it itself, so such a branch is never abandoned work. Only this
 * exact leading prefix identifies one; a name that merely contains it is an
 * ordinary branch and stays in the audit.
 */
pub const MERGE_QUEUE_REF_PREFIX: string = "gh-readonly-queue/"

pub const PRLESS_BRANCH_ISSUE_MARKER_PREFIX: string = "<!-- harn-bump-fleet:prless-branches:"

pub const PRLESS_BRANCH_LABEL: string = "fleet/prless-branch-audit"

/** Environment variable holding the machine names a published audit must not carry. */
pub const PRIVATE_NAMES_ENV: string = "FLEET_PRIVATE_HOST_NAMES"

/** What a private machine name renders as wherever the audit publishes a branch name. */
pub const PRIVATE_NAME_PLACEHOLDER: string = "[host]"

pub type BranchAuditState = "clean" | "findings" | "measurement_failed"

pub type RepositoryBranch = {name: string, head_oid: string, protected: bool}

/**
 * Whether a branch with no open pull request still holds work.
 *
 * `merged` means the tip is reachable from the default branch, so deleting the
 * branch loses nothing. `content_merged` means the tip is not reachable, but
 * every file the branch changed already has the same content on the default
 * branch, which is what a squash merge leaves behind; deleting it loses no
 * file content. `unmerged` means at least one changed file differs, so the
 * branch is the only copy of that work. `unknown` means the audit could not
 * establish any of these, and is deliberately its own value: an unreadable
 * answer must not collapse into one that reads as safe to delete.
 */
pub type PrlessBranchDisposition = "merged" | "content_merged" | "unmerged" | "unknown"

pub type PrlessBranchFinding = RepositoryBranch \
  & {disposition: PrlessBranchDisposition, disposition_detail: string}

/**
 * One path the branch changed relative to its merge base, with the blob the
 * path holds at the branch tip and at the default-branch tip. `nil` means the
 * path is absent on that side.
 */
pub type PrlessPathBlobs = {path: string, branch_blob: string?, default_blob: string?}

/**
 * What the content comparison established for one unreachable tip.
 *
 * `landed`: every changed path matches the default branch. `differs`: at
 * least one does not. `unknown`: a read failed, was malformed, or may have
 * been truncated, so the comparison makes no claim.
 */
pub type PrlessContentCheck = {
  verdict: "landed" | "differs" | "unknown",
  path_count: int?,
  differing_path_count: int?,
  detail: string,
}

pub type RepositoryBranchAudit = {
  slug: string,
  default_branch: string,
  state: BranchAuditState,
  branch_count: int?,
  merge_queue_ref_count: int?,
  open_pr_head_count: int?,
  prless_branch_count: int?,
  prless_branches: list<RepositoryBranch>,
  prless_findings: list<PrlessBranchFinding>,
  merged_branch_count: int?,
  content_merged_branch_count: int?,
  unmerged_branch_count: int?,
  undetermined_branch_count: int?,
  error_code?: string,
  detail: string,
}

pub type FleetBranchAuditReceipt = {
  schema_version: string,
  requested_repository_count: int,
  scanned_repository_count: int,
  failed_repository_count: int,
  branch_count: int,
  merge_queue_ref_count: int,
  open_pr_head_count: int,
  prless_branch_count: int,
  repositories: list<RepositoryBranchAudit>,
}

type GithubBranchRow = {name: string, commit: {sha: string}, protected?: bool, ...rest}

type GithubBranchRows = list<GithubBranchRow>

type GithubCompareFile = {filename: string, status: string, previous_filename?: string, ...rest}

type GithubContentCompare = {
  status: string,
  base_commit: {sha: string},
  files: list<GithubCompareFile>,
  ...rest,
}

/** Whether GitHub owns this branch as a merge-queue entry. */
pub fn is_merge_queue_ref(name: string) -> bool {
  return starts_with(name, MERGE_QUEUE_REF_PREFIX)
}

fn slug_parts(slug: string) -> {owner: string, repo: string} {
  const parts = split(slug, "/")
  if len(parts) != 2 || trim(parts[0]) == "" || trim(parts[1]) == "" {
    throw "repository slug must be owner/name, got '${slug}'"
  }
  return {owner: parts[0], repo: parts[1]}
}

fn branch_page(
  harness: Harness,
  slug: string,
  page: int,
  client: GithubClientOptions,
) -> list<RepositoryBranch> {
  const parts = slug_parts(slug)
  const response = api_call(
    harness,
    {
      path:
        "/repos/${parts.owner}/${parts.repo}/branches?page=${to_string(page)}&per_page=${to_string(PAGE_SIZE)}",
      options: client,
    },
  )
  if is_err(response) {
    throw "branch_page_failed: " + to_string(unwrap_err(response))
  }
  const raw = unwrap(response)
  if !schema_is(raw, GithubBranchRows) {
    throw "branch_response_malformed: GitHub did not return a typed branch list"
  }
  let rows: list<RepositoryBranch> = []
  for branch in raw {
    const name = trim(branch.name)
    const head_oid = lowercase(trim(branch.commit.sha))
    if name == "" || len(regex_captures("^[0-9a-f]{40}$", head_oid)) == 0 {
      throw "branch_response_malformed: branch name or commit SHA is invalid"
    }
    rows = rows + [{name: name, head_oid: head_oid, protected: branch.protected ?? false}]
  }
  return rows
}

fn all_branches(
  harness: Harness,
  slug: string,
  client: GithubClientOptions,
) -> list<RepositoryBranch> {
  let branches: list<RepositoryBranch> = []
  for page in range(1, MAX_PAGES + 1) {
    const rows = branch_page(harness, slug, page, client)
    branches = branches + rows
    if len(rows) < PAGE_SIZE {
      return branches
    }
  }
  throw "branch_page_limit_exceeded: ${slug} returned ${to_string(PAGE_SIZE)} branches on all "
    + "${to_string(MAX_PAGES)} bounded pages"
}

fn all_open_pr_head_names(
  harness: Harness,
  slug: string,
  client: GithubClientOptions,
) -> list<string> {
  let names: list<string> = []
  for page in range(1, PULL_REQUEST_MAX_PAGES + 1) {
    const response = github_pr_list(
      harness,
      slug,
      {state: "open", per_page: PULL_REQUEST_PAGE_SIZE, page: page},
      client,
    )
    if is_err(response) {
      throw "pull_request_page_failed: " + to_string(unwrap_err(response))
    }
    const rows = unwrap(response)
    for pull in rows {
      // A fork pull request does not own a branch in the surveyed repository.
      if lowercase(trim(pull.head.repo)) == lowercase(trim(slug)) {
        const name = trim(pull.head.ref)
        if name == "" {
          throw "pull_request_response_malformed: an open same-repository pull request omitted its head branch"
        }
        if !contains(names, name) {
          names = names + [name]
        }
      }
    }
    if len(rows) < PULL_REQUEST_PAGE_SIZE {
      return names
    }
  }
  throw "pull_request_page_limit_exceeded: ${slug} returned ${to_string(PULL_REQUEST_PAGE_SIZE)} open pull "
    + "requests on all ${to_string(PULL_REQUEST_MAX_PAGES)} bounded pages"
}

fn branch_snapshot_fingerprint(branches: list<RepositoryBranch>) -> list<string> {
  return branches.filter({ branch -> !is_merge_queue_ref(branch.name) }).map(
    { branch -> "${branch.name}@${branch.head_oid}" },
  )
    .to_list()
    .sort()
}

fn name_snapshot_fingerprint(names: list<string>) -> list<string> {
  return names.map({ name -> name }).to_list().sort()
}

fn measurement_failure(
  slug: string,
  default_branch: string,
  detail: string,
) -> RepositoryBranchAudit {
  const pieces = split(detail, ":")
  return {
    slug: slug,
    default_branch: default_branch,
    state: "measurement_failed",
    branch_count: nil,
    merge_queue_ref_count: nil,
    open_pr_head_count: nil,
    prless_branch_count: nil,
    prless_branches: [],
    prless_findings: [],
    merged_branch_count: nil,
    content_merged_branch_count: nil,
    unmerged_branch_count: nil,
    undetermined_branch_count: nil,
    error_code: trim(pieces[0]),
    detail: detail,
  }
}

/**
 * Decide whether a branch's changed files already hold the same content on the
 * default branch.
 *
 * Every burin-labs repository merges by squash, so a branch whose work landed
 * keeps a tip the default branch cannot reach. Content is the evidence that
 * survives a squash: if each path the branch changed has the same blob on the
 * default branch, or is absent on both, merging the branch would change
 * nothing. A single differing path makes the branch the only copy of that
 * change. An empty list means the branch changes no file relative to its
 * merge base, which also merges as a no-op.
 *
 * @effects: []
 * @errors: []
 */
pub fn prless_content_verdict(paths: list<PrlessPathBlobs>) -> PrlessContentCheck {
  const differing = len(
    paths.filter({ entry -> entry.branch_blob != entry.default_blob }).to_list(),
  )
  if differing > 0 {
    return {
      verdict: "differs",
      path_count: len(paths),
      differing_path_count: differing,
      detail: "${to_string(differing)} of ${to_string(len(paths))} changed path(s) differ",
    }
  }
  return {
    verdict: "landed",
    path_count: len(paths),
    differing_path_count: 0,
    detail: "all ${to_string(len(paths))} changed path(s) match",
  }
}

fn content_unknown(detail: string) -> PrlessContentCheck {
  return {verdict: "unknown", path_count: nil, differing_path_count: nil, detail: detail}
}

/**
 * Classify one PR-less branch from the reads that either succeeded or did not.
 *
 * The reads are passed in rather than performed here so the decision is
 * testable on its own, and so a failure is a value instead of an exception.
 * A `nil` reachability read is `unknown`. An unreachable tip is then decided
 * by its content check, and a missing or `unknown` content check is `unknown`
 * too: a branch the audit could not compare is not evidence that the branch
 * is disposable, and not evidence that it is the only copy of anything.
 */
pub fn prless_branch_disposition(
  branch: RepositoryBranch,
  default_branch: string,
  reachable: bool?,
  content: PrlessContentCheck?,
) -> PrlessBranchFinding {
  if reachable == nil {
    return branch
      + {
        disposition: "unknown",
        disposition_detail:
          "the audit could not compare this tip against ${default_branch}, so it makes no claim about it",
      }
  }
  if reachable ?? false {
    return branch
      + {
        disposition: "merged",
        disposition_detail:
          "the tip is reachable from ${default_branch}, so deleting the branch loses nothing",
      }
  }
  const verdict = content?.verdict ?? "unknown"
  if verdict == "landed" {
    return branch
      + {
        disposition: "content_merged",
        disposition_detail: "the tip is not reachable from ${default_branch}, but ${content?.detail ?? ""} "
          + "${default_branch}, so the work already landed there (for example by squash merge) "
          + "and deleting the branch loses no file content",
      }
  }
  if verdict == "differs" {
    return branch
      + {
        disposition: "unmerged",
        disposition_detail: "the tip is not reachable from ${default_branch} and ${content?.detail ?? ""} from "
          + "${default_branch}, so this branch is the only copy of that work",
      }
  }
  return branch
    + {
      disposition: "unknown",
      disposition_detail: "the tip is not reachable from ${default_branch} and the audit could not compare its file "
        + "content (${content?.detail ?? "no content check ran"}), so it makes no claim about it",
    }
}

/** How many findings fall into one disposition. */
pub fn prless_disposition_count(
  findings: list<PrlessBranchFinding>,
  disposition: PrlessBranchDisposition,
) -> int {
  return len(findings.filter({ finding -> finding.disposition == disposition }).to_list())
}

/** A path the branch changed, and whether the compare says the tip holds it. */
type ChangedPath = {path: string, on_branch: bool?}

/**
 * Read the paths the branch changed since its merge base, and the exact
 * default-branch commit the compare measured against.
 *
 * `per_page=1` keeps the commit list to one entry; GitHub still returns the
 * whole file list on the first page. A response over the connector's 1 MiB
 * ceiling fails the read, which the caller reports as `unknown`.
 */
fn changed_paths(
  harness: Harness,
  slug: string,
  default_branch: string,
  tip: string,
  client: GithubClientOptions,
) -> {base_oid: string, paths: list<ChangedPath>} {
  const parts = slug_parts(slug)
  const response = api_call(
    harness,
    {
      path:
        "/repos/${parts.owner}/${parts.repo}/compare/${url_encode(default_branch)}...${tip}?per_page=1",
      options: client,
    },
  )
  if is_err(response) {
    throw "content_compare_failed: " + to_string(unwrap_err(response))
  }
  const raw = unwrap(response)
  if !schema_is(raw, GithubContentCompare) {
    throw "content_compare_malformed: GitHub did not return a typed compare with a file list"
  }
  const base_oid = lowercase(trim(raw.base_commit.sha))
  if len(regex_captures("^[0-9a-f]{40}$", base_oid)) == 0 {
    throw "content_compare_malformed: the compare named no exact default-branch commit"
  }
  if len(raw.files) >= COMPARE_FILE_LIMIT {
    throw "content_compare_truncated: GitHub listed ${to_string(len(raw.files))} changed files, "
      + "its cap, so the list may be incomplete"
  }
  let paths: list<ChangedPath> = []
  for file in raw.files {
    const path = file.filename
    if trim(path) == "" {
      throw "content_compare_malformed: a changed file had no path"
    }
    paths = paths + [{path: path, on_branch: file.status != "removed"}]
    // A rename removed the old path on the branch. Whether the default branch
    // still has it is part of the comparison too.
    if file.status == "renamed" && trim(file.previous_filename ?? "") != "" {
      paths = paths + [{path: file.previous_filename ?? "", on_branch: nil}]
    }
  }
  return {base_oid: base_oid, paths: paths}
}

fn blob_lookup_query(count: int) -> string {
  let declarations = ["$owner: String!", "$name: String!"]
  let fields: list<string> = []
  for index in range(0, count) {
    const suffix = to_string(index)
    declarations = declarations + ["$b${suffix}: String!", "$d${suffix}: String!"]
    fields = fields
      + [
        "b${suffix}: object(expression: $b${suffix}) { oid }",
        "d${suffix}: object(expression: $d${suffix}) { oid }",
      ]
  }
  return "query(" + declarations.join(", ") + ") { repository(owner: $owner, name: $name) { "
    + fields.join(" ")
    + " } }"
}

/** One aliased `object` answer: an exact OID, or `nil` when the path is absent. */
fn alias_blob(repository: dict, alias: string) -> string? {
  if !contains(repository.keys().to_list(), alias) {
    throw "blob_lookup_malformed: GraphQL omitted ${alias}"
  }
  const value = repository[alias]
  if value == nil {
    return nil
  }
  const oid = lowercase(trim(to_string(value?.oid ?? "")))
  if len(regex_captures("^[0-9a-f]{40}$", oid)) == 0 {
    throw "blob_lookup_malformed: ${alias} carried no exact object id"
  }
  return oid
}

/** Look up each path's object on both exact commits, in bounded batches. */
fn path_blobs(
  harness: Harness,
  slug: string,
  tip: string,
  base_oid: string,
  paths: list<ChangedPath>,
  client: GithubClientOptions,
) -> list<PrlessPathBlobs> {
  const parts = slug_parts(slug)
  let rows: list<PrlessPathBlobs> = []
  let start = 0
  while start < len(paths) {
    const batch = paths.slice(start, min(start + BLOB_LOOKUP_BATCH, len(paths)))
    let variables: dict<string, string> = {owner: parts.owner, name: parts.repo}
    for index in range(0, len(batch)) {
      const suffix = to_string(index)
      variables["b${suffix}"] = "${tip}:${batch[index].path}"
      variables["d${suffix}"] = "${base_oid}:${batch[index].path}"
    }
    const response = api_call(
      harness,
      {
        path: "/graphql",
        method: "POST",
        body: {query: blob_lookup_query(len(batch)), variables: variables},
        options: client,
      },
    )
    if is_err(response) {
      throw "blob_lookup_failed: " + to_string(unwrap_err(response))
    }
    const answer = unwrap(response)
    if len(answer?.errors ?? []) > 0 {
      throw "blob_lookup_failed: GraphQL reported " + to_string(len(answer?.errors ?? []))
        + " error(s)"
    }
    const repository = answer?.data?.repository
    if type_of(repository) != "dict" {
      throw "blob_lookup_malformed: GraphQL returned no repository object"
    }
    for index in range(0, len(batch)) {
      const suffix = to_string(index)
      const entry = batch[index]
      const branch_blob = alias_blob(repository, "b${suffix}")
      // The compare said whether the tip holds this path. A lookup that
      // disagrees, such as a submodule GraphQL cannot resolve, is a read the
      // audit cannot trust rather than an absence.
      if entry.on_branch != nil && branch_blob != nil != (entry.on_branch ?? false) {
        throw "blob_lookup_inconsistent: the branch-side lookup disagreed with the compare"
      }
      rows = rows
        + [
          {
            path: entry.path,
            branch_blob: branch_blob,
            default_blob: alias_blob(repository, "d${suffix}"),
          },
        ]
    }
    start = start + BLOB_LOOKUP_BATCH
  }
  return rows
}

/**
 * Compare an unreachable tip's changed files with the default branch.
 *
 * Every failure becomes `unknown` with its reason. The verdict is reached only
 * from a complete, consistent read.
 */
fn branch_content_check(
  harness: Harness,
  slug: string,
  default_branch: string,
  tip: string,
  client: GithubClientOptions,
) -> PrlessContentCheck {
  const observed = try {
    const changed = changed_paths(harness, slug, default_branch, tip, client)
    prless_content_verdict(path_blobs(harness, slug, tip, changed.base_oid, changed.paths, client))
  }
  if is_err(observed) {
    return content_unknown(split(to_string(unwrap_err(observed)), ":")[0])
  }
  return unwrap(observed)
}

fn classify_findings(
  harness: Harness,
  slug: string,
  default_branch: string,
  findings: list<RepositoryBranch>,
  client: GithubClientOptions,
) -> list<PrlessBranchFinding> {
  let rows: list<PrlessBranchFinding> = []
  for branch in findings {
    const read = github_commit_reachable_from_branch(
      harness,
      slug,
      branch.head_oid,
      default_branch,
      client,
    )
    const reachable = if is_err(read) {
      nil
    } else {
      unwrap(read).reachable
    }
    const content = if reachable == false {
      branch_content_check(harness, slug, default_branch, branch.head_oid, client)
    } else {
      nil
    }
    rows = rows + [prless_branch_disposition(branch, default_branch, reachable, content)]
  }
  return rows
}

/**
 * Survey one repository through a typed, non-vacuous interface.
 *
 * The default branch is the positive control. A visible GitHub repository
 * cannot have a valid default branch that is absent from its branch listing,
 * so an empty or partial response is a measurement failure rather than inbox
 * zero.
 */
pub fn survey_repository_branches(
  harness: Harness,
  slug: string,
  default_branch: string,
  client: GithubClientOptions = github_connector_options(),
) -> RepositoryBranchAudit {
  const observed = try {
    const branches = all_branches(harness, slug, client)
    if len(branches) == 0 {
      throw "empty_branch_read: GitHub returned zero branches"
    }
    let names: list<string> = []
    for branch in branches {
      if contains(names, branch.name) {
        throw "duplicate_branch_read: GitHub returned branch '${branch.name}' more than once"
      }
      names = names + [branch.name]
    }
    if !contains(names, default_branch) {
      throw "default_branch_missing: '${default_branch}' was absent from the branch listing"
    }
    const open_heads = all_open_pr_head_names(harness, slug, client)
    // REST pages are not a snapshot. Read both inventories twice and refuse a
    // moving answer so a branch inserted between pages cannot hide another.
    // Merge-queue refs come and go within seconds while a queue is busy and are
    // never findings, so they are left out of the comparison. A page shift they
    // cause still moves an audited branch, which the comparison does see.
    const confirmed_branches = all_branches(harness, slug, client)
    const confirmed_open_heads = all_open_pr_head_names(harness, slug, client)
    if branch_snapshot_fingerprint(branches) != branch_snapshot_fingerprint(confirmed_branches) {
      throw "branch_snapshot_moved: branch names or commit identities changed during the audit"
    }
    if name_snapshot_fingerprint(open_heads) != name_snapshot_fingerprint(confirmed_open_heads) {
      throw "pull_request_snapshot_moved: open same-repository pull-request heads changed during the audit"
    }
    const queue_refs = confirmed_branches.filter({ branch -> is_merge_queue_ref(branch.name) })
      .to_list()
    const findings = confirmed_branches.filter(
      { branch ->
        branch.name != default_branch
          && !contains(open_heads, branch.name)
          && !is_merge_queue_ref(branch.name)
      },
    )
      .to_list()
    const state: BranchAuditState = if len(findings) == 0 {
      "clean"
    } else {
      "findings"
    }
    const classified = classify_findings(harness, slug, default_branch, findings, client)
    const row: RepositoryBranchAudit = {
      slug: slug,
      default_branch: default_branch,
      state: state,
      branch_count: len(confirmed_branches),
      merge_queue_ref_count: len(queue_refs),
      open_pr_head_count: len(open_heads),
      prless_branch_count: len(findings),
      prless_branches: findings,
      prless_findings: classified,
      merged_branch_count: prless_disposition_count(classified, "merged"),
      content_merged_branch_count: prless_disposition_count(classified, "content_merged"),
      unmerged_branch_count: prless_disposition_count(classified, "unmerged"),
      undetermined_branch_count: prless_disposition_count(classified, "unknown"),
      error_code: nil,
      detail: if len(findings) == 0 {
        "every non-default branch is the head of an open pull request or a merge-queue ref"
      } else {
        "${to_string(len(findings))} non-default branch(es) have no open pull request"
      },
    }
    row
  }
  if is_err(observed) {
    return measurement_failure(slug, default_branch, to_string(unwrap_err(observed)))
  }
  return unwrap(observed)
}

/**
 * The exit code the audit reports for one completed sweep.
 *
 * ONE owner for that decision, because it is easy to get backwards. A non-zero
 * exit means the audit could not do its job: a repository it was asked to
 * measure failed to measure, or an issue it was asked to reconcile could not be
 * written. It does NOT mean the audit found branches. Findings are the audit's
 * product, not a failure, and the fleet's steady state is hundreds of them.
 *
 * Conflating the two is how a broken instrument becomes indistinguishable from
 * a working one reporting a count: if the daily run is red every day, nobody
 * can see the day it went red for a reason. The count still reaches people
 * through the per-repository issue, the `PR-LESS` lines on stderr, and the
 * receipt.
 *
 * `fail_on_findings` exists for a gating caller that deliberately wants any
 * finding to stop it. It is opt-in, and the scheduled sweep does not set it.
 *
 * @effects: []
 * @errors: []
 */
pub fn branch_audit_exit_code(
  receipt: FleetBranchAuditReceipt,
  reconciliation_failed: bool,
  fail_on_findings: bool,
) -> int {
  if reconciliation_failed || receipt.failed_repository_count > 0 {
    return 1
  }
  if fail_on_findings && receipt.prless_branch_count > 0 {
    return 1
  }
  return 0
}

pub fn fleet_branch_audit_receipt(rows: list<RepositoryBranchAudit>) -> FleetBranchAuditReceipt {
  let scanned = 0
  let failed = 0
  let branch_count = 0
  let merge_queue_ref_count = 0
  let open_pr_head_count = 0
  let prless_branch_count = 0
  for row in rows {
    if row.state == "measurement_failed" {
      failed = failed + 1
      continue
    }
    scanned = scanned + 1
    branch_count = branch_count + (row.branch_count ?? 0)
    merge_queue_ref_count = merge_queue_ref_count + (row.merge_queue_ref_count ?? 0)
    open_pr_head_count = open_pr_head_count + (row.open_pr_head_count ?? 0)
    prless_branch_count = prless_branch_count + (row.prless_branch_count ?? 0)
  }
  return {
    schema_version: "harn_bump_fleet.prless_branch_audit.v2",
    requested_repository_count: len(rows),
    scanned_repository_count: scanned,
    failed_repository_count: failed,
    branch_count: branch_count,
    merge_queue_ref_count: merge_queue_ref_count,
    open_pr_head_count: open_pr_head_count,
    prless_branch_count: prless_branch_count,
    repositories: rows,
  }
}

/**
 * Parse the private machine-name list the audit redacts before publishing.
 *
 * Agents name branches after the workstation that saved them, so a branch
 * census of a public repository republishes private machine names in an
 * indexed issue, the workflow log, and the receipt artifact. The names live in
 * a secret rather than in this public source. An empty list is an error, not
 * "nothing to redact": a missing secret must stop the audit before it
 * publishes, because it is indistinguishable from a list that was never set.
 */
pub fn parse_private_names(raw: string) -> Result<list<string>, string> {
  let names: list<string> = []
  for piece in split(regex_replace("[\\s,]+", ",", lowercase(raw)), ",") {
    if piece == "" {
      continue
    }
    if regex_match("^[a-z0-9][a-z0-9-]{2,}$", piece) == nil {
      return Err(
        "${PRIVATE_NAMES_ENV} entries must be at least three lowercase letters, digits, or hyphens",
      )
    }
    if !contains(names, piece) {
      names = names + [piece]
    }
  }
  if len(names) == 0 {
    return Err("${PRIVATE_NAMES_ENV} is unset or empty, so branch names cannot be published safely")
  }
  // Longest first, so a name that contains another is replaced whole.
  return Ok(names.sort_by({ name -> 0 - len(name) }))
}

/** Replace every private machine name in `text`, ignoring case. */
pub fn redact_private_names(text: string, names: list<string>) -> string {
  let out = text
  for name in names {
    out = regex_replace("(?i)" + name, PRIVATE_NAME_PLACEHOLDER, out)
  }
  return out
}

/**
 * The one projection of an audit row that may leave the job.
 *
 * Every published surface (issue body, receipt, log lines) renders from this
 * row, so no surface can reach a raw branch name. The slug is left alone: it
 * is the issue lookup key and names a repository, not a machine.
 */
pub fn public_branch_audit(
  row: RepositoryBranchAudit,
  names: list<string>,
) -> RepositoryBranchAudit {
  return row
    + {
      prless_branches: row.prless_branches.map(
        { branch -> branch + {name: redact_private_names(branch.name, names)} },
      )
        .to_list(),
      prless_findings: row.prless_findings.map(
        { finding -> finding + {name: redact_private_names(finding.name, names)} },
      )
        .to_list(),
      error_code: if row.error_code == nil {
        nil
      } else {
        redact_private_names(row.error_code ?? "", names)
      },
      detail: redact_private_names(row.detail, names),
    }
}

pub fn prless_branch_issue_marker(slug: string) -> string {
  return PRLESS_BRANCH_ISSUE_MARKER_PREFIX + slug + " -->"
}

pub fn prless_branch_issue_title(row: RepositoryBranchAudit) -> string {
  return if row.state == "measurement_failed" {
    "Fleet branch audit could not measure ${row.slug}"
  } else {
    "Branches without open pull requests in ${row.slug}"
  }
}

fn finding_preview(rows: list<PrlessBranchFinding>) -> list<PrlessBranchFinding> {
  let preview: list<PrlessBranchFinding> = []
  for row in rows {
    if len(preview) >= ISSUE_PREVIEW_LIMIT {
      break
    }
    preview = preview + [row]
  }
  return preview
}

pub fn prless_branch_issue_body(row: RepositoryBranchAudit, run_url: string?) -> string {
  const trailer = if run_url == nil {
    ""
  } else {
    "\n\nDetected by ${to_string(run_url)}."
  }
  if row.state == "measurement_failed" {
    return prless_branch_issue_marker(row.slug)
      + "\n\nThe daily fleet branch audit could not establish a complete branch census."
      + " It is refusing to report inbox zero.\n\nError: `${row.error_code ?? "unknown"}`\n\n"
      + row.detail
      + "\n\nThis issue refreshes until a complete read succeeds. The audit never deletes branches."
      + trailer
  }
  const preview = finding_preview(row.prless_findings)
  const omitted = len(row.prless_findings) - len(preview)
  const omitted_text = if omitted == 0 {
    ""
  } else {
    "\n\n${to_string(omitted)} additional branch(es) are present in the workflow receipt."
  }
  return prless_branch_issue_marker(row.slug)
    + "\n\nThe daily fleet branch audit found **${to_string(row.prless_branch_count ?? 0)}** "
    + "non-default branch(es) that are not the head of an open pull request."
    + "\n\nThe audit measured ${to_string(row.branch_count ?? 0)} branch(es) and "
    + "${to_string(row.open_pr_head_count ?? 0)} unique same-repository open pull-request head(s). "
    + "It left out ${to_string(row.merge_queue_ref_count ?? 0)} merge-queue ref(s) under "
    + "`${MERGE_QUEUE_REF_PREFIX}`, which GitHub creates and removes itself."
    + "\n\n```json\n"
    + json_stringify_pretty(preview)
    + "\n```"
    + omitted_text
    + "\n\nOf those, **${to_string(row.merged_branch_count ?? 0)}** have a tip already reachable "
    + "from `${row.default_branch}` and can be deleted without losing anything, "
    + "**${to_string(row.content_merged_branch_count ?? 0)}** have every changed file already "
    + "matching `${row.default_branch}` (a squash merge leaves this) and can be deleted without "
    + "losing file content, **${to_string(row.unmerged_branch_count ?? 0)}** hold work that exists "
    + "nowhere else, and **${to_string(row.undetermined_branch_count ?? 0)}** could not be compared "
    + "at all. Each branch above carries its own `disposition`. Delete only the `merged` and "
    + "`content_merged` ones. A branch the audit could not compare is not a branch it found safe."
    + "\n\nReview, finish, or archive the work deliberately. This audit never deletes branches."
    + " It refreshes this issue while findings remain and closes it when none remain."
    + trailer
}
