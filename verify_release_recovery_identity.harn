#!/usr/bin/env harn
/** Materialize a legacy landing once, then verify it through the typed owner. */
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { github_pr_view } from "lib/github"
import {
  ReleaseMergeLease,
  observe_release_landing,
  record_release_landing,
  release_landing_admission,
  release_merge_method,
} from "lib/release_merge_lease"
import { run_git } from "lib/release_runtime"
import { release_watch_receipt_read, release_watch_receipt_write } from "lib/release_watch_state"

type Options = {repo: string, tag: string, tagged_oid: string, base_branch: string, receipt: string}

const ARG_SPEC: ParserSpec = {
  name: "verify-release-recovery-identity",
  args: [
    {kind: "flag", name: "repo", long: "--repo", required: true},
    {kind: "flag", name: "tag", long: "--tag", required: true},
    {kind: "flag", name: "tagged_oid", long: "--tagged-oid", required: true},
    {kind: "flag", name: "base_branch", long: "--base-branch", default: "main"},
    {kind: "flag", name: "receipt", long: "--receipt", required: true},
  ],
}

fn on_base(
  harness: {env: HarnessEnv, process: HarnessProcess},
  repo: string,
  oid: string,
  base_ref: string,
) -> bool {
  const result = run_git(
    harness,
    {repo: repo, mock: false},
    ["merge-base", "--is-ancestor", oid, base_ref],
  )
  if result.exit_code == 0 {
    return true
  }
  if result.exit_code == 1 {
    return false
  }
  throw "could not determine whether ${oid} is on ${base_ref}"
}

pipeline main(harness: Harness) -> int {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  let receipt = release_watch_receipt_read(harness.fs, options.receipt)
  if receipt == nil {
    throw "release recovery requires one valid imported watch receipt"
  }
  if receipt.tag != options.tag
    || receipt.release_commit_oid != lowercase(trim(options.tagged_oid))
    || receipt.publication.head_oid != receipt.release_commit_oid {
    throw "recovery inputs do not match the watch receipt's certified tag identity"
  }
  if receipt.merge_lease_candidate_pr <= 0 || receipt.merge_lease_generation == ""
    || receipt.merge_lease_method == "" {
    throw "watch receipt has no exact release merge lease identity"
  }
  const base_ref = "origin/${options.base_branch}"
  const fetched = run_git(
    {env: harness.env, process: harness.process},
    {repo: options.repo, mock: false},
    [
      "fetch",
      "--no-tags",
      "--quiet",
      "origin",
      "+refs/heads/${options.base_branch}:refs/remotes/origin/${options.base_branch}",
    ],
  )
  if !fetched.success {
    throw "could not refresh ${base_ref} before release recovery"
  }
  if receipt.landing == nil {
    const pull = github_pr_view(harness, receipt.slug, receipt.merge_lease_candidate_pr)
    if is_err(pull) {
      throw "could not read the release pull request for legacy landing replay: "
        + to_string(unwrap_err(pull))
    }
    const merge_method = release_merge_method(receipt.merge_lease_method)
    if merge_method == nil {
      throw "release landing merge method is invalid"
    }
    const lease: ReleaseMergeLease = {
      repo: receipt.slug,
      base_branch: options.base_branch,
      base_oid: receipt.pin_sha,
      candidate_pr: receipt.merge_lease_candidate_pr,
      candidate_head: receipt.publication.head_oid,
      generation: receipt.merge_lease_generation,
      tag: receipt.tag,
      merge_method: merge_method,
    }
    const landing = observe_release_landing(harness.process, options.repo, lease, unwrap(pull))
    if landing == nil {
      throw "release merge lease could not materialize an exact landing receipt"
    }
    receipt = record_release_landing(receipt, unwrap(landing), harness.clock.date_iso())
    release_watch_receipt_write(
      {fs: harness.fs, random: harness.random},
      options.receipt,
      unwrap(receipt),
    )
  }
  const admission = release_landing_admission(
    receipt.landing,
    fn(oid) { return on_base(
      {env: harness.env, process: harness.process},
      options.repo,
      oid,
      base_ref,
    ) },
  )
  harness.stdio.println(json_stringify_pretty({landing: receipt.landing, admission: admission}))
  if !admission.valid {
    harness.stdio.eprintln("release recovery identity refused: ${admission.reason}")
    return 1
  }
  return 0
}
