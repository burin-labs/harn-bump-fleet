#!/usr/bin/env harn
// Read-only phase-one projection for the typed release-chain contract.
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { release_chain_pending_controls, release_chain_replay } from "lib/release_chain_state"
import { release_chain_reduce } from "lib/release_chain_transition"

pub type ReleaseChainCliOptions = {state_root: string, chain_id: string}

const ARG_SPEC: ParserSpec = {
  name: "release-chain",
  args: [
    {kind: "flag", name: "state_root", long: "--state-root", required: true},
    {kind: "flag", name: "chain_id", long: "--chain-id", required: true},
  ],
}

pub fn parse_release_chain_args(args: list<string>) -> ReleaseChainCliOptions {
  return cli_options<ReleaseChainCliOptions>(ARG_SPEC, args, schema_of(ReleaseChainCliOptions))
}

fn main(harness: Harness) {
  const options = parse_release_chain_args(argv)
  const history = release_chain_replay(harness.fs, options.state_root, options.chain_id)
  if len(history) == 0 {
    throw "release chain has no durable receipt history"
  }
  const latest = history.find({ receipt -> receipt.revision == len(history) - 1 })
  if latest == nil {
    throw "release chain history has no latest revision"
  }
  const controls = release_chain_pending_controls(harness.fs, options.state_root, latest)
  const decision = release_chain_reduce(latest, nil, controls)
  harness.stdio.log(
    json_stringify(
      {
        mode: "read_only",
        dispatch_authority: false,
        history_count: len(history),
        receipt: latest,
        decision: decision,
      },
    ),
  )
}
