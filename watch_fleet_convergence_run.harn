#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { plan_fleet_dispatch } from "lib/fleet_dispatch"
import { read_fleet_manifest } from "lib/fleet_manifest"
import { wait_fleet_workflow_run } from "lib/fleet_workflow_run"

type Options = {
  target: string,
  run_id: int,
  run_url: string,
  timeout_s: int,
  interval_s: int,
  only: string,
}

const ARG_SPEC: ParserSpec = {
  name: "watch-fleet-convergence-run",
  args: [
    {kind: "positional", name: "target", required: true},
    {kind: "flag", name: "run_id", long: "--run-id", parse: "int", required: true},
    {kind: "flag", name: "run_url", long: "--run-url", required: true},
    {kind: "flag", name: "timeout_s", long: "--timeout-s", parse: "int", default: 10800},
    {kind: "flag", name: "interval_s", long: "--interval-s", parse: "int", default: 30},
    {kind: "flag", name: "only", long: "--only", default: ""},
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if options.run_id < 1 || options.timeout_s < 1 || options.interval_s < 1 {
    throw "fleet run ID, timeout, and interval must be positive"
  }
  const plan = plan_fleet_dispatch(read_fleet_manifest(harness.fs), options.target, options.only)
  const receipt = wait_fleet_workflow_run(
    harness,
    plan.target,
    plan.scope,
    options.run_id,
    options.run_url,
    options.timeout_s,
    options.interval_s,
  )
  harness.stdio.println(json_stringify_pretty(receipt))
  return if receipt.status == "completed" && receipt.conclusion == "success" {
    0
  } else {
    1
  }
}
