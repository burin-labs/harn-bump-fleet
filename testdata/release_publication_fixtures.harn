import { ReleaseArchiveReadback } from "../lib/release_archive_observation"
import { release_harness_root } from "../lib/release_paths"

type PublicReadbackFixture = {rows: list<ReleaseArchiveReadback>}

/** Normalize the retained measured-byte fixture at its owning test boundary. */
pub fn release_public_readbacks(
  fs: HarnessFs,
  sidecars: bool = false,
) -> list<ReleaseArchiveReadback> {
  const name = if sidecars {
    "release-controller-157-sidecar-readbacks.json"
  } else {
    "release-controller-157-readbacks.json"
  }
  const document = json_parse(
    fs.read_text(path_join(release_harness_root(fs), "tests/fixtures", name)),
  )
  return schema_expect(document, PublicReadbackFixture).rows
}
