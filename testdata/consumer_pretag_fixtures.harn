/**
 * Shared scaffolding for the consumer pre-tag gate suites.
 *
 * Lifted out of `tests/consumer_pretag_dispatch.harn` so a sibling suite can
 * drive the same adapter without a second copy of it. A duplicated fixture
 * drifts from the one it was copied from, and the two then disagree about
 * what the gate does while both stay green.
 */
import {
  ConsumerPretagGateAdapter,
  ConsumerPretagGatePolicy,
  ConsumerPretagRunRow,
} from "../lib/consumer_pretag_dispatch"
import { ConsumerPretagGateTarget } from "../lib/consumer_pretag_gate"

pub const FAST: ConsumerPretagGatePolicy = {poll_interval_ms: 1, deadline_ms: 50}

pub const REVISION = "1234567890abcdef1234567890abcdef12345678"

pub const OTHER_REVISION = "fedcba9876543210fedcba9876543210fedcba98"

pub fn target(slug: string = "owner/consumer") -> ConsumerPretagGateTarget {
  return {
    slug: slug,
    workflow: "candidate-gate.yml",
    version: "v0.10.130",
    revision: REVISION,
    inputs: {source_revision: REVISION},
  }
}

pub fn row(
  id: int,
  status: string,
  conclusion: string,
  title: string = "",
) -> ConsumerPretagRunRow {
  return {
    id: id,
    head_sha: REVISION,
    status: status,
    conclusion: conclusion,
    html_url: "https://runs.test/${to_string(id)}",
    display_title: if title == "" {
      "Harn candidate v0.10.130 @ ${REVISION}"
    } else {
      title
    },
  }
}

pub fn adapter(
  sequence: list<ConsumerPretagRunRow>,
  overrides: dict = {},
) -> ConsumerPretagGateAdapter {
  let cursor = 0
  let clock = 0
  let dispatched = false
  const base: dict = {
    consumer_revision: fn(_target) { return Ok(REVISION) },
    dispatch: fn(_target) {
      dispatched = true
      return Ok({run_id: 11, head_sha: REVISION})
    },
    runs: fn(_target) { return Ok(
      if dispatched {
        [row(11, "queued", "")]
      } else {
        []
      },
    ) },
    run: fn(_target, _run_id) {
      const answer = sequence[cursor] ?? sequence[len(sequence) - 1]
      cursor = cursor + 1
      return Ok(answer ?? row(11, "completed", "success"))
    },
    wait: fn(ms) { clock = clock + ms },
    now_ms: fn() {
      clock = clock + 1
      return clock
    },
  }
  return schema_expect(base + overrides, ConsumerPretagGateAdapter)
}
