import { release_owner_guard_acquire } from "../lib/release_owner_guard"

pipeline main() {
  require len(argv) == 1, "usage: release_owner_guard_holder.harn OWNER_PATH"
  const owner_path = argv[0]
  const owner = release_owner_guard_acquire(
    harness,
    {
      repo: "/tmp/harn-owner-guard-holder",
      base: "main",
      mode: "ship-pr",
      bump: "patch",
      yes_live_release: true,
      mock: false,
      pin_sha: "holder-pin",
      owner_guard_path: owner_path,
      owner_guard_ttl_ms: 60000,
    },
    {current_version: "0.0.0", next_version: "0.0.1"},
    "holder-run",
  )
  harness.stdio.println(json_stringify(owner))
  sleep(duration_seconds(30))
  return 0
}
