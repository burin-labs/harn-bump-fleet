.DS_Store
.harn/
.harn-runs/
.harn-tools/
.benchmarks/
.burin/
.fleet/

# Local-only env files for scripts/with_env.sh — never commit secrets.
.env
.env.local
.env.*.local

# .claude/ is local-only (settings, worktree state, scheduled tasks).
# Mirrors the pattern in burin-labs/harn — `.claude/commands/` is the
# carve-out for shared skill definitions if any are added later.
.claude/*
!.claude/commands/
