#!/usr/bin/env harn
import { git_run } from "std/git"
import {
  workflow_checkout_census,
  workflow_checkout_violation_lines,
} from "lib/workflow_checkout_policy"

/**
 * Refuse any workflow checkout in this repository that keeps its credential.
 *
 * A persisted credential writes an `include.path` into `.git/config` pointing
 * at a `$RUNNER_TEMP` file. Git treats an unreadable include as fatal, so a
 * later step reading git from a different temp root or under a sandbox fails
 * on configuration instead of on its own work. Jobs that genuinely have to
 * push arm a credential helper explicitly, which is a transport concern and
 * survives this setting.
 *
 * The census refuses on an empty inventory and on an undecodable workflow, not
 * only on a violation, because those are the two ways this check could report
 * a clean repository while having measured nothing.
 */
pipeline main(harness: Harness) {
  const inventory = git_run(harness.process, ["ls-files", "-z", ".github/workflows/*.yml"])
  if !inventory.ok {
    harness.stdio.eprintln(
      "workflow checkout credentials: could not inventory workflows: ${inventory.combined}",
    )
    return 1
  }
  let sources: list<{path: string, source: string}> = []
  for entry in split(inventory.stdout, "\0") {
    const path = trim(entry)
    if path == "" {
      continue
    }
    sources = sources.push({path: path, source: harness.fs.read_text(path)})
  }
  const census = workflow_checkout_census(sources)
  if !census.ok {
    for line in workflow_checkout_violation_lines(census) {
      harness.stdio.eprintln("workflow checkout credentials: ${line}")
    }
    return 1
  }
  harness.stdio.println(
    "workflow checkout credentials: ${len(census.measured)} checkouts across "
      + "${len(sources)} workflows, all persist-credentials false",
  )
  return 0
}
