#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { import_hosted_candidate_archive_receipt } from "lib/hosted_candidate_archive_receipt"

type Options = {hosted_run_id: int, candidate_archive_run_id: int, receipt_out: string}

const ARG_SPEC: ParserSpec = {
  name: "restore-hosted-candidate-archive-receipt",
  args: [
    {kind: "flag", name: "hosted_run_id", long: "--hosted-run-id", parse: "int", required: true},
    {
      kind: "flag",
      name: "candidate_archive_run_id",
      long: "--candidate-archive-run-id",
      parse: "int",
      required: true,
    },
    {kind: "flag", name: "receipt_out", long: "--receipt-out", required: true},
  ],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const receipt = import_hosted_candidate_archive_receipt(
    harness,
    {
      repo_root: harness.fs.cwd(),
      hosted_run_id: options.hosted_run_id,
      candidate_archive_run_id: options.candidate_archive_run_id,
      destination: options.receipt_out,
    },
  )
  harness.stdio.println(json_stringify_pretty(receipt))
}
