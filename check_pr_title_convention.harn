#!/usr/bin/env harn
import { git_run } from "std/git"
import { github_file_text_at_ref_result } from "lib/github"
import {
  HARN_PR_AREAS,
  HARN_PR_GATES_WORKFLOW_PATH,
  PR_TITLE_SITES,
  harn_declared_pr_areas,
  harn_pr_area_drift,
  pr_title_file_opens_pull_request,
  pr_title_unregistered_paths,
  pr_title_violations,
} from "lib/pr_title_convention"

const HARN_SLUG = "burin-labs/harn"

/**
 * Refuse a pull-request title this repository opens that its target's required
 * title gate would reject, and refuse a pull-request call site that
 * `lib/pr_title_convention.harn` does not name.
 *
 * Three ways this census refuses rather than passes, because each of them is a
 * way a scan can look green while proving nothing: it observed no call site at
 * all, it could not read the areas harn declares, or the areas it carries
 * differ from the ones harn declares.
 */
pipeline main(harness: Harness) {
  const inventory = git_run(harness.process, ["ls-files", "-z", "*.harn"])
  if !inventory.ok {
    harness.stdio.eprintln(
      "pr title convention: could not inventory sources: ${inventory.combined}",
    )
    return 1
  }
  let observed: list<string> = []
  for path in split(inventory.stdout, "\0") {
    const name = trim(path)
    if name == "" || starts_with(name, "tests/") || starts_with(name, "tests-risky/") {
      continue
    }
    if pr_title_file_opens_pull_request(harness.fs.read_text(name)) {
      observed = observed.push(name)
    }
  }
  if len(observed) == 0 {
    harness.stdio.eprintln(
      "pr title convention: the census observed no pull-request call site at all, "
        + "so it proved nothing. Check PR_OPEN_CALLS against lib/github.harn.",
    )
    return 1
  }
  const workflow = github_file_text_at_ref_result(
    harness,
    HARN_SLUG,
    HARN_PR_GATES_WORKFLOW_PATH,
    "main",
  )
  if is_err(workflow) {
    harness.stdio.eprintln(
      "pr title convention: could not read ${HARN_SLUG} ${HARN_PR_GATES_WORKFLOW_PATH}: "
        + to_string(unwrap_err(workflow))
        + ". The pinned area list is unverified, so this census refuses rather "
        + "than assume it still agrees.",
    )
    return 1
  }
  const declared = harn_declared_pr_areas(unwrap(workflow) ?? "")
  if declared == nil {
    harness.stdio.eprintln(
      "pr title convention: ${HARN_SLUG} ${HARN_PR_GATES_WORKFLOW_PATH} declares no "
        + "`areas:` input. An unreadable declaration is not agreement.",
    )
    return 1
  }
  const drift = harn_pr_area_drift(declared ?? [])
  const unregistered = pr_title_unregistered_paths(observed, PR_TITLE_SITES)
  const violations = pr_title_violations(PR_TITLE_SITES)
  for line in drift {
    harness.stdio.eprintln(
      "pr title convention: ${line}. Update HARN_PR_AREAS in lib/pr_title_convention.harn.",
    )
  }
  for path in unregistered {
    harness.stdio.eprintln(
      "${path} opens a pull request that lib/pr_title_convention.harn does not name. "
        + "Add it to PR_TITLE_SITES with the title it renders.",
    )
  }
  for violation in violations {
    harness.stdio.eprintln(
      "${violation.path} (${violation.symbol}) opens a pull request titled "
        + "\"${violation.sample}\": ${violation.reason}",
    )
  }
  if len(drift) > 0 || len(unregistered) > 0 || len(violations) > 0 {
    return 1
  }
  harness.stdio.println(
    "pr title convention: ${len(observed)} call site(s), "
      + "${len(PR_TITLE_SITES)} registered title(s), "
      + "${len(HARN_PR_AREAS)} area(s) matching ${HARN_SLUG}, 0 refused",
  )
  return 0
}
