#!/usr/bin/env harn
import { resolve_projects_root } from "lib/agent_guidance"
import { FleetRepository, read_fleet_manifest } from "lib/fleet_manifest"
import { PackageCiSyncResult, sync_package_ci_repo } from "lib/package_ci_projection"
import { parse_sync_options, sync_target_matches } from "lib/sync_options"

fn selected_repositories(
  repositories: list<FleetRepository>,
  only: string?,
) -> list<FleetRepository> {
  return repositories.filter(
    { repo ->
      repo.package_ci_ownership == "fleet"
        && sync_target_matches(repo.slug, repo.directory, only)
    },
  )
    .to_list()
}

fn report_result(stdio: HarnessStdio, result: PackageCiSyncResult) {
  if result.status == "error" {
    stdio.eprintln("error ${result.slug}: ${result.error ?? "unknown error"}")
  } else {
    stdio.println("${result.status} ${result.slug}: ${result.path}")
  }
}

pipeline main(harness: Harness) -> int {
  const options = parse_sync_options(argv)
  const manifest = read_fleet_manifest(harness.fs, options.manifest)
  const root = resolve_projects_root(
    options.root ?? manifest.fleet.default_root,
    harness.env.get("HOME") ?? "",
  )
  const repositories = selected_repositories(manifest.repositories, options.only)
  if len(repositories) == 0 {
    throw "no fleet-owned package CI repository matched --only ${options.only ?? ""}"
  }
  let failed = false
  for repo in repositories {
    const result = sync_package_ci_repo(harness.fs, manifest, repo, root, options.apply)
    report_result(harness.stdio, result)
    if result.status == "drift" || result.status == "error" {
      failed = true
    }
  }
  return if failed {
    1
  } else {
    0
  }
}
