import {
  github_actions_run,
  github_enable_auto_merge,
  github_file_text_at_ref,
  github_latest_release_tag,
  github_pr_close,
  github_pr_comment,
  github_pr_list,
  github_release_at_tag,
  github_workflow_dispatch,
} from "lib/github"
import {
  cost_budget_audit_line,
  install_cost_budget,
  planner_defaults,
  retrying_llm_caller,
} from "lib/llm_defaults"
import { run_chat_loop } from "lib/post_run_chat"
import {
  public_surface_impact_for_repo,
  public_surface_impact_for_repos,
  public_surface_impact_markdown,
  public_surface_impact_report_from_surfaces,
  public_surface_release_diff,
} from "lib/public_surface_impact"
import { harn_release_readiness, release_readiness_detail } from "lib/release_readiness"
import { FleetAuditReceipt, fleet_audit_receipt_write } from "lib/run_receipts"
import {
  RunSessionViewFleetGate,
  run_session_view_downstream_markdown,
  run_session_view_fleet_gate,
} from "lib/run_session_view_gate"
import { ensure_unrestricted_sandbox } from "lib/sandbox_preflight"
import { timing_artifacts } from "lib/timing_report"

const BUMP_BRANCH = "automation/bump-harn-runtime"

const HARN_REPO = "burin-labs/harn"

const DEFAULT_HARN_REPO_PATH = path_join(env_str("HOME") ?? "", "projects/harn")

const POLL_INTERVAL_MS = 15000

const POST_RUN_SETTLE_MS = 90 * 1000

const POST_RUN_SETTLE_POLL_MS = 5000

const MAX_POLL_MS = 30 * 60 * 1000

const PARALLEL_LIMIT = 4

const RELEASE_READINESS_POLL_MS = 15 * 1000

const RELEASE_READINESS_MAX_MS = 45 * 60 * 1000

// Keep summary and tool-capable chat routing aligned with release_harn.
// HARN_BUMP_FLEET_MODEL / HARN_BUMP_FLEET_PROVIDER override shared defaults.
const __BUMP_FLEET_DEFAULT = planner_defaults("HARN_BUMP_FLEET")

const SUMMARY_MODEL = env_str("HARN_BUMP_FLEET_MODEL") ?? __BUMP_FLEET_DEFAULT.model

const SUMMARY_PROVIDER = env_str("HARN_BUMP_FLEET_PROVIDER") ?? __BUMP_FLEET_DEFAULT.provider

pub type FleetOptions = {
  target?: string,
  dry_run: bool,
  only?: string,
  no_chat: bool,
  chat_only: bool,
  chat_run: string,
  chat_timeout_s: int,
  retry_failed: int,
  harn_repo: string,
}

const ARG_SPEC: ParserSpec = {
  name: "bump-fleet",
  args: [
    {kind: "positional", name: "target", required: false},
    {kind: "switch", name: "dry_run", long: "--dry-run"},
    {kind: "flag", name: "only", long: "--only"},
    {kind: "switch", name: "no_chat", long: "--no-chat"},
    {kind: "switch", name: "chat_only", long: "--chat-only"},
    {kind: "flag", name: "chat_run", long: "--chat-run", default: ""},
    {kind: "flag", name: "chat_timeout_s", long: "--chat-timeout-s", parse: "int", default: 60},
    {kind: "flag", name: "retry_failed", long: "--retry-failed", parse: "int", default: 0},
    {kind: "flag", name: "harn_repo", long: "--harn-repo", default: DEFAULT_HARN_REPO_PATH},
  ],
}

pub fn parse_fleet_args(args: list<string>) -> FleetOptions {
  let parsed = cli_options<FleetOptions>(ARG_SPEC, args, schema_of(FleetOptions))
  if parsed.retry_failed < 0 {
    parsed.retry_failed = 0
  }
  return parsed
}

const BUMP_CHAT_ARGV_PREFIXES = [
  ["git", "status"],
  ["git", "diff"],
  ["git", "log"],
  ["git", "show"],
  ["git", "branch"],
  ["git", "rev-parse"],
  ["gh", "pr", "list"],
  ["gh", "pr", "view"],
  ["gh", "pr", "checks"],
  ["gh", "run", "list"],
  ["gh", "run", "view"],
  ["gh", "workflow", "list"],
  ["gh", "workflow", "view"],
  ["gh", "release", "list"],
  ["gh", "release", "view"],
  ["rg"],
  ["grep"],
  ["head"],
  ["tail"],
  ["cat"],
  ["ls"],
  ["test"],
]

fn bump_chat_tools() {
  return agent_host_tools(
    nil,
    {
      root: cwd(),
      cwd: cwd(),
      max_inline_bytes: 12000,
      read_bytes: 12000,
      tail_bytes: 12000,
      search_max_matches: 120,
      exclude_globs: [".git/**", "target/**"],
      allow_argv_prefixes: BUMP_CHAT_ARGV_PREFIXES,
      names: {
        read_file: "fleet_read",
        read_file_tail: "fleet_read_tail",
        search_files: "fleet_search",
        git_inspect: "fleet_git",
        run_command: "fleet_run",
        read_command_output: "fleet_run_output",
        read_command_output_tail: "fleet_run_tail",
        edit_file: "fleet_edit_file",
        write_file: "fleet_write_file",
      },
      descriptions: {
        read_file:
          "Read a UTF-8 file under the harn-bump-fleet repo by repo-relative path. Prefer bounded reads with limit_bytes.",
        search_files:
          "Search harn-bump-fleet repo contents. Provide a pattern; use path/glob only to narrow the search.",
        git_inspect:
          "Inspect git status, diff, log, show, blame, branches, or remotes without mutating the repo.",
        run_command:
          "Run one bounded read-only inspection command from the harn-bump-fleet repo. Pass argv as an array of strings.",
        edit_file:
          "Apply an exact-text edit to a tracked file in harn-bump-fleet. The operator authorized chat-side edits.",
        write_file:
          "Overwrite a tracked file in harn-bump-fleet. Prefer edit_file for small edits.",
      },
      output_format: "json",
    },
  )
}

fn skipped_run_session_view_gate(target: string, reason: string) -> RunSessionViewFleetGate {
  return {
    ok: true,
    skipped: true,
    check: {
      name: "check-run-view-fixtures",
      command: "(skipped)",
      success: true,
      ok: true,
      status: "completed",
      exit_code: 0,
      stdout: "",
      stderr: "",
    },
    cargo_target_dir: "",
    metadata_ok: true,
    expected_json_count: 0,
    parse_errors: [],
    schemas: [],
    summary_line: reason,
    repo_version: "",
    target_version: strip_v(target ?? ""),
    target_change: {
      known: false,
      changed: false,
      base_tag: "",
      target_tag: target,
      paths: [],
      detail: reason,
    },
  }
}

fn bump_chat_only(harness: Harness, parsed) {
  if !chat_enabled(parsed) {
    harness.stdio.eprintln("--chat-only requires an interactive terminal (and HARN_CHAT != 0)")
    return 2
  }
  const kind = "bump-fleet"
  const target_dir = if trim(parsed.chat_run ?? "") != "" {
    resolve_chat_run_path(harness, kind, parsed.chat_run)
  } else {
    const pick = pick_recent_run(harness, kind, 12)
    if pick == nil {
      nil
    } else {
      pick.dir
    }
  }
  if target_dir == nil {
    harness.stdio.println("(no run selected; exiting)")
    return 0
  }
  const chat_cfg = chat_cfg_from_run_dir(
    harness,
    {
      provider: SUMMARY_PROVIDER,
      model: SUMMARY_MODEL,
      repo: cwd(),
      mock: false,
      timeout_s: parsed.chat_timeout_s,
      tools: bump_chat_tools(),
      no_chat: parsed.no_chat,
    },
    kind,
    target_dir,
  )
  run_chat_loop(harness, chat_cfg)
  return 0
}

// -------------------------------------------------------------------------------------------------

// Repo discovery is a checked projection of fleet.toml. A declared repository
// that is absent, points at the wrong remote, or loses its dispatch adapter is
// drift and stops the run instead of silently shrinking the fleet.

// -------------------------------------------------------------------------------------------------

fn discover_repos(harness: Harness) {
  const home = harness.env.get_or("HOME", "")
  const manifest = read_fleet_manifest()
  const projects = resolve_fleet_root(manifest.fleet.default_root, home)
  let out = []
  for declared in harn_bump_repositories(manifest) {
    const dir = path_join(projects, declared.directory)
    const workflow = path_join(dir, ".github/workflows/bump-harn.yml")
    if !harness.fs.exists(path_join(dir, ".git")) {
      throw "fleet repository ${declared.slug} is not checked out at ${dir}"
    }
    if !harness.fs.exists(workflow) {
      throw "fleet repository ${declared.slug} is missing ${workflow}"
    }
    const dispatch_probe = bump_workflow_dispatch_probe(harness.fs.read_text(workflow))
    if !dispatch_probe.ok {
      throw "fleet repository ${declared.slug} bump workflow contract failed: ${dispatch_probe.reason}"
    }
    const slug_probe = shell_at(dir, "git remote get-url origin 2>/dev/null")
    if !slug_probe.success {
      throw "could not read origin for fleet repository ${declared.slug}"
    }
    const slug = remote_url_to_slug(trim(slug_probe.stdout))
    if slug != declared.slug {
      throw "fleet repository ${declared.slug} checkout points at ${slug ?? "an invalid remote"}"
    }
    const common_dir_probe = shell_at(dir, "git rev-parse --git-common-dir 2>/dev/null")
    if !common_dir_probe.success {
      throw "could not resolve git common dir for fleet repository ${declared.slug}"
    }
    const raw_common = trim(common_dir_probe.stdout)
    const common = if starts_with(raw_common, "/") {
      raw_common
    } else {
      "${dir}/${raw_common}"
    }
    out = out + [{dir: dir, slug: declared.slug, common_dir: common}]
  }
  return out
}

// Pre-pin readback — best-effort current version per repo, for the audit.

// -------------------------------------------------------------------------------------------------

/**
 * Returns `{pin, evidence}` where `pin` is the bare "X.Y.Z" string with any
 * leading "v" stripped, matching the canonical form of
 * `read_remote_pin_probe_at_ref`. Keeping local and remote pins in the same
 * shape avoids asymmetric audit rows and stops the read-only summary LLM from
 * hallucinating drift over a cosmetic `v` prefix.
 */
fn read_pre_pin_probe(harness: Harness, dir) {
  const candidates = [".harn-version"]
  for f in candidates {
    const path = "${dir}/${f}"
    if harness.fs.exists(path) {
      return harn_version_pin_probe(harness.fs.read_text(path))
    }
  }
  // Try parsing exact Harn Cargo deps on harn-cloud-style repos.
  const cargo = "${dir}/Cargo.toml"
  if harness.fs.exists(cargo) {
    return cargo_harn_pin_probe(harness.fs.read_text(cargo))
  }
  return {pin: nil, evidence: "no .harn-version or Cargo.toml pin surface found"}
}

fn read_pre_pin(harness: Harness, dir) {
  return read_pre_pin_probe(harness, dir).pin
}

// -------------------------------------------------------------------------------------------------

// Per-repo bump pipeline. Dispatch the workflow, poll for completion, locate
// the resulting PR, ensure auto-merge is enabled.

// -------------------------------------------------------------------------------------------------

fn base_outcome_fields(repo, local_pin, remote_pin) {
  return {
    dir: repo.dir,
    slug: repo.slug,
    run_id: nil,
    run_url: nil,
    pr_number: nil,
    pr_url: nil,
    pre_pin: local_pin ?? remote_pin,
    local_pin: local_pin,
    remote_pin: remote_pin,
    auto_merge: nil,
    duration_ms: 0,
  }
}

fn make_outcome(repo, local_pin, remote_pin) {
  return base_outcome_fields(repo, local_pin, remote_pin) + {status: "pending", detail: ""}
}

fn bump_span_status(outcome) {
  return if bump_summary_problem_outcome(outcome) {
    "error"
  } else {
    "ok"
  }
}

fn timed_bump_phase(name, attrs, callback) {
  const handle = start_timing(name, attrs)
  try {
    const outcome = callback()
    end_timing(handle, {status: bump_span_status(outcome), outcome: outcome.status ?? ""})
    return outcome
  } catch (e) {
    end_timing(handle, {status: "error", outcome: "exception", error: to_string(e)})
    throw e
  }
}

fn timed_bump_outcome(name, attrs, callback) {
  const handle = start_timing(name, attrs)
  try {
    const outcome = callback()
    const timing = end_timing(
      handle,
      {status: bump_span_status(outcome), outcome: outcome.status ?? ""},
    )
    return outcome + {duration_ms: timing.duration_ms}
  } catch (e) {
    end_timing(handle, {status: "error", outcome: "exception", error: to_string(e)})
    throw e
  }
}

/**
 * Whether an outcome status implies the script actually kicked a workflow
 * run for that repo (vs. resolving via probes only). Used to drive the
 * "dispatched: N" counter in the audit summary.
 */
fn dispatched_status(s) {
  return starts_with(s, "run_") || s == "dispatch_failed" || s == "pr_open"
    || s
    == "already_current_post_run"
}

/**
 * Probe the version pinned on origin/main by reading the canonical connector surface.
 * Tries .harn-version first (most repos), falls back to exact
 * Harn Cargo pins (harn-cloud). Returns `{pin, evidence}` where `pin` is the
 * bare "X.Y.Z" string with any leading "v" already stripped, or nil.
 */
fn read_remote_pin_probe_at_ref(harness: Harness, slug, ref) {
  const hv = github_file_text_at_ref(harness, slug, ".harn-version", ref)
  if hv != nil && trim(hv) != "" {
    return harn_version_pin_probe(hv)
  }
  const cargo = github_file_text_at_ref(harness, slug, "Cargo.toml", ref)
  if cargo != nil && trim(cargo) != "" {
    return cargo_harn_pin_probe(cargo)
  }
  return {pin: nil, evidence: "no .harn-version or Cargo.toml pin surface found at ${ref}"}
}

fn read_remote_pin_at_ref(harness: Harness, slug, ref) {
  return read_remote_pin_probe_at_ref(harness, slug, ref).pin
}

fn read_remote_pin(harness: Harness, slug) {
  return read_remote_pin_at_ref(harness, slug, "main")
}

/** Idempotently arm auto-merge under the PR head observed by the preceding read. */
fn ensure_auto_merge(harness: Harness, slug, pr) {
  const result = github_enable_auto_merge(harness, slug, pr.number, pr.head.sha)
  return if is_err(result) {
    "failed: " + to_string(unwrap_err(result))
  } else {
    unwrap(result).state
  }
}

fn local_harn_changelog_section(target, harn_repo) {
  const result = command_run(
    {
      argv: ["git", "show", "${target}:CHANGELOG.md"],
      cwd: harn_repo,
      capture: {max_inline_bytes: 256000},
    },
    {timeout_ms: 30000},
  )
  if !(result?.success ?? false) {
    return {
      status: "local_changelog_unavailable",
      detail: trim(to_string(result?.stderr ?? result?.stdout ?? "git show failed")),
      body: "",
    }
  }
  const section = changelog_find_section(result.stdout ?? "", target)
  const body = is_ok(section) ? unwrap(section).body : ""
  if trim(body) == "" {
    return {
      status: "local_changelog_section_missing",
      detail: "CHANGELOG.md at ${target} did not contain a ## ${target} section",
      body: "",
    }
  }
  return {status: "local_tag_changelog", detail: "CHANGELOG.md section at ${target}", body: body}
}

fn release_public_surface_analysis(harness: Harness, target, harn_repo) {
  const empty = {
    changelog_section: "",
    changelog_unreleased_section: "",
    diff_names: "",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
    public_surface_diff: "",
  }
  let evidence_parts = []
  let source_statuses = []
  let source_details = []
  const local_changelog = local_harn_changelog_section(target, harn_repo)
  if trim(local_changelog.body) != "" {
    evidence_parts = evidence_parts + [local_changelog.body]
    source_statuses = source_statuses + [local_changelog.status]
    source_details = source_details + [local_changelog.detail]
  }
  const release_diff = public_surface_release_diff(target, harn_repo)
  if release_diff.known {
    source_statuses = source_statuses + [release_diff.status]
    source_details = source_details + [release_diff.detail]
  } else {
    source_details = source_details + ["Git release diff unavailable: " + release_diff.detail]
  }
  const lookup = try {
    github_release_at_tag(harness, HARN_REPO, target)
  } catch (e) {
    return {
      status: if len(source_statuses) == 0 {
        "release_lookup_failed"
      } else {
        join(source_statuses, "+")
      },
      detail: join(source_details + ["GitHub release lookup failed: " + to_string(e)], "; "),
      analysis: {
        ...empty,
        changelog_section: join(evidence_parts, "\n\n"),
        public_surface_diff: release_diff.patch,
      },
    }
  }
  if is_err(lookup) {
    return {
      status: if len(source_statuses) == 0 {
        "release_lookup_failed"
      } else {
        join(source_statuses, "+")
      },
      detail: join(
        source_details + ["GitHub release lookup failed: " + to_string(unwrap_err(lookup))],
        "; ",
      ),
      analysis: {
        ...empty,
        changelog_section: join(evidence_parts, "\n\n"),
        public_surface_diff: release_diff.patch,
      },
    }
  }
  const found = unwrap(lookup)
  if !(found?.found ?? false) {
    return {
      status: if len(source_statuses) == 0 {
        "release_not_found"
      } else {
        join(source_statuses, "+")
      },
      detail: join(source_details + ["GitHub release ${target} was not found"], "; "),
      analysis: {
        ...empty,
        changelog_section: join(evidence_parts, "\n\n"),
        public_surface_diff: release_diff.patch,
      },
    }
  }
  const release = found.release ?? {}
  if trim(release.body ?? "") != "" {
    evidence_parts = evidence_parts + [release.body]
    source_statuses = source_statuses + ["github_release_notes"]
    source_details = source_details + ["GitHub release body for ${target}"]
  }
  return {
    status: if len(source_statuses) == 0 {
      "release_notes_empty"
    } else {
      join(source_statuses, "+")
    },
    detail: if len(source_details) == 0 {
      "no changelog or release-note evidence found for ${target}"
    } else {
      join(source_details, "; ")
    },
    analysis: {
      ...empty,
      changelog_section: join(evidence_parts, "\n\n"),
      public_surface_diff: release_diff.patch,
    },
  }
}

fn public_surface_impact_scan(harness: Harness, target, repos, harn_repo) {
  const source = release_public_surface_analysis(harness, target, harn_repo)
  const base = public_surface_impact_for_repos(target, source.analysis, repos)
  return {...base, source_status: source.status, source_detail: source.detail}
}

fn skipped_public_surface_impact(target, reason) {
  return public_surface_impact_report_from_surfaces(target, [], [], "skipped", reason)
}

fn annotate_bump_pr_with_view_metadata(
  harness: Harness,
  slug,
  pr_number,
  target,
  view_gate,
  public_surface_impact,
) {
  const repo_impact = public_surface_impact_for_repo(public_surface_impact, slug)
  const body = run_session_view_downstream_markdown(target, view_gate)
    + "\n\n"
    + public_surface_impact_markdown(target, repo_impact)
  const result = github_pr_comment(harness, slug, pr_number, body)
  return if is_err(result) {
    {success: false, detail: "metadata comment failed: " + to_string(unwrap_err(result))}
  } else {
    {success: true, detail: "run/session view and public-surface metadata comment posted"}
  }
}

fn close_stale_pr(harness: Harness, slug, pr, target, evidence) {
  const msg =
    "Closing stale Harn runtime bump PR: this fleet run targets ${target}, but ${evidence}."
  const result = github_pr_close(harness, slug, pr.number, msg)
  return if result.ok {
    "closed stale PR #${pr.number}"
  } else {
    "failed to close stale PR #${pr.number}: " + to_string(result.error)
  }
}

fn finish_outcome(base, fields) {
  return base + fields
}

fn already_current_outcome(base, remote_pin, existing_pr) {
  const pr_n = if existing_pr == nil {
    nil
  } else {
    existing_pr.number
  }
  const pr_u = if existing_pr == nil {
    nil
  } else {
    existing_pr.url
  }
  return finish_outcome(
    base,
    {
      status: "already_current",
      detail: "remote main pin is ${remote_pin}; matches target"
        + local_pin_drift_detail(
        base,
        remote_pin,
      ),
      pr_number: pr_n,
      pr_url: pr_u,
    },
  )
}

fn targeted_pr_outcome(harness: Harness, base, slug, target, pr, view_gate, public_surface_impact) {
  const annotated = annotate_bump_pr_with_view_metadata(
    harness,
    slug,
    pr.number,
    target,
    view_gate,
    public_surface_impact,
  )
  if !annotated.success {
    return finish_outcome(
      base,
      {
        status: "pr_open_for_target_schema_metadata_failed",
        detail: "PR #${pr.number} already targets ${target}; " + annotated.detail,
        pr_number: pr.number,
        pr_url: pr.url,
        auto_merge: nil,
      },
    )
  }
  const am = if pr.auto_merge_armed {
    "already_enabled"
  } else {
    ensure_auto_merge(harness, slug, pr)
  }
  const final_status = if starts_with(am, "failed") {
    "pr_open_for_target_auto_merge_failed"
  } else {
    "pr_open_for_target"
  }
  return finish_outcome(
    base,
    {
      status: final_status,
      detail: "PR #${pr.number} already targets ${target}; " + annotated.detail
        + "; auto-merge: ${am}",
      pr_number: pr.number,
      pr_url: pr.url,
      auto_merge: am,
    },
  )
}

fn predispatch_resolution(
  harness: Harness,
  repo,
  base,
  target,
  target_no_v,
  remote_pin,
  view_gate,
  public_surface_impact,
) {
  const existing_pr = find_existing_pr(harness, repo.slug)
  const existing_probe = if existing_pr == nil {
    nil
  } else {
    pr_target_probe(harness, repo.slug, existing_pr, target)
  }
  if remote_pin != nil && remote_pin == target_no_v {
    return {
      done: true,
      outcome: already_current_outcome(base, remote_pin, existing_pr),
      stale_note: "",
    }
  }
  if existing_pr != nil && existing_probe.matches {
    return {
      done: true,
      outcome: targeted_pr_outcome(
        harness,
        base,
        repo.slug,
        target,
        existing_pr,
        view_gate,
        public_surface_impact,
      ),
      stale_note: "",
    }
  }
  if existing_pr != nil {
    const closed = close_stale_pr(harness, repo.slug, existing_pr, target, existing_probe.evidence)
    if starts_with(closed, "failed") {
      return {
        done: true,
        stale_note: "",
        outcome: finish_outcome(
          base,
          {
            status: "stale_pr_close_failed",
            detail: closed,
            pr_number: existing_pr.number,
            pr_url: existing_pr.url,
          },
        ),
      }
    }
    return {done: false, outcome: nil, stale_note: closed + "; "}
  }
  return {done: false, outcome: nil, stale_note: ""}
}

fn dispatch_bump_workflow(harness: Harness, repo, base, target) {
  const dispatch = github_workflow_dispatch(harness, repo.slug, "bump-harn.yml", {version: target})
  if is_err(dispatch) {
    return finish_outcome(
      base,
      {status: "dispatch_failed", detail: to_string(unwrap_err(dispatch))},
    )
  }
  const accepted = unwrap(dispatch)
  const polled = poll_exact_workflow_run(harness, repo.slug, accepted.run_id)
  return if polled.status != "completed" {
    {
      ...base,
      run_id: accepted.run_id,
      run_url: accepted.url,
      status: "run_in_progress",
      detail: "workflow still ${polled.status} after ${MAX_POLL_MS / 1000}s",
    }
  } else {
    {
      ...base,
      run_id: accepted.run_id,
      run_url: accepted.url,
      status: "run_${polled.conclusion}",
      detail: "workflow concluded ${polled.conclusion}",
    }
  }
}

fn classify_post_dispatch(harness: Harness, slug, target, target_no_v, run_outcome, stale_note) {
  const post = wait_for_post_dispatch_state(harness, slug, target)
  const pr = post.pr
  const post_remote = post.remote_pin
  const outcome = if pr == nil {
    const same = post_remote != nil && post_remote == target_no_v
    const remote_label = post_remote ?? "unknown"
    {
      ...run_outcome,
      status: if run_outcome.status == "run_success" && same {
        "already_current_post_run"
      } else if run_outcome.status == "run_success" {
        "run_success_no_target_change"
      } else {
        run_outcome.status
      },
      detail: stale_note + "${run_outcome.detail}; no open PR"
        + if same {
        " (remote pin now ${post_remote}, matches target)"
      } else {
        " (remote pin ${remote_label} does not match target ${target_no_v})"
      },
    }
  } else {
    const probe = post.pr_probe
    {
      ...run_outcome,
      pr_number: pr.number,
      pr_url: pr.url,
      status: if run_outcome.status == "run_success" && probe.matches {
        "pr_open"
      } else if run_outcome.status == "run_success" {
        "stale_pr_after_run"
      } else {
        run_outcome.status
      },
      detail: stale_note
        + "${run_outcome.detail}; PR #${pr.number} on ${pr.head.ref}; ${probe.evidence}",
    }
  }
  return {outcome: outcome, pr: pr}
}

fn with_auto_merge(harness: Harness, slug, classified, target, view_gate, public_surface_impact) {
  const with_pr = classified.outcome
  const pr = classified.pr
  if pr == nil || with_pr.status == "stale_pr_after_run" {
    return with_pr
  }
  const annotated = annotate_bump_pr_with_view_metadata(
    harness,
    slug,
    pr.number,
    target,
    view_gate,
    public_surface_impact,
  )
  if !annotated.success {
    return {
      ...with_pr,
      status: "pr_open_schema_metadata_failed",
      detail: "${with_pr.detail}; " + annotated.detail,
      auto_merge: nil,
    }
  }
  const am = if pr.auto_merge_armed {
    "already_enabled"
  } else {
    ensure_auto_merge(harness, slug, pr)
  }
  const detail = if starts_with(am, "failed") {
    "${with_pr.detail}; auto-merge: ${am}"
  } else {
    with_pr.detail
  }
  return {...with_pr, auto_merge: am, detail: detail}
}

fn bump_one(harness: Harness, repo, target, dry_run, view_gate, public_surface_impact) {
  return timed_bump_outcome(
    "bump.repo",
    {repo: repo.slug, dry_run: dry_run, target: strip_v(target)},
    { ->
      const pins = timed(
        "bump.repo.preflight",
        {repo: repo.slug},
        { ->
          return {
            remote_pin: read_remote_pin(harness, repo.slug),
            local_pin: read_pre_pin(harness, repo.dir),
          }
        },
      ).result
      const remote_pin = pins.remote_pin
      const local_pin = pins.local_pin
      const base = make_outcome(repo, local_pin, remote_pin)
      const target_no_v = strip_v(target)
      if dry_run {
        const existing_pr = find_existing_pr(harness, repo.slug)
        const existing_probe = if existing_pr == nil {
          nil
        } else {
          pr_target_probe(harness, repo.slug, existing_pr, target)
        }
        return dry_run_predispatch_outcome(
          base,
          target,
          target_no_v,
          remote_pin,
          existing_pr,
          existing_probe,
        )
      }
      const pre = timed(
        "bump.repo.pre_dispatch_resolution",
        {repo: repo.slug},
        { ->
          return predispatch_resolution(
            harness,
            repo,
            base,
            target,
            target_no_v,
            remote_pin,
            view_gate,
            public_surface_impact,
          )
        },
      ).result
      if pre.done {
        return pre.outcome
      }
      const run_outcome = timed_bump_phase(
        "bump.repo.dispatch_workflow",
        {repo: repo.slug},
        { -> return dispatch_bump_workflow(harness, repo, base, target) },
      )
      const classified = timed(
        "bump.repo.post_dispatch_verification",
        {repo: repo.slug},
        { ->
          return classify_post_dispatch(
            harness,
            repo.slug,
            target,
            target_no_v,
            run_outcome,
            pre.stale_note,
          )
        },
      ).result
      return timed_bump_phase(
        "bump.repo.auto_merge",
        {repo: repo.slug},
        { ->
          return with_auto_merge(
            harness,
            repo.slug,
            classified,
            target,
            view_gate,
            public_surface_impact,
          )
        },
      )
    },
  )
}

fn pr_target_probe(harness: Harness, slug, pr, target) {
  const target_no_v = strip_v(target)
  const probe = read_remote_pin_probe_at_ref(harness, slug, pr.head.ref)
  const pin = probe.pin
  if pin == nil {
    return {matches: false, pin: nil, evidence: "PR head pin is unknown: ${probe.evidence}"}
  }
  return {
    matches: pin == target_no_v,
    pin: pin,
    evidence: "PR head pin is ${pin}; target is ${target_no_v}; ${probe.evidence}",
  }
}

fn poll_exact_workflow_run(harness: Harness, slug, run_id) {
  const completed = poll_until(
    fn() {
      const run = github_actions_run(harness, slug, run_id)
      if is_err(run) {
        throw to_string(unwrap_err(run))
      }
      const observed = unwrap(run)
      return if observed.status == "completed" {
        observed
      } else {
        nil
      }
    },
    {timeout_ms: MAX_POLL_MS, interval_ms: POLL_INTERVAL_MS},
  )
  if completed != nil {
    return completed
  }
  const final = github_actions_run(harness, slug, run_id)
  if is_err(final) {
    throw to_string(unwrap_err(final))
  }
  return unwrap(final)
}

fn find_existing_pr(harness: Harness, slug) {
  const prs = github_pr_list(
    harness,
    slug,
    {head: BUMP_BRANCH, base: "main", state: "open", limit: 1},
  )
  if is_err(prs) {
    throw "GitHub PR lookup failed for ${slug}: " + to_string(unwrap_err(prs))
  }
  const found = unwrap(prs)
  if len(found) == 0 {
    return nil
  }
  return found[0]
}

fn probe_post_dispatch_state(harness: Harness, slug, target, target_no_v) {
  const pr = find_existing_pr(harness, slug)
  const remote = read_remote_pin(harness, slug)
  const probe = if pr == nil {
    nil
  } else {
    pr_target_probe(harness, slug, pr, target)
  }
  const settled = (pr != nil && probe.matches)
    || (pr == nil && remote != nil && remote == target_no_v)
  return {settled: settled, pr: pr, pr_probe: probe, remote_pin: remote}
}

fn settled_post_dispatch_state(harness: Harness, slug, target, target_no_v) {
  const snap = probe_post_dispatch_state(harness, slug, target, target_no_v)
  if snap.settled {
    return snap
  }
  return nil
}

fn wait_for_post_dispatch_state(harness: Harness, slug, target) {
  const target_no_v = strip_v(target)
  const hit = poll_until(
    fn() { return settled_post_dispatch_state(harness, slug, target, target_no_v) },
    {timeout_ms: POST_RUN_SETTLE_MS, interval_ms: POST_RUN_SETTLE_POLL_MS},
  )
  if hit != nil {
    return hit
  }
  return probe_post_dispatch_state(harness, slug, target, target_no_v)
}

// -------------------------------------------------------------------------------------------------
// Audit & summary.
// -------------------------------------------------------------------------------------------------

fn render_local_prompt(harness: Harness, name, data) {
  return render_string(harness.fs.read_text("prompts/" + name), data)
}

fn write_audit(harness: Harness, run_id, payload: FleetAuditReceipt) {
  const runs_root = "${cwd()}/.harn-runs/bump-fleet/${run_id}"
  const receipt = fleet_audit_receipt_write(runs_root, payload)
  const md_payload = {...payload, audit_sha: sha3_256(receipt.body)[0:16]}
  const md = render_local_prompt(harness, "audit_report.harn.prompt", md_payload)
  const md_path = "${runs_root}/audit.md"
  harness.fs.write_text(md_path, md)
  return {json_path: receipt.json_path, md_path: md_path}
}

fn summarize_with_local_llm(harness: Harness, payload) {
  // Single-node validate -> repair on harn's canonical `workflow_run_repair`
  // primitive instead of a hand-rolled two-attempt loop. The inline executor
  // owns each attempt: attempt 1 asks for bullets straight off the audit JSON;
  // any later attempt (fired only when `bump_summary_format_ok` rejected the
  // prior text) re-prompts through the `bump_summary_retry` template. Returning
  // a `"failed"` branch while the format check fails is what drives the
  // primitive's retry, capped at `max_attempts: 2` — byte-identical to the old
  // first/second ceiling. Each attempt stashes its text on the attempt record's
  // `verification`, so we rebuild the exact `[first]` / `[first, second]` list
  // `bump_summary_result` expects (it selects the first valid attempt, else the
  // deterministic fallback, so a bad final attempt still fails open).
  const system = render_local_prompt(harness, "bump_summary_system.harn.prompt", {})
  const audit_json = json_stringify(payload)
  const executor = { ctx ->
    const attempt_prompt = if ctx.attempt <= 1 {
      "Audit JSON:\n```json\n" + audit_json + "\n```\nBullets:\n"
    } else {
      render_local_prompt(harness, "bump_summary_retry.harn.prompt", {audit_json: audit_json})
    }
    const text = llm_summary_once(attempt_prompt, system)
    const ok = bump_summary_format_ok(text)
    return {
      text: text,
      verification: {ok: ok, text: text},
      branch: if ok {
        nil
      } else {
        "failed"
      },
      outcome: "completed",
    }
  }
  let out = workflow_run_repair({task: "bump-fleet-summary", executor: executor, max_attempts: 2})
  let texts = []
  for {index: _index, value} in (out.run?.stages[0]?.attempts ?? []).enumerate() {
    texts = texts + [value?.verification?.text]
  }
  return bump_summary_result(payload, texts)
}

fn llm_summary_once(prompt, system) {
  const r = try {
    const opts = agent_preset(
      "summary",
      {
        system: system,
        provider: SUMMARY_PROVIDER,
        model: SUMMARY_MODEL,
        max_tokens: 400,
        temperature: 0.0,
        llm_caller: retrying_llm_caller(2),
      },
    )
    agent_loop(prompt, opts?.system, opts)
  } catch (e) {
    return "(local LLM summary unavailable: ${e})"
  }
  const raw = trim(r.visible_text ?? r.text ?? r.prose ?? "")
  return strip_think_blocks(raw)
}

fn resolve_latest_release(harness: Harness) {
  return github_latest_release_tag(harness, HARN_REPO)
}

fn wait_for_target_release_readiness(harness: Harness, target) {
  const stop_at_ms = harness.clock.now_ms() + RELEASE_READINESS_MAX_MS
  let attempt = 1
  let last = nil
  while harness.clock.now_ms() <= stop_at_ms {
    const snapshot = harn_release_readiness(harness, target)
    last = snapshot
    if snapshot.ready {
      return snapshot + {timed_out: false, attempts: attempt}
    }
    harness.stdio.println("   attempt ${attempt}: ${release_readiness_detail(snapshot)}")
    const remaining_ms = stop_at_ms - harness.clock.now_ms()
    if remaining_ms <= 0 {
      break
    }
    harness.clock.sleep_ms(
      if remaining_ms < RELEASE_READINESS_POLL_MS {
        remaining_ms
      } else {
        RELEASE_READINESS_POLL_MS
      },
    )
    attempt = attempt + 1
  }
  return (last ?? harn_release_readiness(harness, target))
    + {timed_out: true, attempts: attempt}
}

fn restore_local_checkout_to_main(dry_run) {
  if dry_run {
    return nil
  }
  return checkout_cleanup(nil, "main", cwd())
}

fn error_outcome_for_repo(harness: Harness, repo, message) {
  return base_outcome_fields(repo, read_pre_pin(harness, repo.dir), nil)
    + {
    status: "error",
    detail: message,
  }
}

pipeline main() {
  const preflight = ensure_unrestricted_sandbox(harness, "bump_fleet.harn")
  if preflight != nil {
    return preflight
  }
  const parsed = parse_fleet_args(argv)
  if parsed.chat_only {
    return bump_chat_only(harness, parsed)
  }
  const pre = fleet_pre_dispatch_phase(
    harness,
    parsed,
    SUMMARY_MODEL,
    {
      resolve_target: fn() { return timed(
        "bump.resolve_target",
        {},
        { -> return resolve_latest_release(harness) },
      ).result },
      start_run: fn(target, mode) { return {
        run_id: uuid_v7(),
        started_iso: date_now_iso(),
        mode: mode,
        run_timing: start_timing("bump.run", {mode: mode, target: strip_v(target)}),
      } },
      install_cost_budget: fn() {
        const limit = install_cost_budget("HARN_BUMP_FLEET_COST_LIMIT_USD")
        return cost_budget_audit_line(limit)
      },
      discover_repos: fn() { return timed("bump.discovery", {}, { -> return discover_repos(harness) })
        .result },
      wait_for_readiness: fn(target) { return timed(
        "bump.release_readiness",
        {target: strip_v(target)},
        { -> return wait_for_target_release_readiness(harness, target) },
      ).result },
      readiness_detail: fn(readiness) { return release_readiness_detail(readiness) },
      skipped_view_gate:
        fn(target, reason) { return skipped_run_session_view_gate(target, reason) },
      run_view_gate: fn(harn_repo, target) { return timed(
        "bump.run_session_view_gate",
        {target: strip_v(target), harn_repo: harn_repo},
        { -> return run_session_view_fleet_gate(harness, harn_repo, target) },
      ).result },
      skipped_public_surface_impact: fn(target, reason) { return skipped_public_surface_impact(
        target,
        reason,
      ) },
      scan_public_surface: fn(target, repos, harn_repo) { return timed(
        "bump.public_surface_impact",
        {target: strip_v(target), repo_count: len(repos)},
        { -> return public_surface_impact_scan(harness, target, repos, harn_repo) },
      ).result },
      finish_run: fn(timing, result) { return end_timing(timing, result) },
      timing_artifacts: fn() { return timing_artifacts() },
      now_iso: fn() { return date_now_iso() },
      operator: fn() { return username() },
      host: fn() { return hostname() },
      write_audit: fn(run_id, payload) { return write_audit(harness, run_id, payload) },
    },
  )
  if !pre.ready {
    return pre.exit_code
  }
  const context = pre.context
  const execution = fleet_execution_phase(
    harness,
    context,
    PARALLEL_LIMIT,
    parsed.retry_failed,
    {
      dry_run: parsed.dry_run,
      run_repo: fn(repo, target, dry_run, view_gate, impact, _retry) { return bump_one(
        harness,
        repo,
        target,
        dry_run,
        view_gate,
        impact,
      ) },
      error_outcome: fn(repo, message) { return error_outcome_for_repo(harness, repo, message) },
      timed_dispatch: fn(attrs, callback) { return timed("bump.dispatch_settle", attrs, callback)
        .result },
      timed_retries:
        fn(attrs, callback) { return timed("bump.retry_failed", attrs, callback).result },
    },
  )
  const finalized = fleet_finalization_phase(
    harness,
    context,
    execution.outcomes,
    parsed,
    SUMMARY_MODEL,
    SUMMARY_PROVIDER,
    {
      now_iso: fn() { return date_now_iso() },
      elapsed_ms: fn(timing) { return elapsed_ms(timing) },
      operator: fn() { return username() },
      host: fn() { return hostname() },
      dispatched: fn(status) { return dispatched_status(status) },
      summarize: fn(payload, dry_run) { return timed(
        "bump.summary",
        {mode: context.mode, skipped: dry_run},
        { ->
          return if dry_run {
            bump_summary_skipped(payload, "(skipped on dry-run)")
          } else {
            summarize_with_local_llm(harness, {...payload, summary_text: ""})
          }
        },
      ).result },
      cleanup: fn(dry_run) { return timed(
        "bump.checkout_cleanup",
        {skipped: dry_run},
        { -> return restore_local_checkout_to_main(dry_run) },
      ).result },
      problem: fn(outcome) { return bump_summary_problem_outcome(outcome) },
      finish_run: fn(timing, result) { return end_timing(timing, result) },
      timing_artifacts: fn() { return timing_artifacts() },
      write_audit: fn(run_id, payload) { return write_audit(harness, run_id, payload) },
      chat_enabled: fn(options) { return chat_enabled(options) },
      run_dir: fn(run_id) { return path_join(cwd(), ".harn-runs/bump-fleet", run_id) },
      repo_root: fn() { return cwd() },
      chat_tools: fn() { return bump_chat_tools() },
      run_chat: fn(config) { run_chat_loop(harness, config) },
    },
  )
  return finalized.exit_code
}
