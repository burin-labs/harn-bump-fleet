#!/usr/bin/env harn
//
// bump_fleet.harn — orchestrate Harn-version bump PRs across every repo in
// ~/projects/{*harn*,*burin*} that ships a `.github/workflows/bump-harn.yml`.
//
// Determinism: every GitHub interaction uses the typed connector boundary. The
// single LLM call at the end is a read-only summary against a local model — it
// never drives any side-effect.
//
// Usage:
//   harn run --no-sandbox bump_fleet.harn                      // bump to latest harn release
//   harn run --no-sandbox bump_fleet.harn -- v0.7.52           // pin to explicit tag
//   harn run --no-sandbox bump_fleet.harn -- --dry-run         // discover-only, no dispatch
//   harn run --no-sandbox bump_fleet.harn -- --dry-run v0.7.52
//   harn run --no-sandbox bump_fleet.harn -- --retry-failed 3  // re-dispatch dispatch_failed/run_failure
//                                                              // repos up to 3 more times each
import { agent_preset } from "std/agent/presets"
import { command_run } from "std/command"
import { env_str } from "std/config"
import { strip_think_blocks } from "std/llm/safe"
import { poll_until } from "std/poll"
import { map_settled } from "std/settled"
import { elapsed_ms, end_timing, start_timing, timed } from "std/timing"
import { workflow_run_repair } from "std/workflow/repair"
import { dry_run_predispatch_outcome, local_pin_drift_detail } from "lib/bump_decision"
import { bump_chat_only, run_bump_post_run_chat } from "lib/bump_fleet_chat"
import { parse_bump_fleet_args } from "lib/bump_fleet_options"
import { cargo_harn_pin_probe, harn_version_pin_probe } from "lib/bump_pins"
import {
  bump_summary_format_ok,
  bump_summary_problem_outcome,
  bump_summary_result,
  bump_summary_skipped,
} from "lib/bump_summary"
import { changelog_named_section_from_text } from "lib/changelog"
import { checkout_cleanup } from "lib/checkout_cleanup"
import { remote_url_to_slug } from "lib/git"
import {
  github_actions_run,
  github_enable_auto_merge,
  github_file_text_at_ref,
  github_latest_release_tag,
  github_pr_close,
  github_pr_comment,
  github_pr_list,
  github_release_at_tag,
  github_workflow_dispatch,
} from "lib/github"
import {
  cost_budget_audit_line,
  install_cost_budget,
  planner_defaults,
  retrying_llm_caller,
} from "lib/llm_defaults"
import {
  public_surface_impact_for_repo,
  public_surface_impact_for_repos,
  public_surface_impact_markdown,
  public_surface_impact_report_from_surfaces,
  public_surface_release_diff,
} from "lib/public_surface_impact"
import { harn_release_readiness, release_readiness_detail } from "lib/release_readiness"
import {
  run_session_view_downstream_markdown,
  run_session_view_fleet_gate,
} from "lib/run_session_view_gate"
import { ensure_unrestricted_sandbox } from "lib/sandbox_preflight"
import { is_v_semver, strip_v } from "lib/semver"
import { timing_artifacts } from "lib/timing_report"

let BUMP_BRANCH = "automation/bump-harn-runtime"

let HARN_REPO = "burin-labs/harn"

let POLL_INTERVAL_MS = 15000

let POST_RUN_SETTLE_MS = 90 * 1000

let POST_RUN_SETTLE_POLL_MS = 5000

let MAX_POLL_MS = 30 * 60 * 1000

let PARALLEL_LIMIT = 4

let RELEASE_READINESS_POLL_MS = 15 * 1000

let RELEASE_READINESS_MAX_MS = 45 * 60 * 1000

// Default summary + chat model. Matches release_harn so the shared chat loop
// (which requires a tool-capable model) works the same way for both harnesses.
// Override with HARN_BUMP_FLEET_MODEL / HARN_BUMP_FLEET_PROVIDER. The
// bottom of the cascade falls through to `lib/llm_defaults`, which now
// defaults unconditionally to the OpenRouter `qwen/qwen3.6-35b-a3b`
// cloud cell (local Ollama is opt-in only via a provider override).
let __BUMP_FLEET_DEFAULT = planner_defaults("HARN_BUMP_FLEET")

let SUMMARY_MODEL = env_str("HARN_BUMP_FLEET_MODEL") ?? __BUMP_FLEET_DEFAULT.model

let SUMMARY_PROVIDER = env_str("HARN_BUMP_FLEET_PROVIDER") ?? __BUMP_FLEET_DEFAULT.provider

// Outcome statuses that are transient enough to be worth retrying. Codeload
// flakes, action-download HTTP 5xx, workflow_dispatch HTTP 500 during a
// GitHub Actions incident, and per-run race conditions all surface as one of
// these — none reflect a configuration problem the operator has to fix
// first. `pr_open*`, `already_current`, `dry_run`, and the closed-stale
// variants are intentionally absent: re-dispatching them either no-ops or
// creates duplicate work.
let RETRYABLE_STATUSES = ["dispatch_failed", "run_failure", "preflight_error", "run_in_progress"]

fn skipped_run_session_view_gate(target, reason) {
  return {
    ok: true,
    skipped: true,
    check: {
      name: "check-run-view-fixtures",
      command: "(skipped)",
      success: true,
      status: 0,
      stdout: "",
      stderr: "",
    },
    cargo_target_dir: "",
    metadata_ok: true,
    expected_json_count: 0,
    parse_errors: [],
    schemas: [],
    summary_line: reason,
    repo_version: "",
    target_version: strip_v(target ?? ""),
    target_change: {known: false, changed: false, paths: [], detail: reason},
  }
}

// -------------------------------------------------------------------------------------------------

// Repo discovery — scan ~/projects for every directory matching
// {*harn*,*burin*} that owns a bump-harn workflow. Skip git worktrees of an
// already-discovered repo so we never double-dispatch the same workflow.

// -------------------------------------------------------------------------------------------------

fn discover_repos(harness: Harness) {
  let home = harness.env.get_or("HOME", "")
  let projects = "${home}/projects"
  let listing = shell("ls -d ${projects}/*harn* ${projects}/*burin* 2>/dev/null")
  let dirs = listing.stdout
    .split("\n")
    .filter({ d -> d != "" && harness.fs.exists("${d}/.github/workflows/bump-harn.yml") })
  let seen_common_dir = {}
  let out = []
  for dir in dirs {
    let slug_probe = shell_at(dir, "git remote get-url origin 2>/dev/null")
    if !slug_probe.success {
      continue
    }
    let slug = remote_url_to_slug(trim(slug_probe.stdout))
    if slug == nil {
      continue
    }
    let common_dir_probe = shell_at(dir, "git rev-parse --git-common-dir 2>/dev/null")
    if !common_dir_probe.success {
      continue
    }
    let raw_common = trim(common_dir_probe.stdout)
    let common = if starts_with(raw_common, "/") {
      raw_common
    } else {
      "${dir}/${raw_common}"
    }
    if seen_common_dir[common] ?? false {
      continue
    }
    seen_common_dir[common] = true
    out = out + [{dir: dir, slug: slug, common_dir: common}]
  }
  // worktree dedupe
  return out
}

// Pre-pin readback — best-effort current version per repo, for the audit.

// -------------------------------------------------------------------------------------------------

/**
 * Returns `{pin, evidence}` where `pin` is the bare "X.Y.Z" string with any
 * leading "v" stripped, matching the canonical form of
 * `read_remote_pin_probe_at_ref`. Keeping local and remote pins in the same
 * shape avoids asymmetric audit rows and stops the read-only summary LLM from
 * hallucinating drift over a cosmetic `v` prefix.
 */
fn read_pre_pin_probe(harness: Harness, dir) {
  let candidates = [".harn-version"]
  for f in candidates {
    let path = "${dir}/${f}"
    if harness.fs.exists(path) {
      return harn_version_pin_probe(harness.fs.read_text(path))
    }
  }
  // Try parsing exact Harn Cargo deps on harn-cloud-style repos.
  let cargo = "${dir}/Cargo.toml"
  if harness.fs.exists(cargo) {
    return cargo_harn_pin_probe(harness.fs.read_text(cargo))
  }
  return {pin: nil, evidence: "no .harn-version or Cargo.toml pin surface found"}
}

fn read_pre_pin(harness: Harness, dir) {
  return read_pre_pin_probe(harness, dir).pin
}

// -------------------------------------------------------------------------------------------------

// Per-repo bump pipeline. Dispatch the workflow, poll for completion, locate
// the resulting PR, ensure auto-merge is enabled.

// -------------------------------------------------------------------------------------------------

fn base_outcome_fields(repo, local_pin, remote_pin) {
  return {
    dir: repo.dir,
    slug: repo.slug,
    run_id: nil,
    run_url: nil,
    pr_number: nil,
    pr_url: nil,
    pre_pin: local_pin ?? remote_pin,
    local_pin: local_pin,
    remote_pin: remote_pin,
    auto_merge: nil,
    duration_ms: 0,
  }
}

fn make_outcome(repo, local_pin, remote_pin) {
  return base_outcome_fields(repo, local_pin, remote_pin) + {status: "pending", detail: ""}
}

fn bump_span_status(outcome) {
  return if bump_summary_problem_outcome(outcome) {
    "error"
  } else {
    "ok"
  }
}

fn timed_bump_phase(name, attrs, callback) {
  let handle = start_timing(name, attrs)
  try {
    let outcome = callback()
    end_timing(handle, {status: bump_span_status(outcome), outcome: outcome.status ?? ""})
    return outcome
  } catch (e) {
    end_timing(handle, {status: "error", outcome: "exception", error: to_string(e)})
    throw e
  }
}

fn timed_bump_outcome(name, attrs, callback) {
  let handle = start_timing(name, attrs)
  try {
    let outcome = callback()
    let timing = end_timing(handle, {status: bump_span_status(outcome), outcome: outcome.status ?? ""})
    return outcome + {duration_ms: timing.duration_ms}
  } catch (e) {
    end_timing(handle, {status: "error", outcome: "exception", error: to_string(e)})
    throw e
  }
}

/**
 * Whether an outcome status implies the script actually kicked a workflow
 * run for that repo (vs. resolving via probes only). Used to drive the
 * "dispatched: N" counter in the audit summary.
 */
fn dispatched_status(s) {
  return starts_with(s, "run_") || s == "dispatch_failed" || s == "pr_open"
    || s == "already_current_post_run"
}

/**
 * Probe the version pinned on origin/main by reading the canonical connector surface.
 * Tries .harn-version first (most repos), falls back to exact
 * Harn Cargo pins (harn-cloud). Returns `{pin, evidence}` where `pin` is the
 * bare "X.Y.Z" string with any leading "v" already stripped, or nil.
 */
fn read_remote_pin_probe_at_ref(slug, ref) {
  let hv = github_file_text_at_ref(slug, ".harn-version", ref)
  if hv != nil && trim(hv) != "" {
    return harn_version_pin_probe(hv)
  }
  let cargo = github_file_text_at_ref(slug, "Cargo.toml", ref)
  if cargo != nil && trim(cargo) != "" {
    return cargo_harn_pin_probe(cargo)
  }
  return {pin: nil, evidence: "no .harn-version or Cargo.toml pin surface found at ${ref}"}
}

fn read_remote_pin_at_ref(slug, ref) {
  return read_remote_pin_probe_at_ref(slug, ref).pin
}

fn read_remote_pin(slug) {
  return read_remote_pin_at_ref(slug, "main")
}

/** Idempotently arm auto-merge under the PR head observed by the preceding read. */
fn ensure_auto_merge(slug, pr) {
  const result = github_enable_auto_merge(slug, pr.number, pr.head.sha)
  return if is_err(result) {
    "failed: " + to_string(unwrap_err(result))
  } else {
    result.state
  }
}

fn local_harn_changelog_section(target, harn_repo) {
  const result = command_run(
    {
      argv: ["git", "show", "${target}:CHANGELOG.md"],
      cwd: harn_repo,
      capture: {max_inline_bytes: 256000},
    },
    {timeout_ms: 30000},
  )
  if !(result?.success ?? false) {
    return {
      status: "local_changelog_unavailable",
      detail: trim(to_string(result?.stderr ?? result?.stdout ?? "git show failed")),
      body: "",
    }
  }
  const body = changelog_named_section_from_text(result.stdout ?? "", "## ${target}")
  if trim(body) == "" {
    return {
      status: "local_changelog_section_missing",
      detail: "CHANGELOG.md at ${target} did not contain a ## ${target} section",
      body: "",
    }
  }
  return {status: "local_tag_changelog", detail: "CHANGELOG.md section at ${target}", body: body}
}

fn release_public_surface_analysis(target, harn_repo) {
  const empty = {
    changelog_section: "",
    changelog_unreleased_section: "",
    diff_names: "",
    commit_file_changes_since_latest_tag: "",
    commit_stats_since_latest_tag: "",
    public_surface_diff: "",
  }
  let evidence_parts = []
  let source_statuses = []
  let source_details = []
  const local_changelog = local_harn_changelog_section(target, harn_repo)
  if trim(local_changelog.body) != "" {
    evidence_parts = evidence_parts + [local_changelog.body]
    source_statuses = source_statuses + [local_changelog.status]
    source_details = source_details + [local_changelog.detail]
  }
  const release_diff = public_surface_release_diff(target, harn_repo)
  if release_diff.known {
    source_statuses = source_statuses + [release_diff.status]
    source_details = source_details + [release_diff.detail]
  } else {
    source_details = source_details + ["Git release diff unavailable: " + release_diff.detail]
  }
  const lookup = try {
    github_release_at_tag(HARN_REPO, target)
  } catch (e) {
    return {
      status: if len(source_statuses) == 0 {
        "release_lookup_failed"
      } else {
        join(source_statuses, "+")
      },
      detail: join(source_details + ["GitHub release lookup failed: " + to_string(e)], "; "),
      analysis: {...empty, changelog_section: join(evidence_parts, "\n\n"), public_surface_diff: release_diff.patch},
    }
  }
  if is_err(lookup) {
    return {
      status: if len(source_statuses) == 0 {
        "release_lookup_failed"
      } else {
        join(source_statuses, "+")
      },
      detail: join(source_details + ["GitHub release lookup failed: " + to_string(unwrap_err(lookup))], "; "),
      analysis: {...empty, changelog_section: join(evidence_parts, "\n\n"), public_surface_diff: release_diff.patch},
    }
  }
  if !(lookup?.found ?? false) {
    return {
      status: if len(source_statuses) == 0 {
        "release_not_found"
      } else {
        join(source_statuses, "+")
      },
      detail: join(source_details + ["GitHub release ${target} was not found"], "; "),
      analysis: {...empty, changelog_section: join(evidence_parts, "\n\n"), public_surface_diff: release_diff.patch},
    }
  }
  const release = lookup.release ?? {}
  if trim(release.body ?? "") != "" {
    evidence_parts = evidence_parts + [release.body]
    source_statuses = source_statuses + ["github_release_notes"]
    source_details = source_details + ["GitHub release body for ${target}"]
  }
  return {
    status: if len(source_statuses) == 0 {
      "release_notes_empty"
    } else {
      join(source_statuses, "+")
    },
    detail: if len(source_details) == 0 {
      "no changelog or release-note evidence found for ${target}"
    } else {
      join(source_details, "; ")
    },
    analysis: {...empty, changelog_section: join(evidence_parts, "\n\n"), public_surface_diff: release_diff.patch},
  }
}

fn public_surface_impact_scan(target, repos, harn_repo) {
  const source = release_public_surface_analysis(target, harn_repo)
  const base = public_surface_impact_for_repos(target, source.analysis, repos)
  return {...base, source_status: source.status, source_detail: source.detail}
}

fn skipped_public_surface_impact(target, reason) {
  return public_surface_impact_report_from_surfaces(target, [], [], "skipped", reason)
}

fn annotate_bump_pr_with_view_metadata(slug, pr_number, target, view_gate, public_surface_impact) {
  const repo_impact = public_surface_impact_for_repo(public_surface_impact, slug)
  let body = run_session_view_downstream_markdown(target, view_gate)
    + "\n\n"
    + public_surface_impact_markdown(target, repo_impact)
  const result = github_pr_comment(slug, pr_number, body)
  return if is_err(result) {
    {success: false, detail: "metadata comment failed: " + to_string(unwrap_err(result))}
  } else {
    {success: true, detail: "run/session view and public-surface metadata comment posted"}
  }
}

fn close_stale_pr(slug, pr, target, evidence) {
  let msg = "Closing stale Harn runtime bump PR: this fleet run targets ${target}, but ${evidence}."
  const result = github_pr_close(slug, pr.number, msg)
  return if result.ok {
    "closed stale PR #${pr.number}"
  } else {
    "failed to close stale PR #${pr.number}: " + to_string(result.error)
  }
}

fn finish_outcome(base, fields) {
  return base + fields
}

fn already_current_outcome(base, remote_pin, existing_pr) {
  let pr_n = if existing_pr == nil {
    nil
  } else {
    existing_pr.number
  }
  let pr_u = if existing_pr == nil {
    nil
  } else {
    existing_pr.url
  }
  return finish_outcome(
    base,
    {
      status: "already_current",
      detail: "remote main pin is ${remote_pin}; matches target" + local_pin_drift_detail(base, remote_pin),
      pr_number: pr_n,
      pr_url: pr_u,
    },
  )
}

fn targeted_pr_outcome(base, slug, target, pr, view_gate, public_surface_impact) {
  let annotated = annotate_bump_pr_with_view_metadata(slug, pr.number, target, view_gate, public_surface_impact)
  if !annotated.success {
    return finish_outcome(
      base,
      {
        status: "pr_open_for_target_schema_metadata_failed",
        detail: "PR #${pr.number} already targets ${target}; " + annotated.detail,
        pr_number: pr.number,
        pr_url: pr.url,
        auto_merge: nil,
      },
    )
  }
  let am = if pr.auto_merge_armed {
    "already_enabled"
  } else {
    ensure_auto_merge(slug, pr)
  }
  let final_status = if starts_with(am, "failed") {
    "pr_open_for_target_auto_merge_failed"
  } else {
    "pr_open_for_target"
  }
  return finish_outcome(
    base,
    {
      status: final_status,
      detail: "PR #${pr.number} already targets ${target}; " + annotated.detail + "; auto-merge: ${am}",
      pr_number: pr.number,
      pr_url: pr.url,
      auto_merge: am,
    },
  )
}

fn predispatch_resolution(
  repo,
  base,
  target,
  target_no_v,
  remote_pin,
  view_gate,
  public_surface_impact,
) {
  let existing_pr = find_existing_pr(repo.slug)
  let existing_probe = if existing_pr == nil {
    nil
  } else {
    pr_target_probe(repo.slug, existing_pr, target)
  }
  if remote_pin != nil && remote_pin == target_no_v {
    return {done: true, outcome: already_current_outcome(base, remote_pin, existing_pr), stale_note: ""}
  }
  if existing_pr != nil && existing_probe.matches {
    return {
      done: true,
      outcome: targeted_pr_outcome(base, repo.slug, target, existing_pr, view_gate, public_surface_impact),
      stale_note: "",
    }
  }
  if existing_pr != nil {
    let closed = close_stale_pr(repo.slug, existing_pr, target, existing_probe.evidence)
    if starts_with(closed, "failed") {
      return {
        done: true,
        stale_note: "",
        outcome: finish_outcome(
          base,
          {
            status: "stale_pr_close_failed",
            detail: closed,
            pr_number: existing_pr.number,
            pr_url: existing_pr.url,
          },
        ),
      }
    }
    return {done: false, outcome: nil, stale_note: closed + "; "}
  }
  return {done: false, outcome: nil, stale_note: ""}
}

fn dispatch_bump_workflow(harness: Harness, repo, base, target) {
  const dispatch = github_workflow_dispatch(repo.slug, "bump-harn.yml", {version: target})
  if is_err(dispatch) {
    return finish_outcome(base, {status: "dispatch_failed", detail: to_string(unwrap_err(dispatch))})
  }
  const polled = poll_exact_workflow_run(repo.slug, dispatch.run_id)
  return if polled.status != "completed" {
    {
      ...base,
      run_id: dispatch.run_id,
      run_url: dispatch.url,
      status: "run_in_progress",
      detail: "workflow still ${polled.status} after ${MAX_POLL_MS / 1000}s",
    }
  } else {
    {
      ...base,
      run_id: dispatch.run_id,
      run_url: dispatch.url,
      status: "run_${polled.conclusion}",
      detail: "workflow concluded ${polled.conclusion}",
    }
  }
}

fn classify_post_dispatch(slug, target, target_no_v, run_outcome, stale_note) {
  let post = wait_for_post_dispatch_state(slug, target)
  let pr = post.pr
  let post_remote = post.remote_pin
  let outcome = if pr == nil {
    let same = post_remote != nil && post_remote == target_no_v
    let remote_label = post_remote ?? "unknown"
    {
      ...run_outcome,
      status: if run_outcome.status == "run_success" && same {
        "already_current_post_run"
      } else if run_outcome.status == "run_success" {
        "run_success_no_target_change"
      } else {
        run_outcome.status
      },
      detail: stale_note + "${run_outcome.detail}; no open PR"
        + if same {
        " (remote pin now ${post_remote}, matches target)"
      } else {
        " (remote pin ${remote_label} does not match target ${target_no_v})"
      },
    }
  } else {
    let probe = post.pr_probe
    {
      ...run_outcome,
      pr_number: pr.number,
      pr_url: pr.url,
      status: if run_outcome.status == "run_success" && probe.matches {
        "pr_open"
      } else if run_outcome.status == "run_success" {
        "stale_pr_after_run"
      } else {
        run_outcome.status
      },
      detail: stale_note + "${run_outcome.detail}; PR #${pr.number} on ${pr.head.ref}; ${probe.evidence}",
    }
  }
  return {outcome: outcome, pr: pr}
}

fn with_auto_merge(slug, classified, target, view_gate, public_surface_impact) {
  let with_pr = classified.outcome
  let pr = classified.pr
  if pr == nil || with_pr.status == "stale_pr_after_run" {
    return with_pr
  }
  let annotated = annotate_bump_pr_with_view_metadata(slug, pr.number, target, view_gate, public_surface_impact)
  if !annotated.success {
    return {
      ...with_pr,
      status: "pr_open_schema_metadata_failed",
      detail: "${with_pr.detail}; " + annotated.detail,
      auto_merge: nil,
    }
  }
  let am = if pr.auto_merge_armed {
    "already_enabled"
  } else {
    ensure_auto_merge(slug, pr)
  }
  let detail = if starts_with(am, "failed") {
    "${with_pr.detail}; auto-merge: ${am}"
  } else {
    with_pr.detail
  }
  return {...with_pr, auto_merge: am, detail: detail}
}

fn bump_one(harness: Harness, repo, target, dry_run, view_gate, public_surface_impact) {
  return timed_bump_outcome(
    "bump.repo",
    {repo: repo.slug, dry_run: dry_run, target: strip_v(target)},
    { ->
      let pins = timed(
        "bump.repo.preflight",
        {repo: repo.slug},
        { -> return {remote_pin: read_remote_pin(repo.slug), local_pin: read_pre_pin(harness, repo.dir)} },
      ).result
      let remote_pin = pins.remote_pin
      let local_pin = pins.local_pin
      let base = make_outcome(repo, local_pin, remote_pin)
      let target_no_v = strip_v(target)
      if dry_run {
        let existing_pr = find_existing_pr(repo.slug)
        let existing_probe = if existing_pr == nil {
          nil
        } else {
          pr_target_probe(repo.slug, existing_pr, target)
        }
        return dry_run_predispatch_outcome(base, target, target_no_v, remote_pin, existing_pr, existing_probe)
      }
      let pre = timed(
        "bump.repo.pre_dispatch_resolution",
        {repo: repo.slug},
        { -> return predispatch_resolution(
          repo,
          base,
          target,
          target_no_v,
          remote_pin,
          view_gate,
          public_surface_impact,
        ) },
      ).result
      if pre.done {
        return pre.outcome
      }
      let run_outcome = timed_bump_phase(
        "bump.repo.dispatch_workflow",
        {repo: repo.slug},
        { -> return dispatch_bump_workflow(harness, repo, base, target) },
      )
      let classified = timed(
        "bump.repo.post_dispatch_verification",
        {repo: repo.slug},
        { -> return classify_post_dispatch(repo.slug, target, target_no_v, run_outcome, pre.stale_note) },
      ).result
      return timed_bump_phase(
        "bump.repo.auto_merge",
        {repo: repo.slug},
        { -> return with_auto_merge(repo.slug, classified, target, view_gate, public_surface_impact) },
      )
    },
  )
}

fn pr_target_probe(slug, pr, target) {
  let target_no_v = strip_v(target)
  let probe = read_remote_pin_probe_at_ref(slug, pr.head.ref)
  let pin = probe.pin
  if pin == nil {
    return {matches: false, pin: nil, evidence: "PR head pin is unknown: ${probe.evidence}"}
  }
  return {
    matches: pin == target_no_v,
    pin: pin,
    evidence: "PR head pin is ${pin}; target is ${target_no_v}; ${probe.evidence}",
  }
}

fn poll_exact_workflow_run(slug, run_id) {
  const completed = poll_until(
    fn() {
      const run = github_actions_run(slug, run_id)
      if is_err(run) {
        throw to_string(unwrap_err(run))
      }
      return if run.status == "completed" {
        run
      } else {
        nil
      }
    },
    {timeout_ms: MAX_POLL_MS, interval_ms: POLL_INTERVAL_MS},
  )
  if completed != nil {
    return completed
  }
  const final = github_actions_run(slug, run_id)
  if is_err(final) {
    throw to_string(unwrap_err(final))
  }
  return final
}

fn find_existing_pr(slug) {
  const prs = github_pr_list(slug, {head: BUMP_BRANCH, base: "main", state: "open", limit: 1})
  if is_err(prs) {
    throw "GitHub PR lookup failed for ${slug}: " + to_string(unwrap_err(prs))
  }
  if len(prs) == 0 {
    return nil
  }
  return prs[0]
}

fn probe_post_dispatch_state(slug, target, target_no_v) {
  let pr = find_existing_pr(slug)
  let remote = read_remote_pin(slug)
  let probe = if pr == nil {
    nil
  } else {
    pr_target_probe(slug, pr, target)
  }
  let settled = (pr != nil && probe.matches) || (pr == nil && remote != nil && remote == target_no_v)
  return {settled: settled, pr: pr, pr_probe: probe, remote_pin: remote}
}

fn settled_post_dispatch_state(slug, target, target_no_v) {
  let snap = probe_post_dispatch_state(slug, target, target_no_v)
  if snap.settled {
    return snap
  }
  return nil
}

fn wait_for_post_dispatch_state(slug, target) {
  let target_no_v = strip_v(target)
  let hit = poll_until(
    fn() { return settled_post_dispatch_state(slug, target, target_no_v) },
    {timeout_ms: POST_RUN_SETTLE_MS, interval_ms: POST_RUN_SETTLE_POLL_MS},
  )
  if hit != nil {
    return hit
  }
  return probe_post_dispatch_state(slug, target, target_no_v)
}

// -------------------------------------------------------------------------------------------------
// Audit & summary.
// -------------------------------------------------------------------------------------------------

fn render_local_prompt(harness: Harness, name, data) {
  return render_string(harness.fs.read_text("prompts/" + name), data)
}

fn write_audit(harness: Harness, run_id, payload) {
  let runs_root = "${cwd()}/.harn-runs/bump-fleet/${run_id}"
  harness.fs.mkdir(runs_root, true)
  let body = json_stringify(payload)
  let json_path = "${runs_root}/audit.json"
  harness.fs.write_text(json_path, body + "\n")
  let md_payload = {...payload, audit_sha: sha3_256(body)[0:16]}
  let md = render_local_prompt(harness, "audit_report.harn.prompt", md_payload)
  let md_path = "${runs_root}/audit.md"
  harness.fs.write_text(md_path, md)
  return {json_path: json_path, md_path: md_path}
}

fn summarize_with_local_llm(harness: Harness, payload) {
  // Single-node validate -> repair on harn's canonical `workflow_run_repair`
  // primitive instead of a hand-rolled two-attempt loop. The inline executor
  // owns each attempt: attempt 1 asks for bullets straight off the audit JSON;
  // any later attempt (fired only when `bump_summary_format_ok` rejected the
  // prior text) re-prompts through the `bump_summary_retry` template. Returning
  // a `"failed"` branch while the format check fails is what drives the
  // primitive's retry, capped at `max_attempts: 2` — byte-identical to the old
  // first/second ceiling. Each attempt stashes its text on the attempt record's
  // `verification`, so we rebuild the exact `[first]` / `[first, second]` list
  // `bump_summary_result` expects (it selects the first valid attempt, else the
  // deterministic fallback, so a bad final attempt still fails open).
  let system = render_local_prompt(harness, "bump_summary_system.harn.prompt", {})
  let audit_json = json_stringify(payload)
  let executor = { ctx ->
    let attempt_prompt = if ctx.attempt <= 1 {
      "Audit JSON:\n```json\n" + audit_json + "\n```\nBullets:\n"
    } else {
      render_local_prompt(harness, "bump_summary_retry.harn.prompt", {audit_json: audit_json})
    }
    let text = llm_summary_once(attempt_prompt, system)
    let ok = bump_summary_format_ok(text)
    return {
      text: text,
      verification: {ok: ok, text: text},
      branch: if ok {
        nil
      } else {
        "failed"
      },
      outcome: "completed",
    }
  }
  let out = workflow_run_repair({task: "bump-fleet-summary", executor: executor, max_attempts: 2})
  let texts = []
  for {index: _index, value} in (out.run?.stages[0]?.attempts ?? []).enumerate() {
    texts = texts + [value?.verification?.text]
  }
  return bump_summary_result(payload, texts)
}

fn llm_summary_once(prompt, system) {
  let r = try {
    let opts = agent_preset(
      "summary",
      {
        system: system,
        provider: SUMMARY_PROVIDER,
        model: SUMMARY_MODEL,
        max_tokens: 400,
        temperature: 0.0,
        llm_caller: retrying_llm_caller(2),
      },
    )
    agent_loop(prompt, opts?.system, opts)
  } catch (e) {
    return "(local LLM summary unavailable: ${e})"
  }
  let raw = trim(r.visible_text ?? r.text ?? r.prose ?? "")
  return strip_think_blocks(raw)
}

// -------------------------------------------------------------------------------------------------
// Entry point.
// -------------------------------------------------------------------------------------------------

fn resolve_latest_release() {
  return github_latest_release_tag(HARN_REPO)
}

fn wait_for_target_release_readiness(harness: Harness, target) {
  let stop_at_ms = harness.clock.now_ms() + RELEASE_READINESS_MAX_MS
  let attempt = 1
  let last = nil
  while harness.clock.now_ms() <= stop_at_ms {
    let snapshot = harn_release_readiness(target)
    last = snapshot
    if snapshot.ready {
      return snapshot + {timed_out: false, attempts: attempt}
    }
    harness.stdio.println("   attempt ${attempt}: ${release_readiness_detail(snapshot)}")
    let remaining_ms = stop_at_ms - harness.clock.now_ms()
    if remaining_ms <= 0 {
      break
    }
    harness.clock
      .sleep_ms(
      if remaining_ms < RELEASE_READINESS_POLL_MS {
        remaining_ms
      } else {
        RELEASE_READINESS_POLL_MS
      },
    )
    attempt = attempt + 1
  }
  return (last ?? harn_release_readiness(target)) + {timed_out: true, attempts: attempt}
}

/**
 * Re-dispatch every outcome whose status is in `RETRYABLE_STATUSES` up to
 * `max_retries` more times. Each pass calls `bump_one` only on the
 * still-failing slugs and stitches the fresh outcome back into the original
 * list, preserving the original ordering so downstream summary/audit
 * readers can diff status across passes by index. Returns the final
 * outcomes list plus a per-slug `passes` map (1 = original try, 2+ =
 * retry attempts) for the audit trail.
 */
fn retry_failed_outcomes(
  harness: Harness,
  repos,
  outcomes,
  target,
  dry_run,
  max_retries,
  view_gate,
  public_surface_impact,
) {
  let current = outcomes
  let passes_by_slug = {}
  for o in current {
    passes_by_slug = passes_by_slug + {[o.slug]: 1}
  }
  if max_retries <= 0 || dry_run {
    return {outcomes: current, passes: passes_by_slug}
  }
  let repo_by_slug = {}
  let idx_map = repo_by_slug
  for r in repos {
    idx_map = idx_map + {[r.slug]: r}
  }
  let attempt = 1
  while attempt <= max_retries {
    let failing = []
    let pending = failing
    for o in current {
      if contains(RETRYABLE_STATUSES, o.status) {
        pending = pending.push(o.slug)
      }
    }
    if len(pending) == 0 {
      return {outcomes: current, passes: passes_by_slug}
    }
    harness.stdio
      .println(
      "\n== retry pass ${attempt}/${max_retries} (re-dispatching ${len(pending)} repo(s) in retryable state) ...",
    )
    let retry_repos = pending.map({ slug -> idx_map[slug] })
    let settled = parallel settle retry_repos with { max_concurrent: PARALLEL_LIMIT } { r ->
      bump_one(harness, r, target, dry_run, view_gate, public_surface_impact)
    }
    let retried = map_settled(
      settled.results,
      { value, _index -> value },
      { msg, index -> error_outcome_for_repo(harness, retry_repos[index], msg) },
    )
    let by_slug = {}
    let slug_map = by_slug
    for o in retried {
      slug_map = slug_map + {[o.slug]: o}
      passes_by_slug = passes_by_slug + {[o.slug]: (passes_by_slug[o.slug] ?? 1) + 1}
    }
    let next = []
    let merged = next
    for o in current {
      if slug_map[o.slug] != nil {
        merged = merged.push(slug_map[o.slug])
      } else {
        merged = merged.push(o)
      }
    }
    current = merged
    for o in retried {
      harness.stdio.println("   ${o.slug}: ${o.status}")
    }
    attempt = attempt + 1
  }
  return {outcomes: current, passes: passes_by_slug}
}

fn restore_local_checkout_to_main(dry_run) {
  if dry_run {
    return nil
  }
  return checkout_cleanup(nil, "main", cwd())
}

fn error_outcome_for_repo(harness: Harness, repo, message) {
  return base_outcome_fields(repo, read_pre_pin(harness, repo.dir), nil)
    + {status: "error", detail: message}
}

pipeline main() {
  let preflight = ensure_unrestricted_sandbox(harness, "bump_fleet.harn")
  if preflight != nil {
    return preflight
  }
  let parsed = parse_bump_fleet_args(argv)
  if parsed.chat_only {
    return bump_chat_only(harness, parsed, {provider: SUMMARY_PROVIDER, model: SUMMARY_MODEL})
  }
  let target = parsed.target ?? timed("bump.resolve_target", {}, { -> return resolve_latest_release() }).result
  if !is_v_semver(target) {
    harness.stdio.eprintln("error: target must look like vX.Y.Z, got '${target}'")
    return 2
  }
  let run_id = uuid_v7()
  let started_iso = date_now_iso()
  let mode_label = if parsed.dry_run {
    "dry-run"
  } else {
    "live"
  }
  let run_timing = start_timing("bump.run", {mode: mode_label, target: strip_v(target)})
  harness.stdio.println("== harn-bump-fleet run ${run_id}")
  harness.stdio.println("   target version : ${target}")
  harness.stdio.println("   mode           : ${mode_label}")
  let cost_limit = install_cost_budget("HARN_BUMP_FLEET_COST_LIMIT_USD")
  harness.stdio.println("   ${cost_budget_audit_line(cost_limit)}")
  let all_repos = timed("bump.discovery", {}, { -> return discover_repos(harness) }).result
  let repos = if parsed.only != nil {
    all_repos.filter({ r -> r.slug == parsed.only })
  } else {
    all_repos
  }
  harness.stdio.println("   repos discovered: ${len(all_repos)} (running on ${len(repos)})")
  for r in repos {
    harness.stdio.println("     - ${r.slug}  (${r.dir})")
  }
  if len(repos) == 0 {
    let only = parsed.only ?? ""
    harness.stdio.eprintln("no candidate repos matched (only=${only})")
    end_timing(run_timing, {status: "error", outcome: "no_matching_repos"})
    return 1
  }
  if !parsed.dry_run {
    harness.stdio.println("\n== waiting for target release readiness ...")
    let readiness = timed(
      "bump.release_readiness",
      {target: strip_v(target)},
      { -> return wait_for_target_release_readiness(harness, target) },
    ).result
    if !readiness.ready {
      harness.stdio
        .eprintln(
        "error: target release ${target} was not ready after ${readiness.attempts} checks: "
          + release_readiness_detail(readiness),
      )
      end_timing(run_timing, {status: "error", outcome: "release_not_ready"})
      return 1
    }
    harness.stdio.println("   ready: ${release_readiness_detail(readiness)}")
  }
  let view_gate = if parsed.dry_run {
    let reason = "skipped on dry-run; live bumps run make check-run-view-fixtures before dispatch"
    harness.stdio.println("\n== run/session view compatibility gate skipped on dry-run")
    harness.stdio.println("   ${reason}")
    skipped_run_session_view_gate(target, reason)
  } else {
    harness.stdio.println("\n== run/session view compatibility gate ...")
    let gate = timed(
      "bump.run_session_view_gate",
      {target: strip_v(target), harn_repo: parsed.harn_repo},
      { -> return run_session_view_fleet_gate(harness, parsed.harn_repo, target) },
    ).result
    harness.stdio.println("   schemas: ${gate.summary_line}")
    harness.stdio.println("   check  : ${gate.check.command} -> ${gate.check.status}")
    harness.stdio.println("   change : ${gate.target_change.detail}")
    gate
  }
  if !view_gate.ok {
    const public_surface_impact = skipped_public_surface_impact(target, "run/session view compatibility gate failed before dispatch")
    harness.stdio
      .eprintln(
      "error: run/session view compatibility gate failed: " + trim(view_gate.check.stderr ?? ""),
    )
    let failed_report = end_timing(run_timing, {status: "error", outcome: "run_session_view_gate_failed"})
    let timing = timing_artifacts()
    let payload = {
      run_id: run_id,
      started_iso: started_iso,
      finished_iso: date_now_iso(),
      duration_ms: failed_report.duration_ms,
      operator: username(),
      host: hostname(),
      target_version: target,
      mode: mode_label,
      repos_total: len(repos),
      repos_dispatched: 0,
      summary_model: SUMMARY_MODEL,
      summary_text: "- run/session view compatibility gate failed before dispatch",
      summary: {source: "deterministic_gate", text: "- run/session view compatibility gate failed before dispatch"},
      outcomes: [],
      run_session_view: view_gate,
      public_surface_impact: public_surface_impact,
      trace_spans: timing.trace_spans,
      timing_summary: timing.timing_summary,
    }
    let written = write_audit(harness, run_id, payload)
    harness.stdio.println("   audit : ${written.md_path}")
    return 1
  }
  harness.stdio.println("\n== public surface impact scan ...")
  const public_surface_impact = timed(
    "bump.public_surface_impact",
    {target: strip_v(target), repo_count: len(repos)},
    { -> return public_surface_impact_scan(target, repos, parsed.harn_repo) },
  ).result
  harness.stdio
    .println(
    "   source: ${public_surface_impact.source_status}; surfaces: ${public_surface_impact.surface_count}; affected repos: ${public_surface_impact.affected_repo_count}",
  )
  harness.stdio.println("\n== dispatching (max_concurrent=${PARALLEL_LIMIT}) ...")
  let settled = timed(
    "bump.dispatch_settle",
    {repo_count: len(repos), max_concurrent: PARALLEL_LIMIT},
    { -> return parallel settle repos with { max_concurrent: PARALLEL_LIMIT } { repo ->
      bump_one(harness, repo, target, parsed.dry_run, view_gate, public_surface_impact)
    } },
  ).result
  let initial_outcomes = map_settled(
    settled.results,
    { value, _index -> value },
    { msg, index -> error_outcome_for_repo(harness, repos[index], msg) },
  )
  for row in initial_outcomes {
    harness.stdio.println("   ${row.slug}: ${row.status}")
  }
  let retry_result = timed(
    "bump.retry_failed",
    {max_retries: parsed.retry_failed, dry_run: parsed.dry_run},
    { -> return retry_failed_outcomes(
      harness,
      repos,
      initial_outcomes,
      target,
      parsed.dry_run,
      parsed.retry_failed,
      view_gate,
      public_surface_impact,
    ) },
  ).result
  let outcomes = retry_result.outcomes
  let core_payload = {
    run_id: run_id,
    started_iso: started_iso,
    finished_iso: date_now_iso(),
    duration_ms: elapsed_ms(run_timing),
    operator: username(),
    host: hostname(),
    target_version: target,
    mode: mode_label,
    repos_total: len(repos),
    repos_dispatched: len(outcomes.filter({ o -> dispatched_status(o.status) })),
    summary_model: SUMMARY_MODEL,
    summary_text: "",
    run_session_view: view_gate,
    public_surface_impact: public_surface_impact,
    outcomes: outcomes,
  }
  harness.stdio.println("\n== summarizing with ${SUMMARY_MODEL} ...")
  let summary_result = timed(
    "bump.summary",
    {mode: mode_label, skipped: parsed.dry_run},
    { -> return if parsed.dry_run {
      bump_summary_skipped(core_payload, "(skipped on dry-run)")
    } else {
      summarize_with_local_llm(harness, {...core_payload, summary_text: ""})
    } },
  ).result
  let summary_text = summary_result.text
  let cleanup = timed(
    "bump.checkout_cleanup",
    {skipped: parsed.dry_run},
    { -> return restore_local_checkout_to_main(parsed.dry_run) },
  ).result
  if cleanup != nil {
    harness.stdio.println("\n== local checkout cleanup")
    harness.stdio.println("   ${cleanup.detail}")
  }
  let any_error = outcomes
    .any({ o -> bump_summary_problem_outcome(o) })
  let run_report = end_timing(
    run_timing,
    {
      status: if any_error {
        "error"
      } else {
        "ok"
      },
      outcome: if any_error {
        "failed"
      } else {
        "ok"
      },
    },
  )
  let timing = timing_artifacts()
  let payload = {
    ...core_payload,
    finished_iso: date_now_iso(),
    duration_ms: run_report.duration_ms,
    summary_text: summary_text,
    summary: summary_result,
    cleanup: cleanup,
    trace_spans: timing.trace_spans,
    timing_summary: timing.timing_summary,
  }
  let written = write_audit(harness, run_id, payload)
  harness.stdio.println("\n== audit written")
  harness.stdio.println("   json: ${written.json_path}")
  harness.stdio.println("   md  : ${written.md_path}")
  harness.stdio.println("\n${summary_text}")
  let exit_code = if any_error {
    1
  } else {
    0
  }
  run_bump_post_run_chat(
    harness,
    parsed,
    {provider: SUMMARY_PROVIDER, model: SUMMARY_MODEL},
    {
      run_id: run_id,
      audit_md_path: written.md_path,
      audit_json_path: written.json_path,
      mode: mode_label,
      failed: any_error,
    },
  )
  return exit_code
}
