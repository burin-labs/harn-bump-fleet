#!/usr/bin/env harn
//
// bump_fleet.harn — orchestrate Harn-version bump PRs across every repo in
// ~/projects/{*harn*,*burin*} that ships a `.github/workflows/bump-harn.yml`.
//
// Determinism: every GitHub interaction is a `gh` shell-out with JSON output.
// GitHub connector helpers are used where available with `gh` fallback. The
// single LLM call at the end is a read-only summary against a local model — it
// never drives any side-effect.
//
// Usage:
//   harn run bump_fleet.harn                      // bump to latest harn release
//   harn run bump_fleet.harn -- v0.7.52           // pin to explicit tag
//   harn run bump_fleet.harn -- --dry-run         // discover-only, no dispatch
//   harn run bump_fleet.harn -- v0.7.52 --dry-run
import { summary_agent } from "std/agent/presets"
import { parse_args } from "std/cli"
import { model_from_env } from "std/config"
import { default_llm_caller, with_retry } from "std/llm/handlers"
import { poll_until } from "std/poll"
import { map_settled } from "std/settled"
import {
  bump_summary_format_ok,
  bump_summary_problem_outcome,
  bump_summary_result,
  bump_summary_skipped,
} from "lib/bump_summary"
import { checkout_cleanup } from "lib/checkout_cleanup"
import { remote_url_to_slug } from "lib/git"
import {
  gh_enable_auto_merge,
  gh_file_text_at_ref,
  gh_json_argv,
  gh_latest_release_tag,
  gh_pr_close,
  gh_workflow_run,
  gh_workflow_runs,
} from "lib/github_cli"
import { harn_release_readiness, release_readiness_detail } from "lib/release_readiness"
import { is_v_semver, strip_v } from "lib/semver"

let BUMP_BRANCH = "automation/bump-harn-runtime"

let HARN_REPO = "burin-labs/harn"

let POLL_INTERVAL_MS = 15000

let POST_DISPATCH_GRACE_MS = 8000

let POST_RUN_SETTLE_MS = 90 * 1000

let POST_RUN_SETTLE_POLL_MS = 5000

let MAX_POLL_MS = 30 * 60 * 1000

let PARALLEL_LIMIT = 4

let RELEASE_READINESS_POLL_MS = 15 * 1000

let RELEASE_READINESS_MAX_MS = 45 * 60 * 1000

// Default summary model uses the local Ollama path. Override with
// HARN_BUMP_FLEET_MODEL / HARN_BUMP_FLEET_PROVIDER when using another local provider.
let SUMMARY_MODEL = model_from_env("HARN_BUMP_FLEET_MODEL", "gemma4:26b")

let SUMMARY_PROVIDER = model_from_env("HARN_BUMP_FLEET_PROVIDER", "ollama")

let ARG_SPEC = [
  {kind: "positional", name: "target", required: false},
  {kind: "flag", name: "dry_run", flags: ["--dry-run"]},
  {kind: "option", name: "only", flags: ["--only"]},
]

fn parse_fleet_args(args) {
  let parsed = parse_args(args, ARG_SPEC)
  let errors = parsed._errors ?? []
  if len(parsed._extras) > 0 {
    throw "unknown flag: " + parsed._extras[0]
  }
  if len(errors) > 0 {
    throw join(errors, "; ")
  }
  return {target: parsed.target, dry_run: parsed.dry_run, only: parsed.only}
}

// -------------------------------------------------------------------------------------------------

// Repo discovery — scan ~/projects for every directory matching
// {*harn*,*burin*} that owns a bump-harn workflow. Skip git worktrees of an
// already-discovered repo so we never double-dispatch the same workflow.

// -------------------------------------------------------------------------------------------------

fn discover_repos() {
  let home = env_or("HOME", "")
  let projects = "${home}/projects"
  let listing = shell("ls -d ${projects}/*harn* ${projects}/*burin* 2>/dev/null")
  let dirs = listing.stdout
    .split("\n")
    .filter(
    { d -> d != "" && file_exists("${d}/.github/workflows/bump-harn.yml") },
  )
  var seen_common_dir = {}
  var out = []
  for dir in dirs {
    let slug_probe = shell_at(dir, "git remote get-url origin 2>/dev/null")
    if !slug_probe.success {
      continue
    }
    let slug = remote_url_to_slug(trim(slug_probe.stdout))
    if slug == nil {
      continue
    }
    let common_dir_probe = shell_at(dir, "git rev-parse --git-common-dir 2>/dev/null")
    if !common_dir_probe.success {
      continue
    }
    let raw_common = trim(common_dir_probe.stdout)
    let common = if starts_with(raw_common, "/") {
      raw_common
    } else {
      "${dir}/${raw_common}"
    }
    if seen_common_dir[common] ?? false {
      continue
    }
    seen_common_dir[common] = true
    out = out + [{dir: dir, slug: slug, common_dir: common}]
  }
  // worktree dedupe
  return out
}

// Pre-pin readback — best-effort current version per repo, for the audit.

// -------------------------------------------------------------------------------------------------

fn read_pre_pin(dir) {
  let candidates = [".harn-version"]
  for f in candidates {
    let path = "${dir}/${f}"
    if file_exists(path) {
      return trim(read_file(path))
    }
  }
  // Try parsing harn-vm cargo dep on harn-cloud-style repos.
  let cargo = "${dir}/Cargo.toml"
  if file_exists(cargo) {
    let text = read_file(cargo)
    let m = regex_captures("(?m)^harn-vm\\s*=\\s*\"=?([0-9]+\\.[0-9]+\\.[0-9]+)\"", text)
    if m != nil && len(m) > 0 {
      return m[0].groups[0]
    }
  }
  return nil
}

// -------------------------------------------------------------------------------------------------

// Per-repo bump pipeline. Dispatch the workflow, poll for completion, locate
// the resulting PR, ensure auto-merge is enabled.

// -------------------------------------------------------------------------------------------------

fn base_outcome_fields(repo, local_pin, remote_pin) {
  return {
    dir: repo.dir,
    slug: repo.slug,
    run_id: nil,
    run_url: nil,
    pr_number: nil,
    pr_url: nil,
    pre_pin: local_pin ?? remote_pin,
    local_pin: local_pin,
    remote_pin: remote_pin,
    auto_merge: nil,
    duration_ms: 0,
  }
}

fn make_outcome(repo, local_pin, remote_pin) {
  return base_outcome_fields(repo, local_pin, remote_pin) + {status: "pending", detail: ""}
}

/**
 * Whether an outcome status implies the script actually kicked a workflow
 * run for that repo (vs. resolving via probes only). Used to drive the
 * "dispatched: N" counter in the audit summary.
 */
fn dispatched_status(s) {
  return starts_with(s, "run_") || s == "dispatch_failed" || s == "pr_open"
    || s == "already_current_post_run"
}

/**
 * Probe the version pinned on origin/main by reading the canonical surface
 * over `gh api`. Tries .harn-version first (most repos), falls back to the
 * `harn-vm = "..."` Cargo.toml dep (harn-cloud). Returns the bare "X.Y.Z"
 * string with any leading "v" already stripped, or nil.
 */
fn read_remote_pin_at_ref(slug, ref) {
  let hv = gh_file_text_at_ref(slug, ".harn-version", ref)
  if hv != nil && trim(hv) != "" {
    return strip_v(trim(hv))
  }
  let cargo = gh_file_text_at_ref(slug, "Cargo.toml", ref)
  if cargo != nil && trim(cargo) != "" {
    let m = regex_captures("(?m)^harn-vm\\s*=\\s*\"=?([0-9]+\\.[0-9]+\\.[0-9]+)\"", cargo)
    if m != nil && len(m) > 0 {
      return m[0].groups[0]
    }
  }
  return nil
}

fn read_remote_pin(slug) {
  return read_remote_pin_at_ref(slug, "main")
}

/**
 * Idempotently nudge auto-merge on. `gh pr merge --auto --squash` is itself
 * idempotent: re-enabling on an already-auto-merging PR exits 0 with a
 * noop message. Treat any non-zero exit as a soft failure carrying the
 * gh stderr forward.
 */
fn ensure_auto_merge(slug, pr_number) {
  let r = gh_enable_auto_merge(slug, pr_number)
  return if r.success {
    r.status
  } else {
    "failed: ${r.stderr}"
  }
}

fn close_stale_pr(slug, pr, target, evidence) {
  let msg = "Closing stale Harn runtime bump PR: this fleet run targets ${target}, but ${evidence}."
  let r = gh_pr_close(slug, pr.number, msg)
  return if r.success {
    "closed stale PR #${pr.number}"
  } else {
    "failed to close stale PR #${pr.number}: ${trim(r.stderr)}"
  }
}

fn finish_outcome(base, started_ms, fields) {
  return base + fields + {duration_ms: now_ms() - started_ms}
}

fn dry_run_outcome(base, target, started_ms) {
  return finish_outcome(
    base,
    started_ms,
    {status: "dry_run", detail: "would dispatch bump-harn.yml with version=${target}"},
  )
}

fn already_current_outcome(base, remote_pin, existing_pr, started_ms) {
  let pr_n = if existing_pr == nil {
    nil
  } else {
    existing_pr.number
  }
  let pr_u = if existing_pr == nil {
    nil
  } else {
    existing_pr.url
  }
  return finish_outcome(
    base,
    started_ms,
    {
      status: "already_current",
      detail: "remote main pin is ${remote_pin}; matches target" + local_pin_drift_detail(base, remote_pin),
      pr_number: pr_n,
      pr_url: pr_u,
    },
  )
}

fn local_pin_drift_detail(base, remote_pin) {
  let local_pin = base.local_pin ?? nil
  if local_pin == nil || remote_pin == nil {
    return ""
  }
  let local_no_v = strip_v(local_pin)
  if local_no_v == remote_pin {
    return ""
  }
  return "; local checkout pin is ${local_no_v}, which differs from remote main"
}

fn targeted_pr_outcome(base, slug, target, pr, started_ms) {
  let am = if pr.autoMergeRequest ?? nil != nil {
    "already_enabled"
  } else {
    ensure_auto_merge(slug, pr.number)
  }
  let final_status = if starts_with(am, "failed") {
    "pr_already_set_auto_merge_failed"
  } else {
    "pr_already_set"
  }
  return finish_outcome(
    base,
    started_ms,
    {
      status: final_status,
      detail: "PR #${pr.number} already targets ${target}; auto-merge: ${am}",
      pr_number: pr.number,
      pr_url: pr.url,
      auto_merge: am,
    },
  )
}

fn predispatch_resolution(repo, base, target, target_no_v, remote_pin, started_ms) {
  let existing_pr = find_existing_pr(repo.slug)
  let existing_probe = if existing_pr == nil {
    nil
  } else {
    pr_target_probe(repo.slug, existing_pr, target)
  }
  if remote_pin != nil && remote_pin == target_no_v {
    return {
      done: true,
      outcome: already_current_outcome(base, remote_pin, existing_pr, started_ms),
      stale_note: "",
    }
  }
  if existing_pr != nil && existing_probe.matches {
    return {
      done: true,
      outcome: targeted_pr_outcome(base, repo.slug, target, existing_pr, started_ms),
      stale_note: "",
    }
  }
  if existing_pr != nil {
    let closed = close_stale_pr(repo.slug, existing_pr, target, existing_probe.evidence)
    if starts_with(closed, "failed") {
      return {
        done: true,
        stale_note: "",
        outcome: finish_outcome(
          base,
          started_ms,
          {
            status: "stale_pr_close_failed",
            detail: closed,
            pr_number: existing_pr.number,
            pr_url: existing_pr.url,
          },
        ),
      }
    }
    return {done: false, outcome: nil, stale_note: closed + "; "}
  }
  return {done: false, outcome: nil, stale_note: ""}
}

fn dispatch_bump_workflow(repo, base, target, started_ms) {
  let dispatch_ts = date_now_iso()
  let dispatch = gh_workflow_run(repo.slug, "bump-harn.yml", {version: target})
  if !dispatch.success {
    return finish_outcome(base, started_ms, {status: "dispatch_failed", detail: trim(dispatch.stderr)})
  }
  sleep_ms(POST_DISPATCH_GRACE_MS)
  let polled = poll_for_completion(repo.slug, dispatch_ts)
  return if polled == nil {
    {...base, status: "run_not_found", detail: "no workflow_dispatch run after ${MAX_POLL_MS / 1000}s"}
  } else {
    {
      ...base,
      run_id: polled.id,
      run_url: polled.url,
      status: "run_${polled.conclusion}",
      detail: "workflow concluded ${polled.conclusion}",
    }
  }
}

fn classify_post_dispatch(slug, target, target_no_v, run_outcome, stale_note) {
  let post = wait_for_post_dispatch_state(slug, target)
  let pr = post.pr
  let post_remote = post.remote_pin
  let outcome = if pr == nil {
    let same = post_remote != nil && post_remote == target_no_v
    let remote_label = post_remote ?? "unknown"
    {
      ...run_outcome,
      status: if run_outcome.status == "run_success" && same {
        "already_current_post_run"
      } else {
        if run_outcome.status == "run_success" {
          "run_success_no_target_change"
        } else {
          run_outcome.status
        }
      },
      detail: stale_note + "${run_outcome.detail}; no open PR"
        + if same {
        " (remote pin now ${post_remote}, matches target)"
      } else {
        " (remote pin ${remote_label} does not match target ${target_no_v})"
      },
    }
  } else {
    let probe = post.pr_probe
    {
      ...run_outcome,
      pr_number: pr.number,
      pr_url: pr.url,
      status: if run_outcome.status == "run_success" && probe.matches {
        "pr_open"
      } else {
        if run_outcome.status == "run_success" {
          "stale_pr_after_run"
        } else {
          run_outcome.status
        }
      },
      detail: stale_note + "${run_outcome.detail}; PR #${pr.number} on ${pr.headRefName}; ${probe.evidence}",
    }
  }
  return {outcome: outcome, pr: pr}
}

fn with_auto_merge(slug, classified) {
  let with_pr = classified.outcome
  let pr = classified.pr
  if pr == nil || with_pr.status == "stale_pr_after_run" {
    return with_pr
  }
  let am = if pr.autoMergeRequest ?? nil != nil {
    "already_enabled"
  } else {
    ensure_auto_merge(slug, pr.number)
  }
  let detail = if starts_with(am, "failed") {
    "${with_pr.detail}; auto-merge: ${am}"
  } else {
    with_pr.detail
  }
  return {...with_pr, auto_merge: am, detail: detail}
}

fn bump_one(repo, target, dry_run) {
  let started_ms = now_ms()
  let remote_pin = read_remote_pin(repo.slug)
  let local_pin = read_pre_pin(repo.dir)
  let base = make_outcome(repo, local_pin, remote_pin)
  if dry_run {
    return dry_run_outcome(base, target, started_ms)
  }
  let target_no_v = strip_v(target)
  let pre = predispatch_resolution(repo, base, target, target_no_v, remote_pin, started_ms)
  if pre.done {
    return pre.outcome
  }
  let run_outcome = dispatch_bump_workflow(repo, base, target, started_ms)
  let classified = classify_post_dispatch(repo.slug, target, target_no_v, run_outcome, pre.stale_note)
  let final = with_auto_merge(repo.slug, classified)
  return {...final, duration_ms: now_ms() - started_ms}
}

fn pr_target_probe(slug, pr, target) {
  let target_no_v = strip_v(target)
  let pin = read_remote_pin_at_ref(slug, pr.headRefName)
  if pin == nil {
    return {matches: false, pin: nil, evidence: "PR head pin is unknown"}
  }
  return {matches: pin == target_no_v, pin: pin, evidence: "PR head pin is ${pin}; target is ${target_no_v}"}
}

fn completed_run_after(slug, after_iso) {
  let runs = try {
    gh_workflow_runs(slug, "bump-harn.yml", "workflow_dispatch", 10)
  } catch (e) {
    nil
  }
  if runs == nil {
    return nil
  }
  var best = nil
  for r in runs {
    if r.createdAt >= after_iso {
      if best == nil || r.createdAt > best.createdAt {
        best = r
      }
    }
  }
  if best != nil && best.status == "completed" {
    return {id: best.databaseId, url: best.url, conclusion: best.conclusion ?? "unknown", status: best.status}
  }
  return nil
}

fn poll_for_completion(slug, after_iso) {
  return poll_until(
    fn() { return completed_run_after(slug, after_iso) },
    {timeout_ms: MAX_POLL_MS, interval_ms: POLL_INTERVAL_MS},
  )
}

fn find_existing_pr(slug) {
  let prs = try {
    gh_json_argv(
      [
        "pr",
        "list",
        "--repo",
        slug,
        "--head",
        BUMP_BRANCH,
        "--base",
        "main",
        "--state",
        "open",
        "--json",
        "number,url,title,headRefName,autoMergeRequest,headRefOid",
        "--limit",
        "1",
      ],
    )
  } catch (e) {
    nil
  }
  if prs == nil {
    return nil
  }
  if len(prs) == 0 {
    return nil
  }
  return prs[0]
}

fn probe_post_dispatch_state(slug, target, target_no_v) {
  let pr = find_existing_pr(slug)
  let remote = read_remote_pin(slug)
  let probe = if pr == nil {
    nil
  } else {
    pr_target_probe(slug, pr, target)
  }
  let settled = (pr != nil && probe.matches) || (pr == nil && remote != nil && remote == target_no_v)
  return {settled: settled, pr: pr, pr_probe: probe, remote_pin: remote}
}

fn settled_post_dispatch_state(slug, target, target_no_v) {
  let snap = probe_post_dispatch_state(slug, target, target_no_v)
  if snap.settled {
    return snap
  }
  return nil
}

fn wait_for_post_dispatch_state(slug, target) {
  let target_no_v = strip_v(target)
  let hit = poll_until(
    fn() { return settled_post_dispatch_state(slug, target, target_no_v) },
    {timeout_ms: POST_RUN_SETTLE_MS, interval_ms: POST_RUN_SETTLE_POLL_MS},
  )
  if hit != nil {
    return hit
  }
  return probe_post_dispatch_state(slug, target, target_no_v)
}

// -------------------------------------------------------------------------------------------------
// Audit & summary.
// -------------------------------------------------------------------------------------------------

fn render_local_prompt(name, data) {
  return render_string(read_file("prompts/" + name), data)
}

fn write_audit(run_id, payload) {
  let runs_root = "${cwd()}/.harn-runs/bump-fleet/${run_id}"
  mkdir(runs_root, true)
  let body = json_stringify(payload)
  let json_path = "${runs_root}/audit.json"
  write_file(json_path, body + "\n")
  let md_payload = {...payload, audit_sha: sha3_256(body)[0:16]}
  let md = render_local_prompt("audit_report.harn.prompt", md_payload)
  let md_path = "${runs_root}/audit.md"
  write_file(md_path, md)
  return {json_path: json_path, md_path: md_path}
}

fn summarize_with_local_llm(payload) {
  let system = render_local_prompt("bump_summary_system.harn.prompt", {})
  let prompt = "Audit JSON:\n```json\n" + json_stringify(payload) + "\n```\nBullets:\n"
  let first = llm_summary_once(prompt, system)
  if bump_summary_format_ok(first) {
    return bump_summary_result(payload, [first])
  }
  let retry_prompt = render_local_prompt("bump_summary_retry.harn.prompt", {audit_json: json_stringify(payload)})
  let second = llm_summary_once(retry_prompt, system)
  return bump_summary_result(payload, [first, second])
}

fn llm_summary_once(prompt, system) {
  let r = try {
    summary_agent(
      prompt,
      {
        system: system,
        provider: SUMMARY_PROVIDER,
        model: SUMMARY_MODEL,
        max_tokens: 400,
        temperature: 0.0,
        llm_caller: with_retry(default_llm_caller(), {max_attempts: 2}),
      },
    )
  } catch (e) {
    return "(local LLM summary unavailable: ${e})"
  }
  let raw = trim(r.visible_text ?? r.text ?? r.prose ?? "")
  return trim(regex_replace("(?s)<think>.*?</think>", "", raw))
}

// -------------------------------------------------------------------------------------------------
// Entry point.
// -------------------------------------------------------------------------------------------------

fn resolve_latest_release() {
  return gh_latest_release_tag(HARN_REPO)
}

fn wait_for_target_release_readiness(target) {
  let stop_at_ms = now_ms() + RELEASE_READINESS_MAX_MS
  var attempt = 1
  var last = nil
  while now_ms() <= stop_at_ms {
    let snapshot = harn_release_readiness(target)
    last = snapshot
    if snapshot.ready {
      return snapshot + {timed_out: false, attempts: attempt}
    }
    println("   attempt ${attempt}: ${release_readiness_detail(snapshot)}")
    let remaining_ms = stop_at_ms - now_ms()
    if remaining_ms <= 0 {
      break
    }
    sleep_ms(
      if remaining_ms < RELEASE_READINESS_POLL_MS {
        remaining_ms
      } else {
        RELEASE_READINESS_POLL_MS
      },
    )
    attempt = attempt + 1
  }
  return last ?? harn_release_readiness(target) + {timed_out: true, attempts: attempt}
}

fn restore_local_checkout_to_main(dry_run) {
  if dry_run {
    return nil
  }
  return checkout_cleanup(nil, "main", cwd())
}

fn error_outcome_for_repo(repo, message) {
  return base_outcome_fields(repo, read_pre_pin(repo.dir), nil) + {status: "error", detail: message}
}

pipeline main() {
  let parsed = parse_fleet_args(argv)
  let target = parsed.target ?? resolve_latest_release()
  if !is_v_semver(target) {
    eprintln("error: target must look like vX.Y.Z, got '${target}'")
    return 2
  }
  let run_id = uuid_v7()
  let started_ms = now_ms()
  let started_iso = date_now_iso()
  let mode_label = if parsed.dry_run {
    "dry-run"
  } else {
    "live"
  }
  println("== harn-bump-fleet run ${run_id}")
  println("   target version : ${target}")
  println("   mode           : ${mode_label}")
  let all_repos = discover_repos()
  let repos = if parsed.only != nil {
    all_repos.filter({ r -> r.slug == parsed.only })
  } else {
    all_repos
  }
  println("   repos discovered: ${len(all_repos)} (running on ${len(repos)})")
  for r in repos {
    println("     - ${r.slug}  (${r.dir})")
  }
  if len(repos) == 0 {
    eprintln("no candidate repos matched (only=${parsed.only ?? \"\"})")
    return 1
  }
  if !parsed.dry_run {
    println("\n== waiting for target release readiness ...")
    let readiness = wait_for_target_release_readiness(target)
    if !readiness.ready {
      eprintln(
        "error: target release ${target} was not ready after ${readiness.attempts} checks: "
          + release_readiness_detail(readiness),
      )
      return 1
    }
    println("   ready: ${release_readiness_detail(readiness)}")
  }
  println("\n== dispatching (max_concurrent=${PARALLEL_LIMIT}) ...")
  let settled = parallel settle repos with { max_concurrent: PARALLEL_LIMIT } { repo ->
    bump_one(repo, target, parsed.dry_run)
  }
  let outcomes = map_settled(
    settled.results,
    { value, _index -> value },
    { msg, index -> error_outcome_for_repo(repos[index], msg) },
  )
  for row in outcomes {
    println("   ${row.slug}: ${row.status}")
  }
  let finished_iso = date_now_iso()
  let core_payload = {
    run_id: run_id,
    started_iso: started_iso,
    finished_iso: finished_iso,
    duration_ms: now_ms() - started_ms,
    operator: username(),
    host: hostname(),
    target_version: target,
    mode: mode_label,
    repos_total: len(repos),
    repos_dispatched: len(outcomes.filter({ o -> dispatched_status(o.status) })),
    summary_model: SUMMARY_MODEL,
    summary_text: "",
    outcomes: outcomes,
  }
  println("\n== summarizing with ${SUMMARY_MODEL} ...")
  let summary_result = if parsed.dry_run {
    bump_summary_skipped(core_payload, "(skipped on dry-run)")
  } else {
    summarize_with_local_llm({...core_payload, summary_text: ""})
  }
  let summary_text = summary_result.text
  let cleanup = restore_local_checkout_to_main(parsed.dry_run)
  if cleanup != nil {
    println("\n== local checkout cleanup")
    println("   ${cleanup.detail}")
  }
  let payload = {...core_payload, summary_text: summary_text, summary: summary_result, cleanup: cleanup}
  let written = write_audit(run_id, payload)
  println("\n== audit written")
  println("   json: ${written.json_path}")
  println("   md  : ${written.md_path}")
  println("\n${summary_text}")
  let any_error = outcomes
    .any({ o -> bump_summary_problem_outcome(o) })
  return if any_error {
    1
  } else {
    0
  }
}
