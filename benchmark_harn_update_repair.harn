#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import {
  FleetRepairCandidate,
  FleetRepairPolicy,
  REPAIR_CONTRACT_REVISION,
  repair_fleet_candidate_in_checkout,
} from "lib/fleet_repair"
import { harn_update_runtime_provenance } from "lib/harn_update"

type Options = {
  repository_dir: string,
  head_sha: string,
  route: "auto" | "value" | "strong",
  max_attempts: int,
}

const ARG_SPEC: ParserSpec = {
  name: "benchmark-harn-update-repair",
  args: [
    {kind: "flag", name: "repository_dir", long: "--repository-dir", required: true},
    {kind: "flag", name: "head_sha", long: "--head-sha", required: true},
    {kind: "flag", name: "route", long: "--route", default: "auto"},
    {kind: "flag", name: "max_attempts", long: "--max-attempts", parse: "int", default: 3},
  ],
}

const FAILED_CHECKS = [
  {
    name: "Rust TUI harn-linked clippy, test & build",
    details:
      "Rust 1.95 Clippy rejects crates/burin-tui/engine/src/dependency_roots.rs: use `normalized.parent()?;` instead of an if-return block; destructure `ProcessError::SpawnIo { kind: \"permission_denied\", message }` rather than a guard; replace `vec![program.to_string()]` with `[program.to_string()]`.",
  },
]

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if !starts_with(options.repository_dir, "/") || len(options.head_sha) != 40 {
    throw "benchmark requires an absolute checkout and an exact 40-character head SHA"
  }
  const head = harness.process.run(
    {program: "git", args: ["rev-parse", "HEAD"], cwd: options.repository_dir},
  )
  const clean = harness.process.run(
    {program: "git", args: ["status", "--porcelain"], cwd: options.repository_dir},
  )
  if !head.success || lowercase(trim(head.stdout)) != lowercase(options.head_sha)
    || !clean.success
    || trim(clean.stdout) != "" {
    throw "benchmark checkout must start clean at its declared historical commit"
  }
  const candidate: FleetRepairCandidate = {
    // This non-existent slug deliberately proves the benchmark cannot publish.
    // The canonical repair code will reach publication only after local
    // validation, where the connector refuses this unowned repository.
    repo: "burin-labs/harn-update-benchmark-no-publish",
    directory: options.repository_dir,
    pr_number: 6238,
    pr_url: "https://github.com/burin-labs/burin-code/pull/6238",
    head_sha: options.head_sha,
    validation_command:
      "cd crates/burin-tui && BURIN_ALLOW_RAW_CARGO=1 cargo clippy -p burin-tui-engine --lib --tests -- -D warnings",
    failing_checks: FAILED_CHECKS,
    allowed_new_files: [],
    branch: "automation/bump-harn-runtime",
    auto_arm: true,
    require_signed_head: true,
  }
  let policy: FleetRepairPolicy = {
    max_rounds: 1,
    max_repositories: 1,
    max_attempts_per_repository: options.max_attempts,
    max_tokens_per_attempt: 6000,
    max_cost_per_attempt_usd: 0.6,
    max_cost_per_repository_usd: 1.8,
    max_cost_per_run_usd: 1.8,
    runtime_provenance: harn_update_runtime_provenance(
      {runtime: harness.runtime, controller_revision: "local"},
      REPAIR_CONTRACT_REVISION,
    ),
    provider_secret_reference: "CEREBRAS_API_KEY",
  }
  if options.route == "value" {
    policy = policy + {route_override: "value"}
  } else if options.route == "strong" {
    policy = policy + {route_override: "strong"}
  }
  const result = repair_fleet_candidate_in_checkout(harness, candidate, "v0.10.95", policy)
  harness.stdio.println(
    json_stringify_pretty(
      {
        schema_version: "harn_bump_fleet.harn_update_benchmark.v1",
        case: "burin_code_6238_rust_1_95_clippy_repair",
        route_requested: options.route,
        historical_commit: options.head_sha,
        result: result,
      },
    ),
  )
  return if result.reason == "validated_published_and_auto_merge_armed"
    || contains(result.reason, "repair publication failed") {
    0
  } else {
    1
  }
}
