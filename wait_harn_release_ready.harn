#!/usr/bin/env harn
import { help_requested } from "std/cli/argparse"
import { gha_write_output } from "std/gha"
import { is_v_semver } from "std/semver"
import { cli_options } from "lib/cli_options"
import { live_release_readiness_adapter, wait_for_harn_release } from "lib/release_readiness"

pub type ReleaseReadinessOptions = {
  tag: string,
  repo: string,
  max_attempts: int,
  interval_seconds: int,
  timeout_seconds: int,
}

const ARG_SPEC = {
  name: "wait-harn-release-ready",
  args: [
    {kind: "flag", name: "tag", long: "--tag", default: ""},
    {kind: "flag", name: "repo", long: "--repo", default: "burin-labs/harn"},
    {kind: "flag", name: "max_attempts", long: "--max-attempts", parse: "int", default: 180},
    {kind: "flag", name: "interval_seconds", long: "--interval-seconds", parse: "int", default: 20},
    {kind: "flag", name: "timeout_seconds", long: "--timeout-seconds", parse: "int", default: 7200},
  ],
}

pub fn parse_release_readiness_args(args: list<string>) -> ReleaseReadinessOptions {
  const options = cli_options<ReleaseReadinessOptions>(
    ARG_SPEC,
    args,
    schema_of(ReleaseReadinessOptions),
  )
  if !is_v_semver(options.tag) || regex_match("^v[0-9]+\\.[0-9]+\\.[0-9]+$", options.tag) == nil {
    throw "expected Harn tag like v0.8.165, got '${options.tag}'"
  }
  if trim(options.repo) == "" {
    throw "--repo must be a non-empty owner/name slug"
  }
  if options.max_attempts < 1 || options.interval_seconds < 1 || options.timeout_seconds < 1 {
    throw "release readiness polling bounds must be positive integers"
  }
  if options.max_attempts > 1000000 || options.interval_seconds > 86400
    || options.timeout_seconds
    > 31536000 {
    throw "release readiness polling bounds exceed practical limits"
  }
  return options
}

pipeline main() {
  if help_requested(argv) {
    harness.stdio.println(
      "Usage: harn run --no-sandbox wait_harn_release_ready.harn -- --tag vX.Y.Z [--repo OWNER/REPO] [--max-attempts N] [--interval-seconds N] [--timeout-seconds N]",
    )
    return 0
  }
  const options = parse_release_readiness_args(argv)
  const tag = options.tag
  const result = wait_for_harn_release(
    tag,
    live_release_readiness_adapter(harness, options.repo),
    {
      max_attempts: options.max_attempts,
      interval_ms: options.interval_seconds * 1000,
      timeout_ms: options.timeout_seconds * 1000,
    },
  )
  for line in result.attempt_lines {
    harness.stdio.println(line)
  }
  gha_write_output("ready", result.ready)
  if result.ready {
    harness.stdio.println(
      "harn-cli ${result.snapshot.version_no_v} is published, required release assets are present, and the GitHub release is finalized.",
    )
  } else {
    harness.stdio.println("Skipping bump: ${tag} is not fully published yet.")
  }
  return 0
}
