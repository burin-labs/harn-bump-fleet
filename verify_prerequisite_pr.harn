#!/usr/bin/env harn
import { help_requested } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { load_prerequisite_pr } from "lib/prerequisite_prs"

type PrerequisiteOptions = {repo: string, pr: int, expected_head: string, json: bool}

const ARG_SPEC = {
  name: "verify-prerequisite-pr",
  args: [
    {kind: "flag", name: "repo", long: "--repo", required: true},
    {kind: "flag", name: "pr", long: "--pr", required: true, parse: "int"},
    {kind: "flag", name: "expected_head", long: "--expected-head", default: ""},
    {kind: "switch", name: "json", long: "--json"},
  ],
}

pub fn parse_prerequisite_args(args: list<string>) -> PrerequisiteOptions {
  const options = cli_options<PrerequisiteOptions>(ARG_SPEC, args, schema_of(PrerequisiteOptions))
  if options.pr <= 0 {
    throw "--pr must be a positive integer"
  }
  return options
}

fn usage() -> string {
  return trim(
    """
Usage: harn run --no-sandbox verify_prerequisite_pr.harn -- --repo OWNER/REPO --pr NUMBER [--expected-head SHA] [--json]

Verifies that a release prerequisite pull request is merged, and optionally that
its observed head still matches the head named by the operator directive.
""",
  )
}

pipeline main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(usage())
    return
  }
  const parsed = parse_prerequisite_args(argv)
  const status = load_prerequisite_pr(harness, parsed.repo, parsed.pr, parsed.expected_head)
  if parsed.json {
    harness.stdio.println(json_stringify(status))
  } else {
    const mark = if status.ok {
      "PASS"
    } else {
      "BLOCK"
    }
    harness.stdio.println("${mark} ${status.repo}#${status.number}: ${status.status}")
    harness.stdio.println("  detail: ${status.detail}")
    if (status.head_oid ?? "") != "" {
      harness.stdio.println("  head  : ${status.head_oid}")
    }
    if (status.expected_head_oid ?? "") != "" {
      harness.stdio.println("  expect: ${status.expected_head_oid}")
    }
    if (status.merged_at ?? "") != "" {
      harness.stdio.println("  merged: ${status.merged_at}")
    }
    if (status.merge_commit_oid ?? "") != "" {
      harness.stdio.println("  commit: ${status.merge_commit_oid}")
    }
  }
  if !status.ok {
    throw "release prerequisite PR is not satisfied: " + status.detail
  }
}
