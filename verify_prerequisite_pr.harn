#!/usr/bin/env harn
import { parse_args } from "std/cli"
import { load_prerequisite_pr } from "lib/prerequisite_prs"

const ARG_SPEC = [
  {kind: "flag", name: "help", flags: ["--help", "-h"]},
  {kind: "option", name: "repo", flags: ["--repo"], required: true},
  {kind: "option", name: "pr", flags: ["--pr"], required: true},
  {kind: "option", name: "expected_head", flags: ["--expected-head"], default: ""},
  {kind: "flag", name: "json", flags: ["--json"]},
]

fn usage() -> string {
  return trim(
    """
Usage: harn run --no-sandbox verify_prerequisite_pr.harn -- --repo OWNER/REPO --pr NUMBER [--expected-head SHA] [--json]

Verifies that a release prerequisite pull request is merged, and optionally that
its observed head still matches the head named by the operator directive.
""",
  )
}

pipeline main() {
  const parsed = parse_args(argv, ARG_SPEC)
  if parsed.help {
    harness.stdio.println(usage())
    return
  }
  if len(parsed._errors ?? []) > 0 {
    throw join(parsed._errors, "; ")
  }
  if len(parsed._extras ?? []) > 0 {
    throw "unknown argument: " + parsed._extras[0]
  }
  const number = to_int(parsed.pr)
  if number == nil || number <= 0 {
    throw "--pr must be a positive integer"
  }
  const status = load_prerequisite_pr(parsed.repo, number, parsed.expected_head ?? "")
  if parsed.json {
    harness.stdio.println(json_stringify(status))
  } else {
    const mark = if status.ok {
      "PASS"
    } else {
      "BLOCK"
    }
    harness.stdio.println("${mark} ${status.repo}#${status.number}: ${status.status}")
    harness.stdio.println("  detail: ${status.detail}")
    if (status.head_oid ?? "") != "" {
      harness.stdio.println("  head  : ${status.head_oid}")
    }
    if (status.expected_head_oid ?? "") != "" {
      harness.stdio.println("  expect: ${status.expected_head_oid}")
    }
    if (status.merged_at ?? "") != "" {
      harness.stdio.println("  merged: ${status.merged_at}")
    }
    if (status.merge_commit_oid ?? "") != "" {
      harness.stdio.println("  commit: ${status.merge_commit_oid}")
    }
  }
  if !status.ok {
    throw "release prerequisite PR is not satisfied: " + status.detail
  }
}
