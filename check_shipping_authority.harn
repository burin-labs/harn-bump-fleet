#!/usr/bin/env harn
import { read_fleet_manifest } from "lib/fleet_manifest"
import {
  require_shipping_enrollment_retained,
  shipping_authority_census,
  shipping_baseline_manifest,
} from "lib/shipping_authority"

/** Enforce complete routing declarations and irreversible managed enrollment. */
fn main(harness: Harness) {
  const manifest = read_fleet_manifest(harness.fs)
  const census = shipping_authority_census(manifest)
  harness.stdio.println(
    json_stringify(
      {
        required: census.required_count,
        declared: census.declared_count,
        valid: len(census.records),
        missing: census.missing,
        invalid: census.invalid,
      },
    ),
  )
  require census.required_count > 0 && census.required_count == len(census.records)
    && len(census.missing) == 0
    && len(census.invalid) == 0,
    "shipping ownership census is incomplete"
  const baseline = harness.env.get("FLEET_SHIPPING_BASE_SHA") ?? ""
  require baseline != "" || harness.env.get("CI") != "true",
    "CI requires the shipping registry comparison commit"
  if baseline != "" {
    const retained = require_shipping_enrollment_retained(
      shipping_baseline_manifest(harness.process, baseline),
      manifest,
    )
    harness.stdio.println("managed enrollments retained: ${retained}")
  }
}
