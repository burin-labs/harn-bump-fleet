#!/usr/bin/env harn
// Resume post-tag Harn release monitoring from a durable typed receipt.
import { help_requested } from "std/cli/argparse"
import { env_str } from "std/config"
import { cli_options } from "lib/cli_options"
import { execution_failed } from "lib/release_execution"
import { release_queue_refresh_or_throw, release_queue_restore_step } from "lib/release_queue_gate"
import {
  mock_release_ref_cleanup_adapter,
  release_ref_cleanup_receipt_path,
  run_release_ref_cleanup,
} from "lib/release_ref_cleanup"
import { run_release_ref_sweep } from "lib/release_ref_sweep"
import { release_run_root } from "lib/release_runtime"
import { release_watch_guard_acquire, release_watch_guard_finish } from "lib/release_watch_guard"
import { import_hosted_release_watch_receipt } from "lib/release_watch_handoff"
import {
  release_watch_progress_key,
  release_watch_progress_lines,
  release_watch_progress_should_emit,
} from "lib/release_watch_progress"
import {
  ReleaseWatchProgressSink,
  mock_release_watch_adapter,
  run_release_watch,
} from "lib/release_watch_runtime"
import {
  release_watch_receipt,
  release_watch_receipt_path,
  release_watch_receipt_read,
  release_watch_receipt_write,
} from "lib/release_watch_state"
import { ensure_release_sandbox } from "lib/sandbox_preflight"

pub type ReleaseWatchOptions = {
  tag: string,
  receipt: string,
  hosted_run?: int?,
  max_polls: int,
  interval_seconds: int,
  yes_live_release: bool,
  observe_only: bool,
  no_recovery: bool,
  warm_cache: bool,
  no_pr_watchdog: bool,
  no_ref_cleanup: bool,
  repo: string,
  mock: bool,
  json: bool,
}

const WATCH_ARG_SPEC = {
  name: "watch-harn-release",
  args: [
    {kind: "flag", name: "tag", long: "--tag", default: ""},
    {kind: "flag", name: "receipt", long: "--receipt", default: ""},
    {kind: "flag", name: "hosted_run", long: "--hosted-run", parse: "int", default: nil},
    {kind: "flag", name: "max_polls", long: "--max-polls", parse: "int", default: 240},
    {kind: "flag", name: "interval_seconds", long: "--interval-seconds", parse: "int", default: 30},
    {kind: "switch", name: "yes_live_release", long: "--yes-live-release"},
    {kind: "switch", name: "observe_only", long: "--observe-only"},
    {kind: "switch", name: "no_recovery", long: "--no-recovery"},
    {kind: "switch", name: "warm_cache", long: "--warm-cache"},
    {kind: "switch", name: "no_pr_watchdog", long: "--no-pr-watchdog"},
    {kind: "switch", name: "no_ref_cleanup", long: "--no-ref-cleanup"},
    {kind: "flag", name: "repo", long: "--repo", default: ""},
    {kind: "switch", name: "mock", long: "--mock"},
    {kind: "switch", name: "json", long: "--json"},
  ],
}

pub fn parse_release_watch_args(args: list<string>) -> ReleaseWatchOptions {
  const options = cli_options<ReleaseWatchOptions>(
    WATCH_ARG_SPEC,
    args,
    schema_of(ReleaseWatchOptions),
  )
  if options.max_polls < 1 {
    throw "--max-polls must be a positive integer"
  }
  if options.interval_seconds < 0 {
    throw "--interval-seconds must be a non-negative integer"
  }
  if options.hosted_run != nil && options.hosted_run <= 0 {
    throw "--hosted-run must be a positive GitHub Actions run ID"
  }
  return options
}

fn usage() {
  return """
Usage:
  scripts/watch_harn_release.sh --tag vX.Y.Z --yes-live-release

Resumes a durable post-tag monitor. The ship command writes the receipt before
returning; this command may be stopped and rerun without repeating release
preparation, tag creation, recovery dispatch, or an accepted warm attempt. The
normal command continues until the release PR merges. An explicit warm attempt
continues until its matrix completes or fails. Poll exhaustion returns a durable
pending receipt that the same command resumes by exact run ID.

Flags:
  --tag vX.Y.Z          Release tag whose receipt should be resumed.
  --receipt PATH        Override the default receipt path.
  --hosted-run RUN_ID   Import the receipt uploaded by this hosted release run.
  --max-polls N         Maximum snapshots before returning pending (default 240).
  --interval-seconds N  Delay between live snapshots (default 30).
  --yes-live-release    Required because red binary builds may dispatch recovery.
  --observe-only        Poll status without PR rearm, recovery, or cache warm actions.
  --no-recovery         Observe only; do not dispatch binary recovery.
  --warm-cache          Opt into the five-target post-publish main-cache warm.
  --no-pr-watchdog      Do not re-arm the release pull request while polling.
  --no-ref-cleanup      Retain transient release refs after terminal proof.
  --repo PATH           Local Harn checkout used for exact leased ref cleanup.
  --mock                Rehearse release readiness; add --warm-cache to rehearse warming.
  --json                Print one machine-readable result.
"""
}

fn harness_root(fs: HarnessFs) {
  const root = fs.runtime_paths().asset_root
  const leaf = basename(root)
  if leaf == "lib" || leaf == "tests" {
    return dirname(root)
  }
  return root
}

pipeline main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(usage())
    return 0
  }
  const parsed = parse_release_watch_args(argv)
  const sandbox_error = ensure_release_sandbox(
    {stdio: harness.stdio, system: harness.system},
    "watch_harn_release.harn",
  )
  if sandbox_error != nil {
    return sandbox_error
  }
  const tag = trim(parsed.tag)
  if tag == "" {
    throw "--tag vX.Y.Z is required"
  }
  if !parsed.yes_live_release && !parsed.mock {
    throw "--yes-live-release is required for release monitoring and recovery"
  }
  const max_polls = parsed.max_polls
  const interval_seconds = parsed.interval_seconds
  const default_root = path_join(harness_root(harness.fs), ".harn-runs", "release-harn")
  const receipt_path = if trim(parsed.receipt) != "" {
    parsed.receipt
  } else {
    release_watch_receipt_path(default_root, tag)
  }
  const watch_guard = release_watch_guard_acquire(
    harness.host_lease,
    {tag: tag, receipt_path: receipt_path, mock: parsed.mock},
  )
  try {
    let receipt = if parsed.hosted_run != nil {
      import_hosted_release_watch_receipt(
        {fs: harness.fs, process: harness.process, random: harness.random},
        {
          repo_root: harness_root(harness.fs),
          tag: tag,
          run_id: parsed.hosted_run ?? 0,
          destination: receipt_path,
        },
      )
    } else {
      release_watch_receipt_read(harness.fs, receipt_path)
    }
    if receipt == nil && parsed.mock {
      const mock_head = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      const mock_version = tag.substring(1)
      receipt = release_watch_receipt(
        {
          tag: tag,
          slug: "burin-labs/harn",
          pin_sha: mock_head,
          publication: {
            version: mock_version,
            local_branch: "release/${tag}",
            remote_ref: "release-attempt/${tag}/${mock_head}",
            head_oid: mock_head,
          },
          pr_url: "https://github.com/burin-labs/harn/pull/1",
          created_at: "2026-07-13T00:00:00Z",
        },
      )
      release_watch_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, receipt)
    }
    if receipt == nil {
      throw "missing or invalid release watch receipt: " + receipt_path
    }
    if receipt.tag != tag {
      throw "receipt tag ${receipt.tag} does not match requested ${tag}"
    }
    const observe_only = parsed.observe_only ?? false
    const no_recovery = observe_only || (parsed.no_recovery ?? false)
    // Repeating the five hosted release targets after every publication is
    // intentionally opt-in. Release cadence can be multiple times per day, so
    // default warming could duplicate hundreds of hosted build-hours monthly.
    const warm_cache_requested = !observe_only && (parsed.warm_cache ?? false)
    const no_pr_watchdog = observe_only || (parsed.no_pr_watchdog ?? false)
    const no_ref_cleanup = observe_only || (parsed.no_ref_cleanup ?? false)
    if !parsed.json {
      harness.stdio.println("== watching ${tag}")
      harness.stdio.println("   receipt: ${receipt_path}")
      harness.stdio.println("   resume : rerun this command with the same --tag")
    }
    const adapter = if parsed.mock {
      mock_release_watch_adapter(receipt)
    } else {
      nil
    }
    let last_progress_key = ""
    let last_progress_poll = 0
    const operator_progress_sink: ReleaseWatchProgressSink? = if parsed.json {
      nil
    } else {
      { progress, path, poll ->
        if !release_watch_progress_should_emit(
          last_progress_key,
          progress,
          poll,
          last_progress_poll,
        ) {
          return nil
        }
        harness.stdio.println(
          "== progress poll ${poll} at ${progress.observed_at}; receipt: ${path}",
        )
        for line in release_watch_progress_lines(progress) {
          harness.stdio.println("   " + line)
        }
        last_progress_key = release_watch_progress_key(progress)
        last_progress_poll = poll
        return nil
      }
    }
    const progress_sink: ReleaseWatchProgressSink = { progress, path, poll ->
      if !observe_only {
        release_queue_refresh_or_throw(harness, release_run_root(harness.fs))
      }
      if operator_progress_sink != nil {
        operator_progress_sink(progress, path, poll)
      }
      return nil
    }
    const interval_ms = if parsed.mock {
      0
    } else {
      interval_seconds * 1000
    }
    const runtime_options = {
      max_polls: max_polls,
      interval_ms: interval_ms,
      dispatch_recovery: !no_recovery,
      dispatch_warm_cache: warm_cache_requested,
      keep_pr_armed: !no_pr_watchdog,
      on_progress: progress_sink,
    }
    const result = run_release_watch(harness, receipt, receipt_path, runtime_options, adapter)
    const queue_restore = if result.status != 3 && !observe_only {
      release_queue_restore_step(harness, release_run_root(harness.fs))
    } else {
      nil
    }
    const repo = if trim(parsed.repo) != "" {
      parsed.repo
    } else {
      path_join(env_str(harness.env, "HOME") ?? "", "projects/harn")
    }
    const cleanup = if result.status == 0
      && (result.receipt.warm_cache.state == "completed"
      || !warm_cache_requested)
      && !no_ref_cleanup {
      run_release_ref_cleanup(
        harness,
        result.receipt,
        receipt_path,
        repo,
        if parsed.mock {
          mock_release_ref_cleanup_adapter(result.receipt)
        } else {
          nil
        },
      )
    } else {
      nil
    }
    const sweep = if cleanup != nil && cleanup.state != "blocked" && !parsed.mock {
      run_release_ref_sweep(
        harness,
        {
          repo: repo,
          slug: result.receipt.slug,
          mode: "apply",
          receipt_path: receipt_path + ".ref-sweep.json",
        },
      )
    } else {
      nil
    }
    const final_status = if cleanup?.state == "blocked" || sweep?.state == "blocked"
      || (queue_restore
      != nil
      && execution_failed([queue_restore])) {
      2
    } else {
      result.status
    }
    if parsed.json {
      harness.stdio.println(
        json_stringify(
          result
            + {
            status: final_status,
            ref_cleanup: cleanup,
            ref_sweep: sweep,
            queue_restore: queue_restore,
          },
        ),
      )
    } else {
      harness.stdio.println("== ${result.state} after ${result.polls} poll(s)")
      harness.stdio.println("   warm    : ${result.receipt.warm_cache.state}")
      if result.progress != nil {
        for line in release_watch_progress_lines(result.progress) {
          harness.stdio.println("   " + line)
        }
      }
      harness.stdio.println("   receipt: ${receipt_path}")
      if queue_restore != nil {
        harness.stdio.println(
          "   queue   : "
            + if execution_failed([queue_restore]) {
            "restore failed"
          } else {
            "restored exact held heads"
          },
        )
      }
      if cleanup != nil {
        harness.stdio.println(
          "   cleanup : ${cleanup.state} (${len(cleanup.refs)} exact ref(s)); receipt: "
            + release_ref_cleanup_receipt_path(
            receipt_path,
          ),
        )
      }
      if sweep != nil {
        harness.stdio.println(
          "   sweep   : ${sweep.state} (${len(sweep.refs)} classified ref(s)); receipt: "
            + receipt_path
            + ".ref-sweep.json",
        )
      }
      if trim(result.reason ?? "") != "" {
        harness.stdio.println("   reason : ${result.reason}")
      }
    }
    return final_status
  } finally {
    const guard_finish = release_watch_guard_finish(harness.host_lease, watch_guard)
    if guard_finish?.error != nil {
      harness.stdio.eprintln(
        "warning: release watcher host lease cleanup failed after the durable watch result was written; "
          + "owner exit leaves the lease recoverable: "
          + guard_finish.error,
      )
    }
  }
}
