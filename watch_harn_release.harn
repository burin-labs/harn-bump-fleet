#!/usr/bin/env harn
import { help_requested } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { run_release_workflow_watch } from "lib/release_watch_runtime"
import { ensure_release_sandbox } from "lib/sandbox_preflight"

pub type ReleaseWatchOptions = {
  tag: string,
  receipt: string,
  release_pr: int,
  producer_run: int,
  max_polls: int,
  interval_seconds: int,
  json: bool,
}

const WATCH_ARG_SPEC = {
  name: "watch-harn-release",
  args: [
    {kind: "flag", name: "tag", long: "--tag", default: ""},
    {kind: "flag", name: "receipt", long: "--receipt", default: ""},
    {kind: "flag", name: "release_pr", long: "--release-pr", parse: "int", default: 0},
    {kind: "flag", name: "producer_run", long: "--producer-run", parse: "int", default: 0},
    {kind: "flag", name: "max_polls", long: "--max-polls", parse: "int", default: 240},
    {kind: "flag", name: "interval_seconds", long: "--interval-seconds", parse: "int", default: 30},
    {kind: "switch", name: "json", long: "--json"},
  ],
}

pub fn parse_release_watch_args(args: list<string>) -> ReleaseWatchOptions {
  const options = cli_options<ReleaseWatchOptions>(
    WATCH_ARG_SPEC,
    args,
    schema_of(ReleaseWatchOptions),
  )
  if options.max_polls < 1 {
    throw "--max-polls must be a positive integer"
  }
  if options.interval_seconds < 0 {
    throw "--interval-seconds must be a non-negative integer"
  }
  if options.release_pr < 0 || options.producer_run < 0 {
    throw "--release-pr and --producer-run must be positive when selected"
  }
  return options
}

pub fn validate_workflow_watch_options(options: ReleaseWatchOptions) -> string {
  if trim(options.receipt) == "" {
    throw "--receipt PATH is required for the canonical workflow handoff"
  }
  return options.receipt
}

fn usage() {
  return """
Usage:
  scripts/watch_harn_release.sh --receipt PATH --release-pr NUMBER --producer-run RUN_ID

Reads the canonical workflow handoff, binds the selected release PR and archive
producer attempt, verifies the merged source and reads certified archive bytes.
Resume with the same receipt; bound identities cannot change. Unmeasured publication
and downstream checks remain named pending. Exit 3 means pending; 2 means failed.

Flags:
  --receipt PATH        Required canonical workflow handoff path.
  --release-pr NUMBER   Explicit PR, retained after its first observation.
  --producer-run RUN_ID Explicit archive producer, with its attempt retained.
  --tag vX.Y.Z          Optional assertion against the recorded tag.
  --max-polls N         Maximum snapshots before returning pending (default 240).
  --interval-seconds N  Delay between snapshots (default 30).
  --json                Print machine-readable observations.
"""
}

pipeline main(harness: Harness) {
  if help_requested(argv) {
    harness.stdio.println(usage())
    return 0
  }
  const parsed = parse_release_watch_args(argv)
  const sandbox_error = ensure_release_sandbox(
    pick(harness, ["stdio", "system"]),
    "watch_harn_release.harn",
  )
  if sandbox_error != nil {
    return sandbox_error
  }
  return run_release_workflow_watch(
    harness,
    validate_workflow_watch_options(parsed),
    pick(parsed, ["tag", "release_pr", "producer_run", "max_polls", "interval_seconds", "json"]),
  )
}
