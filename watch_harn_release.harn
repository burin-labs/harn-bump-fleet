#!/usr/bin/env harn
// Resume post-tag Harn release monitoring from a durable typed receipt.
import { parse_args } from "std/cli"
import { run_release_watch } from "lib/release_watch_runtime"
import { release_watch_receipt_path, release_watch_receipt_read } from "lib/release_watch_state"
import { ensure_unrestricted_sandbox } from "lib/sandbox_preflight"

const WATCH_ARG_SPEC = [
  {kind: "option", name: "tag", flags: ["--tag"], default: ""},
  {kind: "option", name: "receipt", flags: ["--receipt"], default: ""},
  {kind: "option", name: "max_polls", flags: ["--max-polls"], default: "240"},
  {kind: "option", name: "interval_seconds", flags: ["--interval-seconds"], default: "30"},
  {kind: "flag", name: "yes_live_release", flags: ["--yes-live-release"]},
  {kind: "flag", name: "no_recovery", flags: ["--no-recovery"]},
  {kind: "flag", name: "no_warm_cache", flags: ["--no-warm-cache"]},
  {kind: "flag", name: "json", flags: ["--json"]},
  {kind: "flag", name: "help", flags: ["--help", "-h"]},
]

fn usage() {
  return """
Usage:
  harn run --no-sandbox watch_harn_release.harn -- --tag vX.Y.Z --yes-live-release

Resumes a durable post-tag monitor. The ship command writes the receipt before
returning; this command may be stopped and rerun without repeating release
preparation, tag creation, or recovery dispatch.

Flags:
  --tag vX.Y.Z          Release tag whose receipt should be resumed.
  --receipt PATH        Override the default receipt path.
  --max-polls N         Maximum snapshots before returning pending (default 240).
  --interval-seconds N  Delay between live snapshots (default 30).
  --yes-live-release    Required because red binary builds may dispatch recovery.
  --no-recovery         Observe only; do not dispatch binary recovery.
  --no-warm-cache       Do not dispatch the post-publish main-cache warm.
  --json                Print one machine-readable result.
"""
}

fn harness_root() {
  const root = runtime_paths().asset_root
  const leaf = basename(root)
  if leaf == "lib" || leaf == "tests" {
    return dirname(root)
  }
  return root
}

pipeline main() {
  const parsed = parse_args(argv, WATCH_ARG_SPEC)
  if (parsed._help ?? false) || (parsed.help ?? false) {
    harness.stdio.println(usage())
    return 0
  }
  if len(parsed._extras) > 0 {
    throw "unknown arg: " + parsed._extras[0]
  }
  if len(parsed._errors) > 0 {
    throw join(parsed._errors, "; ")
  }
  const sandbox_error = ensure_unrestricted_sandbox(harness, "watch_harn_release.harn")
  if sandbox_error != nil {
    return sandbox_error
  }
  const tag = trim(parsed.tag)
  if tag == "" {
    throw "--tag vX.Y.Z is required"
  }
  if !parsed.yes_live_release {
    throw "--yes-live-release is required for release monitoring and recovery"
  }
  const max_polls = to_int(parsed.max_polls)
  const interval_seconds = to_int(parsed.interval_seconds)
  if max_polls == nil || max_polls < 1 {
    throw "--max-polls must be a positive integer"
  }
  if interval_seconds == nil || interval_seconds < 0 {
    throw "--interval-seconds must be a non-negative integer"
  }
  const default_root = path_join(harness_root(), ".harn-runs", "release-harn")
  const receipt_path = if trim(parsed.receipt) != "" {
    parsed.receipt
  } else {
    release_watch_receipt_path(default_root, tag)
  }
  const receipt = release_watch_receipt_read(receipt_path)
  if receipt == nil {
    throw "missing or invalid release watch receipt: " + receipt_path
  }
  if receipt.tag != tag {
    throw "receipt tag ${receipt.tag} does not match requested ${tag}"
  }
  if !parsed.json {
    harness.stdio.println("== watching ${tag}")
    harness.stdio.println("   receipt: ${receipt_path}")
    harness.stdio.println("   resume : rerun this command with the same --tag")
  }
  const result = run_release_watch(
    harness,
    receipt,
    receipt_path,
    {
      max_polls: max_polls,
      interval_ms: interval_seconds * 1000,
      dispatch_recovery: !parsed.no_recovery,
      dispatch_warm_cache: !parsed.no_warm_cache,
    },
  )
  if parsed.json {
    harness.stdio.println(json_stringify(result))
  } else {
    harness.stdio.println("== ${result.state} after ${result.polls} poll(s)")
    harness.stdio.println("   receipt: ${receipt_path}")
    if trim(result.reason ?? "") != "" {
      harness.stdio.println("   reason : ${result.reason}")
    }
  }
  return result.status
}
