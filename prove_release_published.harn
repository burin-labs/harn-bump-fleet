#!/usr/bin/env harn
//
// prove_release_published.harn — establish whether one release is genuinely
// published, from the release's OWN observable state.
//
// This is deliberately not a re-run of the publication watcher. The watcher
// decides whether the tag-triggered workflow runs went green; this decides
// whether the release exists, which is a different question with a different
// answer whenever the watcher itself fails, times out, loses its credential,
// or is red for a reason that never touched the publication.
//
// The post-publication tail keys on this proof rather than on the watcher's
// exit status, so a prover that cannot confirm never silently disables the
// follow-through it was only ever meant to describe.
//
// Usage: harn run prove_release_published.harn -- --tag vX.Y.Z --repo /path/to/repo
import { ParserSpec } from "std/cli/argparse"
import { is_prerelease, strip_v } from "std/semver"
import { cli_options } from "lib/cli_options"
import { release_tag_verify_git_args } from "lib/release_execution"
import {
  ReleasePublicationEvidence,
  ReleasePublicationProof,
  release_publication_proof,
} from "lib/release_publication_proof"
import {
  live_release_readiness_adapter,
  missing_release_assets,
  required_harn_release_assets,
} from "lib/release_readiness"
import { run_git } from "lib/release_runtime"

type Options = {tag: string, repo: string, json: bool}

const ARG_SPEC: ParserSpec = {
  name: "prove-release-published",
  args: [
    {kind: "flag", name: "tag", long: "--tag", default: ""},
    {kind: "flag", name: "repo", long: "--repo", default: ""},
    {kind: "switch", name: "json", long: "--json"},
  ],
}

/**
 * Observe the tag from the checkout that owns it.
 *
 * The fetch is best effort: the lane that just published normally holds the tag
 * already, and a lane that does not must not read a fetch failure as an absent
 * tag. Presence and signature both come from the local object either way.
 */
fn observe_release_tag(
  git: {env: HarnessEnv, process: HarnessProcess},
  repo: string,
  tag: string,
) -> dict {
  const cfg = {repo: repo, mock: false}
  run_git(git, cfg, ["fetch", "--quiet", "origin", "refs/tags/${tag}:refs/tags/${tag}"])
  const object = run_git(git, cfg, ["rev-parse", "--verify", "--quiet", "refs/tags/${tag}"])
  const present = object.success && trim(object.stdout ?? "") != ""
  const signature = if present {
    run_git(git, cfg, release_tag_verify_git_args(tag))
  } else {
    {success: false}
  }
  return {
    present: present,
    object_oid: lowercase(trim(object.stdout ?? "")),
    signature_verified: present && (signature.success ?? false),
  }
}

pipeline main(harness: Harness) -> int {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const tag = trim(options.tag)
  const repo = trim(options.repo)
  if tag == "" || repo == "" {
    harness.stdio.eprintln(
      "usage: harn run prove_release_published.harn -- --tag vX.Y.Z --repo PATH [--json]",
    )
    return 2
  }
  const observed_tag = observe_release_tag({env: harness.env, process: harness.process}, repo, tag)
  // The same adapter the publication watcher reads, so the proof and the watch
  // cannot disagree about what the release looks like.
  const adapter = live_release_readiness_adapter(harness)
  const release = adapter.github_release(tag)
  const packages = adapter.crate_visibility(strip_v(tag))
  const required = required_harn_release_assets()
  const evidence: ReleasePublicationEvidence = {
    tag: tag,
    tag_present: observed_tag.present,
    tag_signature_verified: observed_tag.signature_verified,
    release_found: release.found,
    release_draft: release.draft,
    release_prerelease: release.prerelease,
    expected_prerelease: is_prerelease(strip_v(tag)),
    required_assets: required,
    missing_assets: missing_release_assets(release.asset_names, required),
    packages_published: packages.published,
  }
  const proof: ReleasePublicationProof = release_publication_proof(evidence)
  if options.json {
    harness.stdio.println(
      json_stringify_pretty(
        {...proof, tag_object_oid: observed_tag.object_oid, evidence: evidence},
      ),
    )
  } else {
    harness.stdio.println("== release publication proof")
    harness.stdio.println("   tag       : ${tag}")
    harness.stdio.println("   published : ${to_string(proof.published)}")
    harness.stdio.println("   detail    : ${proof.detail}")
  }
  // The proof is evidence, not a gate. `report_release_follow_through.harn`
  // owns the exit status, so a false proof still reaches the caller as data
  // rather than as a failed step that skips the very report meant to raise it.
  return 0
}
