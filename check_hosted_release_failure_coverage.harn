#!/usr/bin/env harn
//
// Keep the hosted release failure registry and the hosted release workflow in
// lockstep.
//
// The registry decides what a failed run means and whether a re-dispatch is a
// sane repair. It dispatches on the step name, which is a structured field, so
// a step added or renamed without a registry row would classify as unknown and
// escalate during a release rather than at the moment someone renamed it. This
// gate moves that failure to the pull request that causes it.
import { decode_github_workflow } from "lib/github_workflow"
import {
  HostedReleaseWorkflowJob,
  hosted_release_order_refusals,
  hosted_release_registry_findings,
  hosted_release_registry_refusals,
  hosted_release_step_order,
} from "lib/hosted_release_failure"

const WORKFLOW_PATH = ".github/workflows/hosted-release.yml"

pipeline main(harness: Harness) {
  const source = try {
    harness.fs.read_text(WORKFLOW_PATH)
  } catch (error) {
    harness.stdio.eprintln(
      "hosted release failure registry: could not read ${WORKFLOW_PATH}: ${to_string(error)}",
    )
    return 1
  }
  const workflow = try {
    decode_github_workflow(source)
  } catch (error) {
    harness.stdio.eprintln(
      "hosted release failure registry: could not decode ${WORKFLOW_PATH}: ${to_string(error)}",
    )
    return 1
  }
  let jobs: list<HostedReleaseWorkflowJob> = []
  for job in workflow.jobs {
    const declared = job.value.needs
    const needs: list<string> = if declared == nil {
      []
    } else if type_of(declared) == "string" {
      [to_string(declared)]
    } else {
      declared
    }
    jobs = jobs
      + [
        {
          job: job.key,
          needs: needs,
          steps: (job.value.steps ?? []).map({ step -> return step.name }).to_list(),
        },
      ]
  }
  const refusals = hosted_release_registry_refusals(jobs) + hosted_release_order_refusals(jobs)
  if len(refusals) > 0 {
    harness.stdio.eprintln(
      "hosted release failure registry: refused, the census is not trustworthy",
    )
    for refusal in refusals {
      harness.stdio.eprintln("  ${refusal}")
    }
    return 1
  }
  let measured = 0
  for entry in jobs {
    measured = measured + len(entry.steps)
  }
  const findings = hosted_release_registry_findings(jobs)
  const order = hosted_release_step_order(jobs)
  const post_tag = order.steps.filter({ entry -> return entry.post_tag }).to_list()
  harness.stdio.println(
    "hosted release failure registry: ${len(jobs)} jobs, ${measured} steps, "
      + "${len(post_tag)} after the tag boundary in `${order.boundary_job}`, "
      + "${len(findings)} finding(s)",
  )
  if len(findings) > 0 {
    for finding in findings {
      harness.stdio.eprintln(
        "  ${finding.kind} ${finding.job} / ${finding.step}: ${finding.detail}",
      )
    }
    return 1
  }
  return 0
}
