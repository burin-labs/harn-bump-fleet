  {kind: "option", name: "model", flags: ["--model"], default: DEFAULT_MODEL},
  {kind: "option", name: "provider", flags: ["--provider"], default: DEFAULT_PROVIDER},
  {kind: "flag", name: "mock", flags: ["--mock"]},
  {kind: "flag", name: "help", flags: ["--help", "-h"]},
  {kind: "flag", name: "bootstrap_new_crates", flags: ["--bootstrap-new-crates"]},
  {kind: "option", name: "release_focus", flags: ["--focus"], default: ""},
  {kind: "flag", name: "yes_live_release", flags: ["--yes-live-release"]},
  {kind: "option", name: "pin_sha_input", flags: ["--at-sha"], default: ""},
  {kind: "flag", name: "repin_latest", flags: ["--repin-latest"]},
  {kind: "flag", name: "allow_base_drift", flags: ["--allow-base-drift"]},
  {kind: "flag", name: "offload_audit", flags: ["--offload-audit"]},
  {kind: "flag", name: "local_audit", flags: ["--local-audit"]},
  {kind: "flag", name: "require_remote_audit", flags: ["--require-remote-audit"]},
