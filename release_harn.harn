#!/usr/bin/env harn
//
// release_harn.harn — Harn-native harness for the human-owned `/release-harn`
// workflow in ~/projects/harn.
//
// Defaults to audit-only. Live mutation requires --yes-live-release.
// Use --mock to exercise the end-to-end flow without touching the real repo.
let DEFAULT_REPO = path_join(env_or("HOME", ""), "projects/harn")

let DEFAULT_BASE = env_or("HARN_RELEASE_BASE", "main")

let DEFAULT_MODEL = env_or("HARN_RELEASE_MODEL", "local:gemma4:26b")

let DEFAULT_PROVIDER = env_or("HARN_RELEASE_PROVIDER", "auto")

let MOCK_AGENT_MODEL = "claude-sonnet-4-7"

let RUN_ROOT = ".harn-runs/release-harn"

let ALLOWED_RELEASE_RUN_COMMANDS = [
  "git status",
  "git diff",
  "git log",
  "git show",
  "git branch",
  "git rev-parse",
  "git diff-tree",
  "git ls-files",
  "git describe",
  "git tag",
  "gh pr list",
  "gh pr view",
  "gh pr checks",
  "gh run list",
  "gh run view",
  "gh workflow list",
  "gh workflow view",
  "gh release list",
  "gh release view",
  "rg",
  "grep",
  "sed -n",
  "head",
  "cat",
  "ls",
  "test",
]

fn usage() {
  return """
Usage:
  harn run release_harn.harn
  harn run release_harn.harn -- --agent
  harn run release_harn.harn -- --mock --agent --mode ship-pr
  harn run release_harn.harn -- --repo ~/projects/harn --mode prepare --yes-live-release

Modes:
  audit     Inspect release readiness and write an audit report. Default.
  prepare   Run ./scripts/release_ship.sh --prepare --bump <type>.
  ship-pr   Prepare, commit, rebase, push, open Release vX.Y.Z PR, and enable auto-merge.

Flags:
  --repo PATH             Harn repo path. Defaults to ~/projects/harn.
  --base BRANCH           Base branch for the release PR. Defaults to main.
  --bump patch|minor|major  Version bump type. Defaults to patch.
  --mode audit|prepare|ship-pr
  --agent                 Ask a local model to review the release evidence with read/search/run tools.
  --model MODEL           Local model id for --agent. Defaults to HARN_RELEASE_MODEL or local:gemma4:26b.
  --provider PROVIDER     LLM provider for --agent. Defaults to HARN_RELEASE_PROVIDER or auto.
  --mock                  Use fake command/file tools for a v0.7.52 -> v0.7.53 release rehearsal.
  --skip-audit            Pass through to release_ship.sh --prepare.
  --skip-dry-run          Pass through to release_ship.sh --prepare.
  --yes-live-release      Required for live prepare/ship-pr modes.
"""
}

@complexity(allow)
fn parse_args(args) {
  var cfg = {
    repo: DEFAULT_REPO,
    base: DEFAULT_BASE,
    bump: "patch",
    mode: "audit",
    agent: false,
    model: DEFAULT_MODEL,
    provider: DEFAULT_PROVIDER,
    mock: false,
    help: false,
    skip_audit: false,
    skip_dry_run: false,
    yes_live_release: false,
  }
  var i = 0
  while i < len(args) {
    let a = args[i]
    if a == "--repo" {
      i = i + 1
      if i >= len(args) {
        throw "--repo requires a path"
      }
      cfg = {...cfg, repo: expand_home(args[i])}
    } else if a == "--base" {
      i = i + 1
      if i >= len(args) {
        throw "--base requires a branch name"
      }
      cfg = {...cfg, base: args[i]}
    } else if a == "--bump" {
      i = i + 1
      if i >= len(args) {
        throw "--bump requires patch, minor, or major"
      }
      cfg = {...cfg, bump: args[i]}
    } else if a == "--mode" {
      i = i + 1
      if i >= len(args) {
        throw "--mode requires audit, prepare, or ship-pr"
      }
      cfg = {...cfg, mode: args[i]}
    } else if a == "--agent" {
      cfg = {...cfg, agent: true}
    } else if a == "--model" {
      i = i + 1
      if i >= len(args) {
        throw "--model requires a model id"
      }
      cfg = {...cfg, model: args[i]}
    } else if a == "--provider" {
      i = i + 1
      if i >= len(args) {
        throw "--provider requires a provider name"
      }
      cfg = {...cfg, provider: args[i]}
    } else if a == "--mock" {
      cfg = {...cfg, mock: true}
    } else if a == "--skip-audit" {
      cfg = {...cfg, skip_audit: true}
    } else if a == "--skip-dry-run" {
      cfg = {...cfg, skip_dry_run: true}
    } else if a == "--yes-live-release" {
      cfg = {...cfg, yes_live_release: true}
    } else if a == "-h" || a == "--help" {
      cfg = {...cfg, help: true}
      return cfg
    } else {
      throw "unknown arg: ${a}"
    }
    i = i + 1
  }
  if !(cfg.bump == "patch" || cfg.bump == "minor" || cfg.bump == "major") {
    throw "--bump must be patch, minor, or major"
  }
  if !(cfg.mode == "audit" || cfg.mode == "prepare" || cfg.mode == "ship-pr") {
    throw "--mode must be audit, prepare, or ship-pr"
  }
  return cfg
}

fn expand_home(path) {
  if path == "~" {
    return env_or("HOME", "")
  }
  if starts_with(path, "~/") {
    return env_or("HOME", "") + path[1:len(path)]
  }
  return path
}

fn ok(stdout) {
  return {success: true, status: 0, stdout: stdout, stderr: ""}
}

fn fail(status, stderr) {
  return {success: false, status: status, stdout: "", stderr: stderr}
}

fn run_cmd(cfg, command) {
  if cfg.mock {
    return fake_command(command)
  }
  return shell_at(cfg.repo, command)
}

fn read_repo_file(cfg, path) {
  if cfg.mock {
    return fake_file(path)
  }
  let full = path_join(cfg.repo, path)
  if !file_exists(full) {
    return ""
  }
  return read_file(full)
}

fn fake_file(path) {
  if path == "CHANGELOG.md" {
    return """
# Changelog

## v0.7.53

- Added merge-queue-safe release orchestration that ships from one release PR.
- Tightened release metadata verification and changelog drift checks.
- Documented the harn-release-bot workflow cascade.

## v0.7.52

- Previous release baseline.
"""
  }
  if path == "Cargo.toml" {
    return """
[workspace.package]
version = "0.7.52"
"""
  }
  if path == "README.md" {
    return "# Harn\n\nAgent harness language.\n"
  }
  return ""
}

@complexity(allow)
fn fake_command(command) {
  if contains(command, "git branch --show-current") {
    return ok("release/v0.7.53\n")
  }
  if contains(command, "git status --porcelain") {
    return ok(" M CHANGELOG.md\n M README.md\n M scripts/release_ship.sh\n")
  }
  if contains(command, "git diff") && contains(command, "--stat") {
    return ok(
      " CHANGELOG.md             | 12 ++++++++++++\n README.md                |  4 ++++\n scripts/release_ship.sh  |  8 ++++++++\n 3 files changed, 24 insertions(+)\n",
    )
  }
  if contains(command, "git diff") && contains(command, "--name-only") {
    return ok("CHANGELOG.md\nREADME.md\nscripts/release_ship.sh\n")
  }
  if contains(command, "git describe --tags") {
    return ok("v0.7.52\n")
  }
  if contains(command, "git log --name-status") {
    return ok(
      "commit abc1234 release: consolidate harn release PR flow\nM\tCHANGELOG.md\nM\tscripts/release_ship.sh\n\ncommit bcd2345 ci: publish release from tag drift\nM\t.github/workflows/publish-release.yml\n\ncommit cde3456 docs: clarify local developer loop\nM\tREADME.md\n",
    )
  }
  if contains(command, "git log --oneline") {
    return ok(
      "abc1234 release: consolidate harn release PR flow\nbcd2345 ci: publish release from tag drift\ncde3456 docs: clarify local developer loop\n",
    )
  }
  if contains(command, "python3 - <<'PY_VERSION'") {
    return ok("0.7.52\n")
  }
  if contains(command, "python3 - <<'PY_CHANGELOG_TOP'") {
    return ok("0.7.53\n")
  }
  if contains(command, "python3 - <<'PY_CHANGELOG_SECTION'") {
    return ok(
      "- Added merge-queue-safe release orchestration that ships from one release PR.\n- Tightened release metadata verification and changelog drift checks.\n- Documented the harn-release-bot workflow cascade.\n",
    )
  }
  if contains(command, "python3 - <<'PY_CHANGELOG_GAPS'") {
    return ok("- docs: clarify local developer loop\n")
  }
  if contains(command, "test -x scripts/release_ship.sh") {
    return ok("release_ship=ok\n")
  }
  if contains(command, "test -x scripts/release_gate.sh") {
    return ok("release_gate=ok\n")
  }
  if contains(command, "test -f .github/workflows/publish-release.yml") {
    return ok("publish_workflow=ok\n")
  }
  if contains(command, "test -f .github/workflows/build-release-binaries.yml") {
    return ok("binary_workflow=ok\n")
  }
  if contains(command, "./scripts/release_ship.sh --prepare") {
    return ok(
      "=== Release audit ===\n=== Publish dry run ===\n=== Stage release content ===\nRelease content staged on release/v0.7.53:\n  Previous version: 0.7.52\n  Next version:     0.7.53\n",
    )
  }
  if contains(command, "git commit -m") {
    return ok("[release/v0.7.53 9999999] Release v0.7.53\n")
  }
  if contains(command, "git fetch origin") || contains(command, "git rebase") {
    return ok("Current branch release/v0.7.53 is up to date.\n")
  }
  if contains(command, "git push --no-verify -u origin") {
    return ok("branch 'release/v0.7.53' set up to track 'origin/release/v0.7.53'.\n")
  }
  if contains(command, "git push -u origin") {
    return fail(1, "pre-push hook: make test passed (3187/3187) but exceeded 120s wall-clock budget\n")
  }
  if contains(command, "gh pr create") {
    return ok("https://github.com/burin-labs/harn/pull/999\n")
  }
  if contains(command, "gh pr edit") {
    return ok("https://github.com/burin-labs/harn/pull/999\n")
  }
  if contains(command, "gh pr list") {
    return ok("\n")
  }
  if contains(command, "gh pr merge") {
    return ok("✓ Auto-merge enabled for pull request burin-labs/harn#999\n")
  }
  if contains(command, "rg ") {
    return ok("CHANGELOG.md:3:## v0.7.53\nscripts/release_ship.sh:82:Release vX.Y.Z\n")
  }
  return fail(127, "mock has no response for command: ${command}")
}

fn checked(cfg, command) {
  let r = run_cmd(cfg, command)
  if !r.success {
    throw "command failed (${r.status}): ${command}\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

fn current_version(cfg) {
  return checked(
    cfg,
    """
python3 - <<'PY_VERSION'
from pathlib import Path
import re
text = Path("Cargo.toml").read_text()
m = re.search(r'^version = "([^"]+)"', text, re.M)
if not m:
    m = re.search(r'^version\\s*=\\s*"([^"]+)"', text, re.M)
print(m.group(1) if m else "")
PY_VERSION
""",
  )
}

fn next_version(current, bump) {
  let p = current.split(".")
  if len(p) != 3 {
    throw "current version is not semver: ${current}"
  }
  var major = to_int(p[0])
  var minor = to_int(p[1])
  var patch = to_int(p[2])
  if bump == "major" {
    major = major + 1
    minor = 0
    patch = 0
  } else if bump == "minor" {
    minor = minor + 1
    patch = 0
  } else {
    patch = patch + 1
  }
  return "${major}.${minor}.${patch}"
}

fn changelog_top(cfg) {
  return checked(
    cfg,
    """
python3 - <<'PY_CHANGELOG_TOP'
from pathlib import Path
import re
text = Path("CHANGELOG.md").read_text() if Path("CHANGELOG.md").exists() else ""
for line in text.splitlines():
    m = re.match(r"^## v([0-9]+[.][0-9]+[.][0-9]+)$", line.strip())
    if m:
        print(m.group(1))
        break
PY_CHANGELOG_TOP
""",
  )
}

fn changelog_section(cfg) {
  return checked(
    cfg,
    """
python3 - <<'PY_CHANGELOG_SECTION'
from pathlib import Path
import re
text = Path("CHANGELOG.md").read_text() if Path("CHANGELOG.md").exists() else ""
capture = False
out = []
for line in text.splitlines():
    if re.match(r"^## v[0-9]+[.][0-9]+[.][0-9]+$", line.strip()):
        if capture:
            break
        capture = True
        continue
    if capture:
        out.append(line)
print("\\n".join(out).strip())
PY_CHANGELOG_SECTION
""",
  )
}

fn diff_names(cfg) {
  return checked(cfg, "git diff HEAD --name-only")
}

fn log_range_arg(latest_tag) {
  if latest_tag == "" {
    return "--max-count=50"
  }
  return "${latest_tag}..HEAD --max-count=80"
}

fn release_file_changes(cfg, latest_tag) {
  return checked(
    cfg,
    "git log --name-status --pretty=format:'commit %h %s' --no-merges " + log_range_arg(latest_tag),
  )
}

fn changelog_gap_candidates(cfg, latest_tag) {
  let latest = safe_shell_arg(latest_tag)
  if latest == nil {
    return "skipped: latest tag contains unsupported shell quoting characters"
  }
  return checked(
    cfg,
    "LATEST_TAG=" + latest
      + """ python3 - <<'PY_CHANGELOG_GAPS'
from pathlib import Path
import os
import re
import subprocess

latest = os.environ.get("LATEST_TAG", "")
args = ["git", "log", "--pretty=%s", "--no-merges"]
if latest:
    args.append(f"{latest}..HEAD")
else:
    args.append("--max-count=50")
subjects = subprocess.check_output(args, text=True).splitlines()

text = Path("CHANGELOG.md").read_text() if Path("CHANGELOG.md").exists() else ""
capture = False
section = []
for line in text.splitlines():
    if re.match(r"^## v[0-9]+[.][0-9]+[.][0-9]+$", line.strip()):
        if capture:
            break
        capture = True
        continue
    if capture:
        section.append(line)
section_text = "\n".join(section).lower()

stop = {
    "added", "adds", "allow", "allows", "change", "changes", "fix",
    "fixes", "harn", "release", "version", "update", "updates",
    "with", "from", "into", "that", "this", "when", "where",
}

def tokens(value):
    return [
        t for t in re.findall(r"[a-z0-9]+", value.lower())
        if len(t) > 3 and t not in stop
    ]

for subject in subjects:
    lower = subject.lower()
    if lower.startswith(("release:", "chore(release)", "bump version")):
        continue
    useful = tokens(subject)
    if not useful:
        continue
    hits = sum(1 for t in useful if t in section_text)
    if hits == 0:
        print(f"- {subject}")
PY_CHANGELOG_GAPS
""",
  )
}

fn count_lines(text) {
  let t = trim(text)
  if t == "" {
    return 0
  }
  return len(t.split("\n"))
}

fn probe_ok(cfg, command) {
  let r = run_cmd(cfg, command)
  return r.success
}

fn contains_shell_metachar(command) {
  return contains(command, "\n") || contains(command, ";") || contains(command, "&&")
    || contains(command, "||")
    || contains(command, "|")
    || contains(command, ">")
    || contains(command, "<")
    || contains(command, "`")
    || contains(command, "$")
}

fn safe_shell_arg(value) {
  if contains(value, "'") || contains(value, "\n") {
    return nil
  }
  return "'" + value + "'"
}

fn require_shell_arg(value, label) {
  let arg = safe_shell_arg(value)
  if arg == nil {
    throw "${label} contains unsupported shell quoting characters"
  }
  return arg
}

fn command_matches_prefix(command, prefix) {
  return command == prefix || starts_with(command, prefix + " ")
}

fn allowed_read_command(command) {
  for prefix in ALLOWED_RELEASE_RUN_COMMANDS {
    if command_matches_prefix(command, prefix) {
      return true
    }
  }
  return false
}

fn allowed_command_message() {
  return "blocked: release_run runs with cwd already set to the Harn repo; pass a single command, not `cd ... && ...`, pipes, redirects, or shell chaining. For truncation use flags like `git log --max-count=40`, `sed -n '1,80p' FILE`, or `head -80 FILE`. Allowed read-oriented prefixes: "
    + ALLOWED_RELEASE_RUN_COMMANDS.join(", ")
}

fn blocked_command_message(cfg, command) {
  if starts_with(trim(command), "cd ") {
    return "blocked: release_run already runs from repo cwd `${cfg.repo}`; remove the leading `cd ... &&` and retry with a single read command such as `git log --oneline --max-count=40 v0.7.53..HEAD`, `sed -n '1,80p' CHANGELOG.md`, or `head -80 CHANGELOG.md`."
  }
  if contains_shell_metachar(command) {
    return "blocked: release_run accepts one command only and rejects shell metacharacters. Do not use pipes, redirects, `&&`, `||`, command substitution, or leading `cd`; use command flags instead, e.g. `git log --oneline --max-count=40 v0.7.53..HEAD` or `head -80 CHANGELOG.md`."
  }
  return allowed_command_message()
}

fn agent_result_text(result) {
  let visible = trim(result.visible_text ?? "")
  if visible != "" {
    return visible
  }
  let text = trim(result.text ?? "")
  if text != "" {
    return text
  }
  return "Agent review returned no visible text. Raw result:\n```json\n" + json_stringify(result, 2)
    + "\n```"
}

fn referenced_script_paths(text) {
  let normalized = regex_replace_all("[^A-Za-z0-9_./-]+", "\n", text)
  var refs = []
  for raw in normalized.split("\n") {
    let token = trim(raw)
    if token == "" {
      continue
    }
    let path = if starts_with(token, "./") {
      token[2:len(token)]
    } else {
      token
    }
    if starts_with(path, "scripts/") && ends_with(path, ".sh") {
      refs = refs + [path]
    }
  }
  return refs
}

fn validate_agent_completion(result, text) {
  var findings = []
  let status = result.status ?? ""
  if status != "done" {
    findings = findings
      + ["agent_loop ended with status `${status}` instead of `done`; the audit text may be incomplete"]
    if !contains(text, "##DONE##") {
      findings = findings + ["agent audit did not include the required `##DONE##` completion sentinel"]
    }
  }
  if trim(text) == "" {
    findings = findings + ["agent audit returned empty text"]
  }
  return findings
}

fn validate_agent_review(cfg, text) {
  var findings = []
  for path in referenced_script_paths(text) {
    let path_arg = safe_shell_arg(path)
    if path_arg == nil {
      findings = findings + ["agent referenced an unquotable script path: ${path}"]
      continue
    }
    let check = run_cmd(cfg, "test -e " + path_arg)
    if !check.success {
      let listed = run_cmd(cfg, "ls scripts")
      findings = findings
        + [
        "agent referenced missing script `${path}`; `test -e ${path}` exited ${check.status}; scripts directory:\n${trim(listed.stdout)}",
      ]
    }
  }
  return findings
}

fn validate_agent_review_content(cfg, analysis, text) {
  if cfg.mock || starts_with(text, "Agent review returned no visible text. Raw result:") {
    return []
  }
  var findings = []
  if !contains(text, analysis.next_version) {
    findings = findings
      + ["agent audit does not mention expected next version `${analysis.next_version}`"]
  }
  if !(contains(text, "CHANGELOG") || contains(text, "changelog")) {
    findings = findings + ["agent audit does not discuss CHANGELOG coverage"]
  }
  if !(contains(text, "BEGIN_DRAFT_CHANGELOG") && contains(text, "END_DRAFT_CHANGELOG")) {
    findings = findings
      + ["agent audit does not include a BEGIN_DRAFT_CHANGELOG / END_DRAFT_CHANGELOG block"]
  }
  let commits = trim(analysis.commits_since_latest_tag ?? "")
  if commits != "" {
    let first_line = trim(commits.split("\n")[0])
    let first_hash = trim(first_line.split(" ")[0])
    if first_hash != "" && !contains(text, first_hash) {
      findings = findings
        + ["agent audit does not mention the first post-tag commit `${first_hash}`"]
    }
  }
  return findings
}

fn validate_agent_attempt(cfg, analysis, result, text) {
  var findings = validate_agent_completion(result, text)
  if !starts_with(text, "Agent review returned no visible text. Raw result:") {
    findings = findings + validate_agent_review(cfg, text)
    findings = findings + validate_agent_review_content(cfg, analysis, text)
  }
  return findings
}

fn agent_repair_prompt(validation_findings) {
  return """
The previous release audit ended incomplete or failed deterministic validation.
Treat this as reviewer feedback on your prior answer, not as new release evidence.

Validation findings:
```text
${validation_findings.join("\n")}
```

Use the provided read/search/run tools only if needed. `release_run` already
runs in the Harn repo, so never call `cd`; pass a single read command like
`git log --oneline --max-count=40 v0.7.53..HEAD` or
`sed -n '1,80p' CHANGELOG.md`.

Return the actual corrected concise release audit now. Include the expected
next version, CHANGELOG coverage gaps, post-tag commits that need release-note
coverage, release quality risks, and the next concrete command. Do not answer
with a meta statement about preparing or compiling the audit. Also include a
ready-to-paste markdown changelog section between BEGIN_DRAFT_CHANGELOG and
END_DRAFT_CHANGELOG markers. End with ##DONE##.
"""
}

fn agent_changelog_section(text) {
  let start_marker = "BEGIN_DRAFT_CHANGELOG"
  let end_marker = "END_DRAFT_CHANGELOG"
  var in_block = false
  var lines = []
  for line in text.split("\n") {
    if trim(line) == start_marker {
      in_block = true
      continue
    }
    if trim(line) == end_marker {
      break
    }
    if in_block {
      lines = lines + [line]
    }
  }
  return trim(lines.join("\n"))
}

fn persist_agent_changelog(run_id, text) {
  let section = agent_changelog_section(text)
  if section == "" {
    return nil
  }
  let paths = agent_artifact_paths(run_id)
  mkdir(paths.out_dir, true)
  write_file(paths.draft_changelog_md, section + "\n")
  return paths.draft_changelog_md
}

fn release_session_id(cfg, analysis) {
  return "release-harn-"
    + if cfg.mock {
    "mock"
  } else {
    analysis.next_version
  }
}

fn agent_artifact_paths(run_id) {
  let out_dir = path_join(cwd(), RUN_ROOT, run_id)
  return {
    out_dir: out_dir,
    raw_result_json: path_join(out_dir, "agent-result.json"),
    trace_json: path_join(out_dir, "agent-trace.json"),
    llm_transcript_dir: path_join(out_dir, "agent-llm"),
    llm_transcript_jsonl: path_join(out_dir, "agent-llm/llm_transcript.jsonl"),
    draft_changelog_md: path_join(out_dir, "agent-draft-changelog.md"),
  }
}

fn analyze_release(cfg) {
  let current = current_version(cfg)
  let next = next_version(current, cfg.bump)
  let branch = checked(cfg, "git branch --show-current")
  let status = checked(cfg, "git status --porcelain --untracked-files=normal")
  let diff_stat = checked(cfg, "git diff HEAD --stat")
  let diff_name_list = diff_names(cfg)
  let latest_tag = checked(cfg, "git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true")
  let commits = checked(cfg, "git log --oneline --decorate --no-merges " + log_range_arg(latest_tag))
  let commit_file_changes = release_file_changes(cfg, latest_tag)
  let top = changelog_top(cfg)
  let section = changelog_section(cfg)
  let gap_candidates = changelog_gap_candidates(cfg, latest_tag)
  let scripts = {
    release_ship: probe_ok(cfg, "test -x scripts/release_ship.sh && echo release_ship=ok"),
    release_gate: probe_ok(cfg, "test -x scripts/release_gate.sh && echo release_gate=ok"),
  }
  let workflows = {
    publish_release: probe_ok(cfg, "test -f .github/workflows/publish-release.yml && echo publish_workflow=ok"),
    build_release_binaries: probe_ok(cfg, "test -f .github/workflows/build-release-binaries.yml && echo binary_workflow=ok"),
  }
  let expected_branch = "release/v${next}"
  var findings = []
  if trim(status) == "" {
    findings = findings + ["working tree has no candidate release content"]
  }
  if top != next {
    findings = findings + ["CHANGELOG.md top entry is v${top}; expected v${next} for --bump ${cfg.bump}"]
  }
  if cfg.mode != "audit" && branch == cfg.base {
    findings = findings
      + ["release branch setup will move from ${cfg.base} to ${expected_branch} before preparing"]
  }
  if cfg.mode != "audit" && branch != expected_branch {
    findings = findings + ["current branch is ${branch}; branch setup will target ${expected_branch}"]
  }
  if trim(gap_candidates) != "" {
    findings = findings + ["possible CHANGELOG coverage gaps; review changelog_gap_candidates"]
  }
  if !scripts.release_ship || !scripts.release_gate {
    findings = findings + ["release scripts are missing or not executable"]
  }
  if !workflows.publish_release || !workflows.build_release_binaries {
    findings = findings + ["release cascade workflows are missing"]
  }
  return {
    repo: if cfg.mock {
      "(mock harn repo)"
    } else {
      cfg.repo
    },
    mode: cfg.mode,
    bump: cfg.bump,
    model: cfg.model,
    provider: cfg.provider,
    mock: cfg.mock,
    branch: branch,
    expected_branch: expected_branch,
    base_branch: cfg.base,
    current_version: current,
    next_version: next,
    latest_tag: latest_tag,
    changelog_top: top,
    dirty_files: count_lines(status),
    status: status,
    diff_stat: diff_stat,
    diff_names: diff_name_list,
    commits_since_latest_tag: commits,
    commit_file_changes_since_latest_tag: commit_file_changes,
    changelog_section: section,
    changelog_gap_candidates: gap_candidates,
    release_scripts: scripts,
    workflows: workflows,
    deterministic_findings: findings,
  }
}

fn release_tools(cfg) {
  var tools = tool_registry()
  tools = tool_define(
    tools,
    "release_read",
    "Read a file from the Harn repo",
    {
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> read_repo_file(cfg, args.path) },
    },
  )
  tools = tool_define(
    tools,
    "release_search",
    "Search the Harn repo with ripgrep",
    {
      parameters: {pattern: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args ->
        let pattern = safe_shell_arg(args.pattern)
        if pattern == nil {
          return "blocked: search pattern contains unsupported shell quoting characters"
        }
        let r = run_cmd(
          cfg,
          "rg -n -- " + pattern
            + " README.md CHANGELOG.md docs/src scripts .github 2>/dev/null | head -120",
        )
        if r.success {
          r.stdout
        } else {
          r.stderr
        }
      },
    },
  )
  tools = tool_define(
    tools,
    "release_run",
    "Run one read-only release inspection command. The command already runs with cwd set to the Harn repo, so do not include `cd`, pipes, redirects, or shell chaining. Prefer bounded flags such as `git log --max-count=40`, `sed -n '1,80p' FILE`, and `head -80 FILE`.",
    {
      parameters: {command: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
      handler: { args ->
        let command = args.command
        if !allowed_read_command(command) {
          return blocked_command_message(cfg, command)
        }
        if contains_shell_metachar(command) {
          return blocked_command_message(cfg, command)
        }
        let r = run_cmd(cfg, command)
        return "exit=${r.status}\nstdout:\n${r.stdout}\nstderr:\n${r.stderr}"
      },
    },
  )
  return tools
}

fn run_release_agent_loop(cfg, analysis, system, prompt, run_id) {
  let paths = agent_artifact_paths(run_id)
  return agent_loop(
    prompt,
    system,
    {
      provider: if cfg.mock {
        "mock"
      } else {
        if cfg.provider == "auto" {
          "auto"
        } else {
          cfg.provider
        }
      },
      model: if cfg.mock {
        MOCK_AGENT_MODEL
      } else {
        cfg.model
      },
      tools: release_tools(cfg),
      tool_format: "native",
      persistent: true,
      max_iterations: 12,
      max_nudges: 1,
      session_id: release_session_id(cfg, analysis),
      llm_transcript_dir: paths.llm_transcript_dir,
    },
  )
}

fn persist_agent_artifacts(run_id, result, attempts, validation_findings) {
  let paths = agent_artifact_paths(run_id)
  mkdir(paths.out_dir, true)
  write_file(
    paths.raw_result_json,
    json_stringify({attempts: attempts, final_result: result}, 2) + "\n",
  )
  write_file(paths.trace_json, json_stringify(result.trace ?? {}, 2) + "\n")
  return {
    raw_result_json: paths.raw_result_json,
    trace_json: paths.trace_json,
    llm_transcript_jsonl: paths.llm_transcript_jsonl,
    draft_changelog_md: paths.draft_changelog_md,
    validation_findings: validation_findings,
  }
}

fn recovery_artifact_paths(run_id, step_name) {
  let safe_step = regex_replace_all("[^A-Za-z0-9_.-]+", "-", step_name)
  let out_dir = path_join(cwd(), RUN_ROOT, run_id, "recovery")
  return {
    out_dir: out_dir,
    raw_result_json: path_join(out_dir, safe_step + "-agent-result.json"),
    trace_json: path_join(out_dir, safe_step + "-agent-trace.json"),
    advice_md: path_join(out_dir, safe_step + "-advice.md"),
    llm_transcript_dir: path_join(out_dir, safe_step + "-llm"),
    llm_transcript_jsonl: path_join(out_dir, safe_step + "-llm/llm_transcript.jsonl"),
  }
}

fn recovery_session_id(cfg, analysis, step_name) {
  return release_session_id(cfg, analysis) + "-recovery-" + step_name
}

fn run_recovery_agent_loop(cfg, analysis, prompt, run_id, step_name) {
  let paths = recovery_artifact_paths(run_id, step_name)
  let system = """
You are diagnosing a hiccup during the Harn release handoff. The operator wants
the run transcript to be auditable and wants shell failures fed back into model
context instead of hidden in deterministic logs.

Use the read/search/run tools to inspect current local state if needed. The
tools are intentionally read-only; do not claim that you changed files, pushed,
or fixed the repository. If the failure is a known green-test pre-push hook
budget timeout, say so explicitly and recommend the documented no-verify retry.
For all other failures, identify the most likely root cause, the safest next
manual or harness command, and whether the release branch/commit can be reused.

End with ##DONE##.
"""
  return agent_loop(
    prompt,
    system,
    {
      provider: if cfg.mock {
        "mock"
      } else {
        if cfg.provider == "auto" {
          "auto"
        } else {
          cfg.provider
        }
      },
      model: if cfg.mock {
        MOCK_AGENT_MODEL
      } else {
        cfg.model
      },
      tools: release_tools(cfg),
      tool_format: "native",
      persistent: true,
      max_iterations: 8,
      max_nudges: 1,
      session_id: recovery_session_id(cfg, analysis, step_name),
      llm_transcript_dir: paths.llm_transcript_dir,
    },
  )
}

fn recovery_agent_advice(cfg, analysis, steps, failed_step, run_id) {
  require_agent_tool_model(cfg)
  if cfg.mock {
    llm_mock_clear()
    llm_mock(
      {
        text: "I will inspect the mocked push failure before recommending recovery.",
        tool_calls: [
          {
            id: "recovery_run_1",
            name: "release_run",
            arguments: {command: "git status --porcelain --untracked-files=normal"},
          },
        ],
      },
    )
    llm_mock(
      {
        text: "- The failed push is classified as a green-test pre-push hook budget timeout.\n- The release commit and branch can be reused.\n- Retry with `git push --no-verify -u origin ${analysis.expected_branch}` and keep both attempts in the run artifacts.\n##DONE##",
      },
    )
  }
  let prompt = "Release handoff failure context:\n```json\n"
    + json_stringify(
    {
      analysis: analysis,
      failed_step: failed_step,
      execution_so_far: steps,
      classification: failed_step.classification ?? "",
      recovery_hint: failed_step.recovery_hint ?? "",
    },
    2,
  )
    + "\n```\nDiagnose this hiccup from local evidence and recommend the next concrete action."
  let result = run_recovery_agent_loop(cfg, analysis, prompt, run_id, failed_step.name)
  let text = agent_result_text(result)
  let paths = recovery_artifact_paths(run_id, failed_step.name)
  mkdir(paths.out_dir, true)
  write_file(paths.raw_result_json, json_stringify(result, 2) + "\n")
  write_file(paths.trace_json, json_stringify(result.trace ?? {}, 2) + "\n")
  write_file(paths.advice_md, text + "\n")
  return {
    text: text,
    artifacts: {
      raw_result_json: paths.raw_result_json,
      trace_json: paths.trace_json,
      advice_md: paths.advice_md,
      llm_transcript_jsonl: paths.llm_transcript_jsonl,
    },
    llm: result.llm ?? {},
    tools: result.tools ?? {},
    status: result.status ?? "",
  }
}

fn maybe_recovery_advice_step(cfg, analysis, steps, failed_step, run_id) {
  if !cfg.agent {
    return steps
  }
  let advice = recovery_agent_advice(cfg, analysis, steps, failed_step, run_id)
  let r = ok(advice.text)
  let step = recorded_step(
    "agent-recovery-advice-${failed_step.name}",
    "agent_loop recovery diagnosis for failed ${failed_step.name}",
    r,
  )
  return steps
    + [
    {
      ...step,
      artifacts: advice.artifacts,
      agent_status: advice.status,
      llm: advice.llm,
      tools: advice.tools,
    },
  ]
}

fn agent_review(cfg, analysis, run_id) {
  require_agent_tool_model(cfg)
  if cfg.mock {
    llm_mock_clear()
    llm_mock(
      {
        text: "I will inspect the mocked release evidence.",
        tool_calls: [
          {
            id: "run_1",
            name: "release_run",
            arguments: {command: "git log --oneline v0.7.52..HEAD --max-count=30"},
          },
        ],
      },
    )
    llm_mock(
      {
        text: "- release shape matches v0.7.53 expectations\n- changelog has a matching v0.7.53 top entry\n- mocked prepare/PR path is ready\n##DONE##",
      },
    )
  }
  let system = """
You are auditing the Harn release workflow. Use only local evidence and the
provided tools. Do not recommend publishing directly. The desired flow is:
prepare one Release vX.Y.Z PR, enable auto-merge, then let GitHub Actions
publish and build binaries after the PR lands.

Before writing the final audit, make at least one successful read-only tool call
to ground the review in the repo. Do not complete from the JSON alone. Emit
##DONE## only after you have received tool evidence.

The release analysis JSON already includes the deterministic commit log,
file-level changes, and top CHANGELOG section. Use tools as spot checks and
avoid rediscovering the entire release state. After 1-4 focused tool calls,
write the final audit unless the evidence contradicts the JSON.

You must specifically audit CHANGELOG coverage at a cursory release-quality
level: compare the top CHANGELOG section against the commit log, file-level
changes, and any relevant files you read. Call out likely omissions or say that
no obvious CHANGELOG gaps were found. If the deterministic analysis already
shows the top CHANGELOG version is not the expected next version, report that as
the primary changelog gap without re-reading the old release section.

Also produce a user-facing changelog draft that massages the deterministic
commit list into release-note prose. It must be ready to paste into
CHANGELOG.md and wrapped exactly like this:

BEGIN_DRAFT_CHANGELOG
## vX.Y.Z

### Added

- **Clear user-facing title.** Human-readable impact summary, not just the
  commit subject.
END_DRAFT_CHANGELOG

Proofread the draft before finalizing: avoid split words, preserve exact script
names, PR numbers, versions, and public technical names, and do not invent
features that are not supported by the commit/file evidence.

Output concise audit bullets plus that draft block, then end with ##DONE##.
"""
  let prompt = "Release analysis JSON:\n```json\n" + json_stringify(analysis, 2)
    + "\n```\nReview readiness, CHANGELOG coverage gaps, release quality risks, and the next concrete command."
  var result = run_release_agent_loop(cfg, analysis, system, prompt, run_id)
  var text = agent_result_text(result)
  var validation_findings = validate_agent_attempt(cfg, analysis, result, text)
  var attempts = [
    {
      name: "initial-review",
      text: text,
      validation_findings: validation_findings,
      llm: result.llm ?? {},
      tools: result.tools ?? {},
      status: result.status ?? "",
    },
  ]
  while len(validation_findings) > 0 && len(attempts) < 3 {
    let repair_prompt = agent_repair_prompt(validation_findings)
    result = run_release_agent_loop(cfg, analysis, system, repair_prompt, run_id)
    text = agent_result_text(result)
    validation_findings = validate_agent_attempt(cfg, analysis, result, text)
    attempts = attempts
      + [
      {
        name: "validation-repair-${len(attempts)}",
        text: text,
        validation_findings: validation_findings,
        llm: result.llm ?? {},
        tools: result.tools ?? {},
        status: result.status ?? "",
      },
    ]
  }
  let draft_changelog = persist_agent_changelog(run_id, text)
  let artifacts = persist_agent_artifacts(run_id, result, attempts, validation_findings)
  return {
    text: text,
    attempts: attempts,
    validation_findings: validation_findings,
    draft_changelog: draft_changelog,
    artifacts: artifacts,
  }
}

fn prepare_command(cfg) {
  var cmd = "./scripts/release_ship.sh --prepare --bump ${cfg.bump}"
  if cfg.skip_audit {
    cmd = cmd + " --skip-audit"
  }
  if cfg.skip_dry_run {
    cmd = cmd + " --skip-dry-run"
  }
  return cmd
}

fn require_agent_tool_model(cfg) {
  if cfg.mock {
    return nil
  }
  let info = if cfg.provider == "auto" {
    llm_model_info(cfg.model)
  } else {
    {
      provider: cfg.provider,
      id: cfg.model,
      capabilities: provider_capabilities(cfg.provider, cfg.model),
    }
  }
  let caps = info.capabilities ?? {}
  if !(caps.native_tools ?? false) {
    let provider = info.provider ?? "unknown"
    let model = info.id ?? cfg.model
    throw "agent review model ${cfg.model} resolves to ${provider}/${model}, which does not support Harn tools; choose a tool-capable local model such as qwen3.6:35b-a3b-coding-nvfp4 or run without --agent"
  }
  return info
}

fn require_live_confirmation(cfg) {
  if !cfg.mock && !cfg.yes_live_release {
    throw "live ${cfg.mode} mode requires --yes-live-release"
  }
}

fn recorded_step(name, command, r) {
  return {
    name: name,
    command: command,
    success: r.success,
    status: r.status,
    stdout: r.stdout,
    stderr: r.stderr,
    classification: step_classification(command, r),
    recovery_hint: step_recovery_hint(command, r),
  }
}

fn command_output(r) {
  return r.stdout + "\n" + r.stderr
}

fn push_hook_budget_exceeded(command, r) {
  if r.success || !starts_with(command, "git push ") {
    return false
  }
  let out = lowercase(command_output(r))
  let hook_like = contains(out, "pre-push") || contains(out, "pre push")
    || contains(out, "hook")
  let budget_like = contains(out, "budget") || contains(out, "timed out")
    || contains(out, "timeout")
    || contains(out, "exceeded")
  let green_like = contains(out, "passed") || contains(out, "test result: ok")
    || contains(out, "0 failed")
    || contains(out, "/3187")
    || contains(out, "3187/3187")
  return hook_like && budget_like && green_like
}

fn step_classification(command, r) {
  if r.success {
    return "ok"
  }
  if push_hook_budget_exceeded(command, r) {
    return "push_hook_budget_exceeded_after_green_tests"
  }
  if starts_with(command, "git push ") {
    return "push_failed"
  }
  return "command_failed"
}

fn step_recovery_hint(command, r) {
  if push_hook_budget_exceeded(command, r) {
    return "Tests reported green before the pre-push hook exceeded its wall-clock budget. release_harn retries this exact class with `git push --no-verify` and records both attempts."
  }
  if !r.success && starts_with(command, "git push ") {
    return "Push failed for a reason that was not classified as a green-test hook budget timeout. Keep the release branch and commit, inspect stdout/stderr in the run artifacts, then rerun or push manually after fixing the hook failure."
  }
  return ""
}

fn append_command_step(cfg, steps, name, command) {
  let r = run_cmd(cfg, command)
  return {
    steps: steps + [recorded_step(name, command, r)],
    success: r.success,
    status: r.status,
    stdout: r.stdout,
    stderr: r.stderr,
  }
}

fn local_branch_exists(cfg, branch) {
  return probe_ok(cfg, "git show-ref --verify --quiet refs/heads/${branch}")
}

fn remote_branch_exists(cfg, branch) {
  return probe_ok(cfg, "git show-ref --verify --quiet refs/remotes/origin/${branch}")
}

fn setup_release_branch(cfg, analysis) {
  var steps = []
  let current_branch = checked(cfg, "git branch --show-current")
  let target_branch = analysis.expected_branch
  if current_branch == target_branch {
    return steps
  }
  let status = checked(cfg, "git status --porcelain --untracked-files=normal")
  var stashed = false
  if trim(status) != "" {
    let stash_message = "release_harn branch setup ${analysis.next_version} ${uuid_v7()}"
    let stash_arg = safe_shell_arg(stash_message)
    if stash_arg == nil {
      steps = steps
        + [
        recorded_step(
          "stash-before-branch-setup",
          "git stash push -u -m <release_harn message>",
          fail(2, "failed to quote stash message"),
        ),
      ]
      return steps
    }
    let stash = append_command_step(cfg, steps, "stash-before-branch-setup", "git stash push -u -m " + stash_arg)
    steps = stash.steps
    if !stash.success {
      return steps
    }
    stashed = true
  }
  let fetch = append_command_step(cfg, steps, "fetch-origin", "git fetch origin --prune --quiet")
  steps = fetch.steps
  if !fetch.success {
    if stashed {
      let restore = append_command_step(cfg, steps, "restore-stash-after-fetch-failure", "git stash pop --index")
      steps = restore.steps
    }
    return steps
  }
  if current_branch == cfg.base {
    let base_arg = require_shell_arg(cfg.base, "--base")
    let pull = append_command_step(cfg, steps, "sync-base", "git pull --ff-only origin " + base_arg + " --quiet")
    steps = pull.steps
    if !pull.success {
      if stashed {
        let restore = append_command_step(cfg, steps, "restore-stash-after-sync-failure", "git stash pop --index")
        steps = restore.steps
      }
      return steps
    }
  }
  if current_branch == "" && !local_branch_exists(cfg, target_branch)
    && !remote_branch_exists(cfg, target_branch) {
    steps = steps
      + [
      recorded_step(
        "switch-release-branch",
        "git switch ${target_branch}",
        fail(2, "detached HEAD and ${target_branch} does not already exist locally or on origin"),
      ),
    ]
    if stashed {
      let restore = append_command_step(cfg, steps, "restore-stash-after-switch-failure", "git stash pop --index")
      steps = restore.steps
    }
    return steps
  }
  var switch_command = "git switch -c ${target_branch}"
  if local_branch_exists(cfg, target_branch) {
    switch_command = "git switch ${target_branch}"
  } else if remote_branch_exists(cfg, target_branch) {
    switch_command = "git switch --track origin/${target_branch}"
  }
  let switched = append_command_step(cfg, steps, "switch-release-branch", switch_command)
  steps = switched.steps
  if !switched.success {
    if stashed {
      let restore = append_command_step(cfg, steps, "restore-stash-after-switch-failure", "git stash pop --index")
      steps = restore.steps
    }
    return steps
  }
  if stashed {
    let applied = append_command_step(cfg, steps, "restore-stashed-release-content", "git stash pop --index")
    steps = applied.steps
    if !applied.success {
      let status_after = run_cmd(cfg, "git status --porcelain --untracked-files=normal")
      steps = steps
        + [
        recorded_step(
          "status-after-stash-conflict",
          "git status --porcelain --untracked-files=normal",
          status_after,
        ),
      ]
      return steps
    }
  }
  return steps
}

fn draft_release_notes_command(analysis, notes_path) {
  let next_arg = require_shell_arg(analysis.next_version, "next version")
  let latest_tag_arg = require_shell_arg(analysis.latest_tag, "latest tag")
  let notes_arg = if notes_path == nil {
    "''"
  } else {
    require_shell_arg(notes_path, "agent changelog path")
  }
  return "python3 - " + next_arg + " " + latest_tag_arg + " " + notes_arg + " <<'PY_RELEASE_NOTES'\n"
    + """
from pathlib import Path
import re
import subprocess
import sys

next_version = sys.argv[1]
latest_tag = sys.argv[2]
agent_notes_path = sys.argv[3]
changelog = Path("CHANGELOG.md")
if not changelog.exists():
    raise SystemExit("missing CHANGELOG.md")

text = changelog.read_text()
first = re.search(r"^## v([0-9]+\.[0-9]+\.[0-9]+)\s*$", text, re.M)
if first and first.group(1) == next_version:
    print(f"ok: CHANGELOG.md already starts with v{next_version}")
    raise SystemExit(0)

agent_notes = ""
if agent_notes_path:
    note_path = Path(agent_notes_path)
    if note_path.exists():
        agent_notes = note_path.read_text().strip()
        if not re.search(rf"^## v{re.escape(next_version)}\s*$", agent_notes, re.M):
            raise SystemExit(f"agent draft changelog does not start with ## v{next_version}")

log_args = ["git", "log", "--format=%H%x09%h%x09%s", "--no-merges"]
if latest_tag:
    log_args.append(f"{latest_tag}..HEAD")
else:
    log_args.append("HEAD")
log = subprocess.run(log_args, check=True, text=True, capture_output=True).stdout
commits = []
for line in log.splitlines():
    parts = line.split("\t", 2)
    if len(parts) == 3:
        commits.append(tuple(parts))
if not commits:
    raise SystemExit("no post-tag commits found to draft release notes")

def changed_files(full_hash):
    out = subprocess.run(
        ["git", "show", "--name-only", "--format=", full_hash],
        check=True,
        text=True,
        capture_output=True,
    ).stdout
    return [line.strip() for line in out.splitlines() if line.strip()]

def clean_subject(subject):
    subject = re.sub(r"^\[codex\]\s*", "", subject).strip()
    return subject[:1].upper() + subject[1:]

def summary(subject, files):
    lower = subject.lower()
    if "compact text-tool protocol" in lower:
        return "Adds compact text-tool protocol tag support for local-model tool-call transcripts."
    if "mcp tool tasks" in lower:
        return "Implements MCP task request, result, listing, cancellation, and status notification support."
    if "a2a push config" in lower:
        return "Adds durable A2A push-notification configuration CRUD backed by persisted server state."
    if "diagnostic paths" in lower:
        return "Normalizes diagnostic path rendering so parser and runtime locations are easier to compare."
    if "release-harn skill" in lower:
        return "Updates release workflow instructions around rebasing and enabling auto-merge."
    if any(path.startswith(".github/") for path in files):
        return "Updates release automation and CI workflow behavior."
    if any(path.startswith("docs/") or "/skills/" in path or "/commands/" in path for path in files):
        return "Updates release documentation and operator workflow guidance."
    return clean_subject(subject)

def section_for(subject, files):
    lower = subject.lower()
    if (
        "release-harn skill" in lower
        or all(path.startswith(".codex/") or path.startswith(".claude/") for path in files)
    ):
        return "Internal"
    if "diagnostic paths" in lower:
        return "Changed"
    return "Added"

sections = {"Added": [], "Changed": [], "Internal": []}
for full_hash, short_hash, subject in commits:
    files = changed_files(full_hash)
    title = clean_subject(subject)
    body = summary(subject, files)
    section = section_for(subject, files)
    sections[section].append(f"- **{title}.** {body} (`{short_hash}`)")

if agent_notes:
    draft_text = agent_notes.rstrip() + "\n\n"
else:
    draft = [f"## v{next_version}", ""]
    for heading in ("Added", "Changed", "Internal"):
        entries = sections[heading]
        if not entries:
            continue
        draft.extend([f"### {heading}", "", *entries, ""])
    draft_text = "\n".join(draft).rstrip() + "\n\n"

insert_at = first.start() if first else len(text)
new_text = text[:insert_at] + draft_text + text[insert_at:]
changelog.write_text(new_text)
source = "agent" if agent_notes else "deterministic"
print(f"ok: inserted {source} CHANGELOG.md section for v{next_version} from {len(commits)} post-tag commits")
PY_RELEASE_NOTES
"""
}

fn ensure_release_notes(cfg, analysis, agent_review_result) {
  if analysis.changelog_top == analysis.next_version {
    return [
      recorded_step(
        "release-notes-current",
        "CHANGELOG.md already starts with v${analysis.next_version}",
        ok("CHANGELOG.md already starts with v${analysis.next_version}\n"),
      ),
    ]
  }
  let command = draft_release_notes_command(analysis, agent_review_result.draft_changelog ?? nil)
  let r = run_cmd(cfg, command)
  return [
    recorded_step(
      "draft-release-notes",
      "insert draft CHANGELOG.md section for v${analysis.next_version}",
      r,
    ),
  ]
}

fn prepared_release_findings(raw, original) {
  var findings = []
  if raw.changelog_top != original.next_version {
    findings = findings
      + [
      "CHANGELOG.md top entry is v${raw.changelog_top}; expected v${original.next_version} for this prepared release",
    ]
  }
  if raw.branch != original.expected_branch {
    findings = findings
      + ["current branch is ${raw.branch}; expected prepared release branch ${original.expected_branch}"]
  }
  if trim(raw.changelog_gap_candidates) != "" {
    findings = findings + ["possible CHANGELOG coverage gaps; review changelog_gap_candidates"]
  }
  if !raw.release_scripts.release_ship || !raw.release_scripts.release_gate {
    findings = findings + ["release scripts are missing or not executable"]
  }
  if !raw.workflows.publish_release || !raw.workflows.build_release_binaries {
    findings = findings + ["release cascade workflows are missing"]
  }
  return findings
}

fn prepared_release_analysis(raw, original) {
  return {
    ...raw,
    current_version: original.current_version,
    next_version: original.next_version,
    expected_branch: original.expected_branch,
    deterministic_findings: prepared_release_findings(raw, original),
  }
}

fn pr_body_text(analysis, agent_review_result, execution) {
  let agent_artifacts = agent_review_result.artifacts ?? {}
  let draft_path = agent_review_result.draft_changelog ?? ""
  let validation = agent_review_result.validation_findings ?? []
  let execution_summary = if execution == nil {
    "(no side-effecting steps recorded)"
  } else {
    execution_table(execution)
  }
  return """
Release v${analysis.next_version}

This PR was prepared by `release_harn.harn` and this body was generated from a
fresh post-prepare repo snapshot, after `scripts/release_ship.sh --prepare`
completed.

## Post-prepare summary

- Version: `${analysis.current_version}` -> `${analysis.next_version}`
- Branch: `${analysis.branch}` targeting `${analysis.base_branch}`
- Latest tag used for release delta: `${analysis.latest_tag}`
- Changed files: `${single_line_or(analysis.diff_names, "none")}`
- Deterministic findings: ${if len(analysis.deterministic_findings) == 0 { "none" } else { "review run artifact" }}

## Changelog section

```markdown
${analysis.changelog_section}
```

## Commits covered

```text
${analysis.commits_since_latest_tag}
```

## Execution transcript

${execution_summary}

## Agent artifacts

- Audit JSONL transcript: `${agent_artifacts.llm_transcript_jsonl ?? "not generated"}`
- Draft changelog: `${draft_path}`
- Agent validation findings: ${if len(validation) == 0 { "none" } else { validation.join("; ") }}

Generated by `release_harn.harn`.
"""
}

fn single_line_or(value, fallback) {
  let t = trim(value ?? "")
  if t == "" {
    return fallback
  }
  return regex_replace_all("\\s+", ", ", t)
}

fn execution_table(execution) {
  var lines = ["| Step | Status | Classification |", "|------|--------|----------------|"]
  for step in execution {
    let status = if step.success {
      "ok"
    } else {
      "failed (${step.status})"
    }
    lines = lines + ["| `${step.name}` | ${status} | `${step.classification ?? ""}` |"]
  }
  return lines.join("\n")
}

fn write_pr_body(run_id, analysis, agent_review_result, execution) {
  let body_path = path_join(cwd(), RUN_ROOT, run_id, "pr-body.md")
  mkdir(dirname(body_path), true)
  write_file(body_path, pr_body_text(analysis, agent_review_result, execution))
  return body_path
}

fn run_output_dir(run_id) {
  return path_join(cwd(), RUN_ROOT, run_id)
}

fn crystallization_fixture_paths(run_id) {
  let out_dir = path_join(run_output_dir(run_id), "crystallization-input")
  return {
    out_dir: out_dir,
    manifest_json: path_join(out_dir, "manifest.json"),
    release_run_json: path_join(out_dir, "release-run.json"),
    deterministic_events_jsonl: path_join(out_dir, "deterministic-events.jsonl"),
    agent_events_jsonl: path_join(out_dir, "agent-events.jsonl"),
    tool_observations_jsonl: path_join(out_dir, "tool-observations.jsonl"),
    readme_md: path_join(out_dir, "README.md"),
  }
}

fn artifact_text(path) {
  let p = path ?? ""
  if p == "" || !file_exists(p) {
    return ""
  }
  return read_file(p)
}

fn jsonl(events) {
  var lines = []
  for event in events {
    lines = lines + [json_stringify(event)]
  }
  if len(lines) == 0 {
    return ""
  }
  return lines.join("\n") + "\n"
}

fn deterministic_fixture_events(payload) {
  let a = payload.analysis
  var events = [
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "release_analysis",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        repo: a.repo,
        mode: a.mode,
        mock: a.mock,
        bump: a.bump,
        starting_branch: a.branch,
        target_release_branch: a.expected_branch,
        base_branch: a.base_branch,
        current_version: a.current_version,
        next_version: a.next_version,
        latest_tag: a.latest_tag,
        git_log_range: log_range_arg(a.latest_tag),
        dirty_files: a.dirty_files,
        status: a.status,
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "changelog_audit_inputs",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        expected_version: a.next_version,
        changelog_top: a.changelog_top,
        changelog_section: a.changelog_section,
        gap_candidates: a.changelog_gap_candidates,
        commits_since_latest_tag: a.commits_since_latest_tag,
        commit_file_changes_since_latest_tag: a.commit_file_changes_since_latest_tag,
      },
    },
  ]
  for finding in a.deterministic_findings {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "deterministic_finding",
        source: "deterministic",
        timestamp: payload.finished_iso,
        data: {finding: finding},
      },
    ]
  }
  for step in payload.execution ?? [] {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "release_step_recorded",
        source: "deterministic",
        timestamp: payload.finished_iso,
        data: {
          name: step.name,
          command: step.command,
          success: step.success,
          status: step.status,
          classification: step.classification ?? "",
          recovery_hint: step.recovery_hint ?? "",
        },
      },
    ]
  }
  return events
}

fn agent_artifact_snapshot(agent_detail) {
  let artifacts = agent_detail.artifacts ?? {}
  return {
    raw_result_json_path: artifacts.raw_result_json ?? "",
    raw_result_json: artifact_text(artifacts.raw_result_json ?? ""),
    trace_json_path: artifacts.trace_json ?? "",
    trace_json: artifact_text(artifacts.trace_json ?? ""),
    llm_transcript_jsonl_path: artifacts.llm_transcript_jsonl ?? "",
    llm_transcript_jsonl: artifact_text(artifacts.llm_transcript_jsonl ?? ""),
    draft_changelog_md_path: artifacts.draft_changelog_md ?? "",
    draft_changelog_md: artifact_text(artifacts.draft_changelog_md ?? ""),
  }
}

fn recovery_artifact_snapshot(step) {
  let artifacts = step.artifacts ?? {}
  return {
    raw_result_json_path: artifacts.raw_result_json ?? "",
    raw_result_json: artifact_text(artifacts.raw_result_json ?? ""),
    trace_json_path: artifacts.trace_json ?? "",
    trace_json: artifact_text(artifacts.trace_json ?? ""),
    advice_md_path: artifacts.advice_md ?? "",
    advice_md: artifact_text(artifacts.advice_md ?? ""),
    llm_transcript_jsonl_path: artifacts.llm_transcript_jsonl ?? "",
    llm_transcript_jsonl: artifact_text(artifacts.llm_transcript_jsonl ?? ""),
  }
}

fn agent_fixture_events(payload) {
  let detail = payload.agent_review_detail ?? {}
  let attempts = detail.attempts ?? []
  var events = []
  if len(attempts) == 0 {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "agent_review_skipped",
        source: "agent",
        timestamp: payload.finished_iso,
        data: {reason: payload.agent_review},
      },
    ]
  }
  for {index, value} in attempts.enumerate() {
    let attempt = value
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "agent_review_attempt",
        source: "agent",
        timestamp: payload.finished_iso,
        data: {
          index: index,
          name: attempt.name,
          status: attempt.status ?? "",
          text: attempt.text,
          validation_findings: attempt.validation_findings ?? [],
          llm: attempt.llm ?? {},
          tools: attempt.tools ?? {},
        },
      },
    ]
  }
  if len(attempts) > 0 {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "agent_review_artifacts",
        source: "agent",
        timestamp: payload.finished_iso,
        data: agent_artifact_snapshot(detail),
      },
    ]
  }
  for step in payload.execution ?? [] {
    if starts_with(step.name, "agent-recovery-advice-") {
      events = events
        + [
        {
          schema_version: "release_harn.crystallization_input.v1",
          event_type: "agent_recovery_advice",
          source: "agent",
          timestamp: payload.finished_iso,
          data: {
            step_name: step.name,
            status: step.agent_status ?? "",
            text: step.stdout,
            llm: step.llm ?? {},
            tools: step.tools ?? {},
            artifacts: recovery_artifact_snapshot(step),
          },
        },
      ]
    }
  }
  return events
}

fn tool_observation_events(payload) {
  let a = payload.analysis
  var events = [
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "shell",
        command: "git status --porcelain --untracked-files=normal",
        success: true,
        status: 0,
        stdout: a.status,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "shell",
        command: "git diff HEAD --stat",
        success: true,
        status: 0,
        stdout: a.diff_stat,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "shell",
        command: "git log --oneline --decorate --no-merges " + log_range_arg(a.latest_tag),
        success: true,
        status: 0,
        stdout: a.commits_since_latest_tag,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "shell",
        command: "git log --name-status --pretty=format:'commit %h %s' --no-merges "
          + log_range_arg(a.latest_tag),
        success: true,
        status: 0,
        stdout: a.commit_file_changes_since_latest_tag,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "read_file",
        path: "CHANGELOG.md",
        success: true,
        status: 0,
        stdout: a.changelog_section,
        stderr: "",
      },
    },
  ]
  for step in payload.execution ?? [] {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "tool_observation",
        source: if starts_with(step.name, "agent-recovery-advice-") {
          "agent"
        } else {
          "deterministic"
        },
        timestamp: payload.finished_iso,
        data: {
          tool: if starts_with(step.name, "agent-recovery-advice-") {
            "agent_loop"
          } else {
            "shell"
          },
          step_name: step.name,
          command: step.command,
          success: step.success,
          status: step.status,
          classification: step.classification ?? "",
          recovery_hint: step.recovery_hint ?? "",
          stdout: step.stdout,
          stderr: step.stderr,
        },
      },
    ]
  }
  return events
}

fn fixture_manifest(run_id, payload, report_paths, paths) {
  return {
    schema_version: "release_harn.crystallization_input.v1",
    kind: "release_harn_crystallization_input",
    generated_by: "release_harn.harn",
    generated_at: date_now_iso(),
    run_id: run_id,
    source_issue: "https://github.com/burin-labs/harn-bump-fleet/issues/2",
    consumer_issue: "https://github.com/burin-labs/harn/issues/1146",
    source_artifacts: {release_audit_json: report_paths.json_path, release_audit_md: report_paths.md_path},
    release: {
      repo: payload.analysis.repo,
      mode: payload.analysis.mode,
      mock: payload.analysis.mock,
      current_version: payload.analysis.current_version,
      next_version: payload.analysis.next_version,
      starting_branch: payload.analysis.branch,
      target_release_branch: payload.analysis.expected_branch,
      base_branch: payload.analysis.base_branch,
      latest_tag: payload.analysis.latest_tag,
    },
    files: {
      manifest_json: paths.manifest_json,
      release_run_json: paths.release_run_json,
      deterministic_events_jsonl: paths.deterministic_events_jsonl,
      agent_events_jsonl: paths.agent_events_jsonl,
      tool_observations_jsonl: paths.tool_observations_jsonl,
      readme_md: paths.readme_md,
    },
    semantics: {
      deterministic_events: "Facts and harness decisions emitted by release_harn.harn.",
      agent_events: "Model-authored audit, changelog synthesis, and recovery advice. Not deterministic truth.",
      tool_observations: "Shell/read/tool observations with stdout/stderr preserved for replay and audit.",
    },
  }
}

fn fixture_readme(payload) {
  return """
# release_harn Crystallization Input

This directory is a self-contained fixture bundle for Harn crystallization
experiments. It is intentionally boring JSON/JSONL so another repo can ingest it
without knowing the rest of `.harn-runs/release-harn`.

## Files

- `manifest.json`: schema/version metadata, release identity, and file map.
- `release-run.json`: the full release harness run payload.
- `deterministic-events.jsonl`: deterministic release facts, findings, and step records.
- `agent-events.jsonl`: model-authored review, changelog synthesis, and recovery advice.
- `tool-observations.jsonl`: command/read/tool observations, including failed command stdout/stderr.

## Source Split

Rows with `"source":"deterministic"` are harness-owned facts or command
results. Rows with `"source":"agent"` are model-authored text, tool summaries,
or recovery recommendations and must be treated as advisory.

## Release

- Repo: `${payload.analysis.repo}`
- Mode: `${payload.analysis.mode}`
- Mock: `${payload.analysis.mock}`
- Version: `${payload.analysis.current_version}` -> `${payload.analysis.next_version}`
- Branch: `${payload.analysis.branch}` -> `${payload.analysis.expected_branch}`
- Latest tag: `${payload.analysis.latest_tag}`
"""
}

fn write_crystallization_fixture(run_id, payload, report_paths) {
  let paths = crystallization_fixture_paths(run_id)
  mkdir(paths.out_dir, true)
  write_file(
    paths.release_run_json,
    json_stringify(
      {
        schema_version: "release_harn.crystallization_input.v1",
        kind: "release_harn_run",
        payload: payload,
      },
      2,
    )
      + "\n",
  )
  write_file(paths.deterministic_events_jsonl, jsonl(deterministic_fixture_events(payload)))
  write_file(paths.agent_events_jsonl, jsonl(agent_fixture_events(payload)))
  write_file(paths.tool_observations_jsonl, jsonl(tool_observation_events(payload)))
  write_file(paths.readme_md, fixture_readme(payload))
  write_file(
    paths.manifest_json,
    json_stringify(fixture_manifest(run_id, payload, report_paths, paths), 2) + "\n",
  )
  return {
    out_dir: paths.out_dir,
    manifest_json: paths.manifest_json,
    release_run_json: paths.release_run_json,
    deterministic_events_jsonl: paths.deterministic_events_jsonl,
    agent_events_jsonl: paths.agent_events_jsonl,
    tool_observations_jsonl: paths.tool_observations_jsonl,
    readme_md: paths.readme_md,
  }
}

fn execute_prepare(cfg, analysis, agent_review_result, run_id) {
  require_live_confirmation(cfg)
  var steps = setup_release_branch(cfg, analysis)
  if execution_failed(steps) {
    return add_recovery_for_last_failure(cfg, analysis, steps, run_id)
  }
  steps = steps + ensure_release_notes(cfg, analysis, agent_review_result)
  if execution_failed(steps) {
    return add_recovery_for_last_failure(cfg, analysis, steps, run_id)
  }
  let cmd = prepare_command(cfg)
  let r = run_cmd(cfg, cmd)
  steps = steps + [recorded_step("prepare", cmd, r)]
  if execution_failed(steps) {
    return add_recovery_for_last_failure(cfg, analysis, steps, run_id)
  }
  return steps
}

fn execute_ship_pr(cfg, analysis, agent_review_result, run_id) {
  require_live_confirmation(cfg)
  var steps = execute_prepare(cfg, analysis, agent_review_result, run_id)
  if execution_failed(steps) {
    return steps
  }
  let post_prepare_analysis = prepared_release_analysis(analyze_release(cfg), analysis)
  let version = post_prepare_analysis.next_version
  let branch = "release/v${version}"
  let base_arg = require_shell_arg(cfg.base, "--base")
  let base_ref_arg = require_shell_arg("origin/${cfg.base}", "origin base ref")
  let commands = [
    {name: "commit", command: "git commit -m \"Release v${version}\""},
    {name: "fetch-base", command: "git fetch origin " + base_arg},
    {name: "rebase-base", command: "git rebase " + base_ref_arg},
    {name: "push", command: "git push -u origin ${branch}"},
  ]
  for step in commands {
    let result = append_command_step(cfg, steps, step.name, step.command)
    steps = result.steps
    if !result.success {
      let failed_step = steps[len(steps) - 1]
      if step.name == "push" {
        steps = maybe_recovery_advice_step(cfg, post_prepare_analysis, steps, failed_step, run_id)
        if push_hook_budget_exceeded(failed_step.command, failed_step) {
          let retry_command = "git push --no-verify -u origin ${branch}"
          let push_retry = append_command_step(cfg, steps, "push-no-verify-after-green-hook-budget", retry_command)
          steps = push_retry.steps
          if push_retry.success {
            continue
          }
        }
      } else {
        steps = maybe_recovery_advice_step(cfg, post_prepare_analysis, steps, failed_step, run_id)
      }
      return steps
    }
  }
  let body_path = write_pr_body(run_id, post_prepare_analysis, agent_review_result, steps)
  let existing_pr_command = "gh pr list --base " + base_arg
    + " --head ${branch} --state open --json url --jq '.[0].url // \"\"'"
  let existing_pr = append_command_step(cfg, steps, "find-existing-pr", existing_pr_command)
  steps = existing_pr.steps
  if !existing_pr.success {
    return steps
  }
  var pr_url = trim(existing_pr.stdout)
  if pr_url == "" {
    let body_arg = safe_shell_arg(body_path)
    if body_arg == nil {
      steps = steps
        + [
        recorded_step(
          "create-pr",
          "gh pr create --base <base> --head ${branch} --title \"Release v${version}\" --body-file <path>",
          fail(2, "failed to quote PR body path"),
        ),
      ]
      return steps
    }
    let create_command = "gh pr create --base " + base_arg
      + " --head ${branch} --title \"Release v${version}\" --body-file "
      + body_arg
    let created = append_command_step(cfg, steps, "create-pr", create_command)
    steps = created.steps
    if !created.success {
      return steps
    }
    pr_url = trim(created.stdout)
  } else {
    let body_arg = safe_shell_arg(body_path)
    if body_arg == nil {
      steps = steps
        + [
        recorded_step(
          "refresh-existing-pr-body",
          "gh pr edit <pr-url> --body-file <path>",
          fail(2, "failed to quote PR body path"),
        ),
      ]
      return steps
    }
    let pr_edit_arg = require_shell_arg(pr_url, "PR URL")
    let edit_command = "gh pr edit " + pr_edit_arg + " --title \"Release v${version}\" --body-file "
      + body_arg
    let edited = append_command_step(cfg, steps, "refresh-existing-pr-body", edit_command)
    steps = edited.steps
    if !edited.success {
      return steps
    }
  }
  let pr_arg = safe_shell_arg(pr_url)
  if pr_arg == nil || pr_url == "" {
    steps = steps
      + [
      recorded_step(
        "auto-merge",
        "gh pr merge <pr-url> --auto --squash",
        fail(2, "could not determine PR URL for ${branch}"),
      ),
    ]
    return steps
  }
  let auto_merge = append_command_step(cfg, steps, "auto-merge", "gh pr merge " + pr_arg + " --auto --squash")
  steps = auto_merge.steps
  return steps
}

fn execution_failed(execution) {
  if execution == nil {
    return false
  }
  var recovered_budget_push = false
  for step in execution {
    if step.name == "push-no-verify-after-green-hook-budget" && step.success {
      recovered_budget_push = true
    }
  }
  for step in execution {
    if !step.success {
      if step.classification == "push_hook_budget_exceeded_after_green_tests" && recovered_budget_push {
        continue
      }
      return true
    }
  }
  return false
}

fn last_failed_step(execution) {
  var failed = nil
  if execution == nil {
    return nil
  }
  for step in execution {
    if !step.success {
      failed = step
    }
  }
  return failed
}

fn add_recovery_for_last_failure(cfg, analysis, steps, run_id) {
  let failed = last_failed_step(steps)
  if failed == nil {
    return steps
  }
  return maybe_recovery_advice_step(cfg, analysis, steps, failed, run_id)
}

fn write_report(run_id, payload) {
  let out_dir = path_join(cwd(), RUN_ROOT, run_id)
  mkdir(out_dir, true)
  let body = json_stringify(payload, 2)
  let json_path = path_join(out_dir, "release-audit.json")
  write_file(json_path, body + "\n")
  let md_payload = {...payload, audit_sha: sha3_256(body)[0:16]}
  let md = render("@prompts/release_report.harn.prompt", md_payload)
  let md_path = path_join(out_dir, "release-audit.md")
  write_file(md_path, md)
  return {json_path: json_path, md_path: md_path}
}

pipeline main() {
  let cfg = parse_args(argv)
  if cfg.help {
    println(usage())
    return 0
  }
  let run_id = uuid_v7()
  let started_iso = date_now_iso()
  let started_ms = now_ms()
  let repo_label = if cfg.mock {
    "(mock)"
  } else {
    cfg.repo
  }
  println("== harn release harness ${run_id}")
  println("   repo : ${repo_label}")
  println("   mode : ${cfg.mode}")
  println("   bump : ${cfg.bump}")
  let analysis = analyze_release(cfg)
  println("   current -> next : ${analysis.current_version} -> ${analysis.next_version}")
  println("   changelog top   : v${analysis.changelog_top}")
  println("   dirty files     : ${analysis.dirty_files}")
  var agent_review_result = {
    text: "(agent review skipped; pass --agent to enable local-model review)",
    attempts: [],
    validation_findings: [],
    draft_changelog: nil,
    artifacts: {},
  }
  if cfg.agent {
    let model_label = if cfg.mock {
      "mock provider"
    } else {
      cfg.model
    }
    println("== agent review with ${model_label} ...")
    agent_review_result = agent_review(cfg, analysis, run_id)
  }
  let agent_text = agent_review_result.text
  var execution = nil
  if cfg.mode == "prepare" {
    println("== running prepare ...")
    execution = execute_prepare(cfg, analysis, agent_review_result, run_id)
  } else if cfg.mode == "ship-pr" {
    println("== running prepare + PR handoff ...")
    execution = execute_ship_pr(cfg, analysis, agent_review_result, run_id)
  }
  let payload = {
    run_id: run_id,
    started_iso: started_iso,
    finished_iso: date_now_iso(),
    duration_ms: now_ms() - started_ms,
    operator: username(),
    host: hostname(),
    config: cfg,
    analysis: analysis,
    agent_review: agent_text,
    agent_review_detail: agent_review_result,
    execution: execution,
  }
  let written = write_report(run_id, payload)
  let fixture = write_crystallization_fixture(run_id, payload, written)
  println("== report written")
  println("   json: ${written.json_path}")
  println("   md  : ${written.md_path}")
  println("== crystallization fixture written")
  println("   dir : ${fixture.out_dir}")
  if len(analysis.deterministic_findings) > 0 {
    println("== findings")
    for f in analysis.deterministic_findings {
      println("   - ${f}")
    }
  }
  if execution_failed(execution) {
    return 1
  }
  return 0
}
