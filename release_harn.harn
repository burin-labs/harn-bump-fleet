#!/usr/bin/env harn
//
// release_harn.harn — Harn-native harness for the human-owned `/release-harn`
// workflow in ~/projects/harn.
//
// Defaults to audit-only. Live mutation requires --yes-live-release.
// Use --mock to exercise the end-to-end flow without touching the real repo.
import { agent_host_tools } from "std/agent/host_tools"
import { agent_preset } from "std/agent/presets"
import { command_output_range, command_output_tail } from "std/command"
import {
  changelog_latest_version_section_from_text,
  changelog_named_section_from_text,
  changelog_release_section_update,
  changelog_top_from_text,
} from "lib/changelog"
import { checkout_cleanup } from "lib/checkout_cleanup"
import { release_log_range_arg } from "lib/git"
import {
  agent_changelog_section,
  agent_result_text,
  raw_agent_changelog_section,
  validate_release_agent_audit_with_context,
} from "lib/release_audit"
import { append_std_command_step, append_std_github_command_step } from "lib/release_commands"
import {
  execution_failed,
  last_failed_step,
  markdownlint_source_context,
  markdownlint_violations_from_text,
  push_hook_budget_exceeded,
  recorded_step,
  recovery_step_ref,
  recovery_step_refs,
} from "lib/release_execution"
import { next_semver, version_from_release_branch, version_from_tag } from "lib/semver"
import { fail, ok, require_shell_arg, safe_shell_arg } from "lib/shell_util"
import { markdown_multiline, single_line_or, truncate_text } from "lib/text_util"

let DEFAULT_REPO = path_join(env_or("HOME", ""), "projects/harn")

let DEFAULT_BASE = env_or("HARN_RELEASE_BASE", "main")

let DEFAULT_MODEL = env_or("HARN_RELEASE_MODEL", "qwen3.6:35b-a3b-coding-nvfp4")

let DEFAULT_PROVIDER = env_or("HARN_RELEASE_PROVIDER", "ollama")

let MOCK_AGENT_MODEL = "claude-sonnet-4-7"

let RUN_ROOT = ".harn-runs/release-harn"

// Mock-mode placeholder for the pinned base SHA. 40 hex chars so it
// looks like a real commit SHA in audit reports, fixtures, and tests.
let MOCK_PIN_SHA = "abcdef1234567890abcdef1234567890abcdef12"

let RELEASE_RUN_ARGV_PREFIXES = [
  ["git", "status"],
  ["git", "diff"],
  ["git", "log"],
  ["git", "show"],
  ["git", "branch"],
  ["git", "rev-parse"],
  ["git", "diff-tree"],
  ["git", "ls-files"],
  ["git", "describe"],
  ["git", "tag"],
  ["gh", "pr", "list"],
  ["gh", "pr", "view"],
  ["gh", "pr", "checks"],
  ["gh", "run", "list"],
  ["gh", "run", "view"],
  ["gh", "workflow", "list"],
  ["gh", "workflow", "view"],
  ["gh", "release", "list"],
  ["gh", "release", "view"],
  ["make", "lint-md"],
  ["make", "-s", "lint-md"],
  ["npx", "markdownlint-cli2"],
  ["rg"],
  ["grep"],
  ["sed", "-n"],
  ["head"],
  ["cat"],
  ["ls"],
  ["test"],
]

fn usage() {
  return """
Usage:
  harn run release_harn.harn
  harn run release_harn.harn -- --agent
  harn run release_harn.harn -- --mock --agent --mode ship-pr
  harn run release_harn.harn -- --repo ~/projects/harn --mode prepare --yes-live-release

Modes:
  audit     Inspect release readiness and write an audit report. Default.
  prepare   Run ./scripts/release_ship.sh --prepare --bump <type>.
  ship-pr   Prepare, commit, rebase, push, open Release vX.Y.Z PR, and enable auto-merge.

Flags:
  --repo PATH             Harn repo path. Defaults to ~/projects/harn.
  --base BRANCH           Base branch for the release PR. Defaults to main.
  --bump patch|minor|major  Version bump type. Defaults to patch.
  --mode audit|prepare|ship-pr
  --at-sha SHA            Pin the release to a concrete commit on `--base` (default:
                          `origin/<base>` HEAD at startup). Locks the release branch's
                          parent so commits that land on the base afterward cannot
                          slip into the published artifact.
  --agent                 Ask a local model to review the release evidence with read/search/run tools.
                          Live prepare/ship-pr requires --agent unless CHANGELOG.md
                          already starts with the target version.
  --model MODEL           Local model id for --agent. Defaults to HARN_RELEASE_MODEL or qwen3.6:35b-a3b-coding-nvfp4.
  --provider PROVIDER     LLM provider for --agent. Defaults to HARN_RELEASE_PROVIDER or ollama.
  --mock                  Use fake command/file tools for a v0.7.52 -> v0.7.53 release rehearsal.
  --skip-audit            Pass through to release_ship.sh --prepare.
  --skip-dry-run          Pass through to release_ship.sh --prepare.
  --bootstrap-new-crates  First release that adds a workspace crate depended on by published crates.
  --focus TEXT            Operator context the model must consider while compiling release notes.
  --yes-live-release      Required for live prepare/ship-pr modes.
"""
}

@complexity(allow)
fn parse_args(args) {
  var cfg = {
    repo: DEFAULT_REPO,
    base: DEFAULT_BASE,
    bump: "patch",
    mode: "audit",
    agent: false,
    model: DEFAULT_MODEL,
    provider: DEFAULT_PROVIDER,
    mock: false,
    help: false,
    skip_audit: false,
    skip_dry_run: false,
    bootstrap_new_crates: env_or("HARN_RELEASE_BOOTSTRAP_NEW_CRATES", "") == "1",
    release_focus: env_or("HARN_RELEASE_FOCUS", ""),
    yes_live_release: false,
    pin_sha_input: env_or("HARN_RELEASE_PIN_SHA", ""),
    pin_sha: "",
  }
  var i = 0
  while i < len(args) {
    let a = args[i]
    if a == "--repo" {
      i = i + 1
      if i >= len(args) {
        throw "--repo requires a path"
      }
      cfg = {...cfg, repo: expand_home(args[i])}
    } else if a == "--base" {
      i = i + 1
      if i >= len(args) {
        throw "--base requires a branch name"
      }
      cfg = {...cfg, base: args[i]}
    } else if a == "--bump" {
      i = i + 1
      if i >= len(args) {
        throw "--bump requires patch, minor, or major"
      }
      cfg = {...cfg, bump: args[i]}
    } else if a == "--mode" {
      i = i + 1
      if i >= len(args) {
        throw "--mode requires audit, prepare, or ship-pr"
      }
      cfg = {...cfg, mode: args[i]}
    } else if a == "--agent" {
      cfg = {...cfg, agent: true}
    } else if a == "--model" {
      i = i + 1
      if i >= len(args) {
        throw "--model requires a model id"
      }
      cfg = {...cfg, model: args[i]}
    } else if a == "--provider" {
      i = i + 1
      if i >= len(args) {
        throw "--provider requires a provider name"
      }
      cfg = {...cfg, provider: args[i]}
    } else if a == "--mock" {
      cfg = {...cfg, mock: true}
    } else if a == "--skip-audit" {
      cfg = {...cfg, skip_audit: true}
    } else if a == "--skip-dry-run" {
      cfg = {...cfg, skip_dry_run: true}
    } else if a == "--bootstrap-new-crates" {
      cfg = {...cfg, bootstrap_new_crates: true}
    } else if a == "--focus" {
      i = i + 1
      if i >= len(args) {
        throw "--focus requires context text"
      }
      cfg = {...cfg, release_focus: args[i]}
    } else if a == "--yes-live-release" {
      cfg = {...cfg, yes_live_release: true}
    } else if a == "--at-sha" {
      i = i + 1
      if i >= len(args) {
        throw "--at-sha requires a commit SHA"
      }
      cfg = {...cfg, pin_sha_input: args[i]}
    } else if a == "-h" || a == "--help" {
      cfg = {...cfg, help: true}
      return cfg
    } else {
      throw "unknown arg: ${a}"
    }
    i = i + 1
  }
  if !(cfg.bump == "patch" || cfg.bump == "minor" || cfg.bump == "major") {
    throw "--bump must be patch, minor, or major"
  }
  if !(cfg.mode == "audit" || cfg.mode == "prepare" || cfg.mode == "ship-pr") {
    throw "--mode must be audit, prepare, or ship-pr"
  }
  return cfg
}

fn expand_home(path) {
  if path == "~" {
    return env_or("HOME", "")
  }
  if starts_with(path, "~/") {
    return env_or("HOME", "") + path[1:len(path)]
  }
  return path
}

/**
 * Resolve `cfg.pin_sha_input` (or `origin/<base>` when no input is given)
 * to a concrete 40-char commit SHA. Frozen here so every downstream step
 * — branch creation, audit ranges, PR body, tag push — uses the same
 * commit even if `origin/<base>` advances mid-run.
 */
fn resolve_pin_sha(cfg) {
  if cfg.mock {
    if cfg.pin_sha_input != "" {
      return cfg.pin_sha_input
    }
    return MOCK_PIN_SHA
  }
  if cfg.pin_sha_input != "" {
    let raw = trim(cfg.pin_sha_input)
    let arg = require_shell_arg(raw + "^{commit}", "--at-sha")
    let r = shell_at(cfg.repo, "git rev-parse --verify " + arg)
    if !r.success {
      throw "--at-sha did not resolve to a commit: ${raw}\n${trim(r.stderr)}"
    }
    return trim(r.stdout)
  }
  // For modes that mutate (prepare/ship-pr with --yes-live-release),
  // refresh origin first so the pin reflects the latest base. Audit
  // mode stays read-only and uses whatever is already cached locally.
  if cfg.mode != "audit" || cfg.yes_live_release {
    let f = shell_at(cfg.repo, "git fetch origin --prune --quiet")
    if !f.success {
      throw "failed to fetch origin before pinning the release SHA:\n${trim(f.stderr)}"
    }
  }
  let base_arg = require_shell_arg("origin/${cfg.base}^{commit}", "origin base ref")
  let r = shell_at(cfg.repo, "git rev-parse --verify " + base_arg)
  if !r.success {
    throw "failed to resolve origin/${cfg.base}:\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

fn run_cmd(cfg, command) {
  if cfg.mock {
    return fake_command(command, cfg)
  }
  return shell_at(cfg.repo, command)
}

fn read_repo_file(cfg, path) {
  if cfg.mock {
    return fake_file(path)
  }
  let full = path_join(cfg.repo, path)
  if !file_exists(full) {
    return ""
  }
  return read_file(full)
}

fn fake_file(path) {
  if path == "CHANGELOG.md" {
    return """
# Changelog

## v0.7.53

- Added merge-queue-safe release orchestration that ships from one release PR.
- Tightened release metadata verification and changelog drift checks.
- Documented the harn-release-bot workflow cascade.

## v0.7.52

- Previous release baseline.
"""
  }
  if path == "Cargo.toml" {
    return """
[workspace.package]
version = "0.7.52"
"""
  }
  if path == "README.md" {
    return "# Harn\n\nAgent harness language.\n"
  }
  return ""
}

@complexity(allow)
fn fake_command(command, cfg) {
  if contains(command, "git branch --show-current") {
    return ok("release/v0.7.53\n")
  }
  if contains(command, "git status --porcelain") {
    return ok("")
  }
  if contains(command, "git diff") && contains(command, "--stat") {
    return ok(
      " CHANGELOG.md             | 12 ++++++++++++\n README.md                |  4 ++++\n scripts/release_ship.sh  |  8 ++++++++\n 3 files changed, 24 insertions(+)\n",
    )
  }
  if contains(command, "git diff") && contains(command, "--name-only") {
    return ok("CHANGELOG.md\nREADME.md\nscripts/release_ship.sh\n")
  }
  if contains(command, "git describe --tags") {
    return ok("v0.7.52\n")
  }
  if contains(command, "git log --name-status") {
    return ok(
      "commit abc1234 release: consolidate harn release PR flow\nM\tCHANGELOG.md\nM\tscripts/release_ship.sh\n\ncommit bcd2345 ci: publish release from tag drift\nM\t.github/workflows/publish-release.yml\n\ncommit cde3456 docs: clarify local developer loop\nM\tREADME.md\n",
    )
  }
  if contains(command, "git log --stat") {
    return ok(
      "abc1234 release: consolidate harn release PR flow\n CHANGELOG.md            | 12 ++++++++++++\n scripts/release_ship.sh |  8 ++++++++\n\nbcd2345 ci: publish release from tag drift\n .github/workflows/publish-release.yml | 5 +++++\n\ncde3456 docs: clarify local developer loop\n README.md | 4 ++++\n",
    )
  }
  if contains(command, "git log --oneline") {
    return ok(
      "abc1234 release: consolidate harn release PR flow\nbcd2345 ci: publish release from tag drift\ncde3456 docs: clarify local developer loop\n",
    )
  }
  if contains(command, "test -x scripts/release_ship.sh") {
    return ok("release_ship=ok\n")
  }
  if contains(command, "test -x scripts/release_gate.sh") {
    return ok("release_gate=ok\n")
  }
  if contains(command, "test -f .github/workflows/publish-release.yml") {
    return ok("publish_workflow=ok\n")
  }
  if contains(command, "test -f .github/workflows/build-release-binaries.yml") {
    return ok("binary_workflow=ok\n")
  }
  if contains(command, "./scripts/release_ship.sh --prepare") {
    return ok(
      "=== Release audit ===\n=== Publish dry run ===\n=== Stage release content ===\nRelease content staged on release/v0.7.53:\n  Previous version: 0.7.52\n  Next version:     0.7.53\n",
    )
  }
  if contains(command, "git commit -m") {
    return ok("[release/v0.7.53 9999999] Release v0.7.53\n")
  }
  if contains(command, "git add -u") {
    return ok("")
  }
  if contains(command, "git fetch origin") || contains(command, "git rebase") {
    return ok("Current branch release/v0.7.53 is up to date.\n")
  }
  if contains(command, "git rev-parse HEAD") {
    return ok("9999999999999999999999999999999999999999\n")
  }
  if contains(command, "git rev-parse --verify") && contains(command, "origin/") {
    return ok(MOCK_PIN_SHA + "\n")
  }
  if contains(command, "git rev-parse -q --verify refs/tags/") {
    return fail(1, "")
  }
  if contains(command, "git rev-parse --verify") {
    return ok(MOCK_PIN_SHA + "\n")
  }
  if contains(command, "git rev-list -n 1") {
    return ok("9999999999999999999999999999999999999999\n")
  }
  if contains(command, "git tag -a") {
    return ok("")
  }
  if contains(command, "git push origin 'v") {
    return ok("To github.com:burin-labs/harn.git\n * [new tag]         v0.7.53 -> v0.7.53\n")
  }
  if contains(command, "git reset --hard") {
    return ok("HEAD is now at abc1234 main\n")
  }
  if contains(command, "make -s lint-md") || contains(command, "make lint-md")
    || contains(command, "npx markdownlint-cli2") {
    return ok("markdownlint-cli2 v0.22.1\nSummary: 0 error(s)\n")
  }
  if contains(command, "git push --no-verify -u origin") {
    return ok("branch 'release/v0.7.53' set up to track 'origin/release/v0.7.53'.\n")
  }
  if contains(command, "git push -u origin") {
    return fail(1, "pre-push hook: make test passed (3187/3187) but exceeded 120s wall-clock budget\n")
  }
  if contains(command, "gh pr create") {
    return ok("https://github.com/burin-labs/harn/pull/999\n")
  }
  if contains(command, "gh pr edit") {
    return ok("https://github.com/burin-labs/harn/pull/999\n")
  }
  if contains(command, "gh pr list") {
    if contains(command, "--jq") {
      return ok("\n")
    }
    if contains(command, "--state merged") {
      return ok(
        "[{\"number\":998,\"title\":\"release: consolidate harn release PR flow\",\"mergedAt\":\"2026-05-03T00:00:00Z\",\"url\":\"https://github.com/burin-labs/harn/pull/998\",\"headRefName\":\"release/v0.7.53\",\"mergeCommit\":{\"oid\":\"abc1234\"}}]\n",
      )
    }
    return ok("[]\n")
  }
  if contains(command, "gh pr view") && contains(command, "autoMergeRequest") {
    return ok("false\n")
  }
  if contains(command, "gh pr merge") {
    return ok("✓ Auto-merge enabled for pull request burin-labs/harn#999\n")
  }
  if contains(command, "rg ") {
    return ok("CHANGELOG.md:3:## v0.7.53\nscripts/release_ship.sh:82:Release vX.Y.Z\n")
  }
  return fail(127, "mock has no response for command: ${command}")
}

fn checked(cfg, command) {
  let r = run_cmd(cfg, command)
  if !r.success {
    throw "command failed (${r.status}): ${command}\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

fn current_version(cfg) {
  let text = read_repo_file(cfg, "Cargo.toml")
  let matches = regex_captures("(?m)^version\\s*=\\s*\"([^\"]+)\"", text)
  if len(matches) == 0 {
    return ""
  }
  return matches[0].groups[0]
}

fn changelog_top(cfg) {
  return changelog_top_from_text(read_repo_file(cfg, "CHANGELOG.md"))
}

fn changelog_section(cfg) {
  return changelog_latest_version_section_from_text(read_repo_file(cfg, "CHANGELOG.md"))
}

fn changelog_unreleased_section(cfg) {
  return changelog_named_section_from_text(read_repo_file(cfg, "CHANGELOG.md"), "## Unreleased")
}

fn diff_names(cfg) {
  return checked(cfg, "git diff HEAD --name-only")
}

fn release_file_changes(cfg, latest_tag) {
  return checked(
    cfg,
    "git log --name-status --pretty=format:'commit %h %s' --no-merges "
      + release_log_range_arg(latest_tag, cfg.pin_sha),
  )
}

fn release_commit_stats(cfg, latest_tag) {
  return checked(
    cfg,
    "git log --stat --oneline --no-renames --no-merges "
      + release_log_range_arg(latest_tag, cfg.pin_sha),
  )
}

fn count_lines(text) {
  let t = trim(text)
  if t == "" {
    return 0
  }
  return len(t.split("\n"))
}

fn changelog_section_for_agent(analysis) {
  if analysis.changelog_top == analysis.next_version {
    return truncate_text(analysis.changelog_section, 8000)
  }
  let unreleased = trim(analysis.changelog_unreleased_section ?? "")
  if unreleased != "" {
    return "No `v${analysis.next_version}` section exists yet. CHANGELOG.md has this non-empty `## Unreleased` section that will be promoted or replaced during prepare; preserve these existing entries and fold in only the missing post-tag release notes:\n\n"
      + truncate_text(unreleased, 10000)
  }
  return "No `v${analysis.next_version}` section exists yet. CHANGELOG.md currently starts at `v${analysis.changelog_top}`; draft the next section from the post-tag commit/file evidence instead of summarizing the old release."
}

fn first_post_tag_commit(analysis) {
  let commits = trim(analysis.commits_since_latest_tag ?? "")
  if commits == "" {
    return "(none)"
  }
  return trim(commits.split("\n")[0])
}

fn post_tag_commit_count(analysis) {
  let commits = trim(analysis.commits_since_latest_tag ?? "")
  if commits == "" {
    return 0
  }
  return len(commits.split("\n").filter({ line -> trim(line) != "" }))
}

fn pr_numbers_from_commits(commits) {
  var seen = {}
  var out = []
  for line in split(commits ?? "", "\n") {
    for m in regex_captures("\\(#([0-9]+)\\)", line) {
      let number = m.groups[0]
      if seen[number] ?? false {
        continue
      }
      seen[number] = true
      out = out + [number]
    }
  }
  return out
}

fn release_pr_details(cfg, commits) {
  let numbers = pr_numbers_from_commits(commits)
  if len(numbers) == 0 {
    return ""
  }
  if cfg.mock {
    return "PR #998\n{\"number\":998,\"title\":\"release: consolidate harn release PR flow\",\"body\":\"Mock PR body describing the one-PR release handoff, auto-merge enablement, and release workflow consolidation.\",\"files\":[\"CHANGELOG.md\",\"scripts/release_ship.sh\"]}"
  }
  let jq = require_shell_arg("{number,title,url,body,files:[.files[].path]}", "gh pr view --jq")
  var blocks = []
  for number in numbers {
    if len(blocks) >= 20 {
      break
    }
    let r = run_cmd(
      cfg,
      "gh pr view " + number
        + " --json number,title,url,body,files --jq "
        + jq,
    )
    if r.success && trim(r.stdout) != "" {
      blocks = blocks + ["PR #${number}\n" + truncate_text(trim(r.stdout), 5000)]
    } else {
      blocks = blocks
        + [
        "PR #${number}\nmetadata unavailable from `gh pr view`: "
          + truncate_text(trim(r.stderr ?? r.stdout ?? ""), 1000),
      ]
    }
  }
  return truncate_text(blocks.join("\n\n---\n\n"), 24000)
}

fn compact_agent_analysis(analysis) {
  return {
    repo: analysis.repo,
    mode: analysis.mode,
    bump: analysis.bump,
    branch: analysis.branch,
    expected_branch: analysis.expected_branch,
    base_branch: analysis.base_branch,
    pin_sha: analysis.pin_sha ?? "",
    current_version: analysis.current_version,
    next_version: analysis.next_version,
    operator_focus: analysis.operator_focus ?? "",
    latest_tag: analysis.latest_tag,
    changelog_top: analysis.changelog_top,
    dirty_files: analysis.dirty_files,
    diff_names: truncate_text(analysis.diff_names, 1000),
    post_tag_commit_count: post_tag_commit_count(analysis),
    latest_post_tag_commit: first_post_tag_commit(analysis),
    commits_since_latest_tag: truncate_text(analysis.commits_since_latest_tag, 8000),
    commit_stats_since_latest_tag: truncate_text(analysis.commit_stats_since_latest_tag, 12000),
    commit_file_changes_since_latest_tag: truncate_text(analysis.commit_file_changes_since_latest_tag, 12000),
    post_tag_pr_numbers: analysis.post_tag_pr_numbers ?? [],
    post_tag_pr_details: truncate_text(analysis.post_tag_pr_details ?? "", 12000),
    changelog_section: changelog_section_for_agent(analysis),
    changelog_unreleased_section: truncate_text(analysis.changelog_unreleased_section ?? "", 10000),
    release_scripts: analysis.release_scripts,
    workflows: analysis.workflows,
    deterministic_findings: analysis.deterministic_findings,
    recent_merged_prs: truncate_text(analysis.recent_merged_prs ?? "", 5000),
    suggested_read_only_inspections: [
      "git log --oneline --no-merges --max-count=80 ${analysis.latest_tag}..${analysis.pin_sha}",
      "git diff --stat --stat-count=80 ${analysis.latest_tag}..${analysis.pin_sha}",
      "git show --stat --oneline --no-renames --max-count=20 ${analysis.latest_tag}..${analysis.pin_sha}",
      "sed -n '1,120p' CHANGELOG.md",
      "sed -n '1,180p' scripts/release_ship.sh",
      "sed -n '1,180p' .github/workflows/publish-release.yml",
    ],
  }
}

fn release_finalization_prompt(analysis) {
  return render(
    "@prompts/release_finalization.harn.prompt",
    {
      target_version: "v${analysis.next_version}",
      tag_range: "${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}",
      first_post_tag_commit: first_post_tag_commit(analysis),
      release_fact_sheet: release_fact_sheet(analysis),
      changelog_draft_instructions: release_changelog_draft_prompt(analysis),
    },
  )
}

fn release_changelog_draft_prompt(analysis) {
  return render(
    "@prompts/release_changelog_draft.harn.prompt",
    {
      target_version: "v${analysis.next_version}",
      tag_range: "${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}",
      first_post_tag_commit: first_post_tag_commit(analysis),
    },
  )
}

fn release_fact_sheet(analysis) {
  return """
- Repo: `${analysis.repo}`.
- Mode: `${analysis.mode}`.
- Version: `${analysis.current_version}` -> `${analysis.next_version}` (${analysis.bump}).
- Pinned base SHA: `${analysis.pin_sha ?? "(unset)"}` — release branch is anchored here; commits that landed on `${analysis.base_branch}` after this run started are excluded from the release.
- Latest tag/range: `${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}`.
- Post-tag commit count: ${post_tag_commit_count(analysis)}.
- First post-tag commit: `${first_post_tag_commit(analysis)}`.
- Release-note source rule: use only commits in `${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}`
  plus authored `## Unreleased` content. Recent merged PRs are historical
  context only when they are not in that post-tag range.
- Operator focus: ${if trim(analysis.operator_focus ?? "") == "" {
    "none"
  } else {
    analysis.operator_focus
  }}.
- Current CHANGELOG top: `${analysis.changelog_top}`.
- Deterministic findings: ${if len(analysis.deterministic_findings ?? []) == 0 {
    "none"
  } else {
    join(analysis.deterministic_findings, "; ")
  }}.

Authored CHANGELOG content to preserve or update:
${changelog_section_for_agent(analysis)}

Recent post-tag commits:
${truncate_text(analysis.commits_since_latest_tag, 8000)}

Post-tag PR descriptions and touched files:
${if trim(analysis.post_tag_pr_details ?? "") == "" {
    "(none)"
  } else {
    truncate_text(analysis.post_tag_pr_details, 12000)
  }}

Representative per-commit stats:
${truncate_text(analysis.commit_stats_since_latest_tag, 12000)}

Representative per-commit file changes:
${truncate_text(analysis.commit_file_changes_since_latest_tag, 12000)}
"""
}

fn probe_ok(cfg, command) {
  let r = run_cmd(cfg, command)
  return r.success
}

fn optional_output(cfg, command) {
  let r = run_cmd(cfg, command)
  if r.success {
    return trim(r.stdout)
  }
  return ""
}

fn argv_contains_any(argv, disallowed) {
  for arg in argv {
    for flag in disallowed {
      if arg == flag || starts_with(arg, flag + "=") {
        return true
      }
    }
  }
  return false
}

fn release_run_policy(request, _args) {
  let argv = request?.argv ?? []
  if len(argv) < 2 {
    return true
  }
  if argv[0] == "git" && argv[1] == "tag" {
    if argv_contains_any(
      argv,
      ["-a", "-d", "-f", "-m", "-s", "--annotate", "--delete", "--force", "--message", "--sign"],
    ) {
      return "release_run is read-only; git tag creation, deletion, signing, and force flags are blocked"
    }
  }
  if argv[0] == "git" && argv[1] == "branch" {
    if argv_contains_any(argv, ["-c", "-C", "-d", "-D", "-m", "-M", "--copy", "--delete", "--move"]) {
      return "release_run is read-only; git branch mutation flags are blocked"
    }
  }
  if argv[0] == "gh" {
    if argv_contains_any(argv, ["--web"]) {
      return "release_run is non-interactive; gh --web is blocked"
    }
  }
  return true
}

fn mock_argv_command(args) {
  if type_of(args?.argv) == "list" && len(args.argv) > 0 {
    return args.argv.join(" ")
  }
  return args?.command ?? ""
}

fn mock_release_tools(cfg, run_id) {
  var tools = tool_registry()
  tools = tool_define(
    tools,
    "release_read",
    "Read a file from the mocked Harn repo.",
    {
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> truncate_text(read_repo_file(cfg, args.path), 12000) },
    },
  )
  tools = tool_define(
    tools,
    "release_search",
    "Search the mocked Harn repo.",
    {
      parameters: {pattern: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "search", side_effect_level: "read_only"},
      handler: { args ->
        let pattern = safe_shell_arg(args.pattern)
        if pattern == nil {
          return "blocked: search pattern contains unsupported shell quoting characters"
        }
        let r = run_cmd(cfg, "rg -n -- " + pattern + " README.md CHANGELOG.md docs/src scripts .github")
        if r.success {
          r.stdout
        } else {
          r.stderr
        }
      },
    },
  )
  tools = tool_define(
    tools,
    "release_run",
    "Run one read-only mocked release inspection command. Prefer argv arrays, for example {argv: [\"git\", \"log\", \"--oneline\", \"vX.Y.Z..HEAD\", \"--max-count=40\"]}.",
    {
      parameters: {
        argv: {type: "array", items: {type: "string"}, required: false},
        command: {type: "string", required: false},
      },
      returns: {type: "string"},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
      handler: { args ->
        let command = mock_argv_command(args)
        let r = run_cmd(cfg, command)
        return truncate_text("exit=${r.status}\nstdout:\n${r.stdout}\nstderr:\n${r.stderr}", 20000)
      },
    },
  )
  return add_release_artifact_tools(tools, run_id)
}

fn add_release_artifact_tools(tools, run_id) {
  var out = tools
  out = tool_define(
    out,
    "release_artifact_tail",
    "Read the last 12000 characters from a release-run artifact or live log. Pass a path from the failure context, such as `live-logs/prepare.log`.",
    {
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> read_artifact_window(run_id, args.path, 12000, false) },
    },
  )
  out = tool_define(
    out,
    "release_artifact_head",
    "Read the first 12000 characters from a release-run artifact or live log. Pass a path from the failure context, such as `live-logs/prepare.log`.",
    {
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> read_artifact_window(run_id, args.path, 12000, true) },
    },
  )
  out = tool_define(
    out,
    "release_artifact_search",
    "Search a release-run artifact or live log with ripgrep and return matching lines. Use this before reading a large log.",
    {
      parameters: {path: {type: "string"}, pattern: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> search_artifact(run_id, args.path, args.pattern) },
    },
  )
  return out
}

fn release_repair_relative_path(path) {
  let raw = trim(path ?? "")
  if raw == "" {
    throw "release repair path must be non-empty"
  }
  let normalized = raw.replace("\\", "/")
  if starts_with(normalized, "/") || contains(normalized, "..") {
    throw "release repair path must be repo-relative and must not contain '..'"
  }
  return normalized
}

fn require_release_repair_file(cfg, path) {
  let rel = release_repair_relative_path(path)
  let rel_arg = require_shell_arg(rel, "release repair path")
  let status = run_cmd(cfg, "git status --porcelain --untracked-files=no -- " + rel_arg)
  if !status.success || trim(status.stdout) == "" {
    throw "release repair edits are limited to tracked files already modified by the generated release diff: ${rel}"
  }
  let full = path_join(cfg.repo, rel)
  if !file_exists(full) {
    throw "release repair file does not exist: ${rel}"
  }
  return {rel: rel, full: full}
}

fn release_replace_file(cfg, args) {
  let path = require_release_repair_file(cfg, args.path)
  let old_text = args.old_text ?? ""
  let new_text = args.new_text ?? ""
  if old_text == "" {
    throw "release_replace_file requires non-empty old_text"
  }
  let before = read_file(path.full)
  let pieces = before.split(old_text)
  let count = len(pieces) - 1
  if count == 0 {
    throw "old_text was not found in " + path.rel
  }
  let expected = args?.expected_replacements ?? nil
  if expected != nil && count != expected {
    throw "expected ${expected} replacement(s) in ${path.rel}, found ${count}"
  }
  write_file(path.full, before.replace(old_text, new_text))
  return "replaced ${count} occurrence(s) in ${path.rel}"
}

fn release_write_file(cfg, args) {
  let path = require_release_repair_file(cfg, args.path)
  let content = args.content ?? ""
  write_file(path.full, content)
  return "wrote ${len(content)} bytes to ${path.rel}"
}

fn add_release_repair_tools(tools, cfg) {
  var out = tools
  out = tool_define(
    out,
    "release_replace_file",
    "Replace exact text in a tracked file already modified by the generated release diff. Use this for small release-note, lint, or generated-content repairs.",
    {
      parameters: {
        path: {type: "string"},
        old_text: {type: "string"},
        new_text: {type: "string"},
        expected_replacements: {type: "integer", required: false},
      },
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "filesystem_write"},
      handler: { args -> release_replace_file(cfg, args) },
    },
  )
  out = tool_define(
    out,
    "release_write_file",
    "Overwrite a tracked file already modified by the generated release diff. Prefer release_replace_file for small edits.",
    {
      parameters: {path: {type: "string"}, content: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "filesystem_write"},
      handler: { args -> release_write_file(cfg, args) },
    },
  )
  return out
}

fn release_host_tools(cfg, run_id) {
  let tools = agent_host_tools(
    nil,
    {
      root: cfg.repo,
      cwd: cfg.repo,
      max_inline_bytes: 12000,
      read_bytes: 12000,
      tail_bytes: 12000,
      search_max_matches: 120,
      exclude_globs: [".git/**", ".harn-runs/**", "target/**"],
      allow_argv_prefixes: RELEASE_RUN_ARGV_PREFIXES,
      command_policy: release_run_policy,
      names: {
        read_file: "release_read",
        read_file_tail: "release_read_tail",
        search_files: "release_search",
        git_inspect: "release_git",
        run_command: "release_run",
        read_command_output: "release_run_output",
        read_command_output_tail: "release_run_tail",
      },
      descriptions: {
        read_file: "Read a UTF-8 file under the Harn repo by repo-relative path. Prefer bounded reads with limit_bytes; the harness caps returned content.",
        search_files: "Search Harn repo contents. Provide a pattern; use path/glob only to narrow the search.",
        git_inspect: "Inspect git status, diff, log, show, blame, branches, or remotes without mutating the repo.",
        run_command: "Run one bounded read-only release inspection command from the Harn repo. Pass argv as an array of strings; shell command strings are not accepted. Inline output is capped, and large output can be read with release_run_output or release_run_tail using the returned command_id.",
      },
      result_formatter: release_host_tool_formatter,
      annotations: {run_command: {workflow_phase: "release_audit"}},
      output_format: "json",
    },
  )
  return add_release_artifact_tools(tools, run_id)
}

fn release_tools(cfg, run_id) {
  if cfg.mock {
    return mock_release_tools(cfg, run_id)
  }
  return release_host_tools(cfg, run_id)
}

fn release_repair_tools(cfg, run_id) {
  return add_release_repair_tools(release_tools(cfg, run_id), cfg)
}

fn release_review_post_turn(payload, analysis) {
  let successful = payload?.session_successful_tools ?? payload?.successful_tool_names ?? []
  let has_delta_command = successful.contains("release_run") || successful.contains("release_git")
  let has_content_evidence = successful.contains("release_read") || successful.contains("release_search")
    || successful.contains("release_git")
    || successful.contains("release_run_output")
    || successful.contains("release_run_tail")
  if has_delta_command && (has_content_evidence || analysis.mock) {
    let final_tools = tool_registry()
    return {
      message: release_finalization_prompt(analysis),
      next_options: {
        tools: final_tools,
        tool_choice: "none",
        max_tokens: 2200,
        loop_until_done: false,
        max_iterations: 1,
        max_nudges: 0,
        iteration_budget: {mode: "fixed", initial: 1, max: 1, extend_by: 0},
        post_turn_callback: nil,
      },
    }
  }
  if has_delta_command && !has_content_evidence {
    return {
      message: "Before finalizing, inspect at least one concrete content source with release_read, release_search, release_git, release_run_output, or release_run_tail. Prefer PR bodies, touched docs, or representative diffs over commit titles.",
    }
  }
  return nil
}

fn release_host_tool_formatter(value, _key) {
  if type_of(value) != "dict" {
    return json_stringify(value)
  }
  var out = value
  if type_of(out?.content) == "string" {
    out = out
      + {content: truncate_text(out.content, 12000), content_truncated_by_harness: len(out.content) > 12000}
  }
  if type_of(out?.stdout) == "string" {
    out = out
      + {stdout: truncate_text(out.stdout, 12000), stdout_truncated_by_harness: len(out.stdout) > 12000}
  }
  if type_of(out?.stderr) == "string" {
    out = out
      + {stderr: truncate_text(out.stderr, 4000), stderr_truncated_by_harness: len(out.stderr) > 4000}
  }
  return json_stringify(out)
}

fn validate_agent_attempt(_cfg, analysis, result, text) {
  var findings = validate_release_agent_audit_with_context(
    analysis.next_version,
    result,
    text,
    {first_post_tag_commit: first_post_tag_commit(analysis)},
  )
  let successful = result?.tools?.successful ?? []
  if len(successful) > 0 && starts_with(trim(text), "Audit:")
    && raw_agent_changelog_section(text) != "" {
    var filtered = []
    for finding in findings {
      if starts_with(finding, "agent_loop ended with status `budget_exhausted`") {
        continue
      }
      filtered = filtered + [finding]
    }
    findings = filtered
  }
  if len(successful) > 0 {
    let has_delta = successful.contains("release_run") || successful.contains("release_git")
    let has_content = successful.contains("release_read") || successful.contains("release_search")
      || successful.contains("release_git")
      || successful.contains("release_run_output")
      || successful.contains("release_run_tail")
    if !has_delta {
      findings = findings
        + ["agent did not successfully inspect the release delta with release_run or release_git"]
    }
    if !has_content && !analysis.mock {
      findings = findings
        + ["agent did not successfully inspect concrete PR, file, or diff evidence before drafting"]
    }
  }
  return findings
}

fn agent_repair_prompt(validation_findings, _prior_text, analysis) {
  return render(
    "@prompts/release_repair_prompt.harn.prompt",
    {
      validation_findings: validation_findings.join("\n"),
      release_fact_sheet: release_fact_sheet(analysis),
      target_version: "v${analysis.next_version}",
      first_post_tag_commit: first_post_tag_commit(analysis),
      changelog_draft_instructions: release_changelog_draft_prompt(analysis),
    },
  )
}

fn agent_repair_system() {
  return render("@prompts/release_repair_system.harn.prompt", {})
}

fn persist_agent_changelog(run_id, text, next_version) {
  let section = agent_changelog_section(text, next_version)
  if section == "" {
    return nil
  }
  let paths = agent_artifact_paths(run_id)
  mkdir(paths.out_dir, true)
  write_file(paths.draft_changelog_md, section + "\n")
  return paths.draft_changelog_md
}

fn release_session_id(cfg, analysis, run_id) {
  let session_override = env_or("HARN_RELEASE_SESSION_ID", "")
  if trim(session_override) != "" {
    return session_override
  }
  return "release-harn-"
    + if cfg.mock {
    "mock"
  } else {
    analysis.next_version
  }
    + "-"
    + run_id
}

fn agent_artifact_paths(run_id) {
  let out_dir = path_join(cwd(), RUN_ROOT, run_id)
  return {
    out_dir: out_dir,
    raw_result_json: path_join(out_dir, "agent-result.json"),
    trace_json: path_join(out_dir, "agent-trace.json"),
    llm_transcript_dir: path_join(out_dir, "agent-llm"),
    llm_transcript_jsonl: path_join(out_dir, "agent-llm/llm_transcript.jsonl"),
    draft_changelog_md: path_join(out_dir, "agent-draft-changelog.md"),
  }
}

fn analyze_release(cfg) {
  let branch = checked(cfg, "git branch --show-current")
  let current = current_version(cfg)
  let status = checked(cfg, "git status --porcelain --untracked-files=normal")
  let latest_tag = checked(cfg, "git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true")
  let top = changelog_top(cfg)
  let branch_version = version_from_release_branch(branch)
  let prepared_release = branch_version != "" && branch_version == current && top == current
    && version_from_tag(latest_tag) != current
  let next = if prepared_release {
    current
  } else {
    next_semver(current, cfg.bump)
  }
  let baseline = if prepared_release {
    version_from_tag(latest_tag)
  } else {
    current
  }
  let expected_branch = "release/v${next}"
  let committed_release_content = prepared_release && trim(status) == "" && branch == expected_branch
  let release_diff_range = require_shell_arg("${cfg.pin_sha}..HEAD", "release branch diff range")
  let diff_stat = if committed_release_content {
    checked(cfg, "git diff --stat " + release_diff_range)
  } else {
    checked(cfg, "git diff HEAD --stat")
  }
  let diff_name_list = if committed_release_content {
    checked(cfg, "git diff --name-only " + release_diff_range)
  } else {
    diff_names(cfg)
  }
  let commits = checked(cfg, "git log --oneline --no-merges " + release_log_range_arg(latest_tag, cfg.pin_sha))
  let commit_file_changes = release_file_changes(cfg, latest_tag)
  let commit_stats = release_commit_stats(cfg, latest_tag)
  let post_tag_pr_numbers = pr_numbers_from_commits(commits)
  let post_tag_pr_details = release_pr_details(cfg, commits)
  let section = changelog_section(cfg)
  let unreleased_section = changelog_unreleased_section(cfg)
  let recent_merged_prs = optional_output(
    cfg,
    "gh pr list --state merged --base " + require_shell_arg(cfg.base, "--base")
      + " --limit 30 --json number,title,mergedAt,url,headRefName,mergeCommit",
  )
  let scripts = {
    release_ship: probe_ok(cfg, "test -x scripts/release_ship.sh && echo release_ship=ok"),
    release_gate: probe_ok(cfg, "test -x scripts/release_gate.sh && echo release_gate=ok"),
  }
  let workflows = {
    publish_release: probe_ok(cfg, "test -f .github/workflows/publish-release.yml && echo publish_workflow=ok"),
    build_release_binaries: probe_ok(cfg, "test -f .github/workflows/build-release-binaries.yml && echo binary_workflow=ok"),
  }
  var findings = []
  if trim(status) == "" && trim(diff_name_list) == "" {
    findings = findings + ["working tree has no candidate release content"]
  }
  if top != next {
    findings = findings + ["CHANGELOG.md top entry is v${top}; expected v${next} for --bump ${cfg.bump}"]
  }
  if cfg.mode != "audit" && branch == cfg.base {
    findings = findings
      + ["release branch setup will move from ${cfg.base} to ${expected_branch} before preparing"]
  }
  if cfg.mode != "audit" && branch != expected_branch {
    findings = findings + ["current branch is ${branch}; branch setup will target ${expected_branch}"]
  }
  if !scripts.release_ship || !scripts.release_gate {
    findings = findings + ["release scripts are missing or not executable"]
  }
  if !workflows.publish_release || !workflows.build_release_binaries {
    findings = findings + ["release cascade workflows are missing"]
  }
  return {
    repo: if cfg.mock {
      "(mock harn repo)"
    } else {
      cfg.repo
    },
    mode: cfg.mode,
    bump: cfg.bump,
    model: cfg.model,
    provider: cfg.provider,
    mock: cfg.mock,
    operator_focus: cfg.release_focus,
    branch: branch,
    expected_branch: expected_branch,
    base_branch: cfg.base,
    pin_sha: cfg.pin_sha,
    pin_sha_input: cfg.pin_sha_input ?? "",
    current_version: baseline,
    next_version: next,
    prepared_release: prepared_release,
    latest_tag: latest_tag,
    changelog_top: top,
    dirty_files: count_lines(status),
    status: status,
    diff_stat: diff_stat,
    diff_names: diff_name_list,
    commits_since_latest_tag: commits,
    commit_file_changes_since_latest_tag: commit_file_changes,
    commit_stats_since_latest_tag: commit_stats,
    post_tag_pr_numbers: post_tag_pr_numbers,
    post_tag_pr_details: post_tag_pr_details,
    recent_merged_prs: recent_merged_prs,
    changelog_section: section,
    changelog_unreleased_section: unreleased_section,
    release_scripts: scripts,
    workflows: workflows,
    deterministic_findings: findings,
  }
}

fn artifact_path_for_tool(run_id, path) {
  let p = trim(path ?? "")
  if p == "" || contains(p, "..") {
    return nil
  }
  let root = run_output_dir(run_id)
  if starts_with(p, root + "/") {
    return p
  }
  let rel_prefix = ".harn-runs/release-harn/" + run_id + "/"
  if starts_with(p, rel_prefix) {
    return path_join(cwd(), p)
  }
  if starts_with(p, "/") {
    if contains(p, "/harn-command-") {
      return p
    }
    return nil
  }
  return path_join(root, p)
}

fn read_artifact_window(run_id, path, max_chars, from_start) {
  let resolved = artifact_path_for_tool(run_id, path)
  if resolved == nil {
    return "blocked: artifact path must be inside this release run directory"
  }
  if !file_exists(resolved) {
    return "missing artifact: ${resolved}"
  }
  let limit = max_chars ?? 12000
  let read = try {
    if from_start ?? false {
      command_output_range({path: resolved}, {offset: 0, length: limit})
    } else {
      command_output_tail({path: resolved}, {length: limit})
    }
  } catch (_e) {
    nil
  }
  if read != nil {
    let shown = if read.total_bytes <= limit {
      "full"
    } else {
      if from_start ?? false {
        "first ${limit} bytes"
      } else {
        "last ${limit} bytes"
      }
    }
    return "path: ${resolved}\nsize: ${read.total_bytes}\nshown: ${shown}\n\n" + read.content
  }
  let text = read_file(resolved)
  if len(text) <= limit {
    return "path: ${resolved}\nsize: ${stat(resolved).size}\nshown: full\n\n" + text
  }
  if from_start ?? false {
    return "path: ${resolved}\nsize: ${stat(resolved).size}\nshown: first ${limit} chars\n\n"
      + text[0:limit]
      + "\n\n... output continues; use release_artifact_search or read from the end ..."
  }
  return "path: ${resolved}\nsize: ${stat(resolved).size}\nshown: last ${limit} chars\n\n"
    + text[len(text) - limit:len(text)]
}

fn search_artifact(run_id, path, pattern) {
  let resolved = artifact_path_for_tool(run_id, path)
  if resolved == nil {
    return "blocked: artifact path must be inside this release run directory"
  }
  if !file_exists(resolved) {
    return "missing artifact: ${resolved}"
  }
  let pattern_arg = safe_shell_arg(pattern)
  let path_arg = safe_shell_arg(resolved)
  if pattern_arg == nil || path_arg == nil {
    return "blocked: unsupported shell quoting characters in artifact search"
  }
  let r = shell("rg -n -- " + pattern_arg + " " + path_arg + " | head -120")
  if r.success && trim(r.stdout) != "" {
    return r.stdout
  }
  let out = trim(r.stdout + "\n" + r.stderr)
  if out == "" {
    return "(no matches)"
  }
  return out
}

fn run_release_agent_loop(
  cfg,
  analysis,
  system,
  prompt,
  run_id,
  require_tool_evidence,
  session_suffix,
) {
  let paths = agent_artifact_paths(run_id)
  let role = if require_tool_evidence {
    "audit"
  } else {
    "summary"
  }
  let tools = if require_tool_evidence {
    release_tools(cfg, run_id)
  } else {
    tool_registry()
  }
  var options = agent_preset(
    role,
    {
      provider: if cfg.mock {
        "mock"
      } else {
        if cfg.provider == "auto" {
          "auto"
        } else {
          cfg.provider
        }
      },
      model: if cfg.mock {
        MOCK_AGENT_MODEL
      } else {
        cfg.model
      },
      max_tokens: if require_tool_evidence {
        2048
      } else {
        2200
      },
      tools: tools,
      timeout: 900,
      idle_timeout: 180,
      iteration_budget: if require_tool_evidence {
        {mode: "adaptive", initial: 4, max: 8, extend_by: 2}
      } else {
        {mode: "fixed", initial: 1, max: 1, extend_by: 0}
      },
      turn_policy: {allow_done_sentinel: false, max_prose_chars: 30000},
      post_turn_callback: if require_tool_evidence {
        { payload -> release_review_post_turn(payload, analysis) }
      } else {
        nil
      },
      compaction: {strategy: "hybrid", keep_last_n: 8},
      session_id: release_session_id(cfg, analysis, run_id) + session_suffix,
      llm_transcript_dir: paths.llm_transcript_dir,
    },
  )
  if !require_tool_evidence {
    options = {...options, tool_choice: "none"}
  }
  return agent_loop(prompt, system, options)
}

fn persist_agent_artifacts(run_id, result, attempts, validation_findings) {
  let paths = agent_artifact_paths(run_id)
  mkdir(paths.out_dir, true)
  write_file(paths.raw_result_json, json_stringify({attempts: attempts, final_result: result}) + "\n")
  write_file(paths.trace_json, json_stringify(result.trace ?? {}) + "\n")
  return {
    raw_result_json: paths.raw_result_json,
    trace_json: paths.trace_json,
    llm_transcript_jsonl: paths.llm_transcript_jsonl,
    draft_changelog_md: paths.draft_changelog_md,
    validation_findings: validation_findings,
  }
}

fn recovery_artifact_paths(run_id, step_name) {
  let safe_step = regex_replace_all("[^A-Za-z0-9_.-]+", "-", step_name)
  let out_dir = path_join(cwd(), RUN_ROOT, run_id, "recovery")
  return {
    out_dir: out_dir,
    raw_result_json: path_join(out_dir, safe_step + "-agent-result.json"),
    trace_json: path_join(out_dir, safe_step + "-agent-trace.json"),
    advice_md: path_join(out_dir, safe_step + "-advice.md"),
    llm_transcript_dir: path_join(out_dir, safe_step + "-llm"),
    llm_transcript_jsonl: path_join(out_dir, safe_step + "-llm/llm_transcript.jsonl"),
  }
}

fn recovery_session_id(cfg, analysis, run_id, step_name) {
  return release_session_id(cfg, analysis, run_id) + "-recovery-" + step_name
}

fn unique_markdownlint_paths(violations) {
  var seen = {}
  var out = []
  for violation in violations ?? [] {
    let path = violation.path ?? ""
    if path == "" || seen[path] ?? false {
      continue
    }
    seen[path] = true
    out = out + [path]
  }
  return out
}

fn markdownlint_files_for_context(cfg, paths) {
  var files = {}
  for path in paths ?? [] {
    let text = read_repo_file(cfg, path)
    if text != "" {
      files[path] = text
    }
  }
  return files
}

fn shell_args_for_paths(paths) {
  var args = []
  for path in paths ?? [] {
    let arg = safe_shell_arg(path)
    if arg != nil {
      args = args + [arg]
    }
  }
  return args
}

fn candidate_diff_for_paths(cfg, paths) {
  let args = shell_args_for_paths(paths)
  if len(args) == 0 {
    return ""
  }
  let r = run_cmd(cfg, "git diff -- " + args.join(" "))
  if !r.success {
    return ""
  }
  return truncate_text(r.stdout, 12000)
}

fn includes_changelog_path(paths) {
  for path in paths ?? [] {
    if path == "CHANGELOG.md" || ends_with(path, "/CHANGELOG.md") {
      return true
    }
  }
  return false
}

fn changelog_lint_excerpt(cfg, analysis, paths) {
  if !includes_changelog_path(paths) {
    return ""
  }
  let text = read_repo_file(cfg, "CHANGELOG.md")
  if text == "" {
    return ""
  }
  let section = changelog_latest_version_section_from_text(text)
  if trim(section) == "" {
    return ""
  }
  return "Current top CHANGELOG section for v${analysis.next_version}:\n"
    + truncate_text(section, 8000)
}

fn markdownlint_recovery_context(cfg, analysis, log_text) {
  let violations = markdownlint_violations_from_text(log_text)
  if len(violations) == 0 {
    return nil
  }
  let paths = unique_markdownlint_paths(violations)
  let files = markdownlint_files_for_context(cfg, paths)
  return {
    classification: "generated_markdown_lint_failed",
    violations: violations,
    source_context: markdownlint_source_context(violations, files, 2),
    candidate_diff: candidate_diff_for_paths(cfg, paths),
    changelog_excerpt: changelog_lint_excerpt(cfg, analysis, paths),
    preferred_edit_tool: "release_replace_file",
    fallback_edit_tool: "release_write_file",
    edit_guidance: "Prefer release_replace_file for narrow prose wrapping and line-length fixes; use release_write_file only when exact replacement cannot safely express the repair.",
    bounded_verification: ["make -s lint-md"],
    repeated_read_guidance: "Use source_context, candidate_diff, and changelog_excerpt before calling release_read. If more release_read calls are necessary, state the concrete missing fact.",
  }
}

fn live_log_failure_context(cfg, analysis, step) {
  let log_path = step?.output_path ?? step?.live_log ?? ""
  if log_path == "" {
    return nil
  }
  let tail_read = try {
    command_output_tail(step, {length: 12000})
  } catch (_e) {
    nil
  }
  let tail = if tail_read != nil {
    tail_read.content
  } else {
    if file_exists(log_path) {
      let text = read_file(log_path)
      let limit = 12000
      if len(text) > limit {
        text[len(text) - limit:len(text)]
      } else {
        text
      }
    } else {
      step?.tail ?? step?.stderr ?? ""
    }
  }
  let pattern_arg = safe_shell_arg("fail|failed|error|ERROR|Summary:|MD[0-9]+")
  let path_arg = safe_shell_arg(log_path)
  let matches = if file_exists(log_path) && pattern_arg != nil && path_arg != nil {
    trim(shell("rg -n -- " + pattern_arg + " " + path_arg + " | tail -80").stdout)
  } else {
    ""
  }
  let matched_log_text = trim(matches + "\n" + tail)
  return {
    path: log_path,
    command_id: step?.command_id ?? "",
    matches: matches,
    tail: tail,
    markdownlint: markdownlint_recovery_context(cfg, analysis, matched_log_text),
  }
}

fn recovery_failure_class(failed_step, live_context) {
  if live_context?.markdownlint != nil {
    return "generated_markdown_lint_failed"
  }
  return failed_step.classification ?? ""
}

fn run_recovery_agent_loop(cfg, analysis, prompt, run_id, step_name) {
  let paths = recovery_artifact_paths(run_id, step_name)
  let system = render("@prompts/release_recovery_system.harn.prompt", {})
  return agent_loop(
    prompt,
    system,
    agent_preset(
      "repair",
      {
        provider: if cfg.mock {
          "mock"
        } else {
          if cfg.provider == "auto" {
            "auto"
          } else {
            cfg.provider
          }
        },
        model: if cfg.mock {
          MOCK_AGENT_MODEL
        } else {
          cfg.model
        },
        tools: release_repair_tools(cfg, run_id),
        timeout: 900,
        idle_timeout: 180,
        max_nudges: 1,
        iteration_budget: {mode: "adaptive", initial: 4, max: 10, extend_by: 2},
        turn_policy: {allow_done_sentinel: false, max_prose_chars: 9000},
        compaction: {strategy: "hybrid", keep_last_n: 6},
        session_id: recovery_session_id(cfg, analysis, run_id, step_name),
        llm_transcript_dir: paths.llm_transcript_dir,
      },
    ),
  )
}

fn recovery_agent_advice(cfg, analysis, steps, failed_step, run_id) {
  require_agent_tool_model(cfg)
  if cfg.mock {
    llm_mock_clear()
    llm_mock(
      {
        text: "I will inspect the mocked push failure before recommending recovery.",
        tool_calls: [
          {
            id: "recovery_run_1",
            name: "release_run",
            arguments: {argv: ["git", "status", "--porcelain", "--untracked-files=normal"]},
          },
        ],
      },
    )
    llm_mock(
      {
        text: "- The failed push is classified as a green-test pre-push hook budget timeout.\n- The release commit and branch can be reused.\n- Retry with `git push --no-verify -u origin ${analysis.expected_branch}` and keep both attempts in the run artifacts.",
      },
    )
  }
  let live_context = live_log_failure_context(cfg, analysis, failed_step)
  let classification = recovery_failure_class(failed_step, live_context)
  let prompt = render(
    "@prompts/release_recovery_prompt.harn.prompt",
    {
      failure_context_json: json_stringify(
        {
          analysis: analysis,
          failed_step: recovery_step_ref(failed_step),
          live_log_excerpt: live_context,
          execution_so_far: recovery_step_refs(steps),
          classification: classification,
          recovery_hint: failed_step.recovery_hint ?? "",
        },
      ),
    },
  )
  let result = run_recovery_agent_loop(cfg, analysis, prompt, run_id, failed_step.name)
  let text = agent_result_text(result)
  let paths = recovery_artifact_paths(run_id, failed_step.name)
  mkdir(paths.out_dir, true)
  write_file(paths.raw_result_json, json_stringify(result) + "\n")
  write_file(paths.trace_json, json_stringify(result.trace ?? {}) + "\n")
  write_file(paths.advice_md, text + "\n")
  return {
    text: text,
    artifacts: {
      raw_result_json: paths.raw_result_json,
      trace_json: paths.trace_json,
      advice_md: paths.advice_md,
      llm_transcript_jsonl: paths.llm_transcript_jsonl,
    },
    llm: result.llm ?? {},
    tools: result.tools ?? {},
    status: result.status ?? "",
  }
}

fn maybe_recovery_advice_step(cfg, analysis, steps, failed_step, run_id) {
  if !cfg.agent {
    return steps
  }
  let advice = recovery_agent_advice(cfg, analysis, steps, failed_step, run_id)
  let r = ok(advice.text)
  let step = recorded_step(
    "agent-recovery-advice-${failed_step.name}",
    "agent_loop recovery diagnosis for failed ${failed_step.name}",
    r,
  )
  return steps
    + [
    {
      ...step,
      artifacts: advice.artifacts,
      agent_status: advice.status,
      llm: advice.llm,
      tools: advice.tools,
    },
  ]
}

fn retry_commands_after_agent_repair(step) {
  if step.name == "commit" {
    return [
      {name: "stage-after-agent-repair-commit", command: "git add -u"},
      {name: "commit-after-agent-repair", command: step.command},
    ]
  }
  return []
}

fn run_retry_commands_after_agent_repair(cfg, steps, retry_commands, run_id) {
  var out = steps
  for retry_step in retry_commands {
    release_log_event(run_id, "step_started", {step: retry_step.name, command: retry_step.command})
    let result = append_command_step(cfg, out, retry_step.name, retry_step.command)
    out = result.steps
    release_log_event(
      run_id,
      "step_finished",
      {step: retry_step.name, success: result.success, status: result.status},
    )
    if !result.success {
      return {steps: out, success: false}
    }
  }
  return {steps: out, success: true}
}

fn retry_prepare_after_agent_repair(cfg, steps, failed_step, run_id) {
  let retry_name = "prepare-after-agent-repair"
  let cmd = failed_step.command ?? ""
  release_log_event(run_id, "step_started", {step: retry_name, command: cmd})
  let result = append_command_step(cfg, steps, retry_name, cmd)
  let out = result.steps
  release_log_event(
    run_id,
    "step_finished",
    {
      step: retry_name,
      success: result.success,
      status: result.status,
      live_log: result.step.live_log ?? "",
    },
  )
  return out
}

fn release_generated_content_checks(_cfg, _analysis) {
  return [{name: "release-markdown-lint", command: "make -s lint-md"}]
}

fn run_release_generated_content_checks(cfg, analysis, steps, run_id) {
  var out = steps
  for check in release_generated_content_checks(cfg, analysis) {
    release_log_event(run_id, "step_started", {step: check.name, command: check.command})
    let result = append_command_step(cfg, out, check.name, check.command)
    out = result.steps
    release_log_event(
      run_id,
      "step_finished",
      {step: check.name, success: result.success, status: result.status},
    )
    if result.success {
      continue
    }
    let failed_step = out[len(out) - 1]
    out = maybe_recovery_advice_step(cfg, analysis, out, failed_step, run_id)
    if cfg.agent {
      let retry_name = check.name + "-after-agent-repair"
      release_log_event(run_id, "step_started", {step: retry_name, command: check.command})
      let retry_result = append_command_step(cfg, out, retry_name, check.command)
      out = retry_result.steps
      release_log_event(
        run_id,
        "step_finished",
        {step: retry_name, success: retry_result.success, status: retry_result.status},
      )
      if retry_result.success {
        continue
      }
    }
    return {steps: out, success: false}
  }
  return {steps: out, success: true}
}

fn agent_review(cfg, analysis, run_id) {
  require_agent_tool_model(cfg)
  if cfg.mock {
    llm_mock_clear()
    llm_mock(
      {
        text: "I will inspect the mocked release evidence.",
        tool_calls: [
          {
            id: "run_1",
            name: "release_run",
            arguments: {argv: ["git", "log", "--oneline", "v0.7.52..HEAD", "--max-count=30"]},
          },
          {id: "read_1", name: "release_read", arguments: {path: "CHANGELOG.md"}},
        ],
      },
    )
    let mock_final = {
      text: "Audit:\n- Version/readiness: v0.7.53 matches the mocked release analysis.\n- CHANGELOG coverage: the draft keeps the prepared v0.7.53 release note focused on the mocked one-PR handoff.\n- First post-tag commit: abc1234 release: consolidate harn release PR flow.\n- Release risks: no mocked blocking risks after the read-only evidence pass.\n- Next command: harn run release_harn.harn -- --mode ship-pr --agent --yes-live-release.\n\nBEGIN_DRAFT_CHANGELOG\n## v0.7.53\n\n### Changed\n\n- **Consolidated release flow.** Exercises the mocked one-PR release path and auto-merge handoff.\nEND_DRAFT_CHANGELOG",
    }
    llm_mock(mock_final)
    llm_mock(mock_final)
    llm_mock(mock_final)
    llm_mock(mock_final)
  }
  let system = render("@prompts/release_agent_system.harn.prompt", {})
  let prompt = render(
    "@prompts/release_agent_user.harn.prompt",
    {analysis_json: json_stringify(compact_agent_analysis(analysis))},
  )
  var result = run_release_agent_loop(cfg, analysis, system, prompt, run_id, true, "")
  var text = agent_result_text(result)
  var validation_findings = validate_agent_attempt(cfg, analysis, result, text)
  var attempts = [
    {
      name: "initial-review",
      text: text,
      validation_findings: validation_findings,
      llm: result.llm ?? {},
      tools: result.tools ?? {},
      status: result.status ?? "",
    },
  ]
  while len(validation_findings) > 0 && len(attempts) < 3 {
    let repair_prompt = agent_repair_prompt(validation_findings, text, analysis)
    result = run_release_agent_loop(
      cfg,
      analysis,
      agent_repair_system(),
      repair_prompt,
      run_id,
      false,
      "-repair-${len(attempts)}",
    )
    text = agent_result_text(result)
    validation_findings = validate_agent_attempt(cfg, analysis, result, text)
    attempts = attempts
      + [
      {
        name: "validation-repair-${len(attempts)}",
        text: text,
        validation_findings: validation_findings,
        llm: result.llm ?? {},
        tools: result.tools ?? {},
        status: result.status ?? "",
      },
    ]
  }
  let draft_changelog = persist_agent_changelog(run_id, text, analysis.next_version)
  let artifacts = persist_agent_artifacts(run_id, result, attempts, validation_findings)
  return {
    text: text,
    attempts: attempts,
    validation_findings: validation_findings,
    draft_changelog: draft_changelog,
    artifacts: artifacts,
  }
}

fn prepare_command(cfg) {
  var cmd = "./scripts/release_ship.sh --prepare --bump ${cfg.bump}"
  if cfg.bootstrap_new_crates ?? false {
    cmd = "HARN_BOOTSTRAP_NEW_CRATES=1 " + cmd
  }
  if cfg.skip_audit {
    cmd = cmd + " --skip-audit"
  }
  if cfg.skip_dry_run {
    cmd = cmd + " --skip-dry-run"
  }
  return cmd
}

fn release_adds_workspace_crate(analysis) {
  let changes = analysis.commit_file_changes_since_latest_tag ?? ""
  return contains(changes, "A\tcrates/") && contains(changes, "/Cargo.toml")
}

fn with_derived_release_options(cfg, analysis) {
  if cfg.bootstrap_new_crates ?? false {
    return cfg
  }
  if release_adds_workspace_crate(analysis) {
    return {...cfg, bootstrap_new_crates: true}
  }
  return cfg
}

fn require_agent_tool_model(cfg) {
  if cfg.mock {
    return nil
  }
  let info = if cfg.provider == "auto" {
    llm_model_info(cfg.model)
  } else {
    {
      provider: cfg.provider,
      id: cfg.model,
      capabilities: provider_capabilities(cfg.provider, cfg.model),
    }
  }
  let caps = info.capabilities ?? {}
  if !(caps.native_tools ?? false) {
    let provider = info.provider ?? "unknown"
    let model = info.id ?? cfg.model
    throw "agent review model ${cfg.model} resolves to ${provider}/${model}, which does not support Harn tools; choose a tool-capable local model such as qwen3.6:35b-a3b-coding-nvfp4 through Ollama, or run without --agent"
  }
  return info
}

fn require_live_confirmation(cfg) {
  if !cfg.mock && !cfg.yes_live_release {
    throw "live ${cfg.mode} mode requires --yes-live-release"
  }
}

fn run_events_path(run_id) {
  return path_join(cwd(), RUN_ROOT, run_id, "run-events.jsonl")
}

fn release_log_event(run_id, event_type, data) {
  let path = run_events_path(run_id)
  mkdir(dirname(path), true)
  append_file(
    path,
    json_stringify(
      {
        schema_version: "release_harn.run_event.v1",
        timestamp: date_now_iso(),
        event_type: event_type,
        data: data,
      },
    )
      + "\n",
  )
  return path
}

fn release_command_runner(cfg) {
  if !cfg.mock {
    return nil
  }
  return { spec, _options -> fake_command(spec.command ?? "", cfg) }
}

fn append_command_step(cfg, steps, name, command, extra = nil) {
  return append_std_command_step(cfg, steps, name, command, release_command_runner(cfg), extra)
}

fn append_github_command_step(cfg, steps, name, command) {
  return append_std_github_command_step(cfg, steps, name, command, release_command_runner(cfg))
}

fn local_branch_exists(cfg, branch) {
  return probe_ok(cfg, "git show-ref --verify --quiet refs/heads/${branch}")
}

fn remote_branch_exists(cfg, branch) {
  return probe_ok(cfg, "git show-ref --verify --quiet refs/remotes/origin/${branch}")
}

fn target_release_checkout_state(cfg, analysis) {
  let branch = checked(cfg, "git branch --show-current")
  let current = current_version(cfg)
  let top = changelog_top(cfg)
  return {
    branch: branch,
    current_version: current,
    changelog_top: top,
    matches: branch == analysis.expected_branch && current == analysis.next_version
      && top == analysis.next_version,
  }
}

fn release_branch_push_command(cfg, branch, no_verify) {
  var parts = ["git", "push"]
  if no_verify {
    parts = parts + ["--no-verify"]
  }
  if remote_branch_exists(cfg, branch) {
    parts = parts + ["--force-with-lease"]
  }
  parts = parts + ["-u", "origin", branch]
  return parts.join(" ")
}

/**
 * Tag the release commit at HEAD as `vX.Y.Z` and push the tag.
 *
 * The tag is the source of truth for what gets published — the harn-side
 * publish-release.yml fires on tag push and ships from the tag, so the
 * release survives the merge queue rebasing the Release PR onto a moved
 * main. Idempotent: if the tag already exists locally and points at the
 * release HEAD, the create step no-ops; if it points elsewhere, fail
 * with an actionable message rather than overwriting silently.
 */
fn ensure_release_tag_pushed(cfg, version, steps, run_id) {
  let tag = "v${version}"
  let tag_arg = require_shell_arg(tag, "release tag")
  let head_probe = run_cmd(cfg, "git rev-parse HEAD")
  if !head_probe.success {
    return steps + [recorded_step("create-release-tag", "git rev-parse HEAD", head_probe)]
  }
  let head = trim(head_probe.stdout)
  var pre_steps = steps
  let local_tag_probe = run_cmd(cfg, "git rev-parse -q --verify refs/tags/" + tag_arg)
  if local_tag_probe.success {
    let tag_commit_probe = run_cmd(cfg, "git rev-list -n 1 " + tag_arg)
    let tag_commit = if tag_commit_probe.success {
      trim(tag_commit_probe.stdout)
    } else {
      ""
    }
    if tag_commit != head {
      return pre_steps
        + [
        recorded_step(
          "create-release-tag",
          "git rev-list -n 1 " + tag,
          fail(
            2,
            "tag ${tag} already exists locally at ${tag_commit}, but release HEAD is ${head}; delete the stale tag (`git tag -d ${tag}`) before re-running",
          ),
        ),
      ]
    }
    pre_steps = pre_steps
      + [
      recorded_step(
        "create-release-tag",
        "tag ${tag} already pinned at HEAD",
        ok("idempotent reuse of existing tag ${tag} at ${head}\n"),
      ),
    ]
  } else {
    let tag_msg = require_shell_arg("Release v${version}", "release tag message")
    let create_command = "git tag -a " + tag_arg + " -m " + tag_msg
    release_log_event(run_id, "step_started", {step: "create-release-tag", command: create_command})
    let create = append_command_step(cfg, pre_steps, "create-release-tag", create_command)
    pre_steps = create.steps
    release_log_event(
      run_id,
      "step_finished",
      {step: "create-release-tag", success: create.success, status: create.status},
    )
    if !create.success {
      return pre_steps
    }
  }
  let push_tag_command = "git push origin " + tag_arg
  release_log_event(run_id, "step_started", {step: "push-release-tag", command: push_tag_command})
  let push_tag = append_command_step(cfg, pre_steps, "push-release-tag", push_tag_command)
  release_log_event(
    run_id,
    "step_finished",
    {step: "push-release-tag", success: push_tag.success, status: push_tag.status},
  )
  return push_tag.steps
}

fn normalize_release_analysis_checkout(cfg, run_id) {
  if cfg.mock || cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return
  }
  let current_branch = checked(cfg, "git branch --show-current")
  let release_version = version_from_release_branch(current_branch)
  if release_version == "" {
    return
  }
  let status = checked(cfg, "git status --porcelain --untracked-files=normal")
  if trim(status) != "" {
    release_log_event(
      run_id,
      "checkout_normalization_preserved_dirty_release_branch",
      {from_branch: current_branch, status: status},
    )
    return
  }
  let current = current_version(cfg)
  let top = changelog_top(cfg)
  let latest_tag = checked(cfg, "git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true")
  if release_version == current && top == current && version_from_tag(latest_tag) != current {
    release_log_event(
      run_id,
      "checkout_normalization_skipped_prepared_release_branch",
      {branch: current_branch, version: current, latest_tag: latest_tag},
    )
    return
  }
  let base_arg = require_shell_arg(cfg.base, "--base")
  release_log_event(
    run_id,
    "checkout_normalization_started",
    {from_branch: current_branch, base: cfg.base},
  )
  let fetch = run_cmd(cfg, "git fetch origin --prune --quiet")
  if !fetch.success {
    throw "failed to fetch before release rerun checkout normalization:\n${trim(fetch.stderr)}"
  }
  let switched = run_cmd(cfg, "git switch " + base_arg)
  if !switched.success {
    throw "failed to switch from ${current_branch} to ${cfg.base} before release analysis:\n${trim(switched.stderr)}"
  }
  let pulled = run_cmd(cfg, "git pull --ff-only origin " + base_arg + " --quiet")
  if !pulled.success {
    throw "failed to fast-forward ${cfg.base} before release analysis:\n${trim(pulled.stderr)}"
  }
  release_log_event(
    run_id,
    "checkout_normalization_finished",
    {from_branch: current_branch, base: cfg.base, release_version: release_version},
  )
}

fn setup_release_branch(cfg, analysis) {
  var steps = []
  let current_branch = checked(cfg, "git branch --show-current")
  let target_branch = analysis.expected_branch
  let target_branch_arg = require_shell_arg(target_branch, "target release branch")
  let status = checked(cfg, "git status --porcelain --untracked-files=normal")
  if current_branch == target_branch {
    return [
      recorded_step(
        "use-current-release-branch",
        "git branch --show-current && git status --porcelain --untracked-files=normal",
        ok("using existing ${target_branch} checkout for prepare\n${status}"),
      ),
    ]
  }
  var stashed = false
  if trim(status) != "" {
    if current_branch == cfg.base {
      steps = steps
        + [
        recorded_step(
          "dirty-base-branch",
          "git status --porcelain --untracked-files=normal",
          fail(
            2,
            "refusing to create ${target_branch} from dirty base branch ${cfg.base}; clean, commit, or move unrelated work before running live release",
          ),
        ),
      ]
      return steps
    }
    let stash_message = "release_harn branch setup ${analysis.next_version} ${uuid_v7()}"
    let stash_arg = safe_shell_arg(stash_message)
    if stash_arg == nil {
      steps = steps
        + [
        recorded_step(
          "stash-before-branch-setup",
          "git stash push -u -m <release_harn message>",
          fail(2, "failed to quote stash message"),
        ),
      ]
      return steps
    }
    let stash = append_command_step(cfg, steps, "stash-before-branch-setup", "git stash push -u -m " + stash_arg)
    steps = stash.steps
    if !stash.success {
      return steps
    }
    stashed = true
  }
  let fetch = append_command_step(cfg, steps, "fetch-origin", "git fetch origin --prune --quiet")
  steps = fetch.steps
  if !fetch.success {
    if stashed {
      let restore = append_command_step(cfg, steps, "restore-stash-after-fetch-failure", "git stash pop --index")
      steps = restore.steps
    }
    return steps
  }
  if current_branch == cfg.base {
    let base_arg = require_shell_arg(cfg.base, "--base")
    let pull = append_command_step(cfg, steps, "sync-base", "git pull --ff-only origin " + base_arg + " --quiet")
    steps = pull.steps
    if !pull.success {
      if stashed {
        let restore = append_command_step(cfg, steps, "restore-stash-after-sync-failure", "git stash pop --index")
        steps = restore.steps
      }
      return steps
    }
  }
  let pin_arg = require_shell_arg(cfg.pin_sha, "release pin SHA")
  var switch_step = "create-release-branch-from-pin"
  var switch_command = "git switch -c " + target_branch_arg + " " + pin_arg
  if current_branch == target_branch {
    switch_step = "reset-release-branch-to-pin"
    switch_command = "git reset --hard " + pin_arg
  } else if local_branch_exists(cfg, target_branch) || remote_branch_exists(cfg, target_branch) {
    switch_step = "reset-release-branch-to-pin"
    switch_command = "git switch -C " + target_branch_arg + " " + pin_arg
  }
  let switched = append_command_step(cfg, steps, switch_step, switch_command)
  steps = switched.steps
  if !switched.success {
    if stashed {
      let restore = append_command_step(cfg, steps, "restore-stash-after-switch-failure", "git stash pop --index")
      steps = restore.steps
    }
    return steps
  }
  if stashed {
    let applied = append_command_step(cfg, steps, "restore-stashed-release-content", "git stash pop --index")
    steps = applied.steps
    if !applied.success {
      let status_after = run_cmd(cfg, "git status --porcelain --untracked-files=normal")
      steps = steps
        + [
        recorded_step(
          "status-after-stash-conflict",
          "git status --porcelain --untracked-files=normal",
          status_after,
        ),
      ]
      return steps
    }
  }
  return steps
}

fn read_agent_notes(notes_path) {
  if notes_path == nil || notes_path == "" || !file_exists(notes_path) {
    return ""
  }
  return trim(read_file(notes_path))
}

fn apply_draft_release_notes(cfg, analysis, notes_path) {
  let changelog_path = path_join(cfg.repo, "CHANGELOG.md")
  if !cfg.mock && !file_exists(changelog_path) {
    return fail(1, "missing CHANGELOG.md")
  }
  let original = read_repo_file(cfg, "CHANGELOG.md")
  let update = changelog_release_section_update(original, analysis.next_version, read_agent_notes(notes_path))
  if !update.success {
    return fail(1, update.message)
  }
  if update.changed && !cfg.mock {
    write_file(changelog_path, update.text)
  }
  return ok("ok: " + update.message + "\n")
}

fn release_commit_title(line) {
  let cleaned = trim(line ?? "")
  if cleaned == "" {
    return ""
  }
  return trim(regex_replace("^[0-9a-f]+\\s+", "", cleaned))
}

fn deterministic_release_commit_notes(analysis) {
  var notes = []
  for line in split(analysis.commits_since_latest_tag ?? "", "\n") {
    let title = release_commit_title(line)
    if title == "" {
      continue
    }
    let normalized = regex_replace("^\\[codex\\]\\s+", "", title)
    notes = notes + ["- " + normalized + "."]
  }
  return notes
}

fn deterministic_release_notes(analysis) {
  let unreleased = trim(analysis.changelog_unreleased_section ?? "")
  let commit_notes = deterministic_release_commit_notes(analysis)
  var parts = ["## v${analysis.next_version}"]
  if unreleased != "" {
    parts = parts + [unreleased]
  }
  if len(commit_notes) > 0 {
    parts = parts + ["### Changed\n\n" + join(commit_notes, "\n")]
  }
  return join(parts, "\n\n")
}

fn write_deterministic_release_notes(run_id, analysis) {
  let out_dir = path_join(cwd(), RUN_ROOT, run_id)
  mkdir(out_dir, true)
  let path = path_join(out_dir, "deterministic-draft-changelog.md")
  write_file(path, deterministic_release_notes(analysis) + "\n")
  return path
}

fn release_notes_draft_path(run_id, analysis, agent_review_result) {
  let draft_path = agent_review_result.draft_changelog ?? nil
  if draft_path != nil && draft_path != "" {
    return draft_path
  }
  return write_deterministic_release_notes(run_id, analysis)
}

fn live_release_notes_blocker(cfg, analysis) {
  if cfg.mode == "audit" || cfg.agent || analysis.changelog_top == analysis.next_version {
    return nil
  }
  return recorded_step(
    "release-notes-agent-required",
    "require agent-authored or manually prepared release notes before live release side effects",
    fail(
      2,
      "live ${cfg.mode} would need to draft CHANGELOG.md v${analysis.next_version}, but --agent was not enabled. Rerun with --agent so the harness can inspect PR bodies/files/diffs, or manually add a ## v${analysis.next_version} section before running live release.",
    ),
  )
}

fn ensure_release_notes_with_run_id(cfg, analysis, agent_review_result, run_id) {
  let current_top = changelog_top(cfg)
  if current_top == analysis.next_version {
    return [
      recorded_step(
        "release-notes-current",
        "CHANGELOG.md already starts with v${analysis.next_version}",
        ok("CHANGELOG.md already starts with v${analysis.next_version}\n"),
      ),
    ]
  }
  let draft_path = release_notes_draft_path(run_id, analysis, agent_review_result)
  let r = apply_draft_release_notes(cfg, analysis, draft_path)
  return [
    recorded_step(
      "draft-release-notes",
      "insert draft CHANGELOG.md section for v${analysis.next_version}",
      r,
    ),
  ]
}

fn prepared_release_findings(raw, original) {
  var findings = []
  if raw.changelog_top != original.next_version {
    findings = findings
      + [
      "CHANGELOG.md top entry is v${raw.changelog_top}; expected v${original.next_version} for this prepared release",
    ]
  }
  if raw.branch != original.expected_branch {
    findings = findings
      + ["current branch is ${raw.branch}; expected prepared release branch ${original.expected_branch}"]
  }
  if !raw.release_scripts.release_ship || !raw.release_scripts.release_gate {
    findings = findings + ["release scripts are missing or not executable"]
  }
  if !raw.workflows.publish_release || !raw.workflows.build_release_binaries {
    findings = findings + ["release cascade workflows are missing"]
  }
  return findings
}

fn prepared_release_analysis(raw, original) {
  return {
    ...raw,
    current_version: original.current_version,
    next_version: original.next_version,
    expected_branch: original.expected_branch,
    operator_focus: original.operator_focus ?? "",
    deterministic_findings: prepared_release_findings(raw, original),
  }
}

fn execution_has_step(execution, name) {
  for step in execution ?? [] {
    if step.name == name {
      return true
    }
  }
  return false
}

fn pr_body_text(analysis, agent_review_result, execution) {
  let agent_artifacts = agent_review_result.artifacts ?? {}
  let draft_path = agent_review_result.draft_changelog ?? ""
  let validation = agent_review_result.validation_findings ?? []
  let changelog_section = markdown_multiline(analysis.changelog_section)
  let preparation_note = if execution_has_step(execution, "prepare-already-complete") {
    "The harness verified this branch already had the target Cargo version, release branch name, and top CHANGELOG entry before the PR handoff."
  } else {
    if execution_has_step(execution, "prepare") {
      "The harness generated the release content through `scripts/release_ship.sh --prepare` before the PR handoff."
    } else {
      "The harness generated this body from a fresh release snapshot before the PR handoff."
    }
  }
  let execution_summary = if execution == nil {
    "(no side-effecting steps recorded)"
  } else {
    execution_table(execution)
  }
  let pin_sha_note = if trim(analysis.pin_sha_input ?? "") == "" {
    "(auto-resolved from `origin/${analysis.base_branch}` at run start)"
  } else {
    "(operator override via `--at-sha ${analysis.pin_sha_input}`)"
  }
  return render(
    "@prompts/release_pr_body.harn.prompt",
    {
      next_version: analysis.next_version,
      preparation_note: preparation_note,
      current_version: analysis.current_version,
      branch: analysis.branch,
      base_branch: analysis.base_branch,
      pin_sha: analysis.pin_sha ?? "(unset)",
      pin_sha_note: pin_sha_note,
      latest_tag: analysis.latest_tag,
      changed_files: single_line_or(analysis.diff_names, "none"),
      deterministic_findings: if len(analysis.deterministic_findings) == 0 {
        "none"
      } else {
        "review run artifact"
      },
      changelog_section: changelog_section,
      commits_since_latest_tag: analysis.commits_since_latest_tag,
      execution_summary: execution_summary,
      audit_transcript: agent_artifacts.llm_transcript_jsonl ?? "not generated",
      draft_changelog: draft_path,
      validation_findings: if len(validation) == 0 {
        "none"
      } else {
        validation.join("; ")
      },
    },
  )
}

fn execution_table(execution) {
  var lines = ["| Step | Status | Classification |", "|------|--------|----------------|"]
  for step in execution {
    let status = if step.success {
      "ok"
    } else {
      "failed (${step.status})"
    }
    lines = lines + ["| `${step.name}` | ${status} | `${step.classification ?? ""}` |"]
  }
  return lines.join("\n")
}

fn write_pr_body(run_id, analysis, agent_review_result, execution) {
  let body_path = path_join(cwd(), RUN_ROOT, run_id, "pr-body.md")
  mkdir(dirname(body_path), true)
  write_file(body_path, pr_body_text(analysis, agent_review_result, execution))
  return body_path
}

fn append_pr_auto_merge_steps(cfg, steps, pr_url, run_id) {
  let pr_arg = safe_shell_arg(pr_url)
  if pr_arg == nil || pr_url == "" {
    return {
      steps: steps
        + [
        recorded_step(
          "auto-merge",
          "gh pr merge <pr-url> --auto",
          fail(2, "could not determine PR URL for release PR"),
        ),
      ],
      success: false,
      pr_arg: "",
    }
  }
  let auto_merge_probe_command = "gh pr view " + pr_arg
    + " --json autoMergeRequest --jq '.autoMergeRequest != null'"
  release_log_event(
    run_id,
    "step_started",
    {step: "inspect-auto-merge", command: auto_merge_probe_command},
  )
  let probe = append_github_command_step(cfg, steps, "inspect-auto-merge", auto_merge_probe_command)
  var out = probe.steps
  release_log_event(
    run_id,
    "step_finished",
    {step: "inspect-auto-merge", success: probe.success, status: probe.status},
  )
  if !probe.success {
    return {steps: out, success: false, pr_arg: pr_arg}
  }
  if trim(probe.stdout) == "true" {
    out = out
      + [
      recorded_step(
        "auto-merge-already-enabled",
        "autoMergeRequest present on " + pr_url,
        ok("release PR already has auto-merge enabled\n"),
      ),
    ]
    return {steps: out, success: true, pr_arg: pr_arg}
  }
  let auto_merge_command = "gh pr merge " + pr_arg + " --auto"
  release_log_event(run_id, "step_started", {step: "auto-merge", command: auto_merge_command})
  let auto_merge = append_github_command_step(cfg, out, "auto-merge", auto_merge_command)
  out = auto_merge.steps
  release_log_event(
    run_id,
    "step_finished",
    {step: "auto-merge", success: auto_merge.success, status: auto_merge.status},
  )
  if auto_merge.success {
    return {steps: out, success: true, pr_arg: pr_arg}
  }
  let fallback_command = "gh pr merge " + pr_arg + " --auto --squash"
  release_log_event(
    run_id,
    "step_started",
    {step: "auto-merge-with-squash-fallback", command: fallback_command},
  )
  let fallback = append_github_command_step(cfg, out, "auto-merge-with-squash-fallback", fallback_command)
  out = fallback.steps
  release_log_event(
    run_id,
    "step_finished",
    {step: "auto-merge-with-squash-fallback", success: fallback.success, status: fallback.status},
  )
  return {steps: out, success: fallback.success, pr_arg: pr_arg}
}

fn run_output_dir(run_id) {
  return path_join(cwd(), RUN_ROOT, run_id)
}

fn crystallization_fixture_paths(run_id) {
  let out_dir = path_join(run_output_dir(run_id), "crystallization-input")
  return {
    out_dir: out_dir,
    manifest_json: path_join(out_dir, "manifest.json"),
    release_run_json: path_join(out_dir, "release-run.json"),
    deterministic_events_jsonl: path_join(out_dir, "deterministic-events.jsonl"),
    agent_events_jsonl: path_join(out_dir, "agent-events.jsonl"),
    tool_observations_jsonl: path_join(out_dir, "tool-observations.jsonl"),
    readme_md: path_join(out_dir, "README.md"),
  }
}

fn artifact_text(path) {
  let p = path ?? ""
  if p == "" || !file_exists(p) {
    return ""
  }
  return read_file(p)
}

fn jsonl(events) {
  var lines = []
  for event in events {
    lines = lines + [json_stringify(event)]
  }
  if len(lines) == 0 {
    return ""
  }
  return lines.join("\n") + "\n"
}

fn deterministic_fixture_events(payload) {
  let a = payload.analysis
  var events = [
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "release_analysis",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        repo: a.repo,
        mode: a.mode,
        mock: a.mock,
        bump: a.bump,
        starting_branch: a.branch,
        target_release_branch: a.expected_branch,
        base_branch: a.base_branch,
        current_version: a.current_version,
        next_version: a.next_version,
        latest_tag: a.latest_tag,
        git_log_range: release_log_range_arg(a.latest_tag, a.pin_sha ?? ""),
        dirty_files: a.dirty_files,
        status: a.status,
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "changelog_audit_inputs",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        expected_version: a.next_version,
        changelog_top: a.changelog_top,
        changelog_section: a.changelog_section,
        changelog_unreleased_section: a.changelog_unreleased_section ?? "",
        commits_since_latest_tag: a.commits_since_latest_tag,
        commit_stats_since_latest_tag: a.commit_stats_since_latest_tag,
        commit_file_changes_since_latest_tag: a.commit_file_changes_since_latest_tag,
        post_tag_pr_numbers: a.post_tag_pr_numbers ?? [],
        post_tag_pr_details: a.post_tag_pr_details ?? "",
      },
    },
  ]
  for finding in a.deterministic_findings {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "deterministic_finding",
        source: "deterministic",
        timestamp: payload.finished_iso,
        data: {finding: finding},
      },
    ]
  }
  for step in payload.execution ?? [] {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "release_step_recorded",
        source: "deterministic",
        timestamp: payload.finished_iso,
        data: {
          name: step.name,
          command: step.command,
          success: step.success,
          status: step.status,
          classification: step.classification ?? "",
          recovery_hint: step.recovery_hint ?? "",
        },
      },
    ]
  }
  return events
}

fn agent_artifact_snapshot(agent_detail) {
  let artifacts = agent_detail.artifacts ?? {}
  return {
    raw_result_json_path: artifacts.raw_result_json ?? "",
    raw_result_json: artifact_text(artifacts.raw_result_json ?? ""),
    trace_json_path: artifacts.trace_json ?? "",
    trace_json: artifact_text(artifacts.trace_json ?? ""),
    llm_transcript_jsonl_path: artifacts.llm_transcript_jsonl ?? "",
    llm_transcript_jsonl: artifact_text(artifacts.llm_transcript_jsonl ?? ""),
    draft_changelog_md_path: artifacts.draft_changelog_md ?? "",
    draft_changelog_md: artifact_text(artifacts.draft_changelog_md ?? ""),
  }
}

fn recovery_artifact_snapshot(step) {
  let artifacts = step.artifacts ?? {}
  return {
    raw_result_json_path: artifacts.raw_result_json ?? "",
    raw_result_json: artifact_text(artifacts.raw_result_json ?? ""),
    trace_json_path: artifacts.trace_json ?? "",
    trace_json: artifact_text(artifacts.trace_json ?? ""),
    advice_md_path: artifacts.advice_md ?? "",
    advice_md: artifact_text(artifacts.advice_md ?? ""),
    llm_transcript_jsonl_path: artifacts.llm_transcript_jsonl ?? "",
    llm_transcript_jsonl: artifact_text(artifacts.llm_transcript_jsonl ?? ""),
  }
}

fn agent_fixture_events(payload) {
  let detail = payload.agent_review_detail ?? {}
  let attempts = detail.attempts ?? []
  var events = []
  if len(attempts) == 0 {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "agent_review_skipped",
        source: "agent",
        timestamp: payload.finished_iso,
        data: {reason: payload.agent_review},
      },
    ]
  }
  for {index, value} in attempts.enumerate() {
    let attempt = value
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "agent_review_attempt",
        source: "agent",
        timestamp: payload.finished_iso,
        data: {
          index: index,
          name: attempt.name,
          status: attempt.status ?? "",
          text: attempt.text,
          validation_findings: attempt.validation_findings ?? [],
          llm: attempt.llm ?? {},
          tools: attempt.tools ?? {},
        },
      },
    ]
  }
  if len(attempts) > 0 {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "agent_review_artifacts",
        source: "agent",
        timestamp: payload.finished_iso,
        data: agent_artifact_snapshot(detail),
      },
    ]
  }
  for step in payload.execution ?? [] {
    if starts_with(step.name, "agent-recovery-advice-") {
      events = events
        + [
        {
          schema_version: "release_harn.crystallization_input.v1",
          event_type: "agent_recovery_advice",
          source: "agent",
          timestamp: payload.finished_iso,
          data: {
            step_name: step.name,
            status: step.agent_status ?? "",
            text: step.stdout,
            llm: step.llm ?? {},
            tools: step.tools ?? {},
            artifacts: recovery_artifact_snapshot(step),
          },
        },
      ]
    }
  }
  return events
}

fn tool_observation_events(payload) {
  let a = payload.analysis
  var events = [
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "shell",
        command: "git status --porcelain --untracked-files=normal",
        success: true,
        status: 0,
        stdout: a.status,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "shell",
        command: "git diff HEAD --stat",
        success: true,
        status: 0,
        stdout: a.diff_stat,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "shell",
        command: "git log --oneline --no-merges " + release_log_range_arg(a.latest_tag, a.pin_sha ?? ""),
        success: true,
        status: 0,
        stdout: a.commits_since_latest_tag,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "shell",
        command: "git log --name-status --pretty=format:'commit %h %s' --no-merges "
          + release_log_range_arg(a.latest_tag, a.pin_sha ?? ""),
        success: true,
        status: 0,
        stdout: a.commit_file_changes_since_latest_tag,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "read_file",
        path: "CHANGELOG.md",
        success: true,
        status: 0,
        stdout: a.changelog_section,
        stderr: "",
      },
    },
    {
      schema_version: "release_harn.crystallization_input.v1",
      event_type: "tool_observation",
      source: "deterministic",
      timestamp: payload.started_iso,
      data: {
        tool: "read_file",
        path: "CHANGELOG.md#Unreleased",
        success: true,
        status: 0,
        stdout: a.changelog_unreleased_section ?? "",
        stderr: "",
      },
    },
  ]
  for step in payload.execution ?? [] {
    events = events
      + [
      {
        schema_version: "release_harn.crystallization_input.v1",
        event_type: "tool_observation",
        source: if starts_with(step.name, "agent-recovery-advice-") {
          "agent"
        } else {
          "deterministic"
        },
        timestamp: payload.finished_iso,
        data: {
          tool: if starts_with(step.name, "agent-recovery-advice-") {
            "agent_loop"
          } else {
            "shell"
          },
          step_name: step.name,
          command: step.command,
          success: step.success,
          status: step.status,
          classification: step.classification ?? "",
          recovery_hint: step.recovery_hint ?? "",
          stdout: step.stdout,
          stderr: step.stderr,
        },
      },
    ]
  }
  return events
}

fn fixture_manifest(run_id, payload, report_paths, paths) {
  return {
    schema_version: "release_harn.crystallization_input.v1",
    kind: "release_harn_crystallization_input",
    generated_by: "release_harn.harn",
    generated_at: date_now_iso(),
    run_id: run_id,
    source_issue: env_or("HARN_RELEASE_SOURCE_ISSUE", ""),
    consumer_issue: env_or("HARN_RELEASE_CONSUMER_ISSUE", ""),
    source_artifacts: {release_audit_json: report_paths.json_path, release_audit_md: report_paths.md_path},
    release: {
      repo: payload.analysis.repo,
      mode: payload.analysis.mode,
      mock: payload.analysis.mock,
      current_version: payload.analysis.current_version,
      next_version: payload.analysis.next_version,
      starting_branch: payload.analysis.branch,
      target_release_branch: payload.analysis.expected_branch,
      base_branch: payload.analysis.base_branch,
      latest_tag: payload.analysis.latest_tag,
    },
    files: {
      manifest_json: paths.manifest_json,
      release_run_json: paths.release_run_json,
      deterministic_events_jsonl: paths.deterministic_events_jsonl,
      agent_events_jsonl: paths.agent_events_jsonl,
      tool_observations_jsonl: paths.tool_observations_jsonl,
      readme_md: paths.readme_md,
    },
    semantics: {
      deterministic_events: "Facts and harness decisions emitted by release_harn.harn.",
      agent_events: "Model-authored audit, changelog synthesis, and recovery advice. Not deterministic truth.",
      tool_observations: "Shell/read/tool observations with stdout/stderr preserved for replay and audit.",
    },
  }
}

fn fixture_readme(payload) {
  let a = payload.analysis
  return render(
    "@prompts/release_fixture_readme.harn.prompt",
    {
      repo: a.repo,
      mode: a.mode,
      mock: a.mock,
      current_version: a.current_version,
      next_version: a.next_version,
      branch: a.branch,
      expected_branch: a.expected_branch,
      latest_tag: a.latest_tag,
    },
  )
}

fn write_crystallization_fixture(run_id, payload, report_paths) {
  let paths = crystallization_fixture_paths(run_id)
  mkdir(paths.out_dir, true)
  write_file(
    paths.release_run_json,
    json_stringify(
      {
        schema_version: "release_harn.crystallization_input.v1",
        kind: "release_harn_run",
        payload: payload,
      },
    )
      + "\n",
  )
  write_file(paths.deterministic_events_jsonl, jsonl(deterministic_fixture_events(payload)))
  write_file(paths.agent_events_jsonl, jsonl(agent_fixture_events(payload)))
  write_file(paths.tool_observations_jsonl, jsonl(tool_observation_events(payload)))
  write_file(paths.readme_md, fixture_readme(payload))
  write_file(
    paths.manifest_json,
    json_stringify(fixture_manifest(run_id, payload, report_paths, paths)) + "\n",
  )
  return {
    out_dir: paths.out_dir,
    manifest_json: paths.manifest_json,
    release_run_json: paths.release_run_json,
    deterministic_events_jsonl: paths.deterministic_events_jsonl,
    agent_events_jsonl: paths.agent_events_jsonl,
    tool_observations_jsonl: paths.tool_observations_jsonl,
    readme_md: paths.readme_md,
  }
}

fn execute_prepare(cfg, analysis, agent_review_result, run_id) {
  require_live_confirmation(cfg)
  release_log_event(
    run_id,
    "phase_started",
    {phase: "prepare", message: "starting release branch setup and prepare"},
  )
  var steps = []
  let initial_target_state = target_release_checkout_state(cfg, analysis)
  if initial_target_state.matches {
    steps = steps
      + [
      recorded_step(
        "prepare-already-complete",
        "prepared release branch already has v${analysis.next_version} release content",
        ok(
          "skipped prepare because branch ${initial_target_state.branch}, Cargo version ${initial_target_state.current_version}, and CHANGELOG top v${initial_target_state.changelog_top} already target v${analysis.next_version}",
        ),
      ),
    ]
    release_log_event(
      run_id,
      "phase_finished",
      {phase: "prepare", success: true, already_complete: true},
    )
    return steps
  }
  steps = setup_release_branch(cfg, analysis)
  if execution_failed(steps) {
    release_log_event(
      run_id,
      "phase_failed",
      {phase: "prepare", failed_step: recovery_step_ref(last_failed_step(steps))},
    )
    return add_recovery_for_last_failure(cfg, analysis, steps, run_id)
  }
  release_log_event(run_id, "step_started", {step: "ensure-release-notes"})
  steps = steps + ensure_release_notes_with_run_id(cfg, analysis, agent_review_result, run_id)
  if execution_failed(steps) {
    release_log_event(
      run_id,
      "phase_failed",
      {phase: "prepare", failed_step: recovery_step_ref(last_failed_step(steps))},
    )
    return add_recovery_for_last_failure(cfg, analysis, steps, run_id)
  }
  let target_state = target_release_checkout_state(cfg, analysis)
  if target_state.matches {
    steps = steps
      + [
      recorded_step(
        "prepare-already-complete",
        "prepared release branch already has v${analysis.next_version} release content",
        ok(
          "skipped prepare because branch ${target_state.branch}, Cargo version ${target_state.current_version}, and CHANGELOG top v${target_state.changelog_top} already target v${analysis.next_version}",
        ),
      ),
    ]
    release_log_event(
      run_id,
      "phase_finished",
      {phase: "prepare", success: true, already_complete: true},
    )
    return steps
  }
  let cmd = prepare_command(cfg)
  release_log_event(run_id, "step_started", {step: "prepare", command: cmd})
  let prepare = append_command_step(cfg, steps, "prepare", cmd)
  steps = prepare.steps
  release_log_event(
    run_id,
    "step_finished",
    {
      step: "prepare",
      success: prepare.success,
      status: prepare.status,
      live_log: prepare.step.live_log ?? "",
    },
  )
  if execution_failed(steps) {
    release_log_event(
      run_id,
      "phase_failed",
      {phase: "prepare", failed_step: recovery_step_ref(last_failed_step(steps))},
    )
    return add_recovery_for_last_failure(cfg, analysis, steps, run_id)
  }
  release_log_event(run_id, "phase_finished", {phase: "prepare", success: true})
  return steps
}

fn execute_ship_pr(cfg, analysis, agent_review_result, run_id) {
  require_live_confirmation(cfg)
  var steps = execute_prepare(cfg, analysis, agent_review_result, run_id)
  if execution_failed(steps) {
    return steps
  }
  let validation_analysis = prepared_release_analysis(analyze_release(cfg), analysis)
  let validation = run_release_generated_content_checks(cfg, validation_analysis, steps, run_id)
  steps = validation.steps
  if !validation.success {
    return steps
  }
  let post_prepare_analysis = prepared_release_analysis(analyze_release(cfg), analysis)
  let version = post_prepare_analysis.next_version
  let branch = "release/v${version}"
  let base_arg = require_shell_arg(cfg.base, "--base")
  let push_command = release_branch_push_command(cfg, branch, false)
  var commands = []
  var committed_release_content = false
  if trim(post_prepare_analysis.status ?? "") == ""
    && trim(post_prepare_analysis.diff_names ?? "") != ""
    && post_prepare_analysis.branch == branch {
    committed_release_content = true
    steps = steps
      + [
      recorded_step(
        "commit-already-complete",
        "release branch already has v${version} commit content",
        ok(
          "skipped commit because the working tree is clean and ${branch} already differs from pin ${cfg.pin_sha}",
        ),
      ),
    ]
  } else {
    commands = commands + [{name: "stage-tracked-release-content", command: "git add -u"}]
    commands = commands + [{name: "commit", command: "git commit -m \"Release v${version}\""}]
  }
  // No `git rebase` here — pinning the release branch's parent is the
  // whole point of `cfg.pin_sha`. Rebasing onto origin/<base> would fold
  // commits that landed on main after this run started into the release.
  // We still fetch tags so the upcoming tag step sees existing remote tags.
  commands = commands
    + [
    {name: "fetch-base", command: "git fetch origin --tags " + base_arg},
    {name: "push", command: push_command},
  ]
  for step in commands {
    release_log_event(run_id, "step_started", {step: step.name, command: step.command})
    let result = append_command_step(cfg, steps, step.name, step.command)
    steps = result.steps
    release_log_event(
      run_id,
      "step_finished",
      {step: step.name, success: result.success, status: result.status},
    )
    if !result.success {
      let failed_step = steps[len(steps) - 1]
      if step.name == "push" {
        steps = maybe_recovery_advice_step(cfg, post_prepare_analysis, steps, failed_step, run_id)
        if push_hook_budget_exceeded(failed_step.command, failed_step) {
          let retry_command = release_branch_push_command(cfg, branch, true)
          let push_retry = append_command_step(cfg, steps, "push-no-verify-after-green-hook-budget", retry_command)
          steps = push_retry.steps
          if push_retry.success {
            continue
          }
        }
      } else {
        steps = maybe_recovery_advice_step(cfg, post_prepare_analysis, steps, failed_step, run_id)
        let retry_commands = retry_commands_after_agent_repair(step)
        if len(retry_commands) > 0 {
          let repair_retry = run_retry_commands_after_agent_repair(cfg, steps, retry_commands, run_id)
          steps = repair_retry.steps
          if repair_retry.success {
            continue
          }
        }
      }
      return steps
    }
  }
  // Push vX.Y.Z to origin BEFORE creating the PR. publish-release.yml
  // fires on this tag push and ships crates.io + the GitHub release
  // from the pinned commit; the PR that follows is paperwork (lands the
  // Cargo.toml/CHANGELOG bump on main) and doesn't influence what was
  // shipped. If the tag push fails, abort early so we don't open a PR
  // for a release that hasn't been published.
  steps = ensure_release_tag_pushed(cfg, version, steps, run_id)
  if execution_failed(steps) {
    return steps
  }
  let body_path = write_pr_body(run_id, post_prepare_analysis, agent_review_result, steps)
  let existing_pr_command = "gh pr list --base " + base_arg
    + " --head ${branch} --state open --json url --jq '.[0].url // \"\"'"
  release_log_event(run_id, "step_started", {step: "find-existing-pr", command: existing_pr_command})
  let existing_pr = append_github_command_step(cfg, steps, "find-existing-pr", existing_pr_command)
  steps = existing_pr.steps
  release_log_event(
    run_id,
    "step_finished",
    {step: "find-existing-pr", success: existing_pr.success, status: existing_pr.status},
  )
  if !existing_pr.success {
    return steps
  }
  var pr_url = trim(existing_pr.stdout)
  if pr_url == "" {
    let body_arg = safe_shell_arg(body_path)
    if body_arg == nil {
      steps = steps
        + [
        recorded_step(
          "create-pr",
          "gh pr create --base <base> --head ${branch} --title \"Release v${version}\" --body-file <path>",
          fail(2, "failed to quote PR body path"),
        ),
      ]
      return steps
    }
    let create_command = "gh pr create --base " + base_arg
      + " --head ${branch} --title \"Release v${version}\" --body-file "
      + body_arg
    release_log_event(run_id, "step_started", {step: "create-pr", command: create_command})
    let created = append_github_command_step(cfg, steps, "create-pr", create_command)
    steps = created.steps
    release_log_event(
      run_id,
      "step_finished",
      {step: "create-pr", success: created.success, status: created.status},
    )
    if !created.success {
      return steps
    }
    pr_url = trim(created.stdout)
  } else {
    let body_arg = safe_shell_arg(body_path)
    if body_arg == nil {
      steps = steps
        + [
        recorded_step(
          "refresh-existing-pr-body",
          "gh pr edit <pr-url> --body-file <path>",
          fail(2, "failed to quote PR body path"),
        ),
      ]
      return steps
    }
    let pr_edit_arg = require_shell_arg(pr_url, "PR URL")
    let edit_command = "gh pr edit " + pr_edit_arg + " --title \"Release v${version}\" --body-file "
      + body_arg
    release_log_event(run_id, "step_started", {step: "refresh-existing-pr-body", command: edit_command})
    let edited = append_github_command_step(cfg, steps, "refresh-existing-pr-body", edit_command)
    steps = edited.steps
    release_log_event(
      run_id,
      "step_finished",
      {step: "refresh-existing-pr-body", success: edited.success, status: edited.status},
    )
    if !edited.success {
      return steps
    }
  }
  let merge_handoff = append_pr_auto_merge_steps(cfg, steps, pr_url, run_id)
  steps = merge_handoff.steps
  if !merge_handoff.success {
    return steps
  }
  let pr_arg = merge_handoff.pr_arg
  let final_body_path = write_pr_body(run_id, post_prepare_analysis, agent_review_result, steps)
  let final_body_arg = safe_shell_arg(final_body_path)
  if final_body_arg == nil {
    steps = steps
      + [
      recorded_step(
        "refresh-pr-body-final",
        "gh pr edit <pr-url> --body-file <path>",
        fail(2, "failed to quote final PR body path"),
      ),
    ]
    return steps
  }
  let final_edit_command = "gh pr edit " + pr_arg + " --title \"Release v${version}\" --body-file "
    + final_body_arg
  release_log_event(
    run_id,
    "step_started",
    {step: "refresh-pr-body-final", command: final_edit_command},
  )
  let final_edit = append_github_command_step(cfg, steps, "refresh-pr-body-final", final_edit_command)
  steps = final_edit.steps
  release_log_event(
    run_id,
    "step_finished",
    {step: "refresh-pr-body-final", success: final_edit.success, status: final_edit.status},
  )
  return steps
}

fn add_recovery_for_last_failure(cfg, analysis, steps, run_id) {
  let failed = last_failed_step(steps)
  if failed == nil {
    return steps
  }
  let recovered = maybe_recovery_advice_step(cfg, analysis, steps, failed, run_id)
  if cfg.agent && failed.name == "prepare" {
    return retry_prepare_after_agent_repair(cfg, recovered, failed, run_id)
  }
  return recovered
}

fn restore_release_checkout_to_base(cfg, execution, run_id) {
  if cfg.mock || cfg.mode != "ship-pr" || execution_failed(execution) {
    return nil
  }
  release_log_event(run_id, "checkout_cleanup_started", {repo: cfg.repo, base: cfg.base})
  let runner = if cfg.mock {
    { command -> run_cmd(cfg, command) }
  } else {
    nil
  }
  let cleanup = checkout_cleanup(runner, cfg.base, cfg.repo)
  release_log_event(
    run_id,
    "checkout_cleanup_finished",
    {
      repo: cfg.repo,
      base: cfg.base,
      success: cleanup.success,
      skipped: cleanup.skipped,
      branch: cleanup.branch,
      detail: cleanup.detail,
    },
  )
  return cleanup
}

fn write_report(run_id, payload) {
  let out_dir = path_join(cwd(), RUN_ROOT, run_id)
  mkdir(out_dir, true)
  let body = json_stringify(payload)
  let json_path = path_join(out_dir, "release-audit.json")
  write_file(json_path, body + "\n")
  let md_payload = {...payload, audit_sha: sha3_256(body)[0:16]}
  let md = render("@prompts/release_report.harn.prompt", md_payload)
  let md_path = path_join(out_dir, "release-audit.md")
  write_file(md_path, md)
  return {json_path: json_path, md_path: md_path}
}

pipeline main() {
  let raw_cfg = parse_args(argv)
  if raw_cfg.help {
    println(usage())
    return 0
  }
  let cfg = {...raw_cfg, pin_sha: resolve_pin_sha(raw_cfg)}
  let run_id = uuid_v7()
  let started_iso = date_now_iso()
  let started_ms = now_ms()
  let repo_label = if cfg.mock {
    "(mock)"
  } else {
    cfg.repo
  }
  let run_events = release_log_event(
    run_id,
    "run_started",
    {
      repo: repo_label,
      mode: cfg.mode,
      bump: cfg.bump,
      agent: cfg.agent,
      mock: cfg.mock,
      pin_sha: cfg.pin_sha,
      pin_sha_input: cfg.pin_sha_input,
    },
  )
  println("== harn release harness ${run_id}")
  println("   repo : ${repo_label}")
  println("   mode : ${cfg.mode}")
  println("   bump : ${cfg.bump}")
  println("   pin  : ${cfg.pin_sha}")
  println("   events: ${run_events}")
  println("   tail : tail -f ${run_events}")
  normalize_release_analysis_checkout(cfg, run_id)
  release_log_event(run_id, "analysis_started", {})
  let analysis = analyze_release(cfg)
  release_log_event(
    run_id,
    "analysis_finished",
    {
      current_version: analysis.current_version,
      next_version: analysis.next_version,
      branch: analysis.branch,
      changelog_top: analysis.changelog_top,
      dirty_files: analysis.dirty_files,
      deterministic_findings: analysis.deterministic_findings,
    },
  )
  println("   current -> next : ${analysis.current_version} -> ${analysis.next_version}")
  println("   changelog top   : v${analysis.changelog_top}")
  println("   dirty files     : ${analysis.dirty_files}")
  let effective_cfg = with_derived_release_options(cfg, analysis)
  if effective_cfg.bootstrap_new_crates ?? false && !(cfg.bootstrap_new_crates ?? false) {
    println("   bootstrap new crates: auto-enabled from release delta")
    release_log_event(run_id, "option_derived", {bootstrap_new_crates: true})
  }
  var agent_review_result = {
    text: "(agent review skipped; pass --agent to enable local-model review)",
    attempts: [],
    validation_findings: [],
    draft_changelog: nil,
    artifacts: {},
  }
  if cfg.agent {
    let model_label = if cfg.mock {
      "mock provider"
    } else {
      cfg.model
    }
    println("== agent review with ${model_label} ...")
    release_log_event(
      run_id,
      "agent_started",
      {model: model_label, llm_transcript_dir: agent_artifact_paths(run_id).llm_transcript_dir},
    )
    agent_review_result = agent_review(effective_cfg, analysis, run_id)
    release_log_event(
      run_id,
      "agent_finished",
      {
        draft_changelog: agent_review_result.draft_changelog,
        artifacts: agent_review_result.artifacts,
        validation_findings: agent_review_result.validation_findings,
      },
    )
  }
  let agent_text = agent_review_result.text
  var execution = nil
  if cfg.agent && cfg.mode != "audit" && len(agent_review_result.validation_findings) > 0 {
    execution = [
      recorded_step(
        "agent-review-validation",
        "validate local-model release audit before live release side effects",
        fail(2, "agent review failed validation:\n" + agent_review_result.validation_findings.join("\n")),
      ),
    ]
  } else if live_release_notes_blocker(cfg, analysis) != nil {
    execution = [live_release_notes_blocker(cfg, analysis)]
  } else if cfg.mode == "prepare" {
    println("== running prepare ...")
    release_log_event(run_id, "mode_execution_started", {mode: "prepare"})
    execution = execute_prepare(effective_cfg, analysis, agent_review_result, run_id)
  } else if cfg.mode == "ship-pr" {
    println("== running prepare + PR handoff ...")
    release_log_event(run_id, "mode_execution_started", {mode: "ship-pr"})
    execution = execute_ship_pr(effective_cfg, analysis, agent_review_result, run_id)
  }
  let cleanup = restore_release_checkout_to_base(effective_cfg, execution, run_id)
  if cleanup != nil {
    println("== checkout cleanup")
    println("   ${cleanup.detail}")
  }
  let payload = {
    run_id: run_id,
    started_iso: started_iso,
    finished_iso: date_now_iso(),
    duration_ms: now_ms() - started_ms,
    operator: username(),
    host: hostname(),
    config: effective_cfg,
    analysis: analysis,
    agent_review: agent_text,
    agent_review_detail: agent_review_result,
    execution: execution,
    cleanup: cleanup,
  }
  let written = write_report(run_id, payload)
  let fixture = write_crystallization_fixture(run_id, payload, written)
  release_log_event(
    run_id,
    "run_finished",
    {
      success: !execution_failed(execution),
      report_json: written.json_path,
      report_md: written.md_path,
      fixture_dir: fixture.out_dir,
    },
  )
  println("== report written")
  println("   json: ${written.json_path}")
  println("   md  : ${written.md_path}")
  println("== crystallization fixture written")
  println("   dir : ${fixture.out_dir}")
  if len(analysis.deterministic_findings) > 0 {
    println("== findings")
    for f in analysis.deterministic_findings {
      println("   - ${f}")
    }
  }
  if execution_failed(execution) {
    return 1
  }
  return 0
}
