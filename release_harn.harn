#!/usr/bin/env harn
//
// release_harn.harn — Harn-native harness for the human-owned `/release-harn`
// workflow in ~/projects/harn.
//
// Defaults to audit-only. Live mutation requires --yes-live-release.
// Use --mock to exercise the end-to-end flow without touching the real repo.
let DEFAULT_REPO = path_join(env_or("HOME", ""), "projects/harn")

let DEFAULT_MODEL = env_or("HARN_RELEASE_MODEL", "local:gemma4:26b")

let RUN_ROOT = ".harn-runs/release-harn"

let ALLOWED_RELEASE_RUN_COMMANDS = [
  "git status",
  "git diff",
  "git log",
  "git show",
  "git branch",
  "git rev-parse",
  "git describe",
  "git tag",
  "gh pr list",
  "gh pr view",
  "gh pr checks",
  "gh run list",
  "gh run view",
  "gh workflow list",
  "gh workflow view",
  "gh release list",
  "gh release view",
  "rg",
  "sed -n",
  "cat",
  "ls",
  "test",
]

fn usage() {
  return """
Usage:
  harn run release_harn.harn
  harn run release_harn.harn -- --agent
  harn run release_harn.harn -- --mock --agent --mode ship-pr
  harn run release_harn.harn -- --repo ~/projects/harn --mode prepare --yes-live-release

Modes:
  audit     Inspect release readiness and write an audit report. Default.
  prepare   Run ./scripts/release_ship.sh --prepare --bump <type>.
  ship-pr   Prepare, commit, rebase, push, open Release vX.Y.Z PR, and enable auto-merge.

Flags:
  --repo PATH             Harn repo path. Defaults to ~/projects/harn.
  --bump patch|minor|major  Version bump type. Defaults to patch.
  --mode audit|prepare|ship-pr
  --agent                 Ask a local model to review the release evidence with read/search/run tools.
  --model MODEL           Local model id for --agent. Defaults to HARN_RELEASE_MODEL or local:gemma4:26b.
  --mock                  Use fake command/file tools for a v0.7.52 -> v0.7.53 release rehearsal.
  --skip-audit            Pass through to release_ship.sh --prepare.
  --skip-dry-run          Pass through to release_ship.sh --prepare.
  --yes-live-release      Required for live prepare/ship-pr modes.
"""
}

fn parse_args(args) {
  var cfg = {
    repo: DEFAULT_REPO,
    bump: "patch",
    mode: "audit",
    agent: false,
    model: DEFAULT_MODEL,
    mock: false,
    help: false,
    skip_audit: false,
    skip_dry_run: false,
    yes_live_release: false,
  }
  var i = 0
  while i < len(args) {
    let a = args[i]
    if a == "--repo" {
      i = i + 1
      if i >= len(args) {
        throw "--repo requires a path"
      }
      cfg = {...cfg, repo: expand_home(args[i])}
    } else if a == "--bump" {
      i = i + 1
      if i >= len(args) {
        throw "--bump requires patch, minor, or major"
      }
      cfg = {...cfg, bump: args[i]}
    } else if a == "--mode" {
      i = i + 1
      if i >= len(args) {
        throw "--mode requires audit, prepare, or ship-pr"
      }
      cfg = {...cfg, mode: args[i]}
    } else if a == "--agent" {
      cfg = {...cfg, agent: true}
    } else if a == "--model" {
      i = i + 1
      if i >= len(args) {
        throw "--model requires a model id"
      }
      cfg = {...cfg, model: args[i]}
    } else if a == "--mock" {
      cfg = {...cfg, mock: true}
    } else if a == "--skip-audit" {
      cfg = {...cfg, skip_audit: true}
    } else if a == "--skip-dry-run" {
      cfg = {...cfg, skip_dry_run: true}
    } else if a == "--yes-live-release" {
      cfg = {...cfg, yes_live_release: true}
    } else if a == "-h" || a == "--help" {
      cfg = {...cfg, help: true}
      return cfg
    } else {
      throw "unknown arg: ${a}"
    }
    i = i + 1
  }
  if !(cfg.bump == "patch" || cfg.bump == "minor" || cfg.bump == "major") {
    throw "--bump must be patch, minor, or major"
  }
  if !(cfg.mode == "audit" || cfg.mode == "prepare" || cfg.mode == "ship-pr") {
    throw "--mode must be audit, prepare, or ship-pr"
  }
  return cfg
}

fn expand_home(path) {
  if path == "~" {
    return env_or("HOME", "")
  }
  if starts_with(path, "~/") {
    return env_or("HOME", "") + path[1:len(path)]
  }
  return path
}

fn ok(stdout) {
  return {success: true, status: 0, stdout: stdout, stderr: ""}
}

fn fail(status, stderr) {
  return {success: false, status: status, stdout: "", stderr: stderr}
}

fn run_cmd(cfg, command) {
  if cfg.mock {
    return fake_command(command)
  }
  return shell_at(cfg.repo, command)
}

fn read_repo_file(cfg, path) {
  if cfg.mock {
    return fake_file(path)
  }
  let full = path_join(cfg.repo, path)
  if !file_exists(full) {
    return ""
  }
  return read_file(full)
}

fn fake_file(path) {
  if path == "CHANGELOG.md" {
    return """
# Changelog

## v0.7.53

- Added merge-queue-safe release orchestration that ships from one release PR.
- Tightened release metadata verification and changelog drift checks.
- Documented the harn-release-bot workflow cascade.

## v0.7.52

- Previous release baseline.
"""
  }
  if path == "Cargo.toml" {
    return """
[workspace.package]
version = "0.7.52"
"""
  }
  if path == "README.md" {
    return "# Harn\n\nAgent harness language.\n"
  }
  return ""
}

fn fake_command(command) {
  if contains(command, "git branch --show-current") {
    return ok("release/v0.7.53\n")
  }
  if contains(command, "git status --porcelain") {
    return ok(" M CHANGELOG.md\n M README.md\n M scripts/release_ship.sh\n")
  }
  if contains(command, "git diff --stat") {
    return ok(
      " CHANGELOG.md             | 12 ++++++++++++\n README.md                |  4 ++++\n scripts/release_ship.sh  |  8 ++++++++\n 3 files changed, 24 insertions(+)\n",
    )
  }
  if contains(command, "git describe --tags") {
    return ok("v0.7.52\n")
  }
  if contains(command, "git log --oneline") {
    return ok(
      "abc1234 release: consolidate harn release PR flow\nbcd2345 ci: publish release from tag drift\ncde3456 docs: clarify local developer loop\n",
    )
  }
  if contains(command, "python3 - <<'PY_VERSION'") {
    return ok("0.7.52\n")
  }
  if contains(command, "python3 - <<'PY_CHANGELOG_TOP'") {
    return ok("0.7.53\n")
  }
  if contains(command, "python3 - <<'PY_CHANGELOG_SECTION'") {
    return ok(
      "- Added merge-queue-safe release orchestration that ships from one release PR.\n- Tightened release metadata verification and changelog drift checks.\n- Documented the harn-release-bot workflow cascade.\n",
    )
  }
  if contains(command, "test -x scripts/release_ship.sh") {
    return ok("release_ship=ok\n")
  }
  if contains(command, "test -x scripts/release_gate.sh") {
    return ok("release_gate=ok\n")
  }
  if contains(command, "test -f .github/workflows/publish-release.yml") {
    return ok("publish_workflow=ok\n")
  }
  if contains(command, "test -f .github/workflows/build-release-binaries.yml") {
    return ok("binary_workflow=ok\n")
  }
  if contains(command, "./scripts/release_ship.sh --prepare") {
    return ok(
      "=== Release audit ===\n=== Publish dry run ===\n=== Stage release content ===\nRelease content staged on release/v0.7.53:\n  Previous version: 0.7.52\n  Next version:     0.7.53\n",
    )
  }
  if contains(command, "git commit -m") {
    return ok("[release/v0.7.53 9999999] Release v0.7.53\n")
  }
  if contains(command, "git fetch origin main") || contains(command, "git rebase origin/main") {
    return ok("Current branch release/v0.7.53 is up to date.\n")
  }
  if contains(command, "git push -u origin") {
    return ok("branch 'release/v0.7.53' set up to track 'origin/release/v0.7.53'.\n")
  }
  if contains(command, "gh pr create") {
    return ok("https://github.com/burin-labs/harn/pull/999\n")
  }
  if contains(command, "gh pr merge") {
    return ok("✓ Auto-merge enabled for pull request burin-labs/harn#999\n")
  }
  if contains(command, "rg ") {
    return ok("CHANGELOG.md:3:## v0.7.53\nscripts/release_ship.sh:82:Release vX.Y.Z\n")
  }
  return fail(127, "mock has no response for command: ${command}")
}

fn checked(cfg, command) {
  let r = run_cmd(cfg, command)
  if !r.success {
    throw "command failed (${r.status}): ${command}\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

fn current_version(cfg) {
  return checked(
    cfg,
    """
python3 - <<'PY_VERSION'
from pathlib import Path
import re
text = Path("Cargo.toml").read_text()
m = re.search(r'^version = "([^"]+)"', text, re.M)
if not m:
    m = re.search(r'^version\\s*=\\s*"([^"]+)"', text, re.M)
print(m.group(1) if m else "")
PY_VERSION
""",
  )
}

fn next_version(current, bump) {
  let p = current.split(".")
  if len(p) != 3 {
    throw "current version is not semver: ${current}"
  }
  var major = to_int(p[0])
  var minor = to_int(p[1])
  var patch = to_int(p[2])
  if bump == "major" {
    major = major + 1
    minor = 0
    patch = 0
  } else if bump == "minor" {
    minor = minor + 1
    patch = 0
  } else {
    patch = patch + 1
  }
  return "${major}.${minor}.${patch}"
}

fn changelog_top(cfg) {
  return checked(
    cfg,
    """
python3 - <<'PY_CHANGELOG_TOP'
from pathlib import Path
import re
text = Path("CHANGELOG.md").read_text() if Path("CHANGELOG.md").exists() else ""
for line in text.splitlines():
    m = re.match(r"^## v([0-9]+[.][0-9]+[.][0-9]+)$", line.strip())
    if m:
        print(m.group(1))
        break
PY_CHANGELOG_TOP
""",
  )
}

fn changelog_section(cfg) {
  return checked(
    cfg,
    """
python3 - <<'PY_CHANGELOG_SECTION'
from pathlib import Path
import re
text = Path("CHANGELOG.md").read_text() if Path("CHANGELOG.md").exists() else ""
capture = False
out = []
for line in text.splitlines():
    if re.match(r"^## v[0-9]+[.][0-9]+[.][0-9]+$", line.strip()):
        if capture:
            break
        capture = True
        continue
    if capture:
        out.append(line)
print("\\n".join(out).strip())
PY_CHANGELOG_SECTION
""",
  )
}

fn count_lines(text) {
  let t = trim(text)
  if t == "" {
    return 0
  }
  return len(t.split("\n"))
}

fn probe_ok(cfg, command) {
  let r = run_cmd(cfg, command)
  return r.success
}

fn contains_shell_metachar(command) {
  return contains(command, "\n") || contains(command, ";") || contains(command, "&&")
    || contains(command, "||")
    || contains(command, "|")
    || contains(command, ">")
    || contains(command, "<")
    || contains(command, "`")
    || contains(command, "$")
}

fn safe_shell_arg(value) {
  if contains(value, "'") || contains(value, "\n") {
    return nil
  }
  return "'" + value + "'"
}

fn command_matches_prefix(command, prefix) {
  return command == prefix || starts_with(command, prefix + " ")
}

fn allowed_read_command(command) {
  for prefix in ALLOWED_RELEASE_RUN_COMMANDS {
    if command_matches_prefix(command, prefix) {
      return true
    }
  }
  return false
}

fn allowed_command_message() {
  return "blocked: release_run only allows these read-oriented command prefixes: "
    + ALLOWED_RELEASE_RUN_COMMANDS.join(", ")
}

fn analyze_release(cfg) {
  let current = current_version(cfg)
  let next = next_version(current, cfg.bump)
  let branch = checked(cfg, "git branch --show-current")
  let status = checked(cfg, "git status --porcelain --untracked-files=normal")
  let diff_stat = checked(cfg, "git diff --stat")
  let latest_tag = checked(cfg, "git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true")
  let since_ref = if latest_tag == "" {
    "--max-count=30"
  } else {
    "${latest_tag}..HEAD --max-count=30"
  }
  let commits = checked(cfg, "git log --oneline --decorate --no-merges ${since_ref}")
  let top = changelog_top(cfg)
  let section = changelog_section(cfg)
  let scripts = {
    release_ship: probe_ok(cfg, "test -x scripts/release_ship.sh && echo release_ship=ok"),
    release_gate: probe_ok(cfg, "test -x scripts/release_gate.sh && echo release_gate=ok"),
  }
  let workflows = {
    publish_release: probe_ok(cfg, "test -f .github/workflows/publish-release.yml && echo publish_workflow=ok"),
    build_release_binaries: probe_ok(cfg, "test -f .github/workflows/build-release-binaries.yml && echo binary_workflow=ok"),
  }
  let expected_branch = "release/v${next}"
  var findings = []
  if trim(status) == "" {
    findings = findings + ["working tree has no candidate release content"]
  }
  if top != next {
    findings = findings + ["CHANGELOG.md top entry is v${top}; expected v${next} for --bump ${cfg.bump}"]
  }
  if cfg.mode != "audit" && branch == "main" {
    findings = findings + ["live release preparation must run from ${expected_branch}, not main"]
  }
  if cfg.mode != "audit" && branch != expected_branch {
    findings = findings + ["current branch is ${branch}; conventional release branch is ${expected_branch}"]
  }
  if !scripts.release_ship || !scripts.release_gate {
    findings = findings + ["release scripts are missing or not executable"]
  }
  if !workflows.publish_release || !workflows.build_release_binaries {
    findings = findings + ["release cascade workflows are missing"]
  }
  return {
    repo: if cfg.mock {
      "(mock harn repo)"
    } else {
      cfg.repo
    },
    mode: cfg.mode,
    bump: cfg.bump,
    model: cfg.model,
    mock: cfg.mock,
    branch: branch,
    expected_branch: expected_branch,
    current_version: current,
    next_version: next,
    latest_tag: latest_tag,
    changelog_top: top,
    dirty_files: count_lines(status),
    status: status,
    diff_stat: diff_stat,
    commits_since_latest_tag: commits,
    changelog_section: section,
    release_scripts: scripts,
    workflows: workflows,
    deterministic_findings: findings,
  }
}

fn release_tools(cfg) {
  var tools = tool_registry()
  tools = tool_define(
    tools,
    "release_read",
    "Read a file from the Harn repo",
    {
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> read_repo_file(cfg, args.path) },
    },
  )
  tools = tool_define(
    tools,
    "release_search",
    "Search the Harn repo with ripgrep",
    {
      parameters: {pattern: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args ->
        let pattern = safe_shell_arg(args.pattern)
        if pattern == nil {
          return "blocked: search pattern contains unsupported shell quoting characters"
        }
        let r = run_cmd(
          cfg,
          "rg -n -- " + pattern
            + " README.md CHANGELOG.md docs/src scripts .github 2>/dev/null | head -120",
        )
        if r.success {
          r.stdout
        } else {
          r.stderr
        }
      },
    },
  )
  tools = tool_define(
    tools,
    "release_run",
    "Run a read-only release inspection command in the Harn repo",
    {
      parameters: {command: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
      handler: { args ->
        let command = args.command
        if !allowed_read_command(command) {
          return allowed_command_message()
        }
        if contains_shell_metachar(command) {
          return "blocked: release_run rejects shell metacharacters"
        }
        let r = run_cmd(cfg, command)
        return "exit=${r.status}\nstdout:\n${r.stdout}\nstderr:\n${r.stderr}"
      },
    },
  )
  return tools
}

fn agent_review(cfg, analysis) {
  if cfg.mock {
    llm_mock_clear()
    llm_mock(
      {
        text: "I will inspect the mocked release evidence.",
        tool_calls: [
          {
            id: "run_1",
            name: "release_run",
            arguments: {command: "git log --oneline v0.7.52..HEAD --max-count=30"},
          },
        ],
      },
    )
    llm_mock(
      {
        text: "- release shape matches v0.7.53 expectations\n- changelog has a matching v0.7.53 top entry\n- mocked prepare/PR path is ready\n##DONE##",
      },
    )
  }
  let system = """
You are auditing the Harn release workflow. Use only local evidence and the
provided tools. Do not recommend publishing directly. The desired flow is:
prepare one Release vX.Y.Z PR, enable auto-merge, then let GitHub Actions
publish and build binaries after the PR lands. Output concise bullets and end
with ##DONE##.
"""
  let prompt = "Release analysis JSON:\n```json\n" + json_stringify(analysis, 2)
    + "\n```\nReview readiness, risks, and the next concrete command."
  let result = agent_loop(
    prompt,
    system,
    {
      provider: if cfg.mock {
        "mock"
      } else {
        "auto"
      },
      model: cfg.model,
      tools: release_tools(cfg),
      tool_format: "native",
      persistent: true,
      max_iterations: 4,
      max_nudges: 1,
      session_id: "release-harn-"
        + if cfg.mock {
        "mock"
      } else {
        analysis.next_version
      },
    },
  )
  return trim(result.visible_text ?? result.text ?? json_stringify(result))
}

fn prepare_command(cfg) {
  var cmd = "./scripts/release_ship.sh --prepare --bump ${cfg.bump}"
  if cfg.skip_audit {
    cmd = cmd + " --skip-audit"
  }
  if cfg.skip_dry_run {
    cmd = cmd + " --skip-dry-run"
  }
  return cmd
}

fn require_live_confirmation(cfg) {
  if !cfg.mock && !cfg.yes_live_release {
    throw "live ${cfg.mode} mode requires --yes-live-release"
  }
}

fn execute_prepare(cfg) {
  require_live_confirmation(cfg)
  let cmd = prepare_command(cfg)
  let r = run_cmd(cfg, cmd)
  return {command: cmd, success: r.success, status: r.status, stdout: r.stdout, stderr: r.stderr}
}

fn execute_ship_pr(cfg, analysis, agent_text, run_id) {
  require_live_confirmation(cfg)
  var steps = []
  let prep = execute_prepare(cfg)
  steps = steps
    + [
    {
      name: "prepare",
      command: prep.command,
      success: prep.success,
      status: prep.status,
      stdout: prep.stdout,
      stderr: prep.stderr,
    },
  ]
  if !prep.success {
    return steps
  }
  let version = analysis.next_version
  let branch = "release/v${version}"
  let body_path = path_join(cwd(), RUN_ROOT, run_id, "pr-body.md")
  mkdir(dirname(body_path), true)
  write_file(
    body_path,
    "Release v${version}\n\nAgent release audit:\n\n${agent_text}\n\nGenerated by release_harn.harn.\n",
  )
  let commands = [
    {name: "commit", command: "git commit -m \"Release v${version}\""},
    {name: "fetch-main", command: "git fetch origin main"},
    {name: "rebase-main", command: "git rebase origin/main"},
    {name: "push", command: "git push -u origin ${branch}"},
    {
      name: "create-pr",
      command: "gh pr create --base main --head ${branch} --title \"Release v${version}\" --body-file ${body_path}",
    },
    {name: "auto-merge", command: "gh pr merge --auto"},
  ]
  for step in commands {
    let r = run_cmd(cfg, step.command)
    steps = steps
      + [
      {
        name: step.name,
        command: step.command,
        success: r.success,
        status: r.status,
        stdout: r.stdout,
        stderr: r.stderr,
      },
    ]
    if !r.success {
      return steps
    }
  }
  return steps
}

fn execution_failed(execution) {
  if execution == nil {
    return false
  }
  for step in execution {
    if !step.success {
      return true
    }
  }
  return false
}

fn write_report(run_id, payload) {
  let out_dir = path_join(cwd(), RUN_ROOT, run_id)
  mkdir(out_dir, true)
  let body = json_stringify(payload, 2)
  let json_path = path_join(out_dir, "release-audit.json")
  write_file(json_path, body + "\n")
  let md_payload = {...payload, audit_sha: sha3_256(body)[0:16]}
  let md = render("@prompts/release_report.harn.prompt", md_payload)
  let md_path = path_join(out_dir, "release-audit.md")
  write_file(md_path, md)
  return {json_path: json_path, md_path: md_path}
}

pipeline main() {
  let cfg = parse_args(argv)
  if cfg.help {
    println(usage())
    return 0
  }
  let run_id = uuid_v7()
  let started_iso = date_now_iso()
  let started_ms = now_ms()
  let repo_label = if cfg.mock {
    "(mock)"
  } else {
    cfg.repo
  }
  println("== harn release harness ${run_id}")
  println("   repo : ${repo_label}")
  println("   mode : ${cfg.mode}")
  println("   bump : ${cfg.bump}")
  let analysis = analyze_release(cfg)
  println("   current -> next : ${analysis.current_version} -> ${analysis.next_version}")
  println("   changelog top   : v${analysis.changelog_top}")
  println("   dirty files     : ${analysis.dirty_files}")
  var agent_text = "(agent review skipped; pass --agent to enable local-model review)"
  if cfg.agent {
    let model_label = if cfg.mock {
      "mock provider"
    } else {
      cfg.model
    }
    println("== agent review with ${model_label} ...")
    agent_text = agent_review(cfg, analysis)
  }
  var execution = nil
  if cfg.mode == "prepare" {
    println("== running prepare ...")
    let prep = execute_prepare(cfg)
    execution = [
      {
        name: "prepare",
        command: prep.command,
        success: prep.success,
        status: prep.status,
        stdout: prep.stdout,
        stderr: prep.stderr,
      },
    ]
  } else if cfg.mode == "ship-pr" {
    println("== running prepare + PR handoff ...")
    execution = execute_ship_pr(cfg, analysis, agent_text, run_id)
  }
  let payload = {
    run_id: run_id,
    started_iso: started_iso,
    finished_iso: date_now_iso(),
    duration_ms: now_ms() - started_ms,
    operator: username(),
    host: hostname(),
    config: cfg,
    analysis: analysis,
    agent_review: agent_text,
    execution: execution,
  }
  let written = write_report(run_id, payload)
  println("== report written")
  println("   json: ${written.json_path}")
  println("   md  : ${written.md_path}")
  if len(analysis.deterministic_findings) > 0 {
    println("== findings")
    for f in analysis.deterministic_findings {
      println("   - ${f}")
    }
  }
  if execution_failed(execution) {
    return 1
  }
  return 0
}
