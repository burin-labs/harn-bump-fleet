fn parsed_remote_audit_config(parsed) {
  let env_offload_raw = env_str("HARN_RELEASE_OFFLOAD_AUDIT")
  let env_offload = if env_offload_raw != nil {
    env_bool("HARN_RELEASE_OFFLOAD_AUDIT", false)
  } else {
    nil
  }
  let local_audit = parsed.local_audit || env_bool("HARN_RELEASE_LOCAL_AUDIT", false)
  let min_free_raw = if trim(parsed.offload_min_free_gb) != "" {
    parsed.offload_min_free_gb
  } else {
    env_str("HARN_RELEASE_OFFLOAD_MIN_FREE_GB") ?? ""
  }
  return {
    offload_audit: release_audit_offload_enabled(
      {
        mode: parsed.mode,
        yes_live_release: parsed.yes_live_release,
        explicit_offload: parsed.offload_audit,
        env_offload: env_offload,
        local_audit: local_audit,
      },
    ),
    local_audit: local_audit,
    require_remote_audit: parsed.require_remote_audit
      || env_bool("HARN_RELEASE_REQUIRE_REMOTE_AUDIT", false),
    offload_min_free_gb: resolve_remote_audit_min_free_gb(min_free_raw),
    offload_host: if trim(parsed.offload_host) != "" {
      parsed.offload_host
    } else {
      env_str("HARN_RELEASE_OFFLOAD_HOST") ?? ""
    },
    offload_exclude_host: if trim(parsed.offload_exclude_host) != "" {
      parsed.offload_exclude_host
    } else {
      env_str("HARN_RELEASE_OFFLOAD_EXCLUDE_HOST") ?? ""
    },
  }
}

fn parse_release_args(harness: Harness, args) {
  let parsed = parse_args(args, RELEASE_ARG_SPEC)
  if len(parsed._extras) > 0 {
    throw "unknown arg: " + parsed._extras[0]
  }
  if len(parsed._errors) > 0 {
    throw join(parsed._errors, "; ")
  }
  let bootstrap = parsed.bootstrap_new_crates || env_bool("HARN_RELEASE_BOOTSTRAP_NEW_CRATES", false)
  let release_focus = if parsed.release_focus != "" {
    parsed.release_focus
  } else {
    env_str("HARN_RELEASE_FOCUS") ?? ""
  }
  let pin_sha_input = if parsed.pin_sha_input != "" {
    parsed.pin_sha_input
  } else {
    env_str("HARN_RELEASE_PIN_SHA") ?? ""
  }
  let release_cargo_target_dir = resolve_release_cargo_target_dir(
    env_str("HARN_RELEASE_CARGO_TARGET_DIR") ?? "",
    env_str("HOME") ?? "",
    env_str("XDG_CACHE_HOME") ?? "",
  )
  let remote_audit = parsed_remote_audit_config(parsed)
  let cfg = {
    repo: expand_home(harness, parsed.repo),
    base: parsed.base,
    bump: parsed.bump,
    mode: parsed.mode,
    agent: parsed.agent,
    model: parsed.model,
    provider: parsed.provider,
    mock: parsed.mock,
    help: release_cli_help_requested(parsed),
    bootstrap_new_crates: bootstrap,
    release_cargo_target_dir: release_cargo_target_dir,
    release_focus: release_focus,
    yes_live_release: parsed.yes_live_release,
    pin_sha_input: pin_sha_input,
    pin_sha: "",
    planner_source: DEFAULT_PLANNER.source,
    planner_preflight: nil,
    fixup_mode: false,
    skip_tag: false,
    fixup_tag: "",
    fixup_pr_url: "",
    fixup_pin_unreleased: "",
    fixup_release_body_source: "",
    repin_latest: parsed.repin_latest,
    allow_base_drift: parsed.allow_base_drift,
    offload_audit: remote_audit.offload_audit,
    local_audit: remote_audit.local_audit,
    require_remote_audit: remote_audit.require_remote_audit,
    offload_min_free_gb: remote_audit.offload_min_free_gb,
    offload_host: remote_audit.offload_host,
    offload_exclude_host: remote_audit.offload_exclude_host,
    repin_mode: false,
    repin_tag: "",
    repin_pr_url: "",
    repin_initial_remote_tag_sha: "",
    no_chat: parsed.no_chat,
    chat_only: parsed.chat_only,
    chat_run: parsed.chat_run,
    chat_timeout_s: to_int(parsed.chat_timeout_s) ?? 60,
    self_update: parsed.self_update || env_bool("FLEET_SELF_UPDATE", false),
    wait_build_lock: parsed.wait_build_lock || env_bool("HARN_RELEASE_WAIT_BUILD_LOCK", false),
  }
  if cfg.help {
    return cfg
  }
  if !(cfg.bump == "patch" || cfg.bump == "minor" || cfg.bump == "major") {
    throw "--bump must be patch, minor, or major"
  }
  if !(cfg.mode == "audit" || cfg.mode == "prepare" || cfg.mode == "ship-pr") {
    throw "--mode must be audit, prepare, or ship-pr"
  }
  if cfg.repin_latest && cfg.mode != "ship-pr" {
    throw "--repin-latest requires --mode ship-pr"
  }
  if cfg.repin_latest && !cfg.yes_live_release && !cfg.mock {
    throw "--repin-latest requires --yes-live-release"
  }
  if cfg.repin_latest && trim(cfg.pin_sha_input ?? "") != "" {
    throw "--repin-latest and --at-sha are mutually exclusive: --repin-latest advances the pin to origin/<base>"
  }
  if cfg.require_remote_audit && !cfg.offload_audit {
    throw "--require-remote-audit requires remote audit offload; remove --local-audit/HARN_RELEASE_OFFLOAD_AUDIT=0 or pass --offload-audit"
  }
  return cfg
}

fn expand_home(harness: Harness, path) {
  if path == "~" {
    return harness.env.get_or("HOME", "")
  }
  if starts_with(path, "~/") {
    return harness.env.get_or("HOME", "") + path[1:len(path)]
  }
  return path
}

/**
 * Resolve `cfg.pin_sha_input` (or `origin/<base>` when no input is given)
 * to a concrete 40-char commit SHA. Frozen here so every downstream step
 * — branch creation, audit ranges, PR body, tag push — uses the same
 * commit even if `origin/<base>` advances mid-run.
 */
fn resolve_pin_sha(cfg) {
  if cfg.mock {
    if cfg.pin_sha_input != "" {
      return cfg.pin_sha_input
    }
    return MOCK_PIN_SHA
  }
  if cfg.pin_sha_input != "" {
    let raw = trim(cfg.pin_sha_input)
    let r = git_run(["rev-parse", "--verify", raw + "^{commit}"], {repo: cfg.repo})
    if !r.success {
      throw "--at-sha did not resolve to a commit: ${raw}\n${trim(r.stderr)}"
    }
    return trim(r.stdout)
  }
  // For modes that mutate (prepare/ship-pr with --yes-live-release),
  // refresh origin first so the pin reflects the latest base. Audit
  // mode stays read-only and uses whatever is already cached locally.
  if cfg.mode != "audit" || cfg.yes_live_release {
    let f = git_run(["fetch", "origin", "--prune", "--quiet"], {repo: cfg.repo})
    if !f.success {
      throw "failed to fetch origin before pinning the release SHA:\n${trim(f.stderr)}"
    }
  }
  let r = git_run(["rev-parse", "--verify", "origin/${cfg.base}^{commit}"], {repo: cfg.repo})
  if !r.success {
    throw "failed to resolve origin/${cfg.base}:\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

fn run_cmd(cfg, command) {
  if cfg.mock {
    return fake_command(command, cfg)
  }
  return shell_at(cfg.repo, command)
}

/** Build a shell-equivalent label string from an argv list. */
fn argv_label(argv) {
  return join(argv.map({ a -> to_string(a) }), " ")
}

/**
 * Run a local git command in argv form, scoped to `cfg.repo`.
 *
 * Routes through `fake_command` in mock mode so the legacy substring-keyed
 * mock fixtures continue to match; otherwise dispatches to `std/git`
 * `git_run`, which executes argv without shell quoting and strips ambient
 * GIT_* env.
 */
fn run_git(cfg, args, options = {}) {
  if cfg.mock {
    return fake_command(argv_label(["git"] + args), cfg)
  }
  return git_run(args, options + {repo: cfg.repo})
}

/** Run a local git command, throwing on failure and returning trimmed stdout. */
fn checked_git(cfg, args, options = {}) {
  let r = run_git(cfg, args, options)
  if !r.success {
    throw "git command failed (${r.status}): " + argv_label(["git"] + args) + "\n${trim(r.stderr)}"
  }
  return trim(r.stdout)
}

/** Boolean probe over a local git command. */
fn probe_git_ok(cfg, args, options = {}) {
  return run_git(cfg, args, options).success
}

fn github_slug_from_remote_url(url) {
  let cleaned = regex_replace("[.]git$", "", trim(url ?? ""))
  let matches = regex_captures("github[.]com[:/]([^/]+/[^/]+)$", cleaned)
  if len(matches) == 0 {
    return ""
  }
  return matches[0].groups[0]
}

fn gh_target_repo_arg(cfg) {
  let remote = run_git(cfg, ["remote", "get-url", "origin"])
  if !remote.success {
    return []
  }
  let slug = github_slug_from_remote_url(remote.stdout)
  if slug == "" {
    return []
  }
  return ["--repo", slug]
}

fn args_have_option(args, option) {
  for arg in args {
    if to_string(arg) == option {
      return true
    }
  }
  return false
}

/**
 * Run a `gh` command in argv form. Mock mode routes through `fake_command`
 * so existing substring fixtures keep matching; live mode shells out via
 * the connector helper (`gh_argv`) on top of `std/command`.
 */
fn run_gh(cfg, args) {
  if cfg.mock {
    return fake_command(argv_label(["gh"] + args), cfg)
  }
  if args_have_option(args, "--repo") {
    return gh_argv(args)
  }
  return gh_argv(args + gh_target_repo_arg(cfg))
}

fn read_repo_file(harness: Harness, cfg, path) {
  if cfg.mock {
    return fake_file(path)
  }
  require_release_repo_path(harness, cfg, "reading repo file " + path)
  let full = path_join(cfg.repo, path)
  if !harness.fs.exists(full) {
    return ""
  }
  return harness.fs.read_text(full)
}

fn fake_file(path) {
  if path == "CHANGELOG.md" {
    return """
# Changelog

## v0.7.53

- Added merge-queue-safe release orchestration that ships from one release PR.
- Tightened release metadata verification and changelog drift checks.
- Documented the harn-release-bot workflow cascade.

## v0.7.52

- Previous release baseline.
"""
  }
  if path == "Cargo.toml" {
    return """
[workspace.package]
version = "0.7.52"
"""
  }
  if path == "README.md" {
    return "# Harn\n\nAgent harness language.\n"
  }
  return ""
}

@complexity(allow)
fn fake_command(command, cfg, env = nil) {
  let mock_stale_local_tag = env_str("HARN_RELEASE_MOCK_STALE_LOCAL_TAG") == "1"
  // Lets the mock ship path prove signature failure halts before tag publication.
  let mock_tag_verify_fail = env_str("HARN_RELEASE_MOCK_TAG_VERIFY_FAIL") == "1"
  const tag_command = mock_release_tag_command(command, mock_tag_verify_fail)
  if tag_command != nil {
    return tag_command
  }
  if contains(command, "git branch --show-current") {
    return ok("release/v0.7.53\n")
  }
  if contains(command, "git status --porcelain") {
    return ok("")
  }
  if contains(command, "git diff") && contains(command, "--stat") {
    return ok(
      " CHANGELOG.md             | 12 ++++++++++++\n README.md                |  4 ++++\n scripts/release_ship.sh  |  8 ++++++++\n 3 files changed, 24 insertions(+)\n",
    )
  }
  if contains(command, "git diff") && contains(command, "--name-only") {
    return ok("CHANGELOG.md\nREADME.md\nscripts/release_ship.sh\n")
  }
  if contains(command, "git tag --list") && contains(command, "--sort=-v:refname") {
    return ok("v0.7.52\n")
  }
  if contains(command, "git ls-remote --tags --refs origin refs/tags/v") {
    return ok(
      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trefs/tags/v0.7.51\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\trefs/tags/v0.7.52\n",
    )
  }
  if contains(command, "git describe --tags") {
    return ok("v0.7.51\n")
  }
  if contains(command, "git log --name-status") {
    return ok(
      "commit abc1234 release: consolidate harn release PR flow\nM\tCHANGELOG.md\nM\tscripts/release_ship.sh\n\ncommit bcd2345 ci: publish release from tag drift\nM\t.github/workflows/publish-release.yml\n\ncommit cde3456 docs: clarify local developer loop\nM\tREADME.md\n",
    )
  }
  if contains(command, "git log --stat") {
    return ok(
      "abc1234 release: consolidate harn release PR flow\n CHANGELOG.md            | 12 ++++++++++++\n scripts/release_ship.sh |  8 ++++++++\n\nbcd2345 ci: publish release from tag drift\n .github/workflows/publish-release.yml | 5 +++++\n\ncde3456 docs: clarify local developer loop\n README.md | 4 ++++\n",
    )
  }
  if contains(command, "git log --oneline") {
    return ok(
      "abc1234 release: consolidate harn release PR flow\nbcd2345 ci: publish release from tag drift\ncde3456 docs: clarify local developer loop\n",
    )
  }
  if contains(command, "git log -1 --format=%G?") {
    return ok("G\n")
  }
  if contains(command, "test -x scripts/release_ship.sh") {
    return ok("release_ship=ok\n")
  }
  if contains(command, "test -x scripts/release_gate.sh") {
    return ok("release_gate=ok\n")
  }
  if contains(command, "test -f .github/workflows/publish-release.yml") {
    return ok("publish_workflow=ok\n")
  }
  if contains(command, "test -f .github/workflows/build-release-binaries.yml") {
    return ok("binary_workflow=ok\n")
  }
  if contains(command, "./scripts/release_ship.sh --prepare") {
    return ok(
      "=== Release audit ===\n=== Publish dry run ===\n=== Stage release content ===\nRelease content staged on release/v0.7.53:\n  Previous version: 0.7.52\n  Next version:     0.7.53\n",
    )
  }
  if contains(command, "git commit -m") {
    return ok("[release/v0.7.53 9999999] Release v0.7.53\n")
  }
  if contains(command, "git add -u") {
    return ok("")
  }
  if contains(command, "git fetch origin") || contains(command, "git rebase") {
    return ok("Current branch release/v0.7.53 is up to date.\n")
  }
  if contains(command, "git rev-parse HEAD") {
    return ok("9999999999999999999999999999999999999999\n")
  }
  if contains(command, "git rev-parse --verify") && contains(command, "origin/") {
    return ok(MOCK_PIN_SHA + "\n")
  }
  if contains(command, "git rev-parse -q --verify refs/tags/") {
    if mock_stale_local_tag {
      return ok("eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n")
    }
    return fail(1, "")
  }
  if contains(command, "git ls-remote origin refs/tags/v") {
    return ok("")
  }
  if contains(command, "git rev-parse --verify") {
    return ok(MOCK_PIN_SHA + "\n")
  }
  if contains(command, "git rev-list -n 1") {
    if mock_stale_local_tag {
      return ok("eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n")
    }
    return ok("9999999999999999999999999999999999999999\n")
  }
  if contains(command, "git tag -d") {
    return ok("Deleted tag 'v0.7.53' (was eeeeeee)\n")
  }
  if contains(command, "git push origin v") {
    return ok("To github.com:burin-labs/harn.git\n * [new tag]         v0.7.53 -> v0.7.53\n")
  }
  if contains(command, "git reset --hard") {
    return ok("HEAD is now at abc1234 main\n")
  }
  if contains(command, "make -s lint-md") || contains(command, "make lint-md")
    || contains(command, "npx markdownlint-cli2") {
    return ok("markdownlint-cli2 v0.22.1\nSummary: 0 error(s)\n")
  }
  if contains(command, "git push -u origin") && (env?.HARN_HOOKS_NO_LOCAL_BUILD ?? "") == "1" {
    return ok("branch 'release/v0.7.53' set up to track 'origin/release/v0.7.53'.\n")
  }
  if contains(command, "git push -u origin") {
    return fail(1, "pre-push hook: make test passed (3187/3187) but exceeded 120s wall-clock budget\n")
  }
  if contains(command, "gh pr create") {
    return ok("https://github.com/burin-labs/harn/pull/999\n")
  }
  if contains(command, "gh pr edit") {
    return ok("https://github.com/burin-labs/harn/pull/999\n")
  }
  if contains(command, "gh pr list") {
    if contains(command, "--jq") {
      return ok("\n")
    }
    if contains(command, "--state merged") {
      return ok(
        "[{\"number\":998,\"title\":\"release: consolidate harn release PR flow\",\"mergedAt\":\"2026-05-03T00:00:00Z\",\"url\":\"https://github.com/burin-labs/harn/pull/998\",\"headRefName\":\"release/v0.7.53\",\"mergeCommit\":{\"oid\":\"abc1234\"}}]\n",
      )
    }
    return ok("[]\n")
  }
  if contains(command, "gh pr view") && contains(command, "autoMergeRequest") {
    return ok("false\n")
  }
  if contains(command, "gh pr merge") {
    return ok("✓ Auto-merge enabled for pull request burin-labs/harn#999\n")
  }
  if contains(command, "rg ") {
    return ok("CHANGELOG.md:3:## v0.7.53\nscripts/release_ship.sh:82:Release vX.Y.Z\n")
  }
  return fail(127, "mock has no response for command: ${command}")
}

fn current_version(harness: Harness, cfg) {
  let text = read_repo_file(harness, cfg, "Cargo.toml")
  let matches = regex_captures("(?m)^version\\s*=\\s*\"([^\"]+)\"", text)
  if len(matches) == 0 {
    return ""
  }
  return matches[0].groups[0]
}

fn changelog_top(harness: Harness, cfg) {
  return changelog_top_from_text(read_repo_file(harness, cfg, "CHANGELOG.md"))
}

fn changelog_section(harness: Harness, cfg) {
  return changelog_latest_version_section_from_text(read_repo_file(harness, cfg, "CHANGELOG.md"))
}

fn changelog_unreleased_section(harness: Harness, cfg) {
  return changelog_named_section_from_text(read_repo_file(harness, cfg, "CHANGELOG.md"), "## Unreleased")
}

fn diff_names(cfg) {
  return checked_git(cfg, ["diff", "HEAD", "--name-only"])
}

fn release_file_changes(cfg, latest_tag) {
  return checked_git(
    cfg,
    ["log", "--name-status", "--pretty=format:commit %h %s", "--no-merges"]
      + release_log_range_args(latest_tag, cfg.pin_sha),
  )
}

fn release_commit_stats(cfg, latest_tag) {
  return checked_git(
    cfg,
    ["log", "--stat", "--oneline", "--no-renames", "--no-merges"]
      + release_log_range_args(latest_tag, cfg.pin_sha),
  )
}

fn count_lines(text) {
  let t = trim(text)
  if t == "" {
    return 0
  }
  return len(t.split("\n"))
}

fn changelog_section_for_agent(analysis) {
  if analysis.changelog_top == analysis.next_version {
    return truncate_text(analysis.changelog_section, 8000)
  }
  let unreleased = trim(analysis.changelog_unreleased_section ?? "")
  if unreleased != "" {
    return "No `v${analysis.next_version}` section exists yet. CHANGELOG.md has this non-empty `## Unreleased` section that will be promoted or replaced during prepare; preserve these existing entries and fold in only the missing post-tag release notes:\n\n"
      + truncate_text(unreleased, 10000)
  }
  return "No `v${analysis.next_version}` section exists yet. CHANGELOG.md currently starts at `v${analysis.changelog_top}`; draft the next section from the post-tag commit/file evidence instead of summarizing the old release."
}

fn first_post_tag_commit(analysis) {
  let commits = trim(analysis.commits_since_latest_tag ?? "")
  if commits == "" {
    return "(none)"
  }
  return trim(commits.split("\n")[0])
}

fn post_tag_commit_count(analysis) {
  let commits = trim(analysis.commits_since_latest_tag ?? "")
  if commits == "" {
    return 0
  }
  return len(commits.split("\n").filter({ line -> trim(line) != "" }))
}

fn pr_numbers_from_commits(commits) {
  let seen = {}
  let out = []
  for line in split(commits ?? "", "\n") {
    for m in regex_captures("\\(#([0-9]+)\\)", line) {
      let number = m.groups[0]
      if seen[number] ?? false {
        continue
      }
      seen[number] = true
      out = out + [number]
    }
  }
  return out
}

fn release_pr_details(cfg, commits) {
  let numbers = pr_numbers_from_commits(commits)
  if len(numbers) == 0 {
    return ""
  }
  if cfg.mock {
    return "PR #998\n{\"number\":998,\"title\":\"release: consolidate harn release PR flow\",\"body\":\"Mock PR body describing the one-PR release handoff, auto-merge enablement, and release workflow consolidation.\",\"files\":[\"CHANGELOG.md\",\"scripts/release_ship.sh\"]}"
  }
  let blocks = []
  for number in numbers {
    if len(blocks) >= 20 {
      break
    }
    let r = run_gh(
      cfg,
      [
        "pr",
        "view",
        number,
        "--json",
        "number,title,url,body,files",
        "--jq",
        "{number,title,url,body,files:[.files[].path]}",
      ],
    )
    if r.success && trim(r.stdout) != "" {
      blocks = blocks + ["PR #${number}\n" + truncate_text(trim(r.stdout), 5000)]
    } else {
      blocks = blocks
        + [
        "PR #${number}\nmetadata unavailable from `gh pr view`: "
          + truncate_text(trim(r.stderr ?? r.stdout ?? ""), 1000),
      ]
    }
  }
  return truncate_text(blocks.join("\n\n---\n\n"), 24000)
}

fn compact_agent_analysis(analysis) {
  return {
    repo: analysis.repo,
    mode: analysis.mode,
    bump: analysis.bump,
    branch: analysis.branch,
    expected_branch: analysis.expected_branch,
    base_branch: analysis.base_branch,
    pin_sha: analysis.pin_sha ?? "",
    current_version: analysis.current_version,
    next_version: analysis.next_version,
    operator_focus: analysis.operator_focus ?? "",
    latest_tag: analysis.latest_tag,
    changelog_top: analysis.changelog_top,
    dirty_files: analysis.dirty_files,
    diff_names: truncate_text(analysis.diff_names, 1000),
    post_tag_commit_count: post_tag_commit_count(analysis),
    latest_post_tag_commit: first_post_tag_commit(analysis),
    commits_since_latest_tag: truncate_text(analysis.commits_since_latest_tag, 8000),
    commit_stats_since_latest_tag: truncate_text(analysis.commit_stats_since_latest_tag, 12000),
    commit_file_changes_since_latest_tag: truncate_text(analysis.commit_file_changes_since_latest_tag, 12000),
    post_tag_pr_numbers: analysis.post_tag_pr_numbers ?? [],
    post_tag_pr_details: truncate_text(analysis.post_tag_pr_details ?? "", 12000),
    changelog_section: changelog_section_for_agent(analysis),
    changelog_unreleased_section: truncate_text(analysis.changelog_unreleased_section ?? "", 10000),
    release_scripts: analysis.release_scripts,
    workflows: analysis.workflows,
    deterministic_findings: analysis.deterministic_findings,
    recent_merged_prs: truncate_text(analysis.recent_merged_prs ?? "", 5000),
    suggested_read_only_inspections: [
      "git log --oneline --no-merges --max-count=80 ${analysis.latest_tag}..${analysis.pin_sha}",
      "git diff --stat --stat-count=80 ${analysis.latest_tag}..${analysis.pin_sha}",
      "git show --stat --oneline --no-renames --max-count=20 ${analysis.latest_tag}..${analysis.pin_sha}",
      "sed -n '1,120p' CHANGELOG.md",
      "sed -n '1,180p' scripts/release_ship.sh",
      "sed -n '1,180p' .github/workflows/publish-release.yml",
    ],
  }
}

/**
 * Concrete post-tag PR evidence the audit's `CHANGELOG coverage:` line must
 * cite — the deterministic validator (`lib/release_audit`) rejects a generic
 * coverage line that names neither a `#`-prefixed PR nor the PR count.
 */
fn pr_evidence_count(analysis) {
  return len(analysis.post_tag_pr_numbers ?? [])
}

fn pr_evidence_sample(analysis) {
  let prs = analysis.post_tag_pr_numbers ?? []
  if len(prs) > 0 {
    return "#${prs[0]}"
  }
  return ""
}

fn release_finalization_prompt(analysis) {
  if analysis.fixup_mode ?? false {
    return render(
      prompt_asset("release_fixup_finalization.harn.prompt"),
      {
        target_version: analysis.next_version,
        fixup_tag: analysis.fixup_tag ?? "",
        base_branch: analysis.base_branch,
        release_fact_sheet: release_fact_sheet(analysis),
      },
    )
  }
  return render(
    prompt_asset("release_finalization.harn.prompt"),
    {
      target_version: "v${analysis.next_version}",
      tag_range: "${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}",
      first_post_tag_commit: first_post_tag_commit(analysis),
      post_tag_pr_count: pr_evidence_count(analysis),
      sample_pr: pr_evidence_sample(analysis),
      release_fact_sheet: release_fact_sheet(analysis),
      changelog_draft_instructions: release_changelog_draft_prompt(analysis),
    },
  )
}

fn release_changelog_draft_prompt(analysis) {
  return render(
    prompt_asset("release_changelog_draft.harn.prompt"),
    {
      target_version: "v${analysis.next_version}",
      tag_range: "${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}",
      first_post_tag_commit: first_post_tag_commit(analysis),
    },
  )
}

fn release_fact_sheet(analysis) {
  return """
- Repo: `${analysis.repo}`.
- Mode: `${analysis.mode}`.
- Version: `${analysis.current_version}` -> `${analysis.next_version}` (${analysis.bump}).
- Pinned base SHA: `${analysis.pin_sha ?? "(unset)"}` — release branch is anchored here; commits that landed on `${analysis.base_branch}` after this run started are excluded from the release.
- Latest tag/range: `${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}`.
- Post-tag commit count: ${post_tag_commit_count(analysis)}.
- First post-tag commit: `${first_post_tag_commit(analysis)}`.
- Release-note source rule: use only commits in `${analysis.latest_tag}..${analysis.pin_sha ?? "HEAD"}`
  plus authored `## Unreleased` content. Recent merged PRs are historical
  context only when they are not in that post-tag range.
- Operator focus: ${if trim(analysis.operator_focus ?? "") == "" {
    "none"
  } else {
    analysis.operator_focus
  }}.
- Current CHANGELOG top: `${analysis.changelog_top}`.
- Deterministic findings: ${if len(analysis.deterministic_findings ?? []) == 0 {
    "none"
  } else {
    join(analysis.deterministic_findings, "; ")
  }}.

Authored CHANGELOG content to preserve or update:
${changelog_section_for_agent(analysis)}

Recent post-tag commits:
${truncate_text(analysis.commits_since_latest_tag, 8000)}

Post-tag PR descriptions and touched files:
${if trim(analysis.post_tag_pr_details ?? "") == "" {
    "(none)"
  } else {
    truncate_text(analysis.post_tag_pr_details, 12000)
  }}

Representative per-commit stats:
${truncate_text(analysis.commit_stats_since_latest_tag, 12000)}

Representative per-commit file changes:
${truncate_text(analysis.commit_file_changes_since_latest_tag, 12000)}
"""
}

fn probe_ok(cfg, command) {
  let r = run_cmd(cfg, command)
  return r.success
}

fn argv_contains_any(argv, disallowed) {
  for arg in argv {
    for flag in disallowed {
      if arg == flag || starts_with(arg, flag + "=") {
        return true
      }
    }
  }
  return false
}

fn release_run_policy(request, _args) {
  let argv = request?.argv ?? []
  if len(argv) < 2 {
    return true
  }
  if argv[0] == "git" && argv[1] == "tag" {
    if argv_contains_any(
      argv,
      ["-a", "-d", "-f", "-m", "-s", "--annotate", "--delete", "--force", "--message", "--sign"],
    ) {
      return "release_run is read-only; git tag creation, deletion, signing, and force flags are blocked"
    }
  }
  if argv[0] == "git" && argv[1] == "branch" {
    if argv_contains_any(argv, ["-c", "-C", "-d", "-D", "-m", "-M", "--copy", "--delete", "--move"]) {
      return "release_run is read-only; git branch mutation flags are blocked"
    }
  }
  if argv[0] == "gh" {
    if argv_contains_any(argv, ["--web"]) {
      return "release_run is non-interactive; gh --web is blocked"
    }
  }
  return true
}

fn mock_argv_command(args) {
  if type_of(args?.argv) == "list" && len(args.argv) > 0 {
    return args.argv.join(" ")
  }
  return args?.command ?? ""
}

fn mock_release_tools(harness: Harness, cfg, run_id) {
  let tools = tool_registry()
  tools = tool_define(
    tools,
    "release_read",
    "Read a file from the mocked Harn repo.",
    {
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> truncate_text(read_repo_file(harness, cfg, args.path), 12000) },
    },
  )
  tools = tool_define(
    tools,
    "release_search",
    "Search the mocked Harn repo.",
    {
      parameters: {pattern: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "search", side_effect_level: "read_only"},
      handler: { args ->
        let pattern = safe_shell_arg(args.pattern)
        if pattern == nil {
          return "blocked: search pattern contains unsupported shell quoting characters"
        }
        let r = run_cmd(cfg, "rg -n -- " + pattern + " README.md CHANGELOG.md docs/src scripts .github")
        if r.success {
          r.stdout
        } else {
          r.stderr
        }
      },
    },
  )
  tools = tool_define(
    tools,
    "release_run",
    "Run one read-only mocked release inspection command. Prefer argv arrays, for example {argv: [\"git\", \"log\", \"--oneline\", \"vX.Y.Z..HEAD\", \"--max-count=40\"]}.",
    {
      parameters: {
        argv: {type: "array", items: {type: "string"}, required: false},
        command: {type: "string", required: false},
      },
      returns: {type: "string"},
      annotations: {kind: "execute", side_effect_level: "process_exec"},
      handler: { args ->
        let command = mock_argv_command(args)
        let r = run_cmd(cfg, command)
        return truncate_text("exit=${r.status}\nstdout:\n${r.stdout}\nstderr:\n${r.stderr}", 20000)
      },
    },
  )
  return add_release_artifact_tools(harness, tools, run_id)
}

fn add_release_artifact_tools(harness: Harness, tools, run_id) {
  let out = tools
  out = tool_define(
    out,
    "release_artifact_tail",
    "Read the last 12000 characters from a release-run artifact or live log. Pass a path from the failure context, such as `live-logs/prepare.log`.",
    {
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> read_artifact_window(harness, run_id, args.path, 12000, false) },
    },
  )
  out = tool_define(
    out,
    "release_artifact_head",
    "Read the first 12000 characters from a release-run artifact or live log. Pass a path from the failure context, such as `live-logs/prepare.log`.",
    {
      parameters: {path: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> read_artifact_window(harness, run_id, args.path, 12000, true) },
    },
  )
  out = tool_define(
    out,
    "release_artifact_search",
    "Search a release-run artifact or live log with ripgrep and return matching lines. Use this before reading a large log.",
    {
      parameters: {path: {type: "string"}, pattern: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "read", side_effect_level: "read_only"},
      handler: { args -> search_artifact(harness, run_id, args.path, args.pattern) },
    },
  )
  return out
}

fn release_repair_relative_path(path) {
  let raw = trim(path ?? "")
  if raw == "" {
    throw "release repair path must be non-empty"
  }
  let normalized = raw.replace("\\", "/")
  if starts_with(normalized, "/") || contains(normalized, "..") {
    throw "release repair path must be repo-relative and must not contain '..'"
  }
  return normalized
}

fn require_release_repair_file(harness: Harness, cfg, path) {
  let rel = release_repair_relative_path(path)
  let status = run_git(cfg, ["status", "--porcelain", "--untracked-files=no", "--", rel])
  if !status.success || trim(status.stdout) == "" {
    throw "release repair edits are limited to tracked files already modified by the generated release diff: ${rel}"
  }
  let full = path_join(cfg.repo, rel)
  if !harness.fs.exists(full) {
    throw "release repair file does not exist: ${rel}"
  }
  return {rel: rel, full: full}
}

fn release_replace_file(harness: Harness, cfg, args) {
  let path = require_release_repair_file(harness, cfg, args.path)
  let old_text = args.old_text ?? ""
  let new_text = args.new_text ?? ""
  if old_text == "" {
    throw "release_replace_file requires non-empty old_text"
  }
  let before = harness.fs.read_text(path.full)
  let pieces = before.split(old_text)
  let count = len(pieces) - 1
  if count == 0 {
    throw "old_text was not found in " + path.rel
  }
  let expected = args?.expected_replacements ?? nil
  if expected != nil && count != expected {
    throw "expected ${expected} replacement(s) in ${path.rel}, found ${count}"
  }
  harness.fs.write_text(path.full, before.replace(old_text, new_text))
  return "replaced ${count} occurrence(s) in ${path.rel}"
}

fn release_write_file(harness: Harness, cfg, args) {
  let path = require_release_repair_file(harness, cfg, args.path)
  let content = args.content ?? ""
  harness.fs.write_text(path.full, content)
  return "wrote ${len(content)} bytes to ${path.rel}"
}

fn add_release_repair_tools(harness: Harness, tools, cfg) {
  let out = tools
  out = tool_define(
    out,
    "release_replace_file",
    "Replace exact text in a tracked file already modified by the generated release diff. Use this for small release-note, lint, or generated-content repairs.",
    {
      parameters: {
        path: {type: "string"},
        old_text: {type: "string"},
        new_text: {type: "string"},
        expected_replacements: {type: "integer", required: false},
      },
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "filesystem_write"},
      handler: { args -> release_replace_file(harness, cfg, args) },
    },
  )
  out = tool_define(
    out,
    "release_write_file",
    "Overwrite a tracked file already modified by the generated release diff. Prefer release_replace_file for small edits.",
    {
      parameters: {path: {type: "string"}, content: {type: "string"}},
      returns: {type: "string"},
      annotations: {kind: "edit", side_effect_level: "filesystem_write"},
      handler: { args -> release_write_file(harness, cfg, args) },
    },
  )
  return out
}

fn release_host_tools(harness: Harness, cfg, run_id) {
  require_release_repo_path(harness, cfg, "release agent tool setup")
  let tools = agent_host_tools(
    nil,
    {
      root: cfg.repo,
      cwd: cfg.repo,
      max_inline_bytes: 12000,
      read_bytes: 12000,
      tail_bytes: 12000,
      search_max_matches: 120,
      exclude_globs: [".git/**", ".harn-runs/**", "target/**"],
      allow_argv_prefixes: RELEASE_RUN_ARGV_PREFIXES,
      command_policy: release_run_policy,
      names: {
        read_file: "release_read",
        read_file_tail: "release_read_tail",
        search_files: "release_search",
        git_inspect: "release_git",
        run_command: "release_run",
        read_command_output: "release_run_output",
        read_command_output_tail: "release_run_tail",
      },
      descriptions: {
        read_file: "Read a UTF-8 file under the Harn repo by repo-relative path. Prefer bounded reads with limit_bytes; the harness caps returned content.",
        search_files: "Search Harn repo contents. Provide a pattern; use path/glob only to narrow the search.",
        git_inspect: "Inspect git status, diff, log, show, blame, branches, or remotes without mutating the repo.",
        run_command: "Run one bounded read-only release inspection command from the Harn repo. Pass argv as an array of strings; shell command strings are not accepted. Inline output is capped, and large output can be read with release_run_output or release_run_tail using the returned command_id.",
      },
      result_formatter: release_host_tool_formatter,
      annotations: {run_command: {workflow_phase: "release_audit"}},
      output_format: "json",
    },
  )
  return add_release_artifact_tools(harness, tools, run_id)
}

fn release_tools(harness: Harness, cfg, run_id) {
  if cfg.mock {
    return mock_release_tools(harness, cfg, run_id)
  }
  return release_host_tools(harness, cfg, run_id)
}

fn release_repair_tools(harness: Harness, cfg, run_id) {
  return add_release_repair_tools(harness, release_tools(harness, cfg, run_id), cfg)
}

fn release_review_post_turn(payload, analysis) {
  let successful = payload?.session_successful_tools ?? payload?.successful_tool_names ?? []
  let has_delta_command = successful.contains("release_run") || successful.contains("release_git")
  let has_content_evidence = successful.contains("release_read") || successful.contains("release_search")
    || successful.contains("release_git")
    || successful.contains("release_run_output")
    || successful.contains("release_run_tail")
  if has_delta_command && (has_content_evidence || analysis.mock) {
    let final_tools = tool_registry()
    return {
      message: release_finalization_prompt(analysis),
      next_options: {
        tools: final_tools,
        tool_choice: "none",
        max_tokens: 8000,
        loop_until_done: false,
        max_iterations: 1,
        max_nudges: 0,
        iteration_budget: {mode: "fixed", initial: 1, max: 1, extend_by: 0},
        post_turn_callback: nil,
      },
    }
  }
  // Sized for a comprehensive `## Unreleased` rewrite (20+ bullets,
  // detail-heavy prose). Earlier 2200 cap truncated drafts mid-sentence
  // on releases with substantial post-tag content.
  if has_delta_command && !has_content_evidence {
    return {
      message: "Before finalizing, inspect at least one concrete content source with release_read, release_search, release_git, release_run_output, or release_run_tail. Prefer PR bodies, touched docs, or representative diffs over commit titles.",
    }
  }
  return nil
}

fn release_host_tool_formatter(value, _key) {
  if type_of(value) != "dict" {
    return json_stringify(value)
  }
  let out = value
  if type_of(out?.content) == "string" {
    out = out
      + {content: truncate_text(out.content, 12000), content_truncated_by_harness: len(out.content) > 12000}
  }
  if type_of(out?.stdout) == "string" {
    out = out
      + {stdout: truncate_text(out.stdout, 12000), stdout_truncated_by_harness: len(out.stdout) > 12000}
  }
  if type_of(out?.stderr) == "string" {
    out = out
      + {stderr: truncate_text(out.stderr, 4000), stderr_truncated_by_harness: len(out.stderr) > 4000}
  }
  return json_stringify(out)
}

fn validate_agent_attempt(_cfg, analysis, result, text) {
  let fixup_mode = analysis.fixup_mode ?? false
  let findings = if fixup_mode {
    validate_release_fixup_audit_with_context(
      analysis.next_version,
      result,
      text,
      {fixup_tag: analysis.fixup_tag ?? ""},
    )
  } else {
    validate_release_agent_audit_with_context(
      analysis.next_version,
      result,
      text,
      {
        first_post_tag_commit: first_post_tag_commit(analysis),
        post_tag_pr_numbers: analysis.post_tag_pr_numbers ?? [],
      },
    )
  }
  let successful = result?.tools?.successful ?? []
  let audit_shape_ok = if fixup_mode {
    starts_with(trim(text), "Audit:")
  } else {
    starts_with(trim(text), "Audit:") && raw_agent_changelog_section(text) != ""
  }
  if len(successful) > 0 && audit_shape_ok {
    let filtered = []
    for finding in findings {
      if starts_with(finding, "agent_loop ended with status `budget_exhausted`") {
        continue
      }
      filtered = filtered + [finding]
    }
    findings = filtered
  }
  if len(successful) > 0 {
    let has_delta = successful.contains("release_run") || successful.contains("release_git")
    let has_content = successful.contains("release_read") || successful.contains("release_search")
      || successful.contains("release_git")
      || successful.contains("release_run_output")
      || successful.contains("release_run_tail")
    if !has_delta {
      findings = findings
        + ["agent did not successfully inspect the release delta with release_run or release_git"]
    }
    if !has_content && !analysis.mock {
      findings = findings
        + [
        if fixup_mode {
          "agent did not successfully inspect concrete CHANGELOG/PR/diff evidence before confirming the fixup fold"
        } else {
          "agent did not successfully inspect concrete PR, file, or diff evidence before drafting"
        },
      ]
    }
  }
  return findings
}

fn agent_repair_prompt(validation_findings, _prior_text, analysis) {
  if analysis.fixup_mode ?? false {
    return render(
      prompt_asset("release_fixup_repair_prompt.harn.prompt"),
      {
        validation_findings: validation_findings.join("\n"),
        release_fact_sheet: release_fact_sheet(analysis),
        target_version: analysis.next_version,
        fixup_tag: analysis.fixup_tag ?? "",
      },
    )
  }
  return render(
    prompt_asset("release_repair_prompt.harn.prompt"),
    {
      validation_findings: validation_findings.join("\n"),
      release_fact_sheet: release_fact_sheet(analysis),
      target_version: "v${analysis.next_version}",
      first_post_tag_commit: first_post_tag_commit(analysis),
      post_tag_pr_count: pr_evidence_count(analysis),
      sample_pr: pr_evidence_sample(analysis),
      changelog_draft_instructions: release_changelog_draft_prompt(analysis),
    },
  )
}

fn agent_repair_system() {
  return render(prompt_asset("release_repair_system.harn.prompt"), {})
}

/**
 * Pick the system prompt, user prompt, tool-evidence flag, and session suffix
 * for the Nth release-review attempt. Attempt 1 is the tool-driven initial
 * audit (`system`/`prompt`, tool evidence required, no suffix); every later
 * attempt is a findings-driven repair pass that re-prompts with
 * `agent_repair_prompt` off the prior attempt's findings and text
 * (`ctx.prior_findings` / `ctx.prior_text`) under the repair system prompt.
 * This is the per-attempt branch the `workflow_run_repair` executor runs; it is
 * `pub` so the release-review loop test can prove the repair prompt threads the
 * prior findings.
 */
pub fn agent_review_attempt_selection(ctx, analysis, base_system, base_prompt) {
  if ctx.attempt <= 1 {
    return {system: base_system, prompt: base_prompt, require_tool_evidence: true, session_suffix: ""}
  }
  return {
    system: agent_repair_system(),
    prompt: agent_repair_prompt(ctx.prior_findings, ctx.prior_text, analysis),
    require_tool_evidence: false,
    session_suffix: "-repair-" + to_string(ctx.attempt - 1),
  }
}

fn persist_agent_changelog(harness: Harness, run_id, text, next_version) {
  let section = agent_changelog_section(text, next_version)
  if section == "" {
    return nil
  }
  let paths = agent_artifact_paths(run_id)
  harness.fs.mkdir(paths.out_dir, true)
  harness.fs.write_text(paths.draft_changelog_md, section + "\n")
  return paths.draft_changelog_md
}

fn release_session_id(harness: Harness, cfg, analysis, run_id) {
  let session_override = harness.env.get_or("HARN_RELEASE_SESSION_ID", "")
  if trim(session_override) != "" {
    return session_override
  }
  return "release-harn-"
    + if cfg.mock {
    "mock"
  } else {
    analysis.next_version
  }
    + "-"
    + run_id
}

fn latest_release_tag(cfg) {
  let remote = run_git(cfg, ["ls-remote", "--tags", "--refs", "origin", "refs/tags/v*"])
  if !remote.success {
    throw "could not list origin release tags; refusing to derive release history from local-only tags:\n"
      + trim(remote.stderr ?? "")
  }
  return latest_semver_tag_from_remote_refs(remote.stdout)
}

fn agent_artifact_paths(run_id) {
  let out_dir = release_run_dir(run_id)
  return {
    out_dir: out_dir,
    raw_result_json: path_join(out_dir, "agent-result.json"),
    trace_json: path_join(out_dir, "agent-trace.json"),
    transcript_context_json: path_join(out_dir, "agent-transcript-context.json"),
    llm_transcript_dir: path_join(out_dir, "agent-llm"),
    llm_transcript_jsonl: path_join(out_dir, "agent-llm/llm_transcript.jsonl"),
    draft_changelog_md: path_join(out_dir, "agent-draft-changelog.md"),
  }
}

fn analyze_release(harness: Harness, cfg) {
  let branch = checked_git(cfg, ["branch", "--show-current"])
  let current = current_version(harness, cfg)
  let status = checked_git(cfg, ["status", "--porcelain", "--untracked-files=normal"])
  let latest_tag = latest_release_tag(cfg)
  let top = changelog_top(harness, cfg)
  let branch_version = version_from_release_branch(branch)
  let prepared_release = branch_version != "" && branch_version == current && top == current
    && version_from_tag(latest_tag) != current
  let next = if prepared_release {
    current
  } else {
    next_semver(current, cfg.bump)
  }
  let baseline = if prepared_release {
    version_from_tag(latest_tag)
  } else {
    current
  }
  let expected_branch = "release/v${next}"
  let committed_release_content = prepared_release && trim(status) == "" && branch == expected_branch
  let diff_stat = if committed_release_content {
    checked_git(cfg, ["diff", "--stat", "${cfg.pin_sha}..HEAD"])
  } else {
    checked_git(cfg, ["diff", "HEAD", "--stat"])
  }
  let diff_name_list = if committed_release_content {
    checked_git(cfg, ["diff", "--name-only", "${cfg.pin_sha}..HEAD"])
  } else {
    diff_names(cfg)
  }
  let commits = checked_git(
    cfg,
    ["log", "--oneline", "--no-merges"] + release_log_range_args(latest_tag, cfg.pin_sha),
  )
  let commit_file_changes = release_file_changes(cfg, latest_tag)
  let commit_stats = release_commit_stats(cfg, latest_tag)
  let post_tag_pr_numbers = pr_numbers_from_commits(commits)
  let post_tag_pr_details = release_pr_details(cfg, commits)
  let section = changelog_section(harness, cfg)
  let unreleased_section = changelog_unreleased_section(harness, cfg)
  let recent_merged_prs = trim(
    run_gh(
      cfg,
      [
        "pr",
        "list",
        "--state",
        "merged",
        "--base",
        cfg.base,
        "--limit",
        "30",
        "--json",
        "number,title,mergedAt,url,headRefName,mergeCommit",
      ],
    ).stdout,
  )
  let scripts = {
    release_ship: probe_ok(cfg, "test -x scripts/release_ship.sh && echo release_ship=ok"),
    release_gate: probe_ok(cfg, "test -x scripts/release_gate.sh && echo release_gate=ok"),
  }
  let workflows = {
    publish_release: probe_ok(cfg, "test -f .github/workflows/publish-release.yml && echo publish_workflow=ok"),
    build_release_binaries: probe_ok(cfg, "test -f .github/workflows/build-release-binaries.yml && echo binary_workflow=ok"),
  }
  let findings = []
  if trim(status) == "" && trim(diff_name_list) == "" {
    findings = findings + ["working tree has no candidate release content"]
  }
  if top != next {
    findings = findings + ["CHANGELOG.md top entry is v${top}; expected v${next} for --bump ${cfg.bump}"]
  }
  if cfg.mode != "audit" && branch == cfg.base {
    findings = findings
      + ["release branch setup will move from ${cfg.base} to ${expected_branch} before preparing"]
  }
  if cfg.mode != "audit" && branch != expected_branch {
    findings = findings + ["current branch is ${branch}; branch setup will target ${expected_branch}"]
  }
  if !scripts.release_ship || !scripts.release_gate {
    findings = findings + ["release scripts are missing or not executable"]
  }
  if !workflows.publish_release || !workflows.build_release_binaries {
    findings = findings + ["release cascade workflows are missing"]
  }
  return {
    repo: if cfg.mock {
      "(mock harn repo)"
    } else {
      cfg.repo
    },
    mode: cfg.mode,
    bump: cfg.bump,
    model: cfg.model,
    provider: cfg.provider,
    mock: cfg.mock,
    operator_focus: cfg.release_focus,
    branch: branch,
    expected_branch: expected_branch,
    base_branch: cfg.base,
    pin_sha: cfg.pin_sha,
    pin_sha_input: cfg.pin_sha_input ?? "",
    fixup_mode: cfg.fixup_mode ?? false,
    fixup_tag: cfg.fixup_tag ?? "",
    fixup_pr_url: cfg.fixup_pr_url ?? "",
    current_version: baseline,
    next_version: next,
    prepared_release: prepared_release,
    latest_tag: latest_tag,
    changelog_top: top,
    dirty_files: count_lines(status),
    status: status,
    diff_stat: diff_stat,
    diff_names: diff_name_list,
    commits_since_latest_tag: commits,
    commit_file_changes_since_latest_tag: commit_file_changes,
    commit_stats_since_latest_tag: commit_stats,
    post_tag_pr_numbers: post_tag_pr_numbers,
    post_tag_pr_details: post_tag_pr_details,
    recent_merged_prs: recent_merged_prs,
    changelog_section: section,
    changelog_unreleased_section: unreleased_section,
    release_scripts: scripts,
    workflows: workflows,
    deterministic_findings: findings,
  }
}

fn artifact_path_for_tool(run_id, path) {
  let p = trim(path ?? "")
  if p == "" || contains(p, "..") {
    return nil
  }
  let root = run_output_dir(run_id)
  if starts_with(p, root + "/") {
    return p
  }
  let rel_prefix = ".harn-runs/release-harn/" + run_id + "/"
  if starts_with(p, rel_prefix) {
    return path_join(cwd(), p)
  }
  if starts_with(p, "/") {
    if contains(p, "/harn-command-") {
      return p
    }
    return nil
  }
  return path_join(root, p)
}

fn read_artifact_window(harness: Harness, run_id, path, max_chars, from_start) {
  let resolved = artifact_path_for_tool(run_id, path)
  if resolved == nil {
    return "blocked: artifact path must be inside this release run directory"
  }
  if !harness.fs.exists(resolved) {
    return "missing artifact: ${resolved}"
  }
  let limit = max_chars ?? 12000
  let read = try {
    if from_start ?? false {
      command_output_range({path: resolved}, {offset: 0, length: limit})
    } else {
      command_output_tail({path: resolved}, {length: limit})
    }
  } catch (_e) {
    nil
  }
  if read != nil {
    let shown = if read.total_bytes <= limit {
      "full"
    } else if from_start ?? false {
      "first ${limit} bytes"
    } else {
      "last ${limit} bytes"
    }
    return "path: ${resolved}\nsize: ${read.total_bytes}\nshown: ${shown}\n\n" + read.content
  }
  let text = harness.fs.read_text(resolved)
  if len(text) <= limit {
    return "path: ${resolved}\nsize: ${stat(resolved).size}\nshown: full\n\n" + text
  }
  if from_start ?? false {
    return "path: ${resolved}\nsize: ${stat(resolved).size}\nshown: first ${limit} chars\n\n"
      + text[0:limit]
      + "\n\n... output continues; use release_artifact_search or read from the end ..."
  }
  return "path: ${resolved}\nsize: ${stat(resolved).size}\nshown: last ${limit} chars\n\n"
    + text[len(text) - limit:len(text)]
}

fn search_artifact(harness: Harness, run_id, path, pattern) {
  let resolved = artifact_path_for_tool(run_id, path)
  if resolved == nil {
    return "blocked: artifact path must be inside this release run directory"
  }
  if !harness.fs.exists(resolved) {
    return "missing artifact: ${resolved}"
  }
  let pattern_arg = safe_shell_arg(pattern)
  let path_arg = safe_shell_arg(resolved)
  if pattern_arg == nil || path_arg == nil {
    return "blocked: unsupported shell quoting characters in artifact search"
  }
  let r = shell("rg -n -- " + pattern_arg + " " + path_arg + " | head -120")
  if r.success && trim(r.stdout) != "" {
    return r.stdout
  }
  let out = trim(r.stdout + "\n" + r.stderr)
  if out == "" {
    return "(no matches)"
  }
  return out
}

fn run_release_agent_loop(
  harness: Harness,
  cfg,
  analysis,
  system,
  prompt,
  run_id,
  require_tool_evidence,
  session_suffix,
  audit_tools,
) {
  let paths = agent_artifact_paths(run_id)
  let role = if require_tool_evidence {
    "audit"
  } else {
    "summary"
  }
  let raw_tools = if require_tool_evidence {
    audit_tools
  } else {
    tool_registry()
  }
  // Compose the natural-language tool binder (no-op when the binder is
  // disabled or no tools are registered) so the planner's tool calls get
  // canonicalized via Cerebras GPT-OSS-120B by default. The summary-style
  // call (`tool_choice: "none"`) makes no tool calls; install_binder is
  // still safe because the binder layer only fires when tools have
  // schemas and `_nl_intent` arrives in the call.
  let binder = install_binder_after_preflight(raw_tools, cfg.planner_preflight)
  let compaction_policy = if require_tool_evidence {
    release_compaction_policy("audit")
  } else {
    release_compaction_policy("validation_repair")
  }
  let projection_policy = if require_tool_evidence {
    tool_repair_projection_policy()
  } else {
    summary_projection_policy(4)
  }
  let options = agent_preset(
    role,
    {
      ...release_agent_infra_defaults(cfg, MOCK_AGENT_MODEL),
      max_tokens: if require_tool_evidence {
        2048
      } else {
        8000
      },
      tools: binder.tools,
      tool_caller: binder.tool_caller,
      iteration_budget: if require_tool_evidence {
        {mode: "adaptive", initial: 4, max: 8, extend_by: 2}
      } else {
        {mode: "fixed", initial: 1, max: 1, extend_by: 0}
      },
      turn_policy: {allow_done_sentinel: false, max_prose_chars: 30000},
      post_turn_callback: if require_tool_evidence {
        { payload -> release_review_post_turn(payload, analysis) }
      } else {
        nil
      },
      compaction: {strategy: "hybrid", keep_last_n: 8, policy: compaction_policy},
      transcript_projection: projection_policy,
      session_id: release_session_id(harness, cfg, analysis, run_id) + session_suffix,
      llm_transcript_dir: paths.llm_transcript_dir,
    },
  )
  // Single-turn finalize budget. Sized for a comprehensive
  // `## Unreleased` rewrite (20+ bullets); earlier 2200 cap
  // truncated drafts mid-sentence on substantial releases.
  if !require_tool_evidence {
    options = {...options, tool_choice: "none"}
  }
  return agent_loop(prompt, system, options)
}

fn persist_agent_artifacts(harness: Harness, run_id, result, attempts, validation_findings) {
  let paths = agent_artifact_paths(run_id)
  harness.fs.mkdir(paths.out_dir, true)
  harness.fs
    .write_text(
    paths.raw_result_json,
    json_stringify({attempts: attempts, final_result: result}) + "\n",
  )
  harness.fs.write_text(paths.trace_json, json_stringify(result.trace ?? {}) + "\n")
  let transcript_context = agent_transcript_context_metadata(result)
  harness.fs.write_text(paths.transcript_context_json, json_stringify(transcript_context) + "\n")
  return {
    raw_result_json: paths.raw_result_json,
    trace_json: paths.trace_json,
    transcript_context_json: paths.transcript_context_json,
    llm_transcript_jsonl: paths.llm_transcript_jsonl,
    draft_changelog_md: paths.draft_changelog_md,
    transcript_context: transcript_context,
    validation_findings: validation_findings,
  }
}

fn recovery_artifact_paths(run_id, step_name) {
  let safe_step = regex_replace_all("[^A-Za-z0-9_.-]+", "-", step_name)
  let out_dir = path_join(release_run_dir(run_id), "recovery")
  return {
    out_dir: out_dir,
    raw_result_json: path_join(out_dir, safe_step + "-agent-result.json"),
    trace_json: path_join(out_dir, safe_step + "-agent-trace.json"),
    transcript_context_json: path_join(out_dir, safe_step + "-transcript-context.json"),
    advice_md: path_join(out_dir, safe_step + "-advice.md"),
    llm_transcript_dir: path_join(out_dir, safe_step + "-llm"),
    llm_transcript_jsonl: path_join(out_dir, safe_step + "-llm/llm_transcript.jsonl"),
  }
}

fn recovery_session_id(harness: Harness, cfg, analysis, run_id, step_name) {
  return release_session_id(harness, cfg, analysis, run_id) + "-recovery-" + step_name
}

fn unique_markdownlint_paths(violations) {
  let seen = {}
  let out = []
  for violation in violations ?? [] {
    let path = violation.path ?? ""
    if path == "" || (seen[path] ?? false) {
      continue
    }
    seen[path] = true
    out = out + [path]
  }
  return out
}

fn markdownlint_files_for_context(harness: Harness, cfg, paths) {
  let files = {}
  for path in paths ?? [] {
    let text = read_repo_file(harness, cfg, path)
    if text != "" {
      files[path] = text
    }
  }
  return files
}

fn candidate_diff_for_paths(cfg, paths) {
  let pathlist = paths ?? []
  if len(pathlist) == 0 {
    return ""
  }
  let r = run_git(cfg, ["diff", "--"] + pathlist)
  if !r.success {
    return ""
  }
  return truncate_text(r.stdout, 12000)
}

fn includes_changelog_path(paths) {
  for path in paths ?? [] {
    if path == "CHANGELOG.md" || ends_with(path, "/CHANGELOG.md") {
      return true
    }
  }
  return false
}

fn changelog_lint_excerpt(harness: Harness, cfg, analysis, paths) {
  if !includes_changelog_path(paths) {
    return ""
  }
  let text = read_repo_file(harness, cfg, "CHANGELOG.md")
  if text == "" {
    return ""
  }
  let section = changelog_latest_version_section_from_text(text)
  if trim(section) == "" {
    return ""
  }
  return "Current top CHANGELOG section for v${analysis.next_version}:\n"
    + truncate_text(section, 8000)
}

fn markdownlint_recovery_context(harness: Harness, cfg, analysis, log_text) {
  let violations = markdownlint_violations_from_text(log_text)
  if len(violations) == 0 {
    return nil
  }
  let paths = unique_markdownlint_paths(violations)
  let files = markdownlint_files_for_context(harness, cfg, paths)
  return {
    classification: "generated_markdown_lint_failed",
    violations: violations,
    source_context: markdownlint_source_context(violations, files, 2),
    candidate_diff: candidate_diff_for_paths(cfg, paths),
    changelog_excerpt: changelog_lint_excerpt(harness, cfg, analysis, paths),
    preferred_edit_tool: "release_replace_file",
    fallback_edit_tool: "release_write_file",
    edit_guidance: "Prefer release_replace_file for narrow prose wrapping and line-length fixes; use release_write_file only when exact replacement cannot safely express the repair.",
    bounded_verification: ["make -s lint-md"],
    repeated_read_guidance: "Use source_context, candidate_diff, and changelog_excerpt before calling release_read. If more release_read calls are necessary, state the concrete missing fact.",
  }
}

fn live_log_failure_context(harness: Harness, cfg, analysis, step) {
  let log_path = step?.output_path ?? step?.live_log ?? ""
  if log_path == "" {
    return nil
  }
  let tail_read = try {
    command_output_tail(step, {length: 12000})
  } catch (_e) {
    nil
  }
  let tail = if tail_read != nil {
    tail_read.content
  } else if harness.fs.exists(log_path) {
    let text = harness.fs.read_text(log_path)
    let limit = 12000
    if len(text) > limit {
      text[len(text) - limit:len(text)]
    } else {
      text
    }
  } else {
    step?.tail ?? step?.stderr ?? ""
  }
  let pattern_arg = safe_shell_arg("fail|failed|error|ERROR|Summary:|MD[0-9]+")
  let path_arg = safe_shell_arg(log_path)
  let matches = if harness.fs.exists(log_path) && pattern_arg != nil && path_arg != nil {
    trim(shell("rg -n -- " + pattern_arg + " " + path_arg + " | tail -80").stdout)
  } else {
    ""
  }
  let matched_log_text = trim(matches + "\n" + tail)
  return {
    path: log_path,
    command_id: step?.command_id ?? "",
    matches: matches,
    tail: tail,
    markdownlint: markdownlint_recovery_context(harness, cfg, analysis, matched_log_text),
  }
}

fn recovery_failure_class(failed_step, live_context) {
  if live_context?.markdownlint != nil {
    return "generated_markdown_lint_failed"
  }
  return failed_step.classification ?? ""
}

/**
 * Pre-warm the Ollama model before kicking the recovery agent off. The
 * release pipeline keeps the model loaded during the up-front agent review
 * but `prepare` can run for 5-15 minutes, by which point Ollama's default
 * `keep_alive` (30m on the wire, but pressured by macOS memory reclaim
 * during heavy cargo builds) has typically dropped the runner. The first
 * recovery turn would then sit silently behind a generic
 * `[INFO] [llm] warming up Ollama model …` line for 10-30s while the
 * model paged back in. Doing the warmup here means the wait happens with
 * a step prefix the operator can place in context, and refreshing
 * `keep_alive` keeps the runner pinned through the rest of the recovery
 * loop. Non-blocking: a warmup error never aborts the recovery — the
 * agent_loop call still runs and will surface a real failure if Ollama
 * is genuinely broken.
 */
fn warm_local_model_for_recovery(harness: Harness, cfg) {
  if cfg.mock ?? false {
    return
  }
  let provider = if cfg.provider == "auto" {
    "ollama"
  } else {
    cfg.provider
  }
  if provider != "ollama" {
    return
  }
  let model = trim(cfg.model ?? "")
  if model == "" {
    return
  }
  harness.stdio.println("   → warming local model ${model} (long prepare may have cooled it)")
  let warm = timed(
    "release.agent_warmup",
    {provider: "ollama", model: model},
    { -> return try {
      llm_healthcheck("ollama", {model: model, warm: true, keep_alive: "30m"})
    } catch (e) {
      {valid: false, status: "error", message: "${e}"}
    } },
  )
  let result = warm.result
  let elapsed_s = (warm.timing.duration_ms + 500) / 1000
  if result?.valid ?? false {
    harness.stdio.println("   ✓ warmed ${model} in ${elapsed_s}s")
  } else {
    let status = result?.status ?? "error"
    let message = result?.message ?? "unknown"
    harness.stdio
      .println(
      "   ⚠ model warmup non-blocking failure (${status}): ${message} — continuing into recovery anyway",
    )
  }
}

fn run_recovery_agent_loop(harness: Harness, cfg, analysis, prompt, run_id, step_name) {
  let paths = recovery_artifact_paths(run_id, step_name)
  let system = render(prompt_asset("release_recovery_system.harn.prompt"), {})
  warm_local_model_for_recovery(harness, cfg)
  let binder = install_binder_after_preflight(release_repair_tools(harness, cfg, run_id), cfg.planner_preflight)
  let options = agent_preset(
    "repair",
    {
      ...release_agent_infra_defaults(cfg, MOCK_AGENT_MODEL),
      tools: binder.tools,
      tool_caller: binder.tool_caller,
      max_nudges: 1,
      iteration_budget: {mode: "adaptive", initial: 4, max: 10, extend_by: 2},
      turn_policy: {allow_done_sentinel: false, max_prose_chars: 9000},
      compaction: {strategy: "hybrid", keep_last_n: 6, policy: release_compaction_policy("recovery")},
      transcript_projection: tool_repair_projection_policy(),
      session_id: recovery_session_id(harness, cfg, analysis, run_id, step_name),
      llm_transcript_dir: paths.llm_transcript_dir,
    },
  )
  return agent_loop(prompt, system, options)
}

fn recovery_agent_advice(harness: Harness, cfg, analysis, steps, failed_step, run_id) {
  if cfg.mock {
    llm_mock_clear()
    llm_mock(
      {
        text: "I will inspect the mocked push failure before recommending recovery.",
        tool_calls: [
          {
            id: "recovery_run_1",
            name: "release_run",
            arguments: {argv: ["git", "status", "--porcelain", "--untracked-files=normal"]},
          },
        ],
      },
    )
    llm_mock(
      {
        text: "- The failed push is classified as a green-test pre-push hook budget timeout.\n- The release commit and branch can be reused.\n- Retry the normal push with `HARN_HOOKS_NO_LOCAL_BUILD=1` and keep both attempts in the run artifacts.",
      },
    )
  }
  let live_context = live_log_failure_context(harness, cfg, analysis, failed_step)
  let classification = recovery_failure_class(failed_step, live_context)
  let prompt = render(
    prompt_asset("release_recovery_prompt.harn.prompt"),
    {
      failure_context_json: json_stringify(
        {
          analysis: analysis,
          failed_step: recovery_step_ref(failed_step),
          live_log_excerpt: live_context,
          execution_so_far: recovery_step_refs(steps),
          classification: classification,
          recovery_hint: failed_step.recovery_hint ?? "",
        },
      ),
    },
  )
  let result = run_recovery_agent_loop(harness, cfg, analysis, prompt, run_id, failed_step.name)
  let text = agent_result_text(result)
  let paths = recovery_artifact_paths(run_id, failed_step.name)
  harness.fs.mkdir(paths.out_dir, true)
  harness.fs.write_text(paths.raw_result_json, json_stringify(result) + "\n")
  harness.fs.write_text(paths.trace_json, json_stringify(result.trace ?? {}) + "\n")
  let transcript_context = agent_transcript_context_metadata(result)
  harness.fs.write_text(paths.transcript_context_json, json_stringify(transcript_context) + "\n")
  harness.fs.write_text(paths.advice_md, text + "\n")
  return {
    text: text,
    artifacts: {
      raw_result_json: paths.raw_result_json,
      trace_json: paths.trace_json,
      transcript_context_json: paths.transcript_context_json,
      advice_md: paths.advice_md,
      llm_transcript_jsonl: paths.llm_transcript_jsonl,
      transcript_context: transcript_context,
    },
    llm: result.llm ?? {},
    tools: result.tools ?? {},
    status: result.status ?? "",
  }
}

fn maybe_recovery_advice_step(harness: Harness, cfg, analysis, steps, failed_step, run_id) {
  if !cfg.agent {
    return steps
  }
  // The recovery agent can sit for tens of seconds while the model re-warms
  // and the first turn lands. Print a step header up front so the operator
  // sees harness progress instead of a silent terminal after the failure.
  harness.stdio.println("   → recovery diagnosis (agent_loop on failed step `${failed_step.name}`)")
  let advice = recovery_agent_advice(harness, cfg, analysis, steps, failed_step, run_id)
  let r = ok(advice.text)
  let step = recorded_step(
    "agent-recovery-advice-${failed_step.name}",
    "agent_loop recovery diagnosis for failed ${failed_step.name}",
    r,
  )
  return steps
    + [
    {
      ...step,
      artifacts: advice.artifacts,
      agent_status: advice.status,
      llm: advice.llm,
      tools: advice.tools,
    },
  ]
}

fn retry_commands_after_agent_repair(step) {
  if step.name == "commit" {
    let commit_retry = if starts_with(step.command, "git commit -m ") {
      {command: step.command, env: hook_light_env()}
    } else {
      step.command
    }
    return [
      {name: "stage-after-agent-repair-commit", command: "git add -u"},
      {name: "commit-after-agent-repair", command: commit_retry},
    ]
  }
  return []
}

fn logged_command_step(harness: Harness, cfg, steps, name, command, run_id, extra_fn = nil) {
  log_step_started(harness, run_id, name, command)
  let result = append_command_step(harness, cfg, steps, name, command)
  let extra = if extra_fn == nil {
    nil
  } else {
    extra_fn(result)
  }
  log_step_finished(harness, run_id, name, result, extra)
  return result
}

fn logged_github_command_step(harness: Harness, cfg, steps, name, command, run_id) {
  log_step_started(harness, run_id, name, command)
  let result = append_github_command_step(harness, cfg, steps, name, command)
  log_step_finished(harness, run_id, name, result, nil)
  return result
}

fn logged_live_shell_command_step(harness: Harness, cfg, steps, name, command, run_id) {
  let live_log = command_live_log_path(run_id, name)
  harness.fs.mkdir(dirname(live_log), true)
  log_step_started(
    harness,
    run_id,
    name,
    command,
    {live_log: live_log, tail_hint: "tail -f " + live_log},
  )
  let result = append_command_step(harness, cfg, steps, name, command, {live_log_path: live_log})
  log_step_finished(harness, run_id, name, result, {live_log: live_log})
  return result
}

fn run_retry_commands_after_agent_repair(harness: Harness, cfg, steps, retry_commands, run_id) {
  let out = steps
  for retry_step in retry_commands {
    let result = logged_command_step(harness, cfg, out, retry_step.name, retry_step.command, run_id)
    out = result.steps
    if !result.success {
      return {steps: out, success: false}
    }
  }
  return {steps: out, success: true}
}

fn retry_prepare_after_agent_repair(harness: Harness, cfg, steps, failed_step, run_id) {
  let cmd = failed_step.command ?? ""
  let result = logged_live_shell_command_step(harness, cfg, steps, "prepare-after-agent-repair", cmd, run_id)
  return result.steps
}

fn release_repair_fingerprint(cfg) {
  let diff = run_git(cfg, ["diff", "--binary", "--no-ext-diff", "HEAD"])
  if !diff.success {
    return ""
  }
  return sha256(diff.stdout)
}

pub fn prepare_repair_changed(before_fingerprint: string, after_fingerprint: string) -> bool {
  return before_fingerprint != "" && after_fingerprint != "" && before_fingerprint != after_fingerprint
}

fn release_generated_content_checks(_cfg, _analysis) {
  return [{name: "release-markdown-lint", command: "make -s lint-md"}]
}

fn run_release_generated_content_checks(harness: Harness, cfg, analysis, steps, run_id) {
  let out = steps
  for check in release_generated_content_checks(cfg, analysis) {
    let result = logged_command_step(harness, cfg, out, check.name, check.command, run_id)
    out = result.steps
    if result.success {
      continue
    }
    let failed_step = out[len(out) - 1]
    out = maybe_recovery_advice_step(harness, cfg, analysis, out, failed_step, run_id)
    if cfg.agent {
      let retry_result = logged_command_step(harness, cfg, out, check.name + "-after-agent-repair", check.command, run_id)
      out = retry_result.steps
      if retry_result.success {
        continue
      }
    }
    return {steps: out, success: false}
  }
  return {steps: out, success: true}
}

fn agent_review(harness: Harness, cfg, analysis, run_id) {
  if cfg.mock {
    llm_mock_clear()
    llm_mock(
      {
        text: "I will inspect the mocked release evidence.",
        tool_calls: [
          {
            id: "run_1",
            name: "release_run",
            arguments: {argv: ["git", "log", "--oneline", "v0.7.52..HEAD", "--max-count=30"]},
          },
          {id: "read_1", name: "release_read", arguments: {path: "CHANGELOG.md"}},
        ],
      },
    )
    let mock_final = {
      text: "Audit:\n- Version/readiness: v0.7.53 matches the mocked release analysis.\n- CHANGELOG coverage: the draft keeps the prepared v0.7.53 release note focused on the mocked one-PR handoff.\n- First post-tag commit: abc1234 release: consolidate harn release PR flow.\n- Release risks: no mocked blocking risks after the read-only evidence pass.\n- Next command: harn run --no-sandbox release_harn.harn -- --mode ship-pr --agent --yes-live-release.\n\nBEGIN_DRAFT_CHANGELOG\n## v0.7.53\n\n### Changed\n\n- **Consolidated release flow.** Exercises the mocked one-PR release path and auto-merge handoff.\nEND_DRAFT_CHANGELOG",
    }
    llm_mock(mock_final)
    llm_mock(mock_final)
    llm_mock(mock_final)
    llm_mock(mock_final)
  }
  let fixup_mode = analysis.fixup_mode ?? false
  let system = if fixup_mode {
    render(
      prompt_asset("release_fixup_system.harn.prompt"),
      {
        target_version: analysis.next_version,
        fixup_tag: analysis.fixup_tag ?? "",
        fixup_pr_url: analysis.fixup_pr_url ?? "",
        base_branch: analysis.base_branch,
      },
    )
  } else {
    render(prompt_asset("release_agent_system.harn.prompt"), {})
  }
  let prompt = if fixup_mode {
    render(
      prompt_asset("release_fixup_user.harn.prompt"),
      {
        analysis_json: json_stringify(compact_agent_analysis(analysis)),
        target_version: analysis.next_version,
        fixup_tag: analysis.fixup_tag ?? "",
        release_branch: analysis.expected_branch,
        base_branch: analysis.base_branch,
      },
    )
  } else {
    render(
      prompt_asset("release_agent_user.harn.prompt"),
      {analysis_json: json_stringify(compact_agent_analysis(analysis))},
    )
  }
  // Construct repo-scoped tools after the parent pipeline has validated the
  // checkout. Workflow attempt executors consume these prepared capabilities
  // instead of re-probing filesystem visibility from their child context.
  let audit_tools = release_tools(harness, cfg, run_id)
  // Run the validate->repair-with-feedback loop on harn's canonical
  // `workflow_run_repair` primitive (inline executor + retry-context feedback)
  // instead of a hand-rolled while loop. The executor owns each attempt: it
  // selects the initial vs. repair system/prompt off `ctx.attempt` (threading
  // the prior attempt's findings via `ctx.prior_findings`/`ctx.prior_text`),
  // runs the agent, validates, and returns a "failed" branch while findings
  // remain — which is what drives the primitive's retry up to 3 attempts.
  let review = agent_review_execute(
    {
      task: prompt,
      max_attempts: 3,
      run_attempt: { ctx ->
        let selection = agent_review_attempt_selection(ctx, analysis, system, prompt)
        run_release_agent_loop(
          harness,
          cfg,
          analysis,
          selection.system,
          selection.prompt,
          run_id,
          selection.require_tool_evidence,
          selection.session_suffix,
          audit_tools,
        )
      },
      validate: { attempt_result, attempt_text -> validate_agent_attempt(cfg, analysis, attempt_result, attempt_text) },
      make_record: { name, attempt_text, findings, attempt_result -> agent_attempt_record(name, attempt_text, findings, attempt_result) },
    },
  )
  let result = review.final_result
  let text = review.text
  let validation_findings = review.validation_findings
  let attempts = review.attempts
  let draft_changelog = persist_agent_changelog(harness, run_id, text, analysis.next_version)
  let artifacts = persist_agent_artifacts(harness, run_id, result, attempts, validation_findings)
  return {
    text: text,
    attempts: attempts,
    validation_findings: validation_findings,
    draft_changelog: draft_changelog,
    artifacts: artifacts,
  }
}

fn agent_attempt_record(name, text, validation_findings, result) {
  return {
    name: name,
    text: text,
    validation_findings: validation_findings,
    llm: result.llm ?? {},
    tools: result.tools ?? {},
    status: result.status ?? "",
    transcript_context: agent_transcript_context_metadata(result),
  }
}

fn prepare_command(cfg, skip_local_audit = false) {
  // Keep the bootstrap Harn used to run this harness out of the target repo's
  // release gate. release_gate.sh intentionally exports HARN_BIN to its Harn
  // audit lanes, but it must resolve that binary from the release worktree.
  //
  // Also override any inherited CARGO_TARGET_DIR. Release sessions are often
  // launched from agent shells that carry repo-specific Cargo target dirs; using
  // one of those here can block Harn package/audit steps behind unrelated builds.
  //
  // When a remote offload already proved the audit green, pass the existing
  // release_ship.sh `--skip-audit` flag so the heavy gate is not re-run locally.
  let skip = if skip_local_audit {
    " --skip-audit"
  } else {
    ""
  }
  return release_cargo_cache_prune_command(cfg.release_cargo_target_dir)
    + " && "
    + release_prepare_env(cfg.repo, cfg.bootstrap_new_crates, cfg.release_cargo_target_dir)
    + " ./scripts/release_ship.sh --prepare --bump ${cfg.bump}${skip}"
}

/**
 * Optionally offload the heavy `release_gate.sh audit` to a remote builder.
 * Returns `{steps, skip_local_audit}`. `skip_local_audit` is true ONLY when a
 * remote run was definitively green. Disabled offload, unreachable hosts,
 * preflight failures, and transport drops still fall back to another host or
 * the full local audit. A red audit after setup succeeds aborts the release
 * because the remote gate already executed the authoritative check and local
 * retry would mostly add latency or timing luck.
 */
fn resolve_audit_offload(harness: Harness, cfg, steps, run_id) {
  if !(cfg.offload_audit ?? false) || cfg.mock {
    return {steps: steps, skip_local_audit: false}
  }
  let remote_dir = env_str("HARN_RELEASE_OFFLOAD_DIR") ?? ""
  let plan = resolve_offload_host_plan(cfg.offload_host, cfg.offload_exclude_host)
  let hosts = plan.hosts
  let current_steps = steps
  let skip_target = if len(hosts) > 0 {
    "next-remote"
  } else if cfg.require_remote_audit ?? false {
    "abort"
  } else {
    "local"
  }
  for skip in plan.skipped {
    current_steps = record_remote_audit_host_skip(harness, current_steps, run_id, skip, skip_target)
  }
  for {index, value} in hosts.enumerate() {
    let host = trim(value ?? "")
    if host == "" {
      continue
    }
    let result = resolve_audit_offload_host(
      harness,
      cfg,
      current_steps,
      run_id,
      host,
      remote_dir,
      index >= len(hosts) - 1,
    )
    current_steps = result.steps
    if result.skip_local_audit ?? false {
      return {steps: current_steps, skip_local_audit: true}
    }
    if !(result.try_next_host ?? false) {
      return {steps: current_steps, skip_local_audit: false}
    }
  }
  if cfg.require_remote_audit ?? false {
    throw "all configured remote audit hosts failed; remote audit is required, aborting instead of running the local fallback"
  }
  return {steps: current_steps, skip_local_audit: false}
}

fn record_remote_audit_host_skip(harness: Harness, steps, run_id, skip, target) {
  let host = trim(skip.host ?? "")
  let reason = trim(skip.skip_reason ?? "excluded_by_config")
  let message = "${host} skipped for remote audit offload: ${reason}"
  let context = remote_audit_context({host: host, remote_dir: ""})
    + {skipped: true, skip_reason: reason}
  let recorded = {...recorded_step("remote-audit-offload", "(skipped)", ok("${message}\n")), ...context}
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {step: "remote-audit-offload", success: true, target: target, reason: message}
      + context,
  )
  return steps + [recorded]
}

fn audit_offload_fallback_action(cfg, is_last_host) {
  if !is_last_host {
    return "trying the next remote audit host"
  }
  if cfg.require_remote_audit ?? false {
    return "remote audit is required, aborting instead of running the local fallback"
  }
  return "running the full audit locally"
}

fn audit_offload_fallback_target(is_last_host) {
  if is_last_host {
    return "local"
  }
  return "next-remote"
}

fn record_remote_audit_preflight_failure(
  harness: Harness,
  cfg,
  steps,
  run_id,
  command,
  host,
  remote_dir,
  reason,
  output,
  status_fields,
  is_last_host,
) {
  let diagnostic_output = trim(output ?? "")
  let recorded_stdout = if diagnostic_output == "" {
    "${reason}\n"
  } else {
    "${reason}\n\n${diagnostic_output}\n"
  }
  let failure_context = remote_audit_context(
    {host: host, remote_dir: remote_dir, output: truncate_text(diagnostic_output, 12000)},
  )
    + (status_fields ?? {})
  let recorded = {...recorded_step("remote-audit-offload", command, ok(recorded_stdout)), ...failure_context}
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {
      step: "remote-audit-offload",
      success: !((cfg.require_remote_audit ?? false) && is_last_host),
      target: audit_offload_fallback_target(is_last_host),
      reason: reason,
    }
      + failure_context,
  )
  if (cfg.require_remote_audit ?? false) && is_last_host {
    throw recorded_stdout
  }
  return {steps: steps + [recorded], skip_local_audit: false, try_next_host: !is_last_host}
}

fn resolve_audit_offload_host(harness: Harness, cfg, steps, run_id, host, remote_dir, is_last_host) {
  let initial_remote_context = remote_audit_context({host: host, remote_dir: remote_dir})
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: "remote-audit-offload", host: host} + initial_remote_context,
  )
  let probe = run_cmd(cfg, offload_probe_command(host))
  let plan = audit_offload_decision({enabled: true, host: host, probe_ok: probe.success})
  if plan.target == "local" {
    let reason = if is_last_host {
      plan.reason
    } else {
      "${host} unreachable; " + audit_offload_fallback_action(cfg, false)
    }
    if (cfg.require_remote_audit ?? false) && is_last_host {
      release_log_event(
        harness,
        run_id,
        "step_finished",
        {
          step: "remote-audit-offload",
          success: false,
          target: "local",
          reason: reason,
          probe_status: probe.status,
        }
          + initial_remote_context,
      )
      throw "${reason}; remote audit is required, aborting instead of running the local fallback"
    }
    let recorded = {
      ...recorded_step("remote-audit-offload", offload_probe_command(host), ok("${reason}\n")),
      ...initial_remote_context,
      probe_status: probe.status,
    }
    release_log_event(
      harness,
      run_id,
      "step_finished",
      {
        step: "remote-audit-offload",
        success: true,
        target: audit_offload_fallback_target(is_last_host),
        reason: reason,
        probe_status: probe.status,
      }
        + initial_remote_context,
    )
    return {steps: steps + [recorded], skip_local_audit: false, try_next_host: !is_last_host}
  }
  let prereq_cmd = remote_audit_prereq_command(host)
  let prereq = run_cmd(cfg, prereq_cmd)
  if !prereq.success {
    let reason = "${host} audit prerequisites failed; " + audit_offload_fallback_action(cfg, is_last_host)
    return record_remote_audit_preflight_failure(
      harness,
      cfg,
      steps,
      run_id,
      prereq_cmd,
      host,
      remote_dir,
      reason,
      command_output(prereq),
      {prereq_status: prereq.status},
      is_last_host,
    )
  }
  let disk_cmd = remote_audit_disk_command(
    {host: host, remote_dir: remote_dir, min_free_gb: cfg.offload_min_free_gb},
  )
  let disk = run_cmd(cfg, disk_cmd)
  if !disk.success {
    let reason = "${host} audit disk preflight failed; " + audit_offload_fallback_action(cfg, is_last_host)
    return record_remote_audit_preflight_failure(
      harness,
      cfg,
      steps,
      run_id,
      disk_cmd,
      host,
      remote_dir,
      reason,
      command_output(disk),
      {disk_status: disk.status},
      is_last_host,
    )
  }
  let resource_cmd = remote_audit_resource_command({host: host, remote_dir: remote_dir})
  let resource = run_cmd(cfg, resource_cmd)
  if !resource.success {
    let reason = "${host} audit resource preflight failed; " + audit_offload_fallback_action(cfg, is_last_host)
    return record_remote_audit_preflight_failure(
      harness,
      cfg,
      steps,
      run_id,
      resource_cmd,
      host,
      remote_dir,
      reason,
      command_output(resource),
      {resource_status: resource.status},
      is_last_host,
    )
  }
  let repo_url = trim(run_git(cfg, ["remote", "get-url", "origin"]).stdout ?? "")
  let audit_cmd = remote_audit_setup_and_run_command(
    {host: host, remote_dir: remote_dir, repo_url: repo_url, pin_sha: cfg.pin_sha},
  )
  // Best-effort coordination hw-post (single source of truth for fleet remote
  // runs, mirroring burin-remote-run). Guarded with `command -v` remotely, so a
  // missing helper or a failed post never affects the release.
  if !cfg.mock {
    run_cmd(
      cfg,
      coordination_hw_post_command(
        {host: host, purpose: "harn release audit offload (${cfg.pin_sha[0:12]})", workdir: remote_dir},
      ),
    )
  }
  harness.stdio.println("   → offloading release audit to ${host} (${cfg.pin_sha[0:12]})")
  let audit = run_cmd(cfg, audit_cmd)
  let diagnostic_output = trim(command_output(audit))
  let setup_ok = audit.success || remote_audit_log_path_from_output(diagnostic_output) != ""
  let setup_status = if setup_ok {
    0
  } else {
    audit.status ?? -1
  }
  let audit_status = if setup_ok {
    audit.status ?? -1
  } else {
    -1
  }
  let skip = remote_audit_skip_decision(
    {
      setup_ok: setup_ok,
      audit_status: audit_status,
      host: host,
      require_remote: (cfg.require_remote_audit ?? false) && is_last_host,
      fallback_action: audit_offload_fallback_action(cfg, is_last_host),
    },
  )
  // Transport/preflight failures are recorded as successful offload attempts
  // with a local/next-host target. A red audit is recorded as a failed release
  // step and aborts below; it has already run the authoritative gate.
  let recorded_stdout = if diagnostic_output == "" {
    "${skip.reason}\n"
  } else {
    "${skip.reason}\n\n${diagnostic_output}\n"
  }
  let failure_context = remote_audit_context(
    {host: host, remote_dir: remote_dir, output: truncate_text(diagnostic_output, 12000)},
  )
  let recorded = {
    ...recorded_step("remote-audit-offload", audit_cmd, ok(recorded_stdout)),
    ...failure_context,
    setup_status: setup_status,
    audit_status: audit_status,
  }
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {
      step: "remote-audit-offload",
      success: !(skip.abort_release ?? false),
      target: if skip.abort_release ?? false {
        "abort"
      } else if skip.skip_local_audit {
        "remote"
      } else if is_last_host {
        "local"
      } else {
        "next-remote"
      },
      skip_local_audit: skip.skip_local_audit,
      try_next_host: !(skip.abort_release ?? false) && !skip.skip_local_audit && !is_last_host,
      reason: skip.reason,
      setup_status: setup_status,
      audit_status: audit_status,
    }
      + failure_context,
  )
  if skip.abort_release ?? false {
    throw recorded_stdout
  }
  return {
    steps: steps + [recorded],
    skip_local_audit: skip.skip_local_audit,
    try_next_host: !skip.skip_local_audit && !is_last_host,
  }
}

/**
 * Enumerate non-merge prepare commits on the existing release branch
 * — the commits we want to cherry-pick onto fresh `<base>` during a
 * fixup pass instead of re-running `./scripts/release_ship.sh --prepare`.
 *
 * Skips merges so the `Tie release/v$ver to shipped tag (ours)` merge
 * commit that a prior fixup may have laid down does not get replayed
 * (it has no tree delta and `execute_ship_pr` rebuilds it later if
 * needed). Reads from `origin/release/v$ver` because by the time this
 * runs we have already reset the local branch to fresh `<base>`; the
 * authoritative shape is the remote.
 */
fn fixup_prepare_commits(cfg, analysis) {
  let branch = "release/v${analysis.next_version}"
  let r = run_git(
    cfg,
    ["log", "--reverse", "--no-merges", "--format=%H", "origin/${cfg.base}..origin/${branch}"],
  )
  if !r.success {
    return {success: false, commits: [], stderr: r.stderr ?? ""}
  }
  let commits = []
  for line in split(r.stdout ?? "", "\n") {
    let sha = trim(line)
    if sha != "" {
      commits = commits + [sha]
    }
  }
  return {success: true, commits: commits, stderr: ""}
}

fn fixup_cherry_pick_argv(commits) {
  return ["git", "cherry-pick", "--no-commit", "--strategy-option=ours"] + commits
}

/**
 * Replace `./scripts/release_ship.sh --prepare` (which re-derives the
 * Cargo.toml workspace bumps and regenerated artifacts in ~110s on the
 * full harn workspace) with a cherry-pick of the original release
 * branch's prepare commits onto fresh `<base>`. `--strategy-option=ours`
 * keeps fresh-`<base>` content for any conflicting hunk (most commonly
 * CHANGELOG.md, where `<base>` drift collides with the prepare commit's
 * `## Unreleased` → `## v$ver` rewrite); the follow-up `git checkout
 * HEAD -- CHANGELOG.md` step in `execute_prepare` neutralizes any
 * non-conflicting CHANGELOG hunks the cherry-pick still applied, so
 * the smart-subtract CHANGELOG writer that runs next is unambiguously
 * authoritative. `--no-commit` lets the downstream `git add -u` /
 * `git commit -m "Release v$ver"` step in `execute_ship_pr` produce a
 * single canonical release commit.
 */
fn execute_fixup_cherry_pick(harness: Harness, cfg, analysis, steps, run_id) {
  let probe = fixup_prepare_commits(cfg, analysis)
  if !probe.success {
    return steps
      + [
      recorded_step(
        "fixup-list-prepare-commits",
        "git log --reverse --no-merges origin/${cfg.base}..origin/release/v${analysis.next_version}",
        fail(2, "could not enumerate prepare commits to cherry-pick:\n${trim(probe.stderr ?? "")}"),
      ),
    ]
  }
  if len(probe.commits) == 0 {
    return steps
      + [
      recorded_step(
        "fixup-list-prepare-commits",
        "git log --reverse --no-merges origin/${cfg.base}..origin/release/v${analysis.next_version}",
        fail(
          2,
          "no non-merge commits on origin/release/v${analysis.next_version} to cherry-pick; the existing release branch looks empty",
        ),
      ),
    ]
  }
  let cherry_argv = fixup_cherry_pick_argv(probe.commits)
  release_log_event(
    harness,
    run_id,
    "step_started",
    {
      step: "fixup-cherry-pick-prepare-commits",
      command: argv_label(cherry_argv),
      commit_count: len(probe.commits),
    },
  )
  let result = append_command_step(harness, cfg, steps, "fixup-cherry-pick-prepare-commits", cherry_argv)
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {
      step: "fixup-cherry-pick-prepare-commits",
      success: result.success,
      status: result.status,
      commit_count: len(probe.commits),
    },
  )
  if result.success {
    return result.steps
  }
  // Failure leaves CHERRY_PICK_HEAD set, which would block the next run.
  // Abort defensively; `|| true` keeps the cleanup itself from masking
  // the original failure when there is nothing to abort.
  let abort = append_command_step(
    harness,
    cfg,
    result.steps,
    "fixup-cherry-pick-abort",
    "git cherry-pick --abort 2>/dev/null || true",
  )
  return abort.steps
}

fn release_adds_workspace_crate(analysis) {
  let changes = analysis.commit_file_changes_since_latest_tag ?? ""
  return contains(changes, "A\tcrates/") && contains(changes, "/Cargo.toml")
}

fn with_derived_release_options(cfg, analysis) {
  if cfg.bootstrap_new_crates ?? false {
    return cfg
  }
  if release_adds_workspace_crate(analysis) {
    return {...cfg, bootstrap_new_crates: true}
  }
  return cfg
}

fn require_live_confirmation(cfg) {
  if !cfg.mock && !cfg.yes_live_release {
    throw "live ${cfg.mode} mode requires --yes-live-release"
  }
}

fn run_events_path(run_id) {
  return path_join(release_run_dir(run_id), "run-events.jsonl")
}

fn live_logs_dir(run_id) {
  return path_join(release_run_dir(run_id), "live-logs")
}

fn command_live_log_path(run_id, name) {
  let safe_name = regex_replace_all("[^A-Za-z0-9_.-]+", "-", name)
  return path_join(live_logs_dir(run_id), safe_name + ".log")
}

fn release_log_event(harness: Harness, run_id, event_type, data) {
  let path = run_events_path(run_id)
  harness.fs.mkdir(dirname(path), true)
  harness.fs
    .append(
    path,
    json_stringify(
      {
        schema_version: "release_harn.run_event.v1",
        timestamp: date_now_iso(),
        event_type: event_type,
        data: data,
      },
    )
      + "\n",
  )
  return path
}

fn command_label(command) {
  if command?.argv != nil {
    return argv_label(command.argv)
  }
  if command?.command != nil {
    return command.command
  }
  if type_of(command) == "list" {
    return argv_label(command)
  }
  return command
}

fn log_step_started(harness: Harness, run_id, name, command, extra = nil) {
  let extra_fields = extra ?? {}
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: name, command: command_label(command)} + extra_fields,
  )
}

fn log_step_finished(harness: Harness, run_id, name, result, extra) {
  let base = {step: name, success: result.success, status: result.status}
  let extra_fields = extra ?? {}
  release_log_event(harness, run_id, "step_finished", base + extra_fields)
}

fn release_command_runner(cfg) {
  if !cfg.mock {
    return nil
  }
  return { spec, _options ->
    let label = if spec?.argv != nil {
      join(spec.argv.map({ a -> to_string(a) }), " ")
    } else {
      spec?.command ?? ""
    }
    fake_command(label, cfg, spec?.env)
  }
}

fn append_command_step(harness: Harness, cfg, steps, name, command, extra = nil) {
  return append_std_command_step(harness, cfg, steps, name, command, release_command_runner(cfg), extra)
}

fn append_github_command_step(harness: Harness, cfg, steps, name, command) {
  return append_std_github_command_step(harness, cfg, steps, name, command, release_command_runner(cfg))
}

fn local_branch_exists(cfg, branch) {
  return probe_git_ok(cfg, ["show-ref", "--verify", "--quiet", "refs/heads/${branch}"])
}

fn remote_branch_exists(cfg, branch) {
  return probe_git_ok(cfg, ["show-ref", "--verify", "--quiet", "refs/remotes/origin/${branch}"])
}

fn target_release_checkout_state(harness: Harness, cfg, analysis) {
  let branch = checked_git(cfg, ["branch", "--show-current"])
  let current = current_version(harness, cfg)
  let top = changelog_top(harness, cfg)
  return {
    branch: branch,
    current_version: current,
    changelog_top: top,
    matches: branch == analysis.expected_branch && current == analysis.next_version
      && top == analysis.next_version,
  }
}

fn release_branch_push_argv(cfg, branch) {
  return release_branch_push_args(branch, remote_branch_exists(cfg, branch))
}

/**
 * Tag the release commit at HEAD as `vX.Y.Z` and push the tag.
 *
 * The tag is the source of truth for what gets published — the harn-side
 * publish-release.yml fires on tag push and ships from the tag, so the
 * release survives the merge queue rebasing the Release PR onto a moved
 * main. Idempotent: if the tag already exists locally and points at the
 * release HEAD, the create step no-ops; if it points elsewhere, fail
 * with an actionable message rather than overwriting silently.
 *
 * In post-publish fixup mode (`cfg.skip_tag`), the tag was pushed during
 * the original publish and the artifact already shipped from it. The
 * fixup PR exists to land the Cargo.toml/CHANGELOG bump on `<base>` and
 * does not influence the published release. Re-pushing the tag would
 * either re-fire publish-release.yml (queueing behind itself) or — if
 * advanced to a different commit — diverge crates.io from the git
 * artifact. Short-circuit with an idempotent step so the fixup flow can
 * proceed straight to the PR body refresh.
 */
fn release_repo_slug(cfg) {
  let remote = run_git(cfg, ["remote", "get-url", "origin"])
  if !remote.success {
    return ""
  }
  return github_slug_from_remote_url(remote.stdout)
}

/**
 * Prove the frozen release cutoff remains in `origin/<base>` ancestry before
 * the irreversible tag push. Normal descendant commits belong to the next
 * release; divergence or an unprovable cutoff fails closed. Returns
 * `{steps, proceed}`; `proceed=false` means the caller must stop before
 * `ensure_release_tag_pushed`.
 *
 * The pure `release_cutoff_decision` owns the policy; this only gathers the fresh
 * probe. Repin mode, explicit `--at-sha`, and `--allow-base-drift` short-circuit
 * (their drift is intended or already gated); mock skips the live probe.
 */
fn release_cutoff_gate(harness: Harness, cfg, tag: string, phase: string, steps, run_id) {
  let explicit_pin = trim(cfg.pin_sha_input ?? "") != ""
  if cfg.mock || (cfg.repin_mode ?? false) || explicit_pin || (cfg.allow_base_drift ?? false) {
    return {steps: steps, proceed: true}
  }
  const step = "pre-${phase}-cutoff-check"
  const action = if phase == "tag" {
    "tagging"
  } else {
    "preparing"
  }
  release_log_event(harness, run_id, "step_started", {step: step})
  let fetch = run_git(cfg, ["fetch", "origin", "--quiet", cfg.base])
  if !fetch.success {
    let fetch_stderr = trim(fetch.stderr ?? "")
    let recorded = recorded_step(
      step,
      "git fetch origin ${cfg.base}",
      fail(2, "${step} could not fetch origin/${cfg.base} before ${action} ${tag}: ${fetch_stderr}"),
    )
    release_log_event(harness, run_id, "step_finished", {step: step, success: false})
    return {steps: steps + [recorded], proceed: false}
  }
  const cutoff = release_cutoff_probe({ args -> run_git(cfg, args) }, cfg)
  let decision = release_cutoff_decision(
    {
      pin_sha: cfg.pin_sha,
      base_head_sha: cutoff.base_head_sha,
      pin_is_base_ancestor: cutoff.pin_is_base_ancestor,
      base: cfg.base,
      tag: tag,
      repin_latest: false,
      explicit_pin: false,
      allow_drift: false,
    },
  )
  if decision.action == "abort" {
    let recorded = recorded_step(
      step,
      "prove release cutoff is in origin/${cfg.base} ancestry",
      fail(2, decision.reason),
    )
    release_log_event(
      harness,
      run_id,
      "step_finished",
      {step: step, success: false, reason: decision.reason},
    )
    return {steps: steps + [recorded], proceed: false}
  }
  let recorded = recorded_step(
    step,
    "prove release cutoff is in origin/${cfg.base} ancestry",
    ok(
      "cutoff ${cfg.pin_sha} remains in origin/${cfg.base} ancestry at ${cutoff.base_head_sha}; later base commits belong to the next release; safe to ${phase} ${tag}\n",
    ),
  )
  release_log_event(harness, run_id, "step_finished", {step: step, success: true})
  return {steps: steps + [recorded], proceed: true}
}

fn pre_tag_cutoff_gate(harness: Harness, cfg, version, steps, run_id) {
  return release_cutoff_gate(harness, cfg, "v${version}", "tag", steps, run_id)
}

/**
 * Prove the frozen cutoff is still in base ancestry before branch mutation.
 * Normal base advancement does not invalidate prepared evidence; divergence
 * fails before the expensive prepare phase and branch push.
 */
fn pre_prepare_cutoff_gate(harness: Harness, cfg, analysis, steps, run_id) {
  let version = trim(analysis.next_version ?? "")
  let tag = if version == "" {
    "v<unknown>"
  } else {
    "v${version}"
  }
  return release_cutoff_gate(harness, cfg, tag, "prepare", steps, run_id)
}

/** Persist the handoff that lets post-tag monitoring resume in another process. */
fn persist_release_watch_receipt(harness: Harness, cfg, version, steps, run_id, pr_url) {
  if cfg.mock {
    return steps
  }
  const tag = "v${version}"
  const slug = release_repo_slug(cfg)
  const path = release_watch_receipt_path(release_run_root(), tag)
  const receipt = release_watch_receipt(
    {tag: tag, slug: slug, pin_sha: cfg.pin_sha, pr_url: pr_url, created_at: date_now_iso()},
  )
  const written = try {
    release_watch_receipt_write(path, receipt)
  }
  const result = if is_ok(written) {
    ok("durable release watch receipt: " + unwrap(written) + "\n")
  } else {
    fail(2, "could not persist release watch receipt: " + to_string(unwrap_err(written)))
  }
  release_log_event(
    harness,
    run_id,
    "release_watch_receipt_written",
    {tag: tag, path: path, success: result.success, pr_url: pr_url},
  )
  return steps
    + [recorded_step("persist-release-watch", "persist resumable post-tag watch receipt", result)]
}

fn run_pre_tag_binary_size_gate(harness: Harness, cfg, branch, steps, run_id) {
  const head_probe = run_git(cfg, ["rev-parse", "HEAD"])
  const slug = if cfg.mock {
    "burin-labs/harn"
  } else {
    release_repo_slug(cfg)
  }
  const result = if !head_probe.success {
    pre_tag_size_gate_failure(
      "could not resolve the intended release commit: " + trim(command_output(head_probe)),
    )
  } else if slug == "" {
    pre_tag_size_gate_failure("could not resolve the GitHub repository slug")
  } else {
    const config = pre_tag_binary_size_gate_config(branch, trim(head_probe.stdout))
    const adapter = if cfg.mock {
      mock_pre_tag_size_gate_adapter(config)
    } else {
      command_pre_tag_size_gate_adapter(
        config,
        slug,
        fn(args) { return run_gh(cfg, args) },
        fn(gate) { return gh_workflow_run(
          slug,
          gate.workflow,
          {benchmark_only: gate.benchmark_only, runner_profile: gate.runner_profile, targets: gate.targets},
          gate.ref,
        ) },
        fn(ms) { harness.clock.sleep_ms(ms) },
      )
    }
    run_pre_tag_size_gate(config, adapter)
  }
  release_log_event(harness, run_id, "pre_tag_binary_size_gate", pre_tag_size_gate_event(result))
  return {
    steps: steps
      + [
      recorded_step(
        "pre-tag-linux-binary-size-gate",
        "require SHA-matched Linux size workflow",
        pre_tag_size_gate_command_result(result),
      ),
    ],
    success: result.success,
  }
}

fn ensure_release_tag_pushed(harness: Harness, cfg, version, steps, run_id) {
  let tag = "v${version}"
  if cfg.skip_tag ?? false {
    release_log_event(
      harness,
      run_id,
      "step_started",
      {step: "ensure-release-tag-pushed-skipped", reason: "fixup_mode"},
    )
    let skip_step = recorded_step(
      "ensure-release-tag-pushed-skipped",
      "fixup mode: tag ${tag} was pushed during the original publish",
      ok(
        "idempotent skip: ${tag} was pushed during the original publish-release.yml run; this rerun is post-publish paperwork and must not re-tag\n",
      ),
    )
    release_log_event(
      harness,
      run_id,
      "step_finished",
      {step: "ensure-release-tag-pushed-skipped", success: true, status: 0},
    )
    return steps + [skip_step]
  }
  let head_probe = run_git(cfg, ["rev-parse", "HEAD"])
  if !head_probe.success {
    return steps + [recorded_step("create-release-tag", "git rev-parse HEAD", head_probe)]
  }
  let head = trim(head_probe.stdout)
  let pre_steps = steps
  let remote_tag_probe = run_git(cfg, ["ls-remote", "origin", "refs/tags/" + tag, "refs/tags/" + tag + "^{}"])
  if !remote_tag_probe.success {
    return pre_steps
      + [recorded_step("probe-release-tag", "git ls-remote origin refs/tags/" + tag, remote_tag_probe)]
  }
  let remote_target = remote_tag_target_sha_from_ls_remote(remote_tag_probe.stdout)
  let remote_decision = remote_release_tag_decision({tag: tag, head_sha: head, remote_target_sha: remote_target})
  if remote_decision.action == "reuse" {
    return pre_steps
      + [
      recorded_step(
        "push-release-tag",
        "remote tag ${tag} already targets release HEAD",
        ok("idempotent remote tag reuse: ${remote_decision.reason}; skipping tag push\n"),
      ),
    ]
  }
  if remote_decision.action == "abort" {
    return pre_steps
      + [
      recorded_step(
        "push-release-tag",
        "git ls-remote origin refs/tags/" + tag,
        fail(2, remote_decision.reason),
      ),
    ]
  }
  let local_tag_probe = run_git(cfg, ["rev-parse", "-q", "--verify", "refs/tags/" + tag])
  let local_exists = local_tag_probe.success
  let local_target = ""
  if local_tag_probe.success {
    let tag_commit_probe = run_git(cfg, ["rev-list", "-n", "1", tag])
    local_target = if tag_commit_probe.success {
      trim(tag_commit_probe.stdout)
    } else {
      ""
    }
  }
  let local_decision = local_release_tag_decision(
    {
      tag: tag,
      head_sha: head,
      local_exists: local_exists,
      local_target_sha: local_target,
      remote_target_sha: remote_target,
    },
  )
  if local_decision.action == "abort" {
    return pre_steps
      + [recorded_step("create-release-tag", "git rev-list -n 1 " + tag, fail(2, local_decision.reason))]
  }
  if local_decision.action == "refresh" {
    let delete = logged_command_step(
      harness,
      cfg,
      pre_steps,
      "refresh-local-release-tag",
      ["git", "tag", "-d", tag],
      run_id,
    )
    pre_steps = delete.steps
    if !delete.success {
      return pre_steps
    }
  }
  if local_decision.action == "reuse" {
    pre_steps = pre_steps
      + [
      recorded_step(
        "create-release-tag",
        "tag ${tag} already pinned at HEAD",
        ok("idempotent reuse: ${local_decision.reason}\n"),
      ),
    ]
  } else {
    let create_argv = release_tag_create_args(tag, version)
    let create = logged_command_step(harness, cfg, pre_steps, "create-release-tag", create_argv, run_id)
    pre_steps = create.steps
    if !create.success {
      return pre_steps
    }
  }
  // Never publish a tag that Git cannot verify with the configured signing trust.
  let verify_tag = logged_command_step(
    harness,
    cfg,
    pre_steps,
    "verify-release-tag-signature",
    release_tag_verify_args(tag),
    run_id,
  )
  pre_steps = verify_tag.steps
  if !verify_tag.success {
    return pre_steps
  }
  let push_tag = logged_command_step(
    harness,
    cfg,
    pre_steps,
    "push-release-tag",
    {argv: release_tag_push_args(tag), env: hook_light_env()},
    run_id,
  )
  return push_tag.steps
}

/**
 * Pre-resolve sync: ensure local `<base>` matches `origin/<base>` before we
 * freeze the pin SHA. Stashes any dirty tracked/untracked changes under a
 * run-tagged label so the operator can recover them with `git stash list`.
 *
 * Gated to live-mutating runs only — read-only audit and `--at-sha`-pinned
 * runs keep their lighter footprint (no stash, no branch switch). Mid-release
 * runs already sitting on a `release/v*` branch are deferred to
 * `normalize_release_analysis_checkout`, which knows how to tell a
 * fresh-prepare from a stale one.
 */
fn pre_release_sync_local_base(harness: Harness, cfg, run_id) {
  if cfg.mock {
    return nil
  }
  if trim(cfg.pin_sha_input ?? "") != "" {
    release_log_event(harness, run_id, "base_sync_skipped_pinned", {pin_sha_input: cfg.pin_sha_input})
    return nil
  }
  if cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return nil
  }
  let current_branch_r = run_git(cfg, ["branch", "--show-current"])
  if !current_branch_r.success {
    throw "failed to read current branch before pin-SHA sync:\n${trim(current_branch_r.stderr)}"
  }
  let current_branch = trim(current_branch_r.stdout)
  if version_from_release_branch(current_branch) != "" {
    release_log_event(
      harness,
      run_id,
      "base_sync_skipped_release_branch",
      {branch: current_branch, base: cfg.base},
    )
    harness.stdio
      .println("   ↳ on release branch ${current_branch}; deferring base sync to normalize step")
    return nil
  }
  release_log_event(
    harness,
    run_id,
    "base_sync_started",
    {from_branch: current_branch, base: cfg.base},
  )
  let stash_tag = "release_harn-auto-stash-${run_id}"
  let result = sync_base_branch(nil, cfg.base, stash_tag, cfg.repo)
  release_log_event(
    harness,
    run_id,
    "base_sync_finished",
    {
      from_branch: current_branch,
      base: cfg.base,
      success: result.success,
      dirty: result.dirty,
      stashed: result.stashed,
      stash_message: result.stash_message,
      branch: result.branch,
      detail: result.detail,
    },
  )
  if !result.success {
    let recovery_hint = if result.stashed {
      " (your changes are saved under `git stash list` → ${result.stash_message}; `git stash pop` to recover)"
    } else {
      ""
    }
    throw "failed to sync ${cfg.base} from origin before pin-SHA resolution: ${result.detail}${recovery_hint}"
  }
  if result.stashed {
    harness.stdio
      .println(
      "   ↳ stashed dirty working tree (`git stash pop` to recover; tag: ${result.stash_message})",
    )
  }
  if current_branch != "" && current_branch != cfg.base {
    harness.stdio.println("   ↳ switched from ${current_branch} to ${cfg.base}")
  }
  harness.stdio.println("   ↳ ${result.detail}")
  return result
}

fn normalize_release_analysis_checkout(harness: Harness, cfg, run_id) {
  if cfg.mock || cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return
  }
  let current_branch = checked_git(cfg, ["branch", "--show-current"])
  let release_version = version_from_release_branch(current_branch)
  if release_version == "" {
    return
  }
  let status = checked_git(cfg, ["status", "--porcelain", "--untracked-files=normal"])
  if trim(status) != "" {
    release_log_event(
      harness,
      run_id,
      "checkout_normalization_preserved_dirty_release_branch",
      {from_branch: current_branch, status: status},
    )
    return
  }
  let current = current_version(harness, cfg)
  let top = changelog_top(harness, cfg)
  let latest_tag = latest_release_tag(cfg)
  if release_version == current && top == current && version_from_tag(latest_tag) != current {
    release_log_event(
      harness,
      run_id,
      "checkout_normalization_skipped_prepared_release_branch",
      {branch: current_branch, version: current, latest_tag: latest_tag},
    )
    return
  }
  release_log_event(
    harness,
    run_id,
    "checkout_normalization_started",
    {from_branch: current_branch, base: cfg.base},
  )
  let fetch = run_git(cfg, ["fetch", "origin", "--prune", "--quiet"])
  if !fetch.success {
    throw "failed to fetch before release rerun checkout normalization:\n${trim(fetch.stderr)}"
  }
  let switched = run_git(cfg, ["switch", cfg.base])
  if !switched.success {
    throw "failed to switch from ${current_branch} to ${cfg.base} before release analysis:\n${trim(switched.stderr)}"
  }
  let pulled = run_git(cfg, ["pull", "--ff-only", "origin", cfg.base, "--quiet"])
  if !pulled.success {
    throw "failed to fast-forward ${cfg.base} before release analysis:\n${trim(pulled.stderr)}"
  }
  release_log_event(
    harness,
    run_id,
    "checkout_normalization_finished",
    {from_branch: current_branch, base: cfg.base, release_version: release_version},
  )
}

/**
 * Repin mode: clean up stale `v$next` tags before re-tagging at the new
 * pin. `fetch-base --tags` rehydrates the local tag from origin (when
 * present), and `ensure_release_tag_pushed` refuses to overwrite a stale
 * local tag pointing somewhere other than the release HEAD. Always
 * delete locally; delete on origin only when the TOCTTOU re-check
 * confirmed the remote tag was present at `repin_initial_remote_tag_sha`.
 */
fn maybe_delete_stale_repin_tag(harness: Harness, cfg, version, steps, run_id) {
  if !(cfg.repin_mode ?? false) {
    return {steps: steps, success: true}
  }
  let tag = "v${version}"
  // `git tag -d` returns non-zero when the tag is absent; treat that as a
  // no-op rather than a failure (this step runs as part of repin tear-down
  // and the local tag may already have been pruned).
  let local_del_argv = ["git", "tag", "-d", tag]
  let local_del_label = argv_label(local_del_argv)
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: "repin-delete-local-tag", command: local_del_label},
  )
  let local_del = run_git(cfg, local_del_argv[1:len(local_del_argv)])
  let out = steps
    + [recorded_step("repin-delete-local-tag", local_del_label, ok("ok: ${trim(local_del.stdout)}\n"))]
  release_log_event(harness, run_id, "step_finished", {step: "repin-delete-local-tag", success: true})
  if trim(cfg.repin_initial_remote_tag_sha ?? "") == "" {
    return {steps: out, success: true}
  }
  let remote_del_argv = ["git", "push", "origin", "--delete", tag]
  release_log_event(
    harness,
    run_id,
    "step_started",
    {step: "repin-delete-remote-tag", command: argv_label(remote_del_argv)},
  )
  let remote_del = append_command_step(harness, cfg, out, "repin-delete-remote-tag", remote_del_argv)
  out = remote_del.steps
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {step: "repin-delete-remote-tag", success: remote_del.success, status: remote_del.status},
  )
  return {steps: out, success: remote_del.success}
}

fn release_asset_snapshot(cfg, tag) {
  let probe = run_gh(cfg, ["release", "view", tag, "--json", "assets", "--jq", ".assets[].name"])
  let assets = if probe.success {
    split(probe.stdout ?? "", "\n").map({ name -> trim(name) }).filter({ name -> name != "" })
  } else {
    []
  }
  let missing = missing_release_assets(assets)
  return {assets: assets, missing_assets: missing, ready: len(missing) == 0}
}

/**
 * TOCTTOU re-check executed immediately before the repin branch reset.
 *
 * `detect_repin_state` ran at startup and captured `initial_remote_tag_sha`.
 * Between then and now the operator's environment continued to drift — other
 * sessions may have published the release, moved the tag, or landed more
 * commits on `<base>`. Re-fetch origin, re-probe every gate, and only then
 * return the freshly-locked pin SHA the caller may safely reset to.
 *
 * Returns `{success, message, new_pin_sha}`. On `success=false` the caller
 * must surface `message` and abort the mutation.
 */
fn run_repin_tocttou_recheck(cfg, analysis) {
  let tag = "v${analysis.next_version}"
  let fetch = run_git(cfg, ["fetch", "origin", "--tags", "--prune", "--quiet"])
  if !fetch.success {
    return {
      success: false,
      message: "repin: failed to re-fetch origin before TOCTTOU recheck: ${trim(fetch.stderr)}",
      new_pin_sha: "",
    }
  }
  let release_assets = release_asset_snapshot(cfg, tag)
  let release_exists = release_assets.ready || harn_crate_published(analysis.next_version)
  let ls = run_git(cfg, ["ls-remote", "origin", "refs/tags/" + tag])
  if !ls.success {
    return {
      success: false,
      message: "repin: failed to re-list remote tag ${tag}: ${trim(ls.stderr)}",
      new_pin_sha: "",
    }
  }
  let pin_probe = run_git(cfg, ["rev-parse", "--verify", "origin/${cfg.base}^{commit}"])
  if !pin_probe.success {
    return {
      success: false,
      message: "repin: failed to re-resolve origin/${cfg.base}: ${trim(pin_probe.stderr)}",
      new_pin_sha: "",
    }
  }
  let decision = repin_tocttou_decision(
    {
      release_exists: release_exists,
      initial_remote_tag_sha: cfg.repin_initial_remote_tag_sha ?? "",
      current_remote_tag_sha: remote_tag_sha_from_ls_remote(ls.stdout),
      new_pin_sha: trim(pin_probe.stdout),
      tag: tag,
    },
  )
  if decision.action == "abort" {
    return {success: false, message: "repin: aborting — ${decision.reason}", new_pin_sha: ""}
  }
  return {success: true, message: "", new_pin_sha: decision.new_pin_sha}
}

fn setup_release_branch(harness: Harness, cfg, analysis) {
  let steps = []
  let current_branch = checked_git(cfg, ["branch", "--show-current"])
  let target_branch = analysis.expected_branch
  let status = checked_git(cfg, ["status", "--porcelain", "--untracked-files=normal"])
  if current_branch == target_branch {
    return [
      recorded_step(
        "use-current-release-branch",
        "git branch --show-current && git status --porcelain --untracked-files=normal",
        ok("using existing ${target_branch} checkout for prepare\n${status}"),
      ),
    ]
  }
  let stashed = false
  if trim(status) != "" {
    if current_branch == cfg.base {
      steps = steps
        + [
        recorded_step(
          "dirty-base-branch",
          "git status --porcelain --untracked-files=normal",
          fail(
            2,
            "refusing to create ${target_branch} from dirty base branch ${cfg.base}; clean, commit, or move unrelated work before running live release",
          ),
        ),
      ]
      return steps
    }
    let stash_message = "release_harn branch setup ${analysis.next_version} ${uuid_v7()}"
    let stash = append_command_step(
      harness,
      cfg,
      steps,
      "stash-before-branch-setup",
      ["git", "stash", "push", "-u", "-m", stash_message],
    )
    steps = stash.steps
    if !stash.success {
      return steps
    }
    stashed = true
  }
  let fetch = append_command_step(
    harness,
    cfg,
    steps,
    "fetch-origin",
    ["git", "fetch", "origin", "--prune", "--quiet"],
  )
  steps = fetch.steps
  if !fetch.success {
    if stashed {
      let restore = append_command_step(
        harness,
        cfg,
        steps,
        "restore-stash-after-fetch-failure",
        ["git", "stash", "pop", "--index"],
      )
      steps = restore.steps
    }
    return steps
  }
  if current_branch == cfg.base {
    let pull = append_command_step(
      harness,
      cfg,
      steps,
      "sync-base",
      ["git", "pull", "--ff-only", "origin", cfg.base, "--quiet"],
    )
    steps = pull.steps
    if !pull.success {
      if stashed {
        let restore = append_command_step(
          harness,
          cfg,
          steps,
          "restore-stash-after-sync-failure",
          ["git", "stash", "pop", "--index"],
        )
        steps = restore.steps
      }
      return steps
    }
  }
  let switch_step = "create-release-branch-from-pin"
  let switch_argv = ["git", "switch", "-c", target_branch, cfg.pin_sha]
  if current_branch == target_branch {
    switch_step = "reset-release-branch-to-pin"
    switch_argv = ["git", "reset", "--hard", cfg.pin_sha]
  } else if local_branch_exists(cfg, target_branch) || remote_branch_exists(cfg, target_branch) {
    switch_step = "reset-release-branch-to-pin"
    switch_argv = ["git", "switch", "-C", target_branch, cfg.pin_sha]
  }
  let switched = append_command_step(harness, cfg, steps, switch_step, switch_argv)
  steps = switched.steps
  if !switched.success {
    if stashed {
      let restore = append_command_step(
        harness,
        cfg,
        steps,
        "restore-stash-after-switch-failure",
        ["git", "stash", "pop", "--index"],
      )
      steps = restore.steps
    }
    return steps
  }
  if stashed {
    let applied = append_command_step(
      harness,
      cfg,
      steps,
      "restore-stashed-release-content",
      ["git", "stash", "pop", "--index"],
    )
    steps = applied.steps
    if !applied.success {
      let status_after = run_git(cfg, ["status", "--porcelain", "--untracked-files=normal"])
      steps = steps
        + [
        recorded_step(
          "status-after-stash-conflict",
          "git status --porcelain --untracked-files=normal",
          status_after,
        ),
      ]
      return steps
    }
  }
  return steps
}

fn read_agent_notes(harness: Harness, notes_path) {
  if notes_path == nil || notes_path == "" || !harness.fs.exists(notes_path) {
    return ""
  }
  return trim(harness.fs.read_text(notes_path))
}

/**
 * Discover towncrier-style fragment files under `changelog.d/` in the
 * target repo and assemble them into a Keep-a-Changelog section body.
 * Returns `{section, paths}` where `section` is the rendered markdown
 * (empty when there are no parseable fragments) and `paths` lists the
 * absolute fragment paths consumed (so the caller can stage their
 * deletion alongside the CHANGELOG.md update).
 *
 * Mock mode is a no-op so the v0.7.52→v0.7.53 rehearsal stays
 * fragment-free without needing fixture files.
 */
fn assemble_repo_fragments(harness: Harness, cfg) {
  if cfg.mock {
    return {section: "", paths: []}
  }
  let dir = path_join(cfg.repo, "changelog.d")
  if !harness.fs.exists(dir) {
    return {section: "", paths: []}
  }
  let listing = shell_at(cfg.repo, "ls changelog.d/ 2>/dev/null")
  if !listing.success {
    return {section: "", paths: []}
  }
  let fragments = []
  let paths = []
  for name in listing.stdout.split("\n") {
    let trimmed = trim(name)
    if trimmed == "" {
      continue
    }
    let parsed = parse_fragment_filename(trimmed)
    if parsed == nil {
      continue
    }
    let full = path_join(dir, trimmed)
    if !harness.fs.exists(full) {
      continue
    }
    let body = trim(harness.fs.read_text(full))
    if body == "" {
      continue
    }
    fragments = fragments.push({id: parsed.id, category: parsed.category, body: body})
    paths = paths.push(full)
  }
  return {section: assemble_fragments_section(fragments), paths: paths, fragments: fragments}
}

/**
 * Delete fragment files consumed in this release. `git add -u` (run later
 * by scripts/release_ship.sh) picks the deletions up so they ride in the
 * same release commit as the CHANGELOG.md update.
 */
fn delete_repo_fragments(cfg, paths) {
  for p in paths {
    let arg = safe_shell_arg(p)
    if arg == nil {
      continue
    }
    shell_at(cfg.repo, "rm -f " + arg)
  }
}

/**
 * Deterministic changelog fold: merge assembled `changelog.d` fragments into
 * `## Unreleased`, then rename/insert the `## v${next_version}` section. Pure
 * with respect to the filesystem (no writes) so it can be run twice for an
 * idempotent recovery retry. Returns `{success, message, text, changed}`.
 */
fn fold_changelog_text(original, fragments_section, next_version, agent_notes) {
  let merged = if trim(fragments_section ?? "") == "" {
    {success: true, changed: false, text: original, message: "no changelog.d fragments"}
  } else {
    changelog_merge_fragments_into_unreleased(original, fragments_section)
  }
  if !merged.success {
    return {success: false, message: merged.message, text: original, changed: false}
  }
  let update = changelog_release_section_update(merged.text, next_version, agent_notes)
  if !update.success {
    return {success: false, message: update.message, text: merged.text, changed: false}
  }
  return {
    success: true,
    message: update.message,
    text: update.text,
    changed: update.changed || merged.changed,
  }
}

/**
 * F1b: fold the CHANGELOG deterministically, then recover if the result is
 * malformed. The deterministic fold is the normal path. If the resulting
 * `## v${next_version}` section is invalid (wrong heading, no bullets, or an
 * unrepresented fragment), first retry the deterministic fold (idempotent); only
 * if that still fails does a bounded agent_loop massage the section — with a
 * deterministic validation gate afterward so the model can neither invent
 * content nor drop a fragment. Fragments are deleted only once a valid state is
 * reached; on unrecoverable failure the fold fails loud and leaves fragments in
 * place.
 */
fn apply_draft_release_notes(harness: Harness, cfg, analysis, notes_path, run_id) {
  let changelog_path = path_join(cfg.repo, "CHANGELOG.md")
  if !cfg.mock && !harness.fs.exists(changelog_path) {
    return fail(1, "missing CHANGELOG.md")
  }
  let original = read_repo_file(harness, cfg, "CHANGELOG.md")
  let fragments = assemble_repo_fragments(harness, cfg)
  let fragment_records = fragments.fragments ?? []
  let agent_notes = read_agent_notes(harness, notes_path)
  let folded = fold_changelog_text(original, fragments.section, analysis.next_version, agent_notes)
  if !folded.success {
    return fail(1, folded.message)
  }
  let gate = changelog_release_section_valid(folded.text, analysis.next_version, fragment_records)
  let final_text = folded.text
  let recovery_note = ""
  if !gate.valid {
    release_log_event(
      harness,
      run_id,
      "changelog_fold_invalid",
      {version: analysis.next_version, findings: gate.findings},
    )
    // Deterministic-first recovery: re-run the idempotent fold once.
    let refold = fold_changelog_text(folded.text, fragments.section, analysis.next_version, agent_notes)
    let regate = if refold.success {
      changelog_release_section_valid(refold.text, analysis.next_version, fragment_records)
    } else {
      {valid: false, findings: [refold.message]}
    }
    if regate.valid {
      final_text = refold.text
      recovery_note = "; recovered via deterministic re-fold"
      release_log_event(harness, run_id, "changelog_fold_recovered", {via: "deterministic-refold"})
    } else if !cfg.mock {
      // Last resort: bounded agent massage with a deterministic post-gate.
      let massage = run_changelog_massage_recovery(harness, cfg, analysis, run_id, folded.text, fragment_records)
      if massage.valid {
        final_text = massage.text
        recovery_note = "; recovered via bounded agent massage"
        release_log_event(harness, run_id, "changelog_fold_recovered", {via: "agent-massage"})
      } else {
        return fail(
          1,
          "changelog fold produced an invalid `## v${analysis.next_version}` section and recovery failed:\n"
            + join(gate.findings + (massage.findings ?? []), "\n"),
        )
      }
    } else {
      return fail(
        1,
        "changelog fold produced an invalid `## v${analysis.next_version}` section:\n"
          + join(gate.findings, "\n"),
      )
    }
  }
  if !cfg.mock {
    harness.fs.write_text(changelog_path, final_text)
  }
  if !cfg.mock && len(fragments.paths) > 0 {
    delete_repo_fragments(cfg, fragments.paths)
  }
  let fragments_note = if len(fragments.paths) == 0 {
    ""
  } else {
    "; folded ${len(fragments.paths)} changelog.d fragment(s)"
  }
  return ok("ok: " + folded.message + fragments_note + recovery_note + "\n")
}

/**
 * Bounded agent recovery for a malformed changelog fold. Reuses the release
 * recovery agent loop to reorganize the AUTHORITATIVE fragment bullets into a
 * valid `## v${next_version}` Keep-a-Changelog section, then splices that
 * section deterministically and re-validates with the same gate. The model may
 * not invent content: the gate requires every fragment to be represented, and a
 * failing gate returns `{valid: false}` so the caller fails loud rather than
 * writing model slop. Returns `{valid, text, findings}`.
 */
fn run_changelog_massage_recovery(
  harness: Harness,
  cfg,
  analysis,
  run_id,
  base_text,
  fragment_records,
) {
  let fragments_section = assemble_fragments_section(fragment_records)
  let prompt = render(
    prompt_asset("release_changelog_massage_prompt.harn.prompt"),
    {
      target_version: analysis.next_version,
      fragments_section: fragments_section,
      current_section: changelog_named_section_from_text(base_text, "## v${analysis.next_version}"),
    },
  )
  let result = run_recovery_agent_loop(harness, cfg, analysis, prompt, run_id, "changelog-massage")
  let text = agent_result_text(result)
  let section = changelog_named_section_from_text(text, "## v${analysis.next_version}")
  let section_markdown = if trim(section) == "" {
    ""
  } else {
    "## v${analysis.next_version}\n\n" + trim(section)
  }
  if section_markdown == "" {
    return {
      valid: false,
      text: base_text,
      findings: ["agent massage did not produce a `## v${analysis.next_version}` section"],
    }
  }
  let spliced = changelog_replace_top_section(base_text, section_markdown)
  let gate = changelog_release_section_valid(spliced, analysis.next_version, fragment_records)
  return {valid: gate.valid, text: spliced, findings: gate.findings}
}

/**
 * Repair / fixup CHANGELOG path. Used when an open release/v${next_version}
 * PR is detected at startup — either a re-run on a not-yet-shipped PR
 * (the previous run made it partway through) or a post-publish paperwork
 * pass after the artifact already shipped.
 *
 * Treats recovered release notes as the authoritative description of
 * v${next_version}. Normally that is pin-time `## Unreleased`; for
 * fragment-based releases it is the already-prepared `## v${next_version}`
 * section from the release branch or shipped tag. The promotion helper
 * smart-subtracts that body from current Unreleased when it is present so
 * post-pin drift on `<base>` is preserved as future-release work.
 *
 * The model is not invoked here. Pin-time Unreleased was authored by the
 * operator; the harness just promotes it deterministically.
 */
fn apply_fixup_release_notes(harness: Harness, cfg, analysis) {
  let changelog_path = path_join(cfg.repo, "CHANGELOG.md")
  if !cfg.mock && !harness.fs.exists(changelog_path) {
    return fail(1, "missing CHANGELOG.md")
  }
  let release_body = trim(cfg.fixup_pin_unreleased ?? "")
  if release_body == "" {
    return fail(
      1,
      "fixup mode set but no release-note body cached; the pin SHA and existing release branch may be unreadable",
    )
  }
  let original = read_repo_file(harness, cfg, "CHANGELOG.md")
  let update = changelog_promote_pin_time_unreleased(original, analysis.next_version, release_body)
  if !update.success {
    return fail(1, update.message)
  }
  if update.changed && !cfg.mock {
    harness.fs.write_text(changelog_path, update.text)
  }
  // The inline step printer renders only the step name (`✓ name`), so a
  // step whose only signal is a multi-line stdout body is effectively
  // silent during a live run. Surface the duplicate-bullets state loudly
  // so the operator can't merge the PR without first deduping by hand.
  if (update.subtract_path ?? "") == "fallback" {
    let pin_count = changelog_bullet_count(release_body)
    harness.stdio
      .println(
      "!! drift: smart-subtract fell back to verbatim-preserve; ${pin_count} pin-time bullets are duplicated between `## Unreleased` and `## v${analysis.next_version}` and need manual dedupe before merge",
    )
  }
  return ok("ok: " + update.message + "\n")
}

/**
 * Detect repair / fixup state for `analysis.next_version`.
 *
 * Returns `nil` when this is a normal first-time release. Returns
 * `{tag, pr_url, original_pin, pin_unreleased, release_body_source, tag_exists, release_exists, missing_assets}`
 * when an open release/v${next_version} PR exists on `<base>`.
 *
 * Two flavors collapse into one detection path:
 *   - Re-run on a still-open release PR (artifact may or may not have
 *     shipped). The previous run got partway and left the PR open;
 *     we need to recreate the branch, fix any content regressions,
 *     and force-push.
 *   - Documented post-publish drift: required release assets shipped,
 *     operator added more bullets to Unreleased that describe the NEXT
 *     release; the re-run should land the v${next_version} paperwork
 *     without clobbering those drift bullets.
 *
 * Both share the same recovery: recover the original pin SHA via
 * `git merge-base origin/release/v$ver origin/<base>`, then read
 * pin-time `## Unreleased` from that commit. That gives us the bullets
 * the operator INTENDED to ship — the source of truth regardless of
 * what was actually published (in case the original ship truncated
 * the changelog).
 *
 * Conservative gating:
 *   - mock/audit/non-live runs never auto-detect.
 *   - Pin-time CHANGELOG must be readable, otherwise we can't recover.
 */
fn detect_fixup_state(cfg, analysis) {
  if cfg.mock {
    return nil
  }
  if cfg.mode != "ship-pr" || !(cfg.yes_live_release ?? false) {
    return nil
  }
  let version = trim(analysis.next_version ?? "")
  if version == "" {
    return nil
  }
  let tag = "v${version}"
  let branch = "release/" + tag
  let pr_check = run_gh(
    cfg,
    [
      "pr",
      "list",
      "--base",
      cfg.base,
      "--head",
      branch,
      "--state",
      "open",
      "--json",
      "url",
      "--jq",
      ".[0].url // \"\"",
    ],
  )
  if !pr_check.success {
    return nil
  }
  let pr_url = trim(pr_check.stdout)
  if pr_url == "" {
    return nil
  }
  // Recover the original pin SHA: the common ancestor of the existing
  // release branch and the current base. That commit was `<base>` HEAD
  // when the original run started, and is the point we want pin-time
  // Unreleased read from.
  let merge_base = run_git(cfg, ["merge-base", "origin/" + branch, "origin/" + cfg.base])
  if !merge_base.success {
    return nil
  }
  let original_pin = trim(merge_base.stdout)
  if original_pin == "" {
    return nil
  }
  let pin_show = run_git(cfg, ["show", original_pin + ":CHANGELOG.md"])
  if !pin_show.success {
    return nil
  }
  // Optional informational signals — control which gates we skip but do
  // not gate detection itself.
  let tag_check = run_git(cfg, ["ls-remote", "origin", "refs/tags/" + tag])
  let tag_exists = tag_check.success && trim(tag_check.stdout) != ""
  let release_body_ref = if tag_exists {
    tag
  } else {
    "origin/" + branch
  }
  let release_show = run_git(cfg, ["show", release_body_ref + ":CHANGELOG.md"])
  if !release_show.success && tag_exists {
    release_body_ref = "origin/" + branch
    release_show = run_git(cfg, ["show", release_body_ref + ":CHANGELOG.md"])
  }
  if !release_show.success {
    return nil
  }
  let release_body = changelog_fixup_release_body(pin_show.stdout, release_show.stdout, version)
  if !release_body.success {
    return nil
  }
  let release_body_source = if release_body.source == "release-section" {
    if release_body_ref == tag {
      "tag-release-section"
    } else {
      "branch-release-section"
    }
  } else {
    release_body.source
  }
  let release_assets = release_asset_snapshot(cfg, tag)
  let release_exists = release_assets.ready
  // Conflict state on the existing PR. After other PRs land on `<base>`
  // and touch CHANGELOG.md, release/v$ver collides at the top of
  // CHANGELOG. The repair pass resolves this implicitly by recreating
  // the branch on fresh `<base>` and smart-subtracting pin-time
  // bullets — surface the conflict explicitly so the operator can see
  // the rerun is doing conflict-resolution work.
  let mergeable_check = run_gh(cfg, ["pr", "view", pr_url, "--json", "mergeable", "--jq", ".mergeable"])
  let conflicting = mergeable_check.success && trim(mergeable_check.stdout) == "CONFLICTING"
  return {
    tag: tag,
    pr_url: pr_url,
    original_pin: original_pin,
    pin_unreleased: release_body.body,
    release_body_source: release_body_source,
    tag_exists: tag_exists,
    release_exists: release_exists,
    missing_assets: release_assets.missing_assets,
    conflicting: conflicting,
  }
}

fn with_fixup_state(cfg, fixup) {
  if fixup == nil {
    return cfg
  }
  return {
    ...cfg,
    fixup_mode: true,
    skip_tag: fixup.tag_exists,
    fixup_tag: fixup.tag,
    fixup_pr_url: fixup.pr_url,
    fixup_pin_unreleased: fixup.pin_unreleased,
    fixup_release_body_source: fixup.release_body_source ?? "",
  }
}

fn analysis_with_fixup_state(raw, fixup) {
  if fixup == nil {
    return {
      ...raw,
      fixup_mode: false,
      fixup_tag: "",
      fixup_pr_url: "",
      fixup_release_exists: false,
      fixup_missing_assets: [],
    }
  }
  return {
    ...raw,
    fixup_mode: true,
    fixup_tag: fixup.tag,
    fixup_pr_url: fixup.pr_url,
    fixup_release_exists: fixup.release_exists,
    fixup_missing_assets: fixup.missing_assets ?? [],
  }
}

/**
 * Post-merge drift detection — third auto-mode (after fixup, before normal release).
 *
 * Fires when a previous ship-pr cycle completed (release/v$ver PR merged, binary
 * shipped) but GitHub's 3-way merge absorbed post-pin Unreleased bullets into
 * `## v$ver` on `<base>`. The published binary doesn't contain those bullets;
 * the CHANGELOG entry on `<base>` lies about what shipped. `release-pr-drift-check`
 * warns about this on the release PR, but if the check wasn't required, auto-merge
 * fires anyway and only the CHANGELOG ends up wrong. This detection lets the next
 * `release_harn` re-run open a paperwork-only PR that restores `## v$ver` to
 * pin-time content and moves the absorbed drift into `## Unreleased`.
 *
 * Conservative gating — `nil` unless ALL hold:
 *   - live ship-pr (`--mode ship-pr --yes-live-release`, not mock/audit)
 *   - working tree has no candidate release content (no in-flight release work)
 *   - latest published version (`analysis.current_version`) is FULLY published:
 *     crates.io + every required GitHub release asset.
 *   - no open `release/v$current` PR (existing fixup_state handles that)
 *   - pin-time `## Unreleased` (read from `git merge-base v$current origin/<base>`)
 *     differs from current `## v$current` body on `<base>`.
 *
 * Returns `{kind: "drift", tag, version, original_pin, pin_unreleased,
 *   current_section, paperwork_branch}` when drift is detected and the
 *   paperwork PR should be opened.
 *
 * Returns `{kind: "paperwork_pr_open", pr_url, paperwork_branch}` when a
 *   paperwork PR for this version is already open (idempotent re-run).
 */
fn detect_post_merge_drift(cfg, analysis) {
  if cfg.mock {
    return nil
  }
  if cfg.mode != "ship-pr" || !(cfg.yes_live_release ?? false) {
    return nil
  }
  if (analysis.dirty_files ?? 0) > 0 {
    return nil
  }
  let version = trim(analysis.current_version ?? "")
  if version == "" {
    return nil
  }
  let tag = "v${version}"
  let branch = "release/" + tag
  let paperwork_branch = "paperwork/v${version}-changelog-fix"
  let release_assets = release_asset_snapshot(cfg, tag)
  if !release_assets.ready {
    return nil
  }
  if !harn_crate_published(version) {
    return nil
  }
  let pr_check = run_gh(
    cfg,
    [
      "pr",
      "list",
      "--base",
      cfg.base,
      "--head",
      branch,
      "--state",
      "open",
      "--json",
      "url",
      "--jq",
      ".[0].url // \"\"",
    ],
  )
  if pr_check.success && trim(pr_check.stdout) != "" {
    return nil
  }
  let paperwork_check = run_gh(
    cfg,
    [
      "pr",
      "list",
      "--base",
      cfg.base,
      "--head",
      paperwork_branch,
      "--state",
      "open",
      "--json",
      "url",
      "--jq",
      ".[0].url // \"\"",
    ],
  )
  if paperwork_check.success && trim(paperwork_check.stdout) != "" {
    return {
      kind: "paperwork_pr_open",
      pr_url: trim(paperwork_check.stdout),
      paperwork_branch: paperwork_branch,
    }
  }
  let tag_check = run_git(cfg, ["ls-remote", "origin", "refs/tags/" + tag])
  if !tag_check.success || trim(tag_check.stdout) == "" {
    return nil
  }
  let tag_line_parts = split(trim(tag_check.stdout), "\t")
  let tag_sha = if len(tag_line_parts) > 0 {
    trim(tag_line_parts[0])
  } else {
    ""
  }
  if tag_sha == "" {
    return nil
  }
  let merge_base = run_git(cfg, ["merge-base", tag_sha, "origin/" + cfg.base])
  if !merge_base.success {
    return nil
  }
  let original_pin = trim(merge_base.stdout)
  if original_pin == "" {
    return nil
  }
  let pin_show = run_git(cfg, ["show", original_pin + ":CHANGELOG.md"])
  if !pin_show.success {
    return nil
  }
  let pin_unreleased = changelog_named_section_from_text(pin_show.stdout, "## Unreleased")
  if trim(pin_unreleased) == "" {
    return nil
  }
  let main_show = run_git(cfg, ["show", "origin/" + cfg.base + ":CHANGELOG.md"])
  if !main_show.success {
    return nil
  }
  let current_section = changelog_named_section_from_text(main_show.stdout, "## v" + version)
  if trim(current_section) == "" {
    return nil
  }
  if trim(current_section) == trim(pin_unreleased) {
    return nil
  }
  return {
    kind: "drift",
    tag: tag,
    version: version,
    original_pin: original_pin,
    pin_unreleased: pin_unreleased,
    current_section: current_section,
    paperwork_branch: paperwork_branch,
  }
}

/**
 * Open a paperwork-only PR that restores `## v${version}` to pin-time content
 * and moves drift bullets into `## Unreleased`. Called when
 * `detect_post_merge_drift` returns `kind: "drift"`. Sets `Allow-Retroactive-Changelog`
 * commit trailer + the matching env var on push to bypass the harn-repo's
 * retroactive-edit guard.
 *
 * Returns the exit code (0 success, non-zero failure). The caller short-circuits
 * the normal release flow when this is invoked.
 */
fn run_post_merge_paperwork_pr(harness: Harness, cfg, drift, run_id) {
  let version = drift.version
  let tag = drift.tag
  let paperwork_branch = drift.paperwork_branch
  let pin_short = drift.original_pin[0:10]
  harness.stdio.println("== post-merge paperwork mode (CHANGELOG drift detected for ${tag})")
  harness.stdio.println("   pin SHA   : ${drift.original_pin}")
  harness.stdio.println("   branch    : ${paperwork_branch}")
  harness.stdio
    .println(
    "   plan      : restore `## ${tag}` to pin-time Unreleased; move drift bullets back into `## Unreleased`; force-push paperwork branch; open PR with auto-merge.",
  )
  release_log_event(
    harness,
    run_id,
    "post_merge_drift_detected",
    {tag: tag, version: version, original_pin: drift.original_pin, paperwork_branch: paperwork_branch},
  )
  let fetch_result = run_git(cfg, ["fetch", "origin", cfg.base])
  if !fetch_result.success {
    harness.stdio.println("!! fetch ${cfg.base} failed: ${trim(fetch_result.stderr)}")
    return 1
  }
  let branch_create = run_git(cfg, ["checkout", "-B", paperwork_branch, "origin/" + cfg.base])
  if !branch_create.success {
    harness.stdio.println("!! branch create failed: ${trim(branch_create.stderr)}")
    return 1
  }
  let changelog_path = path_join(cfg.repo, "CHANGELOG.md")
  let original = harness.fs.read_text(changelog_path)
  let update = changelog_repair_post_merge_drift(original, version, drift.pin_unreleased)
  if !update.success {
    harness.stdio.println("!! post-merge repair failed: ${update.message}")
    return 1
  }
  if !update.changed {
    harness.stdio
      .println("== post-merge paperwork: no changes needed (CHANGELOG matches pin-time already)")
    return 0
  }
  harness.fs.write_text(changelog_path, update.text)
  harness.stdio.println("== ${update.message}")
  let stage = run_git(cfg, ["add", "CHANGELOG.md"])
  if !stage.success {
    harness.stdio.println("!! git add failed: ${trim(stage.stderr)}")
    return 1
  }
  let commit_subject = "changelog: restore ${tag} shipped content after drift"
  let commit_body = "The ${tag} release branch merged with drift in `## ${tag}`:\nbullets that landed on `${cfg.base}` between the pin SHA ${pin_short}\nand the release PR merge were absorbed by GitHub's 3-way merge into\nthe ${tag} section. The shipped binary (tag ${tag} pinned at\n${pin_short}) does not contain these post-pin bullets; only the\nCHANGELOG entry lies.\n\nThis paperwork PR restores `## ${tag}` to the pin-time `## Unreleased`\ncontent and moves the absorbed drift bullets back to `## Unreleased`,\nwhere they will ship in the next release.\n\nAuto-generated by release_harn.harn post-merge drift detection.\n\nAllow-Retroactive-Changelog: post-merge drift cleanup: bullets did not\nship in ${tag}'s binary (tag is parented before the post-pin commits);\nthis PR aligns the published `${tag}` section with what shipped."
  let full_commit = commit_subject + "\n\n" + commit_body
  let commit = run_git(cfg, ["commit", "-m", full_commit], {env: {ALLOW_CHANGELOG_RETROACTIVE_EDIT: "1"}})
  if !commit.success {
    harness.stdio.println("!! git commit failed: ${trim(commit.stderr)}")
    return 1
  }
  let push = run_git(
    cfg,
    ["push", "-u", "origin", paperwork_branch, "--force-with-lease"],
    {env: {ALLOW_CHANGELOG_RETROACTIVE_EDIT: "1"}},
  )
  if !push.success {
    harness.stdio.println("!! git push failed: ${trim(push.stderr)}")
    return 1
  }
  let pr_title = "changelog: post-merge paperwork for ${tag}"
  let pr_body = "## Summary\n- Post-merge drift detected on `${cfg.base}` for shipped tag `${tag}` (pin SHA ${pin_short}). Bullets that landed during the release PR window were absorbed by GitHub's 3-way merge into `## ${tag}`, but did not ship in the binary.\n- This PR restores `## ${tag}` to the pin-time `## Unreleased` content and moves the absorbed drift bullets back to `## Unreleased` where they belong.\n\nPure paperwork: no source changes, no version bumps, no retagging.\n\n## Auto-generated\nOpened by `release_harn.harn` post-merge drift detection. Re-running `release_harn.harn -- --mode ship-pr --yes-live-release` after this lands will be a no-op because the auto-detector exits when `## ${tag}` already matches pin-time."
  let pr_create = run_gh(
    cfg,
    [
      "pr",
      "create",
      "--base",
      cfg.base,
      "--head",
      paperwork_branch,
      "--title",
      pr_title,
      "--body",
      pr_body,
    ],
  )
  if !pr_create.success {
    harness.stdio.println("!! gh pr create failed: ${trim(pr_create.stderr)}")
    return 1
  }
  let pr_url = trim(pr_create.stdout)
  harness.stdio.println("== paperwork PR opened: ${pr_url}")
  let auto_merge_attempts = gh_auto_merge_cli_attempts(release_repo_slug(cfg), pr_url, "squash")
  let auto_merge = run_gh(cfg, auto_merge_attempts[0])
  if !auto_merge.success {
    let auto_merge_retry = if len(auto_merge_attempts) > 1 {
      run_gh(cfg, auto_merge_attempts[1])
    } else {
      auto_merge
    }
    if !auto_merge_retry.success {
      harness.stdio.println("!! could not enable auto-merge on ${pr_url}: ${trim(auto_merge.stderr)}")
    }
  }
  release_log_event(
    harness,
    run_id,
    "post_merge_paperwork_pr_opened",
    {pr_url: pr_url, paperwork_branch: paperwork_branch, tag: tag},
  )
  return 0
}

// Don't fail the whole run — the PR is open and reviewable.
/**
 * Detect `--repin-latest` state for `analysis.next_version`.
 *
 * Returns `nil` unless the operator passed `--repin-latest` AND this is a
 * live ship-pr run. Throws (with an actionable message) when the operator
 * asked for repin but the preconditions aren't met:
 *   - The v$next release already shipped. crates.io is immutable — the
 *     pin cannot be advanced for a published release. The operator must
 *     bump to v$next+1 instead.
 *   - No open `release/v$next` PR exists. `--repin-latest` is a "second
 *     take" — for a first-time release the operator uses normal prepare.
 *
 * On success returns `{tag, pr_url, initial_remote_tag_sha}`. The
 * `initial_remote_tag_sha` is captured for a TOCTTOU re-check right
 * before the destructive branch reset.
 */
fn detect_repin_state(cfg, analysis) {
  if !(cfg.repin_latest ?? false) {
    return nil
  }
  if cfg.mock {
    return nil
  }
  if cfg.mode != "ship-pr" || !(cfg.yes_live_release ?? false) {
    throw "--repin-latest requires --mode ship-pr --yes-live-release"
  }
  let version = trim(analysis.next_version ?? "")
  if version == "" {
    throw "--repin-latest could not resolve next version from CHANGELOG/Cargo state"
  }
  let tag = "v${version}"
  let release_check = run_gh(cfg, ["release", "view", tag, "--json", "tagName", "--jq", ".tagName"])
  if release_check.success && trim(release_check.stdout) == tag {
    throw "--repin-latest refused: release ${tag} already exists on origin. Re-shipping a published version is impossible (crates.io is immutable); bump to v$next+1 instead."
  }
  let branch = "release/" + tag
  let pr_check = run_gh(
    cfg,
    [
      "pr",
      "list",
      "--base",
      cfg.base,
      "--head",
      branch,
      "--state",
      "open",
      "--json",
      "url",
      "--jq",
      ".[0].url // \"\"",
    ],
  )
  if !pr_check.success {
    throw "--repin-latest could not query open release PRs: ${trim(pr_check.stderr)}"
  }
  let pr_url = trim(pr_check.stdout)
  if pr_url == "" {
    throw "--repin-latest refused: no open release/${tag} PR found. --repin-latest advances an in-flight PR's pin; for a first-time release use --mode ship-pr without --repin-latest."
  }
  let ls = run_git(cfg, ["ls-remote", "origin", "refs/tags/" + tag])
  if !ls.success {
    throw "--repin-latest could not list remote tag ${tag}: ${trim(ls.stderr)}"
  }
  return {tag: tag, pr_url: pr_url, initial_remote_tag_sha: remote_tag_sha_from_ls_remote(ls.stdout)}
}

fn with_repin_state(cfg, repin) {
  if repin == nil {
    return cfg
  }
  return {
    ...cfg,
    repin_mode: true,
    repin_tag: repin.tag,
    repin_pr_url: repin.pr_url,
    repin_initial_remote_tag_sha: repin.initial_remote_tag_sha,
  }
}

fn analysis_with_repin_state(raw, repin) {
  if repin == nil {
    return {...raw, repin_mode: false, repin_tag: "", repin_pr_url: ""}
  }
  return {...raw, repin_mode: true, repin_tag: repin.tag, repin_pr_url: repin.pr_url}
}

fn release_commit_title(line) {
  let cleaned = trim(line ?? "")
  if cleaned == "" {
    return ""
  }
  return trim(regex_replace("^[0-9a-f]+\\s+", "", cleaned))
}

fn deterministic_release_commit_notes(analysis) {
  let notes = []
  for line in split(analysis.commits_since_latest_tag ?? "", "\n") {
    let title = release_commit_title(line)
    if title == "" {
      continue
    }
    let normalized = regex_replace("^\\[codex\\]\\s+", "", title)
    notes = notes + ["- " + normalized + "."]
  }
  return notes
}

fn deterministic_release_notes(analysis) {
  let unreleased = trim(analysis.changelog_unreleased_section ?? "")
  let commit_notes = deterministic_release_commit_notes(analysis)
  let parts = ["## v${analysis.next_version}"]
  if unreleased != "" {
    parts = parts + [unreleased]
  }
  if len(commit_notes) > 0 {
    parts = parts + ["### Changed\n\n" + join(commit_notes, "\n")]
  }
  return join(parts, "\n\n")
}

fn write_deterministic_release_notes(harness: Harness, run_id, analysis) {
  let out_dir = release_run_dir(run_id)
  harness.fs.mkdir(out_dir, true)
  let path = path_join(out_dir, "deterministic-draft-changelog.md")
  harness.fs.write_text(path, deterministic_release_notes(analysis) + "\n")
  return path
}

fn release_notes_draft_path(harness: Harness, run_id, analysis, agent_review_result) {
  let draft_path = agent_review_result.draft_changelog ?? nil
  if draft_path != nil && draft_path != "" {
    return draft_path
  }
  return write_deterministic_release_notes(harness, run_id, analysis)
}

fn live_release_notes_blocker(harness: Harness, cfg, analysis) {
  if cfg.mode == "audit" || cfg.agent || analysis.changelog_top == analysis.next_version {
    return nil
  }
  if cfg.fixup_mode ?? false {
    return nil
  }
  // The deterministic notes builder promotes `## Unreleased` (plus any
  // commits-since-tag bullets) into `## v${next_version}`. Fragment-based
  // releases are equivalent because prepare folds `changelog.d` into
  // `## Unreleased` before promotion.
  let unreleased_bullets = changelog_bullet_count(analysis.changelog_unreleased_section ?? "")
  let fragment_bullets = changelog_bullet_count(assemble_repo_fragments(harness, cfg).section)
  if unreleased_bullets + fragment_bullets > 0 {
    return nil
  }
  return recorded_step(
    "release-notes-agent-required",
    "require agent-authored or manually prepared release notes before live release side effects",
    fail(
      2,
      "live ${cfg.mode} would need to draft CHANGELOG.md v${analysis.next_version}, but --agent was not enabled and `## Unreleased` is empty. Rerun with --agent so the harness can inspect PR bodies/files/diffs, add bullets to `## Unreleased`, or manually add a ## v${analysis.next_version} section before running live release.",
    ),
  )
}

fn release_run_session_view_gate(harness: Harness, cfg, analysis) {
  let gate = if cfg.mock {
    run_session_view_mock_gate()
  } else {
    let command_env = run_session_view_release_command_env(harness, cfg.repo, cfg.release_cargo_target_dir)
    run_session_view_gate(harness, cfg.repo, nil, command_env)
  }
  let note_status = if cfg.mock {
    {changed: false, paths: [], required: false, present: false, ok: true}
  } else {
    run_session_view_release_note_status(harness, cfg.repo, analysis)
  }
  let findings = []
  if !gate.ok {
    findings = findings
      + ["run/session view fixture gate failed: ${trim(gate.check.stderr ?? gate.check.stdout ?? "")}"]
  }
  if note_status.required && !note_status.present {
    findings = findings
      + [
      "run/session view contract files changed without a CHANGELOG.md or changelog.d note: "
        + join(note_status.paths, ", "),
    ]
  }
  return {...gate, release_note: note_status, findings: findings}
}

fn run_session_view_release_blocker(cfg, view_gate) {
  if cfg.mode == "audit" {
    return nil
  }
  if view_gate.ok && view_gate.release_note.ok {
    return nil
  }
  let check_msg = if view_gate.ok {
    ""
  } else {
    "fixture check failed (`${view_gate.check.command}` status ${view_gate.check.status}): "
      + trim(view_gate.check.stderr ?? view_gate.check.stdout ?? "")
  }
  let note_msg = if view_gate.release_note.required && !view_gate.release_note.present {
    "run/session view contract files changed without a human-readable CHANGELOG.md or changelog.d note: "
      + join(view_gate.release_note.paths, ", ")
  } else {
    ""
  }
  let message = trim(join([check_msg, note_msg].filter({ line -> trim(line) != "" }), "\n"))
  return recorded_step(
    "run-session-view-fixture-gate",
    "make check-run-view-fixtures and require release notes for run/session view schema changes",
    fail(2, message),
  )
}

fn ensure_release_notes_with_run_id(harness: Harness, cfg, analysis, agent_review_result, run_id) {
  let current_top = changelog_top(harness, cfg)
  if current_top == analysis.next_version {
    return [
      recorded_step(
        "release-notes-current",
        "CHANGELOG.md already starts with v${analysis.next_version}",
        ok("CHANGELOG.md already starts with v${analysis.next_version}\n"),
      ),
    ]
  }
  if cfg.fixup_mode ?? false {
    let r = apply_fixup_release_notes(harness, cfg, analysis)
    return [
      recorded_step(
        "fixup-promote-pin-time-unreleased",
        "promote pin-time `## Unreleased` to v${analysis.next_version}; smart-subtract from current Unreleased to preserve post-pin drift",
        r,
      ),
    ]
  }
  let draft_path = release_notes_draft_path(harness, run_id, analysis, agent_review_result)
  let r = apply_draft_release_notes(harness, cfg, analysis, draft_path, run_id)
  return [
    recorded_step(
      "draft-release-notes",
      "insert draft CHANGELOG.md section for v${analysis.next_version}",
      r,
    ),
  ]
}

fn prepared_release_findings(raw, original) {
  let findings = []
  if raw.changelog_top != original.next_version {
    findings = findings
      + [
      "CHANGELOG.md top entry is v${raw.changelog_top}; expected v${original.next_version} for this prepared release",
    ]
  }
  if raw.branch != original.expected_branch {
    findings = findings
      + ["current branch is ${raw.branch}; expected prepared release branch ${original.expected_branch}"]
  }
  if !raw.release_scripts.release_ship || !raw.release_scripts.release_gate {
    findings = findings + ["release scripts are missing or not executable"]
  }
  if !raw.workflows.publish_release || !raw.workflows.build_release_binaries {
    findings = findings + ["release cascade workflows are missing"]
  }
  return findings
}

fn prepared_release_analysis(raw, original) {
  return {
    ...raw,
    current_version: original.current_version,
    next_version: original.next_version,
    expected_branch: original.expected_branch,
    operator_focus: original.operator_focus ?? "",
    pin_sha: original.pin_sha ?? raw.pin_sha ?? "",
    deterministic_findings: prepared_release_findings(raw, original),
    run_session_view: original.run_session_view ?? raw.run_session_view ?? nil,
    fixup_mode: original.fixup_mode ?? raw.fixup_mode ?? false,
    fixup_tag: original.fixup_tag ?? raw.fixup_tag ?? "",
    fixup_pr_url: original.fixup_pr_url ?? raw.fixup_pr_url ?? "",
    repin_mode: original.repin_mode ?? raw.repin_mode ?? false,
    repin_tag: original.repin_tag ?? raw.repin_tag ?? "",
    repin_pr_url: original.repin_pr_url ?? raw.repin_pr_url ?? "",
  }
}

fn execution_step_count(execution) {
  return len(execution ?? [])
}

fn execution_status_summary(execution) {
  let ok = 0
  let failed = 0
  for step in execution ?? [] {
    if step.success {
      ok = ok + 1
    } else {
      failed = failed + 1
    }
  }
  if failed == 0 {
    return "all ok"
  }
  return "${ok} ok, ${failed} failed"
}

fn fixup_changelog_block(analysis) {
  let promoted = trim(markdown_multiline(analysis.changelog_section ?? ""))
  let unreleased = trim(markdown_multiline(analysis.changelog_unreleased_section ?? ""))
  let parts = [
    "**v${analysis.next_version}** (promoted from pin-time `## Unreleased`):",
    "",
    "```markdown",
    "## v${analysis.next_version}",
    "",
    promoted,
    "```",
  ]
  if unreleased != "" {
    parts = parts
      + [
      "",
      "**Held in `## Unreleased`** (post-pin drift on `${analysis.base_branch}` — describes work landing AFTER this release):",
      "",
      "```markdown",
      "## Unreleased",
      "",
      unreleased,
      "```",
    ]
  } else {
    parts = parts + ["", "_No `## Unreleased` drift since the original pin._"]
  }
  return parts.join("\n")
}

fn standard_changelog_block(analysis) {
  let body = trim(markdown_multiline(analysis.changelog_section ?? ""))
  return "```markdown\n## v${analysis.next_version}\n\n${body}\n```"
}

fn pr_body_text(analysis, agent_review_result, execution, run_id) {
  let agent_artifacts = agent_review_result.artifacts ?? {}
  let draft_path = agent_review_result.draft_changelog ?? ""
  let validation = agent_review_result.validation_findings ?? []
  let execution_summary = if execution == nil {
    "(no side-effecting steps recorded)"
  } else {
    execution_table(execution)
  }
  let pin_sha_note = if trim(analysis.pin_sha_input ?? "") == "" {
    "(`origin/${analysis.base_branch}` at run start)"
  } else {
    "(`--at-sha ${analysis.pin_sha_input}`)"
  }
  let fixup_note = if analysis.fixup_mode ?? false {
    "\n\n> **Repair pass for an existing release PR.** Recovered the original pin SHA via `git merge-base`, recreated the branch on fresh `${analysis.base_branch}`, and re-derived v${analysis.next_version} from pin-time `## Unreleased`. Post-pin bullets on the current `## Unreleased` are preserved — they describe work landing AFTER this release. Auto-merge state is left untouched so the operator can review the corrective diff before merging."
  } else if analysis.repin_mode ?? false {
    "\n\n> **Repin pass: advanced pin to fresh `${analysis.base_branch}` HEAD.** TOCTTOU re-checked (no shipped release, remote tag unchanged) immediately before resetting the release branch. v${analysis.next_version} now folds in every commit that landed on `${analysis.base_branch}` after the original pin. The previous tag was deleted on origin and re-pushed at the new pin; `publish-release.yml` will fire on the new tag."
  } else {
    ""
  }
  let tag_publish_note = if analysis.fixup_mode ?? false {
    "tag handling depends on origin state: skipped if `v${analysis.next_version}` already exists on origin (artifact shipped); otherwise pushed pre-PR like a normal first-time release."
  } else if analysis.repin_mode ?? false {
    "stale `v${analysis.next_version}` tag deleted on origin and re-pushed at the new pin; `publish-release.yml` ships from the freshly pushed tag."
  } else {
    "pushed pre-PR; `publish-release.yml` ships from the tag so post-PR drift on `${analysis.base_branch}` cannot leak into the artifact."
  }
  let changelog_block = if analysis.fixup_mode ?? false {
    fixup_changelog_block(analysis)
  } else {
    standard_changelog_block(analysis)
  }
  let run_session_view = analysis.run_session_view ?? {}
  let view_check = run_session_view.check ?? {}
  let view_note = run_session_view.release_note ?? {}
  let view_summary = run_session_view.summary_line ?? "unknown"
  let view_fixture_status = if view_check.success ?? false {
    "passed"
  } else {
    "failed"
  }
  let view_release_note = if view_note.required ?? false {
    if view_note.present ?? false {
      "contract files changed; release note present"
    } else {
      "contract files changed; release note missing"
    }
  } else {
    "no contract-file change detected"
  }
  return render(
    prompt_asset("release_pr_body.harn.prompt"),
    {
      next_version: analysis.next_version,
      run_id: run_id ?? "",
      fixup_note: fixup_note,
      tag_publish_note: tag_publish_note,
      current_version: analysis.current_version,
      branch: analysis.branch,
      base_branch: analysis.base_branch,
      pin_sha: analysis.pin_sha ?? "(unset)",
      pin_sha_note: pin_sha_note,
      latest_tag: analysis.latest_tag,
      changelog_block: changelog_block,
      run_session_view_summary: view_summary,
      run_session_view_fixture_status: view_fixture_status,
      run_session_view_release_note: view_release_note,
      commits_since_latest_tag: analysis.commits_since_latest_tag,
      execution_summary: execution_summary,
      execution_step_count: execution_step_count(execution),
      execution_status_summary: execution_status_summary(execution),
      audit_transcript: agent_artifacts.llm_transcript_jsonl ?? "not generated",
      draft_changelog: draft_path,
      validation_findings: if len(validation) == 0 {
        "none"
      } else {
        validation.join("; ")
      },
    },
  )
}

fn execution_table(execution) {
  let lines = ["| Step | Status | Classification |", "|------|--------|----------------|"]
  for step in execution {
    let status = if step.success {
      "ok"
    } else {
      "failed (${step.status})"
    }
    lines = lines + ["| `${step.name}` | ${status} | `${step.classification ?? ""}` |"]
  }
  return lines.join("\n")
}

fn write_pr_body(harness: Harness, run_id, analysis, agent_review_result, execution) {
  let body_path = path_join(release_run_dir(run_id), "pr-body.md")
  harness.fs.mkdir(dirname(body_path), true)
  harness.fs.write_text(body_path, pr_body_text(analysis, agent_review_result, execution, run_id))
  return body_path
}

fn append_pr_auto_merge_steps(harness: Harness, cfg, steps, pr_url, run_id) {
  if pr_url == "" {
    return {
      steps: steps
        + [
        recorded_step(
          "auto-merge",
          "gh pr merge <pr-url> --auto",
          fail(2, "could not determine PR URL for release PR"),
        ),
      ],
      success: false,
      pr_url: "",
    }
  }
  let probe_argv = ["gh", "pr", "view", pr_url, "--json", "autoMergeRequest", "--jq", ".autoMergeRequest != null"]
  let probe = logged_github_command_step(harness, cfg, steps, "inspect-auto-merge", probe_argv, run_id)
  let out = probe.steps
  if !probe.success {
    return {steps: out, success: false, pr_url: pr_url}
  }
  if trim(probe.stdout) == "true" {
    out = out
      + [
      recorded_step(
        "auto-merge-already-enabled",
        "autoMergeRequest present on " + pr_url,
        ok("release PR already has auto-merge enabled\n"),
      ),
    ]
    return {steps: out, success: true, pr_url: pr_url}
  }
  // Fixup mode means we're repairing an existing release PR. The operator
  // typically disabled auto-merge so they can review the corrective diff
  // before letting it land — re-enabling would defeat that.
  if cfg.fixup_mode ?? false {
    out = out
      + [
      recorded_step(
        "auto-merge-skipped",
        "fixup mode: leaving auto-merge disabled so the operator can review the repaired diff",
        ok("auto-merge state preserved (fixup mode)\n"),
      ),
    ]
    return {steps: out, success: true, pr_url: pr_url}
  }
  let attempts = gh_auto_merge_cli_attempts(release_repo_slug(cfg), pr_url, "squash")
  let auto_merge = logged_github_command_step(harness, cfg, out, "auto-merge", ["gh", ...attempts[0]], run_id)
  out = auto_merge.steps
  if auto_merge.success {
    return {steps: out, success: true, pr_url: pr_url}
  }
  if len(attempts) < 2 {
    return {steps: out, success: false, pr_url: pr_url}
  }
  let fallback = logged_github_command_step(
    harness,
    cfg,
    out,
    "auto-merge-with-squash-fallback",
    ["gh", ...attempts[1]],
    run_id,
  )
  return {steps: fallback.steps, success: fallback.success, pr_url: pr_url}
}

fn run_output_dir(run_id) {
  return release_run_dir(run_id)
}

fn crystallization_fixture_paths(run_id) {
  let out_dir = path_join(run_output_dir(run_id), "crystallization-input")
  return {
    out_dir: out_dir,
    manifest_json: path_join(out_dir, "manifest.json"),
    release_run_json: path_join(out_dir, "release-run.json"),
    deterministic_events_jsonl: path_join(out_dir, "deterministic-events.jsonl"),
    agent_events_jsonl: path_join(out_dir, "agent-events.jsonl"),
    tool_observations_jsonl: path_join(out_dir, "tool-observations.jsonl"),
    readme_md: path_join(out_dir, "README.md"),
  }
}

fn artifact_text(harness: Harness, path) {
  let p = path ?? ""
  if p == "" || !harness.fs.exists(p) {
    return ""
  }
  return harness.fs.read_text(p)
}

let FIXTURE_SCHEMA_VERSION = "release_harn.crystallization_input.v1"

type AgentReviewAttemptFixtureRecord = {
  name?: string,
  status?: string,
  text?: string,
  validation_findings?: list<string>,
  llm?: dict,
  tools?: dict,
}

let AGENT_REVIEW_ATTEMPT_FIXTURE_RECORD_SCHEMA = {
  type: "dict",
  properties: {
    name: {type: "string"},
    status: {type: "string"},
    text: {type: "string"},
    validation_findings: {type: "list", items: {type: "string"}},
    llm: {type: "dict"},
    tools: {type: "dict"},
  },
}

fn fixture_event(event_type, source, timestamp, data) {
  return {
    schema_version: FIXTURE_SCHEMA_VERSION,
    event_type: event_type,
    source: source,
    timestamp: timestamp,
    data: data,
  }
}

fn tool_event(timestamp, source, data) {
  return fixture_event("tool_observation", source, timestamp, data)
}

fn shell_tool_event(timestamp, command, stdout) {
  return tool_event(
    timestamp,
    "deterministic",
    {tool: "shell", command: command, success: true, status: 0, stdout: stdout, stderr: ""},
  )
}

fn read_file_tool_event(timestamp, path, stdout) {
  return tool_event(
    timestamp,
    "deterministic",
    {tool: "read_file", path: path, success: true, status: 0, stdout: stdout, stderr: ""},
  )
}

fn artifact_snapshot(harness: Harness, artifacts, optional_keys) {
  let snap: dict = {
    raw_result_json_path: artifacts.raw_result_json ?? "",
    raw_result_json: artifact_text(harness, artifacts.raw_result_json ?? ""),
    trace_json_path: artifacts.trace_json ?? "",
    trace_json: artifact_text(harness, artifacts.trace_json ?? ""),
    llm_transcript_jsonl_path: artifacts.llm_transcript_jsonl ?? "",
    llm_transcript_jsonl: artifact_text(harness, artifacts.llm_transcript_jsonl ?? ""),
  }
  for key in optional_keys ?? [] {
    snap = snap
      + {[key + "_path"]: artifacts[key] ?? "", [key]: artifact_text(harness, artifacts[key] ?? "")}
  }
  return snap
}

fn deterministic_fixture_events(payload) {
  let a = payload.analysis
  let events = [
    fixture_event(
      "release_analysis",
      "deterministic",
      payload.started_iso,
      {
        repo: a.repo,
        mode: a.mode,
        mock: a.mock,
        bump: a.bump,
        starting_branch: a.branch,
        target_release_branch: a.expected_branch,
        base_branch: a.base_branch,
        current_version: a.current_version,
        next_version: a.next_version,
        latest_tag: a.latest_tag,
        git_log_range: release_log_range_arg(a.latest_tag, a.pin_sha ?? ""),
        dirty_files: a.dirty_files,
        status: a.status,
      },
    ),
    fixture_event(
      "changelog_audit_inputs",
      "deterministic",
      payload.started_iso,
      {
        expected_version: a.next_version,
        changelog_top: a.changelog_top,
        changelog_section: a.changelog_section,
        changelog_unreleased_section: a.changelog_unreleased_section ?? "",
        commits_since_latest_tag: a.commits_since_latest_tag,
        commit_stats_since_latest_tag: a.commit_stats_since_latest_tag,
        commit_file_changes_since_latest_tag: a.commit_file_changes_since_latest_tag,
        post_tag_pr_numbers: a.post_tag_pr_numbers ?? [],
        post_tag_pr_details: a.post_tag_pr_details ?? "",
      },
    ),
  ]
  for finding in a.deterministic_findings {
    events = events
      + [fixture_event("deterministic_finding", "deterministic", payload.finished_iso, {finding: finding})]
  }
  for step in payload.execution ?? [] {
    events = events
      + [
      fixture_event(
        "release_step_recorded",
        "deterministic",
        payload.finished_iso,
        {
          name: step.name,
          command: step.command,
          success: step.success,
          status: step.status,
          classification: step.classification ?? "",
          recovery_hint: step.recovery_hint ?? "",
        },
      ),
    ]
  }
  return events
}

fn agent_artifact_snapshot(harness: Harness, agent_detail) {
  return artifact_snapshot(harness, agent_detail.artifacts ?? {}, ["draft_changelog_md"])
}

fn recovery_artifact_snapshot(harness: Harness, step) {
  return artifact_snapshot(harness, step.artifacts ?? {}, ["advice_md"])
}

fn agent_attempt_fixture_name(index: int, attempt: AgentReviewAttemptFixtureRecord) -> string {
  let name = attempt.name ?? ""
  if name != "" {
    return name
  }
  return "attempt-" + to_string(index + 1)
}

fn agent_attempt_fixture_event(index: int, attempt: AgentReviewAttemptFixtureRecord, ts: string) {
  return fixture_event(
    "agent_review_attempt",
    "agent",
    ts,
    {
      index: index,
      name: agent_attempt_fixture_name(index, attempt),
      status: attempt.status ?? "",
      text: attempt.text ?? "",
      validation_findings: attempt.validation_findings ?? [],
      llm: attempt.llm ?? {},
      tools: attempt.tools ?? {},
    },
  )
}

fn invalid_agent_attempt_fixture_event(index, attempt, ts) {
  let report = schema_report(attempt, AGENT_REVIEW_ATTEMPT_FIXTURE_RECORD_SCHEMA, false)
  return fixture_event(
    "agent_review_attempt_invalid",
    "agent",
    ts,
    {
      index: index,
      observed_type: type_of(attempt),
      reason: report.message ?? "agent review attempt record was missing or malformed",
      issues: report.issues ?? [],
    },
  )
}

pub fn agent_fixture_events(harness: Harness, payload) {
  let detail = payload.agent_review_detail ?? {}
  let attempts = detail.attempts ?? []
  let ts = payload.finished_iso
  let events = []
  if len(attempts) == 0 {
    events = events + [fixture_event("agent_review_skipped", "agent", ts, {reason: payload.agent_review})]
  }
  for {index, value} in attempts.enumerate() {
    let attempt = value
    if schema_is(attempt, AGENT_REVIEW_ATTEMPT_FIXTURE_RECORD_SCHEMA) {
      events = events + [agent_attempt_fixture_event(index, attempt, ts)]
    } else {
      events = events + [invalid_agent_attempt_fixture_event(index, attempt, ts)]
    }
  }
  if len(attempts) > 0 {
    events = events
      + [fixture_event("agent_review_artifacts", "agent", ts, agent_artifact_snapshot(harness, detail))]
  }
  for step in payload.execution ?? [] {
    if starts_with(step.name, "agent-recovery-advice-") {
      events = events
        + [
        fixture_event(
          "agent_recovery_advice",
          "agent",
          ts,
          {
            step_name: step.name,
            status: step.agent_status ?? "",
            text: step.stdout,
            llm: step.llm ?? {},
            tools: step.tools ?? {},
            artifacts: recovery_artifact_snapshot(harness, step),
          },
        ),
      ]
    }
  }
  return events
}

fn tool_observation_events(payload) {
  let a = payload.analysis
  let ts = payload.started_iso
  let log_range = release_log_range_arg(a.latest_tag, a.pin_sha ?? "")
  let events = [
    shell_tool_event(ts, "git status --porcelain --untracked-files=normal", a.status),
    shell_tool_event(ts, "git diff HEAD --stat", a.diff_stat),
    shell_tool_event(ts, "git log --oneline --no-merges " + log_range, a.commits_since_latest_tag),
    shell_tool_event(
      ts,
      "git log --name-status --pretty=format:'commit %h %s' --no-merges " + log_range,
      a.commit_file_changes_since_latest_tag,
    ),
    read_file_tool_event(ts, "CHANGELOG.md", a.changelog_section),
    read_file_tool_event(ts, "CHANGELOG.md#Unreleased", a.changelog_unreleased_section ?? ""),
  ]
  for step in payload.execution ?? [] {
    let is_recovery = starts_with(step.name, "agent-recovery-advice-")
    events = events
      + [
      tool_event(
        payload.finished_iso,
        if is_recovery {
          "agent"
        } else {
          "deterministic"
        },
        {
          tool: if is_recovery {
            "agent_loop"
          } else {
            "shell"
          },
          step_name: step.name,
          command: step.command,
          success: step.success,
          status: step.status,
          classification: step.classification ?? "",
          recovery_hint: step.recovery_hint ?? "",
          stdout: step.stdout,
          stderr: step.stderr,
        },
      ),
    ]
  }
  return events
}

fn fixture_manifest(run_id, payload, report_paths, paths) {
  return {
    schema_version: FIXTURE_SCHEMA_VERSION,
    kind: "release_harn_crystallization_input",
    generated_by: "release_harn.harn",
    generated_at: date_now_iso(),
    run_id: run_id,
    source_issue: env_str("HARN_RELEASE_SOURCE_ISSUE") ?? "",
    consumer_issue: env_str("HARN_RELEASE_CONSUMER_ISSUE") ?? "",
    source_artifacts: {release_audit_json: report_paths.json_path, release_audit_md: report_paths.md_path},
    release: {
      repo: payload.analysis.repo,
      mode: payload.analysis.mode,
      mock: payload.analysis.mock,
      current_version: payload.analysis.current_version,
      next_version: payload.analysis.next_version,
      starting_branch: payload.analysis.branch,
      target_release_branch: payload.analysis.expected_branch,
      base_branch: payload.analysis.base_branch,
      latest_tag: payload.analysis.latest_tag,
    },
    files: {
      manifest_json: paths.manifest_json,
      release_run_json: paths.release_run_json,
      deterministic_events_jsonl: paths.deterministic_events_jsonl,
      agent_events_jsonl: paths.agent_events_jsonl,
      tool_observations_jsonl: paths.tool_observations_jsonl,
      readme_md: paths.readme_md,
    },
    semantics: {
      deterministic_events: "Facts and harness decisions emitted by release_harn.harn.",
      agent_events: "Model-authored audit, changelog synthesis, and recovery advice. Not deterministic truth.",
      tool_observations: "Shell/read/tool observations with stdout/stderr preserved for replay and audit.",
    },
  }
}

fn fixture_readme(payload) {
  let a = payload.analysis
  return render(
    prompt_asset("release_fixture_readme.harn.prompt"),
    {
      repo: a.repo,
      mode: a.mode,
      mock: a.mock,
      current_version: a.current_version,
      next_version: a.next_version,
      branch: a.branch,
      expected_branch: a.expected_branch,
      latest_tag: a.latest_tag,
    },
  )
}

fn write_crystallization_fixture(harness: Harness, run_id, payload, report_paths) {
  let paths = crystallization_fixture_paths(run_id)
  harness.fs.mkdir(paths.out_dir, true)
  harness.fs
    .write_text(
    paths.release_run_json,
    json_stringify({schema_version: FIXTURE_SCHEMA_VERSION, kind: "release_harn_run", payload: payload})
      + "\n",
  )
  write_jsonl(paths.deterministic_events_jsonl, deterministic_fixture_events(payload))
  write_jsonl(paths.agent_events_jsonl, agent_fixture_events(harness, payload))
  write_jsonl(paths.tool_observations_jsonl, tool_observation_events(payload))
  harness.fs.write_text(paths.readme_md, fixture_readme(payload))
  harness.fs
    .write_text(
    paths.manifest_json,
    json_stringify(fixture_manifest(run_id, payload, report_paths, paths)) + "\n",
  )
  return {
    out_dir: paths.out_dir,
    manifest_json: paths.manifest_json,
    release_run_json: paths.release_run_json,
    deterministic_events_jsonl: paths.deterministic_events_jsonl,
    agent_events_jsonl: paths.agent_events_jsonl,
    tool_observations_jsonl: paths.tool_observations_jsonl,
    readme_md: paths.readme_md,
  }
}

fn execute_prepare(harness: Harness, cfg, analysis, agent_review_result, run_id) {
  require_live_confirmation(cfg)
  release_log_event(
    harness,
    run_id,
    "phase_started",
    {phase: "prepare", message: "starting release branch setup and prepare"},
  )
  let steps = []
  let initial_target_state = target_release_checkout_state(harness, cfg, analysis)
  if initial_target_state.matches {
    steps = steps
      + [
      recorded_step(
        "prepare-already-complete",
        "prepared release branch already has v${analysis.next_version} release content",
        ok(
          "skipped prepare because branch ${initial_target_state.branch}, Cargo version ${initial_target_state.current_version}, and CHANGELOG top v${initial_target_state.changelog_top} already target v${analysis.next_version}",
        ),
      ),
    ]
    release_log_event(
      harness,
      run_id,
      "phase_finished",
      {phase: "prepare", success: true, already_complete: true},
    )
    return steps
  }
  steps = setup_release_branch(harness, cfg, analysis)
  if execution_failed(steps) {
    release_log_event(
      harness,
      run_id,
      "phase_failed",
      {phase: "prepare", failed_step: recovery_step_ref(last_failed_step(steps))},
    )
    return add_recovery_for_last_failure(harness, cfg, analysis, steps, run_id)
  }
  // Fixup: replace `release_ship.sh --prepare` (~110s of Cargo.toml
  // workspace bumps + generator reruns + pre-commit `cargo check`) with
  // a cherry-pick of the existing release branch's prepare commits onto
  // fresh `<base>`. The smart-subtract CHANGELOG writer that runs next
  // is the source of truth for CHANGELOG.md, so any CHANGELOG hunks the
  // cherry-pick applied get reset to HEAD here — otherwise smart-subtract
  // would see `## v$ver` already present and short-circuit, leaving
  // potentially duplicated bullets between Unreleased and v$ver.
  if cfg.fixup_mode ?? false {
    steps = execute_fixup_cherry_pick(harness, cfg, analysis, steps, run_id)
    if execution_failed(steps) {
      release_log_event(
        harness,
        run_id,
        "phase_failed",
        {phase: "prepare", failed_step: recovery_step_ref(last_failed_step(steps))},
      )
      return add_recovery_for_last_failure(harness, cfg, analysis, steps, run_id)
    }
    release_log_event(harness, run_id, "step_started", {step: "fixup-reset-changelog"})
    let reset = append_command_step(
      harness,
      cfg,
      steps,
      "fixup-reset-changelog",
      ["git", "checkout", "HEAD", "--", "CHANGELOG.md"],
    )
    steps = reset.steps
    release_log_event(
      harness,
      run_id,
      "step_finished",
      {step: "fixup-reset-changelog", success: reset.success, status: reset.status},
    )
    if execution_failed(steps) {
      release_log_event(
        harness,
        run_id,
        "phase_failed",
        {phase: "prepare", failed_step: recovery_step_ref(last_failed_step(steps))},
      )
      return add_recovery_for_last_failure(harness, cfg, analysis, steps, run_id)
    }
  }
  release_log_event(harness, run_id, "step_started", {step: "ensure-release-notes"})
  steps = steps + ensure_release_notes_with_run_id(harness, cfg, analysis, agent_review_result, run_id)
  if execution_failed(steps) {
    release_log_event(
      harness,
      run_id,
      "phase_failed",
      {phase: "prepare", failed_step: recovery_step_ref(last_failed_step(steps))},
    )
    return add_recovery_for_last_failure(harness, cfg, analysis, steps, run_id)
  }
  if cfg.fixup_mode ?? false {
    release_log_event(harness, run_id, "phase_finished", {phase: "prepare", success: true})
    return steps
  }
  let target_state = target_release_checkout_state(harness, cfg, analysis)
  if target_state.matches {
    steps = steps
      + [
      recorded_step(
        "prepare-already-complete",
        "prepared release branch already has v${analysis.next_version} release content",
        ok(
          "skipped prepare because branch ${target_state.branch}, Cargo version ${target_state.current_version}, and CHANGELOG top v${target_state.changelog_top} already target v${analysis.next_version}",
        ),
      ),
    ]
    release_log_event(
      harness,
      run_id,
      "phase_finished",
      {phase: "prepare", success: true, already_complete: true},
    )
    return steps
  }
  let offload = resolve_audit_offload(harness, cfg, steps, run_id)
  steps = offload.steps
  let cmd = prepare_command(cfg, offload.skip_local_audit)
  let prepare = logged_live_shell_command_step(harness, cfg, steps, "prepare", cmd, run_id)
  steps = prepare.steps
  if execution_failed(steps) {
    release_log_event(
      harness,
      run_id,
      "phase_failed",
      {phase: "prepare", failed_step: recovery_step_ref(last_failed_step(steps))},
    )
    return add_recovery_for_last_failure(harness, cfg, analysis, steps, run_id)
  }
  release_log_event(harness, run_id, "phase_finished", {phase: "prepare", success: true})
  return steps
}

/**
 * Run the repin TOCTTOU re-check and return refreshed (cfg, analysis,
 * prelude_steps). Returns `failed_steps != nil` when the operator must
 * abort; otherwise mutates pin SHA in cfg/analysis to the freshly-locked
 * value.
 */
fn repin_prelude(harness: Harness, cfg, analysis, run_id) {
  if !(cfg.repin_mode ?? false) {
    return {cfg: cfg, analysis: analysis, steps: [], failed_steps: nil}
  }
  release_log_event(harness, run_id, "step_started", {step: "repin-tocttou-recheck"})
  let recheck = run_repin_tocttou_recheck(cfg, analysis)
  if !recheck.success {
    release_log_event(
      harness,
      run_id,
      "step_finished",
      {step: "repin-tocttou-recheck", success: false, message: recheck.message},
    )
    return {
      cfg: cfg,
      analysis: analysis,
      steps: [],
      failed_steps: [
        recorded_step(
          "repin-tocttou-recheck",
          "repin TOCTTOU re-check before branch reset",
          fail(2, recheck.message),
        ),
      ],
    }
  }
  let old_pin = cfg.pin_sha
  let msg = if recheck.new_pin_sha == old_pin {
    "repin: TOCTTOU re-check passed; pin unchanged at ${recheck.new_pin_sha}\n"
  } else {
    "repin: TOCTTOU re-check passed; pin advanced from ${old_pin} to ${recheck.new_pin_sha}\n"
  }
  release_log_event(
    harness,
    run_id,
    "step_finished",
    {step: "repin-tocttou-recheck", success: true, new_pin: recheck.new_pin_sha},
  )
  return {
    cfg: {...cfg, pin_sha: recheck.new_pin_sha},
    analysis: {...analysis, pin_sha: recheck.new_pin_sha},
    steps: [recorded_step("repin-tocttou-recheck", "repin TOCTTOU re-check before branch reset", ok(msg))],
    failed_steps: nil,
  }
}

@complexity(allow)
fn execute_ship_pr(harness: Harness, raw_cfg, raw_analysis, agent_review_result, run_id) {
  require_live_confirmation(raw_cfg)
  // Repin mode advances the pin to fresh `origin/<base>` HEAD. The TOCTTOU
  // re-check (re-fetch origin, re-probe release+tag, re-resolve pin) runs
  // once here so the locked pin propagates into setup_release_branch and
  // the re-analysis after prepare. Abort cleanly if anything moved.
  let pre = repin_prelude(harness, raw_cfg, raw_analysis, run_id)
  if pre.failed_steps != nil {
    return pre.failed_steps
  }
  let cfg = pre.cfg
  let analysis = pre.analysis
  let steps = pre.steps
  let pre_prepare_gate = pre_prepare_cutoff_gate(harness, cfg, analysis, steps, run_id)
  steps = pre_prepare_gate.steps
  if !pre_prepare_gate.proceed {
    return steps
  }
  steps = steps + execute_prepare(harness, cfg, analysis, agent_review_result, run_id)
  if execution_failed(steps) {
    return steps
  }
  let validation_analysis = prepared_release_analysis(analyze_release(harness, cfg), analysis)
  let validation = run_release_generated_content_checks(harness, cfg, validation_analysis, steps, run_id)
  steps = validation.steps
  if !validation.success {
    return steps
  }
  let post_prepare_analysis = prepared_release_analysis(analyze_release(harness, cfg), analysis)
  let version = post_prepare_analysis.next_version
  let branch = "release/v${version}"
  // The release gate, generated-content checks, and markdown lint have already
  // produced stronger evidence than the target repo's expensive local-build
  // hook path. Keep hooks enabled, but ask harn-side hooks to skip duplicated
  // local builds for the canonical generated release push.
  let push_argv = {argv: release_branch_push_argv(cfg, branch), env: hook_light_env()}
  let commands = []
  let committed_release_content = false
  if trim(post_prepare_analysis.status ?? "") == ""
    && trim(post_prepare_analysis.diff_names ?? "") != ""
    && post_prepare_analysis.branch == branch {
    committed_release_content = true
    steps = steps
      + [
      recorded_step(
        "commit-already-complete",
        "release branch already has v${version} commit content",
        ok(
          "skipped commit because the working tree is clean and ${branch} already differs from pin ${cfg.pin_sha}",
        ),
      ),
    ]
  } else {
    commands = commands + [{name: "stage-tracked-release-content", argv: ["git", "add", "-u"]}]
    // The release gate has already run the expensive audit, generated-content
    // checks, and markdown lint before this canonical generated commit. Keep
    // hooks enabled, but skip duplicated harn-side local builds.
    commands = commands
      + [
      {
        name: "commit",
        argv: {argv: ["git", "commit", "-m", "Release v${version}"], env: hook_light_env()},
      },
    ]
  }
  commands = commands
    + [
    {
      name: "verify-release-commit-signature",
      argv: [
        "sh",
        "-c",
        "sig=$(git log -1 --format=%G? HEAD); case \"$sig\" in N|B) echo \"release commit signature is not valid (%G?=$sig); configure commit signing or amend the release commit before publishing\" >&2; exit 1;; *) echo \"release commit signature state: $sig\";; esac",
      ],
    },
  ]
  // No `git rebase` here — pinning the release branch's parent is the
  // whole point of `cfg.pin_sha`. Rebasing onto origin/<base> would fold
  // commits that landed on main after this run started into the release.
  // We still fetch tags so the upcoming tag step sees existing remote tags.
  commands = commands + [{name: "fetch-base", argv: ["git", "fetch", "origin", "--tags", cfg.base]}]
  // Fixup mode: the originally-shipped release commit (the v$tag target)
  // is an ancestor of the published tag but NOT of fresh `<base>`, because
  // the original Release PR never merged. The harn-side
  // `verify_release_metadata.py` audit refuses to run when Cargo.toml
  // claims version X but HEAD doesn't include the X tag's commit, since
  // that means the tagged tree and the about-to-be-merged tree disagree.
  // Merge the tag with `-s ours` to bring it into HEAD's ancestry without
  // changing the tree — the harness has already laid down the
  // canonically-shipped CHANGELOG body and version bump on top of fresh
  // main, and that's the tree we want the fixup PR to land. The merge
  // commit gives the audit a path from HEAD back to the tag, so the
  // ancestry check passes; on squash-merge the merge commit is collapsed
  // away and main ends up with a single commit applying the bump.
  // Only ours-merge when the tag actually exists on origin (cfg.skip_tag
  // implies the tag is already pushed and shipped). When fixup_mode is on
  // because the PR exists but the tag was never pushed, there is no
  // shipped tag to merge in.
  if (cfg.fixup_mode ?? false) && (cfg.skip_tag ?? false) && trim(cfg.fixup_tag ?? "") != "" {
    commands = commands
      + [
      {
        name: "merge-shipped-tag-ours",
        argv: [
          "git",
          "merge",
          "--no-ff",
          "-s",
          "ours",
          cfg.fixup_tag,
          "-m",
          "Tie release/v${version} to shipped tag ${cfg.fixup_tag} (ours)",
        ],
      },
    ]
  }
  commands = commands + [{name: "push", argv: push_argv}]
  for step in commands {
    let result = logged_command_step(harness, cfg, steps, step.name, step.argv, run_id)
    steps = result.steps
    if !result.success {
      let failed_step = steps[len(steps) - 1]
      if step.name == "push" {
        steps = maybe_recovery_advice_step(harness, cfg, post_prepare_analysis, steps, failed_step, run_id)
        if push_hook_budget_exceeded(failed_step.command, failed_step) {
          let retry_argv = {argv: release_branch_push_argv(cfg, branch), env: hook_light_env()}
          let push_retry = append_command_step(harness, cfg, steps, "push-hook-light-after-green-hook-budget", retry_argv)
          steps = push_retry.steps
          if push_retry.success {
            continue
          }
        }
      } else {
        steps = maybe_recovery_advice_step(harness, cfg, post_prepare_analysis, steps, failed_step, run_id)
        let retry_commands = retry_commands_after_agent_repair(step)
        if len(retry_commands) > 0 {
          let repair_retry = run_retry_commands_after_agent_repair(harness, cfg, steps, retry_commands, run_id)
          steps = repair_retry.steps
          if repair_retry.success {
            continue
          }
        }
      }
      return steps
    }
  }
  let delete_outcome = maybe_delete_stale_repin_tag(harness, cfg, version, steps, run_id)
  steps = delete_outcome.steps
  if !delete_outcome.success {
    return steps
  }
  // The tag below fires publish-release.yml from the frozen cutoff. Prove that
  // cutoff remains in base ancestry; commits that landed later ship next time.
  let cutoff_gate = pre_tag_cutoff_gate(harness, cfg, version, steps, run_id)
  steps = cutoff_gate.steps
  if !cutoff_gate.proceed {
    return steps
  }
  // The release branch is now durable and still names the intended commit.
  // Exercise Harn's real Linux release build + size ratchet without publishing
  // anything, and block signed tag creation unless that exact SHA is green.
  if !(cfg.skip_tag ?? false) {
    const binary_gate = run_pre_tag_binary_size_gate(harness, cfg, branch, steps, run_id)
    steps = binary_gate.steps
    if !binary_gate.success {
      return steps
    }
  }
  // Push vX.Y.Z to origin BEFORE creating the PR. publish-release.yml
  // fires on this tag push and ships crates.io + the GitHub release
  // from the pinned commit; the PR that follows is paperwork (lands the
  // Cargo.toml/CHANGELOG bump on main) and doesn't influence what was
  // shipped. If the tag push fails, abort early so we don't open a PR
  // for a release that hasn't been published.
  steps = ensure_release_tag_pushed(harness, cfg, version, steps, run_id)
  if execution_failed(steps) {
    return steps
  }
  let body_path = write_pr_body(harness, run_id, post_prepare_analysis, agent_review_result, steps)
  let existing_pr_argv = [
    "gh",
    "pr",
    "list",
    "--base",
    cfg.base,
    "--head",
    branch,
    "--state",
    "open",
    "--json",
    "url",
    "--jq",
    ".[0].url // \"\"",
  ]
  let existing_pr = logged_github_command_step(harness, cfg, steps, "find-existing-pr", existing_pr_argv, run_id)
  steps = existing_pr.steps
  if !existing_pr.success {
    return steps
  }
  let pr_url = trim(existing_pr.stdout)
  if pr_url == "" {
    let create_argv = [
      "gh",
      "pr",
      "create",
      "--base",
      cfg.base,
      "--head",
      branch,
      "--title",
      "Release v${version}",
      "--body-file",
      body_path,
    ]
    let created = logged_github_command_step(harness, cfg, steps, "create-pr", create_argv, run_id)
    steps = created.steps
    if !created.success {
      return steps
    }
    pr_url = trim(created.stdout)
  } else {
    let edit_argv = ["gh", "pr", "edit", pr_url, "--title", "Release v${version}", "--body-file", body_path]
    let edited = logged_github_command_step(harness, cfg, steps, "refresh-existing-pr-body", edit_argv, run_id)
    steps = edited.steps
    if !edited.success {
      return steps
    }
  }
  let merge_handoff = append_pr_auto_merge_steps(harness, cfg, steps, pr_url, run_id)
  steps = merge_handoff.steps
  if !merge_handoff.success {
    return steps
  }
  let final_body_path = write_pr_body(harness, run_id, post_prepare_analysis, agent_review_result, steps)
  let final_edit_argv = ["gh", "pr", "edit", pr_url, "--title", "Release v${version}", "--body-file", final_body_path]
  let final_edit = logged_github_command_step(harness, cfg, steps, "refresh-pr-body-final", final_edit_argv, run_id)
  steps = final_edit.steps
  if !final_edit.success {
    return steps
  }
  // Tag + branch + PR are durable. Persist the independent monitor handoff and
  // return immediately; `watch_harn_release.harn` resumes from this receipt.
  return persist_release_watch_receipt(harness, cfg, version, steps, run_id, pr_url)
}

fn add_recovery_for_last_failure(harness: Harness, cfg, analysis, steps, run_id) {
  let failed = last_failed_step(steps)
  if failed == nil {
    return steps
  }
  let before_repair = release_repair_fingerprint(cfg)
  let recovered = maybe_recovery_advice_step(harness, cfg, analysis, steps, failed, run_id)
  if cfg.agent && failed.name == "prepare" {
    let after_repair = release_repair_fingerprint(cfg)
    if prepare_repair_changed(before_repair, after_repair) {
      return retry_prepare_after_agent_repair(harness, cfg, recovered, failed, run_id)
    }
    harness.stdio
      .println(
      "   → prepare retry skipped: recovery diagnosis made no tracked release-diff change",
    )
  }
  return recovered
}

fn restore_release_checkout_to_base(harness: Harness, cfg, execution, run_id) {
  if cfg.mock || cfg.mode != "ship-pr" || execution_failed(execution) {
    return nil
  }
  release_log_event(harness, run_id, "checkout_cleanup_started", {repo: cfg.repo, base: cfg.base})
  let runner = if cfg.mock {
    { command -> run_cmd(cfg, command) }
  } else {
    nil
  }
  let cleanup = checkout_cleanup(runner, cfg.base, cfg.repo)
  release_log_event(
    harness,
    run_id,
    "checkout_cleanup_finished",
    {
      repo: cfg.repo,
      base: cfg.base,
      success: cleanup.success,
      skipped: cleanup.skipped,
      branch: cleanup.branch,
      detail: cleanup.detail,
      warning: cleanup.warning ?? "",
      fatal: cleanup.fatal ?? false,
    },
  )
  return cleanup
}

fn write_report(harness: Harness, run_id, payload) {
  let out_dir = release_run_dir(run_id)
  harness.fs.mkdir(out_dir, true)
  let body = json_stringify(payload)
  let json_path = path_join(out_dir, "release-audit.json")
  harness.fs.write_text(json_path, body + "\n")
  let md_payload = {...payload, audit_sha: sha3_256(body)[0:16]}
  let md = render(prompt_asset("release_report.harn.prompt"), md_payload)
  let md_path = path_join(out_dir, "release-audit.md")
  harness.fs.write_text(md_path, md)
  return {json_path: json_path, md_path: md_path}
}

fn release_chat_only(harness: Harness, raw_cfg) {
  if !chat_enabled(raw_cfg) {
    harness.stdio.eprintln("--chat-only requires an interactive terminal (and HARN_CHAT != 0)")
    return 2
  }
  let kind = "release-harn"
  let target_dir = if trim(raw_cfg.chat_run ?? "") != "" {
    resolve_chat_run_path(harness, kind, raw_cfg.chat_run)
  } else {
    let pick = pick_recent_run(harness, kind, 12)
    if pick == nil {
      nil
    } else {
      pick.dir
    }
  }
  if target_dir == nil {
    harness.stdio.println("(no run selected; exiting)")
    return 0
  }
  let chat_cfg = chat_cfg_from_run_dir(
    harness,
    {
      provider: raw_cfg.provider,
      model: raw_cfg.model,
      repo: expand_home(harness, raw_cfg.repo),
      mock: raw_cfg.mock,
      timeout_s: raw_cfg.chat_timeout_s,
      tools: release_repair_tools(
        harness,
        {...raw_cfg, repo: expand_home(harness, raw_cfg.repo)},
        basename(target_dir),
      ),
      no_chat: raw_cfg.no_chat,
    },
    kind,
    target_dir,
  )
  run_chat_loop(harness, chat_cfg)
  return 0
}

/** Prompt once for a single release-shaping flag and echo any fallback note. */
fn release_prompt_flag(harness: Harness, label, choices, default_val) {
  let r = read_line({prompt: label, timeout_ms: 60000, trim: true})
  let resolved = coerce_flag_choice(r.value ?? "", r.ok ?? false, choices, default_val)
  if resolved.note != "" {
    harness.stdio.println("   ↳ ${resolved.note}")
  }
  return resolved.value
}

/**
 * On an interactive terminal, fill in the release-shaping flags the operator
 * didn't pass (`--mode`, `--bump`) with a short prompt. Gated by
 * `chat_enabled`, so CI, piped/redirected stdin, `--no-chat`, and
 * `HARN_CHAT=0` all keep today's silent-default behavior untouched. Returns
 * `cfg` with the resolved values.
 */
fn resolve_release_flags_interactively(harness: Harness, cfg, argv) {
  if !chat_enabled(cfg) {
    return cfg
  }
  let out = cfg
  if !release_flag_passed(argv, "--mode") {
    out = {
      ...out,
      mode: release_prompt_flag(
        harness,
        "ℹ No --mode given. Release mode — audit / prepare / ship-pr [audit]: ",
        ["audit", "prepare", "ship-pr"],
        "audit",
      ),
    }
  }
  if !release_flag_passed(argv, "--bump") {
    out = {
      ...out,
      bump: release_prompt_flag(
        harness,
        "ℹ No --bump given. Version bump — patch / minor / major [patch]: ",
        ["patch", "minor", "major"],
        "patch",
      ),
    }
  }
  // A non-audit mode picked interactively still needs the explicit live flag —
  // surface that so the operator isn't surprised by a read-only "live" run.
  if out.mode != "audit" && !(out.yes_live_release ?? false)
    && !release_flag_passed(argv, "--yes-live-release") {
    harness.stdio
      .println(
      "   ↳ note: live ${out.mode} side effects still require --yes-live-release; without it this run stays read-only",
    )
  }
  return out
}

/**
 * Clear a poisoned `sccache` daemon before the build-heavy `prepare` step.
 *
 * Only relevant for modes that compile (`prepare`/`ship-pr`) and never for
 * mock runs. A daemon left confined by an earlier sandboxed build (harn's
 * sandbox, a sandboxed agent shell, …) breaks every cargo build machine-wide
 * with `Operation not permitted` — which is exactly how the v0.8.82 release's
 * warm-prebuild died despite running `--no-sandbox`. See lib/sccache_preflight.
 */
fn release_sccache_preflight(harness: Harness, cfg) {
  if cfg.mock ?? false {
    return
  }
  if !(cfg.mode == "prepare" || cfg.mode == "ship-pr") {
    return
  }
  let result = ensure_healthy_sccache({ cmd -> shell(cmd) })
  if result.restarted {
    harness.stdio
      .println(
      "   ⚠ ${result.detail} — stale sandbox confinement cleared; the prepare build will spawn a fresh server",
    )
  } else if result.checked {
    harness.stdio.println("   ✓ sccache daemon healthy")
  }
}

/**
 * The bump-fleet checkout's own default branch. This is the repo
 * release_harn.harn lives in, NOT the target release repo (`cfg.repo`/`cfg.base`).
 */
fn fleet_default_branch() {
  return env_str("HARN_FLEET_DEFAULT_BRANCH") ?? "main"
}

/**
 * F4: guard against the bump-fleet checkout running its own stale release code.
 *
 * release_harn checks the TARGET repo's freshness but never its own; a stale
 * bump-fleet runs old logic and can crash mid-cut (the v0.9.21 failure). Only
 * mutating modes gate; pure audit is read-only. Fails loud with the exact
 * `git -C <root> pull --ff-only` remediation unless `--self-update` /
 * `FLEET_SELF_UPDATE=1` opted into an auto fast-forward. Never silently stale.
 */
fn release_fleet_self_check(harness: Harness, cfg, run_id) {
  if cfg.mock ?? false {
    return
  }
  if cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return
  }
  let result = fleet_self_check(
    { args -> git_run(args) },
    { p -> harness.fs.exists(p) },
    {mode: cfg.mode, opt_in: cfg.self_update ?? false, default_branch: fleet_default_branch()},
  )
  release_log_event(
    harness,
    run_id,
    "fleet_self_check",
    {
      action: result.action,
      reason: result.reason,
      fleet_root: result.fleet_root ?? "",
      remote_ref: result.remote_ref ?? "",
      local_sha: result.local_sha ?? "",
      remote_sha: result.remote_sha ?? "",
    },
  )
  if result.action == "fail" {
    harness.stdio.println("   ✗ bump-fleet self-check: ${result.reason}")
    throw "bump-fleet checkout is stale: ${result.reason}\nremediation: ${result.remediation ?? "git pull --ff-only"}"
  }
  if result.action == "autoff" {
    let ff_ok = (result.ff ?? {}).success ?? false
    if !ff_ok {
      throw "bump-fleet self-update fast-forward failed: ${(result.ff ?? {}).stderr ?? ""}\nremediation: ${result.remediation ?? "git pull --ff-only"}"
    }
    harness.stdio.println("   ↻ bump-fleet self-update: ${result.reason}")
  } else if result.action == "warn" {
    harness.stdio.println("   ⚠ bump-fleet self-check: ${result.reason}")
  } else if result.action == "proceed" {
    harness.stdio.println("   ✓ bump-fleet self-check: ${result.reason}")
  }
}

/**
 * F2/F3: heal the known-safe preflight blockers deterministically before a live
 * mutating run — a stale `release/vX.Y.Z` local branch with no open PR and no
 * unique un-pushed commits, and a base branch behind origin with a clean tree.
 * Anything not known-safe (open PR, unique work, dirty tree) fails loud instead
 * of destroying anything. Skipped for repin/fixup, which own their own branch
 * handling.
 */
fn release_preflight_autoremediate(harness: Harness, cfg, analysis, run_id) {
  if cfg.mock ?? false {
    return
  }
  if cfg.mode == "audit" || !(cfg.yes_live_release ?? false) {
    return
  }
  if (cfg.repin_mode ?? false) || (cfg.fixup_mode ?? false) {
    return
  }
  let git = { args -> run_git(cfg, args) }
  let base_result = preflight_remediate_base_behind(git, {base: cfg.base})
  release_preflight_report(harness, run_id, "base-behind", base_result)
  let version = trim(analysis.next_version ?? "")
  if version != "" {
    let open_pr_count = { branch -> release_open_pr_count(cfg, branch) }
    let branch_result = preflight_remediate_stale_release_branch(
      git,
      open_pr_count,
      {version: "v${version}", base: cfg.base},
    )
    release_preflight_report(harness, run_id, "stale-release-branch", branch_result)
  }
}

fn release_preflight_report(harness: Harness, run_id, label, result) {
  release_log_event(
    harness,
    run_id,
    "preflight_autoremediate",
    {
      case: label,
      action: result.action,
      safe: result.safe ?? false,
      reason: result.reason,
      remediated: result.remediated ?? false,
    },
  )
  if result.action == "fail" {
    harness.stdio.println("   ✗ preflight (${label}): ${result.reason}")
    throw "preflight remediation refused (${label}): ${result.reason}"
  }
  if result.remediated ?? false {
    harness.stdio.println("   ↻ preflight (${label}): ${result.reason}")
  }
}

fn release_open_pr_count(cfg, branch) {
  let r = run_gh(cfg, ["pr", "list", "--head", branch, "--state", "open", "--json", "number"])
  if !(r.success ?? false) {
    // Unknown PR state is not known-safe: report a nonzero count so the
    // remediation refuses to delete the branch.
    return 1
  }
  let raw = trim(r.stdout ?? "")
  let body = if raw == "" {
    "[]"
  } else {
    raw
  }
  let parsed = try {
    json_parse(body)
  } catch (_e) {
    return 1
  }
  return len(parsed ?? [])
}

/**
 * F6a: resolve the advisory local build-lock path. A fixed machine-wide path so
 * concurrent releases/builds serialize on the shared Cargo build dir.
 */
fn release_build_lock_path() {
  let tmp = env_str("HARN_RELEASE_BUILD_LOCK") ?? ""
  if trim(tmp) != "" {
    return trim(tmp)
  }
  let base = env_str("TMPDIR") ?? "/tmp"
  return path_join(base, "harn-release-build.lock")
}

/**
 * F6a: acquire the advisory local build mutex before the build-heavy prepare
 * phase so two releases/builds do not thrash the shared Cargo build dir.
 * Returns `nil` when no lock is needed (mock/audit/non-live). Fails fast when a
 * live owner holds the lock unless `--wait` was passed. A stale lock left by a
 * crashed release is stolen automatically (its owner pid is dead).
 */
fn release_acquire_build_lock(harness: Harness, cfg, run_id) {
  if cfg.mock ?? false {
    return nil
  }
  if !(cfg.mode == "prepare" || cfg.mode == "ship-pr") || !(cfg.yes_live_release ?? false) {
    return nil
  }
  let lock_path = release_build_lock_path()
  let result = acquire_build_lock(
    { cmd -> shell(cmd) },
    {
      lock_path: lock_path,
      pid: pid(),
      wait: cfg.wait_build_lock ?? false,
      note: "release_harn ${cfg.mode} ${run_id}",
    },
  )
  release_log_event(
    harness,
    run_id,
    "build_lock",
    {
      action: result.action,
      lock_path: result.lock_path,
      acquired: result.acquired,
      reason: result.reason,
    },
  )
  if !(result.acquired ?? false) {
    harness.stdio.println("   ✗ build lock: ${result.reason}")
    throw "release build lock: ${result.reason}"
  }
  if (result.waited_polls ?? 0) > 0 {
    harness.stdio
      .println("   ⏱ build lock acquired after waiting (${to_string(result.waited_polls)} polls)")
  } else {
    harness.stdio.println("   ✓ build lock: ${result.lock_path}")
  }
  return result.lock_path
}

fn release_release_build_lock(harness: Harness, lock_path, run_id) {
  if lock_path == nil || trim(lock_path) == "" {
    return
  }
  release_build_lock({ cmd -> shell(cmd) }, lock_path)
  release_log_event(harness, run_id, "build_lock_released", {lock_path: lock_path})
}

fn release_planner_preflight_required(cfg) {
  return cfg.agent && cfg.mode != "audit" && (cfg.yes_live_release ?? false) && !(cfg.mock ?? false)
}

fn release_planner_preflight_error(decision) {
  let lines = ["release planner preflight found no healthy provider before mutation"]
  for attempt in decision?.attempts ?? [] {
    let detail = trim(attempt.message ?? "")
    let suffix = if detail == "" {
      ""
    } else {
      ": " + detail
    }
    lines = lines
      + [
      "- ${attempt.provider}/${attempt.model}: ${attempt.classification} (${attempt.health_status})${suffix}",
    ]
  }
  return lines.join("\n")
}

fn preflight_release_planner(harness: Harness, cfg, run_id) {
  if !release_planner_preflight_required(cfg) {
    return cfg
  }
  harness.stdio.println("== planner preflight ...")
  release_log_event(
    harness,
    run_id,
    "planner_preflight_started",
    {provider: cfg.provider, model: cfg.model, source: cfg.planner_source ?? ""},
  )
  let decision = run_planner_preflight(
    {provider: cfg.provider, model: cfg.model, source: cfg.planner_source ?? "requested"},
  )
  release_log_event(harness, run_id, "planner_preflight_finished", decision)
  harness.stdio.println("   ${planner_preflight_audit_line(decision)}")
  for attempt in decision.attempts ?? [] {
    if attempt.valid {
      harness.stdio.println("   ✓ ${attempt.provider}/${attempt.model}")
    } else {
      harness.stdio
        .println(
        "   ✗ ${attempt.provider}/${attempt.model}: ${attempt.classification} (${attempt.health_status})",
      )
    }
  }
  if !(decision.healthy ?? false) {
    throw release_planner_preflight_error(decision)
  }
  if decision.disable_binder ?? false {
    harness.stdio.println("   ↳ binder disabled: its provider failed planner preflight")
  }
  let selected = decision.selected
  return {...cfg, provider: selected.provider, model: selected.model, planner_preflight: decision}
}

pipeline main() {
  let parsed_cfg = parse_release_args(harness, argv)
  if parsed_cfg.help {
    harness.stdio.println(usage())
    return 0
  }
  let preflight = ensure_unrestricted_sandbox(harness, "release_harn.harn")
  if preflight != nil {
    return preflight
  }
  if parsed_cfg.chat_only {
    return release_chat_only(harness, parsed_cfg)
  }
  let raw_cfg = resolve_release_flags_interactively(harness, parsed_cfg, argv)
  require_release_repo_path(harness, raw_cfg, "startup")
  let run_id = uuid_v7()
  let started_iso = date_now_iso()
  let repo_label = if raw_cfg.mock {
    "(mock)"
  } else {
    raw_cfg.repo
  }
  let run_timing = start_timing(
    "release.run",
    {
      mode: raw_cfg.mode,
      mock: raw_cfg.mock,
      agent: raw_cfg.agent,
      repo_kind: if raw_cfg.mock {
        "mock"
      } else {
        "local"
      },
    },
  )
  harness.stdio.println("== harn release harness ${run_id}")
  harness.stdio.println("   repo : ${repo_label}")
  harness.stdio.println("   mode : ${raw_cfg.mode}")
  harness.stdio.println("   bump : ${raw_cfg.bump}")
  harness.stdio
    .println(
    "   ${planner_audit_line({provider: raw_cfg.provider, model: raw_cfg.model, source: DEFAULT_PLANNER.source})}",
  )
  harness.stdio.println("   ${binder_audit_line(install_binder({tools: []}).audit)}")
  let cost_limit = install_cost_budget("HARN_RELEASE_COST_LIMIT_USD")
  harness.stdio.println("   ${cost_budget_audit_line(cost_limit)}")
  release_fleet_self_check(harness, raw_cfg, run_id)
  let preflight_cfg = preflight_release_planner(harness, raw_cfg, run_id)
  require_release_repo_path(harness, preflight_cfg, "base sync")
  timed(
    "release.base_sync",
    {base: preflight_cfg.base, mock: preflight_cfg.mock},
    { ->
      pre_release_sync_local_base(harness, preflight_cfg, run_id)
      return nil
    },
  )
  require_release_repo_path(harness, preflight_cfg, "pin resolution")
  let cfg = {...preflight_cfg, pin_sha: resolve_pin_sha(preflight_cfg)}
  let run_events = release_log_event(
    harness,
    run_id,
    "run_started",
    {
      repo: repo_label,
      mode: cfg.mode,
      bump: cfg.bump,
      agent: cfg.agent,
      mock: cfg.mock,
      pin_sha: cfg.pin_sha,
      pin_sha_input: cfg.pin_sha_input,
    },
  )
  harness.stdio.println("   pin  : ${cfg.pin_sha}")
  harness.stdio.println("   events: ${run_events}")
  harness.stdio.println("   tail : tail -f ${run_events}")
  let owner_guard = release_owner_guard_acquire(harness, cfg, {}, run_id)
  if owner_guard.enabled ?? false {
    harness.stdio.println("   owner guard    : ${owner_guard.path} (${owner_guard.decision.action})")
    release_log_event(
      harness,
      run_id,
      "owner_guard_acquired",
      {path: owner_guard.path, action: owner_guard.decision.action, reason: owner_guard.decision.reason},
    )
  }
  release_sccache_preflight(harness, cfg)
  require_release_repo_path(harness, cfg, "checkout normalization")
  timed(
    "release.checkout_normalization",
    {base: cfg.base, mock: cfg.mock},
    { ->
      normalize_release_analysis_checkout(harness, cfg, run_id)
      return nil
    },
  )
  require_release_repo_path(harness, cfg, "release analysis")
  release_log_event(harness, run_id, "analysis_started", {})
  let raw_analysis = timed(
    "release.analysis",
    {mode: cfg.mode, mock: cfg.mock},
    { -> return analyze_release(harness, cfg) },
  ).result
  let derived_cfg = with_derived_release_options(cfg, raw_analysis)
  require_release_repo_path(harness, derived_cfg, "release-state detection")
  // Repin and fixup are mutually exclusive: --repin-latest is the opt-in
  // inverse of fixup (advance the pin and fold drift in), so detect it
  // first and bypass fixup auto-detection when the operator asked for repin.
  let repin_state = detect_repin_state(derived_cfg, raw_analysis)
  let fixup_state = if repin_state == nil {
    detect_fixup_state(derived_cfg, raw_analysis)
  } else {
    nil
  }
  // Post-merge drift detection — only fires when neither repin nor fixup
  // apply (i.e., the previous release cycle fully merged but main's
  // `## v$current` body diverges from the pin-time `## Unreleased` that
  // the published binary actually contains).
  let drift_state = if repin_state == nil && fixup_state == nil {
    detect_post_merge_drift(derived_cfg, raw_analysis)
  } else {
    nil
  }
  if drift_state != nil {
    release_log_event(
      harness,
      run_id,
      "analysis_finished",
      {
        current_version: raw_analysis.current_version,
        next_version: raw_analysis.next_version,
        branch: raw_analysis.branch,
        changelog_top: raw_analysis.changelog_top,
        dirty_files: raw_analysis.dirty_files,
        deterministic_findings: raw_analysis.deterministic_findings,
        fixup_mode: false,
        post_merge_drift: true,
      },
    )
    owner_guard = release_owner_guard_update(harness, owner_guard, derived_cfg, raw_analysis)
    if owner_guard.enabled ?? false {
      harness.stdio
        .println("   owner guard    : ${owner_guard.path} (v${owner_guard.record.next_version})")
      release_log_event(
        harness,
        run_id,
        "owner_guard_updated",
        {
          path: owner_guard.path,
          version: owner_guard.record.next_version,
          pin_sha: owner_guard.record.pin_sha,
        },
      )
    }
    if drift_state.kind == "paperwork_pr_open" {
      harness.stdio.println("== post-merge paperwork PR already open: ${drift_state.pr_url}")
      harness.stdio.println("   no changes needed (the open PR already fixes the drift)")
      finish_release_run_timing(run_timing, "post_merge_paperwork_pr_open", true)
      release_owner_guard_finish(harness, owner_guard, "post_merge_paperwork_pr_open", true, derived_cfg)
      return 0
    }
    let drift_exit = timed(
      "release.post_merge_paperwork",
      {base: derived_cfg.base, mock: derived_cfg.mock},
      { -> return run_post_merge_paperwork_pr(harness, derived_cfg, drift_state, run_id) },
    ).result
    finish_release_run_timing(run_timing, "post_merge_paperwork_pr", drift_exit == 0)
    release_owner_guard_finish(
      harness,
      owner_guard,
      "post_merge_paperwork_pr",
      drift_exit == 0,
      derived_cfg,
    )
    return drift_exit
  }
  let effective_cfg = with_repin_state(with_fixup_state(derived_cfg, fixup_state), repin_state)
  let base_analysis = analysis_with_repin_state(analysis_with_fixup_state(raw_analysis, fixup_state), repin_state)
  owner_guard = release_owner_guard_update(harness, owner_guard, effective_cfg, base_analysis)
  if owner_guard.enabled ?? false {
    harness.stdio
      .println("   owner guard    : ${owner_guard.path} (v${owner_guard.record.next_version})")
    release_log_event(
      harness,
      run_id,
      "owner_guard_updated",
      {
        path: owner_guard.path,
        version: owner_guard.record.next_version,
        pin_sha: owner_guard.record.pin_sha,
      },
    )
  }
  require_release_repo_path(harness, effective_cfg, "run/session view gate")
  let view_gate = timed(
    "release.run_session_view_gate",
    {mode: effective_cfg.mode, mock: effective_cfg.mock},
    { -> return release_run_session_view_gate(harness, effective_cfg, base_analysis) },
  ).result
  let analysis = {
    ...base_analysis,
    run_session_view: view_gate,
    deterministic_findings: base_analysis.deterministic_findings + view_gate.findings,
  }
  release_log_event(
    harness,
    run_id,
    "analysis_finished",
    {
      current_version: analysis.current_version,
      next_version: analysis.next_version,
      branch: analysis.branch,
      changelog_top: analysis.changelog_top,
      dirty_files: analysis.dirty_files,
      deterministic_findings: analysis.deterministic_findings,
      fixup_mode: analysis.fixup_mode,
    },
  )
  harness.stdio
    .println("   current -> next : ${analysis.current_version} -> ${analysis.next_version}")
  harness.stdio.println("   changelog top   : v${analysis.changelog_top}")
  harness.stdio.println("   dirty files     : ${analysis.dirty_files}")
  harness.stdio.println("   view schemas    : ${view_gate.summary_line}")
  harness.stdio
    .println("   view fixture    : ${view_gate.check.command} -> ${view_gate.check.status}")
  if (effective_cfg.bootstrap_new_crates ?? false) && !(cfg.bootstrap_new_crates ?? false) {
    harness.stdio.println("   bootstrap new crates: auto-enabled from release delta")
    release_log_event(harness, run_id, "option_derived", {bootstrap_new_crates: true})
  }
  require_release_repo_path(harness, effective_cfg, "preflight auto-remediation")
  release_preflight_autoremediate(harness, effective_cfg, analysis, run_id)
  if repin_state != nil {
    harness.stdio.println("== repin mode (advance pin to latest origin/${cfg.base})")
    let tag_state = if trim(repin_state.initial_remote_tag_sha) == "" {
      "${repin_state.tag} (not yet on origin; will be tagged on this run)"
    } else {
      "${repin_state.tag} (currently at ${repin_state.initial_remote_tag_sha}; will be retagged at the new pin)"
    }
    harness.stdio.println("   tag       : ${tag_state}")
    harness.stdio.println("   pr        : ${repin_state.pr_url}")
    harness.stdio
      .println(
      "   pin       : ${cfg.pin_sha} (latest origin/${cfg.base}; re-locked just before branch reset)",
    )
    harness.stdio
      .println(
      "   plan      : recreate release/v${analysis.next_version} on fresh ${cfg.base}, rename current ## Unreleased to v${analysis.next_version}, re-run audit + dry-run + bump, force-push new tag, refresh PR body.",
    )
    release_log_event(
      harness,
      run_id,
      "repin_mode_detected",
      {
        tag: repin_state.tag,
        pr_url: repin_state.pr_url,
        new_pin: cfg.pin_sha,
        initial_remote_tag_sha: repin_state.initial_remote_tag_sha,
      },
    )
  }
  if fixup_state != nil {
    let pin_count = changelog_bullet_count(fixup_state.pin_unreleased)
    let unreleased_count = changelog_bullet_count(analysis.changelog_unreleased_section ?? "")
    let release_body_source = fixup_state.release_body_source ?? "pin-unreleased"
    let label = if fixup_state.conflicting ?? false {
      "resolving merge conflict"
    } else if fixup_state.release_exists {
      "post-publish paperwork"
    } else {
      "repair existing PR"
    }
    harness.stdio.println("== fixup mode (${label})")
    let tag_state = if fixup_state.tag_exists {
      "${fixup_state.tag} (already pushed; tag will not move)"
    } else {
      "${fixup_state.tag} (not yet pushed; will be tagged on this run)"
    }
    harness.stdio.println("   tag       : ${tag_state}")
    harness.stdio.println("   pr        : ${fixup_state.pr_url}")
    if fixup_state.conflicting ?? false {
      harness.stdio
        .println(
        "   conflict  : PR is `CONFLICTING` against ${cfg.base} — recreating branch on fresh ${cfg.base} resolves it implicitly",
      )
    }
    if !(fixup_state.release_exists ?? false) && len(fixup_state.missing_assets ?? []) > 0 {
      harness.stdio.println("   assets    : missing " + join(fixup_state.missing_assets, ", "))
    }
    harness.stdio.println("   pin       : ${fixup_state.original_pin} (recovered via merge-base)")
    harness.stdio
      .println(
      "   v${analysis.next_version} : ${pin_count} recovered release-note entries from ${release_body_source}",
    )
    harness.stdio
      .println(
      "   drift     : ${unreleased_count} current ## Unreleased entries on ${cfg.base}; post-pin bullets stay in Unreleased",
    )
    harness.stdio
      .println(
      "   plan      : recreate release branch on fresh ${cfg.base}, promote pin-time Unreleased to v${analysis.next_version}, version bump, force-push, refresh PR body.",
    )
    release_log_event(
      harness,
      run_id,
      "fixup_mode_detected",
      {
        tag: fixup_state.tag,
        pr_url: fixup_state.pr_url,
        original_pin: fixup_state.original_pin,
        tag_exists: fixup_state.tag_exists,
        release_exists: fixup_state.release_exists,
        missing_assets: fixup_state.missing_assets ?? [],
        conflicting: fixup_state.conflicting ?? false,
        release_body_source: release_body_source,
        pin_unreleased_chars: len(fixup_state.pin_unreleased),
        pin_bullet_count: pin_count,
        current_unreleased_bullet_count: unreleased_count,
      },
    )
  }
  let agent_review_result = {
    text: "(agent review skipped; pass --agent to enable local-model review)",
    attempts: [],
    validation_findings: [],
    draft_changelog: nil,
    artifacts: {},
  }
  if cfg.agent {
    require_release_repo_path(harness, effective_cfg, "agent review")
    let model_label = if cfg.mock {
      "mock provider"
    } else {
      cfg.model
    }
    harness.stdio.println("== agent review with ${model_label} ...")
    release_log_event(
      harness,
      run_id,
      "agent_started",
      {model: model_label, llm_transcript_dir: agent_artifact_paths(run_id).llm_transcript_dir},
    )
    agent_review_result = timed(
      "release.agent_review",
      {
        provider: if cfg.mock {
          "mock"
        } else {
          cfg.provider
        },
        model: model_label,
      },
      { -> return agent_review(harness, effective_cfg, analysis, run_id) },
    ).result
    release_log_event(
      harness,
      run_id,
      "agent_finished",
      {
        draft_changelog: agent_review_result.draft_changelog,
        artifacts: agent_review_result.artifacts,
        validation_findings: agent_review_result.validation_findings,
      },
    )
  }
  let agent_text = agent_review_result.text
  if cfg.mode != "audit"
    && cfg.agent
    && chat_enabled(effective_cfg)
    && agent_review_result.draft_changelog != nil {
    let draft_path = agent_review_result.draft_changelog ?? ""
    let changelog_text = if draft_path != "" && harness.fs.exists(draft_path) {
      harness.fs.read_text(draft_path)
    } else {
      ""
    }
    let pr_body_preview = try {
      pr_body_text(analysis, agent_review_result, [], run_id)
    } catch (_e) {
      ""
    }
    let gate = timed(
      "release.pre_release_gate",
      {mode: cfg.mode, mock: cfg.mock},
      { -> return pre_release_gate(
        harness,
        {
          provider: cfg.provider,
          model: cfg.model,
          mock: cfg.mock,
          tools: release_repair_tools(harness, effective_cfg, run_id),
          timeout_s: cfg.chat_timeout_s,
        },
        {changelog: changelog_text, pr_body: pr_body_preview, findings: analysis.deterministic_findings},
        {
          mode: cfg.mode,
          next_version: analysis.next_version,
          current_version: analysis.current_version,
          repo: cfg.repo,
          run_id: run_id,
          base_branch: cfg.base,
          latest_tag: analysis.latest_tag,
          pin_sha: cfg.pin_sha,
        },
      ) },
    ).result
    if gate.decision == "abort" {
      release_log_event(harness, run_id, "pre_release_gate_aborted", {reason: gate.reason})
      harness.stdio.println("== chat: aborting before live release side effects (${gate.reason})")
      finish_release_run_timing(run_timing, "pre_release_gate_aborted", false)
      release_owner_guard_finish(harness, owner_guard, "pre_release_gate_aborted", false, effective_cfg)
      return 2
    }
    release_log_event(harness, run_id, "pre_release_gate_approved", {reason: gate.reason})
  }
  let build_lock_path = release_acquire_build_lock(harness, effective_cfg, run_id)
  let execution = nil
  let view_blocker = run_session_view_release_blocker(effective_cfg, view_gate)
  if view_blocker != nil {
    execution = [view_blocker]
  } else if cfg.agent && cfg.mode != "audit" && len(agent_review_result.validation_findings) > 0 {
    execution = [
      recorded_step(
        "agent-review-validation",
        "validate local-model release audit before live release side effects",
        fail(2, "agent review failed validation:\n" + agent_review_result.validation_findings.join("\n")),
      ),
    ]
  } else if live_release_notes_blocker(harness, effective_cfg, analysis) != nil {
    execution = [live_release_notes_blocker(harness, effective_cfg, analysis)]
  } else if cfg.mode == "prepare" {
    require_release_repo_path(harness, effective_cfg, "prepare execution")
    harness.stdio.println("== running prepare ...")
    release_log_event(harness, run_id, "mode_execution_started", {mode: "prepare"})
    execution = timed_release_steps(
      "release.mode_execution",
      {mode: "prepare", mock: effective_cfg.mock},
      { -> return execute_prepare(harness, effective_cfg, analysis, agent_review_result, run_id) },
    )
  } else if cfg.mode == "ship-pr" {
    require_release_repo_path(harness, effective_cfg, "ship-pr execution")
    harness.stdio.println("== running prepare + PR handoff ...")
    release_log_event(harness, run_id, "mode_execution_started", {mode: "ship-pr"})
    execution = timed_release_steps(
      "release.mode_execution",
      {mode: "ship-pr", mock: effective_cfg.mock},
      { -> return execute_ship_pr(harness, effective_cfg, analysis, agent_review_result, run_id) },
    )
  }
  let cleanup = timed(
    "release.checkout_cleanup",
    {mode: effective_cfg.mode, mock: effective_cfg.mock},
    { -> return restore_release_checkout_to_base(harness, effective_cfg, execution, run_id) },
  ).result
  if cleanup != nil {
    harness.stdio.println("== checkout cleanup")
    if trim(cleanup.warning ?? "") != "" {
      harness.stdio.println("   warning: ${cleanup.warning}")
    } else {
      harness.stdio.println("   ${cleanup.detail}")
    }
  }
  release_release_build_lock(harness, build_lock_path, run_id)
  let outcome = if execution_failed(execution) {
    "FAILED"
  } else {
    "ok"
  }
  let run_report = finish_release_run_timing(run_timing, outcome, outcome == "ok")
  let timing = timing_artifacts()
  let payload = {
    run_id: run_id,
    started_iso: started_iso,
    finished_iso: date_now_iso(),
    duration_ms: run_report.duration_ms,
    operator: username(),
    host: hostname(),
    config: effective_cfg,
    analysis: analysis,
    agent_review: agent_text,
    agent_review_detail: agent_review_result,
    execution: execution,
    cleanup: cleanup,
    trace_spans: timing.trace_spans,
    timing_summary: timing.timing_summary,
  }
  let written = write_report(harness, run_id, payload)
  let fixture = write_crystallization_fixture(harness, run_id, payload, written)
  release_log_event(
    harness,
    run_id,
    "run_finished",
    {
      success: !execution_failed(execution),
      report_json: written.json_path,
      report_md: written.md_path,
      fixture_dir: fixture.out_dir,
    },
  )
  release_owner_guard_finish(harness, owner_guard, outcome, outcome == "ok", effective_cfg)
  let pr_url = execution_pr_url(execution)
  harness.stdio.println("== done (${outcome}, ${format_ms_human(run_report.duration_ms)})")
  if pr_url != "" {
    harness.stdio.println("   pr      : ${pr_url}")
  }
  if analysis.fixup_mode ?? false {
    if analysis.fixup_release_exists ?? false {
      harness.stdio
        .println("   tag     : ${analysis.fixup_tag} (unchanged; published artifact untouched)")
    } else {
      harness.stdio
        .println(
        "   tag     : ${analysis.fixup_tag} (unchanged; release artifacts still need recovery)",
      )
    }
  } else if (analysis.repin_mode ?? false) && !execution_failed(execution) && !cfg.mock {
    harness.stdio
      .println(
      "   tag     : v${analysis.next_version} (re-pushed at advanced pin; publish-release.yml will ship)",
    )
  } else if cfg.mode == "ship-pr" && !execution_failed(execution) && !cfg.mock {
    harness.stdio
      .println("   tag     : v${analysis.next_version} (pushed; publish-release.yml will ship)")
  }
  harness.stdio.println("   report  : ${written.md_path}")
  const slow_timing_lines = timing_summary_lines(timing.timing_summary, {limit: 5, min_duration_ms: 1000})
  if len(slow_timing_lines) > 0 {
    harness.stdio.println("   timing  :")
    for line in slow_timing_lines {
      harness.stdio.println("     - ${line}")
    }
  }
  if len(analysis.deterministic_findings) > 0 {
    harness.stdio.println("   findings:")
    for f in analysis.deterministic_findings {
      harness.stdio.println("     - ${f}")
    }
  }
  let exit_code = if execution_failed(execution) {
    let failed = last_failed_step(execution)
    if failed != nil {
      let explain = release_failure_explanation(failed)
      harness.stdio.println("   ✗ failed : ${explain.headline}")
      harness.stdio.println("     (step `${failed.name}`, status ${failed.status})")
      let reason = trim(failed.stderr ?? "")
      if reason != "" {
        for line in split(reason, "\n") {
          harness.stdio.println("     ${line}")
        }
      }
      let next_step = trim(explain.next ?? "")
      if next_step != "" {
        harness.stdio.println("   next    : ${next_step}")
      }
    }
    1
  } else {
    0
  }
  if chat_enabled(effective_cfg) {
    let chat_cfg = {
      harness_kind: "release-harn",
      run_id: run_id,
      run_dir: release_run_dir(run_id),
      audit_md_path: written.md_path,
      audit_json_path: written.json_path,
      llm_transcript_path: agent_artifact_paths(run_id).llm_transcript_jsonl,
      provider: cfg.provider,
      model: cfg.model,
      repo: cfg.repo,
      mode_hint: cfg.mode,
      outcome: outcome,
      tools: release_repair_tools(harness, effective_cfg, run_id),
      timeout_s: cfg.chat_timeout_s,
      no_chat: cfg.no_chat,
    }
    run_chat_loop(harness, chat_cfg)
  }
  return exit_code
}

fn execution_pr_url(execution) {
  for step in execution ?? [] {
    if step.name == "find-existing-pr" || step.name == "create-pr" {
      let url = trim(step.stdout ?? "")
      if starts_with(url, "https://") {
        return url
      }
    }
  }
  return ""
}

fn format_ms_human(ms) {
  let total = ms ?? 0
  if total < 1000 {
    return "${total}ms"
  }
  let total_seconds = total / 1000
  if total_seconds < 60 {
    let tenths = (total + 50) / 100
    let whole = tenths / 10
    let frac = tenths - whole * 10
    return "${whole}.${frac}s"
  }
  let minutes = total_seconds / 60
  let seconds = total_seconds - minutes * 60
  return "${minutes}m${seconds}s"
}
