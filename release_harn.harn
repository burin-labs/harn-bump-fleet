let DEFAULT_REPO = path_join(env_str("HOME") ?? "", "projects/harn")

let DEFAULT_BASE = env_str("HARN_RELEASE_BASE") ?? "main"

// Defaults route through `lib/llm_defaults::planner_defaults` so the
// cloud/local cell decision (and `HARN_RELEASE_*` env overrides) live in
// one place across every harness in this repo. See `lib/llm_defaults` for
// the empirical-best planner/binder pair (PR burin-labs/harn#1814).
let DEFAULT_PLANNER = planner_defaults("HARN_RELEASE")

let DEFAULT_MODEL = DEFAULT_PLANNER.model

let DEFAULT_PROVIDER = DEFAULT_PLANNER.provider

let MOCK_AGENT_MODEL = "claude-sonnet-4-7"

let RUN_ROOT = ".harn-runs/release-harn"

/**
 * Resolve the checkout root that owns this release harness. `harn run
 * /abs/path/release_harn.harn` may be launched from another repo, so this must
 * not depend on the process cwd.
 */
pub fn release_harness_root() {
  const root = runtime_paths().asset_root
  const leaf = basename(root)
  if leaf == "lib" || leaf == "tests" {
    return dirname(root)
  }
  return root
}

pub fn release_run_root() {
  return path_join(release_harness_root(), RUN_ROOT)
}

fn release_run_dir(run_id) {
  return path_join(release_run_root(), run_id)
}

pub fn prompt_asset(name) {
  return path_join(release_harness_root(), "prompts", name)
}

pub fn release_cli_help_requested(parsed) {
  return (parsed._help ?? false) || (parsed.help ?? false)
}

fn timing_status(success) {
  return if success {
    "ok"
  } else {
    "error"
  }
}

fn finish_release_run_timing(handle, outcome, success) {
  return end_timing(handle, {status: timing_status(success), outcome: outcome})
}

fn timed_release_steps(name, attrs, callback) {
  let handle = start_timing(name, attrs)
  try {
    let steps = callback()
    let failed = execution_failed(steps)
    end_timing(
      handle,
      {
        status: timing_status(!failed),
        outcome: if failed {
          "failed"
        } else {
          "ok"
        },
        step_count: len(steps ?? []),
      },
    )
    return steps
  } catch (e) {
    end_timing(handle, {status: "error", outcome: "exception", error: to_string(e)})
    throw e
  }
}

// Mock-mode placeholder for the pinned base SHA. 40 hex chars so it
// looks like a real commit SHA in audit reports, fixtures, and tests.
let MOCK_PIN_SHA = "abcdef1234567890abcdef1234567890abcdef12"

