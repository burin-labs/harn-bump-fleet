#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { github_claim_ref, github_release_ref } from "lib/github"
import {
  HarnUpdateContinuationAuthorizationAdapter,
  release_harn_update_chain_with_adapter,
} from "lib/harn_update_continuation"

type Options = {
  chain_id: string,
  controller_revision: string,
  continuation_receipt: string,
  scheduler_outcome: string,
}

const ARG_SPEC: ParserSpec = {
  name: "release-harn-update-chain",
  args: [
    {kind: "flag", name: "chain_id", long: "--chain-id", required: true},
    {kind: "flag", name: "controller_revision", long: "--controller-revision", required: true},
    {
      kind: "flag",
      name: "continuation_receipt",
      long: "--continuation-receipt",
      default: "fleet-update-continuation-receipt.json",
    },
    {kind: "flag", name: "scheduler_outcome", long: "--scheduler-outcome", required: true},
  ],
}

/**
 * Read what this round's own continuation receipt says about a successor.
 *
 * `scheduler_outcome` is the workflow's own answer for whether the scheduler
 * step ran at all, because that is a fact the workflow owns rather than one to
 * infer from the filesystem. A skipped scheduler dispatched nothing.
 *
 * Otherwise an absent or unreadable receipt is `unknown`, not `none`. The
 * scheduler writes it after the dispatch call returns, so a scheduler that
 * dispatched and then died leaves no receipt and a live successor, and treating
 * that as "no successor" would delete the branch that successor runs from.
 */
fn successor_status(
  io: {fs: HarnessFs, stdio: HarnessStdio},
  path: string,
  scheduler_outcome: string,
) -> "none" | "dispatched" | "unknown" {
  if scheduler_outcome == "skipped" {
    return "none"
  }
  const decoded = try {
    unwrap(json_parse(io.fs.read_text(path)))
  } catch (error) {
    io.stdio.eprintln(
      "continuation receipt '${path}' is absent or unreadable after the scheduler ran: "
        + to_string(error),
    )
    return "unknown"
  }
  if to_string(decoded.get("status") ?? "") == "continued" {
    return "dispatched"
  }
  return "none"
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const adapter: HarnUpdateContinuationAuthorizationAdapter = {
    claim: fn(ref, oid) { return github_claim_ref(
      harness,
      "burin-labs/harn-bump-fleet",
      ref,
      {oid: oid},
    ) },
    release: fn(ref, expected_oid) { return github_release_ref(
      harness,
      "burin-labs/harn-bump-fleet",
      ref,
      expected_oid,
    ) },
  }
  const receipt = release_harn_update_chain_with_adapter(
    options.chain_id,
    options.controller_revision,
    successor_status(
      {fs: harness.fs, stdio: harness.stdio},
      options.continuation_receipt,
      options.scheduler_outcome,
    ),
    adapter,
  )
  harness.stdio.println(json_stringify_pretty(receipt))
}
