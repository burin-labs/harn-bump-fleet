#!/usr/bin/env harn
//
// One-off meta-audit harness for the release and fleet scripts.
//
// This is intentionally not wired into CI or the normal release/bump loops. It
// gathers deterministic facts from recent .harn-runs artifacts, then gives a
// local model read-only tools over ~/projects so it can cross-reference the
// harness and Harn implementations before writing recommendations.
import { agent_host_tools } from "std/agent/host_tools"
import { agent_preset } from "std/agent/presets"
import { read_json } from "std/fs"
import { read_jsonl, write_jsonl } from "std/jsonl"
import {
  run_artifact_path,
  run_artifact_transcript_dir,
  run_artifact_transcript_path,
  run_artifact_write_json,
  run_artifact_write_text,
  run_artifacts_from_dir,
  run_artifacts_list,
  run_artifacts_open,
} from "std/run_artifacts"
import { truncate_text } from "std/text"
import { HarnessSelfReviewOptions, parse_self_review_args } from "lib/harness_self_review_options"
import { binder_audit_line, install_binder } from "lib/llm_defaults"
import { agent_result_text } from "lib/release_audit"
import { safe_shell_arg } from "lib/shell_util"
import {
  agent_transcript_context_metadata,
  self_review_compaction_policy,
  self_review_context_eval_manifest,
  self_review_context_eval_markdown,
  self_review_context_eval_report,
  summary_projection_policy,
  tool_repair_projection_policy,
  transcript_compaction_events,
  transcript_projection_events,
} from "lib/transcript_context"

const RUN_ROOT = ".harn-runs"

const SELF_REVIEW_KIND = "harness-self-review"

let IMPORTANT_RELEASE_RUNS = [
  "019e0859-b02f-7263-ba03-112aaa31b3aa",
  "019e0868-036a-7a22-a646-a20b1a2e1223",
  "019e08a6-66fd-78f0-bce6-1021fcf11c96",
]

let IMPORTANT_BUMP_RUNS = ["019e08b0-b18f-7622-9f61-5d70bcec6bf6", "019e08b5-06d7-71e0-ae01-335f27df13a4"]

let AUDIT_RUN_ARGV_PREFIXES = [
  ["git", "status"],
  ["git", "diff"],
  ["git", "log"],
  ["git", "show"],
  ["git", "branch"],
  ["git", "rev-parse"],
  ["git", "ls-files"],
  ["rg"],
  ["grep"],
  ["sed", "-n"],
  ["head"],
  ["tail"],
  ["wc"],
  ["ls"],
  ["find"],
]

fn usage() {
  return """
Usage:
  harn run harness_self_review.harn
  harn run harness_self_review.harn -- --facts-only
  harn run harness_self_review.harn -- --recent 10 --model qwen3.6:35b-a3b-coding-nvfp4

Flags:
  --facts-only           Gather deterministic facts and skip the local model.
  --recent N             Include the N latest release and fleet runs. Defaults to 6.
  --model MODEL          Model id. Defaults through HARN_SELF_REVIEW_*, HARN_RELEASE_*,
                         then lib/llm_defaults' cloud cell (OpenRouter qwen/qwen3.6-35b-a3b).
  --provider PROVIDER    LLM provider. Uses the same default cascade.
  --tool-format text|native  Tool protocol for the review agent. Defaults to text.
  --with-tools           Use the experimental read-only agent tool loop before synthesis.
  --projects-root PATH   Read-only tool root. Defaults to ~/projects.
  --harn-repo PATH       Harn repo path mentioned in the audit facts. Defaults to ~/projects/harn.
"""
}

fn run_artifact_root() {
  return path_join(cwd(), RUN_ROOT)
}

fn review_artifact_paths(run_id) {
  let run = run_artifacts_open(SELF_REVIEW_KIND, {root: run_artifact_root(), run_id: run_id})
  return {
    run: run,
    out_dir: run.dir,
    facts_json: run.paths.facts,
    report_md: run.paths.review,
    raw_result_json: run.paths.agent_result,
    trace_json: run.paths.agent_trace,
    transcript_context_json: run_artifact_path(run, "agent-transcript-context.json"),
    context_eval_manifest_json: run_artifact_path(run, "context-eval-manifest.json"),
    context_eval_dir: run_artifact_path(run, "context-eval"),
    context_eval_summary_json: run_artifact_path(run, "context-eval/summary.json"),
    context_eval_summary_md: run_artifact_path(run, "context-eval/summary.md"),
    context_eval_per_run_jsonl: run_artifact_path(run, "context-eval/per_run.jsonl"),
    llm_transcript_dir: run_artifact_transcript_dir(run),
    llm_transcript_jsonl: run_artifact_transcript_path(run),
  }
}

fn basename(path) {
  let parts = (path ?? "").split("/").filter({ p -> p != "" })
  if len(parts) == 0 {
    return path ?? ""
  }
  return parts[len(parts) - 1]
}

fn relative_to(root, path) {
  let prefix = root + "/"
  if starts_with(path, prefix) {
    return path[len(prefix):len(path)]
  }
  return path
}

fn count_occurrences(text, needle) {
  if needle == "" {
    return 0
  }
  return len((text ?? "").split(needle)) - 1
}

fn artifact_text(harness: Harness, path) {
  let p = path ?? ""
  if p == "" || !harness.fs.exists(p) {
    return ""
  }
  return harness.fs.read_text(p)
}

fn add_count(counts, key) {
  let k = key ?? ""
  if k == "" {
    return counts
  }
  let out = counts
  out[k] = (out[k] ?? 0) + 1
  return out
}

fn contains_any_arg(argv, disallowed) {
  for arg in argv {
    for flag in disallowed {
      if arg == flag || starts_with(arg, flag + "=") {
        return true
      }
    }
  }
  return false
}

fn audit_run_policy(request, _args) {
  let argv = request?.argv ?? []
  if len(argv) < 1 {
    return true
  }
  if argv[0] == "find" && contains_any_arg(argv, ["-delete", "-exec", "-execdir", "-ok", "-okdir"]) {
    return "audit_run is read-only; find mutation/execution actions are blocked"
  }
  if len(argv) >= 2 && argv[0] == "git" && argv[1] == "tag" {
    if contains_any_arg(
      argv,
      ["-a", "-d", "-f", "-m", "-s", "--annotate", "--delete", "--force", "--message", "--sign"],
    ) {
      return "audit_run is read-only; git tag mutation flags are blocked"
    }
  }
  if len(argv) >= 2 && argv[0] == "git" && argv[1] == "branch" {
    if contains_any_arg(argv, ["-c", "-C", "-d", "-D", "-m", "-M", "--copy", "--delete", "--move"]) {
      return "audit_run is read-only; git branch mutation flags are blocked"
    }
  }
  return true
}

fn audit_safe_tool_text(text) {
  return (text ?? "")
    .replace("{", "[open-brace]")
    .replace("}", "[close-brace]")
    .replace("<", "[lt]")
    .replace(">", "[gt]")
}

fn audit_tool_formatter(value, _key) {
  if type_of(value) != "dict" {
    return "value: " + audit_safe_tool_text(to_string(value))
  }
  let lines = []
  if value?.path != nil {
    lines = lines + ["path: " + to_string(value.path)]
  }
  if value?.status != nil {
    lines = lines + ["status: " + to_string(value.status)]
  }
  if value?.exit_code != nil {
    lines = lines + ["exit_code: " + to_string(value.exit_code)]
  }
  if value?.command_id != nil {
    lines = lines + ["command_id: " + to_string(value.command_id)]
  }
  if type_of(value?.content) == "string" {
    lines = lines
      + [
      "content_truncated_by_harness: " + to_string(len(value.content) > 8000),
      "content:",
      audit_safe_tool_text(truncate_text(value.content, 8000)),
    ]
  }
  if type_of(value?.stdout) == "string" {
    lines = lines
      + [
      "stdout_truncated_by_harness: " + to_string(len(value.stdout) > 8000),
      "stdout:",
      audit_safe_tool_text(truncate_text(value.stdout, 8000)),
    ]
  }
  if type_of(value?.stderr) == "string" && value.stderr != "" {
    lines = lines
      + [
      "stderr_truncated_by_harness: " + to_string(len(value.stderr) > 5000),
      "stderr:",
      audit_safe_tool_text(truncate_text(value.stderr, 5000)),
    ]
  }
  if len(lines) == 0 {
    return "value: " + audit_safe_tool_text(json_stringify(value))
  }
  return lines.join("\n")
}

fn latest_dirs(_harness: Harness, kind, limit) {
  return run_artifacts_list(kind, {root: run_artifact_root(), limit: limit})
    .map({ run -> run.dir })
    .to_list()
}

fn maybe_run_dir(harness: Harness, kind, run_id) {
  let run = run_artifacts_from_dir(kind, path_join(run_artifact_root(), kind, run_id))
  if harness.fs.exists(run.dir) {
    return [run.dir]
  }
  return []
}

fn unique_paths(paths) {
  let seen = {}
  let out = []
  for path in paths {
    if path == "" || (seen[path] ?? false) {
      continue
    }
    seen[path] = true
    out = out + [path]
  }
  return out
}

fn selected_run_dirs(harness: Harness, kind, important_run_ids, recent) {
  let out = []
  for run_id in important_run_ids {
    out = out + maybe_run_dir(harness, kind, run_id)
  }
  out = out + latest_dirs(harness, kind, recent)
  return unique_paths(out)
}

fn find_files(harness: Harness, root, glob_name) {
  if !harness.fs.exists(root) {
    return []
  }
  let root_arg = safe_shell_arg(root)
  let glob_arg = safe_shell_arg(glob_name)
  if root_arg == nil || glob_arg == nil {
    return []
  }
  let r = shell("find " + root_arg + " -type f -name " + glob_arg + " | sort")
  if !r.success {
    return []
  }
  return r.stdout.split("\n").map({ p -> trim(p) }).filter({ p -> p != "" })
}

fn transcript_summary(harness: Harness, path) {
  let events = read_jsonl(path)
  let raw = artifact_text(harness, path)
  let projection_events = transcript_projection_events(events)
  let compaction_events = transcript_compaction_events(events)
  let provider_requests = 0
  let provider_responses = 0
  let tool_schema_count = 0
  let native_tool_counts = []
  let tool_choice_counts = {}
  let response_tool_counts = {}
  let response_tool_sequence = []
  let response_protocol_leaks = 0
  let response_code_fence_mentions = 0
  let final_request = nil
  let final_no_tools_request_seen = false
  for event in events {
    let typ = event?.type ?? ""
    if typ == "tool_schemas" {
      tool_schema_count = len(event?.schemas ?? [])
    } else if typ == "provider_call_request" {
      provider_requests = provider_requests + 1
      let native_count = event?.native_tool_count ?? 0
      let choice = event?.tool_choice ?? "(null)"
      native_tool_counts = native_tool_counts + [native_count]
      tool_choice_counts = add_count(tool_choice_counts, choice)
      final_request = {
        native_tool_count: native_count,
        tool_choice: choice,
        tool_format: event?.tool_format ?? "",
        model: event?.model ?? "",
        provider: event?.provider ?? "",
        message_count: event?.message_count,
      }
      if native_count == 0 && choice == "none" {
        final_no_tools_request_seen = true
      }
    } else if typ == "provider_call_response" {
      provider_responses = provider_responses + 1
      let text = event?.text ?? ""
      if contains(text, "<tool_call>") || contains(text, "<function=") || contains(text, "</function>") {
        response_protocol_leaks = response_protocol_leaks + 1
      }
      if contains(text, "```") {
        response_code_fence_mentions = response_code_fence_mentions + 1
      }
      for call in event?.tool_calls ?? [] {
        let name = call?.name ?? ""
        response_tool_counts = add_count(response_tool_counts, name)
        response_tool_sequence = response_tool_sequence + [name]
      }
    }
  }
  let adjacent_repeats = []
  let previous = ""
  for name in response_tool_sequence {
    if name != "" && name == previous {
      adjacent_repeats = adjacent_repeats + [name]
    }
    previous = name
  }
  return {
    path: path,
    exists: harness.fs.exists(path),
    bytes: if harness.fs.exists(path) {
      harness.fs.stat(path).size
    } else {
      0
    },
    event_count: len(events),
    provider_requests: provider_requests,
    provider_responses: provider_responses,
    tool_schema_count: tool_schema_count,
    native_tool_counts: native_tool_counts,
    tool_choice_counts: tool_choice_counts,
    final_request: final_request,
    final_no_tools_request_seen: final_no_tools_request_seen,
    projection_event_count: len(projection_events),
    projection_events: projection_events,
    projection_policies: projection_events.map({ event -> event.policy }),
    compaction_event_count: len(compaction_events),
    compaction_events: compaction_events,
    response_tool_counts: response_tool_counts,
    adjacent_repeated_tool_names: adjacent_repeats,
    response_protocol_leak_count: response_protocol_leaks,
    response_code_fence_count: response_code_fence_mentions,
    required_tool_missing_mentions: count_occurrences(raw, "required tools missing"),
    done_judge_mentions: count_occurrences(raw, "done_judge") + count_occurrences(raw, "done-judge"),
    done_prompt_mentions: count_occurrences(raw, "done_prompt") + count_occurrences(raw, "done-prompt"),
    think_tag_mentions: count_occurrences(raw, "<think>"),
  }
}

fn agent_result_summary(harness: Harness, path) {
  let raw = artifact_text(harness, path)
  let parsed = read_json(path)
  if parsed == nil {
    return {path: path, exists: harness.fs.exists(path), parseable: false}
  }
  let final_result = parsed?.final_result ?? parsed
  let attempts = parsed?.attempts ?? []
  return {
    path: path,
    exists: true,
    parseable: true,
    status: final_result?.status ?? "",
    attempt_count: len(attempts),
    attempt_statuses: attempts.map({ a -> {name: a?.name ?? "", status: a?.status ?? ""} }),
    tool_mode: final_result?.tools?.mode ?? "",
    successful_tools: final_result?.tools?.successful ?? [],
    rejected_tools: final_result?.tools?.rejected ?? [],
    required_tool_missing_mentions: count_occurrences(raw, "required tools missing"),
    max_iterations_mentions: count_occurrences(raw, "max iterations"),
  }
}

fn execution_step_refs(steps) {
  let out = []
  for step in steps ?? [] {
    if type_of(step) != "dict" {
      continue
    }
    out = out
      + [
      {
        name: step?.name ?? "",
        success: step?.success ?? step?.ok,
        status: step?.status ?? "",
        classification: step?.classification ?? "",
        command: step?.command ?? "",
        recovery_hint: step?.recovery_hint ?? "",
      },
    ]
  }
  return out
}

fn release_run_summary(harness: Harness, dir) {
  let run = run_artifacts_from_dir("release-harn", dir)
  let audit_path = run_artifact_path(run, "release-audit.json")
  let events_path = run_artifact_path(run, "run-events.jsonl")
  let result_path = run.paths.agent_result
  let audit = read_json(audit_path)
  let events = read_jsonl(events_path)
  let primary_transcript = run_artifact_transcript_path(run)
  let transcripts = find_files(harness, dir, "llm_transcript.jsonl")
  return {
    kind: "release-harn",
    run_id: run.run_id,
    dir: run.dir,
    audit_path: if harness.fs.exists(audit_path) {
      audit_path
    } else {
      nil
    },
    events_path: if harness.fs.exists(events_path) {
      events_path
    } else {
      nil
    },
    agent_result: agent_result_summary(harness, result_path),
    transcript_paths: transcripts,
    primary_transcript: if harness.fs.exists(primary_transcript) {
      transcript_summary(harness, primary_transcript)
    } else {
      nil
    },
    recovery_transcripts: transcripts
      .filter({ p -> p != primary_transcript })
      .map({ p -> transcript_summary(harness, p) }),
    event_count: len(events),
    event_types: events.map({ e -> e?.event_type ?? e?.type ?? "" }),
    mode: audit?.mode ?? "",
    started_iso: audit?.started_iso ?? "",
    finished_iso: audit?.finished_iso ?? "",
    current_version: audit?.analysis?.current_version ?? "",
    next_version: audit?.analysis?.next_version ?? "",
    branch: audit?.analysis?.branch ?? "",
    changelog_top: audit?.analysis?.changelog_top ?? "",
    deterministic_findings: audit?.analysis?.deterministic_findings ?? [],
    agent_validation_findings: audit?.agent_review_detail?.validation_findings ?? [],
    execution_steps: execution_step_refs(audit?.execution ?? []),
    cleanup: audit?.cleanup,
  }
}

fn status_counts(outcomes) {
  let counts = {}
  for outcome in outcomes ?? [] {
    counts = add_count(counts, outcome?.status ?? "")
  }
  return counts
}

fn bump_run_summary(harness: Harness, dir) {
  let run = run_artifacts_from_dir("bump-fleet", dir)
  let audit_path = run.paths.audit
  let md_path = run_artifact_path(run, "audit.md")
  let audit = read_json(audit_path)
  return {
    kind: "bump-fleet",
    run_id: run.run_id,
    dir: run.dir,
    audit_path: if harness.fs.exists(audit_path) {
      audit_path
    } else {
      nil
    },
    md_path: if harness.fs.exists(md_path) {
      md_path
    } else {
      nil
    },
    started_iso: audit?.started_iso ?? "",
    finished_iso: audit?.finished_iso ?? "",
    mode: audit?.mode ?? "",
    target_version: audit?.target_version ?? "",
    repos_total: audit?.repos_total,
    repos_dispatched: audit?.repos_dispatched,
    status_counts: status_counts(audit?.outcomes ?? []),
    summary_model: audit?.summary_model ?? "",
    summary_text: audit?.summary_text ?? "",
    cleanup: audit?.cleanup,
    outcome_refs: (audit?.outcomes ?? [])
      .map(
      { o -> {
        slug: o?.slug ?? "",
        status: o?.status ?? "",
        detail: truncate_text(o?.detail ?? "", 400),
        pr_url: o?.pr_url,
        run_url: o?.run_url,
      } },
    ),
  }
}

fn validation_ladder_summary(harness: Harness) {
  let root = path_join(cwd(), ".harn-runs/validation-ladder")
  if !harness.fs.exists(root) {
    return {exists: false}
  }
  let transcripts = find_files(harness, root, "llm_transcript.jsonl")
  return {
    exists: true,
    root: root,
    audit_json_paths: find_files(harness, root, "*audit.json"),
    transcript_paths: transcripts,
    transcripts: transcripts.map({ p -> transcript_summary(harness, p) }),
  }
}

fn self_review_run_summary(harness: Harness, dir) {
  let run = run_artifacts_from_dir(SELF_REVIEW_KIND, dir)
  let result_path = run.paths.agent_result
  let transcript_path = run_artifact_transcript_path(run)
  let synthesis_transcript_path = run_artifact_transcript_path(run, "synthesis-llm")
  let agent_context_path = run_artifact_path(run, "agent-transcript-context.json")
  let synthesis_context_path = run_artifact_path(run, "synthesis-transcript-context.json")
  let report_path = run.paths.review
  return {
    kind: "harness-self-review",
    run_id: run.run_id,
    dir: run.dir,
    agent_result: agent_result_summary(harness, result_path),
    agent_transcript: if harness.fs.exists(transcript_path) {
      transcript_summary(harness, transcript_path)
    } else {
      nil
    },
    synthesis_transcript: if harness.fs.exists(synthesis_transcript_path) {
      transcript_summary(harness, synthesis_transcript_path)
    } else {
      nil
    },
    agent_transcript_context: if harness.fs.exists(agent_context_path) {
      read_json(agent_context_path)
    } else {
      nil
    },
    synthesis_transcript_context: if harness.fs.exists(synthesis_context_path) {
      read_json(synthesis_context_path)
    } else {
      nil
    },
    report_excerpt: truncate_text(artifact_text(harness, report_path), 1200),
  }
}

fn transcript_digest(summary) {
  if summary == nil {
    return "(none)"
  }
  return "requests=${summary.provider_requests}, responses=${summary.provider_responses}, tools="
    + json_stringify(summary.response_tool_counts)
    + ", projections="
    + json_stringify(summary.projection_policies ?? [])
    + ", final_no_tools="
    + to_string(summary.final_no_tools_request_seen)
    + ", required_tool_missing_mentions="
    + to_string(summary.required_tool_missing_mentions)
    + ", protocol_leaks="
    + to_string(summary.response_protocol_leak_count)
    + ", final_request="
    + json_stringify(summary.final_request)
}

fn facts_digest(facts) {
  let lines = []
  lines = lines
    + ["Run id: ${facts.run_id}", "Facts schema: ${facts.schema_version}", "Selected release runs:"]
  for run in facts.release_runs {
    lines = lines
      + [
      "- ${run.run_id}: mode=${run.mode}, next=${run.next_version}, branch=${run.branch}, events=${run.event_count}, primary=${transcript_digest(run.primary_transcript)}",
    ]
    for recovery in run.recovery_transcripts ?? [] {
      lines = lines
        + [
        "  recovery ${basename(recovery.path)}: requests=${recovery.provider_requests}, tools=${json_stringify(recovery.response_tool_counts)}, adjacent_repeats=${json_stringify(recovery.adjacent_repeated_tool_names)}",
      ]
    }
    if len(run.execution_steps ?? []) > 0 {
      lines = lines
        + [
        "  execution steps: "
          + json_stringify(
          run.execution_steps
            .map(
            { step -> {name: step.name, success: step.success, classification: step.classification} },
          ),
        ),
      ]
    }
  }
  lines = lines + ["Selected bump-fleet runs:"]
  for run in facts.bump_runs {
    lines = lines
      + [
      "- ${run.run_id}: mode=${run.mode}, target=${run.target_version}, repos=${run.repos_total}, dispatched=${run.repos_dispatched}, statuses=${json_stringify(run.status_counts)}, summary=${run.summary_text}",
    ]
  }
  lines = lines + ["Validation ladder:"]
  for transcript in facts.validation_ladder?.transcripts ?? [] {
    lines = lines
      + ["- ${transcript.path}: ${transcript_digest(transcript)}"]
  }
  lines = lines + ["Prior self-review attempts:"]
  for run in facts.self_review_runs ?? [] {
    let status = run.agent_result?.status ?? ""
    lines = lines
      + [
      "- ${run.run_id}: status=${status}, transcript=${transcript_digest(run.agent_transcript)}, report_excerpt=${single_line_report_excerpt(run.report_excerpt)}",
    ]
  }
  let context_status = facts.context_eval?.status ?? ""
  let context_passed = facts.context_eval?.passed_runs ?? "?"
  let context_total = facts.context_eval?.total_runs ?? "?"
  lines = lines
    + [
    "Context eval: status=${context_status}, runs=${context_passed}/${context_total}, policies=${json_stringify(facts.context_eval?.projection_policies ?? [])}",
  ]
  lines = lines + ["Source refs: " + json_stringify(facts.source_refs)]
  return lines.join("\n")
}

fn single_line_report_excerpt(text) {
  return truncate_text(regex_replace_all("\\s+", " ", trim(text ?? "")), 500)
}

fn readonly_path_exists(path) {
  let path_arg = safe_shell_arg(path)
  if path_arg == nil {
    return false
  }
  return shell("test -e " + path_arg).success
}

fn rg_excerpt(harness: Harness, label, path, pattern) {
  if !readonly_path_exists(path) {
    return "## ${label}\nmissing: ${path}"
  }
  let path_arg = safe_shell_arg(path)
  let pattern_arg = safe_shell_arg(pattern)
  if path_arg == nil || pattern_arg == nil {
    return "## ${label}\nskipped: unsupported shell quoting"
  }
  let r = shell("rg -n -- " + pattern_arg + " " + path_arg + " | head -80")
  let body = if trim(r.stdout) != "" {
    r.stdout
  } else {
    "(no matches)"
  }
  return "## ${label}\npath: ${path}\npattern: ${pattern}\n"
    + audit_safe_tool_text(truncate_text(body, 5000))
}

fn source_evidence_digest(harness: Harness, cfg: HarnessSelfReviewOptions) {
  let items = [
    {
      label: "release harness agent/tool plumbing",
      path: path_join(cwd(), "release_harn.harn"),
      pattern: "release_host_tools|release_review_post_turn|require_successful_tools|run_recovery_agent_loop|llm_transcript_dir|transcript_projection|compaction_policy|release_run_policy|release_replace_file|release_write_file|release_artifact",
    },
    {
      label: "fleet summary and cleanup behavior",
      path: path_join(cwd(), "bump_fleet.harn"),
      pattern: "summarize_with_local_llm|summary_format_ok|restore_local_checkout_to_main|wait_for_target_release_readiness|discover_repos",
    },
    {
      label: "release agent prompt guidance",
      path: path_join(cwd(), "prompts/release_agent_system.harn.prompt"),
      pattern: "tool|CHANGELOG|markdown|final|draft|prompt|Do not|must",
    },
    {
      label: "release recovery prompt guidance",
      path: path_join(cwd(), "prompts/release_recovery_system.harn.prompt"),
      pattern: "markdown|lint|repair|live_log|tool|Do not",
    },
    {
      label: "Harn host tool stdlib",
      path: path_join(cfg.harn_repo, "crates/harn-stdlib/src/stdlib/agent/host_tools.harn"),
      pattern: "output_format|result_formatter|resolve_path|read_file|run_command|tool_define",
    },
    {
      label: "Harn agent loop completion/gating",
      path: path_join(cfg.harn_repo, "crates/harn-stdlib/src/stdlib/agent/loop.harn"),
      pattern: "require_successful_tools|required tools missing|done_judge|done_prompt|llm_transcript_dir|post_turn_callback",
    },
    {
      label: "Harn agent presets",
      path: path_join(cfg.harn_repo, "crates/harn-stdlib/src/stdlib/agent/presets.harn"),
      pattern: "audit|repair|summary|iteration_budget|tool_format|done_judge|loop_until_done|transcript_projection|compaction_policy",
    },
  ]
  let parts = []
  for item in items {
    parts = parts + [rg_excerpt(harness, item.label, item.path, item.pattern)]
  }
  return parts.join("\n\n")
}

fn source_file_refs(harness: Harness, cfg: HarnessSelfReviewOptions) {
  let local = [
    "release_harn.harn",
    "bump_fleet.harn",
    "prompts/release_agent_system.harn.prompt",
    "prompts/release_agent_user.harn.prompt",
    "prompts/release_recovery_system.harn.prompt",
    "prompts/release_recovery_prompt.harn.prompt",
    "prompts/bump_summary_system.harn.prompt",
    "prompts/bump_summary_retry.harn.prompt",
    "lib/release_audit.harn",
    "lib/release_commands.harn",
    "lib/release_execution.harn",
    "lib/checkout_cleanup.harn",
  ]
  let harn_candidates = [
    "crates/harn-stdlib/src",
    "crates/harn-vm/src",
    "crates/harn-runtime/src",
    "crates/harn-cli/src",
    "docs/src",
  ]
  return {
    harn_bump_fleet_root: cwd(),
    harn_repo: cfg.harn_repo,
    harn_bump_fleet_files: local.map({ p -> {path: p, exists: harness.fs.exists(path_join(cwd(), p))} }),
    harn_source_areas: harn_candidates
      .map(
      { p -> {path: path_join(cfg.harn_repo, p), exists: readonly_path_exists(path_join(cfg.harn_repo, p))} },
    ),
  }
}

fn gather_facts(harness: Harness, cfg: HarnessSelfReviewOptions, run_id) {
  let release_dirs = selected_run_dirs(harness, "release-harn", IMPORTANT_RELEASE_RUNS, cfg.recent)
  let bump_dirs = selected_run_dirs(harness, "bump-fleet", IMPORTANT_BUMP_RUNS, cfg.recent)
  let self_dirs = latest_dirs(harness, SELF_REVIEW_KIND, cfg.recent).filter({ dir -> basename(dir) != run_id })
  return {
    schema_version: "harn_bump_fleet.self_review.v1",
    run_id: run_id,
    generated_at: date_now_iso(),
    purpose: "one-off local-model audit of recent release/fleet harness artifacts and source guidance",
    model: cfg.model,
    provider: cfg.provider,
    tool_format: cfg.tool_format,
    projects_root: cfg.projects_root,
    harn_repo: cfg.harn_repo,
    selected_release_runs: release_dirs,
    selected_bump_runs: bump_dirs,
    release_runs: release_dirs.map({ dir -> release_run_summary(harness, dir) }),
    bump_runs: bump_dirs.map({ dir -> bump_run_summary(harness, dir) }),
    self_review_runs: self_dirs.map({ dir -> self_review_run_summary(harness, dir) }),
    validation_ladder: validation_ladder_summary(harness),
    source_refs: source_file_refs(harness, cfg),
  }
}

fn write_context_eval_artifacts(harness: Harness, paths, facts) {
  let manifest = self_review_context_eval_manifest(facts)
  run_artifact_write_json(paths.run, "context-eval-manifest.json", manifest)
  harness.fs.mkdir(paths.context_eval_dir, true)
  let report = self_review_context_eval_report(manifest)
  harness.fs.write_text(paths.context_eval_summary_json, json_stringify(report) + "\n")
  harness.fs.write_text(paths.context_eval_summary_md, self_review_context_eval_markdown(report))
  write_jsonl(paths.context_eval_per_run_jsonl, report.runs ?? [])
  return {
    status: "ok",
    manifest_json: paths.context_eval_manifest_json,
    output_dir: paths.context_eval_dir,
    summary_json: paths.context_eval_summary_json,
    summary_md: paths.context_eval_summary_md,
    per_run_jsonl: paths.context_eval_per_run_jsonl,
    report_schema: report?._type ?? "",
    passed_runs: report?.passed_runs,
    total_runs: report?.total_runs,
    projection_policies: (report?.modes ?? []).map({ mode -> mode?.projection_policy ?? "" }),
  }
}

fn review_tools(cfg: HarnessSelfReviewOptions) {
  return agent_host_tools(
    nil,
    {
      root: cfg.projects_root,
      cwd: cwd(),
      max_inline_bytes: 8000,
      read_bytes: 8000,
      tail_bytes: 8000,
      search_max_matches: 160,
      exclude_globs: [".git/**", "target/**", ".worktrees/**", "node_modules/**", "dist/**", "build/**"],
      allow_argv_prefixes: AUDIT_RUN_ARGV_PREFIXES,
      command_policy: audit_run_policy,
      names: {
        read_file: "audit_read",
        read_file_tail: "audit_read_tail",
        search_files: "audit_search",
        git_inspect: "audit_git",
        run_command: "audit_run",
        read_command_output: "audit_run_output",
        read_command_output_tail: "audit_run_tail",
      },
      descriptions: {
        read_file: "Read a UTF-8 file under ~/projects by relative path, such as harn-bump-fleet/release_harn.harn or harn/crates/harn-stdlib/src/lib.rs.",
        search_files: "Search under ~/projects. Narrow with path/glob before broad searches; avoid target, .git, node_modules, and generated build output.",
        git_inspect: "Inspect git status, diff, log, show, blame, branches, or remotes without mutating a repository.",
        run_command: "Run a bounded read-only inspection command from the harness repo. Pass argv as an array of strings; shell command strings are not accepted.",
      },
      result_formatter: audit_tool_formatter,
      annotations: {run_command: {workflow_phase: "harness_self_review"}},
      output_format: "display",
    },
  )
}

fn run_review_agent(cfg: HarnessSelfReviewOptions, facts, paths, run_id) {
  let system = render("@prompts/harness_self_review_system.harn.prompt", {})
  let prompt = render(
    "@prompts/harness_self_review_prompt.harn.prompt",
    {
      facts_json_path: paths.facts_json,
      facts_json_relative_path: relative_to(cfg.projects_root, paths.facts_json),
      facts_digest: facts_digest(facts),
      harn_bump_fleet_root: cwd(),
      harn_repo: cfg.harn_repo,
      projects_root: cfg.projects_root,
    },
  )
  let binder = install_binder(review_tools(cfg))
  return agent_loop(
    prompt,
    system,
    agent_preset(
      "audit",
      {
        provider: cfg.provider,
        model: cfg.model,
        max_tokens: 5000,
        tools: binder.tools,
        tool_caller: binder.tool_caller,
        tool_format: cfg.tool_format,
        timeout: 1200,
        idle_timeout: 240,
        iteration_budget: {mode: "adaptive", initial: 6, max: 12, extend_by: 2},
        require_successful_tools: ["audit_read"],
        turn_policy: {allow_done_sentinel: false, max_prose_chars: 30000},
        compaction: {strategy: "hybrid", keep_last_n: 10, policy: self_review_compaction_policy("tool_loop")},
        transcript_projection: tool_repair_projection_policy(),
        session_id: "harn-bump-fleet-self-review-" + cfg.tool_format + "-" + run_id,
        llm_transcript_dir: paths.llm_transcript_dir,
      },
    ),
  )
}

fn synthesis_artifact_paths(paths) {
  return {
    raw_result_json: run_artifact_path(paths.run, "synthesis-result.json"),
    trace_json: run_artifact_path(paths.run, "synthesis-trace.json"),
    transcript_context_json: run_artifact_path(paths.run, "synthesis-transcript-context.json"),
    llm_transcript_dir: run_artifact_transcript_dir(paths.run, "synthesis-llm"),
    llm_transcript_jsonl: run_artifact_transcript_path(paths.run, "synthesis-llm"),
  }
}

fn run_synthesis_agent(
  harness: Harness,
  cfg: HarnessSelfReviewOptions,
  facts,
  paths,
  run_id,
  tool_attempt,
) {
  let synthesis_paths = synthesis_artifact_paths(paths)
  let system = render("@prompts/harness_self_review_system.harn.prompt", {})
  let prompt = render(
    "@prompts/harness_self_review_synthesis_prompt.harn.prompt",
    {
      facts_json_path: paths.facts_json,
      facts_json_relative_path: relative_to(cfg.projects_root, paths.facts_json),
      facts_digest: facts_digest(facts),
      source_evidence_digest: source_evidence_digest(harness, cfg),
      tool_attempt_json: json_stringify(tool_attempt),
      harn_bump_fleet_root: cwd(),
      harn_repo: cfg.harn_repo,
      projects_root: cfg.projects_root,
    },
  )
  let result = agent_loop(
    prompt,
    system,
    agent_preset(
      "summary",
      {
        provider: cfg.provider,
        model: cfg.model,
        max_tokens: 5000,
        tools: tool_registry(),
        tool_choice: "none",
        loop_until_done: false,
        max_nudges: 0,
        timeout: 900,
        idle_timeout: 240,
        compaction: {strategy: "hybrid", keep_last_n: 8, policy: self_review_compaction_policy("synthesis")},
        transcript_projection: summary_projection_policy(4),
        session_id: "harn-bump-fleet-self-review-synthesis-" + run_id,
        llm_transcript_dir: synthesis_paths.llm_transcript_dir,
      },
    ),
  )
  run_artifact_write_json(paths.run, "synthesis-result.json", result)
  run_artifact_write_json(paths.run, "synthesis-trace.json", result.trace ?? {})
  run_artifact_write_json(
    paths.run,
    "synthesis-transcript-context.json",
    agent_transcript_context_metadata(result),
  )
  return result
}

pipeline main() {
  let cfg = parse_self_review_args(argv)
  if cfg.help {
    harness.stdio.println(usage())
    return 0
  }
  let run_id = uuid_v7()
  let paths = review_artifact_paths(run_id)
  let mode_label = if cfg.facts_only {
    "facts-only"
  } else {
    "local-agent"
  }
  harness.stdio.println("== harness self-review ${run_id}")
  harness.stdio.println("   mode          : ${mode_label}")
  harness.stdio.println("   model         : ${cfg.model}")
  harness.stdio.println("   provider      : ${cfg.provider}")
  harness.stdio.println("   tool format   : ${cfg.tool_format}")
  harness.stdio.println("   ${binder_audit_line(install_binder({tools: []}).audit)}")
  harness.stdio.println("   artifacts     : ${paths.out_dir}")
  let base_facts = gather_facts(harness, cfg, run_id)
  let context_eval = write_context_eval_artifacts(harness, paths, base_facts)
  let facts = {...base_facts, context_eval: context_eval}
  run_artifact_write_json(paths.run, "facts.json", facts)
  harness.stdio.println("   facts         : ${paths.facts_json}")
  harness.stdio
    .println("   context eval  : ${context_eval.summary_md ?? paths.context_eval_summary_md}")
  if cfg.facts_only {
    return 0
  }
  let tool_attempt = {
    mode: "skipped",
    reason: "default synthesis mode; pass --with-tools to exercise the read-only agent tool loop",
    status: "",
    error: "",
    text: "",
  }
  if cfg.with_tools {
    harness.stdio.println("== running experimental tool-loop self-review ...")
    let tool_result = try {
      run_review_agent(cfg, facts, paths, run_id)
    } catch (e) {
      {status: "error", error: to_string(e)}
    }
    let tool_text = to_string(tool_result?.visible_text ?? tool_result?.text ?? tool_result?.error ?? "")
    tool_attempt = {
      mode: "with-tools",
      reason: "experimental read-only agent tool loop was requested",
      status: tool_result?.status ?? "",
      error: tool_result?.error ?? "",
      text: tool_text,
    }
    run_artifact_write_json(paths.run, "agent-result.json", tool_result)
    run_artifact_write_json(paths.run, "agent-trace.json", tool_result?.trace ?? {})
    run_artifact_write_json(
      paths.run,
      "agent-transcript-context.json",
      agent_transcript_context_metadata(tool_result),
    )
    if (tool_result?.status ?? "") == "done" {
      let final_tool_text = agent_result_text(tool_result)
      run_artifact_write_text(paths.run, "review.md", final_tool_text)
      harness.stdio.println("   report        : ${paths.report_md}")
      harness.stdio.println("   transcript    : ${paths.llm_transcript_jsonl}")
      harness.stdio.println("   status        : ${tool_result.status}")
      return 0
    }
    harness.stdio.println("   tool-loop status: ${tool_attempt.status}")
  }
  harness.stdio.println("== running one-shot synthesis ...")
  let result = run_synthesis_agent(harness, cfg, facts, paths, run_id, tool_attempt)
  let text = agent_result_text(result)
  run_artifact_write_text(paths.run, "review.md", text)
  harness.stdio.println("   report        : ${paths.report_md}")
  harness.stdio.println("   transcript    : ${synthesis_artifact_paths(paths).llm_transcript_jsonl}")
  let status = result.status ?? ""
  harness.stdio.println("   status        : ${status}")
  if status != "done" && status != "" {
    return 1
  }
  return 0
}
