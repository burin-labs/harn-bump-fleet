#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { materialize_fleet_checkouts } from "lib/fleet_checkout"
import { harn_package_repositories, read_fleet_manifest } from "lib/fleet_manifest"

type Options = {root: string}

const ARG_SPEC: ParserSpec = {
  name: "materialize-package-fleet",
  args: [{kind: "flag", name: "root", long: "--root", required: true}],
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const manifest = read_fleet_manifest(harness.fs)
  const repositories = harn_package_repositories(manifest)
  const results = materialize_fleet_checkouts(
    {fs: harness.fs, process: harness.process},
    repositories,
    manifest.fleet.default_branch,
    options.root,
  )
  const failed = results.filter({ result -> result.status == "failed" }).to_list()
  const receipt = {
    schema_version: "harn_bump_fleet.package_checkouts.v1",
    root: options.root,
    selected_count: len(repositories),
    repositories: results,
  }
  harness.stdio.println(json_stringify_pretty(receipt))
  return if len(repositories) > 0 && len(failed) == 0 {
    0
  } else {
    1
  }
}
