#!/usr/bin/env harn
import { parse_args } from "std/cli"
import { changed_harn_lint_gate } from "lib/changed_harn_lint"

const ARG_SPEC = [
  {kind: "flag", name: "help", flags: ["--help", "-h"]},
  {kind: "option", name: "repo", flags: ["--repo"], default: "."},
  {kind: "option", name: "base", flags: ["--base"], required: true},
  {kind: "option", name: "head", flags: ["--head"], default: "HEAD"},
  {kind: "option", name: "harn_bin", flags: ["--harn-bin"], default: ""},
]

fn usage() -> string {
  return "usage: harn run --no-sandbox check_changed_harn_strict_lint.harn -- --base <git-ref> [--head HEAD] [--repo .] [--harn-bin harn]"
}

fn harn_bin(harness: Harness, explicit: string) -> string {
  const configured = trim(explicit)
  if configured != "" {
    return configured
  }
  const from_env = trim(harness.env.get_or("HARN_BIN", ""))
  return if from_env != "" {
    from_env
  } else {
    "harn"
  }
}

pipeline main() {
  const parsed = parse_args(argv, ARG_SPEC)
  if parsed.help {
    harness.stdio.println(usage())
    return
  }
  if len(parsed._errors) > 0 {
    throw join(parsed._errors, "; ")
  }
  if len(parsed._extras) > 0 {
    throw "unknown arg: " + parsed._extras[0]
  }
  const gate = changed_harn_lint_gate(
    harness,
    parsed.repo,
    parsed.base,
    parsed.head,
    harn_bin(harness, parsed.harn_bin),
  )
  if gate.ok {
    harness.stdio.println(gate.detail)
    return 0
  }
  if trim(gate.stderr) != "" {
    harness.stdio.eprintln(gate.stderr)
  }
  harness.stdio.eprintln(gate.detail)
  return gate.status
}
