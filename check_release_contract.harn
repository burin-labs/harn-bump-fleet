#!/usr/bin/env harn
//
// check_release_contract.harn — evaluate this orchestrator's release-semantics
// gates against a target repository's REAL current state.
//
// The mock release path pins a fixed version pair, so it cannot reach any
// invariant that depends on the target repo's actual version, tag, or
// changelog shape. Every drift between this orchestrator's copy of the release
// semantics and the target repo's own therefore surfaced for the first time at
// a live cut.
//
// This check closes that gap without a live run. The gates it exercises are
// pure decision functions over gathered evidence, so it can gather the real
// evidence and assert the real decision while touching nothing:
//
//   * the prior-release fold gate      (workspace + changelog prove the fold)
//   * the release-target resolver      (what this cut would be named)
//   * the published-release resolver   (which release the body gate inspects)
//
// It performs no writes, requires no credentials, and never dispatches. Run it
// from the target repo's CI on any change to release scripts, release
// workflows, or the version scheme.
//
// Usage: harn run check_release_contract.harn -- --repo /path/to/target
import { compare_release, parse_release, version_from_tag } from "std/semver"
import {
  HarnReleaseContract,
  contract_development_release_target,
  contract_last_published_release_version,
  contract_next_development_version,
  contract_next_release_version,
  harn_release_contract_from_text,
} from "lib/harn_release_contract"
import { changelog_top_from_text, workspace_version_from_manifest } from "lib/release_analysis"
import {
  candidate_range_evidence,
  candidate_tree_range_scope,
  release_candidate_tree_decision,
} from "lib/release_candidate_tree_contract"
import { candidate_tree_release_note_fold } from "lib/release_note_fold"
import {
  prior_release_fold_base_evidence,
  prior_release_fold_decision,
} from "lib/release_preflight"

pub type ReleaseContractCheckPhase = {state: "evaluate", version: string} \
  | {state: "publication_pending", version: string} \
  | {state: "pending_contract_changed", version: string}

pub type ReleaseContractCheckHarness = {
  fs: HarnessFs,
  process: HarnessProcess,
  println: fn(string) -> nil,
}

/**
 * Classify the one repository phase where release-cut checks are inapplicable.
 *
 * The stable bump reaches main before its tag is published. That exact shape
 * can be stranded, so this records publication as pending rather than proven.
 * A contract change cannot borrow the base's transient state to evade the
 * semantic checks that are supposed to validate it.
 */
pub fn release_contract_check_phase(
  contract: HarnReleaseContract,
  workspace_version: string,
  changelog_version: string,
  latest_tag: string,
  contract_changed: bool,
) -> ReleaseContractCheckPhase {
  const published = version_from_tag(trim(latest_tag))
  const parsed = parse_release(published)
  if parsed == nil || parsed.prerelease != nil {
    return {state: "evaluate", version: ""}
  }
  const pending = contract_development_release_target(
    contract,
    contract_next_development_version(contract, published),
  )
  if pending == nil {
    return {state: "evaluate", version: ""}
  }
  if trim(workspace_version) != pending || trim(changelog_version) != pending {
    return {state: "evaluate", version: ""}
  }
  if contract_changed {
    return {state: "pending_contract_changed", version: pending}
  }
  return {state: "publication_pending", version: pending}
}

fn flag_value(args: list<string>, name: string, fallback: string) -> string {
  let index = 0
  for arg in args {
    if arg == name && index + 1 < len(args) {
      return trim(args[index + 1])
    }
    index = index + 1
  }
  return fallback
}

fn git_capture(process: HarnessProcess, repo: string, args: list<string>) -> string {
  const result = process.run({program: "git", args: ["-C", repo] + args})
  if !result.success {
    throw "git ${args.join(" ")} failed in ${repo}:\n${trim(result.stderr)}"
  }
  return result.stdout
}

/** Resolve the newest `vX.Y.Z` tag the target repo's origin advertises. */
fn latest_origin_release_tag(process: HarnessProcess, repo: string) -> string {
  const listed = git_capture(
    process,
    repo,
    ["ls-remote", "--tags", "--refs", "origin", "refs/tags/v*"],
  )
  let best = ""
  for line in split(trim(listed), "\n") {
    const parts = split(trim(line), "refs/tags/")
    if len(parts) < 2 {
      continue
    }
    const tag = trim(parts[len(parts) - 1])
    if len(regex_captures("^v[0-9]+[.][0-9]+[.][0-9]+$", tag)) == 0 {
      continue
    }
    if best == "" || compare_release(tag, best) > 0 {
      best = tag
    }
  }
  if best == "" {
    throw "no vX.Y.Z tags found on origin in ${repo}; cannot evaluate the release contract"
  }
  return best
}

/** Command handler kept importable so tests exercise the exact driver path. */
pub fn run_release_contract_check(
  _harness: {fs: HarnessFs, process: HarnessProcess},
  harness: ReleaseContractCheckHarness,
  raw_args: list<string>,
) -> int {
  const repo = flag_value(raw_args, "--repo", "")
  const base = flag_value(raw_args, "--base", "main")
  const contract_ref = flag_value(raw_args, "--contract-ref", "origin/${base}")
  if repo == "" {
    harness.println(
      "usage: harn run check_release_contract.harn -- --repo PATH [--base REF] [--contract-ref REF]",
    )
    return 2
  }
  harness.println("== release contract check")
  harness.println("   repo : ${repo}")
  harness.println("   base : origin/${base}")
  harness.println("   contract : ${contract_ref}")
  // Gather the SAME evidence the live gate gathers, from the same places.
  const latest_tag = latest_origin_release_tag(harness.process, repo)
  const cargo_toml = git_capture(harness.process, repo, ["show", "origin/${base}:Cargo.toml"])
  const changelog = git_capture(harness.process, repo, ["show", "origin/${base}:CHANGELOG.md"])
  const contract_text = git_capture(
    harness.process,
    repo,
    ["show", "${contract_ref}:scripts/release_contract.json"],
  )
  const contract = harn_release_contract_from_text(contract_text)
  if contract == nil {
    throw "${contract_ref}:scripts/release_contract.json is missing or invalid"
  }
  const base_contract_text = git_capture(
    harness.process,
    repo,
    ["show", "origin/${base}:scripts/release_contract.json"],
  )
  const workspace_version = workspace_version_from_manifest(cargo_toml)
  const changelog_top = changelog_top_from_text(changelog)
  harness.println("   tag  : ${latest_tag}")
  harness.println("   workspace : ${workspace_version}")
  harness.println("   changelog : v${changelog_top}")
  const phase = release_contract_check_phase(
    contract,
    workspace_version,
    changelog_top,
    latest_tag,
    contract_text != base_contract_text,
  )
  if phase.state == "publication_pending" {
    harness.println(
      "   phase : publication pending for v${phase.version}; publication is not yet proven",
    )
    harness.println("== contract holds for the unchanged pending-publication base")
    return 0
  }
  if phase.state == "pending_contract_changed" {
    harness.println(
      "   phase : publication pending for v${phase.version}; publication is not yet proven",
    )
    harness.println("== contract VIOLATED")
    harness.println(
      "   - release contract changed while the repository is between its stable bump and tag; validate it after publication or against a development-version base",
    )
    return 1
  }
  let failures = []
  // 1. The prior-release fold gate. This is the gate that stopped a live cut
  //    when the target repo adopted post-release development versions.
  const evidence = prior_release_fold_base_evidence(
    "origin/${base}",
    latest_tag,
    cargo_toml,
    changelog,
    contract,
  )
  const fold = prior_release_fold_decision(evidence)
  if fold.proceed {
    harness.println("   ✓ prior-release fold: ${fold.reason}")
  } else {
    harness.println("   ✗ prior-release fold: ${fold.reason}")
    failures = failures + ["prior-release fold gate would refuse this base: ${fold.detail}"]
  }
  // 2. The release-target resolver. A version scheme this orchestrator does not
  //    understand throws here rather than at the cut.
  let next_version = ""
  try {
    next_version = contract_next_release_version(contract, workspace_version, latest_tag)
    harness.println("   ✓ release target: ${workspace_version} -> ${next_version}")
  } catch (error) {
    harness.println("   ✗ release target: ${error.message}")
    failures = failures
      + ["release-target resolver rejects the current workspace: ${error.message}"]
  }
  // 3. The published-release resolver. The body-integrity gate looks up a
  //    GitHub release by this name, so it must name a tag that EXISTS. A
  //    resolver that returns the raw workspace version names `X.Y.Z-dev`,
  //    which is never published.
  const published = contract_last_published_release_version(contract, workspace_version, latest_tag)
  const body_target = published
  if published == version_from_tag(latest_tag) {
    harness.println("   ✓ published release: ${published}")
  } else {
    harness.println(
      "   ✗ published release: resolved ${published}, expected ${version_from_tag(latest_tag)}",
    )
    failures = failures
      + [
        "published-release resolver returned ${published}, which is not the latest tag ${latest_tag}; the release-body gate would look up a release that does not exist",
      ]
  }
  if body_target != published {
    failures = failures
      + ["release-body gate would inspect ${body_target} instead of the published ${published}"]
  }
  // 4. The exact checked-out candidate tree, scoped to the candidate's own
  // range. This tree is rarely the candidate itself: a pull-request checkout
  // merges the candidate with the default branch, and a merge queue that
  // squashes rebuilds it as a commit with no link back. Either way it carries
  // every fragment the default branch gained while the candidate was in
  // flight. Only fragments the candidate's own commit records prove that the
  // candidate failed to fold itself; the rest are deferred and reported.
  const candidate_cfg = {repo: repo, mock: false}
  const candidate_manifest = git_capture(harness.process, repo, ["show", "HEAD:Cargo.toml"])
  const candidate_version = workspace_version_from_manifest(candidate_manifest)
  const candidate_fold = candidate_tree_release_note_fold(
    {fs: harness.fs, process: harness.process},
    candidate_cfg,
    candidate_version,
    nil,
  )
  const candidate_range = candidate_range_evidence(
    harness.process,
    candidate_cfg,
    candidate_version,
  )
  const candidate_scope = candidate_tree_range_scope(
    harness.fs,
    candidate_cfg,
    candidate_fold,
    candidate_range,
    candidate_version,
  )
  const candidate = release_candidate_tree_decision(
    workspace_version,
    candidate_version,
    candidate_fold,
    candidate_scope,
  )
  // Which commit the range resolved to decides whether a surviving fragment
  // is read as the candidate's own or as one to defer, so name it rather than
  // leaving the reason above to imply it.
  if candidate.applicable {
    harness.println(
      if candidate_range.resolved {
        "   candidate range : ${candidate_range.commit}"
      } else {
        "   candidate range : unresolved (${candidate_range.detail}); nothing deferred"
      },
    )
  }
  if !candidate.applicable {
    harness.println("   - exact candidate tree: not a release transition")
  } else if candidate.proceed {
    harness.println("   ✓ exact candidate tree: ${candidate.reason}")
  } else {
    harness.println("   ✗ exact candidate tree: ${candidate.reason}")
    failures = failures + [candidate.reason]
  }
  if len(failures) == 0 {
    harness.println("== contract holds")
    return 0
  }
  harness.println("== contract VIOLATED")
  for failure in failures {
    harness.println("   - ${failure}")
  }
  harness.println(
    "\nThis orchestrator's release semantics disagree with the target repo's"
      + " current shape. Fix the orchestrator before dispatching a release.",
  )
  return 1
}

pipeline main(harness: Harness) {
  return run_release_contract_check(
    {fs: harness.fs, process: harness.process},
    {
      fs: harness.fs,
      process: harness.process,
      println: fn(line) { return harness.stdio.println(line) },
    },
    argv,
  )
}
