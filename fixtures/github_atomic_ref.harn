const ZERO = "0000000000000000000000000000000000000000"

/** Mock the connector's atomic, exact-object deletion and its acknowledgement. */
pub fn mock_atomic_ref_delete(testing: HarnessTesting, base: string, ref: string, oid: string) {
  const updates = [{ref: ref, before_oid: oid, after_oid: ZERO, force: false}]
  const transaction = "refs-"
    + sha256_hex(json_stringify({repo: "burin-labs/harn", updates: updates}))
  testing.http_mock(
    "GET",
    base + "/repos/burin-labs/harn",
    {status: 200, body: json_stringify({node_id: "R_fixture"})},
  )
  testing.http_mock(
    "POST",
    base + "/graphql",
    {status: 200, body: json_stringify({data: {updateRefs: {clientMutationId: transaction}}})},
  )
}

pub fn atomic_ref_deletes(testing: HarnessTesting, base: string) -> list<dict> {
  return testing.http_mock_calls().filter(
    { call -> (call.method == "POST" && call.url == base + "/graphql") || call.method == "DELETE" },
  )
    .to_list()
}

pub fn atomic_ref_delete_input(testing: HarnessTesting, base: string) {
  const calls = atomic_ref_deletes(testing, base)
  const body = json_parse(calls[0].body)
  return pick(body.variables.input, ["repositoryId", "refUpdates"])
}

pub fn expected_atomic_ref_delete(ref: string, oid: string) {
  return {
    repositoryId: "R_fixture",
    refUpdates: [{name: ref, beforeOid: oid, afterOid: ZERO, force: false}],
  }
}
