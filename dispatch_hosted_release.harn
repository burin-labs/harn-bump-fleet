#!/usr/bin/env harn
import { ParserSpec } from "std/cli/argparse"
import { cli_options } from "lib/cli_options"
import { github_actions_run, github_actions_run_cancel, github_workflow_dispatch } from "lib/github"
import {
  HostedReleaseDispatchAdapter,
  HostedReleaseDispatchReceipt,
  HostedReleaseInputs,
  hosted_release_dispatch,
  hosted_release_receipt_read,
  hosted_release_receipt_write,
  hosted_release_replace,
} from "lib/hosted_release_dispatch"

const REPO = "burin-labs/harn-bump-fleet"

const WORKFLOW = "hosted-release.yml"

const REF = "main"

type Options = {
  mode: string,
  bump: string,
  preid: string,
  at_sha: string,
  base: string,
  no_converge_fleet: bool,
  receipt_out?: string,
  replace_receipt?: string,
  agent: bool,
  yes_live_release: bool,
  no_chat: bool,
}

const ARG_SPEC: ParserSpec = {
  name: "dispatch-hosted-release",
  args: [
    {kind: "flag", name: "mode", long: "--mode", default: "audit"},
    {kind: "flag", name: "bump", long: "--bump", default: "patch"},
    {kind: "flag", name: "preid", long: "--preid", default: ""},
    {kind: "flag", name: "at_sha", long: "--at-sha", default: ""},
    {kind: "flag", name: "base", long: "--base", default: "main"},
    {kind: "switch", name: "no_converge_fleet", long: "--no-converge-fleet"},
    {kind: "flag", name: "receipt_out", long: "--receipt-out"},
    {kind: "flag", name: "replace_receipt", long: "--replace-receipt"},
    // Accepted because run_harn_release.sh uses the same public argv. Hosted
    // release policy already makes these properties structural.
    {kind: "switch", name: "agent", long: "--agent"},
    {kind: "switch", name: "yes_live_release", long: "--yes-live-release"},
    {kind: "switch", name: "no_chat", long: "--no-chat"},
  ],
}

fn changing_input_was_supplied(args: list<string>) -> bool {
  for arg in args {
    for prefix in ["--mode", "--bump", "--preid", "--at-sha", "--base", "--no-converge-fleet"] {
      if arg == prefix || starts_with(arg, prefix + "=") {
        return true
      }
    }
  }
  return false
}

fn adapter(
  harness: Harness,
  prior: HostedReleaseDispatchReceipt? = nil,
) -> HostedReleaseDispatchAdapter {
  const repo = prior?.repo ?? REPO
  const workflow = prior?.workflow ?? WORKFLOW
  const ref = prior?.ref ?? REF
  return {
    dispatch: fn(inputs) { return github_workflow_dispatch(
      harness,
      repo,
      workflow,
      {
        mode: inputs.mode,
        bump: inputs.bump,
        prerelease_identifier: inputs.prerelease_identifier,
        at_sha: inputs.at_sha,
        converge_fleet: inputs.converge_fleet,
      },
      ref,
    ) },
    run: fn(run_id) { return github_actions_run(harness, repo, run_id) },
    cancel: fn(run_id) { return github_actions_run_cancel(harness, repo, run_id) },
  }
}

fn default_receipt_path(run_id: int) -> string {
  return path_join(".harn-runs", "hosted-release-dispatch-${run_id}.json")
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  if options.base != "main" {
    throw "hosted release workflow owns base main; got ${options.base}"
  }
  let result = nil
  if options.replace_receipt != nil {
    if changing_input_was_supplied(argv) {
      throw "replacement replays the prior receipt; release input flags are not accepted"
    }
    const prior = hosted_release_receipt_read(harness.fs, options.replace_receipt)
    if prior == nil {
      throw "replacement requires a valid hosted release dispatch receipt"
    }
    if prior.repo != REPO || prior.workflow != WORKFLOW || prior.ref != REF {
      throw "replacement receipt does not name the canonical hosted release workflow"
    }
    result = hosted_release_replace(prior, adapter(harness, prior))
  } else {
    const inputs: HostedReleaseInputs = {
      mode: options.mode,
      bump: options.bump,
      prerelease_identifier: options.preid,
      at_sha: options.at_sha,
      converge_fleet: !options.no_converge_fleet,
    }
    result = hosted_release_dispatch(REPO, WORKFLOW, REF, inputs, adapter(harness))
  }
  if is_err(result) {
    throw "hosted release dispatch refused: " + json_stringify(unwrap_err(result))
  }
  const receipt = unwrap(result)
  const receipt_path = options.receipt_out ?? default_receipt_path(receipt.run_id)
  hosted_release_receipt_write({fs: harness.fs, random: harness.random}, receipt_path, receipt)
  harness.stdio.eprintln("hosted release dispatch receipt: " + receipt_path)
  harness.stdio.println(json_stringify_pretty(receipt))
}
