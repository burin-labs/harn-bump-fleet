#!/usr/bin/env harn
import { read_toml_typed } from "std/fs"
import {
  AgentGuidanceManifest,
  AgentGuidanceRepo,
  GuidanceRepoResult,
  resolve_projects_root,
  sync_agent_guidance_repo,
} from "lib/agent_guidance"

type SyncOptions = {apply: bool, manifest: string, root: string?, only: string?}

fn parse_options(args: list<string>) -> SyncOptions {
  let apply = false
  let manifest = "agent-guidance-fleet.toml"
  let root: string? = nil
  let only: string? = nil
  let index = 0
  while index < len(args) {
    const arg = args[index]
    if arg == "--apply" {
      apply = true
    } else if arg == "--check" || arg == "--dry-run" {
      apply = false
    } else if arg == "--manifest" || arg == "--root" || arg == "--only" {
      if index + 1 >= len(args) {
        throw "${arg} requires a value"
      }
      const value = args[index + 1] ?? ""
      if arg == "--manifest" {
        manifest = value
      } else if arg == "--root" {
        root = value
      } else {
        only = value
      }
      index = index + 1
    } else {
      throw "unknown argument: ${arg}"
    }
    index = index + 1
  }
  return {apply: apply, manifest: manifest, root: root, only: only}
}

fn selected_repositories(
  repositories: list<AgentGuidanceRepo>,
  only: string?,
) -> list<AgentGuidanceRepo> {
  if only == nil {
    return repositories
  }
  return repositories.filter({ repo -> repo.slug == only || repo.directory == only }).to_list()
}

fn report_result(harness: Harness, result: GuidanceRepoResult) -> nil {
  const detail = if len(result.changes) > 0 {
    ": " + join(result.changes, ", ")
  } else {
    ""
  }
  if result.status == "error" {
    harness.stdio.eprintln("error ${result.slug}: ${result.error ?? "unknown error"}")
  } else {
    harness.stdio.println("${result.status} ${result.slug}${detail}")
  }
}

fn main(harness: Harness) -> int {
  const options = parse_options(argv)
  const manifest = read_toml_typed<AgentGuidanceManifest>(
    options.manifest,
    schema_of(AgentGuidanceManifest),
  )
  const home = harness.env.get("HOME") ?? ""
  const root = resolve_projects_root(options.root ?? manifest.fleet.default_root, home)
  const repositories = selected_repositories(manifest.repositories, options.only)
  if len(repositories) == 0 {
    throw "no repository matched --only ${options.only ?? ""}"
  }
  let failed = false
  for repo in repositories {
    const result = sync_agent_guidance_repo(harness, repo, root, options.apply)
    report_result(harness, result)
    if result.status == "drift" || result.status == "error" {
      failed = true
    }
  }
  return if failed {
    1
  } else {
    0
  }
}
