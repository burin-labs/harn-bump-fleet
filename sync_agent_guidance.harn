#!/usr/bin/env harn
import {
  AgentGuidanceRepo,
  GuidanceRepoResult,
  resolve_projects_root,
  sync_agent_guidance_repo,
} from "lib/agent_guidance"
import { read_fleet_manifest } from "lib/fleet_manifest"
import { parse_sync_options, sync_target_matches } from "lib/sync_options"

fn selected_repositories(
  repositories: list<AgentGuidanceRepo>,
  only: string?,
) -> list<AgentGuidanceRepo> {
  if only == nil {
    return repositories
  }
  return repositories.filter({ repo -> sync_target_matches(repo.slug, repo.directory, only) })
    .to_list()
}

fn report_result(stdio: HarnessStdio, result: GuidanceRepoResult) -> nil {
  const detail = if len(result.changes) > 0 {
    ": " + join(result.changes, ", ")
  } else {
    ""
  }
  if result.status == "error" {
    stdio.eprintln("error ${result.slug}: ${result.error ?? "unknown error"}")
  } else {
    stdio.println("${result.status} ${result.slug}${detail}")
  }
}

fn main(harness: Harness) -> int {
  const options = parse_sync_options(argv)
  const manifest = read_fleet_manifest(harness.fs, options.manifest)
  const home = harness.env.get("HOME") ?? ""
  const root = resolve_projects_root(options.root ?? manifest.fleet.default_root, home)
  const repositories = selected_repositories(manifest.repositories, options.only)
  if len(repositories) == 0 {
    throw "no repository matched --only ${options.only ?? ""}"
  }
  let failed = false
  for repo in repositories {
    const result = sync_agent_guidance_repo(
      {fs: harness.fs, tools: harness.tools},
      repo,
      root,
      options.apply,
    )
    report_result(harness.stdio, result)
    if result.status == "drift" || result.status == "error" {
      failed = true
    }
  }
  return if failed {
    1
  } else {
    0
  }
}
