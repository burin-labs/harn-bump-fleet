#!/usr/bin/env harn
import {
  public_metadata_commits,
  public_metadata_violation_line,
  public_metadata_violations,
} from "lib/public_metadata_privacy"

fn text_field(value: any) -> string? {
  return if type_of(value) == "string" {
    value
  } else {
    nil
  }
}

/** Scan PR-visible title, body, and commit messages without echoing raw input. */
pipeline main(harness: Harness) {
  const event_path = harness.env.get("GITHUB_EVENT_PATH") ?? ""
  if event_path == "" || !harness.fs.exists(event_path) {
    harness.stdio.eprintln("public metadata privacy: GitHub event JSON is required")
    return 2
  }
  const event = try {
    json_parse(harness.fs.read_text(event_path))
  } catch (error) {
    harness.stdio.eprintln("public metadata privacy: GitHub event JSON could not be decoded")
    return 2
  }
  if type_of(event) != "dict" {
    harness.stdio.eprintln("public metadata privacy: GitHub event must be an object")
    return 2
  }
  let base_sha = ""
  let head_sha = ""
  let sources: list<{source: string, text: string}> = []
  const pull_request = event.get("pull_request")
  const merge_group = event.get("merge_group")
  if type_of(pull_request) == "dict" {
    const title = text_field(pull_request?.title)
    const body_value = pull_request?.body
    const body = if body_value == nil {
      ""
    } else {
      text_field(body_value)
    }
    base_sha = text_field(pull_request?.base?.sha) ?? ""
    head_sha = text_field(pull_request?.head?.sha) ?? ""
    if title == nil || body == nil {
      harness.stdio.eprintln("public metadata privacy: pull request metadata is not typed text")
      return 2
    }
    sources = [
      {source: "pull-request-title", text: title ?? ""},
      {source: "pull-request-body", text: body ?? ""},
    ]
  } else if type_of(merge_group) == "dict" {
    base_sha = text_field(merge_group?.base_sha) ?? ""
    head_sha = text_field(merge_group?.head_sha) ?? ""
  } else {
    harness.stdio.eprintln("public metadata privacy: event has no PR or merge-group range")
    return 2
  }
  const measured = public_metadata_commits(harness.process, harness.fs.cwd(), base_sha, head_sha)
  if is_err(measured) {
    harness.stdio.eprintln(
      "public metadata privacy: commits=unmeasured pending=commit-enumeration: "
        + unwrap_err(measured),
    )
    return 2
  }
  const commits = unwrap(measured)
  for commit in commits {
    sources = sources + [{source: "commit/${commit.oid}/message", text: commit.message}]
  }
  let violations = []
  for source in sources {
    violations = violations + public_metadata_violations(source.source, source.text)
  }
  harness.stdio.println(
    "public metadata privacy: sources=${len(sources)} commits=${len(commits)} "
      + "pending=${len(violations)}",
  )
  if len(violations) > 0 {
    for violation in violations {
      harness.stdio.eprintln(public_metadata_violation_line(violation))
    }
    return 1
  }
  return 0
}
