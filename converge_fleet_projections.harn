#!/usr/bin/env harn
//
// Converge every remote default-branch workflow projection `fleet.toml` owns.
// Whole-file projections use rendered bytes. Pin-only package CI projections
// derive safe expected bytes from the current workflow and preserve its other
// jobs. `check_fleet_policy.harn` is the alarm for that drift; this is the
// repair, and it runs against GitHub rather than against local checkouts, so a
// scheduled run needs no machine holding twenty-six clones.
//
// The repair is always a pull request. Nothing here writes a default branch,
// and nothing here merges. By default it does arm auto-merge, which asks GitHub
// to merge each repair once that repository's own required checks pass; a red
// projection still sits open. `--no-auto-merge` proposes without arming.
import {
  consumer_projection_repositories,
  manifest_with_consumer_contracts,
  read_remote_consumer_projection_manifests,
} from "lib/consumer_projection_manifest"
import { read_fleet_manifest } from "lib/fleet_manifest"
import {
  PACKAGE_CI_PATH,
  fleet_projection_sources,
  fleet_projection_targets,
  group_projection_targets_by_repository,
  pin_package_ci_projection_sources,
  projection_source_key,
  resolve_pin_package_ci_targets,
} from "lib/fleet_projection_targets"
import { github_file_text_at_ref } from "lib/github"
import {
  DEFAULT_PROJECTION_PR_AGE_BUDGET_DAYS,
  converge_remote_repository,
  remote_convergence_failed,
  report_projection_status,
} from "lib/remote_projection"
import {
  convergence_path_matches,
  missing_convergence_paths,
  parse_convergence_options,
  sync_target_matches,
} from "lib/sync_options"

pipeline main(harness: Harness) -> int {
  const converge_options = parse_convergence_options(argv)
  const options = converge_options.sync
  const manifest = read_fleet_manifest(harness.fs, options.manifest)
  const default_branch = manifest.fleet.default_branch
  const selected_repositories = manifest.repositories.filter(
    { repo -> sync_target_matches(repo.slug, repo.directory, options.only) },
  )
    .to_list()
  const selected = selected_repositories.map({ repo -> repo.slug }).to_list()
  const selected_consumers = consumer_projection_repositories(manifest).filter(
    { repo -> contains(selected, repo.slug) },
  )
    .to_list()
  const consumer_resolution = read_remote_consumer_projection_manifests(
    harness,
    manifest,
    default_branch,
    selected_consumers,
  )
  const runtime_manifest = manifest_with_consumer_contracts(manifest, consumer_resolution)
  const selected_pin_repositories = if convergence_path_matches(
    PACKAGE_CI_PATH,
    converge_options.only_paths,
  ) {
    selected_repositories
  } else {
    []
  }
  let sources = {}
  let unresolved = []
  for source in fleet_projection_sources(consumer_resolution.projections) {
    const key = projection_source_key(source.slug, source.path)
    const text = github_file_text_at_ref(harness, source.slug, source.path, default_branch)
    if text == nil {
      unresolved = unresolved + [key]
    } else {
      sources[key] = text ?? ""
    }
  }
  let pin_sources = {}
  for source in pin_package_ci_projection_sources(selected_pin_repositories) {
    const key = projection_source_key(source.slug, source.path)
    const text = github_file_text_at_ref(harness, source.slug, source.path, default_branch)
    if text != nil {
      pin_sources[key] = text ?? ""
    }
  }
  const pin_resolution = resolve_pin_package_ci_targets(
    manifest,
    selected_pin_repositories,
    pin_sources,
  )
  // `--only` names a repository the way the local syncs accept it, by slug or
  // by checkout directory. Targets carry only a slug, so admission is decided
  // against the manifest and then applied to them.
  const repository_targets = fleet_projection_targets(
    runtime_manifest,
    sources,
    consumer_resolution.projections,
  )
    .filter({ target -> contains(selected, target.slug) })
    .to_list()
    + pin_resolution.targets
  const missing_paths = missing_convergence_paths(
    converge_options.only_paths,
    repository_targets.map({ target -> target.path }).to_list(),
  )
  if len(missing_paths) > 0 {
    throw "--only-path does not name a manifest-owned target admitted by --only: "
      + join(missing_paths, ", ")
  }
  const targets = repository_targets.filter(
    { target -> convergence_path_matches(target.path, converge_options.only_paths) },
  )
    .to_list()
  let results = []
  let failed = len(unresolved) > 0
    || len(pin_resolution.errors) > 0
    || len(consumer_resolution.errors) > 0
  for group in group_projection_targets_by_repository(targets) {
    const result = converge_remote_repository(
      harness,
      group.slug,
      default_branch,
      group.targets,
      options.apply,
      converge_options.arm_auto_merge,
    )
    report_projection_status(harness.stdio, result)
    results = results + [result]
    failed = failed || remote_convergence_failed(result)
  }
  for key in unresolved {
    harness.stdio.eprintln("error ${key}: projection source is missing on ${default_branch}")
  }
  for error in pin_resolution.errors {
    harness.stdio.eprintln("error ${error}")
  }
  for error in consumer_resolution.errors {
    harness.stdio.eprintln("error ${error}")
  }
  // Counted at the top level so a receipt reader sees a fleet that stopped
  // arming without diffing twenty-seven per-repository records to notice.
  const refused = results.filter({ result -> (result.auto_merge?.state ?? "") == "refused" }).map(
    { result -> result.slug },
  )
    .to_list()
  // Same reason, for the other write this run makes on somebody else's
  // repository. A sweep that stopped working is invisible from its own output:
  // finding nothing to retire and being unable to look both print nothing.
  let swept = []
  for result in results {
    for proposal in result.sweep?.superseded ?? [] {
      swept = swept + [{slug: result.slug} + proposal]
    }
  }
  const sweep_failed = results.filter({ result -> (result.sweep?.error ?? "") != "" }).map(
    { result -> result.slug },
  )
    .to_list()
  const overdue = results.filter({ result -> result.overdue ?? false }).map(
    { result -> result.slug },
  )
    .to_list()
  harness.stdio.println(
    json_stringify_pretty(
      {
        schema_version: "harn.fleet-projection-convergence.v1",
        ok: !failed,
        applied: options.apply,
        auto_merge_armed: converge_options.arm_auto_merge,
        only_paths: converge_options.only_paths,
        auto_merge_refused_by: refused,
        pending_overdue_by: overdue,
        projection_pr_age_budget_days: DEFAULT_PROJECTION_PR_AGE_BUDGET_DAYS,
        superseded_proposals: swept,
        sweep_failed_by: sweep_failed,
        default_branch: default_branch,
        checked_repository_count: len(results),
        unresolved_sources: unresolved,
        target_errors: pin_resolution.errors,
        consumer_manifest_errors: consumer_resolution.errors,
        consumer_manifest_refs: consumer_resolution.contract_refs,
        repositories: results,
      },
    ),
  )
  return if failed {
    1
  } else {
    0
  }
}
