#!/usr/bin/env harn
//
// Converge every remote default-branch file whose exact bytes `fleet.toml`
// owns. `check_fleet_policy.harn` is the alarm for that drift; this is the
// repair, and it runs against GitHub rather than against local checkouts, so a
// scheduled run needs no machine holding twenty-six clones.
//
// The repair is always a pull request. Nothing here writes a default branch.
import { read_fleet_manifest } from "lib/fleet_manifest"
import {
  fleet_projection_sources,
  fleet_projection_targets,
  group_projection_targets_by_repository,
  projection_source_key,
} from "lib/fleet_projection_targets"
import { github_file_text_at_ref } from "lib/github"
import {
  RemoteConvergenceResult,
  converge_remote_repository,
  remote_convergence_failed,
} from "lib/remote_projection"
import { parse_sync_options, sync_target_matches } from "lib/sync_options"

fn report(stdio: HarnessStdio, result: RemoteConvergenceResult) {
  if result.status == "error" {
    stdio.eprintln("error ${result.slug}: ${result.error ?? "unknown error"}")
  } else {
    stdio.println("${result.status} ${result.slug}: ${join(result.drifted, ", ")}")
  }
}

pipeline main(harness: Harness) -> int {
  const options = parse_sync_options(argv)
  const manifest = read_fleet_manifest(harness.fs, options.manifest)
  const default_branch = manifest.fleet.default_branch
  let sources = {}
  let unresolved = []
  for source in fleet_projection_sources(manifest) {
    const key = projection_source_key(source.slug, source.path)
    const text = github_file_text_at_ref(harness, source.slug, source.path, default_branch)
    if text == nil {
      unresolved = unresolved + [key]
    } else {
      sources[key] = text ?? ""
    }
  }
  // `--only` names a repository the way the local syncs accept it, by slug or
  // by checkout directory. Targets carry only a slug, so admission is decided
  // against the manifest and then applied to them.
  const selected = manifest.repositories.filter(
    { repo -> sync_target_matches(repo.slug, repo.directory, options.only) },
  )
    .map({ repo -> repo.slug })
    .to_list()
  const targets = fleet_projection_targets(manifest, sources).filter(
    { target -> contains(selected, target.slug) },
  )
    .to_list()
  let results = []
  let failed = len(unresolved) > 0
  for group in group_projection_targets_by_repository(targets) {
    const result = converge_remote_repository(
      harness,
      group.slug,
      default_branch,
      group.targets,
      options.apply,
    )
    report(harness.stdio, result)
    results = results + [result]
    failed = failed || remote_convergence_failed(result)
  }
  for key in unresolved {
    harness.stdio.eprintln("error ${key}: projection source is missing on ${default_branch}")
  }
  harness.stdio.println(
    json_stringify_pretty(
      {
        schema_version: "harn.fleet-projection-convergence.v1",
        ok: !failed,
        applied: options.apply,
        default_branch: default_branch,
        checked_repository_count: len(results),
        unresolved_sources: unresolved,
        repositories: results,
      },
    ),
  )
  return if failed {
    1
  } else {
    0
  }
}
