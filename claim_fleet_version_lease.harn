#!/usr/bin/env harn
//
// Hold one fleet update chain per Harn version.
//
// Two chains for the same version ran their rounds side by side on
// 2026-09-22, minutes apart, because the only lease was keyed by chain id and
// two chains have two of those. Each round reads and writes across every fleet
// repository with the release app's token, so the second chain doubled the
// spend on the budget that was already binding and raced the first chain's
// proof writes.
//
// This runs before any fleet work, at round one only. Later rounds belong to a
// chain that already holds the lease, and a round that refused on its own
// predecessor would stop every chain at round two.
import { ParserSpec } from "std/cli/argparse"
import { chain_owning_runs } from "lib/chain_ref_reap"
import { cli_options } from "lib/cli_options"
import {
  FleetVersionLeaseAdapter,
  claim_fleet_version_lease_with_adapter,
} from "lib/fleet_version_lease"
import { github_claim_ref, github_release_ref } from "lib/github"
import { release_git_remote_refs } from "lib/release_runtime"

const FLEET_REPO = "burin-labs/harn-bump-fleet"

type Options = {version: string, chain_id: string, update_round: int, controller_revision: string}

const ARG_SPEC: ParserSpec = {
  name: "claim-fleet-version-lease",
  args: [
    {kind: "flag", name: "version", long: "--version", required: true},
    {kind: "flag", name: "chain_id", long: "--chain-id", required: true},
    {kind: "flag", name: "update_round", long: "--update-round", parse: "int", default: 1},
    {kind: "flag", name: "controller_revision", long: "--controller-revision", required: true},
  ],
}

pub fn fleet_version_lease_adapter(
  harness: Harness,
  controller_revision: string,
) -> FleetVersionLeaseAdapter {
  return {
    refs: fn(glob) {
      const observed = release_git_remote_refs(
        harness.process,
        {repo: FLEET_REPO, mock: false},
        [glob],
      )
      if !observed.success {
        throw "could not inventory the version lease refs: " + trim(observed.stderr)
      }
      return observed.refs.map(
        { remote -> return {ref: trim(remote.ref), oid: lowercase(trim(remote.oid))} },
      )
        .to_list()
    },
    runs: fn(chain_id) { return chain_owning_runs(harness, chain_id) },
    clear: fn(ref, oid) {
      const released = github_release_ref(harness, FLEET_REPO, ref, oid)
      if is_err(released) {
        throw "could not reclaim ${ref}: " + to_string(unwrap_err(released))
      }
      return nil
    },
    claim: fn(ref, _chain_id) {
      const claimed = github_claim_ref(harness, FLEET_REPO, ref, {oid: controller_revision})
      if is_err(claimed) {
        throw "could not take the version lease at ${ref}: " + to_string(unwrap_err(claimed))
      }
      return nil
    },
  }
}

pipeline main(harness: Harness) {
  const options = cli_options<Options>(ARG_SPEC, argv, schema_of(Options))
  const receipt = claim_fleet_version_lease_with_adapter(
    options.version,
    options.chain_id,
    options.update_round,
    fleet_version_lease_adapter(harness, options.controller_revision),
  )
  harness.stdio.println(json_stringify_pretty(receipt))
  for chain in receipt.cleared {
    // Named on stderr as well as in the receipt. A lease that disappears
    // silently is indistinguishable from one that was never taken.
    harness.stdio.eprintln("reclaimed the ${receipt.version} lease from chain ${chain}")
  }
  if receipt.decision.action == "refuse" {
    harness.stdio.eprintln(receipt.decision.summary)
    return 1
  }
  harness.stdio.println(receipt.decision.summary)
  return 0
}
