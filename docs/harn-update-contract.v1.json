{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/burin-labs/harn-bump-fleet/docs/harn-update-contract.v1.json",
  "title": "Harn update controller contract v1",
  "description": "The stable, reviewable contract for one hosted Harn update and its bounded follow-up rounds. Secret references identify a brokered environment binding; they never contain values.",
  "type": "object",
  "required": [
    "schema_version",
    "terms",
    "workflow",
    "runtime_readiness",
    "repair_authority",
    "provider_routes",
    "receipts",
    "migrations"
  ],
  "properties": {
    "schema_version": { "const": "harn_update_contract.v1" },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["update", "round", "proof", "repair_attempt"],
      "properties": {
        "update": { "const": "A named Harn version moving through one repository or the declared fleet." },
        "round": { "const": "One fresh hosted workflow run with its own short-lived GitHub App credentials." },
        "proof": { "const": "Exact default-branch pin, green pull-request head, merge commit, and reachability evidence." },
        "repair_attempt": { "const": "One budgeted agent repair followed by an exact validator." }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "inputs", "max_rounds_default", "continuation"],
      "properties": {
        "entrypoint": { "const": ".github/workflows/bump-fleet.yml" },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "only", "enable_repair", "update_round", "max_rounds"],
          "properties": {
            "version": { "type": "string", "description": "Exact vX.Y.Z release tag, or the latest release when blank." },
            "only": { "type": "string", "description": "Optional owner/repository scope." },
            "enable_repair": { "type": "boolean", "default": true },
            "update_round": { "type": "integer", "minimum": 1, "default": 1 },
            "max_rounds": { "type": "integer", "minimum": 1, "default": 4 }
          }
        },
        "max_rounds_default": { "const": 4 },
        "continuation": { "const": "Harn decides whether incomplete proof dispatches exactly one next hosted round; GitHub only supplies the fresh credential boundary." }
      }
    },
    "runtime_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_exact_target_runtime", "provenance_fields", "block_before_model_spend"],
      "properties": {
        "requires_exact_target_runtime": { "const": true },
        "provenance_fields": {
          "type": "array",
          "items": { "type": "string" },
          "const": ["harn_version", "controller_revision", "repair_contract_revision"]
        },
        "block_before_model_spend": { "const": true }
      }
    },
    "repair_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "secret_references", "tools", "new_files"],
      "properties": {
        "environment": { "const": "release" },
        "secret_references": { "const": ["CEREBRAS_API_KEY"] },
        "tools": { "const": ["read", "command", "edit_file", "repair_write"] },
        "new_files": { "const": "repair_write is present only for exact manifest-declared missing paths and refuses overwrites." }
      }
    },
    "provider_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "strong", "cost_accounting"],
      "properties": {
        "value": { "const": { "provider": "cerebras", "model": "gpt-oss-120b" } },
        "strong": { "const": { "provider": "cerebras", "model": "zai-glm-4.7" } },
        "cost_accounting": { "const": "Unknown or incomplete provider usage stops further repair; it is never recorded as zero cost." }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "repair", "proof", "continuation", "required_authority_fields"],
      "properties": {
        "startup": { "const": "fleet-repair-startup-receipt.json" },
        "repair": { "const": "fleet-repair-receipt.json" },
        "proof": { "const": "fleet-convergence-proof-receipt.json" },
        "continuation": { "const": "fleet-update-continuation-receipt.json" },
        "required_authority_fields": { "const": ["requested", "granted", "used", "denied", "unused", "decider"] }
      }
    },
    "migrations": {
      "type": "array",
      "items": { "type": "string" },
      "const": [
        "enable-agent-repair input replaced by enable_repair.",
        "Static second repair and proof steps replaced by the Harn-owned continuation decision.",
        "OpenRouter and Fireworks credential forwarding removed; the brokered repair consumer receives only CEREBRAS_API_KEY."
      ]
    }
  },
  "additionalProperties": false
}
