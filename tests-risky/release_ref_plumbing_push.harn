import { git_push } from "std/git"
import { git_push_ref_plumbing } from "../lib/git"

/**
 * Ref plumbing must not be gated on the checkout's own branch.
 *
 * `abandon_release_attempts` is the remedy the release harness prints when a
 * version is wedged, and it archives one remote ref to another name. The
 * operator running it is on whatever branch they were already on. A pre-push
 * hook reads that branch — `@{upstream}` first — so the escape hatch used to
 * fail on tracking state belonging to unrelated work (burin-labs/harn-bump-fleet#654).
 *
 * The hook installed here is the reported failure in miniature: resolve
 * `@{upstream}` under `set -e`. It is real enough to block a plain `git_push`,
 * which is what the second half asserts. Without that half the first half
 * would pass whether or not the hook ran at all.
 */
fn fixture_shell(process: HarnessProcess, command: string) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

fn fixture_repo(harness: Harness) -> {repo: string, oid: string} {
  const root = path_join(harness.fs.temp_dir(), "ref-plumbing-" + harness.random.uuid_v7())
  const origin = path_join(root, "origin.git")
  const repo = path_join(root, "repo")
  harness.fs.mkdir(root, true)
  fixture_shell(harness.process, "git init --bare -q '${origin}'")
  fixture_shell(harness.process, "git init -q '${repo}'")
  fixture_shell(harness.process, "git -C '${repo}' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '${repo}' config user.name test")
  fixture_shell(harness.process, "git -C '${repo}' checkout -q -b main")
  fixture_shell(harness.process, "touch '" + path_join(repo, "fixture.txt") + "'")
  fixture_shell(harness.process, "git -C '${repo}' add fixture.txt")
  fixture_shell(harness.process, "git -C '${repo}' commit -q -m first")
  fixture_shell(harness.process, "git -C '${repo}' remote add origin '${origin}'")
  const oid = trim(fixture_shell(harness.process, "git -C '${repo}' rev-parse HEAD").stdout)
  fixture_shell(
    harness.process,
    "git -C '${repo}' push -q origin HEAD:refs/heads/release-attempt/v1.2.3/${oid}",
  )
  const hook = path_join(repo, ".git", "hooks", "pre-push")
  harness.fs.write_text(hook, "#!/bin/sh\nset -e\ngit rev-parse --abbrev-ref '@{upstream}'\n")
  fixture_shell(harness.process, "chmod +x '${hook}'")
  // The state every developer checkout and worktree is in: a branch created
  // locally and never pushed, so it has no upstream to resolve.
  fixture_shell(harness.process, "git -C '${repo}' checkout -q -b wip")
  return {repo: repo, oid: oid}
}

pipeline test_archiving_an_attempt_ignores_the_checkouts_branch_state(harness: Harness, task) {
  const fixture = fixture_repo(harness)
  const archived = "refs/heads/release-failed/v1.2.3/${fixture.oid}-abandoned"
  const pushed = git_push_ref_plumbing(
    harness.process,
    "origin",
    "${fixture.oid}:${archived}",
    fixture.repo,
  )
  assert_eq(pushed.success, true)
  assert(
    starts_with(
      trim(
        fixture_shell(harness.process, "git -C '${fixture.repo}' ls-remote origin '${archived}'")
          .stdout,
      ),
      fixture.oid,
    ),
  )
}

pipeline test_the_same_push_without_plumbing_is_blocked_by_the_hook(harness: Harness, task) {
  const fixture = fixture_repo(harness)
  const archived = "refs/heads/release-failed/v1.2.3/${fixture.oid}-abandoned"
  const pushed = git_push(harness.process, "origin", "${fixture.oid}:${archived}", fixture.repo)
  assert_eq(pushed.success, false)
  // git's own words for the hook's failed `@{upstream}` resolution, so the
  // refusal is attributable to the hook rather than to the transport.
  assert(contains(pushed.stderr.inline, "no upstream configured for branch 'wip'"))
  assert_eq(
    trim(
      fixture_shell(harness.process, "git -C '${fixture.repo}' ls-remote origin '${archived}'")
        .stdout,
    ),
    "",
  )
}
