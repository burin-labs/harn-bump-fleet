import { delete_remote_ref_with_lease } from "../lib/release_ref_cleanup"

fn fixture_shell(harness: HarnessProcess, command: string) {
  const result = harness.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

pipeline test_structured_remote_delete_enforces_exact_lease_against_real_remote(
  harness: Harness,
  task,
) {
  const root = path_join(harness.fs.temp_dir(), "release-ref-delete-" + harness.random.uuid_v7())
  const origin = path_join(root, "origin.git")
  const repo = path_join(root, "repo")
  harness.fs.mkdir(root, true)
  fixture_shell(harness.process, "git init --bare -q '" + origin + "'")
  fixture_shell(harness.process, "git init -q '" + repo + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + repo + "' checkout -q -b main")
  fixture_shell(harness.process, "touch '" + path_join(repo, "fixture.txt") + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' add fixture.txt")
  fixture_shell(harness.process, "git -C '" + repo + "' commit -q -m first")
  fixture_shell(harness.process, "git -C '" + repo + "' remote add origin '" + origin + "'")
  const first = trim(fixture_shell(harness.process, "git -C '" + repo + "' rev-parse HEAD").stdout)
  const ref = "refs/heads/release-attempt/v1.2.3/${first}"
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin HEAD:'" + ref + "'")
  const deleted = delete_remote_ref_with_lease(harness.process, repo, ref, first)
  assert_eq(deleted.success, true)
  assert_eq(
    trim(
      fixture_shell(harness.process, "git -C '" + repo + "' ls-remote origin '" + ref + "'").stdout,
    ),
    "",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin HEAD:'" + ref + "'")
  fixture_shell(harness.process, "echo second > '" + path_join(repo, "fixture.txt") + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' commit -q -am second")
  const second = trim(fixture_shell(harness.process, "git -C '" + repo + "' rev-parse HEAD").stdout)
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin HEAD:'" + ref + "'")
  const stale = delete_remote_ref_with_lease(harness.process, repo, ref, first)
  assert_eq(stale.success, false)
  assert_eq(stale.status, "lease_mismatch")
  assert(contains(stale.message, second))
  assert(
    starts_with(
      trim(
        fixture_shell(harness.process, "git -C '" + repo + "' ls-remote origin '" + ref + "'")
          .stdout,
      ),
      second,
    ),
  )
}
