import { git_push } from "std/git"
import { git_push_ref_plumbing } from "../lib/git"
import { delete_remote_ref_with_lease } from "../lib/release_ref_cleanup"

/**
 * A pre-push hook that fails the way harn's own hook did: it resolves the
 * current branch's upstream, which a branch created with `git checkout -b` and
 * never pushed does not have. The message is copied from the real failure so
 * the assertion below is anchored to the reported symptom rather than to
 * whatever this fixture happens to print.
 */
const UPSTREAM_HOOK =
  "#!/bin/sh\nif ! git rev-parse --symbolic-full-name @{upstream} >/dev/null 2>&1; then\n  echo 'fatal: Not a valid object name @{upstream}' >&2\n  exit 1\nfi\n"

fn fixture_shell(process: HarnessProcess, command: string) {
  const result = process.shell(command)
  if !result.success {
    throw "fixture command failed: ${command}\n${result.stderr}"
  }
  return result
}

pipeline test_structured_remote_delete_enforces_exact_lease_against_real_remote(
  harness: Harness,
  task,
) {
  const root = path_join(harness.fs.temp_dir(), "release-ref-delete-" + harness.random.uuid_v7())
  const origin = path_join(root, "origin.git")
  const repo = path_join(root, "repo")
  harness.fs.mkdir(root, true)
  fixture_shell(harness.process, "git init --bare -q '" + origin + "'")
  fixture_shell(harness.process, "git init -q '" + repo + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + repo + "' checkout -q -b main")
  fixture_shell(harness.process, "touch '" + path_join(repo, "fixture.txt") + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' add fixture.txt")
  fixture_shell(harness.process, "git -C '" + repo + "' commit -q -m first")
  fixture_shell(harness.process, "git -C '" + repo + "' remote add origin '" + origin + "'")
  const first = trim(fixture_shell(harness.process, "git -C '" + repo + "' rev-parse HEAD").stdout)
  const ref = "refs/heads/release-attempt/v1.2.3/${first}"
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin HEAD:'" + ref + "'")
  const deleted = delete_remote_ref_with_lease(harness.process, repo, ref, first)
  assert_eq(deleted.success, true)
  assert_eq(
    trim(
      fixture_shell(harness.process, "git -C '" + repo + "' ls-remote origin '" + ref + "'").stdout,
    ),
    "",
  )
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin HEAD:'" + ref + "'")
  fixture_shell(harness.process, "echo second > '" + path_join(repo, "fixture.txt") + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' commit -q -am second")
  const second = trim(fixture_shell(harness.process, "git -C '" + repo + "' rev-parse HEAD").stdout)
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin HEAD:'" + ref + "'")
  const stale = delete_remote_ref_with_lease(harness.process, repo, ref, first)
  assert_eq(stale.success, false)
  assert_eq(stale.status, "lease_mismatch")
  assert(contains(stale.message, second))
  assert(
    starts_with(
      trim(
        fixture_shell(harness.process, "git -C '" + repo + "' ls-remote origin '" + ref + "'")
          .stdout,
      ),
      second,
    ),
  )
}

/**
 * Claim: a leased ref deletion reaches the remote through a checkout whose
 * pre-push hook depends on branch and tracking state the operation never uses.
 *
 * This is the combination the fleet actually needs and the one that could not
 * travel before Harn v0.10.55 — the lease made the push a `--force-with-lease`,
 * and adding `--no-verify` moved it off the argv position the runtime's
 * reviewed dispatch recognized, so it was denied as a bare force push.
 *
 * Falsifier: the same deletion, same lease, same checkout, without the hook
 * skip. If that landed anyway the hook was never the cause and this proves
 * nothing.
 */
pipeline test_leased_deletion_survives_a_hook_that_requires_an_upstream(harness: Harness, task) {
  const root = path_join(harness.fs.temp_dir(), "release-ref-plumbing-" + harness.random.uuid_v7())
  const origin = path_join(root, "origin.git")
  const repo = path_join(root, "repo")
  harness.fs.mkdir(root, true)
  fixture_shell(harness.process, "git init --bare -q '" + origin + "'")
  fixture_shell(harness.process, "git init -q '" + repo + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.email test@example.com")
  fixture_shell(harness.process, "git -C '" + repo + "' config user.name test")
  fixture_shell(harness.process, "git -C '" + repo + "' checkout -q -b main")
  fixture_shell(harness.process, "touch '" + path_join(repo, "fixture.txt") + "'")
  fixture_shell(harness.process, "git -C '" + repo + "' add fixture.txt")
  fixture_shell(harness.process, "git -C '" + repo + "' commit -q -m first")
  fixture_shell(harness.process, "git -C '" + repo + "' remote add origin '" + origin + "'")
  const oid = trim(fixture_shell(harness.process, "git -C '" + repo + "' rev-parse HEAD").stdout)
  const ref = "refs/heads/release-attempt/v1.2.3/${oid}"
  const ls_remote = "git -C '" + repo + "' ls-remote origin '" + ref + "'"
  // Publish the ref before the hook exists, so the deletion below is the only
  // thing the hook ever sees. `push` without `-u` leaves the branch with no
  // upstream, which is the state the hook trips on.
  fixture_shell(harness.process, "git -C '" + repo + "' push -q origin HEAD:'" + ref + "'")
  const hook = repo + "/.git/hooks/pre-push"
  harness.fs.write_text(hook, UPSTREAM_HOOK)
  fixture_shell(harness.process, "chmod +x '" + hook + "'")
  const hooked = git_push(harness.process, "origin", ":${ref}", repo, {ref: ref, expected_oid: oid})
  assert_eq(hooked.success, false)
  assert(contains(hooked.stderr.inline, "@{upstream}"))
  assert(starts_with(trim(fixture_shell(harness.process, ls_remote).stdout), oid))
  const deleted = delete_remote_ref_with_lease(harness.process, repo, ref, oid)
  assert_eq(deleted.success, true)
  assert_eq(trim(fixture_shell(harness.process, ls_remote).stdout), "")
  // Republishing an OID origin already holds is plumbing too, and the lease is
  // absent there — the ref is being created, so there is nothing to replace.
  const archived = "refs/heads/release-failed/v1.2.3/${oid}-abandoned"
  const plumbed = git_push_ref_plumbing(harness.process, "origin", "${oid}:${archived}", repo)
  assert_eq(plumbed.success, true)
}
