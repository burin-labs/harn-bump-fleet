#!/usr/bin/env harn
//
// Record the closed input set a hosted release run was dispatched with.
//
// The Actions API does not report the inputs of a `workflow_dispatch` run, so
// the only thing that can name them later is the run itself. Recording them
// first, before any validation or credential work, means a run that fails at
// its very first gate still leaves the exact dispatch behind for the failure
// finalizer to name.
import { env_str } from "std/config"

const OUT_PATH = ".harn-runs/hosted-release-inputs.json"

type RecordedInputsDocument = {
  schema_version: "harn_bump_fleet.hosted_release_inputs.v1",
  mode: string,
  agent: bool,
  bump: string,
  prerelease_identifier: string,
  at_sha: string,
  expected_prs: string,
  resume_tagged_release: bool,
  converge_fleet: bool,
  repositories_json: string,
  skip_consumers: string,
  consumer_proof_runs_json: string,
}

fn text(env: HarnessEnv, name: string) -> string {
  return trim(env_str(env, name) ?? "")
}

fn flag(env: HarnessEnv, name: string) -> bool {
  return lowercase(text(env, name)) == "true"
}

pipeline main(harness: Harness) {
  const document: RecordedInputsDocument = {
    schema_version: "harn_bump_fleet.hosted_release_inputs.v1",
    mode: text(harness.env, "RELEASE_MODE"),
    agent: flag(harness.env, "RELEASE_AGENT"),
    bump: text(harness.env, "RELEASE_BUMP"),
    prerelease_identifier: text(harness.env, "RELEASE_PREID"),
    at_sha: text(harness.env, "RELEASE_AT_SHA"),
    expected_prs: text(harness.env, "RELEASE_EXPECT_PRS"),
    resume_tagged_release: flag(harness.env, "RELEASE_RESUME_TAGGED"),
    converge_fleet: flag(harness.env, "RELEASE_CONVERGE_FLEET"),
    repositories_json: text(harness.env, "RELEASE_REPOSITORIES_JSON"),
    skip_consumers: text(harness.env, "RELEASE_SKIP_CONSUMERS"),
    consumer_proof_runs_json: text(harness.env, "RELEASE_CONSUMER_PROOF_RUNS_JSON"),
  }
  // Mode and bump are `choice` inputs with defaults, so an empty one means the
  // environment did not reach this step rather than that the operator left it
  // blank. Writing the document anyway would record a dispatch nobody made.
  if document.mode == "" || document.bump == "" {
    harness.stdio.eprintln(
      "hosted release inputs: refusing to record a dispatch with no mode or bump; "
        + "the run environment did not reach this step",
    )
    return 1
  }
  harness.fs.mkdir(".harn-runs")
  harness.fs.write_text(OUT_PATH, json_stringify_pretty(document) + "\n")
  harness.stdio.println("hosted release inputs: recorded ${document.mode} ${document.bump}")
  return 0
}
